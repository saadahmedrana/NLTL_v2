  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#sewageDischargeToSea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Sewage discharge to sea</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <skos:altLabel>sewage_discharge_to_sea</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for sewageDischargeToSea derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Sewage discharge to sea</skos:prefLabel>
    <nltl:draftConceptId>VOC-0660</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Discharge of sewage into the sea from category A and B ships constructed on or after 1 January 2017 and all passenger ships constructed on or after 1 January 2017 is prohibited, except when such discharges are in compliance with paragraph 4.2.1.3 of this chapter.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
