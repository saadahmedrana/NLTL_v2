    <skos:prefLabel xml:lang="en">Water added mass</skos:prefLabel>
    <nltl:draftConceptId>VOC-0806</nltl:draftConceptId>
    <nltl:evidenceExcerpt>When estimating thruster global natural frequencies in the longitudinal and transverse direction, the damping and added mass due to water must be taken into account. In addition to this, the effect of ship attachment stiffness must be modelled.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleMachinery"/>
