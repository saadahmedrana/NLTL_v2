  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#plasticStrength">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Plastic strength</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>plasticStrength</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for plasticStrength derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Plastic strength</skos:prefLabel>
    <nltl:draftConceptId>VOC-0543</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The local frames in bottom structures (i.e. hull areas BIb, Mb and Sb) and transverse local frames in side structures are to be dimensioned such that the combined effects of shear and bending do not exceed the plastic strength of the member. The plastic strength is defined by the magnitude of midspan load that causes the development of a plastic collapse mec...</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleHull"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:quantityKindLabel>Force</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/KiloN"/>
    <nltl:roleDecisionBasis>Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node</nltl:roleDecisionBasis>
    <nltl:sourceAlias>plasticStrength</nltl:sourceAlias>
    <nltl:sourceReference>I2-031 | IACS_UR_I2 p.12 | I2.6.1; I2-034 | IACS_UR_I2 p.13 | I2.7.1</nltl:sourceReference>
    <nltl:sourceRequirementId>I2-031</nltl:sourceRequirementId>
    <nltl:sourceRequirementId>I2-034</nltl:sourceRequirementId>
    <nltl:stage1LocalName>plasticStrength</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Recommended canonical QUDT unit selected by Stage 2 engineering normalization: IACS source defines plastic strength by the magnitude of midspan load at collapse</nltl:unitDecisionStatus>
    <nltl:unitSymbol>kN</nltl:unitSymbol>
  </rdf:Description>
