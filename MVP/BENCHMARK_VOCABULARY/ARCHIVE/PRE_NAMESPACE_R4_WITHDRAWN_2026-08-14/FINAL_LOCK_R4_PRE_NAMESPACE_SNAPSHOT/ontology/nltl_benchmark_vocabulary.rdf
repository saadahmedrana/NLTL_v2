  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#betaIPrime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Beta i prime</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>beta_i_prime</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for betaIPrime derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Beta i prime</skos:prefLabel>
    <nltl:draftConceptId>VOC-0079</nltl:draftConceptId>
    <nltl:evidenceExcerpt>For bow forms defined in I2.3.1(v), the shape coefficient f_ai is to be taken as f_ai = minimum(f_ai1, f_ai2, f_ai3), where f_ai1 = (0.097 - 0.68*(x/L_UI - 0.15)^2)*alpha_i/(beta_i_prime)^0.5, f_ai2 = 1.2*C_FF/(sin(beta_i_prime)*C_FC*D_UI^0.64), and f_ai3 = 0.60.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleHull"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:quantityKindLabel>DimensionlessRatio</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
    <nltl:roleDecisionBasis>Clause-linked engineering quantity override; represented by the canonical QUDT QuantityValue node pattern</nltl:roleDecisionBasis>
    <nltl:sourceAlias>beta_i_prime</nltl:sourceAlias>
    <nltl:sourceReference>I2-015 | IACS_UR_I2 p.5 | I2.3.2.1</nltl:sourceReference>
    <nltl:sourceRequirementId>I2-015</nltl:sourceRequirementId>
    <nltl:stage1LocalName>betaIPrime</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical dimensionless unit</nltl:unitDecisionStatus>
    <nltl:unitSymbol>1</nltl:unitSymbol>
  </rdf:Description>
