    <nltl:roleDecisionBasis>Explicit engineering entity/artifact class set</nltl:roleDecisionBasis>
    <nltl:sourceAlias>thrusterBody</nltl:sourceAlias>
    <nltl:sourceReference>TRF-113 | TRAFICOM p.52 | 6.6.5.1; TRF-114 | TRAFICOM p.53 | 6.6.5.2</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-113</nltl:sourceRequirementId>
    <nltl:sourceRequirementId>TRF-114</nltl:sourceRequirementId>
    <nltl:stage1LocalName>thrusterBody</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
