  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#distanceToNearestFastIce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Distance to nearest fast ice</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>distance_to_nearest_fast_ice_nm</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for distanceToNearestFastIce derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Distance to nearest fast ice</skos:prefLabel>
    <nltl:draftConceptId>VOC-0215</nltl:draftConceptId>
    <nltl:evidenceExcerpt>In the Antarctic area, discharges under regulation 6.1 of MARPOL Annex V shall be as far as practicable from areas of ice concentration exceeding 1/10, but in any case not less than 12 nautical miles from the nearest fast ice; and food waste shall not be discharged onto ice.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Unit-stripped normalized regulatory variable</nltl:namingBasis>
    <nltl:namingRule>N3 - remove unit from the identifier and retain it in unit/quantity metadata</nltl:namingRule>
    <nltl:quantityKindLabel>Length</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/MI_N"/>
    <nltl:roleDecisionBasis>Quantity metadata requires the canonical QUDT QuantityValue node pattern</nltl:roleDecisionBasis>
    <nltl:sourceAlias>distance_to_nearest_fast_ice_nm</nltl:sourceAlias>
    <nltl:sourceReference>IMO-124 | IMO_POLAR_CODE p.44 | 5.2.2.1-.2</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-124</nltl:sourceRequirementId>
    <nltl:stage1LocalName>distanceToNearestFastIce</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Verified recommended QUDT unit from Stage 1 or a documented Stage 2 source-unit refinement</nltl:unitDecisionStatus>
    <nltl:unitSymbol>nautical mile</nltl:unitSymbol>
  </rdf:Description>
