    <skos:prefLabel xml:lang="en">Cooling water system</skos:prefLabel>
    <nltl:draftConceptId>VOC-0172</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The cooling water system shall be designed to secure the supply of cooling water when navigating in ice.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleMachinery"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
