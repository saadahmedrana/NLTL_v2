    <skos:prefLabel xml:lang="en">Independent transducer count</skos:prefLabel>
    <nltl:draftConceptId>VOC-0390</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Ships constructed on or after 1 January 2017, ice strengthened in accordance with chapter 3, shall have either two independent echo-sounding devices or one echo-sounding device with two separate independent transducers.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
