  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#abandonmentOntoIceOrLandPotential">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Abandonment onto ice or land potential</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <skos:altLabel>abandonment_onto_ice_or_land_potential</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for abandonmentOntoIceOrLandPotential derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Abandonment onto ice or land potential</skos:prefLabel>
    <nltl:draftConceptId>VOC-0002</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Whenever the assessment identifies a potential of abandonment onto ice or land, group survival equipment shall be carried, unless an equivalent level of functionality for survival is provided by the ship's normal life-saving appliances.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
    <nltl:namingRule>N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase</nltl:namingRule>
    <nltl:roleDecisionBasis>Explicit binary applicability/state semantics from the linked requirement</nltl:roleDecisionBasis>
    <nltl:sourceAlias>abandonment_onto_ice_or_land_potential</nltl:sourceAlias>
    <nltl:sourceReference>IMO-074 | IMO_POLAR_CODE p.25 | 8.3.3.3.3.1</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-074</nltl:sourceRequirementId>
    <nltl:stage1LocalName>abandonmentOntoIceOrLandPotential</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#alternateVisualIceDetectionMeansApprovalStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Alternate visual ice detection means approval status</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="https://w3id.org/nltl-benchmark/vocab#evidenceState"/>
    <skos:altLabel>alternate_visual_ice_detection_means_approval_status</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for alternateVisualIceDetectionMeansApprovalStatus derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Alternate visual ice detection means approval status</skos:prefLabel>
    <nltl:draftConceptId>VOC-0033</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Ships, with the exception of those solely operating in areas with 24 h daylight, shall be equipped with two remotely rotatable, narrow-beam search lights controllable from the bridge to provide lighting over an arc of 360 degrees, or other means to visually detect ice.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleDocuments"/>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
    <nltl:namingRule>N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase</nltl:namingRule>
    <nltl:roleDecisionBasis>Evidence lifecycle state decision</nltl:roleDecisionBasis>
    <nltl:sourceAlias>alternate_visual_ice_detection_means_approval_status</nltl:sourceAlias>
    <nltl:sourceReference>IMO-088 | IMO_POLAR_CODE p.27 | 9.3.3.1</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-088</nltl:sourceRequirementId>
    <nltl:stage1LocalName>alternateVisualIceDetectionMeansApprovalStatus</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#polarCodeApplies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Polar code applies</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
