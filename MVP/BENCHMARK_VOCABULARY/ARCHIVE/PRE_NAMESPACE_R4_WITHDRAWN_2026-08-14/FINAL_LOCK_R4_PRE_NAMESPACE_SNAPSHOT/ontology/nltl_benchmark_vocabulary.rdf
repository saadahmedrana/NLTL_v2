  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#elasticCouplingPresent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Elastic coupling present</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <skos:altLabel>elasticCouplingPresent</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for elasticCouplingPresent derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Elastic coupling present</skos:prefLabel>
    <nltl:draftConceptId>VOC-0224</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Diesel engine plants without an elastic coupling shall be calculated at the least favourable phase angle for ice versus engine excitation, when calculated in the time domain. The engine firing pulses shall be included in the calculations and their standard steady state harmonics can be used.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleOperations"/>
