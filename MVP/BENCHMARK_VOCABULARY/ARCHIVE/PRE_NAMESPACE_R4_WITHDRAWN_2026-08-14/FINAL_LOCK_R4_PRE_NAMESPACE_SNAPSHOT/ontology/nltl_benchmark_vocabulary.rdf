    <nltl:draftConceptId>VOC-0474</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Mean Daily Low Temperature (MDLT) means the mean value of the daily low temperature for each day of the year over a minimum 10 year period. A data set acceptable to the Administration may be used if 10 years of data is not available.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
