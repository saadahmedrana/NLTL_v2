  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#compressorChargeTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Compressor charge time</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>compressorChargeTime_h</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for compressorChargeTime derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Compressor charge time</skos:prefLabel>
    <nltl:draftConceptId>VOC-0156</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The capacity of the air compressors must be sufficient for charging the air receivers from atmospheric to full pressure in one (1) hour, except for a ship with ice class IA Super, if its propulsion engine has to be reversed for going astern, in which case the compressor must be able to charge the receivers in half an hour.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleOperations"/>
    <nltl:namingBasis>Unit-stripped normalized regulatory variable</nltl:namingBasis>
    <nltl:namingRule>N3 - remove unit from the identifier and retain it in unit/quantity metadata</nltl:namingRule>
    <nltl:quantityKindLabel>Time</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/HR"/>
    <nltl:roleDecisionBasis>Quantity metadata requires the canonical QUDT QuantityValue node pattern</nltl:roleDecisionBasis>
    <nltl:sourceAlias>compressorChargeTime_h</nltl:sourceAlias>
    <nltl:sourceReference>TRF-128 | TRAFICOM p.61 | 7.1</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-128</nltl:sourceRequirementId>
    <nltl:stage1LocalName>compressorChargeTime</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Verified recommended QUDT unit from Stage 1 or a documented Stage 2 source-unit refinement</nltl:unitDecisionStatus>
    <nltl:unitSymbol>h</nltl:unitSymbol>
  </rdf:Description>
