    <nltl:sourceReference>TRF-039 | TRAFICOM p.15 | 4.2.2</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-039</nltl:sourceRequirementId>
    <nltl:stage1LocalName>totalPropulsionPowerForScantlings</nltl:stage1LocalName>
