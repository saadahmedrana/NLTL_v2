    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:quantityKindLabel>Force</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/KiloN"/>
    <nltl:roleDecisionBasis>Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node</nltl:roleDecisionBasis>
    <nltl:sourceAlias>totalGlancingImpactForce</nltl:sourceAlias>
    <nltl:sourceReference>I2-008 | IACS_UR_I2 p.3 | I2.3.1</nltl:sourceReference>
    <nltl:sourceRequirementId>I2-008</nltl:sourceRequirementId>
    <nltl:stage1LocalName>totalGlancingImpactForce</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical benchmark force/load unit</nltl:unitDecisionStatus>
    <nltl:unitSymbol>kN</nltl:unitSymbol>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#outsideIceBeltFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Outside ice belt factor</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>outside_ice_belt_factor</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for outsideIceBeltFactor derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Outside ice belt factor</skos:prefLabel>
    <nltl:draftConceptId>VOC-0525</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The section modulus of a stringer situated outside the ice belt but supporting ice-strengthened frames shall be calculated using Z = f_9*f_10*p*h*l^2/(m*sigma_y)*(1 - h_s/l_s)*10^6 [cm^3] (4.13), and the effective shear area shall be A = sqrt(3)*f_9*f_10*f_11*p*h*l/(2*sigma_y)*(1 - h_s/l_s)*10^4 [cm^2] (4.14). Use p from 4.2.2, h from 4.2.1, p*h = 0.15 MN/m ...</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleHull"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:quantityKindLabel>DimensionlessRatio</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
    <nltl:roleDecisionBasis>Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node</nltl:roleDecisionBasis>
    <nltl:sourceAlias>outside_ice_belt_factor</nltl:sourceAlias>
    <nltl:sourceReference>TRF-054 | TRAFICOM p.22-23 | 4.5.2</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-054</nltl:sourceRequirementId>
    <nltl:stage1LocalName>outsideIceBeltFactor</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical dimensionless unit</nltl:unitDecisionStatus>
    <nltl:unitSymbol>1</nltl:unitSymbol>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#iceLoadCycleCoefficientK2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Ice load cycle coefficient k2</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>k2</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for iceLoadCycleCoefficientK2 derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Ice load cycle coefficient k2</skos:prefLabel>
    <nltl:draftConceptId>VOC-0360</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The number of load cycles per propeller blade in the load spectrum shall be N_ice = k_1*k_2*k_3*N_class*n_n (6.14), where N_class is given in Table 6-6 and the propeller location factor k_1 is given in Table 6-7.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
    <nltl:namingRule>N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase</nltl:namingRule>
    <nltl:quantityKindLabel>DimensionlessRatio</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
    <nltl:roleDecisionBasis>Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node</nltl:roleDecisionBasis>
    <nltl:sourceAlias>k2</nltl:sourceAlias>
    <nltl:sourceReference>TRF-078 | TRAFICOM p.36 | 6.5.1.9; TRF-079 | TRAFICOM p.37 | 6.5.1.9</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-078</nltl:sourceRequirementId>
    <nltl:sourceRequirementId>TRF-079</nltl:sourceRequirementId>
    <nltl:stage1LocalName>iceLoadCycleCoefficientK2</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical dimensionless unit</nltl:unitDecisionStatus>
    <nltl:unitSymbol>1</nltl:unitSymbol>
  </rdf:Description>
