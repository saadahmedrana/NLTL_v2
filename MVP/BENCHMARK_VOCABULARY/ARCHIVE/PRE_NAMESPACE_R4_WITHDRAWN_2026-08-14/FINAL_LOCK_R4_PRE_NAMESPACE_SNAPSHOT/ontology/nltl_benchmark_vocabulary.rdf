    <nltl:sourceRequirementId>TRF-047</nltl:sourceRequirementId>
    <nltl:stage1LocalName>connectionMemberScantling</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
