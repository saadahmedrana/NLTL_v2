    <nltl:roleDecisionBasis>Boolean semantic suffix/word rule</nltl:roleDecisionBasis>
    <nltl:sourceAlias>not_comminuted_or_disinfected</nltl:sourceAlias>
    <nltl:sourceReference>IMO-116 | IMO_POLAR_CODE p.42 | 4.2.1.2</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-116</nltl:sourceRequirementId>
    <nltl:stage1LocalName>notComminutedOrDisinfected</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
