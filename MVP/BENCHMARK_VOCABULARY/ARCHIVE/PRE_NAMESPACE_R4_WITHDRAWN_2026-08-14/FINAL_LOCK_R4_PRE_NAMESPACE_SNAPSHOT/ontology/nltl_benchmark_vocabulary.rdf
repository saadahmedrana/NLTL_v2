  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#requiredIceRemovalMeansPresent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
