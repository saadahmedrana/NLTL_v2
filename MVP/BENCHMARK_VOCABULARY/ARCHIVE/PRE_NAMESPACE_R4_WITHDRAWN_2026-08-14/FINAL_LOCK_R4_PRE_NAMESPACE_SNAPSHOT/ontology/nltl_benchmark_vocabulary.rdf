    <nltl:roleDecisionBasis>Boolean semantic suffix/word rule</nltl:roleDecisionBasis>
    <nltl:sourceAlias>polar_code_applies</nltl:sourceAlias>
    <nltl:sourceReference>IMO-014 | IMO_POLAR_CODE p.14 | 1.3.1</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-014</nltl:sourceRequirementId>
    <nltl:stage1LocalName>polarCodeApplies</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#iceCapabilityMethodologyApplicable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Ice capability methodology applicable</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <skos:altLabel>ice_capability_methodology_applicable</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for iceCapabilityMethodologyApplicable derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Ice capability methodology applicable</skos:prefLabel>
    <nltl:draftConceptId>VOC-0349</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Where applicable, the certificate shall reference a methodology to assess operational capabilities and limitations in ice to the satisfaction of the Administration, taking into account the guidelines developed by the Organization.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleDocuments"/>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
    <nltl:namingRule>N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase</nltl:namingRule>
    <nltl:roleDecisionBasis>Stage 1 explicit boolean</nltl:roleDecisionBasis>
    <nltl:sourceAlias>ice_capability_methodology_applicable</nltl:sourceAlias>
    <nltl:sourceReference>IMO-018 | IMO_POLAR_CODE p.14 | 1.3.7; IMO-026 | IMO_POLAR_CODE p.16 | 2.3.2</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-018</nltl:sourceRequirementId>
    <nltl:sourceRequirementId>IMO-026</nltl:sourceRequirementId>
    <nltl:stage1LocalName>iceCapabilityMethodologyApplicable</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
