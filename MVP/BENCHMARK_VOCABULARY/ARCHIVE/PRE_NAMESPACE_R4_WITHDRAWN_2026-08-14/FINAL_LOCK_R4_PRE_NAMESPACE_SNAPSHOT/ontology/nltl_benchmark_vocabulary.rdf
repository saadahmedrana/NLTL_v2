    <nltl:draftConceptId>VOC-0557</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Discharge of sewage into the sea from category A and B ships constructed on or after 1 January 2017 and all passenger ships constructed on or after 1 January 2017 is prohibited, except when such discharges are in compliance with paragraph 4.2.1.3 of this chapter.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleRegulation"/>
