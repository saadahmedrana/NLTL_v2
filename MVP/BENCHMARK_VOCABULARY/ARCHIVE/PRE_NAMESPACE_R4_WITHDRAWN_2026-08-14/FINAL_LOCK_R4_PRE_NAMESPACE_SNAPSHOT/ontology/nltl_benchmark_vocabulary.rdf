    <nltl:sourceAlias>fire_safety_component</nltl:sourceAlias>
    <nltl:sourceReference>IMO-050 | IMO_POLAR_CODE p.22 | 7.2.1.1; IMO-054 | IMO_POLAR_CODE p.22 | 7.2.2.1</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-050</nltl:sourceRequirementId>
    <nltl:sourceRequirementId>IMO-054</nltl:sourceRequirementId>
    <nltl:stage1LocalName>fireSafetyComponent</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#yieldStrength">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Yield strength</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>sigma_y_N_mm2</skos:altLabel>
    <skos:altLabel>yieldStrength_MPa</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for yieldStrength derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Yield strength</skos:prefLabel>
    <nltl:draftConceptId>VOC-0822</nltl:draftConceptId>
    <nltl:evidenceExcerpt>For transverse framing, the thickness of the shell plating shall be determined by t = 667*s*sqrt(f_1*p_pl/sigma_y) + t_c [mm] (4.5). For longitudinal framing, the thickness shall be determined by t = 667*s*sqrt(p/(f_2*sigma_y)) + t_c [mm] (4.6).</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleMachinery"/>
    <nltl:namingBasis>Unit-stripped normalized regulatory variable</nltl:namingBasis>
    <nltl:namingRule>N3 - remove unit from the identifier and retain it in unit/quantity metadata</nltl:namingRule>
    <nltl:quantityKindLabel>PressureOrStress</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/MegaPA"/>
