  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#designLineLoad">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Design line load</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>design_line_load_MN_m</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for designLineLoad derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Design line load</skos:prefLabel>
    <nltl:draftConceptId>VOC-0194</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The section modulus of a stringer situated within the ice belt shall be calculated using Z = f_6*f_7*p*h*l^2/(m*sigma_y)*10^6 [cm^3] (4.11), and the effective shear area shall be A = sqrt(3)*f_6*f_7*f_8*p*h*l/(2*sigma_y)*10^4 [cm^2] (4.12). Use p from 4.2.2, h from 4.2.1, p*h = 0.15 MN/m when the calculated product is less than 0.15 MN/m, l as stringer span,...</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleHull"/>
    <nltl:namingBasis>Unit-stripped normalized regulatory variable</nltl:namingBasis>
    <nltl:namingRule>N3 - remove unit from the identifier and retain it in unit/quantity metadata</nltl:namingRule>
    <nltl:quantityKindLabel>ForcePerLength</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/KiloN-PER-M"/>
    <nltl:roleDecisionBasis>Quantity metadata requires the canonical QUDT QuantityValue node pattern</nltl:roleDecisionBasis>
    <nltl:sourceAlias>design_line_load_MN_m</nltl:sourceAlias>
    <nltl:sourceReference>TRF-053 | TRAFICOM p.21-22 | 4.5.1; TRF-054 | TRAFICOM p.22-23 | 4.5.2</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-053</nltl:sourceRequirementId>
    <nltl:sourceRequirementId>TRF-054</nltl:sourceRequirementId>
    <nltl:stage1LocalName>designLineLoad</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical line-load unit</nltl:unitDecisionStatus>
    <nltl:unitSymbol>kN/m</nltl:unitSymbol>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#lifeboat">
