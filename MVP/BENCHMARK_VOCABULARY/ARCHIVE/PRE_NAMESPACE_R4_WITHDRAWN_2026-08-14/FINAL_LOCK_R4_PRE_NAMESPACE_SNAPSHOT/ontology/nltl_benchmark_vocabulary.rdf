    <nltl:sourceAlias>serviceLifeLoadDistribution</nltl:sourceAlias>
    <nltl:sourceReference>TRF-106 | TRAFICOM p.48 | 6.6.2.2-6.6.2.3</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-106</nltl:sourceRequirementId>
    <nltl:stage1LocalName>serviceLifeLoadDistribution</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#steeringMechanism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Steering mechanism</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nltl-benchmark/vocab#machineryComponent"/>
