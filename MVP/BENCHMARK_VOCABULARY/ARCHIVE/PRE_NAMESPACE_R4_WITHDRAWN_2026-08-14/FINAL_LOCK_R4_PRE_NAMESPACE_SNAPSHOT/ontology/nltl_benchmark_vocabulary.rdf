  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#webFrameSafetyFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Web frame safety factor</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>webFrameSafetyFactor</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for webFrameSafetyFactor derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Web frame safety factor</skos:prefLabel>
    <nltl:draftConceptId>VOC-0812</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The ice load transferred to a web frame from an ice stringer or from longitudinal framing shall be F = f_12*p*h*S [MN] (4.15). When calculating c_a, use l_a = 2*S. If p*h is less than 0.15 MN/m, use 0.15 MN/m. Use f_12 = 1.8.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleHull"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
