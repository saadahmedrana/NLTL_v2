  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#loadCarryingStringer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Load carrying stringer</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nltl-benchmark/vocab#hullStructure"/>
    <skos:altLabel>loadCarryingStringer</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for loadCarryingStringer derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Load carrying stringer</skos:prefLabel>
    <nltl:draftConceptId>VOC-0421</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Web frames and load-carrying stringers are to be designed to withstand the ice load patch as defined in I2.3. The load patch is to be applied at locations where the capacity of these members under the combined effects of bending and shear is minimised.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleHull"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
