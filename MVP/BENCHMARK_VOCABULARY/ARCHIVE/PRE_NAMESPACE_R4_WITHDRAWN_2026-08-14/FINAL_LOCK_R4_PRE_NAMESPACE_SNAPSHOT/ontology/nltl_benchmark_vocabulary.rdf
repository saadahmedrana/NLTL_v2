    <nltl:sourceReference>TRF-075 | TRAFICOM p.32 | 6.5.1</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-075</nltl:sourceRequirementId>
    <nltl:stage1LocalName>propellerBlade</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#approvalStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Approval status</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <skos:altLabel>approvalStatus</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for approvalStatus derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Approval status</skos:prefLabel>
    <nltl:draftConceptId>VOC-0048</nltl:draftConceptId>
    <nltl:evidenceExcerpt>For an individual ship, in lieu of the Ke or RCH values defined in sections 3.2.2 and 3.2.3, the use of Ke or RCH values based on more precise calculations or values based on model tests may be approved. Such approval will be given on the understanding that it can be revoked if experience of the ship's performance provides grounds for this in practice.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleDocuments"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:roleDecisionBasis>Stage 1 explicit boolean</nltl:roleDecisionBasis>
    <nltl:sourceAlias>approvalStatus</nltl:sourceAlias>
    <nltl:sourceReference>TRF-028 | TRAFICOM p.11 | 3.2.5</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-028</nltl:sourceRequirementId>
    <nltl:stage1LocalName>approvalStatus</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#firefighterOutfit">
