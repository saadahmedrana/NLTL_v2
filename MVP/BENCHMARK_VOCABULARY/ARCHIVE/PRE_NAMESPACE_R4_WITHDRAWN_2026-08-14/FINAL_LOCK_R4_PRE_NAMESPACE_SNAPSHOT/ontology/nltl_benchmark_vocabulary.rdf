    <nltl:sourceAlias>termination_at_that_boundary</nltl:sourceAlias>
    <nltl:sourceReference>TRF-043 | TRAFICOM p.18 | 4.4.1</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-043</nltl:sourceRequirementId>
