    <nltl:roleDecisionBasis>Stage 1 explicit integer</nltl:roleDecisionBasis>
    <nltl:sourceAlias>Nice</nltl:sourceAlias>
    <nltl:sourceAlias>iceLoadCycleCount</nltl:sourceAlias>
