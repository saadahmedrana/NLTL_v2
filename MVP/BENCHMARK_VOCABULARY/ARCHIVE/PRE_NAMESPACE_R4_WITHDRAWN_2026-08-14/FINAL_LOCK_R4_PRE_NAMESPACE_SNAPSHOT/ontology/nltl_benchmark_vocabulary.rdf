    <nltl:roleDecisionBasis>Explicit engineering entity/artifact class set</nltl:roleDecisionBasis>
    <nltl:sourceAlias>longitudinalLocalFrame</nltl:sourceAlias>
    <nltl:sourceReference>I2-034 | IACS_UR_I2 p.13 | I2.7.1</nltl:sourceReference>
    <nltl:sourceRequirementId>I2-034</nltl:sourceRequirementId>
    <nltl:stage1LocalName>longitudinalLocalFrame</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
