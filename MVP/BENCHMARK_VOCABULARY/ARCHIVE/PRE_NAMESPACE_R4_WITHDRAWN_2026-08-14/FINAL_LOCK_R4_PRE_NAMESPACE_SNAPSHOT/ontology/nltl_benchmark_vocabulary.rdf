  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>NLTL benchmark controlled vocabulary</rdfs:label>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-12</dct:created>
    <dct:description>One controlled vocabulary for NL-to-SHACL benchmark inputs. It defines names and value structures but contains no regulatory threshold, formula, applicability outcome, or pass/fail answer logic.</dct:description>
    <owl:versionIRI rdf:resource="https://w3id.org/nltl-benchmark/vocab/2.8.1-dev-batch01-postconfirmation"/>
    <owl:versionInfo>2.14.0-dev-final-stress-gap-closure</owl:versionInfo>
    <nltl:publicationStatus>Stage 2 draft; provisional w3id redirect not yet registered</nltl:publicationStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#sewageDischargeType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Sewage discharge type</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:altLabel>sewage_discharge_type</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for sewageDischargeType derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Sewage discharge type</skos:prefLabel>
    <nltl:draftConceptId>VOC-0661</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The ship is discharging comminuted and disinfected sewage in accordance with regulation 11.1.1 of MARPOL Annex IV at a distance of more than three nautical miles from any ice-shelf or fast ice and shall be as far as practicable from areas of ice concentration exceeding 1/10.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
    <nltl:namingRule>N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase</nltl:namingRule>
    <nltl:roleDecisionBasis>Stage 1 controlled-enumeration string</nltl:roleDecisionBasis>
    <nltl:sourceAlias>sewage_discharge_type</nltl:sourceAlias>
    <nltl:sourceReference>IMO-115 | IMO_POLAR_CODE p.42 | 4.2.1.1; IMO-116 | IMO_POLAR_CODE p.42 | 4.2.1.2</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-115</nltl:sourceRequirementId>
    <nltl:sourceRequirementId>IMO-116</nltl:sourceRequirementId>
    <nltl:stage1LocalName>sewageDischargeType</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#propellerBladeLoss">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Propeller blade loss</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <skos:altLabel>propellerBladeLoss</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for propellerBladeLoss derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Propeller blade loss</skos:prefLabel>
    <nltl:draftConceptId>VOC-0582</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The strength of the propulsion line shall be designed according to the pyramid strength principle. This means that the loss of the propeller blade shall not cause any significant damage to other propeller shaft line components.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleMachinery"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:roleDecisionBasis>Explicit binary applicability/state semantics from the linked requirement</nltl:roleDecisionBasis>
    <nltl:sourceAlias>propellerBladeLoss</nltl:sourceAlias>
    <nltl:sourceReference>TRF-104 | TRAFICOM p.47 | 6.6.1</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-104</nltl:sourceRequirementId>
    <nltl:stage1LocalName>propellerBladeLoss</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
