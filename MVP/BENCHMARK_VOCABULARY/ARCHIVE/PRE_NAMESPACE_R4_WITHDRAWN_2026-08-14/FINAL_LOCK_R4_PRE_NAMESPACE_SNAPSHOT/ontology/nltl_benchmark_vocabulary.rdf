    <nltl:roleDecisionBasis>Quantity metadata requires the canonical QUDT QuantityValue node pattern</nltl:roleDecisionBasis>
    <nltl:sourceAlias>Q_sex_kNm</nltl:sourceAlias>
    <nltl:sourceReference>TRF-102 | TRAFICOM p.46 | 6.5.4.2</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-102</nltl:sourceRequirementId>
    <nltl:stage1LocalName>bladeFailureSpindleTorque</nltl:stage1LocalName>
