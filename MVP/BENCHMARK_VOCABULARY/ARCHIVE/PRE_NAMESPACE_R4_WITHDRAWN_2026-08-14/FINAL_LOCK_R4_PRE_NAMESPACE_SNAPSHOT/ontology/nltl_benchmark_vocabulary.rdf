    <nltl:quantityKindLabel>Mass</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM"/>
    <nltl:roleDecisionBasis>Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node</nltl:roleDecisionBasis>
    <nltl:sourceAlias>waterAddedMass</nltl:sourceAlias>
    <nltl:sourceReference>TRF-120 | TRAFICOM p.60 | 6.6.5.5</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-120</nltl:sourceRequirementId>
