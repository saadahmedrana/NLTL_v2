  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#shellIceStrengtheningExtent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Shell ice strengthening extent</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:altLabel>shellIceStrengtheningExtent</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for shellIceStrengtheningExtent derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Shell ice strengthening extent</skos:prefLabel>
    <nltl:draftConceptId>VOC-0671</nltl:draftConceptId>
    <nltl:evidenceExcerpt>On twin and triple screw ships, the ice strengthening of the shell and framing shall be extended to the tank top 1.5 metres forward and aft of the side propellers.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleHull"/>
