  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#meanBladeMaterialFatigueStrengthInSeawater">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Mean blade material fatigue strength in seawater</rdfs:label>
