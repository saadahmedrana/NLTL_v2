    <nltl:evidenceExcerpt>The engine output shall not be less than that determined by the formula below and in no case less than 1,000 kW for ice class IA, IB and IC, and no less than 2,800 kW for IA Super.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleMachinery"/>
