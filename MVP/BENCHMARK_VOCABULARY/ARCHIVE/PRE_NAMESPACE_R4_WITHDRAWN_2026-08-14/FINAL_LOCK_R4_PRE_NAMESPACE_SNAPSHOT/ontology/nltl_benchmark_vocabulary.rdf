    <nltl:sourceRequirementId>TRF-114</nltl:sourceRequirementId>
    <nltl:stage1LocalName>iceOperatingSpeed</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical maritime linear-speed unit</nltl:unitDecisionStatus>
