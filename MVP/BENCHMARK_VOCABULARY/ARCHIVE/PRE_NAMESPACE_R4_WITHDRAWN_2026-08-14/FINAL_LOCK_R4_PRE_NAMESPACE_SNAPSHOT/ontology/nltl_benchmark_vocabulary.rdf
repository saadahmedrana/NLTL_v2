  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#requiredEquipmentRecords">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Required equipment records</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nltl-benchmark/vocab#documentEvidence"/>
