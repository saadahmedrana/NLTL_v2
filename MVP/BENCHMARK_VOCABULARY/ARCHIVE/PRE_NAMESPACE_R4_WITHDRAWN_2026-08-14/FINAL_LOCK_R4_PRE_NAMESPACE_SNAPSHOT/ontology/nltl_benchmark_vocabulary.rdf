    <nltl:sourceAlias>steeringMechanism</nltl:sourceAlias>
    <nltl:sourceReference>TRF-113 | TRAFICOM p.52 | 6.6.5.1</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-113</nltl:sourceRequirementId>
    <nltl:stage1LocalName>steeringMechanism</nltl:stage1LocalName>
