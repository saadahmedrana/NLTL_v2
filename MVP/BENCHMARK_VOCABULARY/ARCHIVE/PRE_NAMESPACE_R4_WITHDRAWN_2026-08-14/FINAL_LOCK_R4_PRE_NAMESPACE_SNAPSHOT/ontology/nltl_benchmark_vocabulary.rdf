    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/DEG_C"/>
    <nltl:roleDecisionBasis>Quantity metadata requires the canonical QUDT QuantityValue node pattern</nltl:roleDecisionBasis>
    <nltl:sourceAlias>MDLT_degC</nltl:sourceAlias>
    <nltl:sourceReference>IMO-011 | IMO_POLAR_CODE p.13 | 1.2.9</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-011</nltl:sourceRequirementId>
