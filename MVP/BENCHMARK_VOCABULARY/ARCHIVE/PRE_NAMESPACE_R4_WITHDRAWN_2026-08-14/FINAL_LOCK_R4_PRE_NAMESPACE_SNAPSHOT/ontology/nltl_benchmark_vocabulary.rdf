  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#beamTheoryUsed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Beam theory used</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <skos:altLabel>beamTheoryUsed</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for beamTheoryUsed derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Beam theory used</skos:prefLabel>
    <nltl:draftConceptId>VOC-0078</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The acceptance criterion for designs is that the combined stresses from bending and shear, when using the von Mises yield criterion, are lower than the yield point sigmay. When the direct calculation is based on beam theory, the allowable shear stress must be no larger than 0.9*tauy, where tauy = sigmay/sqrt3.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:roleDecisionBasis>Stage 1 explicit boolean</nltl:roleDecisionBasis>
    <nltl:sourceAlias>beamTheoryUsed</nltl:sourceAlias>
    <nltl:sourceReference>TRF-031 | TRAFICOM p.12 | 4.1</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-031</nltl:sourceRequirementId>
    <nltl:stage1LocalName>beamTheoryUsed</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
