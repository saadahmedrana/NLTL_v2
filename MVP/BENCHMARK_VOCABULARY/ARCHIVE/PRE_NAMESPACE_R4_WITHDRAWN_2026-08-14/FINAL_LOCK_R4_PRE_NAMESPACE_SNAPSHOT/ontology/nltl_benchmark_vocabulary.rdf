  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#assessedLowAirTemperature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Assessed low air temperature</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>assessed_low_air_temperature</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for assessedLowAirTemperature derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Assessed low air temperature</skos:prefLabel>
    <nltl:draftConceptId>VOC-0060</nltl:draftConceptId>
    <nltl:evidenceExcerpt>In order to establish procedures or operational limitations, an assessment of the ship and its equipment shall be carried out, taking into consideration the following: the anticipated range of operating and environmental conditions, such as operation in low air temperature, operation in ice, operation in high latitude, and potential for abandonment onto ice ...</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleOperations"/>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
