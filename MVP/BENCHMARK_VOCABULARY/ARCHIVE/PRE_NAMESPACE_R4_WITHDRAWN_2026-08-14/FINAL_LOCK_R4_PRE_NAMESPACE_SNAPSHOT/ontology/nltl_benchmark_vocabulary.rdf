    <nltl:roleDecisionBasis>Quantity metadata requires the canonical QUDT QuantityValue node pattern</nltl:roleDecisionBasis>
    <nltl:sourceAlias>actual_frame_shear_area</nltl:sourceAlias>
    <nltl:sourceReference>TRF-048 | TRAFICOM p.20 | 4.4.3</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-048</nltl:sourceRequirementId>
    <nltl:stage1LocalName>actualFrameShearArea</nltl:stage1LocalName>
    <nltl:stage2UnitEvidence>TRF-048 explicitly gives [cm^2]</nltl:stage2UnitEvidence>
    <nltl:unitDecisionStatus>Verified recommended QUDT unit from Stage 1 or a documented Stage 2 source-unit refinement</nltl:unitDecisionStatus>
    <nltl:unitSymbol>cm^2</nltl:unitSymbol>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#manualInitiation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
