  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#residualStabilityFactorSI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Residual stability factor s i</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>residual_stability_factor_s_i</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for residualStabilityFactorSI derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Residual stability factor s i</skos:prefLabel>
    <nltl:draftConceptId>VOC-0629</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Ships of categories A and B, constructed on or after 1 January 2017, shall be able to withstand flooding resulting from hull penetration due to ice impact. The residual stability following ice damage shall be such that the factor s_i, as defined in SOLAS regulations II-1/7-2.2 and II-1/7-2.3, is equal to one for all loading conditions used to calculate the a...</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
    <nltl:namingRule>N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase</nltl:namingRule>
    <nltl:quantityKindLabel>DimensionlessRatio</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
    <nltl:roleDecisionBasis>Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node</nltl:roleDecisionBasis>
    <nltl:sourceAlias>residual_stability_factor_s_i</nltl:sourceAlias>
    <nltl:sourceReference>IMO-037 | IMO_POLAR_CODE p.19 | 4.3.2.1</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-037</nltl:sourceRequirementId>
    <nltl:stage1LocalName>residualStabilityFactorSI</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical dimensionless unit</nltl:unitDecisionStatus>
    <nltl:unitSymbol>1</nltl:unitSymbol>
  </rdf:Description>
