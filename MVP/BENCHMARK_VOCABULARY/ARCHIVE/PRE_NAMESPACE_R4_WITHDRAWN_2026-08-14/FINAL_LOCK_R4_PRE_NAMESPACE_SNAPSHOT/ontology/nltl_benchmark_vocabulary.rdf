  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#nearbyIceConcentration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Nearby ice concentration</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>nearby_ice_concentration_tenths</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for nearbyIceConcentration derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Nearby ice concentration</skos:prefLabel>
    <nltl:draftConceptId>VOC-0485</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The ship is discharging comminuted and disinfected sewage in accordance with regulation 11.1.1 of MARPOL Annex IV at a distance of more than three nautical miles from any ice-shelf or fast ice and shall be as far as practicable from areas of ice concentration exceeding 1/10.</nltl:evidenceExcerpt>
