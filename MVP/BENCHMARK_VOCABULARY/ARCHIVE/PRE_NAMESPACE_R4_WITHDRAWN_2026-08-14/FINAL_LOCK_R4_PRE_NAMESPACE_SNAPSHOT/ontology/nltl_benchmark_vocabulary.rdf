  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#tankOuterShellSeparation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Tank outer shell separation</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>tank_outer_shell_separation_m</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for tankOuterShellSeparation derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Tank outer shell separation</skos:prefLabel>
    <nltl:draftConceptId>VOC-0748</nltl:draftConceptId>
    <nltl:evidenceExcerpt>For category A and B ships constructed on or after 1 January 2017 all oil residue (sludge) tanks and oily bilge water holding tanks shall be separated from the outer shell by a distance of not less than 0.76 m. This provision does not apply to small tanks with a maximum individual capacity not greater than 30 m^3.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleHull"/>
