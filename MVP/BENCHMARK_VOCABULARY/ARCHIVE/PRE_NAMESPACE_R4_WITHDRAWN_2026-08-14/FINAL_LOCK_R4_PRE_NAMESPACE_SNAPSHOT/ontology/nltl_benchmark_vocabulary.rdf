    <nltl:roleDecisionBasis>Explicit engineering entity/artifact class set</nltl:roleDecisionBasis>
    <nltl:sourceAlias>loadCarryingStringer</nltl:sourceAlias>
    <nltl:sourceReference>I2-037 | IACS_UR_I2 p.13 | I2.8.1; I2-062 | IACS_UR_I2 p.21 | I2.17.2</nltl:sourceReference>
    <nltl:sourceRequirementId>I2-037</nltl:sourceRequirementId>
    <nltl:sourceRequirementId>I2-062</nltl:sourceRequirementId>
    <nltl:stage1LocalName>loadCarryingStringer</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
