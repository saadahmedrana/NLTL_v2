    <nltl:sourceRequirementId>IMO-037</nltl:sourceRequirementId>
    <nltl:stage1LocalName>loadingCondition</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
