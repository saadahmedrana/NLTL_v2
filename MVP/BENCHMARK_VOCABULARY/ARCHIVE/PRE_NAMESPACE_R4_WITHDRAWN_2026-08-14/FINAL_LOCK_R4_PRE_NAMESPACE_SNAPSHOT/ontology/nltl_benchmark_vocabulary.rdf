    <skos:prefLabel xml:lang="en">Not comminuted or disinfected</skos:prefLabel>
    <nltl:draftConceptId>VOC-0500</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The ship is discharging sewage that is not comminuted or disinfected in accordance with regulation 11.1.1 of MARPOL Annex IV and at a distance of more than 12 nautical miles from any ice-shelf or fast ice and shall be as far as practicable from areas of ice concentration exceeding 1/10.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
