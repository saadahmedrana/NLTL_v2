    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:altLabel>Antarctic_area</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for antarcticArea derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Antarctic area</skos:prefLabel>
    <nltl:draftConceptId>VOC-0039</nltl:draftConceptId>
    <nltl:evidenceExcerpt>In the Antarctic area, discharges under regulation 6.1 of MARPOL Annex V shall be as far as practicable from areas of ice concentration exceeding 1/10, but in any case not less than 12 nautical miles from the nearest fast ice; and food waste shall not be discharged onto ice.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:roleDecisionBasis>Controlled/textual category rule</nltl:roleDecisionBasis>
    <nltl:sourceAlias>Antarctic_area</nltl:sourceAlias>
    <nltl:sourceReference>IMO-124 | IMO_POLAR_CODE p.44 | 5.2.2.1-.2</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-124</nltl:sourceRequirementId>
    <nltl:stage1LocalName>antarcticArea</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#iceOrSnowRemovalOrPreventionMeans">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Ice or snow removal or prevention means</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:altLabel>ice_or_snow_removal_or_prevention_means</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for iceOrSnowRemovalOrPreventionMeans derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Ice or snow removal or prevention means</skos:prefLabel>
    <nltl:draftConceptId>VOC-0372</nltl:draftConceptId>
    <nltl:evidenceExcerpt>For ships operating in areas and during periods where ice accretion is likely to occur, means shall be provided to remove or prevent ice and snow accretion around hatches and doors.</nltl:evidenceExcerpt>
