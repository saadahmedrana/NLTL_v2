    <nltl:sourceAlias>ice_or_snow_removal_or_prevention_means</nltl:sourceAlias>
    <nltl:sourceReference>IMO-040 | IMO_POLAR_CODE p.19 | 5.3.1; IMO-052 | IMO_POLAR_CODE p.22 | 7.2.1.4; IMO-066 | IMO_POLAR_CODE p.24 | 8.3.1.1</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-040</nltl:sourceRequirementId>
    <nltl:sourceRequirementId>IMO-052</nltl:sourceRequirementId>
