    <nltl:sourceReference>IMO-081 | IMO_POLAR_CODE p.26 | 9.3.2.1.1; IMO26-007 | IMO_AMEND_2026 p.3 | 9-1.3.2.1.1</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-081</nltl:sourceRequirementId>
