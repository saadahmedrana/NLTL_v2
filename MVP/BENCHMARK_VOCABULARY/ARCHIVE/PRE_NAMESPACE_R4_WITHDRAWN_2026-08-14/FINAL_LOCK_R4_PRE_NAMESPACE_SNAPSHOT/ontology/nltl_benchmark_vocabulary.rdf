    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for upperIceWaterline derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Upper ice waterline</skos:prefLabel>
    <nltl:draftConceptId>VOC-0783</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The upper ice waterline (UIWL) shall be the envelope of the highest points of the waterlines at which the ship is intended to operate in ice. The line may be a broken line.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleHull"/>
