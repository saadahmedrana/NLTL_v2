    <nltl:sourceAlias>contaminated_by_other_garbage</nltl:sourceAlias>
    <nltl:sourceReference>IMO-121 | IMO_POLAR_CODE p.43 | 5.2.1.2</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-121</nltl:sourceRequirementId>
    <nltl:stage1LocalName>contaminatedByOtherGarbage</nltl:stage1LocalName>
