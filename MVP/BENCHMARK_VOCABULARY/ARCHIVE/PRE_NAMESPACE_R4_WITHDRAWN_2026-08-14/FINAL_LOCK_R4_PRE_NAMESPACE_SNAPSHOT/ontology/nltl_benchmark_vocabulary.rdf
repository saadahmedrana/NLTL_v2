    <nltl:roleDecisionBasis>Explicit categorical/target/reference semantics</nltl:roleDecisionBasis>
    <nltl:sourceAlias>assigned_searchlight</nltl:sourceAlias>
    <nltl:sourceReference>IMO-072 | IMO_POLAR_CODE p.25 | 8.3.3.2</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-072</nltl:sourceRequirementId>
    <nltl:stage1LocalName>assignedSearchlight</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#coolingWaterSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cooling water system</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nltl-benchmark/vocab#machineryComponent"/>
