  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#loadPatchApplicationLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Load patch application location</rdfs:label>
