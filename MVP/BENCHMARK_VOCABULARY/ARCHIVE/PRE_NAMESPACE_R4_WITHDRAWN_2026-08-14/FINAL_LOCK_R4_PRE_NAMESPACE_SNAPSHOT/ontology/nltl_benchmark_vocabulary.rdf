  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#longitudinalLocalFrame">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Longitudinal local frame</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nltl-benchmark/vocab#hullStructure"/>
    <skos:altLabel>longitudinalLocalFrame</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for longitudinalLocalFrame derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Longitudinal local frame</skos:prefLabel>
    <nltl:draftConceptId>VOC-0437</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Longitudinal local frames in side structures are to be dimensioned such that the combined effects of shear and bending do not exceed the plastic strength of the member. The plastic strength is defined by the magnitude of midspan load that causes the development of a plastic collapse mechanism.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleHull"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
