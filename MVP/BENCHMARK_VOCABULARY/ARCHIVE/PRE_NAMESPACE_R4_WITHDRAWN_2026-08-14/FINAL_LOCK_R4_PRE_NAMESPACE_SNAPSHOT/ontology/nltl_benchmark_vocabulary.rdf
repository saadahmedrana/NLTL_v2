    <nltl:sourceRequirementId>TRF-129</nltl:sourceRequirementId>
    <nltl:stage1LocalName>coolingWaterSystem</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
