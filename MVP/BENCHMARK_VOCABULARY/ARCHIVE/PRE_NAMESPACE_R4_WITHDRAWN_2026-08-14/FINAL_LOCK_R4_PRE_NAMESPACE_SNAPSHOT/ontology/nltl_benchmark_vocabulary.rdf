  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#deckIcingAllowance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Deck icing allowance</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>deck_icing_allowance_kg_m2</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for deckIcingAllowance derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Deck icing allowance</skos:prefLabel>
    <nltl:draftConceptId>VOC-0186</nltl:draftConceptId>
    <nltl:evidenceExcerpt>For ships operating in areas and during periods where ice accretion is likely to occur, the following icing allowance shall be made in the stability calculations: 30 kg/m^2 on exposed weather decks and gangways; 7.5 kg/m^2 for the projected lateral area of each side of the ship above the water plane; and the projected lateral area of discontinuous surfaces o...</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Unit-stripped normalized regulatory variable</nltl:namingBasis>
    <nltl:namingRule>N3 - remove unit from the identifier and retain it in unit/quantity metadata</nltl:namingRule>
    <nltl:quantityKindLabel>MassPerArea</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-PER-M2"/>
    <nltl:roleDecisionBasis>Quantity metadata requires the canonical QUDT QuantityValue node pattern</nltl:roleDecisionBasis>
    <nltl:sourceAlias>deck_icing_allowance_kg_m2</nltl:sourceAlias>
    <nltl:sourceReference>IMO-033 | IMO_POLAR_CODE p.18 | 4.3.1.1</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-033</nltl:sourceRequirementId>
    <nltl:stage1LocalName>deckIcingAllowance</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Verified recommended QUDT unit from Stage 1 or a documented Stage 2 source-unit refinement</nltl:unitDecisionStatus>
    <nltl:unitSymbol>kg/m^2</nltl:unitSymbol>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#icePressure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Ice pressure</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>icePressure</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for icePressure derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Ice pressure</skos:prefLabel>
    <nltl:draftConceptId>VOC-0373</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The ice load transferred to a web frame from an ice stringer or from longitudinal framing shall be F = f_12*p*h*S [MN] (4.15). When calculating c_a, use l_a = 2*S. If p*h is less than 0.15 MN/m, use 0.15 MN/m. Use f_12 = 1.8.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Verified exact implementation term</nltl:namingBasis>
    <nltl:namingRule>N1 - reuse only after exact URI and semantic-context verification</nltl:namingRule>
    <nltl:quantityKindLabel>PressureOrStress</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/MegaPA"/>
    <nltl:roleDecisionBasis>Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node</nltl:roleDecisionBasis>
    <nltl:sourceAlias>icePressure</nltl:sourceAlias>
    <nltl:sourceReference>TRF-057 | TRAFICOM p.23 | 4.6.1</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-057</nltl:sourceRequirementId>
    <nltl:stage1LocalName>icePressure</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical benchmark stress/pressure unit</nltl:unitDecisionStatus>
    <nltl:unitSymbol>MPa</nltl:unitSymbol>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#independentTransducerCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Independent transducer count</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
