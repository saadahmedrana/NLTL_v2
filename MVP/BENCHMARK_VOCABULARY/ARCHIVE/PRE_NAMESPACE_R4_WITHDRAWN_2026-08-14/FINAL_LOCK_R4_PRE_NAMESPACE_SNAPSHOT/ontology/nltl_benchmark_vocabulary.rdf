  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#polarServiceTemperature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Polar service temperature</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>PST_degC</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for polarServiceTemperature derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Polar service temperature</skos:prefLabel>
    <nltl:draftConceptId>VOC-0561</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Polar Service Temperature (PST) means a temperature specified for a ship which is intended to operate in low air temperature, which shall be set at least 10 deg C below the lowest MDLT for the intended area and season of operation in polar waters.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleTests"/>
