  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#assessedIceOperation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Assessed ice operation</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <skos:altLabel>assessed_ice_operation</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for assessedIceOperation derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
