  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#shaftLineComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Shaft line component</rdfs:label>
