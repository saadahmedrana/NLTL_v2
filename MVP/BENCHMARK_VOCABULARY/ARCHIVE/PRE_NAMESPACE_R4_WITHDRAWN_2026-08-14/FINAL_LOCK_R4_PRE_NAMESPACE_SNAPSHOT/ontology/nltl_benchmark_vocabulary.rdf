  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#assignedSearchlight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Assigned searchlight</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:altLabel>assigned_searchlight</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for assignedSearchlight derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Assigned searchlight</skos:prefLabel>
    <nltl:draftConceptId>VOC-0063</nltl:draftConceptId>
    <nltl:evidenceExcerpt>For ships intended to operate in extended periods of darkness, searchlights suitable for continuous use to facilitate identification of ice shall be provided for each lifeboat.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
