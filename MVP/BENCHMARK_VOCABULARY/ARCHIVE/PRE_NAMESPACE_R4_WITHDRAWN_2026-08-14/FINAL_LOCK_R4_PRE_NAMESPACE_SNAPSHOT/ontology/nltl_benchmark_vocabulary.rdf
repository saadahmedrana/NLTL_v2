  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#allowableShearStress">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Allowable shear stress</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>allowableShearStress</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for allowableShearStress derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Allowable shear stress</skos:prefLabel>
    <nltl:draftConceptId>VOC-0029</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The acceptance criterion for designs is that the combined stresses from bending and shear, when using the von Mises yield criterion, are lower than the yield point sigmay. When the direct calculation is based on beam theory, the allowable shear stress must be no larger than 0.9*tauy, where tauy = sigmay/sqrt3.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:quantityKindLabel>PressureOrStress</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/MegaPA"/>
    <nltl:roleDecisionBasis>Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node</nltl:roleDecisionBasis>
    <nltl:sourceAlias>allowableShearStress</nltl:sourceAlias>
    <nltl:sourceReference>TRF-031 | TRAFICOM p.12 | 4.1</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-031</nltl:sourceRequirementId>
    <nltl:stage1LocalName>allowableShearStress</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical benchmark stress/pressure unit</nltl:unitDecisionStatus>
    <nltl:unitSymbol>MPa</nltl:unitSymbol>
  </rdf:Description>
