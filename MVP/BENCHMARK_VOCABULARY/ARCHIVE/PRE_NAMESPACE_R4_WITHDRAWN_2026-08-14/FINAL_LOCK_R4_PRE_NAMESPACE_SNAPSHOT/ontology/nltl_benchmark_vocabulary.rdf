    <nltl:roleDecisionBasis>Boolean semantic suffix/word rule</nltl:roleDecisionBasis>
    <nltl:sourceAlias>ship_ice_strengthened</nltl:sourceAlias>
    <nltl:sourceReference>IMO-028 | IMO_POLAR_CODE p.16 | 2.3.4; IMO-032 | IMO_POLAR_CODE p.17 | 3.3.2.1-.3; IMO-049 | IMO_POLAR_CODE p.21 | 6.3.3.1-.3; IMO-081 | IMO_POLAR_CODE p.26 | 9.3.2.1.1; IMO26-007 | IMO_AMEND_2026 p.3 | 9-1.3.2.1.1</nltl:sourceReference>
