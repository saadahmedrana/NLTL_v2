  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#requiredShearArea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Required shear area</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>A_required_cm2</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for aRequiredCm2 derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Required shear area</skos:prefLabel>
    <nltl:draftConceptId>VOC-0053</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The section modulus of a web frame shall be calculated using Z = (M/sigma_y)*sqrt(1/(1 - (gamma*A/A_a)^2))*10^6 [cm^3] (4.17), where M is the maximum calculated bending moment under ice load F and shall be M = 0.193*F*L, gamma is selected from Table 4-8, A is the required shear area, and A_a = A_f + A_w is the actual cross-sectional area of the web frame.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:quantityKindLabel>Area</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/CentiM2"/>
    <nltl:roleDecisionBasis>Quantity metadata requires the canonical QUDT QuantityValue node pattern</nltl:roleDecisionBasis>
    <nltl:sourceAlias>A_required_cm2</nltl:sourceAlias>
    <nltl:sourceReference>TRF-060 | TRAFICOM p.24 | 4.6.2</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-060</nltl:sourceRequirementId>
    <nltl:stage1LocalName>aRequiredCm2</nltl:stage1LocalName>
    <nltl:stage2UnitEvidence>TRF-060 defines A as required shear area in the [cm^2] equation</nltl:stage2UnitEvidence>
    <nltl:unitDecisionStatus>Verified recommended QUDT unit from Stage 1 or a documented Stage 2 source-unit refinement</nltl:unitDecisionStatus>
    <nltl:unitSymbol>cm^2</nltl:unitSymbol>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#bowSubregionWaterlineAngle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Bow subregion waterline angle</rdfs:label>
