    <rdfs:label xml:lang="en">Assessed code hazards</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <skos:altLabel>assessed_code_hazards</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for assessedCodeHazards derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Assessed code hazards</skos:prefLabel>
    <nltl:draftConceptId>VOC-0057</nltl:draftConceptId>
    <nltl:evidenceExcerpt>In order to establish procedures or operational limitations, an assessment of the ship and its equipment shall be carried out, taking into consideration the following: the anticipated range of operating and environmental conditions, such as operation in low air temperature, operation in ice, operation in high latitude, and potential for abandonment onto ice ...</nltl:evidenceExcerpt>
