  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#iceBeltLowerLimit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Ice belt lower limit</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:altLabel>iceBeltLowerLimit</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for iceBeltLowerLimit derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Ice belt lower limit</skos:prefLabel>
    <nltl:draftConceptId>VOC-0345</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The lower end of the strengthened part of a main frame and of an intermediate ice frame shall be attached to a deck, top or bottom plating of a tank, tank top or an ice stringer (section 4.5). Where an intermediate frame terminates below a deck, top or bottom plating of a tank, tank top or ice stringer which is situated at or below the lower limit of the ice...</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:roleDecisionBasis>Conservative textual scalar fallback</nltl:roleDecisionBasis>
    <nltl:sourceAlias>iceBeltLowerLimit</nltl:sourceAlias>
    <nltl:sourceReference>TRF-047 | TRAFICOM p.20 | 4.4.2.3</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-047</nltl:sourceRequirementId>
    <nltl:stage1LocalName>iceBeltLowerLimit</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
