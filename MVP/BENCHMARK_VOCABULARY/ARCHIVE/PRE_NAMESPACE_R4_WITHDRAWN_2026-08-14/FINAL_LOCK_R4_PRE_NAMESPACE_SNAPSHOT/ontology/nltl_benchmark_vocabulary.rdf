  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#flareAngle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Flare angle</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>psi</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for flareAngle derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Flare angle</skos:prefLabel>
    <nltl:draftConceptId>VOC-0272</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Coefficients f_1-f_4 and g_1-g_3 are given in Table 3-2. C_3 = 845 kg/(m^2*s^2), C_4 = 42 kg/(m^2*s^2), C_5 = 825 kg/s^2. psi = atan(tan(phi_2)/sin(alpha)). If the value of the term ((L*T)/B^2)^3 is less than 5, the value 5 shall be used; if the value is more than 20, the value 20 shall be used.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Verified exact implementation term</nltl:namingBasis>
    <nltl:namingRule>N1 - reuse only after exact URI and semantic-context verification</nltl:namingRule>
    <nltl:quantityKindLabel>Angle</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/DEG"/>
    <nltl:roleDecisionBasis>Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node</nltl:roleDecisionBasis>
    <nltl:sourceAlias>psi</nltl:sourceAlias>
    <nltl:sourceReference>TRF-022 | TRAFICOM p.10 | 3.2.2; TRF-061 | TRAFICOM p.25 | 4.7</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-022</nltl:sourceRequirementId>
    <nltl:sourceRequirementId>TRF-061</nltl:sourceRequirementId>
    <nltl:stage1LocalName>flareAngle</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical benchmark plane-angle unit</nltl:unitDecisionStatus>
    <nltl:unitSymbol>deg</nltl:unitSymbol>
  </rdf:Description>
