    <nltl:roleDecisionBasis>Boolean semantic suffix/word rule</nltl:roleDecisionBasis>
    <nltl:sourceAlias>voyage_planning_topic_coverage</nltl:sourceAlias>
    <nltl:sourceReference>IMO-101 | IMO_POLAR_CODE p.29-30 | 11.3.1-11.3.9; IMO26-018 | IMO_AMEND_2026 p.6 | 11-1.3.1-11-1.3.9</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-101</nltl:sourceRequirementId>
    <nltl:sourceRequirementId>IMO26-018</nltl:sourceRequirementId>
