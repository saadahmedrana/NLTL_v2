    <nltl:roleDecisionBasis>Controlled/textual category rule</nltl:roleDecisionBasis>
    <nltl:sourceAlias>certificate_language</nltl:sourceAlias>
    <nltl:sourceReference>IMO-016 | IMO_POLAR_CODE p.14 | 1.3.5</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-016</nltl:sourceRequirementId>
    <nltl:stage1LocalName>certificateLanguage</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
