    <nltl:roleDecisionBasis>Explicit count/cycle semantics</nltl:roleDecisionBasis>
    <nltl:sourceAlias>equivalentStressCycles</nltl:sourceAlias>
    <nltl:sourceReference>TRF-106 | TRAFICOM p.48 | 6.6.2.2-6.6.2.3</nltl:sourceReference>
