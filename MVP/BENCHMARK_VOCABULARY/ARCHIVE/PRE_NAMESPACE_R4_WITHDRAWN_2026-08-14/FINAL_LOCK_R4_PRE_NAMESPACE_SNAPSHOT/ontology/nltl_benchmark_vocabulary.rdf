    <skos:prefLabel xml:lang="en">Blade reference strength2</skos:prefLabel>
    <nltl:draftConceptId>VOC-0094</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The calculated blade stresses must satisfy sigma_ref2/sigma_st &gt;= 1.3 (6.39). If finite element analysis is used for estimating the stresses, von Mises stresses shall be used. sigma_ref2 is the reference strength, defined as the lower of 0.7*sigma_u and 0.6*sigma_0.2 + 0.4*sigma_u. The fatigue design of the propeller blade is based on an estimated load distr...</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Unit-stripped normalized regulatory variable</nltl:namingBasis>
    <nltl:namingRule>N3 - remove unit from the identifier and retain it in unit/quantity metadata</nltl:namingRule>
    <nltl:quantityKindLabel>PressureOrStress</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/MegaPA"/>
    <nltl:roleDecisionBasis>Quantity metadata requires the canonical QUDT QuantityValue node pattern</nltl:roleDecisionBasis>
    <nltl:sourceAlias>sigmaRef2_MPa</nltl:sourceAlias>
    <nltl:sourceAlias>sigma_ref2_MPa</nltl:sourceAlias>
    <nltl:sourceReference>TRF-106 | TRAFICOM p.48 | 6.6.2.2-6.6.2.3</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-106</nltl:sourceRequirementId>
    <nltl:stage1LocalName>bladeReferenceStrength2</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Verified recommended QUDT unit from Stage 1 or a documented Stage 2 source-unit refinement</nltl:unitDecisionStatus>
    <nltl:unitSymbol>MPa</nltl:unitSymbol>
  </rdf:Description>
