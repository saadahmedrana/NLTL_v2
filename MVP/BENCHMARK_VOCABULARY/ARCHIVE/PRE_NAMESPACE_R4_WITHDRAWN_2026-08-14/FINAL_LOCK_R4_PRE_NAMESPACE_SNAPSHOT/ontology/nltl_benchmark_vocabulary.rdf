    <nltl:draftConceptId>VOC-0611</nltl:draftConceptId>
    <nltl:evidenceExcerpt>sigma_fl is calculated from gamma_e1, gamma_e2, gamma_v, gamma_m and sigma_exp. [TRAFICOM, p.50-51, 6.6.2.3-6.6.2.4]</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
