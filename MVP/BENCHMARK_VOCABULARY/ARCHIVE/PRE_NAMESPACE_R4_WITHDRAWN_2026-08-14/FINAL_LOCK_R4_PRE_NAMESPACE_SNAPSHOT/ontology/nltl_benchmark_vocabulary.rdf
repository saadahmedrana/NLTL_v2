  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#strutHullAttachmentEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Strut hull attachment evidence</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nltl-benchmark/vocab#documentEvidence"/>
    <skos:altLabel>strutHullAttachmentEvidence</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for strutHullAttachmentEvidence derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Strut hull attachment evidence</skos:prefLabel>
    <nltl:draftConceptId>VOC-0733</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The shafting and stern tubes of side propellers shall normally be enclosed within plated bossings. If detached struts are used, due consideration shall be taken of their design, strength and attachments to the hull.</nltl:evidenceExcerpt>
