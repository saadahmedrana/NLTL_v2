  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#contaminatedByOtherGarbage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Contaminated by other garbage</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <skos:altLabel>contaminated_by_other_garbage</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for contaminatedByOtherGarbage derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Contaminated by other garbage</skos:prefLabel>
    <nltl:draftConceptId>VOC-0166</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Food wastes shall be comminuted or ground and shall be capable of passing through a screen with openings no greater than 25 mm. Food wastes shall not be contaminated by any other garbage type.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
