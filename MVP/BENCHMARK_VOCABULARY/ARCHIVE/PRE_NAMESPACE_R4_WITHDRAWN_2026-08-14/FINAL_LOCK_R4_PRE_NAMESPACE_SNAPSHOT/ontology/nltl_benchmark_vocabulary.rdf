    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:altLabel>non_magnetic_heading_means_count</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for nonMagneticHeadingMeansCount derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Non magnetic heading means count</skos:prefLabel>
    <nltl:draftConceptId>VOC-0496</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Ships shall have two non-magnetic means to determine and display their heading. Both means shall be independent and shall be connected to the ship's main and emergency source of power.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
