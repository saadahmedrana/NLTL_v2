    <nltl:roleDecisionBasis>Explicit engineering entity/artifact class set</nltl:roleDecisionBasis>
    <nltl:sourceAlias>shaftComponent</nltl:sourceAlias>
    <nltl:sourceReference>TRF-112 | TRAFICOM p.52 | 6.6.4.1</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-112</nltl:sourceRequirementId>
    <nltl:stage1LocalName>shaftComponent</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
