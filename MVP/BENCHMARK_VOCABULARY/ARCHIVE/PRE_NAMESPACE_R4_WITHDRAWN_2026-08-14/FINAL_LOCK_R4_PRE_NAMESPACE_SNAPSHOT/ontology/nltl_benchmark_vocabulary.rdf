  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#bladeFailureSpindleTorque">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Blade failure spindle torque</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
