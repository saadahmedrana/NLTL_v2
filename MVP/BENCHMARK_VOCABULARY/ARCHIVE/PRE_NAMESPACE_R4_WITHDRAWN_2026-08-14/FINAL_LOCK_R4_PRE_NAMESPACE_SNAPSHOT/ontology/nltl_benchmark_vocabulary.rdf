  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#bladeIceLoad">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Blade ice load</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>bladeIceLoad</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for bladeIceLoad derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Blade ice load</skos:prefLabel>
    <nltl:draftConceptId>VOC-0085</nltl:draftConceptId>
    <nltl:evidenceExcerpt>where k is the shape parameter of the spectrum, Nice is the number of load cycles in the spectrum, and Fice is the random variable for ice loads on the blade, 0 &lt;= Fice &lt;= (Fice)max. The shape parameter k=0.75 shall be used for the ice force distribution of an open propeller and the shape parameter k=1.0 for that of a ducted propeller blade.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:quantityKindLabel>Force</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/KiloN"/>
    <nltl:roleDecisionBasis>Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node</nltl:roleDecisionBasis>
    <nltl:sourceAlias>bladeIceLoad</nltl:sourceAlias>
    <nltl:sourceReference>TRF-077 | TRAFICOM p.36 | 6.5.1.8</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-077</nltl:sourceRequirementId>
    <nltl:stage1LocalName>bladeIceLoad</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical benchmark force/load unit</nltl:unitDecisionStatus>
    <nltl:unitSymbol>kN</nltl:unitSymbol>
  </rdf:Description>
