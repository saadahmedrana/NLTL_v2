  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#constructionDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Construction date</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <skos:altLabel>construction_date</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for constructionDate derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Construction date</skos:prefLabel>
    <nltl:draftConceptId>VOC-0162</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Ships of categories A and B, constructed on or after 1 January 2017, shall be able to withstand flooding resulting from hull penetration due to ice impact. The residual stability following ice damage shall be such that the factor s_i, as defined in SOLAS regulations II-1/7-2.2 and II-1/7-2.3, is equal to one for all loading conditions used to calculate the a...</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleTests"/>
