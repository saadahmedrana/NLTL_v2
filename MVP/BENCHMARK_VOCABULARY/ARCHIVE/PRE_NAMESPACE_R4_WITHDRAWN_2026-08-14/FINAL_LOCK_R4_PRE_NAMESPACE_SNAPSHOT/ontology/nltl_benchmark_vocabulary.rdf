    <skos:prefLabel xml:lang="en">Polar code applies</skos:prefLabel>
    <nltl:draftConceptId>VOC-0551</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Every ship to which this Code applies shall have on board a valid Polar Ship Certificate.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleRegulation"/>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
