  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#coefficientG2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Coefficient g2</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>coefficientG2</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for coefficientG2 derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Coefficient g2</skos:prefLabel>
    <nltl:draftConceptId>VOC-0145</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Coefficients f_1-f_4 and g_1-g_3 are given in Table 3-3. C_3 = 460 kg/(m^2*s^2), C_4 = 18.7 kg/(m^2*s^2), C_5 = 825 kg/s^2. If the value of the term ((L*T)/B^2)^3 is less than 5, the value 5 shall be used; if the value is more than 20, the value 20 shall be used.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:quantityKindLabel>DimensionlessRatio</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/N-PER-M"/>
    <nltl:roleDecisionBasis>Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node</nltl:roleDecisionBasis>
    <nltl:sourceAlias>coefficientG2</nltl:sourceAlias>
    <nltl:sourceReference>TRF-027 | TRAFICOM p.11 | 3.2.4</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-027</nltl:sourceRequirementId>
    <nltl:stage1LocalName>coefficientG2</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>PDF-verified Batch 01 development correction from TRAFICOM Tables 3-2/3-3; R2 remains unchanged.</nltl:unitDecisionStatus>
    <nltl:unitSymbol>1</nltl:unitSymbol>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#polarOperationCoverage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Polar operation coverage</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <skos:altLabel>polar_operation_coverage</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for polarOperationCoverage derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Polar operation coverage</skos:prefLabel>
    <nltl:draftConceptId>VOC-0559</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Operation in polar waters shall be taken into account, as appropriate, in the Oil Record Books, manuals and the shipboard oil pollution emergency plan or the shipboard marine pollution emergency plan as required by MARPOL Annex I.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleOperations"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
