  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#gaugeLength">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Gauge length</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>gauge_length</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for gaugeLength derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Gauge length</skos:prefLabel>
    <nltl:draftConceptId>VOC-0312</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The materials of components exposed to sea water, such as propeller blades, propeller hubs, and thruster body, shall have an elongation of no less than 15% in a test specimen, the gauge length of which is five times the diameter. A Charpy V impact test shall be carried out for materials other than bronze and austenitic steel. An average impact energy value o...</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleTests"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:quantityKindLabel>Length</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/M"/>
    <nltl:roleDecisionBasis>Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node</nltl:roleDecisionBasis>
    <nltl:sourceAlias>gauge_length</nltl:sourceAlias>
    <nltl:sourceReference>TRF-072 | TRAFICOM p.31 | 6.4.1</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-072</nltl:sourceRequirementId>
    <nltl:stage1LocalName>gaugeLength</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical benchmark length unit</nltl:unitDecisionStatus>
    <nltl:unitSymbol>m</nltl:unitSymbol>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#webFrameIceLoad">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Web frame ice load</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>webFrameIceLoad</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for webFrameIceLoad derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Web frame ice load</skos:prefLabel>
    <nltl:draftConceptId>VOC-0811</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The ice load transferred to a web frame from an ice stringer or from longitudinal framing shall be F = f_12*p*h*S [MN] (4.15). When calculating c_a, use l_a = 2*S. If p*h is less than 0.15 MN/m, use 0.15 MN/m. Use f_12 = 1.8.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleHull"/>
    <nltl:namingBasis>Verified exact implementation term</nltl:namingBasis>
    <nltl:namingRule>N1 - reuse only after exact URI and semantic-context verification</nltl:namingRule>
    <nltl:quantityKindLabel>Force</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/KiloN"/>
    <nltl:roleDecisionBasis>Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node</nltl:roleDecisionBasis>
    <nltl:sourceAlias>webFrameIceLoad</nltl:sourceAlias>
    <nltl:sourceReference>TRF-057 | TRAFICOM p.23 | 4.6.1</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-057</nltl:sourceRequirementId>
    <nltl:stage1LocalName>webFrameIceLoad</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical benchmark force/load unit</nltl:unitDecisionStatus>
    <nltl:unitSymbol>kN</nltl:unitSymbol>
  </rdf:Description>
