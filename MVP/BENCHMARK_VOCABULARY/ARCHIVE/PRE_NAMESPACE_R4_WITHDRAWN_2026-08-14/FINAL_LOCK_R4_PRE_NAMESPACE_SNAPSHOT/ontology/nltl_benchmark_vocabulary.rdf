    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:quantityKindLabel>Velocity</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/KN"/>
    <nltl:roleDecisionBasis>Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node</nltl:roleDecisionBasis>
    <nltl:sourceAlias>maximumOperatingSpeed</nltl:sourceAlias>
    <nltl:sourceReference>TRF-089 | TRAFICOM p.39 | 6.5.3.4</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-089</nltl:sourceRequirementId>
    <nltl:stage1LocalName>maximumOperatingSpeed</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical maritime linear-speed unit</nltl:unitDecisionStatus>
