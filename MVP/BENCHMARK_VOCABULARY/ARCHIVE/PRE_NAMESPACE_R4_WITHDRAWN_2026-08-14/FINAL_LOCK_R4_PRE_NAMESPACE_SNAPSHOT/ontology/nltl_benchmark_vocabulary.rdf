  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#minimumLineLoad">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Minimum line load</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:altLabel>minimumLineLoad</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for minimumLineLoad derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Minimum line load</skos:prefLabel>
    <nltl:draftConceptId>VOC-0480</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The ice load transferred to a web frame from an ice stringer or from longitudinal framing shall be F = f_12*p*h*S [MN] (4.15). When calculating c_a, use l_a = 2*S. If p*h is less than 0.15 MN/m, use 0.15 MN/m. Use f_12 = 1.8.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleCore"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:quantityKindLabel>ForcePerLength</nltl:quantityKindLabel>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/KiloN-PER-M"/>
    <nltl:roleDecisionBasis>Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node</nltl:roleDecisionBasis>
    <nltl:sourceAlias>minimumLineLoad</nltl:sourceAlias>
    <nltl:sourceReference>TRF-057 | TRAFICOM p.23 | 4.6.1</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-057</nltl:sourceRequirementId>
    <nltl:stage1LocalName>minimumLineLoad</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical line-load unit</nltl:unitDecisionStatus>
    <nltl:unitSymbol>kN/m</nltl:unitSymbol>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#mcrBollardCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">MCR bollard condition</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:altLabel>mcrBollardCondition</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for mcrBollardCondition derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">MCR bollard condition</skos:prefLabel>
    <nltl:draftConceptId>VOC-0470</nltl:draftConceptId>
    <nltl:evidenceExcerpt>Time domain calculations shall be calculated for the MCR condition, MCR bollard conditions and for blade order resonant rotational speeds so that the resonant vibration responses can be obtained.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleMachinery"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:roleDecisionBasis>Stage 1 controlled-enumeration string</nltl:roleDecisionBasis>
    <nltl:sourceAlias>mcrBollardCondition</nltl:sourceAlias>
