  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#voyagePlanningTopicCoverage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Voyage planning topic coverage</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nltl-benchmark/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <skos:altLabel>voyage_planning_topic_coverage</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for voyagePlanningTopicCoverage derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Voyage planning topic coverage</skos:prefLabel>
    <nltl:draftConceptId>VOC-0803</nltl:draftConceptId>
    <nltl:evidenceExcerpt>The master shall consider a route through polar waters, taking into account the following: the procedures required by the PWOM; any limitations of the hydrographic information and aids to navigation available; current information on the extent and type of ice and icebergs in the vicinity of the intended route; statistical information on ice and temperatures ...</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleOperations"/>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
