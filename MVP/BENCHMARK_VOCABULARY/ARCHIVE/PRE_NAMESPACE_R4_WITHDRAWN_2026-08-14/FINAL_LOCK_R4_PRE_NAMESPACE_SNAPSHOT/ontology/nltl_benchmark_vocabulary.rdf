  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#alternativeCalculationEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Alternative calculation evidence</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nltl-benchmark/vocab#documentEvidence"/>
    <skos:altLabel>alternativeCalculationEvidence</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for alternativeCalculationEvidence derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Alternative calculation evidence</skos:prefLabel>
    <nltl:draftConceptId>VOC-0034</nltl:draftConceptId>
    <nltl:evidenceExcerpt>For an individual ship, in lieu of the Ke or RCH values defined in sections 3.2.2 and 3.2.3, the use of Ke or RCH values based on more precise calculations or values based on model tests may be approved. Such approval will be given on the understanding that it can be revoked if experience of the ship's performance provides grounds for this in practice.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleDocuments"/>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:roleDecisionBasis>Explicit engineering entity/artifact class set</nltl:roleDecisionBasis>
    <nltl:sourceAlias>alternativeCalculationEvidence</nltl:sourceAlias>
    <nltl:sourceReference>TRF-028 | TRAFICOM p.11 | 3.2.5</nltl:sourceReference>
    <nltl:sourceRequirementId>TRF-028</nltl:sourceRequirementId>
    <nltl:stage1LocalName>alternativeCalculationEvidence</nltl:stage1LocalName>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
  </rdf:Description>
