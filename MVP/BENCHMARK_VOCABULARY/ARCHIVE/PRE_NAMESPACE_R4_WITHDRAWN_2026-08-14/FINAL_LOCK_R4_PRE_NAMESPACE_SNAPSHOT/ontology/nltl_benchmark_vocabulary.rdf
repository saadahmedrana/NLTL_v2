    <nltl:sourceAlias>Qsmax_kNm</nltl:sourceAlias>
    <nltl:sourceReference>TRF-102 | TRAFICOM p.46 | 6.5.4.2; TRF-103 | TRAFICOM p.46 | 6.5.4.2</nltl:sourceReference>
