  <rdf:Description rdf:about="https://w3id.org/nltl-benchmark/vocab#fireSafetyComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fire safety component</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nltl-benchmark/vocab#machineryComponent"/>
    <skos:altLabel>fire_safety_component</skos:altLabel>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for fireSafetyComponent derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <skos:prefLabel xml:lang="en">Fire safety component</skos:prefLabel>
    <nltl:draftConceptId>VOC-0268</nltl:draftConceptId>
    <nltl:evidenceExcerpt>All components of fire safety systems and appliances if installed in exposed positions shall be protected from ice accretion and snow accumulation.</nltl:evidenceExcerpt>
    <nltl:module rdf:resource="https://w3id.org/nltl-benchmark/vocab#moduleTests"/>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
