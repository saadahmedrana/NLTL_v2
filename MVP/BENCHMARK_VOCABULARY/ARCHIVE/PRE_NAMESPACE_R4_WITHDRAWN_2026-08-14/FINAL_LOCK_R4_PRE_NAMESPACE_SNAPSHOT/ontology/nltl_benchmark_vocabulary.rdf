    <nltl:sourceAlias>assessed_ice_operation</nltl:sourceAlias>
    <nltl:sourceReference>IMO-021 | IMO_POLAR_CODE p.15 | 1.5</nltl:sourceReference>
    <nltl:sourceRequirementId>IMO-021</nltl:sourceRequirementId>
