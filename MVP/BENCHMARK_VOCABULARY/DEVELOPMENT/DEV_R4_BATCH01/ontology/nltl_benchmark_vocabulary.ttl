nltl:designVerticalIceShearForce a owl:ObjectProperty ;
    rdfs:label "Design vertical ice shear force"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "designVerticalIceShearForce" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for designVerticalIceShearForce derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Design vertical ice shear force"@en ;
    nltl:draftConceptId "VOC-0197" ;
    nltl:evidenceExcerpt "The design vertical ice shear force, FI, along the hull girder is to be taken as: FI = Cf * FIB [MN] where Cf = longitudinal distribution factor to be taken as follows: (a) Positive shear force Cf = 0.0 between the aft end of LUI and 0.6LUI from aft Cf = 1.0 between 0.9 LUI from aft and the forward end of LUI" ;
    nltl:module nltl:moduleHull ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:quantityKindLabel "Force" ;
    nltl:recommendedUnit unit:KiloN ;
    nltl:roleDecisionBasis "Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node" ;
    nltl:sourceAlias "designVerticalIceShearForce" ;
    nltl:sourceReference "I2-051 | IACS_UR_I2 p.19 | I2.13.3.1; I2-053 | IACS_UR_I2 p.20 | I2.13.3.2" ;
    nltl:sourceRequirementId "I2-051",
        "I2-053" ;
    nltl:stage1LocalName "designVerticalIceShearForce" ;
    nltl:unitDecisionStatus "Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical benchmark force/load unit" ;
    nltl:unitSymbol "kN" .

