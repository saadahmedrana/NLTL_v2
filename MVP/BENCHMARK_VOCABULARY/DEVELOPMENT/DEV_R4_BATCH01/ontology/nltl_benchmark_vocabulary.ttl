        "sigma_st",
        "sigma_st_MPa" ;
    nltl:sourceReference "TRF-105 | TRAFICOM p.47 | 6.6.2.1; TRF-106 | TRAFICOM p.48 | 6.6.2.2-6.6.2.3" ;
