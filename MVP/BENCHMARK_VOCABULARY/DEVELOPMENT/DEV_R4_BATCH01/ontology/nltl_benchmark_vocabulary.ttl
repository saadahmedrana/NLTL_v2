    skos:prefLabel "Polar service temperature"@en ;
    nltl:draftConceptId "VOC-0561" ;
    nltl:evidenceExcerpt "Polar Service Temperature (PST) means a temperature specified for a ship which is intended to operate in low air temperature, which shall be set at least 10 deg C below the lowest MDLT for the intended area and season of operation in polar waters." ;
