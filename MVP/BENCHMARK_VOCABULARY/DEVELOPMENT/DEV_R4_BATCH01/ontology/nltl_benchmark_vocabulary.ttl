    nltl:sourceAlias "airReceiverCapacity_Nm3" ;
    nltl:sourceReference "TRF-126 | TRAFICOM p.61 | 7.1; TRF-127 | TRAFICOM p.61 | 7.1; TRF-128 | TRAFICOM p.61 | 7.1" ;
    nltl:sourceRequirementId "TRF-126",
