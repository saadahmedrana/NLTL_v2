nltl:administrationApprovedEquivalentBridgeWingProtectionPresent a owl:DatatypeProperty ;
    rdfs:label "Administration approved equivalent bridge wing protection present"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range xsd:boolean ;
    skos:altLabel "administration_approved_equivalent_bridge_wing_protection_present" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for administrationApprovedEquivalentBridgeWingProtectionPresent derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Administration approved equivalent bridge wing protection present"@en ;
    nltl:draftConceptId "VOC-0013" ;
    nltl:evidenceExcerpt "In category A and B ships constructed on or after 1 January 2026, the bridge wings shall be enclosed or designed to protect navigational equipment and operating personnel. On ships which cannot comply with this regulation, arrangements acceptable to the Administration shall be provided to achieve a level of protection that is equivalent to this regulation." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Locked-workbook normalized regulatory term" ;
    nltl:namingRule "N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase" ;
    nltl:roleDecisionBasis "Stage 1 explicit boolean" ;
    nltl:sourceAlias "administration_approved_equivalent_bridge_wing_protection_present" ;
    nltl:sourceReference "IMO26-011 | IMO_AMEND_2026 p.4 | 9-1.3.2.1.4.2" ;
    nltl:sourceRequirementId "IMO26-011" ;
    nltl:stage1LocalName "administrationApprovedEquivalentBridgeWingProtectionPresent" ;
    nltl:unitDecisionStatus "Not a quantity property" .

nltl:administrationApprovedEquivalentDepthSoundingDevicePresent a owl:DatatypeProperty ;
    rdfs:label "Administration approved equivalent depth sounding device present"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range xsd:boolean ;
    skos:altLabel "administration_approved_equivalent_depth_sounding_device_present" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for administrationApprovedEquivalentDepthSoundingDevicePresent derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Administration approved equivalent depth sounding device present"@en ;
    nltl:draftConceptId "VOC-0014" ;
    nltl:evidenceExcerpt "Ice-strengthened ships constructed on or after 1 January 2026 shall have either two independent echo-sounding devices or one echo-sounding device with two separate independent transducers. Other devices capable of depth sounding, such as fish finders, acceptable to the Administration, may be used as equivalent means of meeting this requirement." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Locked-workbook normalized regulatory term" ;
    nltl:namingRule "N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase" ;
    nltl:roleDecisionBasis "Stage 1 explicit boolean" ;
    nltl:sourceAlias "administration_approved_equivalent_depth_sounding_device_present" ;
    nltl:sourceReference "IMO26-007 | IMO_AMEND_2026 p.3 | 9-1.3.2.1.1" ;
    nltl:sourceRequirementId "IMO26-007" ;
    nltl:stage1LocalName "administrationApprovedEquivalentDepthSoundingDevicePresent" ;
    nltl:unitDecisionStatus "Not a quantity property" .

nltl:administrationApprovedEquivalentVisibilityArrangementPresent a owl:DatatypeProperty ;
    rdfs:label "Administration approved equivalent visibility arrangement present"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range xsd:boolean ;
    skos:altLabel "administration_approved_equivalent_visibility_arrangement_present" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for administrationApprovedEquivalentVisibilityArrangementPresent derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Administration approved equivalent visibility arrangement present"@en ;
    nltl:draftConceptId "VOC-0015" ;
    nltl:evidenceExcerpt "Ships shall comply with SOLAS regulation V/22.1.9.4, irrespective of the date of construction and the size, and have a clear view astern. On ships which cannot comply with these requirements, arrangements acceptable to the Administration shall be provided to achieve a level of visibility that is equivalent to these requirements." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Locked-workbook normalized regulatory term" ;
    nltl:namingRule "N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase" ;
    nltl:roleDecisionBasis "Stage 1 explicit boolean" ;
    nltl:sourceAlias "administration_approved_equivalent_visibility_arrangement_present" ;
    nltl:sourceReference "IMO26-008 | IMO_AMEND_2026 p.3 | 9-1.3.2.1.2" ;
    nltl:sourceRequirementId "IMO26-008" ;
