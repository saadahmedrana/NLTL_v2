    nltl:sourceAlias "accessible_status" ;
    nltl:sourceReference "IMO-062 | IMO_POLAR_CODE p.23 | 8.2.1.1" ;
    nltl:sourceRequirementId "IMO-062" ;
    nltl:stage1LocalName "accessibleStatus" ;
    nltl:unitDecisionStatus "Not a quantity property" .

nltl:accommodationSpacePresent a owl:DatatypeProperty ;
