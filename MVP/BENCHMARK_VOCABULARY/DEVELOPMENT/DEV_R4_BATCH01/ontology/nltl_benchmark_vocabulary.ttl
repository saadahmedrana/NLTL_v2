    nltl:sourceRequirementId "TRF-112" ;
    nltl:stage1LocalName "shaftComponent" ;
    nltl:unitDecisionStatus "Not a quantity property" .

nltl:shaftComponentDesignTorque a owl:ObjectProperty ;
