nltl:vonMises a owl:DatatypeProperty ;
    rdfs:label "Von mises"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range xsd:string ;
    skos:altLabel "von_Mises" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for vonMises derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Von mises"@en ;
    nltl:draftConceptId "VOC-0798" ;
    nltl:evidenceExcerpt "The calculated blade stresses must satisfy sigma_ref2/sigma_st >= 1.3 (6.39). If finite element analysis is used for estimating the stresses, von Mises stresses shall be used. sigma_ref2 is the reference strength, defined as the lower of 0.7*sigma_u and 0.6*sigma_0.2 + 0.4*sigma_u. The fatigue design of the propeller blade is based on an estimated load distr..." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:roleDecisionBasis "Conservative textual scalar fallback" ;
    nltl:sourceAlias "von_Mises" ;
    nltl:sourceReference "TRF-106 | TRAFICOM p.48 | 6.6.2.2-6.6.2.3" ;
    nltl:sourceRequirementId "TRF-106" ;
    nltl:stage1LocalName "vonMises" ;
    nltl:unitDecisionStatus "Not a quantity property" .

nltl:vonMisesYieldCriterion a owl:DatatypeProperty ;
    rdfs:label "Von mises yield criterion"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range xsd:string ;
    skos:altLabel "vonMisesYieldCriterion" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for vonMisesYieldCriterion derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Von mises yield criterion"@en ;
    nltl:draftConceptId "VOC-0799" ;
    nltl:evidenceExcerpt "The acceptance criterion for designs is that the combined stresses from bending and shear, when using the von Mises yield criterion, are lower than the yield point sigmay. When the direct calculation is based on beam theory, the allowable shear stress must be no larger than 0.9*tauy, where tauy = sigmay/sqrt3." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:roleDecisionBasis "Controlled/textual category rule" ;
    nltl:sourceAlias "vonMisesYieldCriterion" ;
    nltl:sourceReference "TRF-031 | TRAFICOM p.12 | 4.1" ;
    nltl:sourceRequirementId "TRF-031" ;
    nltl:stage1LocalName "vonMisesYieldCriterion" ;
    nltl:unitDecisionStatus "Not a quantity property" .

