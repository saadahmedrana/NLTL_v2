    nltl:recommendedUnit unit:DEG_C ;
    nltl:roleDecisionBasis "Quantity metadata requires the canonical QUDT QuantityValue node pattern" ;
    nltl:sourceAlias "PST_degC" ;
    nltl:sourceReference "IMO-012 | IMO_POLAR_CODE p.14 | 1.2.11; IMO-019 | IMO_POLAR_CODE p.15 | 1.4.2; IMO-020 | IMO_POLAR_CODE p.15 | 1.4.3; IMO-031 | IMO_POLAR_CODE p.17 | 3.3.1; IMO-046 | IMO_POLAR_CODE p.21 | 6.3.2.1; IMO-048 | IMO_POLAR_CODE p.21 | 6.3.2.3; IMO-054 | IMO_POLAR_CODE p.22 | 7.2.2.1; IMO-056 | IMO_POLAR_CODE p.22 | 7.3.1.2; IMO-061 | IMO_POLAR_CODE p.23 | 7.3.3.1" ;
    nltl:sourceRequirementId "IMO-012",
        "IMO-019",
        "IMO-020",
        "IMO-031",
        "IMO-046",
        "IMO-048",
        "IMO-054",
        "IMO-056",
        "IMO-061" ;
