nltl:iceLoadCycleCount a owl:DatatypeProperty ;
    rdfs:label "Ice load cycle count"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range xsd:integer ;
    skos:altLabel "Nice",
        "iceLoadCycleCount" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for iceLoadCycleCount derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Ice load cycle count"@en ;
    nltl:draftConceptId "VOC-0362" ;
    nltl:evidenceExcerpt "where k is the shape parameter of the spectrum, Nice is the number of load cycles in the spectrum, and Fice is the random variable for ice loads on the blade, 0 <= Fice <= (Fice)max. The shape parameter k=0.75 shall be used for the ice force distribution of an open propeller and the shape parameter k=1.0 for that of a ducted propeller blade." ;
    nltl:module nltl:moduleMachinery ;
    nltl:namingBasis "Locked-workbook normalized regulatory term" ;
    nltl:namingRule "N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase" ;
    nltl:roleDecisionBasis "Stage 1 explicit integer" ;
    nltl:sourceAlias "Nice",
        "iceLoadCycleCount" ;
    nltl:sourceReference "TRF-077 | TRAFICOM p.36 | 6.5.1.8; TRF-078 | TRAFICOM p.36 | 6.5.1.9; TRF-080 | TRAFICOM p.37 | 6.5.1.9; TRF-109 | TRAFICOM p.50 | 6.6.2.3" ;
    nltl:sourceRequirementId "TRF-077",
        "TRF-078",
        "TRF-080",
        "TRF-109" ;
    nltl:stage1LocalName "iceLoadCycleCount" ;
    nltl:unitDecisionStatus "Not a quantity property" .

