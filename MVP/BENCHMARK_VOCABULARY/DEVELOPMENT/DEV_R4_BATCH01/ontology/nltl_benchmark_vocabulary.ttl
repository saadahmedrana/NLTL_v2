nltl:polarRoutePlan a owl:Class ;
    rdfs:label "Polar route plan"@en ;
    rdfs:subClassOf nltl:documentEvidence ;
    skos:altLabel "polar_route_plan" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for polarRoutePlan derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
