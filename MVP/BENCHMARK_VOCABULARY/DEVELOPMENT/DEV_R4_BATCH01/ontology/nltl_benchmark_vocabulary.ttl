nltl:coefficientC3 a owl:ObjectProperty ;
    rdfs:label "Coefficient c3"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "coefficientC3" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for coefficientC3 derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Coefficient c3"@en ;
    nltl:draftConceptId "VOC-0137" ;
    nltl:evidenceExcerpt "Coefficients f_1-f_4 and g_1-g_3 are given in Table 3-3. C_3 = 460 kg/(m^2*s^2), C_4 = 18.7 kg/(m^2*s^2), C_5 = 825 kg/s^2. If the value of the term ((L*T)/B^2)^3 is less than 5, the value 5 shall be used; if the value is more than 20, the value 20 shall be used." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:quantityKindLabel "DimensionlessRatio" ;
    nltl:recommendedUnit nltl:kilogramPerSquareMetreSquareSecondUnit ;
    nltl:roleDecisionBasis "Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node" ;
    nltl:sourceAlias "coefficientC3" ;
    nltl:sourceReference "TRF-027 | TRAFICOM p.11 | 3.2.4" ;
    nltl:sourceRequirementId "TRF-027" ;
    nltl:stage1LocalName "coefficientC3" ;
    nltl:unitDecisionStatus "PDF-verified Batch 01 development correction from TRAFICOM Tables 3-2/3-3; R2 remains unchanged." ;
    nltl:unitSymbol "1" .

