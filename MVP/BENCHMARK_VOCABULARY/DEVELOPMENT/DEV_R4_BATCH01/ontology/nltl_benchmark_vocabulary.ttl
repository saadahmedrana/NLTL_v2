nltl:requiredShearArea a owl:ObjectProperty ;
    rdfs:label "Required shear area"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "A_required_cm2" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for aRequiredCm2 derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Required shear area"@en ;
    nltl:draftConceptId "VOC-0053" ;
    nltl:evidenceExcerpt "The section modulus of a web frame shall be calculated using Z = (M/sigma_y)*sqrt(1/(1 - (gamma*A/A_a)^2))*10^6 [cm^3] (4.17), where M is the maximum calculated bending moment under ice load F and shall be M = 0.193*F*L, gamma is selected from Table 4-8, A is the required shear area, and A_a = A_f + A_w is the actual cross-sectional area of the web frame." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:quantityKindLabel "Area" ;
    nltl:recommendedUnit unit:CentiM2 ;
    nltl:roleDecisionBasis "Quantity metadata requires the canonical QUDT QuantityValue node pattern" ;
    nltl:sourceAlias "A_required_cm2" ;
    nltl:sourceReference "TRF-060 | TRAFICOM p.24 | 4.6.2" ;
    nltl:sourceRequirementId "TRF-060" ;
    nltl:stage1LocalName "aRequiredCm2" ;
    nltl:stage2UnitEvidence "TRF-060 defines A as required shear area in the [cm^2] equation" ;
    nltl:unitDecisionStatus "Verified recommended QUDT unit from Stage 1 or a documented Stage 2 source-unit refinement" ;
    nltl:unitSymbol "cm^2" .

