nltl:aggregateOilFuelCapacity a owl:ObjectProperty ;
    rdfs:label "Aggregate oil fuel capacity"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
