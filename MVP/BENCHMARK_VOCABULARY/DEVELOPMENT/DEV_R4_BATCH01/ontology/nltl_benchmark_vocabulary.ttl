nltl:adequateReceptionFacilitiesAvailable a owl:DatatypeProperty ;
    rdfs:label "Adequate reception facilities available"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range xsd:boolean ;
    skos:altLabel "adequate_reception_facilities_available" ;
