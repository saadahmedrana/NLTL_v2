nltl:webFrameIceLoad a owl:ObjectProperty ;
    rdfs:label "Web frame ice load"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "webFrameIceLoad" ;
