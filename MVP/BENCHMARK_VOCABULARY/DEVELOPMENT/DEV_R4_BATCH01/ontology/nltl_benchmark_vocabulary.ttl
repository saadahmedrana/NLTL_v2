nltl:combinedBendingShearStress a owl:ObjectProperty ;
    rdfs:label "Combined bending shear stress"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "combinedBendingShearStress" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for combinedBendingShearStress derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Combined bending shear stress"@en ;
    nltl:draftConceptId "VOC-0149" ;
    nltl:evidenceExcerpt "The acceptance criterion for designs is that the combined stresses from bending and shear, when using the von Mises yield criterion, are lower than the yield point sigmay. When the direct calculation is based on beam theory, the allowable shear stress must be no larger than 0.9*tauy, where tauy = sigmay/sqrt3." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:quantityKindLabel "PressureOrStress" ;
    nltl:recommendedUnit unit:MegaPA ;
    nltl:roleDecisionBasis "Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node" ;
    nltl:sourceAlias "combinedBendingShearStress" ;
    nltl:sourceReference "TRF-031 | TRAFICOM p.12 | 4.1" ;
    nltl:sourceRequirementId "TRF-031" ;
    nltl:stage1LocalName "combinedBendingShearStress" ;
    nltl:unitDecisionStatus "Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical benchmark stress/pressure unit" ;
    nltl:unitSymbol "MPa" .

nltl:combinedShearBendingEffect a owl:DatatypeProperty ;
