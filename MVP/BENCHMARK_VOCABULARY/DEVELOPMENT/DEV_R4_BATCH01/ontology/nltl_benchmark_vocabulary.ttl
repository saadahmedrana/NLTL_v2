    skos:prefLabel "Adequate reception facilities available"@en ;
    nltl:draftConceptId "VOC-0011" ;
    nltl:evidenceExcerpt "Discharge of cargo residues that cannot be recovered using commonly available methods for unloading shall only be permitted while the ship is en route and where all of the following conditions are satisfied: cargo residues, cleaning agents or additives, contained in hold washing water do not include any substances classified as harmful to the marine environm..." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Locked-workbook normalized regulatory term" ;
    nltl:namingRule "N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase" ;
    nltl:roleDecisionBasis "Boolean semantic suffix/word rule" ;
    nltl:sourceAlias "adequate_reception_facilities_available" ;
    nltl:sourceReference "IMO-123 | IMO_POLAR_CODE p.43-44 | 5.2.1.5" ;
    nltl:sourceRequirementId "IMO-123" ;
    nltl:stage1LocalName "adequateReceptionFacilitiesAvailable" ;
    nltl:unitDecisionStatus "Not a quantity property" .

