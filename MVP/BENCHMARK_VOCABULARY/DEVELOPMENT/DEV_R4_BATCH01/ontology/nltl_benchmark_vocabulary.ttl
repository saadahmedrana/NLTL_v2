    nltl:sourceAlias "Nclass" ;
    nltl:sourceReference "TRF-078 | TRAFICOM p.36 | 6.5.1.9" ;
    nltl:sourceRequirementId "TRF-078" ;
    nltl:stage1LocalName "classLoadCycleCount" ;
    nltl:unitDecisionStatus "Not a quantity property" .

