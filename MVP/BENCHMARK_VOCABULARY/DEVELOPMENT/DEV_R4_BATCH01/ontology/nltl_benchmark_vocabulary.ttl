nltl:propellerBladeCount a owl:DatatypeProperty ;
    rdfs:label "Propeller blade count"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range xsd:integer ;
    skos:altLabel "propellerBladeCount" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for propellerBladeCount derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Propeller blade count"@en ;
    nltl:draftConceptId "VOC-0581" ;
