    rdfs:range xsd:integer ;
    skos:altLabel "Nclass" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for classLoadCycleCount derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Class load cycle count"@en ;
    nltl:draftConceptId "VOC-0133" ;
    nltl:evidenceExcerpt "The number of load cycles per propeller blade in the load spectrum shall be N_ice = k_1*k_2*k_3*N_class*n_n (6.14), where N_class is given in Table 6-6 and the propeller location factor k_1 is given in Table 6-7." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Locked-workbook normalized regulatory term" ;
    nltl:namingRule "N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase" ;
