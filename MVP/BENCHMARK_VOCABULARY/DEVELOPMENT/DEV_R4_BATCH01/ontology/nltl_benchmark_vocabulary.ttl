nltl:bowRakeAtQuarterBreadth a owl:ObjectProperty ;
    rdfs:label "Bow rake at quarter breadth"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "phi2" ;
