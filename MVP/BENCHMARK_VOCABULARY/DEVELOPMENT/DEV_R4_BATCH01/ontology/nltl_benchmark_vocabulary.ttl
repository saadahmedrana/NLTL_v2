    nltl:evidenceExcerpt "Where the regulations of this chapter are achieved by means of adding devices requiring a source of power, this source shall be able to operate independently of the ship's main source of power." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Locked-workbook normalized regulatory term" ;
    nltl:namingRule "N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase" ;
    nltl:roleDecisionBasis "Explicit binary applicability/state semantics from the linked requirement" ;
    nltl:sourceAlias "added_life_saving_device_requires_power" ;
