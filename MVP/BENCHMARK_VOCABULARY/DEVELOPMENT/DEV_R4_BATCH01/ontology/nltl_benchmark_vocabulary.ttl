nltl:iceLoadHeight a owl:ObjectProperty ;
    rdfs:label "Ice load height"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "iceLoadHeight" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for iceLoadHeight derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Ice load height"@en ;
    nltl:draftConceptId "VOC-0364" ;
    nltl:evidenceExcerpt "The ice load transferred to a web frame from an ice stringer or from longitudinal framing shall be F = f_12*p*h*S [MN] (4.15). When calculating c_a, use l_a = 2*S. If p*h is less than 0.15 MN/m, use 0.15 MN/m. Use f_12 = 1.8." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:quantityKindLabel "Length" ;
    nltl:recommendedUnit unit:M ;
    nltl:roleDecisionBasis "Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node" ;
    nltl:sourceAlias "iceLoadHeight" ;
    nltl:sourceReference "TRF-057 | TRAFICOM p.23 | 4.6.1" ;
    nltl:sourceRequirementId "TRF-057" ;
    nltl:stage1LocalName "iceLoadHeight" ;
    nltl:unitDecisionStatus "Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical benchmark length unit" ;
    nltl:unitSymbol "m" .

