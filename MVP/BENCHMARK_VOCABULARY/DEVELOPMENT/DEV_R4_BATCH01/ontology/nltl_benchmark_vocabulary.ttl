    nltl:sourceReference "IMO-108 | IMO_POLAR_CODE p.41 | 1.2.1" ;
    nltl:sourceRequirementId "IMO-108" ;
    nltl:stage1LocalName "aggregateOilFuelCapacity" ;
    nltl:unitDecisionStatus "Verified recommended QUDT unit from Stage 1 or a documented Stage 2 source-unit refinement" ;
    nltl:unitSymbol "m^3" .

nltl:airReceiverCapacity a owl:ObjectProperty ;
