nltl:beamTheoryUsed a owl:DatatypeProperty ;
    rdfs:label "Beam theory used"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range xsd:boolean ;
    skos:altLabel "beamTheoryUsed" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for beamTheoryUsed derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Beam theory used"@en ;
    nltl:draftConceptId "VOC-0078" ;
    nltl:evidenceExcerpt "The acceptance criterion for designs is that the combined stresses from bending and shear, when using the von Mises yield criterion, are lower than the yield point sigmay. When the direct calculation is based on beam theory, the allowable shear stress must be no larger than 0.9*tauy, where tauy = sigmay/sqrt3." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:roleDecisionBasis "Stage 1 explicit boolean" ;
    nltl:sourceAlias "beamTheoryUsed" ;
    nltl:sourceReference "TRF-031 | TRAFICOM p.12 | 4.1" ;
    nltl:sourceRequirementId "TRF-031" ;
    nltl:stage1LocalName "beamTheoryUsed" ;
    nltl:unitDecisionStatus "Not a quantity property" .

nltl:betaIPrime a owl:ObjectProperty ;
    rdfs:label "Beta i prime"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "beta_i_prime" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for betaIPrime derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Beta i prime"@en ;
    nltl:draftConceptId "VOC-0079" ;
    nltl:evidenceExcerpt "For bow forms defined in I2.3.1(v), the shape coefficient f_ai is to be taken as f_ai = minimum(f_ai1, f_ai2, f_ai3), where f_ai1 = (0.097 - 0.68*(x/L_UI - 0.15)^2)*alpha_i/(beta_i_prime)^0.5, f_ai2 = 1.2*C_FF/(sin(beta_i_prime)*C_FC*D_UI^0.64), and f_ai3 = 0.60." ;
    nltl:module nltl:moduleHull ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:quantityKindLabel "DimensionlessRatio" ;
    nltl:recommendedUnit unit:UNITLESS ;
    nltl:roleDecisionBasis "Clause-linked engineering quantity override; represented by the canonical QUDT QuantityValue node pattern" ;
    nltl:sourceAlias "beta_i_prime" ;
    nltl:sourceReference "I2-015 | IACS_UR_I2 p.5 | I2.3.2.1" ;
    nltl:sourceRequirementId "I2-015" ;
    nltl:stage1LocalName "betaIPrime" ;
    nltl:unitDecisionStatus "Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical dimensionless unit" ;
    nltl:unitSymbol "1" .

nltl:bladeBendingMoment a owl:ObjectProperty ;
    rdfs:label "Blade bending moment"@en ;
