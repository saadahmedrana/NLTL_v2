@prefix fs: <urn:nltl:few-shot:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

fs:Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
