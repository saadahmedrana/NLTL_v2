@prefix fs: <urn:nltl:few-shot:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

fs:shipPass a nltl:ship ;
    nltl:hasCalculationCase fs:casePass .
fs:casePass a nltl:calculationCase ;
    nltl:hasCalculationInputEvidence fs:inputEvidence ;
    nltl:hasCalculationResultEvidence fs:resultEvidence .
fs:inputEvidence a nltl:evidenceArtifact .
fs:resultEvidence a nltl:evidenceArtifact .
