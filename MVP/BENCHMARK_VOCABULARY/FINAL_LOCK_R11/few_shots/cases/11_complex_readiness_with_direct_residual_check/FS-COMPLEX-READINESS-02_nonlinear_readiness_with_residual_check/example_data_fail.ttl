@prefix fs: <urn:nltl:few-shot:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fs:caseFail a nltl:calculationCase ;
    nltl:nonlinearAnalysisAcceptanceEvidence fs:acceptanceEvidence ;
    nltl:minorPermanentDeformationAssessmentSatisfied "false"^^xsd:boolean .
fs:acceptanceEvidence a nltl:evidenceArtifact .
