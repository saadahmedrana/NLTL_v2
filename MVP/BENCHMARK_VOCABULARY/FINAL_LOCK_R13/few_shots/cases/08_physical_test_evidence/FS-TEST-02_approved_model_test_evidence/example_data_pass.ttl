@prefix dct: <http://purl.org/dc/terms/> .
@prefix fs: <urn:nltl:few-shot:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

fs:shipPass a nltl:ship ;
    nltl:hasEvidence fs:modelTestEvidence .

fs:modelTestEvidence a nltl:modelTestEvidence ;
    dct:source fs:modelTestRecord ;
    nltl:hasEvidenceState nltl:evidenceStateApproved .
