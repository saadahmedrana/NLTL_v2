    {
      "@id": "https://w3id.org/nltl-benchmark/vocab#actualFrameShearArea",
      "@type": "owl:ObjectProperty",
      "localName": "actualFrameShearArea",
      "termKind": "QuantityProperty",
      "moduleName": "hull",
      "prefLabel": "Actual frame shear area",
      "definition": "NORMALIZED (Stage 1): candidate concept for actualFrameShearArea derived from the linked locked requirements; scope and final semantics require vocabulary approval.",
      "alias": [
