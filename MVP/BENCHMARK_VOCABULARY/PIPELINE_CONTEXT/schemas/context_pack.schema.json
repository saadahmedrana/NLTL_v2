{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/nltl-benchmark/schema/context-pack-1.0.0.json",
  "title": "NLTL requirement-scoped vocabulary context pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packVersion",
    "packId",
    "sourceLock",
    "selection",
    "usagePolicy",
    "requirements",
    "terms",
    "nodePatterns",
    "scopedJsonLdContext",
    "sizeEstimate"
  ],
  "properties": {
    "packVersion": { "const": "1.0.0" },
    "packId": { "type": "string", "pattern": "^context-pack-[0-9a-f]{16}$" },
    "sourceLock": {
      "type": "object",
      "required": ["lockId", "workbookSha256", "vocabularyVersion", "registrySha256"]
    },
    "selection": {
      "type": "object",
      "required": ["mode", "requirementIds", "applicableProfiles", "termCount", "all821TermsIncluded"],
      "properties": {
        "mode": { "enum": ["requirement", "integrated-case"] },
        "requirementIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "applicableProfiles": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "termCount": { "type": "integer", "minimum": 1, "maximum": 821 },
        "all821TermsIncluded": { "type": "boolean" }
      }
    },
    "usagePolicy": { "type": "object" },
    "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" } },
    "terms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/term" } },
    "nodePatterns": { "type": "array", "items": { "type": "object" } },
    "scopedJsonLdContext": { "type": "object", "required": ["@context"] },
    "sizeEstimate": { "type": "object", "required": ["characters", "roughTokensAtFourCharactersPerToken"] }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["id", "source", "sourceSheet", "edition", "page", "clause", "verificationCategory", "activationStatus", "codability", "encodingPatternHint", "figureDependent"]
    },
    "term": {
      "type": "object",
      "additionalProperties": true,
      "required": ["localName", "iri", "label", "kind", "module", "range", "aliases", "definition", "sourceConceptIds", "sourceReferences", "namingBasis", "namingRule", "roleDecision", "unitDecision", "mapping"],
      "properties": {
        "localName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "iri": { "type": "string", "format": "uri" },
        "kind": { "enum": ["Class", "DatatypeProperty", "ObjectProperty", "QuantityProperty"] },
        "datatype": { "type": ["string", "null"] },
        "recommendedUnit": { "type": ["string", "null"] },
        "aliases": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
