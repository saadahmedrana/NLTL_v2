@prefix dct: <http://purl.org/dc/terms/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ssp: <https://w3id.org/mtl-requirements/ssp#> .

<https://w3id.org/nltl/mapping/haitham-stage2> a owl:Ontology ;
    rdfs:label "Verified Haitham compatibility mappings" ;
    dct:description "SKOS mappings only; no OWL equivalence is asserted because the legacy named-variable node model differs from the benchmark property/value model." .

nltl:airReceiverCapacity skos:exactMatch ssp:airReceiverCapacity .

nltl:backwardIceThrust skos:exactMatch ssp:BackwardIceThrust .

nltl:bladeFailureSpindleTorque skos:exactMatch ssp:bladeFailureSpindleTorque .

nltl:bowLength skos:exactMatch ssp:bowLength .

nltl:engineOutputCoefficientKe skos:exactMatch ssp:KeValue .

nltl:flareAngle skos:exactMatch ssp:flareAngle .

nltl:forwardDraught skos:exactMatch ssp:forwardDraught .

nltl:forwardIceThrust skos:exactMatch ssp:ForwardIceThrust .

nltl:frameSpan skos:exactMatch ssp:frameSpan .

nltl:hydrodynamicBollardThrust skos:exactMatch ssp:hydrodynamicBollardThrust .

nltl:iceClass skos:exactMatch ssp:iceClass .

nltl:icePressure skos:exactMatch ssp:icePressure .

nltl:levelIceThickness skos:exactMatch ssp:levelIceThickness .

nltl:lowerIceWaterline skos:exactMatch ssp:LIWL .

nltl:propellerDiameter skos:exactMatch ssp:propellerDiameter .

nltl:propellerType skos:exactMatch ssp:propellerType .

nltl:seaInletLocation skos:exactMatch ssp:seaInletLocation .

nltl:shipLength skos:exactMatch ssp:shipLength .

nltl:stringerSpan skos:exactMatch ssp:stringerSpan .

nltl:upperIceWaterline skos:exactMatch ssp:UIWL .

nltl:webFrameIceLoad skos:exactMatch ssp:webFrameIceLoad .

nltl:webFrameSpacing skos:exactMatch ssp:webFrameSpacing .

