    <skos:prefLabel xml:lang="en">Blade order resonance</skos:prefLabel>
    <nltl:draftConceptId>VOC-0089</nltl:draftConceptId>
    <nltl:stage1LocalName>bladeOrderResonance</nltl:stage1LocalName>
    <nltl:module rdf:resource="https://w3id.org/nltl/vocab#moduleOperations"/>
