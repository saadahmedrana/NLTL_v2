    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nltl/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">Bridge controlled rotatable narrow beam searchlight count</rdfs:label>
    <skos:prefLabel xml:lang="en">Bridge controlled rotatable narrow beam searchlight count</skos:prefLabel>
    <nltl:draftConceptId>VOC-0108</nltl:draftConceptId>
    <nltl:stage1LocalName>bridgeControlledRotatableNarrowBeamSearchlightCount</nltl:stage1LocalName>
    <nltl:module rdf:resource="https://w3id.org/nltl/vocab#moduleCore"/>
    <nltl:roleDecisionBasis>Stage 1 explicit integer</nltl:roleDecisionBasis>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
    <nltl:namingRule>N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase</nltl:namingRule>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for bridgeControlledRotatableNarrowBeamSearchlightCount derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <nltl:sourceReference>IMO-088 | IMO_POLAR_CODE p.27 | 9.3.3.1</nltl:sourceReference>
    <nltl:evidenceExcerpt>Ships, with the exception of those solely operating in areas with 24 h daylight, shall be equipped with two remotely rotatable, narrow-beam search lights controllable from the bridge to provide lighting over an arc of 360 degrees, or other means to visually detect ice.</nltl:evidenceExcerpt>
    <skos:altLabel>bridge_controlled_rotatable_narrow_beam_searchlight_count</skos:altLabel>
    <nltl:sourceAlias>bridge_controlled_rotatable_narrow_beam_searchlight_count</nltl:sourceAlias>
