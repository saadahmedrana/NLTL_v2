  <rdf:Description rdf:about="https://w3id.org/nltl/vocab#prolongedEntrapmentProcedurePresent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nltl/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Prolonged entrapment procedure present</rdfs:label>
    <skos:prefLabel xml:lang="en">Prolonged entrapment procedure present</skos:prefLabel>
    <nltl:draftConceptId>VOC-0579</nltl:draftConceptId>
    <nltl:stage1LocalName>prolongedEntrapmentProcedurePresent</nltl:stage1LocalName>
    <nltl:module rdf:resource="https://w3id.org/nltl/vocab#moduleCore"/>
    <nltl:roleDecisionBasis>Stage 1 explicit boolean</nltl:roleDecisionBasis>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
    <nltl:namingRule>N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase</nltl:namingRule>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for prolongedEntrapmentProcedurePresent derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <nltl:sourceReference>IMO-028 | IMO_POLAR_CODE p.16 | 2.3.4</nltl:sourceReference>
    <nltl:evidenceExcerpt>The Manual shall include risk-based procedures to be followed for: contacting emergency response providers for salvage, search and rescue (SAR), spill response, etc., as applicable; and, in the case of ships ice strengthened in accordance with chapter 3, procedures for maintaining life support and ship integrity in the event of prolonged entrapment by ice.</nltl:evidenceExcerpt>
    <skos:altLabel>prolonged_entrapment_procedure_present</skos:altLabel>
    <nltl:sourceAlias>prolonged_entrapment_procedure_present</nltl:sourceAlias>
    <nltl:sourceRequirementId>IMO-028</nltl:sourceRequirementId>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl/vocab#storageLocationSubjectToFreezing">
