    <skos:prefLabel xml:lang="en">Web frame ice load</skos:prefLabel>
    <nltl:draftConceptId>VOC-0811</nltl:draftConceptId>
    <nltl:stage1LocalName>webFrameIceLoad</nltl:stage1LocalName>
    <nltl:module rdf:resource="https://w3id.org/nltl/vocab#moduleHull"/>
