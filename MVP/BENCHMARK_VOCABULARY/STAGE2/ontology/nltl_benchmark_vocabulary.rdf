    <skos:prefLabel xml:lang="en">Propeller pitch at mcr free running</skos:prefLabel>
    <nltl:draftConceptId>VOC-0596</nltl:draftConceptId>
    <nltl:stage1LocalName>propellerPitchAtMcrFreeRunning</nltl:stage1LocalName>
    <nltl:module rdf:resource="https://w3id.org/nltl/vocab#moduleMachinery"/>
