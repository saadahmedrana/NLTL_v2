  <rdf:Description rdf:about="https://w3id.org/nltl/vocab#iceAccumulationPreventionMeansPresent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nltl/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Ice accumulation prevention means present</rdfs:label>
    <skos:prefLabel xml:lang="en">Ice accumulation prevention means present</skos:prefLabel>
