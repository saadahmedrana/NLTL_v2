    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nltl/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">MARPOL Annex V regulation 6.1 discharge occurs</rdfs:label>
    <skos:prefLabel xml:lang="en">MARPOL Annex V regulation 6.1 discharge occurs</skos:prefLabel>
    <nltl:draftConceptId>VOC-0456</nltl:draftConceptId>
    <nltl:stage1LocalName>marpolAnnexVRegulation6Point1DischargeOccurs</nltl:stage1LocalName>
    <nltl:module rdf:resource="https://w3id.org/nltl/vocab#moduleRegulation"/>
    <nltl:roleDecisionBasis>Boolean semantic suffix/word rule</nltl:roleDecisionBasis>
    <nltl:namingBasis>Explicit regulation-reference transcription</nltl:namingBasis>
    <nltl:namingRule>N6 - spell separators as Point or Dash and identify the governing instrument</nltl:namingRule>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for marpolAnnexVRegulation6Point1DischargeOccurs derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <nltl:sourceReference>IMO-124 | IMO_POLAR_CODE p.44 | 5.2.2.1-.2</nltl:sourceReference>
    <nltl:evidenceExcerpt>In the Antarctic area, discharges under regulation 6.1 of MARPOL Annex V shall be as far as practicable from areas of ice concentration exceeding 1/10, but in any case not less than 12 nautical miles from the nearest fast ice; and food waste shall not be discharged onto ice.</nltl:evidenceExcerpt>
    <skos:altLabel>MARPOL_V_6_1_discharge</skos:altLabel>
    <nltl:sourceAlias>MARPOL_V_6_1_discharge</nltl:sourceAlias>
