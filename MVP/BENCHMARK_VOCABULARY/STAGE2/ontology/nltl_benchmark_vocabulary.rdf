    <nltl:sourceRequirementId>IMO-038</nltl:sourceRequirementId>
    <nltl:unitSymbol>m</nltl:unitSymbol>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/M"/>
    <nltl:quantityKindLabel>Length</nltl:quantityKindLabel>
  </rdf:Description>
