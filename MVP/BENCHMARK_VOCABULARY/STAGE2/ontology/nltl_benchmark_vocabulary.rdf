  <rdf:Description rdf:about="https://w3id.org/nltl/vocab#crewSurvivalEquipmentTrainingStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nltl/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Crew survival equipment training status</rdfs:label>
    <skos:prefLabel xml:lang="en">Crew survival equipment training status</skos:prefLabel>
    <nltl:draftConceptId>VOC-0177</nltl:draftConceptId>
    <nltl:stage1LocalName>crewSurvivalEquipmentTrainingStatus</nltl:stage1LocalName>
    <nltl:module rdf:resource="https://w3id.org/nltl/vocab#moduleCore"/>
    <nltl:roleDecisionBasis>Stage 1 explicit boolean</nltl:roleDecisionBasis>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
    <nltl:namingRule>N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase</nltl:namingRule>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for crewSurvivalEquipmentTrainingStatus derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <nltl:sourceReference>IMO-078 | IMO_POLAR_CODE p.25 | 8.3.3.3.3.6-.7</nltl:sourceReference>
    <nltl:evidenceExcerpt>Passengers shall be instructed in the use of the personal survival equipment and the action to take in an emergency; and the crew shall be trained in the use of the personal survival equipment and group survival equipment.</nltl:evidenceExcerpt>
    <skos:altLabel>crew_survival_equipment_training_status</skos:altLabel>
    <nltl:sourceAlias>crew_survival_equipment_training_status</nltl:sourceAlias>
    <nltl:sourceRequirementId>IMO-078</nltl:sourceRequirementId>
  </rdf:Description>
