    <nltl:sourceReference>IMO-082 | IMO_POLAR_CODE p.26 | 9.3.2.1.2; IMO26-008 | IMO_AMEND_2026 p.3 | 9-1.3.2.1.2</nltl:sourceReference>
    <nltl:evidenceExcerpt>Ships shall comply with SOLAS regulation V/22.1.9.4, irrespective of the date of construction and the size and, depending on the bridge configuration, have a clear view astern.</nltl:evidenceExcerpt>
    <skos:altLabel>clear_view_astern_status</skos:altLabel>
    <nltl:sourceAlias>clear_view_astern_status</nltl:sourceAlias>
    <nltl:sourceRequirementId>IMO-082</nltl:sourceRequirementId>
    <nltl:sourceRequirementId>IMO26-008</nltl:sourceRequirementId>
  </rdf:Description>
