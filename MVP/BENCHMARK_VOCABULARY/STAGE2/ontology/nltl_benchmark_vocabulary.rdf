    <skos:prefLabel xml:lang="en">Ice or snow removal or prevention means</skos:prefLabel>
    <nltl:draftConceptId>VOC-0372</nltl:draftConceptId>
    <nltl:stage1LocalName>iceOrSnowRemovalOrPreventionMeans</nltl:stage1LocalName>
    <nltl:module rdf:resource="https://w3id.org/nltl/vocab#moduleCore"/>
