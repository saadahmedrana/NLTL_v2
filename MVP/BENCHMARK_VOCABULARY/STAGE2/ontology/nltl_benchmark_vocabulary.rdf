    <rdfs:label xml:lang="en">Polar Code chapter 11-1 applicable</rdfs:label>
    <skos:prefLabel xml:lang="en">Polar Code chapter 11-1 applicable</skos:prefLabel>
    <nltl:draftConceptId>VOC-0553</nltl:draftConceptId>
    <nltl:stage1LocalName>polarCodeChapter11Dash1Applicable</nltl:stage1LocalName>
