    <rdfs:domain rdf:resource="https://w3id.org/nltl/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <rdfs:label xml:lang="en">Clamped hull geometry term</rdfs:label>
    <skos:prefLabel xml:lang="en">Clamped hull geometry term</skos:prefLabel>
    <nltl:draftConceptId>VOC-0130</nltl:draftConceptId>
