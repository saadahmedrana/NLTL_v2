    <rdfs:label xml:lang="en">Ship ice strengthened</rdfs:label>
    <skos:prefLabel xml:lang="en">Ship ice strengthened</skos:prefLabel>
    <nltl:draftConceptId>VOC-0679</nltl:draftConceptId>
    <nltl:stage1LocalName>shipIceStrengthened</nltl:stage1LocalName>
    <nltl:module rdf:resource="https://w3id.org/nltl/vocab#moduleMachinery"/>
    <nltl:roleDecisionBasis>Boolean semantic suffix/word rule</nltl:roleDecisionBasis>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
    <nltl:namingRule>N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase</nltl:namingRule>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for shipIceStrengthened derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <nltl:sourceReference>IMO-028 | IMO_POLAR_CODE p.16 | 2.3.4; IMO-032 | IMO_POLAR_CODE p.17 | 3.3.2.1-.3; IMO-049 | IMO_POLAR_CODE p.21 | 6.3.3.1-.3; IMO-081 | IMO_POLAR_CODE p.26 | 9.3.2.1.1; IMO26-007 | IMO_AMEND_2026 p.3 | 9-1.3.2.1.1</nltl:sourceReference>
    <nltl:evidenceExcerpt>The Manual shall include risk-based procedures to be followed for: contacting emergency response providers for salvage, search and rescue (SAR), spill response, etc., as applicable; and, in the case of ships ice strengthened in accordance with chapter 3, procedures for maintaining life support and ship integrity in the event of prolonged entrapment by ice.</nltl:evidenceExcerpt>
    <skos:altLabel>ship_ice_strengthened</skos:altLabel>
    <nltl:sourceAlias>ship_ice_strengthened</nltl:sourceAlias>
    <nltl:sourceRequirementId>IMO-028</nltl:sourceRequirementId>
    <nltl:sourceRequirementId>IMO-032</nltl:sourceRequirementId>
    <nltl:sourceRequirementId>IMO-049</nltl:sourceRequirementId>
    <nltl:sourceRequirementId>IMO-081</nltl:sourceRequirementId>
    <nltl:sourceRequirementId>IMO26-007</nltl:sourceRequirementId>
