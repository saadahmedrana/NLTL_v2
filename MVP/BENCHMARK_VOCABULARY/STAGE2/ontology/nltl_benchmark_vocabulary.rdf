    <skos:prefLabel xml:lang="en">Main power</skos:prefLabel>
    <nltl:draftConceptId>VOC-0443</nltl:draftConceptId>
    <nltl:stage1LocalName>mainPower</nltl:stage1LocalName>
    <nltl:module rdf:resource="https://w3id.org/nltl/vocab#moduleCore"/>
