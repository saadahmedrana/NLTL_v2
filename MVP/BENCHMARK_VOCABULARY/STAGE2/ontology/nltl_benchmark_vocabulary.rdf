  <rdf:Description rdf:about="https://w3id.org/nltl/vocab#administrationApprovedEquivalentDepthSoundingDevicePresent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nltl/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Administration approved equivalent depth sounding device present</rdfs:label>
    <skos:prefLabel xml:lang="en">Administration approved equivalent depth sounding device present</skos:prefLabel>
    <nltl:draftConceptId>VOC-0014</nltl:draftConceptId>
    <nltl:stage1LocalName>administrationApprovedEquivalentDepthSoundingDevicePresent</nltl:stage1LocalName>
    <nltl:module rdf:resource="https://w3id.org/nltl/vocab#moduleCore"/>
    <nltl:roleDecisionBasis>Stage 1 explicit boolean</nltl:roleDecisionBasis>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
    <nltl:namingRule>N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase</nltl:namingRule>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for administrationApprovedEquivalentDepthSoundingDevicePresent derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <nltl:sourceReference>IMO26-007 | IMO_AMEND_2026 p.3 | 9-1.3.2.1.1</nltl:sourceReference>
    <nltl:evidenceExcerpt>Ice-strengthened ships constructed on or after 1 January 2026 shall have either two independent echo-sounding devices or one echo-sounding device with two separate independent transducers. Other devices capable of depth sounding, such as fish finders, acceptable to the Administration, may be used as equivalent means of meeting this requirement.</nltl:evidenceExcerpt>
    <skos:altLabel>administration_approved_equivalent_depth_sounding_device_present</skos:altLabel>
    <nltl:sourceAlias>administration_approved_equivalent_depth_sounding_device_present</nltl:sourceAlias>
    <nltl:sourceRequirementId>IMO26-007</nltl:sourceRequirementId>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl/vocab#administrationApprovedEquivalentVisibilityArrangementPresent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nltl/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Administration approved equivalent visibility arrangement present</rdfs:label>
    <skos:prefLabel xml:lang="en">Administration approved equivalent visibility arrangement present</skos:prefLabel>
    <nltl:draftConceptId>VOC-0015</nltl:draftConceptId>
    <nltl:stage1LocalName>administrationApprovedEquivalentVisibilityArrangementPresent</nltl:stage1LocalName>
    <nltl:module rdf:resource="https://w3id.org/nltl/vocab#moduleCore"/>
    <nltl:roleDecisionBasis>Stage 1 explicit boolean</nltl:roleDecisionBasis>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
    <nltl:namingRule>N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase</nltl:namingRule>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for administrationApprovedEquivalentVisibilityArrangementPresent derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <nltl:sourceReference>IMO26-008 | IMO_AMEND_2026 p.3 | 9-1.3.2.1.2</nltl:sourceReference>
    <nltl:evidenceExcerpt>Ships shall comply with SOLAS regulation V/22.1.9.4, irrespective of the date of construction and the size, and have a clear view astern. On ships which cannot comply with these requirements, arrangements acceptable to the Administration shall be provided to achieve a level of visibility that is equivalent to these requirements.</nltl:evidenceExcerpt>
    <skos:altLabel>administration_approved_equivalent_visibility_arrangement_present</skos:altLabel>
