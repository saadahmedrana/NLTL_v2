  <rdf:Description rdf:about="https://w3id.org/nltl/vocab#torsionalVibrationAnalysis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nltl/vocab#engineeringAnalysis"/>
    <rdfs:label xml:lang="en">Torsional vibration analysis</rdfs:label>
    <skos:prefLabel xml:lang="en">Torsional vibration analysis</skos:prefLabel>
    <nltl:draftConceptId>VOC-0769</nltl:draftConceptId>
    <nltl:stage1LocalName>torsionalVibrationAnalysis</nltl:stage1LocalName>
    <nltl:module rdf:resource="https://w3id.org/nltl/vocab#moduleDocuments"/>
    <nltl:roleDecisionBasis>Explicit engineering entity/artifact class set</nltl:roleDecisionBasis>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for torsionalVibrationAnalysis derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <nltl:sourceReference>TRF-089 | TRAFICOM p.39 | 6.5.3.4</nltl:sourceReference>
    <nltl:evidenceExcerpt>If there is first blade order torsional resonance in the operational speed range or in the range 20% above and 20% below the maximum operating speed (bollard condition), the design torque (Qpeak) of the shaft component shall be determined by means of torsional vibration</nltl:evidenceExcerpt>
    <skos:altLabel>torsionalVibrationAnalysis</skos:altLabel>
    <nltl:sourceAlias>torsionalVibrationAnalysis</nltl:sourceAlias>
    <nltl:sourceRequirementId>TRF-089</nltl:sourceRequirementId>
  </rdf:Description>
