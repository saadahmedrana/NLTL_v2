    <nltl:draftConceptId>VOC-0148</nltl:draftConceptId>
    <nltl:stage1LocalName>combinedAxialBendingTorsionLoad</nltl:stage1LocalName>
    <nltl:module rdf:resource="https://w3id.org/nltl/vocab#moduleMachinery"/>
