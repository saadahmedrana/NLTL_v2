    <skos:prefLabel xml:lang="en">Survey compliance status</skos:prefLabel>
    <nltl:draftConceptId>VOC-0738</nltl:draftConceptId>
    <nltl:stage1LocalName>surveyComplianceStatus</nltl:stage1LocalName>
    <nltl:module rdf:resource="https://w3id.org/nltl/vocab#moduleDocuments"/>
    <nltl:roleDecisionBasis>Stage 1 explicit boolean</nltl:roleDecisionBasis>
    <nltl:namingBasis>Locked-workbook normalized regulatory term</nltl:namingBasis>
    <nltl:namingRule>N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase</nltl:namingRule>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for surveyComplianceStatus derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <nltl:sourceReference>IMO-015 | IMO_POLAR_CODE p.14 | 1.3.2</nltl:sourceReference>
    <nltl:evidenceExcerpt>Except as provided for in paragraph 1.3.3, the Polar Ship Certificate shall be issued after an initial or renewal survey to a ship which complies with the relevant requirements of this Code.</nltl:evidenceExcerpt>
    <skos:altLabel>survey_compliance_status</skos:altLabel>
    <nltl:sourceAlias>survey_compliance_status</nltl:sourceAlias>
    <nltl:sourceRequirementId>IMO-015</nltl:sourceRequirementId>
