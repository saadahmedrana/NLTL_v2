  <rdf:Description rdf:about="https://w3id.org/nltl/vocab#directCalculationMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nltl/vocab#benchmarkEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Direct calculation method</rdfs:label>
    <skos:prefLabel xml:lang="en">Direct calculation method</skos:prefLabel>
    <nltl:draftConceptId>VOC-0205</nltl:draftConceptId>
    <nltl:stage1LocalName>directCalculationMethod</nltl:stage1LocalName>
    <nltl:module rdf:resource="https://w3id.org/nltl/vocab#moduleCore"/>
    <nltl:roleDecisionBasis>Stage 1 controlled-enumeration string</nltl:roleDecisionBasis>
    <nltl:namingBasis>Benchmark-coined descriptive engineering term</nltl:namingBasis>
    <nltl:namingRule>N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping</nltl:namingRule>
    <nltl:unitDecisionStatus>Not a quantity property</nltl:unitDecisionStatus>
    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for directCalculationMethod derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <nltl:sourceReference>TRF-031 | TRAFICOM p.12 | 4.1</nltl:sourceReference>
    <nltl:evidenceExcerpt>The acceptance criterion for designs is that the combined stresses from bending and shear, when using the von Mises yield criterion, are lower than the yield point sigmay. When the direct calculation is based on beam theory, the allowable shear stress must be no larger than 0.9*tauy, where tauy = sigmay/sqrt3.</nltl:evidenceExcerpt>
    <skos:altLabel>directCalculationMethod</skos:altLabel>
    <nltl:sourceAlias>directCalculationMethod</nltl:sourceAlias>
    <nltl:sourceRequirementId>TRF-031</nltl:sourceRequirementId>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nltl/vocab#polarCertificateSupplementPresent">
