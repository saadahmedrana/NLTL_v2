    <skos:definition xml:lang="en">NORMALIZED (Stage 1): candidate concept for betaIPrime derived from the linked locked requirements; scope and final semantics require vocabulary approval.</skos:definition>
    <nltl:sourceReference>I2-015 | IACS_UR_I2 p.5 | I2.3.2.1</nltl:sourceReference>
    <nltl:evidenceExcerpt>For bow forms defined in I2.3.1(v), the shape coefficient f_ai is to be taken as f_ai = minimum(f_ai1, f_ai2, f_ai3), where f_ai1 = (0.097 - 0.68*(x/L_UI - 0.15)^2)*alpha_i/(beta_i_prime)^0.5, f_ai2 = 1.2*C_FF/(sin(beta_i_prime)*C_FC*D_UI^0.64), and f_ai3 = 0.60.</nltl:evidenceExcerpt>
    <skos:altLabel>beta_i_prime</skos:altLabel>
    <nltl:sourceAlias>beta_i_prime</nltl:sourceAlias>
    <nltl:sourceRequirementId>I2-015</nltl:sourceRequirementId>
    <nltl:unitSymbol>1</nltl:unitSymbol>
    <nltl:recommendedUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
