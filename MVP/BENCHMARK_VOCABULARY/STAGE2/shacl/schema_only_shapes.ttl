nsh:evidenceArtifactShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:name "evidence source" ;
            sh:path dct:source ] ;
    sh:targetClass nltl:evidenceArtifact .

nsh:observationShape a sh:NodeShape ;
    sh:or ( [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:path sosa:hasSimpleResult ] [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:nodeKind sh:BlankNodeOrIRI ;
                sh:path sosa:hasResult ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "feature of interest" ;
            sh:nodeKind sh:IRI ;
            sh:path sosa:hasFeatureOfInterest ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "observed property" ;
            sh:nodeKind sh:IRI ;
            sh:path sosa:observedProperty ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "result time" ;
            sh:path sosa:resultTime ] ;
    sh:targetClass sosa:Observation .

