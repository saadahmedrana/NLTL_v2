nsh:quantityValueShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "unit" ;
            sh:nodeKind sh:IRI ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "numeric value" ;
            sh:path qudt:numericValue ] ;
    sh:targetClass qudt:QuantityValue .

