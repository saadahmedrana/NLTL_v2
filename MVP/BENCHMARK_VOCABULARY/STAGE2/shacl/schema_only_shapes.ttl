<https://w3id.org/nltl/shapes> a owl:Ontology ;
    rdfs:label "NLTL benchmark schema-only SHACL shapes" ;
    dct:description "Validates canonical node/value structures only. It contains no regulatory applicability, threshold, formula, comparison result, or expected pass/fail logic." .

