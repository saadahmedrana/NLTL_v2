@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-006:fail:ship> a nltl:ship ;
    nltl:applicableIceClassRegulationEdition nltl:iceClassRegulationEdition2008 ;
    nltl:constructionStageDate "1986-11-01"^^xsd:date ;
    nltl:engineOutputRegulationEdition nltl:iceClassRegulationEdition2008 ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-006:fail:component> ;
    nltl:iceClass <urn:nltl:batch01-fixture:TRF-006:fail:node:iceClass> ;
    nltl:maximumContinuousRatingPower <urn:nltl:batch01-fixture:TRF-006:fail:q:maximumContinuousRatingPower> .

<urn:nltl:batch01-fixture:TRF-006:fail:component> a nltl:shipComponent .

<urn:nltl:batch01-fixture:TRF-006:fail:node:iceClass> a nltl:iceClassValue .

<urn:nltl:batch01-fixture:TRF-006:fail:q:maximumContinuousRatingPower> a qudt:QuantityValue ;
