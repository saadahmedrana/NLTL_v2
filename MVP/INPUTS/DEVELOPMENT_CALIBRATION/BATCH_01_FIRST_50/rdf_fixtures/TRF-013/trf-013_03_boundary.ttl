@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-013:boundary:ship> a nltl:ship ;
    nltl:draughtAtAftPerpendicular <urn:nltl:batch01-fixture:TRF-013:boundary:q:draughtAtAftPerpendicular> ;
    nltl:draughtAtForePerpendicular <urn:nltl:batch01-fixture:TRF-013:boundary:q:draughtAtForePerpendicular> ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-013:boundary:component> ;
    nltl:hasIntendedIceOperatingWaterline <urn:nltl:batch01-fixture:TRF-013:boundary:intended> ;
    nltl:hasLowerIceWaterline <urn:nltl:batch01-fixture:TRF-013:boundary:liwl> ;
    nltl:hasUpperIceWaterline <urn:nltl:batch01-fixture:TRF-013:boundary:uiwl> ;
    nltl:iceClass nltl:iceClassIa ;
    nltl:operatingAftDraught <urn:nltl:batch01-fixture:TRF-013:boundary:q:operatingAftDraught> ;
    nltl:operatingForeDraught <urn:nltl:batch01-fixture:TRF-013:boundary:q:operatingForeDraught> ;
    nltl:shipIceStrengthened true .

<urn:nltl:batch01-fixture:TRF-013:boundary:component> a nltl:shipComponent .

<urn:nltl:batch01-fixture:TRF-013:boundary:intended> a nltl:iceWaterline ;
    nltl:hasWaterlineProfilePoint <urn:nltl:batch01-fixture:TRF-013:boundary:point:3>,
        <urn:nltl:batch01-fixture:TRF-013:boundary:point:4> .

<urn:nltl:batch01-fixture:TRF-013:boundary:liwl> a nltl:iceWaterline ;
    nltl:draughtAtAftPerpendicular <urn:nltl:batch01-fixture:TRF-013:boundary:q:lower:draughtAtAftPerpendicular> ;
    nltl:draughtAtForePerpendicular <urn:nltl:batch01-fixture:TRF-013:boundary:q:lower:draughtAtForePerpendicular> ;
    nltl:hasWaterlineProfilePoint <urn:nltl:batch01-fixture:TRF-013:boundary:point:2> .

<urn:nltl:batch01-fixture:TRF-013:boundary:point:1> a nltl:waterlineProfilePoint ;
    nltl:longitudinalPosition <urn:nltl:batch01-fixture:TRF-013:boundary:point:1:x> ;
    nltl:verticalCoordinate <urn:nltl:batch01-fixture:TRF-013:boundary:point:1:z> .

<urn:nltl:batch01-fixture:TRF-013:boundary:point:1:x> a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-013:boundary:point:1:z> a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-013:boundary:point:2> a nltl:waterlineProfilePoint ;
    nltl:longitudinalPosition <urn:nltl:batch01-fixture:TRF-013:boundary:point:2:x> ;
    nltl:verticalCoordinate <urn:nltl:batch01-fixture:TRF-013:boundary:point:2:z> .

<urn:nltl:batch01-fixture:TRF-013:boundary:point:2:x> a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-013:boundary:point:2:z> a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-013:boundary:point:3> a nltl:waterlineProfilePoint ;
    nltl:longitudinalPosition <urn:nltl:batch01-fixture:TRF-013:boundary:point:3:x> ;
    nltl:verticalCoordinate <urn:nltl:batch01-fixture:TRF-013:boundary:point:3:z> .

<urn:nltl:batch01-fixture:TRF-013:boundary:point:3:x> a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-013:boundary:point:3:z> a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-013:boundary:point:4> a nltl:waterlineProfilePoint ;
    nltl:longitudinalPosition <urn:nltl:batch01-fixture:TRF-013:boundary:point:4:x> ;
    nltl:verticalCoordinate <urn:nltl:batch01-fixture:TRF-013:boundary:point:4:z> .

<urn:nltl:batch01-fixture:TRF-013:boundary:point:4:x> a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-013:boundary:point:4:z> a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-013:boundary:q:draughtAtAftPerpendicular> a qudt:QuantityValue ;
    qudt:numericValue 6.5 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-013:boundary:q:draughtAtForePerpendicular> a qudt:QuantityValue ;
    qudt:numericValue 6.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-013:boundary:q:lower:draughtAtAftPerpendicular> a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-013:boundary:q:lower:draughtAtForePerpendicular> a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-013:boundary:q:operatingAftDraught> a qudt:QuantityValue ;
    qudt:numericValue 6.5 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-013:boundary:q:operatingForeDraught> a qudt:QuantityValue ;
    qudt:numericValue 6.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-013:boundary:q:upper:draughtAtAftPerpendicular> a qudt:QuantityValue ;
    qudt:numericValue 7.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-013:boundary:q:upper:draughtAtForePerpendicular> a qudt:QuantityValue ;
    qudt:numericValue 7.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-013:boundary:uiwl> a nltl:iceWaterline ;
    nltl:draughtAtAftPerpendicular <urn:nltl:batch01-fixture:TRF-013:boundary:q:upper:draughtAtAftPerpendicular> ;
    nltl:draughtAtForePerpendicular <urn:nltl:batch01-fixture:TRF-013:boundary:q:upper:draughtAtForePerpendicular> ;
    nltl:hasWaterlineProfilePoint <urn:nltl:batch01-fixture:TRF-013:boundary:point:1> .

