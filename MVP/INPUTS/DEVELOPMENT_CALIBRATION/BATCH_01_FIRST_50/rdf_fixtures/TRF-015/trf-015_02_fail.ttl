@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-015:fail:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-015:fail:component> ;
    nltl:intendedRouteSeaWaterSalinity <urn:nltl:batch01-fixture:TRF-015:fail:q:intendedRouteSeaWaterSalinity> ;
    nltl:loadingCalculationSeaWaterSalinity <urn:nltl:batch01-fixture:TRF-015:fail:q:loadingCalculationSeaWaterSalinity> ;
    nltl:maximumPermittedIceTrim <urn:nltl:batch01-fixture:TRF-015:fail:q:maximumPermittedIceTrim> ;
    nltl:navigatingInIce true ;
    nltl:operatingDraught <urn:nltl:batch01-fixture:TRF-015:fail:q:operatingDraught> ;
    nltl:operatingTrim <urn:nltl:batch01-fixture:TRF-015:fail:q:operatingTrim> ;
    nltl:upperIceWaterlineDraught <urn:nltl:batch01-fixture:TRF-015:fail:q:upperIceWaterlineDraught> .

<urn:nltl:batch01-fixture:TRF-015:fail:component> a nltl:shipComponent .

<urn:nltl:batch01-fixture:TRF-015:fail:q:intendedRouteSeaWaterSalinity> a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit nltl:gramPerKilogramSalinityUnit .

<urn:nltl:batch01-fixture:TRF-015:fail:q:loadingCalculationSeaWaterSalinity> a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit nltl:gramPerKilogramSalinityUnit .

<urn:nltl:batch01-fixture:TRF-015:fail:q:maximumPermittedIceTrim> a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-015:fail:q:operatingDraught> a qudt:QuantityValue ;
    qudt:numericValue 7.1 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-015:fail:q:operatingTrim> a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-015:fail:q:upperIceWaterlineDraught> a qudt:QuantityValue ;
    qudt:numericValue 7.0 ;
    qudt:unit unit:M .

