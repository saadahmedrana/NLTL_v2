@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-017:fail:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-017:fail:component> ;
    nltl:maximumContinuousRatingPower <urn:nltl:batch01-fixture:TRF-017:fail:q:maximumContinuousRatingPower> ;
    nltl:propulsionMachineryContinuousOutput <urn:nltl:batch01-fixture:TRF-017:fail:q:propulsionMachineryContinuousOutput> ;
    nltl:propulsionOutputRestrictionApplies false ;
    nltl:restrictedPropulsionOutput <urn:nltl:batch01-fixture:TRF-017:fail:q:restrictedPropulsionOutput> .

<urn:nltl:batch01-fixture:TRF-017:fail:component> a nltl:shipComponent .

<urn:nltl:batch01-fixture:TRF-017:fail:q:maximumContinuousRatingPower> a qudt:QuantityValue ;
    qudt:numericValue 5500.0 ;
    qudt:unit unit:KiloW .

<urn:nltl:batch01-fixture:TRF-017:fail:q:propulsionMachineryContinuousOutput> a qudt:QuantityValue ;
    qudt:numericValue 5000.0 ;
    qudt:unit unit:KiloW .

<urn:nltl:batch01-fixture:TRF-017:fail:q:restrictedPropulsionOutput> a qudt:QuantityValue ;
