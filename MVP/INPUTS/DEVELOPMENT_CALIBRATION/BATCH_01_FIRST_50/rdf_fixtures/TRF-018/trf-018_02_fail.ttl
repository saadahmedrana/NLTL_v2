@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-018:fail:ship> a nltl:ship ;
    nltl:calculatedRequiredPower <urn:nltl:batch01-fixture:TRF-018:fail:q:calculatedRequiredPower> ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-018:fail:component> ;
    nltl:iceClass nltl:iceClassIa ;
    nltl:maximumContinuousRatingPower <urn:nltl:batch01-fixture:TRF-018:fail:q:maximumContinuousRatingPower> .

<urn:nltl:batch01-fixture:TRF-018:fail:component> a nltl:shipComponent .

<urn:nltl:batch01-fixture:TRF-018:fail:q:calculatedRequiredPower> a qudt:QuantityValue ;
    qudt:numericValue 1000.0 ;
    qudt:unit unit:KiloW .

<urn:nltl:batch01-fixture:TRF-018:fail:q:maximumContinuousRatingPower> a qudt:QuantityValue ;
    qudt:numericValue 999.0 ;
    qudt:unit unit:KiloW .

