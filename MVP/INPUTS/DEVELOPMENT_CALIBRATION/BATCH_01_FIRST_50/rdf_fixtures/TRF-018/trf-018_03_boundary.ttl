@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-018:boundary:ship> a nltl:ship ;
    nltl:calculatedRequiredPower <urn:nltl:batch01-fixture:TRF-018:boundary:q:calculatedRequiredPower> ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-018:boundary:component> ;
    nltl:iceClass nltl:iceClassIaSuper ;
    nltl:maximumContinuousRatingPower <urn:nltl:batch01-fixture:TRF-018:boundary:q:maximumContinuousRatingPower> .

<urn:nltl:batch01-fixture:TRF-018:boundary:component> a nltl:shipComponent .

<urn:nltl:batch01-fixture:TRF-018:boundary:q:calculatedRequiredPower> a qudt:QuantityValue ;
    qudt:numericValue 2800.0 ;
    qudt:unit unit:KiloW .

<urn:nltl:batch01-fixture:TRF-018:boundary:q:maximumContinuousRatingPower> a qudt:QuantityValue ;
