<urn:nltl:batch01-fixture:TRF-023:pass:ship> a nltl:ship ;
    nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-023:pass:component> ;
    nltl:iceClass nltl:iceClassIb ;
    nltl:maximumContinuousRatingPower <urn:nltl:batch01-fixture:TRF-023:pass:q:maximumContinuousRatingPower> ;
    nltl:requiredPowerUnder1985Rules <urn:nltl:batch01-fixture:TRF-023:pass:q:requiredPowerUnder1985Rules> .

<urn:nltl:batch01-fixture:TRF-023:pass:component> a nltl:shipComponent .

