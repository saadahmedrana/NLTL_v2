@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-034:fail:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-034:fail:component> .

<urn:nltl:batch01-fixture:TRF-034:fail:component> a nltl:hullStructure,
        nltl:iceStringer,
        nltl:shipComponent ;
    nltl:hasEffectiveMemberCrossSection <urn:nltl:batch01-fixture:TRF-034:fail:effective-cross-section> ;
    nltl:memberNormalToPlating false .

<urn:nltl:batch01-fixture:TRF-034:fail:effective-cross-section> a nltl:effectiveMemberCrossSection ;
    nltl:sectionModulus <urn:nltl:batch01-fixture:TRF-034:fail:q:sectionModulus> ;
    nltl:shearArea <urn:nltl:batch01-fixture:TRF-034:fail:q:shearArea> .

<urn:nltl:batch01-fixture:TRF-034:fail:q:sectionModulus> a qudt:QuantityValue ;
    qudt:numericValue 200.0 ;
    qudt:unit unit:CentiM3 .

<urn:nltl:batch01-fixture:TRF-034:fail:q:shearArea> a qudt:QuantityValue ;
    qudt:numericValue 0.01 ;
    qudt:unit unit:M2 .

