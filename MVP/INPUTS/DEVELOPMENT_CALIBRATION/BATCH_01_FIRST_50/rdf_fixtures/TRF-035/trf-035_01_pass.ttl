@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-035:pass:ship> a nltl:ship ;
    nltl:classificationSociety "verified"^^xsd:string ;
    nltl:classificationSocietyRuleLength <urn:nltl:batch01-fixture:TRF-035:pass:q:classificationSocietyRuleLength> ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-035:pass:component> ;
    nltl:hullRegion nltl:bowRegion ;
    nltl:ruleLength <urn:nltl:batch01-fixture:TRF-035:pass:q:ruleLength> .

<urn:nltl:batch01-fixture:TRF-035:pass:component> a nltl:shipComponent .

<urn:nltl:batch01-fixture:TRF-035:pass:q:classificationSocietyRuleLength> a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-035:pass:q:ruleLength> a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:M .

