@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-036:pass:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-036:pass:component> ;
    nltl:hasIceClassDesignParameterSet <urn:nltl:batch01-fixture:TRF-036:pass:design-parameter-set> ;
    nltl:iceClass nltl:iceClassIa .

<urn:nltl:batch01-fixture:TRF-036:pass:component> a nltl:shipComponent .

<urn:nltl:batch01-fixture:TRF-036:pass:design-parameter-set> a nltl:iceClassDesignParameterSet ;
    nltl:designIceLoadHeight <urn:nltl:batch01-fixture:TRF-036:pass:q:designIceLoadHeight:design-set> ;
    nltl:levelIceThickness <urn:nltl:batch01-fixture:TRF-036:pass:q:levelIceThickness:design-set> .

<urn:nltl:batch01-fixture:TRF-036:pass:q:designIceLoadHeight:design-set> a qudt:QuantityValue ;
    qudt:numericValue 0.3 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-036:pass:q:levelIceThickness:design-set> a qudt:QuantityValue ;
