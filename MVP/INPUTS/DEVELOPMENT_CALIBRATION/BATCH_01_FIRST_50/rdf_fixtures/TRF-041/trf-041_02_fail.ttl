@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-041:fail:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-041:fail:component> .

<urn:nltl:batch01-fixture:TRF-041:fail:component> a nltl:plating,
        nltl:shipComponent ;
    nltl:corrosionAbrasionAddition <urn:nltl:batch01-fixture:TRF-041:fail:q:corrosionAbrasionAddition> ;
    nltl:hullStructuralSteelGrade nltl:highStrengthHullStructuralSteel ;
    nltl:icePressure <urn:nltl:batch01-fixture:TRF-041:fail:q:icePressure> ;
    nltl:longitudinalPlatingFactorF2 <urn:nltl:batch01-fixture:TRF-041:fail:q:longitudinalPlatingFactorF2> ;
    nltl:platingFramingOrientation nltl:transverseFramingOrientation ;
    nltl:platingPressure <urn:nltl:batch01-fixture:TRF-041:fail:q:platingPressure> ;
    nltl:requiredShellPlatingThickness <urn:nltl:batch01-fixture:TRF-041:fail:q:requiredShellPlatingThickness> ;
    nltl:spacing <urn:nltl:batch01-fixture:TRF-041:fail:q:spacing> ;
    nltl:transversePlatingFactorF1 <urn:nltl:batch01-fixture:TRF-041:fail:q:transversePlatingFactorF1> ;
    nltl:yieldStrength <urn:nltl:batch01-fixture:TRF-041:fail:q:yieldStrength> .

<urn:nltl:batch01-fixture:TRF-041:fail:q:corrosionAbrasionAddition> a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:MilliM .

<urn:nltl:batch01-fixture:TRF-041:fail:q:icePressure> a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:MegaPA .

<urn:nltl:batch01-fixture:TRF-041:fail:q:longitudinalPlatingFactorF2> a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

<urn:nltl:batch01-fixture:TRF-041:fail:q:platingPressure> a qudt:QuantityValue ;
    qudt:numericValue 0.75 ;
    qudt:unit unit:MegaPA .

<urn:nltl:batch01-fixture:TRF-041:fail:q:requiredShellPlatingThickness> a qudt:QuantityValue ;
    qudt:numericValue 20.0 ;
    qudt:unit unit:MilliM .

<urn:nltl:batch01-fixture:TRF-041:fail:q:spacing> a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-041:fail:q:transversePlatingFactorF1> a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

<urn:nltl:batch01-fixture:TRF-041:fail:q:yieldStrength> a qudt:QuantityValue ;
    qudt:numericValue 235.0 ;
    qudt:unit unit:MegaPA .

