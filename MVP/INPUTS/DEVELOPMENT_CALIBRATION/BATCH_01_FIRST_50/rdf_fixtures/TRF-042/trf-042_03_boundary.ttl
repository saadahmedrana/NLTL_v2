@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-042:boundary:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-042:boundary:component> .

<urn:nltl:batch01-fixture:TRF-042:boundary:component> a nltl:plating,
        nltl:shipComponent ;
    nltl:corrosionAbrasionAddition <urn:nltl:batch01-fixture:TRF-042:boundary:q:corrosionAbrasionAddition> ;
    nltl:designIceLoadHeight <urn:nltl:batch01-fixture:TRF-042:boundary:q:designIceLoadHeight> ;
    nltl:hullStructuralSteelGrade nltl:normalStrengthHullStructuralSteel ;
    nltl:longitudinalPlatingFactorF2 <urn:nltl:batch01-fixture:TRF-042:boundary:q:longitudinalPlatingFactorF2> ;
    nltl:materialApprovalStatus nltl:evidenceStateApproved ;
    nltl:requiredShellPlatingThickness <urn:nltl:batch01-fixture:TRF-042:boundary:q:requiredShellPlatingThickness> ;
    nltl:spacing <urn:nltl:batch01-fixture:TRF-042:boundary:q:spacing> ;
    nltl:specialSurfaceCoatingMaintained false ;
    nltl:yieldStrength <urn:nltl:batch01-fixture:TRF-042:boundary:q:yieldStrength> .

<urn:nltl:batch01-fixture:TRF-042:boundary:q:corrosionAbrasionAddition> a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:MilliM .

<urn:nltl:batch01-fixture:TRF-042:boundary:q:designIceLoadHeight> a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-042:boundary:q:longitudinalPlatingFactorF2> a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

<urn:nltl:batch01-fixture:TRF-042:boundary:q:requiredShellPlatingThickness> a qudt:QuantityValue ;
    qudt:numericValue 23.754 ;
    qudt:unit unit:MilliM .

<urn:nltl:batch01-fixture:TRF-042:boundary:q:spacing> a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-042:boundary:q:yieldStrength> a qudt:QuantityValue ;
    qudt:numericValue 235.0 ;
    qudt:unit unit:MegaPA .

