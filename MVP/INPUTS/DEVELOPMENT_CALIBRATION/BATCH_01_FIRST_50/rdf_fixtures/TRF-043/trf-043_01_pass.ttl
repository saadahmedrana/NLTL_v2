@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-043:pass:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-043:pass:component> .

<urn:nltl:batch01-fixture:TRF-043:pass:component> a nltl:frame,
        nltl:shipComponent ;
    nltl:extensionBeyondAdjacentDeckOrTankBoundary <urn:nltl:batch01-fixture:TRF-043:pass:q:extensionBeyondAdjacentDeckOrTankBoundary> ;
    nltl:framingIceStrengtheningAboveUpperIceWaterline <urn:nltl:batch01-fixture:TRF-043:pass:q:framingIceStrengtheningAboveUpperIceWaterline> ;
    nltl:framingIceStrengtheningBelowLowerIceWaterline <urn:nltl:batch01-fixture:TRF-043:pass:q:framingIceStrengtheningBelowLowerIceWaterline> ;
    nltl:hullRegion nltl:midbodyRegion ;
    nltl:iceClass nltl:iceClassIaSuper ;
    nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted true ;
    nltl:reachesTankTopOrBelowFloorTop true ;
    nltl:reachesUpperBowIceBeltTop true ;
    nltl:upperBowIceBeltRequired false .

<urn:nltl:batch01-fixture:TRF-043:pass:q:extensionBeyondAdjacentDeckOrTankBoundary> a qudt:QuantityValue ;
    qudt:numericValue 250.0 ;
    qudt:unit unit:MilliM .

<urn:nltl:batch01-fixture:TRF-043:pass:q:framingIceStrengtheningAboveUpperIceWaterline> a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-043:pass:q:framingIceStrengtheningBelowLowerIceWaterline> a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:M .

