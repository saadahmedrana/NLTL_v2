@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-045:boundary:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-045:boundary:component> .

<urn:nltl:batch01-fixture:TRF-045:boundary:component> a nltl:frame,
        nltl:shipComponent ;
    nltl:frameSpanWithinIceStrengtheningZone <urn:nltl:batch01-fixture:TRF-045:boundary:q:frameSpanWithinIceStrengtheningZone> ;
    nltl:ordinaryFrameScantlingsUsed false ;
    nltl:span <urn:nltl:batch01-fixture:TRF-045:boundary:q:span> .

<urn:nltl:batch01-fixture:TRF-045:boundary:q:frameSpanWithinIceStrengtheningZone> a qudt:QuantityValue ;
    qudt:numericValue 1.5 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-045:boundary:q:span> a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:M .

