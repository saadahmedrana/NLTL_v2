@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-046:fail:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-046:fail:component>,
        <urn:nltl:batch01-fixture:TRF-046:fail:frame:1>,
        <urn:nltl:batch01-fixture:TRF-046:fail:frame:2> .

<urn:nltl:batch01-fixture:TRF-046:fail:support:1> a nltl:deckStructure ;
    nltl:supportingStructureAtOrAboveIceBeltUpperLimit true .

<urn:nltl:batch01-fixture:TRF-046:fail:adjacent-main-frame:2> a nltl:frame,
        nltl:mainFrame ;
    nltl:hasStrengthenedPart <urn:nltl:batch01-fixture:TRF-046:fail:adjacent-main-frame:2:part> ;
    nltl:hasUpperEnd <urn:nltl:batch01-fixture:TRF-046:fail:adjacent-main-frame:2:end> .

<urn:nltl:batch01-fixture:TRF-046:fail:adjacent-main-frame:2:end> a nltl:frameEnd ;
    nltl:hasAttachedSupportingStructure <urn:nltl:batch01-fixture:TRF-046:fail:support:2> .

<urn:nltl:batch01-fixture:TRF-046:fail:adjacent-main-frame:2:part> a nltl:frameStrengthenedPart .

<urn:nltl:batch01-fixture:TRF-046:fail:component> a nltl:shipComponent .

<urn:nltl:batch01-fixture:TRF-046:fail:frame-end:1> a nltl:frameEnd .

<urn:nltl:batch01-fixture:TRF-046:fail:frame-end:2> a nltl:frameEnd ;
    nltl:hasHorizontalConnectionMember <urn:nltl:batch01-fixture:TRF-046:fail:horizontal-member> .

<urn:nltl:batch01-fixture:TRF-046:fail:frame:2> a nltl:frame,
        nltl:intermediateIceFrame ;
    nltl:hasStrengthenedPart <urn:nltl:batch01-fixture:TRF-046:fail:strengthened-part:2> ;
    nltl:hasUpperEnd <urn:nltl:batch01-fixture:TRF-046:fail:frame-end:2> .

<urn:nltl:batch01-fixture:TRF-046:fail:horizontal-member> a nltl:horizontalConnectionMember ;
    nltl:connectsToAdjacentMainFrame <urn:nltl:batch01-fixture:TRF-046:fail:adjacent-main-frame:2>,
        <urn:nltl:batch01-fixture:TRF-046:fail:frame:1> ;
    nltl:sameScantlingsAsMainFrame true .

<urn:nltl:batch01-fixture:TRF-046:fail:strengthened-part:1> a nltl:frameStrengthenedPart .

<urn:nltl:batch01-fixture:TRF-046:fail:strengthened-part:2> a nltl:frameStrengthenedPart .

<urn:nltl:batch01-fixture:TRF-046:fail:support:2> a nltl:tankBoundaryPlating ;
    nltl:supportingStructureAtOrAboveIceBeltUpperLimit true .

<urn:nltl:batch01-fixture:TRF-046:fail:frame:1> a nltl:frame,
        nltl:mainFrame ;
    nltl:hasStrengthenedPart <urn:nltl:batch01-fixture:TRF-046:fail:strengthened-part:1> ;
    nltl:hasUpperEnd <urn:nltl:batch01-fixture:TRF-046:fail:frame-end:1> .

