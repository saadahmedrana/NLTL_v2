@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-046:boundary:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-046:boundary:component>,
        <urn:nltl:batch01-fixture:TRF-046:boundary:frame:1>,
        <urn:nltl:batch01-fixture:TRF-046:boundary:frame:2> .

<urn:nltl:batch01-fixture:TRF-046:boundary:adjacent-main-frame> a nltl:mainFrame .

<urn:nltl:batch01-fixture:TRF-046:boundary:component> a nltl:shipComponent .

<urn:nltl:batch01-fixture:TRF-046:boundary:frame-end:1> a nltl:frameEnd ;
    nltl:hasAttachedSupportingStructure <urn:nltl:batch01-fixture:TRF-046:boundary:support:1> .

<urn:nltl:batch01-fixture:TRF-046:boundary:frame-end:2> a nltl:frameEnd ;
    nltl:hasAttachedSupportingStructure <urn:nltl:batch01-fixture:TRF-046:boundary:support:2> ;
    nltl:hasHorizontalConnectionMember <urn:nltl:batch01-fixture:TRF-046:boundary:horizontal-member> .

<urn:nltl:batch01-fixture:TRF-046:boundary:frame:1> a nltl:mainFrame ;
    nltl:hasStrengthenedPart <urn:nltl:batch01-fixture:TRF-046:boundary:strengthened-part:1> ;
    nltl:hasUpperEnd <urn:nltl:batch01-fixture:TRF-046:boundary:frame-end:1> .

<urn:nltl:batch01-fixture:TRF-046:boundary:frame:2> a nltl:intermediateIceFrame ;
    nltl:hasStrengthenedPart <urn:nltl:batch01-fixture:TRF-046:boundary:strengthened-part:2> ;
    nltl:hasUpperEnd <urn:nltl:batch01-fixture:TRF-046:boundary:frame-end:2> .

<urn:nltl:batch01-fixture:TRF-046:boundary:horizontal-member> a nltl:horizontalConnectionMember ;
    nltl:connectsToAdjacentMainFrame <urn:nltl:batch01-fixture:TRF-046:boundary:adjacent-main-frame> ;
    nltl:sameScantlingsAsMainFrame true .

<urn:nltl:batch01-fixture:TRF-046:boundary:strengthened-part:1> a nltl:frameStrengthenedPart .

<urn:nltl:batch01-fixture:TRF-046:boundary:strengthened-part:2> a nltl:frameStrengthenedPart .

<urn:nltl:batch01-fixture:TRF-046:boundary:support:1> a nltl:deckStructure ;
    nltl:supportingStructureAtOrAboveIceBeltUpperLimit true .

<urn:nltl:batch01-fixture:TRF-046:boundary:support:2> a nltl:tankBoundaryPlating ;
    nltl:supportingStructureAtOrAboveIceBeltUpperLimit true .

