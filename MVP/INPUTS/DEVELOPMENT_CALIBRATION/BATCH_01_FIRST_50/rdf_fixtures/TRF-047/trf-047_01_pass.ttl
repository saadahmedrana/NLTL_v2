@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-047:pass:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-047:pass:component>,
        <urn:nltl:batch01-fixture:TRF-047:pass:frame:1>,
        <urn:nltl:batch01-fixture:TRF-047:pass:frame:2> .

<urn:nltl:batch01-fixture:TRF-047:pass:adjacent-main-frame> a nltl:mainFrame .

<urn:nltl:batch01-fixture:TRF-047:pass:component> a nltl:frame,
        nltl:shipComponent ;
    nltl:hasStrengthenedPart <urn:nltl:batch01-fixture:TRF-047:pass:node:hasStrengthenedPart> .

<urn:nltl:batch01-fixture:TRF-047:pass:frame-end:1> a nltl:frameEnd ;
    nltl:hasAttachedSupportingStructure <urn:nltl:batch01-fixture:TRF-047:pass:support:1> .

<urn:nltl:batch01-fixture:TRF-047:pass:frame-end:2> a nltl:frameEnd ;
    nltl:hasAttachedSupportingStructure <urn:nltl:batch01-fixture:TRF-047:pass:support:2> ;
    nltl:hasHorizontalConnectionMember <urn:nltl:batch01-fixture:TRF-047:pass:horizontal-member> .

<urn:nltl:batch01-fixture:TRF-047:pass:frame:1> a nltl:mainFrame ;
    nltl:hasLowerEnd <urn:nltl:batch01-fixture:TRF-047:pass:frame-end:1> ;
    nltl:hasStrengthenedPart <urn:nltl:batch01-fixture:TRF-047:pass:strengthened-part:1> ;
    nltl:mainFrameBelowIceBeltStrengthened true .

<urn:nltl:batch01-fixture:TRF-047:pass:frame:2> a nltl:intermediateIceFrame ;
    nltl:hasLowerEnd <urn:nltl:batch01-fixture:TRF-047:pass:frame-end:2> ;
    nltl:hasStrengthenedPart <urn:nltl:batch01-fixture:TRF-047:pass:strengthened-part:2> .

<urn:nltl:batch01-fixture:TRF-047:pass:horizontal-member> a nltl:horizontalConnectionMember ;
    nltl:connectsToAdjacentMainFrame <urn:nltl:batch01-fixture:TRF-047:pass:adjacent-main-frame> ;
    nltl:sameScantlingsAsMainFrame true .

<urn:nltl:batch01-fixture:TRF-047:pass:node:hasStrengthenedPart> a nltl:frameStrengthenedPart .

<urn:nltl:batch01-fixture:TRF-047:pass:strengthened-part:1> a nltl:frameStrengthenedPart .

<urn:nltl:batch01-fixture:TRF-047:pass:strengthened-part:2> a nltl:frameStrengthenedPart .

<urn:nltl:batch01-fixture:TRF-047:pass:support:1> a nltl:deckStructure ;
    nltl:supportingStructureAtOrBelowIceBeltLowerLimit true .

<urn:nltl:batch01-fixture:TRF-047:pass:support:2> a nltl:tankBoundaryPlating ;
    nltl:supportingStructureAtOrBelowIceBeltLowerLimit true .

