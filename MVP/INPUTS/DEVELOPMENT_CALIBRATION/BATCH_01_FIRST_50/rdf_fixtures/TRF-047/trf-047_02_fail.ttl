@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-047:fail:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-047:fail:component>,
        <urn:nltl:batch01-fixture:TRF-047:fail:frame:1>,
        <urn:nltl:batch01-fixture:TRF-047:fail:frame:2> .

<urn:nltl:batch01-fixture:TRF-047:fail:support:1> a nltl:deckStructure ;
    nltl:supportingStructureAtOrBelowIceBeltLowerLimit true .

<urn:nltl:batch01-fixture:TRF-047:fail:support:2> a nltl:tankBoundaryPlating ;
    nltl:supportingStructureAtOrBelowIceBeltLowerLimit true .

<urn:nltl:batch01-fixture:TRF-047:fail:adjacent-main-frame> a nltl:mainFrame .

<urn:nltl:batch01-fixture:TRF-047:fail:component> a nltl:frame,
        nltl:shipComponent ;
    nltl:hasStrengthenedPart <urn:nltl:batch01-fixture:TRF-047:fail:node:hasStrengthenedPart> .

<urn:nltl:batch01-fixture:TRF-047:fail:frame-end:1> a nltl:frameEnd .

<urn:nltl:batch01-fixture:TRF-047:fail:frame-end:2> a nltl:frameEnd ;
    nltl:hasHorizontalConnectionMember <urn:nltl:batch01-fixture:TRF-047:fail:horizontal-member> .

<urn:nltl:batch01-fixture:TRF-047:fail:frame:1> a nltl:mainFrame ;
    nltl:hasLowerEnd <urn:nltl:batch01-fixture:TRF-047:fail:frame-end:1> ;
    nltl:hasStrengthenedPart <urn:nltl:batch01-fixture:TRF-047:fail:strengthened-part:1> ;
    nltl:mainFrameBelowIceBeltStrengthened false .

<urn:nltl:batch01-fixture:TRF-047:fail:frame:2> a nltl:intermediateIceFrame ;
    nltl:hasLowerEnd <urn:nltl:batch01-fixture:TRF-047:fail:frame-end:2> ;
    nltl:hasStrengthenedPart <urn:nltl:batch01-fixture:TRF-047:fail:strengthened-part:2> .

<urn:nltl:batch01-fixture:TRF-047:fail:horizontal-member> a nltl:horizontalConnectionMember ;
    nltl:connectsToAdjacentMainFrame <urn:nltl:batch01-fixture:TRF-047:fail:adjacent-main-frame> ;
    nltl:sameScantlingsAsMainFrame true .

<urn:nltl:batch01-fixture:TRF-047:fail:node:hasStrengthenedPart> a nltl:frameStrengthenedPart .

<urn:nltl:batch01-fixture:TRF-047:fail:strengthened-part:1> a nltl:frameStrengthenedPart .

<urn:nltl:batch01-fixture:TRF-047:fail:strengthened-part:2> a nltl:frameStrengthenedPart .

