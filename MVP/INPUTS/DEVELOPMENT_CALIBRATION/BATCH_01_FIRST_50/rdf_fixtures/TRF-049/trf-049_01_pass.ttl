@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-049:pass:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-049:pass:component>,
        <urn:nltl:batch01-fixture:TRF-049:pass:frame> .

<urn:nltl:batch01-fixture:TRF-049:pass:bracket> a nltl:connectionBracket ;
    nltl:bracketEdgeStiffened true ;
    nltl:bracketThickness <urn:nltl:batch01-fixture:TRF-049:pass:q:bracketThickness:structured> ;
    nltl:bucklingStiffening true .

<urn:nltl:batch01-fixture:TRF-049:pass:bulkhead> a nltl:bulkhead .

<urn:nltl:batch01-fixture:TRF-049:pass:component> a nltl:frame,
        nltl:shipComponent,
        nltl:supportingStructure ;
    nltl:hasSupportingStructureAttachment <urn:nltl:batch01-fixture:TRF-049:pass:node:hasSupportingStructureAttachment> ;
    nltl:similarAttachmentConstructionPresent false .

<urn:nltl:batch01-fixture:TRF-049:pass:frame> a nltl:longitudinalFrame ;
    nltl:frameWebThickness <urn:nltl:batch01-fixture:TRF-049:pass:q:frameWebThickness:structured> ;
    nltl:hasFrameAttachment <urn:nltl:batch01-fixture:TRF-049:pass:attachment> ;
    nltl:hasSupportingBulkhead <urn:nltl:batch01-fixture:TRF-049:pass:bulkhead> ;
    nltl:hasSupportingWebFrame <urn:nltl:batch01-fixture:TRF-049:pass:support> ;
    nltl:passesThroughSupportingStructure true ;
    nltl:terminatesAtDeckOrIceStringer true ;
    nltl:webPlateConnectionSideCount 2 ;
    nltl:withinIceStrengthenedArea true .

<urn:nltl:batch01-fixture:TRF-049:pass:node:hasSupportingStructureAttachment> a nltl:frameAttachment .

<urn:nltl:batch01-fixture:TRF-049:pass:q:bracketThickness:structured> a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:MilliM .

<urn:nltl:batch01-fixture:TRF-049:pass:q:frameWebThickness:structured> a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:MilliM .

<urn:nltl:batch01-fixture:TRF-049:pass:attachment> a nltl:frameAttachment ;
    nltl:effectiveAttachmentConfirmed true ;
    nltl:hasAttachedSupportingStructure <urn:nltl:batch01-fixture:TRF-049:pass:support> ;
    nltl:hasConnectionBracket <urn:nltl:batch01-fixture:TRF-049:pass:bracket> ;
    nltl:similarAttachmentConstructionPresent false .

<urn:nltl:batch01-fixture:TRF-049:pass:support> a nltl:supportingStructure ;
    nltl:hasSupportingStructureAttachment <urn:nltl:batch01-fixture:TRF-049:pass:attachment> .

