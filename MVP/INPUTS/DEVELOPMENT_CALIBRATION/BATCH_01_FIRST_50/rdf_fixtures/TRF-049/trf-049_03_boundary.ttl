@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-049:boundary:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-049:boundary:component>,
        <urn:nltl:batch01-fixture:TRF-049:boundary:frame> .

<urn:nltl:batch01-fixture:TRF-049:boundary:bracket> a nltl:connectionBracket ;
    nltl:bracketEdgeStiffened true ;
    nltl:bracketThickness <urn:nltl:batch01-fixture:TRF-049:boundary:q:bracketThickness:structured> ;
    nltl:bucklingStiffening true .

<urn:nltl:batch01-fixture:TRF-049:boundary:bulkhead> a nltl:bulkhead ;
    nltl:hasSupportingStructureAttachment <urn:nltl:batch01-fixture:TRF-049:boundary:attachment> .

<urn:nltl:batch01-fixture:TRF-049:boundary:component> a nltl:frameAttachment,
        nltl:shipComponent,
        nltl:supportingStructure ;
    nltl:hasSupportingStructureAttachment <urn:nltl:batch01-fixture:TRF-049:boundary:node:hasSupportingStructureAttachment> ;
    nltl:similarAttachmentConstructionPresent false .

<urn:nltl:batch01-fixture:TRF-049:boundary:frame> a nltl:frame,
        nltl:longitudinalFrame ;
    nltl:frameWebThickness <urn:nltl:batch01-fixture:TRF-049:boundary:q:frameWebThickness:structured> ;
    nltl:hasFrameAttachment <urn:nltl:batch01-fixture:TRF-049:boundary:attachment> ;
    nltl:hasSupportingBulkhead <urn:nltl:batch01-fixture:TRF-049:boundary:bulkhead> ;
    nltl:hasSupportingWebFrame <urn:nltl:batch01-fixture:TRF-049:boundary:support> ;
    nltl:passesThroughSupportingStructure true ;
    nltl:terminatesAtDeckOrIceStringer true ;
    nltl:webPlateConnectionSideCount 2 ;
    nltl:withinIceStrengthenedArea true .

<urn:nltl:batch01-fixture:TRF-049:boundary:node:hasSupportingStructureAttachment> a nltl:frameAttachment .

<urn:nltl:batch01-fixture:TRF-049:boundary:q:bracketThickness:structured> a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:MilliM .

<urn:nltl:batch01-fixture:TRF-049:boundary:q:frameWebThickness:structured> a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:MilliM .

<urn:nltl:batch01-fixture:TRF-049:boundary:support> a nltl:supportingStructure ;
    nltl:hasSupportingStructureAttachment <urn:nltl:batch01-fixture:TRF-049:boundary:attachment> .

<urn:nltl:batch01-fixture:TRF-049:boundary:attachment> a nltl:frameAttachment ;
    nltl:effectiveAttachmentConfirmed true ;
    nltl:hasAttachedSupportingStructure <urn:nltl:batch01-fixture:TRF-049:boundary:support> ;
    nltl:hasConnectionBracket <urn:nltl:batch01-fixture:TRF-049:boundary:bracket> ;
    nltl:similarAttachmentConstructionPresent false .

