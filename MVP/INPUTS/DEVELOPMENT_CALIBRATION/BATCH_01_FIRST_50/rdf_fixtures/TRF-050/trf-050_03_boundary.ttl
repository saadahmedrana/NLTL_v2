@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-050:boundary:ship> a nltl:ship ;
    nltl:frameShellAttachment <urn:nltl:batch01-fixture:TRF-050:boundary:frame-shell-attachment> ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-050:boundary:component> .

<urn:nltl:batch01-fixture:TRF-050:boundary:component> a nltl:shipComponent .

<urn:nltl:batch01-fixture:TRF-050:boundary:frame-shell-attachment> a nltl:frameAttachment ;
    nltl:frameShellWeldType nltl:doubleContinuousWeld ;
    nltl:scallopingPresent true ;
    nltl:shellPlateButtCrossing true .

