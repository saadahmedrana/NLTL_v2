@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-051:fail:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-051:fail:component> .

<urn:nltl:batch01-fixture:TRF-051:fail:component> a nltl:bulkhead,
        nltl:deckStructure,
        nltl:hullStructure,
        nltl:shipComponent,
        nltl:tankBottom,
        nltl:tankBoundaryPlating,
        nltl:tankTop ;
    nltl:adjacentFrameHeight <urn:nltl:batch01-fixture:TRF-051:fail:q:adjacentFrameHeight> ;
    nltl:corrosionAbrasionAddition <urn:nltl:batch01-fixture:TRF-051:fail:q:corrosionAbrasionAddition> ;
    nltl:frameProfileType nltl:profileSection ;
    nltl:frameWebThickness <urn:nltl:batch01-fixture:TRF-051:fail:q:frameWebThickness> ;
    nltl:hullStructuralSteelGrade nltl:normalStrengthHullStructuralSteel ;
    nltl:inLieuOfFrame false ;
    nltl:netShellPlatingThickness <urn:nltl:batch01-fixture:TRF-051:fail:q:netShellPlatingThickness> ;
    nltl:yieldStrength <urn:nltl:batch01-fixture:TRF-051:fail:q:yieldStrength> .

<urn:nltl:batch01-fixture:TRF-051:fail:q:adjacentFrameHeight> a qudt:QuantityValue ;
    qudt:numericValue 400.0 ;
    qudt:unit unit:MilliM .

<urn:nltl:batch01-fixture:TRF-051:fail:q:corrosionAbrasionAddition> a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:MilliM .

<urn:nltl:batch01-fixture:TRF-051:fail:q:frameWebThickness> a qudt:QuantityValue ;
    qudt:numericValue 8.9 ;
    qudt:unit unit:MilliM .

<urn:nltl:batch01-fixture:TRF-051:fail:q:netShellPlatingThickness> a qudt:QuantityValue ;
    qudt:numericValue 12.0 ;
    qudt:unit unit:MilliM .

<urn:nltl:batch01-fixture:TRF-051:fail:q:yieldStrength> a qudt:QuantityValue ;
    qudt:numericValue 235.0 ;
    qudt:unit unit:MegaPA .

