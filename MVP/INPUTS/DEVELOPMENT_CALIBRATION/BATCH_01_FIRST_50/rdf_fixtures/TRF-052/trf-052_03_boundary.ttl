@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-052:boundary:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-052:boundary:component> .

<urn:nltl:batch01-fixture:TRF-052:boundary:component> a nltl:frame,
        nltl:shipComponent ;
    nltl:antitrippingSupportSpacing <urn:nltl:batch01-fixture:TRF-052:boundary:q:antitrippingSupportSpacing> ;
    nltl:equivalentSupportStatusByDirectCalculation false ;
    nltl:frameAsymmetrical true ;
    nltl:frameSpan <urn:nltl:batch01-fixture:TRF-052:boundary:q:frameSpan> ;
    nltl:frameWebAngleToShell <urn:nltl:batch01-fixture:TRF-052:boundary:q:frameWebAngleToShell> ;
    nltl:hasAntitrippingSupportRegion nltl:bowRegion,
        nltl:midbodyRegion,
        nltl:sternRegion ;
    nltl:iceClass nltl:iceClassIa .

<urn:nltl:batch01-fixture:TRF-052:boundary:q:antitrippingSupportSpacing> a qudt:QuantityValue ;
    qudt:numericValue 1300.0 ;
    qudt:unit unit:MilliM .

<urn:nltl:batch01-fixture:TRF-052:boundary:q:frameSpan> a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-052:boundary:q:frameWebAngleToShell> a qudt:QuantityValue ;
    qudt:numericValue 80.0 ;
    qudt:unit unit:DEG .

