@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-053:fail:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-053:fail:component> .

<urn:nltl:batch01-fixture:TRF-053:fail:component> a nltl:iceStringer,
        nltl:shipComponent ;
    nltl:designIceLoadHeight <urn:nltl:batch01-fixture:TRF-053:fail:q:designIceLoadHeight> ;
    nltl:designLineLoad <urn:nltl:batch01-fixture:TRF-053:fail:q:designLineLoad> ;
    nltl:frameMomentFactorM <urn:nltl:batch01-fixture:TRF-053:fail:q:frameMomentFactorM> ;
    nltl:icePressure <urn:nltl:batch01-fixture:TRF-053:fail:q:icePressure> ;
    nltl:iceStringerDistributionFactorF6 <urn:nltl:batch01-fixture:TRF-053:fail:q:iceStringerDistributionFactorF6> ;
    nltl:iceStringerSafetyFactorF7 <urn:nltl:batch01-fixture:TRF-053:fail:q:iceStringerSafetyFactorF7> ;
    nltl:iceStringerShearFactorF8 <urn:nltl:batch01-fixture:TRF-053:fail:q:iceStringerShearFactorF8> ;
    nltl:locatedWithinIceBelt true ;
    nltl:requiredShearArea <urn:nltl:batch01-fixture:TRF-053:fail:q:requiredShearArea> ;
    nltl:sectionModulus <urn:nltl:batch01-fixture:TRF-053:fail:q:sectionModulus> ;
    nltl:span <urn:nltl:batch01-fixture:TRF-053:fail:q:span> ;
    nltl:yieldStrength <urn:nltl:batch01-fixture:TRF-053:fail:q:yieldStrength> .

<urn:nltl:batch01-fixture:TRF-053:fail:q:designIceLoadHeight> a qudt:QuantityValue ;
    qudt:numericValue 0.3 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-053:fail:q:designLineLoad> a qudt:QuantityValue ;
    qudt:numericValue 150.0 ;
    qudt:unit unit:KiloN-PER-M .

<urn:nltl:batch01-fixture:TRF-053:fail:q:frameMomentFactorM> a qudt:QuantityValue ;
    qudt:numericValue 13.3 ;
    qudt:unit unit:UNITLESS .

<urn:nltl:batch01-fixture:TRF-053:fail:q:icePressure> a qudt:QuantityValue ;
    qudt:numericValue 0.3 ;
    qudt:unit unit:MegaPA .

<urn:nltl:batch01-fixture:TRF-053:fail:q:iceStringerDistributionFactorF6> a qudt:QuantityValue ;
    qudt:numericValue 0.9 ;
    qudt:unit unit:UNITLESS .

<urn:nltl:batch01-fixture:TRF-053:fail:q:iceStringerSafetyFactorF7> a qudt:QuantityValue ;
    qudt:numericValue 1.8 ;
    qudt:unit unit:UNITLESS .

<urn:nltl:batch01-fixture:TRF-053:fail:q:iceStringerShearFactorF8> a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:UNITLESS .

<urn:nltl:batch01-fixture:TRF-053:fail:q:requiredShearArea> a qudt:QuantityValue ;
    qudt:numericValue 21.492170871790837 ;
    qudt:unit unit:CentiM2 .

<urn:nltl:batch01-fixture:TRF-053:fail:q:sectionModulus> a qudt:QuantityValue ;
    qudt:numericValue 300.0 ;
    qudt:unit unit:CentiM3 .

<urn:nltl:batch01-fixture:TRF-053:fail:q:span> a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-053:fail:q:yieldStrength> a qudt:QuantityValue ;
    qudt:numericValue 235.0 ;
    qudt:unit unit:MegaPA .

