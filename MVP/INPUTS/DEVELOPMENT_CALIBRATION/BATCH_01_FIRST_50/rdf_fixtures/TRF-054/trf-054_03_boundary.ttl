<urn:nltl:batch01-fixture:TRF-054:boundary:q:frameMomentFactorM> a qudt:QuantityValue ;
    qudt:numericValue 13.3 ;
    qudt:unit unit:UNITLESS .

<urn:nltl:batch01-fixture:TRF-054:boundary:q:icePressure> a qudt:QuantityValue ;
