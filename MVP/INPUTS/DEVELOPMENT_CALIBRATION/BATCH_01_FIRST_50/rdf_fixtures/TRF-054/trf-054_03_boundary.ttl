<urn:nltl:batch01-fixture:TRF-054:boundary:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-054:boundary:component> .

<urn:nltl:batch01-fixture:TRF-054:boundary:component> a nltl:iceStringer,
        nltl:shipComponent ;
    nltl:designIceLoadHeight <urn:nltl:batch01-fixture:TRF-054:boundary:q:designIceLoadHeight> ;
    nltl:designLineLoad <urn:nltl:batch01-fixture:TRF-054:boundary:q:designLineLoad> ;
    nltl:distanceToAdjacentIceStringer <urn:nltl:batch01-fixture:TRF-054:boundary:q:distanceToAdjacentIceStringer> ;
    nltl:distanceToIceBelt <urn:nltl:batch01-fixture:TRF-054:boundary:q:distanceToIceBelt> ;
    nltl:frameMomentFactorM <urn:nltl:batch01-fixture:TRF-054:boundary:q:frameMomentFactorM> ;
    nltl:icePressure <urn:nltl:batch01-fixture:TRF-054:boundary:q:icePressure> ;
    nltl:locatedOutsideIceBelt true ;
    nltl:outsideIceBeltDistributionFactorF9 <urn:nltl:batch01-fixture:TRF-054:boundary:q:outsideIceBeltDistributionFactorF9> ;
    nltl:outsideIceBeltFactor <urn:nltl:batch01-fixture:TRF-054:boundary:q:outsideIceBeltFactor> ;
    nltl:outsideIceBeltSafetyFactorF10 <urn:nltl:batch01-fixture:TRF-054:boundary:q:outsideIceBeltSafetyFactorF10> ;
    nltl:outsideIceBeltShearFactorF11 <urn:nltl:batch01-fixture:TRF-054:boundary:q:outsideIceBeltShearFactorF11> ;
    nltl:requiredShearArea <urn:nltl:batch01-fixture:TRF-054:boundary:q:requiredShearArea> ;
    nltl:sectionModulus <urn:nltl:batch01-fixture:TRF-054:boundary:q:sectionModulus> ;
    nltl:span <urn:nltl:batch01-fixture:TRF-054:boundary:q:span> ;
    nltl:stringerSpan <urn:nltl:batch01-fixture:TRF-054:boundary:q:stringerSpan> ;
    nltl:supportsIceStrengthenedFrames true ;
    nltl:yieldStrength <urn:nltl:batch01-fixture:TRF-054:boundary:q:yieldStrength> .

<urn:nltl:batch01-fixture:TRF-054:boundary:q:designIceLoadHeight> a qudt:QuantityValue ;
