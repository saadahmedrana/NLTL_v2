@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-055:pass:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-055:pass:component> .

<urn:nltl:batch01-fixture:TRF-055:pass:component> a nltl:narrowDeckStrip,
        nltl:shipComponent ;
    nltl:abreastOfHatch true ;
    nltl:actualSectionModulus <urn:nltl:batch01-fixture:TRF-055:pass:q:actualSectionModulus> ;
    nltl:actualShearArea <urn:nltl:batch01-fixture:TRF-055:pass:q:actualShearArea> ;
    nltl:designLineLoad <urn:nltl:batch01-fixture:TRF-055:pass:q:designLineLoad> ;
    nltl:hatchOpeningLength <urn:nltl:batch01-fixture:TRF-055:pass:q:hatchOpeningLength> ;
    nltl:permittedReducedLineLoad <urn:nltl:batch01-fixture:TRF-055:pass:q:permittedReducedLineLoad> ;
    nltl:reducedLineLoadApprovedByClassificationSociety true ;
    nltl:requiredSectionModulus <urn:nltl:batch01-fixture:TRF-055:pass:q:requiredSectionModulus> ;
    nltl:requiredShearArea <urn:nltl:batch01-fixture:TRF-055:pass:q:requiredShearArea> ;
    nltl:scantlingApprovalStatus nltl:evidenceStateApproved ;
    nltl:sectionModulus <urn:nltl:batch01-fixture:TRF-055:pass:q:sectionModulus> ;
    nltl:servesAsIceStringer true ;
    nltl:shipBreadth <urn:nltl:batch01-fixture:TRF-055:pass:q:shipBreadth> ;
    nltl:veryLongHatchOpening true .

<urn:nltl:batch01-fixture:TRF-055:pass:q:actualSectionModulus> a qudt:QuantityValue ;
    qudt:numericValue 200.0 ;
    qudt:unit unit:CentiM3 .

<urn:nltl:batch01-fixture:TRF-055:pass:q:actualShearArea> a qudt:QuantityValue ;
    qudt:numericValue 20.0 ;
    qudt:unit unit:CentiM2 .

<urn:nltl:batch01-fixture:TRF-055:pass:q:designLineLoad> a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:KiloN-PER-M .

<urn:nltl:batch01-fixture:TRF-055:pass:q:hatchOpeningLength> a qudt:QuantityValue ;
    qudt:numericValue 11.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-055:pass:q:permittedReducedLineLoad> a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:KiloN-PER-M .

<urn:nltl:batch01-fixture:TRF-055:pass:q:requiredSectionModulus> a qudt:QuantityValue ;
    qudt:numericValue 200.0 ;
    qudt:unit unit:CentiM3 .

<urn:nltl:batch01-fixture:TRF-055:pass:q:requiredShearArea> a qudt:QuantityValue ;
    qudt:numericValue 20.0 ;
    qudt:unit unit:CentiM2 .

<urn:nltl:batch01-fixture:TRF-055:pass:q:sectionModulus> a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:CentiM3 .

<urn:nltl:batch01-fixture:TRF-055:pass:q:shipBreadth> a qudt:QuantityValue ;
    qudt:numericValue 20.0 ;
    qudt:unit unit:M .

