@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-056:fail:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-056:fail:component> ;
    nltl:hasWeatherdeckHatch <urn:nltl:batch01-fixture:TRF-056:fail:weatherdeck-hatch> .

<urn:nltl:batch01-fixture:TRF-056:fail:component> a nltl:hatchCoverDesignEvidence,
        nltl:hatchFittingDesignEvidence,
        nltl:shipComponent,
        nltl:weatherdeckHatch ;
    nltl:hatchOpeningLength <urn:nltl:batch01-fixture:TRF-056:fail:q:hatchOpeningLength> ;
    nltl:shipBreadth <urn:nltl:batch01-fixture:TRF-056:fail:q:shipBreadth> ;
    nltl:shipSideDeflection <urn:nltl:batch01-fixture:TRF-056:fail:q:shipSideDeflection> .

<urn:nltl:batch01-fixture:TRF-056:fail:q:shipBreadth> a qudt:QuantityValue ;
    qudt:numericValue 20.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-056:fail:weatherdeck-hatch> a nltl:weatherdeckHatch ;
    nltl:hatchOpeningLength <urn:nltl:batch01-fixture:TRF-056:fail:q:hatchOpeningLength> ;
    nltl:shipSideDeflection <urn:nltl:batch01-fixture:TRF-056:fail:q:shipSideDeflection> .

<urn:nltl:batch01-fixture:TRF-056:fail:q:hatchOpeningLength> a qudt:QuantityValue ;
    qudt:numericValue 11.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-056:fail:q:shipSideDeflection> a qudt:QuantityValue ;
    qudt:numericValue 0.01 ;
    qudt:unit unit:M .

