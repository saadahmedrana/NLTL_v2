@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-056:boundary:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-056:boundary:component> ;
    nltl:hasWeatherdeckHatch <urn:nltl:batch01-fixture:TRF-056:boundary:weatherdeck-hatch> .

<urn:nltl:batch01-fixture:TRF-056:boundary:component> a nltl:hatchCoverDesignEvidence,
        nltl:hatchFittingDesignEvidence,
        nltl:shipComponent,
        nltl:weatherdeckHatch ;
    nltl:hasHatchCoverDesignEvidence <urn:nltl:batch01-fixture:TRF-056:boundary:evidence:hasHatchCoverDesignEvidence> ;
    nltl:hasHatchFittingDesignEvidence <urn:nltl:batch01-fixture:TRF-056:boundary:evidence:hasHatchFittingDesignEvidence> ;
    nltl:hatchOpeningLength <urn:nltl:batch01-fixture:TRF-056:boundary:q:hatchOpeningLength> ;
    nltl:shipBreadth <urn:nltl:batch01-fixture:TRF-056:boundary:q:shipBreadth> ;
    nltl:shipSideDeflection <urn:nltl:batch01-fixture:TRF-056:boundary:q:shipSideDeflection> .

<urn:nltl:batch01-fixture:TRF-056:boundary:q:shipBreadth> a qudt:QuantityValue ;
    qudt:numericValue 20.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-056:boundary:weatherdeck-hatch> a nltl:weatherdeckHatch ;
    nltl:hasHatchCoverDesignEvidence <urn:nltl:batch01-fixture:TRF-056:boundary:evidence:hasHatchCoverDesignEvidence> ;
    nltl:hasHatchFittingDesignEvidence <urn:nltl:batch01-fixture:TRF-056:boundary:evidence:hasHatchFittingDesignEvidence> ;
    nltl:hatchOpeningLength <urn:nltl:batch01-fixture:TRF-056:boundary:q:hatchOpeningLength> ;
    nltl:shipSideDeflection <urn:nltl:batch01-fixture:TRF-056:boundary:q:shipSideDeflection> .

<urn:nltl:batch01-fixture:TRF-056:boundary:evidence:hasHatchCoverDesignEvidence> a nltl:hatchCoverDesignEvidence .

<urn:nltl:batch01-fixture:TRF-056:boundary:evidence:hasHatchFittingDesignEvidence> a nltl:hatchFittingDesignEvidence .

<urn:nltl:batch01-fixture:TRF-056:boundary:q:hatchOpeningLength> a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-056:boundary:q:shipSideDeflection> a qudt:QuantityValue ;
    qudt:numericValue 0.01 ;
    qudt:unit unit:M .

