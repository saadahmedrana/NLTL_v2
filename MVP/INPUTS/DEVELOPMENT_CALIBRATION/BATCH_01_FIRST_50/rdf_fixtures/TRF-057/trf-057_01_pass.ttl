@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-057:pass:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-057:pass:component> .

<urn:nltl:batch01-fixture:TRF-057:pass:component> a nltl:shipComponent,
        nltl:webFrame ;
    nltl:iceLoadHeight <urn:nltl:batch01-fixture:TRF-057:pass:q:iceLoadHeight> ;
    nltl:iceLoadSourceType nltl:iceStringerLoadSource ;
    nltl:icePressure <urn:nltl:batch01-fixture:TRF-057:pass:q:icePressure> ;
    nltl:loadLengthParameter <urn:nltl:batch01-fixture:TRF-057:pass:q:loadLengthParameter> ;
    nltl:minimumLineLoad <urn:nltl:batch01-fixture:TRF-057:pass:q:minimumLineLoad> ;
    nltl:webFrameIceLoad <urn:nltl:batch01-fixture:TRF-057:pass:q:webFrameIceLoad> ;
    nltl:webFrameSafetyFactor <urn:nltl:batch01-fixture:TRF-057:pass:q:webFrameSafetyFactor> ;
    nltl:webFrameSpacing <urn:nltl:batch01-fixture:TRF-057:pass:q:webFrameSpacing> .

<urn:nltl:batch01-fixture:TRF-057:pass:q:iceLoadHeight> a qudt:QuantityValue ;
    qudt:numericValue 0.3 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-057:pass:q:icePressure> a qudt:QuantityValue ;
    qudt:numericValue 0.3 ;
    qudt:unit unit:MegaPA .

<urn:nltl:batch01-fixture:TRF-057:pass:q:loadLengthParameter> a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-057:pass:q:minimumLineLoad> a qudt:QuantityValue ;
    qudt:numericValue 150.0 ;
    qudt:unit unit:KiloN-PER-M .

<urn:nltl:batch01-fixture:TRF-057:pass:q:webFrameIceLoad> a qudt:QuantityValue ;
    qudt:numericValue 540.0 ;
    qudt:unit unit:KiloN .

<urn:nltl:batch01-fixture:TRF-057:pass:q:webFrameSafetyFactor> a qudt:QuantityValue ;
    qudt:numericValue 1.8 ;
    qudt:unit unit:UNITLESS .

<urn:nltl:batch01-fixture:TRF-057:pass:q:webFrameSpacing> a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:M .

