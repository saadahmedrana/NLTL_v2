@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-058:boundary:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-058:boundary:component> .

<urn:nltl:batch01-fixture:TRF-058:boundary:component> a nltl:shipComponent,
        nltl:webFrame ;
    nltl:adjustedIceLoadForce <urn:nltl:batch01-fixture:TRF-058:boundary:q:adjustedIceLoadForce> ;
    nltl:iceLoadForce <urn:nltl:batch01-fixture:TRF-058:boundary:q:iceLoadForce> ;
    nltl:stringerOutsideIceBeltHeight <urn:nltl:batch01-fixture:TRF-058:boundary:q:stringerOutsideIceBeltHeight> ;
    nltl:stringerSpan <urn:nltl:batch01-fixture:TRF-058:boundary:q:stringerSpan> ;
    nltl:supportedStringerOutsideIceBelt false .

<urn:nltl:batch01-fixture:TRF-058:boundary:q:adjustedIceLoadForce> a qudt:QuantityValue ;
    qudt:numericValue 540.0 ;
    qudt:unit unit:KiloN .

<urn:nltl:batch01-fixture:TRF-058:boundary:q:iceLoadForce> a qudt:QuantityValue ;
    qudt:numericValue 540.0 ;
    qudt:unit unit:KiloN .

<urn:nltl:batch01-fixture:TRF-058:boundary:q:stringerOutsideIceBeltHeight> a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:M .

<urn:nltl:batch01-fixture:TRF-058:boundary:q:stringerSpan> a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:M .

