@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:batch01-fixture:TRF-059:fail:ship> a nltl:ship ;
    nltl:hasComponent <urn:nltl:batch01-fixture:TRF-059:fail:component> .

<urn:nltl:batch01-fixture:TRF-059:fail:component> a nltl:shipComponent,
        nltl:webFrame ;
    nltl:freeFlangeArea <urn:nltl:batch01-fixture:TRF-059:fail:q:freeFlangeArea> ;
    nltl:freeFlangeToWebAreaRatio <urn:nltl:batch01-fixture:TRF-059:fail:q:freeFlangeToWebAreaRatio> ;
    nltl:maximumCalculatedShearForce <urn:nltl:batch01-fixture:TRF-059:fail:q:maximumCalculatedShearForce> ;
    nltl:requiredShearArea <urn:nltl:batch01-fixture:TRF-059:fail:q:requiredShearArea> ;
    nltl:sectionModulus <urn:nltl:batch01-fixture:TRF-059:fail:q:sectionModulus> ;
    nltl:webFrameShearDistributionFactorF13 <urn:nltl:batch01-fixture:TRF-059:fail:q:webFrameShearDistributionFactorF13> ;
    nltl:webFrameShearFactorAlpha <urn:nltl:batch01-fixture:TRF-059:fail:q:webFrameShearFactorAlpha> ;
    nltl:webPlateArea <urn:nltl:batch01-fixture:TRF-059:fail:q:webPlateArea> ;
    nltl:yieldStrength <urn:nltl:batch01-fixture:TRF-059:fail:q:yieldStrength> .

<urn:nltl:batch01-fixture:TRF-059:fail:q:freeFlangeArea> a qudt:QuantityValue ;
    qudt:numericValue 40.0 ;
    qudt:unit unit:CentiM2 .

<urn:nltl:batch01-fixture:TRF-059:fail:q:freeFlangeToWebAreaRatio> a qudt:QuantityValue ;
    qudt:numericValue 0.4 ;
    qudt:unit unit:UNITLESS .

<urn:nltl:batch01-fixture:TRF-059:fail:q:maximumCalculatedShearForce> a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:KiloN .

<urn:nltl:batch01-fixture:TRF-059:fail:q:requiredShearArea> a qudt:QuantityValue ;
    qudt:numericValue 9.0 ;
    qudt:unit unit:CentiM2 .

<urn:nltl:batch01-fixture:TRF-059:fail:q:sectionModulus> a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:CentiM3 .

<urn:nltl:batch01-fixture:TRF-059:fail:q:webFrameShearDistributionFactorF13> a qudt:QuantityValue ;
    qudt:numericValue 1.1 ;
    qudt:unit unit:UNITLESS .

<urn:nltl:batch01-fixture:TRF-059:fail:q:webFrameShearFactorAlpha> a qudt:QuantityValue ;
    qudt:numericValue 1.16 ;
    qudt:unit unit:UNITLESS .

<urn:nltl:batch01-fixture:TRF-059:fail:q:webPlateArea> a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:CentiM2 .

<urn:nltl:batch01-fixture:TRF-059:fail:q:yieldStrength> a qudt:QuantityValue ;
    qudt:numericValue 235.0 ;
    qudt:unit unit:MegaPA .

