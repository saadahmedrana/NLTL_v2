@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix test: <urn:nltl:r2-evaluation:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

test:ship a nltl:ship ;
    nltl:operatesOnlyInContinuousDaylight "false"^^xsd:boolean ;
    nltl:bridgeControlledRotatableNarrowBeamSearchlightCount "1"^^xsd:integer ;
    nltl:searchlightCoverageArc [
        a qudt:QuantityValue ;
        qudt:numericValue "360"^^xsd:decimal ;
        qudt:unit unit:DEG
    ] .

