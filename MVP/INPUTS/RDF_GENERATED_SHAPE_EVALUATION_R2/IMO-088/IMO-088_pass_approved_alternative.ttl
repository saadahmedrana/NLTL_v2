@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix test: <urn:nltl:r2-evaluation:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

test:ship a nltl:ship ;
    nltl:operatesOnlyInContinuousDaylight "false"^^xsd:boolean ;
    nltl:alternateVisualIceDetectionMeansApprovalStatus nltl:evidenceStateApproved .

