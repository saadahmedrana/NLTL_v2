@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:r4-test:I2-005:ship-fail-angle> a nltl:ship ;
    nltl:hasBottomRegionLowerRegionBoundaryPoint <urn:nltl:r4-test:I2-005:point-fail-angle> .

<urn:nltl:r4-test:I2-005:point-fail-angle> a nltl:hullBoundaryPoint ;
    nltl:shellInclinationAngle [
        a qudt:QuantityValue ;
        qudt:numericValue "6.999"^^xsd:decimal ;
        qudt:unit unit:DEG
    ] .
