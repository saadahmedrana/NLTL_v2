@prefix nltl: <https://w3id.org/nltl/vocab#> .

<urn:nltl:r4-test:IMO-086:ship-fail-power> a nltl:ship ;
    nltl:hasNonMagneticHeadingMeans
        <urn:nltl:r4-test:IMO-086:means-power-a>,
        <urn:nltl:r4-test:IMO-086:means-power-b> .

<urn:nltl:r4-test:IMO-086:means-power-a> a nltl:nonMagneticHeadingMeans ;
    nltl:connectedToMainPower <urn:nltl:r4-test:IMO-086:main-power> ;
    nltl:connectedToEmergencyPower <urn:nltl:r4-test:IMO-086:emergency-power> ;
    nltl:independentFromHeadingMeans <urn:nltl:r4-test:IMO-086:means-power-b> .

<urn:nltl:r4-test:IMO-086:means-power-b> a nltl:nonMagneticHeadingMeans ;
    nltl:connectedToMainPower <urn:nltl:r4-test:IMO-086:main-power> ;
    nltl:independentFromHeadingMeans <urn:nltl:r4-test:IMO-086:means-power-a> .

<urn:nltl:r4-test:IMO-086:main-power> a nltl:benchmarkEntity .
<urn:nltl:r4-test:IMO-086:emergency-power> a nltl:benchmarkEntity .
