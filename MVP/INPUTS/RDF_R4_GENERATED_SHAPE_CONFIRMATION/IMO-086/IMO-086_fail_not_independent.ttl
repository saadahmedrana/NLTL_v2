@prefix nltl: <https://w3id.org/nltl/vocab#> .

<urn:nltl:r4-test:IMO-086:ship-fail-independence> a nltl:ship ;
    nltl:hasNonMagneticHeadingMeans
        <urn:nltl:r4-test:IMO-086:means-dependent-a>,
        <urn:nltl:r4-test:IMO-086:means-dependent-b> .

<urn:nltl:r4-test:IMO-086:means-dependent-a> a nltl:nonMagneticHeadingMeans ;
    nltl:connectedToMainPower <urn:nltl:r4-test:IMO-086:main-power> ;
    nltl:connectedToEmergencyPower <urn:nltl:r4-test:IMO-086:emergency-power> .

<urn:nltl:r4-test:IMO-086:means-dependent-b> a nltl:nonMagneticHeadingMeans ;
    nltl:connectedToMainPower <urn:nltl:r4-test:IMO-086:main-power> ;
    nltl:connectedToEmergencyPower <urn:nltl:r4-test:IMO-086:emergency-power> .

<urn:nltl:r4-test:IMO-086:main-power> a nltl:benchmarkEntity .
<urn:nltl:r4-test:IMO-086:emergency-power> a nltl:benchmarkEntity .
