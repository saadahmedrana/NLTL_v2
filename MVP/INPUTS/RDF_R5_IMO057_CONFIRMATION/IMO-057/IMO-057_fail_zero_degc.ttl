@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix test: <urn:nltl:r2-evaluation:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

test:ship a nltl:ship ; nltl:hasComponent test:firePump .

test:firePump a nltl:firePump ;
    nltl:hasContainingCompartment test:compartment .

test:compartment a nltl:compartment ;
    nltl:maintainedTemperature [
        a qudt:QuantityValue ;
        qudt:numericValue "0"^^xsd:decimal ;
        qudt:unit unit:DEG_C
    ] .
