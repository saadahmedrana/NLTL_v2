@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix test: <urn:nltl:r2-evaluation:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

test:ship a nltl:ship ;
    nltl:hasComponent test:firePump,
        test:emergencyFirePump,
        test:waterMistPump,
        test:waterSprayPump .

test:firePump a nltl:firePump ;
    nltl:hasContainingCompartment test:firePumpCompartment .

test:emergencyFirePump a nltl:emergencyFirePump ;
    nltl:hasContainingCompartment test:emergencyFirePumpCompartment .

test:waterMistPump a nltl:waterMistPump ;
    nltl:hasContainingCompartment test:waterMistPumpCompartment .

test:waterSprayPump a nltl:waterSprayPump ;
    nltl:hasContainingCompartment test:waterSprayPumpCompartment .

test:firePumpCompartment a nltl:compartment ;
    nltl:maintainedTemperature [
        a qudt:QuantityValue ; qudt:numericValue "5"^^xsd:decimal ; qudt:unit unit:DEG_C
    ] .

test:emergencyFirePumpCompartment a nltl:compartment ;
    nltl:maintainedTemperature [
        a qudt:QuantityValue ; qudt:numericValue "2"^^xsd:decimal ; qudt:unit unit:DEG_C
    ] .

test:waterMistPumpCompartment a nltl:compartment ;
    nltl:maintainedTemperature [
        a qudt:QuantityValue ; qudt:numericValue "1"^^xsd:decimal ; qudt:unit unit:DEG_C
    ] .

test:waterSprayPumpCompartment a nltl:compartment ;
    nltl:maintainedTemperature [
        a qudt:QuantityValue ; qudt:numericValue "0.1"^^xsd:decimal ; qudt:unit unit:DEG_C
    ] .
