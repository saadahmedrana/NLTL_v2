@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix pilot: <urn:nltl:rdf-pilot:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pilot:INT_001_Ship a nltl:ship ;
    nltl:shipCategory nltl:polarShipCategoryA ;
    nltl:constructionDate "2022-05-01"^^xsd:date ;
    nltl:bridgeWingsEnclosed "true"^^xsd:boolean ;
    nltl:bridgeWingProtectionDesignStatus "false"^^xsd:boolean ;
    nltl:personalOrGroupSurvivalEquipmentRequired "true"^^xsd:boolean ;
    nltl:personsOnBoard "50"^^xsd:integer ;
    nltl:availableSurvivalEquipmentCapacity "55"^^xsd:integer ;
    nltl:storageAccessibilityStatus "true"^^xsd:boolean .
