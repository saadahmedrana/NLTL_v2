@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix pilot: <urn:nltl:rdf-pilot:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pilot:INT001_IMO075Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [ sh:path nltl:personalOrGroupSurvivalEquipmentRequired ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:personsOnBoard ; sh:datatype xsd:integer ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:availableSurvivalEquipmentCapacity ; sh:datatype xsd:integer ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:storageAccessibilityStatus ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:sparql [
        sh:message "IMO-075: survival-equipment capacity and accessibility condition is not satisfied" ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl-benchmark/vocab#personalOrGroupSurvivalEquipmentRequired> ?required .
                FILTER (?required = true)
                FILTER NOT EXISTS {
                    $this <https://w3id.org/nltl-benchmark/vocab#personsOnBoard> ?persons ;
                          <https://w3id.org/nltl-benchmark/vocab#availableSurvivalEquipmentCapacity> ?capacity ;
                          <https://w3id.org/nltl-benchmark/vocab#storageAccessibilityStatus> true .
                    FILTER (?persons >= 0 && ?capacity >= 0 && (?capacity * 10) >= (?persons * 11))
                }
            }
        """
    ] .

pilot:INT001_IMO085Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [ sh:path nltl:shipCategory ; sh:nodeKind sh:IRI ; sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB nltl:polarShipCategoryC ) ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:constructionDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:bridgeWingsEnclosed ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:bridgeWingProtectionDesignStatus ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:sparql [
        sh:message "IMO-085: applicable Category A or B ship lacks both enclosed bridge wings and protective bridge-wing design" ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl-benchmark/vocab#shipCategory> ?category ;
                      <https://w3id.org/nltl-benchmark/vocab#constructionDate> ?date .
                FILTER (?category IN (<https://w3id.org/nltl-benchmark/vocab#polarShipCategoryA>, <https://w3id.org/nltl-benchmark/vocab#polarShipCategoryB>))
                FILTER (?date >= "2017-01-01"^^<http://www.w3.org/2001/XMLSchema#date>)
                FILTER NOT EXISTS { $this <https://w3id.org/nltl-benchmark/vocab#bridgeWingsEnclosed> true }
                FILTER NOT EXISTS { $this <https://w3id.org/nltl-benchmark/vocab#bridgeWingProtectionDesignStatus> true }
            }
        """
    ] .
