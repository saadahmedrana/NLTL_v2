@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix pilot: <urn:nltl:rdf-pilot:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pilot:INT_002_Ship a nltl:ship ;
    nltl:constructionDate "2026-06-15"^^xsd:date ;
    nltl:shipIceStrengthened "true"^^xsd:boolean ;
    nltl:independentEchoSoundingDeviceCount "0"^^xsd:integer ;
    nltl:echoSoundingDeviceCount "1"^^xsd:integer ;
    nltl:independentTransducerCount "2"^^xsd:integer ;
    nltl:administrationApprovedEquivalentDepthSoundingDevicePresent "false"^^xsd:boolean ;
    nltl:shipCategory nltl:polarShipCategoryB ;
    nltl:bridgeWingsEnclosed "false"^^xsd:boolean ;
    nltl:bridgeWingProtectionDesignStatus "true"^^xsd:boolean ;
    nltl:administrationApprovedEquivalentBridgeWingProtectionPresent "false"^^xsd:boolean ;
    nltl:operatesOnlyInContinuousDaylight "false"^^xsd:boolean ;
    nltl:visualIceDetectionIlluminationMeansCount "2"^^xsd:integer .
