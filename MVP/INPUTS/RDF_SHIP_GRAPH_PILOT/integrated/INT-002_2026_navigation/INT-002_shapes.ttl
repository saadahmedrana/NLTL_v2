@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix pilot: <urn:nltl:rdf-pilot:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pilot:INT002SchemaShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [ sh:path nltl:constructionDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:shipIceStrengthened ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:independentEchoSoundingDeviceCount ; sh:datatype xsd:integer ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:echoSoundingDeviceCount ; sh:datatype xsd:integer ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:independentTransducerCount ; sh:datatype xsd:integer ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:administrationApprovedEquivalentDepthSoundingDevicePresent ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:shipCategory ; sh:nodeKind sh:IRI ; sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB nltl:polarShipCategoryC ) ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:bridgeWingsEnclosed ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:bridgeWingProtectionDesignStatus ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:administrationApprovedEquivalentBridgeWingProtectionPresent ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:operatesOnlyInContinuousDaylight ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path nltl:visualIceDetectionIlluminationMeansCount ; sh:datatype xsd:integer ; sh:maxCount 1 ] .

pilot:INT002_IMO26_007Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "IMO26-007: applicable ice-strengthened ship lacks a permitted echo-sounding arrangement or approved equivalent" ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl-benchmark/vocab#shipIceStrengthened> ?strengthened ;
                      <https://w3id.org/nltl-benchmark/vocab#constructionDate> ?date .
                FILTER (?strengthened = true)
                FILTER (?date >= "2026-01-01"^^<http://www.w3.org/2001/XMLSchema#date>)
                FILTER NOT EXISTS {
                    $this <https://w3id.org/nltl-benchmark/vocab#independentEchoSoundingDeviceCount> ?independentCount .
                    FILTER (?independentCount >= 2)
                }
                FILTER NOT EXISTS {
                    $this <https://w3id.org/nltl-benchmark/vocab#echoSoundingDeviceCount> ?deviceCount ;
                          <https://w3id.org/nltl-benchmark/vocab#independentTransducerCount> ?transducerCount .
                    FILTER (?deviceCount >= 1 && ?transducerCount >= 2)
                }
                FILTER NOT EXISTS {
                    $this <https://w3id.org/nltl-benchmark/vocab#administrationApprovedEquivalentDepthSoundingDevicePresent> true
                }
            }
        """
    ] .

pilot:INT002_IMO26_011Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "IMO26-011: applicable Category A or B ship lacks enclosed, protectively designed, or Administration-accepted equivalent bridge-wing protection" ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl-benchmark/vocab#shipCategory> ?category ;
                      <https://w3id.org/nltl-benchmark/vocab#constructionDate> ?date .
                FILTER (?category IN (<https://w3id.org/nltl-benchmark/vocab#polarShipCategoryA>, <https://w3id.org/nltl-benchmark/vocab#polarShipCategoryB>))
                FILTER (?date >= "2026-01-01"^^<http://www.w3.org/2001/XMLSchema#date>)
                FILTER NOT EXISTS { $this <https://w3id.org/nltl-benchmark/vocab#bridgeWingsEnclosed> true }
                FILTER NOT EXISTS { $this <https://w3id.org/nltl-benchmark/vocab#bridgeWingProtectionDesignStatus> true }
                FILTER NOT EXISTS { $this <https://w3id.org/nltl-benchmark/vocab#administrationApprovedEquivalentBridgeWingProtectionPresent> true }
            }
        """
    ] .

pilot:INT002_IMO26_014Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "IMO26-014: the continuous-daylight exception does not apply and fewer than two visual-ice-detection illumination means are recorded" ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl-benchmark/vocab#operatesOnlyInContinuousDaylight> ?daylightOnly .
                FILTER (?daylightOnly = false)
                FILTER NOT EXISTS {
                    $this <https://w3id.org/nltl-benchmark/vocab#visualIceDetectionIlluminationMeansCount> ?count .
                    FILTER (?count >= 2)
                }
            }
        """
    ] .
