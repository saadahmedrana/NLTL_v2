@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix pilot: <urn:nltl:rdf-pilot:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pilot:RQ_IMO_075_Ship a nltl:ship ;
    nltl:personalOrGroupSurvivalEquipmentRequired "true"^^xsd:boolean ;
    nltl:personsOnBoard "50"^^xsd:integer ;
    nltl:availableSurvivalEquipmentCapacity "54"^^xsd:integer ;
    nltl:storageAccessibilityStatus "true"^^xsd:boolean .
