@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix pilot: <urn:nltl:rdf-pilot:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pilot:IMO075Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:personalOrGroupSurvivalEquipmentRequired ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:personsOnBoard ;
        sh:datatype xsd:integer ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:availableSurvivalEquipmentCapacity ;
        sh:datatype xsd:integer ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:storageAccessibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "IMO-075: when survival equipment is required, integer capacity shall be at least 110 percent of persons on board and storage shall be accessible" ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl-benchmark/vocab#personalOrGroupSurvivalEquipmentRequired> ?required .
                FILTER (?required = true)
                FILTER NOT EXISTS {
                    $this <https://w3id.org/nltl-benchmark/vocab#personsOnBoard> ?persons ;
                          <https://w3id.org/nltl-benchmark/vocab#availableSurvivalEquipmentCapacity> ?capacity ;
                          <https://w3id.org/nltl-benchmark/vocab#storageAccessibilityStatus> true .
                    FILTER (?persons >= 0 && ?capacity >= 0 && (?capacity * 10) >= (?persons * 11))
                }
            }
        """
    ] .
