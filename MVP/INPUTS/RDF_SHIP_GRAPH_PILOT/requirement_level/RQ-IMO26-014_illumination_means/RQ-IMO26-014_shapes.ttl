@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix pilot: <urn:nltl:rdf-pilot:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pilot:IMO26_014Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatesOnlyInContinuousDaylight ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:visualIceDetectionIlluminationMeansCount ;
        sh:datatype xsd:integer ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "IMO26-014: unless the ship operates only in continuous daylight, at least two visual-ice-detection illumination means are required" ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl-benchmark/vocab#operatesOnlyInContinuousDaylight> ?daylightOnly .
                FILTER (?daylightOnly = false)
                FILTER NOT EXISTS {
                    $this <https://w3id.org/nltl-benchmark/vocab#visualIceDetectionIlluminationMeansCount> ?count .
                    FILTER (?count >= 2)
                }
            }
        """
    ] .
