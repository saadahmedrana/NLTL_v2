@prefix fs: <urn:nltl:few-shot:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

fs:Shape a sh:NodeShape ;
    sh:targetClass nltl:shipComponent ;
    sh:property [
        sh:path nltl:materialApprovalStatus ;
        sh:nodeKind sh:IRI ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
