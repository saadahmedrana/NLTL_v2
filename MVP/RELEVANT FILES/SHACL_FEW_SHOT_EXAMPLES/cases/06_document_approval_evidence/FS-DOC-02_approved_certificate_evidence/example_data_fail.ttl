@prefix dct: <http://purl.org/dc/terms/> .
@prefix fs: <urn:nltl:few-shot:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .

fs:shipFail a nltl:ship ;
    nltl:hasEvidence fs:certificateEvidence .

fs:certificateEvidence a nltl:polarShipCertificateForm ;
    dct:source fs:certificateRecord ;
    nltl:hasEvidenceState nltl:evidenceStateDraft .
