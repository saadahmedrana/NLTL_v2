@prefix fs: <urn:nltl:few-shot:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fs:shipFail a nltl:ship ;
    nltl:hasObservation fs:observationOne .

fs:observationOne a sosa:Observation ;
    sosa:hasFeatureOfInterest fs:shipFail ;
    sosa:observedProperty nltl:workingLiquid ;
    sosa:resultTime "2026-02-12 08:30"^^xsd:string ;
    sosa:hasSimpleResult "hydraulic oil"^^xsd:string .
