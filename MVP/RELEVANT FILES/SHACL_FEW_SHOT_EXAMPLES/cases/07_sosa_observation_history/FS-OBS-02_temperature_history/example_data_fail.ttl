@prefix fs: <urn:nltl:few-shot:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fs:shipFail a nltl:ship ;
    nltl:hasObservation fs:observationOne .

fs:observationOne a sosa:Observation ;
    sosa:hasFeatureOfInterest fs:shipFail ;
    sosa:observedProperty nltl:dailyLowTemperature ;
    sosa:resultTime "2026-01-10T00:00:00Z"^^xsd:dateTime ;
    sosa:hasResult [ a qudt:QuantityValue ; qudt:numericValue "-18"^^xsd:decimal ; qudt:unit unit:DEG_C ] .
