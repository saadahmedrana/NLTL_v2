@prefix fs: <urn:nltl:few-shot:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fs:shipFail a nltl:ship ;
    nltl:personsOnBoard "30"^^xsd:integer ;
    nltl:additionalEquipmentCapacityRequirement "5"^^xsd:integer ;
    nltl:personsCapacityRequirement "34"^^xsd:integer .
