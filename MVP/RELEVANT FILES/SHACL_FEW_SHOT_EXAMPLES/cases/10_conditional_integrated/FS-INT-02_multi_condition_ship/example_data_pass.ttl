@prefix fs: <urn:nltl:few-shot:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fs:shipPass a nltl:ship ;
    nltl:shipCategory nltl:polarShipCategoryA ;
    nltl:constructionDate "2022-05-01"^^xsd:date ;
    nltl:bridgeWingsEnclosed "true"^^xsd:boolean ;
    nltl:lengthOverall [ a qudt:QuantityValue ; qudt:numericValue "80"^^xsd:decimal ; qudt:unit unit:M ] .
