@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasUpperIceWaterlineCase ex:waterlineCase1,
        ex:waterlineCase2 ;
    nltl:upperIceWaterlineDisplacement ex:selectedDui .

ex:caseDisp1 a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:KiloTON_Metric .

ex:caseDisp2 a qudt:QuantityValue ;
    qudt:numericValue 12.0 ;
    qudt:unit unit:KiloTON_Metric .

ex:selectedDui a qudt:QuantityValue ;
    qudt:numericValue 12.0 ;
    qudt:unit unit:UNITLESS .

ex:waterlineCase1 a nltl:upperIceWaterlineCase ;
    nltl:waterlineCaseDisplacement ex:caseDisp1 .

ex:waterlineCase2 a nltl:upperIceWaterlineCase ;
    nltl:waterlineCaseDisplacement ex:caseDisp2 .

