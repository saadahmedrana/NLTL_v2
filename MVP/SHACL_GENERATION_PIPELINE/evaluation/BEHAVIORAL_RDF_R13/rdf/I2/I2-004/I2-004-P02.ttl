@prefix ex: <https://w3id.org/nltl/benchmark/pilot-01/I2-004-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasUpperIceWaterlineCase ex:case12 ;
    nltl:upperIceWaterlineDisplacement [
        a qudt:QuantityValue ; qudt:numericValue "12"^^xsd:decimal ; qudt:unit unit:KiloTON_Metric
    ] .

ex:case12 a nltl:upperIceWaterlineCase ;
    nltl:waterlineCaseDisplacement [
        a qudt:QuantityValue ; qudt:numericValue "12"^^xsd:decimal ; qudt:unit unit:KiloTON_Metric
    ] .
