@prefix ex: <https://w3id.org/nltl/benchmark/pilot-01/I2-005-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ; nltl:hasBottomRegionLowerRegionBoundaryPoint ex:point .
ex:point a nltl:hullBoundaryPoint ;
    nltl:shellInclinationAngle [
        a qudt:QuantityValue ; qudt:numericValue "6.9"^^xsd:decimal ; qudt:unit unit:DEG
    ] .
