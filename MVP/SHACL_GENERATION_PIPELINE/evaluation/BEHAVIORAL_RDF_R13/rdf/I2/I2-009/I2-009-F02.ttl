@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:assignment a nltl:hullAreaAssignment ;
    nltl:assignedHullArea nltl:otherIceStrengthenedArea .

ex:ship a nltl:ship ;
    nltl:averageIcePressure ex:pressure ;
    nltl:loadPatchAspectRatio ex:ar ;
    nltl:nonBowLoadPatchHeight ex:height ;
    nltl:nonBowLoadPatchLength ex:length .

ex:ar a qudt:QuantityValue ;
    qudt:numericValue 3.6 ;
    qudt:unit unit:UNITLESS .

ex:height a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:M .

ex:length a qudt:QuantityValue ;
    qudt:numericValue 3.6 ;
    qudt:unit unit:M .

ex:pressure a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:MegaPA .

