@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:bowFormApplicability true ;
    nltl:buttockAngle ex:gamma ;
    nltl:normalFrameAngle ex:beta .

ex:beta a qudt:QuantityValue ;
    qudt:numericValue 20.0 ;
    qudt:unit unit:DEG .

ex:gamma a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:DEG .

