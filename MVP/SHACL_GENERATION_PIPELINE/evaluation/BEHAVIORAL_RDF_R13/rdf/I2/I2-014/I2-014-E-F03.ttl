@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasBowSubregionCalculationCase ex:subregion1,
        ex:subregion2,
        ex:subregion3,
        ex:subregion4 ;
    nltl:selectedMaximumBowForce ex:selectedForce ;
    nltl:selectedMaximumBowLineLoad ex:selectedLine ;
    nltl:selectedMaximumBowPressure ex:selectedPressure .

ex:ar1 a qudt:QuantityValue ;
    qudt:numericValue 1.5 ;
    qudt:unit unit:UNITLESS .

ex:ar3 a qudt:QuantityValue ;
    qudt:numericValue 1.7 ;
    qudt:unit unit:UNITLESS .

ex:ar4 a qudt:QuantityValue ;
    qudt:numericValue 1.8 ;
    qudt:unit unit:UNITLESS .

ex:evidence1 a nltl:evidenceArtifact .

ex:evidence2 a nltl:evidenceArtifact .

ex:evidence3 a nltl:evidenceArtifact .

ex:evidence4 a nltl:evidenceArtifact .

ex:force1 a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:MegaN .

ex:force2 a qudt:QuantityValue ;
    qudt:numericValue 6.0 ;
    qudt:unit unit:MegaN .

ex:force3 a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:MegaN .

ex:force4 a qudt:QuantityValue ;
    qudt:numericValue 7.0 ;
    qudt:unit unit:MegaN .

ex:line1 a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:MegaN-M-PER-M2 .

ex:line2 a qudt:QuantityValue ;
    qudt:numericValue 1.4 ;
    qudt:unit unit:MegaN-M-PER-M2 .

ex:line3 a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:MegaN-M-PER-M2 .

ex:line4 a qudt:QuantityValue ;
    qudt:numericValue 1.3 ;
    qudt:unit unit:MegaN-M-PER-M2 .

ex:mid1 a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:M .

ex:mid2 a qudt:QuantityValue ;
    qudt:numericValue 3.0 ;
    qudt:unit unit:M .

ex:mid3 a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:M .

ex:mid4 a qudt:QuantityValue ;
    qudt:numericValue 7.0 ;
    qudt:unit unit:M .

ex:pressure1 a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:MegaPA .

ex:pressure2 a qudt:QuantityValue ;
    qudt:numericValue 2.5 ;
    qudt:unit unit:MegaPA .

ex:pressure3 a qudt:QuantityValue ;
    qudt:numericValue 2.2 ;
    qudt:unit unit:MegaPA .

ex:pressure4 a qudt:QuantityValue ;
    qudt:numericValue 2.4 ;
    qudt:unit unit:MegaPA .

ex:selectedForce a qudt:QuantityValue ;
    qudt:numericValue 7.0 ;
    qudt:unit unit:MegaN .

ex:selectedLine a qudt:QuantityValue ;
    qudt:numericValue 1.4 ;
    qudt:unit unit:MegaN-M-PER-M2 .

ex:selectedPressure a qudt:QuantityValue ;
    qudt:numericValue 2.5 ;
    qudt:unit unit:MegaPA .

ex:subregion1 a nltl:bowSubregionCalculationCase ;
    nltl:bowSubregionAspectRatio ex:ar1 ;
    nltl:bowSubregionCalculatedForce ex:force1 ;
    nltl:bowSubregionCalculatedLineLoad ex:line1 ;
    nltl:bowSubregionCalculatedPressure ex:pressure1 ;
    nltl:bowSubregionCalculationEvidence ex:evidence1 ;
    nltl:bowSubregionMidLengthPosition ex:mid1 .

ex:subregion2 a nltl:bowSubregionCalculationCase ;
    nltl:bowSubregionCalculatedForce ex:force2 ;
    nltl:bowSubregionCalculatedLineLoad ex:line2 ;
    nltl:bowSubregionCalculatedPressure ex:pressure2 ;
    nltl:bowSubregionCalculationEvidence ex:evidence2 ;
    nltl:bowSubregionMidLengthPosition ex:mid2 .

ex:subregion3 a nltl:bowSubregionCalculationCase ;
    nltl:bowSubregionAspectRatio ex:ar3 ;
    nltl:bowSubregionCalculatedForce ex:force3 ;
    nltl:bowSubregionCalculatedLineLoad ex:line3 ;
    nltl:bowSubregionCalculatedPressure ex:pressure3 ;
    nltl:bowSubregionCalculationEvidence ex:evidence3 ;
    nltl:bowSubregionMidLengthPosition ex:mid3 .

ex:subregion4 a nltl:bowSubregionCalculationCase ;
    nltl:bowSubregionAspectRatio ex:ar4 ;
    nltl:bowSubregionCalculatedForce ex:force4 ;
    nltl:bowSubregionCalculatedLineLoad ex:line4 ;
    nltl:bowSubregionCalculatedPressure ex:pressure4 ;
    nltl:bowSubregionCalculationEvidence ex:evidence4 ;
    nltl:bowSubregionMidLengthPosition ex:mid4 .

