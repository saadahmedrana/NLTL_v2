@prefix ex: <https://w3id.org/nltl/benchmark/pilot-02/I2-014-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasBowSubregionCalculationCase ex:subregion1,
        ex:subregion2,
        ex:subregion3 ;
    nltl:selectedMaximumBowForce <https://w3id.org/nltl/benchmark/pilot-02/I2-014-F01/ship/selectedMaximumBowForce/qv> ;
    nltl:selectedMaximumBowLineLoad <https://w3id.org/nltl/benchmark/pilot-02/I2-014-F01/ship/selectedMaximumBowLineLoad/qv> ;
    nltl:selectedMaximumBowPressure <https://w3id.org/nltl/benchmark/pilot-02/I2-014-F01/ship/selectedMaximumBowPressure/qv> .

ex:evidence1 a nltl:evidenceArtifact .

ex:evidence2 a nltl:evidenceArtifact .

ex:evidence3 a nltl:evidenceArtifact .

<https://w3id.org/nltl/benchmark/pilot-02/I2-014-F01/ship/selectedMaximumBowForce/qv> a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:MegaN .

<https://w3id.org/nltl/benchmark/pilot-02/I2-014-F01/ship/selectedMaximumBowLineLoad/qv> a qudt:QuantityValue ;
    qudt:numericValue 7.0 ;
    qudt:unit unit:MegaN-M-PER-M2 .

<https://w3id.org/nltl/benchmark/pilot-02/I2-014-F01/ship/selectedMaximumBowPressure/qv> a qudt:QuantityValue ;
    qudt:numericValue 6.0 ;
    qudt:unit unit:MegaPA .

ex:subregion1 a nltl:bowSubregionCalculationCase ;
    nltl:bowSubregionAspectRatio <https://w3id.org/nltl/benchmark/pilot-02/I2-014-F01/subregion1/bowSubregionAspectRatio/qv> ;
    nltl:bowSubregionCalculatedForce <https://w3id.org/nltl/benchmark/pilot-02/I2-014-F01/subregion1/bowSubregionCalculatedForce/qv> ;
    nltl:bowSubregionCalculatedLineLoad <https://w3id.org/nltl/benchmark/pilot-02/I2-014-F01/subregion1/bowSubregionCalculatedLineLoad/qv> ;
    nltl:bowSubregionCalculatedPressure <https://w3id.org/nltl/benchmark/pilot-02/I2-014-F01/subregion1/bowSubregionCalculatedPressure/qv> ;
    nltl:bowSubregionCalculationEvidence ex:evidence1 ;
    nltl:bowSubregionMidLengthPosition <https://w3id.org/nltl/benchmark/pilot-02/I2-014-F01/subregion1/bowSubregionMidLengthPosition/qv> .

<https://w3id.org/nltl/benchmark/pilot-02/I2-014-F01/subregion1/bowSubregionAspectRatio/qv> a qudt:QuantityValue ;
    qudt:numericValue 1.4 ;
    qudt:unit unit:UNITLESS .

<https://w3id.org/nltl/benchmark/pilot-02/I2-014-F01/subregion1/bowSubregionCalculatedForce/qv> a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:MegaN .

<https://w3id.org/nltl/benchmark/pilot-02/I2-014-F01/subregion1/bowSubregionCalculatedLineLoad/qv> a qudt:QuantityValue ;
    qudt:numericValue 3.0 ;
