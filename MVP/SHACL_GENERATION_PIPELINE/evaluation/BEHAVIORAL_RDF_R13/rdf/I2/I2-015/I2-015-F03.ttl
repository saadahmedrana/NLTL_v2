@prefix ex: <https://w3id.org/nltl/benchmark/pilot-02/I2-015-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:lookup a nltl:tableLookupCase .

ex:ship a nltl:ship ;
    nltl:hasBowSubregionCalculationCase ex:case .

ex:case a nltl:bowSubregionCalculationCase ;
    nltl:betaIPrime <https://w3id.org/nltl/benchmark/pilot-02/I2-015-F03/case/betaIPrime/qv> ;
    nltl:bowFormApplicabilityClassification nltl:i231vBowFormApplicability ;
    nltl:bowShapeCoefficient <https://w3id.org/nltl/benchmark/pilot-02/I2-015-F03/case/bowShapeCoefficient/qv> ;
    nltl:bowSubregionMidLengthPosition <https://w3id.org/nltl/benchmark/pilot-02/I2-015-F03/case/bowSubregionMidLengthPosition/qv> ;
    nltl:bowSubregionWaterlineAngle <https://w3id.org/nltl/benchmark/pilot-02/I2-015-F03/case/bowSubregionWaterlineAngle/qv> ;
    nltl:crushingFailureClassFactor <https://w3id.org/nltl/benchmark/pilot-02/I2-015-F03/case/crushingFailureClassFactor/qv> ;
    nltl:flexuralFailureClassFactor <https://w3id.org/nltl/benchmark/pilot-02/I2-015-F03/case/flexuralFailureClassFactor/qv> ;
    nltl:upperIceWaterlineLengthLUI <https://w3id.org/nltl/benchmark/pilot-02/I2-015-F03/case/upperIceWaterlineLengthLUI/qv> .

<https://w3id.org/nltl/benchmark/pilot-02/I2-015-F03/case/betaIPrime/qv> a qudt:QuantityValue ;
    qudt:numericValue 0.6 ;
    qudt:unit unit:UNITLESS .

<https://w3id.org/nltl/benchmark/pilot-02/I2-015-F03/case/bowShapeCoefficient/qv> a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:UNITLESS .

<https://w3id.org/nltl/benchmark/pilot-02/I2-015-F03/case/bowSubregionMidLengthPosition/qv> a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:M .

<https://w3id.org/nltl/benchmark/pilot-02/I2-015-F03/case/bowSubregionWaterlineAngle/qv> a qudt:QuantityValue ;
    qudt:numericValue 25.0 ;
    qudt:unit unit:DEG .

<https://w3id.org/nltl/benchmark/pilot-02/I2-015-F03/case/crushingFailureClassFactor/qv> a qudt:QuantityValue ;
    qudt:numericValue 6.06 ;
    qudt:unit unit:UNITLESS .

<https://w3id.org/nltl/benchmark/pilot-02/I2-015-F03/case/flexuralFailureClassFactor/qv> a qudt:QuantityValue ;
    qudt:numericValue 21.17 ;
    qudt:unit unit:UNITLESS .

<https://w3id.org/nltl/benchmark/pilot-02/I2-015-F03/case/upperIceWaterlineLengthLUI/qv> a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:M .

