@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-e/I2-017-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:displacementFactorThreshold ex:threshold ;
    nltl:hasNonBowIceLoadCalculationCase ex:nonBowCase ;
    nltl:upperIceWaterlineDraughtDUI ex:dui .

ex:cfc a qudt:QuantityValue ;
    qudt:numericValue 3.1 ;
    qudt:unit unit:UNITLESS .

ex:df a qudt:QuantityValue ;
    qudt:numericValue 6.8 ;
    qudt:unit unit:UNITLESS .

ex:dui a qudt:QuantityValue ;
    qudt:numericValue 20.0 ;
    qudt:unit unit:M .

ex:force a qudt:QuantityValue ;
    qudt:numericValue 700.0 ;
    qudt:unit unit:KiloN .

ex:line a qudt:QuantityValue ;
    qudt:numericValue 0.7 ;
    qudt:unit unit:MegaN-M-PER-M2 .

ex:nonBowCase a nltl:calculationCase,
        nltl:nonBowIceLoadCalculationCase,
        nltl:tableLookupCase ;
    nltl:crushingFailureClassFactor ex:cfc ;
    nltl:nonBowIceForce ex:force ;
    nltl:nonBowIceLineLoad ex:line ;
    nltl:shipDisplacementFactor ex:df .

ex:threshold a qudt:QuantityValue ;
    qudt:numericValue 40.0 ;
    qudt:unit unit:M .

