@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasIceLoadPatch ex:patch ;
    nltl:hasPeakPressureFactorLookupCase ex:lookup ;
    nltl:hasTableLookupCase ex:lookup .

ex:evidence a nltl:evidenceArtifact .

ex:force a qudt:QuantityValue ;
    qudt:numericValue 1800.0 ;
    qudt:unit unit:KiloN .

ex:height a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:M .

ex:length a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:M .

ex:patch a nltl:iceLoadPatch ;
    nltl:averageIcePressure ex:pavg ;
    nltl:iceForce ex:force ;
    nltl:loadPatchHeight ex:height ;
    nltl:loadPatchLength ex:length .

ex:pavg a qudt:QuantityValue ;
    qudt:numericValue 1.7 ;
    qudt:unit unit:MegaPA .

ex:ppf a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

ex:selectedPpf a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

ex:lookup a nltl:peakPressureFactorLookupCase,
        nltl:tableLookupCase ;
    nltl:localizedStructuralMemberCategory nltl:bottomStructureFrameCategory ;
    nltl:lookupSelectionEvidence ex:evidence ;
    nltl:peakPressureFactor ex:ppf ;
    nltl:selectedPeakPressureFactor ex:selectedPpf ;
    nltl:tableReference nltl:iacsUrI2Table3 .

