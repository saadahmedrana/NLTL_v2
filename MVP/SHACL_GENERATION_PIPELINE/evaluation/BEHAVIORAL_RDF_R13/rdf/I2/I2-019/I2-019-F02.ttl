@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasStructuralMember ex:member .

ex:area1 a nltl:hullAreaValue ;
    nltl:hullAreaFactor <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019/140593823768576/af1> .

ex:area2 a nltl:hullAreaValue ;
    nltl:hullAreaFactor <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019/140593823768576/af2> .

ex:area3 a nltl:hullAreaValue ;
    nltl:hullAreaFactor <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019/140593823768576/af3> .

ex:member a nltl:structuralMember ;
    nltl:hasSpannedHullArea ex:area1,
        ex:area2,
        ex:area3 ;
    nltl:selectedHullAreaFactor <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019/140593823768576/selected> .

<https://w3id.org/nltl/benchmark/i2-batch-a/I2-019/140593823768576/af1> a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

<https://w3id.org/nltl/benchmark/i2-batch-a/I2-019/140593823768576/af2> a qudt:QuantityValue ;
    qudt:numericValue 1.4 ;
    qudt:unit unit:UNITLESS .

<https://w3id.org/nltl/benchmark/i2-batch-a/I2-019/140593823768576/af3> a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:UNITLESS .

<https://w3id.org/nltl/benchmark/i2-batch-a/I2-019/140593823768576/selected> a qudt:QuantityValue ;
    qudt:numericValue 1.6 ;
    qudt:unit unit:UNITLESS .

