@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasStructuralMember ex:member .

ex:area1 a nltl:hullAreaValue ;
    nltl:hullAreaFactor <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019/140593823488128/af1> .

ex:member a nltl:structuralMember ;
    nltl:hasSpannedHullArea ex:area1 ;
    nltl:selectedHullAreaFactor <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019/140593823488128/selected> .

<https://w3id.org/nltl/benchmark/i2-batch-a/I2-019/140593823488128/af1> a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:UNITLESS .

<https://w3id.org/nltl/benchmark/i2-batch-a/I2-019/140593823488128/selected> a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:UNITLESS .

