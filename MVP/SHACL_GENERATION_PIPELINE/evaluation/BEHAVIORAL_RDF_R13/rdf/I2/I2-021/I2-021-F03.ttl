@prefix ex: <https://w3id.org/nltl/benchmark/pilot-02/I2-021-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasPlating ex:plating .

ex:plating a nltl:plating ;
    nltl:iceLoadRequiredNetPlateThickness <https://w3id.org/nltl/benchmark/pilot-02/I2-021-F03/plating/iceLoadRequiredNetPlateThickness/qv> ;
    nltl:thickness <https://w3id.org/nltl/benchmark/pilot-02/I2-021-F03/plating/thickness/qv> .

<https://w3id.org/nltl/benchmark/pilot-02/I2-021-F03/plating/iceLoadRequiredNetPlateThickness/qv> a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:MilliM .

<https://w3id.org/nltl/benchmark/pilot-02/I2-021-F03/plating/thickness/qv> a qudt:QuantityValue ;
    qudt:numericValue 0.012 ;
    qudt:unit unit:M .

