@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasPlating ex:plating .

ex:plating a nltl:plating ;
    nltl:iceLoadRequiredNetPlateThickness ex:tnet ;
    nltl:thickness ex:thickness .

ex:thickness a qudt:QuantityValue ;
    qudt:numericValue 0.022 ;
    qudt:unit unit:M .

ex:tnet a qudt:QuantityValue ;
    qudt:numericValue 20.0 ;
    qudt:unit unit:MilliM .

