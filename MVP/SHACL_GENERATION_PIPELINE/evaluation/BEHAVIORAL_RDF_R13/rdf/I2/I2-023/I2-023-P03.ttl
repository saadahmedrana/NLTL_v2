@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasPlating ex:plating .

ex:member a nltl:structuralMember .

ex:omega a qudt:QuantityValue ;
    qudt:numericValue 45.0 ;
    qudt:unit unit:DEG .

ex:plating a nltl:plating ;
    nltl:framingAngleOmega ex:omega ;
    nltl:platingSupportedByStructuralMember ex:member .

