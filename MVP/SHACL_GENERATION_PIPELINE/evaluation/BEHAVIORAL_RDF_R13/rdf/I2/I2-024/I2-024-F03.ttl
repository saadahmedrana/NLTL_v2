@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:framingAngle ex:framingAngle ;
    nltl:hasObliquePlatingInterpolationCase ex:case .

ex:case a nltl:calculationCase,
        nltl:obliquePlatingInterpolationCase ;
    nltl:interpolatedNetPlateThickness ex:interpolatedThickness ;
    nltl:interpolationLowerEndpoint ex:lowerEndpoint ;
    nltl:interpolationUpperEndpoint ex:upperEndpoint ;
    nltl:longitudinalFramingNetPlateThickness ex:longitudinalThickness ;
    nltl:transverseFramingNetPlateThickness ex:transverseThickness .

ex:framingAngle a qudt:QuantityValue ;
    qudt:numericValue 45.0 ;
    qudt:unit unit:DEG .

ex:interpolatedThickness a qudt:QuantityValue ;
    qudt:numericValue 0.012 ;
    qudt:unit unit:MilliM .

ex:longitudinalThickness a qudt:QuantityValue ;
    qudt:numericValue 0.01 ;
    qudt:unit unit:MilliM .

ex:lowerCoordinate a qudt:QuantityValue ;
    qudt:numericValue 20.0 ;
    qudt:unit unit:UNITLESS .

ex:lowerEndpoint a nltl:interpolationPoint ;
    nltl:interpolationPointCoordinate ex:lowerCoordinate ;
    nltl:interpolationPointResult ex:lowerResult .

ex:lowerResult a qudt:QuantityValue ;
    qudt:numericValue 0.01 ;
    qudt:unit unit:MilliM .

ex:transverseThickness a qudt:QuantityValue ;
    qudt:numericValue 0.014 ;
    qudt:unit unit:MilliM .

ex:upperCoordinate a qudt:QuantityValue ;
    qudt:numericValue 70.0 ;
    qudt:unit unit:UNITLESS .

ex:upperEndpoint a nltl:interpolationPoint ;
    nltl:interpolationPointCoordinate ex:upperCoordinate ;
    nltl:interpolationPointResult ex:upperResult .

ex:upperResult a qudt:QuantityValue ;
    qudt:numericValue 0.014 ;
    qudt:unit unit:MilliM .

