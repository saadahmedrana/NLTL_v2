@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasStructuralMember ex:member .

ex:collapse a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:KiloN .

ex:demand1 a qudt:QuantityValue ;
    qudt:numericValue 80.0 ;
    qudt:unit unit:KiloN .

ex:demand2 a qudt:QuantityValue ;
    qudt:numericValue 101.0 ;
    qudt:unit unit:KiloN .

ex:load1 a nltl:loadCase ;
    nltl:combinedShearAndBendingDemand ex:demand1 .

ex:load2 a nltl:loadCase ;
    nltl:combinedShearAndBendingDemand ex:demand2 .

ex:member a nltl:longitudinalLocalFrame,
        nltl:structuralMember ;
    nltl:hasStructuralMemberLoadCase ex:load1,
        ex:load2 ;
    nltl:longitudinalFrameOrientation true ;
    nltl:midspanPlasticCollapseLoad ex:collapse ;
    nltl:plasticStrength ex:strength ;
    nltl:sideStructureApplicability true ;
    nltl:structuralLocation nltl:sideStructureLocation .

ex:strength a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:KiloN .

