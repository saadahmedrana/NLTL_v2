@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-f/I2-035-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:averageIcePressure ex:pavg ;
    nltl:frameSpacing ex:s ;
    nltl:frameSpan ex:a ;
    nltl:loadPatchHeight ex:b ;
    nltl:peakPressureFactor ex:ppf ;
    nltl:requiredLongitudinalFrameShearArea ex:al ;
    nltl:selectedHullAreaFactor ex:af ;
    nltl:shearArea ex:aw ;
    nltl:yieldStrength ex:sy .

ex:a a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:M .

ex:af a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

ex:al a qudt:QuantityValue ;
    qudt:numericValue 62.68667723736126 ;
    qudt:unit unit:CentiM2 .

ex:aw a qudt:QuantityValue ;
    qudt:numericValue 0.007268667723736127 ;
    qudt:unit unit:M2 .

ex:b a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:M .

ex:pavg a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:MegaPA .

ex:ppf a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

ex:s a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:M .

ex:sy a qudt:QuantityValue ;
    qudt:numericValue 235.0 ;
    qudt:unit unit:MegaPA .

