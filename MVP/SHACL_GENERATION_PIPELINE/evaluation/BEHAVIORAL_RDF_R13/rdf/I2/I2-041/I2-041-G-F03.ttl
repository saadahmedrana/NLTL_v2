@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-g/I2-041-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasStructuralMember ex:member .

ex:member a nltl:structuralMember ;
    nltl:netAttachedShellPlateThickness ex:netAttachedShellPlateThickness ;
    nltl:yieldStrength ex:yieldStrength .

ex:netAttachedShellPlateThickness a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:MilliM .

ex:yieldStrength a qudt:QuantityValue ;
    qudt:numericValue 235.0 ;
    qudt:unit unit:MegaPA .

