@prefix ex: <https://w3id.org/nltl/benchmark/pilot-01/I2-042-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ; nltl:hasStructuralMember ex:member .
ex:member a nltl:structuralMember ;
    nltl:netWebThickness [ a qudt:QuantityValue ; qudt:numericValue "10.0"^^xsd:decimal ; qudt:unit unit:MilliM ] ;
    nltl:flangeWidth [ a qudt:QuantityValue ; qudt:numericValue "55.0"^^xsd:decimal ; qudt:unit unit:MilliM ] .
