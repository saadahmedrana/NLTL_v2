@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:netThickness ex:net ;
    nltl:steelRenewalRequired true .

ex:net a qudt:QuantityValue ;
    qudt:numericValue 0.01 ;
    qudt:unit unit:M .

