@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F003/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

ex:ship a nltl:ship ;
    nltl:hasSteelGradeRequirementCase ex:case ;
    nltl:polarClass nltl:polarClassPc3 .

ex:case a nltl:steelGradeRequirementCase ;
    nltl:actualHullStructuralSteelGrade nltl:steelGradeD ;
    nltl:requiredHullStructuralSteelGrade nltl:steelGradeD ;
    nltl:steelGradeRequirementCasePlating ex:plating ;
    nltl:steelMaterialClass nltl:steelMaterialClassOne ;
    nltl:steelStrengthCategory nltl:normalStrengthSteelCategory ;
    nltl:tableReference nltl:iacsUrI2Table8 .

ex:plating a nltl:plating .

