@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T018/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasSteelGradeRequirementCase ex:case ;
    nltl:polarClass nltl:polarClassPc6 .

ex:case a nltl:steelGradeRequirementCase ;
    nltl:actualHullStructuralSteelGrade nltl:steelGradeAh ;
    nltl:requiredHullStructuralSteelGrade nltl:steelGradeAh ;
    nltl:steelGradeRequirementCasePlating ex:plating ;
    nltl:steelMaterialClass nltl:steelMaterialClassOne ;
    nltl:steelStrengthCategory nltl:highTensileSteelCategory ;
    nltl:tableReference nltl:iacsUrI2Table8 .

ex:plating a nltl:plating ;
    nltl:asBuiltPlateThickness ex:thickness .

ex:thickness a qudt:QuantityValue ;
    qudt:numericValue 12.5 ;
    qudt:unit unit:MilliM .

