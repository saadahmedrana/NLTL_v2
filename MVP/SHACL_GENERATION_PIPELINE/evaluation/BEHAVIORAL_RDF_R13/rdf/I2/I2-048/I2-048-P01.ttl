@prefix ex: <https://w3id.org/nltl/benchmark/pilot-02/I2-048-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasSteelGradeRequirementCase ex:case ;
    nltl:polarClass nltl:polarClassPc3 .

ex:case a nltl:steelGradeRequirementCase ;
    nltl:actualHullStructuralSteelGrade nltl:steelGradeB ;
    nltl:requiredHullStructuralSteelGrade nltl:steelGradeB ;
    nltl:steelGradeRequirementCasePlating ex:plating ;
    nltl:steelMaterialClass nltl:steelMaterialClassOne ;
    nltl:steelStrengthCategory nltl:normalStrengthSteelCategory ;
    nltl:tableReference nltl:iacsUrI2Table8 .

ex:plating a nltl:plating ;
    nltl:asBuiltPlateThickness <https://w3id.org/nltl/benchmark/pilot-02/I2-048-P01/plating/asBuiltPlateThickness/qv> .

<https://w3id.org/nltl/benchmark/pilot-02/I2-048-P01/plating/asBuiltPlateThickness/qv> a qudt:QuantityValue ;
    qudt:numericValue 8.0 ;
    qudt:unit unit:MilliM .

