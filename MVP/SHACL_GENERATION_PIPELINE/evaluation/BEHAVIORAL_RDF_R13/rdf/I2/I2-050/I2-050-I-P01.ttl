@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:calculation a nltl:calculationCase .

ex:ship a nltl:ship ;
    nltl:crushingFailureClassFactor ex:crushingFailureClassFactor ;
    nltl:designVerticalIceForceAtBow ex:designVerticalIceForceAtBow ;
    nltl:designVerticalIceForceAtBowCandidateOne ex:designVerticalIceForceAtBowCandidateOne ;
    nltl:designVerticalIceForceAtBowCandidateTwo ex:designVerticalIceForceAtBowCandidateTwo ;
    nltl:flexuralFailureClassFactor ex:flexuralFailureClassFactor ;
    nltl:hullFormCoefficientKh ex:hullFormCoefficientKh ;
    nltl:iceStrengthCoefficientKI ex:iceStrengthCoefficientKI ;
    nltl:longitudinalStrengthClassFactor ex:longitudinalStrengthClassFactor ;
    nltl:stemAngle ex:stemAngle ;
    nltl:upperIceWaterlineDraughtDUI ex:upperIceWaterlineDraughtDUI .

ex:crushingFailureClassFactor a qudt:QuantityValue ;
    qudt:numericValue 4.5 ;
    qudt:unit unit:UNITLESS .

ex:designVerticalIceForceAtBow a qudt:QuantityValue ;
    qudt:numericValue 7.0 ;
    qudt:unit unit:MegaN .

ex:designVerticalIceForceAtBowCandidateOne a qudt:QuantityValue ;
    qudt:numericValue 7.0 ;
    qudt:unit unit:MegaN .

ex:designVerticalIceForceAtBowCandidateTwo a qudt:QuantityValue ;
    qudt:numericValue 16.176 ;
    qudt:unit unit:MegaN .

ex:flexuralFailureClassFactor a qudt:QuantityValue ;
    qudt:numericValue 13.48 ;
    qudt:unit unit:UNITLESS .

ex:hullFormCoefficientKh a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:UNITLESS .

ex:iceStrengthCoefficientKI a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:UNITLESS .

ex:longitudinalStrengthClassFactor a qudt:QuantityValue ;
    qudt:numericValue 3.15 ;
    qudt:unit unit:UNITLESS .

ex:stemAngle a qudt:QuantityValue ;
    qudt:numericValue 45.0 ;
    qudt:unit unit:DEG .

ex:upperIceWaterlineDraughtDUI a qudt:QuantityValue ;
    qudt:numericValue 12.0 ;
    qudt:unit unit:M .

