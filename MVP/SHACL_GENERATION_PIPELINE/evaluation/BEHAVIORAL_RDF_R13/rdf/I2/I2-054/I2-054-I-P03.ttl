@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:designVerticalIceForceAtBow ex:designVerticalIceForceAtBow ;
    nltl:hasCalculationCase ex:bendingCase ;
    nltl:hasHullGirderBendingMomentCalculationCase ex:bendingCase ;
    nltl:stemAngle ex:stemAngle ;
    nltl:upperIceWaterlineLengthLUI ex:upperIceWaterlineLengthLUI .

ex:caseBendingMomentDistributionFactor a qudt:QuantityValue ;
    qudt:numericValue 0.2 ;
    qudt:unit unit:UNITLESS .

ex:caseDesignVerticalIceBendingMoment a qudt:QuantityValue ;
    qudt:numericValue 999.0 ;
    qudt:unit unit:MegaN-M .

ex:caseHullGirderLongitudinalPositionFromAft a qudt:QuantityValue ;
    qudt:numericValue 82.5 ;
    qudt:unit unit:M .

ex:designVerticalIceForceAtBow a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:MegaN .

ex:interp1 a nltl:interpolationPoint ;
    nltl:interpolationCoordinate ex:interpCoord1 ;
    nltl:interpolationPointValue ex:interpVal1 .

ex:interp2 a nltl:interpolationPoint ;
    nltl:interpolationCoordinate ex:interpCoord2 ;
    nltl:interpolationPointValue ex:interpVal2 .

ex:interpCoord1 a qudt:QuantityValue ;
    qudt:numericValue 70.0 ;
    qudt:unit unit:M .

ex:interpCoord2 a qudt:QuantityValue ;
    qudt:numericValue 95.0 ;
    qudt:unit unit:M .

ex:interpVal1 a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

ex:interpVal2 a qudt:QuantityValue ;
    qudt:numericValue 0.3 ;
    qudt:unit unit:UNITLESS .

ex:stemAngle a qudt:QuantityValue ;
    qudt:numericValue 45.0 ;
    qudt:unit unit:DEG .

ex:upperIceWaterlineLengthLUI a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:M .

ex:bendingCase a nltl:calculationCase,
        nltl:hullGirderBendingMomentCalculationCase ;
    nltl:caseBendingMomentDistributionFactor ex:caseBendingMomentDistributionFactor ;
    nltl:caseDesignVerticalIceBendingMoment ex:caseDesignVerticalIceBendingMoment ;
    nltl:caseHullGirderLongitudinalPositionFromAft ex:caseHullGirderLongitudinalPositionFromAft ;
    nltl:hasInterpolationPoint ex:interp1,
        ex:interp2 .

