@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:designStress ex:designStress ;
    nltl:permissibleStress ex:permissibleStress ;
    nltl:strengthCriterionStatus false .

ex:designStress a qudt:QuantityValue ;
    qudt:numericValue 250.0 ;
    qudt:unit unit:MegaPA .

ex:permissibleStress a qudt:QuantityValue ;
    qudt:numericValue 200.0 ;
    qudt:unit unit:MegaPA .

