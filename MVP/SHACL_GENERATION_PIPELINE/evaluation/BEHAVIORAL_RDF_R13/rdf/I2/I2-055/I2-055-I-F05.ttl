@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:designStress ex:designStress ;
    nltl:strengthCriterionStatus true .

ex:designStress a qudt:QuantityValue ;
    qudt:numericValue 150.0 ;
    qudt:unit unit:MegaPA .

