@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasStructuralMember ex:member .

ex:cutout a nltl:cutout .

ex:member a nltl:structuralMember ;
    nltl:hasCutout ex:cutout ;
    nltl:memberInWayOfCutout true ;
    nltl:stiffeningNecessary false .

