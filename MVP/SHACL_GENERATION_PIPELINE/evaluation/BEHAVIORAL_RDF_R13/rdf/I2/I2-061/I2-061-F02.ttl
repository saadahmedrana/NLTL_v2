@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

ex:ship a nltl:ship ;
    nltl:hasCalculationCase ex:case .

ex:case a nltl:calculationCase ;
    nltl:calculationCaseAssessedHullStructure ex:structure ;
    nltl:calculationMethod nltl:directCalculationMethodValue .

ex:structure a nltl:structuralMember .

