@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

ex:ship a nltl:ship ;
    nltl:hasStructuralMember ex:member .

ex:grillage a nltl:grillageSystem .

ex:member a nltl:loadCarryingStringer,
        nltl:structuralMember ;
    nltl:partOfGrillageSystem ex:grillage .

