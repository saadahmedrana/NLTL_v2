@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasWeld ex:weld1,
        ex:weld2,
        ex:weld3 .

ex:weld1 a nltl:weld ;
    nltl:weldType nltl:doubleContinuousWeld ;
    nltl:withinIceStrengthenedArea true .

ex:weld2 a nltl:weld ;
    nltl:weldType ex:otherWeldType ;
    nltl:withinIceStrengthenedArea true .

ex:weld3 a nltl:weld ;
    nltl:weldType ex:otherWeldType ;
    nltl:withinIceStrengthenedArea false .

