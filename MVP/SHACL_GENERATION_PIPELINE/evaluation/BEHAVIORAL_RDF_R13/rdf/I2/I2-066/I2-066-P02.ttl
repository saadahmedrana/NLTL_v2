@prefix ex: <https://w3id.org/nltl/benchmark/pilot-02/I2-066-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasWeld ex:w1,
        ex:w2 .

ex:w1 a nltl:weld ;
    nltl:weldType nltl:doubleContinuousWeld ;
    nltl:withinIceStrengthenedArea true .

ex:w2 a nltl:weld ;
    nltl:weldType nltl:doubleContinuousWeld ;
    nltl:withinIceStrengthenedArea true .

