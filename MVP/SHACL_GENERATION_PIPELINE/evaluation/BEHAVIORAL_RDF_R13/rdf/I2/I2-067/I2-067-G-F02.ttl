@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:structuralConnection ex:connection1,
        ex:connection2,
        ex:connection3 .

ex:connection1 a nltl:benchmarkEntity ;
    nltl:strengthContinuityStatus true .

ex:connection2 a nltl:benchmarkEntity ;
    nltl:strengthContinuityStatus false .

ex:connection3 a nltl:benchmarkEntity ;
    nltl:strengthContinuityStatus true .

