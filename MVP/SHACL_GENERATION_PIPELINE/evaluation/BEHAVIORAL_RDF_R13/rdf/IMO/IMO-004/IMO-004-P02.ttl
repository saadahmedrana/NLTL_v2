@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:iceOriginType nltl:seaIceOrigin ;
    nltl:iceThickness ex:iceThicknessValue ;
    nltl:iceTypeClassification nltl:firstYearIce ;
    nltl:winterGrowthCount 1 .

ex:iceThicknessValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:M .

