@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-006-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:iceThickness ex:iceThicknessValue ;
    nltl:iceTypeClassification nltl:mediumFirstYearIce .

ex:iceThicknessValue a qudt:QuantityValue ;
    qudt:numericValue 0.7 ;
    qudt:unit unit:M .

