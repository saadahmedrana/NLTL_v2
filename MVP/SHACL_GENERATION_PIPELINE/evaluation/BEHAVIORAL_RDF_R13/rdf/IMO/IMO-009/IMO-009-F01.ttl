@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:iceCondition "bergy waters"^^xsd:string ;
    nltl:landOriginIceConcentration ex:landOriginIceConcentrationValue ;
    nltl:totalIceConcentration ex:totalIceConcentrationValue .

ex:landOriginIceConcentrationValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

ex:totalIceConcentrationValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

