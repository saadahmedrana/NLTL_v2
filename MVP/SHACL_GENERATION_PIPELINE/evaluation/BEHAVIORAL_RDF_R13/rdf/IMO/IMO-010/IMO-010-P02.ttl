@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-010-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:maximumExpectedRescueTime ex:maximumExpectedRescueTimeValue .

ex:maximumExpectedRescueTimeValue a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:DAY .

