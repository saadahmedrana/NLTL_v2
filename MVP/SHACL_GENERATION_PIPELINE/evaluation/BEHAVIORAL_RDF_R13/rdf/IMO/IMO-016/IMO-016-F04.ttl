@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:certificate a nltl:polarShipCertificateForm ;
    nltl:certificateFormModel nltl:appendixIPolarShipCertificateModel ;
    nltl:certificateLanguage "English"^^xsd:string .

ex:ship a nltl:ship .

