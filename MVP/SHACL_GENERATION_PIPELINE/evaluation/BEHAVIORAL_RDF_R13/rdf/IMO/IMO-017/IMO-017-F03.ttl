@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:endorsementDates "2028-07-01"^^xsd:date ;
    nltl:hasPolarShipCertificate ex:certificate ;
    nltl:hasSolasCertificateSchedule ex:solasSchedule ;
    nltl:polarCertificateValidityDates "2030-01-01"^^xsd:date ;
    nltl:surveyDates "2028-06-01"^^xsd:date .

ex:supplement a nltl:polarCertificateSupplement .

ex:certificate a nltl:polarShipCertificateForm .

ex:endorsementRecord a nltl:certificateScheduleDateRecord ;
    nltl:certificateScheduleDate "2028-07-01"^^xsd:date ;
    nltl:certificateScheduleDateType nltl:endorsementDateCategory .

ex:solasSchedule a nltl:solasCertificateSchedule ;
    nltl:hasCertificateScheduleDateRecord ex:endorsementRecord,
        ex:surveyRecord,
        ex:validityRecord .

ex:surveyRecord a nltl:certificateScheduleDateRecord ;
    nltl:certificateScheduleDate "2028-06-01"^^xsd:date ;
    nltl:certificateScheduleDateType nltl:surveyDateCategory .

ex:validityRecord a nltl:certificateScheduleDateRecord ;
    nltl:certificateScheduleDate "2030-01-01"^^xsd:date ;
    nltl:certificateScheduleDateType nltl:validityDateCategory .

