@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:lowestMdlt ex:lowestMdltValue ;
    nltl:requiredSystemsFunctionalAtPst true ;
    nltl:shipOperatesInLowAirTemperature true .

ex:lowestMdltValue a qudt:QuantityValue ;
    qudt:numericValue -20.0 ;
    qudt:unit unit:DEG_C .

