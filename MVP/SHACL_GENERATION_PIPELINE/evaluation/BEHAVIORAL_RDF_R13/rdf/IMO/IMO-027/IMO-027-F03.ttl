@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-027-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:environmentalForecastArrangements "receive environmental forecasts"^^xsd:string ;
    nltl:environmentalFunctionalityMeasures true ;
    nltl:informationLimitationMeasures ""^^xsd:string ;
    nltl:polarWaterOperationalManualRiskProcedureCoverage true ;
    nltl:requiredEquipmentOperation "operate equipment required by other Code chapters"^^xsd:string ;
    nltl:voyageLimitAvoidance "avoid ice/temperature limits"^^xsd:string .

