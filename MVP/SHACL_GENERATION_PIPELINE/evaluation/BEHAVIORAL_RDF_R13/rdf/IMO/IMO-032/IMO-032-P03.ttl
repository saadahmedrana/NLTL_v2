@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-032-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasApprovalRecord ex:approvalRecord ;
    nltl:shipCategory nltl:polarShipCategoryC ;
    nltl:shipIceStrengthened true .

ex:approvalRecord a nltl:approvalRecord ;
    nltl:approvalStandard "acceptable standard adequate for operating ice type and concentration"^^xsd:string ;
    nltl:approvingAuthority "Administration"^^xsd:string ;
    nltl:operatingIceConcentration ex:operatingIceConcentrationValue ;
    nltl:operatingIceType "medium first-year ice"^^xsd:string ;
    nltl:scantlingApprovalStatus nltl:evidenceStateApproved .

ex:operatingIceConcentrationValue a qudt:QuantityValue ;
    qudt:numericValue 0.7 ;
    qudt:unit unit:UNITLESS .

