@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-034-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:administrationRequiredIceRemovalMeans "electrical, pneumatic, or special-tool means as required"^^xsd:string ;
    nltl:iceAccretionLikely true ;
    nltl:iceAccretionMinimizationDesignPresent true ;
    nltl:requiredIceRemovalMeansPresent true .

