@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasPolarWaterOperationalManualRecord ex:pwomRecord ;
    nltl:hasStabilityCalculationRecord ex:stabilityRecord .

ex:pwomRecord a nltl:documentRecord ;
    nltl:polarWaterOperationalManualIcingAllowanceInformationPresent false ;
    nltl:polarWaterOperationalManualIcingAllowanceValues "deck=30 kg/m2; side=7.5 kg/m2"^^xsd:string .

ex:stabilityRecord a nltl:documentRecord ;
    nltl:stabilityCalculationIcingAllowanceValues "deck=30 kg/m2; side=7.5 kg/m2"^^xsd:string .

