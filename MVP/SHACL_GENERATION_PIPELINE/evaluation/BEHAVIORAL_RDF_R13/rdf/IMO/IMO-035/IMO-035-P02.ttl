@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasPolarWaterOperationalManualRecord ex:pwomRecord ;
    nltl:hasStabilityCalculationRecord ex:stabilityRecord .

ex:pwomRecord a nltl:documentRecord ;
    nltl:polarWaterOperationalManualIcingAllowanceInformationPresent true ;
    nltl:polarWaterOperationalManualIcingAllowanceValues "30|7.5|5%|10%"^^xsd:string .

ex:stabilityRecord a nltl:documentRecord ;
    nltl:stabilityCalculationIcingAllowanceValues "30|7.5|5%|10%"^^xsd:string .

