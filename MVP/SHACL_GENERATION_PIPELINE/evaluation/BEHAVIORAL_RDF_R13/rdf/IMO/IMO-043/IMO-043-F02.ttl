@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasMachineryInstallation ex:mainMachinery .

ex:mainMachinery a nltl:machineryInstallationItem ;
    nltl:hasApplicableHazard nltl:iceAccretionHazard,
        nltl:liquidFreezingOrViscosityIncreaseHazard,
        nltl:seawaterIceIngestionHazard,
        nltl:seawaterIntakeTemperatureHazard,
        nltl:snowAccumulationHazard,
        nltl:snowIngestionHazard ;
    nltl:hasAssociatedEquipment ex:mainMachineryEquipment ;
    nltl:machineryInstallation "mainMachinery"^^xsd:string .

ex:mainMachineryEquipment a nltl:associatedEquipmentItem .

