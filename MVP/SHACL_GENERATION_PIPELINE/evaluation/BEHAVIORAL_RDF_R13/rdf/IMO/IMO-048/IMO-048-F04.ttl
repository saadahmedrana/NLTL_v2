@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:approvalStandard "standard acceptable to the Organization"^^xsd:string ;
    nltl:approvingAuthority "Administration"^^xsd:string ;
    nltl:exposedMachineryOrFoundationMaterial "exposed machinery/foundation material"^^xsd:string ;
    nltl:materialApprovalStatus nltl:evidenceStateApproved .

