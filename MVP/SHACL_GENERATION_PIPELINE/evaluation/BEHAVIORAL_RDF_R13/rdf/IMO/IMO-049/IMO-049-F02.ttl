@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasComponent ex:steering ;
    nltl:shipCategory nltl:polarShipCategoryB ;
    nltl:shipIceStrengthened true .

ex:steering a nltl:machineryComponent ;
    nltl:hasApprovalRecord ex:steeringApproval ;
    nltl:machineryComponentType "steering equipment"^^xsd:string .

ex:steeringApproval a nltl:approvalRecord ;
    nltl:approvalStandard "standard acceptable to the Organization"^^xsd:string ;
    nltl:approvingAuthority "manufacturer"^^xsd:string ;
    nltl:scantlingApprovalStatus nltl:evidenceStateApproved .

