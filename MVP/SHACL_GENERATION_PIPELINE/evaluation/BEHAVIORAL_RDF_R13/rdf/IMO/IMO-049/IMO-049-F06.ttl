@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasComponent ex:propeller,
        ex:shaft ;
    nltl:shipCategory nltl:polarShipCategoryA ;
    nltl:shipIceStrengthened true .

ex:propeller a nltl:machineryComponent ;
    nltl:hasApprovalRecord ex:propellerApproval ;
    nltl:machineryComponentType "propeller blade"^^xsd:string .

ex:propellerApproval a nltl:approvalRecord ;
    nltl:approvalStandard "standard acceptable to the Organization"^^xsd:string ;
    nltl:approvingAuthority "Administration"^^xsd:string ;
    nltl:scantlingApprovalStatus nltl:evidenceStateApproved .

ex:shaft a nltl:machineryComponent ;
    nltl:hasApprovalRecord ex:shaftApproval ;
    nltl:machineryComponentType "propulsion line"^^xsd:string .

ex:shaftApproval a nltl:approvalRecord ;
    nltl:approvalStandard "standard acceptable to the Organization"^^xsd:string ;
    nltl:approvingAuthority "manufacturer"^^xsd:string ;
    nltl:scantlingApprovalStatus nltl:evidenceStateApproved .

