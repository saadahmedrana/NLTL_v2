@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-P05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasComponent ex:hotel ;
    nltl:shipCategory nltl:polarShipCategoryA ;
    nltl:shipIceStrengthened true .

ex:hotel a nltl:machineryComponent ;
    nltl:machineryComponentType "hotel service equipment"^^xsd:string .

