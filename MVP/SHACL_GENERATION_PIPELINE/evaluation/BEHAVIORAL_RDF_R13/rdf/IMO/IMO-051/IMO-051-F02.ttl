@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasLocalControlItem ex:control1 .

ex:control1 a nltl:localControlItem ;
    nltl:continuouslyAccessible false ;
    nltl:freezingSnowIceProtectionPresent true .

