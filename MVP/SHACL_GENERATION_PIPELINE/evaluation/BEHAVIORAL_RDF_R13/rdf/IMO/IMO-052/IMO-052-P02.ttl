@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

ex:ship a nltl:ship ;
    nltl:hasRequiredAccessItem ex:access1,
        ex:access2 .

ex:access1 a nltl:requiredAccessItem ;
    nltl:hasIceOrSnowRemovalOrPreventionMeans ex:access1Means .

ex:access1Means a nltl:iceSnowRemovalOrPreventionMeans .

ex:access2 a nltl:requiredAccessItem ;
    nltl:hasIceOrSnowRemovalOrPreventionMeans ex:access2Means .

ex:access2Means a nltl:iceSnowRemovalOrPreventionMeans .

