@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-057-P04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasComponent ex:spray .

ex:spray a nltl:waterSprayPump ;
    nltl:hasContainingCompartment ex:sprayCompartment .

ex:sprayCompartment a nltl:compartment ;
    nltl:maintainedTemperature ex:sprayMaintainedTemperatureValue .

ex:sprayMaintainedTemperatureValue a qudt:QuantityValue ;
    qudt:numericValue 0.1 ;
    qudt:unit unit:DEG_C .

