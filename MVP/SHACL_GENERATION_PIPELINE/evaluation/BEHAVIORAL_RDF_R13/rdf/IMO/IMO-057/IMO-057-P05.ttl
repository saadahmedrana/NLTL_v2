@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-057-P05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasComponent ex:fire,
        ex:mist .

ex:fire a nltl:firePump ;
    nltl:hasContainingCompartment ex:fireCompartment .

ex:fireCompartment a nltl:compartment ;
    nltl:maintainedTemperature ex:fireMaintainedTemperatureValue .

ex:fireMaintainedTemperatureValue a qudt:QuantityValue ;
    qudt:numericValue 3.0 ;
    qudt:unit unit:DEG_C .

ex:mist a nltl:waterMistPump ;
    nltl:hasContainingCompartment ex:mistCompartment .

ex:mistCompartment a nltl:compartment ;
    nltl:maintainedTemperature ex:mistMaintainedTemperatureValue .

ex:mistMaintainedTemperatureValue a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:DEG_C .

