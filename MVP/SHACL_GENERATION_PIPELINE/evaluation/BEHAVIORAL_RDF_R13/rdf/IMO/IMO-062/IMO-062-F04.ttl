@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasExposedEscapeRoute ex:route1 .

ex:route1 a nltl:exposedEscapeRoute ;
    nltl:accessibleStatus true ;
    nltl:hasEscapeRouteIceSnowMitigationEvidence ex:route1Evidence ;
    nltl:safeStatus true .

ex:route1Evidence a nltl:evidenceArtifact ;
    nltl:iceSnowMitigationCoverage false .

