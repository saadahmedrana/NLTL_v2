@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:abandonmentEnvironment "water, ice or land"^^xsd:string ;
    nltl:accommodationSpacePresent true ;
    nltl:habitableEnvironmentPresent true ;
    nltl:maximumExpectedRescueTime ex:maximumExpectedRescueTimeValue ;
    nltl:rescueCommunicationPresent true ;
    nltl:safeAccessExitPresent true ;
    nltl:survivalSupportDuration ex:survivalSupportDurationValue ;
    nltl:sustenanceMeansPresent true ;
    nltl:weatherProtectionPresent false .

ex:maximumExpectedRescueTimeValue a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:DAY .

ex:survivalSupportDurationValue a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:DAY .

