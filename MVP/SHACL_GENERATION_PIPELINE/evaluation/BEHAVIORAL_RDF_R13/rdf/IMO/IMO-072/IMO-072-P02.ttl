@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:extendedDarknessOperation true ;
    nltl:hasLifeboat ex:boat1,
        ex:boat2 .

ex:boat1 a nltl:lifeboat ;
    nltl:hasAssignedSearchlight ex:boat1Searchlight .

ex:boat1Searchlight a nltl:searchlight ;
    nltl:searchlightContinuousUseSuitabilityStatus true .

ex:boat2 a nltl:lifeboat ;
    nltl:hasAssignedSearchlight ex:boat2Searchlight .

ex:boat2Searchlight a nltl:searchlight ;
    nltl:searchlightContinuousUseSuitabilityStatus true .

