@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-073-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

ex:ship a nltl:ship ;
    nltl:hasLifeboat ex:boat1,
        ex:boat2 .

ex:boat1 a nltl:lifeboat ;
    nltl:lifeboatTypeClassification nltl:partiallyEnclosedLifeboat .

ex:boat2 a nltl:lifeboat ;
    nltl:lifeboatTypeClassification nltl:totallyEnclosedLifeboat .

