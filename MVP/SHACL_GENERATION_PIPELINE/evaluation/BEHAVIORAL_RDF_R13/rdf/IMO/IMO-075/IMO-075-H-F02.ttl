@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:availableSurvivalEquipmentCapacity 11 ;
    nltl:personalOrGroupSurvivalEquipmentRequired true ;
    nltl:personsOnBoard 10 ;
    nltl:storageAccessibilityStatus false .

