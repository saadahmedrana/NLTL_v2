@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-P04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:availableSurvivalEquipmentCapacity 2 ;
    nltl:personalOrGroupSurvivalEquipmentRequired true ;
    nltl:personsOnBoard 1 ;
    nltl:storageAccessibilityStatus true .

