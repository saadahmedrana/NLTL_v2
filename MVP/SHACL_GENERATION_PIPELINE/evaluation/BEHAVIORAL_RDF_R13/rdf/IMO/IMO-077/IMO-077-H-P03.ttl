@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:additionalEquipmentCapacityRequirement 2 ;
    nltl:additionalEquipmentCarriedInSurvivalCraft false ;
    nltl:launchingApplianceCapacity ex:launchingApplianceCapacityValue ;
    nltl:loadedSurvivalCraftRequirement ex:loadedSurvivalCraftRequirementValue ;
    nltl:personsCapacityRequirement 10 ;
    nltl:survivalCraftAvailableCapacity 0 .

ex:launchingApplianceCapacityValue a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:KiloGM .

ex:loadedSurvivalCraftRequirementValue a qudt:QuantityValue ;
    qudt:numericValue 1200.0 ;
    qudt:unit unit:KiloGM .

