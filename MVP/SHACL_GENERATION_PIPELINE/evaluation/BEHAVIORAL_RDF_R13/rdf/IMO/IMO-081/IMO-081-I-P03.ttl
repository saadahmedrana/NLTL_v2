@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:constructionDate "2016-12-31"^^xsd:date ;
    nltl:echoSoundingDeviceCount 0 ;
    nltl:independentEchoSoundingDeviceCount 0 ;
    nltl:independentTransducerCount 0 ;
    nltl:shipIceStrengthened true .

