@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:connectedToEmergencyPower ex:emergencyPowerSource ;
    nltl:connectedToMainPower ex:mainPowerSource ;
    nltl:gnssCompassOrEquivalentCount 0 ;
    nltl:plannedOrActualLatitude ex:plannedOrActualLatitudeValue .

ex:plannedOrActualLatitudeValue a qudt:QuantityValue ;
    qudt:numericValue 81.0 ;
    qudt:unit unit:DEG .

