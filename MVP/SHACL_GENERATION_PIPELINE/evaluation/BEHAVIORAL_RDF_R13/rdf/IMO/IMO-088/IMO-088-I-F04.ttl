@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-088-I-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:alternateVisualIceDetectionMeansApprovalStatus nltl:evidenceStateApproved ;
    nltl:bridgeControlledRotatableNarrowBeamSearchlightCount 2 ;
    nltl:searchlightCoverageArc ex:searchlightCoverageArcValue .

ex:searchlightCoverageArcValue a qudt:QuantityValue ;
    qudt:numericValue 360.0 ;
    qudt:unit unit:DEG .

