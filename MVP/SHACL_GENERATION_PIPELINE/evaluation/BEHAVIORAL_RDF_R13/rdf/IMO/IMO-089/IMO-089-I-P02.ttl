@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:colregSternLightArcComplianceStatus false ;
    nltl:icebreakerEscortOperation false ;
    nltl:lightVisibleFromAstern false ;
    nltl:manuallyInitiatedFlashingRedStoppedLightPresent false ;
    nltl:visibilityRange ex:visibilityRangeValue .

ex:visibilityRangeValue a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:MI_N .

