@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-091-J-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:aeronauticalFrequencyCapabilityPresent true ;
    nltl:searchAndRescueCoordinationCommunicationPresent false ;
    nltl:twoWayOnSceneCommunicationPresent true .

