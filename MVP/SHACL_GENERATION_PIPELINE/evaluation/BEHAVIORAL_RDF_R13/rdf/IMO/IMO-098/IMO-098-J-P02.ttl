@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-098-J-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasOtherSurvivalCraft ex:other1,
        ex:other2 ;
    nltl:shipOperatesInLowAirTemperature true .

ex:location1 a nltl:locationSignalDevice .

ex:location2 a nltl:locationSignalDevice .

ex:onscene1 a nltl:onSceneCommunicationDevice .

ex:onscene2 a nltl:onSceneCommunicationDevice .

ex:other1 a nltl:otherSurvivalCraft ;
    nltl:hasLocationSignalDevice ex:location1 ;
    nltl:hasOnSceneCommunicationDevice ex:onscene1 .

ex:other2 a nltl:otherSurvivalCraft ;
    nltl:hasLocationSignalDevice ex:location2 ;
    nltl:hasOnSceneCommunicationDevice ex:onscene2 .

