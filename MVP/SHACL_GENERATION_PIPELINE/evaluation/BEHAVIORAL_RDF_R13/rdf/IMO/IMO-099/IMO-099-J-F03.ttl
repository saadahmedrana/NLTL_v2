@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-099-J-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:batteryLifeManagementProcedurePresent true ;
    nltl:communicationDeviceAvailability ex:communicationDeviceAvailabilityValue ;
    nltl:maximumExpectedRescueTime ex:maximumExpectedRescueTimeValue ;
    nltl:procedureImplementationStatus true .

ex:communicationDeviceAvailabilityValue a qudt:QuantityValue ;
    qudt:numericValue 4.9 ;
    qudt:unit unit:DAY .

ex:maximumExpectedRescueTimeValue a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:DAY .

