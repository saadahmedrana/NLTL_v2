@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

ex:ship a nltl:ship ;
    nltl:hasCrewMemberInventory ex:crew ;
    nltl:iceConditionClassification nltl:otherWatersIceCondition ;
    nltl:polarTrainingShipTypeClassification nltl:tankerPolarTrainingShipType .

ex:crew a nltl:crewMember ;
    nltl:polarTrainingCrewRoleClassification nltl:officerInChargeOfNavigationalWatchPolarTrainingRole ;
    nltl:requiredTrainingLevel nltl:basicPolarTrainingLevel .

