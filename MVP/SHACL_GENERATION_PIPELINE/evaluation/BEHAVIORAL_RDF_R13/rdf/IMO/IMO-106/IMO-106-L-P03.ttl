@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:dischargedMaterialClassification ex:otherMaterial ;
    nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable true .

ex:otherMaterial a nltl:dischargedMaterialTypeValue .

