@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:manualPolarCoverage true ;
    nltl:oilRecordBookPolarCoverage true ;
    nltl:polarOperationCoverage true ;
    nltl:pollutionEmergencyPlanPolarCoverage false ;
    nltl:shipOperatesInPolarWaters true .

