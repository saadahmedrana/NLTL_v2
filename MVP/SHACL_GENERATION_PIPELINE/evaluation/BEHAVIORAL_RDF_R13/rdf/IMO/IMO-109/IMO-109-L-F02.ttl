@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:cargoTankCarriesOil true ;
    nltl:constructionDate "2017-01-01"^^xsd:date ;
    nltl:shipCategory nltl:polarShipCategoryA ;
    nltl:shipType "cargo ship other than tanker"^^xsd:string .

