@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:cargoTankCarriesOil true ;
    nltl:cargoTankOuterShellSeparation ex:cargoTankOuterShellSeparationValue ;
    nltl:constructionDate "2017-01-01"^^xsd:date ;
    nltl:shipCategory nltl:polarShipCategoryA ;
    nltl:shipType "oil tanker"^^xsd:string .

ex:cargoTankOuterShellSeparationValue a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:M .

