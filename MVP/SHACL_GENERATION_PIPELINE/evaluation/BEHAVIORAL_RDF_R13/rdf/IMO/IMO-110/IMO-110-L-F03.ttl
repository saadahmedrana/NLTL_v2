@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-110-L-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:constructionDate "2017-01-01"^^xsd:date ;
    nltl:entireCargoTankLengthDoubleBottomProtectionStatus true ;
    nltl:shipCategory nltl:polarShipCategoryA ;
    nltl:shipType "oil tanker"^^xsd:string ;
    nltl:wingTankProtectionStatus true .

