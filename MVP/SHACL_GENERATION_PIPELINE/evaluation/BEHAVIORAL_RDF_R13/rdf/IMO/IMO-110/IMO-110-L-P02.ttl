@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-110-L-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:constructionDate "2017-01-01"^^xsd:date ;
    nltl:deadweight ex:deadweightValue ;
    nltl:entireCargoTankLengthDoubleBottomProtectionStatus true ;
    nltl:shipCategory nltl:polarShipCategoryB ;
    nltl:shipType "oil tanker"^^xsd:string ;
    nltl:wingTankProtectionStatus true .

ex:deadweightValue a qudt:QuantityValue ;
    qudt:numericValue 1000.0 ;
    qudt:unit unit:TON_Metric .

