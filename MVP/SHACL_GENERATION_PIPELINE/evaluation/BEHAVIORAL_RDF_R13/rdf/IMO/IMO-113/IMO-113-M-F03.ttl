@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-113-M-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:cargoRecordBookPolarCoverage true ;
    nltl:manualPolarCoverage true ;
    nltl:noxiousLiquidSubstanceEmergencyPlanPolarCoverage false ;
    nltl:polarOperationCoverage true ;
    nltl:shipOperatesInPolarWaters true .

