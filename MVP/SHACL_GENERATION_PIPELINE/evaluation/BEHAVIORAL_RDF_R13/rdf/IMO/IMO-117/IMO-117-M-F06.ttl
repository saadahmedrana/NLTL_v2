@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F06/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasDischargeDistanceRecord ex:distanceRecord ;
    nltl:marpolAnnexIvRegulation11Point1Point2DischargeComplianceStatus true ;
    nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus nltl:evidenceStateApproved ;
    nltl:marpolCertificationStatus nltl:evidenceStateApproved ;
    nltl:marpolDischargeStatus true ;
    nltl:sewageDischargeUsesTreatmentPlant true ;
    nltl:sewageTreatmentPlantApprovalStatus nltl:evidenceStateApproved .

ex:distanceRecord a nltl:dischargeDistanceRecords ;
    nltl:distanceToNearestLandIceShelfOrFastIce ex:distanceToNearestLandIceShelfOrFastIceValue .

ex:distanceToNearestLandIceShelfOrFastIceValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:MI_N .

