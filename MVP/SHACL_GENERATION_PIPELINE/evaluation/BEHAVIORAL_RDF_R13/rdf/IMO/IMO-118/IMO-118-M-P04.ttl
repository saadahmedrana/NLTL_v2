@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-P04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:constructionDate "2017-01-01"^^xsd:date ;
    nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus false ;
    nltl:sewageDischargeToSea true ;
    nltl:shipCategory nltl:polarShipCategoryC .

