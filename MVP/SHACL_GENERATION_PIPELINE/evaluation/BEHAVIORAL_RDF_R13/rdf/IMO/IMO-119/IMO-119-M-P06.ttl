@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-P06/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:administrationDischargeApprovalStatus nltl:evidenceStateRejected ;
    nltl:approvedSewageTreatmentPlantUsed false ;
    nltl:extendedPeriodOperation true ;
    nltl:iceConcentration ex:iceConcentrationValue ;
    nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus nltl:evidenceStateRejected ;
    nltl:sewageDischargeOccurs true ;
    nltl:shipCategory nltl:polarShipCategoryC .

ex:iceConcentrationValue a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:UNITLESS .

