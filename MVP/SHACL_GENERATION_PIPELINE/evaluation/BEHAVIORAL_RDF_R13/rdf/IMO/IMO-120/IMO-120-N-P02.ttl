@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:arcticWaters "Arctic waters"^^xsd:string ;
    nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ex:distanceFromAreaWithIceConcentrationAboveOneTenthValue ;
    nltl:distanceToNearestLandIceShelfOrFastIce ex:distanceToNearestLandIceShelfOrFastIceValue ;
    nltl:foodWasteDischargeToSea true ;
    nltl:nearbyIceConcentration ex:nearbyIceConcentrationValue ;
    nltl:operatingArea "Arctic waters"^^xsd:string .

ex:distanceFromAreaWithIceConcentrationAboveOneTenthValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:MI_N .

ex:distanceToNearestLandIceShelfOrFastIceValue a qudt:QuantityValue ;
    qudt:numericValue 20.0 ;
    qudt:unit unit:MI_N .

ex:nearbyIceConcentrationValue a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:UNITLESS .

