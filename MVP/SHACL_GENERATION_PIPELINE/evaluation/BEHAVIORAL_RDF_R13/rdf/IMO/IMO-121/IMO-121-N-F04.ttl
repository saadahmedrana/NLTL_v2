@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-121-N-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:contaminatedByOtherGarbage false ;
    nltl:foodWasteComminutedOrGround true ;
    nltl:foodWasteDischargeToSea true .

