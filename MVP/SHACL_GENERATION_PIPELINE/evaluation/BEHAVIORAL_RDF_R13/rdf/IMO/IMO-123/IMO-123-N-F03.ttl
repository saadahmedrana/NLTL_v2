@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:adequateReceptionFacilitiesAvailable false ;
    nltl:departureAndDestinationWithinArctic true ;
    nltl:harmfulSubstancePresent true ;
    nltl:hasDischargeDistanceRecord ex:distanceRecord ;
    nltl:nearbyIceConcentration ex:nearbyIceConcentrationValue ;
    nltl:residueNotRecoverableByCommonMethods true ;
    nltl:routeRemainsWithinArctic true ;
    nltl:shipEnRoute true .

ex:distanceRecord a nltl:dischargeDistanceRecords ;
    nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ex:distanceToAreaWithIceConcentrationGreaterThanOneTenthValue ;
    nltl:distanceToNearestLandIceShelfOrFastIce ex:distanceToNearestLandIceShelfOrFastIceValue .

ex:distanceToAreaWithIceConcentrationGreaterThanOneTenthValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:MI_N .

ex:distanceToNearestLandIceShelfOrFastIceValue a qudt:QuantityValue ;
    qudt:numericValue 12.0 ;
    qudt:unit unit:MI_N .

ex:nearbyIceConcentrationValue a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:UNITLESS .

