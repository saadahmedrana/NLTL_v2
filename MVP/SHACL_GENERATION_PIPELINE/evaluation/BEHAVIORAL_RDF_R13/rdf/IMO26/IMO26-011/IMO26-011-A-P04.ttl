@prefix ex: <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-011-A-P04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:administrationApprovedEquivalentBridgeWingProtectionPresent true ;
    nltl:bridgeWingProtectionDesignStatus true ;
    nltl:bridgeWingsEnclosed true ;
    nltl:constructionDate "2026-01-01"^^xsd:date ;
    nltl:shipCategory nltl:polarShipCategoryA .

