@prefix ex: <https://w3id.org/nltl/benchmark/pilot-02/IMO26-011-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:administrationApprovedEquivalentBridgeWingProtectionPresent false ;
    nltl:bridgeWingProtectionDesignStatus false ;
    nltl:bridgeWingsEnclosed true ;
    nltl:constructionDate "2026-01-01"^^xsd:date ;
    nltl:shipCategory nltl:polarShipCategoryA .

