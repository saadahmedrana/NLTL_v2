@prefix ex: <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:grossTonnage ex:grossTonnageValue .

ex:grossTonnageValue a qudt:QuantityValue ;
    qudt:numericValue 499.0 ;
    qudt:unit unit:UNITLESS .

