@prefix ex: <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-013-A-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:connectedToEmergencyPower ex:emergencyPowerSource ;
    nltl:connectedToMainPower ex:mainPowerSource ;
    nltl:gnssCompassOrEquivalentCount 1 .

