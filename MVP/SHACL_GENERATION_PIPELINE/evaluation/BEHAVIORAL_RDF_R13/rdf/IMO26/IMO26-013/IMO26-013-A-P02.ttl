@prefix ex: <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-013-A-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:gnssCompassOrEquivalentCount 0 ;
    nltl:plannedOrActualLatitude ex:plannedOrActualLatitudeValue .

ex:plannedOrActualLatitudeValue a qudt:QuantityValue ;
    qudt:numericValue 80.0 ;
    qudt:unit unit:DEG .

