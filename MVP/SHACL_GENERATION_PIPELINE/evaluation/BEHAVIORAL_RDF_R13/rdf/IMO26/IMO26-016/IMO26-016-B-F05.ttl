@prefix ex: <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:engagedInTrade false ;
    nltl:lengthOverall ex:lengthOverallValue ;
    nltl:polarCodeChapter11Dash1Applicable true ;
    nltl:shipOperatesInPolarWaters true ;
    nltl:shipType "cargo_ship"^^xsd:string .

ex:lengthOverallValue a qudt:QuantityValue ;
    qudt:numericValue 24.0 ;
    qudt:unit unit:M .

