@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-P04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:applicableIceClassRegulationEdition nltl:iceClassRegulationEdition2008 ;
    nltl:constructionContractDate "2010-01-01"^^xsd:date ;
    nltl:constructionStageDate "2005-01-01"^^xsd:date .

