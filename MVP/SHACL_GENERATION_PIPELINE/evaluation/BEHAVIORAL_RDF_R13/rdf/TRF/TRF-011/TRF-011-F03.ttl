@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasIntendedIceOperatingWaterline ex:intendedLine1 .

ex:i1Point1 a nltl:waterlineProfilePoint ;
    nltl:longitudinalPosition ex:i1X1 ;
    nltl:verticalCoordinate ex:i1Z1 .

ex:i1X1 a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:M .

ex:i1Z1 a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:M .

ex:intendedLine1 a nltl:iceWaterline ;
    nltl:hasWaterlineProfilePoint ex:i1Point1 .

