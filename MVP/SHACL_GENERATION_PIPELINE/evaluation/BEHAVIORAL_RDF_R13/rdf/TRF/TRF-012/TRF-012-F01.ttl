@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intendedLine a nltl:iceWaterline ;
    nltl:hasWaterlineProfilePoint ex:intendedPoint .

ex:ship a nltl:ship ;
    nltl:hasLowerIceWaterline ex:lowerIceWaterline .

ex:intendedPoint a nltl:waterlineProfilePoint ;
    nltl:longitudinalPosition ex:ix ;
    nltl:verticalCoordinate ex:iz .

ex:ix a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:M .

ex:iz a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:M .

ex:lowerIceWaterline a nltl:iceWaterline ;
    nltl:hasWaterlineProfilePoint ex:lowerPoint .

ex:lowerPoint a nltl:waterlineProfilePoint ;
    nltl:longitudinalPosition ex:lx ;
    nltl:verticalCoordinate ex:lz .

ex:lx a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:M .

ex:lz a qudt:QuantityValue ;
    qudt:numericValue 3.5 ;
    qudt:unit unit:M .

