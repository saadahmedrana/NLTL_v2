@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:loadingCalculationSeaWaterSalinity ex:loadingCalculationSeaWaterSalinity ;
    nltl:maximumPermittedIceTrim ex:maximumPermittedIceTrim ;
    nltl:navigatingInIce true ;
    nltl:operatingDraught ex:operatingDraught ;
    nltl:operatingTrim ex:operatingTrim ;
    nltl:upperIceWaterlineDraught ex:upperIceWaterlineDraught .

ex:loadingCalculationSeaWaterSalinity a qudt:QuantityValue ;
    qudt:numericValue 6.0 ;
    qudt:unit nltl:gramPerKilogramSalinityUnit .

ex:maximumPermittedIceTrim a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:M .

ex:operatingDraught a qudt:QuantityValue ;
    qudt:numericValue 5.5 ;
    qudt:unit unit:M .

ex:operatingTrim a qudt:QuantityValue ;
    qudt:numericValue 0.3 ;
    qudt:unit unit:M .

ex:upperIceWaterlineDraught a qudt:QuantityValue ;
    qudt:numericValue 6.0 ;
    qudt:unit unit:M .

