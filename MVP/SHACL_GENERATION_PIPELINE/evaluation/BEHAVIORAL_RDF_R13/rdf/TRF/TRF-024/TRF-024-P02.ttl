@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:assessmentDate "2025-01-01"^^xsd:date ;
    nltl:constructionStageDate "1995-01-01"^^xsd:date ;
    nltl:deliveryDate "2000-06-01"^^xsd:date ;
    nltl:engineOutputComplianceMethod nltl:traficom2017Section3Point2Point4Method ;
    nltl:iceClass nltl:iceClassIaSuper .

