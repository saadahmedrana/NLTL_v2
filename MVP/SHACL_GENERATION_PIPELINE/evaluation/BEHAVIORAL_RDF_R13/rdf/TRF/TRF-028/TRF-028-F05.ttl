@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:calculationEvidence a nltl:alternativeCalculationEvidence .

ex:ship a nltl:ship ;
    nltl:approvalStatus true ;
    nltl:engineOutputCoefficientKe ex:ke .

ex:ke a qudt:QuantityValue ;
    qudt:numericValue 1.95 ;
    qudt:unit unit:UNITLESS .

