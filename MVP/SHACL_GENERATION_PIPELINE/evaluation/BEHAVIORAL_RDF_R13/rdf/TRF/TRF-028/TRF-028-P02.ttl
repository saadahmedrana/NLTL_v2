@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:modelEvidence a nltl:modelTestEvidence .

ex:ship a nltl:ship ;
    nltl:approvalRevocationStatus nltl:evidenceStateApproved ;
    nltl:approvalStatus true ;
    nltl:brashIceChannelResistanceRch ex:rch .

ex:rch a qudt:QuantityValue ;
    qudt:numericValue 120000.0 ;
    qudt:unit unit:N .

