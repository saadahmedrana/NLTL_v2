@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-029-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:directAnalysisApprovalStatus nltl:evidenceStateRejected ;
    nltl:directAnalysisUsed true ;
    nltl:prescribedProcedureApplicability false ;
    nltl:structuralArrangement "non-standard grillage detail"^^xsd:string .

