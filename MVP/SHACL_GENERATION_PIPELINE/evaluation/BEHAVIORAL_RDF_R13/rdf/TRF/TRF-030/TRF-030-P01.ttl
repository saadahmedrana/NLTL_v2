@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasDirectAnalysisCase ex:directAnalysis .

ex:appliedIcePressure a qudt:QuantityValue ;
    qudt:numericValue 2.16 ;
    qudt:unit unit:MegaPA .

ex:directAnalysis a nltl:directAnalysisCase ;
    nltl:appliedIcePressure ex:appliedIcePressure ;
    nltl:capacityMinimizingLoadPositionConfirmed true ;
    nltl:combinedBendingAndShearEvaluated true ;
    nltl:horizontalLoadPosition ex:horizontalLoadPosition ;
    nltl:iceLoadAreaFactorCa ex:iceLoadAreaFactorCa ;
    nltl:icePressure ex:icePressure ;
    nltl:loadLengthDeterminedFromArrangement true ;
    nltl:loadPatchHeight ex:loadPatchHeight ;
    nltl:loadPatchLength ex:loadPatchLength ;
    nltl:verticalLoadPosition ex:verticalLoadPosition .

ex:horizontalLoadPosition a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:M .

ex:iceLoadAreaFactorCa a qudt:QuantityValue ;
    qudt:numericValue 0.7 ;
    qudt:unit unit:UNITLESS .

ex:icePressure a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:MegaPA .

ex:loadPatchHeight a qudt:QuantityValue ;
    qudt:numericValue 0.35 ;
    qudt:unit unit:M .

ex:loadPatchLength a qudt:QuantityValue ;
    qudt:numericValue 0.8 ;
    qudt:unit unit:M .

ex:verticalLoadPosition a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:M .

