@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:member a nltl:iceStringer ;
    nltl:hasEffectiveMemberCrossSection ex:effectiveSection .

ex:ship a nltl:ship .

ex:effectiveSection a nltl:effectiveMemberCrossSection ;
    nltl:sectionModulus ex:sectionModulus ;
    nltl:shearArea ex:shearArea .

ex:sectionModulus a qudt:QuantityValue ;
    qudt:numericValue 2500.0 ;
    qudt:unit unit:CentiM3 .

ex:shearArea a qudt:QuantityValue ;
    qudt:numericValue 0.02 ;
    qudt:unit unit:M2 .

