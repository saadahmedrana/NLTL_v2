@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:classificationSociety "Classification Society"^^xsd:string ;
    nltl:classificationSocietyRuleLength ex:societyRuleLength .

ex:societyRuleLength a qudt:QuantityValue ;
    qudt:numericValue 150.0 ;
    qudt:unit unit:M .

