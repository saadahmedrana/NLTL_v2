@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:designParameters a nltl:iceClassDesignParameterSet ;
    nltl:designIceLoadHeight ex:designIceLoadHeight ;
    nltl:iceClass nltl:iceClassIa ;
    nltl:levelIceThickness ex:levelIceThickness .

ex:ship a nltl:ship .

ex:designIceLoadHeight a qudt:QuantityValue ;
    qudt:numericValue 0.3 ;
    qudt:unit unit:M .

ex:levelIceThickness a qudt:QuantityValue ;
    qudt:numericValue 0.8 ;
    qudt:unit unit:M .

