@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:plating a nltl:plating ;
    nltl:corrosionAbrasionAddition ex:corrosionAbrasionAdditionValue ;
    nltl:icePressure ex:icePressureValue ;
    nltl:longitudinalPlatingFactorF2 ex:longitudinalPlatingFactorF2Value ;
    nltl:platingFramingOrientation nltl:transverseFramingOrientation ;
    nltl:platingPressure ex:platingPressureValue ;
    nltl:requiredShellPlatingThickness ex:requiredShellPlatingThicknessValue ;
    nltl:spacing ex:spacingValue ;
    nltl:transversePlatingFactorF1 ex:transversePlatingFactorF1Value .

ex:corrosionAbrasionAdditionValue a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:MilliM .

ex:icePressureValue a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:MegaPA .

ex:longitudinalPlatingFactorF2Value a qudt:QuantityValue ;
    qudt:numericValue 1.02 ;
    qudt:unit unit:UNITLESS .

ex:platingPressureValue a qudt:QuantityValue ;
    qudt:numericValue 0.9 ;
    qudt:unit unit:MegaPA .

ex:requiredShellPlatingThicknessValue a qudt:QuantityValue ;
    qudt:numericValue 18.0 ;
    qudt:unit unit:MilliM .

ex:spacingValue a qudt:QuantityValue ;
    qudt:numericValue 0.6 ;
    qudt:unit unit:M .

ex:transversePlatingFactorF1Value a qudt:QuantityValue ;
    qudt:numericValue 0.92 ;
    qudt:unit unit:UNITLESS .

