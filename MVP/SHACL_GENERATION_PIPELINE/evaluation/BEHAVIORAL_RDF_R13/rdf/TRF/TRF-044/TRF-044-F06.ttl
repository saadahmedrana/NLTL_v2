@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F06/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:transverseFrame a nltl:transverseFrame ;
    nltl:designIceLoadHeight ex:designIceLoadHeightValue ;
    nltl:frameBoundaryConditionFactorM0 ex:frameBoundaryConditionFactorM0Value ;
    nltl:frameBoundaryConditionType nltl:bulkCarrierTopWingTankFrameCondition ;
    nltl:frameMomentFactorMt ex:frameMomentFactorMtValue ;
    nltl:icePressure ex:icePressureValue ;
    nltl:requiredShearArea ex:requiredShearAreaValue ;
    nltl:sectionModulus ex:sectionModulusValue ;
    nltl:spacing ex:spacingValue ;
    nltl:span ex:spanValue ;
    nltl:yieldStrength ex:yieldStrengthValue .

ex:designIceLoadHeightValue a qudt:QuantityValue ;
    qudt:numericValue 0.35 ;
    qudt:unit unit:M .

ex:frameBoundaryConditionFactorM0Value a qudt:QuantityValue ;
    qudt:numericValue 7.0 ;
    qudt:unit unit:UNITLESS .

ex:frameMomentFactorMtValue a qudt:QuantityValue ;
    qudt:numericValue 7.636363636363636 ;
    qudt:unit unit:UNITLESS .

ex:icePressureValue a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:UNITLESS .

ex:requiredShearAreaValue a qudt:QuantityValue ;
    qudt:numericValue 11.144088600187837 ;
    qudt:unit unit:CentiM2 .

ex:sectionModulusValue a qudt:QuantityValue ;
    qudt:numericValue 421.27659574468083 ;
    qudt:unit unit:CentiM3 .

ex:spacingValue a qudt:QuantityValue ;
    qudt:numericValue 0.6 ;
    qudt:unit unit:M .

ex:spanValue a qudt:QuantityValue ;
    qudt:numericValue 3.0 ;
    qudt:unit unit:M .

ex:yieldStrengthValue a qudt:QuantityValue ;
    qudt:numericValue 235.0 ;
    qudt:unit unit:MegaPA .

