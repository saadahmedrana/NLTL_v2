@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:frame a nltl:frame ;
    nltl:frameSpanWithinIceStrengtheningZone ex:frameSpanWithinIceStrengtheningZoneValue ;
    nltl:ordinaryFrameScantlingsUsed true .

ex:frameSpanWithinIceStrengtheningZoneValue a qudt:QuantityValue ;
    qudt:numericValue 0.4 ;
    qudt:unit unit:M .

