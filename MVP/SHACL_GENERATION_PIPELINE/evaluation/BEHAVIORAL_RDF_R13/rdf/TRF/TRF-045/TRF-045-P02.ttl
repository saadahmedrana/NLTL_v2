@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:frame a nltl:frame ;
    nltl:frameSpanWithinIceStrengtheningZone ex:frameSpanWithinIceStrengtheningZoneValue ;
    nltl:ordinaryFrameScantlingsUsed false ;
    nltl:span ex:spanValue .

ex:frameSpanWithinIceStrengtheningZoneValue a qudt:QuantityValue ;
    qudt:numericValue 0.596 ;
    qudt:unit unit:M .

ex:spanValue a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:M .

