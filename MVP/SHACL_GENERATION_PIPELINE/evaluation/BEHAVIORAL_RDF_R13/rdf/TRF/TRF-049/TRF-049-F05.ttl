@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:frame a nltl:frame ;
    nltl:effectiveAttachmentConfirmed true ;
    nltl:frameWebThickness ex:frameWebThicknessValue ;
    nltl:hasConnectionBracket ex:bracket ;
    nltl:withinIceStrengthenedArea true .

ex:bracket a nltl:connectionBracket ;
    nltl:bracketEdgeStiffened false ;
    nltl:bracketThickness ex:bracketThicknessValue .

ex:bracketThicknessValue a qudt:QuantityValue ;
    qudt:numericValue 12.0 ;
    qudt:unit unit:MilliM .

ex:frameWebThicknessValue a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:MilliM .

