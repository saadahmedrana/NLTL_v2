@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P06/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:frame a nltl:frame ;
    nltl:effectiveAttachmentConfirmed true ;
    nltl:passesThroughSupportingStructure true ;
    nltl:webPlateConnectionSideCount 2 ;
    nltl:withinIceStrengthenedArea true .

