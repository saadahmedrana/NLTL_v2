@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:frame a nltl:frame ;
    nltl:frameAttachment ex:attachmentRecord .

ex:attachmentRecord a nltl:frameAttachmentRecord ;
    nltl:frameShellWeldType nltl:doubleContinuousWeld ;
    nltl:scallopingPresent false ;
    nltl:shellPlateButtCrossing false .

