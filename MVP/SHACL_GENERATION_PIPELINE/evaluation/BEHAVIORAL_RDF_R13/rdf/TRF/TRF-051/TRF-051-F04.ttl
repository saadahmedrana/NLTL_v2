@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-051-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:hullStructure a nltl:hullStructure ;
    nltl:adjacentFrameHeight ex:adjacentFrameHeightValue ;
    nltl:corrosionAbrasionAddition ex:corrosionAbrasionAdditionValue ;
    nltl:frameProfileType nltl:profileSection ;
    nltl:frameWebThickness ex:frameWebThicknessValue ;
    nltl:inLieuOfFrame false ;
    nltl:yieldStrength ex:yieldStrengthValue .

ex:adjacentFrameHeightValue a qudt:QuantityValue ;
    qudt:numericValue 500.0 ;
    qudt:unit unit:MilliM .

ex:corrosionAbrasionAdditionValue a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:MilliM .

ex:frameWebThicknessValue a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:MilliM .

ex:yieldStrengthValue a qudt:QuantityValue ;
    qudt:numericValue 235.0 ;
    qudt:unit unit:MegaPA .

