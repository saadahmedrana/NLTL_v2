@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:frame a nltl:frame ;
    nltl:equivalentSupportStatusByDirectCalculation false ;
    nltl:frameAsymmetrical false ;
    nltl:frameSpan ex:frameSpanValue ;
    nltl:frameWebAngleToShell ex:frameWebAngleToShellValue ;
    nltl:iceClass nltl:iceClassIa .

ex:frameSpanValue a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:M .

ex:frameWebAngleToShellValue a qudt:QuantityValue ;
    qudt:numericValue 90.0 ;
    qudt:unit unit:DEG .

