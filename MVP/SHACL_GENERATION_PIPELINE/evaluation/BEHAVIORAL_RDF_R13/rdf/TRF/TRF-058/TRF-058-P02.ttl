@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:webFrame a nltl:webFrame ;
    nltl:adjustedIceLoadForce ex:adjustedIceLoadForceValue ;
    nltl:iceLoadForce ex:iceLoadForceValue ;
    nltl:stringerOutsideIceBeltHeight ex:stringerOutsideIceBeltHeightValue ;
    nltl:stringerSpan ex:stringerSpanValue .

ex:adjustedIceLoadForceValue a qudt:QuantityValue ;
    qudt:numericValue 500.0 ;
    qudt:unit unit:KiloN .

ex:iceLoadForceValue a qudt:QuantityValue ;
    qudt:numericValue 500.0 ;
    qudt:unit unit:KiloN .

ex:stringerOutsideIceBeltHeightValue a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:M .

ex:stringerSpanValue a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:M .

