@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:webFrame a nltl:webFrame ;
    nltl:freeFlangeToWebAreaRatio ex:freeFlangeToWebAreaRatioValue ;
    nltl:maximumCalculatedShearForce ex:maximumCalculatedShearForceValue ;
    nltl:requiredShearArea ex:requiredShearAreaValue ;
    nltl:webFrameShearFactorAlpha ex:webFrameShearFactorAlphaValue ;
    nltl:yieldStrength ex:yieldStrengthValue .

ex:freeFlangeToWebAreaRatioValue a qudt:QuantityValue ;
    qudt:numericValue 0.2 ;
    qudt:unit unit:UNITLESS .

ex:maximumCalculatedShearForceValue a qudt:QuantityValue ;
    qudt:numericValue 500.0 ;
    qudt:unit unit:KiloN .

ex:requiredShearAreaValue a qudt:QuantityValue ;
    qudt:numericValue 49.860951971078535 ;
    qudt:unit unit:CentiM2 .

ex:webFrameShearFactorAlphaValue a qudt:QuantityValue ;
    qudt:numericValue 1.23 ;
    qudt:unit unit:UNITLESS .

ex:yieldStrengthValue a qudt:QuantityValue ;
    qudt:numericValue 235.0 ;
    qudt:unit unit:MegaPA .

