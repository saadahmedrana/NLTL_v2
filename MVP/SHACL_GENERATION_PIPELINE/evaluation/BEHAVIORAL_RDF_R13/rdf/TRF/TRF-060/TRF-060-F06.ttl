@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F06/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:actualWebFrameCrossSectionalArea ex:actualWebFrameCrossSectionalAreaValue ;
    nltl:hasTableLookupCase ex:lookup ;
    nltl:requiredShearArea ex:requiredShearAreaValue ;
    nltl:sectionModulus ex:sectionModulusValue ;
    nltl:shearArea ex:shearAreaValue ;
    nltl:webFrameFreeFlangeArea ex:webFrameFreeFlangeAreaValue ;
    nltl:webFrameIceLoad ex:webFrameIceLoadValue ;
    nltl:webFrameMaximumIceLoadBendingMoment ex:webFrameMaximumIceLoadBendingMomentValue ;
    nltl:webFrameSpan ex:webFrameSpanValue ;
    nltl:webFrameTable4Dash8GammaFactor ex:webFrameTable4Dash8GammaFactorValue ;
    nltl:webFrameWebArea ex:webFrameWebAreaValue ;
    nltl:yieldStrength ex:yieldStrengthValue .

ex:actualWebFrameCrossSectionalAreaValue a qudt:QuantityValue ;
    qudt:numericValue 300.0 ;
    qudt:unit unit:CentiM2 .

ex:lookup a nltl:tableLookupCase ;
    nltl:lookupSelectionEvidence ex:lookupEvidence ;
    nltl:tableReference nltl:traficomTable4Dash8 .

ex:lookupEvidence a nltl:evidenceArtifact .

ex:requiredShearAreaValue a qudt:QuantityValue ;
    qudt:numericValue 120.0 ;
    qudt:unit unit:CentiM2 .

ex:sectionModulusValue a qudt:QuantityValue ;
    qudt:numericValue 1000.0 ;
    qudt:unit unit:CentiM3 .

ex:shearAreaValue a qudt:QuantityValue ;
    qudt:numericValue 0.02 ;
    qudt:unit unit:M2 .

ex:webFrameFreeFlangeAreaValue a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:CentiM2 .

ex:webFrameIceLoadValue a qudt:QuantityValue ;
    qudt:numericValue 500.0 ;
    qudt:unit unit:KiloN .

ex:webFrameMaximumIceLoadBendingMomentValue a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:MegaN-M .

ex:webFrameSpanValue a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:M .

ex:webFrameTable4Dash8GammaFactorValue a qudt:QuantityValue ;
    qudt:numericValue 0.8 ;
    qudt:unit unit:UNITLESS .

ex:webFrameWebAreaValue a qudt:QuantityValue ;
    qudt:numericValue 200.0 ;
    qudt:unit unit:CentiM2 .

ex:yieldStrengthValue a qudt:QuantityValue ;
    qudt:numericValue 235.0 ;
    qudt:unit unit:MegaPA .

