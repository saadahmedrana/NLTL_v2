@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-062-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:minimumClearance ex:minimumClearanceValue ;
    nltl:propellerBladeTipHullClearance ex:propellerBladeTipHullClearanceValue .

ex:sternFrame a nltl:sternFrame .

ex:minimumClearanceValue a qudt:QuantityValue ;
    qudt:numericValue 0.35 ;
    qudt:unit unit:M .

ex:propellerBladeTipHullClearanceValue a qudt:QuantityValue ;
    qudt:numericValue 0.35 ;
    qudt:unit unit:M .

