@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:envelope a nltl:sidePropellerStrengtheningEnvelope ;
    nltl:strengtheningAftExtent ex:strengtheningAftExtentValue ;
    nltl:strengtheningEnvelopeBoundary ex:boundary ;
    nltl:strengtheningForwardExtent ex:strengtheningForwardExtentValue .

ex:ship a nltl:ship .

ex:boundary a nltl:tankTop .

ex:strengtheningAftExtentValue a qudt:QuantityValue ;
    qudt:numericValue 1.5 ;
    qudt:unit unit:M .

ex:strengtheningForwardExtentValue a qudt:QuantityValue ;
    qudt:numericValue 1.5 ;
    qudt:unit unit:M .

