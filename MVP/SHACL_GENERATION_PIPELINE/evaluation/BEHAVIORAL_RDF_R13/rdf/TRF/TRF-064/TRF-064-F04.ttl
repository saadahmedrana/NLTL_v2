@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

ex:ship a nltl:ship ;
    nltl:hasDetachedStrut ex:detachedStrut ;
    nltl:hasSidePropellerShafting ex:shafting ;
    nltl:hasSternTube ex:sternTube .

ex:attachmentEvidence a nltl:strutHullAttachmentEvidence .

ex:designEvidence a nltl:strutDesignEvidence .

ex:detachedStrut a nltl:detachedStrutStructure ;
    nltl:hasStrutDesignEvidence ex:designEvidence ;
    nltl:hasStrutHullAttachmentEvidence ex:attachmentEvidence .

ex:shaftBossing a nltl:platedBossingStructure .

ex:shafting a nltl:sidePropellerShaftingAssembly ;
    nltl:enclosedByPlatedBossing ex:shaftBossing .

ex:sternTube a nltl:sternTube ;
    nltl:enclosedByPlatedBossing ex:tubeBossing .

ex:tubeBossing a nltl:platedBossingStructure .

