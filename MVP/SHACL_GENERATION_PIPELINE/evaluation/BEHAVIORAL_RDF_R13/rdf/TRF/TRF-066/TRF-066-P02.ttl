@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasRudderProtectionArrangement ex:arrangement ;
    nltl:iceClass nltl:iceClassIaSuper ;
    nltl:iceKnifePracticable false .

ex:arrangement a nltl:equivalentRudderProtectionMeans .

