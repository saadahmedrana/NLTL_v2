@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:designCondition a nltl:designCondition .

ex:ship a nltl:ship ;
    nltl:designConditionLocalStrengthCapacity ex:designConditionLocalStrengthCapacityValue ;
    nltl:localIcePressure ex:localIcePressureValue ;
    nltl:mainPropulsionThruster true ;
    nltl:propellerIceInteractionLoad ex:propellerIceInteractionLoadValue ;
    nltl:thrusterBodyIceInteractionLoad ex:thrusterBodyIceInteractionLoadValue ;
    nltl:thrusterType "azimuthing"^^xsd:string .

ex:designConditionLocalStrengthCapacityValue a qudt:QuantityValue ;
    qudt:numericValue 120.0 ;
    qudt:unit unit:KiloN .

ex:localIcePressureValue a qudt:QuantityValue ;
    qudt:numericValue 5.6 ;
    qudt:unit unit:MegaPA .

ex:propellerIceInteractionLoadValue a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:KiloN .

ex:thrusterBodyIceInteractionLoadValue a qudt:QuantityValue ;
    qudt:numericValue 80.0 ;
    qudt:unit unit:KiloN .

