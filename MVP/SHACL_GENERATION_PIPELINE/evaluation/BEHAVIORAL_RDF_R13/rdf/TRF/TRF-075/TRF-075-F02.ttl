@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

ex:ship a nltl:ship ;
    nltl:hasPropellerBladeLoadCase ex:case .

ex:blade a nltl:propellerBlade .

ex:case a nltl:propellerBladeLoadCase ;
    nltl:propellerBladeLoadCaseBlade ex:blade ;
    nltl:propellerBladeLoadCaseIceBlock ex:iceBlock .

ex:iceBlock a nltl:iceBlock .

