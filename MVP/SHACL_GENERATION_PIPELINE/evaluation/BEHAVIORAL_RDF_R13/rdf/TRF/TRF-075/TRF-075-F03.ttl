@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:blade a nltl:propellerBlade .

ex:ship a nltl:ship ;
    nltl:hasPropellerBladeLoadCase ex:case .

ex:backwardBladeForceValue a qudt:QuantityValue ;
    qudt:numericValue 500.0 ;
    qudt:unit unit:KiloN .

ex:case a nltl:propellerBladeLoadCase ;
    nltl:backwardBladeForce ex:backwardBladeForceValue ;
    nltl:propellerBladeLoadCaseIceBlock ex:iceBlock .

ex:iceBlock a nltl:iceBlock .

