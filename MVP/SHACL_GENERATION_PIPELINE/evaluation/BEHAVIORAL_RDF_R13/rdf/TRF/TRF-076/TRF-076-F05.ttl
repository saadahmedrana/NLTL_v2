@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasPropellerBladeLoadCase ex:case1,
        ex:case2,
        ex:case3,
        ex:case4 ;
    nltl:propellerReversingCapability true ;
    nltl:propellerType "FP"^^xsd:string .

ex:case1 a nltl:propellerBladeLoadCase ;
    nltl:propellerBladeLoadCaseNumber 1 .

ex:case2 a nltl:propellerBladeLoadCase ;
    nltl:propellerBladeLoadCaseNumber 2 .

ex:case3 a nltl:propellerBladeLoadCase ;
    nltl:propellerBladeLoadCaseNumber 3 .

ex:case4 a nltl:propellerBladeLoadCase ;
    nltl:propellerBladeLoadCaseNumber 4 .

