@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasTableLookupCase ex:table6,
        ex:table7 ;
    nltl:iceLoadCycleCoefficientK3 ex:iceLoadCycleCoefficientK3Value ;
    nltl:iceLoadCycleCount 7200000 ;
    nltl:propellerBladeLoadSpectrumCountFactor ex:propellerBladeLoadSpectrumCountFactorValue .

ex:iceLoadCycleCoefficientK3Value a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

ex:propellerBladeLoadSpectrumCountFactorValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

ex:selectedIceClassCycleCountValue a qudt:QuantityValue ;
    qudt:numericValue 9000000.0 ;
    qudt:unit unit:UNITLESS .

ex:selectedPropellerLocationFactorValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

ex:table6 a nltl:tableLookupCase ;
    nltl:iceClass nltl:iceClassIaSuper ;
    nltl:selectedIceClassCycleCount ex:selectedIceClassCycleCountValue ;
    nltl:tableReference nltl:traficomTable6Dash6 .

ex:table7 a nltl:tableLookupCase ;
    nltl:selectedPropellerLocationFactor ex:selectedPropellerLocationFactorValue ;
    nltl:tableLookupPropellerLocation ex:centrePropeller ;
    nltl:tableReference nltl:traficomTable6Dash7 .

