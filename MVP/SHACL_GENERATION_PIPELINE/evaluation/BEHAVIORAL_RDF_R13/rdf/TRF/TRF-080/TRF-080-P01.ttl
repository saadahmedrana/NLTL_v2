@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:effectiveIceLoadCycleCount ex:effectiveIceLoadCycleCountValue ;
    nltl:iceLoadCycleCount 1000 ;
    nltl:propellerBladeCount 4 .

ex:effectiveIceLoadCycleCountValue a qudt:QuantityValue ;
    qudt:numericValue 4000.0 ;
    qudt:unit unit:UNITLESS .

