@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-082-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:bollardThrustKnown true ;
    nltl:hydrodynamicBollardThrust ex:hydrodynamicBollardThrustValue .

ex:hydrodynamicBollardThrustValue a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:KiloN .

