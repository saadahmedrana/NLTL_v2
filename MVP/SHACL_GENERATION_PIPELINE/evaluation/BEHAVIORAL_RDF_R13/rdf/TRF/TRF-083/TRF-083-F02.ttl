@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-083-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasTableLookupCase ex:lookup ;
    nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ex:propellerRotationalSpeedAtMaximumContinuousRatingBollardValue ;
    nltl:rotationalSpeedKnown false .

ex:lookup a nltl:tableLookupCase ;
    nltl:tableLookupApplied true ;
    nltl:tableReference nltl:traficomTable6Dash9 .

ex:propellerRotationalSpeedAtMaximumContinuousRatingBollardValue a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:REV-PER-MIN .

