@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasIceMillingSequenceCase ex:milling .

ex:loadCase a nltl:loadCase ;
    nltl:loadCasePurpose nltl:propulsionLineStrengthEvaluationPurpose .

ex:milling a nltl:iceMillingSequenceCase ;
    nltl:hasPropulsionLoadCase ex:loadCase ;
    nltl:propellerIceMillingLoadSequence "half-sine blade impact sequence"^^xsd:string ;
    nltl:propulsionLineStrengthEvaluation "required"^^xsd:string ;
    nltl:stallingAnalysisPurpose "not intended"^^xsd:string .

