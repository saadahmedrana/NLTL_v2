@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:bladeChordLengthAtWeakestSection ex:bladeChordLengthAtWeakestSectionValue ;
    nltl:bladeCylindricalRootRadius ex:bladeCylindricalRootRadiusValue ;
    nltl:bladeFailureLoadApplicationRadiusRatio ex:bladeFailureLoadApplicationRadiusRatioValue ;
    nltl:bladeFailureUltimateLoad ex:bladeFailureUltimateLoadValue ;
    nltl:bladeMaximumThicknessAtWeakestSection ex:bladeMaximumThicknessAtWeakestSectionValue ;
    nltl:bladeMinimumYieldStrength ex:bladeMinimumYieldStrengthValue ;
    nltl:bladeReferenceStrength1 ex:bladeReferenceStrength1Value ;
    nltl:bladeTipOffset ex:bladeTipOffsetValue ;
    nltl:bladeUltimateTensileStrength ex:bladeUltimateTensileStrengthValue ;
    nltl:propellerDiameter ex:propellerDiameterValue .

ex:bladeChordLengthAtWeakestSectionValue a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:M .

ex:bladeCylindricalRootRadiusValue a qudt:QuantityValue ;
    qudt:numericValue 0.3 ;
    qudt:unit unit:M .

ex:bladeFailureLoadApplicationRadiusRatioValue a qudt:QuantityValue ;
    qudt:numericValue 0.8 ;
    qudt:unit unit:UNITLESS .

ex:bladeFailureUltimateLoadValue a qudt:QuantityValue ;
    qudt:numericValue 155.07692307692307 ;
    qudt:unit unit:KiloN .

ex:bladeMaximumThicknessAtWeakestSectionValue a qudt:QuantityValue ;
    qudt:numericValue 0.08 ;
    qudt:unit unit:M .

ex:bladeMinimumYieldStrengthValue a qudt:QuantityValue ;
    qudt:numericValue 300.0 ;
    qudt:unit unit:MegaPA .

ex:bladeReferenceStrength1Value a qudt:QuantityValue ;
    qudt:numericValue 420.0 ;
    qudt:unit unit:MegaPA .

ex:bladeTipOffsetValue a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:M .

ex:bladeUltimateTensileStrengthValue a qudt:QuantityValue ;
    qudt:numericValue 600.0 ;
    qudt:unit unit:MegaPA .

ex:propellerDiameterValue a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:M .

