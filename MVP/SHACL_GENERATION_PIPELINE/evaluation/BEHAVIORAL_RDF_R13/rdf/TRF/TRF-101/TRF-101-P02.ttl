@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:approvedNonlinearBladeStressAnalysis ex:analysis ;
    nltl:bladeFailureLoadWeakestDirectionConfirmed true ;
    nltl:bladeFailureUltimateLoad ex:bladeFailureUltimateLoadValue .

ex:analysis a nltl:evidenceArtifact .

ex:bladeFailureUltimateLoadValue a qudt:QuantityValue ;
    qudt:numericValue 500.0 ;
    qudt:unit unit:KiloN .

