@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:stressLifeCurveKnown false ;
    nltl:stressLifeCurveSelection ex:otherStressLifeCurve ;
    nltl:stressLifeCurveSelectionCorrespondenceEvidence ex:evidence ;
    nltl:stressLifeCurveType "unknown"^^xsd:string .

ex:evidence a nltl:evidenceArtifact .

