@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasTableLookupCase ex:lookup ;
    nltl:iceLoadCycleCount 5000000 ;
    nltl:propellerType "ducted"^^xsd:string .

ex:fatigueCoefficientC1Value a qudt:QuantityValue ;
    qudt:numericValue 0.000534 ;
    qudt:unit unit:UNITLESS .

ex:fatigueCoefficientC2Value a qudt:QuantityValue ;
    qudt:numericValue 0.0533 ;
    qudt:unit unit:UNITLESS .

ex:fatigueCoefficientC3Value a qudt:QuantityValue ;
    qudt:numericValue -0.0459 ;
    qudt:unit unit:UNITLESS .

ex:fatigueCoefficientC4Value a qudt:QuantityValue ;
    qudt:numericValue 2.584 ;
    qudt:unit unit:UNITLESS .

ex:lookup a nltl:tableLookupCase ;
    nltl:fatigueCoefficientC1 ex:fatigueCoefficientC1Value ;
    nltl:fatigueCoefficientC2 ex:fatigueCoefficientC2Value ;
    nltl:fatigueCoefficientC3 ex:fatigueCoefficientC3Value ;
    nltl:fatigueCoefficientC4 ex:fatigueCoefficientC4Value ;
    nltl:tableReference nltl:traficomTable6Dash14 .

