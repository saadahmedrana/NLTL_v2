@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasThrusterIceImpactLoadCase ex:impact .

ex:areaEvidence a nltl:evidenceArtifact .

ex:geomEvidence a nltl:evidenceArtifact .

ex:iceOperatingSpeedValue a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:KN .

ex:impact a nltl:thrusterIceImpactLoadCase ;
    nltl:contactGeometryClassification nltl:nonHemisphericalContactGeometry ;
    nltl:contactGeometryCorrespondenceEvidence ex:geomEvidence ;
    nltl:designIceBlockTableReference nltl:traficomTable6Dash3Reference ;
    nltl:iceOperatingSpeed ex:iceOperatingSpeedValue ;
    nltl:impactLoadCaseTableReference nltl:traficomTable6Dash16Reference ;
    nltl:thrusterIceImpactDemand ex:thrusterIceImpactDemandValue ;
    nltl:thrusterIceImpactLoad ex:thrusterIceImpactLoadValue ;
    nltl:thrusterIceImpactLoadedAreaEvidence ex:areaEvidence ;
    nltl:thrusterImpactCaseAppliesToBody ex:thrusterBody ;
    nltl:thrusterResistanceCapacity ex:thrusterResistanceCapacityValue .

ex:thrusterBody a nltl:thrusterBody .

ex:thrusterIceImpactDemandValue a qudt:QuantityValue ;
    qudt:numericValue 1000.0 ;
    qudt:unit unit:KiloN .

ex:thrusterIceImpactLoadValue a qudt:QuantityValue ;
    qudt:numericValue 1000.0 ;
    qudt:unit unit:KiloN .

ex:thrusterResistanceCapacityValue a qudt:QuantityValue ;
    qudt:numericValue 1200.0 ;
    qudt:unit unit:KiloN .

