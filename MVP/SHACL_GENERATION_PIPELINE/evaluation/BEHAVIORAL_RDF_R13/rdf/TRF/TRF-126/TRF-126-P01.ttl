@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:airReceiverConsecutiveStartCapacity 12 ;
    nltl:propulsionEngineReversedForAstern true .

