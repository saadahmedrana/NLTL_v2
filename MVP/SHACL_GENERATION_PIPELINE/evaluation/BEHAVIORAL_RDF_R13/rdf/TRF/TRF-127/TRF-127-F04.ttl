@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:airReceiverCapacity ex:airReceiverCapacityValue ;
    nltl:airReceiverServesAdditionalPurpose true .

ex:airReceiverCapacityValue a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:M3 .

