@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:compressorChargeTime ex:compressorChargeTimeValue ;
    nltl:iceClass nltl:iceClassIa ;
    nltl:propulsionEngineReversalRequiredForAstern true .

ex:compressorChargeTimeValue a qudt:QuantityValue ;
    qudt:numericValue 1.01 ;
    qudt:unit unit:HR .

