@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-129-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:coolingWaterSupplySecured true ;
    nltl:iceNavigationCondition "navigating in ice"^^xsd:string .

