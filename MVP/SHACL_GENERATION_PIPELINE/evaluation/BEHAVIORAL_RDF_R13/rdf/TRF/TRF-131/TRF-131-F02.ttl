@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-131-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:ballastWaterCoolingArrangement "reserve ballast-water cooling"^^xsd:string ;
    nltl:reserveCoolingFunction "reserve only"^^xsd:string .

