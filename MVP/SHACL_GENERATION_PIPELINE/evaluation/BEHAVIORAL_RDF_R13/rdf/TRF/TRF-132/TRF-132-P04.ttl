@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-P04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:engineOutputFormulaBasePowerP0 ex:engineOutputFormulaBasePowerP0Value ;
    nltl:engineOutputFormulaDisplacement ex:engineOutputFormulaDisplacementValue ;
    nltl:engineOutputFormulaFactorF1 ex:engineOutputFormulaFactorF1Value ;
    nltl:engineOutputFormulaFactorF2 ex:engineOutputFormulaFactorF2Value ;
    nltl:engineOutputFormulaFactorF3 ex:engineOutputFormulaFactorF3Value ;
    nltl:engineOutputFormulaFactorF4 ex:engineOutputFormulaFactorF4Value ;
    nltl:iceClass nltl:iceClassIa ;
    nltl:maximumContinuousRatingPower ex:maximumContinuousRatingPowerValue .

ex:engineOutputFormulaBasePowerP0Value a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:KiloW .

ex:engineOutputFormulaDisplacementValue a qudt:QuantityValue ;
    qudt:numericValue 10000.0 ;
    qudt:unit unit:TON_Metric .

ex:engineOutputFormulaFactorF1Value a qudt:QuantityValue ;
    qudt:numericValue 0.9 ;
    qudt:unit unit:UNITLESS .

ex:engineOutputFormulaFactorF2Value a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

ex:engineOutputFormulaFactorF3Value a qudt:QuantityValue ;
    qudt:numericValue 1.1 ;
    qudt:unit unit:UNITLESS .

ex:engineOutputFormulaFactorF4Value a qudt:QuantityValue ;
    qudt:numericValue 0.18 ;
    qudt:unit unit:UNITLESS .

ex:maximumContinuousRatingPowerValue a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:KiloW .

