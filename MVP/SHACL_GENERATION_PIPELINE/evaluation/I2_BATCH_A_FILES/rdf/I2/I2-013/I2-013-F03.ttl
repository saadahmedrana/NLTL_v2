@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-a/I2-013-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

ex:other a nltl:structuralMember ;
    nltl:classificationSocietyAccelerationEvidence ex:accEvidence ;
    nltl:inertialLoadDesignConsiderationEvidence ex:inertEvidence .

ex:ship a nltl:ship .

ex:accEvidence a nltl:evidenceArtifact .

ex:inertEvidence a nltl:evidenceArtifact .

