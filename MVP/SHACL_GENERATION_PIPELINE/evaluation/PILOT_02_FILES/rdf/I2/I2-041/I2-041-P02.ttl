@prefix ex: <https://w3id.org/nltl/benchmark/pilot-02/I2-041-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasStructuralMember ex:member1,
        ex:member2 .

ex:member1 a nltl:structuralMember ;
    nltl:netAttachedShellPlateThickness <https://w3id.org/nltl/benchmark/pilot-02/I2-041-P02/member1/netAttachedShellPlateThickness/qv> ;
    nltl:netWebThickness <https://w3id.org/nltl/benchmark/pilot-02/I2-041-P02/member1/netWebThickness/qv> ;
    nltl:yieldStrength <https://w3id.org/nltl/benchmark/pilot-02/I2-041-P02/member1/yieldStrength/qv> .

<https://w3id.org/nltl/benchmark/pilot-02/I2-041-P02/member1/netAttachedShellPlateThickness/qv> a qudt:QuantityValue ;
    qudt:numericValue 12.0 ;
    qudt:unit unit:MilliM .

<https://w3id.org/nltl/benchmark/pilot-02/I2-041-P02/member1/netWebThickness/qv> a qudt:QuantityValue ;
    qudt:numericValue 8.0 ;
    qudt:unit unit:MilliM .

<https://w3id.org/nltl/benchmark/pilot-02/I2-041-P02/member1/yieldStrength/qv> a qudt:QuantityValue ;
    qudt:numericValue 355.0 ;
    qudt:unit unit:MegaPA .

ex:member2 a nltl:structuralMember ;
    nltl:netAttachedShellPlateThickness <https://w3id.org/nltl/benchmark/pilot-02/I2-041-P02/member2/netAttachedShellPlateThickness/qv> ;
    nltl:netWebThickness <https://w3id.org/nltl/benchmark/pilot-02/I2-041-P02/member2/netWebThickness/qv> ;
    nltl:yieldStrength <https://w3id.org/nltl/benchmark/pilot-02/I2-041-P02/member2/yieldStrength/qv> .

<https://w3id.org/nltl/benchmark/pilot-02/I2-041-P02/member2/netAttachedShellPlateThickness/qv> a qudt:QuantityValue ;
    qudt:numericValue 12.0 ;
    qudt:unit unit:MilliM .

<https://w3id.org/nltl/benchmark/pilot-02/I2-041-P02/member2/netWebThickness/qv> a qudt:QuantityValue ;
    qudt:numericValue 8.0 ;
    qudt:unit unit:MilliM .

<https://w3id.org/nltl/benchmark/pilot-02/I2-041-P02/member2/yieldStrength/qv> a qudt:QuantityValue ;
    qudt:numericValue 355.0 ;
    qudt:unit unit:MegaPA .

