@prefix ex: <https://w3id.org/nltl/benchmark/pilot-02/I2-046-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasInternalIceStrengthenedStructure ex:internal1 ;
    nltl:polarClass nltl:polarClassPc3 ;
    nltl:polarClassRequirementsApplicable true .

ex:internal1 a nltl:internalIceStrengthenedStructure .

