@prefix ex: <https://w3id.org/nltl/benchmark/pilot-02/I2-047-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:gaugedThickness <https://w3id.org/nltl/benchmark/pilot-02/I2-047-P03/ship/gaugedThickness/qv> ;
    nltl:netThickness <https://w3id.org/nltl/benchmark/pilot-02/I2-047-P03/ship/netThickness/qv> ;
    nltl:steelRenewalRequired true .

<https://w3id.org/nltl/benchmark/pilot-02/I2-047-P03/ship/gaugedThickness/qv> a qudt:QuantityValue ;
    qudt:numericValue 0.0104 ;
    qudt:unit unit:M .

<https://w3id.org/nltl/benchmark/pilot-02/I2-047-P03/ship/netThickness/qv> a qudt:QuantityValue ;
    qudt:numericValue 0.01 ;
    qudt:unit unit:M .

