@prefix ex: <https://w3id.org/nltl/benchmark/pilot-02/I2-048-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasSteelGradeRequirementCase ex:case ;
    nltl:polarClass nltl:polarClassPc5 .

ex:case a nltl:steelGradeRequirementCase ;
    nltl:actualHullStructuralSteelGrade nltl:steelGradeAh ;
    nltl:requiredHullStructuralSteelGrade nltl:steelGradeEh ;
    nltl:steelGradeRequirementCasePlating ex:plating ;
    nltl:steelMaterialClass nltl:steelMaterialClassThree ;
    nltl:steelStrengthCategory nltl:highTensileSteelCategory ;
    nltl:tableReference nltl:iacsUrI2Table8 .

ex:plating a nltl:plating ;
    nltl:asBuiltPlateThickness <https://w3id.org/nltl/benchmark/pilot-02/I2-048-F01/plating/asBuiltPlateThickness/qv> .

<https://w3id.org/nltl/benchmark/pilot-02/I2-048-F01/plating/asBuiltPlateThickness/qv> a qudt:QuantityValue ;
    qudt:numericValue 32.0 ;
    qudt:unit unit:MilliM .

