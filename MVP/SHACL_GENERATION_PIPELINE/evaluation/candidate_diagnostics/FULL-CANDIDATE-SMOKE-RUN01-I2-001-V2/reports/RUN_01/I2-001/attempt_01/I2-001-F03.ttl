@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-001-F03/ship> ;
            sh:resultMessage "Ships contracted for construction on or after 1 January 2021 must have UR I2 revision applicability true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Ships contracted for construction on or after 1 January 2021 must have UR I2 revision applicability true." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:constructionContractDate ?date .
                FILTER (?date >= "2021-01-01"^^xsd:date)
                FILTER NOT EXISTS {
                    $this nltl:urI2RevisionApplicability true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-001> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-001-F03/ship> ] .

