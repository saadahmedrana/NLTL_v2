@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-001-F02/ship> ;
            sh:resultMessage "Ships contracted for construction before 1 January 2021 must not be marked as subject to the UR I2 revision." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Ships contracted for construction before 1 January 2021 must not be marked as subject to the UR I2 revision." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:constructionContractDate ?date ;
                      nltl:urI2RevisionApplicability true .
                FILTER (?date < "2021-01-01"^^xsd:date)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-001> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-001-F02/ship> ] .

