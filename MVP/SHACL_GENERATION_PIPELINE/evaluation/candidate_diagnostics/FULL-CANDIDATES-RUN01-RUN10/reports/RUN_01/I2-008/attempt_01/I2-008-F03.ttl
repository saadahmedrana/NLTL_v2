@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F03/ship> ;
            sh:resultMessage "Shape coefficient input is required as a dimensionless quantity." ;
            sh:resultPath nltl:shapeCoefficient ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Shape coefficient input is required as a dimensionless quantity." ;
                    sh:minCount 1 ;
                    sh:node gen:DimensionlessQuantityShape ;
                    sh:path nltl:shapeCoefficient ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F03/ship> ;
            sh:resultMessage "Line load input is required with the specified line-load unit." ;
            sh:resultPath nltl:lineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Line load input is required with the specified line-load unit." ;
                    sh:minCount 1 ;
                    sh:node gen:LineLoadQuantityShape ;
                    sh:path nltl:lineLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F03/ship> ;
            sh:resultMessage "A valid Polar Class value is required to establish applicability." ;
            sh:resultPath nltl:polarClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:polarClassPc1 nltl:polarClassPc2 nltl:polarClassPc3 nltl:polarClassPc4 nltl:polarClassPc5 nltl:polarClassPc6 nltl:polarClassPc7 ) ;
                    sh:message "A valid Polar Class value is required to establish applicability." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarClass ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F03/polarClass> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F03/bowCase> ;
                    sh:resultMessage "Each bow subregion case requires an externally calculated glancing impact line load." ;
                    sh:resultPath nltl:glancingImpactLineLoad ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each bow subregion case requires an externally calculated glancing impact line load." ;
                            sh:minCount 1 ;
                            sh:node gen:LineLoadQuantityShape ;
                            sh:path nltl:glancingImpactLineLoad ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F03/ship> ;
            sh:resultMessage "At least one bow subregion calculation case with required calculated characteristics is required." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "At least one bow subregion calculation case with required calculated characteristics is required." ;
                    sh:minCount 1 ;
                    sh:node gen:BowSubregionCalculationCaseShape ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F03/bowCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F03/ship> ;
            sh:resultMessage "Load patch height input is required with metre units." ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Load patch height input is required with metre units." ;
                    sh:minCount 1 ;
                    sh:node gen:LengthQuantityShape ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F03/ship> ;
            sh:resultMessage "The externally calculated total glancing impact force is required with force units." ;
            sh:resultPath nltl:totalGlancingImpactForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The externally calculated total glancing impact force is required with force units." ;
                    sh:minCount 1 ;
                    sh:node gen:ForceQuantityShape ;
                    sh:path nltl:totalGlancingImpactForce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F03/ship> ;
            sh:resultMessage "Local ice pressure input is required with pressure units." ;
            sh:resultPath nltl:localIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Local ice pressure input is required with pressure units." ;
                    sh:minCount 1 ;
                    sh:node gen:PressureQuantityShape ;
                    sh:path nltl:localIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F03/ship> ;
            sh:resultMessage "Average ice pressure input is required with pressure units." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Average ice pressure input is required with pressure units." ;
                    sh:minCount 1 ;
                    sh:node gen:PressureQuantityShape ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F03/ship> ;
            sh:resultMessage "Load patch length input is required with metre units." ;
            sh:resultPath nltl:loadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Load patch length input is required with metre units." ;
                    sh:minCount 1 ;
                    sh:node gen:LengthQuantityShape ;
                    sh:path nltl:loadPatchLength ] ] .

