@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F01/ship> ;
            sh:resultMessage "The ship must identify a Polar Class to establish applicability of the design ice-force rule." ;
            sh:resultPath nltl:polarClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype nltl:polarClassValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship must identify a Polar Class to establish applicability of the design ice-force rule." ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:in ( nltl:polarClassPc1 nltl:polarClassPc2 nltl:polarClassPc3 nltl:polarClassPc4 nltl:polarClassPc5 ) ] [ sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ] ) ;
                    sh:path nltl:polarClass ] ;
            sh:value nltl:polarClassPc5 ] .

