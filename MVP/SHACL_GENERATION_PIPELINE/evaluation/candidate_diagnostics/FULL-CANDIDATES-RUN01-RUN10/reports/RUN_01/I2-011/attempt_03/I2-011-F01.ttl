@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:node gen:I2_011_ApplicableShape ] , [ sh:node gen:I2_011_BulbousBowAbsentShape ] , [ sh:node gen:I2_011_NonPc6Pc7Shape ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_011_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F01/ship> ] .

