@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F02/ship> ;
            sh:resultMessage "The bow region must be divided into four sub-regions." ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:maxInclusive 4 ;
                    sh:message "The bow region must be divided into four sub-regions." ;
                    sh:minCount 1 ;
                    sh:minInclusive 4 ;
                    sh:path nltl:bowSubregionCount ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F02/ship> ;
            sh:resultMessage "The ship must provide its bow length in metres." ;
            sh:resultPath nltl:bowLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide its bow length in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:bowLength ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F02/subregion3> ;
                    sh:resultMessage "Each bow sub-region calculation case must have calculation evidence." ;
                    sh:resultPath nltl:bowSubregionCalculationEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:maxCount 1 ;
                            sh:message "Each bow sub-region calculation case must have calculation evidence." ;
                            sh:minCount 1 ;
                            sh:path nltl:bowSubregionCalculationEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F02/ship> ;
            sh:resultMessage "The ship must provide exactly four bow sub-region calculation cases." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 4 ;
                    sh:message "The ship must provide exactly four bow sub-region calculation cases." ;
                    sh:minCount 4 ;
                    sh:node [ sh:class nltl:bowSubregionCalculationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "Each bow sub-region must report its calculated line load in MN/m." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:MegaN-M-PER-M2 ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:bowSubregionCalculatedLineLoad ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each bow sub-region must report its calculated pressure in MPa." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:MegaPA ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:bowSubregionCalculatedPressure ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each bow sub-region must provide its mid-length position in metres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:bowSubregionMidLengthPosition ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each bow sub-region must provide its load patch aspect ratio." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:bowSubregionAspectRatio ],
                                [ sh:class nltl:evidenceArtifact ;
                                    sh:maxCount 1 ;
                                    sh:message "Each bow sub-region calculation case must have calculation evidence." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:bowSubregionCalculationEvidence ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each bow sub-region must report its calculated force in MN." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:MegaN ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:bowSubregionCalculatedForce ] ] ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F02/subregion3> ] .

