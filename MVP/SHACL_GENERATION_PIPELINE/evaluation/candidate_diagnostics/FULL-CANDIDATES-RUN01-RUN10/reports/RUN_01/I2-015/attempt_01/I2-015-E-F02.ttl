@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F02/ship> ;
            sh:resultMessage "Each ship must provide one beta i prime dimensionless quantity." ;
            sh:resultPath nltl:betaIPrime ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ship must provide one beta i prime dimensionless quantity." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-015-DimensionlessQuantityShape> ;
                    sh:path nltl:betaIPrime ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F02/ship> ;
            sh:resultMessage "Each ship must provide one upper ice waterline length in metres." ;
            sh:resultPath nltl:upperIceWaterlineLengthLUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ship must provide one upper ice waterline length in metres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-015-LengthQuantityShape> ;
                    sh:path nltl:upperIceWaterlineLengthLUI ] ] .

