@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/ship> ;
            sh:resultMessage "Each ship must provide one beta i prime dimensionless quantity." ;
            sh:resultPath nltl:betaIPrime ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ship must provide one beta i prime dimensionless quantity." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-015-DimensionlessQuantityShape> ;
                    sh:path nltl:betaIPrime ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/factorLookup> ;
                            sh:resultMessage "The failure-class-factor lookup case must provide the crushing failure class factor." ;
                            sh:resultPath nltl:crushingFailureClassFactor ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "The failure-class-factor lookup case must provide the crushing failure class factor." ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:I2-015-DimensionlessQuantityShape> ;
                                    sh:path nltl:crushingFailureClassFactor ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/bowCase> ;
                    sh:resultMessage "The applicable bow calculation case must provide a failure-class-factor lookup case." ;
                    sh:resultPath nltl:hasFailureClassFactorLookupCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "The applicable bow calculation case must provide a failure-class-factor lookup case." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-015-FactorLookupShape> ;
                            sh:path nltl:hasFailureClassFactorLookupCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/factorLookup> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/ship> ;
            sh:resultMessage "The ship must provide an applicable bow subregion calculation case." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide an applicable bow subregion calculation case." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-015-BowCaseShape> ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/bowCase> ] .

