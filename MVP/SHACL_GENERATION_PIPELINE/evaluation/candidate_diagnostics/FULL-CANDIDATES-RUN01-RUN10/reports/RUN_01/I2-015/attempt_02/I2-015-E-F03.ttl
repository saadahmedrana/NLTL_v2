@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/bowCase> ;
            sh:resultMessage "The bow subregion calculation case must provide D_UI in metres." ;
            sh:resultPath nltl:upperIceWaterlineDraughtDUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n1f681ba784d0408ba2bbd7848a0ab900b11 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/bowCase> ;
                    sh:resultMessage "The bow subregion calculation case must provide D_UI in metres." ;
                    sh:resultPath nltl:upperIceWaterlineDraughtDUI ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n1f681ba784d0408ba2bbd7848a0ab900b11 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/bowCase> ;
                    sh:resultMessage "The bow subregion calculation case must provide alpha_i in degrees." ;
                    sh:resultPath nltl:bowSubregionWaterlineAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n1f681ba784d0408ba2bbd7848a0ab900b12 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/bowCase> ;
                    sh:resultMessage "The bow subregion calculation case must provide L_UI in metres." ;
                    sh:resultPath nltl:upperIceWaterlineLengthLUI ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n1f681ba784d0408ba2bbd7848a0ab900b10 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:BowSubregionCalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:BowSubregionCalculationCaseShape ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/bowCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/bowCase> ;
            sh:resultMessage "The bow subregion calculation case must provide alpha_i in degrees." ;
            sh:resultPath nltl:bowSubregionWaterlineAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n1f681ba784d0408ba2bbd7848a0ab900b12 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/bowCase> ;
            sh:resultMessage "The bow subregion calculation case must provide L_UI in metres." ;
            sh:resultPath nltl:upperIceWaterlineLengthLUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n1f681ba784d0408ba2bbd7848a0ab900b10 ] .

_:n1f681ba784d0408ba2bbd7848a0ab900b10 sh:maxCount 1 ;
    sh:message "The bow subregion calculation case must provide L_UI in metres." ;
    sh:minCount 1 ;
    sh:node gen:LengthMetresQuantityShape ;
    sh:path nltl:upperIceWaterlineLengthLUI .

_:n1f681ba784d0408ba2bbd7848a0ab900b11 sh:maxCount 1 ;
    sh:message "The bow subregion calculation case must provide D_UI in metres." ;
    sh:minCount 1 ;
    sh:node gen:LengthMetresQuantityShape ;
    sh:path nltl:upperIceWaterlineDraughtDUI .

_:n1f681ba784d0408ba2bbd7848a0ab900b12 sh:maxCount 1 ;
    sh:message "The bow subregion calculation case must provide alpha_i in degrees." ;
    sh:minCount 1 ;
    sh:node gen:AngleDegreesQuantityShape ;
    sh:path nltl:bowSubregionWaterlineAngle .

