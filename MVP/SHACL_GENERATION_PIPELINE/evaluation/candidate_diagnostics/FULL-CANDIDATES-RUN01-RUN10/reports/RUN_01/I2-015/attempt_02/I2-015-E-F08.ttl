@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/bowCase> ;
            sh:resultMessage "The bow subregion calculation case must provide L_UI in metres." ;
            sh:resultPath nltl:upperIceWaterlineLengthLUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The bow subregion calculation case must provide L_UI in metres." ;
                    sh:minCount 1 ;
                    sh:node gen:LengthMetresQuantityShape ;
                    sh:path nltl:upperIceWaterlineLengthLUI ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/bowCase> ;
            sh:resultMessage "The bow subregion calculation case must provide D_UI in metres." ;
            sh:resultPath nltl:upperIceWaterlineDraughtDUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The bow subregion calculation case must provide D_UI in metres." ;
                    sh:minCount 1 ;
                    sh:node gen:LengthMetresQuantityShape ;
                    sh:path nltl:upperIceWaterlineDraughtDUI ] ] .

