@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F02/ship> ;
            sh:resultMessage "For an I2.3.1(v) bow form, the ship shall provide exactly one valid upper ice waterline length, upper ice waterline draught, and beta i prime quantity with the declared units." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an I2.3.1(v) bow form, the ship shall provide exactly one valid upper ice waterline length, upper ice waterline draught, and beta i prime quantity with the declared units." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowFormApplicabilityClassification nltl:i231vBowFormApplicability .
                FILTER (
                    NOT EXISTS {
                        $this nltl:upperIceWaterlineLengthLUI ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (datatype(?v) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        $this nltl:upperIceWaterlineLengthLUI ?q1 .
                        $this nltl:upperIceWaterlineLengthLUI ?q2 .
                        FILTER (?q1 != ?q2)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:upperIceWaterlineDraughtDUI ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (datatype(?v) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        $this nltl:upperIceWaterlineDraughtDUI ?q1 .
                        $this nltl:upperIceWaterlineDraughtDUI ?q2 .
                        FILTER (?q1 != ?q2)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:betaIPrime ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (datatype(?v) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        $this nltl:betaIPrime ?q1 .
                        $this nltl:betaIPrime ?q2 .
                        FILTER (?q1 != ?q2)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_015_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F02/ship> ] .

