@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An applicable bow calculation requires exactly one beta i prime quantity with unitless units.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:betaIPrime ], [ sh:datatype qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An applicable bow calculation requires exactly one upper ice waterline draught quantity in metres.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:upperIceWaterlineDraughtDUI ], [ sh:datatype qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An applicable bow calculation requires exactly one upper ice waterline length quantity in metres.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:upperIceWaterlineLengthLUI ], [ sh:message Literal("An I2.3.1(v) bow form requires a complete externally calculated bow subregion readiness record, including operands, failure-factor lookup inputs, and the resulting shape coefficient.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:bowSubregionCalculationCase ; sh:property [ sh:hasValue nltl:i231vBowFormApplicability ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bowFormApplicabilityClassification ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:tableLookupCase ; sh:property [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property <http://recursion.too.deep>, <http://recursion.too.deep> ] ; sh:path nltl:crushingFailureClassFactor ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property <http://recursion.too.deep>, <http://recursion.too.deep> ] ; sh:path nltl:flexuralFailureClassFactor ] ] ; sh:path nltl:hasFailureClassFactorLookupCase ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:bowSubregionWaterlineAngle ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:bowSubregionMidLengthPosition ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:bowShapeCoefficient ] ] ; sh:path nltl:hasBowSubregionCalculationCase ] ] , [ sh:property [ sh:message Literal("A non-applicable bow case must contain an explicit applicability classification distinct from the I2.3.1(v) bow form.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:bowSubregionCalculationCase ; sh:property [ sh:class nltl:bowFormApplicabilityValue ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bowFormApplicabilityClassification ] ; sh:sparql [ sh:message Literal("A non-applicable bow case must not be classified as the I2.3.1(v) bow form.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            SELECT $this
                            WHERE {
                                $this nltl:bowFormApplicabilityClassification
                                      nltl:i231vBowFormApplicability .
                            }
                        ") ] ] ; sh:path nltl:hasBowSubregionCalculationCase ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-015-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/ship> ] .

