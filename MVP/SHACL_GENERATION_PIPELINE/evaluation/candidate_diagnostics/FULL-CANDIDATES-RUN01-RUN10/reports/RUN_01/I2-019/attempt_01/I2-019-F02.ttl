@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/member> ;
                    sh:resultMessage "selectedHullAreaFactor must equal the largest hullAreaFactor among the structural member's spanned hull areas." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "selectedHullAreaFactor must equal the largest hullAreaFactor among the structural member's spanned hull areas." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasSpannedHullArea ?area ;
                      nltl:selectedHullAreaFactor ?selected .

                ?area nltl:hullAreaFactor ?factorValue .
                ?factorValue <http://qudt.org/schema/qudt/numericValue> ?factor .

                ?selected <http://qudt.org/schema/qudt/numericValue> ?selectedFactor .

                FILTER NOT EXISTS {
                    $this nltl:hasSpannedHullArea ?higherArea .
                    ?higherArea nltl:hullAreaFactor ?higherFactorValue .
                    ?higherFactorValue <http://qudt.org/schema/qudt/numericValue> ?higherFactor .
                    FILTER (?higherFactor > ?factor)
                }

                FILTER (
                    ABS(?selectedFactor - ?factor) >
                    (ABS(?factor) * 0.000001 + 0.000000001)
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/member> ] .

