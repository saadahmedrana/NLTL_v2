@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F03/member> ;
                    sh:resultMessage """Node ex:member must conform to one or more shapes in [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:selectedHullAreaFactor ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:hullAreaValue ; sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:hullAreaFactor ] ] ; sh:path nltl:hasSpannedHullArea ] ; sh:sparql [ sh:message Literal("selectedHullAreaFactor must equal the largest hullAreaFactor among the structural member's spanned hull areas.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                {
                                    SELECT $this (MAX(?factor) AS ?expectedMax)
                                    WHERE {
                                        $this nltl:hasSpannedHullArea ?area .
                                        ?area nltl:hullAreaFactor ?factorNode .
                                        ?factorNode qudt:numericValue ?factor .
                                    }
                                    GROUP BY $this
                                }
                                $this nltl:selectedHullAreaFactor ?selectedNode .
                                ?selectedNode qudt:numericValue ?selected .
                                BIND(IF(?expectedMax >= 0,
                                        ?expectedMax,
                                        -?expectedMax) AS ?scale)
                                BIND((0.000001 * ?scale + 0.000000000001) AS ?tolerance)
                                FILTER (
                                    ?selected > (?expectedMax + ?tolerance) ||
                                    ?selected < (?expectedMax - ?tolerance)
                                )
                            }
                        ") ] ] , [ sh:property [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:path nltl:hasSpannedHullArea ] ]""" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:structuralMember ;
                            sh:or ( [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class qudt:QuantityValue ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:selectedHullAreaFactor ],
                                            [ sh:minCount 1 ;
                                                sh:node [ sh:class nltl:hullAreaValue ;
                                                        sh:property [ ] ] ;
                                                sh:path nltl:hasSpannedHullArea ] ;
                                        sh:sparql [ sh:message "selectedHullAreaFactor must equal the largest hullAreaFactor among the structural member's spanned hull areas." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                {
                                    SELECT $this (MAX(?factor) AS ?expectedMax)
                                    WHERE {
                                        $this nltl:hasSpannedHullArea ?area .
                                        ?area nltl:hullAreaFactor ?factorNode .
                                        ?factorNode qudt:numericValue ?factor .
                                    }
                                    GROUP BY $this
                                }
                                $this nltl:selectedHullAreaFactor ?selectedNode .
                                ?selectedNode qudt:numericValue ?selected .
                                BIND(IF(?expectedMax >= 0,
                                        ?expectedMax,
                                        -?expectedMax) AS ?scale)
                                BIND((0.000001 * ?scale + 0.000000000001) AS ?tolerance)
                                FILTER (
                                    ?selected > (?expectedMax + ?tolerance) ||
                                    ?selected < (?expectedMax - ?tolerance)
                                )
                            }
                        """ ] ] [ sh:property [ sh:maxCount 0 ;
                                                sh:path nltl:hasSpannedHullArea ] ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F03/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F03/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:class nltl:structuralMember ; sh:or ( [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:selectedHullAreaFactor ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:hullAreaValue ; sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:hullAreaFactor ] ] ; sh:path nltl:hasSpannedHullArea ] ; sh:sparql [ sh:message Literal("selectedHullAreaFactor must equal the largest hullAreaFactor among the structural member's spanned hull areas.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                {
                                    SELECT $this (MAX(?factor) AS ?expectedMax)
                                    WHERE {
                                        $this nltl:hasSpannedHullArea ?area .
                                        ?area nltl:hullAreaFactor ?factorNode .
                                        ?factorNode qudt:numericValue ?factor .
                                    }
                                    GROUP BY $this
                                }
                                $this nltl:selectedHullAreaFactor ?selectedNode .
                                ?selectedNode qudt:numericValue ?selected .
                                BIND(IF(?expectedMax >= 0,
                                        ?expectedMax,
                                        -?expectedMax) AS ?scale)
                                BIND((0.000001 * ?scale + 0.000000000001) AS ?tolerance)
                                FILTER (
                                    ?selected > (?expectedMax + ?tolerance) ||
                                    ?selected < (?expectedMax - ?tolerance)
                                )
                            }
                        ") ] ] [ sh:property [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:path nltl:hasSpannedHullArea ] ] ) ]. See details for more information.""" ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:structuralMember ;
                            sh:or ( [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:selectedHullAreaFactor ],
                                            [ sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:hasSpannedHullArea ] ;
                                        sh:sparql [ sh:message "selectedHullAreaFactor must equal the largest hullAreaFactor among the structural member's spanned hull areas." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                {
                                    SELECT $this (MAX(?factor) AS ?expectedMax)
                                    WHERE {
                                        $this nltl:hasSpannedHullArea ?area .
                                        ?area nltl:hullAreaFactor ?factorNode .
                                        ?factorNode qudt:numericValue ?factor .
                                    }
                                    GROUP BY $this
                                }
                                $this nltl:selectedHullAreaFactor ?selectedNode .
                                ?selectedNode qudt:numericValue ?selected .
                                BIND(IF(?expectedMax >= 0,
                                        ?expectedMax,
                                        -?expectedMax) AS ?scale)
                                BIND((0.000001 * ?scale + 0.000000000001) AS ?tolerance)
                                FILTER (
                                    ?selected > (?expectedMax + ?tolerance) ||
                                    ?selected < (?expectedMax - ?tolerance)
                                )
                            }
                        """ ] ] [ sh:property [ sh:maxCount 0 ;
                                                sh:path nltl:hasSpannedHullArea ] ] ) ] ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F03/member> ] .

