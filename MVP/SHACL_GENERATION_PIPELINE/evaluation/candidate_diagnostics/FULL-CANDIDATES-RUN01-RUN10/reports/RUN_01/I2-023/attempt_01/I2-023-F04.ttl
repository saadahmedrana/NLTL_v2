@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/ship> ;
            sh:resultMessage "Frame span is required in metres." ;
            sh:resultPath nltl:frameSpan ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Frame span is required in metres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-023-LengthQuantityShape> ;
                    sh:path nltl:frameSpan ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/member> ;
                            sh:resultMessage "The selected hull area factor is required as a dimensionless quantity." ;
                            sh:resultPath nltl:selectedHullAreaFactor ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "The selected hull area factor is required as a dimensionless quantity." ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:I2-023-DimensionlessQuantityShape> ;
                                    sh:path nltl:selectedHullAreaFactor ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/plating> ;
                    sh:resultMessage "A supporting structural-member relationship is required to establish the calculation model." ;
                    sh:resultPath nltl:platingSupportedByStructuralMember ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:structuralMember ;
                            sh:message "A supporting structural-member relationship is required to establish the calculation model." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-023-StructuralMemberShape> ;
                            sh:path nltl:platingSupportedByStructuralMember ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/ship> ;
            sh:resultMessage "A plating relationship is required to establish the calculation model." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:plating ;
                    sh:message "A plating relationship is required to establish the calculation model." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-023-PlatingShape> ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/ship> ;
            sh:resultMessage "Average ice pressure is required in MPa." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Average ice pressure is required in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-023-PressureQuantityShape> ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/ship> ;
            sh:resultMessage "Peak pressure factor is required as a dimensionless quantity." ;
            sh:resultPath nltl:peakPressureFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Peak pressure factor is required as a dimensionless quantity." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-023-DimensionlessQuantityShape> ;
                    sh:path nltl:peakPressureFactor ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/ship> ;
            sh:resultMessage "Yield strength is required in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Yield strength is required in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-023-PressureQuantityShape> ;
                    sh:path nltl:yieldStrength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/ship> ;
            sh:resultMessage "Load patch height is required in metres." ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Load patch height is required in metres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-023-LengthQuantityShape> ;
                    sh:path nltl:loadPatchHeight ] ] .

