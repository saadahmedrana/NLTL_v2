@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/ship> ;
            sh:resultMessage "A calculation case with the declared interpolation inputs is required." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A calculation case with the declared interpolation inputs is required." ;
                    sh:minCount 1 ;
                    sh:node gs:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/case> ;
                    sh:resultMessage "The framing angle must be present and strictly between 20 and 70 degrees." ;
                    sh:resultPath nltl:framingAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The framing angle must be present and strictly between 20 and 70 degrees." ;
                            sh:minCount 1 ;
                            sh:node gs:FramingAngleQuantityShape ;
                            sh:path nltl:framingAngle ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/ship> ;
            sh:resultMessage "Each represented oblique plating interpolation case must contain the applicable angle, endpoints, operands, and result." ;
            sh:resultPath nltl:hasObliquePlatingInterpolationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each represented oblique plating interpolation case must contain the applicable angle, endpoints, operands, and result." ;
                    sh:node gs:ObliquePlatingInterpolationCaseShape ;
                    sh:path nltl:hasObliquePlatingInterpolationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/case> ] .

