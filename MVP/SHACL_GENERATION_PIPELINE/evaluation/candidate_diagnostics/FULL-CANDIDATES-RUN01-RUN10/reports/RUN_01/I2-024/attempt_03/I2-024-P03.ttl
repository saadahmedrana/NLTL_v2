@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/upperEndpoint> ;
            sh:resultMessage "Less than 1 values on ex:upperEndpoint->nltl:interpolationPointResult" ;
            sh:resultPath nltl:interpolationPointResult ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nbbd9af6e226e45c48666e865639eb8ceb62 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/upperEndpoint> ;
            sh:resultMessage "Less than 1 values on ex:upperEndpoint->nltl:interpolationPointCoordinate" ;
            sh:resultPath nltl:interpolationPointCoordinate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nbbd9af6e226e45c48666e865639eb8ceb58 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasCalculationCase" ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:transverseFramingNetPlateThickness ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:longitudinalFramingNetPlateThickness ] ] ;
                    sh:path nltl:hasCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/lowerEndpoint> ;
            sh:resultMessage "Less than 1 values on ex:lowerEndpoint->nltl:interpolationPointResult" ;
            sh:resultPath nltl:interpolationPointResult ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nbbd9af6e226e45c48666e865639eb8ceb62 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/lowerEndpoint> ;
            sh:resultMessage "Less than 1 values on ex:lowerEndpoint->nltl:interpolationPointCoordinate" ;
            sh:resultPath nltl:interpolationPointCoordinate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nbbd9af6e226e45c48666e865639eb8ceb58 ] .

_:N2bcb0fd790e84da08e8d6041def05a1a sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:N38453babb1754c16bc7345ed1da0e0f5 sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:N6c673f72fb114c6a8c5390f26a38210d sh:property _:N2bcb0fd790e84da08e8d6041def05a1a,
        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:nbbd9af6e226e45c48666e865639eb8ceb58 sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node _:N6c673f72fb114c6a8c5390f26a38210d ;
    sh:path nltl:interpolationPointCoordinate .

_:nbbd9af6e226e45c48666e865639eb8ceb62 sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node _:N38453babb1754c16bc7345ed1da0e0f5 ;
    sh:path nltl:interpolationPointResult .

