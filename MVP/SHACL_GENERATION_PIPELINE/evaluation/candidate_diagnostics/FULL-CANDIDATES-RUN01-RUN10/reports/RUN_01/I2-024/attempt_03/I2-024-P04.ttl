@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P04/upperEndpoint> ;
            sh:resultMessage "Less than 1 values on ex:upperEndpoint->nltl:interpolationPointCoordinate" ;
            sh:resultPath nltl:interpolationPointCoordinate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nbbd9af6e226e45c48666e865639eb8ceb58 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P04/upperEndpoint> ;
            sh:resultMessage "Less than 1 values on ex:upperEndpoint->nltl:interpolationPointResult" ;
            sh:resultPath nltl:interpolationPointResult ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nbbd9af6e226e45c48666e865639eb8ceb62 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasCalculationCase" ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:longitudinalFramingNetPlateThickness ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:transverseFramingNetPlateThickness ] ] ;
                    sh:path nltl:hasCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P04/lowerEndpoint> ;
            sh:resultMessage "Less than 1 values on ex:lowerEndpoint->nltl:interpolationPointCoordinate" ;
            sh:resultPath nltl:interpolationPointCoordinate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nbbd9af6e226e45c48666e865639eb8ceb58 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P04/lowerEndpoint> ;
            sh:resultMessage "Less than 1 values on ex:lowerEndpoint->nltl:interpolationPointResult" ;
            sh:resultPath nltl:interpolationPointResult ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nbbd9af6e226e45c48666e865639eb8ceb62 ] .

_:N1101230fbdc24e5f8617fb65f11f712c sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:N33ebc0e45d86427bae6fe3779968a220 sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:nbbd9af6e226e45c48666e865639eb8ceb58 sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node _:N1101230fbdc24e5f8617fb65f11f712c ;
    sh:path nltl:interpolationPointCoordinate .

_:nbbd9af6e226e45c48666e865639eb8ceb62 sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node _:N33ebc0e45d86427bae6fe3779968a220 ;
    sh:path nltl:interpolationPointResult .

