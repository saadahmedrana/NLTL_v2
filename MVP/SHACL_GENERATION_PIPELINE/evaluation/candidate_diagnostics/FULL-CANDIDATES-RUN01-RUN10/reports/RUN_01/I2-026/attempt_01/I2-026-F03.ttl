@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ;
                    sh:resultMessage "Support fixity must be fixed for continuous members, members with a connection bracket, members with demonstrated rotational restraint, and members terminating within an ice-strengthened area; demonstrated rotational restraint also requires evidence." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "Support fixity must be fixed for continuous members, members with a connection bracket, members with demonstrated rotational restraint, and members terminating within an ice-strengthened area; demonstrated rotational restraint also requires evidence." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasMemberSupport ?support .
                ?support nltl:frameSupportCondition ?condition .

                FILTER (
                    (
                        EXISTS {
                            $this nltl:terminatesWithinIceStrengthenedArea true
                        }
                        && ?condition != nltl:fixedFrameSupport
                    )
                    ||
                    (
                        EXISTS {
                            $this nltl:continuousThroughSupport true
                        }
                        && ?condition != nltl:fixedFrameSupport
                    )
                    ||
                    (
                        EXISTS {
                            ?support nltl:connectionBracketPresent true
                        }
                        && ?condition != nltl:fixedFrameSupport
                    )
                    ||
                    (
                        EXISTS {
                            ?support nltl:demonstratedRotationalRestraint true
                        }
                        &&
                        (
                            ?condition != nltl:fixedFrameSupport
                            ||
                            NOT EXISTS {
                                $this nltl:significantRotationalRestraintEvidence ?evidence .
                            }
                        )
                    )
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_026_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/ship> ;
            sh:resultMessage "Each represented structural member must have a conforming support model." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each represented structural member must have a conforming support model." ;
                    sh:node gen:I2_026_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ] .

