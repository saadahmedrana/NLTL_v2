@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/calc> ;
                                    sh:resultMessage "Less than 1 values on ex:calc->nltl:sectionCalculationCasePlating" ;
                                    sh:resultPath nltl:sectionCalculationCasePlating ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                                    sh:sourceShape [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node gs:I2_030_PlatingShape ;
                                            sh:path nltl:sectionCalculationCasePlating ] ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/member> ;
                            sh:resultMessage "Value does not conform to Shape gs:I2_030_LocalFrameSectionCalculationCaseShape. See details for more information." ;
                            sh:resultPath nltl:hasLocalFrameSectionCalculationCase ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
                                    sh:node gs:I2_030_LocalFrameSectionCalculationCaseShape ;
                                    sh:path nltl:hasLocalFrameSectionCalculationCase ] ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/calc> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/calc> ;
                    sh:resultMessage "Value does not conform to Shape gs:I2_030_StructuralMemberShape. See details for more information." ;
                    sh:resultPath nltl:sectionCalculationCaseStructuralMember ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node gs:I2_030_StructuralMemberShape ;
                            sh:path nltl:sectionCalculationCaseStructuralMember ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:I2_030_CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gs:I2_030_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/calc> ] .

