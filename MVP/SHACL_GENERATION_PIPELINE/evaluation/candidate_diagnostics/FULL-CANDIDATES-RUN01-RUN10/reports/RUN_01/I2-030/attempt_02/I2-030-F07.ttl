@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/calc> ;
                    sh:resultMessage "For oblique framing with 20 < Omega < 70 degrees, the calculation case shall provide paired lower and upper interpolation points with coordinates and results." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "For oblique framing with 20 < Omega < 70 degrees, the calculation case shall provide paired lower and upper interpolation points with coordinates and results." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCaseStructuralMember ?member .
                ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                ?localCase nltl:sectionCalculationCasePlating ?plating .
                ?plating nltl:framingAngleOmega ?omegaNode .
                ?omegaNode qudt:numericValue ?omega ;
                           qudt:unit <http://qudt.org/vocab/unit/DEG> .
                FILTER(
                    datatype(?omega) = xsd:decimal &&
                    ?omega > 20 &&
                    ?omega < 70
                )
                FILTER NOT EXISTS {
                    $this nltl:interpolationLowerEndpoint ?lower ;
                          nltl:interpolationUpperEndpoint ?upper .
                    ?lower rdf:type nltl:interpolationPoint ;
                           nltl:interpolationPointCoordinate ?lowerCoordinate ;
                           nltl:interpolationPointResult ?lowerResult .
                    ?upper rdf:type nltl:interpolationPoint ;
                           nltl:interpolationPointCoordinate ?upperCoordinate ;
                           nltl:interpolationPointResult ?upperResult .
                    ?lowerCoordinate qudt:numericValue ?lowerX ;
                                      qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    ?upperCoordinate qudt:numericValue ?upperX ;
                                      qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    ?lowerResult qudt:numericValue ?lowerY .
                    ?upperResult qudt:numericValue ?upperY .
                    FILTER(
                        datatype(?lowerX) = xsd:decimal &&
                        datatype(?upperX) = xsd:decimal &&
                        datatype(?lowerY) = xsd:decimal &&
                        datatype(?upperY) = xsd:decimal
                    )
                }
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gs:I2_030_CalculationCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/calc> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:I2_030_CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gs:I2_030_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/calc> ] .

