@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasStructuralMember" ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gs:StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/upper> ;
                            sh:resultMessage "Less than 1 values on ex:upper->nltl:interpolationPointResult" ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:interpolationPointResult ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/calc> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:interpolationPoint ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:interpolationPointResult ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:interpolationPointCoordinate ] ]. See details for more information." ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node [ sh:class nltl:interpolationPoint ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:class qudt:QuantityValue ;
                                                    sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:interpolationPointResult ],
                                        [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:class qudt:QuantityValue ;
                                                    sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ],
                                                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ] ] ;
                                            sh:path nltl:interpolationPointCoordinate ] ] ;
                            sh:path nltl:interpolationUpperEndpoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/upper> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gs:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/calc> ] .

