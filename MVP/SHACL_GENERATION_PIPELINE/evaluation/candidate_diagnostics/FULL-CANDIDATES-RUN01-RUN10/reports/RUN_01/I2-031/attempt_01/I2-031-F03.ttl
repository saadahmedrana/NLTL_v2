@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:frameProfileType" ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:hasValue nltl:flatBarSection ] [ sh:hasValue nltl:profileSection ] ) ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:plasticCollapseMechanism" ;
            sh:resultPath nltl:plasticCollapseMechanism ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:minCount 1 ;
                    sh:path nltl:plasticCollapseMechanism ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:patchLoad" ;
            sh:resultPath nltl:patchLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:I2_031_KiloNewtonQuantityShape ;
                    sh:path nltl:patchLoad ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F03/member> ;
                    sh:resultMessage "Less than 1 values on ex:member->nltl:midspanPlasticCollapseLoad" ;
                    sh:resultPath nltl:midspanPlasticCollapseLoad ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node gen:I2_031_KiloNewtonQuantityShape ;
                            sh:path nltl:midspanPlasticCollapseLoad ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_031_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:I2_031_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F03/member> ] .

