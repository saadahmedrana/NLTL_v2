@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode nltl:sternBottomHullArea ;
            sh:resultMessage "Less than 1 values on nltl:sternBottomHullArea->nltl:hullAreaFactor" ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n100b7d6e1d224f43801f048c34007aedb43 ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:bowIntermediateBottomHullArea ;
