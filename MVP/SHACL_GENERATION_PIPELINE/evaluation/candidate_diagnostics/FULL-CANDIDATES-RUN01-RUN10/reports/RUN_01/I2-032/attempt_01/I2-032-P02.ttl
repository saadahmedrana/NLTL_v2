            sh:resultMessage "Less than 1 values on nltl:midbodyBottomHullArea->nltl:hullAreaFactor" ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n100b7d6e1d224f43801f048c34007aedb43 ] .

_:Nbdd5155a3e5e470a92e194c94f138bd0 sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:Nd0b3099c11ff4d828c7e9e3d2d87ff51 sh:class qudt:QuantityValue ;
    sh:property _:Nbdd5155a3e5e470a92e194c94f138bd0,
