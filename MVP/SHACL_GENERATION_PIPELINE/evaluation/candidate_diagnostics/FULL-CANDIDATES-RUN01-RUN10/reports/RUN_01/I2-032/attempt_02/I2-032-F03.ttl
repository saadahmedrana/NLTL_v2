@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode nltl:bowIntermediateBottomHullArea ;
            sh:resultMessage "Less than 1 values on nltl:bowIntermediateBottomHullArea->nltl:hullAreaFactor" ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n1467a8a981ca422ebc39dadfdb6e3cd3b43 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-032-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchHeight" ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:sternBottomHullArea ;
            sh:resultMessage "Less than 1 values on nltl:sternBottomHullArea->nltl:hullAreaFactor" ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n1467a8a981ca422ebc39dadfdb6e3cd3b43 ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:midbodyBottomHullArea ;
            sh:resultMessage "Less than 1 values on nltl:midbodyBottomHullArea->nltl:hullAreaFactor" ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n1467a8a981ca422ebc39dadfdb6e3cd3b43 ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:otherIceStrengthenedArea ;
            sh:resultMessage "Less than 1 values on nltl:otherIceStrengthenedArea->nltl:hullAreaFactor" ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n1467a8a981ca422ebc39dadfdb6e3cd3b43 ] .

_:N71d26d0d815a4091ab2706f3a0d722bb sh:class qudt:QuantityValue ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ],
        [ sh:hasValue unit:UNITLESS ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:n1467a8a981ca422ebc39dadfdb6e3cd3b43 sh:maxCount 1 ;
