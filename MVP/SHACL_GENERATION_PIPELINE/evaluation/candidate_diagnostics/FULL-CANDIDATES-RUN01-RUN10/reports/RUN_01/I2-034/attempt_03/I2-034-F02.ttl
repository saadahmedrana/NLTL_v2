@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/ship> ;
            sh:resultMessage "Every applicable longitudinal side-structure frame must have valid plastic strength, midspan plastic-collapse load, and load-case demand values." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Every applicable longitudinal side-structure frame must have valid plastic strength, midspan plastic-collapse load, and load-case demand values." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT ?this
            WHERE {
                ?this nltl:hasStructuralMember ?member .
                ?member nltl:longitudinalFrameOrientation true ;
                        nltl:structuralLocation nltl:sideStructureLocation ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .
                FILTER (
                    NOT EXISTS {
                        ?member nltl:plasticStrength ?strength .
                        ?strength qudt:numericValue ?strengthValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        FILTER (datatype(?strengthValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?member nltl:midspanPlasticCollapseLoad ?collapseLoad .
                        ?collapseLoad qudt:numericValue ?collapseValue ;
                                      qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        FILTER (datatype(?collapseValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                        ?demand qudt:numericValue ?demandValue .
                        FILTER (datatype(?demandValue) = xsd:decimal)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:I2_034_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/ship> ;
            sh:resultMessage "The ship must represent its frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must represent its frame profile type." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:frameProfileType ] ] .

