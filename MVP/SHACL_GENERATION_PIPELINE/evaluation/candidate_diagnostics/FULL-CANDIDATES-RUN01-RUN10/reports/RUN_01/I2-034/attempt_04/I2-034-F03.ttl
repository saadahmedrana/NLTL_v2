@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F03/member> ;
                    sh:resultMessage "For an applicable longitudinal side-structure frame, plastic strength, midspan plastic collapse load, and each represented load-case demand must be represented with valid numeric values and the declared KiloN unit for the two strength quantities." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "For an applicable longitudinal side-structure frame, plastic strength, midspan plastic collapse load, and each represented load-case demand must be represented with valid numeric values and the declared KiloN unit for the two strength quantities." ;
                            sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:longitudinalFrameOrientation true ;
        nltl:structuralLocation nltl:sideStructureLocation .
  FILTER (
    NOT EXISTS {
      $this nltl:plasticStrength ?ps .
      ?ps qudt:numericValue ?psv ;
          qudt:unit <http://qudt.org/vocab/unit/KiloN> .
      FILTER (DATATYPE(?psv) = xsd:decimal)
    }
    ||
    NOT EXISTS {
      $this nltl:midspanPlasticCollapseLoad ?pc .
      ?pc qudt:numericValue ?pcv ;
          qudt:unit <http://qudt.org/vocab/unit/KiloN> .
      FILTER (DATATYPE(?pcv) = xsd:decimal)
    }
    ||
    EXISTS {
      $this nltl:hasStructuralMemberLoadCase ?lc .
      FILTER NOT EXISTS {
        ?lc nltl:combinedShearAndBendingDemand ?d .
        ?d qudt:numericValue ?dv .
        FILTER (DATATYPE(?dv) = xsd:decimal)
      }
    }
  )
}
""" ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape [ a sh:NodeShape ;
                            sh:property [ sh:node [ a sh:NodeShape ;
                                            sh:property [ sh:node [ a sh:NodeShape ;
                                                            sh:property [ ] ] ;
                                                    sh:path nltl:combinedShearAndBendingDemand ] ] ;
                                    sh:path nltl:hasStructuralMemberLoadCase ],
                                [ sh:datatype xsd:boolean ;
                                    sh:path nltl:longitudinalFrameOrientation ],
                                [ sh:class nltl:structuralLocationValue ;
                                    sh:path nltl:structuralLocation ] ;
                            sh:sparql [ a sh:SPARQLConstraint ;
                                    sh:message "For an applicable longitudinal side-structure frame, every represented combined shear-and-bending demand must not exceed either the plastic strength or the midspan plastic collapse load." ;
                                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:longitudinalFrameOrientation true ;
        nltl:structuralLocation nltl:sideStructureLocation ;
        nltl:plasticStrength ?ps ;
        nltl:midspanPlasticCollapseLoad ?pc ;
        nltl:hasStructuralMemberLoadCase ?lc .
  ?ps qudt:numericValue ?psv ;
      qudt:unit <http://qudt.org/vocab/unit/KiloN> .
  ?pc qudt:numericValue ?pcv ;
      qudt:unit <http://qudt.org/vocab/unit/KiloN> .
  ?lc nltl:combinedShearAndBendingDemand ?d .
  ?d qudt:numericValue ?dv .
  FILTER (
    DATATYPE(?psv) = xsd:decimal &&
    DATATYPE(?pcv) = xsd:decimal &&
    DATATYPE(?dv) = xsd:decimal &&
    (?dv > ?psv || ?dv > ?pcv)
  )
}
""" ],
                                [ a sh:SPARQLConstraint ;
                                    sh:message "For an applicable longitudinal side-structure frame, plastic strength, midspan plastic collapse load, and each represented load-case demand must be represented with valid numeric values and the declared KiloN unit for the two strength quantities." ;
                                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:longitudinalFrameOrientation true ;
        nltl:structuralLocation nltl:sideStructureLocation .
  FILTER (
    NOT EXISTS {
      $this nltl:plasticStrength ?ps .
      ?ps qudt:numericValue ?psv ;
          qudt:unit <http://qudt.org/vocab/unit/KiloN> .
      FILTER (DATATYPE(?psv) = xsd:decimal)
    }
    ||
    NOT EXISTS {
      $this nltl:midspanPlasticCollapseLoad ?pc .
      ?pc qudt:numericValue ?pcv ;
          qudt:unit <http://qudt.org/vocab/unit/KiloN> .
      FILTER (DATATYPE(?pcv) = xsd:decimal)
    }
    ||
    EXISTS {
      $this nltl:hasStructuralMemberLoadCase ?lc .
      FILTER NOT EXISTS {
        ?lc nltl:combinedShearAndBendingDemand ?d .
        ?d qudt:numericValue ?dv .
        FILTER (DATATYPE(?dv) = xsd:decimal)
      }
    }
  )
}
""" ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F03/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F03/ship> ;
            sh:resultMessage """Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:class nltl:structuralLocationValue ; sh:path nltl:structuralLocation ], [ sh:datatype xsd:boolean ; sh:path nltl:longitudinalFrameOrientation ], [ sh:node [ rdf:type sh:NodeShape ; sh:property [ sh:node [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:combinedShearAndBendingDemand ] ] ; sh:path nltl:hasStructuralMemberLoadCase ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("For an applicable longitudinal side-structure frame, every represented combined shear-and-bending demand must not exceed either the plastic strength or the midspan plastic collapse load.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:longitudinalFrameOrientation true ;
        nltl:structuralLocation nltl:sideStructureLocation ;
        nltl:plasticStrength ?ps ;
        nltl:midspanPlasticCollapseLoad ?pc ;
        nltl:hasStructuralMemberLoadCase ?lc .
  ?ps qudt:numericValue ?psv ;
      qudt:unit <http://qudt.org/vocab/unit/KiloN> .
  ?pc qudt:numericValue ?pcv ;
      qudt:unit <http://qudt.org/vocab/unit/KiloN> .
  ?lc nltl:combinedShearAndBendingDemand ?d .
  ?d qudt:numericValue ?dv .
  FILTER (
    DATATYPE(?psv) = xsd:decimal &&
    DATATYPE(?pcv) = xsd:decimal &&
    DATATYPE(?dv) = xsd:decimal &&
    (?dv > ?psv || ?dv > ?pcv)
  )
}
") ], [ rdf:type sh:SPARQLConstraint ; sh:message Literal("For an applicable longitudinal side-structure frame, plastic strength, midspan plastic collapse load, and each represented load-case demand must be represented with valid numeric values and the declared KiloN unit for the two strength quantities.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:longitudinalFrameOrientation true ;
        nltl:structuralLocation nltl:sideStructureLocation .
  FILTER (
    NOT EXISTS {
      $this nltl:plasticStrength ?ps .
      ?ps qudt:numericValue ?psv ;
          qudt:unit <http://qudt.org/vocab/unit/KiloN> .
      FILTER (DATATYPE(?psv) = xsd:decimal)
    }
    ||
    NOT EXISTS {
      $this nltl:midspanPlasticCollapseLoad ?pc .
      ?pc qudt:numericValue ?pcv ;
          qudt:unit <http://qudt.org/vocab/unit/KiloN> .
      FILTER (DATATYPE(?pcv) = xsd:decimal)
    }
    ||
    EXISTS {
      $this nltl:hasStructuralMemberLoadCase ?lc .
      FILTER NOT EXISTS {
        ?lc nltl:combinedShearAndBendingDemand ?d .
        ?d qudt:numericValue ?dv .
        FILTER (DATATYPE(?dv) = xsd:decimal)
      }
    }
  )
}
") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ a sh:NodeShape ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:path nltl:longitudinalFrameOrientation ],
                                [ sh:class nltl:structuralLocationValue ;
                                    sh:path nltl:structuralLocation ],
                                [ sh:node [ a sh:NodeShape ;
                                            sh:property [ sh:node [ ] ;
                                                    sh:path nltl:combinedShearAndBendingDemand ] ] ;
                                    sh:path nltl:hasStructuralMemberLoadCase ] ;
                            sh:sparql [ a sh:SPARQLConstraint ;
                                    sh:message "For an applicable longitudinal side-structure frame, plastic strength, midspan plastic collapse load, and each represented load-case demand must be represented with valid numeric values and the declared KiloN unit for the two strength quantities." ;
                                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:longitudinalFrameOrientation true ;
        nltl:structuralLocation nltl:sideStructureLocation .
  FILTER (
    NOT EXISTS {
      $this nltl:plasticStrength ?ps .
      ?ps qudt:numericValue ?psv ;
          qudt:unit <http://qudt.org/vocab/unit/KiloN> .
      FILTER (DATATYPE(?psv) = xsd:decimal)
    }
    ||
    NOT EXISTS {
      $this nltl:midspanPlasticCollapseLoad ?pc .
      ?pc qudt:numericValue ?pcv ;
          qudt:unit <http://qudt.org/vocab/unit/KiloN> .
      FILTER (DATATYPE(?pcv) = xsd:decimal)
    }
    ||
    EXISTS {
      $this nltl:hasStructuralMemberLoadCase ?lc .
      FILTER NOT EXISTS {
        ?lc nltl:combinedShearAndBendingDemand ?d .
        ?d qudt:numericValue ?dv .
