@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/loadcase> ;
                            sh:resultMessage "The structural-member load case must represent the combined bending and shear effects." ;
                            sh:resultPath nltl:combinedShearBendingEffect ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:message "The structural-member load case must represent the combined bending and shear effects." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:combinedShearBendingEffect ] ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/loadcase> ;
                            sh:resultMessage "The structural-member load case must identify the load-patch application location." ;
                            sh:resultPath nltl:loadPatchApplicationLocation ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:message "The structural-member load case must identify the load-patch application location." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:loadPatchApplicationLocation ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/member> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:loadCase ; sh:property [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The structural-member load case must identify the load-patch application location.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadPatchApplicationLocation ], [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The structural-member load case must represent the combined bending and shear effects.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:combinedShearBendingEffect ] ]. See details for more information." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class nltl:loadCase ;
                                    sh:property [ sh:datatype xsd:string ;
                                            sh:maxCount 1 ;
                                            sh:message "The structural-member load case must represent the combined bending and shear effects." ;
                                            sh:minCount 1 ;
                                            sh:path nltl:combinedShearBendingEffect ],
                                        [ sh:datatype xsd:string ;
                                            sh:maxCount 1 ;
                                            sh:message "The structural-member load case must identify the load-patch application location." ;
                                            sh:minCount 1 ;
                                            sh:path nltl:loadPatchApplicationLocation ] ] ;
                            sh:path nltl:hasStructuralMemberLoadCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/loadcase> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/member> ;
                    sh:resultMessage "Each structural member must provide its capacity in kilonewtons." ;
                    sh:resultPath nltl:memberCapacity ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each structural member must provide its capacity in kilonewtons." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue unit:KiloN ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:memberCapacity ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:structuralMember ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each structural member must provide its capacity in kilonewtons.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:memberCapacity ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:loadCase ; sh:property [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The structural-member load case must identify the load-patch application location.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadPatchApplicationLocation ], [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The structural-member load case must represent the combined bending and shear effects.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:combinedShearBendingEffect ] ] ; sh:path nltl:hasStructuralMemberLoadCase ] ]. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:structuralMember ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:loadCase ;
                                            sh:property [ sh:datatype xsd:string ;
                                                    sh:maxCount 1 ;
                                                    sh:message "The structural-member load case must represent the combined bending and shear effects." ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:combinedShearBendingEffect ],
                                                [ sh:datatype xsd:string ;
                                                    sh:maxCount 1 ;
                                                    sh:message "The structural-member load case must identify the load-patch application location." ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:loadPatchApplicationLocation ] ] ;
                                    sh:path nltl:hasStructuralMemberLoadCase ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each structural member must provide its capacity in kilonewtons." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:KiloN ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:memberCapacity ] ] ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "At least one represented structural-member load-case location must have minimum capacity under the combined bending and shear load cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "At least one represented structural-member load-case location must have minimum capacity under the combined bending and shear load cases." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasStructuralMember ?m0 .
                    ?m0 nltl:hasStructuralMemberLoadCase ?lc0 .
                    ?lc0 nltl:combinedShearBendingEffect ?effect0 ;
                         nltl:loadPatchApplicationLocation ?location0 .
                    ?m0 nltl:memberCapacity ?capacity0 .
                    ?capacity0 qudt:numericValue ?value0 ;
                              qudt:unit unit:KiloN .
                    FILTER NOT EXISTS {
                        $this nltl:hasStructuralMember ?m1 .
                        ?m1 nltl:hasStructuralMemberLoadCase ?lc1 .
                        ?lc1 nltl:combinedShearBendingEffect ?effect1 ;
                             nltl:loadPatchApplicationLocation ?location1 .
                        ?m1 nltl:memberCapacity ?capacity1 .
                        ?capacity1 qudt:numericValue ?value1 ;
                                  qudt:unit unit:KiloN .
                        FILTER ( ?value1 < ?value0 )
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-037> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ;
                    sh:resultMessage "The ice-load-patch design case must confirm capacity minimization." ;
                    sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n76e1454f85a94acab33b05df826b0eb2b5 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ;
                    sh:resultMessage "The ice-load-patch design case must confirm capacity minimization." ;
                    sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n76e1454f85a94acab33b05df826b0eb2b5 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "The ship must provide an ice-load-patch design case." ;
            sh:resultPath nltl:hasIceLoadPatchDesignCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide an ice-load-patch design case." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:iceLoadPatchDesignCase ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:message "The ice-load-patch design case must confirm capacity minimization." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:memberCapacityMinimizationConfirmed ] ] ;
                    sh:path nltl:hasIceLoadPatchDesignCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "The ship must identify the ice load patch used by the design." ;
            sh:resultPath nltl:hasIceLoadPatch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must identify the ice load patch used by the design." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:iceLoadPatch ] ;
                    sh:path nltl:hasIceLoadPatch ] ] .

_:n76e1454f85a94acab33b05df826b0eb2b5 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ice-load-patch design case must confirm capacity minimization." ;
    sh:minCount 1 ;
    sh:path nltl:memberCapacityMinimizationConfirmed .

