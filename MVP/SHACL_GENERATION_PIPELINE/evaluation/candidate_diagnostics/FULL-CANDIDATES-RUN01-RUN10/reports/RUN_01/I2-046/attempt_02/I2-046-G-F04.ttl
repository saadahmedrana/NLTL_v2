@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:polarClassRequirementsApplicable" ;
            sh:resultPath nltl:polarClassRequirementsApplicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:polarClassRequirementsApplicable ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:I2_046_ApplicableBranch , gs:I2_046_NonApplicableBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:I2_046_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/ship> ] .

