@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F02/ship> ;
            sh:resultMessage "steelRenewalRequired must be true when gauged thickness is less than net thickness plus 0.0005 m, and false otherwise" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "steelRenewalRequired must be true when gauged thickness is less than net thickness plus 0.0005 m, and false otherwise" ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:gaugedThickness ?gaugedQuantity ;
                      nltl:netThickness ?netQuantity ;
                      nltl:steelRenewalRequired ?renewal .

                ?gaugedQuantity qudt:numericValue ?gaugedValue ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                ?netQuantity qudt:numericValue ?netValue ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .

                FILTER (
                    (?gaugedValue < (?netValue + 0.0005) && ?renewal != true) ||
                    (?gaugedValue >= (?netValue + 0.0005) && ?renewal != false)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:I2_047_SteelRenewalShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F02/ship> ] .

