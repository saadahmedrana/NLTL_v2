@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F02/ship> ;
            sh:resultMessage "steelRenewalRequired must be true exactly when gaugedThickness is less than netThickness plus 0.0005 m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "steelRenewalRequired must be true exactly when gaugedThickness is less than netThickness plus 0.0005 m." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:gaugedThickness ?gaugedQuantity ;
                      nltl:netThickness ?netQuantity ;
                      nltl:steelRenewalRequired ?renewal .

                ?gaugedQuantity qudt:numericValue ?gaugedThickness ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                ?netQuantity qudt:numericValue ?netThickness ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .

                FILTER (
                    (
                        ?gaugedThickness < (?netThickness + 0.0005) &&
                        ?renewal != true
                    ) ||
                    (
                        !(
                            ?gaugedThickness < (?netThickness + 0.0005)
                        ) &&
                        ?renewal != false
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_047_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F02/ship> ;
            sh:resultMessage "The ship must identify the linked structure as ice strengthened." ;
            sh:resultPath _:nb3f5ae9eb5744b678ba244a27b4e9d53b10 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb3f5ae9eb5744b678ba244a27b4e9d53b9 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F02/ship> ;
            sh:resultMessage "The ship must identify the linked structure as ice strengthened." ;
            sh:resultPath _:nb3f5ae9eb5744b678ba244a27b4e9d53b10 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb3f5ae9eb5744b678ba244a27b4e9d53b9 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F02/ship> ;
            sh:resultMessage "Value is not Literal with datatype qudt:QuantityValue" ;
            sh:resultPath nltl:gaugedThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:gaugedThickness ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F02/gauged> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F02/ship> ;
            sh:resultMessage "Value is not Literal with datatype qudt:QuantityValue" ;
            sh:resultPath nltl:netThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:netThickness ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F02/net> ] .

_:N50d51a3cf7d6478884c8786124fb1364 rdf:first nltl:iceStrengthenedStructureStatus ;
    rdf:rest () .

_:Nab34454c96e5410fa071f35827d250d9 rdf:first nltl:hasPlating ;
    rdf:rest ( nltl:iceStrengthenedStructureStatus ) .

_:nb3f5ae9eb5744b678ba244a27b4e9d53b10 rdf:first nltl:hasPlating ;
    rdf:rest _:N50d51a3cf7d6478884c8786124fb1364 .

_:nb3f5ae9eb5744b678ba244a27b4e9d53b9 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must identify the linked structure as ice strengthened." ;
    sh:minCount 1 ;
    sh:path _:Nab34454c96e5410fa071f35827d250d9 .

