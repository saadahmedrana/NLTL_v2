[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-P01/ship> ;
            sh:resultMessage "The ship must identify the linked structure as ice strengthened." ;
