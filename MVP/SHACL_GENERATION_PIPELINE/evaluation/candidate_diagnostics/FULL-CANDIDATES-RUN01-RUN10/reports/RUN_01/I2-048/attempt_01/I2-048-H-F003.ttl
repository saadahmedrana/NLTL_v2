            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-048-case>. See details for more information." ;
            sh:resultPath nltl:hasSteelGradeRequirementCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeRequirementCase ;
                    sh:node <urn:nltl:generated-shape:I2-048-case> ;
