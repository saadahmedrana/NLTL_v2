[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F003/case> ;
                    sh:resultMessage "Less than 1 values on ex:case->nltl:asBuiltPlateThickness" ;
