                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F005/case> ;
                    sh:resultMessage "Less than 1 values on ex:case->nltl:steelMaterialClass" ;
                    sh:resultPath nltl:steelMaterialClass ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n72b7df79b39c46af93cfafae9a7ff6acb14 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F005/case> ;
                    sh:resultMessage "Less than 1 values on ex:case->nltl:asBuiltPlateThickness" ;
