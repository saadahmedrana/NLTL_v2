@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ice strength coefficient ki input is required as a dimensionless quantity." ;
            sh:resultPath nltl:iceStrengthCoefficientKI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ice strength coefficient ki input is required as a dimensionless quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:iceStrengthCoefficientKI ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The externally computed second candidate design vertical ice force at the bow is required with a value in MN." ;
            sh:resultPath nltl:designVerticalIceForceAtBowCandidateTwo ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The externally computed second candidate design vertical ice force at the bow is required with a value in MN." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:MegaN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:designVerticalIceForceAtBowCandidateTwo ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The externally computed first candidate design vertical ice force at the bow is required with a value in MN." ;
            sh:resultPath nltl:designVerticalIceForceAtBowCandidateOne ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The externally computed first candidate design vertical ice force at the bow is required with a value in MN." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:MegaN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designVerticalIceForceAtBowCandidateOne ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The upper ice waterline draught input is required with a value in metres." ;
            sh:resultPath nltl:upperIceWaterlineDraughtDUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The upper ice waterline draught input is required with a value in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:upperIceWaterlineDraughtDUI ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/ship> ;
            sh:resultMessage "The externally computed design vertical ice force at the bow is required with a value in MN." ;
            sh:resultPath nltl:designVerticalIceForceAtBow ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The externally computed design vertical ice force at the bow is required with a value in MN." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:MegaN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designVerticalIceForceAtBow ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The hull form coefficient kh input is required as a dimensionless quantity." ;
            sh:resultPath nltl:hullFormCoefficientKh ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The hull form coefficient kh input is required as a dimensionless quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:hullFormCoefficientKh ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The stem angle input is required with a value in degrees." ;
            sh:resultPath nltl:stemAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The stem angle input is required with a value in degrees." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:DEG ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:stemAngle ] ] .

