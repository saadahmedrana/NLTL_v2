@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasCalculationCase" ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:minCount 5 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ] ] ;
                                    sh:path nltl:hasInterpolationPoint ] ;
                            sh:sparql [ sh:message "The calculation case must represent C_m at the aft end, 0.5 L_UI, 0.7 L_UI, 0.95 L_UI, and the forward end, with the corresponding interpolation-point results." ;
                                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this
WHERE {
  ?this nltl:hasInterpolationPoint ?p0 .
  ?this nltl:hasInterpolationPoint ?p05 .
  ?this nltl:hasInterpolationPoint ?p07 .
  ?this nltl:hasInterpolationPoint ?p095 .
  ?this nltl:hasInterpolationPoint ?p1 .

  ?p0 nltl:interpolationPointCoordinate ?q0 ;
      nltl:interpolationPointResult ?r0q .
  ?q0 qudt:numericValue ?x0 .
  ?r0q qudt:numericValue ?r0 .

  ?p05 nltl:interpolationPointCoordinate ?q05 ;
       nltl:interpolationPointResult ?r05q .
  ?q05 qudt:numericValue ?x05 .
  ?r05q qudt:numericValue ?r05 .

  ?p07 nltl:interpolationPointCoordinate ?q07 ;
       nltl:interpolationPointResult ?r07q .
  ?q07 qudt:numericValue ?x07 .
  ?r07q qudt:numericValue ?r07 .

  ?p095 nltl:interpolationPointCoordinate ?q095 ;
        nltl:interpolationPointResult ?r095q .
  ?q095 qudt:numericValue ?x095 .
  ?r095q qudt:numericValue ?r095 .

  ?p1 nltl:interpolationPointCoordinate ?q1 ;
      nltl:interpolationPointResult ?r1q .
  ?q1 qudt:numericValue ?x1 .
  ?r1q qudt:numericValue ?r1 .

  FILTER (
    ?x0 = 0 &&
    ?r0 = 0 &&
    ?x05 = 0.5 &&
    ?r05 = 1 &&
    ?x07 = 0.7 &&
    ?r07 = 1 &&
    ?x095 = 0.95 &&
    ?r095 = 0.3 &&
    ?x1 = 1 &&
    ?r1 = 0
  )
}
""" ] ] ;
                    sh:path nltl:hasCalculationCase ] ] .

