    $this nltl:hasInterpolationPoint ?p4 .
    ?p4 nltl:interpolationPointCoordinate ?q4 ;
        nltl:interpolationPointResult ?r4 .
    ?q4 qudt:numericValue ?x4 .
    ?r4 qudt:numericValue ?y4 .
    FILTER(?x4 = 1.0 && ?y4 = 0.0)
  }
}
""" ] ;
