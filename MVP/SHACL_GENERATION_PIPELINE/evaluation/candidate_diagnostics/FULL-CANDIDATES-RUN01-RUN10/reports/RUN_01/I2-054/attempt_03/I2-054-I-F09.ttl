PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  FILTER NOT EXISTS {
    $this nltl:hasInterpolationPoint ?p0 .
    ?p0 nltl:interpolationPointCoordinate ?q0 ;
        nltl:interpolationPointResult ?r0 .
    ?q0 qudt:numericValue ?x0 .
    ?r0 qudt:numericValue ?y0 .
    FILTER(?x0 = 0.0 && ?y0 = 0.0)
  }
  FILTER NOT EXISTS {
    $this nltl:hasInterpolationPoint ?p1 .
    ?p1 nltl:interpolationPointCoordinate ?q1 ;
        nltl:interpolationPointResult ?r1 .
    ?q1 qudt:numericValue ?x1 .
    ?r1 qudt:numericValue ?y1 .
    FILTER(?x1 = 0.5 && ?y1 = 1.0)
  }
  FILTER NOT EXISTS {
    $this nltl:hasInterpolationPoint ?p2 .
    ?p2 nltl:interpolationPointCoordinate ?q2 ;
        nltl:interpolationPointResult ?r2 .
    ?q2 qudt:numericValue ?x2 .
    ?r2 qudt:numericValue ?y2 .
    FILTER(?x2 = 0.7 && ?y2 = 1.0)
  }
  FILTER NOT EXISTS {
    $this nltl:hasInterpolationPoint ?p3 .
    ?p3 nltl:interpolationPointCoordinate ?q3 ;
        nltl:interpolationPointResult ?r3 .
    ?q3 qudt:numericValue ?x3 .
    ?r3 qudt:numericValue ?y3 .
