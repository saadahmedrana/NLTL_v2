    ?r2 qudt:numericValue ?y2 .
    FILTER(?x2 = 0.7 && ?y2 = 1.0)
  }
  FILTER NOT EXISTS {
    $this nltl:hasInterpolationPoint ?p3 .
    ?p3 nltl:interpolationPointCoordinate ?q3 ;
        nltl:interpolationPointResult ?r3 .
    ?q3 qudt:numericValue ?x3 .
    ?r3 qudt:numericValue ?y3 .
    FILTER(?x3 = 0.95 && ?y3 = 0.3)
  }
  FILTER NOT EXISTS {
    $this nltl:hasInterpolationPoint ?p4 .
    ?p4 nltl:interpolationPointCoordinate ?q4 ;
        nltl:interpolationPointResult ?r4 .
    ?q4 qudt:numericValue ?x4 .
    ?r4 qudt:numericValue ?y4 .
    FILTER(?x4 = 1.0 && ?y4 = 0.0)
  }
}
