PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  FILTER NOT EXISTS {
    $this nltl:hasInterpolationPoint ?p0 .
    ?p0 nltl:interpolationPointCoordinate ?q0 ;
        nltl:interpolationPointResult ?r0 .
