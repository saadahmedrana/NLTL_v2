                                [ sh:message "Each interpolation point in the hull-girder case must follow the declared piecewise linear interpolation of C_m." ;
                                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:hasInterpolationPoint ?p .
  ?p nltl:interpolationPointCoordinate ?q ;
     nltl:interpolationPointResult ?r .
  ?q qudt:numericValue ?x .
  ?r qudt:numericValue ?y .
  FILTER(?x >= 0.0 && ?x <= 1.0)
  BIND(
    IF(?x <= 0.5,
       2.0 * ?x,
       IF(?x <= 0.7,
          1.0,
          IF(?x <= 0.95,
             1.0 - 2.8 * (?x - 0.7),
             0.3 - 6.0 * (?x - 0.95)
          )
       )
    ) AS ?expected
  )
  FILTER(
    ABS(?y - ?expected) > 0.000001 &&
    ABS(?y - ?expected) > 0.000001 * ABS(?expected)
  )
}
""" ] ] ;
