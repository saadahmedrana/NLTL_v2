@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/ship> ;
            sh:resultMessage "A ship with a structural member in way of a cutout must record member instability as false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship with a structural member in way of a cutout must record member instability as false." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout .
    FILTER (
        NOT EXISTS {
            $this nltl:memberInstability ?instability .
        }
        ||
        EXISTS {
            $this nltl:memberInstability ?instability .
            FILTER (
                DATATYPE(?instability) != xsd:boolean
                || ?instability != false
            )
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-060-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/ship> ;
            sh:resultMessage "Where stiffening is necessary for a member in way of a cutout, structural stiffening must be recorded." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Where stiffening is necessary for a member in way of a cutout, structural stiffening must be recorded." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout .
    ?member nltl:stiffeningNecessary ?necessary .
    FILTER (
        DATATYPE(?necessary) = xsd:boolean
        && ?necessary = true
    )
    FILTER NOT EXISTS {
        $this nltl:structuralStiffening ?stiffening .
        FILTER (DATATYPE(?stiffening) = xsd:string)
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-060-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/ship> ] .

