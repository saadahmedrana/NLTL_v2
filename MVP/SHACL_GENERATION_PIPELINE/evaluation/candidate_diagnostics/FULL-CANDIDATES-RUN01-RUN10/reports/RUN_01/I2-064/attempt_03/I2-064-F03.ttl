@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/web> ;
                            sh:resultMessage "The applicable structural member web must satisfy the buckling criteria." ;
                            sh:resultPath nltl:bucklingCriteriaSatisfied ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:n28fa81ed15a54e2f8c67a26a6f898c30b8 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/web> ;
                            sh:resultMessage "The applicable structural member web must satisfy the buckling criteria." ;
                            sh:resultPath nltl:bucklingCriteriaSatisfied ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n28fa81ed15a54e2f8c67a26a6f898c30b8 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/member> ;
                    sh:resultMessage "Value does not conform to Shape gen:StructuralMemberWebShape. See details for more information." ;
                    sh:resultPath nltl:hasStructuralMemberWeb ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node gen:StructuralMemberWebShape ;
                            sh:path nltl:hasStructuralMemberWeb ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/web> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/ship> ;
            sh:resultMessage "The applicable ship must provide yield strength as a decimal MegaPascal quantity." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The applicable ship must provide yield strength as a decimal MegaPascal quantity." ;
                    sh:minCount 1 ;
                    sh:node gen:StressQuantityShape ;
                    sh:path nltl:yieldStrength ] ] .

_:n28fa81ed15a54e2f8c67a26a6f898c30b8 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The applicable structural member web must satisfy the buckling criteria." ;
    sh:minCount 1 ;
    sh:path nltl:bucklingCriteriaSatisfied .

