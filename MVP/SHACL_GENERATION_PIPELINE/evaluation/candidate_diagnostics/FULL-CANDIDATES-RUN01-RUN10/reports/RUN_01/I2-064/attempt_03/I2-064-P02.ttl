@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/ship> ;
            sh:resultMessage "The applicable ship must provide yield strength as a decimal MegaPascal quantity." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The applicable ship must provide yield strength as a decimal MegaPascal quantity." ;
                    sh:minCount 1 ;
                    sh:node gen:StressQuantityShape ;
                    sh:path nltl:yieldStrength ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/calculation> ;
                    sh:resultMessage "The calculation case must explicitly identify the linear calculation method." ;
                    sh:resultPath nltl:calculationMethod ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue nltl:linearCalculationMethodValue ;
                            sh:message "The calculation case must explicitly identify the linear calculation method." ;
                            sh:minCount 1 ;
                            sh:path nltl:calculationMethod ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/ship> ;
            sh:resultMessage "The ship must provide a calculation case using the linear calculation method." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a calculation case using the linear calculation method." ;
                    sh:minCount 1 ;
                    sh:node gen:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/calculation> ] .

