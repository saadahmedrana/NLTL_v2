@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-F01/ship> ;
            sh:resultMessage "A ship designed to operate in at least thin first-year ice with possible old-ice inclusions must be category B unless it is category A." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO002ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-F01/ship> ] .

