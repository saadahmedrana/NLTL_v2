@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F03/ship> ;
            sh:resultMessage "A ship must declare an allowed design ice condition: open water or ice conditions less severe than categories A and B." ;
            sh:resultPath nltl:designIceCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:openWaterIceCondition nltl:iceConditionLessSevereThanCategoryAAndB ) ;
                    sh:message "A ship must declare an allowed design ice condition: open water or ice conditions less severe than categories A and B." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:designIceCondition ] ] .

