@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F01/ship> ;
            sh:resultMessage "When the design ice condition is open water or less severe than categories A and B, shipCategory must be exactly polarShipCategoryC." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the design ice condition is open water or less severe than categories A and B, shipCategory must be exactly polarShipCategoryC." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:designIceCondition ?iceCondition .
                FILTER (
                    ?iceCondition = nltl:openWaterIceCondition ||
                    ?iceCondition = nltl:iceConditionLessSevereThanCategoryAAndB
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:shipCategory nltl:polarShipCategoryC .
                    }
                    ||
                    EXISTS {
                        $this nltl:shipCategory ?category .
                        FILTER (?category != nltl:polarShipCategoryC)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_003_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F01/ship> ] .

