@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F02/ship> ;
            sh:resultMessage "Ships meeting the sea-ice, winter-growth, and thickness conditions must be classified as first-year ice." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Ships meeting the sea-ice, winter-growth, and thickness conditions must be classified as first-year ice." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceOriginType nltl:seaIceOrigin ;
                       nltl:iceThickness ?thickness ;
                       nltl:winterGrowthCount ?growth .

                ?thickness qudt:numericValue ?thicknessValue ;
                           qudt:unit unit:M .

                FILTER (
                    datatype(?thicknessValue) = xsd:decimal &&
                    ?thicknessValue >= "0.3"^^xsd:decimal &&
                    ?thicknessValue <= "2.0"^^xsd:decimal
                )

                FILTER (
                    datatype(?growth) = xsd:integer &&
                    ?growth <= 1
                )

                FILTER NOT EXISTS {
                    $this nltl:iceTypeClassification nltl:firstYearIce .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-004> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F02/ship> ] .

