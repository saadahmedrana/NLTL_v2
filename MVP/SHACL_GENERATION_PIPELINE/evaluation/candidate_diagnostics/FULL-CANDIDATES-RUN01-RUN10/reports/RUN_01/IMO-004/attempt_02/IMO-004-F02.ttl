@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F02/ship> ;
            sh:resultMessage "When the origin is sea ice, winter growth is at most one, and thickness is between 0.3 m and 2.0 m, the classification must contain first-year ice and no other classification." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the origin is sea ice, winter growth is at most one, and thickness is between 0.3 m and 2.0 m, the classification must contain first-year ice and no other classification." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceOriginType nltl:seaIceOrigin ;
           nltl:winterGrowthCount ?growth ;
           nltl:iceThickness ?thickness .
    ?thickness qudt:numericValue ?thickValue ;
               qudt:unit unit:M .
    FILTER(
        ?growth <= "1"^^xsd:integer &&
        ?thickValue >= "0.3"^^xsd:decimal &&
        ?thickValue <= "2.0"^^xsd:decimal
    )
    FILTER(
        NOT EXISTS {
            $this nltl:iceTypeClassification nltl:firstYearIce
        }
        ||
        EXISTS {
            $this nltl:iceTypeClassification ?classification .
            FILTER(?classification != nltl:firstYearIce)
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_004_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F02/ship> ] .

