@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-F01/ship> ;
            sh:resultMessage "A ship classified as thin first-year ice must provide ice thickness from 0.3 m through 0.7 m using a decimal value and the metre unit." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A ship classified as thin first-year ice must provide ice thickness from 0.3 m through 0.7 m using a decimal value and the metre unit." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:iceTypeClassification nltl:thinFirstYearIce .
    FILTER (
        NOT EXISTS {
            $this nltl:iceThickness ?anyThickness .
        }
        ||
        EXISTS {
            $this nltl:iceThickness ?thickness .
            FILTER NOT EXISTS {
                ?thickness qudt:numericValue ?value .
                ?thickness qudt:unit unit:M .
                FILTER (
                    datatype(?value) = xsd:decimal &&
                    ?value >= 0.3 &&
                    ?value <= 0.7
                )
            }
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-008_ThinFirstYearIceThicknessShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-F01/ship> ] .

