@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F01/ship> ;
            sh:resultMessage "For bergy waters, land-origin ice concentration must be below 1/10 and total ice concentration must not exceed 1/10, both expressed as dimensionless quantities." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_009_BergyWaters> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F01/ship> ] .

