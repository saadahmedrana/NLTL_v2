@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F02/ship> ;
            sh:resultMessage "When iceCondition is 'bergy waters', land-origin ice concentration must be less than 1 and total ice concentration must be at most 1, with dimensionless decimal quantities." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When iceCondition is 'bergy waters', land-origin ice concentration must be less than 1 and total ice concentration must be at most 1, with dimensionless decimal quantities." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceCondition ?condition .
                FILTER (?condition = "bergy waters"^^xsd:string)

                FILTER NOT EXISTS {
                    $this nltl:landOriginIceConcentration ?landQuantity .
                    ?landQuantity a qudt:QuantityValue ;
                        qudt:numericValue ?landValue ;
                        qudt:unit unit:UNITLESS .

                    $this nltl:totalIceConcentration ?totalQuantity .
                    ?totalQuantity a qudt:QuantityValue ;
                        qudt:numericValue ?totalValue ;
                        qudt:unit unit:UNITLESS .

                    FILTER (
                        datatype(?landValue) = xsd:decimal &&
                        datatype(?totalValue) = xsd:decimal &&
                        ?landValue < 1 &&
                        ?totalValue <= 1
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO-009-BergyWatersShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F02/ship> ] .

