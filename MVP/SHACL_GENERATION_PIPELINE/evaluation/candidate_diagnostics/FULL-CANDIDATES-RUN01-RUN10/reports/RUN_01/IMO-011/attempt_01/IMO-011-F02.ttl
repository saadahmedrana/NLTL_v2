@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F02/obs1> ;
                    sh:resultMessage "Each daily low-temperature observation must carry one daily low-temperature value in degrees Celsius." ;
                    sh:resultPath nltl:dailyLowTemperature ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each daily low-temperature observation must carry one daily low-temperature value in degrees Celsius." ;
                            sh:minCount 1 ;
                            sh:node nltlgen:IMO_011_DailyLowTemperatureQuantityShape ;
                            sh:path nltl:dailyLowTemperature ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F02/ship> ;
            sh:resultMessage "Each ship must provide dated daily low-temperature observations with daily low-temperature values." ;
            sh:resultPath nltl:hasDailyLowTemperatureObservation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:dailyLowTemperatureObservation ;
                    sh:message "Each ship must provide dated daily low-temperature observations with daily low-temperature values." ;
                    sh:minCount 1 ;
                    sh:node nltlgen:IMO_011_DailyLowTemperatureObservationShape ;
                    sh:path nltl:hasDailyLowTemperatureObservation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F02/obs1> ] .

