@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F04/ship> ;
            sh:resultMessage "The ship must provide one data period in years." ;
            sh:resultPath nltl:dataPeriod ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one data period in years." ;
                    sh:minCount 1 ;
                    sh:node nltlgen:IMO_011_DataPeriodQuantityShape ;
                    sh:path nltl:dataPeriod ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in nltlgen:IMO_011_DataPeriodAtLeastTenYearsShape , nltlgen:IMO_011_DataPeriodBelowTenYearsShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:IMO_011_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F04/ship> ] .

