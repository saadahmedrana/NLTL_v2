@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/ship> ;
            sh:resultMessage "Each Polar Ship Certificate validity, survey, and endorsement date shall match a correspondingly categorized SOLAS certificate schedule date." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each Polar Ship Certificate validity, survey, and endorsement date shall match a correspondingly categorized SOLAS certificate schedule date." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasSolasCertificateSchedule ?schedule .
                FILTER (
                    EXISTS {
                        $this nltl:polarCertificateValidityDates ?date .
                        FILTER NOT EXISTS {
                            ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                            ?record nltl:certificateScheduleDateType nltl:validityDateCategory ;
                                    nltl:certificateScheduleDate ?date .
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:surveyDates ?date .
                        FILTER NOT EXISTS {
                            ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                            ?record nltl:certificateScheduleDateType nltl:surveyDateCategory ;
                                    nltl:certificateScheduleDate ?date .
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:endorsementDates ?date .
                        FILTER NOT EXISTS {
                            ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                            ?record nltl:certificateScheduleDateType nltl:endorsementDateCategory ;
                                    nltl:certificateScheduleDate ?date .
                        }
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO017ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/ship> ] .

