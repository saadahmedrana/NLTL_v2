@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-018-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"The ice capability methodology applicability decision must be false for the non-applicable branch.\") ; sh:path nltl:iceCapabilityMethodologyApplicable ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The ice capability methodology applicability decision must be true for the applicable branch.\") ; sh:path nltl:iceCapabilityMethodologyApplicable ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When the ice capability methodology is applicable, Administration acceptance must be approved.\") ; sh:path nltl:administrationAcceptanceStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When the ice capability methodology is applicable, the certificate must reference the methodology.\") ; sh:path nltl:certificateMethodologyReferencePresent ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltl:IMO_018_IceCapabilityMethodologyShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-018-F01/ship> ] .

