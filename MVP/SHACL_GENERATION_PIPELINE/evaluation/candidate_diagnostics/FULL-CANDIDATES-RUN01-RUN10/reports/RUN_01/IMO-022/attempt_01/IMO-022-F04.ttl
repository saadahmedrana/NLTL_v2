@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-022-F04/ship> ;
            sh:resultMessage "The Polar Water Operational Manual shall reference the operational assessment required under paragraph 1.5." ;
            sh:resultPath nltl:operationalAssessmentReference ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The Polar Water Operational Manual shall reference the operational assessment required under paragraph 1.5." ;
                    sh:minCount 1 ;
                    sh:path nltl:operationalAssessmentReference ] ] .

