@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-026-F02/ship> ;
            sh:resultMessage "The ice capability methodology applicability flag must be supplied as a boolean." ;
            sh:resultPath nltl:iceCapabilityMethodologyApplicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "The ice capability methodology applicability flag must be supplied as a boolean." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceCapabilityMethodologyApplicable ] ] .

