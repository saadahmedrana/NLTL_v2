@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship must identify ice operation as not applicable when the conditional PWOM provisions do not apply.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceOperationApplicable ] ] , [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:escortRequirementsPresent ], [ sh:datatype xsd:string ; sh:message Literal(\"Independent-operation limitations must be specified when escort or icebreaker assistance is not applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:independentOperationLimits ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:escortRequirementsPresent ], [ sh:datatype xsd:string ; sh:message Literal(\"Escort or icebreaker-assistance requirements and escorted-operation limitations must be specified when escort is applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:escortedOperationLimits ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Ice-operation monitoring and safety procedures must be present when ice operation is applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceSafetyMonitoringProcedurePresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship must identify ice operation as applicable before the conditional PWOM provisions can be assessed.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceOperationApplicable ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-030> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F04/ship> ] .

