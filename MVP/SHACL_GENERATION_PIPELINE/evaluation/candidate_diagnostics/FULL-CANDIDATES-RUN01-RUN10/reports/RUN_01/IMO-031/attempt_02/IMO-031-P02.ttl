@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-P02/ship> ;
            sh:resultMessage "Value Literal(\"recognized organization accepted by the Administration\", datatype=xsd:string) not in list ['Literal(\"Administration\")', 'Literal(\"recognized organization accepted by the Administration\")']" ;
            sh:resultPath nltl:approvingAuthority ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "Administration" "recognized organization accepted by the Administration" ) ;
                    sh:path nltl:approvingAuthority ] ;
            sh:value "recognized organization accepted by the Administration"^^xsd:string ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-P02/ship> ;
            sh:resultMessage "Value Literal(\"another standard offering an equivalent level of safety\", datatype=xsd:string) not in list ['Literal(\"another standard offering an equivalent level of safety\")', 'Literal(\"standard acceptable to the Organization\")']" ;
            sh:resultPath nltl:approvalStandard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "standard acceptable to the Organization" "another standard offering an equivalent level of safety" ) ;
                    sh:path nltl:approvalStandard ] ;
            sh:value "another standard offering an equivalent level of safety"^^xsd:string ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-P02/ship> ;
            sh:resultMessage "Each exposed-structure material must be linked to approved evidence identifying an authorized approving authority, an accepted approval standard, the approved evidence state, and the polar service temperature basis." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each exposed-structure material must be linked to approved evidence identifying an authorized approving authority, an accepted approval standard, the approved evidence state, and the polar service temperature basis." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:exposedStructureMaterial ?material .
                FILTER NOT EXISTS {
                    $this nltl:approvalStandard ?standard ;
                          nltl:approvingAuthority ?authority ;
                          nltl:materialApprovalStatus nltl:evidenceStateApproved ;
                          nltl:polarServiceTemperature ?pst ;
                          nltl:hasEvidence ?evidence .
                    ?pst rdf:type qudt:QuantityValue ;
                         qudt:numericValue ?numeric ;
                         qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
                    ?evidence rdf:type nltl:evidenceArtifact .
                    FILTER (
                        datatype(?numeric) = xsd:decimal &&
                        ?standard IN (
                            "standard acceptable to the Organization",
                            "another standard offering an equivalent level of safety"
                        ) &&
                        ?authority IN (
                            "Administration",
                            "recognized organization accepted by the Administration"
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_031_MaterialApprovalShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-P02/ship> ] .

