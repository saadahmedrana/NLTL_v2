@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F03/ship> ;
            sh:resultMessage "For ice accretion likely, discontinuous projected area must equal 1.05 times the continuous projected area and discontinuous static moment must equal 1.10 times the continuous static moment within relative tolerance 1e-6 plus an absolute fallback of 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For ice accretion likely, discontinuous projected area must equal 1.05 times the continuous projected area and discontinuous static moment must equal 1.10 times the continuous static moment within relative tolerance 1e-6 plus an absolute fallback of 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX q: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely ?likely ;
                      nltl:continuousSurfaceProjectedArea ?continuousAreaNode ;
                      nltl:discontinuousSurfaceProjectedArea ?discontinuousAreaNode ;
                      nltl:continuousSurfaceStaticMoment ?continuousMomentNode ;
                      nltl:discontinuousSurfaceStaticMoment ?discontinuousMomentNode .

                ?continuousAreaNode q:numericValue ?continuousArea .
                ?discontinuousAreaNode q:numericValue ?discontinuousArea .
                ?continuousMomentNode q:numericValue ?continuousMoment .
                ?discontinuousMomentNode q:numericValue ?discontinuousMoment .

                FILTER (?likely = "true"^^xsd:boolean)

                BIND (?continuousArea * 1.05 AS ?expectedArea)
                BIND (?continuousMoment * 1.10 AS ?expectedMoment)

                FILTER (
                    ABS(?discontinuousArea - ?expectedArea) >
                    (ABS(?expectedArea) * 0.000001 + 0.000001)
                    ||
                    ABS(?discontinuousMoment - ?expectedMoment) >
                    (ABS(?expectedMoment) * 0.000001 + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_033_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F03/ship> ] .

