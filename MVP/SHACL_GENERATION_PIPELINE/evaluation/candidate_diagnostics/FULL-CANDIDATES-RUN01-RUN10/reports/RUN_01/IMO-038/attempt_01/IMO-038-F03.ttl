@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ;
            sh:resultMessage "Damage extents must satisfy the piecewise longitudinal formula and vertical-position envelope; calculated decimal results are checked with a relative tolerance of 1e-6 and an absolute fallback of 1e-6 m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Damage extents must satisfy the piecewise longitudinal formula and vertical-position envelope; calculated decimal results are checked with a relative tolerance of 1e-6 and an absolute fallback of 1e-6 m." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthNode ;
                      nltl:upperIceWaterlineDraught ?draughtNode ;
                      nltl:longitudinalDamageExtent ?longitudinalNode ;
                      nltl:verticalDamageExtent ?verticalNode ;
                      nltl:selectedVerticalDamagePosition ?positionNode .
                ?lengthNode qudt:numericValue ?length .
                ?draughtNode qudt:numericValue ?draught .
                ?longitudinalNode qudt:numericValue ?longitudinal .
                ?verticalNode qudt:numericValue ?vertical .
                ?positionNode qudt:numericValue ?position .
                BIND(IF(?forward = true, 0.045 * ?length, 0.015 * ?length) AS ?expectedLongitudinal)
                BIND(IF((0.20 * ?draught) < ?expectedLongitudinal,
                        0.20 * ?draught,
                        ?expectedLongitudinal) AS ?expectedVertical)
                FILTER(
                    ABS(?longitudinal - ?expectedLongitudinal) >
                    IF(ABS(?expectedLongitudinal) * 0.000001 > 0.000001,
                       ABS(?expectedLongitudinal) * 0.000001,
                       0.000001)
                    ||
                    ABS(?vertical - ?expectedVertical) >
                    IF(ABS(?expectedVertical) * 0.000001 > 0.000001,
                       ABS(?expectedVertical) * 0.000001,
                       0.000001)
                    ||
                    ?position < 0
                    ||
                    ?position > (1.20 * ?draught)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-038> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ;
            sh:resultMessage "The permitted vertical damage-position representation must be provided." ;
            sh:resultPath nltl:allowedVerticalPosition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The permitted vertical damage-position representation must be provided." ;
                    sh:minCount 1 ;
                    sh:path nltl:allowedVerticalPosition ] ] .

