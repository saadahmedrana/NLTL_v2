@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ;
            sh:resultMessage "Longitudinal and vertical damage extents do not satisfy the required piecewise formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Longitudinal and vertical damage extents do not satisfy the required piecewise formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthNode ;
                      nltl:upperIceWaterlineDraught ?draughtNode ;
                      nltl:longitudinalDamageExtent ?longNode ;
                      nltl:verticalDamageExtent ?verticalNode .
                ?lengthNode qudt:numericValue ?length .
                ?draughtNode qudt:numericValue ?draught .
                ?longNode qudt:numericValue ?long .
                ?verticalNode qudt:numericValue ?vertical .
                BIND(IF(?forward = true, 0.045 * ?length, 0.015 * ?length) AS ?expectedLong)
                BIND(IF(0.20 * ?draught < ?expectedLong,
                        0.20 * ?draught,
                        ?expectedLong) AS ?expectedVertical)
                FILTER (
                    ABS(?long - ?expectedLong) >
                    IF(0.000001 * ABS(?expectedLong) > 0.000000001,
                       0.000001 * ABS(?expectedLong),
                       0.000000001)
                    ||
                    ABS(?vertical - ?expectedVertical) >
                    IF(0.000001 * ABS(?expectedVertical) > 0.000000001,
                       0.000001 * ABS(?expectedVertical),
                       0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_038_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ] .

