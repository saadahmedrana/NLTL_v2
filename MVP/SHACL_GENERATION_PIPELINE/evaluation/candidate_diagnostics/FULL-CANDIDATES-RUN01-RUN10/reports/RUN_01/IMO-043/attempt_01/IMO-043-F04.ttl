@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F04/ship> ;
            sh:resultMessage "The ship shall record hazard protection coverage." ;
            sh:resultPath nltl:hazardProtectionCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n789f99d7c0734132abe7578733723650b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F04/mainMachinery> ;
            sh:resultMessage "Each machinery installation shall identify its associated equipment." ;
            sh:resultPath nltl:hasAssociatedEquipment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n789f99d7c0734132abe7578733723650b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F04/ship> ;
            sh:resultMessage "The ship shall record hazard protection coverage." ;
            sh:resultPath nltl:hazardProtectionCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n789f99d7c0734132abe7578733723650b1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F04/mainMachinery> ;
                    sh:resultMessage "Each machinery installation shall identify its associated equipment." ;
                    sh:resultPath nltl:hasAssociatedEquipment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n789f99d7c0734132abe7578733723650b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F04/ship> ;
            sh:resultMessage "Each machinery installation shall satisfy the required hazard-coverage constraints." ;
            sh:resultPath nltl:hasMachineryInstallation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:machineryInstallationItem ;
                    sh:message "Each machinery installation shall satisfy the required hazard-coverage constraints." ;
                    sh:node <urn:nltl:generated-shape:IMO-043_MachineryInstallationShape> ;
                    sh:path nltl:hasMachineryInstallation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F04/mainMachinery> ] .

_:n789f99d7c0734132abe7578733723650b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall record hazard protection coverage." ;
    sh:minCount 1 ;
    sh:path nltl:hazardProtectionCoverage .

_:n789f99d7c0734132abe7578733723650b3 sh:class nltl:associatedEquipmentItem ;
    sh:message "Each machinery installation shall identify its associated equipment." ;
    sh:minCount 1 ;
    sh:path nltl:hasAssociatedEquipment .

