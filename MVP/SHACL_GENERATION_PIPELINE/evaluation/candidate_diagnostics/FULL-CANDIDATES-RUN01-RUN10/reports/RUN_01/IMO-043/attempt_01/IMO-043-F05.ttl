_:n789f99d7c0734132abe7578733723650b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall record hazard protection coverage." ;
    sh:minCount 1 ;
    sh:path nltl:hazardProtectionCoverage .

_:n789f99d7c0734132abe7578733723650b10 sh:class nltl:evidenceArtifact ;
    sh:message "Each machinery installation shall have hazard-protection evidence." ;
    sh:minCount 1 ;
    sh:path nltl:hasHazardProtectionEvidence .

_:n789f99d7c0734132abe7578733723650b4 sh:hasValue nltl:iceAccretionHazard ;
    sh:message "Ice accretion shall be represented as an applicable hazard for the machinery installation." ;
    sh:minCount 1 ;
    sh:path nltl:hasApplicableHazard .

