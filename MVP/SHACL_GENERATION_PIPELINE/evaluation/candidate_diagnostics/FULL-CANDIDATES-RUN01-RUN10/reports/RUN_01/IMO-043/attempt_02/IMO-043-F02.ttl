    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachineryEquipment> ;
                    sh:resultMessage "Each associated equipment item shall be linked to a machinery installation that covers all six specified hazards and has hazard protection evidence." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:n43aecbb75007476ba1e3a5b1e01d485eb10 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:IMO_043_AssociatedEquipmentShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachineryEquipment> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachinery> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO_043_AssociatedEquipmentShape. See details for more information." ;
            sh:resultPath nltl:hasAssociatedEquipment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n43aecbb75007476ba1e3a5b1e01d485eb9 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachineryEquipment> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachineryEquipment> ;
                            sh:resultMessage "Each associated equipment item shall be linked to a machinery installation that covers all six specified hazards and has hazard protection evidence." ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraint _:n43aecbb75007476ba1e3a5b1e01d485eb10 ;
                            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                            sh:sourceShape gen:IMO_043_AssociatedEquipmentShape ;
                            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachineryEquipment> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachinery> ;
                    sh:resultMessage "Value does not conform to Shape gen:IMO_043_AssociatedEquipmentShape. See details for more information." ;
                    sh:resultPath nltl:hasAssociatedEquipment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n43aecbb75007476ba1e3a5b1e01d485eb9 ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachineryEquipment> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachinery> ;
                    sh:resultMessage "The machinery installation shall have hazard protection evidence." ;
                    sh:resultPath nltl:hasHazardProtectionEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n43aecbb75007476ba1e3a5b1e01d485eb8 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO_043_MachineryInstallationShape. See details for more information." ;
            sh:resultPath nltl:hasMachineryInstallation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:IMO_043_MachineryInstallationShape ;
                    sh:path nltl:hasMachineryInstallation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachinery> ],
        [ a sh:ValidationResult ;
