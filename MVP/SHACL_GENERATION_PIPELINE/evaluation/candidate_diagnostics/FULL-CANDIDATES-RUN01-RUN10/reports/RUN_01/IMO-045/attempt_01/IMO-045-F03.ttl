@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship must explicitly indicate that no machinery seawater supply is present when this requirement is not applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:machinerySeawaterSupply ] , [ sh:and ( [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:machinerySeawaterSupply ] [ sh:or ( [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each machinery seawater supply must indicate that ice ingestion prevention is present, or provide approved alternative-functionality evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceIngestionPreventionPresent ] [ sh:hasValue nltl:evidenceStateApproved ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The alternative functionality arrangement for a machinery seawater supply must have approved status.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:alternateFunctionalityArrangementApprovalStatus ] ) ] ) ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_045_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F03/ship> ] .

