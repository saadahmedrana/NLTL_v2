@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F02/ship> ;
            sh:resultMessage "When machinery seawater supply is true, ice-ingestion prevention must be true or the alternate functionality arrangement must be approved." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When machinery seawater supply is true, ice-ingestion prevention must be true or the alternate functionality arrangement must be approved." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:machinerySeawaterSupply ?supply .
                FILTER ( ?supply = "true"^^xsd:boolean )
                FILTER NOT EXISTS {
                    $this nltl:iceIngestionPreventionPresent ?prevention .
                    FILTER ( ?prevention = "true"^^xsd:boolean )
                }
                FILTER NOT EXISTS {
                    $this nltl:alternateFunctionalityArrangementApprovalStatus
                        nltl:evidenceStateApproved .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-045> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F02/ship> ] .

