@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-P04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:IMO049CategoryAShape , gen:IMO049CategoryBShape , gen:IMO049IceStrengthenedCategoryCShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO049ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-P04/ship> ] .

