@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in <urn:nltl:generated-shape:IMO-049-CategoryABBranch> , <urn:nltl:generated-shape:IMO-049-CategoryCStrengthenedBranch> , <urn:nltl:generated-shape:IMO-049-CategoryCNotStrengthenedBranch>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-049-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/ship> ] .

