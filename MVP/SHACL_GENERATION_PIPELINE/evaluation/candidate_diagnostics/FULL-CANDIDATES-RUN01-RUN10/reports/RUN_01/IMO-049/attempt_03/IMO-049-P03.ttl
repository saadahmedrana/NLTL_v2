@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-P03/ship> ;
            sh:resultMessage "The ship must provide the applicable polar category and ice-strengthening branch information." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-049> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-P03/ship> ] .

