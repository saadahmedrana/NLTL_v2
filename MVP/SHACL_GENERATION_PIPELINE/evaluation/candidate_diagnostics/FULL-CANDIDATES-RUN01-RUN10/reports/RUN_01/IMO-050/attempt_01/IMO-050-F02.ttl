@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-050-F02/ship> ;
            sh:resultMessage "If a fire safety component is exposed, ice and snow protection must be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO_050_FireSafetyExposureProtectionShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-050-F02/ship> ] .

