@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-050-F03/ship> ;
            sh:resultMessage "Each ship must state whether a fire safety component is exposed." ;
            sh:resultPath nltl:fireSafetyComponentExposed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Each ship must state whether a fire safety component is exposed." ;
                    sh:minCount 1 ;
                    sh:path nltl:fireSafetyComponentExposed ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-050-F03/ship> ;
            sh:resultMessage "If a fire safety component is exposed, ice and snow protection must be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO_050_FireSafetyExposureProtectionShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-050-F03/ship> ] .

