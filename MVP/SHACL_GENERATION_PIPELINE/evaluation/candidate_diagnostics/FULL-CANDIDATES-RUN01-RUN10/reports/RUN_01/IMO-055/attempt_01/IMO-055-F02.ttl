@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-F02/ship> ;
            sh:resultMessage "An exposed isolating, pressure, or vacuum valve must remain continuously accessible." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "An exposed isolating, pressure, or vacuum valve must remain continuously accessible." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:valveExposed true ;
                      nltl:valveType ?valveType .
                FILTER (?valveType IN ("isolating"^^xsd:string,
                                       "pressure"^^xsd:string,
                                       "vacuum"^^xsd:string))
                FILTER NOT EXISTS {
                    $this nltl:continuouslyAccessible true
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-055> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-F02/ship> ] .

