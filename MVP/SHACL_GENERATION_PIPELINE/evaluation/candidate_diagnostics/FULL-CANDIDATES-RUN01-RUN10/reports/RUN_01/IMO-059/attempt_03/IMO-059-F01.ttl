@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F01/ship> ;
            sh:resultMessage "Each linked firefighter outfit must be an equipment item with storage locations that are physical locations classified as warm." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each linked firefighter outfit must be an equipment item with storage locations that are physical locations classified as warm." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>

            SELECT $this
            WHERE {
                $this nltl:hasFirefighterOutfit ?outfit .
                FILTER (
                    NOT EXISTS {
                        ?outfit a nltl:firefighterOutfitItem .
                        ?outfit a nltl:equipmentItem .
                    }
                    ||
                    NOT EXISTS {
                        ?outfit nltl:hasStorageLocation ?location .
                    }
                    ||
                    EXISTS {
                        ?outfit nltl:hasStorageLocation ?location .
                        FILTER NOT EXISTS {
                            ?location a nltl:physicalStorageLocation .
                            ?location nltl:storageTemperatureClass nltl:warmStorageLocation .
                        }
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_059_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F01/ship> ] .

