@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F04/outfit2> ;
            sh:resultMessage "Each firefighter outfit must have a storage location classified as warm." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each firefighter outfit must have a storage location classified as warm." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                ?ship a nltl:ship ;
                      nltl:hasFirefighterOutfit $this .
                FILTER NOT EXISTS {
                    $this nltl:hasStorageLocation ?location .
                    ?location a nltl:physicalStorageLocation ;
                              nltl:storageTemperatureClass nltl:warmStorageLocation .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_059_EquipmentItemShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F04/outfit2> ] .

