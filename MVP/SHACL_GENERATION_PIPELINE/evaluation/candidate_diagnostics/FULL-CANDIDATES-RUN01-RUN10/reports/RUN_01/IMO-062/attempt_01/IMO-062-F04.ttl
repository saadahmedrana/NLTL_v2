@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/ship> ;
            sh:resultMessage "The ship shall document ice and snow mitigation coverage." ;
            sh:resultPath nltl:iceSnowMitigationCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nf9a28c780ae24b4b8e7b09154fcbdd8fb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/ship> ;
            sh:resultMessage "The ship shall document ice and snow mitigation coverage." ;
            sh:resultPath nltl:iceSnowMitigationCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf9a28c780ae24b4b8e7b09154fcbdd8fb1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/route1> ;
                    sh:resultMessage "Each exposed escape route shall be accessible." ;
                    sh:resultPath nltl:escapeRouteAccessibleStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nf9a28c780ae24b4b8e7b09154fcbdd8fb3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/route1> ;
                    sh:resultMessage "Each exposed escape route shall be safe." ;
                    sh:resultPath nltl:escapeRouteSafeStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nf9a28c780ae24b4b8e7b09154fcbdd8fb4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/route1> ;
                    sh:resultMessage "Each exposed escape route shall be safe." ;
                    sh:resultPath nltl:escapeRouteSafeStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nf9a28c780ae24b4b8e7b09154fcbdd8fb4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/route1> ;
                    sh:resultMessage "Each exposed escape route shall be accessible." ;
                    sh:resultPath nltl:escapeRouteAccessibleStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nf9a28c780ae24b4b8e7b09154fcbdd8fb3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-062-ExposedEscapeRouteShape>. See details for more information." ;
            sh:resultPath nltl:hasExposedEscapeRoute ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-062-ExposedEscapeRouteShape> ;
                    sh:path nltl:hasExposedEscapeRoute ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/route1> ] .

_:nf9a28c780ae24b4b8e7b09154fcbdd8fb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship shall document ice and snow mitigation coverage." ;
    sh:minCount 1 ;
    sh:path nltl:iceSnowMitigationCoverage .

_:nf9a28c780ae24b4b8e7b09154fcbdd8fb3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "Each exposed escape route shall be accessible." ;
    sh:minCount 1 ;
    sh:path nltl:escapeRouteAccessibleStatus .

_:nf9a28c780ae24b4b8e7b09154fcbdd8fb4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "Each exposed escape route shall be safe." ;
    sh:minCount 1 ;
    sh:path nltl:escapeRouteSafeStatus .

