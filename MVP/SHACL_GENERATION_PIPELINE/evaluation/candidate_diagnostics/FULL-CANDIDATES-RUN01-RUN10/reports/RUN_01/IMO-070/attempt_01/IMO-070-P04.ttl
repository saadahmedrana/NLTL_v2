@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P04/ship> ;
            sh:resultMessage "For an applicable passenger ship, size compatibility must be true and every linked person on board must have an immersion suit or thermal protective aid assignment." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an applicable passenger ship, size compatibility must be true and every linked person on board must have an immersion suit or thermal protective aid assignment." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

            SELECT $this
            WHERE {
                FILTER (
                    EXISTS {
                        $this rdf:type nltl:passengerShip .
                    }
                    ||
                    EXISTS {
                        $this nltl:shipType "passenger_ship" .
                    }
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:sizeCompatibilityStatus true .
                    }
                    ||
                    EXISTS {
                        $this nltl:hasPersonOnBoardMember ?person .
                        FILTER NOT EXISTS {
                            ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment .
                            ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment .
                            ?equipment rdf:type ?equipmentType .
                            FILTER (
                                ?equipmentType = nltl:immersionSuitEquipment
                                ||
                                ?equipmentType = nltl:thermalProtectiveAidEquipment
                            )
                        }
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-070> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P04/ship> ;
            sh:resultMessage "A ship type is required to determine whether the passenger-ship rule applies." ;
            sh:resultPath nltl:shipType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "A ship type is required to determine whether the passenger-ship rule applies." ;
                    sh:minCount 1 ;
                    sh:path nltl:shipType ] ] .

