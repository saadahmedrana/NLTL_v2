@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F02/ship> ;
            sh:resultMessage "For an applicable passenger ship, each person on board must have an immersion suit or thermal protective aid assignment, and size compatibility must be true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an applicable passenger ship, each person on board must have an immersion suit or thermal protective aid assignment, and size compatibility must be true." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    FILTER (
        EXISTS { $this a nltl:passengerShip }
        ||
        EXISTS {
            $this nltl:shipType "passenger_ship"^^xsd:string
        }
    )
    FILTER (
        NOT EXISTS {
            $this nltl:sizeCompatibilityStatus true
        }
        ||
        EXISTS {
            $this nltl:hasPersonOnBoardMember ?person
            FILTER NOT EXISTS {
                ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment .
                ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment .
                ?equipment a ?equipmentKind .
                FILTER (
                    ?equipmentKind IN (
                        nltl:immersionSuitEquipment,
                        nltl:thermalProtectiveAidEquipment
                    )
                )
            }
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_070_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F02/ship> ] .

