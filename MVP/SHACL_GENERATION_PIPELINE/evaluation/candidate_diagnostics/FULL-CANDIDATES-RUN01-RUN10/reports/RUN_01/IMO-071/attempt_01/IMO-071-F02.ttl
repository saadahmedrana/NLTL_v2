@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:message Literal(\"The immersion-suit applicability value must be recorded.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:immersionSuitRequired ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"When immersion suits are not required, the applicability value must be false.\") ; sh:path nltl:immersionSuitRequired ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When immersion suits are required, the applicability value must be true.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:immersionSuitRequired ], [ sh:hasValue nltl:insulatedImmersionSuit ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Where immersion suits are required, their type must be insulated.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:immersionSuitTypeClassification ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_071_ImmersionSuitTypeShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F02/ship> ] .

