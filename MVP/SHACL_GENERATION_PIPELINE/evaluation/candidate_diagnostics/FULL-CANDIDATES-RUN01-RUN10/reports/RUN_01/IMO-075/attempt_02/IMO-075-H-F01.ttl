@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F01/ship> ;
            sh:resultMessage "When personal or group survival equipment is required, available survival equipment capacity must be at least 110 percent of the persons on board." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When personal or group survival equipment is required, available survival equipment capacity must be at least 110 percent of the persons on board." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:personalOrGroupSurvivalEquipmentRequired true ;
                      nltl:personsOnBoard ?persons ;
                      nltl:availableSurvivalEquipmentCapacity ?capacity .
                FILTER (10 * ?capacity < 11 * ?persons)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_075_SurvivalEquipmentCapacityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F01/ship> ] .

