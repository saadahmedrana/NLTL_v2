@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F01/ship> ;
            sh:resultMessage "Category A or B ships constructed on or after 1 January 2017 shall have enclosed bridge wings or approved bridge-wing protection design." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO085Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F01/ship> ] .

