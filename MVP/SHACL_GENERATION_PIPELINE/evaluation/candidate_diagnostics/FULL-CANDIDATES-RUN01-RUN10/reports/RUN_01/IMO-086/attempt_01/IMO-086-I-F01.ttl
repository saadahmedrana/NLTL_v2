@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/heading1> ;
                    sh:resultMessage "Each non-magnetic heading means shall be independent from another distinct non-magnetic heading means belonging to the same ship." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Each non-magnetic heading means shall be independent from another distinct non-magnetic heading means belonging to the same ship." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    ?ship nltl:hasNonMagneticHeadingMeans $this .
                    $this nltl:independentFromHeadingMeans ?other .
                    ?ship nltl:hasNonMagneticHeadingMeans ?other .
                    FILTER (?other != $this)
                }
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:IMO_086_HeadingMeansShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/heading1> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/heading1> ;
                    sh:resultMessage "Each non-magnetic heading means shall have an independence relation to another non-magnetic heading means." ;
                    sh:resultPath nltl:independentFromHeadingMeans ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:nonMagneticHeadingMeans ;
                            sh:message "Each non-magnetic heading means shall have an independence relation to another non-magnetic heading means." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:independentFromHeadingMeans ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic heading means, each satisfying the required power and independence relationships." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nc7ad68d75f364e1bb90fb5baa47c7364b1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/heading1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic heading means, each satisfying the required power and independence relationships." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc7ad68d75f364e1bb90fb5baa47c7364b1 ] .

_:nc7ad68d75f364e1bb90fb5baa47c7364b1 sh:class nltl:nonMagneticHeadingMeans ;
    sh:message "The ship shall have at least two non-magnetic heading means, each satisfying the required power and independence relationships." ;
    sh:minCount 2 ;
    sh:node gen:IMO_086_HeadingMeansShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasNonMagneticHeadingMeans .

