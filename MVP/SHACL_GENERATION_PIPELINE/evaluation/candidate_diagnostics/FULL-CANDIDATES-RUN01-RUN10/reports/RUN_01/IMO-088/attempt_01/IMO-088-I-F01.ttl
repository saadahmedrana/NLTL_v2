@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-088-I-F01/ship> ;
            sh:resultMessage "Ships not operating solely in continuous daylight must provide either the required searchlights and coverage or approved alternative visual ice-detection means." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_088_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-088-I-F01/ship> ] .

