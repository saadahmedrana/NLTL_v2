@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipOperatesInLowAirTemperature ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:releasedRescueBoatOrLifeboat ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipOperatesInLowAirTemperature ] ] , [ sh:property [ sh:class nltl:lifeboat ; sh:path nltl:hasLifeboat ], [ sh:class nltl:lifeboat ; sh:path nltl:hasRequiredRescueBoatOrLifeboat ], [ sh:class nltl:otherSurvivalCraft ; sh:path nltl:hasOtherSurvivalCraft ], [ sh:class nltl:survivalCraft ; sh:path nltl:hasSurvivalCraft ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:releasedRescueBoatOrLifeboat ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipOperatesInLowAirTemperature ] ; sh:sparql [ sh:message Literal("Each released rescue boat or lifeboat must carry a ship-to-shore distress-alert device, a location-signal device, and an on-scene transmit/receive communication device.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this (nltl:hasLifeboat|nltl:hasOtherSurvivalCraft|nltl:hasRequiredRescueBoatOrLifeboat) ?craft .
                        FILTER (
                            NOT EXISTS {
                                ?craft nltl:survivalCraftHasShipToShoreDistressAlertDevice ?distressDevice
                            }
                            ||
                            NOT EXISTS {
                                ?craft nltl:survivalCraftHasLocationSignalDevice ?locationDevice
                            }
                            ||
                            NOT EXISTS {
                                ?craft nltl:survivalCraftHasOnSceneCommunicationDevice ?communicationDevice
                            }
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-097> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F03/ship> ] .

