@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F02/ship> ;
            sh:resultMessage "Each ship shall have a polar route plan covering the required voyage-planning topics." ;
            sh:resultPath nltl:hasPolarRoutePlan ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarRoutePlan ;
                    sh:message "Each ship shall have a polar route plan covering the required voyage-planning topics." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-101-PolarRoutePlanShape> ;
                    sh:path nltl:hasPolarRoutePlan ] ] .

