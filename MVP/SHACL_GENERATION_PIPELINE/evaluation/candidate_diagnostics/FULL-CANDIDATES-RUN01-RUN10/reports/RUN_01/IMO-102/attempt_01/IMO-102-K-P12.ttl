@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P12/ship> ;
            sh:resultMessage "Each applicable crew member must have a polar training record whose required and recorded training levels match the 12.3.1 matrix and whose STCW qualification is valid." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each applicable crew member must have a polar training record whose required and recorded training levels match the 12.3.1 matrix and whose STCW qualification is valid." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?crew
            WHERE {
                $this nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType ;
                      nltl:hasCrewMemberInventory ?crew .
                ?crew nltl:polarTrainingCrewRoleClassification ?role .

                BIND(
                    IF(
                        ?ice = nltl:openWaterIceCondition &&
                        (
                            ?shipType = nltl:tankerPolarTrainingShipType ||
                            ?shipType = nltl:passengerShipPolarTrainingShipType
                        ),
                        nltl:basicPolarTrainingLevel,
                        IF(
                            ?ice = nltl:otherWatersIceCondition &&
                            (
                                ?role = nltl:masterPolarTrainingRole ||
                                ?role = nltl:chiefMatePolarTrainingRole
                            ),
                            nltl:advancedPolarTrainingLevel,
                            IF(
                                ?ice = nltl:otherWatersIceCondition &&
                                ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole,
                                nltl:basicPolarTrainingLevel,
                                nltl:polarTrainingNotApplicable
                            )
                        )
                    )
                    AS ?expected
                )

                FILTER(?expected != nltl:polarTrainingNotApplicable)

                FILTER NOT EXISTS {
                    ?crew nltl:hasCrewTrainingRecord ?record ;
                          nltl:hasPolarTrainingRecord ?record .
                    ?record nltl:requiredTrainingLevel ?expected ;
                            nltl:trainingRecordLevel ?expected ;
                            nltl:stcwQualificationValid true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-102-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P12/ship> ] .

