@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F05/ship> ;
            sh:resultMessage "The ship shall record completed PWOM familiarization status." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:maxInclusive true ;
                    sh:message "The ship shall record completed PWOM familiarization status." ;
                    sh:minCount 1 ;
                    sh:minInclusive true ;
                    sh:path nltl:polarWaterOperationalManualFamiliarizationStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F05/crew1> ;
            sh:resultMessage "Each procedure or equipment item relevant to a crew member's assigned duties shall be represented in that crew member's familiarization records." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:n94735d1a8e31485eaad1a7e0889cd170b6 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO104CrewMemberShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F05/crew1> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F05/crew1> ;
                    sh:resultMessage "Each procedure or equipment item relevant to a crew member's assigned duties shall be represented in that crew member's familiarization records." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:n94735d1a8e31485eaad1a7e0889cd170b6 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gs:IMO104CrewMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F05/crew1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:IMO104CrewMemberShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gs:IMO104CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F05/crew1> ] .

_:n94735d1a8e31485eaad1a7e0889cd170b6 a sh:SPARQLConstraint ;
    sh:message "Each procedure or equipment item relevant to a crew member's assigned duties shall be represented in that crew member's familiarization records." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasAssignedDuty ?duty .
                ?duty nltl:hasRelevantPolarWaterOperationalManualItem ?item .
                FILTER NOT EXISTS {
                    $this nltl:hasFamiliarizationRecord ?record .
                    ?record nltl:familiarizationRecordItem ?item .
                }
            }
        """ .

