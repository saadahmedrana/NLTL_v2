@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/crew1> ;
                    sh:resultMessage "Each crew member shall have a PWOM familiarization record." ;
                    sh:resultPath nltl:hasFamiliarizationRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:familiarizationRecord ;
                            sh:message "Each crew member shall have a PWOM familiarization record." ;
                            sh:minCount 1 ;
                            sh:node gen:IMO_104_FamiliarizationRecordShape ;
                            sh:path nltl:hasFamiliarizationRecord ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/crew1> ;
                    sh:resultMessage "Each PWOM item relevant to a crew member's assigned duties shall be represented in that crew member's familiarization record." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Each PWOM item relevant to a crew member's assigned duties shall be represented in that crew member's familiarization record." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasAssignedDuty ?duty .
                ?duty nltl:hasRelevantPolarWaterOperationalManualItem ?item .
                FILTER NOT EXISTS {
                    $this nltl:hasFamiliarizationRecord ?record .
                    ?record nltl:familiarizationRecordItem ?item .
                }
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:IMO_104_CrewMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/crew1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ;
            sh:resultMessage "The ship shall identify its crew members for PWOM familiarization verification." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:crewMember ;
                    sh:message "The ship shall identify its crew members for PWOM familiarization verification." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO_104_CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/crew1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ;
            sh:resultMessage "The ship shall record completed PWOM familiarization." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n5c0edff98411407bb2d18def9eed6da6b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ;
            sh:resultMessage "The ship shall record completed PWOM familiarization." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n5c0edff98411407bb2d18def9eed6da6b1 ] .

_:n5c0edff98411407bb2d18def9eed6da6b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall record completed PWOM familiarization." ;
    sh:minCount 1 ;
    sh:path nltl:polarWaterOperationalManualFamiliarizationStatus .

