@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "The ship shall record completed PWOM familiarization." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n0d3c907b86a0438a9061a4b5e438883eb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "The ship shall record completed PWOM familiarization." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n0d3c907b86a0438a9061a4b5e438883eb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "The ship shall identify its crew members." ;
            sh:resultPath nltl:hasCrewMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:crewMember ;
                    sh:message "The ship shall identify its crew members." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasCrewMember ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/crew1> ;
                    sh:resultMessage "Each crew member shall have an assigned duty linked to relevant PWOM items." ;
                    sh:resultPath nltl:hasAssignedDuty ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:assignedDuty ;
                            sh:message "Each crew member shall have an assigned duty linked to relevant PWOM items." ;
                            sh:minCount 1 ;
                            sh:node gen:IMO104AssignedDutyShape ;
                            sh:path nltl:hasAssignedDuty ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "The ship shall provide the crew-member inventory and applicable familiarization records." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:crewMember ;
                    sh:message "The ship shall provide the crew-member inventory and applicable familiarization records." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO104CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/crew1> ] .

_:n0d3c907b86a0438a9061a4b5e438883eb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall record completed PWOM familiarization." ;
    sh:minCount 1 ;
    sh:path nltl:polarWaterOperationalManualFamiliarizationStatus .

