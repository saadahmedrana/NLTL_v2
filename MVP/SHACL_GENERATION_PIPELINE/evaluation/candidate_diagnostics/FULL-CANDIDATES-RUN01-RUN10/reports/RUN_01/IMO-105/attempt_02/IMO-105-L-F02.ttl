@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-105-L-F02/ship> ;
            sh:resultMessage "An operating area is required to determine whether the Arctic discharge prohibition applies." ;
            sh:resultPath nltl:operatingArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "An operating area is required to determine whether the Arctic discharge prohibition applies." ;
                    sh:minCount 1 ;
                    sh:path nltl:operatingArea ] ] .

