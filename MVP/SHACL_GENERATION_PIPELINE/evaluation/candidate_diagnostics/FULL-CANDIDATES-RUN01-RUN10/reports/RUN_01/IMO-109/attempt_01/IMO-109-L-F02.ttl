@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-F02/ship> ;
            sh:resultMessage "The applicability conditions must be established, and applicable cargo tanks must have at least 0.76 m outer-shell separation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-109-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-F02/ship> ] .

