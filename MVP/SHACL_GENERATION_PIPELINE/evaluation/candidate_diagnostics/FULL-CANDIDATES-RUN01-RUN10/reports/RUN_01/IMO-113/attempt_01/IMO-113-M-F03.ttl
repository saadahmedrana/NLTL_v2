@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-113-M-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"false\" = False, datatype=xsd:boolean) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipOperatesInPolarWaters ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"Polar operation coverage shall be recorded in the applicable Cargo Record Book.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:cargoRecordBookPolarCoverage ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"Polar operation coverage shall be recorded in the applicable Manual.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:manualPolarCoverage ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"Polar operation coverage shall be recorded in the applicable noxious liquid substance or marine pollution emergency plan.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:noxiousLiquidSubstanceEmergencyPlanPolarCoverage ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipOperatesInPolarWaters ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_113_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-113-M-F03/ship> ] .

