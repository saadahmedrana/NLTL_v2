@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-P01/ship> ;
            sh:resultMessage "For category A or B ships constructed on or after 1 January 2017 carrying NLS requiring a type 3 tank in cargo tanks of type 3, Administration approval and the applicable certificate polar-operation entry are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-114> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-P01/ship> ] .

