@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-F02/ship> ;
            sh:resultMessage "For an applicable Category A or B ship, the Administration approval status must be approved and the applicable certificate polar operation entry must be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an applicable Category A or B ship, the Administration approval status must be approved and the applicable certificate polar operation entry must be present." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?constructionDate ;
                      nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ?requiresType3 ;
                      nltl:cargoTankType ?tankType .

                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                    &&
                    ?constructionDate >= "2017-01-01"^^xsd:date
                    &&
                    ?requiresType3 = true
                    &&
                    ?tankType = "3"
                    &&
                    (
                        NOT EXISTS {
                            $this nltl:administrationCarriageApprovalStatus
                                  nltl:evidenceStateApproved
                        }
                        ||
                        NOT EXISTS {
                            $this nltl:applicableCertificatePolarOperationEntryPresent
                                  true
                        }
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_114_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-F02/ship> ] .

