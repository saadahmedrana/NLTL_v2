@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-115-M-F02/ship> ;
            sh:resultMessage "If sewage is comminuted and disinfected, MARPOL compliance, the strict distance threshold, and the ice-concentration-area distance record are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_115_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-115-M-F02/ship> ] .

