@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-115-M-P01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("MARPOL Annex IV regulation 11.1.1 compliance is required for comminuted and disinfected sewage discharge.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus ], [ sh:datatype xsd:string ; sh:hasValue Literal("comminuted_and_disinfected") ; sh:path nltl:sewageDischargeType ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The applicable nearby ice concentration must be greater than 0.1.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minExclusive Literal("0.1", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:nearbyIceConcentration ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The distance from the applicable area with ice concentration above one tenth must be recorded in nautical miles.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MI_N ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The distance from the nearest ice shelf or fast ice must be greater than 3 nautical miles.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minExclusive Literal("3", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MI_N ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:distanceToNearestIceShelfOrFastIce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The recorded ice concentration for the applicable ice area must be greater than 0.1.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minExclusive Literal("0.1", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:iceConcentration ] ] , [ sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("The non-applicable alternative requires sewageDischargeType other than comminuted_and_disinfected.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:sewageDischargeType ?dischargeType .
    FILTER (STR(?dischargeType) != "comminuted_and_disinfected")
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO115Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-115-M-P01/ship> ] .

