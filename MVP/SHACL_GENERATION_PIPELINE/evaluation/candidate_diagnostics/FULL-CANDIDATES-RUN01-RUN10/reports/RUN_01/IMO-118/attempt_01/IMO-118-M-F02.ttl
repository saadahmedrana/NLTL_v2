@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F02/ship> ;
            sh:resultMessage "For a qualifying category A or B ship, or any passenger ship, constructed on or after 1 January 2017, sewage discharge to sea must be false unless compliance with paragraph 4.2.1.3 is recorded as true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a qualifying category A or B ship, or any passenger ship, constructed on or after 1 January 2017, sewage discharge to sea must be false unless compliance with paragraph 4.2.1.3 is recorded as true." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:constructionDate ?date .
                FILTER (
                    YEAR(?date) > 2017 ||
                    (
                        YEAR(?date) = 2017 &&
                        (
                            MONTH(?date) > 1 ||
                            (MONTH(?date) = 1 && DAY(?date) >= 1)
                        )
                    )
                )

                {
                    ?this nltl:shipCategory ?category .
                    FILTER (
                        ?category IN (
                            nltl:polarShipCategoryA,
                            nltl:polarShipCategoryB
                        )
                    )
                }
                UNION
                {
                    ?this a nltl:passengerShip .
                }

                FILTER NOT EXISTS {
                    ?this nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ?status .
                    FILTER ( ?status = true )
                }

                FILTER NOT EXISTS {
                    ?this nltl:sewageDischargeToSea ?discharge .
                    FILTER ( ?discharge = false )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-118> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F02/ship> ] .

