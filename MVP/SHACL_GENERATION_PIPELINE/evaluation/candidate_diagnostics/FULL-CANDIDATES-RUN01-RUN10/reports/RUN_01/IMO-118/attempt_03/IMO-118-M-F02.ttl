@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F02/ship> ;
            sh:resultMessage "Sewage discharge to sea is prohibited for an applicable ship unless paragraph 4.2.1.3 compliance is true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Sewage discharge to sea is prohibited for an applicable ship unless paragraph 4.2.1.3 compliance is true." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionDate ?date .
                FILTER (
                    datatype(?date) = xsd:date &&
                    ?date >= "2017-01-01"^^xsd:date
                )

                FILTER (
                    EXISTS {
                        $this nltl:shipCategory ?category .
                        FILTER (
                            ?category IN (
                                nltl:polarShipCategoryA,
                                nltl:polarShipCategoryB
                            )
                        )
                    }
                    ||
                    EXISTS {
                        $this a nltl:passengerShip
                    }
                )

                $this nltl:sewageDischargeToSea ?discharge .
                FILTER (?discharge = true)

                FILTER NOT EXISTS {
                    $this nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ?status .
                    FILTER (?status = true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_118_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F02/ship> ] .

