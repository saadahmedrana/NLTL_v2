@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-P01/ship> ;
            sh:resultMessage "The ship's operating area must be recorded as Arctic_waters." ;
            sh:resultPath nltl:operatingArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:hasValue "Arctic_waters"^^xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship's operating area must be recorded as Arctic_waters." ;
                    sh:minCount 1 ;
                    sh:path nltl:operatingArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-P01/ship> ;
            sh:resultMessage "The ship's arctic waters applicability must be recorded as Arctic_waters." ;
            sh:resultPath nltl:arcticWaters ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:hasValue "Arctic_waters"^^xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship's arctic waters applicability must be recorded as Arctic_waters." ;
                    sh:minCount 1 ;
                    sh:path nltl:arcticWaters ] ] .

