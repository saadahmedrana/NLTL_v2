@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P02/grossTonnageValue> ;
                    sh:resultMessage "Node ex:grossTonnageValue->qudt:unit does not contain a value in the set: ['qudt:UNITLESS']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO26-002-QuantityGrossTonnage>. See details for more information." ;
            sh:resultPath nltl:grossTonnage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO26-002-QuantityGrossTonnage> ;
                    sh:path nltl:grossTonnage ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P02/grossTonnageValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P02/lengthOverallValue> ;
                    sh:resultMessage "Node ex:lengthOverallValue->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO26-002-QuantityLength>. See details for more information." ;
            sh:resultPath nltl:lengthOverall ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO26-002-QuantityLength> ;
                    sh:path nltl:lengthOverall ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P02/lengthOverallValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P02/ship> ;
            sh:resultMessage "Chapter 9-1 applicability does not match the ship type, dimensions, gross tonnage, and trade status." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Chapter 9-1 applicability does not match the ship type, dimensions, gross tonnage, and trade status." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:shipType ?type .
    $this nltl:polarCodeChapter9Dash1Applicable ?app .
    OPTIONAL {
        $this nltl:lengthOverall ?lengthQuantity .
        ?lengthQuantity qudt:numericValue ?lengthValue .
    }
    OPTIONAL {
        $this nltl:grossTonnage ?tonnageQuantity .
        ?tonnageQuantity qudt:numericValue ?tonnageValue .
    }
    OPTIONAL {
        $this nltl:engagedInTrade ?trade .
    }
    FILTER (
        (
            ?type = "fishing_vessel"
            && (
                !BOUND(?lengthValue)
                || ?lengthValue < 24
                || ?app != true
            )
        )
        ||
        (
            ?type = "pleasure_yacht"
            && (
                !BOUND(?tonnageValue)
                || !BOUND(?trade)
                || ?tonnageValue < 300
                || ?trade != false
                || ?app != true
            )
        )
        ||
        (
            ?type = "cargo_ship"
            && (
                !BOUND(?tonnageValue)
                || ?tonnageValue < 300
                || ?tonnageValue >= 500
                || ?app != true
            )
        )
        ||
        (
            ?type NOT IN ("fishing_vessel", "pleasure_yacht", "cargo_ship")
            && ?app != false
        )
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-002-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P02/ship> ] .

