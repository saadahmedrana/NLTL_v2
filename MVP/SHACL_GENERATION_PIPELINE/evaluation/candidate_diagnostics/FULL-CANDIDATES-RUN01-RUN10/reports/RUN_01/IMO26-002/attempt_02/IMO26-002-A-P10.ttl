@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P10/lengthOverallValue> ;
                    sh:resultMessage "Node ex:lengthOverallValue->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P10/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO26-002-QuantityLength>. See details for more information." ;
            sh:resultPath nltl:lengthOverall ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO26-002-QuantityLength> ;
                    sh:path nltl:lengthOverall ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P10/lengthOverallValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P10/grossTonnageValue> ;
                    sh:resultMessage "Node ex:grossTonnageValue->qudt:unit does not contain a value in the set: ['qudt:UNITLESS']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P10/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO26-002-QuantityGrossTonnage>. See details for more information." ;
            sh:resultPath nltl:grossTonnage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO26-002-QuantityGrossTonnage> ;
                    sh:path nltl:grossTonnage ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P10/grossTonnageValue> ] .

