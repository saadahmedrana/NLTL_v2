@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-F02/ship> ;
            sh:resultMessage "Each represented heading-reference or position-fixing system must have an intended-area suitability approval status of Approved." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each represented heading-reference or position-fixing system must have an intended-area suitability approval status of Approved." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:headingOrPositionSystem ?system .
                FILTER (
                    NOT EXISTS {
                        $this nltl:intendedAreaSuitabilityApprovalStatus
                              nltl:evidenceStateApproved
                    }
                    ||
                    EXISTS {
                        $this nltl:intendedAreaSuitabilityApprovalStatus ?status .
                        FILTER (?status != nltl:evidenceStateApproved)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-005> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-F02/ship> ] .

