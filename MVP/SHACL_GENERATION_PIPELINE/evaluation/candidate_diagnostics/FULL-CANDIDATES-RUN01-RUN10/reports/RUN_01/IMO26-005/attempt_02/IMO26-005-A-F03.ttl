@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-F03/ship> ;
            sh:resultMessage "The suitability approval status for the intended area must be Approved." ;
            sh:resultPath nltl:intendedAreaSuitabilityApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n700a0b635f5b4d0b812792623d59c0aab3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-F03/ship> ;
            sh:resultMessage "The suitability approval status for the intended area must be Approved." ;
            sh:resultPath nltl:intendedAreaSuitabilityApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n700a0b635f5b4d0b812792623d59c0aab3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-F03/ship> ;
            sh:resultMessage "The ship must specify the intended area for the represented heading-reference or position-fixing systems." ;
            sh:resultPath nltl:intendedArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must specify the intended area for the represented heading-reference or position-fixing systems." ;
                    sh:minCount 1 ;
                    sh:path nltl:intendedArea ] ] .

_:n700a0b635f5b4d0b812792623d59c0aab3 sh:class nltl:evidenceState ;
    sh:hasValue nltl:evidenceStateApproved ;
    sh:message "The suitability approval status for the intended area must be Approved." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:intendedAreaSuitabilityApprovalStatus .

