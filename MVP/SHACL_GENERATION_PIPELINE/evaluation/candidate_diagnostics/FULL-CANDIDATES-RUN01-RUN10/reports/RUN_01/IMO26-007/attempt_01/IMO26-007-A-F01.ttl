@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-007-A-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:message Literal(\"The 1 January 2026 equipment rule is not applicable when the ship is not ice-strengthened or was constructed before 1 January 2026.\") ; sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:shipIceStrengthened ] ] [ sh:property [ sh:datatype xsd:date ; sh:maxInclusive Literal(\"2025-12-31\", datatype=xsd:date) ; sh:path nltl:constructionDate ] ] ) ] , [ sh:and ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipIceStrengthened ] ] [ sh:property [ sh:datatype xsd:date ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2026-01-01\", datatype=xsd:date) ; sh:path nltl:constructionDate ] ] [ sh:or ( [ sh:property [ sh:datatype xsd:integer ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:independentEchoSoundingDeviceCount ] ] [ sh:and ( [ sh:property [ sh:datatype xsd:integer ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:echoSoundingDeviceCount ] ] [ sh:property [ sh:datatype xsd:integer ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:independentTransducerCount ] ] ) ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:administrationApprovedEquivalentDepthSoundingDevicePresent ] ] ) ] ) ; sh:message Literal(\"An ice-strengthened ship constructed on or after 1 January 2026 shall have two independent echo-sounding devices, or one echo-sounding device with two independent transducers, or an administration-approved equivalent depth-sounding device.\") ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO26_007_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-007-A-F01/ship> ] .

