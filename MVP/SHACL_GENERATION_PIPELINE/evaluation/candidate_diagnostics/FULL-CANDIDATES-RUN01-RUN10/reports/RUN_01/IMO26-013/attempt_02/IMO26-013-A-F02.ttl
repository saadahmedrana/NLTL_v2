@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-013-A-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:message Literal(\"A planned or actual latitude at or below 80 degrees is required to establish non-applicability.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxInclusive Literal(\"80\", datatype=xsd:decimal) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:plannedOrActualLatitude ] ] , [ sh:property [ sh:class nltl:benchmarkEntity ; sh:message Literal(\"The GNSS compass or equivalent must be connected to the ship's emergency source of power.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:connectedToEmergencyPower ], [ sh:class nltl:benchmarkEntity ; sh:message Literal(\"The GNSS compass or equivalent must be connected to the ship's main source of power.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:connectedToMainPower ], [ sh:datatype xsd:integer ; sh:message Literal(\"At least one GNSS compass or equivalent is required for voyages over 80 degrees latitude.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:gnssCompassOrEquivalentCount ], [ sh:message Literal(\"A planned or actual latitude over 80 degrees is required to establish applicability.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minExclusive Literal(\"80\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:plannedOrActualLatitude ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-013> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-013-A-F02/ship> ] .

