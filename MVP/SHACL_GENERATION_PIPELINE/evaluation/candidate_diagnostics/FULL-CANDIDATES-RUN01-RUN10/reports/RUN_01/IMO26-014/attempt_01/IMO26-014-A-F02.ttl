@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-014-A-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The daylight-operation applicability value must be true for this branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:operatesOnlyInContinuousDaylight ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The daylight-operation applicability value must be false for the two-means requirement branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:operatesOnlyInContinuousDaylight ], [ sh:datatype xsd:integer ; sh:message Literal(\"Ships not operating solely in continuous daylight must have at least two means of illumination to aid visual detection of ice.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:visualIceDetectionIlluminationMeansCount ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-014> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-014-A-F02/ship> ] .

