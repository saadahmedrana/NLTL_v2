@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F01/ship> ;
            sh:resultMessage "A ship operating in polar waters that meets a Chapter 11-1 ship-type and threshold condition must have polarCodeChapter11Dash1Applicable true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship operating in polar waters that meets a Chapter 11-1 ship-type and threshold condition must have polarCodeChapter11Dash1Applicable true." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters ?polar .
                FILTER(?polar = true)

                FILTER(
                    EXISTS {
                        $this nltl:shipType ?type .
                        FILTER(datatype(?type) = xsd:string)
                        FILTER(?type = "fishing_vessel")
                        $this nltl:lengthOverall ?lengthQuantity .
                        ?lengthQuantity qudt:numericValue ?length .
                        ?lengthQuantity qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER(datatype(?length) = xsd:decimal)
                        FILTER(?length >= 24)
                    }
                    ||
                    EXISTS {
                        $this nltl:shipType ?type .
                        FILTER(datatype(?type) = xsd:string)
                        FILTER(?type = "pleasure_yacht")
                        $this nltl:grossTonnage ?tonnageQuantity .
                        ?tonnageQuantity qudt:numericValue ?tonnage .
                        ?tonnageQuantity qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER(datatype(?tonnage) = xsd:decimal)
                        FILTER(?tonnage >= 300)
                        $this nltl:engagedInTrade ?trade .
                        FILTER(?trade = false)
                    }
                    ||
                    EXISTS {
                        $this nltl:shipType ?type .
                        FILTER(datatype(?type) = xsd:string)
                        FILTER(?type = "cargo_ship")
                        $this nltl:grossTonnage ?tonnageQuantity .
                        ?tonnageQuantity qudt:numericValue ?tonnage .
                        ?tonnageQuantity qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER(datatype(?tonnage) = xsd:decimal)
                        FILTER(?tonnage >= 300)
                        FILTER(?tonnage < 500)
                    }
                )

                FILTER NOT EXISTS {
                    $this nltl:polarCodeChapter11Dash1Applicable true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO26_016_Chapter11_1ApplicabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F01/ship> ] .

