@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-017-B-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When Chapter 11-1 is applicable, a voyage plan must be present.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:voyagePlanPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When Chapter 11-1 is applicable, the voyage plan must take into account every intended-voyage hazard.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:voyagePlanCoverage ], [ sh:datatype xsd:string ; sh:message Literal(\"When Chapter 11-1 is applicable, the intended-voyage hazard register must be recorded.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:intendedVoyageHazard ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:polarCodeChapter11Dash1Applicable ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:polarCodeChapter11Dash1Applicable ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-017-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-017-B-F02/ship> ] .

