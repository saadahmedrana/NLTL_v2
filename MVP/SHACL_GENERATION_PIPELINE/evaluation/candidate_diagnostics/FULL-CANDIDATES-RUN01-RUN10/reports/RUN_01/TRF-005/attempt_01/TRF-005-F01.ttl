@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F01/ship> ;
            sh:resultMessage "For an applicable ship, the applicable regulation edition must be the 2002 Ice Class Regulations." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an applicable ship, the applicable regulation edition must be the 2002 Ice Class Regulations." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?contractDate ;
                      nltl:constructionStageDate ?stageDate ;
                      nltl:applicableIceClassRegulationEdition ?edition .
                FILTER (
                    ?contractDate < "2010-01-01"^^xsd:date &&
                    ?stageDate >= "2003-09-01"^^xsd:date &&
                    ?edition != nltl:iceClassRegulationEdition2002
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-005> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F01/ship> ;
            sh:resultMessage "Ships contracted before 1 January 2010 and at a similar construction stage on or after 1 September 2003 must identify the 2002 Ice Class Regulations as the applicable regulation edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ships contracted before 1 January 2010 and at a similar construction stage on or after 1 September 2003 must identify the 2002 Ice Class Regulations as the applicable regulation edition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?contractDate ;
                      nltl:constructionStageDate ?stageDate .
                FILTER (
                    ?contractDate < "2010-01-01"^^xsd:date &&
                    ?stageDate >= "2003-09-01"^^xsd:date
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                          nltl:iceClassRegulationEdition2002 .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-005> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F01/ship> ] .

