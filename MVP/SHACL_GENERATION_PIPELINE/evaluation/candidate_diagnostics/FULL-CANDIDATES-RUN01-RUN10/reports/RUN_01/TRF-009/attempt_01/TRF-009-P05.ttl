@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-P05/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:sparql [ sh:message Literal("TRF-009 applies only to an IA Super or IA ship whose keel was laid or construction reached a similar stage before 1 September 2003.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass ;
                              nltl:constructionStageDate ?constructionStageDate .
                        FILTER (
                            ?iceClass IN (
                                nltl:iceClassIaSuper,
                                nltl:iceClassIa
                            )
                        )
                        FILTER (
                            YEAR(?constructionStageDate) < 2003
                            ||
                            (
                                YEAR(?constructionStageDate) = 2003
                                && MONTH(?constructionStageDate) < 9
                            )
                            ||
                            (
                                YEAR(?constructionStageDate) = 2003
                                && MONTH(?constructionStageDate) = 9
                                && DAY(?constructionStageDate) < 1
                            )
                        )
                    }
                ") ] ] , [ sh:sparql [ sh:message Literal("For an applicable ship, the required 2017 Ice Class Regulations compliance method and deadline must be satisfied.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass ;
                              nltl:constructionStageDate ?constructionStageDate ;
                              nltl:deliveryDate ?deliveryDate ;
                              nltl:assessmentDate ?assessmentDate .
                        FILTER (
                            ?iceClass IN (
                                nltl:iceClassIaSuper,
                                nltl:iceClassIa
                            )
                        )
                        FILTER (
                            YEAR(?constructionStageDate) < 2003
                            ||
                            (
                                YEAR(?constructionStageDate) = 2003
                                && MONTH(?constructionStageDate) < 9
                            )
                            ||
                            (
                                YEAR(?constructionStageDate) = 2003
                                && MONTH(?constructionStageDate) = 9
                                && DAY(?constructionStageDate) < 1
                            )
                        )
                        FILTER (
                            NOT EXISTS {
                                $this nltl:engineOutputComplianceMethod ?method .
                                FILTER (
                                    ?method IN (
                                        nltl:traficom2017Section3Point2Point2Method,
                                        nltl:traficom2017Section3Point2Point4Method
                                    )
                                )
                            }
                            ||
                            !(
                                YEAR(?assessmentDate) < YEAR(?deliveryDate) + 20
                                ||
                                (
                                    YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20
                                    && MONTH(?assessmentDate) = 1
                                    && DAY(?assessmentDate) = 1
                                )
                            )
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-009-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-P05/ship> ] .

