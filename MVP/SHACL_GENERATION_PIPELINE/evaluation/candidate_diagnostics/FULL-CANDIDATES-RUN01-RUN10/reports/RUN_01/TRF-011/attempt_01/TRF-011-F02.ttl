@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F02/ship> ;
            sh:resultMessage "The upper ice waterline must equal the maximum intended ice-operating waterline vertical coordinate at every longitudinal position, in both directions; comparison uses a 1e-6 relative tolerance with a 1e-9 absolute fallback." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The upper ice waterline must equal the maximum intended ice-operating waterline vertical coordinate at every longitudinal position, in both directions; comparison uses a 1e-6 relative tolerance with a 1e-9 absolute fallback." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?this ?x
WHERE {
  {
    SELECT ?this ?x
           (SUM(IF(?source = "intended", 1, 0)) AS ?intendedCount)
           (SUM(IF(?source = "upper", 1, 0)) AS ?upperCount)
           (MAX(IF(?source = "intended", ?y, 0.0)) AS ?intendedMaximum)
           (MAX(IF(?source = "upper", ?y, 0.0)) AS ?upperMaximum)
    WHERE {
      {
        ?this nltl:hasIntendedIceOperatingWaterline ?waterline .
        ?waterline nltl:hasWaterlineProfilePoint ?point .
        ?point nltl:longitudinalPosition ?longitudinalQuantity ;
               nltl:verticalCoordinate ?verticalQuantity .
        ?longitudinalQuantity qudt:numericValue ?x ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .
        ?verticalQuantity qudt:numericValue ?y ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
        BIND("intended" AS ?source)
      }
      UNION
      {
        ?this nltl:hasUpperIceWaterline ?waterline .
        ?waterline nltl:hasWaterlineProfilePoint ?point .
        ?point nltl:longitudinalPosition ?longitudinalQuantity ;
               nltl:verticalCoordinate ?verticalQuantity .
        ?longitudinalQuantity qudt:numericValue ?x ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .
        ?verticalQuantity qudt:numericValue ?y ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
        BIND("upper" AS ?source)
      }
    }
    GROUP BY ?this ?x
  }
  FILTER(
    ?intendedCount = 0 ||
    ?upperCount = 0 ||
    ABS(?intendedMaximum - ?upperMaximum) >
      (
        0.000001 *
        IF(
          ABS(?intendedMaximum) > ABS(?upperMaximum),
          ABS(?intendedMaximum),
          ABS(?upperMaximum)
        ) +
        0.000000001
      )
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF011ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F02/ship> ] .

