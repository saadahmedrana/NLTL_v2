@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Node ex:ship->nltl:retainedOnBoard does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n756250855e604c509b2e0573f9a1e752b41 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Node ex:ship->nltl:readilyAvailableToMaster does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n756250855e604c509b2e0573f9a1e752b42 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:readilyAvailableToMaster" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n756250855e604c509b2e0573f9a1e752b42 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:retainedOnBoard" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n756250855e604c509b2e0573f9a1e752b41 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "For ships built before 1 July 2007, complete marking evidence is required, or a first scheduled dry docking date must be supplied; markings are required when that date is on or before the assessment date." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For ships built before 1 July 2007, complete marking evidence is required, or a first scheduled dry docking date must be supplied; markings are required when that date is on or before the assessment date." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:constructionDate ?constructionDate .
    FILTER (?constructionDate < "2007-07-01"^^xsd:date)

    FILTER (
        NOT EXISTS {
            $this nltl:warningTrianglePresent true ;
                  nltl:iceClassDraughtMarkPresent true ;
                  nltl:iceClassDraughtMarkDraughtAmidships ?markDraught .
            ?markDraught qudt:numericValue ?markValue ;
                         qudt:unit unit:M .
            FILTER (datatype(?markValue) = xsd:decimal)
        }
        &&
        (
            NOT EXISTS {
                $this nltl:firstScheduledDryDockingDate ?dryDockingDate .
            }
            ||
            (
                EXISTS {
                    $this nltl:firstScheduledDryDockingDate ?dryDockingDate ;
                          nltl:assessmentDate ?assessmentDate .
                    FILTER (?dryDockingDate <= ?assessmentDate)
                }
                &&
                NOT EXISTS {
                    $this nltl:warningTrianglePresent true ;
                          nltl:iceClassDraughtMarkPresent true ;
                          nltl:iceClassDraughtMarkDraughtAmidships ?markDraught .
                    ?markDraught qudt:numericValue ?markValue ;
                                 qudt:unit unit:M .
                    FILTER (datatype(?markValue) = xsd:decimal)
                }
            )
        )
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF014Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ] .

_:n756250855e604c509b2e0573f9a1e752b41 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

_:n756250855e604c509b2e0573f9a1e752b42 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

