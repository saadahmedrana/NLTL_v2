@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "The ice draught restriction document must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc7d58c4f060d44bf83373a2ec6ff8a7db8 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "The ice draught restriction document must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nc7d58c4f060d44bf83373a2ec6ff8a7db8 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "The ice draught restriction document must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nc7d58c4f060d44bf83373a2ec6ff8a7db9 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/certificate> ;
                    sh:resultMessage "Less than 1 values on ex:certificate->nltl:minimumIceClassDraughtAft" ;
                    sh:resultPath nltl:minimumIceClassDraughtAft ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node gen:TRF014_LengthQuantityShape ;
                            sh:path nltl:minimumIceClassDraughtAft ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "A class certificate containing all required ice-class draught limits is required." ;
            sh:resultPath nltl:hasClassCertificate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:classCertificate ;
                    sh:message "A class certificate containing all required ice-class draught limits is required." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF014_ClassCertificateShape ;
                    sh:path nltl:hasClassCertificate ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/certificate> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "The ice draught restriction document must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc7d58c4f060d44bf83373a2ec6ff8a7db9 ] .

_:nc7d58c4f060d44bf83373a2ec6ff8a7db8 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice draught restriction document must be retained on board." ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

_:nc7d58c4f060d44bf83373a2ec6ff8a7db9 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice draught restriction document must be readily available to the master." ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

