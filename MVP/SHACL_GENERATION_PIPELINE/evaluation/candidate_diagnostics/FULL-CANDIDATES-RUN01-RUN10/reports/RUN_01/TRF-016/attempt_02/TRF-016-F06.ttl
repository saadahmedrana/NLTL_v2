@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F06/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:liwlDraughtAmidships" ;
            sh:resultPath nltl:liwlDraughtAmidships ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltl:TRF016_LengthQuantityShape ;
                    sh:path nltl:liwlDraughtAmidships ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F06/hi> ;
                    sh:resultMessage "Node ex:hi->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/M>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape nltl:TRF016_LengthQuantityShape. See details for more information." ;
            sh:resultPath nltl:levelIceThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltl:TRF016_LengthQuantityShape ;
                    sh:path nltl:levelIceThickness ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F06/hi> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F06/upper> ;
                    sh:resultMessage "Less than 1 values on ex:upper->nltl:waterlineDisplacement" ;
                    sh:resultPath nltl:waterlineDisplacement ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node nltl:TRF016_MassQuantityShape ;
                            sh:path nltl:waterlineDisplacement ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape nltl:TRF016_UpperIceWaterlineShape. See details for more information." ;
            sh:resultPath nltl:hasUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node nltl:TRF016_UpperIceWaterlineShape ;
                    sh:path nltl:hasUpperIceWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F06/upper> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F06/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:displacementAtUpperIceWaterline" ;
            sh:resultPath nltl:displacementAtUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltl:TRF016_MassQuantityShape ;
                    sh:path nltl:displacementAtUpperIceWaterline ] ] .

