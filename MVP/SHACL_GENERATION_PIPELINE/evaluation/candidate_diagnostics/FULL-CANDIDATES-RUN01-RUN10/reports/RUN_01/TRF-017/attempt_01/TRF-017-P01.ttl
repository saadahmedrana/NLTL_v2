@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P01/ship> ;
            sh:resultMessage "The engine output P must equal the maximum continuously deliverable propulsion machinery output, or the restricted output when a restriction applies." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The engine output P must equal the maximum continuously deliverable propulsion machinery output, or the restricted output when a restriction applies." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies ?applies ;
                      nltl:maximumContinuousRatingPower ?pNode ;
                      nltl:propulsionMachineryContinuousOutput ?cNode .

                ?pNode qudt:numericValue ?pValue .
                ?cNode qudt:numericValue ?cValue .

                OPTIONAL {
                    $this nltl:restrictedPropulsionOutput ?rNode .
                    ?rNode qudt:numericValue ?rValue .
                }

                FILTER (
                    (?applies = true && BOUND(?rValue) && ?rValue = ?pValue) ||
                    (?applies = false && ?cValue = ?pValue)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF017Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P01/ship> ] .

