@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F02/ship> ;
            sh:resultMessage "Maximum continuous rating power P must equal the applicable propulsion output, including any additional propulsion power, within a relative tolerance of 1e-6 and an absolute fallback of 0.000001 kW." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Maximum continuous rating power P must equal the applicable propulsion output, including any additional propulsion power, within a relative tolerance of 1e-6 and an absolute fallback of 0.000001 kW." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE
            {
                {
                    $this nltl:maximumContinuousRatingPower ?pNode .
                    ?pNode qudt:numericValue ?p .
                    $this nltl:propulsionMachineryContinuousOutput ?mNode .
                    ?mNode qudt:numericValue ?m .
                    $this nltl:propulsionOutputRestrictionApplies false .
                    FILTER NOT EXISTS {
                        $this nltl:additionalPropulsionPower ?aNode .
                        ?aNode qudt:numericValue ?a .
                    }
                    FILTER (ABS(?p - ?m) > (ABS(?m) * 0.000001 + 0.000001))
                }
                UNION
                {
                    $this nltl:maximumContinuousRatingPower ?pNode .
                    ?pNode qudt:numericValue ?p .
                    $this nltl:propulsionMachineryContinuousOutput ?mNode .
                    ?mNode qudt:numericValue ?m .
                    $this nltl:propulsionOutputRestrictionApplies false .
                    $this nltl:additionalPropulsionPower ?aNode .
                    ?aNode qudt:numericValue ?a .
                    FILTER (ABS(?p - (?m + ?a)) > (ABS(?m + ?a) * 0.000001 + 0.000001))
                }
                UNION
                {
                    $this nltl:maximumContinuousRatingPower ?pNode .
                    ?pNode qudt:numericValue ?p .
                    $this nltl:restrictedPropulsionOutput ?rNode .
                    ?rNode qudt:numericValue ?r .
                    $this nltl:propulsionOutputRestrictionApplies true .
                    FILTER NOT EXISTS {
                        $this nltl:additionalPropulsionPower ?aNode .
                        ?aNode qudt:numericValue ?a .
                    }
                    FILTER (ABS(?p - ?r) > (ABS(?r) * 0.000001 + 0.000001))
                }
                UNION
                {
                    $this nltl:maximumContinuousRatingPower ?pNode .
                    ?pNode qudt:numericValue ?p .
                    $this nltl:restrictedPropulsionOutput ?rNode .
                    ?rNode qudt:numericValue ?r .
                    $this nltl:propulsionOutputRestrictionApplies true .
                    $this nltl:additionalPropulsionPower ?aNode .
                    ?aNode qudt:numericValue ?a .
                    FILTER (ABS(?p - (?r + ?a)) > (ABS(?r + ?a) * 0.000001 + 0.000001))
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_017_Static> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F02/ship> ] .

