@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-022-F04/ship> ;
            sh:resultMessage "Ice class draught is required in metres." ;
            sh:resultPath nltl:iceClassDraught ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Ice class draught is required in metres." ;
                    sh:minCount 1 ;
                    sh:node gs:TRF022LengthQuantityShape ;
                    sh:path nltl:iceClassDraught ] ] .

