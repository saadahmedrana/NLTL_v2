@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-022-F06/ship> ;
            sh:resultMessage "Coefficient c3 input is required with its declared unit." ;
            sh:resultPath nltl:coefficientC3 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Coefficient c3 input is required with its declared unit." ;
                    sh:minCount 1 ;
                    sh:node gs:TRF022C34QuantityShape ;
                    sh:path nltl:coefficientC3 ] ] .

