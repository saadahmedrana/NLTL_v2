@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-022-F10/ship> ;
            sh:resultMessage "The externally computed clamped hull geometry result is required and must be dimensionless." ;
            sh:resultPath nltl:clampedHullGeometryTerm ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The externally computed clamped hull geometry result is required and must be dimensionless." ;
                    sh:minCount 1 ;
                    sh:node gs:TRF022DimensionlessQuantityShape ;
                    sh:path nltl:clampedHullGeometryTerm ] ] .

