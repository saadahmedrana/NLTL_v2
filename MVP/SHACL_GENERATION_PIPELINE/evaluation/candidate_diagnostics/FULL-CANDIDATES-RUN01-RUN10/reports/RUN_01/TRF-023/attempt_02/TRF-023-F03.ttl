@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:node <urn:nltl:generated-shape:TRF-023-PowerComparison> ; sh:property [ sh:hasValue nltl:iceClassIb ; sh:message Literal(\"The ship must have ice class IB for this applicability branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:hasValue nltl:iceClassRuleEdition1985 ; sh:message Literal(\"The applicable ice class regulation edition must be the 1985 rules.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:applicableIceClassRegulationEdition ] ] , [ sh:node <urn:nltl:generated-shape:TRF-023-PowerComparison> ; sh:property [ sh:hasValue nltl:iceClassIc ; sh:message Literal(\"The ship must have ice class IC for this applicability branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:hasValue nltl:iceClassRuleEdition1985 ; sh:message Literal(\"The applicable ice class regulation edition must be the 1985 rules.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:applicableIceClassRegulationEdition ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-023> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F03/ship> ] .

