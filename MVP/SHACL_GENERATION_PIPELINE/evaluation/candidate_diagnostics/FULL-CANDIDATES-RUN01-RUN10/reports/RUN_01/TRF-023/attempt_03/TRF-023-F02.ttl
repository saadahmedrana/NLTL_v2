@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:sparql [ sh:message Literal("The 1985 ice-regulation applicability branch must be evaluated with the required power constraint.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this a nltl:ship ;
                              nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
                              nltl:iceClass ?iceClass .
                        FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
                    }
                ") ] ] , [ sh:property [ sh:class qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:KiloW ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:maximumContinuousRatingPower ], [ sh:class qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:KiloW ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:requiredPowerUnder1985Rules ], [ sh:hasValue nltl:iceClassRuleEdition1985 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:applicableIceClassRegulationEdition ], [ sh:in ( nltl:iceClassIb nltl:iceClassIc ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ] ; sh:sparql [ sh:message Literal("Maximum continuous rating power must be at least the required power under the 1985 rules.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this a nltl:ship ;
                              nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
                              nltl:iceClass ?iceClass ;
                              nltl:maximumContinuousRatingPower ?mcrQuantity ;
                              nltl:requiredPowerUnder1985Rules ?requiredQuantity .
                        FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
                        ?mcrQuantity qudt:numericValue ?mcrValue ;
                                      qudt:unit qudt:KiloW .
                        ?requiredQuantity qudt:numericValue ?requiredValue ;
                                            qudt:unit qudt:KiloW .
                        FILTER (?mcrValue < ?requiredValue)
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-023> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F02/ship> ] .

