@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( nltl:iceClassRegulationEdition2002 nltl:iceClassRegulationEdition2008 nltl:iceClassRegulationEdition2010 nltl:iceClassRegulationEdition2017 nltl:iceClassRegulationEdition2021 ) ; sh:message Literal("This requirement is not applicable when a regulation edition other than the 1985 edition applies.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:applicableIceClassRegulationEdition ] ] , [ sh:property [ sh:hasValue nltl:iceClassRuleEdition1985 ; sh:message Literal("The applicable ice class regulation edition must be the 1985 rules.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:applicableIceClassRegulationEdition ], [ sh:in ( nltl:iceClassIb nltl:iceClassIc ) ; sh:message Literal("A ship subject to the 1985 rules must retain ice class IB or IC.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The ship must have exactly one valid maximum continuous rating power value.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:PowerQuantityShape ; sh:nodeKind sh:IRI ; sh:path nltl:maximumContinuousRatingPower ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The ship must have exactly one valid required power under the 1985 rules.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:PowerQuantityShape ; sh:nodeKind sh:IRI ; sh:path nltl:requiredPowerUnder1985Rules ] ; sh:sparql [ sh:message Literal("Maximum continuous rating power must be greater than or equal to the required power under the 1985 rules.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:maximumContinuousRatingPower ?mcrNode .
                        ?mcrNode qudt:numericValue ?mcrValue .
                        $this nltl:requiredPowerUnder1985Rules ?requiredNode .
                        ?requiredNode qudt:numericValue ?requiredValue .
                        FILTER (?mcrValue < ?requiredValue)
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF023Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F03/ship> ] .

