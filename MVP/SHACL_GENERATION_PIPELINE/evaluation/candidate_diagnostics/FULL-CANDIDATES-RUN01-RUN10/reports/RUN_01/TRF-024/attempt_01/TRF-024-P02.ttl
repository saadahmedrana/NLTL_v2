@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-P02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:sparql [ sh:message Literal("The non-applicable branch is valid only when the ship is not ice class IA Super or IA, or its construction stage was not before 1 September 2003.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?ice ;
          nltl:constructionStageDate ?construction .
    FILTER (
        ?ice IN (nltl:iceClassIaSuper, nltl:iceClassIa)
        &&
        (
            YEAR(?construction) < 2003
            ||
            (
                YEAR(?construction) = 2003
                && MONTH(?construction) < 9
            )
            ||
            (
                YEAR(?construction) = 2003
                && MONTH(?construction) = 9
                && DAY(?construction) < 1
            )
        )
    )
}
") ] ] , [ sh:sparql [ sh:message Literal("For an applicable IA Super or IA ship, the assessment date must be no later than 1 January of the year twenty years after delivery.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?ice ;
          nltl:constructionStageDate ?construction .
    FILTER (
        ?ice IN (nltl:iceClassIaSuper, nltl:iceClassIa)
        &&
        (
            YEAR(?construction) < 2003
            ||
            (
                YEAR(?construction) = 2003
                && MONTH(?construction) < 9
            )
            ||
            (
                YEAR(?construction) = 2003
                && MONTH(?construction) = 9
                && DAY(?construction) < 1
            )
        )
    )
    FILTER (
        NOT EXISTS {
            $this nltl:deliveryDate ?delivery .
        }
        ||
        NOT EXISTS {
            $this nltl:assessmentDate ?assessment .
        }
        ||
        NOT EXISTS {
            $this nltl:deliveryDate ?delivery ;
                  nltl:assessmentDate ?assessment .
            FILTER (
                YEAR(?assessment) < YEAR(?delivery) + 20
                ||
                (
                    YEAR(?assessment) = YEAR(?delivery) + 20
                    && MONTH(?assessment) = 1
                    && DAY(?assessment) = 1
                )
            )
        }
    )
}
") ], [ sh:message Literal("The applicable branch requires an ice class IA Super or IA ship whose construction stage was before 1 September 2003.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?ice ;
          nltl:constructionStageDate ?construction .
    FILTER (
        ! (
            ?ice IN (nltl:iceClassIaSuper, nltl:iceClassIa)
            &&
            (
                YEAR(?construction) < 2003
                ||
                (
                    YEAR(?construction) = 2003
                    && MONTH(?construction) < 9
                )
                ||
                (
                    YEAR(?construction) = 2003
                    && MONTH(?construction) = 9
                    && DAY(?construction) < 1
                )
            )
        )
    )
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-024-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-P02/ship> ] .

