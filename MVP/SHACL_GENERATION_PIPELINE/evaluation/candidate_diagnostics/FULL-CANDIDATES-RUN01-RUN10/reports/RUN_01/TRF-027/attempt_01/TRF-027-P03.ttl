@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-P03/ship> ;
            sh:resultMessage "The IA or IA Super branch requires a construction stage date before 2003-09-01; the Table 3-3 and clamped-geometry constraints apply only to that branch." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-027-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-P03/ship> ] .

