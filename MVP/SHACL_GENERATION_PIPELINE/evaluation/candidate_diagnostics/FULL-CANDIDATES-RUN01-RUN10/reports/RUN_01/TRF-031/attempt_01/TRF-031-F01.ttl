@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/ship> ;
            sh:resultMessage "combinedBendingShearStress must be lower than yieldPoint." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "combinedBendingShearStress must be lower than yieldPoint." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldNode ;
                      nltl:combinedBendingShearStress ?combinedNode .
                ?yieldNode qudt:numericValue ?yieldValue .
                ?combinedNode qudt:numericValue ?combinedValue .
                FILTER (?combinedValue >= ?yieldValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF031Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/ship> ] .

