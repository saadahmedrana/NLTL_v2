@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F02/ship> ;
            sh:resultMessage "Combined bending and shear stress must be strictly lower than the yield point, and yield shear stress must equal yield point divided by square root of 3 within a relative tolerance of 1e-6 with a small absolute fallback near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Combined bending and shear stress must be strictly lower than the yield point, and yield shear stress must equal yield point divided by square root of 3 within a relative tolerance of 1e-6 with a small absolute fallback near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldPointNode ;
                      nltl:combinedBendingShearStress ?combinedNode ;
                      nltl:yieldShearStress ?yieldShearNode .
                ?yieldPointNode qudt:numericValue ?yieldPointValue .
                ?combinedNode qudt:numericValue ?combinedValue .
                ?yieldShearNode qudt:numericValue ?yieldShearValue .
                BIND (?yieldPointValue / 1.7320508075688772 AS ?expectedYieldShearValue)
                BIND (IF(?expectedYieldShearValue > 0.000001,
                         ?expectedYieldShearValue * 0.000001,
                         0.000001) AS ?tolerance)
                FILTER (
                    ?combinedValue >= ?yieldPointValue
                    ||
                    !(
                        (?yieldShearValue >= ?expectedYieldShearValue &&
                         ?yieldShearValue <= (?expectedYieldShearValue + ?tolerance))
                        ||
                        (?yieldShearValue < ?expectedYieldShearValue &&
                         ?yieldShearValue >= (?expectedYieldShearValue - ?tolerance))
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF031Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F02/ship> ;
            sh:resultMessage "Node ex:ship->nltl:vonMisesYieldCriterion does not contain a value in the set: ['Literal(\"von Mises yield criterion\")']" ;
            sh:resultPath nltl:vonMisesYieldCriterion ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:hasValue "von Mises yield criterion" ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:vonMisesYieldCriterion ] ] .

