@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F01/member> ;
            sh:resultMessage "The hull structure must be linked to its effective member cross section." ;
            sh:resultPath nltl:hasEffectiveMemberCrossSection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:effectiveMemberCrossSection ;
                    sh:message "The hull structure must be linked to its effective member cross section." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasEffectiveMemberCrossSection ] ] .

