@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F04/effectiveSection> ;
            sh:resultMessage "Node ex:effectiveSection must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:memberNormalToPlating ] ] , [ sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal(\"When the member is not normal to the plating, classification-society section-property calculation evidence is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasClassificationSocietySectionPropertyCalculationEvidence ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:memberNormalToPlating ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-034-effective-member-cross-section> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F04/effectiveSection> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F04/effectiveSection> ;
            sh:resultMessage "The member orientation relative to the plating must be specified." ;
            sh:resultPath nltl:memberNormalToPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The member orientation relative to the plating must be specified." ;
                    sh:minCount 1 ;
                    sh:path nltl:memberNormalToPlating ] ] .

