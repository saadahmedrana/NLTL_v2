[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/effectiveSection> ;
            sh:resultMessage "The effective member cross section shall provide section modulus and shear area in the required units, and non-normal members shall have classification-society calculation evidence." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF034EffectiveMemberCrossSectionShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/effectiveSection> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/effectiveSection> ;
            sh:resultMessage "Value is not Literal with datatype qudt:QuantityValue" ;
            sh:resultPath nltl:sectionModulus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape _:n4c6c0a703db8441aba144dde3486ae8eb1 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/sectionModulus> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/effectiveSection> ;
            sh:resultMessage "Less than 1 values on ex:effectiveSection->nltl:shearArea" ;
            sh:resultPath nltl:shearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:M2 ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:shearArea ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/sectionModulus> ;
                    sh:resultMessage "Node ex:sectionModulus->qudt:unit does not contain a value in the set: ['qudt:CentiM3']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:CentiM3 ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/effectiveSection> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:CentiM3 ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:sectionModulus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n4c6c0a703db8441aba144dde3486ae8eb1 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/sectionModulus> ] .

