[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F02/ship> ;
            sh:resultMessage "The ship must provide the rule length used by the classification society." ;
            sh:resultPath nltl:classificationSocietyRuleLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:message "The ship must provide the rule length used by the classification society." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:classificationSocietyRuleLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F02/ship> ;
            sh:resultMessage "Node ex:ship->( nltl:classificationSocietyRuleLength qudt:unit ) does not contain a value in the set: ['<http://qudt.org/vocab/unit/M>']" ;
