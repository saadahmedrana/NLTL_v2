            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n5dd056aa621a4df1999a30f8abffbef8b6 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->( nltl:classificationSocietyRuleLength qudt:numericValue )" ;
            sh:resultPath ( nltl:classificationSocietyRuleLength qudt:numericValue ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:decimal ;
                    sh:minCount 1 ;
                    sh:path ( nltl:classificationSocietyRuleLength qudt:numericValue ) ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->( nltl:classificationSocietyRuleLength qudt:unit )" ;
            sh:resultPath _:n5dd056aa621a4df1999a30f8abffbef8b7 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n5dd056aa621a4df1999a30f8abffbef8b6 ] .

