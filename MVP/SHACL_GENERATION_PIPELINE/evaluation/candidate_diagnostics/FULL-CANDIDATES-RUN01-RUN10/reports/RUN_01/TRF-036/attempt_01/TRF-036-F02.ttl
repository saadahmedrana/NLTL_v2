@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/designParameters> ;
                    sh:resultMessage "The ice class, level ice thickness, and design ice load height must match Table 4-1." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:nfc6a80e6ab56428999005932094fa161b15 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:TRF036ParameterSetShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/designParameters> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF036ParameterSetShape>. See details for more information." ;
            sh:resultPath nltl:hasIceClassDesignParameterSet ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceClassDesignParameterSet ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF036ParameterSetShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceClassDesignParameterSet ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/designParameters> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/designParameters> ;
            sh:resultMessage "The ice class, level ice thickness, and design ice load height must match Table 4-1." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:nfc6a80e6ab56428999005932094fa161b15 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF036ParameterSetShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/designParameters> ] .

_:nfc6a80e6ab56428999005932094fa161b15 sh:message "The ice class, level ice thickness, and design ice load height must match Table 4-1." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:iceClass ?iceClass .
                    $this nltl:levelIceThickness ?levelNode .
                    $this nltl:designIceLoadHeight ?heightNode .
                    ?levelNode qudt:numericValue ?level .
                    ?heightNode qudt:numericValue ?height .
                    FILTER (
                        (
                            ?iceClass = nltl:iceClassIaSuper &&
                            ?level <= 1.0 &&
                            ?height >= 0.35 &&
                            ?height <= 0.35
                        ) ||
                        (
                            ?iceClass = nltl:iceClassIa &&
                            ?level <= 0.8 &&
                            ?height >= 0.30 &&
                            ?height <= 0.30
                        ) ||
                        (
                            ?iceClass = nltl:iceClassIb &&
                            ?level <= 0.6 &&
                            ?height >= 0.25 &&
                            ?height <= 0.25
                        ) ||
                        (
                            ?iceClass = nltl:iceClassIc &&
                            ?level <= 0.4 &&
                            ?height >= 0.22 &&
                            ?height <= 0.22
                        )
                    )
                }
            }
        """ .

