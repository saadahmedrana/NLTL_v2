@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F05/designParameters> ;
            sh:resultMessage "The parameter set must be linked from one ship with one permitted Finnish-Swedish ice class." ;
            sh:resultPath ( [ sh:inversePath nltl:hasIceClassDesignParameterSet ] nltl:iceClass ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceClassValue ;
                    sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc ) ;
                    sh:maxCount 1 ;
                    sh:message "The parameter set must be linked from one ship with one permitted Finnish-Swedish ice class." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path ( [ sh:inversePath nltl:hasIceClassDesignParameterSet ] nltl:iceClass ) ] ] .

