@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F05/ship> ;
            sh:resultMessage "The conditional ice-belt strengthening requirements, including the applicable spatial extent, are not satisfied." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The conditional ice-belt strengthening requirements, including the applicable spatial extent, are not satisfied." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:iceClass nltl:iceClassIaSuper .
                    FILTER NOT EXISTS {
                        $this nltl:spacing ?spacing .
                    }
                }
                UNION
                {
                    $this nltl:iceClass nltl:iceClassIaSuper .
                    FILTER NOT EXISTS {
                        $this nltl:forefootShellStrengtheningStatus ?forefoot .
                    }
                }
                UNION
                {
                    $this nltl:iceClass nltl:iceClassIaSuper .
                    FILTER NOT EXISTS {
                        $this nltl:bowRegionEquivalent ?bow .
                    }
                }
                UNION
                {
                    $this nltl:iceClass nltl:iceClassIaSuper ;
                          nltl:forefootShellStrengtheningStatus ?forefoot ;
                          nltl:bowRegionEquivalent ?bow .
                    FILTER (?forefoot != ?bow)
                }
                UNION
                {
                    $this nltl:iceClass ?iceClass ;
                          nltl:openWaterServiceSpeed ?speedNode .
                    FILTER (
                        ?iceClass = nltl:iceClassIaSuper ||
                        ?iceClass = nltl:iceClassIa
                    )
                    ?speedNode <http://qudt.org/schema/qudt/numericValue> ?speed .
                    FILTER (?speed >= 18)
                    FILTER NOT EXISTS {
                        $this nltl:upperBowIceBeltStrengtheningStatus ?upper .
                    }
                }
                UNION
                {
                    $this nltl:iceClass ?iceClass ;
                          nltl:openWaterServiceSpeed ?speedNode .
                    FILTER (
                        ?iceClass = nltl:iceClassIaSuper ||
                        ?iceClass = nltl:iceClassIa
                    )
                    ?speedNode <http://qudt.org/schema/qudt/numericValue> ?speed .
                    FILTER (?speed >= 18)
                    FILTER NOT EXISTS {
                        $this nltl:midbodyEquivalent ?midbody .
                    }
                }
                UNION
                {
                    $this nltl:iceClass ?iceClass ;
                          nltl:openWaterServiceSpeed ?speedNode ;
                          nltl:upperBowIceBeltStrengtheningStatus ?upper ;
                          nltl:midbodyEquivalent ?midbody .
                    FILTER (
                        ?iceClass = nltl:iceClassIaSuper ||
                        ?iceClass = nltl:iceClassIa
                    )
                    ?speedNode <http://qudt.org/schema/qudt/numericValue> ?speed .
                    FILTER (?speed >= 18)
                    FILTER (?upper != ?midbody)
                }
                UNION
                {
                    $this nltl:weatherDeckBelowIceBeltUpperLimit true .
                    FILTER NOT EXISTS {
                        $this nltl:bulwarkStrengthStatus true .
                    }
                }
                UNION
                {
                    $this nltl:weatherDeckBelowIceBeltUpperLimit true .
                    FILTER NOT EXISTS {
                        $this nltl:freeingPortStrengthStatus true .
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF040Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F05/ship> ] .

