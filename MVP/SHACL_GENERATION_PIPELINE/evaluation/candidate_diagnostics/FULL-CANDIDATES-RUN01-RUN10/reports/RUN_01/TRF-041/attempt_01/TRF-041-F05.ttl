@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F05/plating> ;
            sh:resultMessage "Node ex:plating->nltl:platingFramingOrientation does not contain a value in the set: ['nltl:longitudinalFramingOrientation']" ;
            sh:resultPath nltl:platingFramingOrientation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:longitudinalFramingOrientation ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:platingFramingOrientation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F05/plating> ;
            sh:resultMessage "The plating record must identify transverse or longitudinal framing and contain all inputs and the externally calculated result required for the applicable readiness branch." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF041PlatingReadinessShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F05/plating> ] .

