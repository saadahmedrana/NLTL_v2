@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F09/plating> ;
            sh:resultMessage "Node ex:plating->nltl:platingFramingOrientation does not contain a value in the set: ['nltl:longitudinalFramingOrientation']" ;
            sh:resultPath nltl:platingFramingOrientation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:longitudinalFramingOrientation ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:platingFramingOrientation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F09/plating> ;
            sh:resultMessage "A calculated required shell plating thickness in millimetres is required." ;
            sh:resultPath nltl:requiredShellPlatingThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A calculated required shell plating thickness in millimetres is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:requiredShellPlatingThickness ] ] .

