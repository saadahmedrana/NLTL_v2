@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-P01/plating> ;
            sh:resultMessage "Node ex:plating->nltl:platingFramingOrientation does not contain a value in the set: ['nltl:longitudinalFramingOrientation']" ;
            sh:resultPath nltl:platingFramingOrientation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:longitudinalFramingOrientation ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:platingFramingOrientation ] ] .

