@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P03/terminationCase> ;
                    sh:resultMessage "When the extension beyond the adjacent boundary is at most 250 mm, termination at that boundary must be permitted and no conflicting false value may be recorded." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "When the extension beyond the adjacent boundary is at most 250 mm, termination at that boundary must be permitted and no conflicting false value may be recorded." ;
                            sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?quantity .
                        ?quantity qudt:numericValue ?extension ;
                                  qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER (?extension <= 250)
                        FILTER (
                            NOT EXISTS {
                                $this nltl:iceStrengtheningTerminationAtAdjacentBoundary true
                            }
                            ||
                            EXISTS {
                                $this nltl:iceStrengtheningTerminationAtAdjacentBoundary ?conflictingValue .
                                FILTER (?conflictingValue != true)
                            }
                        )
                    }
                """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:framingIceStrengtheningTerminationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "Each termination case must state the extension beyond the adjacent boundary in millimetres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ],
                                [ sh:datatype xsd:boolean ;
                                    sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ],
                                [ sh:maxCount 1 ;
                                    sh:message "The termination boundary must be a deck structure, tank boundary plating, or tank top." ;
                                    sh:minCount 1 ;
                                    sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] ) ;
                                    sh:path nltl:terminationAdjacentBoundary ] ;
                            sh:sparql [ a sh:SPARQLConstraint ;
                                    sh:message "When the extension beyond the adjacent boundary is at most 250 mm, termination at that boundary must be permitted and no conflicting false value may be recorded." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?quantity .
                        ?quantity qudt:numericValue ?extension ;
                                  qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER (?extension <= 250)
                        FILTER (
                            NOT EXISTS {
                                $this nltl:iceStrengtheningTerminationAtAdjacentBoundary true
                            }
                            ||
                            EXISTS {
                                $this nltl:iceStrengtheningTerminationAtAdjacentBoundary ?conflictingValue .
                                FILTER (?conflictingValue != true)
                            }
                        )
                    }
                """ ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P03/terminationCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P03/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:class nltl:framingIceStrengtheningTerminationCase ; sh:property [ sh:datatype xsd:boolean ; sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Each termination case must state the extension beyond the adjacent boundary in millimetres.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The termination boundary must be a deck structure, tank boundary plating, or tank top.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] ) ; sh:path nltl:terminationAdjacentBoundary ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("When the extension beyond the adjacent boundary is at most 250 mm, termination at that boundary must be permitted and no conflicting false value may be recorded.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?quantity .
                        ?quantity qudt:numericValue ?extension ;
                                  qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER (?extension <= 250)
                        FILTER (
                            NOT EXISTS {
                                $this nltl:iceStrengtheningTerminationAtAdjacentBoundary true
                            }
                            ||
                            EXISTS {
                                $this nltl:iceStrengtheningTerminationAtAdjacentBoundary ?conflictingValue .
                                FILTER (?conflictingValue != true)
                            }
                        )
                    }
                ") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasFramingIceStrengtheningTerminationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:framingIceStrengtheningTerminationCase ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ],
                                [ sh:maxCount 1 ;
                                    sh:message "The termination boundary must be a deck structure, tank boundary plating, or tank top." ;
                                    sh:minCount 1 ;
                                    sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] ) ;
                                    sh:path nltl:terminationAdjacentBoundary ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each termination case must state the extension beyond the adjacent boundary in millimetres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ;
                            sh:sparql [ a sh:SPARQLConstraint ;
                                    sh:message "When the extension beyond the adjacent boundary is at most 250 mm, termination at that boundary must be permitted and no conflicting false value may be recorded." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?quantity .
                        ?quantity qudt:numericValue ?extension ;
                                  qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER (?extension <= 250)
                        FILTER (
                            NOT EXISTS {
                                $this nltl:iceStrengtheningTerminationAtAdjacentBoundary true
                            }
                            ||
                            EXISTS {
                                $this nltl:iceStrengtheningTerminationAtAdjacentBoundary ?conflictingValue .
                                FILTER (?conflictingValue != true)
                            }
                        )
                    }
                """ ] ] ;
                    sh:path nltl:hasFramingIceStrengtheningTerminationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P03/terminationCase> ] .

