@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P04/terminationCase> ;
                    sh:resultMessage """Node ex:terminationCase must conform to one or more shapes in [ sh:sparql [ sh:message Literal("An extension greater than 250 mm is outside the conditional termination limit.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?quantity .
                        ?quantity qudt:numericValue ?value .
                        FILTER (xsd:decimal(?value) > 250)
                    }
                ") ] ] , [ sh:node <urn:nltl:generated-shape:TRF-043-ApplicableTerminationShape> ]""" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:TRF-043-TerminationCaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P04/terminationCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF-043-TerminationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasFramingIceStrengtheningTerminationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:TRF-043-TerminationCaseShape> ;
                    sh:path nltl:hasFramingIceStrengtheningTerminationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P04/terminationCase> ] .

