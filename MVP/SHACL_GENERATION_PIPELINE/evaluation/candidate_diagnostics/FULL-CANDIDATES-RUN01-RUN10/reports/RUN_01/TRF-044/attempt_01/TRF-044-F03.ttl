@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F03/transverseFrame> ;
            sh:resultMessage "Node nltl:bulkCarrierTopWingTankFrameCondition must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:bulkCarrierTopWingTankFrameCondition ; sh:path nltl:frameBoundaryConditionType ] ] , [ sh:property [ sh:hasValue nltl:singleDeckTankTopToMainDeckFrameCondition ; sh:path nltl:frameBoundaryConditionType ] ] , [ sh:property [ sh:hasValue nltl:multiDeckOrStringerContinuousFrameCondition ; sh:path nltl:frameBoundaryConditionType ] ] , [ sh:property [ sh:hasValue nltl:twoDeckFrameCondition ; sh:path nltl:frameBoundaryConditionType ] ]" ;
            sh:resultPath nltl:frameBoundaryConditionType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:property [ sh:hasValue nltl:bulkCarrierTopWingTankFrameCondition ;
                                        sh:path nltl:frameBoundaryConditionType ] ] [ sh:property [ sh:hasValue nltl:singleDeckTankTopToMainDeckFrameCondition ;
                                        sh:path nltl:frameBoundaryConditionType ] ] [ sh:property [ sh:hasValue nltl:multiDeckOrStringerContinuousFrameCondition ;
                                        sh:path nltl:frameBoundaryConditionType ] ] [ sh:property [ sh:hasValue nltl:twoDeckFrameCondition ;
                                        sh:path nltl:frameBoundaryConditionType ] ] ) ;
                    sh:path nltl:frameBoundaryConditionType ] ;
            sh:value nltl:bulkCarrierTopWingTankFrameCondition ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F03/transverseFrame> ;
            sh:resultMessage "Frame factors and calculated section modulus and shear area must satisfy the Table 4-7 selection and formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Frame factors and calculated section modulus and shear area must satisfy the Table 4-7 selection and formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                      nltl:spacing/qudt:numericValue ?s ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:span/qudt:numericValue ?l ;
                      nltl:frameBoundaryConditionType ?condition ;
                      nltl:frameBoundaryConditionFactorM0/qudt:numericValue ?m0 ;
                      nltl:yieldStrength/qudt:numericValue ?sigma ;
                      nltl:frameMomentFactorMt/qudt:numericValue ?mt ;
                      nltl:sectionModulus/qudt:numericValue ?z ;
                      nltl:requiredShearArea/qudt:numericValue ?a .
                BIND(
                    IF(?condition = nltl:bulkCarrierTopWingTankFrameCondition, 7,
                    IF(?condition = nltl:singleDeckTankTopToMainDeckFrameCondition, 6,
                    IF(?condition = nltl:multiDeckOrStringerContinuousFrameCondition, 5.7,
                    IF(?condition = nltl:twoDeckFrameCondition, 5, 0))))
                    AS ?expectedM0
                )
                BIND((7 * ?expectedM0) / (7 - 5 * ?h / ?l) AS ?expectedMt)
                BIND((?p * ?s * ?h * ?l / (?expectedMt * ?sigma)) * 1000000 AS ?expectedZ)
                BIND((1.7320508075688772 * 1.2 * ?p * ?h * ?s / (2 * ?sigma)) * 10000 AS ?expectedA)
                FILTER(
                    ?m0 != ?expectedM0 ||
                    ABS(?mt - ?expectedMt) > (ABS(?expectedMt) * 0.000001 + 0.000000001) ||
                    ABS(?z - ?expectedZ) > (ABS(?expectedZ) * 0.000001 + 0.000001) ||
                    ABS(?a - ?expectedA) > (ABS(?expectedA) * 0.000001 + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF044TransverseFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F03/transverseFrame> ] .

