@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F05/transverseFrame> ;
            sh:resultMessage "Node nltl:bulkCarrierTopWingTankFrameCondition must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:bulkCarrierTopWingTankFrameCondition ; sh:path nltl:frameBoundaryConditionType ] ] , [ sh:property [ sh:hasValue nltl:singleDeckTankTopToMainDeckFrameCondition ; sh:path nltl:frameBoundaryConditionType ] ] , [ sh:property [ sh:hasValue nltl:multiDeckOrStringerContinuousFrameCondition ; sh:path nltl:frameBoundaryConditionType ] ] , [ sh:property [ sh:hasValue nltl:twoDeckFrameCondition ; sh:path nltl:frameBoundaryConditionType ] ]" ;
            sh:resultPath nltl:frameBoundaryConditionType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:property [ sh:hasValue nltl:bulkCarrierTopWingTankFrameCondition ;
                                        sh:path nltl:frameBoundaryConditionType ] ] [ sh:property [ sh:hasValue nltl:singleDeckTankTopToMainDeckFrameCondition ;
                                        sh:path nltl:frameBoundaryConditionType ] ] [ sh:property [ sh:hasValue nltl:multiDeckOrStringerContinuousFrameCondition ;
                                        sh:path nltl:frameBoundaryConditionType ] ] [ sh:property [ sh:hasValue nltl:twoDeckFrameCondition ;
                                        sh:path nltl:frameBoundaryConditionType ] ] ) ;
                    sh:path nltl:frameBoundaryConditionType ] ;
            sh:value nltl:bulkCarrierTopWingTankFrameCondition ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F05/transverseFrame> ;
            sh:resultMessage "Less than 1 values on ex:transverseFrame->nltl:span" ;
            sh:resultPath nltl:span ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:span ] ] .

