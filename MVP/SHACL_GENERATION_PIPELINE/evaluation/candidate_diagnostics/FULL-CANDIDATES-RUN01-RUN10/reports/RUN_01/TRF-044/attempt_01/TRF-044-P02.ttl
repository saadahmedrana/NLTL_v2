@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-P02/transverseFrame> ;
            sh:resultMessage "Node nltl:singleDeckTankTopToMainDeckFrameCondition must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:bulkCarrierTopWingTankFrameCondition ; sh:path nltl:frameBoundaryConditionType ] ] , [ sh:property [ sh:hasValue nltl:singleDeckTankTopToMainDeckFrameCondition ; sh:path nltl:frameBoundaryConditionType ] ] , [ sh:property [ sh:hasValue nltl:multiDeckOrStringerContinuousFrameCondition ; sh:path nltl:frameBoundaryConditionType ] ] , [ sh:property [ sh:hasValue nltl:twoDeckFrameCondition ; sh:path nltl:frameBoundaryConditionType ] ]" ;
            sh:resultPath nltl:frameBoundaryConditionType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:property [ sh:hasValue nltl:bulkCarrierTopWingTankFrameCondition ;
                                        sh:path nltl:frameBoundaryConditionType ] ] [ sh:property [ sh:hasValue nltl:singleDeckTankTopToMainDeckFrameCondition ;
                                        sh:path nltl:frameBoundaryConditionType ] ] [ sh:property [ sh:hasValue nltl:multiDeckOrStringerContinuousFrameCondition ;
                                        sh:path nltl:frameBoundaryConditionType ] ] [ sh:property [ sh:hasValue nltl:twoDeckFrameCondition ;
                                        sh:path nltl:frameBoundaryConditionType ] ] ) ;
                    sh:path nltl:frameBoundaryConditionType ] ;
            sh:value nltl:singleDeckTankTopToMainDeckFrameCondition ] .

