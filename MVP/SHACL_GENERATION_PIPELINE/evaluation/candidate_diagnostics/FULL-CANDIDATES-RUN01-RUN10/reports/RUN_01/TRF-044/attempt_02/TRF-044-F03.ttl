@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F03/transverseFrame> ;
            sh:resultMessage "The frame factors and calculated section modulus and shear area must satisfy the Table 4-7 selection and the declared formulas within an expected-result-scaled tolerance of 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The frame factors and calculated section modulus and shear area must satisfy the Table 4-7 selection and the declared formulas within an expected-result-scaled tolerance of 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType ?condition ;
                      nltl:icePressure ?pNode ;
                      nltl:spacing ?sNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?sNode qudt:numericValue ?s .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?m0Node qudt:numericValue ?m0 .
                ?sigmaNode qudt:numericValue ?sigma .
                ?mtNode qudt:numericValue ?mt .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND(
                    IF(?condition = nltl:bulkCarrierTopWingTankFrameCondition, 7.0,
                        IF(?condition = nltl:singleDeckTankTopToMainDeckFrameCondition, 6.0,
                            IF(?condition = nltl:multiDeckOrStringerContinuousFrameCondition, 5.7,
                                IF(?condition = nltl:twoDeckFrameCondition, 5.0, -1.0)
                            )
                        )
                    ) AS ?tableM0
                )
                BIND(7.0 * ?tableM0 / (7.0 - 5.0 * ?h / ?l) AS ?expectedMt)
                BIND(?p * ?s * ?h * ?l / (?expectedMt * ?sigma) * 1000000.0 AS ?expectedZ)
                BIND(1.7320508075688772 * 1.2 * ?p * ?h * ?s / (2.0 * ?sigma) * 10000.0 AS ?expectedA)

                FILTER(
                    ?m0 != ?tableM0 ||
                    ABS(?mt - ?expectedMt) >
                        0.000001 * IF(ABS(?expectedMt) > 1.0, ABS(?expectedMt), 1.0) ||
                    ABS(?z - ?expectedZ) >
                        0.000001 * IF(ABS(?expectedZ) > 1.0, ABS(?expectedZ), 1.0) ||
                    ABS(?a - ?expectedA) >
                        0.000001 * IF(ABS(?expectedA) > 1.0, ABS(?expectedA), 1.0)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF044TransverseFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F03/transverseFrame> ] .

