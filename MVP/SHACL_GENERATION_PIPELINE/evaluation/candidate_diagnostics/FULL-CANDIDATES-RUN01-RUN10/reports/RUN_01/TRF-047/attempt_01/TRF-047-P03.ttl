@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P03/frame> ;
            sh:resultMessage "Each strengthened part of a main frame or intermediate ice frame shall be a transverse frame with a lower end." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each strengthened part of a main frame or intermediate ice frame shall be a transverse frame with a lower end." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this a nltl:frame ;
                      nltl:hasStrengthenedPart ?part .
                FILTER (
                    EXISTS { $this a nltl:mainFrame }
                    || EXISTS { $this a nltl:intermediateIceFrame }
                )
                FILTER NOT EXISTS {
                    ?part a nltl:transverseFrame ;
                          nltl:hasLowerEnd ?end .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-047> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P03/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P03/frame> ;
            sh:resultMessage "A main frame shall be ice strengthened below the lower edge of the ice belt." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A main frame shall be ice strengthened below the lower edge of the ice belt." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this a nltl:frame ,
                      nltl:mainFrame .
                FILTER NOT EXISTS {
                    $this nltl:mainFrameBelowIceBeltStrengthened true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-047> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P03/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P03/frame> ;
            sh:resultMessage "Each frame shall have a strengthened part with a lower end." ;
            sh:resultPath ( nltl:hasStrengthenedPart nltl:hasLowerEnd ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Each frame shall have a strengthened part with a lower end." ;
                    sh:minCount 1 ;
                    sh:path ( nltl:hasStrengthenedPart nltl:hasLowerEnd ) ] ] .

