@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/frame> ;
            sh:resultMessage "Each frame shall have a strengthened part with a lower end." ;
            sh:resultPath _:nd6bd3c89a3c649508bb61bf8a4bc9555b3 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd6bd3c89a3c649508bb61bf8a4bc9555b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/frame> ;
            sh:resultMessage "Each strengthened part of a main frame or intermediate ice frame shall be a transverse frame with a lower end." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each strengthened part of a main frame or intermediate ice frame shall be a transverse frame with a lower end." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this a nltl:frame ;
                      nltl:hasStrengthenedPart ?part .
                FILTER (
                    EXISTS { $this a nltl:mainFrame }
                    || EXISTS { $this a nltl:intermediateIceFrame }
                )
                FILTER NOT EXISTS {
                    ?part a nltl:transverseFrame ;
                          nltl:hasLowerEnd ?end .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-047> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/adjacentMainFrame> ;
            sh:resultMessage "A frame shall have a strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A frame shall have a strengthened part." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasStrengthenedPart ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/adjacentMainFrame> ;
            sh:resultMessage "Each frame shall have a strengthened part with a lower end." ;
            sh:resultPath _:nd6bd3c89a3c649508bb61bf8a4bc9555b3 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd6bd3c89a3c649508bb61bf8a4bc9555b2 ] .

_:Naa15ff71d3f348a4a97469a75280139c rdf:first nltl:hasLowerEnd ;
    rdf:rest () .

_:Nb4260db6919f460f906ca4be3f0a477f rdf:first nltl:hasLowerEnd ;
    rdf:rest () .

_:Ncc0168e23a6f4b7a85ddcf243e9a6715 rdf:first nltl:hasStrengthenedPart ;
    rdf:rest _:Naa15ff71d3f348a4a97469a75280139c .

_:nd6bd3c89a3c649508bb61bf8a4bc9555b2 sh:message "Each frame shall have a strengthened part with a lower end." ;
    sh:minCount 1 ;
    sh:path _:Ncc0168e23a6f4b7a85ddcf243e9a6715 .

_:nd6bd3c89a3c649508bb61bf8a4bc9555b3 rdf:first nltl:hasStrengthenedPart ;
    rdf:rest _:Nb4260db6919f460f906ca4be3f0a477f .

