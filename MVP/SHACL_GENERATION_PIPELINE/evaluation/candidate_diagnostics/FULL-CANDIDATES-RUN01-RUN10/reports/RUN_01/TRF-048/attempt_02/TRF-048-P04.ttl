@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-P04/longitudinalFrame> ;
            sh:resultMessage "Frame calculation results must satisfy the declared f4, section-modulus, shear-area, and bracket-exclusion formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Frame calculation results must satisfy the declared f4, section-modulus, shear-area, and bracket-exclusion formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:spacing ?sNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Node ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode ;
                      nltl:bracketArea ?bNode ;
                      nltl:actualFrameShearArea ?actualNode .
                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?sNode qudt:numericValue ?s .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?sigmaNode qudt:numericValue ?sigma .
                ?f4Node qudt:numericValue ?f4 .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .
                ?bNode qudt:numericValue ?b .
                ?actualNode qudt:numericValue ?actual .
                BIND (1.0 - 0.2 * ?h / ?s AS ?expectedF4)
                BIND (?expectedF4 * ?p * ?h * ?l * ?l / (4.0 * ?m * ?sigma) * 1000000.0 AS ?expectedZ)
                BIND (1.7320508075688773 * ?expectedF4 * 2.16 * ?p * ?h * ?l / (2.0 * ?sigma) * 10000.0 AS ?expectedA)
                BIND (?expectedA - ?b AS ?expectedActual)
                BIND (IF(?expectedF4 >= 0.0, ?expectedF4 * 0.000001 + 0.000000000001, (-?expectedF4) * 0.000001 + 0.000000000001) AS ?tolF4)
                BIND (IF(?expectedZ >= 0.0, ?expectedZ * 0.000001 + 0.000000000001, (-?expectedZ) * 0.000001 + 0.000000000001) AS ?tolZ)
                BIND (IF(?expectedA >= 0.0, ?expectedA * 0.000001 + 0.000000000001, (-?expectedA) * 0.000001 + 0.000000000001) AS ?tolA)
                BIND (IF(?expectedActual >= 0.0, ?expectedActual * 0.000001 + 0.000000000001, (-?expectedActual) * 0.000001 + 0.000000000001) AS ?tolActual)
                FILTER (
                    ?f4 < (?expectedF4 - ?tolF4) ||
                    ?f4 > (?expectedF4 + ?tolF4) ||
                    ?z < (?expectedZ - ?tolZ) ||
                    ?z > (?expectedZ + ?tolZ) ||
                    ?a < (?expectedA - ?tolA) ||
                    ?a > (?expectedA + ?tolA) ||
                    ?actual < (?expectedActual - ?tolActual) ||
                    ?actual > (?expectedActual + ?tolActual)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-048-LongitudinalFrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-P04/longitudinalFrame> ] .

