@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F01/frame> ;
            sh:resultMessage "The frame must be effectively attached to its supporting structures." ;
            sh:resultPath nltl:effectiveAttachmentConfirmed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The frame must be effectively attached to its supporting structures." ;
                    sh:minCount 1 ;
                    sh:path nltl:effectiveAttachmentConfirmed ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F01/frame> ;
            sh:resultMessage "Less than 1 values on ex:frame->nltl:frameWebThickness" ;
            sh:resultPath nltl:frameWebThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:frameWebThickness ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F01/frame> ;
            sh:resultMessage "Less than 1 values on ex:frame->nltl:hasFrameAttachment" ;
            sh:resultPath nltl:hasFrameAttachment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:frameAttachmentRecord ;
                            sh:property [ sh:node [ sh:class nltl:connectionBracket ;
                                            sh:property [ sh:datatype xsd:boolean ;
                                                    sh:hasValue true ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:bracketEdgeStiffened ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:bracketThickness ],
                                                [ sh:datatype xsd:boolean ;
                                                    sh:hasValue true ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:bucklingStiffening ] ] ;
                                    sh:path nltl:hasConnectionBracket ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:effectiveAttachmentConfirmed ],
                                [ sh:datatype xsd:boolean ;
                                    sh:maxCount 1 ;
                                    sh:path nltl:similarAttachmentConstructionPresent ] ] ;
                    sh:path nltl:hasFrameAttachment ] ] .

