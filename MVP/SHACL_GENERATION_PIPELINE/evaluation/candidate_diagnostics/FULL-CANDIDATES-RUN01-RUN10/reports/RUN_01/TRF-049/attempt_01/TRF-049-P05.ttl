@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P05/frame> ;
            sh:resultMessage "Less than 1 values on ex:frame->nltl:hasFrameAttachment" ;
            sh:resultPath nltl:hasFrameAttachment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:frameAttachmentRecord ;
                            sh:property [ sh:node [ sh:class nltl:connectionBracket ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:bracketThickness ],
                                                [ sh:datatype xsd:boolean ;
                                                    sh:hasValue true ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:bucklingStiffening ],
                                                [ sh:datatype xsd:boolean ;
                                                    sh:hasValue true ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:bracketEdgeStiffened ] ] ;
                                    sh:path nltl:hasConnectionBracket ],
                                [ sh:datatype xsd:boolean ;
                                    sh:maxCount 1 ;
                                    sh:path nltl:similarAttachmentConstructionPresent ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:effectiveAttachmentConfirmed ] ] ;
                    sh:path nltl:hasFrameAttachment ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P05/frame> ;
            sh:resultMessage "Less than 1 values on ex:frame->nltl:frameWebThickness" ;
            sh:resultPath nltl:frameWebThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:frameWebThickness ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P05/frame> ;
            sh:resultMessage "A transverse frame terminating at a deck or ice stringer must have a bracket or similar construction." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A transverse frame terminating at a deck or ice stringer must have a bracket or similar construction." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:terminatesAtDeckOrIceStringer true .
  FILTER (
    NOT EXISTS {
      $this nltl:hasFrameAttachment ?attachment .
      ?attachment ?predicate ?value .
      FILTER (
        ?predicate = nltl:hasConnectionBracket ||
        (?predicate = nltl:similarAttachmentConstructionPresent && ?value = true)
      )
    }
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-049_TransverseFrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P05/frame> ] .

