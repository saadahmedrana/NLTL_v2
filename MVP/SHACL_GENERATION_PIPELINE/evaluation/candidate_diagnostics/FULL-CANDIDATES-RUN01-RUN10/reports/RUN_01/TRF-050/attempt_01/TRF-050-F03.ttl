@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F03/attachmentRecord> ;
            sh:resultMessage "The frame must be attached to the shell by a double continuous weld." ;
            sh:resultPath nltl:frameShellWeldType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ncbf7947f4a7341cdb4020e1b9cbea6f5b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F03/attachmentRecord> ;
            sh:resultMessage "The frame must be attached to the shell by a double continuous weld." ;
            sh:resultPath nltl:frameShellWeldType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ncbf7947f4a7341cdb4020e1b9cbea6f5b3 ] .

_:ncbf7947f4a7341cdb4020e1b9cbea6f5b3 sh:datatype nltl:weldTypeValue ;
    sh:hasValue nltl:doubleContinuousWeld ;
    sh:maxCount 1 ;
    sh:message "The frame must be attached to the shell by a double continuous weld." ;
    sh:minCount 1 ;
    sh:path nltl:frameShellWeldType .

