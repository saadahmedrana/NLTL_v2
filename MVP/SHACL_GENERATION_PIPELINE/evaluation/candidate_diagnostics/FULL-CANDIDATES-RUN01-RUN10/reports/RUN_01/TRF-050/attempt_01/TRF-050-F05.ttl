            sh:resultPath [ sh:inversePath nltl:frameAttachment ] ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frame ;
                    sh:message "Each frame attachment record must be linked from a frame." ;
                    sh:minCount 1 ;
                    sh:path [ sh:inversePath nltl:frameAttachment ] ] ],
        [ a sh:ValidationResult ;
