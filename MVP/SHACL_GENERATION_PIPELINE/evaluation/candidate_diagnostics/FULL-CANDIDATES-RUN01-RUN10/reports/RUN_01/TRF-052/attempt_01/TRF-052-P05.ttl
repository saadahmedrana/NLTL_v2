@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P05/frame> ;
            sh:resultMessage "The antitripping support regions must match the frame span and ice-class applicability required by the regulation, unless equivalent support is demonstrated by direct calculation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The antitripping support regions must match the frame span and ice-class applicability required by the regulation, unless equivalent support is demonstrated by direct calculation." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX q: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:frameSpan ?spanNode ;
                      nltl:iceClass ?ice .
                ?spanNode q:numericValue ?span .

                FILTER (
                    NOT EXISTS {
                        $this nltl:equivalentSupportStatusByDirectCalculation true
                    }
                    &&
                    (
                        (
                            ?span > 4.0
                            &&
                            (
                                NOT EXISTS {
                                    $this nltl:hasAntitrippingSupportRegion ?r .
                                    FILTER (
                                        ?r IN (
                                            nltl:bowRegion,
                                            nltl:midbodyRegion,
                                            nltl:sternRegion,
                                            nltl:otherIceStrengthenedAreaValue
                                        )
                                    )
                                }
                                ||
                                EXISTS {
                                    $this nltl:hasAntitrippingSupportRegion ?r .
                                    FILTER (
                                        ?r NOT IN (
                                            nltl:bowRegion,
                                            nltl:midbodyRegion,
                                            nltl:sternRegion,
                                            nltl:otherIceStrengthenedAreaValue
                                        )
                                    )
                                }
                            )
                        )
                        ||
                        (
                            ?span <= 4.0
                            &&
                            (
                                (
                                    ?ice = nltl:iceClassIaSuper
                                    &&
                                    (
                                        NOT EXISTS {
                                            $this nltl:hasAntitrippingSupportRegion ?r .
                                            FILTER (
                                                ?r IN (
                                                    nltl:bowRegion,
                                                    nltl:midbodyRegion,
                                                    nltl:sternRegion,
                                                    nltl:otherIceStrengthenedAreaValue
                                                )
                                            )
                                        }
                                        ||
                                        EXISTS {
                                            $this nltl:hasAntitrippingSupportRegion ?r .
                                            FILTER (
                                                ?r NOT IN (
                                                    nltl:bowRegion,
                                                    nltl:midbodyRegion,
                                                    nltl:sternRegion,
                                                    nltl:otherIceStrengthenedAreaValue
                                                )
                                            )
                                        }
                                    )
                                )
                                ||
                                (
                                    ?ice = nltl:iceClassIa
                                    &&
                                    (
                                        NOT EXISTS {
                                            $this nltl:hasAntitrippingSupportRegion ?r .
                                            FILTER (
                                                ?r IN (
                                                    nltl:bowRegion,
                                                    nltl:midbodyRegion
                                                )
                                            )
                                        }
                                        ||
                                        EXISTS {
                                            $this nltl:hasAntitrippingSupportRegion ?r .
                                            FILTER (
                                                ?r NOT IN (
                                                    nltl:bowRegion,
                                                    nltl:midbodyRegion
                                                )
                                            )
                                        }
                                    )
                                )
                                ||
                                (
                                    (
                                        ?ice = nltl:iceClassIb ||
                                        ?ice = nltl:iceClassIc
                                    )
                                    &&
                                    (
                                        NOT EXISTS {
                                            $this nltl:hasAntitrippingSupportRegion ?r .
                                            FILTER (?r = nltl:bowRegion)
                                        }
                                        ||
                                        EXISTS {
                                            $this nltl:hasAntitrippingSupportRegion ?r .
                                            FILTER (?r != nltl:bowRegion)
                                        }
                                    )
                                )
                            )
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF052FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P05/frame> ] .

