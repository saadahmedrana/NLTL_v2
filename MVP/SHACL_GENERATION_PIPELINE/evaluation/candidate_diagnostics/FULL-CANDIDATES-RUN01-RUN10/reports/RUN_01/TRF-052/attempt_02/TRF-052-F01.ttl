@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F01/frame> ;
            sh:resultMessage "When the frame is asymmetrical or its web angle is below 90 degrees, antitripping support spacing must not exceed 1300 mm, unless an equivalent arrangement is demonstrated." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the frame is asymmetrical or its web angle is below 90 degrees, antitripping support spacing must not exceed 1300 mm, unless an equivalent arrangement is demonstrated." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:equivalentSupportStatusByDirectCalculation true .
                }
                {
                    $this nltl:frameAsymmetrical true .
                }
                UNION
                {
                    $this nltl:frameWebAngleToShell ?angleQuantity .
                    ?angleQuantity qudt:numericValue ?angle .
                    FILTER (?angle < 90)
                }
                FILTER NOT EXISTS {
                    $this nltl:antitrippingSupportSpacing ?spacingQuantity .
                    ?spacingQuantity qudt:numericValue ?spacing .
                    FILTER (?spacing <= 1300)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-052-FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F01/frame> ] .

