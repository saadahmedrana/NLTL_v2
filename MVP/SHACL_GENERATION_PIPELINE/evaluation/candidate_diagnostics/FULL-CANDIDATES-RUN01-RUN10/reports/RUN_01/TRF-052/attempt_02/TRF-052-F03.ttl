@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F03/frame> ;
            sh:resultMessage "The required antitripping support regions must all be represented for the frame span and ice class." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The required antitripping support regions must all be represented for the frame span and ice class." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:equivalentSupportStatusByDirectCalculation true .
                }
                FILTER NOT EXISTS {
                    {
                        $this nltl:frameSpan ?spanQuantity .
                        ?spanQuantity qudt:numericValue ?span .
                        FILTER (?span > 4)
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion .
                        $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion .
                        $this nltl:hasAntitrippingSupportRegion nltl:sternRegion .
                        $this nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue .
                    }
                    UNION
                    {
                        $this nltl:frameSpan ?spanQuantity .
                        ?spanQuantity qudt:numericValue ?span .
                        FILTER (?span <= 4)
                        $this nltl:iceClass nltl:iceClassIaSuper .
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion .
                        $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion .
                        $this nltl:hasAntitrippingSupportRegion nltl:sternRegion .
                        $this nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue .
                    }
                    UNION
                    {
                        $this nltl:frameSpan ?spanQuantity .
                        ?spanQuantity qudt:numericValue ?span .
                        FILTER (?span <= 4)
                        $this nltl:iceClass nltl:iceClassIa .
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion .
                        $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion .
                    }
                    UNION
                    {
                        $this nltl:frameSpan ?spanQuantity .
                        ?spanQuantity qudt:numericValue ?span .
                        FILTER (?span <= 4)
                        {
                            $this nltl:iceClass nltl:iceClassIb .
                        }
                        UNION
                        {
                            $this nltl:iceClass nltl:iceClassIc .
                        }
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion .
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-052-FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F03/frame> ] .

