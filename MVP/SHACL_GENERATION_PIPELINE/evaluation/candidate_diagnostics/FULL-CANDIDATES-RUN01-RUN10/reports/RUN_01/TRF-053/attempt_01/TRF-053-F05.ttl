@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/iceStringer> ;
            sh:resultMessage "designLineLoad must equal max(icePressure times designIceLoadHeight, 0.15), within relative tolerance 1e-6 and absolute tolerance 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "designLineLoad must equal max(icePressure times designIceLoadHeight, 0.15), within relative tolerance 1e-6 and absolute tolerance 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:designIceLoadHeight ?heightNode ;
                      nltl:designLineLoad ?lineLoadNode .
                ?pressureNode qudt:numericValue ?pressure .
                ?heightNode qudt:numericValue ?height .
                ?lineLoadNode qudt:numericValue ?lineLoad .
                BIND((?pressure * ?height) AS ?product)
                BIND(IF(?product < 0.15, 0.15, ?product) AS ?expected)
                FILTER(
                    ABS(?lineLoad - ?expected) >
                    (ABS(?expected) * 0.000001 + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF053IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/iceStringer> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/designLineLoadValue> ;
                    sh:resultMessage "Node ex:designLineLoadValue->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/KiloN-PER-M>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/iceStringer> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:designLineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:designLineLoad ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/designLineLoadValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/iceStringer> ;
            sh:resultMessage "sectionModulus and requiredShearArea must satisfy the declared ice stringer formulas within relative tolerance 1e-6 and absolute tolerance 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "sectionModulus and requiredShearArea must satisfy the declared ice stringer formulas within relative tolerance 1e-6 and absolute tolerance 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designLineLoad ?lineLoadNode ;
                      nltl:span ?spanNode ;
                      nltl:frameMomentFactorM ?momentFactorNode ;
                      nltl:yieldStrength ?yieldNode ;
                      nltl:sectionModulus ?sectionModulusNode ;
                      nltl:requiredShearArea ?shearAreaNode .
                ?lineLoadNode qudt:numericValue ?lineLoad .
                ?spanNode qudt:numericValue ?span .
                ?momentFactorNode qudt:numericValue ?momentFactor .
                ?yieldNode qudt:numericValue ?yieldStrength .
                ?sectionModulusNode qudt:numericValue ?sectionModulus .
                ?shearAreaNode qudt:numericValue ?shearArea .
                BIND(
                    (0.9 * 1.8 * ?lineLoad * ?span * ?span /
                    (?momentFactor * ?yieldStrength) * 1000000)
                    AS ?expectedSectionModulus
                )
                BIND(
                    (1.7320508075688772 * 0.9 * 1.8 * 1.2 * ?lineLoad * ?span /
                    (2 * ?yieldStrength) * 10000)
                    AS ?expectedShearArea
                )
                FILTER(
                    ABS(?sectionModulus - ?expectedSectionModulus) >
                    (ABS(?expectedSectionModulus) * 0.000001 + 0.000001)
                    ||
                    ABS(?shearArea - ?expectedShearArea) >
                    (ABS(?expectedShearArea) * 0.000001 + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF053IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/iceStringer> ] .

