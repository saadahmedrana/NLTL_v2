@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F03/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:hatchOpeningLength" ;
            sh:resultPath nltl:hatchOpeningLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node g:TRF055QuantityLengthM ;
                    sh:path nltl:hatchOpeningLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F03/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:designLineLoad" ;
            sh:resultPath nltl:designLineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node g:TRF055QuantityForcePerLength ;
                    sh:path nltl:designLineLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F03/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:scantlingApprovalStatus" ;
            sh:resultPath nltl:scantlingApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:evidenceStateApproved nltl:evidenceStateDraft nltl:evidenceStateExpired nltl:evidenceStateRejected nltl:evidenceStateRevoked nltl:evidenceStateSubmitted nltl:evidenceStateUnderReview ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:scantlingApprovalStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F03/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:sectionModulus" ;
            sh:resultPath nltl:sectionModulus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node g:TRF055QuantitySectionModulusCm3 ;
                    sh:path nltl:sectionModulus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F03/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:shipBreadth" ;
            sh:resultPath nltl:shipBreadth ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node g:TRF055QuantityLengthM ;
                    sh:path nltl:shipBreadth ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F03/narrowDeckStrip> ;
            sh:resultMessage "For an applicable narrow deck strip, the actual section modulus and shear area must meet their required values; a very-long-hatch reduced line load must be approved and lie from 0.10 inclusive to below 0.15 kN/m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an applicable narrow deck strip, the actual section modulus and shear area must meet their required values; a very-long-hatch reduced line load must be approved and lie from 0.10 inclusive to below 0.15 kN/m." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:abreastOfHatch true ;
                      nltl:servesAsIceStringer true ;
                      nltl:veryLongHatchOpening ?veryLong ;
                      nltl:actualSectionModulus ?actualZ ;
                      nltl:requiredSectionModulus ?requiredZ ;
                      nltl:actualShearArea ?actualA ;
                      nltl:requiredShearArea ?requiredA .

                ?actualZ qudt:numericValue ?actualZValue .
                ?requiredZ qudt:numericValue ?requiredZValue .
                ?actualA qudt:numericValue ?actualAValue .
                ?requiredA qudt:numericValue ?requiredAValue .

                FILTER (
                    xsd:decimal(?actualZValue) < xsd:decimal(?requiredZValue)
                    ||
                    xsd:decimal(?actualAValue) < xsd:decimal(?requiredAValue)
                    ||
                    (
                        ?veryLong = true &&
                        (
                            NOT EXISTS {
                                $this nltl:permittedReducedLineLoad ?reducedLoad ;
                                      nltl:reducedLineLoadApprovedByClassificationSociety true .
                                ?reducedLoad qudt:numericValue ?reducedValue .
                            }
                            ||
                            EXISTS {
                                $this nltl:permittedReducedLineLoad ?reducedLoad ;
                                      nltl:reducedLineLoadApprovedByClassificationSociety true .
                                ?reducedLoad qudt:numericValue ?reducedValue .
                                FILTER (
                                    xsd:decimal(?reducedValue) < 0.10
                                    ||
                                    xsd:decimal(?reducedValue) >= 0.15
                                )
                            }
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape g:TRF055NarrowDeckStripShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F03/narrowDeckStrip> ] .

