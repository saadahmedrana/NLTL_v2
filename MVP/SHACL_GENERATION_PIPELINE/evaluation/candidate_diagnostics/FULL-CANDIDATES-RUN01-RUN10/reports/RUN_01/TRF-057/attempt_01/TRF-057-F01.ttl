@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "webFrameIceLoad must equal 1800 times webFrameSpacing times the greater of icePressure multiplied by iceLoadHeight and 0.15, within a relative tolerance of 1e-6 with an absolute fallback of 1e-6 kN." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "webFrameIceLoad must equal 1800 times webFrameSpacing times the greater of icePressure multiplied by iceLoadHeight and 0.15, within a relative tolerance of 1e-6 with an absolute fallback of 1e-6 kN." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureQuantity ;
                      nltl:iceLoadHeight ?heightQuantity ;
                      nltl:webFrameSpacing ?spacingQuantity ;
                      nltl:webFrameIceLoad ?loadQuantity .

                ?pressureQuantity qudt:numericValue ?pressure ;
                                  qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?heightQuantity qudt:numericValue ?height ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                ?spacingQuantity qudt:numericValue ?spacing ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                ?loadQuantity qudt:numericValue ?actualLoad ;
                               qudt:unit <http://qudt.org/vocab/unit/KiloN> .

                BIND ((?pressure * ?height) AS ?pressureHeight)
                BIND (IF(?pressureHeight < 0.15, 0.15, ?pressureHeight) AS ?effectiveLineLoad)
                BIND ((1800 * ?effectiveLineLoad * ?spacing) AS ?expectedLoad)
                BIND (ABS(?actualLoad - ?expectedLoad) AS ?difference)

                FILTER (
                    ?difference > 0.000001 &&
                    ?difference > (ABS(?expectedLoad) * 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF057WebFrameIceLoadShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ] .

