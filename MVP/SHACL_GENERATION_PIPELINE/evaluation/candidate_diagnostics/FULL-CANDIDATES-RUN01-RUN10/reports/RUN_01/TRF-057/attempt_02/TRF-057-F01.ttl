@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "webFrameIceLoad must equal 1.8 times the effective ice line load and web frame spacing, converted from MN to kN; the comparison uses a relative tolerance of 1e-6 with a 1e-6 kN fallback near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "webFrameIceLoad must equal 1.8 times the effective ice line load and web frame spacing, converted from MN to kN; the comparison uses a relative tolerance of 1e-6 with a 1e-6 kN fallback near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:iceLoadHeight ?heightNode ;
                      nltl:webFrameSpacing ?spacingNode ;
                      nltl:webFrameIceLoad ?loadNode .

                ?pressureNode qudt:numericValue ?pressure .
                ?heightNode qudt:numericValue ?height .
                ?spacingNode qudt:numericValue ?spacing .
                ?loadNode qudt:numericValue ?actualLoad .

                BIND((?pressure * ?height) AS ?lineLoad)
                BIND(IF(?lineLoad < 0.15, 0.15, ?lineLoad) AS ?effectiveLineLoad)
                BIND((1.8 * ?effectiveLineLoad * ?spacing * 1000) AS ?expectedLoad)
                BIND(IF(?actualLoad >= ?expectedLoad,
                        ?actualLoad - ?expectedLoad,
                        ?expectedLoad - ?actualLoad) AS ?difference)
                BIND(IF(?expectedLoad >= 0,
                        ?expectedLoad,
                        0 - ?expectedLoad) AS ?expectedMagnitude)
                BIND(IF(?expectedMagnitude > 0,
                        0.000001 * ?expectedMagnitude,
                        0.000001) AS ?tolerance)

                FILTER(?difference > ?tolerance)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF057WebFrameIceLoadShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ] .

