@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F01/webFrame> ;
            sh:resultMessage "The shear factor alpha must match Table 4-8 for the supplied free-flange-to-web area ratio, and required shear area must equal sqrt(3) times alpha times 1.1 times maximum shear force in MN divided by yield strength, converted to cm2; calculated decimal equality is checked with a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The shear factor alpha must match Table 4-8 for the supplied free-flange-to-web area ratio, and required shear area must equal sqrt(3) times alpha times 1.1 times maximum shear force in MN divided by yield strength, converted to cm2; calculated decimal equality is checked with a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
                    sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl/vocab#maximumCalculatedShearForce> ?forceQuantity ;
                      <https://w3id.org/nltl/vocab#webFrameShearFactorAlpha> ?alphaQuantity ;
                      <https://w3id.org/nltl/vocab#yieldStrength> ?yieldQuantity ;
                      <https://w3id.org/nltl/vocab#freeFlangeToWebAreaRatio> ?ratioQuantity ;
                      <https://w3id.org/nltl/vocab#requiredShearArea> ?areaQuantity .
                ?forceQuantity <http://qudt.org/schema/qudt/numericValue> ?force .
                ?alphaQuantity <http://qudt.org/schema/qudt/numericValue> ?alpha .
                ?yieldQuantity <http://qudt.org/schema/qudt/numericValue> ?yield .
                ?ratioQuantity <http://qudt.org/schema/qudt/numericValue> ?ratio .
                ?areaQuantity <http://qudt.org/schema/qudt/numericValue> ?area .
                BIND (1.7320508075688772 * ?alpha * 1.1 * (?force / 1000) / ?yield * 10000 AS ?expected)
                FILTER (
                    !(
                        (?ratio = 0.0 && ?alpha = 1.5) ||
                        (?ratio = 0.2 && ?alpha = 1.23) ||
                        (?ratio = 0.4 && ?alpha = 1.16) ||
                        (?ratio = 0.6 && ?alpha = 1.11) ||
                        (?ratio = 0.8 && ?alpha = 1.09) ||
                        (?ratio = 1.0 && ?alpha = 1.07) ||
                        (?ratio = 1.2 && ?alpha = 1.06) ||
                        (?ratio = 1.4 && ?alpha = 1.05) ||
                        (?ratio = 1.6 && ?alpha = 1.05) ||
                        (?ratio = 1.8 && ?alpha = 1.04) ||
                        (?ratio = 2.0 && ?alpha = 1.04)
                    ) ||
                    ABS(?area - ?expected) >
                    (0.000001 * ABS(?expected) + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF059WebFrameShearAreaShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F01/webFrame> ] .

