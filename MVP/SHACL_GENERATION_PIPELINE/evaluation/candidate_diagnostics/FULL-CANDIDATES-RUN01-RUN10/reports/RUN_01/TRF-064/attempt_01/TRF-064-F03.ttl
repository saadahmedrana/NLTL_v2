@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F03/ship> ;
            sh:resultMessage "Each detached strut shall have design evidence." ;
            sh:resultPath ( nltl:hasDetachedStrut nltl:hasStrutDesignEvidence ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:strutDesignEvidence ;
                    sh:message "Each detached strut shall have design evidence." ;
                    sh:minCount 1 ;
                    sh:path ( nltl:hasDetachedStrut nltl:hasStrutDesignEvidence ) ] ] .

