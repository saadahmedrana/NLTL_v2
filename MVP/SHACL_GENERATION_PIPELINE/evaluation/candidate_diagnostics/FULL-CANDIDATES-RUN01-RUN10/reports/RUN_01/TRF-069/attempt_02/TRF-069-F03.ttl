@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-F03/ship> ;
            sh:resultMessage "The ship must specify a controllable or fixed pitch type." ;
            sh:resultPath nltl:pitchType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "controllable" "fixed" ) ;
                    sh:message "The ship must specify a controllable or fixed pitch type." ;
                    sh:minCount 1 ;
                    sh:path nltl:pitchType ] ;
            sh:value "fixed"^^xsd:string ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-F03/ship> ;
            sh:resultMessage "The ship must specify an open or ducted propeller type." ;
            sh:resultPath nltl:propellerType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "open" "ducted" ) ;
                    sh:message "The ship must specify an open or ducted propeller type." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerType ] ;
            sh:value "open"^^xsd:string ] .

