@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ;
            sh:resultMessage "The ship must provide both the Table 6-6 and Table 6-7 lookup cases and iceLoadCycleCount must equal k1*k2*k3*N_class*n_n within the permitted numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ship must provide both the Table 6-6 and Table 6-7 lookup cases and iceLoadCycleCount must equal k1*k2*k3*N_class*n_n within the permitted numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?case6 ;
                      nltl:hasTableLookupCase ?case7 ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Node ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnNode ;
                      nltl:iceLoadCycleCount ?nice .

                ?case6 nltl:tableReference nltl:traficomTable6Dash6 ;
                        nltl:iceClass ?iceClass ;
                        nltl:selectedIceClassCycleCount ?nclassNode .

                ?case7 nltl:tableReference nltl:traficomTable6Dash7 ;
                        nltl:tableLookupPropellerLocation ?location ;
                        nltl:selectedPropellerLocationFactor ?k1Node .

                ?k1Node qudt:numericValue ?k1 .
                ?k2Node qudt:numericValue ?k2 .
                ?k3Node qudt:numericValue ?k3 .
                ?nclassNode qudt:numericValue ?nclass .
                ?nnNode qudt:numericValue ?nn .
                ?niceValue qudt:numericValue ?niceNumeric .

                BIND((?k1 * ?k2 * ?k3 * ?nclass * ?nn) AS ?expected)
                BIND(xsd:decimal(?nice) AS ?reported)

                FILTER(
                    ABS(?reported - ?expected) >
                    (0.000001 * ABS(?expected) + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:Trf078Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ] .

