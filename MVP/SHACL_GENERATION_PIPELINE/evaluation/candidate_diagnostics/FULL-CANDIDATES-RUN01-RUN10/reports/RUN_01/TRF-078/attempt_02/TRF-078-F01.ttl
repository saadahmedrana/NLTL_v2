@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "At least one table lookup case shall reference Table 6-6 and provide an ice-class selection and selected ice-class cycle count." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "At least one table lookup case shall reference Table 6-6 and provide an ice-class selection and selected ice-class cycle count." ;
                    sh:minCount 1 ;
                    sh:node gs:TRF078TableLookupCaseShape ;
                    sh:path nltl:hasTableLookupCase ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:tableLookupCase ;
                            sh:property [ sh:hasValue nltl:traficomTable6Dash6 ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:tableReference ],
                                [ sh:class nltl:iceClassValue ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:iceClass ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node gs:TRF078QuantityShape ;
                                    sh:path nltl:selectedIceClassCycleCount ] ] ] ] .

