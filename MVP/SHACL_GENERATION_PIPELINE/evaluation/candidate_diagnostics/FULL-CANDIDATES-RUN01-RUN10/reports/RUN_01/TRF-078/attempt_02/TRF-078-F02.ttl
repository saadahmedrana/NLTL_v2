@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ;
            sh:resultMessage "iceLoadCycleCount shall equal k1*k2*k3*N_class*n_n within a relative tolerance of 1e-6 plus an absolute fallback of 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "iceLoadCycleCount shall equal k1*k2*k3*N_class*n_n within a relative tolerance of 1e-6 plus an absolute fallback of 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?classCase ;
                      nltl:hasTableLookupCase ?locationCase ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Node ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnNode ;
                      nltl:iceLoadCycleCount ?nice .

                ?classCase nltl:tableReference nltl:traficomTable6Dash6 ;
                            nltl:selectedIceClassCycleCount ?nclassNode .
                ?locationCase nltl:tableReference nltl:traficomTable6Dash7 ;
                               nltl:selectedPropellerLocationFactor ?k1Node .

                ?k1Node qudt:numericValue ?k1 .
                ?k2Node qudt:numericValue ?k2 .
                ?k3Node qudt:numericValue ?k3 .
                ?nclassNode qudt:numericValue ?nclass .
                ?nnNode qudt:numericValue ?nn .
                BIND ((?k1 * ?k2 * ?k3 * ?nclass * ?nn) AS ?expected)

                FILTER (
                    ?nice > (?expected + (0.000001 * ?expected) + 0.000001)
                    ||
                    ?nice < (?expected - (0.000001 * ?expected) - 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF078Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ] .

