@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ;
            sh:resultMessage "The immersion function and ice load cycle coefficient k2 must satisfy the specified formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The immersion function and ice load cycle coefficient k2 must satisfy the specified formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness/qudt:numericValue ?h ;
                      nltl:iceLoadCycleCoefficientK2/qudt:numericValue ?k2 ;
                      nltl:propellerDiameter/qudt:numericValue ?d ;
                      nltl:propellerImmersionFunction/qudt:numericValue ?f ;
                      nltl:propellerShaftCentrelineDepth/qudt:numericValue ?h0 .

                BIND (((?h0 - ?h) / (?d / 2)) - 1 AS ?fExpected)

                BIND (
                    IF(
                        ?fExpected < 0,
                        0.8 - ?fExpected,
                        IF(
                            ?fExpected <= 1,
                            0.8 - (0.4 * ?fExpected),
                            IF(
                                ?fExpected <= 2.5,
                                0.6 - (0.2 * ?fExpected),
                                0.1
                            )
                        )
                    )
                    AS ?k2Expected
                )

                BIND (
                    0.000001 *
                    IF(ABS(?fExpected) > 1, ABS(?fExpected), 1)
                    AS ?fTolerance
                )

                BIND (
                    0.000001 *
                    IF(ABS(?k2Expected) > 1, ABS(?k2Expected), 1)
                    AS ?k2Tolerance
                )

                FILTER (
                    (?f < (?fExpected - ?fTolerance) ||
                     ?f > (?fExpected + ?fTolerance) ||
                     ?k2 < (?k2Expected - ?k2Tolerance) ||
                     ?k2 > (?k2Expected + ?k2Tolerance))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-079> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ] .

