@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ;
            sh:resultMessage "The propeller immersion function and ice load cycle coefficient k2 must satisfy the specified formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The propeller immersion function and ice load cycle coefficient k2 must satisfy the specified formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?iceQuantity ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Quantity ;
                      nltl:propellerDiameter ?diameterQuantity ;
                      nltl:propellerImmersionFunction ?fQuantity ;
                      nltl:propellerShaftCentrelineDepth ?depthQuantity .

                ?iceQuantity qudt:numericValue ?ice .
                ?k2Quantity qudt:numericValue ?reportedK2 .
                ?diameterQuantity qudt:numericValue ?diameter .
                ?fQuantity qudt:numericValue ?reportedF .
                ?depthQuantity qudt:numericValue ?depth .

                FILTER (?diameter != 0)

                BIND (((?depth - ?ice) / (?diameter / 2)) - 1 AS ?expectedF)

                BIND (
                    IF(
                        ?expectedF < 0,
                        0 - ?expectedF,
                        ?expectedF
                    )
                    AS ?fMagnitude
                )

                BIND (
                    IF(
                        ?expectedF < 0,
                        0.8 - ?expectedF,
                        IF(
                            ?expectedF <= 1,
                            0.8 - (0.4 * ?expectedF),
                            IF(
                                ?expectedF <= 2.5,
                                0.6 - (0.2 * ?expectedF),
                                0.1
                            )
                        )
                    )
                    AS ?expectedK2
                )

                BIND (
                    IF(
                        ?fMagnitude > 1,
                        0.000001 * ?fMagnitude,
                        0.000001
                    )
                    AS ?fTolerance
                )

                BIND (
                    IF(
                        ?expectedK2 > 1,
                        0.000001 * ?expectedK2,
                        0.000001
                    )
                    AS ?k2Tolerance
                )

                FILTER (
                    (?reportedF < (?expectedF - ?fTolerance)) ||
                    (?reportedF > (?expectedF + ?fTolerance)) ||
                    (?reportedK2 < (?expectedK2 - ?k2Tolerance)) ||
                    (?reportedK2 > (?expectedK2 + ?k2Tolerance))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF_079_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ] .

