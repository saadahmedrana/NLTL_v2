@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-P01/ship> ;
            sh:resultMessage "Ice thrust and propeller shaft design thrust values must satisfy the declared formulas; calculated decimal results are checked with a relative tolerance of 1e-6 and an absolute fallback of 1e-6 kN." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ice thrust and propeller shaft design thrust values must satisfy the declared formulas; calculated decimal results are checked with a relative tolerance of 1e-6 and an absolute fallback of 1e-6 kN." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce ?ffQ ;
                      nltl:backwardBladeForce ?fbQ ;
                      nltl:hydrodynamicBollardThrust ?tQ ;
                      nltl:forwardIceThrust ?tfQ ;
                      nltl:backwardIceThrust ?tbQ ;
                      nltl:forwardPropellerShaftDesignThrust ?frQ ;
                      nltl:backwardPropellerShaftDesignThrust ?brQ ;
                      nltl:propellerShaftDesignThrust ?drQ .

                ?ffQ qudt:numericValue ?ff .
                ?fbQ qudt:numericValue ?fb .
                ?tQ qudt:numericValue ?t .
                ?tfQ qudt:numericValue ?tf .
                ?tbQ qudt:numericValue ?tb .
                ?frQ qudt:numericValue ?fr .
                ?brQ qudt:numericValue ?br .
                ?drQ qudt:numericValue ?dr .

                BIND ((1.1 * ?ff) AS ?expectedTf)
                BIND ((1.1 * ?fb) AS ?expectedTb)
                BIND ((?t + (2.2 * ?expectedTf)) AS ?forwardLoad)
                BIND ((1.5 * ?expectedTb) AS ?backwardLoad)
                BIND (IF(?forwardLoad >= ?backwardLoad, ?forwardLoad, ?backwardLoad) AS ?expectedDesign)

                BIND (IF(ABS(?expectedTf) * 0.000001 > 0.000001,
                         ABS(?expectedTf) * 0.000001,
                         0.000001) AS ?tolTf)
                BIND (IF(ABS(?expectedTb) * 0.000001 > 0.000001,
                         ABS(?expectedTb) * 0.000001,
                         0.000001) AS ?tolTb)
                BIND (IF(ABS(?expectedDesign) * 0.000001 > 0.000001,
                         ABS(?expectedDesign) * 0.000001,
                         0.000001) AS ?tolDesign)

                FILTER (
                    ?tf < (?expectedTf - ?tolTf) ||
                    ?tf > (?expectedTf + ?tolTf) ||
                    ?tb < (?expectedTb - ?tolTb) ||
                    ?tb > (?expectedTb + ?tolTb) ||
                    ?fr < (?expectedDesign - ?tolDesign) ||
                    ?fr > (?expectedDesign + ?tolDesign) ||
                    ?br < (?expectedDesign - ?tolDesign) ||
                    ?br > (?expectedDesign + ?tolDesign) ||
                    ?dr < (?expectedDesign - ?tolDesign) ||
                    ?dr > (?expectedDesign + ?tolDesign)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-081> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-P01/ship> ] .

