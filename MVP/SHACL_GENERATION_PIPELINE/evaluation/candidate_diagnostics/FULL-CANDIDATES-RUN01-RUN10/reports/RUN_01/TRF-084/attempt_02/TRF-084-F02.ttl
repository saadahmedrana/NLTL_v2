@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:pitchValueKnown ], [ sh:datatype xsd:string ; sh:hasValue Literal("CP") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerType ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:propellerPitchAtMcrBollard ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:pitchValueKnown ], [ sh:datatype xsd:string ; sh:hasValue Literal("CP") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerType ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:propellerPitchAtMcrBollard ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:propellerPitchAtMcrFreeRunning ] ; sh:sparql [ sh:message Literal("For a CP propeller with unknown pitch value, propeller pitch at MCR in bollard condition must equal 0.7 times the free-running value within relative tolerance 1e-6 and absolute fallback 1e-9.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:propellerType ?type .
                        FILTER (STR(?type) = "CP") .
                        $this nltl:pitchValueKnown false .
                        $this nltl:propellerPitchAtMcrBollard ?bollard .
                        ?bollard qudt:numericValue ?bollardValue ;
                                 qudt:unit unit:M .
                        $this nltl:propellerPitchAtMcrFreeRunning ?freeRunning .
                        ?freeRunning qudt:numericValue ?freeRunningValue ;
                                     qudt:unit unit:M .
                        FILTER (
                            isNumeric(?bollardValue) &&
                            isNumeric(?freeRunningValue) &&
                            ABS(?bollardValue - (0.7 * ?freeRunningValue)) >
                            (0.000001 * ABS(0.7 * ?freeRunningValue) + 0.000000001)
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:string ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerType ] ; sh:sparql [ sh:message Literal("The CP-specific pitch constraint is not applicable to a non-CP propeller.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:propellerType ?type .
                            FILTER (STR(?type) != "CP")
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF084Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F02/ship> ] .

