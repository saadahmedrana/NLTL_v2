@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ;
                    sh:resultMessage "The propulsion load case shall be designated for propulsion-line strength evaluation and not for propulsion system stalling analysis." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nbeeacf603cac4ef0a95f1eb276bbf4b8b3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ;
                    sh:resultMessage "The propulsion load case shall be designated for propulsion-line strength evaluation and not for propulsion system stalling analysis." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nbeeacf603cac4ef0a95f1eb276bbf4b8b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/milling> ;
            sh:resultMessage "The ship shall identify a propulsion load case for the propulsion-line strength evaluation." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nbeeacf603cac4ef0a95f1eb276bbf4b8b2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/ship> ;
            sh:resultMessage "The ship shall identify a propulsion load case for the propulsion-line strength evaluation." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nbeeacf603cac4ef0a95f1eb276bbf4b8b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/milling> ;
            sh:resultMessage "The ship shall identify an ice milling sequence case." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceMillingSequenceCase ;
                    sh:message "The ship shall identify an ice milling sequence case." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceMillingSequenceCase ] ] .

_:N6fd0e669bac64216bee64e012a53ee1f sh:hasValue nltl:stallingAnalysisPurposeValue .

_:nbeeacf603cac4ef0a95f1eb276bbf4b8b2 sh:class nltl:loadCase ;
    sh:message "The ship shall identify a propulsion load case for the propulsion-line strength evaluation." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:TRF-091-PropulsionLoadCaseShape> ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasPropulsionLoadCase .

_:nbeeacf603cac4ef0a95f1eb276bbf4b8b3 sh:class nltl:loadCasePurposeValue ;
    sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
    sh:message "The propulsion load case shall be designated for propulsion-line strength evaluation and not for propulsion system stalling analysis." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:not _:N6fd0e669bac64216bee64e012a53ee1f ;
    sh:path nltl:loadCasePurpose .

