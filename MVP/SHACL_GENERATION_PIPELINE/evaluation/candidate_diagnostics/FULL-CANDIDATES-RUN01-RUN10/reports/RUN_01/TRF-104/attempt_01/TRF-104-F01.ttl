@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-F01/component0> ;
                    sh:resultMessage "Loss of a propeller blade shall not cause significant damage to the propeller shaft line component." ;
                    sh:resultPath nltl:significantDamageFromBladeLoss ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue false ;
                            sh:maxCount 1 ;
                            sh:message "Loss of a propeller blade shall not cause significant damage to the propeller shaft line component." ;
                            sh:minCount 1 ;
                            sh:path nltl:significantDamageFromBladeLoss ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF104PropellerShaftLineComponentShape. See details for more information." ;
            sh:resultPath nltl:hasPropellerShaftLineComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:propellerShaftLineComponent ;
                    sh:node gen:TRF104PropellerShaftLineComponentShape ;
                    sh:path nltl:hasPropellerShaftLineComponent ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-F01/component0> ] .

