@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal(\"A known stress-life curve requires evidence that the selected curve corresponds to the blade material properties.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ], [ sh:datatype xsd:string ; sh:message Literal(\"A known stress-life curve requires the blade material properties.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propellerBladeMaterialProperty ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:stressLifeCurveKnown ], [ sh:message Literal(\"A known stress-life curve requires a selected curve corresponding to the blade material properties.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:stressLifeCurveSelection ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:stressLifeCurveKnown ], [ sh:hasValue nltl:twoSlopeStressLifeCurve ; sh:message Literal(\"When the stress-life curve is unknown, the two-slope stress-life curve shall be used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelection ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-108> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F01/ship> ] .

