@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-P02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal("Correspondence evidence for the selected stress-life curve and blade material properties is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ], [ sh:class nltl:stressLifeCurveTypeValue ; sh:message Literal("For a known stress-life curve, the selected curve must be recorded.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelection ], [ sh:datatype xsd:string ; sh:message Literal("For a known stress-life curve, the blade material properties must be recorded.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerBladeMaterialProperty ] ; sh:sparql [ sh:message Literal("The known stress-life curve branch cannot be used when the stress-life curve type is unknown.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:stressLifeCurveType ?curveType .
                        FILTER (LCASE(STR(?curveType)) = "unknown")
                    }
                ") ], [ sh:message Literal("The known stress-life curve selection, blade material properties, and correspondence evidence must be represented together on the ship.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:stressLifeCurveSelection ?curve ;
                                  nltl:propellerBladeMaterialProperty ?material ;
                                  nltl:stressLifeCurveSelectionCorrespondenceEvidence ?evidence .
                            ?curve a nltl:stressLifeCurveTypeValue .
                            ?evidence a nltl:evidenceArtifact .
                        }
                    }
                ") ] ] , [ sh:property [ sh:hasValue nltl:twoSlopeStressLifeCurve ; sh:message Literal("When the stress-life curve is unknown, the two-slope stress-life curve must be selected.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelection ] ; sh:sparql [ sh:message Literal("The unknown stress-life curve branch requires an applicability value of unknown.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:stressLifeCurveType ?curveType .
                            FILTER (LCASE(STR(?curveType)) = "unknown")
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_108_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-P02/ship> ] .

