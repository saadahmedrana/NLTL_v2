@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ rdf:type sh:NodeShape ; sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal("Evidence must document correspondence between the selected stress-life curve and the blade material properties.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ], [ sh:class nltl:stressLifeCurveTypeValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A stress-life curve must be selected.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelection ], [ sh:datatype xsd:string ; sh:message Literal("The blade material properties must be provided for a known stress-life curve.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerBladeMaterialProperty ] ; sh:sparql [ sh:message Literal("The selected stress-life curve, blade material properties, and correspondence evidence must be explicitly tied together.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:stressLifeCurveType ?curveType .
                        FILTER(LCASE(STR(?curveType)) != "unknown")
                        $this nltl:stressLifeCurveSelection ?curve .
                        $this nltl:propellerBladeMaterialProperty ?material .
                        $this nltl:stressLifeCurveSelectionCorrespondenceEvidence ?evidence .
                        ?evidence rdf:subject ?curve ;
                                  rdf:predicate nltl:propellerBladeMaterialProperty ;
                                  rdf:object ?material .
                    }
                ") ] ] , [ rdf:type sh:NodeShape ; sh:property [ sh:class nltl:stressLifeCurveTypeValue ; sh:hasValue nltl:twoSlopeStressLifeCurve ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("When the stress-life curve type is unknown, the two-slope stress-life curve must be selected.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelection ] ; sh:sparql [ sh:message Literal("The two-slope alternative applies only when the stress-life curve type is unknown.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:stressLifeCurveType ?curveType .
                        FILTER(LCASE(STR(?curveType)) = "unknown")
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-108-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F01/ship> ] .

