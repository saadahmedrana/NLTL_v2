@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/ship> ;
            sh:resultMessage "The ship shall provide the extreme ice force as a QUDT quantity in kN." ;
            sh:resultPath nltl:extremeIceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship shall provide the extreme ice force as a QUDT quantity in kN." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:extremeIceForce ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/loadCase> ;
                    sh:resultMessage "Node nltl:bladeFailureLoadCase must conform to one or more shapes in [ sh:hasValue nltl:extremeOperationalLoadCase ; sh:property [ sh:class qudt:QuantityValue ; sh:message Literal(\"The component yield safety factor for an extreme operational load shall be at least 1.3.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.3\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ] ] , [ sh:hasValue nltl:fatigueLoadCase ] , [ sh:hasValue nltl:bladeFailureLoadCase ; sh:property [ sh:class qudt:QuantityValue ; sh:message Literal(\"The component yield safety factor for a blade failure load shall be at least 1.0.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ] ]" ;
                    sh:resultPath nltl:shaftLineLoadCaseType ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                            sh:minCount 1 ;
                            sh:or ( [ sh:hasValue nltl:extremeOperationalLoadCase ;
                                        sh:property [ sh:class qudt:QuantityValue ;
                                                sh:message "The component yield safety factor for an extreme operational load shall be at least 1.3." ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] [ sh:hasValue nltl:fatigueLoadCase ] [ sh:hasValue nltl:bladeFailureLoadCase ;
                                        sh:property [ sh:class qudt:QuantityValue ;
                                                sh:message "The component yield safety factor for a blade failure load shall be at least 1.0." ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] ) ;
                            sh:path nltl:shaftLineLoadCaseType ] ;
                    sh:value nltl:bladeFailureLoadCase ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:class nltl:shaftLineLoadCaseTypeValue ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:or ( [ sh:hasValue nltl:extremeOperationalLoadCase ; sh:property [ sh:class qudt:QuantityValue ; sh:message Literal(\"The component yield safety factor for an extreme operational load shall be at least 1.3.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.3\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ] ] [ sh:hasValue nltl:fatigueLoadCase ] [ sh:hasValue nltl:bladeFailureLoadCase ; sh:property [ sh:class qudt:QuantityValue ; sh:message Literal(\"The component yield safety factor for a blade failure load shall be at least 1.0.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ] ] ) ; sh:path nltl:shaftLineLoadCaseType ] ]. See details for more information." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:loadCase ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                                    sh:minCount 1 ;
                                    sh:or ( [ sh:hasValue nltl:extremeOperationalLoadCase ;
                                                sh:property [ ] ] [ sh:hasValue nltl:fatigueLoadCase ] [ sh:hasValue nltl:bladeFailureLoadCase ;
                                                sh:property [ ] ] ) ;
                                    sh:path nltl:shaftLineLoadCaseType ] ] ;
                    sh:path nltl:hasPropulsionLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/loadCase> ] .

