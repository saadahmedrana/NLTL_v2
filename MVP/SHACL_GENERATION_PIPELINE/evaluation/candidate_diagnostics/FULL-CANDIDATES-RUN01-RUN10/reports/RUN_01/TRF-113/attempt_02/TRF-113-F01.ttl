@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The design evidence must cover the body of the thruster." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The design evidence must cover the body of the thruster." ;
                    sh:path nltl:hasComponent ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:thrusterBody ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The ship must record the blade-loss maximum load as a single force quantity in kilonewtons." ;
            sh:resultPath nltl:bladeLossLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must record the blade-loss maximum load as a single force quantity in kilonewtons." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:KiloN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:bladeLossLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The ship must record the plastic-bending-without-damage design condition for the blade-loss case." ;
            sh:resultPath nltl:bladePlasticBending ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must record the plastic-bending-without-damage design condition for the blade-loss case." ;
                    sh:minCount 1 ;
                    sh:path nltl:bladePlasticBending ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The design evidence must cover the fitting of the thruster unit." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The design evidence must cover the fitting of the thruster unit." ;
                    sh:path nltl:hasComponent ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:thrusterFitting ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The design evidence must cover a steering mechanism." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The design evidence must cover a steering mechanism." ;
                    sh:path nltl:hasComponent ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:steeringMechanism ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The ship must identify the propeller blade orientation causing the maximum component load." ;
            sh:resultPath nltl:propellerBladeOrientation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must identify the propeller blade orientation causing the maximum component load." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerBladeOrientation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "Evidence must be provided for the blade-loss design assessment." ;
            sh:resultPath nltl:thrusterBladeLossDesignEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Evidence must be provided for the blade-loss design assessment." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:evidenceArtifact ] ;
                    sh:path nltl:thrusterBladeLossDesignEvidence ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "A propulsion load case accounting for blade loss at the maximum-load orientation is required." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A propulsion load case accounting for blade loss at the maximum-load orientation is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:loadCase ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive true ;
                                    sh:message "The propulsion load case must confirm that the recorded blade orientation produces the maximum load on the studied component." ;
                                    sh:minCount 1 ;
                                    sh:minInclusive true ;
                                    sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ] ] ;
                    sh:path nltl:hasPropulsionLoadCase ] ] .

