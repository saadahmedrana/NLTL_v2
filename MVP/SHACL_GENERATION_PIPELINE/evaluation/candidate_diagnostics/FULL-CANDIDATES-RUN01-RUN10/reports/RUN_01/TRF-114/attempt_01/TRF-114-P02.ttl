@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/ship> ;
            sh:resultMessage "The ship must provide a typical ice operating speed in knots." ;
            sh:resultPath nltl:iceOperatingSpeed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide a typical ice operating speed in knots." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:iceOperatingSpeed ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/thrusterBody> ;
                            sh:resultMessage "The thruster body must provide its externally assessed resistance capacity." ;
                            sh:resultPath nltl:thrusterResistanceCapacity ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "The thruster body must provide its externally assessed resistance capacity." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thrusterResistanceCapacity ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/impact> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:thrusterBody ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The thruster body must provide its externally assessed resistance capacity.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterResistanceCapacity ] ]. See details for more information." ;
                    sh:resultPath nltl:thrusterImpactCaseAppliesToBody ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node [ sh:class nltl:thrusterBody ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:message "The thruster body must provide its externally assessed resistance capacity." ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:class qudt:QuantityValue ;
                                                    sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ],
                                                        [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ] ] ;
                                            sh:path nltl:thrusterResistanceCapacity ] ] ;
                            sh:path nltl:thrusterImpactCaseAppliesToBody ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/thrusterBody> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:thrusterIceImpactLoadCase ; sh:or ( [ sh:property [ sh:hasValue nltl:hemisphericalContactGeometry ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:contactGeometryClassification ] ] [ sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal(\"Non-hemispherical contact geometry requires correspondence evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:contactGeometryCorrespondenceEvidence ], [ sh:hasValue nltl:nonHemisphericalContactGeometry ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:contactGeometryClassification ] ] ) ; sh:property [ sh:class nltl:contactGeometryValue ; sh:in ( nltl:hemisphericalContactGeometry nltl:nonHemisphericalContactGeometry ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The impact case must classify its contact geometry as hemispherical or non-hemispherical.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:contactGeometryClassification ], [ sh:class nltl:evidenceArtifact ; sh:message Literal(\"The impact case must provide evidence for the loaded impact area.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:thrusterIceImpactLoadedAreaEvidence ], [ sh:class nltl:tableReferenceValue ; sh:hasValue nltl:traficomTable6Dash16Reference ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The impact case must reference TRAFICOM Table 6-16 for its impact load case.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:impactLoadCaseTableReference ], [ sh:class nltl:tableReferenceValue ; sh:hasValue nltl:traficomTable6Dash3Reference ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The impact case must reference TRAFICOM Table 6-3 for the design ice block.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:designIceBlockTableReference ], [ sh:class nltl:thrusterBody ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:thrusterImpactCaseAppliesToBody ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterIceImpactDemand ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterIceImpactLoad ], [ sh:node [ sh:class nltl:thrusterBody ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The thruster body must provide its externally assessed resistance capacity.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterResistanceCapacity ] ] ; sh:path nltl:thrusterImpactCaseAppliesToBody ] ]. See details for more information." ;
            sh:resultPath nltl:hasThrusterIceImpactLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:thrusterIceImpactLoadCase ;
                            sh:or ( [ sh:property [ sh:hasValue nltl:hemisphericalContactGeometry ;
                                                sh:minCount 1 ;
                                                sh:path nltl:contactGeometryClassification ] ] [ sh:property [ sh:hasValue nltl:nonHemisphericalContactGeometry ;
                                                sh:minCount 1 ;
                                                sh:path nltl:contactGeometryClassification ],
                                            [ sh:class nltl:evidenceArtifact ;
                                                sh:message "Non-hemispherical contact geometry requires correspondence evidence." ;
                                                sh:minCount 1 ;
                                                sh:path nltl:contactGeometryCorrespondenceEvidence ] ] ) ;
                            sh:property [ sh:class nltl:tableReferenceValue ;
                                    sh:hasValue nltl:traficomTable6Dash16Reference ;
                                    sh:maxCount 1 ;
                                    sh:message "The impact case must reference TRAFICOM Table 6-16 for its impact load case." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:impactLoadCaseTableReference ],
                                [ sh:class nltl:contactGeometryValue ;
                                    sh:in ( nltl:hemisphericalContactGeometry nltl:nonHemisphericalContactGeometry ) ;
                                    sh:maxCount 1 ;
                                    sh:message "The impact case must classify its contact geometry as hemispherical or non-hemispherical." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:contactGeometryClassification ],
                                [ sh:class nltl:tableReferenceValue ;
                                    sh:hasValue nltl:traficomTable6Dash3Reference ;
                                    sh:maxCount 1 ;
                                    sh:message "The impact case must reference TRAFICOM Table 6-3 for the design ice block." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:designIceBlockTableReference ],
                                [ sh:node [ sh:class nltl:thrusterBody ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:message "The thruster body must provide its externally assessed resistance capacity." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:thrusterResistanceCapacity ] ] ;
                                    sh:path nltl:thrusterImpactCaseAppliesToBody ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:thrusterIceImpactLoad ],
                                [ sh:class nltl:thrusterBody ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:thrusterImpactCaseAppliesToBody ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:thrusterIceImpactDemand ],
                                [ sh:class nltl:evidenceArtifact ;
                                    sh:message "The impact case must provide evidence for the loaded impact area." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:thrusterIceImpactLoadedAreaEvidence ] ] ;
                    sh:path nltl:hasThrusterIceImpactLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/impact> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/ship> ;
            sh:resultMessage "Each non-hemispherical impact case must have an equivalent impact sphere radius on the ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each non-hemispherical impact case must have an equivalent impact sphere radius on the ship." ;
                    sh:select """PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:hasThrusterIceImpactLoadCase ?case .
    ?case nltl:contactGeometryClassification nltl:nonHemisphericalContactGeometry .
    FILTER NOT EXISTS {
        $this nltl:equivalentImpactSphereRadius ?radius .
        ?radius qudt:numericValue ?value ;
                qudt:unit <http://qudt.org/vocab/unit/M> .
    }
}""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-114-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/ship> ] .

