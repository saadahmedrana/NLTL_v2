@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:totalRelevantEnginePower" ;
            sh:resultPath nltl:totalRelevantEnginePower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:totalRelevantEnginePower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F02/chest1> ;
            sh:resultMessage "Each linked inlet chest must have recommended chest volume approximately equal to total relevant engine power divided by 750, and strainer open area at least four times inlet pipe area; the volume comparison uses a relative tolerance of 1e-6 above 1 m3 and an absolute tolerance of 1e-6 m3 near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each linked inlet chest must have recommended chest volume approximately equal to total relevant engine power divided by 750, and strainer open area at least four times inlet pipe area; the volume comparison uses a relative tolerance of 1e-6 above 1 m3 and an absolute tolerance of 1e-6 m3 near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:recommendedChestVolume ?volumeNode .
                ?volumeNode qudt:numericValue ?reportedVolume .
                $this nltl:strainerOpenArea ?strainerNode .
                ?strainerNode qudt:numericValue ?strainerArea .
                $this nltl:inletPipeArea ?pipeNode .
                ?pipeNode qudt:numericValue ?pipeArea .
                $this nltl:totalRelevantEnginePower ?powerNode .
                ?powerNode qudt:numericValue ?power .
                BIND((?power / 750) AS ?expectedVolume)
                FILTER (
                    (
                        ?expectedVolume > 1 &&
                        ?reportedVolume >= (?expectedVolume - (0.000001 * ?expectedVolume)) &&
                        ?reportedVolume <= (?expectedVolume + (0.000001 * ?expectedVolume))
                    ) ||
                    (
                        ?expectedVolume <= 1 &&
                        ?reportedVolume >= (?expectedVolume - 0.000001) &&
                        ?reportedVolume <= (?expectedVolume + 0.000001)
                    )
                )
                FILTER (?strainerArea < (4 * ?pipeArea))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-130-InletChestOperandsShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F02/chest1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:maximumContinuousRatingPower" ;
            sh:resultPath nltl:maximumContinuousRatingPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:maximumContinuousRatingPower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestAlternativeArrangementUsed ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ], [ sh:message Literal(\"When the volume and height requirements can be met, at least one standard inlet chest must satisfy all applicable paragraph requirements.\") ; sh:path nltl:hasComponent ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:class nltl:inletChest ; sh:node <urn:nltl:generated-shape:TRF-130-StandardInletChestShape> ] ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestAlternativeArrangementUsed ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ], [ sh:message Literal(\"When the volume and height requirements cannot be met, at least two alternating inlet chests are required.\") ; sh:path nltl:hasComponent ; sh:qualifiedMinCount Literal(\"2\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:class nltl:inletChest ; sh:node <urn:nltl:generated-shape:TRF-130-AlternativeInletChestShape> ] ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-130-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F02/ship> ] .

