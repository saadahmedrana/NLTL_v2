@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-P04/ship> ;
            sh:resultMessage "The engine output must be at least f1*f2*f3*(f4*Delta + P0), and must be at least 740 kW for ice classes IB and IC." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The engine output must be at least f1*f2*f3*(f4*Delta + P0), and must be at least 740 kW for ice classes IB and IC." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceNode ;
                      nltl:engineOutputFormulaBasePowerP0 ?p0Node ;
                      nltl:engineOutputFormulaDisplacement ?deltaNode ;
                      nltl:engineOutputFormulaFactorF1 ?f1Node ;
                      nltl:engineOutputFormulaFactorF2 ?f2Node ;
                      nltl:engineOutputFormulaFactorF3 ?f3Node ;
                      nltl:engineOutputFormulaFactorF4 ?f4Node ;
                      nltl:maximumContinuousRatingPower ?mcrNode .

                ?iceNode a nltl:iceClassValue ;
                         ?iceClassPredicate ?ice .
                FILTER (?iceClassPredicate = <https://w3id.org/nltl/vocab#iceClassValue> || ?iceClassPredicate != <https://w3id.org/nltl/vocab#iceClassValue>)

                ?p0Node <http://qudt.org/schema/qudt/numericValue> ?p0 .
                ?deltaNode <http://qudt.org/schema/qudt/numericValue> ?delta .
                ?f1Node <http://qudt.org/schema/qudt/numericValue> ?f1 .
                ?f2Node <http://qudt.org/schema/qudt/numericValue> ?f2 .
                ?f3Node <http://qudt.org/schema/qudt/numericValue> ?f3 .
                ?f4Node <http://qudt.org/schema/qudt/numericValue> ?f4 .
                ?mcrNode <http://qudt.org/schema/qudt/numericValue> ?mcr .

                BIND (?f1 * ?f2 * ?f3 * ((?f4 * ?delta) + ?p0) AS ?formulaResult)

                FILTER (
                    (?mcr + (ABS(?formulaResult) * 0.000001) + 0.000000001 < ?formulaResult)
                    ||
                    (
                        (?ice = nltl:iceClassIb || ?ice = nltl:iceClassIc)
                        && ?mcr < 740
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF132EngineOutputShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-P04/ship> ] .

