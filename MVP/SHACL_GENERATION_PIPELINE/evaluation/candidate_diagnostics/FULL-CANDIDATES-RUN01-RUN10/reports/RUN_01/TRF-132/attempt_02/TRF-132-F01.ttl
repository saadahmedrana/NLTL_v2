@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F01/ship> ;
            sh:resultMessage "The engine output must be at least f1*f2*f3*(f4*Delta + P0), allowing a relative tolerance of 1e-6 plus a small absolute fallback." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The engine output must be at least f1*f2*f3*(f4*Delta + P0), allowing a relative tolerance of 1e-6 plus a small absolute fallback." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this
                    nltl:engineOutputFormulaBasePowerP0 ?p0Node ;
                    nltl:engineOutputFormulaDisplacement ?deltaNode ;
                    nltl:engineOutputFormulaFactorF1 ?f1Node ;
                    nltl:engineOutputFormulaFactorF2 ?f2Node ;
                    nltl:engineOutputFormulaFactorF3 ?f3Node ;
                    nltl:engineOutputFormulaFactorF4 ?f4Node ;
                    nltl:maximumContinuousRatingPower ?mcrNode .
                ?p0Node qudt:numericValue ?p0 .
                ?deltaNode qudt:numericValue ?delta .
                ?f1Node qudt:numericValue ?f1 .
                ?f2Node qudt:numericValue ?f2 .
                ?f3Node qudt:numericValue ?f3 .
                ?f4Node qudt:numericValue ?f4 .
                ?mcrNode qudt:numericValue ?mcr .
                BIND (?f1 * ?f2 * ?f3 * ((?f4 * ?delta) + ?p0) AS ?expected)
                FILTER (
                    ?mcr + ((?expected * "0.000001"^^xsd:decimal) + "0.000001"^^xsd:decimal)
                    < ?expected
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF132Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F01/ship> ] .

