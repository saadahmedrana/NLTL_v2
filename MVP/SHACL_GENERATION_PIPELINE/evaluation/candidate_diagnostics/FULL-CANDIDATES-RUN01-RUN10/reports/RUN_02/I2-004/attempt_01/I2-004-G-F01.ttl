@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The ship displacement must equal the greatest displacement among its upper ice waterline cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ship displacement must equal the greatest displacement among its upper ice waterline cases." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?shipDisplacement .
                ?shipDisplacement qudt:numericValue ?shipValue .
                FILTER NOT EXISTS {
                    $this nltl:hasUpperIceWaterlineCase ?matchingCase .
                    ?matchingCase nltl:waterlineCaseDisplacement ?matchingDisplacement .
                    ?matchingDisplacement qudt:numericValue ?matchingValue .
                    FILTER (?matchingValue = ?shipValue)
                    FILTER NOT EXISTS {
                        $this nltl:hasUpperIceWaterlineCase ?greaterCase .
                        ?greaterCase nltl:waterlineCaseDisplacement ?greaterDisplacement .
                        ?greaterDisplacement qudt:numericValue ?greaterValue .
                        FILTER (?greaterValue > ?matchingValue)
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_004_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

