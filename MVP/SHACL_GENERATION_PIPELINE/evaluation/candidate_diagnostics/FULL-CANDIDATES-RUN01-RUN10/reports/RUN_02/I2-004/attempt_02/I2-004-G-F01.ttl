@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The upper ice waterline displacement must equal a waterline case displacement, and no waterline case may have a greater displacement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The upper ice waterline displacement must equal a waterline case displacement, and no waterline case may have a greater displacement." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>

SELECT $this
WHERE {
    $this nltl:upperIceWaterlineDisplacement ?shipDisplacement .
    ?shipDisplacement qudt:numericValue ?shipValue ;
                      qudt:unit unit:KiloTON_Metric .
    FILTER (
        NOT EXISTS {
            $this nltl:hasUpperIceWaterlineCase ?equalCase .
            ?equalCase nltl:waterlineCaseDisplacement ?equalDisplacement .
            ?equalDisplacement qudt:numericValue ?equalValue ;
                               qudt:unit unit:KiloTON_Metric .
            FILTER (?equalValue = ?shipValue)
        }
        ||
        EXISTS {
            $this nltl:hasUpperIceWaterlineCase ?greaterCase .
            ?greaterCase nltl:waterlineCaseDisplacement ?greaterDisplacement .
            ?greaterDisplacement qudt:numericValue ?greaterValue ;
                                 qudt:unit unit:KiloTON_Metric .
            FILTER (?greaterValue > ?shipValue)
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_004_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

