@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"Astern ice operation intent must be explicitly false when the conditional design requirement is not applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:asternIceOperationIntent ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Astern ice operation intent must be explicitly true when the conditional design requirement applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:asternIceOperationIntent ], [ sh:datatype xsd:string ; sh:hasValue Literal(\"Bow and Bow Intermediate hull area requirements\") ; sh:message Literal(\"The aft section design basis must use the Bow and Bow Intermediate hull area requirements.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:aftSectionDesignBasis ], [ sh:datatype xsd:string ; sh:hasValue Literal(\"Bow and Bow Intermediate hull area requirements\") ; sh:message Literal(\"The hull area requirement set must be the Bow and Bow Intermediate hull area requirements.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hullAreaRequirementSet ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_006_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F01/ship> ] .

