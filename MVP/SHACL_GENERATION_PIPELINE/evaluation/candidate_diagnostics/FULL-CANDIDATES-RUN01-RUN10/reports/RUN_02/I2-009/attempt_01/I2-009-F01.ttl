@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "A hull area representation is required." ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "A hull area representation is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "The buttock angle must be supplied as a single degree quantity." ;
            sh:resultPath nltl:buttockAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The buttock angle must be supplied as a single degree quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:DEG ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:buttockAngle ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "The normal frame angle must be supplied as a single degree quantity." ;
            sh:resultPath nltl:normalFrameAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The normal frame angle must be supplied as a single degree quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:DEG ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:normalFrameAngle ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ar> ;
                    sh:resultMessage "Value is not >= Literal(\"3.6\", datatype=xsd:decimal)" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:maxInclusive 3.6 ;
                            sh:minCount 1 ;
                            sh:minInclusive 3.6 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 3.5 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "The load patch aspect ratio must equal 3.6." ;
            sh:resultPath nltl:loadPatchAspectRatio ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The load patch aspect ratio must equal 3.6." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 3.6 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 3.6 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:loadPatchAspectRatio ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ar> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "Bow-form applicability must be recorded." ;
            sh:resultPath nltl:bowFormApplicability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Bow-form applicability must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:bowFormApplicability ] ] .

