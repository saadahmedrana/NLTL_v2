@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F02/ship> ;
            sh:resultMessage "Bow-form applicability must be recorded." ;
            sh:resultPath nltl:bowFormApplicability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Bow-form applicability must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:bowFormApplicability ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F02/ship> ;
            sh:resultMessage "A hull area representation is required." ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "A hull area representation is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F02/ship> ;
            sh:resultMessage "The buttock angle must be supplied as a single degree quantity." ;
            sh:resultPath nltl:buttockAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The buttock angle must be supplied as a single degree quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:DEG ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:buttockAngle ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F02/ship> ;
            sh:resultMessage "A hull area assignment is required." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A hull area assignment is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:hullAreaAssignment ;
                            sh:property [ sh:in ( nltl:otherIceStrengthenedArea nltl:otherIceStrengthenedAreaValue nltl:bowIntermediateBottomHullArea nltl:midbodyBottomHullArea nltl:sternBottomHullArea ) ;
                                    sh:maxCount 1 ;
                                    sh:message "The hull area assignment must identify an allowed ice-strengthened area." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:assignedHullArea ] ] ;
                    sh:path nltl:hasHullAreaAssignment ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F02/ship> ;
            sh:resultMessage "The normal frame angle must be supplied as a single degree quantity." ;
            sh:resultPath nltl:normalFrameAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The normal frame angle must be supplied as a single degree quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:DEG ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:normalFrameAngle ] ] .

