@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "Bow-form applicability must agree with the buttock-angle and normal-frame-angle conditions." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Bow-form applicability must agree with the buttock-angle and normal-frame-angle conditions." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bowFormApplicability ?app ;
                      nltl:buttockAngle ?gammaQuantity ;
                      nltl:normalFrameAngle ?betaQuantity .
                ?gammaQuantity qudt:numericValue ?gamma .
                ?betaQuantity qudt:numericValue ?beta .
                FILTER (
                    (?app = true &&
                     !(?gamma > 0 && ?gamma < 80 && ?beta > 10))
                    ||
                    (?app = false &&
                     (?gamma <= 0 || ?gamma >= 80 || ?beta <= 10))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_009_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasHullAreaAssignment" ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:in ( nltl:bowIntermediateBottomHullArea nltl:midbodyBottomHullArea nltl:sternBottomHullArea nltl:otherIceStrengthenedArea ) ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:assignedHullArea ] ] ;
                    sh:path nltl:hasHullAreaAssignment ] ] .

