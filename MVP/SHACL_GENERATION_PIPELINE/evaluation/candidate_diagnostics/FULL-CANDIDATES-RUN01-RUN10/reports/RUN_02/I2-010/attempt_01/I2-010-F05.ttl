@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F05/ship> ;
            sh:resultMessage "The vertical-sided bow indicators must agree." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The vertical-sided bow indicators must agree." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:verticalSidedBowForm ?verticalForm ;
        nltl:bowVerticalSideStatus ?status .
  FILTER (?verticalForm != ?status)
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-010> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F05/ship> ] .

