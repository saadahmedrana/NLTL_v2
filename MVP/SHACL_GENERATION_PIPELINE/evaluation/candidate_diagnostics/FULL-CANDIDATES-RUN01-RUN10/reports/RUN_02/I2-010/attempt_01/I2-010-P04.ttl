@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-P04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:string ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An applicable ship must record the design ice-force calculation method.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bowDesignForceMethod ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:bowVerticalSideStatus ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:verticalSidedBowForm ], [ sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ; sh:path nltl:polarClass ], [ sh:message Literal("For an applicable ship, every represented normal frame angle must be between 0 and 10 degrees.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("10", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("0", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:normalFrameAngle ] ] , [ sh:sparql [ sh:message Literal("The ship is outside the PC6/PC7 vertical-sided-bow applicability condition.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  FILTER (
    NOT EXISTS {
      $this nltl:polarClass ?pc .
      FILTER (?pc IN (
        nltl:polarClassPc6,
        nltl:polarClassPc7
      ))
    }
    ||
    (
      EXISTS {
        $this nltl:verticalSidedBowForm false
      }
      &&
      EXISTS {
        $this nltl:bowVerticalSideStatus false
      }
    )
  )
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-010> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-P04/ship> ] .

