@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-P02/ship> ;
            sh:resultMessage "For PC6 or PC7 ships with bulbous bows, the I2.3.1(vii) bow-force constraints apply" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:I2_011_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-P02/ship> ] .

