@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F06/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( nltl:polarClassPc1 nltl:polarClassPc2 nltl:polarClassPc3 nltl:polarClassPc4 nltl:polarClassPc5 ) ; sh:path nltl:polarClass ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:bulbousBowPresent ], [ sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ; sh:path nltl:polarClass ] ] , [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:bulbousBowPresent ], [ sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ; sh:path nltl:polarClass ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("0.6", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("0.6", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:shapeCoefficient ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("1.3", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("1.3", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:loadPatchAspectRatio ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:bowDesignForce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MegaN ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MegaN ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ] ; sh:sparql [ sh:message Literal("For an applicable PC6 or PC7 ship with a bulbous bow, bowDesignForce must equal the greater of the part iii and part iv forces within a relative tolerance of 1e-6, with a 1e-6 kN absolute fallback near zero.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiNode ;
                              nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivNode ;
                              nltl:bowDesignForce ?resultNode .

                        ?iiiNode qudt:numericValue ?iii ;
                                  qudt:unit <http://qudt.org/vocab/unit/MegaN> .
                        ?ivNode qudt:numericValue ?iv ;
                                 qudt:unit <http://qudt.org/vocab/unit/MegaN> .
                        ?resultNode qudt:numericValue ?result ;
                                    qudt:unit <http://qudt.org/vocab/unit/KiloN> .

                        BIND(IF(?iii >= ?iv, ?iii, ?iv) AS ?expectedMn)
                        BIND(?expectedMn * 1000 AS ?expectedKn)
                        BIND(IF(?expectedKn >= 0, ?expectedKn, -?expectedKn) AS ?magnitude)
                        BIND(IF(?magnitude * 0.000001 >= 0.000001,
                                ?magnitude * 0.000001,
                                0.000001) AS ?toleranceKn)

                        FILTER (
                            ?result < (?expectedKn - ?toleranceKn) ||
                            ?result > (?expectedKn + ?toleranceKn)
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2_011_BowDesignForce> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F06/ship> ] .

