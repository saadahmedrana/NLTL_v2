@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F06/ship> ;
            sh:resultMessage "Each ship must provide one bow length quantity in metres." ;
            sh:resultPath nltl:bowLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ship must provide one bow length quantity in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:bowLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F06/ship> ;
            sh:resultMessage "Selected maximum bow force, line load, and pressure must match the corresponding maximum case value within tolerance scaled from the expected maximum." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Selected maximum bow force, line load, and pressure must match the corresponding maximum case value within tolerance scaled from the expected maximum." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedForceQuantity ;
                      nltl:selectedMaximumBowLineLoad ?selectedLineQuantity ;
                      nltl:selectedMaximumBowPressure ?selectedPressureQuantity .
                ?selectedForceQuantity qudt:numericValue ?selectedForce .
                ?selectedLineQuantity qudt:numericValue ?selectedLine .
                ?selectedPressureQuantity qudt:numericValue ?selectedPressure .

                {
                    SELECT $this (MAX(?force) AS ?maxForce)
                           (MAX(?line) AS ?maxLine)
                           (MAX(?pressure) AS ?maxPressure)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedForce ?forceQuantity ;
                              nltl:bowSubregionCalculatedLineLoad ?lineQuantity ;
                              nltl:bowSubregionCalculatedPressure ?pressureQuantity .
                        ?forceQuantity qudt:numericValue ?force .
                        ?lineQuantity qudt:numericValue ?line .
                        ?pressureQuantity qudt:numericValue ?pressure .
                    }
                    GROUP BY $this
                }

                FILTER (
                    ?selectedForce < (?maxForce - (?maxForce * 0.000001 + 0.000000001)) ||
                    ?selectedForce > (?maxForce + (?maxForce * 0.000001 + 0.000000001)) ||
                    ?selectedLine < (?maxLine - (?maxLine * 0.000001 + 0.000000001)) ||
                    ?selectedLine > (?maxLine + (?maxLine * 0.000001 + 0.000000001)) ||
                    ?selectedPressure < (?maxPressure - (?maxPressure * 0.000001 + 0.000000001)) ||
                    ?selectedPressure > (?maxPressure + (?maxPressure * 0.000001 + 0.000000001))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_014_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F06/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F06/ship> ;
            sh:resultMessage "The bow region must contain four subregions." ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:maxInclusive 4 ;
                    sh:message "The bow region must contain four subregions." ;
                    sh:minCount 1 ;
                    sh:minInclusive 4 ;
                    sh:path nltl:bowSubregionCount ] ] .

