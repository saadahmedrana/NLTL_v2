@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:upperIceWaterlineDraughtDUI" ;
            sh:resultPath nltl:upperIceWaterlineDraughtDUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:upperIceWaterlineDraughtDUI ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:betaIPrime" ;
            sh:resultPath nltl:betaIPrime ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:betaIPrime ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasBowSubregionCalculationCase" ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:bowSubregionCalculationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:bowSubregionWaterlineAngle ],
                                [ sh:class nltl:bowFormApplicabilityValue ;
                                    sh:hasValue nltl:i231vBowFormApplicability ;
                                    sh:maxCount 1 ;
                                    sh:message "Each bow subregion calculation case must identify the applicable I2.3.1(v) bow form classification." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:bowFormApplicabilityClassification ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:bowSubregionMidLengthPosition ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:tableLookupCase ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:flexuralFailureClassFactor ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:crushingFailureClassFactor ] ] ;
                                    sh:path nltl:hasFailureClassFactorLookupCase ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:bowShapeCoefficient ] ] ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ] .

