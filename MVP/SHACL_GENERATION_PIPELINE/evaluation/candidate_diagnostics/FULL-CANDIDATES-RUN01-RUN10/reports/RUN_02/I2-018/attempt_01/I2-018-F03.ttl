                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:iceForce ] ] .

_:n8f24cc9d4e684536812be31f50d417c0b18 sh:hasValue nltl:iacsUrI2Table3 ;
    sh:maxCount 1 ;
    sh:message "The peak-pressure-factor lookup must reference IACS UR I2 Table 3." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:tableReference .

