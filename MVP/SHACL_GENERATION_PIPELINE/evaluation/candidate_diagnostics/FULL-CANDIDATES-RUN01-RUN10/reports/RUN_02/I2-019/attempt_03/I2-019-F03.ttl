@prefix generated: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F03/member> ;
                    sh:resultMessage """Node ex:member must conform to one or more shapes in [ sh:property [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:message Literal("A structural member without a spanned hull area is not subject to the maximum hull area factor check.") ; sh:path nltl:hasSpannedHullArea ] ] , [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:selectedHullAreaFactor ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:hullAreaValue ; sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:hullAreaFactor ] ] ; sh:path nltl:hasSpannedHullArea ] ; sh:sparql [ sh:message Literal("selectedHullAreaFactor must equal the maximum reached hullAreaFactor within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-6.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        {
                            SELECT $this ?selectedNode ?selectedNumeric
                                   (MAX(?factorNumeric) AS ?maximumFactor)
                            WHERE {
                                $this nltl:hasSpannedHullArea ?area .
                                ?area nltl:hullAreaFactor ?factorNode .
                                ?factorNode qudt:numericValue ?factorNumeric .
                                $this nltl:selectedHullAreaFactor ?selectedNode .
                                ?selectedNode qudt:numericValue ?selectedNumeric .
                                FILTER (datatype(?factorNumeric) = xsd:decimal)
                                FILTER (datatype(?selectedNumeric) = xsd:decimal)
                            }
                            GROUP BY $this ?selectedNode ?selectedNumeric
                        }
                        FILTER (
                            ABS(?selectedNumeric - ?maximumFactor) >
                            (ABS(?maximumFactor) * 0.000001 + 0.000001)
                        )
                    }
                ") ] ]""" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape generated:I2_019_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F03/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape generated:I2_019_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node generated:I2_019_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F03/member> ] .

