@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/plating> ;
                    sh:resultMessage "Thickness must equal ice-load required net plate thickness plus corrosion and abrasion allowance, with millimetre operands converted to metres; tolerance is relative 1e-6 plus an absolute 1e-9 metre fallback." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Thickness must equal ice-load required net plate thickness plus corrosion and abrasion allowance, with millimetre operands converted to metres; tolerance is relative 1e-6 plus an absolute 1e-9 metre fallback." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceLoadRequiredNetPlateThickness ?netQuantity ;
                      nltl:corrosionAbrasionAllowance ?allowanceQuantity ;
                      nltl:thickness ?thicknessQuantity .

                ?netQuantity qudt:numericValue ?net ;
                             qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                ?allowanceQuantity qudt:numericValue ?allowance ;
                                    qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                ?thicknessQuantity qudt:numericValue ?actual ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .

                BIND((?net + ?allowance) / 1000 AS ?expected)
                FILTER(
                    ABS(?actual - ?expected) >
                    ((ABS(?expected) * 0.000001) + 0.000000001)
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-021-PlatingShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-021-PlatingShape>. See details for more information." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-021-PlatingShape> ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/plating> ] .

