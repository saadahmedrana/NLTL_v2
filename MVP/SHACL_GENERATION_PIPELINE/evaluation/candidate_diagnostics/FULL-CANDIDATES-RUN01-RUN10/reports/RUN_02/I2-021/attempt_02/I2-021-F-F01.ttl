@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/ship> ;
            sh:resultMessage "For each plating item, thickness in metres must equal iceLoadRequiredNetPlateThickness plus corrosionAbrasionAllowance in millimetres converted to metres, within a 1e-6 relative tolerance and a 1e-6 metre absolute fallback near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For each plating item, thickness in metres must equal iceLoadRequiredNetPlateThickness plus corrosionAbrasionAllowance in millimetres converted to metres, within a 1e-6 relative tolerance and a 1e-6 metre absolute fallback near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasPlating ?plating .
                ?plating nltl:iceLoadRequiredNetPlateThickness ?netNode ;
                         nltl:corrosionAbrasionAllowance ?allowanceNode ;
                         nltl:thickness ?thicknessNode .
                ?netNode qudt:numericValue ?net .
                ?allowanceNode qudt:numericValue ?allowance .
                ?thicknessNode qudt:numericValue ?reported .

                BIND ((?net + ?allowance) / 1000 AS ?expected)
                BIND (?reported - ?expected AS ?difference)
                BIND (IF(?expected < 0, 0 - ?expected, ?expected) AS ?expectedAbsolute)
                BIND (
                    IF(
                        ?expectedAbsolute < 0.000001,
                        0.000001,
                        ?expectedAbsolute * 0.000001
                    ) AS ?tolerance
                )
                BIND (
                    IF(?difference < 0, 0 - ?difference, ?difference)
                    AS ?absoluteDifference
                )

                FILTER (?absoluteDifference > ?tolerance)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_021_ShellPlateThicknessShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/ship> ] .

