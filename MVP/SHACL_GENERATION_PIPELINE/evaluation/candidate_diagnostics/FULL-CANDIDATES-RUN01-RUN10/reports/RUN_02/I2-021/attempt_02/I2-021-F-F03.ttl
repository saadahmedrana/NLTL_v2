@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F03/plating> ;
                    sh:resultMessage "Less than 1 values on ex:plating->nltl:corrosionAbrasionAllowance" ;
                    sh:resultPath nltl:corrosionAbrasionAllowance ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node gen:LengthMilliMQuantityShape ;
                            sh:path nltl:corrosionAbrasionAllowance ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:plating ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:LengthMQuantityShape ; sh:path nltl:thickness ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:LengthMilliMQuantityShape ; sh:path nltl:corrosionAbrasionAllowance ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:LengthMilliMQuantityShape ; sh:path nltl:iceLoadRequiredNetPlateThickness ] ]. See details for more information." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:plating ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node gen:LengthMQuantityShape ;
                                    sh:path nltl:thickness ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node gen:LengthMilliMQuantityShape ;
                                    sh:path nltl:corrosionAbrasionAllowance ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node gen:LengthMilliMQuantityShape ;
                                    sh:path nltl:iceLoadRequiredNetPlateThickness ] ] ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F03/plating> ] .

