@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:detail [ a sh:ValidationResult ;
                                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/member> ;
                                            sh:resultMessage "Less than 1 values on ex:member->nltl:netAttachedShellPlateThickness" ;
                                            sh:resultPath nltl:netAttachedShellPlateThickness ;
                                            sh:resultSeverity sh:Violation ;
                                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                                            sh:sourceShape [ sh:minCount 1 ;
                                                    sh:node gen:QvMm ;
                                                    sh:path nltl:netAttachedShellPlateThickness ] ] ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/calc> ;
                                    sh:resultMessage "Value does not conform to Shape gen:StructuralMemberOperandShape. See details for more information." ;
                                    sh:resultPath nltl:sectionCalculationCaseStructuralMember ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                                    sh:sourceShape [ sh:minCount 1 ;
                                            sh:node gen:StructuralMemberOperandShape ;
                                            sh:path nltl:sectionCalculationCaseStructuralMember ] ;
                                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/member> ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/member> ;
                            sh:resultMessage "Value does not conform to Shape gen:LocalFrameSectionCalculationCaseShape. See details for more information." ;
                            sh:resultPath nltl:hasLocalFrameSectionCalculationCase ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
                                    sh:node gen:LocalFrameSectionCalculationCaseShape ;
                                    sh:path nltl:hasLocalFrameSectionCalculationCase ] ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/calc> ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/member> ;
                            sh:resultMessage "Less than 1 values on ex:member->nltl:netAttachedShellPlateThickness" ;
                            sh:resultPath nltl:netAttachedShellPlateThickness ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
                                    sh:node gen:QvMm ;
                                    sh:path nltl:netAttachedShellPlateThickness ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/calc> ;
                    sh:resultMessage "Value does not conform to Shape gen:StructuralMemberShape. See details for more information." ;
                    sh:resultPath nltl:sectionCalculationCaseStructuralMember ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node gen:StructuralMemberShape ;
                            sh:path nltl:sectionCalculationCaseStructuralMember ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/member> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/calc> ;
                    sh:resultMessage "Less than 1 values on ex:calc->nltl:interpolationLowerEndpoint" ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node gen:InterpolationPointShape ;
                            sh:path nltl:interpolationLowerEndpoint ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/calc> ;
                    sh:resultMessage "Less than 1 values on ex:calc->nltl:interpolationUpperEndpoint" ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node gen:InterpolationPointShape ;
                            sh:path nltl:interpolationUpperEndpoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/ship> ;
            sh:resultMessage "A calculation case with required externally calculated inputs and results is required." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A calculation case with required externally calculated inputs and results is required." ;
                    sh:minCount 1 ;
                    sh:node gen:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/calc> ] .

