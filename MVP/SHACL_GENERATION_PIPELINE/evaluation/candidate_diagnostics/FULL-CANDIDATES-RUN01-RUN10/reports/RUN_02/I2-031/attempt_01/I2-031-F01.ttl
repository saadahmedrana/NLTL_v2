@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
                    sh:resultMessage "Each applicable structural member must identify its plastic collapse mechanism." ;
                    sh:resultPath nltl:plasticCollapseMechanism ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nc2798e93e5354e38a21a91d8c65be2eab10 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
                    sh:resultMessage "Combined shear and bending demand must not exceed the member plastic strength." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:nc2798e93e5354e38a21a91d8c65be2eab18 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-031-StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "The ship must identify the structural members governed by this requirement." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must identify the structural members governed by this requirement." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-031-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
            sh:resultMessage "Combined shear and bending demand must not exceed the member plastic strength." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:nc2798e93e5354e38a21a91d8c65be2eab18 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-031-StructuralMemberShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "The ship must identify the frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must identify the frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
            sh:resultMessage "Each applicable structural member must identify its plastic collapse mechanism." ;
            sh:resultPath nltl:plasticCollapseMechanism ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc2798e93e5354e38a21a91d8c65be2eab10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "The ship must provide the patch load in kN." ;
            sh:resultPath nltl:patchLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the patch load in kN." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-031-QuantityKiloNShape> ;
                    sh:path nltl:patchLoad ] ] .

_:nc2798e93e5354e38a21a91d8c65be2eab10 sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each applicable structural member must identify its plastic collapse mechanism." ;
    sh:minCount 1 ;
    sh:path nltl:plasticCollapseMechanism .

_:nc2798e93e5354e38a21a91d8c65be2eab18 a sh:SPARQLConstraint ;
    sh:message "Combined shear and bending demand must not exceed the member plastic strength." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMemberLoadCase ?loadCase .
                $this nltl:plasticStrength ?strength .
                ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                ?strength qudt:numericValue ?strengthValue .
                ?demand qudt:numericValue ?demandValue .
                FILTER (?demandValue > ?strengthValue)
            }
        """ .

