@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/member> ;
                    sh:resultMessage "Each applicable structural member must identify its plastic collapse mechanism." ;
                    sh:resultPath nltl:plasticCollapseMechanism ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nc2798e93e5354e38a21a91d8c65be2eab10 ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/loadcase> ;
                            sh:resultMessage "Each load case must provide one combined shear and bending demand." ;
                            sh:resultPath nltl:combinedShearAndBendingDemand ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nc2798e93e5354e38a21a91d8c65be2eab4 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/member> ;
                    sh:resultMessage "Each applicable structural member must have a load case." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nc2798e93e5354e38a21a91d8c65be2eab7 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/loadcase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/ship> ;
            sh:resultMessage "The ship must identify the structural members governed by this requirement." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must identify the structural members governed by this requirement." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-031-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/member> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/loadcase> ;
                    sh:resultMessage "Each load case must provide one combined shear and bending demand." ;
                    sh:resultPath nltl:combinedShearAndBendingDemand ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nc2798e93e5354e38a21a91d8c65be2eab4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/member> ;
            sh:resultMessage "Each applicable structural member must have a load case." ;
            sh:resultPath nltl:hasStructuralMemberLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nc2798e93e5354e38a21a91d8c65be2eab7 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/loadcase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/ship> ;
            sh:resultMessage "The ship must provide the patch load in kN." ;
            sh:resultPath nltl:patchLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the patch load in kN." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-031-QuantityKiloNShape> ;
                    sh:path nltl:patchLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/ship> ;
            sh:resultMessage "The ship must identify the frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must identify the frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/member> ;
            sh:resultMessage "Each applicable structural member must identify its plastic collapse mechanism." ;
            sh:resultPath nltl:plasticCollapseMechanism ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc2798e93e5354e38a21a91d8c65be2eab10 ] .

_:nc2798e93e5354e38a21a91d8c65be2eab10 sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Each applicable structural member must identify its plastic collapse mechanism." ;
    sh:minCount 1 ;
    sh:path nltl:plasticCollapseMechanism .

_:nc2798e93e5354e38a21a91d8c65be2eab4 sh:maxCount 1 ;
    sh:message "Each load case must provide one combined shear and bending demand." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-031-QuantityDecimalShape> ;
    sh:path nltl:combinedShearAndBendingDemand .

_:nc2798e93e5354e38a21a91d8c65be2eab7 sh:message "Each applicable structural member must have a load case." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-031-LoadCaseShape> ;
    sh:path nltl:hasStructuralMemberLoadCase .

