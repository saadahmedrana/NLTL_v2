@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/ship> ;
            sh:resultMessage "The ship shall provide a frame profile type value." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship shall provide a frame profile type value." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/ship> ;
            sh:resultMessage "The ship shall provide a patch load in kN." ;
            sh:resultPath nltl:patchLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide a patch load in kN." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_031_KiloNewtonQuantityShape ;
                    sh:path nltl:patchLoad ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/member> ;
                    sh:resultMessage "Node ex:member must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:bottomStructureLocation ; sh:path nltl:structuralLocation ], [ sh:hasValue nltl:loadPatchHeightParallelToFrame ; sh:message Literal(\"For a bottom structural member, the patch load dimension b shall be parallel with the frame direction.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path ( nltl:hasStructuralMemberLoadCase nltl:loadPatchOrientation ) ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A side structural member shall be identified as a transverse local frame.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:transverseFrameOrientation ], [ sh:hasValue nltl:sideStructureLocation ; sh:path nltl:structuralLocation ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:I2_031_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_031_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:I2_031_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/ship> ;
            sh:resultMessage "The ship shall identify the plastic collapse mechanism." ;
            sh:resultPath nltl:plasticCollapseMechanism ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship shall identify the plastic collapse mechanism." ;
                    sh:minCount 1 ;
                    sh:path nltl:plasticCollapseMechanism ] ] .

