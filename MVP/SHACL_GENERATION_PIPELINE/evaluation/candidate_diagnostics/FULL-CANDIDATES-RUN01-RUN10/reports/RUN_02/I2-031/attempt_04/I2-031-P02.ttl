@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P02/ship> ;
            sh:resultMessage "The ship shall provide a patch load in kN." ;
            sh:resultPath nltl:patchLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide a patch load in kN." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_031_KiloNewtonQuantityShape ;
                    sh:path nltl:patchLoad ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P02/loadcase> ;
                            sh:resultMessage "Each structural-member load case shall identify the load patch orientation." ;
                            sh:resultPath nltl:loadPatchOrientation ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:class nltl:loadPatchOrientationValue ;
                                    sh:maxCount 1 ;
                                    sh:message "Each structural-member load case shall identify the load patch orientation." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:loadPatchOrientation ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P02/member> ;
                    sh:resultMessage "Value does not conform to Shape gen:I2_031_LoadCaseShape. See details for more information." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node gen:I2_031_LoadCaseShape ;
                            sh:path nltl:hasStructuralMemberLoadCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P02/loadcase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_031_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:I2_031_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P02/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P02/ship> ;
            sh:resultMessage "The ship shall provide a frame profile type value." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship shall provide a frame profile type value." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P02/ship> ;
            sh:resultMessage "The ship shall identify the plastic collapse mechanism." ;
            sh:resultPath nltl:plasticCollapseMechanism ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship shall identify the plastic collapse mechanism." ;
                    sh:minCount 1 ;
                    sh:path nltl:plasticCollapseMechanism ] ] .

