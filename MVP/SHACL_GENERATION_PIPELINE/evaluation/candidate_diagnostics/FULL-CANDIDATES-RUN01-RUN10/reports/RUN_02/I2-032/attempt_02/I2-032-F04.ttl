@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-032-F04/at> ;
                    sh:resultMessage "Node ex:at->qudt:unit does not contain a value in the set: ['unit:CentiM2']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue unit:CentiM2 ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-032-F04/ship> ;
            sh:resultMessage "Each structural member must provide the calculated required transverse frame shear area in square centimetres." ;
            sh:resultPath nltl:requiredTransverseFrameShearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "Each structural member must provide the calculated required transverse frame shear area in square centimetres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-032-QuantityAreaCm2> ;
                    sh:path nltl:requiredTransverseFrameShearArea ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-032-F04/at> ] .

