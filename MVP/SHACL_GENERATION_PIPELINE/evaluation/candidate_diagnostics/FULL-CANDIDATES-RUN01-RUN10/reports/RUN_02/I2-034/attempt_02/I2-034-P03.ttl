@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-P03/ship> ;
            sh:resultMessage "Each represented structural member must provide structural location for applicability determination." ;
            sh:resultPath ( nltl:hasStructuralMember nltl:structuralLocation ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Each represented structural member must provide structural location for applicability determination." ;
                    sh:minCount 1 ;
                    sh:path ( nltl:hasStructuralMember nltl:structuralLocation ) ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-P03/ship> ;
            sh:resultMessage "Each represented structural member must provide longitudinal frame orientation for applicability determination." ;
            sh:resultPath ( nltl:hasStructuralMember nltl:longitudinalFrameOrientation ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "Each represented structural member must provide longitudinal frame orientation for applicability determination." ;
                    sh:minCount 1 ;
                    sh:path ( nltl:hasStructuralMember nltl:longitudinalFrameOrientation ) ] ] .

