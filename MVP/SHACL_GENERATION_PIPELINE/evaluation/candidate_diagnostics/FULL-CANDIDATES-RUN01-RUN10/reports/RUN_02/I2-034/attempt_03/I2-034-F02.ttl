@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/member> ;
                    sh:resultMessage "An applicable longitudinal frame in a side structure must provide kN plastic-strength and midspan-collapse-load quantities, and every represented load-case demand must not exceed the plastic strength." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "An applicable longitudinal frame in a side structure must provide kN plastic-strength and midspan-collapse-load quantities, and every represented load-case demand must not exceed the plastic strength." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:longitudinalFrameOrientation true ;
                       nltl:structuralLocation nltl:sideStructureLocation .

                FILTER (
                    NOT EXISTS {
                        $this nltl:plasticStrength ?plasticStrengthQuantity .
                        ?plasticStrengthQuantity qudt:numericValue ?plasticStrengthValue ;
                                                  qudt:unit qudt:KiloN .
                        FILTER (datatype(?plasticStrengthValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:midspanPlasticCollapseLoad ?midspanQuantity .
                        ?midspanQuantity qudt:numericValue ?midspanValue ;
                                          qudt:unit qudt:KiloN .
                        FILTER (datatype(?midspanValue) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasStructuralMemberLoadCase ?loadCase .
                        FILTER NOT EXISTS {
                            ?loadCase nltl:combinedShearAndBendingDemand ?demandQuantity .
                            ?demandQuantity qudt:numericValue ?demandValue ;
                                             qudt:unit qudt:KiloN .
                            FILTER (datatype(?demandValue) = xsd:decimal)
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:hasStructuralMemberLoadCase ?loadCase .
                        ?loadCase nltl:combinedShearAndBendingDemand ?demandQuantity .
                        ?demandQuantity qudt:numericValue ?demandValue ;
                                         qudt:unit qudt:KiloN .
                        $this nltl:plasticStrength ?plasticStrengthQuantity .
                        ?plasticStrengthQuantity qudt:numericValue ?plasticStrengthValue ;
                                                  qudt:unit qudt:KiloN .
                        FILTER (
                            datatype(?demandValue) = xsd:decimal &&
                            datatype(?plasticStrengthValue) = xsd:decimal &&
                            ?demandValue > ?plasticStrengthValue
                        )
                    }
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_034_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_034_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:node gen:I2_034_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/ship> ;
            sh:resultMessage "The ship must identify its frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship must identify its frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ] .

