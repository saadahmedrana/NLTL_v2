@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F03/ship> ;
            sh:resultMessage "Each applicable longitudinal side frame must have valid kN strength and collapse-load quantities, and every represented load-case demand must not exceed either threshold." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each applicable longitudinal side frame must have valid kN strength and collapse-load quantities, and every represented load-case demand must not exceed either threshold." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:longitudinalFrameOrientation true ;
                        nltl:structuralLocation nltl:sideStructureLocation .
                {
                    FILTER NOT EXISTS {
                        ?member nltl:plasticStrength ?strength .
                        ?strength qudt:numericValue ?strengthValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        FILTER (datatype(?strengthValue) = xsd:decimal)
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        ?member nltl:midspanPlasticCollapseLoad ?collapseLoad .
                        ?collapseLoad qudt:numericValue ?collapseValue ;
                                      qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        FILTER (datatype(?collapseValue) = xsd:decimal)
                    }
                }
                UNION
                {
                    ?member nltl:hasStructuralMemberLoadCase ?loadCase .
                    FILTER NOT EXISTS {
                        ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                        ?demand qudt:numericValue ?demandValue ;
                                qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        FILTER (datatype(?demandValue) = xsd:decimal)
                    }
                }
                UNION
                {
                    ?member nltl:plasticStrength ?strength ;
                            nltl:midspanPlasticCollapseLoad ?collapseLoad ;
                            nltl:hasStructuralMemberLoadCase ?loadCase .
                    ?strength qudt:numericValue ?strengthValue ;
                              qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                    ?collapseLoad qudt:numericValue ?collapseValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                    ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                    ?demand qudt:numericValue ?demandValue ;
                            qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                    FILTER (
                        datatype(?strengthValue) = xsd:decimal &&
                        datatype(?collapseValue) = xsd:decimal &&
                        datatype(?demandValue) = xsd:decimal &&
                        (
                            ?demandValue > ?strengthValue ||
                            ?demandValue > ?collapseValue
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-034-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F03/ship> ;
            sh:resultMessage "The ship must specify its frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship must specify its frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ] .

