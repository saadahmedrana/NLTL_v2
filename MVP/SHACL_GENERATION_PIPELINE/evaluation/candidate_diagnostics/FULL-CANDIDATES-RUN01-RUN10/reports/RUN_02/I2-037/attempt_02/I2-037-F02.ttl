@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/ship> ;
            sh:resultMessage "The ship shall provide an ice-load-patch design case." ;
            sh:resultPath nltl:hasIceLoadPatchDesignCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide an ice-load-patch design case." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:iceLoadPatchDesignCase ] ;
                    sh:path nltl:hasIceLoadPatchDesignCase ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/member> ;
                    sh:resultMessage "Each applicable member shall provide its capacity in kilonewtons." ;
                    sh:resultPath nltl:memberCapacity ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each applicable member shall provide its capacity in kilonewtons." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue unit:KiloN ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:memberCapacity ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/loadcase> ;
                            sh:resultMessage "The structural-member load case shall represent the combined bending-and-shear effect." ;
                            sh:resultPath nltl:combinedShearBendingEffect ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:message "The structural-member load case shall represent the combined bending-and-shear effect." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:combinedShearBendingEffect ] ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/loadcase> ;
                            sh:resultMessage "The load case shall identify the load-patch application location." ;
                            sh:resultPath nltl:loadPatchApplicationLocation ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:message "The load case shall identify the load-patch application location." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:loadPatchApplicationLocation ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/member> ;
                    sh:resultMessage "Each web frame or load-carrying stringer shall have a structural-member load case." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Each web frame or load-carrying stringer shall have a structural-member load case." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:loadCase ;
                                    sh:property [ sh:datatype xsd:string ;
                                            sh:maxCount 1 ;
                                            sh:message "The load case shall identify the load-patch application location." ;
                                            sh:minCount 1 ;
                                            sh:path nltl:loadPatchApplicationLocation ],
                                        [ sh:datatype xsd:string ;
                                            sh:maxCount 1 ;
                                            sh:message "The structural-member load case shall represent the combined bending-and-shear effect." ;
                                            sh:minCount 1 ;
                                            sh:path nltl:combinedShearBendingEffect ] ] ;
                            sh:path nltl:hasStructuralMemberLoadCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/loadcase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/ship> ;
            sh:resultMessage "The ship shall identify the applicable web frames or load-carrying stringers." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify the applicable web frames or load-carrying stringers." ;
                    sh:minCount 1 ;
                    sh:node [ sh:or ( [ sh:class nltl:webFrame ] [ sh:class nltl:loadCarryingStringer ] ) ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "Each applicable member shall provide its capacity in kilonewtons." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:KiloN ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:memberCapacity ],
                                [ sh:message "Each web frame or load-carrying stringer shall have a structural-member load case." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:loadCase ;
                                            sh:property [ sh:datatype xsd:string ;
                                                    sh:maxCount 1 ;
                                                    sh:message "The structural-member load case shall represent the combined bending-and-shear effect." ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:combinedShearBendingEffect ],
                                                [ sh:datatype xsd:string ;
                                                    sh:maxCount 1 ;
                                                    sh:message "The load case shall identify the load-patch application location." ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:loadPatchApplicationLocation ] ] ;
                                    sh:path nltl:hasStructuralMemberLoadCase ] ] ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/ship> ;
            sh:resultMessage "The ship shall identify the ice load patch to be used for the design." ;
            sh:resultPath nltl:hasIceLoadPatch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify the ice load patch to be used for the design." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:iceLoadPatch ] ;
                    sh:path nltl:hasIceLoadPatch ] ] .

