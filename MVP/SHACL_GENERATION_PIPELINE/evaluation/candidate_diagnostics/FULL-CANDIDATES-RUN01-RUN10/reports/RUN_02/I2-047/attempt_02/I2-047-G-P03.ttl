@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-P03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:message Literal("An applicable ice-strengthened structure must be identified.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ], [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:steelRenewalRequired ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:gaugedThickness ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:netThickness ] ; sh:sparql [ sh:message Literal("For an ice-strengthened structure, steel renewal is required when gauged thickness is less than net thickness plus 0.0005 m.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasPlating ?plating .
                        ?plating nltl:iceStrengthenedStructureStatus "true"^^xsd:boolean .
                        $this nltl:gaugedThickness ?gaugedQuantity .
                        ?gaugedQuantity <http://qudt.org/schema/qudt/numericValue> ?gauged .
                        $this nltl:netThickness ?netQuantity .
                        ?netQuantity <http://qudt.org/schema/qudt/numericValue> ?net .
                        $this nltl:steelRenewalRequired ?renewal .
                        FILTER (?gauged < (?net + 0.0005))
                        FILTER (?renewal != "true"^^xsd:boolean)
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:message Literal("The ice-strengthened structure applicability status must be true or false.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_047_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-P03/ship> ] .

