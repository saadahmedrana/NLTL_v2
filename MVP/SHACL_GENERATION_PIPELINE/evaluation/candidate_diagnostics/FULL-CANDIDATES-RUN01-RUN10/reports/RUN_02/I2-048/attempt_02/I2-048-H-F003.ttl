@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F003/case> ;
            sh:resultMessage "Less than 1 values on ex:case->nltl:asBuiltPlateThickness" ;
            sh:resultPath nltl:asBuiltPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n2d2ee2711eba45e0aa7342f7cb704628b12 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F003/case> ;
                    sh:resultMessage "Less than 1 values on ex:case->nltl:asBuiltPlateThickness" ;
                    sh:resultPath nltl:asBuiltPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n2d2ee2711eba45e0aa7342f7cb704628b12 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F003/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-048-CaseShape>. See details for more information." ;
            sh:resultPath nltl:hasSteelGradeRequirementCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-048-CaseShape> ;
                    sh:path nltl:hasSteelGradeRequirementCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F003/case> ] .

_:N2ed80559c3e44f88be4ee43ee954acf6 a sh:NodeShape ;
    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:n2d2ee2711eba45e0aa7342f7cb704628b12 sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node _:N2ed80559c3e44f88be4ee43ee954acf6 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:asBuiltPlateThickness .

