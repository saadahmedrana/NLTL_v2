_:N19a1af2c720845fda7c23be69d8e9b06 a sh:NodeShape ;
    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:N2ea6e10cb77f4676b915864fd740934b rdf:first nltl:normalStrengthSteelCategory ;
    rdf:rest ( nltl:highTensileSteelCategory ) .

_:n2d2ee2711eba45e0aa7342f7cb704628b11 sh:class nltl:tableReferenceValue ;
    sh:hasValue nltl:iacsUrI2Table8 ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:tableReference .

_:n2d2ee2711eba45e0aa7342f7cb704628b12 sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node _:N19a1af2c720845fda7c23be69d8e9b06 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:asBuiltPlateThickness .

_:n2d2ee2711eba45e0aa7342f7cb704628b20 sh:class nltl:steelStrengthCategoryValue ;
    sh:in _:N2ea6e10cb77f4676b915864fd740934b ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:steelStrengthCategory .

