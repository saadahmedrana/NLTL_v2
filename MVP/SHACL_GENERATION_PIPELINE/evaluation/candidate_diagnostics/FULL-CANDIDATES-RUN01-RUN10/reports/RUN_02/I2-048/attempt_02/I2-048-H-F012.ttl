@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F012/plating> ;
            sh:resultMessage "Less than 1 values on ex:plating->nltl:steelStrengthCategory" ;
            sh:resultPath nltl:steelStrengthCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelStrengthCategoryValue ;
                    sh:in ( nltl:normalStrengthSteelCategory nltl:highTensileSteelCategory ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelStrengthCategory ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F012/plating> ;
            sh:resultMessage "Node ex:plating->nltl:tableReference does not contain a value in the set: ['nltl:iacsUrI2Table8']" ;
            sh:resultPath nltl:tableReference ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n2d2ee2711eba45e0aa7342f7cb704628b11 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F012/plating> ;
            sh:resultMessage "Less than 1 values on ex:plating->nltl:actualHullStructuralSteelGrade" ;
            sh:resultPath nltl:actualHullStructuralSteelGrade ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:actualHullStructuralSteelGrade ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F012/plating> ;
            sh:resultMessage "Less than 1 values on ex:plating->nltl:steelGradeRequirementCasePlating" ;
            sh:resultPath nltl:steelGradeRequirementCasePlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:plating ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelGradeRequirementCasePlating ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F012/plating> ;
            sh:resultMessage "Less than 1 values on ex:plating->nltl:steelMaterialClass" ;
            sh:resultPath nltl:steelMaterialClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelMaterialClassValue ;
                    sh:in ( nltl:steelMaterialClassOne nltl:steelMaterialClassTwo nltl:steelMaterialClassThree ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelMaterialClass ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F012/plating> ;
            sh:resultMessage "Less than 1 values on ex:plating->nltl:tableReference" ;
            sh:resultPath nltl:tableReference ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n2d2ee2711eba45e0aa7342f7cb704628b11 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F012/case> ;
                    sh:resultMessage "The actual steel grade does not meet the required Table 8 rank within its steel-strength category." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:n2d2ee2711eba45e0aa7342f7cb704628b26 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-048-CaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F012/case> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F012/case> ;
                    sh:resultMessage "Less than 1 values on ex:case->nltl:asBuiltPlateThickness" ;
                    sh:resultPath nltl:asBuiltPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n2d2ee2711eba45e0aa7342f7cb704628b12 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F012/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-048-CaseShape>. See details for more information." ;
            sh:resultPath nltl:hasSteelGradeRequirementCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-048-CaseShape> ;
                    sh:path nltl:hasSteelGradeRequirementCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F012/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F012/case> ;
            sh:resultMessage "Less than 1 values on ex:case->nltl:asBuiltPlateThickness" ;
            sh:resultPath nltl:asBuiltPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n2d2ee2711eba45e0aa7342f7cb704628b12 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F012/case> ;
            sh:resultMessage "The actual steel grade does not meet the required Table 8 rank within its steel-strength category." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:n2d2ee2711eba45e0aa7342f7cb704628b26 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-048-CaseShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F012/case> ] .

_:N4ecb55243e904175a6d31b84ec8f98f3 sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path qudt:unit .

_:Nc10feb4a716b477684721f489da43165 sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:Nec451508861a40bf9439b9103fc28c88 a sh:NodeShape ;
    sh:property _:N4ecb55243e904175a6d31b84ec8f98f3,
        _:Nc10feb4a716b477684721f489da43165 .

_:n2d2ee2711eba45e0aa7342f7cb704628b11 sh:class nltl:tableReferenceValue ;
    sh:hasValue nltl:iacsUrI2Table8 ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:tableReference .

_:n2d2ee2711eba45e0aa7342f7cb704628b12 sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node _:Nec451508861a40bf9439b9103fc28c88 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:asBuiltPlateThickness .

_:n2d2ee2711eba45e0aa7342f7cb704628b26 a sh:SPARQLConstraint ;
    sh:message "The actual steel grade does not meet the required Table 8 rank within its steel-strength category." ;
    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:actualHullStructuralSteelGrade ?actual ;
        nltl:requiredHullStructuralSteelGrade ?required ;
        nltl:steelStrengthCategory ?category .
  ?actual nltl:steelGradeOrderRank ?actualRank .
  ?required nltl:steelGradeOrderRank ?requiredRank .
  FILTER(?actualRank < ?requiredRank)
  FILTER(
    (?category = nltl:normalStrengthSteelCategory &&
      ?actual IN (
        nltl:steelGradeB,
        nltl:steelGradeD,
        nltl:steelGradeE
      ) &&
      ?required IN (
        nltl:steelGradeB,
        nltl:steelGradeD,
        nltl:steelGradeE
      ))
    ||
    (?category = nltl:highTensileSteelCategory &&
      ?actual IN (
        nltl:steelGradeAh,
        nltl:steelGradeDh,
        nltl:steelGradeEh,
        nltl:steelGradeFh
      ) &&
      ?required IN (
        nltl:steelGradeAh,
        nltl:steelGradeDh,
        nltl:steelGradeEh,
        nltl:steelGradeFh
      ))
  )
}
""" .

