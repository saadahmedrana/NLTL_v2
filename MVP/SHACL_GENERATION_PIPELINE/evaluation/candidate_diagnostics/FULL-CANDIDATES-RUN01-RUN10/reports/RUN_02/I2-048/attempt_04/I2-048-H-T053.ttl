@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T053/case> ;
                    sh:resultMessage "Less than 1 values on ex:case->nltl:asBuiltPlateThickness" ;
                    sh:resultPath nltl:asBuiltPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue unit:MilliM ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:asBuiltPlateThickness ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T053/case> ;
                    sh:resultMessage "The Table 8 selection is missing, non-applicable, or does not require the exact grade; actual grade rank must meet the required rank within its strength-category family." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "The Table 8 selection is missing, non-applicable, or does not require the exact grade; actual grade rank must meet the required rank within its strength-category family." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
              ?ship nltl:hasSteelGradeRequirementCase $this .

              OPTIONAL { ?ship nltl:polarClass ?pc . }
              OPTIONAL {
                $this nltl:asBuiltPlateThickness ?th .
                OPTIONAL { ?th qudt:numericValue ?t . }
                OPTIONAL { ?th qudt:unit ?u . }
              }
              OPTIONAL { $this nltl:steelMaterialClass ?mat . }
              OPTIONAL { $this nltl:steelStrengthCategory ?str . }
              OPTIONAL { $this nltl:tableReference ?tr . }
              OPTIONAL { $this nltl:actualHullStructuralSteelGrade ?actual . }
              OPTIONAL { $this nltl:requiredHullStructuralSteelGrade ?req . }
              OPTIONAL { ?actual nltl:steelGradeOrderRank ?ar . }
              OPTIONAL { ?req nltl:steelGradeOrderRank ?rr . }

              BIND(IF(BOUND(?pc), ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3), false) AS ?p13)
              BIND(IF(BOUND(?pc), ?pc IN (nltl:polarClassPc4, nltl:polarClassPc5), false) AS ?p45)
              BIND(IF(BOUND(?pc), ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7), false) AS ?p67)
              BIND(IF(BOUND(?mat), ?mat = nltl:steelMaterialClassOne, false) AS ?m1)
              BIND(IF(BOUND(?mat), ?mat = nltl:steelMaterialClassTwo, false) AS ?m2)
              BIND(IF(BOUND(?mat), ?mat = nltl:steelMaterialClassThree, false) AS ?m3)
              BIND(IF(BOUND(?str), ?str = nltl:normalStrengthSteelCategory, false) AS ?normal)
              BIND(IF(BOUND(?str), ?str = nltl:highTensileSteelCategory, false) AS ?high)
              BIND(IF(BOUND(?u), ?u = unit:MilliM, false) AS ?mm)

              FILTER(
                !BOUND(?pc) ||
                !BOUND(?t) ||
                !BOUND(?mat) ||
                !BOUND(?str) ||
                !BOUND(?tr) ||
                ?tr != nltl:iacsUrI2Table8 ||
                !?mm ||
                (
                  BOUND(?t) &&
                  BOUND(?mat) &&
                  BOUND(?str) &&
                  (
                    (
                      ?t <= 10 &&
                      (
                        (?m1 && ?normal && ((?p13 || ?p45 || ?p67) && BOUND(?req) && ?req = nltl:steelGradeB)) ||
                        (?m1 && ?high && ((?p13 || ?p45 || ?p67) && BOUND(?req) && ?req = nltl:steelGradeAh)) ||
                        (?m2 && ?normal && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeB || ?p67 && BOUND(?req) && ?req = nltl:steelGradeB)) ||
                        (?m2 && ?high && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeAh || ?p67 && BOUND(?req) && ?req = nltl:steelGradeAh)) ||
                        (?m3 && ?normal && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeE || ?p67 && BOUND(?req) && ?req = nltl:steelGradeB)) ||
                        (?m3 && ?high && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeEh || ?p67 && BOUND(?req) && ?req = nltl:steelGradeAh))
                      )
                    ) ||
                    (
                      ?t > 10 && ?t <= 15 &&
                      (
                        (?m1 && ?normal && BOUND(?req) && ?req = nltl:steelGradeB) ||
                        (?m1 && ?high && BOUND(?req) && ?req = nltl:steelGradeAh) ||
                        (?m2 && ?normal && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeD || ?p67 && BOUND(?req) && ?req = nltl:steelGradeB)) ||
                        (?m2 && ?high && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeDh || ?p67 && BOUND(?req) && ?req = nltl:steelGradeAh)) ||
                        (?m3 && ?normal && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeE || ?p67 && BOUND(?req) && ?req = nltl:steelGradeD)) ||
                        (?m3 && ?high && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeEh || ?p67 && BOUND(?req) && ?req = nltl:steelGradeDh))
                      )
                    ) ||
                    (
                      ?t > 15 && ?t <= 25 &&
                      (
                        (?m1 && ?normal && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeD || ?p67 && BOUND(?req) && ?req = nltl:steelGradeB)) ||
                        (?m1 && ?high && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeDh || ?p67 && BOUND(?req) && ?req = nltl:steelGradeAh)) ||
                        (?m2 && ?normal && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeD || ?p67 && BOUND(?req) && ?req = nltl:steelGradeB)) ||
                        (?m2 && ?high && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeDh || ?p67 && BOUND(?req) && ?req = nltl:steelGradeAh)) ||
                        (?m3 && ?normal && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeE || ?p67 && BOUND(?req) && ?req = nltl:steelGradeD)) ||
                        (?m3 && ?high && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeEh || ?p67 && BOUND(?req) && ?req = nltl:steelGradeDh))
                      )
                    ) ||
                    (
                      ?t > 25 && ?t <= 35 &&
                      (
                        (?m1 && ?normal && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeD || ?p67 && BOUND(?req) && ?req = nltl:steelGradeB)) ||
                        (?m1 && ?high && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeDh || ?p67 && BOUND(?req) && ?req = nltl:steelGradeAh)) ||
                        (?m2 && ?normal && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeE || ?p67 && BOUND(?req) && ?req = nltl:steelGradeD)) ||
                        (?m2 && ?high && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeEh || ?p67 && BOUND(?req) && ?req = nltl:steelGradeDh)) ||
                        (?m3 && ?normal && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeE || ?p67 && BOUND(?req) && ?req = nltl:steelGradeE)) ||
                        (?m3 && ?high && ((?p13 || ?p45 || ?p67) && BOUND(?req) && ?req = nltl:steelGradeEh))
                      )
                    ) ||
                    (
                      ?t > 35 && ?t <= 40 &&
                      (
                        (?m1 && ?normal && BOUND(?req) && ?req = nltl:steelGradeD) ||
                        (?m1 && ?high && BOUND(?req) && ?req = nltl:steelGradeDh) ||
                        (?m2 && ?normal && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeE || ?p67 && BOUND(?req) && ?req = nltl:steelGradeD)) ||
                        (?m2 && ?high && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeEh || ?p67 && BOUND(?req) && ?req = nltl:steelGradeDh)) ||
                        (?m3 && ?normal && ((?p13 && !BOUND(?req)) || (?p45 || ?p67) && BOUND(?req) && ?req = nltl:steelGradeE)) ||
                        (?m3 && ?high && ((?p13 && BOUND(?req) && ?req = nltl:steelGradeFh) || (?p45 || ?p67) && BOUND(?req) && ?req = nltl:steelGradeEh))
                      )
                    ) ||
                    (
                      ?t > 40 && ?t <= 45 &&
                      (
                        (?m1 && ?normal && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeE || ?p67 && BOUND(?req) && ?req = nltl:steelGradeD)) ||
                        (?m1 && ?high && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeEh || ?p67 && BOUND(?req) && ?req = nltl:steelGradeDh)) ||
                        (?m2 && ?normal && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeE || ?p67 && BOUND(?req) && ?req = nltl:steelGradeD)) ||
                        (?m2 && ?high && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeEh || ?p67 && BOUND(?req) && ?req = nltl:steelGradeDh)) ||
                        (?m3 && ?normal && ((?p13 && !BOUND(?req)) || (?p45 || ?p67) && BOUND(?req) && ?req = nltl:steelGradeE)) ||
                        (?m3 && ?high && ((?p13 && BOUND(?req) && ?req = nltl:steelGradeFh) || (?p45 || ?p67) && BOUND(?req) && ?req = nltl:steelGradeEh))
                      )
                    ) ||
                    (
                      ?t > 45 && ?t <= 50 &&
                      (
                        (?m1 && ?normal && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeE || ?p67 && BOUND(?req) && ?req = nltl:steelGradeD)) ||
                        (?m1 && ?high && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeEh || ?p67 && BOUND(?req) && ?req = nltl:steelGradeDh)) ||
                        (?m2 && ?normal && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeE || ?p67 && BOUND(?req) && ?req = nltl:steelGradeD)) ||
                        (?m2 && ?high && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeEh || ?p67 && BOUND(?req) && ?req = nltl:steelGradeDh)) ||
                        (?m3 && ?normal && ((?p13 || ?p45) && !BOUND(?req) || ?p67 && BOUND(?req) && ?req = nltl:steelGradeE)) ||
                        (?m3 && ?high && ((?p13 || ?p45) && BOUND(?req) && ?req = nltl:steelGradeFh || ?p67 && BOUND(?req) && ?req = nltl:steelGradeEh))
                      )
                    )
                  )
                ) ||
                (
                  BOUND(?req) &&
                  (
                    ( ?normal && ( !BOUND(?actual) || !BOUND(?ar) || !BOUND(?rr) || ?actual NOT IN (nltl:steelGradeB, nltl:steelGradeD, nltl:steelGradeE) || ?ar < ?rr ) ) ||
                    ( ?high && ( !BOUND(?actual) || !BOUND(?ar) || !BOUND(?rr) || ?actual NOT IN (nltl:steelGradeAh, nltl:steelGradeDh, nltl:steelGradeEh, nltl:steelGradeFh) || ?ar < ?rr ) )
                  )
                )
              )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-048-CaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T053/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T053/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-048-CaseShape>. See details for more information." ;
            sh:resultPath nltl:hasSteelGradeRequirementCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeRequirementCase ;
                    sh:node <urn:nltl:generated-shape:I2-048-CaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasSteelGradeRequirementCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T053/case> ] .

