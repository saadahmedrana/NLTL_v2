@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F12/stemAngle> ;
                    sh:resultMessage "Node ex:stemAngle->q:unit does not contain a value in the set: ['unit:DEG']" ;
                    sh:resultPath q:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue unit:DEG ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path q:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F12/ship> ;
            sh:resultMessage "A stem angle expressed in degrees is required." ;
            sh:resultPath nltl:stemAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A stem angle expressed in degrees is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class q:QuantityValue ;
                            sh:property [ sh:hasValue unit:DEG ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path q:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path q:numericValue ] ] ;
                    sh:path nltl:stemAngle ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F12/stemAngle> ] .

