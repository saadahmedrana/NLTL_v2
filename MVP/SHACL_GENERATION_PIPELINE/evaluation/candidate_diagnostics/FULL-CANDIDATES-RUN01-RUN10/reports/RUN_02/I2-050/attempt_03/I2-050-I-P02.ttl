@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-P02/ship> ;
            sh:resultMessage "The design vertical ice force at the bow must equal the lesser candidate force within the declared numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The design vertical ice force at the bow must equal the lesser candidate force within the declared numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX q: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designVerticalIceForceAtBow ?f .
                ?f q:numericValue ?fv ;
                   q:unit unit:MegaN .
                $this nltl:designVerticalIceForceAtBowCandidateOne ?f1node .
                ?f1node q:numericValue ?f1 ;
                        q:unit unit:MegaN .
                $this nltl:designVerticalIceForceAtBowCandidateTwo ?f2node .
                ?f2node q:numericValue ?f2 ;
                        q:unit unit:MegaN .
                BIND(IF(?f1 <= ?f2, ?f1, ?f2) AS ?expected)
                FILTER(ABS(?fv - ?expected) >
                       (1e-6 * ABS(?expected) + 1e-9))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_050_ComplexReadinessShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-P02/ship> ] .

