@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-P02/ship> ;
            sh:resultMessage "The design vertical ice force at bow must be the minimum of the two externally computed candidate forces." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The design vertical ice force at bow must be the minimum of the two externally computed candidate forces." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:designVerticalIceForceAtBow ?fNode .
    $this nltl:designVerticalIceForceAtBowCandidateOne ?f1Node .
    $this nltl:designVerticalIceForceAtBowCandidateTwo ?f2Node .
    ?fNode qudt:numericValue ?f .
    ?f1Node qudt:numericValue ?f1 .
    ?f2Node qudt:numericValue ?f2 .
    FILTER (
        !(
            ?f <= ?f1 &&
            ?f <= ?f2 &&
            (?f = ?f1 || ?f = ?f2)
        )
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape g:I2_050_ComplexReadinessShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-P02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-P02/ship> ;
            sh:resultMessage "A table lookup case with the required ice-force factors is required." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:tableLookupCase ;
                    sh:message "A table lookup case with the required ice-force factors is required." ;
                    sh:minCount 1 ;
                    sh:node g:I2_050_TableLookupCaseShape ;
                    sh:path nltl:hasTableLookupCase ] ] .

