            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4a40d5773cad4a5f87eb24b11f4381abb10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/lowerPoint> ;
            sh:resultMessage "The calculation case shall contain an interpolation point." ;
            sh:resultPath nltl:hasInterpolationPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4a40d5773cad4a5f87eb24b11f4381abb3 ],
