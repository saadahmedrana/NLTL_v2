                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/calculation> ;
                    sh:resultMessage "The calculation case shall identify an upper interpolation endpoint." ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n4a40d5773cad4a5f87eb24b11f4381abb5 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/ship> ;
            sh:resultMessage "The ship shall provide a calculation case for the interpolation determination." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "The ship shall provide a calculation case for the interpolation determination." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-052-CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/calculation> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/upperPoint> ;
            sh:resultMessage "The calculation case shall provide the externally determined interpolated longitudinal distribution factor." ;
            sh:resultPath nltl:interpolatedLongitudinalDistributionFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4a40d5773cad4a5f87eb24b11f4381abb10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/lowerPoint> ;
            sh:resultMessage "The calculation case shall identify a lower interpolation endpoint." ;
