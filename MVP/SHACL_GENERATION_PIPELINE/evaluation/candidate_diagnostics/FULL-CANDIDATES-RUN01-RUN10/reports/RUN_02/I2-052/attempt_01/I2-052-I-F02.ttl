@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/upperPoint> ;
            sh:resultMessage "The calculation case shall provide the hull-girder longitudinal position from aft in metres." ;
            sh:resultPath nltl:hullGirderLongitudinalPositionFromAft ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4a40d5773cad4a5f87eb24b11f4381abb6 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/calculation> ;
