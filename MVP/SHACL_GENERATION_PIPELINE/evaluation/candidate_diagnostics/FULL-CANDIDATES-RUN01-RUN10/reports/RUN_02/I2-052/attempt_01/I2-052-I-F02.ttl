        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/lowerPoint> ;
            sh:resultMessage "The calculation case shall provide the hull-girder longitudinal position from aft in metres." ;
            sh:resultPath nltl:hullGirderLongitudinalPositionFromAft ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4a40d5773cad4a5f87eb24b11f4381abb6 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/lowerPoint> ;
            sh:resultMessage "The calculation case shall provide the externally determined interpolated longitudinal distribution factor." ;
