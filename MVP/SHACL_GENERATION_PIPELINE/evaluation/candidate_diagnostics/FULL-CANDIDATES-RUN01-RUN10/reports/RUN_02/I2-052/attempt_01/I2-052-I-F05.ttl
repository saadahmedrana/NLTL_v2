_:N6ec9519ed64e4fe2898ff7257ad39967 sh:class qudt:QuantityValue ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ],
        [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:N9b955d309346409da7a5228c5920f923 sh:class qudt:QuantityValue ;
