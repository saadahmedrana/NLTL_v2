_:N265e2c737c894f7d9dc64d037e9a23b9 sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:N2ca048ae334a47d4aa388980ae8a69ab sh:class qudt:QuantityValue ;
    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:N58574adeab794441b596a547dbed73e4 sh:class qudt:QuantityValue ;
    sh:property _:N265e2c737c894f7d9dc64d037e9a23b9,
        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:n4a40d5773cad4a5f87eb24b11f4381abb3 sh:class nltl:interpolationPoint ;
    sh:message "The calculation case shall contain an interpolation point." ;
