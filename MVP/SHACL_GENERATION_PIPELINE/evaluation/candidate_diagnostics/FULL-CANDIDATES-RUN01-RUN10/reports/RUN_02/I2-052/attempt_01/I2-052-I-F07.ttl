            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4a40d5773cad4a5f87eb24b11f4381abb4 ] .

_:N00ee1e490f4c4730bdd12805d6be7a4d sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:N1ad2604959b8404884a524db13807ef8 sh:class qudt:QuantityValue ;
    sh:property _:N00ee1e490f4c4730bdd12805d6be7a4d,
        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:N3799c2cd62a24e6aa86e2e41ef769f69 sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:N3b08035535424b91a38b1195984a8c7c sh:class qudt:QuantityValue ;
    sh:property _:N3799c2cd62a24e6aa86e2e41ef769f69,
        [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:n4a40d5773cad4a5f87eb24b11f4381abb10 sh:message "The calculation case shall provide the externally determined interpolated longitudinal distribution factor." ;
    sh:minCount 1 ;
    sh:node _:N1ad2604959b8404884a524db13807ef8 ;
    sh:path nltl:interpolatedLongitudinalDistributionFactor .

_:n4a40d5773cad4a5f87eb24b11f4381abb3 sh:class nltl:interpolationPoint ;
    sh:message "The calculation case shall contain an interpolation point." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-052-InterpolationPointShape> ;
    sh:path nltl:hasInterpolationPoint .

_:n4a40d5773cad4a5f87eb24b11f4381abb4 sh:class nltl:interpolationPoint ;
    sh:message "The calculation case shall identify a lower interpolation endpoint." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-052-InterpolationPointShape> ;
    sh:path nltl:interpolationLowerEndpoint .

_:n4a40d5773cad4a5f87eb24b11f4381abb5 sh:class nltl:interpolationPoint ;
    sh:message "The calculation case shall identify an upper interpolation endpoint." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-052-InterpolationPointShape> ;
    sh:path nltl:interpolationUpperEndpoint .

_:n4a40d5773cad4a5f87eb24b11f4381abb6 sh:message "The calculation case shall provide the hull-girder longitudinal position from aft in metres." ;
    sh:minCount 1 ;
    sh:node _:N3b08035535424b91a38b1195984a8c7c ;
    sh:path nltl:hullGirderLongitudinalPositionFromAft .

