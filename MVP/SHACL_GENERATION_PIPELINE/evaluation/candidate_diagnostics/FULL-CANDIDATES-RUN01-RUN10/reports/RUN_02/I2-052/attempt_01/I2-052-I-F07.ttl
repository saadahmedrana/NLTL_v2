            sh:sourceShape _:n4a40d5773cad4a5f87eb24b11f4381abb4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F07/upperPoint> ;
            sh:resultMessage "The calculation case shall provide the externally determined interpolated longitudinal distribution factor." ;
            sh:resultPath nltl:interpolatedLongitudinalDistributionFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4a40d5773cad4a5f87eb24b11f4381abb10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F07/lowerPoint> ;
            sh:resultMessage "The calculation case shall identify an upper interpolation endpoint." ;
            sh:resultPath nltl:interpolationUpperEndpoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4a40d5773cad4a5f87eb24b11f4381abb5 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F07/upperPoint> ;
            sh:resultMessage "The calculation case shall identify an upper interpolation endpoint." ;
            sh:resultPath nltl:interpolationUpperEndpoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4a40d5773cad4a5f87eb24b11f4381abb5 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F07/lowerPoint> ;
            sh:resultMessage "The calculation case shall contain an interpolation point." ;
            sh:resultPath nltl:hasInterpolationPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4a40d5773cad4a5f87eb24b11f4381abb3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F07/ship> ;
            sh:resultMessage "The ship shall provide the externally determined interpolated value." ;
            sh:resultPath nltl:interpolatedValue ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship shall provide the externally determined interpolated value." ;
                    sh:minCount 1 ;
                    sh:path nltl:interpolatedValue ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F07/upperPoint> ;
            sh:resultMessage "The calculation case shall provide the hull-girder longitudinal position from aft in metres." ;
            sh:resultPath nltl:hullGirderLongitudinalPositionFromAft ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4a40d5773cad4a5f87eb24b11f4381abb6 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F07/lowerPoint> ;
            sh:resultMessage "The calculation case shall provide the hull-girder longitudinal position from aft in metres." ;
            sh:resultPath nltl:hullGirderLongitudinalPositionFromAft ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4a40d5773cad4a5f87eb24b11f4381abb6 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F07/upperPoint> ;
            sh:resultMessage "The calculation case shall contain an interpolation point." ;
