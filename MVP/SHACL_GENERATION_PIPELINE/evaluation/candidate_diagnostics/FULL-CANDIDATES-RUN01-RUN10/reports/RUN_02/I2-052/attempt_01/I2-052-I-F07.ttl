            sh:resultMessage "The calculation case shall provide the externally determined interpolated longitudinal distribution factor." ;
            sh:resultPath nltl:interpolatedLongitudinalDistributionFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4a40d5773cad4a5f87eb24b11f4381abb10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F07/upperPoint> ;
            sh:resultMessage "The calculation case shall identify a lower interpolation endpoint." ;
            sh:resultPath nltl:interpolationLowerEndpoint ;
            sh:resultSeverity sh:Violation ;
