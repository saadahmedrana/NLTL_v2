    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F09/lowerPoint> ;
            sh:resultMessage "The calculation case shall contain an interpolation point." ;
            sh:resultPath nltl:hasInterpolationPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4a40d5773cad4a5f87eb24b11f4381abb3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F09/lowerPoint> ;
            sh:resultMessage "The calculation case shall provide the hull-girder longitudinal position from aft in metres." ;
