_:N0043a93ad9e347409c263efd17a9d259 sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:N22535dba63fd4f1d9a59c27d64f4328b sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

_:N3b8a62c7506c4bdf9a378f4113ac9f6c sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:N9d93eb0b84634ed19131ff924efa5ac2 sh:class qudt:QuantityValue ;
    sh:property _:N0043a93ad9e347409c263efd17a9d259,
        [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:Nc5621627fda644a3b50e83d562a2be52 sh:class qudt:QuantityValue ;
    sh:property _:N22535dba63fd4f1d9a59c27d64f4328b,
        _:N3b8a62c7506c4bdf9a378f4113ac9f6c .

_:n4a40d5773cad4a5f87eb24b11f4381abb10 sh:message "The calculation case shall provide the externally determined interpolated longitudinal distribution factor." ;
    sh:minCount 1 ;
    sh:node _:Nc5621627fda644a3b50e83d562a2be52 ;
    sh:path nltl:interpolatedLongitudinalDistributionFactor .

_:n4a40d5773cad4a5f87eb24b11f4381abb3 sh:class nltl:interpolationPoint ;
    sh:message "The calculation case shall contain an interpolation point." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-052-InterpolationPointShape> ;
    sh:path nltl:hasInterpolationPoint .

_:n4a40d5773cad4a5f87eb24b11f4381abb4 sh:class nltl:interpolationPoint ;
    sh:message "The calculation case shall identify a lower interpolation endpoint." ;
    sh:minCount 1 ;
