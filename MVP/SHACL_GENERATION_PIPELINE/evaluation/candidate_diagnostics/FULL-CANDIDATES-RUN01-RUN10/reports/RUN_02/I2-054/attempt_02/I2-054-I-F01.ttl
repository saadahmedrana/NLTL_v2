@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F01/ship> ;
            sh:resultMessage "Less than 5 values on ex:ship->nltl:hasHullGirderBendingMomentCalculationCase" ;
            sh:resultPath nltl:hasHullGirderBendingMomentCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 5 ;
                    sh:node [ sh:class nltl:hullGirderBendingMomentCalculationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:caseDesignVerticalIceBendingMoment ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:caseHullGirderLongitudinalPositionFromAft ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:caseBendingMomentDistributionFactor ] ] ;
                    sh:path nltl:hasHullGirderBendingMomentCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:upperIceWaterlineLengthLUI" ;
            sh:resultPath nltl:upperIceWaterlineLengthLUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:upperIceWaterlineLengthLUI ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F01/bendingCase> ;
                    sh:resultMessage "Less than 5 values on ex:bendingCase->nltl:hasInterpolationPoint" ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 5 ;
                            sh:node [ sh:class nltl:interpolationPoint ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ],
                                                        [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:interpolationPointCoordinate ],
                                        [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:interpolationPointResult ] ] ;
                            sh:path nltl:hasInterpolationPoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:calculationCase ; sh:property [ sh:minCount Literal(\"5\", datatype=xsd:integer) ; sh:node [ sh:class nltl:interpolationPoint ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:interpolationPointResult ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:interpolationPointCoordinate ] ] ; sh:path nltl:hasInterpolationPoint ] ]. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:minCount 5 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ] ] ;
                                    sh:path nltl:hasInterpolationPoint ] ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F01/bendingCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F01/ship> ;
            sh:resultMessage "The interpolation table must include normalized anchor coordinates 0.0, 0.5, 0.7, 0.95, and 1.0 with C_m values 0.0, 1.0, 1.0, 0.3, and 0.0; intermediate points may also be supplied." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The interpolation table must include normalized anchor coordinates 0.0, 0.5, 0.7, 0.95, and 1.0 with C_m values 0.0, 1.0, 1.0, 0.3, and 0.0; intermediate points may also be supplied." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?calc .
                    ?calc nltl:hasInterpolationPoint ?p0 .
                    ?p0 nltl:interpolationPointCoordinate/qudt:numericValue ?c0 ;
                        nltl:interpolationPointResult/qudt:numericValue ?r0 .
                    FILTER(?c0 = 0.0 && ?r0 = 0.0)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?calc .
                    ?calc nltl:hasInterpolationPoint ?p05 .
                    ?p05 nltl:interpolationPointCoordinate/qudt:numericValue ?c05 ;
                         nltl:interpolationPointResult/qudt:numericValue ?r05 .
                    FILTER(?c05 = 0.5 && ?r05 = 1.0)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?calc .
                    ?calc nltl:hasInterpolationPoint ?p07 .
                    ?p07 nltl:interpolationPointCoordinate/qudt:numericValue ?c07 ;
                         nltl:interpolationPointResult/qudt:numericValue ?r07 .
                    FILTER(?c07 = 0.7 && ?r07 = 1.0)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?calc .
                    ?calc nltl:hasInterpolationPoint ?p095 .
                    ?p095 nltl:interpolationPointCoordinate/qudt:numericValue ?c095 ;
                          nltl:interpolationPointResult/qudt:numericValue ?r095 .
                    FILTER(?c095 = 0.95 && ?r095 = 0.3)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?calc .
                    ?calc nltl:hasInterpolationPoint ?p1 .
                    ?p1 nltl:interpolationPointCoordinate/qudt:numericValue ?c1 ;
                       nltl:interpolationPointResult/qudt:numericValue ?r1 .
                    FILTER(?c1 = 1.0 && ?r1 = 0.0)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_054_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F01/ship> ] .

