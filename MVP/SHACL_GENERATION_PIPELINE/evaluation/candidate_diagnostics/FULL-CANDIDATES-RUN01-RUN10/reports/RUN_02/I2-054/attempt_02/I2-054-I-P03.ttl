@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/ship> ;
            sh:resultMessage "The hull-girder calculation cases must include all five declared C_m anchor positions: 0.0, 0.5 L_UI, 0.7 L_UI, 0.95 L_UI, and 1.0 L_UI." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The hull-girder calculation cases must include all five declared C_m anchor positions: 0.0, 0.5 L_UI, 0.7 L_UI, 0.95 L_UI, and 1.0 L_UI." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineLengthLUI/qudt:numericValue ?lui .
                FILTER NOT EXISTS {
                    $this nltl:hasHullGirderBendingMomentCalculationCase ?aft .
                    ?aft nltl:caseHullGirderLongitudinalPositionFromAft/qudt:numericValue ?p0 .
                    ?aft nltl:caseBendingMomentDistributionFactor/qudt:numericValue ?cm0 .
                    FILTER(?p0 / ?lui = 0.0 && ?cm0 = 0.0)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasHullGirderBendingMomentCalculationCase ?half .
                    ?half nltl:caseHullGirderLongitudinalPositionFromAft/qudt:numericValue ?p05 .
                    ?half nltl:caseBendingMomentDistributionFactor/qudt:numericValue ?cm05 .
                    FILTER(?p05 / ?lui = 0.5 && ?cm05 = 1.0)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasHullGirderBendingMomentCalculationCase ?seven .
                    ?seven nltl:caseHullGirderLongitudinalPositionFromAft/qudt:numericValue ?p07 .
                    ?seven nltl:caseBendingMomentDistributionFactor/qudt:numericValue ?cm07 .
                    FILTER(?p07 / ?lui = 0.7 && ?cm07 = 1.0)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasHullGirderBendingMomentCalculationCase ?ninetyfive .
                    ?ninetyfive nltl:caseHullGirderLongitudinalPositionFromAft/qudt:numericValue ?p095 .
                    ?ninetyfive nltl:caseBendingMomentDistributionFactor/qudt:numericValue ?cm095 .
                    FILTER(?p095 / ?lui = 0.95 && ?cm095 = 0.3)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasHullGirderBendingMomentCalculationCase ?forward .
                    ?forward nltl:caseHullGirderLongitudinalPositionFromAft/qudt:numericValue ?p1 .
                    ?forward nltl:caseBendingMomentDistributionFactor/qudt:numericValue ?cm1 .
                    FILTER(?p1 / ?lui = 1.0 && ?cm1 = 0.0)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_054_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/ship> ;
            sh:resultMessage "Less than 5 values on ex:ship->nltl:hasHullGirderBendingMomentCalculationCase" ;
            sh:resultPath nltl:hasHullGirderBendingMomentCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 5 ;
                    sh:node [ sh:class nltl:hullGirderBendingMomentCalculationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:caseBendingMomentDistributionFactor ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:caseDesignVerticalIceBendingMoment ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:caseHullGirderLongitudinalPositionFromAft ] ] ;
                    sh:path nltl:hasHullGirderBendingMomentCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/ship> ;
            sh:resultMessage "The interpolation table must include normalized anchor coordinates 0.0, 0.5, 0.7, 0.95, and 1.0 with C_m values 0.0, 1.0, 1.0, 0.3, and 0.0; intermediate points may also be supplied." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The interpolation table must include normalized anchor coordinates 0.0, 0.5, 0.7, 0.95, and 1.0 with C_m values 0.0, 1.0, 1.0, 0.3, and 0.0; intermediate points may also be supplied." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?calc .
                    ?calc nltl:hasInterpolationPoint ?p0 .
                    ?p0 nltl:interpolationPointCoordinate/qudt:numericValue ?c0 ;
                        nltl:interpolationPointResult/qudt:numericValue ?r0 .
                    FILTER(?c0 = 0.0 && ?r0 = 0.0)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?calc .
                    ?calc nltl:hasInterpolationPoint ?p05 .
                    ?p05 nltl:interpolationPointCoordinate/qudt:numericValue ?c05 ;
                         nltl:interpolationPointResult/qudt:numericValue ?r05 .
                    FILTER(?c05 = 0.5 && ?r05 = 1.0)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?calc .
                    ?calc nltl:hasInterpolationPoint ?p07 .
                    ?p07 nltl:interpolationPointCoordinate/qudt:numericValue ?c07 ;
                         nltl:interpolationPointResult/qudt:numericValue ?r07 .
                    FILTER(?c07 = 0.7 && ?r07 = 1.0)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?calc .
                    ?calc nltl:hasInterpolationPoint ?p095 .
                    ?p095 nltl:interpolationPointCoordinate/qudt:numericValue ?c095 ;
                          nltl:interpolationPointResult/qudt:numericValue ?r095 .
                    FILTER(?c095 = 0.95 && ?r095 = 0.3)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?calc .
                    ?calc nltl:hasInterpolationPoint ?p1 .
                    ?p1 nltl:interpolationPointCoordinate/qudt:numericValue ?c1 ;
                       nltl:interpolationPointResult/qudt:numericValue ?r1 .
                    FILTER(?c1 = 1.0 && ?r1 = 0.0)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_054_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/ship> ],
