@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "The hull-girder calculation cases shall represent the five required C_m anchor cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The hull-girder calculation cases shall represent the five required C_m anchor cases." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this
WHERE {
    $this nltl:upperIceWaterlineLengthLUI ?lq .
    ?lq qudt:numericValue ?l .

    FILTER NOT EXISTS {
        $this nltl:hasHullGirderBendingMomentCalculationCase ?c .
        ?c nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
        ?pq qudt:numericValue ?p .
        ?c nltl:caseBendingMomentDistributionFactor ?mq .
        ?mq qudt:numericValue ?cm .
        FILTER (
            ?p >= (?l * -0.000001) &&
            ?p <= (?l * 0.000001) &&
            ?cm >= 0.0 && ?cm <= 0.0
        )
    }

    FILTER NOT EXISTS {
        $this nltl:hasHullGirderBendingMomentCalculationCase ?c .
        ?c nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
        ?pq qudt:numericValue ?p .
        ?c nltl:caseBendingMomentDistributionFactor ?mq .
        ?mq qudt:numericValue ?cm .
        FILTER (
            ?p >= (?l * 0.499999) &&
            ?p <= (?l * 0.500001) &&
            ?cm >= 1.0 && ?cm <= 1.0
        )
    }

    FILTER NOT EXISTS {
        $this nltl:hasHullGirderBendingMomentCalculationCase ?c .
        ?c nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
        ?pq qudt:numericValue ?p .
        ?c nltl:caseBendingMomentDistributionFactor ?mq .
        ?mq qudt:numericValue ?cm .
        FILTER (
            ?p >= (?l * 0.699999) &&
            ?p <= (?l * 0.700001) &&
            ?cm >= 1.0 && ?cm <= 1.0
        )
    }

    FILTER NOT EXISTS {
        $this nltl:hasHullGirderBendingMomentCalculationCase ?c .
        ?c nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
        ?pq qudt:numericValue ?p .
        ?c nltl:caseBendingMomentDistributionFactor ?mq .
        ?mq qudt:numericValue ?cm .
        FILTER (
            ?p >= (?l * 0.949999) &&
            ?p <= (?l * 0.950001) &&
            ?cm >= 0.3 && ?cm <= 0.3
        )
    }

    FILTER NOT EXISTS {
        $this nltl:hasHullGirderBendingMomentCalculationCase ?c .
        ?c nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
        ?pq qudt:numericValue ?p .
        ?c nltl:caseBendingMomentDistributionFactor ?mq .
        ?mq qudt:numericValue ?cm .
        FILTER (
            ?p >= (?l * 0.999999) &&
            ?p <= (?l * 1.000001) &&
            ?cm >= 0.0 && ?cm <= 0.0
        )
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-054-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/bendingCase> ;
            sh:resultMessage "Less than 1 values on ex:bendingCase->nltl:hasInterpolationPoint" ;
            sh:resultPath nltl:hasInterpolationPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:interpolationPoint ] ;
                    sh:path nltl:hasInterpolationPoint ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "The ship shall provide a calculation case with interpolation-point data." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide a calculation case with interpolation-point data." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:interpolationPoint ] ;
                                    sh:path nltl:hasInterpolationPoint ] ] ;
                    sh:path nltl:hasCalculationCase ] ] .

