@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp1> ;
            sh:resultMessage "Less than 1 values on ex:interp1->nltl:hasInterpolationPoint" ;
            sh:resultPath nltl:hasInterpolationPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ned1e5a031746475691a1891c144c5364b20 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/ship> ;
            sh:resultMessage "The hull-girder calculation cases shall represent the five required C_m anchor cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The hull-girder calculation cases shall represent the five required C_m anchor cases." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this
WHERE {
    $this nltl:upperIceWaterlineLengthLUI ?lq .
    ?lq qudt:numericValue ?l .

    FILTER NOT EXISTS {
        $this nltl:hasHullGirderBendingMomentCalculationCase ?c .
        ?c nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
        ?pq qudt:numericValue ?p .
        ?c nltl:caseBendingMomentDistributionFactor ?mq .
        ?mq qudt:numericValue ?cm .
        FILTER (
            ?p >= (?l * -0.000001) &&
            ?p <= (?l * 0.000001) &&
            ?cm >= 0.0 && ?cm <= 0.0
        )
    }

    FILTER NOT EXISTS {
        $this nltl:hasHullGirderBendingMomentCalculationCase ?c .
        ?c nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
        ?pq qudt:numericValue ?p .
        ?c nltl:caseBendingMomentDistributionFactor ?mq .
        ?mq qudt:numericValue ?cm .
        FILTER (
            ?p >= (?l * 0.499999) &&
            ?p <= (?l * 0.500001) &&
            ?cm >= 1.0 && ?cm <= 1.0
        )
    }

    FILTER NOT EXISTS {
        $this nltl:hasHullGirderBendingMomentCalculationCase ?c .
        ?c nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
        ?pq qudt:numericValue ?p .
        ?c nltl:caseBendingMomentDistributionFactor ?mq .
        ?mq qudt:numericValue ?cm .
        FILTER (
            ?p >= (?l * 0.699999) &&
            ?p <= (?l * 0.700001) &&
            ?cm >= 1.0 && ?cm <= 1.0
        )
    }

    FILTER NOT EXISTS {
        $this nltl:hasHullGirderBendingMomentCalculationCase ?c .
        ?c nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
        ?pq qudt:numericValue ?p .
        ?c nltl:caseBendingMomentDistributionFactor ?mq .
        ?mq qudt:numericValue ?cm .
        FILTER (
            ?p >= (?l * 0.949999) &&
            ?p <= (?l * 0.950001) &&
            ?cm >= 0.3 && ?cm <= 0.3
        )
    }

    FILTER NOT EXISTS {
        $this nltl:hasHullGirderBendingMomentCalculationCase ?c .
        ?c nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
        ?pq qudt:numericValue ?p .
        ?c nltl:caseBendingMomentDistributionFactor ?mq .
        ?mq qudt:numericValue ?cm .
        FILTER (
            ?p >= (?l * 0.999999) &&
            ?p <= (?l * 1.000001) &&
            ?cm >= 0.0 && ?cm <= 0.0
        )
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-054-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp1> ;
            sh:resultMessage "Less than 1 values on ex:interp1->nltl:interpolationPointResult" ;
            sh:resultPath nltl:interpolationPointResult ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ned1e5a031746475691a1891c144c5364b38 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp2> ;
            sh:resultMessage "Less than 1 values on ex:interp2->nltl:hasInterpolationPoint" ;
            sh:resultPath nltl:hasInterpolationPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ned1e5a031746475691a1891c144c5364b20 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp1> ;
            sh:resultMessage "Less than 1 values on ex:interp1->nltl:interpolationPointCoordinate" ;
            sh:resultPath nltl:interpolationPointCoordinate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ned1e5a031746475691a1891c144c5364b34 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp2> ;
            sh:resultMessage "Less than 1 values on ex:interp2->nltl:interpolationPointResult" ;
            sh:resultPath nltl:interpolationPointResult ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ned1e5a031746475691a1891c144c5364b38 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp2> ;
            sh:resultMessage "Less than 1 values on ex:interp2->nltl:interpolationPointCoordinate" ;
            sh:resultPath nltl:interpolationPointCoordinate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ned1e5a031746475691a1891c144c5364b34 ] .

_:N85c7eabee3364857b9a3bc2edf761450 sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ],
        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:Nf99a121a64e04a418cc5fde572bb362a sh:class nltl:interpolationPoint .

_:ned1e5a031746475691a1891c144c5364b20 sh:minCount 1 ;
    sh:node _:Nf99a121a64e04a418cc5fde572bb362a ;
    sh:path nltl:hasInterpolationPoint .

_:ned1e5a031746475691a1891c144c5364b34 sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node _:N85c7eabee3364857b9a3bc2edf761450 ;
    sh:path nltl:interpolationPointCoordinate .

_:ned1e5a031746475691a1891c144c5364b38 sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:interpolationPointResult .

