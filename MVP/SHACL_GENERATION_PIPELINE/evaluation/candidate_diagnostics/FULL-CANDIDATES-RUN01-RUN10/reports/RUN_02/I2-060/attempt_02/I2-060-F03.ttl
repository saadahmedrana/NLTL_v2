@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/member> ;
                    sh:resultMessage "Less than 1 values on ex:member->nltl:stiffeningNecessary" ;
                    sh:resultPath nltl:stiffeningNecessary ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:stiffeningNecessary ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-060-StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:node <urn:nltl:generated-shape:I2-060-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/ship> ;
            sh:resultMessage "A member in way of a cut-out must not be reported as unstable." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A member in way of a cut-out must not be reported as unstable." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:memberInWayOfCutout true .
                FILTER NOT EXISTS {
                    $this nltl:memberInstability false .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-060-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/ship> ] .

