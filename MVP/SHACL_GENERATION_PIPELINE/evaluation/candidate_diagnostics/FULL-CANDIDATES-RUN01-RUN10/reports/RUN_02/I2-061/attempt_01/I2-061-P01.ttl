@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/structure> ;
                            sh:resultMessage "The assessed hull structure must provide thickness as a metre-valued decimal quantity." ;
                            sh:resultPath nltl:thickness ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:message "The assessed hull structure must provide thickness as a metre-valued decimal quantity." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:thickness ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/case> ;
                    sh:resultMessage "A calculation case must identify its assessed hull structure." ;
                    sh:resultPath nltl:calculationCaseAssessedHullStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:hullStructure ;
                            sh:message "A calculation case must identify its assessed hull structure." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_061_HullStructureShape ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:calculationCaseAssessedHullStructure ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/structure> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/ship> ;
            sh:resultMessage "Each linked calculation case must follow the prescribed analytical procedure model." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "Each linked calculation case must follow the prescribed analytical procedure model." ;
                    sh:node gen:I2_061_CalculationCaseShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/case> ] .

