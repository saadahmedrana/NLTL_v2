@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "Every linked load carrying stringer or web frame must form part of a grillage system." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Every linked load carrying stringer or web frame must form part of a grillage system." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a ?memberType .
                FILTER (
                    ?memberType = nltl:loadCarryingStringer ||
                    ?memberType = nltl:webFrame
                )
                FILTER NOT EXISTS {
                    ?member nltl:partOfGrillageSystem ?grillage .
                    ?grillage a nltl:grillageSystem .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-062-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "The ship must identify a load carrying stringer forming part of a grillage system." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must identify a load carrying stringer forming part of a grillage system." ;
                    sh:path nltl:hasStructuralMember ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:loadCarryingStringer ;
                            sh:property [ sh:class nltl:grillageSystem ;
                                    sh:minCount 1 ;
                                    sh:path nltl:partOfGrillageSystem ] ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "The ship must identify a web frame forming part of a grillage system." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must identify a web frame forming part of a grillage system." ;
                    sh:path nltl:hasStructuralMember ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:webFrame ;
                            sh:property [ sh:class nltl:grillageSystem ;
                                    sh:minCount 1 ;
                                    sh:path nltl:partOfGrillageSystem ] ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "The ship must record that direct calculation is used." ;
            sh:resultPath nltl:directCalculationUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nbe5d3c996bba4f3e8a73133f06d5ab6bb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "The ship must record that direct calculation is used." ;
            sh:resultPath nltl:directCalculationUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nbe5d3c996bba4f3e8a73133f06d5ab6bb1 ] .

_:nbe5d3c996bba4f3e8a73133f06d5ab6bb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record that direct calculation is used." ;
    sh:minCount 1 ;
    sh:path nltl:directCalculationUsed .

