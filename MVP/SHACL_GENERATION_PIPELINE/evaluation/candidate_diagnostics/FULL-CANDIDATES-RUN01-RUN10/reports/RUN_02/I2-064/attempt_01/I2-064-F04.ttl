@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/ship> ;
            sh:resultMessage "The ship must provide one yield strength in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one yield strength in MPa." ;
                    sh:minCount 1 ;
                    sh:node gs:QuantityValueShape ;
                    sh:path nltl:yieldStrength ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/web> ;
                            sh:resultMessage "Each structural member web must provide one nominal shear stress in MPa." ;
                            sh:resultPath nltl:nominalShearStress ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each structural member web must provide one nominal shear stress in MPa." ;
                                    sh:minCount 1 ;
                                    sh:node gs:QuantityValueShape ;
                                    sh:path nltl:nominalShearStress ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/member> ;
                    sh:resultMessage "Value does not conform to Shape gs:StructuralMemberWebShape. See details for more information." ;
                    sh:resultPath nltl:hasStructuralMemberWeb ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node gs:StructuralMemberWebShape ;
                            sh:path nltl:hasStructuralMemberWeb ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/web> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/nominalFlangeVonMisesStress> ;
                                    sh:resultMessage "The quantity must use MPa." ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape [ sh:hasValue qudt:MegaPA ;
                                            sh:maxCount 1 ;
                                            sh:message "The quantity must use MPa." ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/flange> ;
                            sh:resultMessage "Each structural member flange must provide one nominal von Mises stress in MPa." ;
                            sh:resultPath nltl:nominalFlangeVonMisesStress ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each structural member flange must provide one nominal von Mises stress in MPa." ;
                                    sh:minCount 1 ;
                                    sh:node gs:QuantityValueShape ;
                                    sh:path nltl:nominalFlangeVonMisesStress ] ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/nominalFlangeVonMisesStress> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/member> ;
                    sh:resultMessage "Value does not conform to Shape gs:StructuralMemberFlangeShape. See details for more information." ;
                    sh:resultPath nltl:hasStructuralMemberFlange ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node gs:StructuralMemberFlangeShape ;
                            sh:path nltl:hasStructuralMemberFlange ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/flange> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gs:StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/member> ] .

