@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "A non-linear calculation case requires fracture, major buckling, and yielding margins on the ship, each with a unitless quantity value." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A non-linear calculation case requires fracture, major buckling, and yielding margins on the ship, each with a unitless quantity value." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                FILTER (
                    NOT EXISTS {
                        $this nltl:fractureMargin ?fracture .
                        ?fracture qudt:numericValue ?fractureValue .
                        ?fracture qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    }
                    || EXISTS {
                        $this nltl:fractureMargin ?fractureExtra .
                        ?fractureExtra qudt:unit ?fractureUnit .
                        FILTER (?fractureUnit != <http://qudt.org/vocab/unit/UNITLESS>)
                    }
                    || NOT EXISTS {
                        $this nltl:majorBucklingMargin ?buckling .
                        ?buckling qudt:numericValue ?bucklingValue .
                        ?buckling qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    }
                    || EXISTS {
                        $this nltl:majorBucklingMargin ?bucklingExtra .
                        ?bucklingExtra qudt:unit ?bucklingUnit .
                        FILTER (?bucklingUnit != <http://qudt.org/vocab/unit/UNITLESS>)
                    }
                    || NOT EXISTS {
                        $this nltl:yieldingMargin ?yielding .
                        ?yielding qudt:numericValue ?yieldingValue .
                        ?yielding qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    }
                    || EXISTS {
                        $this nltl:yieldingMargin ?yieldingExtra .
                        ?yieldingExtra qudt:unit ?yieldingUnit .
                        FILTER (?yieldingUnit != <http://qudt.org/vocab/unit/UNITLESS>)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:I2_065_ComplexReadinessShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ] .

