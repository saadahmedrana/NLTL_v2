@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ;
                    sh:resultMessage """Node ex:calculation must conform to one or more shapes in [ sh:property [ sh:class nltl:calculationMethodValue ; sh:hasValue nltl:nonlinearCalculationMethodValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:calculationMethod ], [ sh:class nltl:evidenceArtifact ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:nonlinearAnalysisAcceptanceEvidence ], [ sh:class qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:permanentLateralDeformation ], [ sh:class qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:permanentOutOfPlaneDeformation ], [ sh:class qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:relevantStructuralDimension ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:minorPermanentDeformationAssessmentSatisfied ] ] , [ sh:sparql [ sh:message Literal("A calculation case must have a non-linear or another explicitly represented calculation method.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            SELECT $this
                            WHERE {
                                $this nltl:calculationMethod ?method .
                                FILTER (?method != nltl:nonlinearCalculationMethodValue)
                                FILTER NOT EXISTS {
                                    $this nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                                }
                            }
                        ") ] ]""" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:or ( [ sh:property [ sh:class nltl:calculationMethodValue ;
                                                sh:hasValue nltl:nonlinearCalculationMethodValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:calculationMethod ],
                                            [ sh:class qudt:QuantityValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:permanentOutOfPlaneDeformation ],
                                            [ sh:class qudt:QuantityValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:permanentLateralDeformation ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:minorPermanentDeformationAssessmentSatisfied ],
                                            [ sh:class qudt:QuantityValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:relevantStructuralDimension ],
                                            [ sh:class nltl:evidenceArtifact ;
                                                sh:minCount 1 ;
                                                sh:path nltl:nonlinearAnalysisAcceptanceEvidence ] ] [ sh:sparql [ sh:message "A calculation case must have a non-linear or another explicitly represented calculation method." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            SELECT $this
                            WHERE {
                                $this nltl:calculationMethod ?method .
                                FILTER (?method != nltl:nonlinearCalculationMethodValue)
                                FILTER NOT EXISTS {
                                    $this nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                                }
                            }
                        """ ] ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:or ( [ sh:property [ sh:class nltl:calculationMethodValue ; sh:hasValue nltl:nonlinearCalculationMethodValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:calculationMethod ], [ sh:class nltl:evidenceArtifact ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:nonlinearAnalysisAcceptanceEvidence ], [ sh:class qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:permanentLateralDeformation ], [ sh:class qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:permanentOutOfPlaneDeformation ], [ sh:class qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:relevantStructuralDimension ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:minorPermanentDeformationAssessmentSatisfied ] ] [ sh:sparql [ sh:message Literal("A calculation case must have a non-linear or another explicitly represented calculation method.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            SELECT $this
                            WHERE {
                                $this nltl:calculationMethod ?method .
                                FILTER (?method != nltl:nonlinearCalculationMethodValue)
                                FILTER NOT EXISTS {
                                    $this nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                                }
                            }
                        ") ] ] ) ]. See details for more information.""" ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:node [ sh:or ( [ sh:property [ sh:class qudt:QuantityValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:permanentLateralDeformation ],
                                            [ sh:class nltl:evidenceArtifact ;
                                                sh:minCount 1 ;
                                                sh:path nltl:nonlinearAnalysisAcceptanceEvidence ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:minorPermanentDeformationAssessmentSatisfied ],
                                            [ sh:class qudt:QuantityValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:relevantStructuralDimension ],
                                            [ sh:class nltl:calculationMethodValue ;
                                                sh:hasValue nltl:nonlinearCalculationMethodValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:calculationMethod ],
                                            [ sh:class qudt:QuantityValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:permanentOutOfPlaneDeformation ] ] [ sh:sparql [ sh:message "A calculation case must have a non-linear or another explicitly represented calculation method." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            SELECT $this
                            WHERE {
                                $this nltl:calculationMethod ?method .
                                FILTER (?method != nltl:nonlinearCalculationMethodValue)
                                FILTER NOT EXISTS {
                                    $this nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                                }
                            }
                        """ ] ] ) ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ] .

