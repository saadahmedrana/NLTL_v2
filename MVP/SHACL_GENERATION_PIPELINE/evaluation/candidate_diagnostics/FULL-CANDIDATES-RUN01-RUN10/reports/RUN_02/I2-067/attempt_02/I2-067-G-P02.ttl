@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-P02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:structuralConnection ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"A ship with structural connections must record that continuity of strength is ensured.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:strengthContinuityStatus ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:structuralConnection ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-067-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-P02/ship> ] .

