@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:iceConditionValue ; sh:hasValue nltl:mediumFirstYearIceWithPossibleOldIceInclusions ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A ship designed for at least medium first-year ice must declare exactly one medium design ice condition.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:designIceCondition ], [ sh:class nltl:polarShipCategoryValue ; sh:hasValue nltl:polarShipCategoryA ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A ship designed for at least medium first-year ice must have exactly Category A.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:shipCategory ] ] , [ sh:property [ sh:class nltl:iceConditionValue ; sh:in ( nltl:iceConditionLessSevereThanCategoryAAndB nltl:iceFreeIceCondition nltl:openWaterIceCondition nltl:otherWatersIceCondition nltl:thinFirstYearIceWithPossibleOldIceInclusions ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When the medium first-year ice condition does not apply, the ship must declare exactly one non-triggering design ice condition.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:designIceCondition ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-001-ShipDesignIceCategory> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-F02/ship> ] .

