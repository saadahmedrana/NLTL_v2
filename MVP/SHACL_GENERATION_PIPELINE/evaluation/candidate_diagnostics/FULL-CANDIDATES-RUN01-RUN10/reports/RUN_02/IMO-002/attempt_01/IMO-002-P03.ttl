@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-P03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:polarShipCategoryA ; sh:path nltl:shipCategory ] ] , [ sh:property [ sh:hasValue nltl:polarShipCategoryB ; sh:path nltl:shipCategory ], [ sh:hasValue nltl:thinFirstYearIceWithPossibleOldIceInclusions ; sh:path nltl:designIceCondition ] ] , [ sh:sparql [ sh:message Literal("A ship with a design ice condition other than thin first-year ice with possible old-ice inclusions is outside this category-B condition.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:designIceCondition ?ice .
                        FILTER NOT EXISTS {
                            $this nltl:designIceCondition
                                nltl:thinFirstYearIceWithPossibleOldIceInclusions .
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:ShipDesignIceCategoryShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-P03/ship> ] .

