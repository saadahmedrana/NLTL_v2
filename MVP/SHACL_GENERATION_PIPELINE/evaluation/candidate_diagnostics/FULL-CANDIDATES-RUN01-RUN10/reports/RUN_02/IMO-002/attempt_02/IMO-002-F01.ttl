@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-F01/ship> ;
            sh:resultMessage "The ship category must be Category A, or Category B for at least thin first-year ice with possible old-ice inclusions, or be absent for the explicitly supplied non-qualifying ice conditions." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_002_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-F01/ship> ] .

