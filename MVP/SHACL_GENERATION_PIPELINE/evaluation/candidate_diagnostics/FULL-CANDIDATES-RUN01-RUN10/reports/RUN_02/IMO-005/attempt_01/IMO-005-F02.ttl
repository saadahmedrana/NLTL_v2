@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-005-F02/ship> ;
            sh:resultMessage "A ship described as being in ice free waters must have totalIcePresent false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship described as being in ice free waters must have totalIcePresent false." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceCondition ?condition .
    FILTER (?condition = "ice free waters"^^xsd:string)
    FILTER (
        NOT EXISTS {
            $this nltl:totalIcePresent ?presentFalse .
            FILTER (?presentFalse = false)
        }
        ||
        EXISTS {
            $this nltl:totalIcePresent ?presentTrue .
            FILTER (?presentTrue = true)
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_005_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-005-F02/ship> ] .

