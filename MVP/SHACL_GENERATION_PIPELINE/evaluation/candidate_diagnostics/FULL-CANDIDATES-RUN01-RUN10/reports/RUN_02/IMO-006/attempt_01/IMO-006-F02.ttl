@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-006-F02/iceThicknessValue> ;
                    sh:resultMessage "Value is not <= Literal(\"1.2\", datatype=xsd:decimal)" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MaxInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:maxInclusive 1.2 ;
                            sh:minCount 1 ;
                            sh:minInclusive 0.7 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 1.21 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-006-F02/ship> ;
            sh:resultMessage "Medium first-year ice thickness must be between 0.7 m and 1.2 m inclusive." ;
            sh:resultPath nltl:iceThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Medium first-year ice thickness must be between 0.7 m and 1.2 m inclusive." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 1.2 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 0.7 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:iceThickness ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-006-F02/iceThicknessValue> ] .

