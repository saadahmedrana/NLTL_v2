@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-006-F01/ship> ;
            sh:resultMessage "If the ship is classified as medium first-year ice, its ice thickness must be between 0.7 m and 1.2 m inclusive." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_006_MediumFirstYearIceShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-006-F01/ship> ] .

