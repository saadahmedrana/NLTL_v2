@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Open water requires no ice of land origin.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceOfLandOriginPresent ], [ sh:hasValue nltl:openWaterIceCondition ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Open-water classification is required for the open-water branch.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceConditionClassification ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Open water requires sea-ice concentration below 1 with the canonical unitless QUDT unit.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxExclusive Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:seaIceConcentration ] ] , [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A non-open-water ice classification must be explicitly present.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceConditionClassification ] ; sh:sparql [ sh:message Literal("The non-open-water classification must differ from open water.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceConditionClassification ?classification .
                        FILTER (?classification = nltl:openWaterIceCondition)
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO007ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F02/ship> ] .

