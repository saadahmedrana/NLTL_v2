@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F04/ship> ;
            sh:resultMessage "For bergy waters, land-origin ice concentration must be less than 1/10 and total ice concentration must not exceed 1/10, with both concentrations expressed as canonical dimensionless quantities." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For bergy waters, land-origin ice concentration must be less than 1/10 and total ice concentration must not exceed 1/10, with both concentrations expressed as canonical dimensionless quantities." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceCondition ?condition .
                FILTER (?condition = "bergy waters")

                OPTIONAL {
                    $this nltl:landOriginIceConcentration ?landQuantity .
                    ?landQuantity a qudt:QuantityValue ;
                        qudt:numericValue ?landValue ;
                        qudt:unit unit:UNITLESS .
                    FILTER (datatype(?landValue) = xsd:decimal)
                }

                OPTIONAL {
                    $this nltl:totalIceConcentration ?totalQuantity .
                    ?totalQuantity a qudt:QuantityValue ;
                        qudt:numericValue ?totalValue ;
                        qudt:unit unit:UNITLESS .
                    FILTER (datatype(?totalValue) = xsd:decimal)
                }

                FILTER (
                    !BOUND(?landValue) ||
                    ?landValue >= 1 ||
                    !BOUND(?totalValue) ||
                    ?totalValue > 1
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_009_BergyWatersShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F04/ship> ] .

