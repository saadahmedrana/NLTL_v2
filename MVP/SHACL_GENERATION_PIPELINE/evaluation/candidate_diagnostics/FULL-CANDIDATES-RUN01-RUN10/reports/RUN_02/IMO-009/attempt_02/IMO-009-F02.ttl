@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F02/ship> ;
            sh:resultMessage "When ice condition is bergy waters, both ice concentrations are required and must satisfy their regulatory limits." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When ice condition is bergy waters, both ice concentrations are required and must satisfy their regulatory limits." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:iceCondition ?condition .
  FILTER (LCASE(STR(?condition)) = "bergy waters")
  FILTER (
    NOT EXISTS {
      $this nltl:landOriginIceConcentration ?landNode
    }
    ||
    EXISTS {
      $this nltl:landOriginIceConcentration ?landNode .
      ?landNode qudt:numericValue ?landValue .
      FILTER (?landValue >= 1)
    }
    ||
    NOT EXISTS {
      $this nltl:totalIceConcentration ?totalNode
    }
    ||
    EXISTS {
      $this nltl:totalIceConcentration ?totalNode .
      ?totalNode qudt:numericValue ?totalValue .
      FILTER (?totalValue > 1)
    }
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_009_BergyWatersShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F02/ship> ] .

