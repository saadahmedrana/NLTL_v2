@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-013-F03/ship> ;
            sh:resultMessage "When lowest MDLT is below -10 deg C, shipOperatesInLowAirTemperature must be true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When lowest MDLT is below -10 deg C, shipOperatesInLowAirTemperature must be true." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:lowestMdlt ?quantity .
                ?quantity qudt:numericValue ?value ;
                          qudt:unit unit:DEG_C .
                FILTER (?value < "-10"^^xsd:decimal)
                FILTER NOT EXISTS {
                    ?this nltl:shipOperatesInLowAirTemperature ?state .
                    FILTER (?state = true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_013_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-013-F03/ship> ] .

