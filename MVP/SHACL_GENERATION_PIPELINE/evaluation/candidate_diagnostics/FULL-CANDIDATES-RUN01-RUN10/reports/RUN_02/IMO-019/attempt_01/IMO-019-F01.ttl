@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F01/ship> ;
            sh:resultMessage "polarServiceTemperature must be at least 10 degrees Celsius below lowestMdlt." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "polarServiceTemperature must be at least 10 degrees Celsius below lowestMdlt." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true ;
                      nltl:lowestMdlt ?lowestNode ;
                      nltl:polarServiceTemperature ?pstNode .
                ?lowestNode qudt:numericValue ?lowestValue ;
                            qudt:unit unit:DEG_C .
                ?pstNode qudt:numericValue ?pstValue ;
                         qudt:unit unit:DEG_C .
                FILTER (?pstValue > (?lowestValue - 10))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_019_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F01/ship> ] .

