@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:requiredSystemsFunctionalAtPst ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipOperatesInLowAirTemperature ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG_C ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:lowestMdlt ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG_C ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:polarServiceTemperature ] ; sh:sparql [ sh:message Literal("For a ship operating in low air temperature, polarServiceTemperature must be no greater than lowestMdlt minus 10 degrees Celsius, allowing a relative tolerance of 1e-6 of the expected result and an absolute tolerance of 1e-6 near zero.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:lowestMdlt ?lowestQuantity ;
                              nltl:polarServiceTemperature ?pstQuantity .
                        ?lowestQuantity <http://qudt.org/schema/qudt/numericValue> ?lowestValue ;
                                         <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/DEG_C> .
                        ?pstQuantity <http://qudt.org/schema/qudt/numericValue> ?pstValue ;
                                      <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/DEG_C> .
                        FILTER (
                            ?pstValue >
                            (?lowestValue - "10"^^xsd:decimal) +
                            IF(
                                ABS(?lowestValue - "10"^^xsd:decimal) > "1"^^xsd:decimal,
                                ABS(?lowestValue - "10"^^xsd:decimal) * "0.000001"^^xsd:decimal,
                                "0.000001"^^xsd:decimal
                            )
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipOperatesInLowAirTemperature ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_019_StaticCalculationShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F04/ship> ] .

