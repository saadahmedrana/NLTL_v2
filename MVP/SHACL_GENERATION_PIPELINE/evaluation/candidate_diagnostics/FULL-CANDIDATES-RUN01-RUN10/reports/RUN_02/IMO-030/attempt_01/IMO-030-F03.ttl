@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F03/ship> ;
            sh:resultMessage "When ice operation is applicable, the ship must record ice-safety monitoring, escort requirements, and both independent and escorted operation limits." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_030_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F03/ship> ] .

