@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F05/ship> ;
            sh:resultMessage "iceOperationApplicable must be recorded as a single boolean value." ;
            sh:resultPath nltl:iceOperationApplicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "iceOperationApplicable must be recorded as a single boolean value." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceOperationApplicable ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:IMO_030_NotApplicableShape , gen:IMO_030_ApplicableShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_030_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F05/ship> ] .

