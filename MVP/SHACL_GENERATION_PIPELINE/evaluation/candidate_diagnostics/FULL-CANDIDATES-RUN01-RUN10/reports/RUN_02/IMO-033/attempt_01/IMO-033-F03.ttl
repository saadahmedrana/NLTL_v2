@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F03/ship> ;
            sh:resultMessage "When ice accretion is likely, discontinuous projected area must equal continuous projected area times 1.05 and discontinuous static moment must equal continuous static moment times 1.10, within a relative tolerance of 1e-6 with an absolute fallback of 1e-12." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When ice accretion is likely, discontinuous projected area must equal continuous projected area times 1.05 and discontinuous static moment must equal continuous static moment times 1.10, within a relative tolerance of 1e-6 with an absolute fallback of 1e-12." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely true ;
                      nltl:continuousSurfaceProjectedArea ?continuousAreaNode ;
                      nltl:continuousSurfaceStaticMoment ?continuousMomentNode ;
                      nltl:discontinuousSurfaceProjectedArea ?discontinuousAreaNode ;
                      nltl:discontinuousSurfaceStaticMoment ?discontinuousMomentNode .

                ?continuousAreaNode qudt:numericValue ?continuousArea .
                ?continuousMomentNode qudt:numericValue ?continuousMoment .
                ?discontinuousAreaNode qudt:numericValue ?discontinuousArea .
                ?discontinuousMomentNode qudt:numericValue ?discontinuousMoment .

                FILTER (
                    ABS(?discontinuousArea - (?continuousArea * 1.05))
                    > (ABS(?continuousArea * 1.05) * 0.000001 + 0.000000000001)
                    ||
                    ABS(?discontinuousMoment - (?continuousMoment * 1.10))
                    > (ABS(?continuousMoment * 1.10) * 0.000001 + 0.000000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-033> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F03/ship> ] .

