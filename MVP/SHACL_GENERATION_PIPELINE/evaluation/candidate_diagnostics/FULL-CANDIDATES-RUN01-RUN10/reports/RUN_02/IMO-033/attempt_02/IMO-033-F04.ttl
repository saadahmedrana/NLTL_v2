@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F04/ship> ;
            sh:resultMessage "When ice accretion is likely, discontinuous surface projected area must equal continuous surface projected area multiplied by 1.05, and discontinuous surface static moment must equal continuous surface static moment multiplied by 1.10, within an explicit tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When ice accretion is likely, discontinuous surface projected area must equal continuous surface projected area multiplied by 1.05, and discontinuous surface static moment must equal continuous surface static moment multiplied by 1.10, within an explicit tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely true ;
                      nltl:continuousSurfaceProjectedArea ?continuousAreaNode ;
                      nltl:discontinuousSurfaceProjectedArea ?discontinuousAreaNode ;
                      nltl:continuousSurfaceStaticMoment ?continuousMomentNode ;
                      nltl:discontinuousSurfaceStaticMoment ?discontinuousMomentNode .

                ?continuousAreaNode qudt:numericValue ?continuousArea .
                ?discontinuousAreaNode qudt:numericValue ?discontinuousArea .
                ?continuousMomentNode qudt:numericValue ?continuousMoment .
                ?discontinuousMomentNode qudt:numericValue ?discontinuousMoment .

                BIND((?continuousArea * 1.05) AS ?expectedArea)
                BIND((?continuousMoment * 1.10) AS ?expectedMoment)
                BIND(IF(?expectedArea > 1.0, ?expectedArea * 0.000001, 0.000001) AS ?areaTolerance)
                BIND(IF(?expectedMoment > 1.0, ?expectedMoment * 0.000001, 0.000001) AS ?momentTolerance)

                FILTER(
                    (
                        ?discontinuousArea < (?expectedArea - ?areaTolerance) ||
                        ?discontinuousArea > (?expectedArea + ?areaTolerance)
                    ) ||
                    (
                        ?discontinuousMoment < (?expectedMoment - ?momentTolerance) ||
                        ?discontinuousMoment > (?expectedMoment + ?momentTolerance)
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_033_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F04/ship> ] .

