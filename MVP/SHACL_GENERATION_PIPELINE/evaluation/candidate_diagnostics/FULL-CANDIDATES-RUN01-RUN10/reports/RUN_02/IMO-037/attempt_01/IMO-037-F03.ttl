@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F03/ship> ;
            sh:resultMessage "The requirement applies to Category A or B ships constructed on or after 1 January 2017." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_037_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F03/ship> ] .

