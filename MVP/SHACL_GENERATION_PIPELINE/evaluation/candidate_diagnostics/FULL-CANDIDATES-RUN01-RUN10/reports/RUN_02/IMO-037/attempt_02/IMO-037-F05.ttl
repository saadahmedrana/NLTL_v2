@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F05/LC1> ;
                    sh:resultMessage "Each loading condition result requires linked result evidence." ;
                    sh:resultPath nltl:hasLoadingConditionResultEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:message "Each loading condition result requires linked result evidence." ;
                            sh:minCount 1 ;
                            sh:path nltl:hasLoadingConditionResultEvidence ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F05/LC1> ;
                    sh:resultMessage "Each loading condition must provide either a compliant permitted alternative-instrument outcome or a residual stability factor result." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gs:IMO037LoadingConditionCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F05/LC1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F05/ship> ;
            sh:resultMessage "Each represented loading condition must satisfy the residual-stability readiness condition." ;
            sh:resultPath nltl:hasLoadingConditionCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:loadingConditionCase ;
                    sh:message "Each represented loading condition must satisfy the residual-stability readiness condition." ;
                    sh:node gs:IMO037LoadingConditionCaseShape ;
                    sh:path nltl:hasLoadingConditionCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F05/LC1> ] .

