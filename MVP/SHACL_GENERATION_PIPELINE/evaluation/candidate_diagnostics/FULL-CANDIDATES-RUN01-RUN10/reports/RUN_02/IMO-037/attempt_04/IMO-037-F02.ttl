@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F02/LC1> ;
                    sh:resultMessage "Each loading condition case must have an identifier." ;
                    sh:resultPath nltl:loadingConditionIdentifier ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:string ;
                            sh:message "Each loading condition case must have an identifier." ;
                            sh:minCount 1 ;
                            sh:path nltl:loadingConditionIdentifier ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F02/LC1> ;
                    sh:resultMessage "Node ex:LC1 must conform to one or more shapes in gen:IMO037ResidualStabilityOutcomeShape , gen:IMO037AlternativeInstrumentOutcomeShape" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:IMO037LoadingConditionCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F02/LC1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO037LoadingConditionCaseShape. See details for more information." ;
            sh:resultPath nltl:hasLoadingConditionCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:IMO037LoadingConditionCaseShape ;
                    sh:path nltl:hasLoadingConditionCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F02/LC1> ] .

