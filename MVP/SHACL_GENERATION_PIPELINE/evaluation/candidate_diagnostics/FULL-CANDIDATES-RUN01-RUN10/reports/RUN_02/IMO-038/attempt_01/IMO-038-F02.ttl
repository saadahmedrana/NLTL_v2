@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F02/transversePenetrationValue> ;
                    sh:resultMessage "Value is not >= Literal(\"760\", datatype=xsd:integer)" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:maxInclusive 760 ;
                            sh:minCount 1 ;
                            sh:minInclusive 760 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 759.0 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape nltlgen:TransversePenetrationQuantityShape. See details for more information." ;
            sh:resultPath nltl:transversePenetration ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltlgen:TransversePenetrationQuantityShape ;
                    sh:path nltl:transversePenetration ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F02/transversePenetrationValue> ] .

