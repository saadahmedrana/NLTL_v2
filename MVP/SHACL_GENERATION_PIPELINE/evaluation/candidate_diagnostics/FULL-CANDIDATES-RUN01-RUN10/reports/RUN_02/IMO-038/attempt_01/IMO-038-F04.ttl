@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F04/selectedVerticalDamagePositionValue> ;
                    sh:resultMessage "Value is not >= Literal(\"0\", datatype=xsd:integer)" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:minInclusive 0 ;
                            sh:path qudt:numericValue ] ;
                    sh:value -0.01 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape nltlgen:SelectedVerticalDamagePositionQuantityShape. See details for more information." ;
            sh:resultPath nltl:selectedVerticalDamagePosition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltlgen:SelectedVerticalDamagePositionQuantityShape ;
                    sh:path nltl:selectedVerticalDamagePosition ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F04/selectedVerticalDamagePositionValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F04/ship> ;
            sh:resultMessage "Damage extents and selected vertical damage position do not satisfy the declared ice damage formulas and inclusive range." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Damage extents and selected vertical damage position do not satisfy the declared ice damage formulas and inclusive range." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthNode ;
                      nltl:upperIceWaterlineDraught ?draughtNode ;
                      nltl:longitudinalDamageExtent ?longNode ;
                      nltl:verticalDamageExtent ?verticalNode ;
                      nltl:selectedVerticalDamagePosition ?positionNode .

                ?lengthNode qudt:numericValue ?length .
                ?draughtNode qudt:numericValue ?draught .
                ?longNode qudt:numericValue ?long .
                ?verticalNode qudt:numericValue ?vertical .
                ?positionNode qudt:numericValue ?position .

                FILTER (?forward = true || ?forward = false)

                BIND(IF(?forward = true,
                        0.045 * ?length,
                        0.015 * ?length) AS ?expectedLong)
                BIND(IF(ABS(?expectedLong) > 0,
                        ABS(?expectedLong) * 0.000001,
                        0.000000001) AS ?longTolerance)

                BIND(IF(0.20 * ?draught < ?expectedLong,
                        0.20 * ?draught,
                        ?expectedLong) AS ?expectedVertical)
                BIND(IF(ABS(?expectedVertical) > 0,
                        ABS(?expectedVertical) * 0.000001,
                        0.000000001) AS ?verticalTolerance)

                FILTER (
                    ABS(?long - ?expectedLong) > ?longTolerance
                    ||
                    ABS(?vertical - ?expectedVertical) > ?verticalTolerance
                    ||
                    ?position < 0
                    ||
                    ?position > (1.20 * ?draught)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlgen:IMO038ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F04/ship> ] .

