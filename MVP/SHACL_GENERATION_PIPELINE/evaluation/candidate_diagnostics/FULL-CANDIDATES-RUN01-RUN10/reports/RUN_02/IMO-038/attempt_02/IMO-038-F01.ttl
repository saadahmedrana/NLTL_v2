@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ;
            sh:resultMessage "Allowed vertical position must be recorded." ;
            sh:resultPath nltl:allowedVerticalPosition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "Allowed vertical position must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:allowedVerticalPosition ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ;
            sh:resultMessage "Longitudinal damage extent must equal 4.5 percent or 1.5 percent of upper ice waterline length, according to the damage-center position." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Longitudinal damage extent must equal 4.5 percent or 1.5 percent of upper ice waterline length, according to the damage-center position." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthNode ;
                      nltl:longitudinalDamageExtent ?extentNode .
                ?lengthNode qudt:numericValue ?length .
                ?extentNode qudt:numericValue ?reported .
                BIND(IF(?forward = true, 0.045, 0.015) AS ?factor)
                BIND(?factor * ?length AS ?expected)
                BIND((?expected * 0.000001) + 0.000001 AS ?tolerance)
                FILTER (
                    ?reported < (?expected - ?tolerance) ||
                    ?reported > (?expected + ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-038> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ] .

