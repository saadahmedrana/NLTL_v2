@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ;
            sh:resultMessage "Allowed vertical position must be recorded." ;
            sh:resultPath nltl:allowedVerticalPosition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "Allowed vertical position must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:allowedVerticalPosition ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ;
            sh:resultMessage "Vertical damage extent must equal the lesser of 20 percent of draught and longitudinal damage extent." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Vertical damage extent must equal the lesser of 20 percent of draught and longitudinal damage extent." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDraught ?draughtNode ;
                      nltl:longitudinalDamageExtent ?longitudinalNode ;
                      nltl:verticalDamageExtent ?verticalNode .
                ?draughtNode qudt:numericValue ?draught .
                ?longitudinalNode qudt:numericValue ?longitudinal .
                ?verticalNode qudt:numericValue ?reported .
                BIND(0.20 * ?draught AS ?twentyPercentDraught)
                BIND(IF(?twentyPercentDraught < ?longitudinal, ?twentyPercentDraught, ?longitudinal) AS ?expected)
                BIND((?expected * 0.000001) + 0.000001 AS ?tolerance)
                FILTER (
                    ?reported < (?expected - ?tolerance) ||
                    ?reported > (?expected + ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-038> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ] .

