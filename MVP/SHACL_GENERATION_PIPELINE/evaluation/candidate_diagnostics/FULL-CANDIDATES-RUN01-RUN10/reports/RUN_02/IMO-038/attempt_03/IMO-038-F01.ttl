@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ;
            sh:resultMessage "Damage extents must satisfy the piecewise longitudinal formula, the lesser-of vertical formula, and the inclusive keel-to-1.20-draught vertical-position range. Formula results are checked with a relative tolerance of 1e-6 plus an absolute fallback of 1e-6 m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Damage extents must satisfy the piecewise longitudinal formula, the lesser-of vertical formula, and the inclusive keel-to-1.20-draught vertical-position range. Formula results are checked with a relative tolerance of 1e-6 plus an absolute fallback of 1e-6 m." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthNode ;
                      nltl:upperIceWaterlineDraught ?draughtNode ;
                      nltl:longitudinalDamageExtent ?longNode ;
                      nltl:verticalDamageExtent ?verticalNode ;
                      nltl:selectedVerticalDamagePosition ?positionNode .

                ?lengthNode qudt:numericValue ?length .
                ?draughtNode qudt:numericValue ?draught .
                ?longNode qudt:numericValue ?actualLongitudinal .
                ?verticalNode qudt:numericValue ?actualVertical .
                ?positionNode qudt:numericValue ?position .

                BIND(IF(?forward = true,
                        0.045 * ?length,
                        0.015 * ?length) AS ?expectedLongitudinal)
                BIND(0.20 * ?draught AS ?draughtLimit)
                BIND(IF(?draughtLimit < ?expectedLongitudinal,
                        ?draughtLimit,
                        ?expectedLongitudinal) AS ?expectedVertical)
                BIND((?expectedLongitudinal * 0.000001) + 0.000001 AS ?longTolerance)
                BIND((?expectedVertical * 0.000001) + 0.000001 AS ?verticalTolerance)

                FILTER (
                    ?actualLongitudinal < (?expectedLongitudinal - ?longTolerance)
                    || ?actualLongitudinal > (?expectedLongitudinal + ?longTolerance)
                    || ?actualVertical < (?expectedVertical - ?verticalTolerance)
                    || ?actualVertical > (?expectedVertical + ?verticalTolerance)
                    || ?position < 0
                    || ?position > (1.20 * ?draught)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_038_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ] .

