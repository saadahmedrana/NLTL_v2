@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F01/ship> ;
            sh:resultMessage "The ice-accretion applicability state must be recorded as true or false; when true, every relevant hatch or door must have associated ice or snow removal or prevention means." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO_040_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F01/ship> ] .

