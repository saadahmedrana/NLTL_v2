@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-041-P02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Hydraulically operated hatches or doors must have means to prevent freezing or excessive viscosity of hydraulic liquids.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hydraulicFluidFreezingOrViscosityControlPresent ], [ sh:hasValue Literal("hydraulic") ; sh:path nltl:openingActuationType ] ] , [ sh:sparql [ sh:message Literal("A non-hydraulic opening actuation type is required for the hydraulic-fluid protection condition to be non-applicable.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:openingActuationType ?actuationType .
                        FILTER (?actuationType != "hydraulic")
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_041_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-041-P02/ship> ] .

