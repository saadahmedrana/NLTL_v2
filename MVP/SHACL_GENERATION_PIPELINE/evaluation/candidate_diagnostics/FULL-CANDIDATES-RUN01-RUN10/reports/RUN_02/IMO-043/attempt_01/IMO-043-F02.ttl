@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "The ship shall record protection coverage for applicable machinery hazards." ;
            sh:resultPath nltl:hazardProtectionCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n2a49bc0dab0b46d4b935deddb6234ea0b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "The ship shall record protection coverage for applicable machinery hazards." ;
            sh:resultPath nltl:hazardProtectionCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n2a49bc0dab0b46d4b935deddb6234ea0b1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachinery> ;
                    sh:resultMessage "Each machinery installation shall provide hazard protection evidence." ;
                    sh:resultPath nltl:hasHazardProtectionEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:message "Each machinery installation shall provide hazard protection evidence." ;
                            sh:minCount 1 ;
                            sh:path nltl:hasHazardProtectionEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "Each linked machinery installation shall satisfy the applicable hazard protection constraints." ;
            sh:resultPath nltl:hasMachineryInstallation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:machineryInstallationItem ;
                    sh:message "Each linked machinery installation shall satisfy the applicable hazard protection constraints." ;
                    sh:node <urn:nltl:generated-shape:IMO-043-MachineryInstallationShape> ;
                    sh:path nltl:hasMachineryInstallation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachinery> ] .

_:n2a49bc0dab0b46d4b935deddb6234ea0b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall record protection coverage for applicable machinery hazards." ;
    sh:minCount 1 ;
    sh:path nltl:hazardProtectionCoverage .

