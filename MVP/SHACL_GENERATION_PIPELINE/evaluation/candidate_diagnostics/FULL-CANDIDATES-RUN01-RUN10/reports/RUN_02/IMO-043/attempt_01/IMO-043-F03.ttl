@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F03/ship> ;
            sh:resultMessage "The ship shall record protection coverage for applicable machinery hazards." ;
            sh:resultPath nltl:hazardProtectionCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n2a49bc0dab0b46d4b935deddb6234ea0b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F03/ship> ;
            sh:resultMessage "The ship shall record protection coverage for applicable machinery hazards." ;
            sh:resultPath nltl:hazardProtectionCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n2a49bc0dab0b46d4b935deddb6234ea0b1 ] .

_:n2a49bc0dab0b46d4b935deddb6234ea0b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall record protection coverage for applicable machinery hazards." ;
    sh:minCount 1 ;
    sh:path nltl:hazardProtectionCoverage .

