@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachinery> ;
            sh:resultMessage "The machinery installation must include every controlled applicable hazard." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:nea6a65a5428c456f96a6cecb93f21f28b11 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO043MachineryInstallationShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachinery> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachinery> ;
            sh:resultMessage "A machinery installation must record the complete six-hazard applicable set." ;
            sh:resultPath nltl:hasApplicableHazard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nea6a65a5428c456f96a6cecb93f21f28b2 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachinery> ;
                    sh:resultMessage "The machinery installation must include every controlled applicable hazard." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:nea6a65a5428c456f96a6cecb93f21f28b11 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:IMO043MachineryInstallationShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachinery> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachineryEquipment> ;
                            sh:resultMessage "Each associated equipment item must be connected to an installation having complete hazard coverage and protection evidence." ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraint _:nea6a65a5428c456f96a6cecb93f21f28b12 ;
                            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                            sh:sourceShape gen:IMO043AssociatedEquipmentShape ;
                            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachineryEquipment> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachinery> ;
                    sh:resultMessage "Each represented associated equipment item must be linked to a machinery installation with complete hazard coverage." ;
                    sh:resultPath nltl:hasAssociatedEquipment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nea6a65a5428c456f96a6cecb93f21f28b9 ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachineryEquipment> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachinery> ;
                    sh:resultMessage "A machinery installation must record the complete six-hazard applicable set." ;
                    sh:resultPath nltl:hasApplicableHazard ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nea6a65a5428c456f96a6cecb93f21f28b2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/ship> ;
            sh:resultMessage "Each represented machinery installation must satisfy the hazard-coverage constraint." ;
            sh:resultPath nltl:hasMachineryInstallation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:machineryInstallationItem ;
                    sh:message "Each represented machinery installation must satisfy the hazard-coverage constraint." ;
                    sh:node gen:IMO043MachineryInstallationShape ;
                    sh:path nltl:hasMachineryInstallation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachinery> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachineryEquipment> ;
                    sh:resultMessage "Each associated equipment item must be connected to an installation having complete hazard coverage and protection evidence." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:nea6a65a5428c456f96a6cecb93f21f28b12 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:IMO043AssociatedEquipmentShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachineryEquipment> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachinery> ;
            sh:resultMessage "Each represented associated equipment item must be linked to a machinery installation with complete hazard coverage." ;
            sh:resultPath nltl:hasAssociatedEquipment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nea6a65a5428c456f96a6cecb93f21f28b9 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachineryEquipment> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachineryEquipment> ;
            sh:resultMessage "Each associated equipment item must be connected to an installation having complete hazard coverage and protection evidence." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:nea6a65a5428c456f96a6cecb93f21f28b12 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO043AssociatedEquipmentShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachineryEquipment> ] .

_:N1ce56defbf604d43aa4ed12275460a5a rdf:first nltl:seawaterIntakeTemperatureHazard ;
    rdf:rest ( nltl:snowIngestionHazard ) .

_:N451a376016bd448ca04d054c47cefe4e rdf:first nltl:liquidFreezingOrViscosityIncreaseHazard ;
    rdf:rest _:N1ce56defbf604d43aa4ed12275460a5a .

_:Ncc08ed4d4c724ca9b685707c585ff52f rdf:first nltl:snowAccumulationHazard ;
    rdf:rest ( nltl:seawaterIceIngestionHazard nltl:liquidFreezingOrViscosityIncreaseHazard nltl:seawaterIntakeTemperatureHazard nltl:snowIngestionHazard ) .

_:Ndffc2c519dc84057917d33261bb22969 rdf:first nltl:iceAccretionHazard ;
    rdf:rest _:Ncc08ed4d4c724ca9b685707c585ff52f .

_:nea6a65a5428c456f96a6cecb93f21f28b11 sh:message "The machinery installation must include every controlled applicable hazard." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasApplicableHazard nltl:iceAccretionHazard .
                    $this nltl:hasApplicableHazard nltl:snowAccumulationHazard .
                    $this nltl:hasApplicableHazard nltl:seawaterIceIngestionHazard .
                    $this nltl:hasApplicableHazard nltl:liquidFreezingOrViscosityIncreaseHazard .
                    $this nltl:hasApplicableHazard nltl:seawaterIntakeTemperatureHazard .
                    $this nltl:hasApplicableHazard nltl:snowIngestionHazard .
                }
            }
        """ .

_:nea6a65a5428c456f96a6cecb93f21f28b2 sh:class nltl:applicableHazardValue ;
    sh:in _:Ndffc2c519dc84057917d33261bb22969 ;
    sh:maxCount 6 ;
    sh:message "A machinery installation must record the complete six-hazard applicable set." ;
    sh:minCount 6 ;
    sh:path nltl:hasApplicableHazard .

_:nea6a65a5428c456f96a6cecb93f21f28b9 sh:class nltl:associatedEquipmentItem ;
    sh:message "Each represented associated equipment item must be linked to a machinery installation with complete hazard coverage." ;
    sh:node gen:IMO043AssociatedEquipmentShape ;
    sh:path nltl:hasAssociatedEquipment .

_:nea6a65a5428c456f96a6cecb93f21f28b12 sh:message "Each associated equipment item must be connected to an installation having complete hazard coverage and protection evidence." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    ?installation nltl:hasAssociatedEquipment $this .
                    ?installation nltl:hasApplicableHazard nltl:iceAccretionHazard .
                    ?installation nltl:hasApplicableHazard nltl:snowAccumulationHazard .
                    ?installation nltl:hasApplicableHazard nltl:seawaterIceIngestionHazard .
                    ?installation nltl:hasApplicableHazard nltl:liquidFreezingOrViscosityIncreaseHazard .
                    ?installation nltl:hasApplicableHazard nltl:seawaterIntakeTemperatureHazard .
                    ?installation nltl:hasApplicableHazard nltl:snowIngestionHazard .
                    ?installation nltl:hasHazardProtectionEvidence ?evidence .
                }
            }
        """ .

