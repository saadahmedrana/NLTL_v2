@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/engine1> ;
                    sh:resultMessage "Each essential engine must have combustion-air temperature control present." ;
                    sh:resultPath nltl:combustionAirTemperatureControlPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "Each essential engine must have combustion-air temperature control present." ;
                            sh:minCount 1 ;
                            sh:path nltl:combustionAirTemperatureControlPresent ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Each essential engine must have combustion-air temperature control present.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:combustionAirTemperatureControlPresent ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Each essential engine must provide one combustion-air temperature in degrees Celsius.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:combustionAirTemperature ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Each essential engine must provide one manufacturer maximum combustion-air temperature in degrees Celsius.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:manufacturerMaxAirTemperature ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Each essential engine must provide one manufacturer minimum combustion-air temperature in degrees Celsius.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:manufacturerMinAirTemperature ] ; sh:sparql [ sh:message Literal("The combustion-air temperature must be within the engine manufacturer's minimum and maximum criteria.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:combustionAirTemperature ?temperatureNode .
                        $this nltl:manufacturerMinAirTemperature ?minimumNode .
                        $this nltl:manufacturerMaxAirTemperature ?maximumNode .
                        ?temperatureNode qudt:numericValue ?temperature .
                        ?minimumNode qudt:numericValue ?minimum .
                        ?maximumNode qudt:numericValue ?maximum .
                        FILTER (
                            ?temperature < ?minimum ||
                            ?temperature > ?maximum
                        )
                    }
                ") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasEssentialEngine ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:essentialEngine ;
                    sh:node [ sh:property [ sh:maxCount 1 ;
                                    sh:message "Each essential engine must provide one combustion-air temperature in degrees Celsius." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:combustionAirTemperature ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each essential engine must provide one manufacturer minimum combustion-air temperature in degrees Celsius." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:manufacturerMinAirTemperature ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each essential engine must provide one manufacturer maximum combustion-air temperature in degrees Celsius." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:manufacturerMaxAirTemperature ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "Each essential engine must have combustion-air temperature control present." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:combustionAirTemperatureControlPresent ] ;
                            sh:sparql [ sh:message "The combustion-air temperature must be within the engine manufacturer's minimum and maximum criteria." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:combustionAirTemperature ?temperatureNode .
                        $this nltl:manufacturerMinAirTemperature ?minimumNode .
                        $this nltl:manufacturerMaxAirTemperature ?maximumNode .
                        ?temperatureNode qudt:numericValue ?temperature .
                        ?minimumNode qudt:numericValue ?minimum .
                        ?maximumNode qudt:numericValue ?maximum .
                        FILTER (
                            ?temperature < ?minimum ||
                            ?temperature > ?maximum
                        )
                    }
                """ ] ] ;
                    sh:path nltl:hasEssentialEngine ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/engine1> ] .

