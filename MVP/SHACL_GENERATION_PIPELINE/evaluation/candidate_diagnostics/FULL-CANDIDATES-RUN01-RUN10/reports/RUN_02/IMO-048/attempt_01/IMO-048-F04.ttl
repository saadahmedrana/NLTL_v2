@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F04/ship> ;
            sh:resultMessage "The approving authority shall be the Administration or a recognized organization accepted by the Administration." ;
            sh:resultPath nltl:approvingAuthority ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "Administration" "recognized organization accepted by the Administration" ) ;
                    sh:maxCount 1 ;
                    sh:message "The approving authority shall be the Administration or a recognized organization accepted by the Administration." ;
                    sh:minCount 1 ;
                    sh:path nltl:approvingAuthority ] ;
            sh:value "Administration"^^xsd:string ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F04/ship> ;
            sh:resultMessage "The approval basis shall preserve the polar service temperature, expressed in degrees Celsius." ;
            sh:resultPath nltl:polarServiceTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The approval basis shall preserve the polar service temperature, expressed in degrees Celsius." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:DEG_C ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:polarServiceTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F04/ship> ;
            sh:resultMessage "The approval standard shall be acceptable to the Organization or offer an equivalent level of safety." ;
            sh:resultPath nltl:approvalStandard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "standard acceptable to the Organization" "another standard offering an equivalent level of safety" ) ;
                    sh:maxCount 1 ;
                    sh:message "The approval standard shall be acceptable to the Organization or offer an equivalent level of safety." ;
                    sh:minCount 1 ;
                    sh:path nltl:approvalStandard ] ;
            sh:value "standard acceptable to the Organization"^^xsd:string ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode nltl:evidenceStateApproved ;
                    sh:resultMessage "Node nltl:evidenceStateApproved->rdfs:seeAlso does not contain a value in the set: ['nltl:evidenceStateApproved']" ;
                    sh:resultPath rdfs:seeAlso ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue nltl:evidenceStateApproved ;
                            sh:minCount 0 ;
                            sh:path rdfs:seeAlso ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F04/ship> ;
            sh:resultMessage "The material approval status shall be Approved." ;
            sh:resultPath nltl:materialApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:evidenceStateApproved ;
                    sh:maxCount 1 ;
                    sh:message "The material approval status shall be Approved." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:evidenceState ;
                            sh:property [ sh:hasValue nltl:evidenceState ;
                                    sh:minCount 1 ;
                                    sh:path rdf:type ],
                                [ sh:hasValue nltl:evidenceStateApproved ;
                                    sh:minCount 0 ;
                                    sh:path rdfs:seeAlso ] ] ;
                    sh:path nltl:materialApprovalStatus ] ;
            sh:value nltl:evidenceStateApproved ] .

