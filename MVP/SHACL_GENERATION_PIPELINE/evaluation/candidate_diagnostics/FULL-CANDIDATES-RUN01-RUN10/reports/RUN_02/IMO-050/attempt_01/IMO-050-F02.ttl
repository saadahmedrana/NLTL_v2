@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-050-F02/ship> ;
            sh:resultMessage "An exposed fire-safety component must have ice and snow protection." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "An exposed fire-safety component must have ice and snow protection." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:fireSafetyComponentExposed true .
                FILTER NOT EXISTS {
                    $this nltl:iceAndSnowProtectionPresent true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_050_FireSafetyProtectionShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-050-F02/ship> ] .

