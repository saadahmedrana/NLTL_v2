@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F01/control1> ;
                    sh:resultMessage "The local control item must remain continuously accessible." ;
                    sh:resultPath nltl:localControlContinuouslyAccessible ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "The local control item must remain continuously accessible." ;
                            sh:minCount 1 ;
                            sh:path nltl:localControlContinuouslyAccessible ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F01/control1> ;
                    sh:resultMessage "The local control item must have freezing, snow and ice protection." ;
                    sh:resultPath nltl:localControlProtectionPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "The local control item must have freezing, snow and ice protection." ;
                            sh:minCount 1 ;
                            sh:path nltl:localControlProtectionPresent ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F01/ship> ;
            sh:resultMessage "Each linked local control item must satisfy the freezing, snow, ice protection and continuous accessibility requirements." ;
            sh:resultPath nltl:hasLocalControlItem ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked local control item must satisfy the freezing, snow, ice protection and continuous accessibility requirements." ;
                    sh:node <urn:nltl:generated-shape:IMO-051-LocalControlItemShape> ;
                    sh:path nltl:hasLocalControlItem ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F01/control1> ] .

