@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:valveExposed ] ] , [ sh:and ( [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:valveExposed ] ] [ sh:property [ sh:in ( Literal(\"isolating\") Literal(\"pressure\") Literal(\"vacuum\") ) ; sh:path nltl:valveType ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"An exposed isolating, pressure, or vacuum valve must have ice accretion protection.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAccretionProtectionPresent ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"An exposed isolating, pressure, or vacuum valve must remain continuously accessible.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:continuouslyAccessible ] ] ) ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_055_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-F04/ship> ;
            sh:resultMessage "Valve exposure must be provided as a boolean." ;
            sh:resultPath nltl:valveExposed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "Valve exposure must be provided as a boolean." ;
                    sh:minCount 1 ;
                    sh:path nltl:valveExposed ] ] .

