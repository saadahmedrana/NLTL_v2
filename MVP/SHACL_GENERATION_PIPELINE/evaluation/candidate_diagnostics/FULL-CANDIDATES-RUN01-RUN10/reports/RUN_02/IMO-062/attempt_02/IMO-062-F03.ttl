@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F03/route1> ;
                    sh:resultMessage "The exposed escape route must have documented ice/snow mitigation evidence." ;
                    sh:resultPath nltl:hasEscapeRouteIceSnowMitigationEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:message "The exposed escape route must have documented ice/snow mitigation evidence." ;
                            sh:minCount 1 ;
                            sh:path nltl:hasEscapeRouteIceSnowMitigationEvidence ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F03/route1> ;
                    sh:resultMessage "The exposed escape route must be accessible." ;
                    sh:resultPath nltl:escapeRouteAccessibleStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:message "The exposed escape route must be accessible." ;
                            sh:path nltl:escapeRouteAccessibleStatus ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F03/route1> ;
                    sh:resultMessage "The exposed escape route must be safe." ;
                    sh:resultPath nltl:escapeRouteSafeStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:message "The exposed escape route must be safe." ;
                            sh:path nltl:escapeRouteSafeStatus ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F03/ship> ;
            sh:resultMessage "Each linked exposed escape route must satisfy the required accessibility, safety, and ice/snow mitigation evidence conditions." ;
            sh:resultPath nltl:hasExposedEscapeRoute ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:exposedEscapeRoute ;
                    sh:message "Each linked exposed escape route must satisfy the required accessibility, safety, and ice/snow mitigation evidence conditions." ;
                    sh:node gen:IMO_062_ExposedEscapeRouteShape ;
                    sh:path nltl:hasExposedEscapeRoute ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F03/route1> ] .

