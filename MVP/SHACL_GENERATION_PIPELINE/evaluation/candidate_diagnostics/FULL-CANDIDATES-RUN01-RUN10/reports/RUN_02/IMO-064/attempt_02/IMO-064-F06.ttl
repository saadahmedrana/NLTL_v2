@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F06/ship> ;
            sh:resultMessage "Approved thermal-protection adequacy evidence shall be linked." ;
            sh:resultPath nltl:thermalProtectionApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf6b88174822d436fb9cab307aaca7e1db2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F06/ship> ;
            sh:resultMessage "Approved thermal-protection adequacy evidence shall be linked." ;
            sh:resultPath nltl:thermalProtectionApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nf6b88174822d436fb9cab307aaca7e1db2 ] .

_:nf6b88174822d436fb9cab307aaca7e1db2 sh:hasValue nltl:evidenceStateApproved ;
    sh:message "Approved thermal-protection adequacy evidence shall be linked." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:thermalProtectionApprovalStatus .

