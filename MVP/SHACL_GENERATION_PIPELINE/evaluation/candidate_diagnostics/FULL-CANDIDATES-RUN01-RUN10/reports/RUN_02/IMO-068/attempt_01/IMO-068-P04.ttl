@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-P04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Safe evacuation means must be present when the requirement applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:safeEvacuationMeansPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The ship's operation in ice-covered waters must be recorded as true when this applicability branch is used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipOperatesInIceCoveredWaters ], [ sh:hasValue nltl:evidenceStateApproved ; sh:message Literal(\"Survival equipment deployment approval status must be approved when the requirement applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:survivalEquipmentDeploymentApprovalStatus ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Direct evacuation onto ice applicability must be recorded as true when this applicability branch is used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:directEvacuationOntoIceApplicable ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Safe evacuation means must be present when the requirement applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:safeEvacuationMeansPresent ], [ sh:hasValue nltl:evidenceStateApproved ; sh:message Literal(\"Survival equipment deployment approval status must be approved when the requirement applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:survivalEquipmentDeploymentApprovalStatus ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-068> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-P04/ship> ] .

