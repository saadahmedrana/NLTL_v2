@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-F03/ship> ;
            sh:resultMessage "When operating in ice-covered waters or evacuating directly onto ice, safe evacuation means and approved survival-equipment deployment evidence are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When operating in ice-covered waters or evacuating directly onto ice, safe evacuation means and approved survival-equipment deployment evidence are required." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    EXISTS {
                        $this nltl:shipOperatesInIceCoveredWaters true .
                    }
                    ||
                    EXISTS {
                        $this nltl:directEvacuationOntoIceApplicable true .
                    }
                )
                FILTER (
                    ! EXISTS {
                        $this nltl:safeEvacuationMeansPresent true .
                    }
                    ||
                    ! EXISTS {
                        $this nltl:survivalEquipmentDeploymentApprovalStatus nltl:evidenceStateApproved .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO068ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-F03/ship> ] .

