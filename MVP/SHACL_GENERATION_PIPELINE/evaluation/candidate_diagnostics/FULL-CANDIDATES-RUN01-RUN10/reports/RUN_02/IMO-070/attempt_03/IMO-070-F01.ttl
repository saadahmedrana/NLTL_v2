@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "A passenger ship must have exactly one size compatibility status, and it must be true." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n40c42cbe821b4644876797e37d279727b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "A ship subject to this rule must have exactly one ship type recorded as passenger_ship." ;
            sh:resultPath nltl:shipType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n40c42cbe821b4644876797e37d279727b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "A passenger ship must have exactly one size compatibility status, and it must be true." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n40c42cbe821b4644876797e37d279727b2 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/person1> ;
                    sh:resultMessage "Each person on board must have exactly one personal survival equipment assignment." ;
                    sh:resultPath nltl:hasPersonalSurvivalEquipmentAssignment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each person on board must have exactly one personal survival equipment assignment." ;
                            sh:minCount 1 ;
                            sh:node [ a sh:NodeShape ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:message "Each person on board must have exactly one assigned personal survival equipment item that is an immersion suit or a thermal protective aid." ;
                                            sh:minCount 1 ;
                                            sh:or ( [ sh:class nltl:immersionSuitEquipment ] [ sh:class nltl:thermalProtectiveAidEquipment ] ) ;
                                            sh:path nltl:assignedPersonalSurvivalEquipment ] ] ;
                            sh:path nltl:hasPersonalSurvivalEquipmentAssignment ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "Each person on board must have a qualifying survival equipment assignment." ;
            sh:resultPath nltl:hasPersonOnBoardMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each person on board must have a qualifying survival equipment assignment." ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "Each person on board must have exactly one personal survival equipment assignment." ;
                                    sh:minCount 1 ;
                                    sh:node [ a sh:NodeShape ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:message "Each person on board must have exactly one assigned personal survival equipment item that is an immersion suit or a thermal protective aid." ;
                                                    sh:minCount 1 ;
                                                    sh:or [ ] ;
                                                    sh:path nltl:assignedPersonalSurvivalEquipment ] ] ;
                                    sh:path nltl:hasPersonalSurvivalEquipmentAssignment ] ] ;
                    sh:path nltl:hasPersonOnBoardMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/person1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "A ship subject to this rule must have exactly one ship type recorded as passenger_ship." ;
            sh:resultPath nltl:shipType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n40c42cbe821b4644876797e37d279727b1 ] .

_:n40c42cbe821b4644876797e37d279727b1 sh:datatype xsd:string ;
    sh:hasValue "passenger_ship" ;
    sh:maxCount 1 ;
    sh:message "A ship subject to this rule must have exactly one ship type recorded as passenger_ship." ;
    sh:minCount 1 ;
    sh:path nltl:shipType .

_:n40c42cbe821b4644876797e37d279727b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "A passenger ship must have exactly one size compatibility status, and it must be true." ;
    sh:minCount 1 ;
    sh:path nltl:sizeCompatibilityStatus .

