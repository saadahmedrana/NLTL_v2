@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P04/ship> ;
            sh:resultMessage "A ship subject to this rule must have exactly one ship type recorded as passenger_ship." ;
            sh:resultPath nltl:shipType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n40c42cbe821b4644876797e37d279727b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P04/ship> ;
            sh:resultMessage "A ship subject to this rule must have exactly one ship type recorded as passenger_ship." ;
            sh:resultPath nltl:shipType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n40c42cbe821b4644876797e37d279727b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P04/ship> ;
            sh:resultMessage "A passenger ship must have exactly one size compatibility status, and it must be true." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n40c42cbe821b4644876797e37d279727b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P04/ship> ;
            sh:resultMessage "A passenger ship must have exactly one size compatibility status, and it must be true." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n40c42cbe821b4644876797e37d279727b2 ] .

_:n40c42cbe821b4644876797e37d279727b1 sh:datatype xsd:string ;
    sh:hasValue "passenger_ship" ;
    sh:maxCount 1 ;
    sh:message "A ship subject to this rule must have exactly one ship type recorded as passenger_ship." ;
    sh:minCount 1 ;
    sh:path nltl:shipType .

_:n40c42cbe821b4644876797e37d279727b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "A passenger ship must have exactly one size compatibility status, and it must be true." ;
    sh:minCount 1 ;
    sh:path nltl:sizeCompatibilityStatus .

