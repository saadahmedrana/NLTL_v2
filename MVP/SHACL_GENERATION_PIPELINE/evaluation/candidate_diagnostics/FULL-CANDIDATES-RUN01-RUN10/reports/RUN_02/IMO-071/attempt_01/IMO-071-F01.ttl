@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"The immersion-suit applicability state must be false for this branch.\") ; sh:path nltl:immersionSuitRequired ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The immersion-suit applicability state must be true for this branch.\") ; sh:path nltl:immersionSuitRequired ], [ sh:in ( nltl:insulatedImmersionSuit ) ; sh:message Literal(\"Where immersion suits are required, the immersion suit type must be insulated.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:immersionSuitTypeClassification ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO071Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F01/ship> ] .

