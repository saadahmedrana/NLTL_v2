@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype nltl:polarShipCategoryValue ; sh:hasValue nltl:polarShipCategoryC ; sh:message Literal(\"The ship category must be Category C for the non-applicable case.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipCategory ], [ sh:datatype xsd:date ; sh:message Literal(\"A construction date is required to determine applicability.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:constructionDate ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxInclusive Literal(\"2016-12-31\", datatype=xsd:date) ; sh:message Literal(\"The construction date must be before 1 January 2017 for this non-applicable case.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:constructionDate ], [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ; sh:message Literal(\"The ship category must be Category A or B.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:shipCategory ] ] , [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The bridge wings must be enclosed.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bridgeWingsEnclosed ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The bridge-wing protection design must be approved.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bridgeWingProtectionDesignStatus ] ] ) ; sh:property [ sh:datatype xsd:date ; sh:message Literal(\"The construction date must be on or after 1 January 2017.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2017-01-01\", datatype=xsd:date) ; sh:path nltl:constructionDate ], [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ; sh:message Literal(\"The ship category must be Category A or B.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:shipCategory ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-085-Static> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F02/ship> ] .

