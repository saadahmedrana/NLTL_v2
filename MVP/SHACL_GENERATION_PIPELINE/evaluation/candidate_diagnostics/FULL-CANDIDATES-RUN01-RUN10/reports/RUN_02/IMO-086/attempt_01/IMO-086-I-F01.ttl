@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/heading1> ;
                    sh:resultMessage "Less than 1 values on ex:heading1->nltl:independentFromHeadingMeans" ;
                    sh:resultPath nltl:independentFromHeadingMeans ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:nonMagneticHeadingMeans ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:independentFromHeadingMeans ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:class nltl:benchmarkEntity ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:connectedToEmergencyPower ], [ sh:class nltl:benchmarkEntity ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:connectedToMainPower ], [ sh:class nltl:nonMagneticHeadingMeans ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:independentFromHeadingMeans ] ]. See details for more information." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n9bb48ded31474d3b8c830cd674ec395db1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/heading1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "Less than 2 values on ex:ship->nltl:hasNonMagneticHeadingMeans" ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n9bb48ded31474d3b8c830cd674ec395db1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "Each non-magnetic heading means must be independent from a distinct non-magnetic heading means linked to the same ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each non-magnetic heading means must be independent from a distinct non-magnetic heading means linked to the same ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasNonMagneticHeadingMeans ?means .
                FILTER NOT EXISTS {
                    ?means nltl:independentFromHeadingMeans ?other .
                    $this nltl:hasNonMagneticHeadingMeans ?other .
                    FILTER (?means != ?other)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-086-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ] .

_:N60470fe314844d06923b0274cfa0b0a7 a sh:NodeShape ;
    sh:property [ sh:class nltl:benchmarkEntity ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path nltl:connectedToEmergencyPower ],
        [ sh:class nltl:nonMagneticHeadingMeans ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path nltl:independentFromHeadingMeans ],
        [ sh:class nltl:benchmarkEntity ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path nltl:connectedToMainPower ] .

_:n9bb48ded31474d3b8c830cd674ec395db1 sh:class nltl:nonMagneticHeadingMeans ;
    sh:minCount 2 ;
    sh:node _:N60470fe314844d06923b0274cfa0b0a7 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasNonMagneticHeadingMeans .

