@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-088-I-F03/ship> ;
            sh:resultMessage "If the ship does not operate solely in continuous daylight, it must either have at least two bridge-controlled rotatable narrow-beam searchlights with coverage of at least 360 degrees, or have an approved alternative visual ice-detection means." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:IMO_088_Static_ConditionalEquipmentShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-088-I-F03/ship> ] .

