@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-088-I-F04/ship> ;
            sh:resultMessage "If the ship does not operate solely in continuous daylight, it must either have at least two bridge-controlled rotatable narrow-beam searchlights with coverage of at least 360 degrees, or have an approved alternative visual ice-detection means." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:IMO_088_Static_ConditionalEquipmentShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-088-I-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-088-I-F04/ship> ;
            sh:resultMessage "The ship's continuous-daylight operating profile must be supplied as a single boolean value." ;
            sh:resultPath nltl:operatesOnlyInContinuousDaylight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ship's continuous-daylight operating profile must be supplied as a single boolean value." ;
                    sh:minCount 1 ;
                    sh:path nltl:operatesOnlyInContinuousDaylight ] ] .

