[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F02/ship> ;
            sh:resultMessage "The supported aircraft voice frequencies shall include 121.5 MHz." ;
            sh:resultPath nltl:supportedAircraftVoiceFrequency ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The supported aircraft voice frequencies shall include 121.5 MHz." ;
                    sh:node gen:IMO095AircraftVoiceFrequencyQuantityShape ;
                    sh:path nltl:supportedAircraftVoiceFrequency ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape gen:IMO095Aircraft1215QuantityShape ;
                    sh:qualifiedValueShapesDisjoint false ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F02/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath nltl:searchAndRescueCommunicationCapability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n30e544038e284b0892794d42e7ae69d8b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F02/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath nltl:searchAndRescueCommunicationCapability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n30e544038e284b0892794d42e7ae69d8b1 ] .

_:n30e544038e284b0892794d42e7ae69d8b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship shall declare search and rescue communication capability." ;
    sh:minCount 1 ;
    sh:path nltl:searchAndRescueCommunicationCapability .

