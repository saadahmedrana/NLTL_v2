@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipOperatesInLowAirTemperature ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipOperatesInLowAirTemperature ] ; sh:sparql [ sh:message Literal("Every linked rescue boat or lifeboat and survival craft must have at least one ship-to-shore distress-alert device, one location-signal device, and one on-scene communication device.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>

                    SELECT $this
                    WHERE {
                        $this (nltl:hasRequiredRescueBoatOrLifeboat|nltl:hasSurvivalCraft) ?craft .
                        FILTER (
                            NOT EXISTS {
                                ?craft nltl:survivalCraftHasShipToShoreDistressAlertDevice ?distressDevice .
                            }
                            ||
                            NOT EXISTS {
                                ?craft nltl:survivalCraftHasLocationSignalDevice ?locationDevice .
                            }
                            ||
                            NOT EXISTS {
                                ?craft nltl:survivalCraftHasOnSceneCommunicationDevice ?communicationDevice .
                            }
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-097-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F01/ship> ] .

