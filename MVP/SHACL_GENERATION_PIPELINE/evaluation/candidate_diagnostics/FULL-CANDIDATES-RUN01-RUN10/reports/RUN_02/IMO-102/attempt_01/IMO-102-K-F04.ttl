@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F04/crew> ;
                    sh:resultMessage "An applicable crew member must have both declared polar training record relationships." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "An applicable crew member must have both declared polar training record relationships." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                ?ship nltl:hasCrewMemberInventory $this ;
                       nltl:iceConditionClassification ?ice ;
                       nltl:polarTrainingShipTypeClassification ?shipType .
                $this nltl:polarTrainingCrewRoleClassification ?role .
                FILTER (
                    (
                        ?ice = nltl:openWaterIceCondition &&
                        ?shipType IN (
                            nltl:tankerPolarTrainingShipType,
                            nltl:passengerShipPolarTrainingShipType
                        )
                    ) ||
                    ?ice = nltl:otherWatersIceCondition
                )
                FILTER NOT EXISTS {
                    $this nltl:hasCrewTrainingRecord ?crewRecord .
                }
                FILTER NOT EXISTS {
                    $this nltl:hasPolarTrainingRecord ?polarRecord .
                }
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:IMO102CrewMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F04/crew> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO102CrewMemberShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:crewMember ;
                    sh:node gen:IMO102CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F04/crew> ] .

