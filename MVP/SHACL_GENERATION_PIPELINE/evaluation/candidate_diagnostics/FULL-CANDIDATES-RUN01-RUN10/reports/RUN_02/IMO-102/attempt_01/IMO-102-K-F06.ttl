@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ;
                            sh:resultMessage "Less than 1 values on ex:trainingRecord->nltl:requiredTrainingLevel" ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n3c9b2c24ec7b4e3ca88647a5334ebf0eb19 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:IMO102TrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasPolarTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:polarTrainingRecord ;
                            sh:node gen:IMO102TrainingRecordShape ;
                            sh:path nltl:hasPolarTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ;
                    sh:resultMessage "Each represented crew member must have exactly one controlled polar training role." ;
                    sh:resultPath nltl:polarTrainingCrewRoleClassification ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:polarTrainingCrewRoleValue ;
                            sh:in ( nltl:masterPolarTrainingRole nltl:chiefMatePolarTrainingRole nltl:officerInChargeOfNavigationalWatchPolarTrainingRole ) ;
                            sh:maxCount 1 ;
                            sh:message "Each represented crew member must have exactly one controlled polar training role." ;
                            sh:minCount 1 ;
                            sh:path nltl:polarTrainingCrewRoleClassification ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ;
                            sh:resultMessage "Less than 1 values on ex:trainingRecord->nltl:requiredTrainingLevel" ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n3c9b2c24ec7b4e3ca88647a5334ebf0eb19 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:IMO102TrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasCrewTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:polarTrainingRecord ;
                            sh:node gen:IMO102TrainingRecordShape ;
                            sh:path nltl:hasCrewTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO102CrewMemberShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:crewMember ;
                    sh:node gen:IMO102CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ] .

_:N02bd16e210f2424f8992c246f046858b rdf:first nltl:advancedPolarTrainingLevel ;
    rdf:rest ( nltl:polarTrainingNotApplicable ) .

_:N38187cf9ab084af0a6c0792e3924019c rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest _:N02bd16e210f2424f8992c246f046858b .

_:n3c9b2c24ec7b4e3ca88647a5334ebf0eb19 sh:class nltl:trainingLevelValue ;
    sh:in _:N38187cf9ab084af0a6c0792e3924019c ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:requiredTrainingLevel .

