                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:polarTrainingRecord ;
                            sh:node gen:IMO102TrainingRecordShape ;
                            sh:path nltl:hasCrewTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P24/trainingRecord> ],
