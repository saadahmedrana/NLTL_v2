@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F05/ship> ;
            sh:resultMessage "A non-applicable training record must use Polar training not applicable for both training-level properties." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A non-applicable training record must use Polar training not applicable for both training-level properties." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType ;
                      nltl:hasCrewMemberInventory ?crew .
                ?crew nltl:polarTrainingCrewRoleClassification ?role .
                FILTER (
                    ?ice = nltl:iceFreeIceCondition
                    ||
                    (?ice = nltl:openWaterIceCondition &&
                     ?shipType = nltl:otherShipPolarTrainingType)
                )
                ?crew (nltl:hasCrewTrainingRecord|nltl:hasPolarTrainingRecord) ?record .
                FILTER NOT EXISTS {
                    ?record nltl:requiredTrainingLevel nltl:polarTrainingNotApplicable ;
                            nltl:trainingRecordLevel nltl:polarTrainingNotApplicable .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO102ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F05/ship> ] .

