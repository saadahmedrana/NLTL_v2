@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F01/ship> ;
            sh:resultMessage "For clean or segregated ballast discharge, paragraph 1.1.1 must be recorded as not applicable." ;
            sh:resultPath nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue false ;
                    sh:maxCount 1 ;
                    sh:message "For clean or segregated ballast discharge, paragraph 1.1.1 must be recorded as not applicable." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ] ] .

