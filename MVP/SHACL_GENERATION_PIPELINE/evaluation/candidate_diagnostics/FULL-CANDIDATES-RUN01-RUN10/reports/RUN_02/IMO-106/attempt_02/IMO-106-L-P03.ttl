@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-P03/ship> ;
            sh:resultMessage "For clean or segregated ballast discharge, paragraph 1.1.1 must be recorded as not applicable." ;
            sh:resultPath nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue false ;
                    sh:maxCount 1 ;
                    sh:message "For clean or segregated ballast discharge, paragraph 1.1.1 must be recorded as not applicable." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-P03/ship> ;
            sh:resultMessage "The discharged material classification must be clean ballast or segregated ballast." ;
            sh:resultPath nltl:dischargedMaterialClassification ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:cleanBallastMaterial nltl:segregatedBallastMaterial ) ;
                    sh:message "The discharged material classification must be clean ballast or segregated ballast." ;
                    sh:minCount 1 ;
                    sh:path nltl:dischargedMaterialClassification ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-P03/otherMaterial> ] .

