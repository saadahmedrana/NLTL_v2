@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-F04/ship> ;
            sh:resultMessage "The ship's polar-water applicability and, when applicable, required polar-operation coverage indicators must conform to IMO-107 clause 1.1.4." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO107PolarOperationCoverageShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-F04/ship> ] .

