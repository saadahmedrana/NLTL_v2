@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-F01/ship> ;
            sh:resultMessage "For an applicable Category A or B ship constructed on or after 1 January 2017, which is not an oil tanker and has cargo tanks carrying oil, every cargo tank outer-shell separation value must be a metre quantity of at least 0.76 m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an applicable Category A or B ship constructed on or after 1 January 2017, which is not an oil tanker and has cargo tanks carrying oil, every cargo tank outer-shell separation value must be a metre quantity of at least 0.76 m." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:shipType ?shipType ;
                      nltl:constructionDate ?constructionDate ;
                      nltl:cargoTankCarriesOil ?carriesOil .

                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )
                FILTER (datatype(?constructionDate) = xsd:date)
                FILTER (?constructionDate >= "2017-01-01"^^xsd:date)
                FILTER (datatype(?carriesOil) = xsd:boolean && ?carriesOil = true)
                FILTER NOT EXISTS {
                    $this a nltl:oilTanker
                }

                FILTER (
                    NOT EXISTS {
                        $this nltl:cargoTankOuterShellSeparation ?missingSeparation
                    }
                    ||
                    EXISTS {
                        $this nltl:cargoTankOuterShellSeparation ?separation .

                        FILTER (
                            NOT EXISTS {
                                ?separation a qudt:QuantityValue
                            }
                            ||
                            NOT EXISTS {
                                ?separation qudt:numericValue ?decimalValue .
                                FILTER (datatype(?decimalValue) = xsd:decimal)
                            }
                            ||
                            EXISTS {
                                ?separation qudt:numericValue ?nonDecimalValue .
                                FILTER (datatype(?nonDecimalValue) != xsd:decimal)
                            }
                            ||
                            NOT EXISTS {
                                ?separation qudt:unit unit:M
                            }
                            ||
                            EXISTS {
                                ?separation qudt:unit ?nonMetreUnit .
                                FILTER (?nonMetreUnit != unit:M)
                            }
                            ||
                            EXISTS {
                                ?separation qudt:numericValue ?value .
                                FILTER (
                                    datatype(?value) = xsd:decimal &&
                                    ?value < "0.76"^^xsd:decimal
                                )
                            }
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO109Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-F01/ship> ] .

