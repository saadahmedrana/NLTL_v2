@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-F02/ship> ;
            sh:resultMessage "For an applicable ship, at least one cargo-tank outer-shell separation value is required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an applicable ship, at least one cargo-tank outer-shell separation value is required." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                $this nltl:shipType ?shipType .
                $this nltl:constructionDate ?constructionDate .
                $this nltl:cargoTankCarriesOil ?carriesOil .

                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )
                FILTER ( ?constructionDate >= "2017-01-01"^^xsd:date )
                FILTER ( ?carriesOil = true )
                FILTER NOT EXISTS {
                    $this nltl:shipType ?excludedShipType .
                    FILTER ( STR(?excludedShipType) = "oil_tanker" )
                }
                FILTER NOT EXISTS {
                    $this a nltl:oilTanker .
                }
                FILTER NOT EXISTS {
                    $this nltl:cargoTankOuterShellSeparation ?separation
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-109-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-F02/ship> ] .

