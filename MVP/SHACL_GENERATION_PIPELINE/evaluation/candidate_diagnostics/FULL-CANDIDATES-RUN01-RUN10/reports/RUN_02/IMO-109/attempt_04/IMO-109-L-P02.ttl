@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-P02/ship> ;
            sh:resultMessage "Each cargo-tank outer-shell separation for an applicable ship must be a QuantityValue in metres with a decimal value of at least 0.76." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each cargo-tank outer-shell separation for an applicable ship must be a QuantityValue in metres with a decimal value of at least 0.76." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                $this nltl:shipType ?shipType .
                $this nltl:constructionDate ?constructionDate .
                $this nltl:cargoTankCarriesOil ?carriesOil .
                $this nltl:cargoTankOuterShellSeparation ?separation .

                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )
                FILTER ( ?constructionDate >= "2017-01-01"^^xsd:date )
                FILTER ( ?carriesOil = true )
                FILTER NOT EXISTS {
                    $this nltl:shipType ?excludedShipType .
                    FILTER ( STR(?excludedShipType) = "oil_tanker" )
                }
                FILTER NOT EXISTS {
                    $this a nltl:oilTanker .
                }

                FILTER (
                    NOT EXISTS {
                        ?separation a qudt:QuantityValue
                    }
                    ||
                    NOT EXISTS {
                        ?separation qudt:numericValue ?numericValue .
                        FILTER ( datatype(?numericValue) = xsd:decimal )
                    }
                    ||
                    NOT EXISTS {
                        ?separation qudt:unit unit:M
                    }
                    ||
                    EXISTS {
                        ?separation qudt:numericValue ?numericValue2 .
                        FILTER (
                            datatype(?numericValue2) = xsd:decimal &&
                            ?numericValue2 < "0.76"^^xsd:decimal
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-109-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-P02/ship> ] .

