@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-115-M-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Comminuted and disinfected sewage must be recorded as true.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:comminutedAndDisinfected ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"MARPOL Annex IV regulation 11.1.1 compliance is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus ], [ sh:datatype xsd:string ; sh:hasValue Literal(\"comminuted_and_disinfected\", datatype=xsd:string) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Applicable sewage discharge type must be comminuted and disinfected.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sewageDischargeType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A distance from areas exceeding one tenth ice concentration must be recorded.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MI_N ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Distance from the nearest ice shelf or fast ice must exceed 3 nautical miles.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minExclusive Literal(\"3\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MI_N ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:distanceToNearestIceShelfOrFastIce ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The applicable nearby ice concentration must exceed one tenth.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minExclusive Literal(\"0.1\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:nearbyIceConcentration ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The recorded ice concentration associated with the distance must exceed one tenth.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minExclusive Literal(\"0.1\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:iceConcentration ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:comminutedAndDisinfected ], [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:not [ sh:hasValue Literal(\"comminuted_and_disinfected\", datatype=xsd:string) ] ; sh:path nltl:sewageDischargeType ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-115> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-115-M-F03/ship> ] .

