@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-F04/ship> ;
            sh:resultMessage "When sewage is not comminuted or disinfected, the MARPOL compliance, strict distance threshold, nearby ice concentration, and corresponding distance record are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-116-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-F04/ship> ] .

