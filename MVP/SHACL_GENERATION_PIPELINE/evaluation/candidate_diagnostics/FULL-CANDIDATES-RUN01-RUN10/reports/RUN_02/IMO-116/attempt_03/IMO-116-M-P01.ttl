@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-P01/ship> ;
            sh:resultMessage "The sewage discharge applicability evidence and its corresponding static constraints must be consistent." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-116-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-P01/ship> ] .

