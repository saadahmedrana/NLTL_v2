@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F03/ship> ;
            sh:resultMessage "Node Literal(\"true\" = True, datatype=xsd:boolean) must conform to one or more shapes in [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ] , [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Applicable sewage discharge must comply with MARPOL Annex IV regulation 11.1.2.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:marpolAnnexIvRegulation11Point1Point2DischargeComplianceStatus ], [ sh:hasValue nltl:evidenceStateApproved ; sh:message Literal(\"An applicable sewage treatment plant must have approved MARPOL Annex IV certification status.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ], [ sh:hasValue nltl:evidenceStateApproved ; sh:message Literal(\"An applicable sewage treatment plant must have approved status.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sewageTreatmentPlantApprovalStatus ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:dischargeDistanceRecords ; sh:property [ sh:message Literal(\"The applicable discharge-distance record must record distance to an area with ice concentration greater than one tenth.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MI_N> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ], [ sh:message Literal(\"The applicable discharge-distance record must record distance to the nearest land, ice shelf, or fast ice.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MI_N> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:distanceToNearestLandIceShelfOrFastIce ] ] ; sh:path nltl:hasDischargeDistanceRecord ] ]" ;
            sh:resultPath nltl:sewageDischargeUsesTreatmentPlant ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:hasValue false ] [ sh:hasValue true ;
                                sh:property [ sh:datatype xsd:boolean ;
                                        sh:hasValue true ;
                                        sh:message "Applicable sewage discharge must comply with MARPOL Annex IV regulation 11.1.2." ;
                                        sh:minCount 1 ;
                                        sh:path nltl:marpolAnnexIvRegulation11Point1Point2DischargeComplianceStatus ],
                                    [ sh:hasValue nltl:evidenceStateApproved ;
                                        sh:message "An applicable sewage treatment plant must have approved MARPOL Annex IV certification status." ;
                                        sh:minCount 1 ;
                                        sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ],
                                    [ sh:minCount 1 ;
                                        sh:node [ sh:class nltl:dischargeDistanceRecords ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:hasDischargeDistanceRecord ],
                                    [ sh:hasValue nltl:evidenceStateApproved ;
                                        sh:message "An applicable sewage treatment plant must have approved status." ;
                                        sh:minCount 1 ;
                                        sh:path nltl:sewageTreatmentPlantApprovalStatus ] ] ) ;
                    sh:path nltl:sewageDischargeUsesTreatmentPlant ] ;
            sh:value true ] .

