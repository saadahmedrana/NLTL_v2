ean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Sewage discharge is permitted only when compliance with paragraph 4.2.1.3 is recorded.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sewageDischargeToSea ] ] ) ; sh:property [ sh:datatype xsd:date ; sh:minInclusive Literal(\"2017-01-01\", datatype=xsd:date) ; sh:path nltl:constructionDate ], [ sh:hasValue nltl:passengerShip ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path rdf:type ] ]" ;
            sh:resultSeverity sh:Violation ;
