@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F01/ship> ;
            sh:resultMessage "Category A or B ships operating above 1/10 ice concentration for an extended period with sewage discharge must use an approved sewage treatment plant and have Administration discharge approval." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Category A or B ships operating above 1/10 ice concentration for an extended period with sewage discharge must use an approved sewage treatment plant and have Administration discharge approval." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:shipCategory ?category .
    $this nltl:iceConcentration ?iceQuantity .
    ?iceQuantity qudt:numericValue ?iceValue .
    $this nltl:extendedPeriodOperation ?extended .
    $this nltl:sewageDischargeOccurs ?discharge .
    FILTER (?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))
    FILTER (?iceValue > 1)
    FILTER (?extended = true)
    FILTER (?discharge = true)
    FILTER (
        NOT EXISTS {
            $this nltl:approvedSewageTreatmentPlantUsed true
        }
        ||
        NOT EXISTS {
            $this nltl:administrationDischargeApprovalStatus nltl:evidenceStateApproved
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-119> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F01/ship> ;
            sh:resultMessage "Node ex:ship->nltl:approvedSewageTreatmentPlantUsed does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:approvedSewageTreatmentPlantUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:approvedSewageTreatmentPlantUsed ] ] .

