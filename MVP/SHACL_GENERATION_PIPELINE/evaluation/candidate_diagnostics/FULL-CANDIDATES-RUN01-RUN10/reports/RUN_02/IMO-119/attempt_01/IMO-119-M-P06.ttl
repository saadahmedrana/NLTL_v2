@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-P06/ship> ;
            sh:resultMessage "Node ex:ship->nltl:approvedSewageTreatmentPlantUsed does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:approvedSewageTreatmentPlantUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:approvedSewageTreatmentPlantUsed ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-P06/ship> ;
            sh:resultMessage "Node ex:ship->nltl:administrationDischargeApprovalStatus does not contain a value in the set: ['nltl:evidenceStateApproved']" ;
            sh:resultPath nltl:administrationDischargeApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:evidenceStateApproved ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:administrationDischargeApprovalStatus ] ] .

