@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F02/ship> ;
            sh:resultMessage "For an applicable Category A or B ship operating in ice concentration greater than 1/10 for an extended period with sewage discharge, an approved sewage treatment plant, approved MARPOL Annex IV certification status, and approved Administration discharge status are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an applicable Category A or B ship operating in ice concentration greater than 1/10 for an extended period with sewage discharge, an approved sewage treatment plant, approved MARPOL Annex IV certification status, and approved Administration discharge status are required." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                $this nltl:iceConcentration ?ice .
                ?ice qudt:numericValue ?iceValue .
                ?ice qudt:unit unit:UNITLESS .
                $this nltl:extendedPeriodOperation ?extended .
                $this nltl:sewageDischargeOccurs ?discharge .
                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )
                FILTER (?iceValue > "1"^^xsd:decimal)
                FILTER (?extended = true)
                FILTER (?discharge = true)
                FILTER NOT EXISTS {
                    $this nltl:approvedSewageTreatmentPlantUsed true ;
                          nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus nltl:evidenceStateApproved ;
                          nltl:administrationDischargeApprovalStatus nltl:evidenceStateApproved .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_119_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F02/ship> ] .

