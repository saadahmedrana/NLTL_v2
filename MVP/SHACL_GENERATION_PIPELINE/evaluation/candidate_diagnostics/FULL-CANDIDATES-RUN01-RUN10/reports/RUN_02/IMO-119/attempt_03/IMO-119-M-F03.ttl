@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F03/ship> ;
            sh:resultMessage "For a Category A or B ship operating for an extended period in ice concentration greater than 1/10 while sewage discharge occurs, an approved sewage treatment plant and approved MARPOL certification and administration approval are required, with no conflicting outcome values." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a Category A or B ship operating for an extended period in ice concentration greater than 1/10 while sewage discharge occurs, an approved sewage treatment plant and approved MARPOL certification and administration approval are required, with no conflicting outcome values." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                FILTER (
                    ?category = nltl:polarShipCategoryA ||
                    ?category = nltl:polarShipCategoryB
                )

                $this nltl:iceConcentration ?iceQuantity .
                ?iceQuantity qudt:numericValue ?iceValue .
                ?iceQuantity qudt:unit unit:UNITLESS .
                FILTER ( ?iceValue > "1"^^xsd:decimal )

                $this nltl:extendedPeriodOperation true .
                $this nltl:sewageDischargeOccurs true .

                FILTER (
                    NOT EXISTS {
                        $this nltl:approvedSewageTreatmentPlantUsed true
                    }
                    ||
                    EXISTS {
                        $this nltl:approvedSewageTreatmentPlantUsed ?plantValue .
                        FILTER ( ?plantValue != true )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus nltl:evidenceStateApproved
                    }
                    ||
                    EXISTS {
                        $this nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ?annexStatus .
                        FILTER ( ?annexStatus != nltl:evidenceStateApproved )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:marpolCertificationStatus nltl:evidenceStateApproved
                    }
                    ||
                    EXISTS {
                        $this nltl:marpolCertificationStatus ?marpolStatus .
                        FILTER ( ?marpolStatus != nltl:evidenceStateApproved )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:administrationDischargeApprovalStatus nltl:evidenceStateApproved
                    }
                    ||
                    EXISTS {
                        $this nltl:administrationDischargeApprovalStatus ?approvalStatus .
                        FILTER ( ?approvalStatus != nltl:evidenceStateApproved )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-119> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F03/ship> ] .

