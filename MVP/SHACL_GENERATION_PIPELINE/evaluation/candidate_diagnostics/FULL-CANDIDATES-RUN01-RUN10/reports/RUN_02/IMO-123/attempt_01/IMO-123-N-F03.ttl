@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:hasDischargeDistanceRecord ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"Cargo residues, cleaning agents, or additives must not include substances harmful to the marine environment.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:harmfulSubstancePresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"No adequate reception facilities may be available at the applicable ports.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:adequateReceptionFacilitiesAvailable ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Cargo residues must not be recoverable by commonly available methods.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:residueNotRecoverableByCommonMethods ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The departure and destination ports must both be within Arctic waters.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:departureAndDestinationWithinArctic ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The route must remain within Arctic waters.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:routeRemainsWithinArctic ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The ship must be en route.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipEnRoute ], [ sh:message Literal(\"Each cargo-residue discharge must have a discharge-distance record.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:IMO_123_DischargeDistanceRecordShape ; sh:path nltl:hasDischargeDistanceRecord ], [ sh:message Literal(\"The applicable ice concentration must exceed one tenth.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:IMO_123_IceConcentrationQuantityShape ; sh:path nltl:nearbyIceConcentration ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_123_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F03/ship> ] .

