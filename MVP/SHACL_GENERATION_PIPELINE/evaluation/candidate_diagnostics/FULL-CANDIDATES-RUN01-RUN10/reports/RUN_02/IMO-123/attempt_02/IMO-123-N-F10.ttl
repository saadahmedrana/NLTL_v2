@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ;
                    sh:resultMessage "The discharge must be at least 12 nautical miles from the nearest land, ice shelf, or fast ice." ;
                    sh:resultPath nltl:distanceToNearestLandIceShelfOrFastIce ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The discharge must be at least 12 nautical miles from the nearest land, ice shelf, or fast ice." ;
                            sh:minCount 1 ;
                            sh:node gen:NearestIceDistanceShape ;
                            sh:path nltl:distanceToNearestLandIceShelfOrFastIce ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ;
                    sh:resultMessage "Each discharge-distance record must record the distance from an area with ice concentration greater than one tenth." ;
                    sh:resultPath nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each discharge-distance record must record the distance from an area with ice concentration greater than one tenth." ;
                            sh:minCount 1 ;
                            sh:node gen:IceConcentrationDistanceShape ;
                            sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/ship> ;
            sh:resultMessage "Each permitted discharge must have a linked discharge-distance record." ;
            sh:resultPath nltl:hasDischargeDistanceRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each permitted discharge must have a linked discharge-distance record." ;
                    sh:minCount 1 ;
                    sh:node gen:DischargeDistanceRecordShape ;
                    sh:path nltl:hasDischargeDistanceRecord ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ] .

