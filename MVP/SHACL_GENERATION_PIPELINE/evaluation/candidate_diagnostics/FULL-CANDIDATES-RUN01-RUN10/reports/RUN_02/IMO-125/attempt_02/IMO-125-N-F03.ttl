@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F03/ship> ;
            sh:resultMessage "When the ship operates in polar waters, polar-operation coverage must be present in the Garbage Record Book, Garbage Management Plan, and garbage placards." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the ship operates in polar waters, polar-operation coverage must be present in the Garbage Record Book, Garbage Management Plan, and garbage placards." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>

SELECT $this
WHERE {
    $this nltl:shipOperatesInPolarWaters ?operatesInPolarWaters .
    FILTER (?operatesInPolarWaters = true)
    FILTER (
        NOT EXISTS {
            $this nltl:garbageRecordBookPolarCoverage ?recordBookCoverage .
            FILTER (?recordBookCoverage = true)
        }
        ||
        NOT EXISTS {
            $this nltl:garbageManagementPlanPolarCoverage ?managementPlanCoverage .
            FILTER (?managementPlanCoverage = true)
        }
        ||
        NOT EXISTS {
            $this nltl:garbagePlacardPolarCoverage ?placardCoverage .
            FILTER (?placardCoverage = true)
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-125> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F03/ship> ] .

