@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P01/ship> ;
            sh:resultMessage "The ship shall satisfy one Chapter 9-1 applicability branch: fishing vessel with length overall of at least 24 m; pleasure yacht of at least 300 gross tonnage not engaged in trade; or cargo ship of at least 300 and below 500 gross tonnage." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ship shall satisfy one Chapter 9-1 applicability branch: fishing vessel with length overall of at least 24 m; pleasure yacht of at least 300 gross tonnage not engaged in trade; or cargo ship of at least 300 and below 500 gross tonnage." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:shipType ?shipType .
  FILTER (
    (
      STR(?shipType) = "fishing_vessel"
      &&
      EXISTS {
        $this nltl:lengthOverall ?lengthQuantity .
        ?lengthQuantity qudt:numericValue ?lengthValue .
        ?lengthQuantity qudt:unit <http://qudt.org/vocab/unit/M> .
        FILTER (
          datatype(?lengthValue) = xsd:decimal &&
          ?lengthValue >= 24
        )
      }
    )
    ||
    (
      STR(?shipType) = "pleasure_yacht"
      &&
      EXISTS {
        $this nltl:grossTonnage ?tonnageQuantity .
        ?tonnageQuantity qudt:numericValue ?tonnageValue .
        ?tonnageQuantity qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
        FILTER (
          datatype(?tonnageValue) = xsd:decimal &&
          ?tonnageValue >= 300
        )
      }
      &&
      EXISTS {
        $this nltl:engagedInTrade ?tradeValue .
        FILTER (
          datatype(?tradeValue) = xsd:boolean &&
          ?tradeValue = false
        )
      }
    )
    ||
    (
      STR(?shipType) = "cargo_ship"
      &&
      EXISTS {
        $this nltl:grossTonnage ?tonnageQuantity .
        ?tonnageQuantity qudt:numericValue ?tonnageValue .
        ?tonnageQuantity qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
        FILTER (
          datatype(?tonnageValue) = xsd:decimal &&
          ?tonnageValue >= 300 &&
          ?tonnageValue < 500
        )
      }
    )
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO26_002_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P01/ship> ] .

