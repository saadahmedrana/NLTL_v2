@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P02/ship> ;
            sh:resultMessage "Chapter 9-1 applicability shall be recorded as true for a ship within the stated scope." ;
            sh:resultPath nltl:polarCodeChapter9Dash1Applicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:message "Chapter 9-1 applicability shall be recorded as true for a ship within the stated scope." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarCodeChapter9Dash1Applicable ] ] .

