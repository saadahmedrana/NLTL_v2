@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-007-A-F02/ship> ;
            sh:resultMessage "For ice-strengthened ships constructed on or after 1 January 2026, the required depth-sounding equipment alternative or approved equivalent must be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-007-A-F02/ship> ] .

