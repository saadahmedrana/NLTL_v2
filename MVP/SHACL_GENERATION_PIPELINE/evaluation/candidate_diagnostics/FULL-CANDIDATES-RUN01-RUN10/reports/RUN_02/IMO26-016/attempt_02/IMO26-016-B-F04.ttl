@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F04/grossTonnageValue> ;
                    sh:resultMessage "Node ex:grossTonnageValue->qudt:unit does not contain a value in the set: ['qudt:UNITLESS']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:grossTonnage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:grossTonnage ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F04/grossTonnageValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F04/lengthOverallValue> ;
                    sh:resultMessage "Node ex:lengthOverallValue->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:lengthOverall ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:lengthOverall ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F04/lengthOverallValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F04/ship> ;
            sh:resultMessage "For a ship operating in polar waters, chapter 11-1 applicability must be true and one permitted ship-type and threshold alternative must hold." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a ship operating in polar waters, chapter 11-1 applicability must be true and one permitted ship-type and threshold alternative must hold." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters ?operates .
                FILTER (
                    datatype(?operates) = xsd:boolean &&
                    ?operates = true
                )

                {
                    FILTER NOT EXISTS {
                        $this nltl:polarCodeChapter11Dash1Applicable "true"^^xsd:boolean .
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        {
                            $this nltl:shipType ?fishingType .
                            FILTER (
                                datatype(?fishingType) = xsd:string &&
                                ?fishingType = "fishing_vessel"
                            )
                            $this nltl:lengthOverall ?lengthQuantity .
                            ?lengthQuantity qudt:numericValue ?lengthValue .
                            ?lengthQuantity qudt:unit qudt:M .
                            FILTER (
                                datatype(?lengthValue) = xsd:decimal &&
                                ?lengthValue >= 24
                            )
                        }
                        UNION
                        {
                            $this nltl:shipType ?yachtType .
                            FILTER (
                                datatype(?yachtType) = xsd:string &&
                                ?yachtType = "pleasure_yacht"
                            )
                            $this nltl:grossTonnage ?yachtTonnageQuantity .
                            ?yachtTonnageQuantity qudt:numericValue ?yachtTonnage .
                            ?yachtTonnageQuantity qudt:unit qudt:UNITLESS .
                            FILTER (
                                datatype(?yachtTonnage) = xsd:decimal &&
                                ?yachtTonnage >= 300
                            )
                            $this nltl:engagedInTrade "false"^^xsd:boolean .
                        }
                        UNION
                        {
                            $this nltl:shipType ?cargoType .
                            FILTER (
                                datatype(?cargoType) = xsd:string &&
                                ?cargoType = "cargo_ship"
                            )
                            $this nltl:grossTonnage ?cargoTonnageQuantity .
                            ?cargoTonnageQuantity qudt:numericValue ?cargoTonnage .
                            ?cargoTonnageQuantity qudt:unit qudt:UNITLESS .
                            FILTER (
                                datatype(?cargoTonnage) = xsd:decimal &&
                                ?cargoTonnage >= 300 &&
                                ?cargoTonnage < 500
                            )
                        }
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO26_016_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F04/ship> ] .

