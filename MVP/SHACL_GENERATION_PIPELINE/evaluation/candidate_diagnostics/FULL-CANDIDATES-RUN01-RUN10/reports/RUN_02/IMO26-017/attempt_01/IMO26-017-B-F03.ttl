@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-017-B-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"An applicable ship must have a voyage plan.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:voyagePlanPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Chapter 11-1 applicability must be recorded as true for this branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarCodeChapter11Dash1Applicable ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The voyage plan must cover every intended voyage hazard.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:voyagePlanCoverage ], [ sh:datatype xsd:string ; sh:message Literal(\"An applicable ship must record its intended voyage hazards.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:intendedVoyageHazard ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarCodeChapter11Dash1Applicable ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltl:IMO26_017_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-017-B-F03/ship> ] .

