@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F01/ship> ;
            sh:resultMessage "Ships with a construction stage on or after 1 September 2003 and a construction contract before 1 January 2010 shall identify the 2002 Ice Class Regulations." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ships with a construction stage on or after 1 September 2003 and a construction contract before 1 January 2010 shall identify the 2002 Ice Class Regulations." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?stage ;
                      nltl:constructionContractDate ?contract .
                FILTER (
                    ?stage >= "2003-09-01"^^xsd:date &&
                    ?contract < "2010-01-01"^^xsd:date
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRegulationEdition2002 .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF005Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F01/ship> ] .

