@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxExclusive Literal(\"1986-11-01\", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ] , [ sh:property [ sh:minInclusive Literal(\"2003-09-01\", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ] , [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:ownerRequested2008EngineOutputRequirements ], [ sh:hasValue nltl:iceClassRegulationEdition2008 ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When the owner requests the 2008 engine-output requirements, the engine-output regulation edition must be the 2008 Ice Class Regulations.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:engineOutputRegulationEdition ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:ownerRequested2008EngineOutputRequirements ], [ sh:hasValue nltl:iceClassRuleEdition1985 ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Without an owner request for the 2008 engine-output requirements, the engine-output regulation edition must remain the 1985 Ice Class Rules.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:engineOutputRegulationEdition ] ] ) ; sh:property [ sh:hasValue nltl:iceClassRuleEdition1985 ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Ships in the stated construction-stage cohort must identify the 1985 Ice Class Rules as the applicable ice-class regulation edition.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:applicableIceClassRegulationEdition ], [ sh:maxExclusive Literal(\"2003-09-01\", datatype=xsd:date) ; sh:minInclusive Literal(\"1986-11-01\", datatype=xsd:date) ; sh:path nltl:constructionStageDate ], [ sh:message Literal(\"An ice class is required for ships in the stated construction-stage cohort.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF006Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F01/ship> ] .

