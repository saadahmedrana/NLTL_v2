@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P02/ship> ;
            sh:resultMessage "An applicable IA or IA Super ship must have the required delivery date, assessment date, permitted compliance method, and deadline assessment." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "An applicable IA or IA Super ship must have the required delivery date, assessment date, permitted compliance method, and deadline assessment." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:constructionStageDate ?stage .

                FILTER (?ice IN (
                    nltl:iceClassIa,
                    nltl:iceClassIaSuper
                ))

                FILTER (?stage < "2003-09-01"^^xsd:date)

                FILTER (
                    NOT EXISTS {
                        $this nltl:deliveryDate ?delivery .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:assessmentDate ?assessment .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:engineOutputComplianceMethod ?method .
                        FILTER (?method IN (
                            nltl:traficom2017Section3Point2Point2Method,
                            nltl:traficom2017Section3Point2Point4Method
                        ))
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:deliveryDate ?delivery ;
                              nltl:assessmentDate ?assessment .
                        FILTER (
                            YEAR(?assessment) = YEAR(?delivery) + 20
                            &&
                            MONTH(?assessment) = 1
                            &&
                            DAY(?assessment) = 1
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF007ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P02/ship> ] .

