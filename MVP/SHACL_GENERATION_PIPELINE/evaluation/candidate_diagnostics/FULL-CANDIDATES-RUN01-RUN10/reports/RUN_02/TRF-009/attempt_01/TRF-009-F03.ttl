@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F03/ship> ;
            sh:resultMessage "The delivery date is required to determine the compliance deadline." ;
            sh:resultPath nltl:deliveryDate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:date ;
                    sh:maxCount 1 ;
                    sh:message "The delivery date is required to determine the compliance deadline." ;
                    sh:minCount 1 ;
                    sh:path nltl:deliveryDate ] ] .

