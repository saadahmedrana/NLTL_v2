@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-P03/ship> ;
            sh:resultMessage "The upper ice waterline must match, in both directions, the maximum vertical coordinate of intended ice-operating waterlines at each longitudinal position; derived decimal comparisons use a relative tolerance of 1e-6 with a 1e-6 metre absolute fallback near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The upper ice waterline must match, in both directions, the maximum vertical coordinate of intended ice-operating waterlines at each longitudinal position; derived decimal comparisons use a relative tolerance of 1e-6 with a 1e-6 metre absolute fallback near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    SELECT $this ?x
                           (MAX(?expectedY) AS ?expectedMax)
                           (MIN(?uiwlY) AS ?uiwlMin)
                           (MAX(?uiwlY) AS ?uiwlMax)
                    WHERE {
                        {
                            $this nltl:hasIntendedIceOperatingWaterline ?intended .
                            ?intended nltl:hasWaterlineProfilePoint ?intendedPoint .
                            ?intendedPoint nltl:longitudinalPosition ?intendedX .
                            ?intendedPoint nltl:verticalCoordinate ?intendedVertical .
                            ?intendedVertical qudt:numericValue ?expectedY .
                            BIND(?intendedX AS ?x)
                        }
                        UNION
                        {
                            $this nltl:hasUpperIceWaterline ?uiwl .
                            ?uiwl nltl:hasWaterlineProfilePoint ?uiwlPoint .
                            ?uiwlPoint nltl:longitudinalPosition ?uiwlX .
                            ?uiwlPoint nltl:verticalCoordinate ?uiwlVertical .
                            ?uiwlVertical qudt:numericValue ?uiwlY .
                            BIND(?uiwlX AS ?x)
                        }
                    }
                    GROUP BY $this ?x
                }
                FILTER(
                    !BOUND(?expectedMax) ||
                    !BOUND(?uiwlMin) ||
                    !BOUND(?uiwlMax) ||
                    ABS(?uiwlMin - ?expectedMax) >
                        IF(
                            ABS(?expectedMax) > 0.000001,
                            ABS(?expectedMax) * 0.000001,
                            0.000001
                        ) ||
                    ABS(?uiwlMax - ?expectedMax) >
                        IF(
                            ABS(?expectedMax) > 0.000001,
                            ABS(?expectedMax) * 0.000001,
                            0.000001
                        )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_011_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-P03/ship> ] .

