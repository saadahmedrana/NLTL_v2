@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasUpperIceWaterline" ;
            sh:resultPath nltl:hasUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:minCount 1 ;
                    sh:node gen:TRF_011_IceWaterlineShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasUpperIceWaterline ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/ship> ;
            sh:resultMessage "The UIWL ordinates shall equal the maximum intended ice-operating waterline ordinate at every longitudinal position." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The UIWL ordinates shall equal the maximum intended ice-operating waterline ordinate at every longitudinal position." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this ?x ?expectedMax ?actualMin ?actualMax
WHERE {
  {
    SELECT $this ?x
           (MAX(?expectedY) AS ?expectedMax)
           (MIN(?actualY) AS ?actualMin)
           (MAX(?actualY) AS ?actualMax)
    WHERE {
      {
        $this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
        ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
        ?intendedPoint nltl:longitudinalPosition ?intendedLongitudinal .
        ?intendedLongitudinal qudt:numericValue ?x ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .
        ?intendedPoint nltl:verticalCoordinate ?intendedVertical .
        ?intendedVertical qudt:numericValue ?expectedY ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
      }
      UNION
      {
        $this nltl:hasUpperIceWaterline ?upperWaterline .
        ?upperWaterline nltl:hasWaterlineProfilePoint ?upperPoint .
        ?upperPoint nltl:longitudinalPosition ?upperLongitudinal .
        ?upperLongitudinal qudt:numericValue ?x ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .
        ?upperPoint nltl:verticalCoordinate ?upperVertical .
        ?upperVertical qudt:numericValue ?actualY ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
      }
    }
    GROUP BY $this ?x
  }
  FILTER (
    !BOUND(?expectedMax) ||
    !BOUND(?actualMin) ||
    !BOUND(?actualMax) ||
    ABS(?actualMin - ?expectedMax) >
      (0.000001 * ABS(?expectedMax) + 0.000000001) ||
    ABS(?actualMax - ?expectedMax) >
      (0.000001 * ABS(?expectedMax) + 0.000000001)
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_011_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/ship> ] .

