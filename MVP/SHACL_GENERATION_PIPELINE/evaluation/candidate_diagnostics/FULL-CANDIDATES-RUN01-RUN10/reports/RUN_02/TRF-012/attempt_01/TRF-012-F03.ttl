@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F03/lx> ;
                                    sh:resultMessage "Each waterline coordinate quantity must use metres." ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:ncb0886cf588a4d87a995ab33bab9a774b7 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F03/lowerPoint> ;
                            sh:resultMessage "Each waterline profile point must carry a longitudinal position." ;
                            sh:resultPath nltl:longitudinalPosition ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:message "Each waterline profile point must carry a longitudinal position." ;
                                    sh:minCount 1 ;
                                    sh:node gen:TRF012LengthQuantityShape ;
                                    sh:path nltl:longitudinalPosition ] ;
                            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F03/lx> ],
                        [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F03/lz> ;
                                    sh:resultMessage "Each waterline coordinate quantity must use metres." ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:ncb0886cf588a4d87a995ab33bab9a774b7 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F03/lowerPoint> ;
                            sh:resultMessage "Each waterline profile point must carry a vertical coordinate." ;
                            sh:resultPath nltl:verticalCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:message "Each waterline profile point must carry a vertical coordinate." ;
                                    sh:minCount 1 ;
                                    sh:node gen:TRF012LengthQuantityShape ;
                                    sh:path nltl:verticalCoordinate ] ;
                            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F03/lz> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F03/lowerIceWaterline> ;
                    sh:resultMessage "Each represented ice waterline must contain at least one profile point." ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:ncb0886cf588a4d87a995ab33bab9a774b3 ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F03/lowerPoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F03/ship> ;
            sh:resultMessage "The externally determined lower ice waterline must be represented with required profile points." ;
            sh:resultPath nltl:hasLowerIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:message "The externally determined lower ice waterline must be represented with required profile points." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF012IceWaterlineShape ;
                    sh:path nltl:hasLowerIceWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F03/lowerIceWaterline> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F03/intendedLine> ;
                    sh:resultMessage "Each represented ice waterline must contain at least one profile point." ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:ncb0886cf588a4d87a995ab33bab9a774b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F03/ship> ;
            sh:resultMessage "The ship must represent at least one intended ice-operating waterline with required profile points." ;
            sh:resultPath nltl:hasIntendedIceOperatingWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:message "The ship must represent at least one intended ice-operating waterline with required profile points." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF012IceWaterlineShape ;
                    sh:path nltl:hasIntendedIceOperatingWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F03/intendedLine> ] .

_:ncb0886cf588a4d87a995ab33bab9a774b3 sh:class nltl:waterlineProfilePoint ;
    sh:message "Each represented ice waterline must contain at least one profile point." ;
    sh:minCount 1 ;
    sh:node gen:TRF012ProfilePointShape ;
    sh:path nltl:hasWaterlineProfilePoint .

_:ncb0886cf588a4d87a995ab33bab9a774b7 sh:hasValue qudt:M ;
    sh:maxCount 1 ;
    sh:message "Each waterline coordinate quantity must use metres." ;
    sh:minCount 1 ;
    sh:path qudt:unit .

