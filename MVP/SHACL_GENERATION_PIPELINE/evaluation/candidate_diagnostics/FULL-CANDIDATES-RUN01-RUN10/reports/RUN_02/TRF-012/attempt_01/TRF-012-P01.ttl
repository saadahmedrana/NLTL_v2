@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/iz> ;
                                    sh:resultMessage "Each waterline coordinate quantity must use metres." ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:ncb0886cf588a4d87a995ab33bab9a774b7 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/intendedPoint> ;
                            sh:resultMessage "Each waterline profile point must carry a vertical coordinate." ;
                            sh:resultPath nltl:verticalCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape _:ncb0886cf588a4d87a995ab33bab9a774b5 ;
                            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/iz> ],
                        [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/ix> ;
                                    sh:resultMessage "Each waterline coordinate quantity must use metres." ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:ncb0886cf588a4d87a995ab33bab9a774b7 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/intendedPoint> ;
                            sh:resultMessage "Each waterline profile point must carry a longitudinal position." ;
                            sh:resultPath nltl:longitudinalPosition ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape _:ncb0886cf588a4d87a995ab33bab9a774b4 ;
                            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/ix> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/intendedLine> ;
                    sh:resultMessage "Each represented ice waterline must contain at least one profile point." ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:ncb0886cf588a4d87a995ab33bab9a774b3 ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/intendedPoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/ship> ;
            sh:resultMessage "The ship must represent at least one intended ice-operating waterline with required profile points." ;
            sh:resultPath nltl:hasIntendedIceOperatingWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:message "The ship must represent at least one intended ice-operating waterline with required profile points." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF012IceWaterlineShape ;
                    sh:path nltl:hasIntendedIceOperatingWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/intendedLine> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/lz> ;
                                    sh:resultMessage "Each waterline coordinate quantity must use metres." ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:ncb0886cf588a4d87a995ab33bab9a774b7 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/lowerPoint> ;
                            sh:resultMessage "Each waterline profile point must carry a vertical coordinate." ;
                            sh:resultPath nltl:verticalCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape _:ncb0886cf588a4d87a995ab33bab9a774b5 ;
                            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/lz> ],
                        [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/lx> ;
                                    sh:resultMessage "Each waterline coordinate quantity must use metres." ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:ncb0886cf588a4d87a995ab33bab9a774b7 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/lowerPoint> ;
                            sh:resultMessage "Each waterline profile point must carry a longitudinal position." ;
                            sh:resultPath nltl:longitudinalPosition ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape _:ncb0886cf588a4d87a995ab33bab9a774b4 ;
                            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/lx> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/lowerIceWaterline> ;
                    sh:resultMessage "Each represented ice waterline must contain at least one profile point." ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:ncb0886cf588a4d87a995ab33bab9a774b3 ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/lowerPoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/ship> ;
            sh:resultMessage "The externally determined lower ice waterline must be represented with required profile points." ;
            sh:resultPath nltl:hasLowerIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:message "The externally determined lower ice waterline must be represented with required profile points." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF012IceWaterlineShape ;
                    sh:path nltl:hasLowerIceWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-P01/lowerIceWaterline> ] .

_:ncb0886cf588a4d87a995ab33bab9a774b3 sh:class nltl:waterlineProfilePoint ;
    sh:message "Each represented ice waterline must contain at least one profile point." ;
    sh:minCount 1 ;
    sh:node gen:TRF012ProfilePointShape ;
    sh:path nltl:hasWaterlineProfilePoint .

_:ncb0886cf588a4d87a995ab33bab9a774b4 sh:message "Each waterline profile point must carry a longitudinal position." ;
    sh:minCount 1 ;
    sh:node gen:TRF012LengthQuantityShape ;
    sh:path nltl:longitudinalPosition .

_:ncb0886cf588a4d87a995ab33bab9a774b5 sh:message "Each waterline profile point must carry a vertical coordinate." ;
    sh:minCount 1 ;
    sh:node gen:TRF012LengthQuantityShape ;
    sh:path nltl:verticalCoordinate .

_:ncb0886cf588a4d87a995ab33bab9a774b7 sh:hasValue qudt:M ;
    sh:maxCount 1 ;
    sh:message "Each waterline coordinate quantity must use metres." ;
    sh:minCount 1 ;
    sh:path qudt:unit .

