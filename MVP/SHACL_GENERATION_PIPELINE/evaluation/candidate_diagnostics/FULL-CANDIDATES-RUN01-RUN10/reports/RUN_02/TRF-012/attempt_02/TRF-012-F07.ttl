@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F07/lz> ;
                                    sh:resultMessage "The quantity must use metres as its unit." ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:n7c0f5bea1702460699ccb6772167e02db6 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F07/lowerPoint> ;
                            sh:resultMessage "Each waterline profile point must have one vertical coordinate in metres." ;
                            sh:resultPath nltl:verticalCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each waterline profile point must have one vertical coordinate in metres." ;
                                    sh:minCount 1 ;
                                    sh:node gs:TRF012LengthQuantityShape ;
                                    sh:path nltl:verticalCoordinate ] ;
                            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F07/lz> ],
                        [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F07/lx> ;
                                    sh:resultMessage "The quantity must use metres as its unit." ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:n7c0f5bea1702460699ccb6772167e02db6 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F07/lowerPoint> ;
                            sh:resultMessage "Each waterline profile point must have one longitudinal position in metres." ;
                            sh:resultPath nltl:longitudinalPosition ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each waterline profile point must have one longitudinal position in metres." ;
                                    sh:minCount 1 ;
                                    sh:node gs:TRF012LengthQuantityShape ;
                                    sh:path nltl:longitudinalPosition ] ;
                            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F07/lx> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F07/lowerIceWaterline> ;
                    sh:resultMessage "The ice waterline must be represented by profile points." ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n7c0f5bea1702460699ccb6772167e02db3 ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F07/lowerPoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F07/ship> ;
            sh:resultMessage "A lower ice waterline with profile points is required." ;
            sh:resultPath nltl:hasLowerIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A lower ice waterline with profile points is required." ;
                    sh:minCount 1 ;
                    sh:node gs:TRF012IceWaterlineShape ;
                    sh:path nltl:hasLowerIceWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F07/lowerIceWaterline> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F07/intendedLine> ;
                    sh:resultMessage "The ice waterline must be represented by profile points." ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n7c0f5bea1702460699ccb6772167e02db3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F07/ship> ;
            sh:resultMessage "An intended ice-operating waterline with profile points is required." ;
            sh:resultPath nltl:hasIntendedIceOperatingWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "An intended ice-operating waterline with profile points is required." ;
                    sh:minCount 1 ;
                    sh:node gs:TRF012IceWaterlineShape ;
                    sh:path nltl:hasIntendedIceOperatingWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F07/intendedLine> ] .

_:n7c0f5bea1702460699ccb6772167e02db3 sh:message "The ice waterline must be represented by profile points." ;
    sh:minCount 1 ;
    sh:node gs:TRF012ProfilePointShape ;
    sh:path nltl:hasWaterlineProfilePoint .

_:n7c0f5bea1702460699ccb6772167e02db6 sh:hasValue qudt:M ;
    sh:maxCount 1 ;
    sh:message "The quantity must use metres as its unit." ;
    sh:minCount 1 ;
    sh:path qudt:unit .

