@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-F05/ship> ;
            sh:resultMessage "When ice-strengthening is required, the ship must provide the applicable ice class, upper and lower ice waterlines, metre-valued fore and aft operating and ice-class draughts, and satisfy the inclusive fore and aft draught bounds." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When ice-strengthening is required, the ship must provide the applicable ice class, upper and lower ice waterlines, metre-valued fore and aft operating and ice-class draughts, and satisfy the inclusive fore and aft draught bounds." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipIceStrengthened true .

                OPTIONAL {
                    $this nltl:iceClass ?iceClass .
                    ?iceClass a nltl:iceClassValue .
                }

                OPTIONAL {
                    $this nltl:hasUpperIceWaterline ?upperWaterline .
                    ?upperWaterline a nltl:iceWaterline .
                }

                OPTIONAL {
                    $this nltl:hasLowerIceWaterline ?lowerWaterline .
                    ?lowerWaterline a nltl:iceWaterline .
                }

                OPTIONAL {
                    $this nltl:operatingForeDraught ?operatingFore .
                    ?operatingFore a qudt:QuantityValue ;
                        qudt:numericValue ?operatingForeValue ;
                        qudt:unit unit:M .
                    FILTER ( datatype(?operatingForeValue) = xsd:decimal )
                }

                OPTIONAL {
                    $this nltl:operatingAftDraught ?operatingAft .
                    ?operatingAft a qudt:QuantityValue ;
                        qudt:numericValue ?operatingAftValue ;
                        qudt:unit unit:M .
                    FILTER ( datatype(?operatingAftValue) = xsd:decimal )
                }

                OPTIONAL {
                    $this nltl:minimumIceClassDraughtFore ?minimumFore .
                    ?minimumFore a qudt:QuantityValue ;
                        qudt:numericValue ?minimumForeValue ;
                        qudt:unit unit:M .
                    FILTER ( datatype(?minimumForeValue) = xsd:decimal )
                }

                OPTIONAL {
                    $this nltl:maximumIceClassDraughtFore ?maximumFore .
                    ?maximumFore a qudt:QuantityValue ;
                        qudt:numericValue ?maximumForeValue ;
                        qudt:unit unit:M .
                    FILTER ( datatype(?maximumForeValue) = xsd:decimal )
                }

                OPTIONAL {
                    $this nltl:minimumIceClassDraughtAft ?minimumAft .
                    ?minimumAft a qudt:QuantityValue ;
                        qudt:numericValue ?minimumAftValue ;
                        qudt:unit unit:M .
                    FILTER ( datatype(?minimumAftValue) = xsd:decimal )
                }

                OPTIONAL {
                    $this nltl:maximumIceClassDraughtAft ?maximumAft .
                    ?maximumAft a qudt:QuantityValue ;
                        qudt:numericValue ?maximumAftValue ;
                        qudt:unit unit:M .
                    FILTER ( datatype(?maximumAftValue) = xsd:decimal )
                }

                FILTER (
                    !BOUND(?iceClass) ||
                    !BOUND(?upperWaterline) ||
                    !BOUND(?lowerWaterline) ||
                    !BOUND(?operatingForeValue) ||
                    !BOUND(?operatingAftValue) ||
                    !BOUND(?minimumForeValue) ||
                    !BOUND(?maximumForeValue) ||
                    !BOUND(?minimumAftValue) ||
                    !BOUND(?maximumAftValue) ||
                    ?operatingForeValue < ?minimumForeValue ||
                    ?operatingForeValue > ?maximumForeValue ||
                    ?operatingAftValue < ?minimumAftValue ||
                    ?operatingAftValue > ?maximumAftValue
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF013Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-F05/ship> ] .

