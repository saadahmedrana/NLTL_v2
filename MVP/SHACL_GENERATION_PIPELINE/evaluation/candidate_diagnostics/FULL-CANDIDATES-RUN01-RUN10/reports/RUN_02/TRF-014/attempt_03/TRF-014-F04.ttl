@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:retainedOnBoard" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n501f2d4ebebd486a976d65cb7fed0892b39 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "For a pre-2007 ship whose UIWL is below the summer load line, complete marking evidence is required, or a first scheduled dry docking date must be supplied until the assessment date." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a pre-2007 ship whose UIWL is below the summer load line, complete marking evidence is required, or a first scheduled dry docking date must be supplied until the assessment date." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate ;
                      nltl:assessmentDate ?assessmentDate ;
                      nltl:summerLoadLineFreshWaterDraught ?summerQuantity ;
                      nltl:upperIceWaterlineDraught ?uiwlQuantity .
                ?summerQuantity qudt:numericValue ?summerValue .
                ?uiwlQuantity qudt:numericValue ?uiwlValue .
                FILTER (?constructionDate < "2007-07-01"^^xsd:date)
                FILTER (?uiwlValue < ?summerValue)
                FILTER (
                    NOT EXISTS {
                        $this nltl:warningTrianglePresent true ;
                              nltl:iceClassDraughtMarkPresent true ;
                              nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity .
                        ?markQuantity qudt:numericValue ?markValue ;
                                      qudt:unit <http://qudt.org/vocab/unit/M> .
                    }
                    &&
                    (
                        NOT EXISTS {
                            $this nltl:firstScheduledDryDockingDate ?dryDockingDate .
                        }
                        ||
                        EXISTS {
                            $this nltl:firstScheduledDryDockingDate ?dryDockingDate .
                            FILTER (?dryDockingDate <= ?assessmentDate)
                            FILTER NOT EXISTS {
                                $this nltl:warningTrianglePresent true ;
                                      nltl:iceClassDraughtMarkPresent true ;
                                      nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity .
                                ?markQuantity qudt:numericValue ?markValue ;
                                              qudt:unit <http://qudt.org/vocab/unit/M> .
                            }
                        }
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-014-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:readilyAvailableToMaster" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n501f2d4ebebd486a976d65cb7fed0892b38 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Node ex:ship->nltl:readilyAvailableToMaster does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n501f2d4ebebd486a976d65cb7fed0892b38 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Node ex:ship->nltl:retainedOnBoard does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n501f2d4ebebd486a976d65cb7fed0892b39 ] .

_:n501f2d4ebebd486a976d65cb7fed0892b38 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

_:n501f2d4ebebd486a976d65cb7fed0892b39 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

