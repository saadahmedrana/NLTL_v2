@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "The required ice-class marking is missing or does not match the class-certificate maximum amidships draught for the applicable date and draught conditions." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The required ice-class marking is missing or does not match the class-certificate maximum amidships draught for the applicable date and draught conditions." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate ;
                      nltl:assessmentDate ?assessmentDate ;
                      nltl:summerLoadLineFreshWaterDraught ?summerQuantity ;
                      nltl:upperIceWaterlineDraught ?uiwlQuantity .

                ?summerQuantity qudt:numericValue ?summerDraught .
                ?uiwlQuantity qudt:numericValue ?uiwlDraught .

                FILTER (
                    (
                        ?constructionDate >= "2007-07-01"^^xsd:date
                        &&
                        ?summerDraught > ?uiwlDraught
                        &&
                        NOT EXISTS {
                            $this nltl:warningTrianglePresent true ;
                                  nltl:iceClassDraughtMarkPresent true ;
                                  nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity ;
                                  nltl:hasClassCertificate ?certificate .

                            ?markQuantity qudt:numericValue ?markDraught .
                            ?certificate nltl:maximumIceClassDraughtAmidships ?certificateQuantity .
                            ?certificateQuantity qudt:numericValue ?certificateDraught .

                            FILTER ( ?markDraught = ?certificateDraught )
                        }
                    )
                    ||
                    (
                        ?constructionDate < "2007-07-01"^^xsd:date
                        &&
                        ?uiwlDraught < ?summerDraught
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:warningTrianglePresent true ;
                                      nltl:iceClassDraughtMarkPresent true ;
                                      nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity ;
                                      nltl:hasClassCertificate ?certificate .

                                ?markQuantity qudt:numericValue ?markDraught .
                                ?certificate nltl:maximumIceClassDraughtAmidships ?certificateQuantity .
                                ?certificateQuantity qudt:numericValue ?certificateDraught .

                                FILTER ( ?markDraught = ?certificateDraught )
                            }
                            &&
                            (
                                NOT EXISTS {
                                    $this nltl:firstScheduledDryDockingDate ?dryDockingDate
                                }
                                ||
                                (
                                    EXISTS {
                                        $this nltl:firstScheduledDryDockingDate ?dryDockingDate
                                    }
                                    &&
                                    ?dryDockingDate <= ?assessmentDate
                                    &&
                                    NOT EXISTS {
                                        $this nltl:warningTrianglePresent true ;
                                              nltl:iceClassDraughtMarkPresent true ;
                                              nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity ;
                                              nltl:hasClassCertificate ?certificate .

                                        ?markQuantity qudt:numericValue ?markDraught .
                                        ?certificate nltl:maximumIceClassDraughtAmidships ?certificateQuantity .
                                        ?certificateQuantity qudt:numericValue ?certificateDraught .

                                        FILTER ( ?markDraught = ?certificateDraught )
                                    }
                                )
                            )
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF014ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "The ice-draught restriction document must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n02660194e7774f42b4bc250481d1edccb9 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "The ice-draught restriction document must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n02660194e7774f42b4bc250481d1edccb9 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "The ice-draught restriction information must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n02660194e7774f42b4bc250481d1edccb10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "The ice-draught restriction information must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n02660194e7774f42b4bc250481d1edccb10 ] .

_:n02660194e7774f42b4bc250481d1edccb10 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice-draught restriction information must be readily available to the master." ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

_:n02660194e7774f42b4bc250481d1edccb9 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice-draught restriction document must be retained on board." ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

