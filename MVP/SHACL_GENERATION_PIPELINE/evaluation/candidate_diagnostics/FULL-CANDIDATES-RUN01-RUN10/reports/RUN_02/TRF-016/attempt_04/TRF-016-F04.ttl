@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The propeller highest point must be submerged when navigating in ice.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerHighestPointSubmerged ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("navigatingInIce must be true for the ice-navigation branch.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:navigatingInIce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Displacement at the upper ice waterline must be supplied in metric tons.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/TON_Metric> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:displacementAtUpperIceWaterline ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("draughtAmidships must be supplied as a metre quantity.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:draughtAmidships ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("forwardDraught must be supplied as a metre quantity.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:forwardDraught ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("levelIceThickness must be supplied as a metre quantity.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:levelIceThickness ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("liwlDraughtAmidships must be supplied as a metre quantity.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:liwlDraughtAmidships ], [ sh:message Literal("A lower ice waterline is required when navigating in ice.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:iceWaterline ] ; sh:path nltl:hasLowerIceWaterline ], [ sh:message Literal("An upper ice waterline is required when navigating in ice.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:iceWaterline ] ; sh:path nltl:hasUpperIceWaterline ] ; sh:sparql [ sh:message Literal("Every ballast tank situated above the LIWL and needed to reach it must have freezing prevention.") ; sh:select Literal("
                    SELECT $this
                    WHERE {
                        $this <https://w3id.org/nltl/vocab#hasBallastTank> ?tank .
                        ?tank <https://w3id.org/nltl/vocab#situatedAboveLowerIceWaterline> ?above ;
                              <https://w3id.org/nltl/vocab#usedToReachLowerIceWaterline> ?needed .
                        FILTER (?above = true && ?needed = true)
                        FILTER NOT EXISTS {
                            ?tank <https://w3id.org/nltl/vocab#freezingPreventionPresent> true .
                        }
                    }
                ") ], [ sh:message Literal("draughtAmidships must be at least the LIWL draught amidships.") ; sh:select Literal("
                    SELECT $this
                    WHERE {
                        $this <https://w3id.org/nltl/vocab#draughtAmidships> ?draughtNode ;
                              <https://w3id.org/nltl/vocab#liwlDraughtAmidships> ?liwlNode .
                        ?draughtNode <http://qudt.org/schema/qudt/numericValue> ?draught .
                        ?liwlNode <http://qudt.org/schema/qudt/numericValue> ?liwl .
                        FILTER (?draught < ?liwl)
                    }
                ") ], [ sh:message Literal("forwardDraught must be at least the applicable level-ice-thickness formula threshold.") ; sh:select Literal("
                    SELECT $this
                    WHERE {
                        $this <https://w3id.org/nltl/vocab#forwardDraught> ?forwardNode ;
                              <https://w3id.org/nltl/vocab#displacementAtUpperIceWaterline> ?displacementNode ;
                              <https://w3id.org/nltl/vocab#levelIceThickness> ?thicknessNode .
                        ?forwardNode <http://qudt.org/schema/qudt/numericValue> ?forward .
                        ?displacementNode <http://qudt.org/schema/qudt/numericValue> ?displacement .
                        ?thicknessNode <http://qudt.org/schema/qudt/numericValue> ?thickness .
                        FILTER (
                            ?forward <
                            IF(
                                ((2 + (0.00025 * ?displacement)) * ?thickness) <
                                (4 * ?thickness),
                                ((2 + (0.00025 * ?displacement)) * ?thickness),
                                (4 * ?thickness)
                            )
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:navigatingInIce ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-016-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F04/ship> ] .

