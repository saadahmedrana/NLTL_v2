@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F03/ship> ;
            sh:resultMessage "Maximum continuous rating power must be at least the calculated required power and the applicable ice-class minimum." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Maximum continuous rating power must be at least the calculated required power and the applicable ice-class minimum." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:calculatedRequiredPower ?calculatedNode ;
                      nltl:maximumContinuousRatingPower ?maximumNode .
                ?calculatedNode qudt:numericValue ?calculatedRequiredPower .
                ?maximumNode qudt:numericValue ?maximumContinuousRatingPower .
                FILTER (
                    (
                        ?iceClass IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                        &&
                        (
                            ?maximumContinuousRatingPower < ?calculatedRequiredPower
                            || ?maximumContinuousRatingPower < 1000.0
                        )
                    )
                    ||
                    (
                        ?iceClass = nltl:iceClassIaSuper
                        &&
                        (
                            ?maximumContinuousRatingPower < ?calculatedRequiredPower
                            || ?maximumContinuousRatingPower < 2800.0
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF018Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F03/ship> ] .

