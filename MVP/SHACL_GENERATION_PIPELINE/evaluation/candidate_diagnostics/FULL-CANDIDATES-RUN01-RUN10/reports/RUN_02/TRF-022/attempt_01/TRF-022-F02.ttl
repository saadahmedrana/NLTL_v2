@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-022-F02/ship> ;
            sh:resultMessage "Waterline angle at quarter breadth is required as an angle in degrees." ;
            sh:resultPath nltl:waterlineAngleAtQuarterBreadth ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Waterline angle at quarter breadth is required as an angle in degrees." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:AngleQuantity> ;
                    sh:path nltl:waterlineAngleAtQuarterBreadth ] ] .

