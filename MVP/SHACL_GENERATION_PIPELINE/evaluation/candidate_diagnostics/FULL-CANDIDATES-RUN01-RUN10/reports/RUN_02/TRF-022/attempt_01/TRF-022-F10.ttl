@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-022-F10/ship> ;
            sh:resultMessage "The externally computed clamped hull geometry result is required in the inclusive interval [5,20]." ;
            sh:resultPath nltl:clampedHullGeometryTerm ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The externally computed clamped hull geometry result is required in the inclusive interval [5,20]." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:ClampedGeometryQuantity> ;
                    sh:path nltl:clampedHullGeometryTerm ] ] .

