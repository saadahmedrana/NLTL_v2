@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F01/ship> ;
            sh:resultMessage "For ice class IB or IC under the 1985 rules, maximum continuous rating power shall be at least the required power under the 1985 rules." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For ice class IB or IC under the 1985 rules, maximum continuous rating power shall be at least the required power under the 1985 rules." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
                      nltl:maximumContinuousRatingPower ?maximumQuantity ;
                      nltl:requiredPowerUnder1985Rules ?requiredQuantity .
                FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
                ?maximumQuantity qudt:numericValue ?maximumPower .
                ?requiredQuantity qudt:numericValue ?requiredPower .
                FILTER (?maximumPower < ?requiredPower)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-023> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F01/ship> ] .

