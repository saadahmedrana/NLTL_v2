@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:iceClassRuleEdition1985 ; sh:path nltl:applicableIceClassRegulationEdition ], [ sh:in ( nltl:iceClassIb nltl:iceClassIc ) ; sh:path nltl:iceClass ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloW> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:maximumContinuousRatingPower ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloW> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:requiredPowerUnder1985Rules ] ; sh:sparql [ sh:message Literal("For ice class IB or IC under the 1985 ice class regulations, maximum continuous rating power must be at least the required power under the 1985 rules.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:maximumContinuousRatingPower ?maximumQuantity .
                        ?maximumQuantity qudt:numericValue ?maximumPower .
                        $this nltl:requiredPowerUnder1985Rules ?requiredQuantity .
                        ?requiredQuantity qudt:numericValue ?requiredPower .
                        FILTER (?maximumPower < ?requiredPower)
                    }
                ") ] ] , [ sh:property [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:in ( nltl:iceClassRegulationEdition2002 nltl:iceClassRegulationEdition2008 nltl:iceClassRegulationEdition2010 nltl:iceClassRegulationEdition2017 nltl:iceClassRegulationEdition2021 ) ; sh:path nltl:applicableIceClassRegulationEdition ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF023Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/ship> ] .

