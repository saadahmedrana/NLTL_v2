@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F02/ship> ;
            sh:resultMessage "For ice class IB or IC under the 1985 ice-class rules, maximum continuous rating power must be at least the required power under the 1985 rules, with both values expressed in kW." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ice class IB or IC under the 1985 ice-class rules, maximum continuous rating power must be at least the required power under the 1985 rules, with both values expressed in kW." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:applicableIceClassRegulationEdition ?edition .

                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                    && ?edition = nltl:iceClassRuleEdition1985
                )

                FILTER NOT EXISTS {
                    $this nltl:maximumContinuousRatingPower ?maximumPowerNode .
                    ?maximumPowerNode qudt:numericValue ?maximumPowerValue ;
                                       qudt:unit qudt:KiloW .

                    $this nltl:requiredPowerUnder1985Rules ?requiredPowerNode .
                    ?requiredPowerNode qudt:numericValue ?requiredPowerValue ;
                                       qudt:unit qudt:KiloW .

                    FILTER (
                        datatype(?maximumPowerValue) = xsd:decimal
                        && datatype(?requiredPowerValue) = xsd:decimal
                        && ?maximumPowerValue >= ?requiredPowerValue
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-023> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F02/ship> ] .

