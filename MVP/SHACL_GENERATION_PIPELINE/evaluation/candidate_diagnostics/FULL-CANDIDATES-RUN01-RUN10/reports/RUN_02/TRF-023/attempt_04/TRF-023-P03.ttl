@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:iceClassRuleEdition1985 ; sh:message Literal("The 1985 ice class regulation edition must apply to retain ice class IB or IC.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:applicableIceClassRegulationEdition ], [ sh:in ( nltl:iceClassIb nltl:iceClassIc ) ; sh:message Literal("The ship must have ice class IB or IC for this applicability branch.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:hasValue unit:KiloW ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Maximum continuous rating power must be expressed in kW.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:maximumContinuousRatingPower ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:hasValue unit:KiloW ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Required power under the 1985 rules must be expressed in kW.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:requiredPowerUnder1985Rules ] ; sh:sparql [ sh:message Literal("For applicable ice class IB or IC under the 1985 rules, maximum continuous rating power must be at least the required power.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:maximumContinuousRatingPower ?mcrNode .
                        ?mcrNode qudt:numericValue ?mcrValue .
                        $this nltl:requiredPowerUnder1985Rules ?requiredNode .
                        ?requiredNode qudt:numericValue ?requiredValue .
                        FILTER (?mcrValue >= ?requiredValue)
                    }
                ") ] ] , [ sh:sparql [ sh:message Literal("The 1985 IB/IC power requirement is not applicable to this ship.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:iceClass ?iceClass .
                            FILTER (?iceClass IN (
                                nltl:iceClassIb,
                                nltl:iceClassIc
                            ))
                            $this nltl:applicableIceClassRegulationEdition
                                nltl:iceClassRuleEdition1985 .
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-023> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P03/ship> ] .

