@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-P02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:or ( [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ] ] [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("2003-09-01", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ] ) ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxExclusive Literal("2003-09-01", datatype=xsd:date) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:assessmentDate ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:deliveryDate ], [ sh:in ( nltl:iceClassIa nltl:iceClassIaSuper ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("For an applicable IA or IA Super ship, assessmentDate must not be later than 1 January of the year twenty years after deliveryDate.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:deliveryDate ?delivery ;
          nltl:assessmentDate ?assessment .
    BIND(YEAR(?delivery) + 20 AS ?deadlineYear)
    FILTER(
        YEAR(?assessment) > ?deadlineYear
        ||
        (
            YEAR(?assessment) = ?deadlineYear
            &&
            (
                MONTH(?assessment) > 1
                ||
                (MONTH(?assessment) = 1 && DAY(?assessment) > 1)
            )
        )
    )
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-024> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-P02/ship> ] .

