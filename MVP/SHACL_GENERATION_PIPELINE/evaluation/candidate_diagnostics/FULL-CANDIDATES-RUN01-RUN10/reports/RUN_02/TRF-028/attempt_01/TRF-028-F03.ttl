@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F03/ship> ;
            sh:resultMessage "An approved alternative Ke or RCH determination is required." ;
            sh:resultPath nltl:approvalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "An approved alternative Ke or RCH determination is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:approvalStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F03/ship> ;
            sh:resultMessage "An approved alternative calculation or model-test basis, together with an externally determined Ke or RCH value, is required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-028> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F03/ship> ] .

