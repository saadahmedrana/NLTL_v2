@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to exactly one shape in gs:TRF028AlternativeCalculationBranch , gs:TRF028ModelTestBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:XoneConstraintComponent ;
            sh:sourceShape gs:TRF028Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F03/ship> ;
            sh:resultMessage "The approved alternative method must have approvalStatus true." ;
            sh:resultPath nltl:approvalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The approved alternative method must have approvalStatus true." ;
                    sh:minCount 1 ;
                    sh:path nltl:approvalStatus ] ] .

