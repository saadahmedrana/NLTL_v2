@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-P01/ship> ;
            sh:resultMessage "Node ex:ship must conform to exactly one shape in [ sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal(\"The approved alternative Ke value must have alternative-calculation or model-test evidence with its canonical evidence range.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:class nltl:alternativeCalculationEvidence, nltl:documentEvidence ] [ sh:class nltl:modelTestEvidence, nltl:physicalTestEvidence ] ) ] ; sh:path nltl:hasEvidence ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:engineOutputCoefficientKe ] ] , [ sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal(\"The approved alternative RCH value must have alternative-calculation or model-test evidence with its canonical evidence range.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:class nltl:alternativeCalculationEvidence, nltl:documentEvidence ] [ sh:class nltl:modelTestEvidence, nltl:physicalTestEvidence ] ) ] ; sh:path nltl:hasEvidence ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/N> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:brashIceChannelResistanceRch ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:XoneConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_028_ComplexReadinessShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-P01/ship> ] .

