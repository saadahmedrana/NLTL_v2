@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/ship> ;
            sh:resultMessage "The combined bending and shear stress must be lower than the yield point, and yield shear stress must equal yield point divided by sqrt(3) within a 1e-6 relative tolerance or a 1e-9 MPa absolute tolerance near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The combined bending and shear stress must be lower than the yield point, and yield shear stress must equal yield point divided by sqrt(3) within a 1e-6 relative tolerance or a 1e-9 MPa absolute tolerance near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldPointQuantity ;
                      nltl:combinedBendingShearStress ?combinedQuantity ;
                      nltl:yieldShearStress ?yieldShearQuantity .
                ?yieldPointQuantity qudt:numericValue ?yieldPoint ;
                                    qudt:unit unit:MegaPA .
                ?combinedQuantity qudt:numericValue ?combined ;
                                  qudt:unit unit:MegaPA .
                ?yieldShearQuantity qudt:numericValue ?yieldShear ;
                                    qudt:unit unit:MegaPA .
                BIND((?yieldPoint / 1.7320508075688772) AS ?expectedYieldShear)
                FILTER (
                    ?combined >= ?yieldPoint
                    ||
                    (
                        ?expectedYieldShear > 0.001
                        &&
                        (
                            ?yieldShear < (?expectedYieldShear * (1 - 0.000001))
                            ||
                            ?yieldShear > (?expectedYieldShear * (1 + 0.000001))
                        )
                    )
                    ||
                    (
                        ?expectedYieldShear <= 0.001
                        &&
                        (
                            ?yieldShear < (?expectedYieldShear - 0.000000001)
                            ||
                            ?yieldShear > (?expectedYieldShear + 0.000000001)
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF031Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/ship> ] .

