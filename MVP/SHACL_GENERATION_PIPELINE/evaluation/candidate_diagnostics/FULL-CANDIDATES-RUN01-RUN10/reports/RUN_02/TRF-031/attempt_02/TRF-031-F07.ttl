@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F07/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:beamTheoryUsed ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Beam-theory calculations must provide one allowable shear stress in MPa.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:StressQuantityShape ; sh:path nltl:allowableShearStress ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:beamTheoryUsed ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF031Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F07/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F07/ship> ;
            sh:resultMessage "Each ship must state whether the direct calculation is based on beam theory." ;
            sh:resultPath nltl:beamTheoryUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Each ship must state whether the direct calculation is based on beam theory." ;
                    sh:minCount 1 ;
                    sh:path nltl:beamTheoryUsed ] ] .

