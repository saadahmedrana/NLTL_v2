@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-P04/ship> ;
            sh:resultMessage "Ice strengthening status is required to determine applicability." ;
            sh:resultPath nltl:iceStrengtheningStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Ice strengthening status is required to determine applicability." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceStrengtheningStatus ] ] .

