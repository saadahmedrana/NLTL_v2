@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F02/ship> ;
            sh:resultMessage "The ship must provide the classification society rule length." ;
            sh:resultPath nltl:classificationSocietyRuleLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the classification society rule length." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF035RuleLengthQuantityShape ;
                    sh:path nltl:classificationSocietyRuleLength ] ] .

