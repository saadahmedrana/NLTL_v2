@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F01/ship> ;
            sh:resultMessage "Design operation speed in ice shall be provided as a single knot quantity." ;
            sh:resultPath nltl:designOperationSpeedInIce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Design operation speed in ice shall be provided as a single knot quantity." ;
                    sh:minCount 1 ;
                    sh:node gen:VelocityQuantity ;
                    sh:path nltl:designOperationSpeedInIce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F01/ship> ;
            sh:resultMessage "Spacing shall be provided as a single metre quantity." ;
            sh:resultPath nltl:spacing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Spacing shall be provided as a single metre quantity." ;
                    sh:minCount 1 ;
                    sh:node gen:LengthQuantity ;
                    sh:path nltl:spacing ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F01/ship> ;
            sh:resultMessage "Sidescuttles shall not be situated in the ice belt." ;
            sh:resultPath nltl:sidescuttleInIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue false ;
                    sh:maxCount 1 ;
                    sh:message "Sidescuttles shall not be situated in the ice belt." ;
                    sh:minCount 1 ;
                    sh:path nltl:sidescuttleInIceBelt ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F01/ship> ;
            sh:resultMessage "Thickness shall be provided as a single metre quantity." ;
            sh:resultPath nltl:thickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Thickness shall be provided as a single metre quantity." ;
                    sh:minCount 1 ;
                    sh:node gen:LengthQuantity ;
                    sh:path nltl:thickness ] ] .

