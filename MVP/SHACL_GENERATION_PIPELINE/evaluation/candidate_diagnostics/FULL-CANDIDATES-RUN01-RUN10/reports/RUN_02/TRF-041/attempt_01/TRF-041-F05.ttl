@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F05/plating> ;
            sh:resultMessage "The transverse plating factor f1 is required as a dimensionless input." ;
            sh:resultPath nltl:transversePlatingFactorF1 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The transverse plating factor f1 is required as a dimensionless input." ;
                    sh:minCount 1 ;
                    sh:node gen:UnitlessQuantityShape ;
                    sh:path nltl:transversePlatingFactorF1 ] ] .

