@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F09/plating> ;
            sh:resultMessage "The externally determined required shell plating thickness is required in millimetres." ;
            sh:resultPath nltl:requiredShellPlatingThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The externally determined required shell plating thickness is required in millimetres." ;
                    sh:minCount 1 ;
                    sh:node gen:MillimetreQuantityShape ;
                    sh:path nltl:requiredShellPlatingThickness ] ] .

