@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F02/plating> ;
            sh:resultMessage "The corrosion and abrasion addition must be supplied in millimetres." ;
            sh:resultPath nltl:corrosionAbrasionAddition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The corrosion and abrasion addition must be supplied in millimetres." ;
                    sh:minCount 1 ;
                    sh:node gen:LengthMillimetreQuantityShape ;
                    sh:path nltl:corrosionAbrasionAddition ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F02/plating> ;
            sh:resultMessage "A design ice load height in metres is required." ;
            sh:resultPath nltl:designIceLoadHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A design ice load height in metres is required." ;
                    sh:minCount 1 ;
                    sh:node gen:LengthMetreQuantityShape ;
                    sh:path nltl:designIceLoadHeight ] ] .

