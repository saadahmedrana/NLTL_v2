@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ;
            sh:resultMessage "The frame boundary condition factor m0 must match its Table 4-7 boundary condition value." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The frame boundary condition factor m0 must match its Table 4-7 boundary condition value." ;
                    sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl/vocab#frameBoundaryConditionType> ?condition ;
                      <https://w3id.org/nltl/vocab#frameBoundaryConditionFactorM0> ?m0Node .
                ?m0Node <http://qudt.org/schema/qudt/numericValue> ?m0 .
                FILTER (
                    (?condition = <https://w3id.org/nltl/vocab#bulkCarrierTopWingTankFrameCondition> && ?m0 != 7) ||
                    (?condition = <https://w3id.org/nltl/vocab#singleDeckTankTopToMainDeckFrameCondition> && ?m0 != 6) ||
                    (?condition = <https://w3id.org/nltl/vocab#multiDeckOrStringerContinuousFrameCondition> && ?m0 != 5.7) ||
                    (?condition = <https://w3id.org/nltl/vocab#twoDeckFrameCondition> && ?m0 != 5)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF044TransverseFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ] .

