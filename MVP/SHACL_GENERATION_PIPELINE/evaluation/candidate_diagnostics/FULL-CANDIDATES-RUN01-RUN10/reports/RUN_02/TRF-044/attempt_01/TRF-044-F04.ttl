@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F04/transverseFrame> ;
            sh:resultMessage "The frame moment factor, section modulus, and required shear area must satisfy the specified calculation formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The frame moment factor, section modulus, and required shear area must satisfy the specified calculation formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:spacing ?sNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .
                ?pNode qudt:numericValue ?p .
                ?sNode qudt:numericValue ?s .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?m0Node qudt:numericValue ?m0 .
                ?sigmaNode qudt:numericValue ?sigma .
                ?mtNode qudt:numericValue ?mt .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .
                BIND ((7 - 5 * ?h / ?l) AS ?mtDenominator)
                BIND ((7 * ?m0 / ?mtDenominator) AS ?mtExpected)
                BIND ((?p * ?s * ?h * ?l / (?mtExpected * ?sigma) * 1000000) AS ?zExpected)
                BIND ((1.7320508075688772 * 1.2 * ?p * ?h * ?s / (2 * ?sigma) * 10000) AS ?aExpected)
                FILTER (
                    ?mtDenominator = 0 ||
                    ?sigma = 0 ||
                    ABS(?mt - ?mtExpected) > (0.000001 * ABS(?mtExpected) + 0.000001) ||
                    ABS(?z - ?zExpected) > (0.000001 * ABS(?zExpected) + 0.000001) ||
                    ABS(?a - ?aExpected) > (0.000001 * ABS(?aExpected) + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF044TransverseFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F04/transverseFrame> ] .

