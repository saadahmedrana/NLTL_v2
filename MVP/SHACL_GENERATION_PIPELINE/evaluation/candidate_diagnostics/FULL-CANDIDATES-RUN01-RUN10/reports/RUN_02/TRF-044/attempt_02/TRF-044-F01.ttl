@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ;
            sh:resultMessage "Node ex:transverseFrame must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:bulkCarrierTopWingTankFrameCondition ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:frameBoundaryConditionType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"7\", datatype=xsd:decimal) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"7\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:frameBoundaryConditionFactorM0 ] ] , [ sh:property [ sh:hasValue nltl:singleDeckTankTopToMainDeckFrameCondition ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:frameBoundaryConditionType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"6\", datatype=xsd:decimal) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"6\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:frameBoundaryConditionFactorM0 ] ] , [ sh:property [ sh:hasValue nltl:multiDeckOrStringerContinuousFrameCondition ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:frameBoundaryConditionType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"5.7\", datatype=xsd:decimal) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"5.7\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:frameBoundaryConditionFactorM0 ] ] , [ sh:property [ sh:hasValue nltl:twoDeckFrameCondition ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:frameBoundaryConditionType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"5\", datatype=xsd:decimal) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"5\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:frameBoundaryConditionFactorM0 ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF044Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ;
            sh:resultMessage "Frame moment factor, section modulus, and required shear area must satisfy the declared calculations; derived results are checked with a relative tolerance of 1e-6 plus an absolute fallback of 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Frame moment factor, section modulus, and required shear area must satisfy the declared calculations; derived results are checked with a relative tolerance of 1e-6 plus an absolute fallback of 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:spacing ?sNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:yieldStrength ?yNode ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?sNode qudt:numericValue ?s .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?m0Node qudt:numericValue ?m0 .
                ?yNode qudt:numericValue ?y .
                ?mtNode qudt:numericValue ?mt .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND (7 * ?m0 / (7 - 5 * ?h / ?l) AS ?expectedMt)
                BIND (?p * ?s * ?h * ?l / ?expectedMt * 1000000 AS ?expectedZ)
                BIND (1.7320508075688772 * 1.2 * ?p * ?h * ?s / (2 * ?y) * 10000 AS ?expectedA)

                FILTER (
                    ?mt < (?expectedMt - (?expectedMt * 0.000001 + 0.000001)) ||
                    ?mt > (?expectedMt + (?expectedMt * 0.000001 + 0.000001)) ||
                    ?z < (?expectedZ - (?expectedZ * 0.000001 + 0.000001)) ||
                    ?z > (?expectedZ + (?expectedZ * 0.000001 + 0.000001)) ||
                    ?a < (?expectedA - (?expectedA * 0.000001 + 0.000001)) ||
                    ?a > (?expectedA + (?expectedA * 0.000001 + 0.000001))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF044Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ] .

