@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F02/strengthenedPart> ;
                    sh:resultMessage "Node ex:strengthenedPart must conform to one or more shapes in [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:message Literal(\"The lower end shall be attached to a deck, tank boundary plating, tank top, or ice stringer.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] [ sh:class nltl:iceStringer ] ) ] ; sh:path nltl:hasAttachedSupportingStructure ] ] ; sh:path ( nltl:hasStrengthenedPart nltl:hasLowerEnd ) ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:mainFrameBelowIceBeltStrengthened ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:ordinaryFrameScantlingsUsed ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sameScantlingsAsMainFrame ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:message Literal(\"The applicable terminating supporting structure shall be at or below the lower limit of the ice belt.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ] ] ; sh:path nltl:hasTerminationBelowSupportingStructure ], [ sh:message Literal(\"The lower end may use a horizontal member only when it is connected to an adjacent main frame.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:horizontalConnectionMember ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltl:mainFrame ; sh:path nltl:connectsToAdjacentMainFrame ] ] ; sh:path nltl:hasHorizontalConnectionMember ] ] ; sh:path ( nltl:hasStrengthenedPart nltl:hasLowerEnd ) ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:or ( [ sh:property [ sh:minCount 1 ;
                                                sh:node [ sh:property [ ] ] ;
                                                sh:path ( nltl:hasStrengthenedPart nltl:hasLowerEnd ) ] ] [ sh:property [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:minCount 1 ;
                                                sh:path nltl:mainFrameBelowIceBeltStrengthened ],
                                            [ sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path ( nltl:hasStrengthenedPart nltl:hasLowerEnd ) ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:minCount 1 ;
                                                sh:path nltl:ordinaryFrameScantlingsUsed ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:minCount 1 ;
                                                sh:path nltl:sameScantlingsAsMainFrame ] ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F02/strengthenedPart> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F02/frame> ;
            sh:resultMessage "Each frame shall identify its strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each frame shall identify its strengthened part." ;
                    sh:minCount 1 ;
                    sh:node [ sh:or ( [ sh:property [ sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path [ ] ] ] [ sh:property [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:minCount 1 ;
                                                sh:path nltl:sameScantlingsAsMainFrame ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:minCount 1 ;
                                                sh:path nltl:ordinaryFrameScantlingsUsed ],
                                            [ sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path [ ] ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:minCount 1 ;
                                                sh:path nltl:mainFrameBelowIceBeltStrengthened ] ] ) ] ;
                    sh:path nltl:hasStrengthenedPart ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F02/strengthenedPart> ] .

