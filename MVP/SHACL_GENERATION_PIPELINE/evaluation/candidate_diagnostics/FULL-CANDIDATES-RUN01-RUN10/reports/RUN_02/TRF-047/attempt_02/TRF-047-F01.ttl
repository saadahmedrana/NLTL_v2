@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F01/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:message Literal(\"The lower end of the strengthened part must be attached to the permitted deck, tank plating, tank top, or ice stringer structure.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] [ sh:class nltl:iceStringer ] ) ] ; sh:path nltl:hasAttachedSupportingStructure ] ] ; sh:path nltl:hasLowerEnd ] ] ; sh:path nltl:hasStrengthenedPart ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The horizontal connection member must have the same scantlings as the main frames.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sameScantlingsAsMainFrame ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The horizontal-member alternative requires the terminating supporting structure to be at or below the lower limit of the ice belt.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:message Literal(\"The intermediate frame must terminate below the applicable supporting structure.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:supportingStructure ] ; sh:path nltl:hasTerminationBelowSupportingStructure ], [ sh:message Literal(\"The lower end must be connected by a horizontal member in the applicable termination alternative.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:horizontalConnectionMember ; sh:property [ sh:message Literal(\"The horizontal connection member must connect to an adjacent main frame.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:mainFrame ; sh:property <http://recursion.too.deep> ] ; sh:path nltl:connectsToAdjacentMainFrame ] ] ; sh:path nltl:hasHorizontalConnectionMember ] ] ; sh:path nltl:hasLowerEnd ] ] ; sh:path nltl:hasStrengthenedPart ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-047_MainOrIntermediateIceFrame> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F01/frame> ] .

