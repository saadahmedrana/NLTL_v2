@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/strengthenedPart> ;
                    sh:resultMessage "The strengthened part must identify its lower end." ;
                    sh:resultPath nltl:hasLowerEnd ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The strengthened part must identify its lower end." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:hasLowerEnd ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/frame> ;
            sh:resultMessage "Value does not conform to Shape g:TRF047StrengthenedPartShape. See details for more information." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape g:TRF047StrengthenedPartPropertyShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/strengthenedPart> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/adjacentMainFrame> ;
            sh:resultMessage "Less than 1 values on ex:adjacentMainFrame->nltl:hasStrengthenedPart" ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape g:TRF047StrengthenedPartPropertyShape ] .

