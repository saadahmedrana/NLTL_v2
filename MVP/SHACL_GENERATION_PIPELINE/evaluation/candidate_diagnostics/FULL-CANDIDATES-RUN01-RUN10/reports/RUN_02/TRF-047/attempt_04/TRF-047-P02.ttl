@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P02/frame> ;
            sh:resultMessage "A main frame covered by this requirement must be ice strengthened below the lower edge of the ice belt." ;
            sh:resultPath nltl:mainFrameBelowIceBeltStrengthened ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n259b4d66fadd43e3aee4383fd6709ef0b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P02/frame> ;
            sh:resultMessage "A main frame covered by this requirement must be ice strengthened below the lower edge of the ice belt." ;
            sh:resultPath nltl:mainFrameBelowIceBeltStrengthened ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n259b4d66fadd43e3aee4383fd6709ef0b2 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P02/strengthenedPart> ;
                    sh:resultMessage "The strengthened part must identify its lower end." ;
                    sh:resultPath nltl:hasLowerEnd ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The strengthened part must identify its lower end." ;
                            sh:minCount 1 ;
                            sh:node nltl:TRF047_LowerEndShape ;
                            sh:path nltl:hasLowerEnd ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P02/frame> ;
            sh:resultMessage "The main frame or intermediate ice frame must identify its strengthened part and a compliant lower-end arrangement." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The main frame or intermediate ice frame must identify its strengthened part and a compliant lower-end arrangement." ;
                    sh:minCount 1 ;
                    sh:node nltl:TRF047_StrengthenedPartShape ;
                    sh:path nltl:hasStrengthenedPart ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P02/strengthenedPart> ] .

_:n259b4d66fadd43e3aee4383fd6709ef0b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "A main frame covered by this requirement must be ice strengthened below the lower edge of the ice belt." ;
    sh:minCount 1 ;
    sh:path nltl:mainFrameBelowIceBeltStrengthened .

