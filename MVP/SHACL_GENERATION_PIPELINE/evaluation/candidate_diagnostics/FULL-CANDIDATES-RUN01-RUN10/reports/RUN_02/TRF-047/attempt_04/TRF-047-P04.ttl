@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/strengthenedPart> ;
                    sh:resultMessage "The strengthened part must identify its lower end." ;
                    sh:resultPath nltl:hasLowerEnd ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The strengthened part must identify its lower end." ;
                            sh:minCount 1 ;
                            sh:node nltl:TRF047_LowerEndShape ;
                            sh:path nltl:hasLowerEnd ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/frame> ;
            sh:resultMessage "The main frame or intermediate ice frame must identify its strengthened part and a compliant lower-end arrangement." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n259b4d66fadd43e3aee4383fd6709ef0b1 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/strengthenedPart> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/adjacentMainFrame> ;
            sh:resultMessage "The main frame or intermediate ice frame must identify its strengthened part and a compliant lower-end arrangement." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n259b4d66fadd43e3aee4383fd6709ef0b1 ] .

_:n259b4d66fadd43e3aee4383fd6709ef0b1 sh:message "The main frame or intermediate ice frame must identify its strengthened part and a compliant lower-end arrangement." ;
    sh:minCount 1 ;
    sh:node nltl:TRF047_StrengthenedPartShape ;
    sh:path nltl:hasStrengthenedPart .

