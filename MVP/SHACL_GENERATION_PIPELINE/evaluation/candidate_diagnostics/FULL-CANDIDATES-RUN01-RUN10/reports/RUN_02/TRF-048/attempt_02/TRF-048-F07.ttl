@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ;
            sh:resultMessage "The longitudinal frame calculation results, including exclusion of bracket shear area from actual frame shear area, do not satisfy the verified formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The longitudinal frame calculation results, including exclusion of bracket shear area from actual frame shear area, do not satisfy the verified formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:spacing/qudt:numericValue ?s ;
                      nltl:span/qudt:numericValue ?l ;
                      nltl:yieldStrength/qudt:numericValue ?sigma ;
                      nltl:frameMomentFactorM/qudt:numericValue ?m ;
                      nltl:longitudinalFrameLoadDistributionFactorF4/qudt:numericValue ?f4 ;
                      nltl:sectionModulus/qudt:numericValue ?z ;
                      nltl:requiredShearArea/qudt:numericValue ?a ;
                      nltl:grossFrameShearArea/qudt:numericValue ?gross ;
                      nltl:bracketArea/qudt:numericValue ?bracket ;
                      nltl:actualFrameShearArea/qudt:numericValue ?actual ;
                      nltl:frameBoundaryConditionType ?condition ;
                      nltl:significantlyDifferentBoundaryConditions ?different .

                BIND (1.0 - (0.2 * ?h / ?s) AS ?expectedF4)
                BIND (?expectedF4 * ?p * ?h * ?l * ?l /
                      (4.0 * ?m * ?sigma) * 1000000.0 AS ?expectedZ)
                BIND (1.7320508075688772 * ?expectedF4 * 2.16 * ?p * ?h * ?l /
                      (2.0 * ?sigma) * 10000.0 AS ?expectedA)
                BIND (?gross - ?bracket AS ?expectedActual)

                FILTER (
                    (
                        ?condition = nltl:continuousBeamWithBracketsFrameCondition &&
                        ?different = false &&
                        ?m != 13.3
                    )
                    ||
                    ABS(?f4 - ?expectedF4) >
                        (ABS(?expectedF4) * 0.000001 + 0.000001)
                    ||
                    ABS(?z - ?expectedZ) >
                        (ABS(?expectedZ) * 0.000001 + 0.000001)
                    ||
                    ABS(?a - ?expectedA) >
                        (ABS(?expectedA) * 0.000001 + 0.000001)
                    ||
                    ABS(?actual - ?expectedActual) >
                        (ABS(?expectedActual) * 0.000001 + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-048> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ] .

