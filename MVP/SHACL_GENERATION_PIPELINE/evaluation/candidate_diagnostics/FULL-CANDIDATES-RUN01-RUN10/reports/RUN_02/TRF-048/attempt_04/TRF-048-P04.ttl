@prefix n: <urn:nltl:generated-shape:TRF-048:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-P04/longitudinalFrame> ;
            sh:resultMessage "longitudinalFrameShearFactorF5 must equal 2.16." ;
            sh:resultPath nltl:longitudinalFrameShearFactorF5 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "longitudinalFrameShearFactorF5 must equal 2.16." ;
                    sh:minCount 1 ;
                    sh:node n:FactorF5QuantityShape ;
                    sh:path nltl:longitudinalFrameShearFactorF5 ] ] .

