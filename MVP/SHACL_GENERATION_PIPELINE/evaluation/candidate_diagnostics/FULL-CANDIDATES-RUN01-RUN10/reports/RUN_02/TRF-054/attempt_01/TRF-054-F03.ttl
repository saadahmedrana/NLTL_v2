@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F03/iceStringer> ;
            sh:resultMessage "The calculated design line load, outside ice belt factor, section modulus, or required shear area does not satisfy TRF-054." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The calculated design line load, outside ice belt factor, section modulus, or required shear area does not satisfy TRF-054." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:span/qudt:numericValue ?l ;
                      nltl:frameMomentFactorM/qudt:numericValue ?m ;
                      nltl:yieldStrength/qudt:numericValue ?sigma ;
                      nltl:distanceToIceBelt/qudt:numericValue ?hs ;
                      nltl:stringerSpan/qudt:numericValue ?ls ;
                      nltl:designLineLoad/qudt:numericValue ?reportedLoad ;
                      nltl:outsideIceBeltFactor/qudt:numericValue ?reportedFactor ;
                      nltl:sectionModulus/qudt:numericValue ?reportedZ ;
                      nltl:requiredShearArea/qudt:numericValue ?reportedA .

                BIND(?p * ?h AS ?product)
                BIND(IF(?product < 0.15, 0.15, ?product) AS ?loadMNPerM)
                BIND(?loadMNPerM * 1000 AS ?expectedLoad)
                BIND(1 - (?hs / ?ls) AS ?expectedFactor)
                BIND(0.80 * 1.8 * ?loadMNPerM * ?l * ?l /
                     (?m * ?sigma) * ?expectedFactor * 1000000 AS ?expectedZ)
                BIND(1.7320508075688772 * 0.80 * 1.8 * 1.2 *
                     ?loadMNPerM * ?l / (2 * ?sigma) *
                     ?expectedFactor * 10000 AS ?expectedA)

                FILTER(
                    ABS(?reportedLoad - ?expectedLoad) >
                        (ABS(?expectedLoad) * 0.000001 + 0.000000001)
                    ||
                    ABS(?reportedFactor - ?expectedFactor) >
                        (ABS(?expectedFactor) * 0.000001 + 0.000000001)
                    ||
                    ABS(?reportedZ - ?expectedZ) >
                        (ABS(?expectedZ) * 0.000001 + 0.000000001)
                    ||
                    ABS(?reportedA - ?expectedA) >
                        (ABS(?expectedA) * 0.000001 + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF054_IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F03/iceStringer> ] .

