@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/outsideIceBeltFactorValue> ;
                    sh:resultMessage "Node ex:outsideIceBeltFactorValue->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/UNITLESS>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/iceStringer> ;
            sh:resultMessage "Value does not conform to Shape g:DimensionlessQuantityShape. See details for more information." ;
            sh:resultPath nltl:outsideIceBeltFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node g:DimensionlessQuantityShape ;
                    sh:path nltl:outsideIceBeltFactor ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/outsideIceBeltFactorValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/iceStringer> ;
            sh:resultMessage "Design line load, outside-ice-belt factor, section modulus, and required shear area must satisfy the TRF-054 formulas within a relative tolerance of 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Design line load, outside-ice-belt factor, section modulus, and required shear area must satisfy the TRF-054 formulas within a relative tolerance of 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?spanNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:distanceToIceBelt ?hsNode ;
                      nltl:stringerSpan ?lsNode ;
                      nltl:designLineLoad ?loadNode ;
                      nltl:outsideIceBeltFactor ?factorNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?spanNode qudt:numericValue ?span .
                ?mNode qudt:numericValue ?m .
                ?sigmaNode qudt:numericValue ?sigma .
                ?hsNode qudt:numericValue ?hs .
                ?lsNode qudt:numericValue ?ls .
                ?loadNode qudt:numericValue ?reportedLoad .
                ?factorNode qudt:numericValue ?reportedFactor .
                ?zNode qudt:numericValue ?reportedZ .
                ?aNode qudt:numericValue ?reportedA .

                BIND((?p * ?h) AS ?rawLoadMn)
                BIND(IF(?rawLoadMn < 0.15, 0.15, ?rawLoadMn) AS ?expectedLoadMn)
                BIND(?expectedLoadMn * 1000 AS ?expectedLoadKn)
                BIND(1 - (?hs / ?ls) AS ?expectedFactor)
                BIND((0.80 * 1.8 * ?expectedLoadMn * ?ls * ?ls /
                      (?m * ?sigma) * ?expectedFactor * 1000000) AS ?expectedZ)
                BIND((1.7320508075688772 * 0.80 * 1.8 * 1.2 *
                      ?expectedLoadMn * ?ls /
                      (2 * ?sigma) * ?expectedFactor * 10000) AS ?expectedA)

                BIND(IF(?expectedLoadKn < 0, -?expectedLoadKn, ?expectedLoadKn) AS ?absLoad)
                BIND(IF(?expectedFactor < 0, -?expectedFactor, ?expectedFactor) AS ?absFactor)
                BIND(IF(?expectedZ < 0, -?expectedZ, ?expectedZ) AS ?absZ)
                BIND(IF(?expectedA < 0, -?expectedA, ?expectedA) AS ?absA)

                BIND(IF(?absLoad > 0.000000001, ?absLoad * 0.000001, 0.000000001) AS ?tolLoad)
                BIND(IF(?absFactor > 0.000000001, ?absFactor * 0.000001, 0.000000001) AS ?tolFactor)
                BIND(IF(?absZ > 0.000000001, ?absZ * 0.000001, 0.000000001) AS ?tolZ)
                BIND(IF(?absA > 0.000000001, ?absA * 0.000001, 0.000000001) AS ?tolA)

                FILTER(
                    ?reportedLoad < (?expectedLoadKn - ?tolLoad) ||
                    ?reportedLoad > (?expectedLoadKn + ?tolLoad) ||
                    ?reportedFactor < (?expectedFactor - ?tolFactor) ||
                    ?reportedFactor > (?expectedFactor + ?tolFactor) ||
                    ?reportedZ < (?expectedZ - ?tolZ) ||
                    ?reportedZ > (?expectedZ + ?tolZ) ||
                    ?reportedA < (?expectedA - ?tolA) ||
                    ?reportedA > (?expectedA + ?tolA)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape g:TRF054IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/iceStringer> ] .

