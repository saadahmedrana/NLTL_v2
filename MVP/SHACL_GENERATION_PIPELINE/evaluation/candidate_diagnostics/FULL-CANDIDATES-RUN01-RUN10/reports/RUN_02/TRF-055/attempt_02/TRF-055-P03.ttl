@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P03/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:scantlingApprovalStatus" ;
            sh:resultPath nltl:scantlingApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceState ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:scantlingApprovalStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P03/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:designLineLoad" ;
            sh:resultPath nltl:designLineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:TRF055LineLoadQuantityShape ;
                    sh:path nltl:designLineLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P03/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:shipBreadth" ;
            sh:resultPath nltl:shipBreadth ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:TRF055LengthQuantityShape ;
                    sh:path nltl:shipBreadth ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P03/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:hatchOpeningLength" ;
            sh:resultPath nltl:hatchOpeningLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:TRF055LengthQuantityShape ;
                    sh:path nltl:hatchOpeningLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P03/narrowDeckStrip> ;
            sh:resultMessage "Node Literal(\"true\" = True, datatype=xsd:boolean) must conform to one or more shapes in [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:reducedLineLoadApprovedByClassificationSociety ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxExclusive Literal(\"0.15\", datatype=xsd:decimal) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"0.10\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:permittedReducedLineLoad ] ] , [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ]" ;
            sh:resultPath nltl:veryLongHatchOpening ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ sh:or ( [ sh:hasValue true ;
                                sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:permittedReducedLineLoad ],
                                    [ sh:datatype xsd:boolean ;
                                        sh:hasValue true ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:path nltl:reducedLineLoadApprovedByClassificationSociety ] ] [ sh:hasValue false ] ) ;
                    sh:path nltl:veryLongHatchOpening ] ;
            sh:value true ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P03/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:sectionModulus" ;
            sh:resultPath nltl:sectionModulus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:TRF055SectionModulusQuantityShape ;
                    sh:path nltl:sectionModulus ] ] .

