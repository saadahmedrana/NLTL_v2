@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F01/hatch> ;
                    sh:resultMessage """Node ex:hatch must conform to one or more shapes in [ sh:sparql [ sh:message Literal("A hatch opening longer than half the ship breadth requires deflection representation and both hatch design evidence links.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>

                            SELECT $this
                            WHERE {
                                ?ship nltl:hasWeatherdeckHatch $this .
                                $this nltl:hatchOpeningLength/qudt:numericValue ?openingLength .
                                ?ship nltl:shipBreadth/qudt:numericValue ?breadth .
                                FILTER (?openingLength > (?breadth / 2))
                            }
                        ") ] ] , [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:shipSideDeflection ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:hatchCoverDesignEvidence ] ; sh:path nltl:hasHatchCoverDesignEvidence ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:hatchFittingDesignEvidence ] ; sh:path nltl:hasHatchFittingDesignEvidence ] ; sh:sparql [ sh:message Literal("The conditional hatch requirement applies only when the opening length is greater than half the ship breadth.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>

                            SELECT $this
                            WHERE {
                                ?ship nltl:hasWeatherdeckHatch $this .
                                $this nltl:hatchOpeningLength/qudt:numericValue ?openingLength .
                                ?ship nltl:shipBreadth/qudt:numericValue ?breadth .
                                FILTER (!(?openingLength > (?breadth / 2)))
                            }
                        ") ] ]""" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:weatherdeckHatch ;
                            sh:or ( [ sh:sparql [ sh:message "A hatch opening longer than half the ship breadth requires deflection representation and both hatch design evidence links." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>

                            SELECT $this
                            WHERE {
                                ?ship nltl:hasWeatherdeckHatch $this .
                                $this nltl:hatchOpeningLength/qudt:numericValue ?openingLength .
                                ?ship nltl:shipBreadth/qudt:numericValue ?breadth .
                                FILTER (?openingLength > (?breadth / 2))
                            }
                        """ ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class qudt:QuantityValue ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:shipSideDeflection ],
                                            [ sh:minCount 1 ;
                                                sh:node [ sh:class nltl:hatchCoverDesignEvidence ] ;
                                                sh:path nltl:hasHatchCoverDesignEvidence ],
                                            [ sh:minCount 1 ;
                                                sh:node [ sh:class nltl:hatchFittingDesignEvidence ] ;
                                                sh:path nltl:hasHatchFittingDesignEvidence ] ;
                                        sh:sparql [ sh:message "The conditional hatch requirement applies only when the opening length is greater than half the ship breadth." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>

                            SELECT $this
                            WHERE {
                                ?ship nltl:hasWeatherdeckHatch $this .
                                $this nltl:hatchOpeningLength/qudt:numericValue ?openingLength .
                                ?ship nltl:shipBreadth/qudt:numericValue ?breadth .
                                FILTER (!(?openingLength > (?breadth / 2)))
                            }
                        """ ] ] ) ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:hatchOpeningLength ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F01/hatch> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F01/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:class nltl:weatherdeckHatch ; sh:or ( [ sh:sparql [ sh:message Literal("A hatch opening longer than half the ship breadth requires deflection representation and both hatch design evidence links.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>

                            SELECT $this
                            WHERE {
                                ?ship nltl:hasWeatherdeckHatch $this .
                                $this nltl:hatchOpeningLength/qudt:numericValue ?openingLength .
                                ?ship nltl:shipBreadth/qudt:numericValue ?breadth .
                                FILTER (?openingLength > (?breadth / 2))
                            }
                        ") ] ] [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:shipSideDeflection ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:hatchCoverDesignEvidence ] ; sh:path nltl:hasHatchCoverDesignEvidence ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:hatchFittingDesignEvidence ] ; sh:path nltl:hasHatchFittingDesignEvidence ] ; sh:sparql [ sh:message Literal("The conditional hatch requirement applies only when the opening length is greater than half the ship breadth.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>

                            SELECT $this
                            WHERE {
                                ?ship nltl:hasWeatherdeckHatch $this .
                                $this nltl:hatchOpeningLength/qudt:numericValue ?openingLength .
                                ?ship nltl:shipBreadth/qudt:numericValue ?breadth .
                                FILTER (!(?openingLength > (?breadth / 2)))
                            }
                        ") ] ] ) ; sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:hatchOpeningLength ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasWeatherdeckHatch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:weatherdeckHatch ;
                            sh:or ( [ sh:sparql [ sh:message "A hatch opening longer than half the ship breadth requires deflection representation and both hatch design evidence links." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>

                            SELECT $this
                            WHERE {
                                ?ship nltl:hasWeatherdeckHatch $this .
                                $this nltl:hatchOpeningLength/qudt:numericValue ?openingLength .
                                ?ship nltl:shipBreadth/qudt:numericValue ?breadth .
                                FILTER (?openingLength > (?breadth / 2))
                            }
                        """ ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:shipSideDeflection ],
                                            [ sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:hasHatchFittingDesignEvidence ],
                                            [ sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:hasHatchCoverDesignEvidence ] ;
                                        sh:sparql [ sh:message "The conditional hatch requirement applies only when the opening length is greater than half the ship breadth." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>

                            SELECT $this
                            WHERE {
                                ?ship nltl:hasWeatherdeckHatch $this .
                                $this nltl:hatchOpeningLength/qudt:numericValue ?openingLength .
                                ?ship nltl:shipBreadth/qudt:numericValue ?breadth .
                                FILTER (!(?openingLength > (?breadth / 2)))
                            }
                        """ ] ] ) ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:hatchOpeningLength ] ] ;
                    sh:path nltl:hasWeatherdeckHatch ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F01/hatch> ] .

