@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "webFrameIceLoad must equal 1.8 times the clamped ice pressure-height product times web frame spacing, converted from MN to kN." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "webFrameIceLoad must equal 1.8 times the clamped ice pressure-height product times web frame spacing, converted from MN to kN." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureQuantity ;
                      nltl:iceLoadHeight ?heightQuantity ;
                      nltl:webFrameSpacing ?spacingQuantity ;
                      nltl:webFrameIceLoad ?loadQuantity .

                ?pressureQuantity qudt:numericValue ?pressure ;
                                   qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?heightQuantity qudt:numericValue ?height ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                ?spacingQuantity qudt:numericValue ?spacing ;
                                 qudt:unit <http://qudt.org/vocab/unit/M> .
                ?loadQuantity qudt:numericValue ?load ;
                              qudt:unit <http://qudt.org/vocab/unit/KiloN> .

                BIND (?pressure * ?height AS ?lineProduct)
                BIND (IF(?lineProduct < "0.15"^^xsd:decimal,
                         "0.15"^^xsd:decimal,
                         ?lineProduct) AS ?clampedProduct)
                BIND ("1.8"^^xsd:decimal * ?clampedProduct * ?spacing * "1000"^^xsd:decimal AS ?expectedLoad)
                BIND ("0.000001"^^xsd:decimal * ?expectedLoad +
                      "0.000000001"^^xsd:decimal AS ?tolerance)

                FILTER (
                    ?load > ?expectedLoad + ?tolerance ||
                    ?load < ?expectedLoad - ?tolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-057-WebFrameIceLoadShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ] .

