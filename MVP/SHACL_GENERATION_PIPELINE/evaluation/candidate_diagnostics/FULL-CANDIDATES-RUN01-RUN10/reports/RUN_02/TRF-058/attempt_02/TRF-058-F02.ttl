@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-F02/webFrame> ;
            sh:resultMessage """Node ex:webFrame must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:supportedStringerOutsideIceBelt ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minExclusive Literal("0", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:stringerSpan ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:KiloN ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:adjustedIceLoadForce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:KiloN ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:iceLoadForce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:stringerOutsideIceBeltHeight ] ; sh:sparql [ sh:message Literal("adjustedIceLoadForce must equal iceLoadForce multiplied by (1 - stringerOutsideIceBeltHeight / stringerSpan), within a relative tolerance of 1e-6 with a 1e-9 absolute fallback near zero.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceLoadForce ?forceQuantity ;
                              nltl:stringerOutsideIceBeltHeight ?heightQuantity ;
                              nltl:stringerSpan ?spanQuantity ;
                              nltl:adjustedIceLoadForce ?adjustedQuantity .
                        ?forceQuantity qudt:numericValue ?force .
                        ?heightQuantity qudt:numericValue ?height .
                        ?spanQuantity qudt:numericValue ?span .
                        ?adjustedQuantity qudt:numericValue ?adjusted .
                        FILTER (?span != 0)
                        BIND (?force * (1 - (?height / ?span)) AS ?expected)
                        BIND (IF(?expected >= 0, ?expected, 0 - ?expected) AS ?absoluteExpected)
                        BIND (IF(?absoluteExpected > 0, ?absoluteExpected * 0.000001, 0.000000001) AS ?tolerance)
                        FILTER (
                            (?adjusted < (?expected - ?tolerance)) ||
                            (?adjusted > (?expected + ?tolerance))
                        )
                    }
                ") ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:supportedStringerOutsideIceBelt ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF058WebFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-F02/webFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-F02/webFrame> ;
            sh:resultMessage "The supported-stringer-outside-ice-belt applicability value must be present and boolean." ;
            sh:resultPath nltl:supportedStringerOutsideIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The supported-stringer-outside-ice-belt applicability value must be present and boolean." ;
                    sh:minCount 1 ;
                    sh:path nltl:supportedStringerOutsideIceBelt ] ] .

