@prefix generated: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ;
            sh:resultMessage "The reported required shear area must follow the Table 4-8 alpha selection and the prescribed shear-area formula." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The reported required shear area must follow the Table 4-8 alpha selection and the prescribed shear-area formula." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?forceQuantity ;
                      nltl:webFrameShearFactorAlpha ?alphaQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:freeFlangeToWebAreaRatio ?ratioQuantity ;
                      nltl:requiredShearArea ?areaQuantity .

                ?forceQuantity qudt:numericValue ?force ;
                               qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                ?alphaQuantity qudt:numericValue ?alpha ;
                                qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?yieldQuantity qudt:numericValue ?yield ;
                               qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?ratioQuantity qudt:numericValue ?ratio ;
                               qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?areaQuantity qudt:numericValue ?area ;
                              qudt:unit <http://qudt.org/vocab/unit/CentiM2> .

                BIND(1.7320508075688772935 * ?alpha * 1.1 * (?force / 1000) / ?yield * 10000 AS ?expectedArea)

                FILTER (
                    !(
                        (?ratio = 0.0 && ?alpha = 1.5) ||
                        (?ratio = 0.2 && ?alpha = 1.23) ||
                        (?ratio = 0.4 && ?alpha = 1.16) ||
                        (?ratio = 0.6 && ?alpha = 1.11) ||
                        (?ratio = 0.8 && ?alpha = 1.09) ||
                        (?ratio = 1.0 && ?alpha = 1.07) ||
                        (?ratio = 1.2 && ?alpha = 1.06) ||
                        (?ratio = 1.4 && ?alpha = 1.05) ||
                        (?ratio = 1.6 && ?alpha = 1.05) ||
                        (?ratio = 1.8 && ?alpha = 1.04) ||
                        (?ratio = 2.0 && ?alpha = 1.04)
                    )
                    ||
                    (
                        ABS(?area - ?expectedArea) > (ABS(?expectedArea) * 0.000001)
                        &&
                        ABS(?area - ?expectedArea) > 0.000001
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape generated:TRF_059_WebFrameShearAreaShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ] .

