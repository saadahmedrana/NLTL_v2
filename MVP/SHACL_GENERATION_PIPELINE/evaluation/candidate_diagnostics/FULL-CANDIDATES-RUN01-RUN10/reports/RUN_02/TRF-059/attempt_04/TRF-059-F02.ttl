@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ;
            sh:resultMessage "requiredShearArea must equal sqrt(3)*alpha*1.1*Q_MN/sigma_y*10^4 within the expected-value-scaled tolerance" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "requiredShearArea must equal sqrt(3)*alpha*1.1*Q_MN/sigma_y*10^4 within the expected-value-scaled tolerance" ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?force ;
                      nltl:webFrameShearFactorAlpha ?alpha ;
                      nltl:yieldStrength ?yield ;
                      nltl:requiredShearArea ?required .
                ?force qudt:numericValue ?forceValue .
                ?alpha qudt:numericValue ?alphaValue .
                ?yield qudt:numericValue ?yieldValue .
                ?required qudt:numericValue ?requiredValue .
                FILTER (?yieldValue != 0.0)
                BIND (
                    1.7320508075688772 * ?alphaValue * 1.1 *
                    (?forceValue / 1000.0) / ?yieldValue * 10000.0
                    AS ?expectedArea
                )
                FILTER (
                    ?requiredValue <
                    (?expectedArea * (1.0 - 0.000001) - 0.000001)
                    ||
                    ?requiredValue >
                    (?expectedArea * (1.0 + 0.000001) + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF059WebFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ] .

