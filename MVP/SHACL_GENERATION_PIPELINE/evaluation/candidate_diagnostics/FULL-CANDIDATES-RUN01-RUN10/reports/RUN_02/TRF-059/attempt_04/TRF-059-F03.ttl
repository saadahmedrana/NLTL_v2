@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F03/webFrame> ;
            sh:resultMessage "freeFlangeToWebAreaRatio and webFrameShearFactorAlpha must be a permitted Table 4-8 pair" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "freeFlangeToWebAreaRatio and webFrameShearFactorAlpha must be a permitted Table 4-8 pair" ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:freeFlangeToWebAreaRatio ?ratio ;
                      nltl:webFrameShearFactorAlpha ?alpha .
                ?ratio qudt:numericValue ?ratioValue .
                ?alpha qudt:numericValue ?alphaValue .
                FILTER (
                    ! (
                        (?ratioValue = 0.0 && ?alphaValue = 1.5) ||
                        (?ratioValue = 0.2 && ?alphaValue = 1.23) ||
                        (?ratioValue = 0.4 && ?alphaValue = 1.16) ||
                        (?ratioValue = 0.6 && ?alphaValue = 1.11) ||
                        (?ratioValue = 0.8 && ?alphaValue = 1.09) ||
                        (?ratioValue = 1.0 && ?alphaValue = 1.07) ||
                        (?ratioValue = 1.2 && ?alphaValue = 1.06) ||
                        (?ratioValue = 1.4 && ?alphaValue = 1.05) ||
                        (?ratioValue = 1.6 && ?alphaValue = 1.05) ||
                        (?ratioValue = 1.8 && ?alphaValue = 1.04) ||
                        (?ratioValue = 2.0 && ?alphaValue = 1.04)
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF059WebFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F03/webFrame> ] .

