@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:shellIceStrengtheningExtent" ;
            sh:resultPath nltl:shellIceStrengtheningExtent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:shellIceStrengtheningExtent ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:framingIceStrengtheningExtent" ;
            sh:resultPath nltl:framingIceStrengtheningExtent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:framingIceStrengtheningExtent ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:propellerCount" ;
            sh:resultPath nltl:propellerCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerCount ] ] .

