@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/ship> ;
            sh:resultMessage "Each supplied side-propeller shafting assembly shall be enclosed by a plated bossing." ;
            sh:resultPath ( nltl:hasSidePropellerShafting nltl:enclosedByPlatedBossing ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:platedBossingStructure ;
                    sh:message "Each supplied side-propeller shafting assembly shall be enclosed by a plated bossing." ;
                    sh:minCount 1 ;
                    sh:path ( nltl:hasSidePropellerShafting nltl:enclosedByPlatedBossing ) ] ] .

