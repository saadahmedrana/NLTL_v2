@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:or ( [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:iceKnifePracticable ], [ sh:message Literal(\"An applicable rudder protection arrangement with an ice knife is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:iceKnife ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The ice knife must extend below the lower ice waterline.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendsBelowLowerIceWaterline ] ] ; sh:path nltl:hasRudderProtectionArrangement ] ] [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:iceKnifePracticable ], [ sh:message Literal(\"Equivalent rudder protection means are required when an ice knife is not practicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:equivalentRudderProtectionMeans ] ; sh:path nltl:hasRudderProtectionArrangement ] ] ) ; sh:property [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The lower ice waterline is required for ice class IA.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lowerIceWaterline ], [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] , [ sh:or ( [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:iceKnifePracticable ], [ sh:message Literal(\"An applicable rudder protection arrangement with an ice knife is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:iceKnife ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The ice knife must extend below the lower ice waterline.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendsBelowLowerIceWaterline ] ] ; sh:path nltl:hasRudderProtectionArrangement ] ] [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:iceKnifePracticable ], [ sh:message Literal(\"Equivalent rudder protection means are required when an ice knife is not practicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:equivalentRudderProtectionMeans ] ; sh:path nltl:hasRudderProtectionArrangement ] ] ) ; sh:property [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The lower ice waterline is required for ice class IA Super.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lowerIceWaterline ], [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF066Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F02/ship> ] .

