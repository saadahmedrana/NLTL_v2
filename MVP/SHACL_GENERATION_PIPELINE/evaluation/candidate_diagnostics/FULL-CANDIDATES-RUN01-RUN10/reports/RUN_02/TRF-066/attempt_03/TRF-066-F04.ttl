@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"For ice class IA, a practicable ice knife shall be indicated.\") ; sh:path nltl:iceKnifePracticable ], [ sh:datatype xsd:string ; sh:message Literal(\"Ice class IA requires a lower ice waterline input.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lowerIceWaterline ], [ sh:hasValue nltl:iceClassIa ; sh:message Literal(\"For ice class IA, the applicable rudder-protection conditions shall be satisfied.\") ; sh:path nltl:iceClass ], [ sh:message Literal(\"For ice class IA, the rudder shall have an ice-knife protection arrangement.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:iceKnife ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The ice knife shall extend below the lower ice waterline.\") ; sh:path nltl:extendsBelowLowerIceWaterline ] ] ; sh:path nltl:hasRudderProtectionArrangement ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"For ice class IA Super, a practicable ice knife shall be indicated.\") ; sh:path nltl:iceKnifePracticable ], [ sh:datatype xsd:string ; sh:message Literal(\"Ice class IA Super requires a lower ice waterline input.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lowerIceWaterline ], [ sh:hasValue nltl:iceClassIaSuper ; sh:message Literal(\"For ice class IA Super, the applicable rudder-protection conditions shall be satisfied.\") ; sh:path nltl:iceClass ], [ sh:message Literal(\"For ice class IA Super, the rudder shall have an ice-knife protection arrangement.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:iceKnife ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The ice knife shall extend below the lower ice waterline.\") ; sh:path nltl:extendsBelowLowerIceWaterline ] ] ; sh:path nltl:hasRudderProtectionArrangement ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:iceKnifePracticable ], [ sh:datatype xsd:string ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lowerIceWaterline ], [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ], [ sh:message Literal(\"When an ice knife is not practicable, an equivalent rudder-protection means shall be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:equivalentRudderProtectionMeans ] ; sh:path nltl:hasRudderProtectionArrangement ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:iceKnifePracticable ], [ sh:datatype xsd:string ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lowerIceWaterline ], [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ], [ sh:message Literal(\"When an ice knife is not practicable, an equivalent rudder-protection means shall be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:equivalentRudderProtectionMeans ] ; sh:path nltl:hasRudderProtectionArrangement ] ] , [ sh:property [ sh:hasValue nltl:iceClassIb ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:hasValue nltl:iceClassIc ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:hasValue nltl:iceClassIi ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:hasValue nltl:iceClassIii ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-066> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F04/ship> ] .

