@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F01/case> ;
                    sh:resultMessage "Each propeller blade load case must link to one blade and one ice block and specify exactly one blade force direction." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:XoneConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:propellerBladeLoadCase ;
                            sh:message "Each propeller blade load case must link to one blade and one ice block and specify exactly one blade force direction." ;
                            sh:property [ sh:class nltl:propellerBlade ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:propellerBladeLoadCaseBlade ],
                                [ sh:class nltl:iceBlock ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:propellerBladeLoadCaseIceBlock ] ;
                            sh:xone ( [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node nltlgen:ForceQuantityShape ;
                                        sh:path nltl:backwardBladeForce ] [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node nltlgen:ForceQuantityShape ;
                                        sh:path nltl:forwardBladeForce ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F01/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:propellerBladeLoadCase ; sh:message Literal(\"Each propeller blade load case must link to one blade and one ice block and specify exactly one blade force direction.\") ; sh:property [ sh:class nltl:iceBlock ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propellerBladeLoadCaseIceBlock ], [ sh:class nltl:propellerBlade ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propellerBladeLoadCaseBlade ] ; sh:xone ( [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:ForceQuantityShape ; sh:path nltl:backwardBladeForce ] [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:ForceQuantityShape ; sh:path nltl:forwardBladeForce ] ) ]. See details for more information." ;
            sh:resultPath nltl:hasPropellerBladeLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:propellerBladeLoadCase ;
                            sh:message "Each propeller blade load case must link to one blade and one ice block and specify exactly one blade force direction." ;
                            sh:property [ sh:class nltl:propellerBlade ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:propellerBladeLoadCaseBlade ],
                                [ sh:class nltl:iceBlock ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:propellerBladeLoadCaseIceBlock ] ;
                            sh:xone ( [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node nltlgen:ForceQuantityShape ;
                                        sh:path nltl:backwardBladeForce ] [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node nltlgen:ForceQuantityShape ;
                                        sh:path nltl:forwardBladeForce ] ) ] ;
                    sh:path nltl:hasPropellerBladeLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F01/case> ] .

