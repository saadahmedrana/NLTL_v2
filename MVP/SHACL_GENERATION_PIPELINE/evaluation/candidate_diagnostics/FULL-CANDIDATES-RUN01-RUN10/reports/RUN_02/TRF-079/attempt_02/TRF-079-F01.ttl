@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ;
            sh:resultMessage "propellerImmersionFunction and iceLoadCycleCoefficientK2 must satisfy the specified formulae." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "propellerImmersionFunction and iceLoadCycleCoefficientK2 must satisfy the specified formulae." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?iceQuantity ;
                      nltl:propellerDiameter ?diameterQuantity ;
                      nltl:propellerShaftCentrelineDepth ?depthQuantity ;
                      nltl:propellerImmersionFunction ?functionQuantity ;
                      nltl:iceLoadCycleCoefficientK2 ?coefficientQuantity .

                ?iceQuantity qudt:numericValue ?ice ;
                             qudt:unit <http://qudt.org/vocab/unit/M> .
                ?diameterQuantity qudt:numericValue ?diameter ;
                                   qudt:unit <http://qudt.org/vocab/unit/M> .
                ?depthQuantity qudt:numericValue ?depth ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                ?functionQuantity qudt:numericValue ?function .
                ?coefficientQuantity qudt:numericValue ?coefficient .

                BIND (((?depth - ?ice) / (?diameter / 2)) - 1 AS ?expectedFunction)
                BIND (
                    IF(
                        ?expectedFunction < 0,
                        0.8 - ?expectedFunction,
                        IF(
                            ?expectedFunction <= 1,
                            0.8 - (0.4 * ?expectedFunction),
                            IF(
                                ?expectedFunction <= 2.5,
                                0.6 - (0.2 * ?expectedFunction),
                                0.1
                            )
                        )
                    ) AS ?expectedCoefficient
                )

                FILTER (
                    ABS(?function - ?expectedFunction) >
                    (1e-6 * ABS(?expectedFunction) + 1e-9)
                    ||
                    ABS(?coefficient - ?expectedCoefficient) >
                    (1e-6 * ABS(?expectedCoefficient) + 1e-9)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF079Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ] .

