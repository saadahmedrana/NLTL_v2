@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ;
            sh:resultMessage "effectiveIceLoadCycleCount must equal iceLoadCycleCount multiplied by propellerBladeCount within a relative tolerance of 1e-6, with an absolute tolerance of 1e-6 near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "effectiveIceLoadCycleCount must equal iceLoadCycleCount multiplied by propellerBladeCount within a relative tolerance of 1e-6, with an absolute tolerance of 1e-6 near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?nice ;
                      nltl:propellerBladeCount ?blades ;
                      nltl:effectiveIceLoadCycleCount ?quantity .
                ?quantity qudt:numericValue ?reported .

                FILTER (
                    ABS(
                        xsd:decimal(?reported) -
                        (xsd:decimal(?nice) * xsd:decimal(?blades))
                    )
                    >
                    IF(
                        ABS(xsd:decimal(?nice) * xsd:decimal(?blades)) > 0,
                        0.000001 * ABS(xsd:decimal(?nice) * xsd:decimal(?blades)),
                        0.000001
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF_080_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ] .

