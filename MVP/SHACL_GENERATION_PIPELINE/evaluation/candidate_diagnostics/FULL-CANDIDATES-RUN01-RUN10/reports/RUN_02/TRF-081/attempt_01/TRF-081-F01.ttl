@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-F01/ship> ;
            sh:resultMessage "Ice thrust and propeller shaft design thrust values must satisfy the declared formulas; calculated decimal results are checked with a relative tolerance of 1e-6 plus an absolute fallback of 1e-6 kN." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ice thrust and propeller shaft design thrust values must satisfy the declared formulas; calculated decimal results are checked with a relative tolerance of 1e-6 plus an absolute fallback of 1e-6 kN." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce ?ffNode ;
                      nltl:backwardBladeForce ?fbNode ;
                      nltl:hydrodynamicBollardThrust ?hNode ;
                      nltl:forwardIceThrust ?tfNode ;
                      nltl:backwardIceThrust ?tbNode ;
                      nltl:forwardPropellerShaftDesignThrust ?frNode ;
                      nltl:backwardPropellerShaftDesignThrust ?brNode ;
                      nltl:propellerShaftDesignThrust ?rNode .

                ?ffNode qudt:numericValue ?ff .
                ?fbNode qudt:numericValue ?fb .
                ?hNode qudt:numericValue ?h .
                ?tfNode qudt:numericValue ?tf .
                ?tbNode qudt:numericValue ?tb .
                ?frNode qudt:numericValue ?fr .
                ?brNode qudt:numericValue ?br .
                ?rNode qudt:numericValue ?r .

                BIND (1.1 * ?ff AS ?expectedTf)
                BIND (1.1 * ?fb AS ?expectedTb)
                BIND (?h + 2.2 * ?expectedTf AS ?expectedForward)
                BIND (1.5 * ?expectedTb AS ?expectedBackward)
                BIND (IF(?expectedForward >= ?expectedBackward,
                         ?expectedForward,
                         ?expectedBackward) AS ?expectedDesign)

                FILTER (
                    ABS(?tf - ?expectedTf) >
                        (ABS(?expectedTf) * 0.000001 + 0.000001)
                    ||
                    ABS(?tb - ?expectedTb) >
                        (ABS(?expectedTb) * 0.000001 + 0.000001)
                    ||
                    ABS(?fr - ?expectedForward) >
                        (ABS(?expectedForward) * 0.000001 + 0.000001)
                    ||
                    ABS(?br - ?expectedBackward) >
                        (ABS(?expectedBackward) * 0.000001 + 0.000001)
                    ||
                    ABS(?r - ?expectedDesign) >
                        (ABS(?expectedDesign) * 0.000001 + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_081_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-F01/ship> ] .

