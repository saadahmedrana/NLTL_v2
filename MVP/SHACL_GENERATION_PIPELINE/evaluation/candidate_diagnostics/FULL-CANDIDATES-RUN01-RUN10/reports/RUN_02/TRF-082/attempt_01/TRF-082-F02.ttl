@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-082-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Bollard thrust applicability must be recorded as known when the table lookup is not required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bollardThrustKnown ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"Bollard thrust applicability must be recorded as not known when the Table 6-8 value is used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bollardThrustKnown ], [ sh:message Literal(\"A Table 6-8 lookup case must be recorded when hydrodynamic bollard thrust is not known.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF082TableLookupCaseShape ; sh:path nltl:hasTableLookupCase ], [ sh:message Literal(\"Hydrodynamic bollard thrust must be supplied when its value is not known and Table 6-8 is used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:KiloN ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:hydrodynamicBollardThrust ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF082ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-082-F02/ship> ] .

