@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-082-F01/ship> ;
            sh:resultMessage "Bollard thrust must be explicitly known, or, when unknown, the ship must provide the hydrodynamic bollard thrust in kN and link it to a Table 6-8 lookup case with selection evidence." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_082_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-082-F01/ship> ] .

