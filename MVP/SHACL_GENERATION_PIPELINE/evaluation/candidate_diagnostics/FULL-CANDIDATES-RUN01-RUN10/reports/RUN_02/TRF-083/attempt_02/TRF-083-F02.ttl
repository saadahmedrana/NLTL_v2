@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-083-F02/ship> ;
            sh:resultMessage "The rotational-speed-known selector must be present; when the speed is unknown, the value must be attributed using TRAFICOM Table 6-9 with selection evidence." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-083-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-083-F02/ship> ] .

