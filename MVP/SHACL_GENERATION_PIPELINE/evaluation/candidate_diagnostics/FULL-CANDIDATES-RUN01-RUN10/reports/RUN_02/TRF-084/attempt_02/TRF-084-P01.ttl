@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-P01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("CP") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerType ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:pitchValueKnown ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:QuantityValueShape ; sh:path nltl:propellerPitchAtMcrBollard ] ] , [ sh:property [ sh:hasValue Literal("CP") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerType ], [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:pitchValueKnown ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:QuantityValueShape ; sh:path nltl:propellerPitchAtMcrBollard ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:QuantityValueShape ; sh:path nltl:propellerPitchAtMcrFreeRunning ] ; sh:sparql [ sh:message Literal("For a CP propeller with an unknown pitch value, the bollard-condition pitch must equal 0.7 times the free-running pitch within a relative tolerance of 1e-6 and an absolute fallback tolerance of 1e-9 m.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:propellerType "CP" ;
                              nltl:pitchValueKnown false ;
                              nltl:propellerPitchAtMcrBollard ?bollardPitch ;
                              nltl:propellerPitchAtMcrFreeRunning ?freePitch .

                        ?bollardPitch qudt:numericValue ?bollardValue .
                        ?freePitch qudt:numericValue ?freeValue .

                        FILTER (isNumeric(?bollardValue) && isNumeric(?freeValue))

                        BIND (0.7 * ?freeValue AS ?expectedValue)
                        BIND (
                            IF(
                                ?expectedValue >= 0,
                                IF(
                                    (?expectedValue * 0.000001) > 0.000000001,
                                    ?expectedValue * 0.000001,
                                    0.000000001
                                ),
                                IF(
                                    (-?expectedValue * 0.000001) > 0.000000001,
                                    -?expectedValue * 0.000001,
                                    0.000000001
                                )
                            )
                            AS ?tolerance
                        )

                        FILTER (
                            ?bollardValue < (?expectedValue - ?tolerance)
                            ||
                            ?bollardValue > (?expectedValue + ?tolerance)
                        )
                    }
                ") ] ] , [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerType ; sh:pattern Literal("^(?!CP$).*$") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF084Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-P01/ship> ] .

