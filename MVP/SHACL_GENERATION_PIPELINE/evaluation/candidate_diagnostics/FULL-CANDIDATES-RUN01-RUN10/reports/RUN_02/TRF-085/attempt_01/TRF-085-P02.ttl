@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:KnownSpeedBranch , gen:TableSelectedSpeedBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF085PropellerBollardSpeedShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P02/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P02/lookup> ;
                    sh:resultMessage "Less than 1 values on ex:lookup->nltl:lookupResultQuantity" ;
                    sh:resultPath nltl:lookupResultQuantity ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node gen:PropellerSpeedQuantityShape ;
                            sh:path nltl:lookupResultQuantity ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P02/lookup> ;
                    sh:resultMessage "Less than 1 values on ex:lookup->nltl:lookupInputQuantity" ;
                    sh:resultPath nltl:lookupInputQuantity ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node gen:PropellerDiameterQuantityShape ;
                            sh:path nltl:lookupInputQuantity ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TableLookupCaseShape. See details for more information." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:TableLookupCaseShape ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P02/lookup> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bollardPropellerSpeedKnown" ;
            sh:resultPath nltl:bollardPropellerSpeedKnown ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:bollardPropellerSpeedKnown ] ] .

