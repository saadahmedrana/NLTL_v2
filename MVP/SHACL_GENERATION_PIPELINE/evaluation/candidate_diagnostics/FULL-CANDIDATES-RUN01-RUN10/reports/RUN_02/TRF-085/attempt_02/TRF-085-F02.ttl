@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-F02/ship> ;
            sh:resultMessage "The bollard propeller speed must either be a known single value in rev/min with no table lookup case, or be selected through exactly one Table 6-9 lookup case." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:TRF_085_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-F02/ship> ] .

