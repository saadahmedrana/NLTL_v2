@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/propellerDiameterValue> ;
                    sh:resultMessage "Node ex:propellerDiameterValue->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:propellerDiameter ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:propellerDiameter ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/propellerDiameterValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:bollardPropellerSpeedKnown ], [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:hasTableLookupCase ] ] , [ sh:property [ sh:class nltl:tableLookupCase ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-085-TableLookupCaseShape> ; sh:path nltl:hasTableLookupCase ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:bollardPropellerSpeedKnown ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-085-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/propellerRotationalSpeedAtMaximumContinuousRatingBollardValue> ;
                    sh:resultMessage "Node ex:propellerRotationalSpeedAtMaximumContinuousRatingBollardValue->qudt:unit does not contain a value in the set: ['qudt:REV-PER-MIN']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:REV-PER-MIN ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:REV-PER-MIN ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:REV-PER-MIN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/propellerRotationalSpeedAtMaximumContinuousRatingBollardValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bollardPropellerSpeedKnown" ;
            sh:resultPath nltl:bollardPropellerSpeedKnown ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:bollardPropellerSpeedKnown ] ] .

