@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ;
                    sh:resultMessage "The propulsion load case shall specify its purpose as propulsion-line strength evaluation and shall not specify stalling analysis." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCasePurposeValue ;
                            sh:message "The propulsion load case shall specify its purpose as propulsion-line strength evaluation and shall not specify stalling analysis." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:TRF-091-StrengthEvaluationPurposeShape> ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:loadCasePurpose ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/milling> ;
            sh:resultMessage "The ship shall identify the propulsion-line strength-evaluation load case." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n921cea4b671a49df82f456748577991bb2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/milling> ;
            sh:resultMessage "The ship shall identify the load-sequence case for propeller ice-block milling." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceMillingSequenceCase ;
                    sh:message "The ship shall identify the load-sequence case for propeller ice-block milling." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-091-IceMillingSequenceCaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceMillingSequenceCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/ship> ;
            sh:resultMessage "The ship shall identify the propulsion-line strength-evaluation load case." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n921cea4b671a49df82f456748577991bb2 ] .

_:n921cea4b671a49df82f456748577991bb2 sh:class nltl:loadCase ;
    sh:message "The ship shall identify the propulsion-line strength-evaluation load case." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:TRF-091-PropulsionLoadCaseShape> ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasPropulsionLoadCase .

