@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F02/ship> ;
            sh:resultMessage "Evidence shall document the SN-curve selection correspondence." ;
            sh:resultPath nltl:stressLifeCurveSelectionCorrespondenceEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                    sh:maxCount 1 ;
                    sh:message "Evidence shall document the SN-curve selection correspondence." ;
                    sh:minCount 1 ;
                    sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ] ] .

