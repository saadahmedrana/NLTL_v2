                                                sh:path nltl:fatigueCoefficientC3 ] ] [ sh:property [ sh:node [ ] ;
                                                sh:path nltl:fatigueCoefficientC4 ],
                                            [ sh:datatype xsd:string ;
                                                sh:hasValue "ducted"^^xsd:string ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:propellerType ],
                                            [ sh:node [ ] ;
