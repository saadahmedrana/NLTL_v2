                                            [ sh:node [ ] ;
                                                sh:path nltl:fatigueCoefficientC3 ],
                                            [ sh:node [ ] ;
                                                sh:path nltl:fatigueCoefficientC2 ] ] ) ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:fatigueCoefficientC2 ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:fatigueCoefficientC1 ],
                                [ sh:hasValue nltl:traficomTable6Dash14 ;
                                    sh:maxCount 1 ;
                                    sh:message "The table lookup case must reference TRAFICOM Table 6-14." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:tableReference ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
