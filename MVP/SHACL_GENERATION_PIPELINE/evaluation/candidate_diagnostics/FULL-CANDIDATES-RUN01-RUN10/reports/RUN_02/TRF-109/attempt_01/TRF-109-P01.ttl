                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:fatigueCoefficientC3 ] ] ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-P01/lookup> ] .

