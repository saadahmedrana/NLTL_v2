                                            [ sh:node [ sh:property [ ] ] ;
                                                sh:path nltl:fatigueCoefficientC3 ],
                                            [ sh:datatype xsd:string ;
                                                sh:hasValue "ducted"^^xsd:string ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:propellerType ],
                                            [ sh:node [ sh:property [ ] ] ;
                                                sh:path nltl:fatigueCoefficientC4 ],
                                            [ sh:node [ sh:property [ ] ] ;
                                                sh:path nltl:fatigueCoefficientC1 ] ] ) ;
                            sh:property [ sh:maxCount 1 ;
