@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-P01/lookup> ;
                    sh:resultMessage "Node ex:lookup must conform to one or more shapes in [ sh:property [ sh:datatype xsd:string ; sh:hasValue Literal(\"open\", datatype=xsd:string) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propellerType ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"-0.0565\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"-0.0565\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:fatigueCoefficientC3 ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"0.000747\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"0.000747\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:fatigueCoefficientC1 ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"0.0645\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"0.0645\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:fatigueCoefficientC2 ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"2.22\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"2.22\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:fatigueCoefficientC4 ] ] , [ sh:property [ sh:datatype xsd:string ; sh:hasValue Literal(\"ducted\", datatype=xsd:string) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propellerType ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"-0.0459\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"-0.0459\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:fatigueCoefficientC3 ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"0.000534\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"0.000534\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:fatigueCoefficientC1 ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"0.0533\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"0.0533\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:fatigueCoefficientC2 ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"2.584\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"2.584\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:fatigueCoefficientC4 ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:tableLookupCase ;
                            sh:or ( [ sh:property [ sh:node [ sh:property [ ] ] ;
                                                sh:path nltl:fatigueCoefficientC1 ],
                                            [ sh:node [ sh:property [ ] ] ;
                                                sh:path nltl:fatigueCoefficientC2 ],
                                            [ sh:datatype xsd:string ;
                                                sh:hasValue "open"^^xsd:string ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:propellerType ],
                                            [ sh:node [ sh:property [ ] ] ;
                                                sh:path nltl:fatigueCoefficientC3 ],
