@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/ship> ;
            sh:resultMessage "For an applicable total-blade-failure load case, externally calculated bending and torsional yield safety factors of a propeller shaft line component must both be at least 1.0." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an applicable total-blade-failure load case, externally calculated bending and torsional yield safety factors of a propeller shaft line component must both be at least 1.0." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasPropulsionLoadCase ?loadCase .
                ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
                FILTER NOT EXISTS {
                    $this nltl:hasPropellerShaftLineComponent ?component .
                    ?component nltl:bendingYieldSafetyFactor ?bending .
                    ?bending qudt:numericValue ?bendingValue ;
                             qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    ?component nltl:torsionalYieldSafetyFactor ?torsional .
                    ?torsional qudt:numericValue ?torsionalValue ;
                              qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    FILTER (
                        datatype(?bendingValue) = xsd:decimal &&
                        datatype(?torsionalValue) = xsd:decimal &&
                        ?bendingValue >= 1.0 &&
                        ?torsionalValue >= 1.0
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-112-ComplexReadinessShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/ship> ] .

