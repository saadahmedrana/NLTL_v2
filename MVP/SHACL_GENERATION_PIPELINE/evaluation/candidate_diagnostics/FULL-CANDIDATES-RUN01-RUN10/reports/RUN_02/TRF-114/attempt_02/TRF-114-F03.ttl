@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/impact> ;
                    sh:resultMessage "The impact case must provide evidence for the loaded area." ;
                    sh:resultPath nltl:thrusterIceImpactLoadedAreaEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:message "The impact case must provide evidence for the loaded area." ;
                            sh:minCount 1 ;
                            sh:path nltl:thrusterIceImpactLoadedAreaEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:thrusterIceImpactLoadCase ; sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal(\"The impact case must provide evidence for the loaded area.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:thrusterIceImpactLoadedAreaEvidence ], [ sh:class nltl:thrusterBody ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:thrusterImpactCaseAppliesToBody ], [ sh:hasValue nltl:traficomTable6Dash16Reference ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The impact case must reference TRAFICOM Table 6-16 for the impact load case.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:impactLoadCaseTableReference ], [ sh:hasValue nltl:traficomTable6Dash3Reference ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The impact case must reference TRAFICOM Table 6-3 for the design ice block.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:designIceBlockTableReference ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The impact case must classify contact geometry as hemispherical or non-hemispherical.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:or ( [ sh:hasValue nltl:hemisphericalContactGeometry ] [ sh:hasValue nltl:nonHemisphericalContactGeometry ; sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal(\"A non-hemispherical case must provide contact geometry correspondence evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:contactGeometryCorrespondenceEvidence ] ] ) ; sh:path nltl:contactGeometryClassification ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterIceImpactDemand ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterIceImpactLoad ] ]. See details for more information." ;
            sh:resultPath nltl:hasThrusterIceImpactLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:thrusterIceImpactLoadCase ;
                            sh:property [ sh:class nltl:thrusterBody ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:thrusterImpactCaseAppliesToBody ],
                                [ sh:hasValue nltl:traficomTable6Dash16Reference ;
                                    sh:maxCount 1 ;
                                    sh:message "The impact case must reference TRAFICOM Table 6-16 for the impact load case." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:impactLoadCaseTableReference ],
                                [ sh:hasValue nltl:traficomTable6Dash3Reference ;
                                    sh:maxCount 1 ;
                                    sh:message "The impact case must reference TRAFICOM Table 6-3 for the design ice block." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:designIceBlockTableReference ],
                                [ sh:class nltl:evidenceArtifact ;
                                    sh:message "The impact case must provide evidence for the loaded area." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:thrusterIceImpactLoadedAreaEvidence ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thrusterIceImpactLoad ],
                                [ sh:maxCount 1 ;
                                    sh:message "The impact case must classify contact geometry as hemispherical or non-hemispherical." ;
                                    sh:minCount 1 ;
                                    sh:or ( [ sh:hasValue nltl:hemisphericalContactGeometry ] [ sh:hasValue nltl:nonHemisphericalContactGeometry ;
                                                sh:property [ ] ] ) ;
                                    sh:path nltl:contactGeometryClassification ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thrusterIceImpactDemand ] ] ;
                    sh:path nltl:hasThrusterIceImpactLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/impact> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/ship> ;
            sh:resultMessage "The ship must provide one ice operating speed in knots." ;
            sh:resultPath nltl:iceOperatingSpeed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one ice operating speed in knots." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:iceOperatingSpeed ] ] .

