@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/ship> ;
            sh:resultMessage "The ship must provide one ice operating speed quantity in knots." ;
            sh:resultPath nltl:iceOperatingSpeed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one ice operating speed quantity in knots." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:iceOperatingSpeed ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/impact> ;
                    sh:resultMessage "Node nltl:nonHemisphericalContactGeometry must conform to one or more shapes in [ sh:hasValue nltl:hemisphericalContactGeometry ] , [ sh:hasValue nltl:nonHemisphericalContactGeometry ; sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal(\"Non-hemispherical contact geometry requires correspondence evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:contactGeometryCorrespondenceEvidence ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Non-hemispherical contact geometry requires a ship-owned equivalent impact sphere radius in metres.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path ( [ sh:inversePath nltl:hasThrusterIceImpactLoadCase ] nltl:equivalentImpactSphereRadius ) ] ]" ;
                    sh:resultPath nltl:contactGeometryClassification ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:contactGeometryValue ;
                            sh:in ( nltl:hemisphericalContactGeometry nltl:nonHemisphericalContactGeometry ) ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:or ( [ sh:hasValue nltl:hemisphericalContactGeometry ] [ sh:hasValue nltl:nonHemisphericalContactGeometry ;
                                        sh:property [ sh:class nltl:evidenceArtifact ;
                                                sh:message "Non-hemispherical contact geometry requires correspondence evidence." ;
                                                sh:minCount 1 ;
                                                sh:path nltl:contactGeometryCorrespondenceEvidence ],
                                            [ sh:maxCount 1 ;
                                                sh:message "Non-hemispherical contact geometry requires a ship-owned equivalent impact sphere radius in metres." ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class qudt:QuantityValue ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path ( [ ] nltl:equivalentImpactSphereRadius ) ] ] ) ;
                            sh:path nltl:contactGeometryClassification ] ;
                    sh:value nltl:nonHemisphericalContactGeometry ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/thrusterBody> ;
                            sh:resultMessage "Less than 1 values on ex:thrusterBody->nltl:thrusterResistanceCapacity" ;
                            sh:resultPath nltl:thrusterResistanceCapacity ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thrusterResistanceCapacity ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/impact> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterResistanceCapacity ] ]. See details for more information." ;
                    sh:resultPath nltl:thrusterImpactCaseAppliesToBody ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:thrusterBody ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:class qudt:QuantityValue ;
                                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ],
                                                        [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:thrusterResistanceCapacity ] ] ;
                            sh:path nltl:thrusterImpactCaseAppliesToBody ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/thrusterBody> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF114LoadCaseShape. See details for more information." ;
            sh:resultPath nltl:hasThrusterIceImpactLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:thrusterIceImpactLoadCase ;
                    sh:minCount 1 ;
                    sh:node gen:TRF114LoadCaseShape ;
                    sh:path nltl:hasThrusterIceImpactLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/impact> ] .

