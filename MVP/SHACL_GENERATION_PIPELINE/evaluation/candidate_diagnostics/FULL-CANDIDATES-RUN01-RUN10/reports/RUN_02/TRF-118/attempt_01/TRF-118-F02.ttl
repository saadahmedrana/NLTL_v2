@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/assessment> ;
                    sh:resultMessage "Each assessment must provide the externally assessed factored extreme load in kN." ;
                    sh:resultPath nltl:assessedFactoredExtremeLoad ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each assessment must provide the externally assessed factored extreme load in kN." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:assessedFactoredExtremeLoad ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:factoredExtremeLoadOperabilityAssessment ; sh:property [ sh:class nltl:shipComponent ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each assessment must identify its assessed thruster component.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:assessedThrusterComponent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The externally assessed result must state that repair is not required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:assessmentRepairRequired ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The externally assessed operability result must be true.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:assessmentOperabilityMaintained ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each assessment must provide the externally assessed factored extreme load in kN.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:assessedFactoredExtremeLoad ] ]. See details for more information." ;
            sh:resultPath nltl:hasFactoredExtremeLoadOperabilityAssessment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:factoredExtremeLoadOperabilityAssessment ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "Each assessment must provide the externally assessed factored extreme load in kN." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:assessedFactoredExtremeLoad ],
                                [ sh:class nltl:shipComponent ;
                                    sh:maxCount 1 ;
                                    sh:message "Each assessment must identify its assessed thruster component." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:assessedThrusterComponent ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The externally assessed operability result must be true." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:assessmentOperabilityMaintained ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue false ;
                                    sh:maxCount 1 ;
                                    sh:message "The externally assessed result must state that repair is not required." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:assessmentRepairRequired ] ] ;
                    sh:path nltl:hasFactoredExtremeLoadOperabilityAssessment ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/assessment> ] .

