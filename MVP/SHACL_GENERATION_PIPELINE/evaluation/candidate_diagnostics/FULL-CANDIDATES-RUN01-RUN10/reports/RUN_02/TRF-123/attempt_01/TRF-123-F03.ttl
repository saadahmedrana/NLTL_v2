@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F03/component> ;
                            sh:resultMessage "Each assessed component must provide its externally calculated occasional-force stress in MPa." ;
                            sh:resultPath nltl:occasionalForceComponentStress ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:message "Each assessed component must provide its externally calculated occasional-force stress in MPa." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:occasionalForceComponentStress ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F03/loadCase> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:shipComponent ; sh:property [ sh:message Literal(\"Each assessed component must provide its externally calculated occasional-force stress in MPa.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:occasionalForceComponentStress ], [ sh:node [ sh:class nltl:materialProperties ; sh:property [ sh:message Literal(\"The assessed component material properties must provide the material yield strength in MPa.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentMaterialYieldStrength ] ] ; sh:path nltl:hasMaterialProperties ] ]. See details for more information." ;
                    sh:resultPath nltl:occasionalForceCaseAssessedComponent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node [ sh:class nltl:shipComponent ;
                                    sh:property [ sh:node [ sh:class nltl:materialProperties ;
                                                    sh:property [ sh:message "The assessed component material properties must provide the material yield strength in MPa." ;
                                                            sh:minCount 1 ;
                                                            sh:node [ ] ;
                                                            sh:path nltl:componentMaterialYieldStrength ] ] ;
                                            sh:path nltl:hasMaterialProperties ],
                                        [ sh:message "Each assessed component must provide its externally calculated occasional-force stress in MPa." ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:class qudt:QuantityValue ;
                                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ],
                                                        [ sh:datatype xsd:decimal ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:occasionalForceComponentStress ] ] ;
                            sh:path nltl:occasionalForceCaseAssessedComponent ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F03/component> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F03/loadCase> ;
                    sh:resultMessage "Each occasional force load case must provide the externally calculated component yield safety factor as a dimensionless quantity." ;
                    sh:resultPath nltl:componentYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each occasional force load case must provide the externally calculated component yield safety factor as a dimensionless quantity." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:componentYieldSafetyFactor ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F03/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:class nltl:occasionalForceLoadCase ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The occasional force load case must record that propeller blades are excluded from its scope.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ], [ sh:message Literal("Each occasional force load case must provide the externally calculated component yield safety factor as a dimensionless quantity.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ], [ sh:node [ sh:class nltl:shipComponent ; sh:property [ sh:message Literal("Each assessed component must provide its externally calculated occasional-force stress in MPa.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:occasionalForceComponentStress ], [ sh:node [ sh:class nltl:materialProperties ; sh:property [ sh:message Literal("The assessed component material properties must provide the material yield strength in MPa.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentMaterialYieldStrength ] ] ; sh:path nltl:hasMaterialProperties ] ] ; sh:path nltl:occasionalForceCaseAssessedComponent ] ; sh:sparql [ sh:message Literal("The externally calculated occasional-force stress, including the component yield safety factor, must not exceed the component material yield strength.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:componentYieldSafetyFactor ?factorQuantity .
                        ?factorQuantity qudt:numericValue ?factor .
                        $this nltl:occasionalForceCaseAssessedComponent ?component .
                        ?component nltl:occasionalForceComponentStress ?stressQuantity .
                        ?stressQuantity qudt:numericValue ?stress .
                        ?component nltl:hasMaterialProperties ?material .
                        ?material nltl:componentMaterialYieldStrength ?yieldQuantity .
                        ?yieldQuantity qudt:numericValue ?yield .
                        FILTER (?stress * ?factor > ?yield)
                    }
                ") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasOccasionalForceLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:occasionalForceLoadCase ;
                            sh:property [ sh:node [ sh:class nltl:shipComponent ;
                                            sh:property [ sh:message "Each assessed component must provide its externally calculated occasional-force stress in MPa." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:occasionalForceComponentStress ],
                                                [ sh:node [ ] ;
                                                    sh:path nltl:hasMaterialProperties ] ] ;
                                    sh:path nltl:occasionalForceCaseAssessedComponent ],
                                [ sh:message "Each occasional force load case must provide the externally calculated component yield safety factor as a dimensionless quantity." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:componentYieldSafetyFactor ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The occasional force load case must record that propeller blades are excluded from its scope." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ] ;
                            sh:sparql [ sh:message "The externally calculated occasional-force stress, including the component yield safety factor, must not exceed the component material yield strength." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:componentYieldSafetyFactor ?factorQuantity .
                        ?factorQuantity qudt:numericValue ?factor .
                        $this nltl:occasionalForceCaseAssessedComponent ?component .
                        ?component nltl:occasionalForceComponentStress ?stressQuantity .
                        ?stressQuantity qudt:numericValue ?stress .
                        ?component nltl:hasMaterialProperties ?material .
                        ?material nltl:componentMaterialYieldStrength ?yieldQuantity .
                        ?yieldQuantity qudt:numericValue ?yield .
                        FILTER (?stress * ?factor > ?yield)
                    }
                """ ] ] ;
                    sh:path nltl:hasOccasionalForceLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F03/loadCase> ] .

