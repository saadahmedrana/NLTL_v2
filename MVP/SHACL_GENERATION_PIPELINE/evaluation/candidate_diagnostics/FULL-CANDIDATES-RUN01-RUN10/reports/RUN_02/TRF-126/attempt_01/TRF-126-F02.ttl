@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-F02/ship> ;
            sh:resultMessage "The ship must provide the required number of consecutive propulsion-engine starts according to whether reversal for astern movement is required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <nltl:generatedShape_TRF126> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-F02/ship> ] .

