@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Propulsion engine astern-reversal applicability must be recorded as true for this branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propulsionEngineReversedForAstern ], [ sh:datatype xsd:integer ; sh:message Literal(\"Air receiver capacity must provide at least 12 consecutive propulsion-engine starts when reversal for astern movement is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"12\", datatype=xsd:integer) ; sh:path nltl:airReceiverConsecutiveStartCapacity ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"Propulsion engine astern-reversal applicability must be recorded as false for this branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propulsionEngineReversedForAstern ], [ sh:datatype xsd:integer ; sh:message Literal(\"Air receiver capacity must provide at least 6 consecutive propulsion-engine starts when reversal for astern movement is not required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"6\", datatype=xsd:integer) ; sh:path nltl:airReceiverConsecutiveStartCapacity ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ a sh:NodeShape ;
                    sh:or ( [ sh:property [ sh:datatype xsd:integer ;
                                        sh:message "Air receiver capacity must provide at least 12 consecutive propulsion-engine starts when reversal for astern movement is required." ;
                                        sh:minCount 1 ;
                                        sh:minInclusive 12 ;
                                        sh:path nltl:airReceiverConsecutiveStartCapacity ],
                                    [ sh:datatype xsd:boolean ;
                                        sh:hasValue true ;
                                        sh:message "Propulsion engine astern-reversal applicability must be recorded as true for this branch." ;
                                        sh:minCount 1 ;
                                        sh:path nltl:propulsionEngineReversedForAstern ] ] [ sh:property [ sh:datatype xsd:boolean ;
                                        sh:hasValue false ;
                                        sh:message "Propulsion engine astern-reversal applicability must be recorded as false for this branch." ;
                                        sh:minCount 1 ;
                                        sh:path nltl:propulsionEngineReversedForAstern ],
                                    [ sh:datatype xsd:integer ;
                                        sh:message "Air receiver capacity must provide at least 6 consecutive propulsion-engine starts when reversal for astern movement is not required." ;
                                        sh:minCount 1 ;
                                        sh:minInclusive 6 ;
                                        sh:path nltl:airReceiverConsecutiveStartCapacity ] ] ) ;
                    sh:targetClass nltl:ship ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-F03/ship> ] .

