@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F01/ship> ;
            sh:resultMessage "When the air receiver serves an additional purpose, its capacity must be at least the required additional-purpose air capacity." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the air receiver serves an additional purpose, its capacity must be at least the required additional-purpose air capacity." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:airReceiverServesAdditionalPurpose true .
                $this nltl:airReceiverCapacity ?capacity .
                ?capacity qudt:numericValue ?capacityValue .
                $this nltl:additionalPurposeRequiredAirCapacity ?required .
                ?required qudt:numericValue ?requiredValue .
                FILTER (
                    ?capacityValue < ?requiredValue
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF127Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F01/ship> ] .

