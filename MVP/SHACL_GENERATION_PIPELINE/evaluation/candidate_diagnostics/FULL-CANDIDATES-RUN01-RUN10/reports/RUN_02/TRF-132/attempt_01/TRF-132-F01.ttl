@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F01/ship> ;
            sh:resultMessage "Maximum continuous rating power must be at least f1*f2*f3*(f4*Delta + P0), within a relative tolerance of 1e-6 with a 1e-6 kW absolute fallback; for ice classes IB and IC it must also be at least 740 kW." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Maximum continuous rating power must be at least f1*f2*f3*(f4*Delta + P0), within a relative tolerance of 1e-6 with a 1e-6 kW absolute fallback; for ice classes IB and IC it must also be at least 740 kW." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:engineOutputFormulaBasePowerP0 ?p0Node ;
                      nltl:engineOutputFormulaDisplacement ?deltaNode ;
                      nltl:engineOutputFormulaFactorF1 ?f1Node ;
                      nltl:engineOutputFormulaFactorF2 ?f2Node ;
                      nltl:engineOutputFormulaFactorF3 ?f3Node ;
                      nltl:engineOutputFormulaFactorF4 ?f4Node ;
                      nltl:maximumContinuousRatingPower ?actualNode .

                ?p0Node <http://qudt.org/schema/qudt/numericValue> ?p0 .
                ?deltaNode <http://qudt.org/schema/qudt/numericValue> ?delta .
                ?f1Node <http://qudt.org/schema/qudt/numericValue> ?f1 .
                ?f2Node <http://qudt.org/schema/qudt/numericValue> ?f2 .
                ?f3Node <http://qudt.org/schema/qudt/numericValue> ?f3 .
                ?f4Node <http://qudt.org/schema/qudt/numericValue> ?f4 .
                ?actualNode <http://qudt.org/schema/qudt/numericValue> ?actual .

                BIND (?f1 * ?f2 * ?f3 * (?f4 * ?delta + ?p0) AS ?expected)
                BIND (IF(ABS(?expected) * 0.000001 > 0.000001,
                         ABS(?expected) * 0.000001,
                         0.000001) AS ?tolerance)

                FILTER (
                    (
                        (?iceClass = nltl:iceClassIb ||
                         ?iceClass = nltl:iceClassIc) &&
                        ?actual < 740
                    ) ||
                    ?actual + ?tolerance < ?expected
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-132-EngineOutput> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F01/ship> ] .

