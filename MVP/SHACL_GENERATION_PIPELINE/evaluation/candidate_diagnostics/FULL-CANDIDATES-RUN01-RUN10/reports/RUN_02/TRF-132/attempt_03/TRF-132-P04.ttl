@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-P04/ship> ;
            sh:resultMessage "Maximum continuous rating power must be no less than f1*f2*f3*(f4*Delta + P0), within the permitted numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Maximum continuous rating power must be no less than f1*f2*f3*(f4*Delta + P0), within the permitted numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:engineOutputFormulaBasePowerP0 ?p0Quantity ;
                       nltl:engineOutputFormulaDisplacement ?deltaQuantity ;
                       nltl:engineOutputFormulaFactorF1 ?f1Quantity ;
                       nltl:engineOutputFormulaFactorF2 ?f2Quantity ;
                       nltl:engineOutputFormulaFactorF3 ?f3Quantity ;
                       nltl:engineOutputFormulaFactorF4 ?f4Quantity ;
                       nltl:maximumContinuousRatingPower ?actualQuantity .

                ?p0Quantity qudt:numericValue ?p0 .
                ?deltaQuantity qudt:numericValue ?delta .
                ?f1Quantity qudt:numericValue ?f1 .
                ?f2Quantity qudt:numericValue ?f2 .
                ?f3Quantity qudt:numericValue ?f3 .
                ?f4Quantity qudt:numericValue ?f4 .
                ?actualQuantity qudt:numericValue ?actual .

                BIND ((?f1 * ?f2 * ?f3) * ((?f4 * ?delta) + ?p0) AS ?expected)
                FILTER (
                    ?actual +
                    (ABS(?expected) * "0.000001"^^xsd:decimal) +
                    "0.000001"^^xsd:decimal
                    < ?expected
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF132ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-P04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-P04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:iceClassIb ; sh:path nltl:iceClass ], gen:PowerAtLeast740Shape ] , [ sh:property [ sh:hasValue nltl:iceClassIc ; sh:path nltl:iceClass ], gen:PowerAtLeast740Shape ] , [ sh:sparql [ sh:message Literal("For ice classes other than IB and IC, the ice class must be explicitly represented.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER (?iceClass NOT IN (nltl:iceClassIb, nltl:iceClassIc))
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF132ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-P04/ship> ] .

