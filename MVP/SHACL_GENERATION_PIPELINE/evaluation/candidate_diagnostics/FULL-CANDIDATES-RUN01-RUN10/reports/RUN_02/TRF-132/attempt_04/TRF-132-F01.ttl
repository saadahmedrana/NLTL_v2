@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F01/ship> ;
            sh:resultMessage "Maximum continuous rating power must be no less than the declared engine-output formula result, within an expected-result-scaled tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Maximum continuous rating power must be no less than the declared engine-output formula result, within an expected-result-scaled tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:engineOutputFormulaBasePowerP0 ?p0Node ;
                      nltl:engineOutputFormulaDisplacement ?deltaNode ;
                      nltl:engineOutputFormulaFactorF1 ?f1Node ;
                      nltl:engineOutputFormulaFactorF2 ?f2Node ;
                      nltl:engineOutputFormulaFactorF3 ?f3Node ;
                      nltl:engineOutputFormulaFactorF4 ?f4Node ;
                      nltl:maximumContinuousRatingPower ?actualNode .
                ?p0Node qudt:numericValue ?p0 .
                ?deltaNode qudt:numericValue ?delta .
                ?f1Node qudt:numericValue ?f1 .
                ?f2Node qudt:numericValue ?f2 .
                ?f3Node qudt:numericValue ?f3 .
                ?f4Node qudt:numericValue ?f4 .
                ?actualNode qudt:numericValue ?actual .
                BIND ((?f1 * ?f2 * ?f3) * ((?f4 * ?delta) + ?p0) AS ?expected)
                BIND (IF(?expected >= 0, ?expected, -?expected) AS ?expectedMagnitude)
                BIND (IF(?expectedMagnitude >= 1, ?expectedMagnitude * 0.000001, 0.000001) AS ?tolerance)
                FILTER (?actual < (?expected - ?tolerance))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF132EngineOutputShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F01/ship> ] .

