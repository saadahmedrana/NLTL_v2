@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-P02/ship> ;
            sh:resultMessage "The upper ice waterline displacement must equal the greatest displacement among the linked upper ice waterline cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The upper ice waterline displacement must equal the greatest displacement among the linked upper ice waterline cases." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?resultQuantity .
                ?resultQuantity qudt:numericValue ?resultValue .
                $this nltl:hasUpperIceWaterlineCase ?case .

                FILTER (
                    EXISTS {
                        ?case nltl:waterlineCaseDisplacement ?greaterQuantity .
                        ?greaterQuantity qudt:numericValue ?greaterValue .
                        FILTER (?greaterValue > ?resultValue)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:waterlineCaseDisplacement ?matchingQuantity .
                        ?matchingQuantity qudt:numericValue ?matchingValue .
                        FILTER (?matchingValue = ?resultValue)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-004-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-P02/ship> ] .

