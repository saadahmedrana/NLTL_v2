@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F03/ship> ;
            sh:resultMessage "When astern ice operation is intended, the aft section design basis and hull area requirement set must specify the Bow and Bow Intermediate hull area requirements." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When astern ice operation is intended, the aft section design basis and hull area requirement set must specify the Bow and Bow Intermediate hull area requirements." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:asternIceOperationIntent true .
                FILTER NOT EXISTS {
                    $this nltl:aftSectionDesignBasis "Bow and Bow Intermediate hull area requirements" .
                    $this nltl:hullAreaRequirementSet "Bow and Bow Intermediate hull area requirements" .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape [ a sh:NodeShape ;
                    sh:sparql [ a sh:SPARQLConstraint ;
                            sh:message "When astern ice operation is intended, the aft section design basis and hull area requirement set must specify the Bow and Bow Intermediate hull area requirements." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:asternIceOperationIntent true .
                FILTER NOT EXISTS {
                    $this nltl:aftSectionDesignBasis "Bow and Bow Intermediate hull area requirements" .
                    $this nltl:hullAreaRequirementSet "Bow and Bow Intermediate hull area requirements" .
                }
            }
        """ ] ;
                    sh:targetClass nltl:ship ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F03/ship> ] .

