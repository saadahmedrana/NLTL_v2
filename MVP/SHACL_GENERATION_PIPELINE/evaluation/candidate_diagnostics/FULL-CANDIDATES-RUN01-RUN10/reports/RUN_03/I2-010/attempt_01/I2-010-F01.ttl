@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F01/ship> ;
            sh:resultMessage "Design ice force applicability requires Polar Class PC6 or PC7 and a vertical-sided bow, including the permitted normal frame angle range from 0 to 10 degrees." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-010> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F01/ship> ] .

