@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F04/ship> ;
            sh:resultMessage "For a PC6 or PC7 ship with a bulbous bow, the bow design force must be at least both applicable method forces." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a PC6 or PC7 ship with a bulbous bow, the bow design force must be at least both applicable method forces." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:bulbousBowPresent true ;
                      nltl:polarClass ?polarClass ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiQuantity ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivQuantity ;
                      nltl:bowDesignForce ?resultQuantity .

                FILTER (?polarClass IN (
                    nltl:polarClassPc6,
                    nltl:polarClassPc7
                ))

                ?iiiQuantity qudt:numericValue ?iii .
                ?ivQuantity qudt:numericValue ?iv .
                ?resultQuantity qudt:numericValue ?result .

                FILTER (
                    (?result < (?iii * 1000)) ||
                    (?result < (?iv * 1000))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:I2_011_BowDesignForceShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F04/ship> ] .

