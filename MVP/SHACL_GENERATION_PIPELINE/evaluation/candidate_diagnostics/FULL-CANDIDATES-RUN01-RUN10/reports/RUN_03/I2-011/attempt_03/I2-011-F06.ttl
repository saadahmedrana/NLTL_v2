@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F06/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:bulbousBowPresent ], [ sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ; sh:path nltl:polarClass ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("For an applicable ship, loadPatchAspectRatio must be AR = 1.3.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxInclusive Literal("1.3", datatype=xsd:decimal) ; sh:minInclusive Literal("1.3", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:loadPatchAspectRatio ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("For an applicable ship, shapeCoefficient must encode fa = 0.6.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxInclusive Literal("0.6", datatype=xsd:decimal) ; sh:minInclusive Literal("0.6", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:shapeCoefficient ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The bow design force must be reported in kN.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:bowDesignForce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ] ; sh:sparql [ sh:message Literal("For an applicable ship, bowDesignForce must be determined by method (iv), within scaled tolerance, and must not be less than the method (iii) result using fa = 0.6 and AR = 1.3.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:shapeCoefficient ?faNode ;
                              nltl:loadPatchAspectRatio ?arNode ;
                              nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiNode ;
                              nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivNode ;
                              nltl:bowDesignForce ?forceNode .

                        ?faNode <http://qudt.org/schema/qudt/numericValue> ?fa .
                        ?arNode <http://qudt.org/schema/qudt/numericValue> ?ar .
                        ?iiiNode <http://qudt.org/schema/qudt/numericValue> ?iii .
                        ?ivNode <http://qudt.org/schema/qudt/numericValue> ?iv .
                        ?forceNode <http://qudt.org/schema/qudt/numericValue> ?force .

                        BIND ((?iii * (?fa / 0.6) * (?ar / 1.3)) * 1000 AS ?expectedIiiKiloN)
                        BIND (?iv * 1000 AS ?expectedIvKiloN)
                        BIND (1e-6 * IF(?expectedIvKiloN >= 0, ?expectedIvKiloN, -?expectedIvKiloN) + 1e-9 AS ?tolerance)

                        FILTER (
                            ?force < (?expectedIiiKiloN) ||
                            ?force < (?expectedIvKiloN - ?tolerance) ||
                            ?force > (?expectedIvKiloN + ?tolerance)
                        )
                    }
                ") ] ] , [ sh:or ( [ sh:property [ sh:in ( nltl:polarClassPc1 nltl:polarClassPc2 nltl:polarClassPc3 nltl:polarClassPc4 nltl:polarClassPc5 ) ; sh:path nltl:polarClass ] ] [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:bulbousBowPresent ] ] ) ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:I2_011_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F06/ship> ] .

