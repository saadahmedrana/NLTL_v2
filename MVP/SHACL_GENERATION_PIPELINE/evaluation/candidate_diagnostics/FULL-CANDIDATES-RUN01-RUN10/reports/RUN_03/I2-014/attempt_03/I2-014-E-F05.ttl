@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowLength" ;
            sh:resultPath nltl:bowLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:bowLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "Selected bow force, line load, and pressure must equal the corresponding calculated maximum within the permitted decimal tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Selected bow force, line load, and pressure must equal the corresponding calculated maximum within the permitted decimal tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?sfq ;
                      nltl:selectedMaximumBowLineLoad ?sqlq ;
                      nltl:selectedMaximumBowPressure ?spq ;
                      nltl:hasBowSubregionCalculationCase ?case .

                ?sfq qudt:numericValue ?sf .
                ?sqlq qudt:numericValue ?sql .
                ?spq qudt:numericValue ?sp .

                ?case nltl:bowSubregionCalculatedForce ?fq ;
                      nltl:bowSubregionCalculatedLineLoad ?qlq ;
                      nltl:bowSubregionCalculatedPressure ?pq .
                ?fq qudt:numericValue ?f .
                ?qlq qudt:numericValue ?q .
                ?pq qudt:numericValue ?p .
            }
            GROUP BY $this ?sf ?sql ?sp
            HAVING (
                (
                    ABS(?sf - MAX(?f)) > (0.000001 * ABS(MAX(?f)))
                    && ABS(?sf - MAX(?f)) > 0.000000001
                )
                ||
                (
                    ABS(?sql - MAX(?q)) > (0.000001 * ABS(MAX(?q)))
                    && ABS(?sql - MAX(?q)) > 0.000000001
                )
                ||
                (
                    ABS(?sp - MAX(?p)) > (0.000001 * ABS(MAX(?p)))
                    && ABS(?sp - MAX(?p)) > 0.000000001
                )
            )
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_014_BowSubregionShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowSubregionCount" ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:maxInclusive 4 ;
                    sh:minCount 1 ;
                    sh:minInclusive 4 ;
                    sh:path nltl:bowSubregionCount ] ] .

