@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/ship> ;
            sh:resultMessage "The ship must provide beta i prime with a dimensionless unit." ;
            sh:resultPath nltl:betaIPrime ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide beta i prime with a dimensionless unit." ;
                    sh:minCount 1 ;
                    sh:node gs:QuantityDimensionless ;
                    sh:path nltl:betaIPrime ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/factorLookup> ;
                            sh:resultMessage "Each failure-class lookup case must provide one flexural failure class factor with a dimensionless unit." ;
                            sh:resultPath nltl:flexuralFailureClassFactor ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each failure-class lookup case must provide one flexural failure class factor with a dimensionless unit." ;
                                    sh:minCount 1 ;
                                    sh:node gs:QuantityDimensionless ;
                                    sh:path nltl:flexuralFailureClassFactor ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/bowCase> ;
                    sh:resultMessage "The applicable bow subregion case must link to its failure-class factor lookup case." ;
                    sh:resultPath nltl:hasFailureClassFactorLookupCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The applicable bow subregion case must link to its failure-class factor lookup case." ;
                            sh:minCount 1 ;
                            sh:node gs:FailureClassFactorLookupCaseShape ;
                            sh:path nltl:hasFailureClassFactorLookupCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/factorLookup> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/ship> ;
            sh:resultMessage "The ship must provide an applicable bow subregion calculation case for this requirement." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide an applicable bow subregion calculation case for this requirement." ;
                    sh:minCount 1 ;
                    sh:node gs:BowSubregionCalculationCaseShape ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/bowCase> ] .

