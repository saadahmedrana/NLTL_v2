@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F02/bowCase> ;
            sh:resultMessage "The linked ship must provide the upper ice waterline length." ;
            sh:resultPath ( [ sh:inversePath nltl:hasBowSubregionCalculationCase ] nltl:upperIceWaterlineLengthLUI ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The linked ship must provide the upper ice waterline length." ;
                    sh:minCount 1 ;
                    sh:node gen:QuantityValueLengthShape ;
                    sh:path ( [ sh:inversePath nltl:hasBowSubregionCalculationCase ] nltl:upperIceWaterlineLengthLUI ) ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F02/bowCase> ;
            sh:resultMessage "The linked ship must provide beta i prime." ;
            sh:resultPath ( [ sh:inversePath nltl:hasBowSubregionCalculationCase ] nltl:betaIPrime ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The linked ship must provide beta i prime." ;
                    sh:minCount 1 ;
                    sh:node gen:QuantityValueDimensionlessShape ;
                    sh:path ( [ sh:inversePath nltl:hasBowSubregionCalculationCase ] nltl:betaIPrime ) ] ] .

