@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F07/bowCase> ;
            sh:resultMessage "The linked ship must provide beta i prime." ;
            sh:resultPath ( [ sh:inversePath nltl:hasBowSubregionCalculationCase ] nltl:betaIPrime ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The linked ship must provide beta i prime." ;
                    sh:minCount 1 ;
                    sh:node gen:QuantityValueDimensionlessShape ;
                    sh:path ( [ sh:inversePath nltl:hasBowSubregionCalculationCase ] nltl:betaIPrime ) ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F07/bowCase> ;
            sh:resultMessage "The applicable bow-subregion case must provide the externally computed bow shape coefficient." ;
            sh:resultPath nltl:bowShapeCoefficient ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The applicable bow-subregion case must provide the externally computed bow shape coefficient." ;
                    sh:minCount 1 ;
                    sh:node gen:QuantityValueDimensionlessShape ;
                    sh:path nltl:bowShapeCoefficient ] ] .

