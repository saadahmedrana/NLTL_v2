@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/ship> ;
                    sh:resultMessage "Less than 1 values on ex:ship->nltl:betaIPrime" ;
                    sh:resultPath nltl:betaIPrime ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node gen:DecimalUnitlessQuantityShape ;
                            sh:path nltl:betaIPrime ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/bowCase> ;
            sh:resultMessage "Value does not conform to Shape gen:ShipInputsShape. See details for more information." ;
            sh:resultPath [ sh:inversePath nltl:hasBowSubregionCalculationCase ] ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:ShipInputsShape ;
                    sh:path [ sh:inversePath nltl:hasBowSubregionCalculationCase ] ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/factorLookup> ;
                    sh:resultMessage "Less than 1 values on ex:factorLookup->nltl:crushingFailureClassFactor" ;
                    sh:resultPath nltl:crushingFailureClassFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node gen:DecimalUnitlessQuantityShape ;
                            sh:path nltl:crushingFailureClassFactor ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/bowCase> ;
            sh:resultMessage "Value does not conform to Shape gen:FailureClassFactorLookupShape. See details for more information." ;
            sh:resultPath nltl:hasFailureClassFactorLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:FailureClassFactorLookupShape ;
                    sh:path nltl:hasFailureClassFactorLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/factorLookup> ] .

