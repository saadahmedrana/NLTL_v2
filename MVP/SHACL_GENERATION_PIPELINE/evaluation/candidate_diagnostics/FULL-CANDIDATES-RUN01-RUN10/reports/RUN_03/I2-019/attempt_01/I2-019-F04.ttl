@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/member> ;
                    sh:resultMessage "The selected hull area factor must equal the largest hull area factor among the areas spanned by the structural member." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "The selected hull area factor must equal the largest hull area factor among the areas spanned by the structural member." ;
                            sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:selectedHullAreaFactor ?selectedNode ;
                              nltl:hasSpannedHullArea ?area .
                        ?selectedNode qudt:numericValue ?selected .
                        ?area nltl:hullAreaFactor ?factor .
                        ?factor qudt:numericValue ?operand .
                        FILTER (
                            ?operand > ?selected ||
                            NOT EXISTS {
                                $this nltl:hasSpannedHullArea ?equalArea .
                                ?equalArea nltl:hullAreaFactor ?equalFactor .
                                ?equalFactor qudt:numericValue ?equal .
                                FILTER (?equal = ?selected)
                            }
                        )
                    }
                """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:structuralMember ;
                            sh:property [ sh:node [ sh:class nltl:hullAreaValue ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ sh:class qudt:QuantityValue ;
                                                            sh:property [ ],
                                                                [ ] ] ;
                                                    sh:path nltl:hullAreaFactor ] ] ;
                                    sh:path nltl:hasSpannedHullArea ],
                                [ sh:maxCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:selectedHullAreaFactor ] ;
                            sh:sparql [ sh:message "The selected hull area factor must equal the largest hull area factor among the areas spanned by the structural member." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:selectedHullAreaFactor ?selectedNode ;
                              nltl:hasSpannedHullArea ?area .
                        ?selectedNode qudt:numericValue ?selected .
                        ?area nltl:hullAreaFactor ?factor .
                        ?factor qudt:numericValue ?operand .
                        FILTER (
                            ?operand > ?selected ||
                            NOT EXISTS {
                                $this nltl:hasSpannedHullArea ?equalArea .
                                ?equalArea nltl:hullAreaFactor ?equalFactor .
                                ?equalFactor qudt:numericValue ?equal .
                                FILTER (?equal = ?selected)
                            }
                        )
                    }
                """ ],
                                [ sh:message "A structural member spanning one or more hull areas must have a selected hull area factor." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasSpannedHullArea ?area .
                        ?area nltl:hullAreaFactor ?factor .
                        ?factor qudt:numericValue ?operand .
                        FILTER NOT EXISTS {
                            $this nltl:selectedHullAreaFactor ?selected .
                            ?selected qudt:numericValue ?result .
                        }
                    }
                """ ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/member> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/area2> ;
                            sh:resultMessage "Less than 1 values on ex:area2->nltl:hullAreaFactor" ;
                            sh:resultPath nltl:hullAreaFactor ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:hullAreaFactor ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/member> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:hullAreaValue ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:hullAreaFactor ] ]. See details for more information." ;
                    sh:resultPath nltl:hasSpannedHullArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node [ sh:class nltl:hullAreaValue ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:class qudt:QuantityValue ;
                                                    sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ],
                                                        [ sh:hasValue unit:UNITLESS ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ] ] ;
                                            sh:path nltl:hullAreaFactor ] ] ;
                            sh:path nltl:hasSpannedHullArea ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/area2> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:class nltl:structuralMember ; sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:selectedHullAreaFactor ], [ sh:node [ sh:class nltl:hullAreaValue ; sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:hullAreaFactor ] ] ; sh:path nltl:hasSpannedHullArea ] ; sh:sparql [ sh:message Literal("A structural member spanning one or more hull areas must have a selected hull area factor.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasSpannedHullArea ?area .
                        ?area nltl:hullAreaFactor ?factor .
                        ?factor qudt:numericValue ?operand .
                        FILTER NOT EXISTS {
                            $this nltl:selectedHullAreaFactor ?selected .
                            ?selected qudt:numericValue ?result .
                        }
                    }
                ") ], [ sh:message Literal("The selected hull area factor must equal the largest hull area factor among the areas spanned by the structural member.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:selectedHullAreaFactor ?selectedNode ;
                              nltl:hasSpannedHullArea ?area .
                        ?selectedNode qudt:numericValue ?selected .
                        ?area nltl:hullAreaFactor ?factor .
                        ?factor qudt:numericValue ?operand .
                        FILTER (
                            ?operand > ?selected ||
                            NOT EXISTS {
                                $this nltl:hasSpannedHullArea ?equalArea .
                                ?equalArea nltl:hullAreaFactor ?equalFactor .
                                ?equalFactor qudt:numericValue ?equal .
                                FILTER (?equal = ?selected)
                            }
                        )
                    }
                ") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:structuralMember ;
                            sh:property [ sh:node [ sh:class nltl:hullAreaValue ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:hullAreaFactor ] ] ;
                                    sh:path nltl:hasSpannedHullArea ],
                                [ sh:maxCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:selectedHullAreaFactor ] ;
                            sh:sparql [ sh:message "A structural member spanning one or more hull areas must have a selected hull area factor." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasSpannedHullArea ?area .
                        ?area nltl:hullAreaFactor ?factor .
                        ?factor qudt:numericValue ?operand .
                        FILTER NOT EXISTS {
                            $this nltl:selectedHullAreaFactor ?selected .
                            ?selected qudt:numericValue ?result .
                        }
                    }
                """ ],
                                [ sh:message "The selected hull area factor must equal the largest hull area factor among the areas spanned by the structural member." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:selectedHullAreaFactor ?selectedNode ;
                              nltl:hasSpannedHullArea ?area .
                        ?selectedNode qudt:numericValue ?selected .
                        ?area nltl:hullAreaFactor ?factor .
                        ?factor qudt:numericValue ?operand .
                        FILTER (
                            ?operand > ?selected ||
                            NOT EXISTS {
                                $this nltl:hasSpannedHullArea ?equalArea .
                                ?equalArea nltl:hullAreaFactor ?equalFactor .
                                ?equalFactor qudt:numericValue ?equal .
                                FILTER (?equal = ?selected)
                            }
                        )
                    }
                """ ] ] ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/member> ] .

