@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/ship> ;
            sh:resultMessage "For each plating item, thickness must equal ice-load required net plate thickness plus corrosion and abrasion allowance, converted from millimetres to metres within numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For each plating item, thickness must equal ice-load required net plate thickness plus corrosion and abrasion allowance, converted from millimetres to metres within numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this
            WHERE {
                $this nltl:hasPlating ?plating .
                ?plating nltl:iceLoadRequiredNetPlateThickness ?tnetQuantity ;
                         nltl:corrosionAbrasionAllowance ?allowanceQuantity ;
                         nltl:thickness ?thicknessQuantity .
                ?tnetQuantity qudt:numericValue ?tnet ;
                              qudt:unit unit:MilliM .
                ?allowanceQuantity qudt:numericValue ?allowance ;
                                   qudt:unit unit:MilliM .
                ?thicknessQuantity qudt:numericValue ?thickness ;
                                  qudt:unit unit:M .

                BIND((?tnet + ?allowance) / 1000 AS ?expected)
                BIND(?thickness - ?expected AS ?difference)
                BIND(IF(?difference < 0, 0 - ?difference, ?difference) AS ?absoluteDifference)
                BIND(IF(?expected < 0, 0 - ?expected, ?expected) AS ?absoluteExpected)
                BIND(IF(?absoluteExpected > 0,
                        ?absoluteExpected * 0.000001,
                        0.000001) AS ?tolerance)
                FILTER(?absoluteDifference > ?tolerance)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_021_ShellPlateThicknessShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/ship> ] .

