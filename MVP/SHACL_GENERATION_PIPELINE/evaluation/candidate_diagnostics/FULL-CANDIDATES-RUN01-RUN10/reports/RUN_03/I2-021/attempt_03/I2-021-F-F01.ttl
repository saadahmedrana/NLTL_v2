@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/plating> ;
                    sh:resultMessage "Thickness must equal the ice-load net plate thickness plus the corrosion and abrasion allowance, converted from millimetres to metres." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Thickness must equal the ice-load net plate thickness plus the corrosion and abrasion allowance, converted from millimetres to metres." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadRequiredNetPlateThickness ?tnetNode ;
                      nltl:corrosionAbrasionAllowance ?tsNode ;
                      nltl:thickness ?thicknessNode .
                ?tnetNode qudt:numericValue ?tnet .
                ?tsNode qudt:numericValue ?ts .
                ?thicknessNode qudt:numericValue ?reported .
                BIND((?tnet + ?ts) / 1000 AS ?expected)
                BIND((?expected - ?reported) AS ?difference)
                BIND(IF(?difference < 0, 0 - ?difference, ?difference) AS ?absoluteDifference)
                BIND(IF(?expected < 0, 0 - ?expected, ?expected) AS ?absoluteExpected)
                BIND(IF(?absoluteExpected > 0.000001,
                        0.000001 * ?absoluteExpected,
                        0.000001) AS ?tolerance)
                FILTER(?absoluteDifference > ?tolerance)
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_021_PlatingShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_021_PlatingShape. See details for more information." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:I2_021_PlatingShape ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/plating> ] .

