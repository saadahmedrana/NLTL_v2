@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/plating> ;
                    sh:resultMessage "Applicable longitudinally-framed plating shall have a supporting structural member with spacing and selected hull area factor, and an externally computed net plate thickness result." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Applicable longitudinally-framed plating shall have a supporting structural member with spacing and selected hull area factor, and an externally computed net plate thickness result." ;
                            sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:framingAngleOmega ?omega .
                        ?omega qudt:numericValue ?angle .
                        FILTER (?angle <= 20)
                        FILTER (
                            NOT EXISTS {
                                $this nltl:platingSupportedByStructuralMember ?member .
                                ?member a nltl:structuralMember .
                            }
                            ||
                            EXISTS {
                                $this nltl:platingSupportedByStructuralMember ?member .
                                ?member a nltl:structuralMember .
                                FILTER NOT EXISTS {
                                    ?member nltl:frameSpacing ?spacing .
                                    ?spacing qudt:numericValue ?spacingValue .
                                    ?spacing qudt:unit <http://qudt.org/vocab/unit/M> .
                                }
                            }
                            ||
                            EXISTS {
                                $this nltl:platingSupportedByStructuralMember ?member .
                                ?member a nltl:structuralMember .
                                FILTER NOT EXISTS {
                                    ?member nltl:selectedHullAreaFactor ?factor .
                                    ?factor qudt:numericValue ?factorValue .
                                    ?factor qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                }
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:iceLoadRequiredNetPlateThickness ?result .
                                ?result qudt:numericValue ?resultValue .
                                ?result qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                            }
                        )
                    }
                """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:plating ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:framingAngleOmega ] ;
                            sh:sparql [ sh:message "Applicable longitudinally-framed plating shall have a supporting structural member with spacing and selected hull area factor, and an externally computed net plate thickness result." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:framingAngleOmega ?omega .
                        ?omega qudt:numericValue ?angle .
                        FILTER (?angle <= 20)
                        FILTER (
                            NOT EXISTS {
                                $this nltl:platingSupportedByStructuralMember ?member .
                                ?member a nltl:structuralMember .
                            }
                            ||
                            EXISTS {
                                $this nltl:platingSupportedByStructuralMember ?member .
                                ?member a nltl:structuralMember .
                                FILTER NOT EXISTS {
                                    ?member nltl:frameSpacing ?spacing .
                                    ?spacing qudt:numericValue ?spacingValue .
                                    ?spacing qudt:unit <http://qudt.org/vocab/unit/M> .
                                }
                            }
                            ||
                            EXISTS {
                                $this nltl:platingSupportedByStructuralMember ?member .
                                ?member a nltl:structuralMember .
                                FILTER NOT EXISTS {
                                    ?member nltl:selectedHullAreaFactor ?factor .
                                    ?factor qudt:numericValue ?factorValue .
                                    ?factor qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                }
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:iceLoadRequiredNetPlateThickness ?result .
                                ?result qudt:numericValue ?resultValue .
                                ?result qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                            }
                        )
                    }
                """ ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:class nltl:plating ; sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:framingAngleOmega ] ; sh:sparql [ sh:message Literal("Applicable longitudinally-framed plating shall have a supporting structural member with spacing and selected hull area factor, and an externally computed net plate thickness result.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:framingAngleOmega ?omega .
                        ?omega qudt:numericValue ?angle .
                        FILTER (?angle <= 20)
                        FILTER (
                            NOT EXISTS {
                                $this nltl:platingSupportedByStructuralMember ?member .
                                ?member a nltl:structuralMember .
                            }
                            ||
                            EXISTS {
                                $this nltl:platingSupportedByStructuralMember ?member .
                                ?member a nltl:structuralMember .
                                FILTER NOT EXISTS {
                                    ?member nltl:frameSpacing ?spacing .
                                    ?spacing qudt:numericValue ?spacingValue .
                                    ?spacing qudt:unit <http://qudt.org/vocab/unit/M> .
                                }
                            }
                            ||
                            EXISTS {
                                $this nltl:platingSupportedByStructuralMember ?member .
                                ?member a nltl:structuralMember .
                                FILTER NOT EXISTS {
                                    ?member nltl:selectedHullAreaFactor ?factor .
                                    ?factor qudt:numericValue ?factorValue .
                                    ?factor qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                }
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:iceLoadRequiredNetPlateThickness ?result .
                                ?result qudt:numericValue ?resultValue .
                                ?result qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                            }
                        )
                    }
                ") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:plating ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:framingAngleOmega ] ;
                            sh:sparql [ sh:message "Applicable longitudinally-framed plating shall have a supporting structural member with spacing and selected hull area factor, and an externally computed net plate thickness result." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:framingAngleOmega ?omega .
                        ?omega qudt:numericValue ?angle .
                        FILTER (?angle <= 20)
                        FILTER (
                            NOT EXISTS {
                                $this nltl:platingSupportedByStructuralMember ?member .
                                ?member a nltl:structuralMember .
                            }
                            ||
                            EXISTS {
                                $this nltl:platingSupportedByStructuralMember ?member .
                                ?member a nltl:structuralMember .
                                FILTER NOT EXISTS {
                                    ?member nltl:frameSpacing ?spacing .
                                    ?spacing qudt:numericValue ?spacingValue .
                                    ?spacing qudt:unit <http://qudt.org/vocab/unit/M> .
                                }
                            }
                            ||
                            EXISTS {
                                $this nltl:platingSupportedByStructuralMember ?member .
                                ?member a nltl:structuralMember .
                                FILTER NOT EXISTS {
                                    ?member nltl:selectedHullAreaFactor ?factor .
                                    ?factor qudt:numericValue ?factorValue .
                                    ?factor qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                }
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:iceLoadRequiredNetPlateThickness ?result .
                                ?result qudt:numericValue ?resultValue .
                                ?result qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                            }
                        )
                    }
                """ ] ] ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchHeight" ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:averageIcePressure" ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:peakPressureFactor" ;
            sh:resultPath nltl:peakPressureFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:peakPressureFactor ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:frameSpan" ;
            sh:resultPath nltl:frameSpan ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:frameSpan ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:yieldStrength" ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:yieldStrength ] ] .

