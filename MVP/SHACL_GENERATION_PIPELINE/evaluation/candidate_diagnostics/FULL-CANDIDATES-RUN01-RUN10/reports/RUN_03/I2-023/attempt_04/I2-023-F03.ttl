@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship must provide one average ice pressure QuantityValue in MPa." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one average ice pressure QuantityValue in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship must provide one dimensionless peak pressure factor." ;
            sh:resultPath nltl:peakPressureFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one dimensionless peak pressure factor." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:peakPressureFactor ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship must provide one yield strength QuantityValue in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one yield strength QuantityValue in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:yieldStrength ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/plating> ;
                    sh:resultMessage "Applicable plating must provide one externally computed net plate thickness QuantityValue in millimetres." ;
                    sh:resultPath nltl:iceLoadRequiredNetPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Applicable plating must provide one externally computed net plate thickness QuantityValue in millimetres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:iceLoadRequiredNetPlateThickness ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship must provide the plating path required for the external net-thickness calculation." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the plating path required for the external net-thickness calculation." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:plating ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "Each applicable plating must identify one supporting structural member." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:structuralMember ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:message "The supporting structural member must provide one frame spacing QuantityValue in metres." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:frameSpacing ],
                                                [ sh:maxCount 1 ;
                                                    sh:message "The supporting structural member must provide one dimensionless selected hull area factor." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:selectedHullAreaFactor ] ] ;
                                    sh:path nltl:platingSupportedByStructuralMember ],
                                [ sh:maxCount 1 ;
                                    sh:message "Applicable plating must have one framing angle Omega not exceeding 20 degrees." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:maxInclusive 20 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:framingAngleOmega ],
                                [ sh:maxCount 1 ;
                                    sh:message "Applicable plating must provide one externally computed net plate thickness QuantityValue in millimetres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:iceLoadRequiredNetPlateThickness ] ] ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship must provide one frame span QuantityValue in metres." ;
            sh:resultPath nltl:frameSpan ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one frame span QuantityValue in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:frameSpan ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship must provide one load patch height QuantityValue in metres." ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one load patch height QuantityValue in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:loadPatchHeight ] ] .

