                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F02/case> ;
                    sh:resultMessage """Node ex:case must conform to one or more shapes in [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2-024-InterpolationPointShape> ; sh:path nltl:interpolationLowerEndpoint ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2-024-InterpolationPointShape> ; sh:path nltl:interpolationUpperEndpoint ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:interpolatedNetPlateThickness ] ; sh:sparql [ sh:message Literal("An interpolation case with 20 degrees < framing angle < 70 degrees must contain its interpolation endpoints and interpolated net plate thickness.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:framingAngle ?angle .
                        ?angle qudt:numericValue ?value .
                        FILTER (?value <= 20 || ?value >= 70)
                    }
                ") ] ] , [ sh:sparql [ sh:message Literal("Linear interpolation is required only when 20 degrees < framing angle < 70 degrees; an applicable angle requires the interpolation structure.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:framingAngle ?angle .
                        ?angle qudt:numericValue ?value .
                        FILTER (?value > 20 && ?value < 70)
                    }
                ") ] ]""" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-024-ObliqueCaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F02/case> ] ;
