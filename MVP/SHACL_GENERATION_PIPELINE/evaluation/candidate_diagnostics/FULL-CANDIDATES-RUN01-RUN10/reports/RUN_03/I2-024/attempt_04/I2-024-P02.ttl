@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/ship> ;
            sh:resultMessage "For an applicable oblique-plating case, the ship must provide at least one linked calculation case with exactly one longitudinal and one transverse framing net plate thickness, both in millimetres." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an applicable oblique-plating case, the ship must provide at least one linked calculation case with exactly one longitudinal and one transverse framing net plate thickness, both in millimetres." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasObliquePlatingInterpolationCase ?obliqueCase .
                ?obliqueCase nltl:framingAngle ?angle .
                ?angle qudt:numericValue ?angleValue .
                ?angle qudt:unit <http://qudt.org/vocab/unit/DEG> .
                FILTER(datatype(?angleValue) = xsd:decimal)
                FILTER(?angleValue > 20 && ?angleValue < 70)

                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?calculationCase .
                    ?calculationCase nltl:longitudinalFramingNetPlateThickness ?longitudinal .
                    ?longitudinal qudt:numericValue ?longitudinalValue .
                    ?longitudinal qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    FILTER(datatype(?longitudinalValue) = xsd:decimal)
                    ?calculationCase nltl:transverseFramingNetPlateThickness ?transverse .
                    ?transverse qudt:numericValue ?transverseValue .
                    ?transverse qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    FILTER(datatype(?transverseValue) = xsd:decimal)
                    FILTER NOT EXISTS {
                        ?calculationCase nltl:longitudinalFramingNetPlateThickness ?longitudinalOther .
                        FILTER(?longitudinalOther != ?longitudinal)
                    }
                    FILTER NOT EXISTS {
                        ?calculationCase nltl:transverseFramingNetPlateThickness ?transverseOther .
                        FILTER(?transverseOther != ?transverse)
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-024-applicable-calculation-case-shape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/ship> ] .

