@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F01/calc> ;
                    sh:resultMessage "The calculation case shall identify its lower interpolation endpoint." ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:maxCount 1 ;
                            sh:message "The calculation case shall identify its lower interpolation endpoint." ;
                            sh:minCount 1 ;
                            sh:node g:InterpolationPointShape ;
                            sh:path nltl:interpolationLowerEndpoint ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F01/calc> ;
                    sh:resultMessage "The calculation case shall identify its upper interpolation endpoint." ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:maxCount 1 ;
                            sh:message "The calculation case shall identify its upper interpolation endpoint." ;
                            sh:minCount 1 ;
                            sh:node g:InterpolationPointShape ;
                            sh:path nltl:interpolationUpperEndpoint ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F01/member> ;
                            sh:resultMessage "Less than 1 values on ex:member->nltl:netLocalFrameFlangeArea" ;
                            sh:resultPath nltl:netLocalFrameFlangeArea ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node g:SquareCentimetreQuantityShape ;
                                    sh:path nltl:netLocalFrameFlangeArea ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F01/calc> ;
                    sh:resultMessage "The calculation case shall identify the evaluated structural member." ;
                    sh:resultPath nltl:sectionCalculationCaseStructuralMember ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:structuralMember ;
                            sh:maxCount 1 ;
                            sh:message "The calculation case shall identify the evaluated structural member." ;
                            sh:minCount 1 ;
                            sh:node g:StructuralMemberShape ;
                            sh:path nltl:sectionCalculationCaseStructuralMember ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F01/ship> ;
            sh:resultMessage "The ship shall provide a calculation case for the section-modulus assessment." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "The ship shall provide a calculation case for the section-modulus assessment." ;
                    sh:minCount 1 ;
                    sh:node g:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F01/calc> ] .

