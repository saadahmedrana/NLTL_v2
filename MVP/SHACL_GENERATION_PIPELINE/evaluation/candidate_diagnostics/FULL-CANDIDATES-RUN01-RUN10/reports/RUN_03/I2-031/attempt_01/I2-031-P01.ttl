@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P01/ship> ;
            sh:resultMessage "The plastic collapse mechanism must be recorded." ;
            sh:resultPath nltl:plasticCollapseMechanism ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The plastic collapse mechanism must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:plasticCollapseMechanism ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P01/strength> ;
                            sh:resultMessage "A force quantity must use kN." ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:nbaae20fbfffe465283d6eaa3034dc138b3 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P01/member> ;
                    sh:resultMessage "Each structural member must provide its plastic strength in kN." ;
                    sh:resultPath nltl:plasticStrength ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Each structural member must provide its plastic strength in kN." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-031-KiloNewtonQuantity> ;
                            sh:path nltl:plasticStrength ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P01/strength> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P01/collapse> ;
                            sh:resultMessage "A force quantity must use kN." ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:nbaae20fbfffe465283d6eaa3034dc138b3 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P01/member> ;
                    sh:resultMessage "Each structural member must provide the midspan load producing plastic collapse in kN." ;
                    sh:resultPath nltl:midspanPlasticCollapseLoad ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Each structural member must provide the midspan load producing plastic collapse in kN." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-031-KiloNewtonQuantity> ;
                            sh:path nltl:midspanPlasticCollapseLoad ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P01/collapse> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P01/ship> ;
            sh:resultMessage "Each linked structural member must satisfy the local-frame strength requirement." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked structural member must satisfy the local-frame strength requirement." ;
                    sh:node <urn:nltl:generated-shape:I2-031-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P01/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P01/ship> ;
            sh:resultMessage "The patch load must be provided in kN." ;
            sh:resultPath nltl:patchLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The patch load must be provided in kN." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-031-KiloNewtonQuantity> ;
                    sh:path nltl:patchLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P01/ship> ;
            sh:resultMessage "The ship must provide the applicable frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the applicable frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ] .

_:nbaae20fbfffe465283d6eaa3034dc138b3 sh:hasValue qudt:KiloN ;
    sh:maxCount 1 ;
    sh:message "A force quantity must use kN." ;
    sh:minCount 1 ;
    sh:path qudt:unit .

