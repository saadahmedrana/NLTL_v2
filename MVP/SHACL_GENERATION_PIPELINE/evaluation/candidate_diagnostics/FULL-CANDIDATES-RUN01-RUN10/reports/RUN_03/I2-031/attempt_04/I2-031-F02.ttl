@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/ship> ;
            sh:resultMessage "The ship must identify the plastic collapse mechanism." ;
            sh:resultPath nltl:plasticCollapseMechanism ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must identify the plastic collapse mechanism." ;
                    sh:minCount 1 ;
                    sh:path nltl:plasticCollapseMechanism ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/ship> ;
            sh:resultMessage "The ship must provide a frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:message "The ship must provide a frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/member> ;
                    sh:resultMessage "Node ex:member must conform to one or more shapes in [ sh:property [ sh:class nltl:loadCase ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:I2_031_BottomLoadCaseShape ; sh:path nltl:hasStructuralMemberLoadCase ], [ sh:class nltl:structuralLocationValue ; sh:hasValue nltl:bottomStructureLocation ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:structuralLocation ] ] , [ sh:property [ sh:class nltl:structuralLocationValue ; sh:hasValue nltl:sideStructureLocation ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:structuralLocation ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:transverseFrameOrientation ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape nltlgen:I2_031_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape nltlgen:I2_031_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:node nltlgen:I2_031_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/ship> ;
            sh:resultMessage "The ship must provide the patch load in kN." ;
            sh:resultPath nltl:patchLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the patch load in kN." ;
                    sh:minCount 1 ;
                    sh:node nltlgen:I2_031_KiloNewtonQuantityShape ;
                    sh:path nltl:patchLoad ] ] .

