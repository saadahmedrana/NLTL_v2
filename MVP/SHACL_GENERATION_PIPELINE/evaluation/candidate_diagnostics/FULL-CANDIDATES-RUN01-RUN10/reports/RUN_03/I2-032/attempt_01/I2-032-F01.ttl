@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode nltl:sternBottomHullArea ;
            sh:resultMessage "Less than 1 values on nltl:sternBottomHullArea->nltl:hullAreaFactor" ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ncf4a0b5f828b41f99057c9bef5c84d65b44 ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:bowIntermediateBottomHullArea ;
            sh:resultMessage "Less than 1 values on nltl:bowIntermediateBottomHullArea->nltl:hullAreaFactor" ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ncf4a0b5f828b41f99057c9bef5c84d65b44 ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:midbodyBottomHullArea ;
            sh:resultMessage "Less than 1 values on nltl:midbodyBottomHullArea->nltl:hullAreaFactor" ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ncf4a0b5f828b41f99057c9bef5c84d65b44 ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:otherIceStrengthenedArea ;
            sh:resultMessage "Less than 1 values on nltl:otherIceStrengthenedArea->nltl:hullAreaFactor" ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ncf4a0b5f828b41f99057c9bef5c84d65b44 ] .

_:N27f94ee654ca4928bb3d547e474d4ea5 sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:N6922ec9ce6e54977919162f235e636a8 sh:class qudt:QuantityValue ;
    sh:property _:N27f94ee654ca4928bb3d547e474d4ea5,
        [ sh:hasValue unit:UNITLESS ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:ncf4a0b5f828b41f99057c9bef5c84d65b44 sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node _:N6922ec9ce6e54977919162f235e636a8 ;
    sh:path nltl:hullAreaFactor .

