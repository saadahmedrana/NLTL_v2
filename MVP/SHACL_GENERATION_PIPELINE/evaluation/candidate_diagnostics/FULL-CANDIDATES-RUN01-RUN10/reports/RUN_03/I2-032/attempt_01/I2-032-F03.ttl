@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode nltl:otherIceStrengthenedArea ;
            sh:resultMessage "Less than 1 values on nltl:otherIceStrengthenedArea->nltl:hullAreaFactor" ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ncf4a0b5f828b41f99057c9bef5c84d65b44 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-032-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchHeight" ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:midbodyBottomHullArea ;
            sh:resultMessage "Less than 1 values on nltl:midbodyBottomHullArea->nltl:hullAreaFactor" ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ncf4a0b5f828b41f99057c9bef5c84d65b44 ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:bowIntermediateBottomHullArea ;
            sh:resultMessage "Less than 1 values on nltl:bowIntermediateBottomHullArea->nltl:hullAreaFactor" ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ncf4a0b5f828b41f99057c9bef5c84d65b44 ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:sternBottomHullArea ;
            sh:resultMessage "Less than 1 values on nltl:sternBottomHullArea->nltl:hullAreaFactor" ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ncf4a0b5f828b41f99057c9bef5c84d65b44 ] .

_:N449f10440d304175806152b958fc062f sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:N7526e228d7224c6f9fa4d1ac2f11b5ce sh:hasValue unit:UNITLESS ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

_:N85d609940f8048559a50eee24eb625e3 sh:class qudt:QuantityValue ;
    sh:property _:N449f10440d304175806152b958fc062f,
        _:N7526e228d7224c6f9fa4d1ac2f11b5ce .

_:ncf4a0b5f828b41f99057c9bef5c84d65b44 sh:maxCount 1 ;
    sh:minCount 1 ;
