[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode nltl:sternBottomHullArea ;
            sh:resultMessage "Less than 1 values on nltl:sternBottomHullArea->nltl:hullAreaFactor" ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n6f099739d4284a8ba7b76c22826aaeb2b42 ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:bowIntermediateBottomHullArea ;
