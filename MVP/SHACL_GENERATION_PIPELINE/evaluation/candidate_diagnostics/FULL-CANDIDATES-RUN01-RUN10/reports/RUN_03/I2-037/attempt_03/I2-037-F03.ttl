@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/loadcase> ;
            sh:resultMessage "Less than 1 values on ex:loadcase->nltl:combinedShearBendingEffect" ;
            sh:resultPath nltl:combinedShearBendingEffect ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n093736b1329c437b890fb679282393fab11 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/patchCase> ;
            sh:resultMessage "Node ex:patchCase->nltl:memberCapacityMinimizationConfirmed does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n093736b1329c437b890fb679282393fab13 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/loadcase> ;
            sh:resultMessage "Node ex:loadcase->nltl:memberCapacityMinimizationConfirmed does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n093736b1329c437b890fb679282393fab13 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/loadcase> ;
            sh:resultMessage "Less than 1 values on ex:loadcase->nltl:loadPatchApplicationLocation" ;
            sh:resultPath nltl:loadPatchApplicationLocation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n093736b1329c437b890fb679282393fab12 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/ship> ;
            sh:resultMessage "Each web frame or load-carrying stringer load case must be linked to an ice load patch and design case with confirmed capacity minimization, combined bending/shear effect, application location, and member capacity." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each web frame or load-carrying stringer load case must be linked to an ice load patch and design case with confirmed capacity minimization, combined bending/shear effect, application location, and member capacity." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?loadCase
            WHERE {
                $this a nltl:ship .
                $this nltl:hasStructuralMember ?member .
                ?member a ?memberClass .
                FILTER (?memberClass IN (nltl:webFrame, nltl:loadCarryingStringer))
                ?member nltl:hasStructuralMemberLoadCase ?loadCase .
                FILTER NOT EXISTS {
                    $this nltl:hasIceLoadPatch ?patch .
                    $this nltl:hasIceLoadPatchDesignCase ?designCase .
                    ?designCase nltl:memberCapacityMinimizationConfirmed true .
                    ?loadCase nltl:combinedShearBendingEffect ?combinedEffect .
                    ?loadCase nltl:loadPatchApplicationLocation ?location .
                    ?member nltl:memberCapacity ?capacity .
                    ?capacity qudt:numericValue ?numericValue ;
                             qudt:unit unit:KiloN .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-037-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/patchCase> ;
            sh:resultMessage "Less than 1 values on ex:patchCase->nltl:memberCapacityMinimizationConfirmed" ;
            sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n093736b1329c437b890fb679282393fab13 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/member> ;
            sh:resultMessage "Less than 1 values on ex:member->nltl:memberCapacity" ;
            sh:resultPath nltl:memberCapacity ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:memberCapacity ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/loadcase> ;
                    sh:resultMessage "Less than 1 values on ex:loadcase->nltl:combinedShearBendingEffect" ;
                    sh:resultPath nltl:combinedShearBendingEffect ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n093736b1329c437b890fb679282393fab11 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/loadcase> ;
                    sh:resultMessage "Less than 1 values on ex:loadcase->nltl:loadPatchApplicationLocation" ;
                    sh:resultPath nltl:loadPatchApplicationLocation ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n093736b1329c437b890fb679282393fab12 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/member> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-037-LoadCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMemberLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-037-LoadCaseShape> ;
                    sh:path nltl:hasStructuralMemberLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/loadcase> ] .

_:n093736b1329c437b890fb679282393fab11 sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:path nltl:combinedShearBendingEffect .

_:n093736b1329c437b890fb679282393fab12 sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:path nltl:loadPatchApplicationLocation .

_:n093736b1329c437b890fb679282393fab13 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:memberCapacityMinimizationConfirmed .

