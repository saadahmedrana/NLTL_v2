@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-041-F02/member> ;
                    sh:resultMessage "Each structural member requires yield strength as an input." ;
                    sh:resultPath nltl:yieldStrength ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each structural member requires yield strength as an input." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_041_YieldStrengthShape ;
                            sh:path nltl:yieldStrength ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-041-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_041_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:I2_041_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-041-F02/member> ] .

