@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F02/member> ;
                    sh:resultMessage "A structural member must provide one minimum upper yield strength in megapascals." ;
                    sh:resultPath nltl:yieldStrength ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "A structural member must provide one minimum upper yield strength in megapascals." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_043_StressQuantityShape ;
                            sh:path nltl:yieldStrength ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F02/ship> ;
            sh:resultMessage "Each linked structural member must provide the required flange-stability inputs and externally computed result." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked structural member must provide the required flange-stability inputs and externally computed result." ;
                    sh:node gen:I2_043_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F02/member> ] .

