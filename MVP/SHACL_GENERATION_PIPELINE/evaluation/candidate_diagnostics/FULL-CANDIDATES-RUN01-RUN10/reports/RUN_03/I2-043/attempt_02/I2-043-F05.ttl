@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F05/flangeOutstand> ;
                            sh:resultMessage "Node ex:flangeOutstand->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/MilliM>']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F05/member> ;
                    sh:resultMessage "A structural member must provide one externally computed flange outstand in millimetres." ;
                    sh:resultPath nltl:flangeOutstand ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "A structural member must provide one externally computed flange outstand in millimetres." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_043_LengthQuantityShape ;
                            sh:path nltl:flangeOutstand ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F05/flangeOutstand> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F05/ship> ;
            sh:resultMessage "Each linked structural member must provide the required flange-stability inputs and externally computed result." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked structural member must provide the required flange-stability inputs and externally computed result." ;
                    sh:node gen:I2_043_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F05/member> ] .

