@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:message Literal("The linked hull structure must explicitly indicate that it is not ice strengthened when the renewal rule is non-applicable.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path ( nltl:hasComponent nltl:iceStrengthenedStructureStatus ) ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:message Literal("The linked hull structure must explicitly indicate that it is ice strengthened before applying the steel-renewal calculation.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path ( nltl:hasComponent nltl:iceStrengthenedStructureStatus ) ], [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:steelRenewalRequired ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:gaugedThickness ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:netThickness ] ; sh:sparql [ sh:message Literal("For an ice strengthened structure, steelRenewalRequired must be true exactly when gaugedThickness is less than netThickness plus 0.0005 m.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:hasComponent ?structure ;
                              nltl:gaugedThickness ?gaugedNode ;
                              nltl:netThickness ?netNode ;
                              nltl:steelRenewalRequired ?renewal .
                        ?structure nltl:iceStrengthenedStructureStatus true .
                        ?gaugedNode qudt:numericValue ?gauged .
                        ?netNode qudt:numericValue ?net .
                        FILTER (
                            ?renewal !=
                            (?gauged < (?net + "0.0005"^^xsd:decimal))
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_047_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F03/ship> ] .

