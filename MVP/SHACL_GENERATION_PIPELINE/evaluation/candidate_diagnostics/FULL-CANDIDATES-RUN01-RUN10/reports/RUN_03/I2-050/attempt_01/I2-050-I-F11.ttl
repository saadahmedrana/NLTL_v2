_:N14e84e41e9ae4252811b9d5f4305f178 sh:class nltl:tableLookupCase ;
    sh:property [ sh:datatype qudt:QuantityValue ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:numericValue ],
                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:path nltl:crushingFailureClassFactor ],
        [ sh:datatype qudt:QuantityValue ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:numericValue ],
                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:path nltl:flexuralFailureClassFactor ],
        [ sh:datatype qudt:QuantityValue ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ],
                        [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:numericValue ] ] ;
            sh:path nltl:longitudinalStrengthClassFactor ] .

