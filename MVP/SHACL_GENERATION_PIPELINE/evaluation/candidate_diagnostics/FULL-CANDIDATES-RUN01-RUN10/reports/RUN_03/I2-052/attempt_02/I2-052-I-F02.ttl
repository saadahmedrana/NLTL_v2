            sh:resultMessage "The calculation case shall identify the lower interpolation endpoint." ;
            sh:resultPath nltl:interpolationLowerEndpoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n6215481b25f044bdafbb3afdde6ee2dbb4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/ship> ;
            sh:resultMessage "The ship shall provide the externally determined interpolated value." ;
            sh:resultPath nltl:interpolatedValue ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship shall provide the externally determined interpolated value." ;
                    sh:minCount 1 ;
                    sh:path nltl:interpolatedValue ] ],
        [ a sh:ValidationResult ;
