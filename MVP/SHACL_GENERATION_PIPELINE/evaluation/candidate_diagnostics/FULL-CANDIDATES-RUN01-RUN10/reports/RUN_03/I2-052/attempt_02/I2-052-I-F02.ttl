_:N2e4ac4f0e43f4886807479dd0d1d083c sh:class qudt:QuantityValue ;
    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:N6732038348a24a89b4af536075b4ef4b sh:class qudt:QuantityValue ;
    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:n6215481b25f044bdafbb3afdde6ee2dbb10 sh:message "The calculation case shall provide the externally determined longitudinal distribution factor." ;
    sh:minCount 1 ;
    sh:node _:N6732038348a24a89b4af536075b4ef4b ;
    sh:path nltl:interpolatedLongitudinalDistributionFactor .

_:n6215481b25f044bdafbb3afdde6ee2dbb3 sh:class nltl:interpolationPoint ;
    sh:message "The calculation case shall identify interpolation points." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-052-InterpolationPointShape> ;
    sh:path nltl:hasInterpolationPoint .

_:n6215481b25f044bdafbb3afdde6ee2dbb4 sh:class nltl:interpolationPoint ;
    sh:message "The calculation case shall identify the lower interpolation endpoint." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-052-InterpolationPointShape> ;
    sh:path nltl:interpolationLowerEndpoint .

_:n6215481b25f044bdafbb3afdde6ee2dbb6 sh:message "The calculation case shall provide the hull girder longitudinal position from aft in metres." ;
    sh:minCount 1 ;
    sh:node _:N2e4ac4f0e43f4886807479dd0d1d083c ;
    sh:path nltl:hullGirderLongitudinalPositionFromAft .

_:n6215481b25f044bdafbb3afdde6ee2dbb5 sh:class nltl:interpolationPoint ;
    sh:message "The calculation case shall identify the upper interpolation endpoint." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-052-InterpolationPointShape> ;
    sh:path nltl:interpolationUpperEndpoint .

