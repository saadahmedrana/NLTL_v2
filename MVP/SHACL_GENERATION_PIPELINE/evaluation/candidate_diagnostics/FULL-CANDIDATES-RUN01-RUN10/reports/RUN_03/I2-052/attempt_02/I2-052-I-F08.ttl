@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F08/lowerPoint> ;
            sh:resultMessage "The calculation case shall provide the externally determined longitudinal distribution factor." ;
            sh:resultPath nltl:interpolatedLongitudinalDistributionFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The calculation case shall provide the externally determined longitudinal distribution factor." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:interpolatedLongitudinalDistributionFactor ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F08/lowerPoint> ;
            sh:resultMessage "The calculation case shall identify the lower interpolation endpoint." ;
            sh:resultPath nltl:interpolationLowerEndpoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:interpolationPoint ;
                    sh:message "The calculation case shall identify the lower interpolation endpoint." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-052-InterpolationPointShape> ;
                    sh:path nltl:interpolationLowerEndpoint ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F08/lowerPoint> ;
            sh:resultMessage "The calculation case shall identify interpolation points." ;
            sh:resultPath nltl:hasInterpolationPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:interpolationPoint ;
                    sh:message "The calculation case shall identify interpolation points." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-052-InterpolationPointShape> ;
                    sh:path nltl:hasInterpolationPoint ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F08/lowerPoint> ;
            sh:resultMessage "The calculation case shall identify the upper interpolation endpoint." ;
            sh:resultPath nltl:interpolationUpperEndpoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:interpolationPoint ;
                    sh:message "The calculation case shall identify the upper interpolation endpoint." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-052-InterpolationPointShape> ;
                    sh:path nltl:interpolationUpperEndpoint ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F08/ship> ;
            sh:resultMessage "The ship shall provide the externally determined interpolated value." ;
            sh:resultPath nltl:interpolatedValue ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship shall provide the externally determined interpolated value." ;
                    sh:minCount 1 ;
                    sh:path nltl:interpolatedValue ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F08/lowerPoint> ;
            sh:resultMessage "The calculation case shall provide the hull girder longitudinal position from aft in metres." ;
            sh:resultPath nltl:hullGirderLongitudinalPositionFromAft ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The calculation case shall provide the hull girder longitudinal position from aft in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:hullGirderLongitudinalPositionFromAft ] ] .

