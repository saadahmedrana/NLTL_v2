@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "The ship must record that the required direct calculation is used." ;
            sh:resultPath nltl:directCalculationUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n5c41d12c6002492dab277d1fe6fea20bb1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/member> ;
                    sh:resultMessage "Node ex:member must conform to one or more shapes in [ sh:class nltl:loadCarryingStringer ; sh:property [ sh:class nltl:grillageSystem ; sh:message Literal(\"A load carrying stringer must form part of a grillage system.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:partOfGrillageSystem ] ] , [ sh:class nltl:webFrame ; sh:property [ sh:class nltl:grillageSystem ; sh:message Literal(\"A web frame must form part of a grillage system.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:partOfGrillageSystem ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:structuralMember ;
                            sh:or ( [ sh:class nltl:loadCarryingStringer ;
                                        sh:property [ sh:class nltl:grillageSystem ;
                                                sh:message "A load carrying stringer must form part of a grillage system." ;
                                                sh:minCount 1 ;
                                                sh:path nltl:partOfGrillageSystem ] ] [ sh:class nltl:webFrame ;
                                        sh:property [ sh:class nltl:grillageSystem ;
                                                sh:message "A web frame must form part of a grillage system." ;
                                                sh:minCount 1 ;
                                                sh:path nltl:partOfGrillageSystem ] ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:structuralMember ; sh:or ( [ sh:class nltl:loadCarryingStringer ; sh:property [ sh:class nltl:grillageSystem ; sh:message Literal(\"A load carrying stringer must form part of a grillage system.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:partOfGrillageSystem ] ] [ sh:class nltl:webFrame ; sh:property [ sh:class nltl:grillageSystem ; sh:message Literal(\"A web frame must form part of a grillage system.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:partOfGrillageSystem ] ] ) ]. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:structuralMember ;
                            sh:or ( [ sh:class nltl:loadCarryingStringer ;
                                        sh:property [ sh:class nltl:grillageSystem ;
                                                sh:message "A load carrying stringer must form part of a grillage system." ;
                                                sh:minCount 1 ;
                                                sh:path nltl:partOfGrillageSystem ] ] [ sh:class nltl:webFrame ;
                                        sh:property [ sh:class nltl:grillageSystem ;
                                                sh:message "A web frame must form part of a grillage system." ;
                                                sh:minCount 1 ;
                                                sh:path nltl:partOfGrillageSystem ] ] ) ] ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "The ship must record that the required direct calculation is used." ;
            sh:resultPath nltl:directCalculationUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n5c41d12c6002492dab277d1fe6fea20bb1 ] .

_:n5c41d12c6002492dab277d1fe6fea20bb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship must record that the required direct calculation is used." ;
    sh:minCount 1 ;
    sh:path nltl:directCalculationUsed .

