@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/flange> ;
            sh:resultMessage "The applicable hull structure must confirm that the buckling criteria are satisfied." ;
            sh:resultPath nltl:bucklingCriteriaSatisfied ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n31e4b8ec687349c08706165a33a10f7ab24 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/flange> ;
            sh:resultMessage "The applicable hull structure must confirm that the buckling criteria are satisfied." ;
            sh:resultPath nltl:bucklingCriteriaSatisfied ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n31e4b8ec687349c08706165a33a10f7ab24 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/web> ;
            sh:resultMessage "The applicable hull structure must confirm that the buckling criteria are satisfied." ;
            sh:resultPath nltl:bucklingCriteriaSatisfied ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n31e4b8ec687349c08706165a33a10f7ab24 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:yieldStrength" ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:yieldStrength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/web> ;
            sh:resultMessage "The applicable hull structure must confirm that the buckling criteria are satisfied." ;
            sh:resultPath nltl:bucklingCriteriaSatisfied ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n31e4b8ec687349c08706165a33a10f7ab24 ] .

_:n31e4b8ec687349c08706165a33a10f7ab24 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The applicable hull structure must confirm that the buckling criteria are satisfied." ;
    sh:minCount 1 ;
    sh:path nltl:bucklingCriteriaSatisfied .

