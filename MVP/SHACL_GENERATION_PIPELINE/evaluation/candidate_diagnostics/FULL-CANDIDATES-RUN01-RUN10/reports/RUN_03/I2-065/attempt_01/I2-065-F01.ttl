@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F01/ship> ;
            sh:resultMessage "Each non-linear calculation case must provide the declared inputs, acceptance evidence, and satisfied permanent-deformation assessment." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each non-linear calculation case must provide the declared inputs, acceptance evidence, and satisfied permanent-deformation assessment." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:nonlinearCalculationMethodValue .

                FILTER (
                    NOT EXISTS {
                        ?case nltl:nonlinearAnalysisAcceptanceEvidence ?evidence .
                        ?evidence a nltl:evidenceArtifact .
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:minorPermanentDeformationAssessmentSatisfied ?assessment .
                        FILTER (
                            datatype(?assessment) = xsd:boolean
                            && ?assessment = true
                        )
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:permanentLateralDeformation ?lateral .
                        ?lateral qudt:numericValue ?lateralValue ;
                                 qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER (datatype(?lateralValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:permanentOutOfPlaneDeformation ?outOfPlane .
                        ?outOfPlane qudt:numericValue ?outOfPlaneValue ;
                                    qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER (datatype(?outOfPlaneValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:relevantStructuralDimension ?dimension .
                        ?dimension qudt:numericValue ?dimensionValue ;
                                   qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER (datatype(?dimensionValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:fractureMargin ?fracture .
                        ?fracture qudt:numericValue ?fractureValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (datatype(?fractureValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:majorBucklingMargin ?buckling .
                        ?buckling qudt:numericValue ?bucklingValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (datatype(?bucklingValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:yieldingMargin ?yielding .
                        ?yielding qudt:numericValue ?yieldingValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (datatype(?yieldingValue) = xsd:decimal)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-065-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F01/ship> ] .

