@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F02/connection2> ;
                    sh:resultMessage "Each structural connection must ensure continuity of strength." ;
                    sh:resultPath nltl:strengthContinuityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "Each structural connection must ensure continuity of strength." ;
                            sh:minCount 1 ;
                            sh:path nltl:strengthContinuityStatus ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_067_StructuralConnectionShape. See details for more information." ;
            sh:resultPath nltl:structuralConnection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:I2_067_StructuralConnectionShape ;
                    sh:path nltl:structuralConnection ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F02/connection2> ] .

