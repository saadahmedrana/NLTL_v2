@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-P03/ship> ;
            sh:resultMessage "The ship must indicate that continuity of strength is ensured at all structural connections." ;
            sh:resultPath nltl:strengthContinuityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nfcf575e094954ceea8b6a40437827849b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-P03/ship> ;
            sh:resultMessage "The ship must indicate that continuity of strength is ensured at all structural connections." ;
            sh:resultPath nltl:strengthContinuityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nfcf575e094954ceea8b6a40437827849b1 ] .

_:nfcf575e094954ceea8b6a40437827849b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship must indicate that continuity of strength is ensured at all structural connections." ;
    sh:minCount 1 ;
    sh:path nltl:strengthContinuityStatus .

