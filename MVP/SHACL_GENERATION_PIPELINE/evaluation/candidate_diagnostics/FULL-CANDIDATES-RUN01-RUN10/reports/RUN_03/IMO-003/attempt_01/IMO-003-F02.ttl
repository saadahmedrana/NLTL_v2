@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F02/ship> ;
            sh:resultMessage "A ship designed for open water or ice conditions less severe than categories A and B shall have Polar Ship Category C." ;
            sh:resultPath nltl:shipCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n845bd6c916b0400c95df994f2fc568e3b4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F02/ship> ;
            sh:resultMessage "A ship designed for open water or ice conditions less severe than categories A and B shall have Polar Ship Category C." ;
            sh:resultPath nltl:shipCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n845bd6c916b0400c95df994f2fc568e3b4 ] .

_:n845bd6c916b0400c95df994f2fc568e3b4 sh:class nltl:polarShipCategoryValue ;
    sh:hasValue nltl:polarShipCategoryC ;
    sh:maxCount 1 ;
    sh:message "A ship designed for open water or ice conditions less severe than categories A and B shall have Polar Ship Category C." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:shipCategory .

