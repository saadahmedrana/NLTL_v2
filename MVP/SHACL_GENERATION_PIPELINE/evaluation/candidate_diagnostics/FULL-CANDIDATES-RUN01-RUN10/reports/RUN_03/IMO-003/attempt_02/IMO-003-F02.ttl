@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F02/ship> ;
            sh:resultMessage "A ship designed for open water or for ice conditions less severe than categories A and B must have ship category C." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship designed for open water or for ice conditions less severe than categories A and B must have ship category C." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:designIceCondition ?condition .
                FILTER (
                    ?condition = nltl:openWaterIceCondition ||
                    ?condition = nltl:iceConditionLessSevereThanCategoryAAndB
                )
                FILTER NOT EXISTS {
                    $this nltl:shipCategory nltl:polarShipCategoryC .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_003_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F02/ship> ] .

