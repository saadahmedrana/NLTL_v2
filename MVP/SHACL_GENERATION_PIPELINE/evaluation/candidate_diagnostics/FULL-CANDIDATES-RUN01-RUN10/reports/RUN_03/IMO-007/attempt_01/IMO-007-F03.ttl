@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For open water, ice of land origin must be absent.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceOfLandOriginPresent ], [ sh:hasValue nltl:openWaterIceCondition ; sh:path nltl:iceConditionClassification ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For open water, sea ice concentration must be a unitless decimal less than 1.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxExclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:seaIceConcentration ] ] , [ sh:property [ sh:in ( nltl:iceConditionLessSevereThanCategoryAAndB nltl:iceFreeIceCondition nltl:mediumFirstYearIceWithPossibleOldIceInclusions nltl:otherWatersIceCondition nltl:thinFirstYearIceWithPossibleOldIceInclusions ) ; sh:path nltl:iceConditionClassification ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_007_StaticShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F03/ship> ] .

