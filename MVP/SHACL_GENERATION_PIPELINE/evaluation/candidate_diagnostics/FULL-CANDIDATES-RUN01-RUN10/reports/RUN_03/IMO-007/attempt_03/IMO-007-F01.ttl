@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F01/ship> ;
            sh:resultMessage "If the ice condition is open water, its concentration must be below 1 and no ice of land origin may be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO007Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F01/ship> ] .

