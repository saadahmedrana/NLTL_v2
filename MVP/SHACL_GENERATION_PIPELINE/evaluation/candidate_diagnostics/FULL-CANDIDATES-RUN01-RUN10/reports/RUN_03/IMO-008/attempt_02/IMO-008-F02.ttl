@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-F02/ship> ;
            sh:resultMessage "For a ship classified as thin first-year ice, at least one ice thickness quantity is required, and every supplied thickness quantity must use unit:M with a value inclusively between 0.3 m and 0.7 m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a ship classified as thin first-year ice, at least one ice thickness quantity is required, and every supplied thickness quantity must use unit:M with a value inclusively between 0.3 m and 0.7 m." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceTypeClassification nltl:thinFirstYearIce .
                FILTER (
                    NOT EXISTS {
                        $this nltl:iceThickness ?validQuantity .
                        ?validQuantity qudt:unit unit:M .
                        ?validQuantity qudt:numericValue ?validValue .
                        FILTER (
                            ?validValue >= 0.3 &&
                            ?validValue <= 0.7
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:iceThickness ?quantity .
                        FILTER (
                            NOT EXISTS {
                                ?quantity qudt:unit unit:M
                            }
                            ||
                            EXISTS {
                                ?quantity qudt:unit ?unit .
                                FILTER (?unit != unit:M)
                            }
                            ||
                            NOT EXISTS {
                                ?quantity qudt:numericValue ?value
                            }
                            ||
                            EXISTS {
                                ?quantity qudt:numericValue ?value .
                                FILTER (
                                    ?value < 0.3 ||
                                    ?value > 0.7
                                )
                            }
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_008_ThinFirstYearIceShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-F02/ship> ] .

