@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-012-F01/ship> ;
            sh:resultMessage "polarServiceTemperature must be no greater than lowestMdlt minus 10 degrees Celsius." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "polarServiceTemperature must be no greater than lowestMdlt minus 10 degrees Celsius." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:lowestMdlt ?lowestMdltQuantity ;
                      nltl:polarServiceTemperature ?polarServiceTemperatureQuantity .
                ?lowestMdltQuantity qudt:numericValue ?lowestMdlt .
                ?polarServiceTemperatureQuantity qudt:numericValue ?polarServiceTemperature .
                FILTER (?polarServiceTemperature > (?lowestMdlt - 10))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_012_PolarServiceTemperatureShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-012-F01/ship> ] .

