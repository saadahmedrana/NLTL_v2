@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-014-F03/ship> ;
            sh:resultMessage "The Polar Code applicability determination must be present; applicable ships must have a valid Polar Ship Certificate." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_014_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-014-F03/ship> ] .

