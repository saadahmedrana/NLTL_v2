@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F01/ship> ;
            sh:resultMessage "Each SOLAS certificate schedule date must match the corresponding Polar Ship Certificate date by controlled date category." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each SOLAS certificate schedule date must match the corresponding Polar Ship Certificate date by controlled date category." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasSolasCertificateSchedule ?schedule .
                ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                ?record nltl:certificateScheduleDateType ?category ;
                        nltl:certificateScheduleDate ?scheduleDate .
                FILTER (
                    (
                        ?category = nltl:validityDateCategory &&
                        NOT EXISTS {
                            $this nltl:polarCertificateValidityDates ?shipDate .
                            FILTER (?shipDate = ?scheduleDate)
                        }
                    ) ||
                    (
                        ?category = nltl:surveyDateCategory &&
                        NOT EXISTS {
                            $this nltl:surveyDates ?shipDate .
                            FILTER (?shipDate = ?scheduleDate)
                        }
                    ) ||
                    (
                        ?category = nltl:endorsementDateCategory &&
                        NOT EXISTS {
                            $this nltl:endorsementDates ?shipDate .
                            FILTER (?shipDate = ?scheduleDate)
                        }
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO017ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F01/ship> ] .

