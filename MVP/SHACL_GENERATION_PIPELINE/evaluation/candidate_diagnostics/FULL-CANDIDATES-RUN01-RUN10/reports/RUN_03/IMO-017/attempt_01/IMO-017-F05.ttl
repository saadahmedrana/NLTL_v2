@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/solasSchedule> ;
                    sh:resultMessage "The SOLAS certificate schedule must include a survey date record." ;
                    sh:resultPath nltl:hasCertificateScheduleDateRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The SOLAS certificate schedule must include a survey date record." ;
                            sh:path nltl:hasCertificateScheduleDateRecord ;
                            sh:qualifiedMinCount 1 ;
                            sh:qualifiedValueShape gs:SurveyDateRecordShape ;
                            sh:qualifiedValueShapesDisjoint false ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/ship> ;
            sh:resultMessage "The ship must have an applicable SOLAS certificate schedule." ;
            sh:resultPath nltl:hasSolasCertificateSchedule ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:solasCertificateSchedule ;
                    sh:message "The ship must have an applicable SOLAS certificate schedule." ;
                    sh:minCount 1 ;
                    sh:node gs:SolasCertificateScheduleShape ;
                    sh:path nltl:hasSolasCertificateSchedule ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/solasSchedule> ] .

