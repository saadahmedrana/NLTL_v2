@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/ship> ;
            sh:resultMessage "Every Polar Ship Certificate validity, survey, and endorsement date must match a SOLAS schedule record of the corresponding category, and every such SOLAS schedule record must match the corresponding Polar Ship Certificate date." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Every Polar Ship Certificate validity, survey, and endorsement date must match a SOLAS schedule record of the corresponding category, and every such SOLAS schedule record must match the corresponding Polar Ship Certificate date." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                {
                    $this nltl:polarCertificateValidityDates ?date .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDateType nltl:validityDateCategory ;
                                nltl:certificateScheduleDate ?date .
                    }
                }
                UNION
                {
                    $this nltl:surveyDates ?date .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDateType nltl:surveyDateCategory ;
                                nltl:certificateScheduleDate ?date .
                    }
                }
                UNION
                {
                    $this nltl:endorsementDates ?date .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDateType nltl:endorsementDateCategory ;
                                nltl:certificateScheduleDate ?date .
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDateType nltl:validityDateCategory ;
                            nltl:certificateScheduleDate ?date .
                    FILTER NOT EXISTS {
                        $this nltl:polarCertificateValidityDates ?date
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDateType nltl:surveyDateCategory ;
                            nltl:certificateScheduleDate ?date .
                    FILTER NOT EXISTS {
                        $this nltl:surveyDates ?date
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDateType nltl:endorsementDateCategory ;
                            nltl:certificateScheduleDate ?date .
                    FILTER NOT EXISTS {
                        $this nltl:endorsementDates ?date
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO017Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/endorsementRecord> ;
                            sh:resultMessage "Each SOLAS certificate schedule record must have one permitted controlled date category." ;
                            sh:resultPath nltl:certificateScheduleDateType ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue nltl:validityDateCategory ;
                                    sh:in ( nltl:validityDateCategory nltl:surveyDateCategory nltl:endorsementDateCategory ) ;
                                    sh:message "Each SOLAS certificate schedule record must have one permitted controlled date category." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:certificateScheduleDateType ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/solasSchedule> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:date ; sh:message Literal(\"Each SOLAS certificate schedule record must contain a date.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:certificateScheduleDate ], [ sh:hasValue nltl:validityDateCategory ; sh:in ( nltl:validityDateCategory nltl:surveyDateCategory nltl:endorsementDateCategory ) ; sh:message Literal(\"Each SOLAS certificate schedule record must have one permitted controlled date category.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:certificateScheduleDateType ] ]. See details for more information." ;
                    sh:resultPath nltl:hasCertificateScheduleDateRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:certificateScheduleDateRecord ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:date ;
                                            sh:message "Each SOLAS certificate schedule record must contain a date." ;
                                            sh:minCount 1 ;
                                            sh:path nltl:certificateScheduleDate ],
                                        [ sh:hasValue nltl:validityDateCategory ;
                                            sh:in ( nltl:validityDateCategory nltl:surveyDateCategory nltl:endorsementDateCategory ) ;
                                            sh:message "Each SOLAS certificate schedule record must have one permitted controlled date category." ;
                                            sh:minCount 1 ;
                                            sh:path nltl:certificateScheduleDateType ] ] ;
                            sh:path nltl:hasCertificateScheduleDateRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/endorsementRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/ship> ;
            sh:resultMessage "A SOLAS certificate schedule with date records is required." ;
            sh:resultPath nltl:hasSolasCertificateSchedule ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:solasCertificateSchedule ;
                    sh:message "A SOLAS certificate schedule with date records is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:class nltl:certificateScheduleDateRecord ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:date ;
                                                    sh:message "Each SOLAS certificate schedule record must contain a date." ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:certificateScheduleDate ],
                                                [ sh:hasValue nltl:validityDateCategory ;
                                                    sh:in [ ] ;
                                                    sh:message "Each SOLAS certificate schedule record must have one permitted controlled date category." ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:certificateScheduleDateType ] ] ;
                                    sh:path nltl:hasCertificateScheduleDateRecord ] ] ;
                    sh:path nltl:hasSolasCertificateSchedule ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/solasSchedule> ] .

