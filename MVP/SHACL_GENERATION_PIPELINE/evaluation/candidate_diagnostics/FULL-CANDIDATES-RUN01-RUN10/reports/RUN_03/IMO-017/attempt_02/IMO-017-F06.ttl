                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:n731ff7ca97824dff987701760df0b9adb14 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F06/solasSchedule> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:date ; sh:message Literal(\"Each SOLAS certificate schedule record must contain a date.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:certificateScheduleDate ], [ sh:hasValue nltl:validityDateCategory ; sh:in ( nltl:validityDateCategory nltl:surveyDateCategory nltl:endorsementDateCategory ) ; sh:message Literal(\"Each SOLAS certificate schedule record must have one permitted controlled date category.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:certificateScheduleDateType ] ]. See details for more information." ;
                    sh:resultPath nltl:hasCertificateScheduleDateRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n731ff7ca97824dff987701760df0b9adb11 ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F06/endorsementRecord> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F06/surveyRecord> ;
                            sh:resultMessage "Each SOLAS certificate schedule record must have one permitted controlled date category." ;
                            sh:resultPath nltl:certificateScheduleDateType ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:n731ff7ca97824dff987701760df0b9adb14 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F06/solasSchedule> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:date ; sh:message Literal(\"Each SOLAS certificate schedule record must contain a date.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:certificateScheduleDate ], [ sh:hasValue nltl:validityDateCategory ; sh:in ( nltl:validityDateCategory nltl:surveyDateCategory nltl:endorsementDateCategory ) ; sh:message Literal(\"Each SOLAS certificate schedule record must have one permitted controlled date category.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:certificateScheduleDateType ] ]. See details for more information." ;
                    sh:resultPath nltl:hasCertificateScheduleDateRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n731ff7ca97824dff987701760df0b9adb11 ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F06/surveyRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F06/ship> ;
            sh:resultMessage "A SOLAS certificate schedule with date records is required." ;
            sh:resultPath nltl:hasSolasCertificateSchedule ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:solasCertificateSchedule ;
                    sh:message "A SOLAS certificate schedule with date records is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:class nltl:certificateScheduleDateRecord ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:date ;
                                                    sh:message "Each SOLAS certificate schedule record must contain a date." ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:certificateScheduleDate ],
                                                [ sh:hasValue nltl:validityDateCategory ;
