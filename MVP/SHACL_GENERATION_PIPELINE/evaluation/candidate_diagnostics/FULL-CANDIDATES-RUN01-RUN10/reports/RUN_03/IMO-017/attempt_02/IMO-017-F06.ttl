[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F06/ship> ;
            sh:resultMessage "A Polar Ship Certificate is required." ;
            sh:resultPath nltl:hasPolarShipCertificate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarShipCertificateForm ;
                    sh:message "A Polar Ship Certificate is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasPolarShipCertificate ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F06/endorsementRecord> ;
                            sh:resultMessage "Each SOLAS certificate schedule record must have one permitted controlled date category." ;
