@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F01/ship> ;
            sh:resultMessage "Every Polar Ship Certificate validity, survey, and endorsement date must match a SOLAS schedule record of the corresponding category, and every SOLAS schedule record must match the corresponding Polar Ship Certificate date." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Every Polar Ship Certificate validity, survey, and endorsement date must match a SOLAS schedule record of the corresponding category, and every SOLAS schedule record must match the corresponding Polar Ship Certificate date." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    $this nltl:polarCertificateValidityDates ?date .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?date ;
                               nltl:certificateScheduleDateType nltl:validityDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:surveyDates ?date .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?date ;
                               nltl:certificateScheduleDateType nltl:surveyDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:endorsementDates ?date .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?date ;
                               nltl:certificateScheduleDateType nltl:endorsementDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?date ;
                           nltl:certificateScheduleDateType nltl:validityDateCategory .
                    FILTER NOT EXISTS {
                        $this nltl:polarCertificateValidityDates ?date
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?date ;
                           nltl:certificateScheduleDateType nltl:surveyDateCategory .
                    FILTER NOT EXISTS {
                        $this nltl:surveyDates ?date
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?date ;
                           nltl:certificateScheduleDateType nltl:endorsementDateCategory .
                    FILTER NOT EXISTS {
                        $this nltl:endorsementDates ?date
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO017ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F01/ship> ] .

