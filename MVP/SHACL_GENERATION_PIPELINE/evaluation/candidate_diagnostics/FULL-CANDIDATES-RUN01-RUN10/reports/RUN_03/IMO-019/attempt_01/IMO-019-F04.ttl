@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F04/ship> ;
            sh:resultMessage "For ships operating in low air temperature, PST, lowest MDLT, and functional status at PST are required and the PST limit must be met." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_019_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F04/ship> ] .

