@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-023-F03/ship> ;
            sh:resultMessage "The ship's manual must include or reference procedures for normal operations." ;
            sh:resultPath nltl:normalOperationProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd89bfb5b51fb427e93b62b3bc2e2c2bfb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-023-F03/ship> ;
            sh:resultMessage "The ship's manual must include or reference procedures for normal operations." ;
            sh:resultPath nltl:normalOperationProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nd89bfb5b51fb427e93b62b3bc2e2c2bfb1 ] .

_:nd89bfb5b51fb427e93b62b3bc2e2c2bfb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship's manual must include or reference procedures for normal operations." ;
    sh:minCount 1 ;
    sh:path nltl:normalOperationProcedurePresent .

