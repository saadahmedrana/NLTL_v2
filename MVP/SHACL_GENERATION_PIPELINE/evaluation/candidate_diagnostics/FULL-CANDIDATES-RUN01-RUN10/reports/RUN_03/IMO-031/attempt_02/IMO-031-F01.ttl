@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F01/ship> ;
            sh:resultMessage "Value Literal(\"yard self-approval\", datatype=xsd:string) not in list ['Literal(\"recognized organization accepted by the Administration\", datatype=xsd:string)', 'Literal(\"Administration\", datatype=xsd:string)']" ;
            sh:resultPath nltl:approvingAuthority ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "Administration"^^xsd:string "recognized organization accepted by the Administration"^^xsd:string ) ;
                    sh:path nltl:approvingAuthority ] ;
            sh:value "yard self-approval"^^xsd:string ] .

