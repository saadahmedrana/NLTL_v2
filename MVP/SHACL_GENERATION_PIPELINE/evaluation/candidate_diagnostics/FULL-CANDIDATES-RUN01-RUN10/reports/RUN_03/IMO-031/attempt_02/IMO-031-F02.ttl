@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F02/ship> ;
            sh:resultMessage "Value Literal(\"uncontrolled internal standard\", datatype=xsd:string) not in list ['Literal(\"another standard offering an equivalent level of safety\", datatype=xsd:string)', 'Literal(\"standard acceptable to the Organization\", datatype=xsd:string)']" ;
            sh:resultPath nltl:approvalStandard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "standard acceptable to the Organization"^^xsd:string "another standard offering an equivalent level of safety"^^xsd:string ) ;
                    sh:path nltl:approvalStandard ] ;
            sh:value "uncontrolled internal standard"^^xsd:string ] .

