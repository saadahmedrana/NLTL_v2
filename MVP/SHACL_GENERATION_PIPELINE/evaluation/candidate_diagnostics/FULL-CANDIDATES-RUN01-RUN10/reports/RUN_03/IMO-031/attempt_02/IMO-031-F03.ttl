@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F03/ship> ;
            sh:resultMessage "Node ex:ship->nltl:materialApprovalStatus does not contain a value in the set: ['nltl:evidenceStateApproved']" ;
            sh:resultPath nltl:materialApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:evidenceStateApproved ;
                    sh:path nltl:materialApprovalStatus ] ] .

