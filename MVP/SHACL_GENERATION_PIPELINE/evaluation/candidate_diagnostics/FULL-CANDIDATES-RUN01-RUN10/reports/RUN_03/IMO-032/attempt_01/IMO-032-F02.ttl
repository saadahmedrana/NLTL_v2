@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-032-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:approvalRecord ; sh:message Literal(\"A Category A or B ship must have a conforming scantling approval record.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:IMO032ApprovalABShape ; sh:path nltl:hasApprovalRecord ], [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ; sh:path nltl:shipCategory ] ] , [ sh:property [ sh:class nltl:approvalRecord ; sh:message Literal(\"An ice-strengthened Category C ship must have a conforming scantling approval record with operating ice context.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:IMO032ApprovalCShape ; sh:path nltl:hasApprovalRecord ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:shipIceStrengthened ], [ sh:hasValue nltl:polarShipCategoryC ; sh:path nltl:shipCategory ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:shipIceStrengthened ], [ sh:hasValue nltl:polarShipCategoryC ; sh:path nltl:shipCategory ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO032Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-032-F02/ship> ] .

