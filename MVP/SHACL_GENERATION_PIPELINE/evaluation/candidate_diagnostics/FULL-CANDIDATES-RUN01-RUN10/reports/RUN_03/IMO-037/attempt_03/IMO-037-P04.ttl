@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-P04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:message Literal("At least one loading condition case is required for an applicable ship.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:IMO_037_LoadingConditionCaseShape ; sh:path nltl:hasLoadingConditionCase ] ; sh:sparql [ sh:message Literal("The ship must be Category A or B and constructed on or after 2017-01-01 for this branch to apply.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:shipCategory ?category ;
                              nltl:constructionDate ?date .
                        FILTER (
                            ?category IN (
                                nltl:polarShipCategoryA,
                                nltl:polarShipCategoryB
                            )
                            &&
                            (
                                YEAR(?date) > 2017
                                ||
                                (
                                    YEAR(?date) = 2017
                                    &&
                                    (
                                        MONTH(?date) > 1
                                        ||
                                        (
                                            MONTH(?date) = 1
                                            && DAY(?date) >= 1
                                        )
                                    )
                                )
                            )
                        )
                    }
                ") ] ] , [ sh:sparql [ sh:message Literal("This non-applicable branch requires a category other than A or B, or a construction date before 2017-01-01.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:shipCategory ?category ;
                              nltl:constructionDate ?date .
                        FILTER (
                            ?category NOT IN (
                                nltl:polarShipCategoryA,
                                nltl:polarShipCategoryB
                            )
                            ||
                            YEAR(?date) < 2017
                            ||
                            (
                                YEAR(?date) = 2017
                                &&
                                (
                                    MONTH(?date) < 1
                                    ||
                                    (
                                        MONTH(?date) = 1
                                        && DAY(?date) < 1
                                    )
                                )
                            )
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_037_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-P04/ship> ] .

