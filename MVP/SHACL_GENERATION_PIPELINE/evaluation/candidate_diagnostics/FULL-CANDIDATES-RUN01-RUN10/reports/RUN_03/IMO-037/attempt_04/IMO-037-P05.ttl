@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-P05/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("2017-01-01", datatype=xsd:date) ; sh:path nltl:constructionDate ], [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipCategory ], [ sh:node gen:IMO_037_LoadingConditionCaseShape ; sh:path nltl:hasLoadingConditionCase ] ] , [ sh:sparql [ sh:message Literal("The ship is outside the applicability condition for this requirement.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:shipCategory ?category ;
                              nltl:constructionDate ?date .
                        FILTER (
                            ?category NOT IN (
                                nltl:polarShipCategoryA,
                                nltl:polarShipCategoryB
                            )
                            || ?date < "2017-01-01"^^xsd:date
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_037_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-P05/ship> ] .

