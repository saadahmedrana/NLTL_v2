@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F02/transversePenetrationValue> ;
                    sh:resultMessage "Value is not >= Literal(\"760.0\", datatype=xsd:decimal)" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:maxInclusive 760.0 ;
                            sh:minCount 1 ;
                            sh:minInclusive 760.0 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 759.0 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F02/ship> ;
            sh:resultMessage "Transverse penetration must equal 760 mm." ;
            sh:resultPath nltl:transversePenetration ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Transverse penetration must equal 760 mm." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 760.0 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 760.0 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:transversePenetration ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F02/transversePenetrationValue> ] .

