@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ;
            sh:resultMessage "Damage extents and selected vertical damage position do not satisfy the required Polar Code formulas and range." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Damage extents and selected vertical damage position do not satisfy the required Polar Code formulas and range." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthNode ;
                      nltl:upperIceWaterlineDraught ?draughtNode ;
                      nltl:longitudinalDamageExtent ?longitudinalNode ;
                      nltl:verticalDamageExtent ?verticalNode ;
                      nltl:selectedVerticalDamagePosition ?positionNode .

                ?lengthNode qudt:numericValue ?length ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                ?draughtNode qudt:numericValue ?draught ;
                             qudt:unit <http://qudt.org/vocab/unit/M> .
                ?longitudinalNode qudt:numericValue ?longitudinal ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                ?verticalNode qudt:numericValue ?vertical ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                ?positionNode qudt:numericValue ?position ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .

                FILTER (
                    ABS(
                        ?longitudinal -
                        IF(
                            ?forward = true,
                            0.045 * ?length,
                            0.015 * ?length
                        )
                    ) >
                    (
                        ABS(
                            IF(
                                ?forward = true,
                                0.045 * ?length,
                                0.015 * ?length
                            )
                        ) * 0.000001 + 0.000000001
                    )
                    ||
                    ABS(
                        ?vertical -
                        IF(
                            0.20 * ?draught < ?longitudinal,
                            0.20 * ?draught,
                            ?longitudinal
                        )
                    ) >
                    (
                        ABS(
                            IF(
                                0.20 * ?draught < ?longitudinal,
                                0.20 * ?draught,
                                ?longitudinal
                            )
                        ) * 0.000001 + 0.000000001
                    )
                    ||
                    ?position > (1.20 * ?draught)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_038_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ] .

