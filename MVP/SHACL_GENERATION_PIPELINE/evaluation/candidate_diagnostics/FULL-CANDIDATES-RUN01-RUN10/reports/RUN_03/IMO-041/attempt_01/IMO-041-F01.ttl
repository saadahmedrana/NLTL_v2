@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-041-F01/ship> ;
            sh:resultMessage "Ships with hydraulically operated hatches or doors shall provide freezing or excessive-viscosity control for the hydraulic fluid." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Ships with hydraulically operated hatches or doors shall provide freezing or excessive-viscosity control for the hydraulic fluid." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:openingActuationType ?actuation .
                FILTER (STR(?actuation) = "hydraulic")
                FILTER NOT EXISTS {
                    $this nltl:hydraulicFluidFreezingOrViscosityControlPresent ?protection .
                    FILTER (
                        datatype(?protection) = xsd:boolean &&
                        ?protection = true
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_041_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-041-F01/ship> ] .

