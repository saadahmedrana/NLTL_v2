@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-041-F02/ship> ;
            sh:resultMessage "When the opening actuation type is hydraulic, hydraulic-fluid freezing or excessive-viscosity protection must be present and true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the opening actuation type is hydraulic, hydraulic-fluid freezing or excessive-viscosity protection must be present and true." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:openingActuationType ?actuationType .
                FILTER (STR(?actuationType) = "hydraulic")
                FILTER NOT EXISTS {
                    $this nltl:hydraulicFluidFreezingOrViscosityControlPresent ?protection .
                    FILTER (?protection = true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO041Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-041-F02/ship> ] .

