@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F03/engine1> ;
                    sh:resultMessage "Combustion air temperature shall be within the engine manufacturer's specified minimum and maximum limits." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "Combustion air temperature shall be within the engine manufacturer's specified minimum and maximum limits." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:combustionAirTemperature ?temperatureQuantity .
                ?temperatureQuantity qudt:numericValue ?temperatureValue ;
                                     qudt:unit <http://qudt.org/vocab/unit/DEG_C> .

                $this nltl:manufacturerMinAirTemperature ?minimumQuantity .
                ?minimumQuantity qudt:numericValue ?minimumValue ;
                                 qudt:unit <http://qudt.org/vocab/unit/DEG_C> .

                $this nltl:manufacturerMaxAirTemperature ?maximumQuantity .
                ?maximumQuantity qudt:numericValue ?maximumValue ;
                                 qudt:unit <http://qudt.org/vocab/unit/DEG_C> .

                FILTER (
                    ?temperatureValue < ?minimumValue ||
                    ?temperatureValue > ?maximumValue
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:IMO_047_EssentialEngineShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F03/engine1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO_047_EssentialEngineShape. See details for more information." ;
            sh:resultPath nltl:hasEssentialEngine ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:essentialEngine ;
                    sh:node gen:IMO_047_EssentialEngineShape ;
                    sh:path nltl:hasEssentialEngine ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F03/engine1> ] .

