@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F04/engine1> ;
                    sh:resultMessage "Each essential engine shall provide its manufacturer minimum air temperature." ;
                    sh:resultPath nltl:manufacturerMinAirTemperature ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each essential engine shall provide its manufacturer minimum air temperature." ;
                            sh:minCount 1 ;
                            sh:node gen:IMO_047_TemperatureQuantityShape ;
                            sh:path nltl:manufacturerMinAirTemperature ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO_047_EssentialEngineShape. See details for more information." ;
            sh:resultPath nltl:hasEssentialEngine ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:essentialEngine ;
                    sh:node gen:IMO_047_EssentialEngineShape ;
                    sh:path nltl:hasEssentialEngine ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F04/engine1> ] .

