@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F04/ship> ;
            sh:resultMessage "The approval basis shall include the polar service temperature in degrees Celsius." ;
            sh:resultPath nltl:polarServiceTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:message "The approval basis shall include the polar service temperature in degrees Celsius." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue unit:DEG_C ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:polarServiceTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F04/ship> ;
            sh:resultMessage "The approval shall identify an Organization-acceptable standard or another standard offering an equivalent level of safety." ;
            sh:resultPath nltl:approvalStandard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "standard acceptable to the Organization" "another standard offering an equivalent level of safety" ) ;
                    sh:message "The approval shall identify an Organization-acceptable standard or another standard offering an equivalent level of safety." ;
                    sh:minCount 1 ;
                    sh:path nltl:approvalStandard ] ;
            sh:value "standard acceptable to the Organization"^^xsd:string ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F04/ship> ;
            sh:resultMessage "The approval shall identify the Administration or a recognized organization accepted by the Administration as the approving authority." ;
            sh:resultPath nltl:approvingAuthority ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "Administration" "recognized organization accepted by the Administration" ) ;
                    sh:message "The approval shall identify the Administration or a recognized organization accepted by the Administration as the approving authority." ;
                    sh:minCount 1 ;
                    sh:path nltl:approvingAuthority ] ;
            sh:value "Administration"^^xsd:string ] .

