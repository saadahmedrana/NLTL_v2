@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-P01/ship> ;
            sh:resultMessage "When exposed machinery or foundation material is represented, its approval must identify an authorized authority and standard, have approved status, and preserve the polar service temperature basis." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_048_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-P01/ship> ] .

