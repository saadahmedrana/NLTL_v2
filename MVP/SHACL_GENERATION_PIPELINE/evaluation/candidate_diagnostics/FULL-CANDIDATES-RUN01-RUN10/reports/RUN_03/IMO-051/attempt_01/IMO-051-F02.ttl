@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F02/control1> ;
            sh:resultMessage "Each linked local control item must remain continuously accessible." ;
            sh:resultPath nltl:localControlContinuouslyAccessible ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n73c0a6eca9274c38a6d650eaf7a6f7adb2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F02/control1> ;
            sh:resultMessage "Each linked local control item must have freezing, snow, and ice protection." ;
            sh:resultPath nltl:localControlProtectionPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n73c0a6eca9274c38a6d650eaf7a6f7adb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F02/control1> ;
            sh:resultMessage "Each linked local control item must have freezing, snow, and ice protection." ;
            sh:resultPath nltl:localControlProtectionPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n73c0a6eca9274c38a6d650eaf7a6f7adb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F02/control1> ;
            sh:resultMessage "Each linked local control item must remain continuously accessible." ;
            sh:resultPath nltl:localControlContinuouslyAccessible ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n73c0a6eca9274c38a6d650eaf7a6f7adb2 ] .

_:n73c0a6eca9274c38a6d650eaf7a6f7adb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Each linked local control item must have freezing, snow, and ice protection." ;
    sh:minCount 1 ;
    sh:path nltl:localControlProtectionPresent .

_:n73c0a6eca9274c38a6d650eaf7a6f7adb2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Each linked local control item must remain continuously accessible." ;
    sh:minCount 1 ;
    sh:path nltl:localControlContinuouslyAccessible .

