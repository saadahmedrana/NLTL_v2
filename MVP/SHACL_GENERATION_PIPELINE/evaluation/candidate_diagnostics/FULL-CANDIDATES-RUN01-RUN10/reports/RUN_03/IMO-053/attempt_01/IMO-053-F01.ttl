@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-F01/medium1> ;
                    sh:resultMessage "The extinguishing medium must have intended-operation compatibility status approved." ;
                    sh:resultPath nltl:extinguishingMediumCompatibilityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "The extinguishing medium must have intended-operation compatibility status approved." ;
                            sh:minCount 1 ;
                            sh:path nltl:extinguishingMediumCompatibilityStatus ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-F01/ship> ;
            sh:resultMessage "Every linked extinguishing medium must have approved intended-operation compatibility status." ;
            sh:resultPath nltl:hasExtinguishingMedium ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Every linked extinguishing medium must have approved intended-operation compatibility status." ;
                    sh:node gen:IMO_053_ExtinguishingMediumShape ;
                    sh:path nltl:hasExtinguishingMedium ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-F01/medium1> ] .

