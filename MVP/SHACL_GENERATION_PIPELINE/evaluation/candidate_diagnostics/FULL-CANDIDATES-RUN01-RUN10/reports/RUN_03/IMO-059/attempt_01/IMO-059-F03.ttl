                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F03/outfit1Store> ;
                            sh:resultMessage "The storage location for each firefighter outfit shall be classified as warm." ;
