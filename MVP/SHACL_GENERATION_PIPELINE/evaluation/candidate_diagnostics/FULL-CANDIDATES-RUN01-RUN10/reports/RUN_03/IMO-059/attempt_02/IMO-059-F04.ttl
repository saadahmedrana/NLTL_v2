@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F04/outfit2ColdClass> ;
                                    sh:resultMessage "The storage location must be classified as warm." ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape [ a sh:NodeShape ;
                                            sh:class nltl:storageTemperatureClassValue ;
                                            sh:hasValue nltl:warmStorageLocation ;
                                            sh:message "The storage location must be classified as warm." ] ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F04/outfit2Store> ;
                            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:class nltl:storageTemperatureClassValue ; sh:hasValue nltl:warmStorageLocation ; sh:message Literal(\"The storage location must be classified as warm.\") ]. See details for more information." ;
                            sh:resultPath nltl:storageTemperatureClass ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
                                    sh:node [ a sh:NodeShape ;
                                            sh:class nltl:storageTemperatureClassValue ;
                                            sh:hasValue nltl:warmStorageLocation ;
                                            sh:message "The storage location must be classified as warm." ] ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:storageTemperatureClass ] ;
                            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F04/outfit2ColdClass> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F04/outfit2> ;
                    sh:resultMessage "Each firefighter outfit must have a storage location." ;
                    sh:resultPath nltl:hasStorageLocation ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Each firefighter outfit must have a storage location." ;
                            sh:minCount 1 ;
                            sh:node [ a sh:NodeShape ;
                                    sh:class nltl:physicalStorageLocation ;
                                    sh:property [ sh:minCount 1 ;
                                            sh:node [ a sh:NodeShape ;
                                                    sh:class nltl:storageTemperatureClassValue ;
                                                    sh:hasValue nltl:warmStorageLocation ;
                                                    sh:message "The storage location must be classified as warm." ] ;
                                            sh:nodeKind sh:IRI ;
                                            sh:path nltl:storageTemperatureClass ] ] ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:hasStorageLocation ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F04/outfit2Store> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:class nltl:equipmentItem, nltl:firefighterOutfitItem ; sh:property [ sh:message Literal(\"Each firefighter outfit must have a storage location.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ rdf:type sh:NodeShape ; sh:class nltl:physicalStorageLocation ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ rdf:type sh:NodeShape ; sh:class nltl:storageTemperatureClassValue ; sh:hasValue nltl:warmStorageLocation ; sh:message Literal(\"The storage location must be classified as warm.\") ] ; sh:nodeKind sh:IRI ; sh:path nltl:storageTemperatureClass ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:hasStorageLocation ] ]. See details for more information." ;
            sh:resultPath nltl:hasFirefighterOutfit ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ a sh:NodeShape ;
                            sh:class nltl:equipmentItem,
                                nltl:firefighterOutfitItem ;
                            sh:property [ sh:message "Each firefighter outfit must have a storage location." ;
                                    sh:minCount 1 ;
                                    sh:node [ a sh:NodeShape ;
                                            sh:class nltl:physicalStorageLocation ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:nodeKind sh:IRI ;
                                                    sh:path nltl:storageTemperatureClass ] ] ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:hasStorageLocation ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasFirefighterOutfit ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F04/outfit2> ] .

