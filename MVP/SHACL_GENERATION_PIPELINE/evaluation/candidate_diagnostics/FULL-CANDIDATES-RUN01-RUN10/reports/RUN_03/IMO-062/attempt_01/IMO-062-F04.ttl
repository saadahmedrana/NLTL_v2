                    sh:resultMessage "Each exposed escape route shall be accessible." ;
                    sh:resultPath nltl:escapeRouteAccessibleStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n957040107333486cb63f1d91b9390d3ab9 ],
                [ a sh:ValidationResult ;
