@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Applicability must indicate that the ship is exposed to ice accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipExposedToIceAccretion ], [ sh:message Literal(\"A launching appliance must be represented as a protected item with ice or snow removal or prevention means.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO066LaunchingApplianceItemShape ], [ sh:message Literal(\"A muster station must be represented as a protected item with ice or snow removal or prevention means.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO066MusterStationItemShape ], [ sh:message Literal(\"A survival craft must be represented as a protected item with ice or snow removal or prevention means.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO066SurvivalCraftItemShape ], [ sh:message Literal(\"Access to a survival craft must be represented as a protected item with ice or snow removal or prevention means.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO066SurvivalCraftAccessItemShape ], [ sh:message Literal(\"An embarkation area must be represented as a protected item with ice or snow removal or prevention means.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO066EmbarkationAreaItemShape ], [ sh:message Literal(\"An exposed escape route must be represented as a protected item with ice or snow removal or prevention means.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO066EscapeRouteItemShape ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"Applicability must indicate that the ship is not exposed to ice accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipExposedToIceAccretion ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO066ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F04/ship> ] .

