@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P03/ship> ;
            sh:resultMessage "A passenger ship must declare that assigned survival equipment is size-compatible." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n882b66f109634e959936e1d00f7bdef1b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P03/ship> ;
            sh:resultMessage "A passenger ship must declare that assigned survival equipment is size-compatible." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n882b66f109634e959936e1d00f7bdef1b1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P03/person1> ;
                    sh:resultMessage "Each person on board must have one personal survival equipment assignment." ;
                    sh:resultPath nltl:hasPersonalSurvivalEquipmentAssignment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MaxCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each person on board must have one personal survival equipment assignment." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:IMO-070-AssignmentShape> ;
                            sh:path nltl:hasPersonalSurvivalEquipmentAssignment ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P03/ship> ;
            sh:resultMessage "Each represented person on board must have a compliant survival-equipment assignment." ;
            sh:resultPath nltl:hasPersonOnBoardMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each represented person on board must have a compliant survival-equipment assignment." ;
                    sh:node <urn:nltl:generated-shape:IMO-070-PersonShape> ;
                    sh:path nltl:hasPersonOnBoardMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P03/person1> ] .

_:n882b66f109634e959936e1d00f7bdef1b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "A passenger ship must declare that assigned survival equipment is size-compatible." ;
    sh:minCount 1 ;
    sh:path nltl:sizeCompatibilityStatus .

