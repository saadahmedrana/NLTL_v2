@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F01/ship> ;
            sh:resultMessage "When personal or group survival equipment is required, available survival equipment capacity must be at least 110 percent of persons on board." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When personal or group survival equipment is required, available survival equipment capacity must be at least 110 percent of persons on board." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:personalOrGroupSurvivalEquipmentRequired true ;
                      nltl:personsOnBoard ?persons ;
                      nltl:availableSurvivalEquipmentCapacity ?capacity .
                FILTER (
                    datatype(?persons) = xsd:integer &&
                    datatype(?capacity) = xsd:integer &&
                    (10 * ?capacity) < (11 * ?persons)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO075Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:personalOrGroupSurvivalEquipmentRequired ] ] , [ sh:property [ sh:class qudt:QuantityValue ; sh:message Literal(\"The storage distance must be recorded as a metre-valued quantity representing stowage as close as practical to a muster or embarkation station.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:storageDistanceToMusterOrEmbarkation ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:personalOrGroupSurvivalEquipmentRequired ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:storageAccessibilityStatus ], [ sh:datatype xsd:integer ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:availableSurvivalEquipmentCapacity ], [ sh:datatype xsd:integer ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:personsOnBoard ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO075Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F01/ship> ] .

