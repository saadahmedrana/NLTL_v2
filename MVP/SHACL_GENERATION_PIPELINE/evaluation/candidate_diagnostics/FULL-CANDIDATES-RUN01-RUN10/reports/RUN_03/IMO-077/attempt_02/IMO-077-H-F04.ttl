@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in nltlgen:IMO_077_NotCarriedShape , nltlgen:IMO_077_CarriedShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:IMO_077_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F04/ship> ] .

