@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F05/ship> ;
            sh:resultMessage "The additional-equipment applicability value must be present exactly once and be boolean." ;
            sh:resultPath nltl:additionalEquipmentCarriedInSurvivalCraft ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The additional-equipment applicability value must be present exactly once and be boolean." ;
                    sh:minCount 1 ;
                    sh:path nltl:additionalEquipmentCarriedInSurvivalCraft ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:IMO077NotApplicableShape , gen:IMO077ApplicableShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO077Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F05/ship> ] .

