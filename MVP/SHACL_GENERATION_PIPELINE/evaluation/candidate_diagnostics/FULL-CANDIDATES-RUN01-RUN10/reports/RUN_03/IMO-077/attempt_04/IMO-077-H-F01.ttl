@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F01/ship> ;
            sh:resultMessage "When additional equipment is carried, survival-craft capacity must be at least the persons capacity requirement plus the additional equipment capacity requirement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When additional equipment is carried, survival-craft capacity must be at least the persons capacity requirement plus the additional equipment capacity requirement." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:additionalEquipmentCarriedInSurvivalCraft ?carried .
                FILTER (?carried = true)
                FILTER NOT EXISTS {
                    $this nltl:personsCapacityRequirement ?persons ;
                         nltl:additionalEquipmentCapacityRequirement ?additional ;
                         nltl:survivalCraftAvailableCapacity ?available .
                    FILTER (
                        datatype(?persons) = xsd:integer &&
                        datatype(?additional) = xsd:integer &&
                        datatype(?available) = xsd:integer &&
                        ?available >= (?persons + ?additional)
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-077> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F01/ship> ] .

