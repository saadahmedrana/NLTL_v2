@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F02/ship> ;
            sh:resultMessage "When additional equipment is carried, launching-appliance capacity must be at least the loaded survival-craft requirement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When additional equipment is carried, launching-appliance capacity must be at least the loaded survival-craft requirement." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:additionalEquipmentCarriedInSurvivalCraft ?carried .
                FILTER (?carried = true)
                FILTER NOT EXISTS {
                    $this nltl:launchingApplianceCapacity ?launching ;
                         nltl:loadedSurvivalCraftRequirement ?loaded .
                    ?launching qudt:numericValue ?launchingValue ;
                              qudt:unit unit:KiloGM .
                    ?loaded qudt:numericValue ?loadedValue ;
                            qudt:unit unit:KiloGM .
                    FILTER (
                        datatype(?launchingValue) = xsd:decimal &&
                        datatype(?loadedValue) = xsd:decimal &&
                        ?launchingValue >= ?loadedValue
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-077> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F02/ship> ] .

