@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F04/ship> ;
            sh:resultMessage "For ships constructed on or after 1 January 2017 and ice strengthened, the required independent echo-sounding equipment alternative must be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_081_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F04/ship> ] .

