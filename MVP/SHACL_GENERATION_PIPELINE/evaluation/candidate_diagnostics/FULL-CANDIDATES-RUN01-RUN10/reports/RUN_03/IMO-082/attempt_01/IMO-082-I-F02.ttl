@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:message Literal("A clear view astern shall be compliant when required by the bridge configuration.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:clearViewAsternStatus ], [ sh:hasValue nltl:asternViewRequiredBridgeConfiguration ; sh:path nltl:bridgeConfigurationType ] ] , [ sh:sparql [ sh:message Literal("The bridge configuration shall either require a compliant clear view astern or identify a configuration for which it is not required.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        FILTER EXISTS {
                            $this nltl:bridgeConfigurationType
                                nltl:asternViewRequiredBridgeConfiguration .
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_082_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F02/ship> ] .

