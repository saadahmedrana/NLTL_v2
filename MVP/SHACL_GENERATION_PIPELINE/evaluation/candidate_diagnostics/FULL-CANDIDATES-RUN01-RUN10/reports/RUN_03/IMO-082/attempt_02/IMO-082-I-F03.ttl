@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A bridge configuration requiring an astern view must have clear view astern status true.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:clearViewAsternStatus ], [ sh:hasValue nltl:asternViewRequiredBridgeConfiguration ; sh:path nltl:bridgeConfigurationType ] ] , [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:not [ sh:hasValue nltl:asternViewRequiredBridgeConfiguration ] ; sh:path nltl:bridgeConfigurationType ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_082_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F03/ship> ;
            sh:resultMessage "The bridge configuration type is required to determine whether clear astern visibility applies." ;
            sh:resultPath nltl:bridgeConfigurationType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:bridgeConfigurationValue ;
                    sh:maxCount 1 ;
                    sh:message "The bridge configuration type is required to determine whether clear astern visibility applies." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:bridgeConfigurationType ] ] .

