@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F04/ship> ;
            sh:resultMessage "The ship must comply with SOLAS regulation V/22.1.9.4." ;
            sh:resultPath nltl:solasRegulationV22Point1Point9Point4ComplianceStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n2a3ff4a3041d46539c292479c9a7c43fb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F04/ship> ;
            sh:resultMessage "The ship must comply with SOLAS regulation V/22.1.9.4." ;
            sh:resultPath nltl:solasRegulationV22Point1Point9Point4ComplianceStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n2a3ff4a3041d46539c292479c9a7c43fb1 ] .

_:n2a3ff4a3041d46539c292479c9a7c43fb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must comply with SOLAS regulation V/22.1.9.4." ;
    sh:minCount 1 ;
    sh:path nltl:solasRegulationV22Point1Point9Point4ComplianceStatus .

