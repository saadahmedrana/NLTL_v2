@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-084-I-F03/ship> ;
            sh:resultMessage "When sensors project below the hull, sensor ice protection must be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When sensors project below the hull, sensor ice protection must be present." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this nltl:requiredSensorProjectsBelowHull ?required .
                FILTER (?required = "true"^^xsd:boolean)
                FILTER NOT EXISTS {
                    ?this nltl:sensorIceProtectionPresent ?protected .
                    FILTER (?protected = "true"^^xsd:boolean)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-084> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-084-I-F03/ship> ] .

