@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:IMO087LatitudeNotOver80 , gs:IMO087LatitudeOver80" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO087ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F04/ship> ] .

