@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-F06/ship> ;
            sh:resultMessage "Icebreaker escort operation status is required to determine applicability." ;
            sh:resultPath nltl:icebreakerEscortOperation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Icebreaker escort operation status is required to determine applicability." ;
                    sh:minCount 1 ;
                    sh:path nltl:icebreakerEscortOperation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-F06/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:IMO_089_EscortApplicable , gs:IMO_089_EscortNotApplicable" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO_089_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-F06/ship> ] .

