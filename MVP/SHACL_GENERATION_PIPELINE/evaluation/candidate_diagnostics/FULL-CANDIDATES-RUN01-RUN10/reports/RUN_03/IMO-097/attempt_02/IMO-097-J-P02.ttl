@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P02/ship> ;
            sh:resultMessage "The ship must provide its lifeboat relationship and each linked lifeboat must carry the required distress-alert device." ;
            sh:resultPath nltl:hasLifeboat ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide its lifeboat relationship and each linked lifeboat must carry the required distress-alert device." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-097-LifeboatShape> ;
                    sh:path nltl:hasLifeboat ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P02/ship> ;
            sh:resultMessage "The ship must indicate that a rescue boat or lifeboat is released for evacuation." ;
            sh:resultPath nltl:releasedRescueBoatOrLifeboat ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb803b7ba8e7144eeaa221e768c16b246b2 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P02/craft1> ;
                    sh:resultMessage "Each applicable lifeboat must carry at least one ship-to-shore distress-alert device." ;
                    sh:resultPath nltl:hasDistressAlertDevice ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nb803b7ba8e7144eeaa221e768c16b246b7 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P02/ship> ;
            sh:resultMessage "The ship must provide the declared required rescue-boat or lifeboat relationship." ;
            sh:resultPath nltl:hasRequiredRescueBoatOrLifeboat ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nb803b7ba8e7144eeaa221e768c16b246b5 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P02/craft1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P02/ship> ;
            sh:resultMessage "The ship must indicate that a rescue boat or lifeboat is released for evacuation." ;
            sh:resultPath nltl:releasedRescueBoatOrLifeboat ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb803b7ba8e7144eeaa221e768c16b246b2 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P02/craft2> ;
                    sh:resultMessage "Each applicable lifeboat must carry at least one ship-to-shore distress-alert device." ;
                    sh:resultPath nltl:hasDistressAlertDevice ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nb803b7ba8e7144eeaa221e768c16b246b7 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P02/ship> ;
            sh:resultMessage "The ship must provide the declared required rescue-boat or lifeboat relationship." ;
            sh:resultPath nltl:hasRequiredRescueBoatOrLifeboat ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nb803b7ba8e7144eeaa221e768c16b246b5 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P02/craft2> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P02/ship> ;
            sh:resultMessage "The ship must provide the declared other-survival-craft relationship." ;
            sh:resultPath nltl:hasOtherSurvivalCraft ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the declared other-survival-craft relationship." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasOtherSurvivalCraft ] ] .

_:nb803b7ba8e7144eeaa221e768c16b246b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must indicate that a rescue boat or lifeboat is released for evacuation." ;
    sh:minCount 1 ;
    sh:path nltl:releasedRescueBoatOrLifeboat .

_:nb803b7ba8e7144eeaa221e768c16b246b5 sh:message "The ship must provide the declared required rescue-boat or lifeboat relationship." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:IMO-097-LifeboatShape> ;
    sh:path nltl:hasRequiredRescueBoatOrLifeboat .

_:nb803b7ba8e7144eeaa221e768c16b246b7 sh:message "Each applicable lifeboat must carry at least one ship-to-shore distress-alert device." ;
    sh:minCount 1 ;
    sh:path nltl:hasDistressAlertDevice .

