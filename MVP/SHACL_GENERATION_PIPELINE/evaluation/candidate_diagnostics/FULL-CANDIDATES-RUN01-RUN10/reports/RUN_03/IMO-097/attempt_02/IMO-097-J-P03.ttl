@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P03/ship> ;
            sh:resultMessage "The ship must provide its lifeboat relationship and each linked lifeboat must carry the required distress-alert device." ;
            sh:resultPath nltl:hasLifeboat ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide its lifeboat relationship and each linked lifeboat must carry the required distress-alert device." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-097-LifeboatShape> ;
                    sh:path nltl:hasLifeboat ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P03/ship> ;
            sh:resultMessage "The ship must provide the declared required rescue-boat or lifeboat relationship." ;
            sh:resultPath nltl:hasRequiredRescueBoatOrLifeboat ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the declared required rescue-boat or lifeboat relationship." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-097-LifeboatShape> ;
                    sh:path nltl:hasRequiredRescueBoatOrLifeboat ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P03/ship> ;
            sh:resultMessage "The ship must provide the declared other-survival-craft relationship." ;
            sh:resultPath nltl:hasOtherSurvivalCraft ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the declared other-survival-craft relationship." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasOtherSurvivalCraft ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P03/ship> ;
            sh:resultMessage "The ship must indicate that a rescue boat or lifeboat is released for evacuation." ;
            sh:resultPath nltl:releasedRescueBoatOrLifeboat ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb803b7ba8e7144eeaa221e768c16b246b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P03/ship> ;
            sh:resultMessage "The ship must indicate that it operates in low air temperature." ;
            sh:resultPath nltl:shipOperatesInLowAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The ship must indicate that it operates in low air temperature." ;
                    sh:minCount 1 ;
                    sh:path nltl:shipOperatesInLowAirTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P03/ship> ;
            sh:resultMessage "Each linked survival craft must carry the required communication devices." ;
            sh:resultPath nltl:hasSurvivalCraft ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked survival craft must carry the required communication devices." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-097-SurvivalCraftShape> ;
                    sh:path nltl:hasSurvivalCraft ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P03/ship> ;
            sh:resultMessage "The ship must indicate that a rescue boat or lifeboat is released for evacuation." ;
            sh:resultPath nltl:releasedRescueBoatOrLifeboat ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb803b7ba8e7144eeaa221e768c16b246b2 ] .

_:nb803b7ba8e7144eeaa221e768c16b246b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must indicate that a rescue boat or lifeboat is released for evacuation." ;
    sh:minCount 1 ;
    sh:path nltl:releasedRescueBoatOrLifeboat .

