@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F02/craft1> ;
                    sh:resultMessage "The rescue boat or lifeboat release applicability must be recorded." ;
                    sh:resultPath nltl:releasedRescueBoatOrLifeboat ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:message "The rescue boat or lifeboat release applicability must be recorded." ;
                            sh:minCount 1 ;
                            sh:path nltl:releasedRescueBoatOrLifeboat ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-097-RequiredCraftShape>. See details for more information." ;
            sh:resultPath nltl:hasRequiredRescueBoatOrLifeboat ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:lifeboat ;
                    sh:node <urn:nltl:generated-shape:IMO-097-RequiredCraftShape> ;
                    sh:path nltl:hasRequiredRescueBoatOrLifeboat ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F02/craft1> ] .

