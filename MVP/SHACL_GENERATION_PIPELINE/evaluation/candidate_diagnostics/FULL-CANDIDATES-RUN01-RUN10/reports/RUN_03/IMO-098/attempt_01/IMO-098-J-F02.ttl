@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-098-J-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInLowAirTemperature ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInLowAirTemperature ], [ sh:node [ sh:class nltl:otherSurvivalCraft ; sh:property [ sh:class nltl:locationSignalDevice ; sh:message Literal(\"Each other survival craft must carry at least one location-signal device.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasLocationSignalDevice ], [ sh:class nltl:onSceneCommunicationDevice ; sh:message Literal(\"Each other survival craft must carry at least one on-scene transmit/receive communication device.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasOnSceneCommunicationDevice ] ] ; sh:path nltl:hasOtherSurvivalCraft ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_098_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-098-J-F02/ship> ] .

