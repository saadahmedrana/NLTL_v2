@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/routePlan> ;
                    sh:resultMessage "The polar route plan must record voyage planning topic coverage as true." ;
                    sh:resultPath nltl:voyagePlanningTopicCoverage ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n9b642f27e56748d88c0e083eb9842076b3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/routePlan> ;
                    sh:resultMessage "The polar route plan must record voyage planning topic coverage as true." ;
                    sh:resultPath nltl:voyagePlanningTopicCoverage ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n9b642f27e56748d88c0e083eb9842076b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/ship> ;
            sh:resultMessage "The ship must have a polar route plan with the required voyage planning topic coverage." ;
            sh:resultPath nltl:hasPolarRoutePlan ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarRoutePlan ;
                    sh:message "The ship must have a polar route plan with the required voyage planning topic coverage." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The polar route plan must record voyage planning topic coverage as true." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:voyagePlanningTopicCoverage ] ] ;
                    sh:path nltl:hasPolarRoutePlan ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/routePlan> ] .

_:n9b642f27e56748d88c0e083eb9842076b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The polar route plan must record voyage planning topic coverage as true." ;
    sh:minCount 1 ;
    sh:path nltl:voyagePlanningTopicCoverage .

