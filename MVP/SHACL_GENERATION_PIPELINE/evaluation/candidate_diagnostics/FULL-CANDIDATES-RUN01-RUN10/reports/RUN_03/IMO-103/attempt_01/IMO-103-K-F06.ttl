@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-103-K-F06/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:alternateQualifiedPersonUsed ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Administration permission must be approved when an alternate qualified person is used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:administrationPermissionStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Advanced polar training is required for the alternate qualified person.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:advancedPolarTrainingStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"STCW Code section A-II/2 compliance is required for the alternate qualified person.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stcwCodeSectionAIi2ComplianceStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"STCW Convention regulation II/2 compliance is required for the alternate qualified person.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stcwConventionRegulationIi2ComplianceStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Sufficient trained persons must cover all watches while operating in polar waters.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:watchCoverageStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The alternate qualified person must comply with the Administration's minimum rest requirements.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:restComplianceStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:alternateQualifiedPersonUsed ], [ sh:datatype xsd:string ; sh:in ( Literal(\"passenger ship\") Literal(\"tanker\") Literal(\"cargo ship other than tanker\") ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship type is required to determine the applicable basic-training safeguard.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipType ], [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The operating ice condition is required to determine the applicable basic-training safeguard.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceCondition ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Ice concentration, expressed as a dimensionless quantity, is required when an alternate qualified person is used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:iceConcentration ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_103_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-103-K-F06/ship> ] .

