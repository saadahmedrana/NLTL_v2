@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F04/ship> ;
            sh:resultMessage "The ship must identify its crew members through hasCrewMember." ;
            sh:resultPath nltl:hasCrewMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:crewMember ;
                    sh:message "The ship must identify its crew members through hasCrewMember." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO_104_CrewMemberShape ;
                    sh:path nltl:hasCrewMember ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F04/record1> ;
                            sh:resultMessage "Each familiarization record must identify the relevant PWOM item." ;
                            sh:resultPath nltl:familiarizationRecordItem ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:class nltl:polarWaterOperationalManualItem ;
                                    sh:message "Each familiarization record must identify the relevant PWOM item." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:familiarizationRecordItem ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F04/crew1> ;
                    sh:resultMessage "Each crew member must have a PWOM familiarization record." ;
                    sh:resultPath nltl:hasFamiliarizationRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:familiarizationRecord ;
                            sh:message "Each crew member must have a PWOM familiarization record." ;
                            sh:minCount 1 ;
                            sh:node gen:IMO_104_FamiliarizationRecordShape ;
                            sh:path nltl:hasFamiliarizationRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F04/record1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F04/ship> ;
            sh:resultMessage "The ship must identify applicable crew members through hasCrewMemberInventory." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:crewMember ;
                    sh:message "The ship must identify applicable crew members through hasCrewMemberInventory." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO_104_CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F04/crew1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F04/ship> ;
            sh:resultMessage "The ship must record completed PWOM familiarization status." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n55730c31f5944d4dbb4cbd7b8bcfb884b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F04/ship> ;
            sh:resultMessage "The ship must record completed PWOM familiarization status." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n55730c31f5944d4dbb4cbd7b8bcfb884b1 ] .

_:n55730c31f5944d4dbb4cbd7b8bcfb884b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record completed PWOM familiarization status." ;
    sh:minCount 1 ;
    sh:path nltl:polarWaterOperationalManualFamiliarizationStatus .

