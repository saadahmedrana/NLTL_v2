@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For clean or segregated ballast, the paragraph 1.1.1 oil-discharge prohibition must be recorded as not applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ], [ sh:in ( nltl:cleanBallastMaterial nltl:segregatedBallastMaterial ) ; sh:path nltl:dischargedMaterialClassification ] ] , [ sh:property [ sh:not [ sh:in ( nltl:cleanBallastMaterial nltl:segregatedBallastMaterial ) ] ; sh:path nltl:dischargedMaterialClassification ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO106ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F02/ship> ] .

