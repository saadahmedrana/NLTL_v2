@prefix generated: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-112-M-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in generated:IMO112ArcticCaseShape , generated:IMO112NonArcticCaseShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape generated:IMO112Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-112-M-F02/ship> ] .

