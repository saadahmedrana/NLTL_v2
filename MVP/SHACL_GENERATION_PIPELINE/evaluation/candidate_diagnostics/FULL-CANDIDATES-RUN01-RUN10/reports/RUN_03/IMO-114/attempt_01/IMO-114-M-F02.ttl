@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Applicable polar operation shall be reflected in the certificate.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:applicableCertificatePolarOperationEntryPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("2017-01-01", datatype=xsd:date) ; sh:path nltl:constructionDate ], [ sh:datatype xsd:string ; sh:hasValue Literal("3", datatype=xsd:string) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:cargoTankType ], [ sh:hasValue nltl:evidenceStateApproved ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Applicable carriage of NLS in type 3 cargo tanks requires Administration approval.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:administrationCarriageApprovalStatus ], [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:shipCategory ] ] , [ sh:property [ sh:in ( nltl:polarShipCategoryC ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:shipCategory ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxExclusive Literal("2017-01-01", datatype=xsd:date) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionDate ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ] ] , [ sh:property [ sh:datatype xsd:string ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:cargoTankType ; sh:sparql [ sh:message Literal("Cargo tank type must be established as different from type 3 when this alternative establishes non-applicability.") ; sh:select Literal("
                        PREFIX nltl: <https://w3id.org/nltl/vocab#>
                        PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                        SELECT $this
                        WHERE {
                            $this nltl:cargoTankType ?value .
                            FILTER ( ?value = "3"^^xsd:string )
                        }
                    ") ] ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_114_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-F02/ship> ] .

