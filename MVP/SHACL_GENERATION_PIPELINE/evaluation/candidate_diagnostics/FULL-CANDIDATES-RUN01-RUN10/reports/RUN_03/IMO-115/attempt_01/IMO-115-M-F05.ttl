@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-115-M-F05/ship> ;
            sh:resultMessage "When sewage is comminuted and disinfected, the MARPOL status, ice-distance threshold, and ice-condition distance record must conform." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:IMO_115_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-115-M-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-115-M-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:sewageDischargeType" ;
            sh:resultPath nltl:sewageDischargeType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:sewageDischargeType ] ] .

