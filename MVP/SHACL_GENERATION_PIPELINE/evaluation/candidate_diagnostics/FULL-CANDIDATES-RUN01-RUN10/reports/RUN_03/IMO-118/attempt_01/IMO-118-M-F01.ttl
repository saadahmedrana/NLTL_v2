@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F01/ship> ;
            sh:resultMessage "For a ship constructed on or after 1 January 2017 that is Category A or B, or is a passenger ship, sewage discharge to sea must be false unless compliance with Polar Code paragraph 4.2.1.3 is true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a ship constructed on or after 1 January 2017 that is Category A or B, or is a passenger ship, sewage discharge to sea must be false unless compliance with Polar Code paragraph 4.2.1.3 is true." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:constructionDate ?date .
    FILTER (?date >= "2017-01-01"^^xsd:date)

    {
        $this nltl:shipCategory ?category .
        FILTER (?category IN (
            nltl:polarShipCategoryA,
            nltl:polarShipCategoryB
        ))
    }
    UNION
    {
        $this rdf:type nltl:passengerShip .
    }

    FILTER NOT EXISTS {
        $this nltl:sewageDischargeToSea ?discharge .
        FILTER (?discharge = false)
    }

    FILTER NOT EXISTS {
        $this nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ?status .
        FILTER (?status = true)
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-118> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F01/ship> ] .

