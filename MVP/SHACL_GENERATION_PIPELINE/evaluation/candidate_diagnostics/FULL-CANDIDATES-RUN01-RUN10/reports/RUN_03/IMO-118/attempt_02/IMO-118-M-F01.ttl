@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F01/ship> ;
            sh:resultMessage "For ships constructed on or after 1 January 2017, the sewage discharge prohibition applies to Category A or B ships and to passenger ships, subject to paragraph 4.2.1.3 compliance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO118Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F01/ship> ] .

