@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F01/ship> ;
            sh:resultMessage "For an applicable Category A or B ship, sewage discharge requires an approved sewage treatment plant and Administration approval." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an applicable Category A or B ship, sewage discharge requires an approved sewage treatment plant and Administration approval." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:iceConcentration ?iceQuantity ;
                      nltl:extendedPeriodOperation ?extended ;
                      nltl:sewageDischargeOccurs ?discharge .

                ?iceQuantity qudt:numericValue ?iceValue ;
                             qudt:unit unit:UNITLESS .

                FILTER (?category IN (
                    nltl:polarShipCategoryA,
                    nltl:polarShipCategoryB
                ))
                FILTER (?iceValue > 1)
                FILTER (?extended = true)
                FILTER (?discharge = true)

                FILTER (
                    NOT EXISTS {
                        $this nltl:approvedSewageTreatmentPlantUsed true
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:administrationDischargeApprovalStatus
                            nltl:evidenceStateApproved
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-119> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F01/ship> ] .

