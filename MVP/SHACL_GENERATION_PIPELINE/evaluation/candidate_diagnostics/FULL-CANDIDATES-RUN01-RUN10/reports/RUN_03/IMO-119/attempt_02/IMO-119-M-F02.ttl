@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F02/ship> ;
            sh:resultMessage "For Category A or B ships operating above 1/10 ice concentration for an extended period with sewage discharge, an approved sewage treatment plant, approved MARPOL Annex IV certification, and Administration discharge approval are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For Category A or B ships operating above 1/10 ice concentration for an extended period with sewage discharge, an approved sewage treatment plant, approved MARPOL Annex IV certification, and Administration discharge approval are required." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:shipCategory ?category .
    $this nltl:iceConcentration ?ice .
    ?ice qudt:numericValue ?iceValue .
    $this nltl:extendedPeriodOperation true .
    $this nltl:sewageDischargeOccurs true .
    FILTER (
        ?category IN (
            nltl:polarShipCategoryA,
            nltl:polarShipCategoryB
        )
    )
    FILTER (?iceValue > "1"^^xsd:decimal)
    FILTER NOT EXISTS {
        $this nltl:approvedSewageTreatmentPlantUsed true .
        $this nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus nltl:evidenceStateApproved .
        $this nltl:administrationDischargeApprovalStatus nltl:evidenceStateApproved .
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_119_SewageDischargeApprovalShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F02/ship> ] .

