@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-121-N-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in <urn:nltl:generated-shape:IMO-121-NonDischargeBranch> , <urn:nltl:generated-shape:IMO-121-DischargeBranch>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-121-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-121-N-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-121-N-F05/ship> ;
            sh:resultMessage "Food-waste discharge to sea status must be recorded as a single boolean value." ;
            sh:resultPath nltl:foodWasteDischargeToSea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Food-waste discharge to sea status must be recorded as a single boolean value." ;
                    sh:minCount 1 ;
                    sh:path nltl:foodWasteDischargeToSea ] ] .

