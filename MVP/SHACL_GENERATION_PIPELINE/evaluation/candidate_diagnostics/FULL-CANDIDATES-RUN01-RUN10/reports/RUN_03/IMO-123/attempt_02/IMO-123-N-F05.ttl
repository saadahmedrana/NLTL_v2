@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F05/nearbyIceConcentrationValue> ;
                    sh:resultMessage "Node ex:nearbyIceConcentrationValue->qudt:unit does not contain a value in the set: ['qudt:UNITLESS']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F05/ship> ;
            sh:resultMessage "The ice concentration associated with the discharge-distance record must exceed one tenth." ;
            sh:resultPath nltl:nearbyIceConcentration ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ice concentration associated with the discharge-distance record must exceed one tenth." ;
                    sh:minCount 1 ;
                    sh:node gen:NearbyIceConcentrationShape ;
                    sh:path nltl:nearbyIceConcentration ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F05/nearbyIceConcentrationValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F05/distanceToNearestLandIceShelfOrFastIceValue> ;
                            sh:resultMessage "Node ex:distanceToNearestLandIceShelfOrFastIceValue->qudt:unit does not contain a value in the set: ['qudt:MI_N']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:MI_N ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F05/distanceRecord> ;
                    sh:resultMessage "The discharge must be at least 12 nautical miles from the nearest land, ice shelf, or fast ice." ;
                    sh:resultPath nltl:distanceToNearestLandIceShelfOrFastIce ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The discharge must be at least 12 nautical miles from the nearest land, ice shelf, or fast ice." ;
                            sh:minCount 1 ;
                            sh:node gen:NearestLandIceShelfFastIceDistanceShape ;
                            sh:path nltl:distanceToNearestLandIceShelfOrFastIce ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F05/distanceToNearestLandIceShelfOrFastIceValue> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F05/distanceToAreaWithIceConcentrationGreaterThanOneTenthValue> ;
                            sh:resultMessage "Node ex:distanceToAreaWithIceConcentrationGreaterThanOneTenthValue->qudt:unit does not contain a value in the set: ['qudt:MI_N']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:MI_N ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F05/distanceRecord> ;
                    sh:resultMessage "The discharge-distance record must record the distance from an area with ice concentration greater than one tenth." ;
                    sh:resultPath nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The discharge-distance record must record the distance from an area with ice concentration greater than one tenth." ;
                            sh:minCount 1 ;
                            sh:node gen:IceConcentrationAreaDistanceShape ;
                            sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F05/distanceToAreaWithIceConcentrationGreaterThanOneTenthValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F05/ship> ;
            sh:resultMessage "A discharge-distance record with both required distances must be provided." ;
            sh:resultPath nltl:hasDischargeDistanceRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A discharge-distance record with both required distances must be provided." ;
                    sh:minCount 1 ;
                    sh:node gen:DischargeDistanceRecordShape ;
                    sh:path nltl:hasDischargeDistanceRecord ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F05/distanceRecord> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F05/ship> ;
            sh:resultMessage "The route must remain within Arctic waters." ;
            sh:resultPath nltl:routeRemainsWithinArctic ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The route must remain within Arctic waters." ;
                    sh:minCount 1 ;
                    sh:path nltl:routeRemainsWithinArctic ] ] .

