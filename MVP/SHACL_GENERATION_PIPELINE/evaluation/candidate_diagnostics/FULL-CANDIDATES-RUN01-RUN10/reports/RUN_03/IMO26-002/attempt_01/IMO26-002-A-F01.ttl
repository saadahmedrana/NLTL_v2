@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/ship> ;
            sh:resultMessage "Chapter 9-1 applicability must be recorded as true for an applicable ship." ;
            sh:resultPath nltl:polarCodeChapter9Dash1Applicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "Chapter 9-1 applicability must be recorded as true for an applicable ship." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarCodeChapter9Dash1Applicable ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/ship> ;
            sh:resultMessage "Chapter 9-1 applicability does not match the ship type, dimensions, gross tonnage, and trade status." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Chapter 9-1 applicability does not match the ship type, dimensions, gross tonnage, and trade status." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipType ?shipType ;
                      nltl:lengthOverall ?lengthNode ;
                      nltl:grossTonnage ?tonnageNode ;
                      nltl:engagedInTrade ?engaged ;
                      nltl:polarCodeChapter9Dash1Applicable ?applicable .
                ?lengthNode qudt:numericValue ?length .
                ?tonnageNode qudt:numericValue ?tonnage .

                FILTER (
                    ?applicable != true ||
                    !(
                        (
                            ?shipType = "fishing_vessel" &&
                            ?length >= 24
                        ) ||
                        (
                            ?shipType = "pleasure_yacht" &&
                            ?tonnage >= 300 &&
                            ?engaged = false
                        ) ||
                        (
                            ?shipType = "cargo_ship" &&
                            ?tonnage >= 300 &&
                            ?tonnage < 500
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO26_002_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/grossTonnageValue> ;
                    sh:resultMessage "Node ex:grossTonnageValue->qudt:unit does not contain a value in the set: ['qudt:UNITLESS']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/ship> ;
            sh:resultMessage "Gross tonnage is required as a dimensionless quantity to determine applicability." ;
            sh:resultPath nltl:grossTonnage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Gross tonnage is required as a dimensionless quantity to determine applicability." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue qudt:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:grossTonnage ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/grossTonnageValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/lengthOverallValue> ;
                    sh:resultMessage "Node ex:lengthOverallValue->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/ship> ;
            sh:resultMessage "Length overall is required in metres to determine fishing-vessel applicability." ;
            sh:resultPath nltl:lengthOverall ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Length overall is required in metres to determine fishing-vessel applicability." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue qudt:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:lengthOverall ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/lengthOverallValue> ] .

