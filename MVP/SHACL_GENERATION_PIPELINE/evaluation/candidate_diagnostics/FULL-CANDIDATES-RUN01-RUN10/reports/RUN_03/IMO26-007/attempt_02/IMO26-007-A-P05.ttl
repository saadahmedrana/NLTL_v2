@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-007-A-P05/ship> ;
            sh:resultMessage "An ice-strengthened ship constructed on or after 2026-01-01 shall satisfy one of the three depth-sounding equipment alternatives." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO26_007_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-007-A-P05/ship> ] .

