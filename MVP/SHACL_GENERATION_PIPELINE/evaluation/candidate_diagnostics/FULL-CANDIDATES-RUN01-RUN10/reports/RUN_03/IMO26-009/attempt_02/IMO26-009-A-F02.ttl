@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-009-A-F02/antenna2> ;
                    sh:resultMessage "Each required navigation or communication antenna must have means to prevent ice accumulation." ;
                    sh:resultPath nltl:antennaIceAccumulationPreventionPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "Each required navigation or communication antenna must have means to prevent ice accumulation." ;
                            sh:minCount 1 ;
                            sh:path nltl:antennaIceAccumulationPreventionPresent ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-009-A-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO26_009_AntennaShape. See details for more information." ;
            sh:resultPath nltl:hasRequiredNavigationOrCommunicationAntenna ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:IMO26_009_AntennaShape ;
                    sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-009-A-F02/antenna2> ] .

