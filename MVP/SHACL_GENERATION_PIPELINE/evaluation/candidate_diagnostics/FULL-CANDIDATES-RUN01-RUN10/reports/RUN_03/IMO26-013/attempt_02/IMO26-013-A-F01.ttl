@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-013-A-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:integer ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("1", datatype=xsd:integer) ; sh:path nltl:gnssCompassOrEquivalentCount ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:benchmarkEntity ] ; sh:path nltl:connectedToEmergencyPower ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:benchmarkEntity ] ; sh:path nltl:connectedToMainPower ] ; sh:sparql [ sh:message Literal("A latitude over 80 degrees requires at least one GNSS compass or equivalent connected to both main and emergency power.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT ?this
                    WHERE {
                        FILTER (
                            NOT EXISTS {
                                ?this nltl:plannedOrActualLatitude ?latitudeNode .
                                ?latitudeNode qudt:numericValue ?latitude .
                                FILTER (?latitude > 80.0)
                            }
                            ||
                            NOT EXISTS {
                                ?this nltl:gnssCompassOrEquivalentCount ?count .
                                FILTER (?count >= 1)
                            }
                            ||
                            NOT EXISTS {
                                ?this nltl:connectedToMainPower ?mainPower .
                            }
                            ||
                            NOT EXISTS {
                                ?this nltl:connectedToEmergencyPower ?emergencyPower .
                            }
                        )
                    }
                ") ] ] , [ sh:sparql [ sh:message Literal("The non-applicable branch requires that no supplied latitude value is over 80 degrees.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT ?this
                    WHERE {
                        FILTER EXISTS {
                            ?this nltl:plannedOrActualLatitude ?latitudeNode .
                            ?latitudeNode qudt:numericValue ?latitude .
                            FILTER (?latitude > 80.0)
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-013Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-013-A-F01/ship> ] .

