@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-P10/ship> ;
            sh:resultMessage "For a ship operating in polar waters, Chapter 11-1 applicability must be true for the applicable regulated ship category and threshold." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlg:Chapter11Dash1ApplicabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-P10/ship> ] .

