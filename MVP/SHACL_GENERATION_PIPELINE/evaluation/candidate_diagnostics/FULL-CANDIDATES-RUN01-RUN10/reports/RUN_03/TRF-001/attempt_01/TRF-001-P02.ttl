            sh:sourceShape _:n4119c97d0abc478286d5549bbe5ac6f1b3 ] .

_:n4119c97d0abc478286d5549bbe5ac6f1b2 sh:class nltl:iceClassRegulatoryProvisionValue ;
    sh:hasValue nltl:iceClassSection1Point8Provision2021 ;
    sh:message "The 2021 section 1.8 Ice Classes provision must apply to every ship." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:applicableIceClassRegulatoryProvision .

_:n4119c97d0abc478286d5549bbe5ac6f1b3 sh:class nltl:iceClassRegulatoryProvisionValue ;
