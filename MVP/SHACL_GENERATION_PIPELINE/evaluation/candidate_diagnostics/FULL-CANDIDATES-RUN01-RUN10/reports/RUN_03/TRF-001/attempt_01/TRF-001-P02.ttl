            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4119c97d0abc478286d5549bbe5ac6f1b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-P02/ship> ;
            sh:resultMessage "The 2021 section 1.8 Ice Classes provision must apply to every ship." ;
