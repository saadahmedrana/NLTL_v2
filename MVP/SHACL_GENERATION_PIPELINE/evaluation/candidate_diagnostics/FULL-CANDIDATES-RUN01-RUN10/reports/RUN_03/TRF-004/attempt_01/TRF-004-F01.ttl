@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ;
            sh:resultMessage "The construction contract date must establish whether the 2008 Ice Class Regulations apply; for contracts from 2010-01-01 through 2011-12-31, the applicable edition must be 2008." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF004Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ] .

