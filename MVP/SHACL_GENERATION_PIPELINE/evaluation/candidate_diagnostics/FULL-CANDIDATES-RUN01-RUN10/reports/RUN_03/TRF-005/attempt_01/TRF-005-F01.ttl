@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F01/ship> ;
            sh:resultMessage "Ships with a construction stage on or after 1 September 2003 and contracted before 1 January 2010 must identify the 2002 Ice Class Regulations as the applicable regulation edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ships with a construction stage on or after 1 September 2003 and contracted before 1 January 2010 must identify the 2002 Ice Class Regulations as the applicable regulation edition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?stageDate ;
                      nltl:constructionContractDate ?contractDate .

                FILTER (datatype(?stageDate) = xsd:date)
                FILTER (datatype(?contractDate) = xsd:date)

                FILTER (
                    YEAR(?stageDate) > 2003 ||
                    (YEAR(?stageDate) = 2003 && MONTH(?stageDate) > 9) ||
                    (YEAR(?stageDate) = 2003 && MONTH(?stageDate) = 9 && DAY(?stageDate) >= 1)
                )

                FILTER (
                    YEAR(?contractDate) < 2010 ||
                    (YEAR(?contractDate) = 2010 && MONTH(?contractDate) < 1) ||
                    (YEAR(?contractDate) = 2010 && MONTH(?contractDate) = 1 && DAY(?contractDate) < 1)
                )

                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRegulationEdition2002 .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-005> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F01/ship> ] .

