@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:maximumContinuousRatingPower" ;
            sh:resultPath nltl:maximumContinuousRatingPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:maximumContinuousRatingPower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F04/ship> ;
            sh:resultMessage "The ship must have a construction-stage date from 1 November 1986 up to, but not including, 1 September 2003." ;
            sh:resultPath nltl:constructionStageDate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MaxExclusiveConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:date ;
                    sh:maxCount 1 ;
                    sh:maxExclusive "2003-09-01"^^xsd:date ;
                    sh:message "The ship must have a construction-stage date from 1 November 1986 up to, but not including, 1 September 2003." ;
                    sh:minCount 1 ;
                    sh:minInclusive "1986-11-01"^^xsd:date ;
                    sh:path nltl:constructionStageDate ] ;
            sh:value "2003-09-01"^^xsd:date ] .

