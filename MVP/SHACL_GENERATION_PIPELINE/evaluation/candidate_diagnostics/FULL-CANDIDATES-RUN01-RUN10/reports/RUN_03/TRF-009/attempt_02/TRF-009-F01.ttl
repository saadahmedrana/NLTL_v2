@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F01/ship> ;
            sh:resultMessage "From 1 January in the year twenty years after delivery, an applicable IA or IA Super ship must identify one of the permitted 2017 Ice Class Regulations compliance methods." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "From 1 January in the year twenty years after delivery, an applicable IA or IA Super ship must identify one of the permitted 2017 Ice Class Regulations compliance methods." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice .
                FILTER (?ice IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                $this nltl:constructionStageDate ?constructionDate .
                FILTER (
                    YEAR(?constructionDate) < 2003 ||
                    (
                        YEAR(?constructionDate) = 2003 &&
                        MONTH(?constructionDate) < 9
                    )
                )
                $this nltl:assessmentDate ?assessmentDate .
                $this nltl:deliveryDate ?deliveryDate .
                BIND(YEAR(?deliveryDate) + 20 AS ?deadlineYear)
                FILTER (
                    YEAR(?assessmentDate) > ?deadlineYear ||
                    (
                        YEAR(?assessmentDate) = ?deadlineYear &&
                        MONTH(?assessmentDate) >= 1
                    )
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:engineOutputComplianceMethod ?permittedMethod .
                        FILTER (
                            ?permittedMethod IN (
                                nltl:traficom2017Section3Point2Point2Method,
                                nltl:traficom2017Section3Point2Point4Method
                            )
                        )
                    } ||
                    EXISTS {
                        $this nltl:engineOutputComplianceMethod ?invalidMethod .
                        FILTER (
                            ?invalidMethod NOT IN (
                                nltl:traficom2017Section3Point2Point2Method,
                                nltl:traficom2017Section3Point2Point4Method
                            )
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF009ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F01/ship> ] .

