@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F02/ship> ;
            sh:resultMessage "On or after the compliance deadline, engineOutputComplianceMethod must be one of the two permitted 2017 method values." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "On or after the compliance deadline, engineOutputComplianceMethod must be one of the two permitted 2017 method values." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice .
                FILTER (?ice IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                FILTER EXISTS {
                    $this nltl:constructionStageDate ?constructionDate .
                    FILTER (datatype(?constructionDate) = xsd:date)
                    FILTER (
                        YEAR(?constructionDate) < 2003 ||
                        (
                            YEAR(?constructionDate) = 2003 &&
                            (
                                MONTH(?constructionDate) < 9 ||
                                (
                                    MONTH(?constructionDate) = 9 &&
                                    DAY(?constructionDate) < 1
                                )
                            )
                        )
                    )
                }
                $this nltl:assessmentDate ?assessmentDate .
                $this nltl:deliveryDate ?deliveryDate .
                FILTER (datatype(?assessmentDate) = xsd:date)
                FILTER (datatype(?deliveryDate) = xsd:date)
                FILTER (
                    YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20 ||
                    (
                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                        (
                            MONTH(?assessmentDate) > 1 ||
                            (
                                MONTH(?assessmentDate) = 1 &&
                                DAY(?assessmentDate) >= 1
                            )
                        )
                    )
                )
                $this nltl:engineOutputComplianceMethod ?method .
                FILTER (
                    ?method != nltl:traficom2017Section3Point2Point2Method &&
                    ?method != nltl:traficom2017Section3Point2Point4Method
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-009> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F02/ship> ;
            sh:resultMessage "On or after 1 January in the year twenty years after delivery, the ship must specify one permitted 2017 Ice Class Regulations compliance method." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "On or after 1 January in the year twenty years after delivery, the ship must specify one permitted 2017 Ice Class Regulations compliance method." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice .
                FILTER (?ice IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                FILTER EXISTS {
                    $this nltl:constructionStageDate ?constructionDate .
                    FILTER (datatype(?constructionDate) = xsd:date)
                    FILTER (
                        YEAR(?constructionDate) < 2003 ||
                        (
                            YEAR(?constructionDate) = 2003 &&
                            (
                                MONTH(?constructionDate) < 9 ||
                                (
                                    MONTH(?constructionDate) = 9 &&
                                    DAY(?constructionDate) < 1
                                )
                            )
                        )
                    )
                }
                $this nltl:assessmentDate ?assessmentDate .
                $this nltl:deliveryDate ?deliveryDate .
                FILTER (datatype(?assessmentDate) = xsd:date)
                FILTER (datatype(?deliveryDate) = xsd:date)
                FILTER (
                    YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20 ||
                    (
                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                        (
                            MONTH(?assessmentDate) > 1 ||
                            (
                                MONTH(?assessmentDate) = 1 &&
                                DAY(?assessmentDate) >= 1
                            )
                        )
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:engineOutputComplianceMethod ?method .
                    FILTER (
                        ?method = nltl:traficom2017Section3Point2Point2Method ||
                        ?method = nltl:traficom2017Section3Point2Point4Method
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-009> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F02/ship> ] .

