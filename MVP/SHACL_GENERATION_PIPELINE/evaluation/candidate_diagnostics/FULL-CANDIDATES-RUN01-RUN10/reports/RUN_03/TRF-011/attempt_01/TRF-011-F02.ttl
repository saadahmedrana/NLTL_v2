@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F02/ship> ;
            sh:resultMessage "The upper ice waterline must equal the maximum vertical coordinate of intended ice-operating waterline points at every longitudinal position, with matching positions in both profiles." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The upper ice waterline must equal the maximum vertical coordinate of intended ice-operating waterline points at every longitudinal position, with matching positions in both profiles." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                {
                    SELECT ?this ?x ?uv
                    WHERE {
                        ?this nltl:hasIntendedIceOperatingWaterline ?intended .
                        ?intended nltl:hasWaterlineProfilePoint ?ip .
                        ?ip nltl:longitudinalPosition ?ix ;
                            nltl:verticalCoordinate ?ivNode .
                        ?ix qudt:numericValue ?x .
                        ?ivNode qudt:numericValue ?iv .

                        OPTIONAL {
                            ?this nltl:hasUpperIceWaterline ?upper .
                            ?upper nltl:hasWaterlineProfilePoint ?up .
                            ?up nltl:longitudinalPosition ?ux ;
                                nltl:verticalCoordinate ?uvNode .
                            ?ux qudt:numericValue ?x .
                            ?uvNode qudt:numericValue ?uv .
                        }
                    }
                    GROUP BY ?this ?x ?uv
                    HAVING (!BOUND(?uv) || MAX(?iv) != ?uv)
                }
                UNION
                {
                    SELECT ?this ?x ?uv
                    WHERE {
                        ?this nltl:hasUpperIceWaterline ?upper .
                        ?upper nltl:hasWaterlineProfilePoint ?up .
                        ?up nltl:longitudinalPosition ?ux ;
                            nltl:verticalCoordinate ?uvNode .
                        ?ux qudt:numericValue ?x .
                        ?uvNode qudt:numericValue ?uv .

                        OPTIONAL {
                            ?this nltl:hasIntendedIceOperatingWaterline ?intended .
                            ?intended nltl:hasWaterlineProfilePoint ?ip .
                            ?ip nltl:longitudinalPosition ?ix ;
                                nltl:verticalCoordinate ?ivNode .
                            ?ix qudt:numericValue ?x .
                            ?ivNode qudt:numericValue ?iv .
                        }
                    }
                    GROUP BY ?this ?x ?uv
                    HAVING (!BOUND(?iv) || MAX(?iv) != ?uv)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape g:TRF011ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F02/ship> ] .

