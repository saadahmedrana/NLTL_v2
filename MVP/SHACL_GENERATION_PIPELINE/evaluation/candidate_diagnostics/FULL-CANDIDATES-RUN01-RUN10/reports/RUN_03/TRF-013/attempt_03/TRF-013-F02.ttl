@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:iceClassValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipIceStrengthened ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF013IceWaterlineShape ; sh:path nltl:hasLowerIceWaterline ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF013IceWaterlineShape ; sh:path nltl:hasUpperIceWaterline ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF013QuantityShape ; sh:path nltl:maximumIceClassDraughtAft ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF013QuantityShape ; sh:path nltl:maximumIceClassDraughtFore ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF013QuantityShape ; sh:path nltl:minimumIceClassDraughtAft ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF013QuantityShape ; sh:path nltl:minimumIceClassDraughtFore ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF013QuantityShape ; sh:path nltl:operatingAftDraught ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF013QuantityShape ; sh:path nltl:operatingForeDraught ] ; sh:sparql [ sh:message Literal("The operating fore and aft draughts must be within their inclusive ice-class draught bounds, and the upper and lower ice waterlines must be distinct.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:hasLowerIceWaterline ?lowerWaterline ;
                              nltl:hasUpperIceWaterline ?upperWaterline ;
                              nltl:operatingForeDraught ?operatingFore ;
                              nltl:operatingAftDraught ?operatingAft ;
                              nltl:minimumIceClassDraughtFore ?minimumFore ;
                              nltl:maximumIceClassDraughtFore ?maximumFore ;
                              nltl:minimumIceClassDraughtAft ?minimumAft ;
                              nltl:maximumIceClassDraughtAft ?maximumAft .

                        ?operatingFore qudt:numericValue ?operatingForeValue .
                        ?operatingAft qudt:numericValue ?operatingAftValue .
                        ?minimumFore qudt:numericValue ?minimumForeValue .
                        ?maximumFore qudt:numericValue ?maximumForeValue .
                        ?minimumAft qudt:numericValue ?minimumAftValue .
                        ?maximumAft qudt:numericValue ?maximumAftValue .

                        FILTER (
                            ?operatingForeValue < ?minimumForeValue ||
                            ?operatingForeValue > ?maximumForeValue ||
                            ?operatingAftValue < ?minimumAftValue ||
                            ?operatingAftValue > ?maximumAftValue ||
                            ?lowerWaterline = ?upperWaterline
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF013Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-F02/ship> ] .

