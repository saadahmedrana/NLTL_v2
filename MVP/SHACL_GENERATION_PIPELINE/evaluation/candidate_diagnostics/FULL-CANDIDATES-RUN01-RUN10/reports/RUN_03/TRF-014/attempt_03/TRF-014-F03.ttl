@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:readilyAvailableToMaster" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n8606b72268844d5d984897cabc288e5cb42 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:retainedOnBoard" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n8606b72268844d5d984897cabc288e5cb41 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "Node ex:ship->nltl:retainedOnBoard does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n8606b72268844d5d984897cabc288e5cb41 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "The conditional ice-class marking, docking-date, and maximum-permissible-draught requirements are not satisfied." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The conditional ice-class marking, docking-date, and maximum-permissible-draught requirements are not satisfied." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate ;
                      nltl:assessmentDate ?assessmentDate ;
                      nltl:summerLoadLineFreshWaterDraught/qudt:numericValue ?summerValue ;
                      nltl:upperIceWaterlineDraught/qudt:numericValue ?uiwlValue .

                FILTER (
                    (
                        ?constructionDate >= "2007-07-01"^^xsd:date
                        && ?summerValue > ?uiwlValue
                        && NOT EXISTS {
                            $this nltl:warningTrianglePresent true ;
                                  nltl:iceClassDraughtMarkPresent true ;
                                  nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity .
                            ?markQuantity qudt:numericValue ?markValue ;
                                          qudt:unit unit:M .
                            $this nltl:hasClassCertificate ?certificate .
                            ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
                            ?maximumQuantity qudt:numericValue ?maximumValue ;
                                             qudt:unit unit:M .
                            FILTER (?markValue = ?maximumValue)
                        }
                    )
                    ||
                    (
                        ?constructionDate < "2007-07-01"^^xsd:date
                        && NOT EXISTS {
                            $this nltl:warningTrianglePresent true ;
                                  nltl:iceClassDraughtMarkPresent true ;
                                  nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity .
                            ?markQuantity qudt:numericValue ?markValue ;
                                          qudt:unit unit:M .
                            $this nltl:hasClassCertificate ?certificate .
                            ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
                            ?maximumQuantity qudt:numericValue ?maximumValue ;
                                             qudt:unit unit:M .
                            FILTER (?markValue = ?maximumValue)
                        }
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:firstScheduledDryDockingDate ?dockDate .
                            }
                            ||
                            (
                                EXISTS {
                                    $this nltl:firstScheduledDryDockingDate ?dockDate .
                                }
                                && ?dockDate <= ?assessmentDate
                                && ?summerValue > ?uiwlValue
                                && NOT EXISTS {
                                    $this nltl:warningTrianglePresent true ;
                                          nltl:iceClassDraughtMarkPresent true ;
                                          nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity2 .
                                    ?markQuantity2 qudt:numericValue ?markValue2 ;
                                                   qudt:unit unit:M .
                                    $this nltl:hasClassCertificate ?certificate2 .
                                    ?certificate2 nltl:maximumIceClassDraughtAmidships ?maximumQuantity2 .
                                    ?maximumQuantity2 qudt:numericValue ?maximumValue2 ;
                                                      qudt:unit unit:M .
                                    FILTER (?markValue2 = ?maximumValue2)
                                }
                            )
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-014-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "Node ex:ship->nltl:readilyAvailableToMaster does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n8606b72268844d5d984897cabc288e5cb42 ] .

_:n8606b72268844d5d984897cabc288e5cb41 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

_:n8606b72268844d5d984897cabc288e5cb42 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

