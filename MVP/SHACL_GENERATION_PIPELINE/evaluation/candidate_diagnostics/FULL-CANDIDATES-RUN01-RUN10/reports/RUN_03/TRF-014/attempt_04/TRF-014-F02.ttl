@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "The ice-draught restriction document must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n32e940a2893740a495ce06ad6180d59eb40 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/certificate> ;
                    sh:resultMessage "Less than 1 values on ex:certificate->nltl:minimumIceClassDraughtAft" ;
                    sh:resultPath nltl:minimumIceClassDraughtAft ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue unit:M ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:minimumIceClassDraughtAft ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "The ship must have one class certificate containing all maximum and minimum ice-class draughts in metres." ;
            sh:resultPath nltl:hasClassCertificate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must have one class certificate containing all maximum and minimum ice-class draughts in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:classCertificate ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:maximumIceClassDraughtAft ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:minimumIceClassDraughtAft ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:maximumIceClassDraughtAmidships ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:maximumIceClassDraughtFore ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:minimumIceClassDraughtAmidships ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:minimumIceClassDraughtFore ] ] ;
                    sh:path nltl:hasClassCertificate ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/certificate> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "When the summer load line is above the UIWL, the required warning triangle and ice-class draught marking must be present when applicable, with the mark at the certificate maximum amidships draught." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the summer load line is above the UIWL, the required warning triangle and ice-class draught marking must be present when applicable, with the mark at the certificate maximum amidships draught." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:summerLoadLineFreshWaterDraught ?summerQ .
  ?summerQ qudt:numericValue ?summerValue .
  $this nltl:upperIceWaterlineDraught ?uiwlQ .
  ?uiwlQ qudt:numericValue ?uiwlValue .
  $this nltl:constructionDate ?constructionDate .
  $this nltl:assessmentDate ?assessmentDate .
  FILTER (?summerValue > ?uiwlValue)
  FILTER NOT EXISTS {
    {
      FILTER (?constructionDate >= "2007-07-01"^^xsd:date)
      FILTER EXISTS {
        $this nltl:warningTrianglePresent true .
        $this nltl:iceClassDraughtMarkPresent true .
        $this nltl:iceClassDraughtMarkDraughtAmidships ?markQ .
        ?markQ qudt:numericValue ?markValue .
        $this nltl:hasClassCertificate ?certificate .
        ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQ .
        ?maximumQ qudt:numericValue ?maximumValue .
        FILTER (?markValue = ?maximumValue)
      }
    }
    UNION
    {
      FILTER (?constructionDate < "2007-07-01"^^xsd:date)
      FILTER (
        EXISTS {
          $this nltl:warningTrianglePresent true .
          $this nltl:iceClassDraughtMarkPresent true .
          $this nltl:iceClassDraughtMarkDraughtAmidships ?markQ2 .
          ?markQ2 qudt:numericValue ?markValue2 .
          $this nltl:hasClassCertificate ?certificate2 .
          ?certificate2 nltl:maximumIceClassDraughtAmidships ?maximumQ2 .
          ?maximumQ2 qudt:numericValue ?maximumValue2 .
          FILTER (?markValue2 = ?maximumValue2)
        }
        ||
        EXISTS {
          $this nltl:firstScheduledDryDockingDate ?dockDate .
          FILTER (?dockDate > ?assessmentDate)
        }
        ||
        EXISTS {
          $this nltl:firstScheduledDryDockingDate ?dockDate2 .
          FILTER (?dockDate2 <= ?assessmentDate)
          FILTER EXISTS {
            $this nltl:warningTrianglePresent true .
            $this nltl:iceClassDraughtMarkPresent true .
            $this nltl:iceClassDraughtMarkDraughtAmidships ?markQ3 .
            ?markQ3 qudt:numericValue ?markValue3 .
            $this nltl:hasClassCertificate ?certificate3 .
            ?certificate3 nltl:maximumIceClassDraughtAmidships ?maximumQ3 .
            ?maximumQ3 qudt:numericValue ?maximumValue3 .
            FILTER (?markValue3 = ?maximumValue3)
          }
        }
      )
    }
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF014ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "The ice-draught restriction document must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n32e940a2893740a495ce06ad6180d59eb39 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "The ice-draught restriction document must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n32e940a2893740a495ce06ad6180d59eb40 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "The ice-draught restriction document must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n32e940a2893740a495ce06ad6180d59eb39 ] .

_:n32e940a2893740a495ce06ad6180d59eb39 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice-draught restriction document must be readily available to the master." ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

_:n32e940a2893740a495ce06ad6180d59eb40 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice-draught restriction document must be retained on board." ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

