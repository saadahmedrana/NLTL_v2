@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-P01/upper> ;
            sh:resultMessage "Less than 1 values on ex:upper->nltl:waterlineDisplacement" ;
            sh:resultPath nltl:waterlineDisplacement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/TON_Metric> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:waterlineDisplacement ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-P01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:ballastTank ; sh:node [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:freezingPreventionPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:situatedAboveLowerIceWaterline ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:usedToReachLowerIceWaterline ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:usedToReachLowerIceWaterline ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:situatedAboveLowerIceWaterline ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:situatedAboveLowerIceWaterline ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:usedToReachLowerIceWaterline ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:situatedAboveLowerIceWaterline ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:usedToReachLowerIceWaterline ] ] ) ] ; sh:path nltl:hasBallastTank ], [ sh:class nltl:iceWaterline ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasLowerIceWaterline ], [ sh:class nltl:iceWaterline ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasUpperIceWaterline ], [ sh:datatype qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:draughtAmidships ], [ sh:datatype qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:forwardDraught ], [ sh:datatype qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:levelIceThickness ], [ sh:datatype qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:liwlDraughtAmidships ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerHighestPointSubmerged ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:navigatingInIce ] ; sh:sparql [ sh:message Literal("A ballast tank situated above the LIWL and needed to reach the LIWL must have freezing prevention.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasBallastTank ?tank .
                        ?tank nltl:situatedAboveLowerIceWaterline true ;
                              nltl:usedToReachLowerIceWaterline true .
                        FILTER NOT EXISTS {
                            ?tank nltl:freezingPreventionPresent true .
                        }
                    }
                ") ], [ sh:message Literal("Draught amidships must be at least the LIWL draught amidships.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:draughtAmidships ?draughtNode ;
                              nltl:liwlDraughtAmidships ?liwlNode .
                        ?draughtNode qudt:numericValue ?draught .
                        ?liwlNode qudt:numericValue ?liwl .
                        FILTER (?draught < ?liwl)
                    }
                ") ], [ sh:message Literal("Forward draught must satisfy the UIWL displacement and level ice thickness formula.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasUpperIceWaterline ?selectedWaterline ;
                              nltl:levelIceThickness ?iceNode ;
                              nltl:forwardDraught ?forwardNode .
                        ?selectedWaterline nltl:waterlineDisplacement ?selectedDisplacementNode .
                        ?selectedDisplacementNode qudt:numericValue ?delta .
                        ?iceNode qudt:numericValue ?hi .
                        ?forwardNode qudt:numericValue ?forward .
                        FILTER NOT EXISTS {
                            $this nltl:hasUpperIceWaterline ?otherWaterline .
                            ?otherWaterline nltl:waterlineDisplacement ?otherDisplacementNode .
                            ?otherDisplacementNode qudt:numericValue ?otherDelta .
                            FILTER (?otherDelta > ?delta)
                        }
                        BIND ((2 + (0.00025 * ?delta)) * ?hi AS ?formulaMinimum)
                        BIND (4 * ?hi AS ?formulaMaximum)
                        BIND (IF(?formulaMinimum < ?formulaMaximum, ?formulaMinimum, ?formulaMaximum) AS ?requiredForward)
                        FILTER (?forward < ?requiredForward)
                    }
                ") ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:navigatingInIce ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-016> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-P01/ship> ] .

