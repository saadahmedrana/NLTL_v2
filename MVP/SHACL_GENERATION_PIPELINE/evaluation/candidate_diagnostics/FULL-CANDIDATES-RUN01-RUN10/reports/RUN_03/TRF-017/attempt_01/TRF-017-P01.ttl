@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P01/ship> ;
            sh:resultMessage "Maximum continuous rating power must equal the continuous propulsion machinery output, or the restricted propulsion output when a restriction applies." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Maximum continuous rating power must equal the continuous propulsion machinery output, or the restricted propulsion output when a restriction applies." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:propulsionOutputRestrictionApplies ?flag ;
          nltl:maximumContinuousRatingPower ?power ;
          nltl:propulsionMachineryContinuousOutput ?continuous .
    ?power qudt:numericValue ?powerValue .
    ?continuous qudt:numericValue ?continuousValue .
    OPTIONAL {
        $this nltl:restrictedPropulsionOutput ?restricted .
        ?restricted qudt:numericValue ?restrictedValue .
    }
    FILTER (
        (?flag = true && BOUND(?restrictedValue) && ?powerValue = ?restrictedValue)
        ||
        (?flag = false && ?powerValue = ?continuousValue)
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF017ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P01/ship> ] .

