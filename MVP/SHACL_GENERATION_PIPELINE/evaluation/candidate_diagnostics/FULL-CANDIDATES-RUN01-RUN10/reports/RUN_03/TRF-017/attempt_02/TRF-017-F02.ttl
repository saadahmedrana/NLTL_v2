@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F02/ship> ;
            sh:resultMessage "The maximum continuous rating power must equal the restricted propulsion output when restriction applies, or the propulsion machinery continuous output otherwise." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The maximum continuous rating power must equal the restricted propulsion output when restriction applies, or the propulsion machinery continuous output otherwise." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:propulsionOutputRestrictionApplies ?flag .
    FILTER (
        (
            ?flag = true &&
            (
                NOT EXISTS {
                    $this nltl:restrictedPropulsionOutput ?restricted
                }
                ||
                NOT EXISTS {
                    $this nltl:maximumContinuousRatingPower ?maximum
                }
                ||
                NOT EXISTS {
                    $this nltl:restrictedPropulsionOutput ?restricted .
                    ?restricted qudt:numericValue ?restrictedValue ;
                                qudt:unit unit:KiloW .
                    $this nltl:maximumContinuousRatingPower ?maximum .
                    ?maximum qudt:numericValue ?maximumValue ;
                             qudt:unit unit:KiloW .
                    FILTER (?restrictedValue = ?maximumValue)
                }
            )
        )
        ||
        (
            ?flag = false &&
            (
                NOT EXISTS {
                    $this nltl:maximumContinuousRatingPower ?maximum
                }
                ||
                NOT EXISTS {
                    $this nltl:propulsionMachineryContinuousOutput ?machinery
                }
                ||
                NOT EXISTS {
                    $this nltl:maximumContinuousRatingPower ?maximum .
                    ?maximum qudt:numericValue ?maximumValue ;
                             qudt:unit unit:KiloW .
                    $this nltl:propulsionMachineryContinuousOutput ?machinery .
                    ?machinery qudt:numericValue ?machineryValue ;
                              qudt:unit unit:KiloW .
                    FILTER (?maximumValue = ?machineryValue)
                }
            )
        )
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF017Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F02/ship> ] .

