@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/ship> ;
            sh:resultMessage "For a ship identified as ice class IB or IC under the 1985 ice-class rules, maximum continuous rating power must be present in kW and be at least the required power under the 1985 rules." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a ship identified as ice class IB or IC under the 1985 ice-class rules, maximum continuous rating power must be present in kW and be at least the required power under the 1985 rules." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
                       nltl:iceClass ?iceClass .

                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )

                FILTER NOT EXISTS {
                    $this nltl:maximumContinuousRatingPower ?mcrQuantity ;
                           nltl:requiredPowerUnder1985Rules ?requiredQuantity .

                    ?mcrQuantity qudt:numericValue ?mcrValue ;
                                 qudt:unit <http://qudt.org/vocab/unit/KiloW> .

                    ?requiredQuantity qudt:numericValue ?requiredValue ;
                                      qudt:unit <http://qudt.org/vocab/unit/KiloW> .

                    FILTER (
                        datatype(?mcrValue) = xsd:decimal &&
                        datatype(?requiredValue) = xsd:decimal &&
                        ?mcrValue >= ?requiredValue
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-023> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/ship> ] .

