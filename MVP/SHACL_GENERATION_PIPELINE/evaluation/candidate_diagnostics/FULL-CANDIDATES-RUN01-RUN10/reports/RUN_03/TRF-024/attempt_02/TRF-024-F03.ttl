@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:iceClassValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The ship must have one ice class.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ] ; sh:sparql [ sh:message Literal("The applicable IA or IA Super branch must be used for this requirement.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER (?iceClass IN (
                            nltl:iceClassIa ,
                            nltl:iceClassIaSuper
                        ))
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A construction stage date is required to determine applicability.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:in ( nltl:iceClassIa nltl:iceClassIaSuper ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ] ; sh:sparql [ sh:message Literal("This non-applicable branch requires IA or IA Super construction on or after 1 September 2003.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionStageDate ?constructionDate .
                        FILTER (
                            YEAR(?constructionDate) < 2003 ||
                            (
                                YEAR(?constructionDate) = 2003 &&
                                MONTH(?constructionDate) < 9
                            ) ||
                            (
                                YEAR(?constructionDate) = 2003 &&
                                MONTH(?constructionDate) = 9 &&
                                DAY(?constructionDate) < 1
                            )
                        )
                    }
                ") ] ] , [ sh:property [ sh:class nltl:engineOutputComplianceMethodValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The applicable ship must identify its engine output compliance method.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:engineOutputComplianceMethod ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A delivery date is required for an applicable IA or IA Super ship.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:deliveryDate ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An assessment date is required for deadline evaluation.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:assessmentDate ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:in ( nltl:iceClassIa nltl:iceClassIaSuper ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ] ; sh:sparql [ sh:message Literal("For an IA or IA Super ship constructed before 1 September 2003, section 3.2.2 compliance must be completed by 1 January in the year twenty years after delivery.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionStageDate ?constructionDate ;
                              nltl:deliveryDate ?deliveryDate ;
                              nltl:assessmentDate ?assessmentDate .
                        FILTER (
                            YEAR(?constructionDate) < 2003 ||
                            (
                                YEAR(?constructionDate) = 2003 &&
                                MONTH(?constructionDate) < 9
                            ) ||
                            (
                                YEAR(?constructionDate) = 2003 &&
                                MONTH(?constructionDate) = 9 &&
                                DAY(?constructionDate) < 1
                            )
                        )
                        FILTER (
                            YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20 ||
                            (
                                YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                                MONTH(?assessmentDate) > 1
                            ) ||
                            (
                                YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                                MONTH(?assessmentDate) = 1 &&
                                DAY(?assessmentDate) > 1
                            )
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF024Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-F03/ship> ] .

