@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-026-F03/ship> ;
            sh:resultMessage "For IA Super ships, bulb applicability must be established; a bulb activates the required external calculation inputs and C1/C2 results." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF026Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-026-F03/ship> ] .

