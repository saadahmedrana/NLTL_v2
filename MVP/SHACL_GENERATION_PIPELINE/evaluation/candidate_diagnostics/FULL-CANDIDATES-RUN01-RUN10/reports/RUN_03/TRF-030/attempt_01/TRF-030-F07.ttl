@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F07/ship> ;
            sh:resultMessage "The ship must provide the externally determined ice pressure in MPa." ;
            sh:resultPath nltl:icePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the externally determined ice pressure in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-PressureQuantityShape> ;
                    sh:path nltl:icePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F07/ship> ;
            sh:resultMessage "The ship must provide the load patch height in metres." ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the load patch height in metres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-LengthQuantityShape> ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F07/ship> ;
            sh:resultMessage "The ship must provide multiple direct analysis cases covering the required load positions." ;
            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide multiple direct analysis cases covering the required load positions." ;
                    sh:minCount 2 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-DirectAnalysisCaseShape> ;
                    sh:path nltl:hasDirectAnalysisCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F07/ship> ;
            sh:resultMessage "The ship must state whether load length was determined from the structural arrangement." ;
            sh:resultPath nltl:loadLengthDeterminedFromArrangement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ship must state whether load length was determined from the structural arrangement." ;
                    sh:minCount 1 ;
                    sh:path nltl:loadLengthDeterminedFromArrangement ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F07/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:loadLengthDeterminedFromArrangement ], [ sh:minCount Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:hasDirectAnalysisCase ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:loadLengthDeterminedFromArrangement ], [ sh:minCount Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:hasDirectAnalysisCase ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-030-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F07/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F07/ship> ;
            sh:resultMessage "The externally computed applied ice pressure must be provided in MPa." ;
            sh:resultPath nltl:appliedIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The externally computed applied ice pressure must be provided in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-PressureQuantityShape> ;
                    sh:path nltl:appliedIcePressure ] ] .

