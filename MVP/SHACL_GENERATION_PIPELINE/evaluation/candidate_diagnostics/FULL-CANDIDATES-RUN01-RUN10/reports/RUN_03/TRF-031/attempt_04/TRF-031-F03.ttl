@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ;
            sh:resultMessage "Yield shear stress must equal yield point divided by sqrt(3) within a 1e-6 relative tolerance, with a 1e-6 MPa absolute fallback near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Yield shear stress must equal yield point divided by sqrt(3) within a 1e-6 relative tolerance, with a 1e-6 MPa absolute fallback near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldNode ;
                      nltl:yieldShearStress ?resultNode .
                ?yieldNode qudt:numericValue ?yieldValue .
                ?resultNode qudt:numericValue ?resultValue .
                FILTER (datatype(?yieldValue) = xsd:decimal)
                FILTER (datatype(?resultValue) = xsd:decimal)
                BIND ((?yieldValue / 1.7320508075688772) AS ?expected)
                BIND (IF(?expected >= 0, ?expected, -?expected) AS ?expectedAbs)
                BIND (IF(?expectedAbs > 0.000001, (?expectedAbs * 0.000001), 0.000001) AS ?tolerance)
                BIND ((?resultValue - ?expected) AS ?difference)
                BIND (IF(?difference >= 0, ?difference, -?difference) AS ?differenceAbs)
                FILTER (?differenceAbs > ?tolerance)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF031Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ] .

