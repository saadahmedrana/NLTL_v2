@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-P02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceStrengtheningStatus ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceStrengtheningStatus ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:classificationSocietyRequiredScantling ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:regulationRequiredScantling ] ; sh:sparql [ sh:message Literal("The selected design scantling must equal the classification society required scantling when the regulation scantling is lower.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
SELECT $this
WHERE {
    $this nltl:iceStrengtheningStatus false .
    $this nltl:regulationRequiredScantling ?regulationQuantity .
    ?regulationQuantity qudt:numericValue ?regulationValue .
    $this nltl:classificationSocietyRequiredScantling ?classificationQuantity .
    ?classificationQuantity qudt:numericValue ?classificationValue .
    $this nltl:selectedDesignScantling ?selectedQuantity .
    ?selectedQuantity a qudt:QuantityValue .
    ?selectedQuantity qudt:numericValue ?selectedValue .
    FILTER (?regulationValue < ?classificationValue)
    FILTER (?selectedValue != ?classificationValue)
}
") ], [ sh:message Literal("When the regulation scantling is less than the classification society scantling, a valid selected design scantling equal to the classification society scantling is required.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceStrengtheningStatus false .
    $this nltl:regulationRequiredScantling ?regulationQuantity .
    ?regulationQuantity qudt:numericValue ?regulationValue .
    $this nltl:classificationSocietyRequiredScantling ?classificationQuantity .
    ?classificationQuantity qudt:numericValue ?classificationValue .
    FILTER (?regulationValue < ?classificationValue)
    FILTER NOT EXISTS {
        $this nltl:selectedDesignScantling ?selectedQuantity .
        ?selectedQuantity a qudt:QuantityValue .
        ?selectedQuantity qudt:numericValue ?selectedValue .
        FILTER (datatype(?selectedValue) = xsd:decimal)
    }
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF-032-ScantlingSelectionShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-P02/ship> ] .

