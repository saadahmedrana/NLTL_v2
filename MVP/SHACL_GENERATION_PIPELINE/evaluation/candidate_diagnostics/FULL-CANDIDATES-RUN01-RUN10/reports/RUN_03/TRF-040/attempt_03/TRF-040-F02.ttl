@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F02/ship> ;
            sh:resultMessage "For ice class IA Super, forefoot strengthening shall equal bow-region strengthening and the five-main-frame-spacing input shall be supplied." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ice class IA Super, forefoot strengthening shall equal bow-region strengthening and the five-main-frame-spacing input shall be supplied." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper .
                FILTER (
                    NOT EXISTS {
                        $this nltl:forefootShellStrengtheningStatus ?forefoot .
                        $this nltl:bowRegionEquivalent ?bow .
                        FILTER ( ?forefoot = ?bow )
                    }
                    ||
                    EXISTS {
                        $this nltl:forefootShellStrengtheningStatus ?forefoot .
                        $this nltl:bowRegionEquivalent ?bow .
                        FILTER ( ?forefoot != ?bow )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasComponent ?component .
                        ?component nltl:frameSpacing ?spacingValue .
                        ?spacingValue qudt:numericValue ?spacingNumber .
                        ?spacingValue qudt:unit unit:M .
                        FILTER ( datatype(?spacingNumber) = xsd:decimal )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-040> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:spacing" ;
            sh:resultPath nltl:spacing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:spacing ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:designOperationSpeedInIce" ;
            sh:resultPath nltl:designOperationSpeedInIce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:KN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:designOperationSpeedInIce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:thickness" ;
            sh:resultPath nltl:thickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:thickness ] ] .

