@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "Node ex:plating must conform to one or more shapes in nltlgen:NormalCorrosionBranch , nltlgen:ApprovedCoatedLowerCorrosionBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:TRF042PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "The longitudinal plating factor must be calculated from 0 < designIceLoadHeight/spacing <= 1.8 and must match the applicable piecewise formula within max(1e-6*ABS(expected),1e-12)." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The longitudinal plating factor must be calculated from 0 < designIceLoadHeight/spacing <= 1.8 and must match the applicable piecewise formula within max(1e-6*ABS(expected),1e-12)." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    $this nltl:spacing ?sNode .
                    ?sNode qudt:numericValue ?s .
                    FILTER (datatype(?s) = xsd:decimal)
                    FILTER (?s = 0)
                }
                UNION
                {
                    $this nltl:designIceLoadHeight ?hNode ;
                          nltl:spacing ?sNode .
                    ?hNode qudt:numericValue ?h .
                    ?sNode qudt:numericValue ?s .
                    FILTER (datatype(?h) = xsd:decimal)
                    FILTER (datatype(?s) = xsd:decimal)
                    FILTER (?s != 0)
                    BIND (?h / ?s AS ?ratio)
                    FILTER (?ratio <= 0 || ?ratio > 1.8)
                }
                UNION
                {
                    $this nltl:designIceLoadHeight ?hNode ;
                          nltl:spacing ?sNode ;
                          nltl:longitudinalPlatingFactorF2 ?f2Node .
                    ?hNode qudt:numericValue ?h .
                    ?sNode qudt:numericValue ?s .
                    ?f2Node qudt:numericValue ?actual .
                    FILTER (datatype(?h) = xsd:decimal)
                    FILTER (datatype(?s) = xsd:decimal)
                    FILTER (datatype(?actual) = xsd:decimal)
                    FILTER (?s != 0)
                    BIND (?h / ?s AS ?ratio)
                    FILTER (?ratio > 0 && ?ratio <= 1.8)
                    BIND (
                        IF(
                            ?ratio <= 1,
                            0.4 / ?ratio + 0.6,
                            1.4 - 0.4 * ?ratio
                        ) AS ?expected
                    )
                    BIND (
                        IF(
                            1e-6 * ABS(?expected) > 1e-12,
                            1e-6 * ABS(?expected),
                            1e-12
                        ) AS ?tolerance
                    )
                    FILTER (ABS(?actual - ?expected) > ?tolerance)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlgen:TRF042PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ] .

