@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P03/extensionBeyondAdjacentDeckOrTankBoundaryValue> ;
                            sh:resultMessage "Node ex:extensionBeyondAdjacentDeckOrTankBoundaryValue->qudt:unit does not contain a value in the set: ['qudt:MilliM']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:MilliM ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P03/terminationCase> ;
                    sh:resultMessage "The termination case must provide one extension beyond the adjacent boundary in millimetres." ;
                    sh:resultPath nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The termination case must provide one extension beyond the adjacent boundary in millimetres." ;
                            sh:minCount 1 ;
                            sh:node gen:TRF043MillimetreQuantityShape ;
                            sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P03/extensionBeyondAdjacentDeckOrTankBoundaryValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P03/ship> ;
            sh:resultMessage "Each framing ice-strengthening termination case must conform to the termination requirements." ;
            sh:resultPath nltl:hasFramingIceStrengtheningTerminationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:framingIceStrengtheningTerminationCase ;
                    sh:message "Each framing ice-strengthening termination case must conform to the termination requirements." ;
                    sh:node gen:TRF043TerminationCaseShape ;
                    sh:path nltl:hasFramingIceStrengtheningTerminationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P03/terminationCase> ] .

