@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F04/terminationCase> ;
                    sh:resultMessage "The termination extension must be a single quantity in millimetres." ;
                    sh:resultPath nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class qudt:QuantityValue ;
                            sh:maxCount 1 ;
                            sh:message "The termination extension must be a single quantity in millimetres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue unit:MilliM ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F04/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:property [ sh:class qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The termination extension must be a single quantity in millimetres.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MilliM ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ], [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A termination case must identify one adjacent deck, tank boundary plating, or tank top.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] ) ; sh:path nltl:terminationAdjacentBoundary ] ; sh:sparql [ sh:message Literal("If the strengthening extends no more than 250 mm beyond the adjacent boundary, termination there must be permitted.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?quantity .
                        ?quantity qudt:numericValue ?extension ;
                                  qudt:unit unit:MilliM .
                        FILTER (datatype(?extension) = xsd:decimal)
                        FILTER (?extension <= 250)
                        FILTER NOT EXISTS {
                            $this nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted true .
                        }
                    }
                ") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasFramingIceStrengtheningTerminationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:framingIceStrengtheningTerminationCase ;
                    sh:node [ sh:property [ sh:class qudt:QuantityValue ;
                                    sh:maxCount 1 ;
                                    sh:message "The termination extension must be a single quantity in millimetres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue unit:MilliM ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ],
                                [ sh:datatype xsd:boolean ;
                                    sh:maxCount 1 ;
                                    sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ],
                                [ sh:maxCount 1 ;
                                    sh:message "A termination case must identify one adjacent deck, tank boundary plating, or tank top." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] ) ;
                                    sh:path nltl:terminationAdjacentBoundary ] ;
                            sh:sparql [ sh:message "If the strengthening extends no more than 250 mm beyond the adjacent boundary, termination there must be permitted." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?quantity .
                        ?quantity qudt:numericValue ?extension ;
                                  qudt:unit unit:MilliM .
                        FILTER (datatype(?extension) = xsd:decimal)
                        FILTER (?extension <= 250)
                        FILTER NOT EXISTS {
                            $this nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted true .
                        }
                    }
                """ ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasFramingIceStrengtheningTerminationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F04/terminationCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F04/terminationCase> ;
            sh:resultMessage "The termination extension must be a single quantity in millimetres." ;
            sh:resultPath nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "The termination extension must be a single quantity in millimetres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:MilliM ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ] .

