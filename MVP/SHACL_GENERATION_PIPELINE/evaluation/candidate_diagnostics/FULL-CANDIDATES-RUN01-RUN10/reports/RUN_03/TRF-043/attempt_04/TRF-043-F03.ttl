@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/terminationCase> ;
                    sh:resultMessage "Node ex:boundary must conform to one or more shapes in [ sh:class nltl:deckStructure ] , [ sh:class nltl:tankBoundaryPlating ] , [ sh:class nltl:tankTop ]" ;
                    sh:resultPath nltl:terminationAdjacentBoundary ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] ) ;
                            sh:path nltl:terminationAdjacentBoundary ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/boundary> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/ship> ;
            sh:resultMessage """Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] ) ; sh:path nltl:terminationAdjacentBoundary ] ; sh:sparql [ sh:message Literal("When extension beyond the adjacent boundary is at most 250 mm, termination at that boundary must be permitted.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?quantity .
                        ?quantity qudt:numericValue ?value .
                        FILTER (xsd:decimal(?value) <= 250)
                        FILTER NOT EXISTS {
                            $this nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted true .
                        }
                    }
                ") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasFramingIceStrengtheningTerminationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:framingIceStrengtheningTerminationCase ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] ) ;
                                    sh:path nltl:terminationAdjacentBoundary ],
                                [ sh:datatype xsd:boolean ;
                                    sh:maxCount 1 ;
                                    sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ;
                            sh:sparql [ sh:message "When extension beyond the adjacent boundary is at most 250 mm, termination at that boundary must be permitted." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?quantity .
                        ?quantity qudt:numericValue ?value .
                        FILTER (xsd:decimal(?value) <= 250)
                        FILTER NOT EXISTS {
                            $this nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted true .
                        }
                    }
                """ ] ] ;
                    sh:path nltl:hasFramingIceStrengtheningTerminationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/terminationCase> ] .

