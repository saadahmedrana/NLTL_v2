@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F02/transverseFrame> ;
            sh:resultMessage "Frame moment factor, section modulus, and required shear area must satisfy the declared calculations within a relative tolerance of 1e-6 plus an absolute fallback of 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Frame moment factor, section modulus, and required shear area must satisfy the declared calculations within a relative tolerance of 1e-6 plus an absolute fallback of 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:spacing ?sNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode <http://qudt.org/schema/qudt/numericValue> ?p .
                ?sNode <http://qudt.org/schema/qudt/numericValue> ?s .
                ?hNode <http://qudt.org/schema/qudt/numericValue> ?h .
                ?lNode <http://qudt.org/schema/qudt/numericValue> ?l .
                ?m0Node <http://qudt.org/schema/qudt/numericValue> ?m0 .
                ?sigmaNode <http://qudt.org/schema/qudt/numericValue> ?sigma .
                ?mtNode <http://qudt.org/schema/qudt/numericValue> ?mt .
                ?zNode <http://qudt.org/schema/qudt/numericValue> ?z .
                ?aNode <http://qudt.org/schema/qudt/numericValue> ?a .

                BIND ((7 * ?m0) / (7 - 5 * ?h / ?l) AS ?mtExpected)
                BIND ((?p * ?s * ?h * ?l / (?mtExpected * ?sigma)) * 1000000 AS ?zExpected)
                BIND ((1.7320508075688772 * 1.2 * ?p * ?h * ?s / (2 * ?sigma)) * 10000 AS ?aExpected)

                FILTER (
                    ABS(?mt - ?mtExpected) >
                        (0.000001 * ABS(?mtExpected) + 0.000001)
                    ||
                    ABS(?z - ?zExpected) >
                        (0.000001 * ABS(?zExpected) + 0.000001)
                    ||
                    ABS(?a - ?aExpected) >
                        (0.000001 * ABS(?aExpected) + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_044_TransverseFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F02/transverseFrame> ] .

