@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F03/frame> ;
            sh:resultMessage "Ordinary frame scantlings may be used only when the frame span within the ice-strengthening zone is less than 15% of the frame span, with both quantities stated in metres." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Ordinary frame scantlings may be used only when the frame span within the ice-strengthening zone is less than 15% of the frame span, with both quantities stated in metres." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:ordinaryFrameScantlingsUsed ?used .
                FILTER (?used = true)
                FILTER NOT EXISTS {
                    $this nltl:frameSpanWithinIceStrengtheningZone ?withinQuantity .
                    $this nltl:span ?spanQuantity .
                    ?withinQuantity a qudt:QuantityValue ;
                        qudt:numericValue ?withinValue ;
                        qudt:unit <http://qudt.org/vocab/unit/M> .
                    ?spanQuantity a qudt:QuantityValue ;
                        qudt:numericValue ?spanValue ;
                        qudt:unit <http://qudt.org/vocab/unit/M> .
                    FILTER (datatype(?withinValue) = xsd:decimal)
                    FILTER (datatype(?spanValue) = xsd:decimal)
                    FILTER (?spanValue > 0)
                    FILTER ((?withinValue / ?spanValue) < 0.15)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-045_FrameOrdinaryScantlingsShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F03/frame> ] .

