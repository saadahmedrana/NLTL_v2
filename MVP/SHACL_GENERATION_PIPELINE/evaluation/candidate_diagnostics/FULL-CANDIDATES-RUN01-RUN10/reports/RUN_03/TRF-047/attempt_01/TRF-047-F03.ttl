@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/frame> ;
            sh:resultMessage "Each main frame or intermediate ice frame must have a strengthened part with a lower end." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:na43f82e13f834ce28091aecae17f8121b1 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-047_FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/adjacentMainFrame> ;
            sh:resultMessage "Each main frame or intermediate ice frame must have a strengthened part with a lower end." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:na43f82e13f834ce28091aecae17f8121b1 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-047_FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/adjacentMainFrame> ] .

_:na43f82e13f834ce28091aecae17f8121b1 a sh:SPARQLConstraint ;
    sh:message "Each main frame or intermediate ice frame must have a strengthened part with a lower end." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a ?frameType .
                FILTER (?frameType IN (nltl:mainFrame, nltl:intermediateIceFrame))
                FILTER NOT EXISTS {
                    $this nltl:hasStrengthenedPart ?part .
                    ?part nltl:hasLowerEnd ?lowerEnd .
                }
            }
        """ .

