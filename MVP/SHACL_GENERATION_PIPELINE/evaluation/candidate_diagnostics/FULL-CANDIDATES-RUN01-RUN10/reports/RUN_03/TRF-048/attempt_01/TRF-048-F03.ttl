@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/yieldStrengthValue> ;
                    sh:resultMessage "Node ex:yieldStrengthValue->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n87b29d64b5214239a0ad5c2ecc938af0b15 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/longitudinalFrame> ;
            sh:resultMessage "A longitudinal frame must provide exactly one yield strength in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A longitudinal frame must provide exactly one yield strength in MPa." ;
                    sh:minCount 1 ;
                    sh:node gen:PressureQuantityShape ;
                    sh:path nltl:yieldStrength ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/yieldStrengthValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/longitudinalFrame> ;
            sh:resultMessage "f4, section modulus, and required shear area must match the declared frame calculations within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "f4, section modulus, and required shear area must match the declared frame calculations within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                       nltl:designIceLoadHeight ?hNode ;
                       nltl:spacing ?sNode ;
                       nltl:span ?lNode ;
                       nltl:frameMomentFactorM ?mNode ;
                       nltl:yieldStrength ?sigmaNode ;
                       nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Node ;
                       nltl:sectionModulus ?zNode ;
                       nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?sNode qudt:numericValue ?s .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?sigmaNode qudt:numericValue ?sigma .
                ?f4Node qudt:numericValue ?f4 .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND ((1 - "0.2"^^xsd:decimal * ?h / ?s) AS ?expectedF4)
                BIND ((?expectedF4 * ?p * ?h * ?l * ?l /
                    ("4"^^xsd:decimal * ?m * ?sigma) *
                    "1000000"^^xsd:decimal) AS ?expectedZ)
                BIND (("1.7320508075688772"^^xsd:decimal *
                    ?expectedF4 * "2.16"^^xsd:decimal * ?p * ?h * ?l /
                    ("2"^^xsd:decimal * ?sigma) *
                    "10000"^^xsd:decimal) AS ?expectedA)

                FILTER (
                    ABS(?f4 - ?expectedF4) >
                        ABS(?expectedF4) * "0.000001"^^xsd:decimal +
                        "0.000000001"^^xsd:decimal
                    ||
                    ABS(?z - ?expectedZ) >
                        ABS(?expectedZ) * "0.000001"^^xsd:decimal +
                        "0.000000001"^^xsd:decimal
                    ||
                    ABS(?a - ?expectedA) >
                        ABS(?expectedA) * "0.000001"^^xsd:decimal +
                        "0.000000001"^^xsd:decimal
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF048_LongitudinalFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/longitudinalFrame> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/icePressureValue> ;
                    sh:resultMessage "Node ex:icePressureValue->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n87b29d64b5214239a0ad5c2ecc938af0b15 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/longitudinalFrame> ;
            sh:resultMessage "A longitudinal frame must provide exactly one ice pressure in MPa." ;
            sh:resultPath nltl:icePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A longitudinal frame must provide exactly one ice pressure in MPa." ;
                    sh:minCount 1 ;
                    sh:node gen:PressureQuantityShape ;
                    sh:path nltl:icePressure ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/icePressureValue> ] .

_:n87b29d64b5214239a0ad5c2ecc938af0b15 sh:hasValue qudt:MegaPA ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

