@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P03/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A bracketed longitudinal frame must provide its web thickness.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltl:TRF049_QuantityShape ; sh:path nltl:frameWebThickness ], [ sh:node nltl:TRF049_LongitudinalSupportingStructureShape ; sh:path nltl:hasSupportingBulkhead ], [ sh:node nltl:TRF049_LongitudinalSupportingStructureShape ; sh:path nltl:hasSupportingWebFrame ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltl:TRF049_LongitudinalFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P03/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P03/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ] ] , [ sh:node nltl:TRF049_InIceFrameShape ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltl:TRF049_FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P03/frame> ] .

