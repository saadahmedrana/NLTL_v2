@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ;
            sh:resultMessage """Node ex:frame must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:withinIceStrengthenedArea ], [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:passesThroughSupportingStructure ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasFrameAttachment ] ; sh:sparql [ sh:message Literal("A frame running through a supporting structure must have a web plate side count of exactly 2.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:passesThroughSupportingStructure true .
                        FILTER NOT EXISTS {
                            $this nltl:webPlateConnectionSideCount 2 .
                        }
                    }
                ") ], [ sh:message Literal("A longitudinal frame must have a bracketed attachment to every linked supporting web frame or bulkhead.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this a nltl:longitudinalFrame ;
                            nltl:hasFrameAttachment ?attachment .
                        $this (nltl:hasSupportingBulkhead|nltl:hasSupportingWebFrame) ?structure .
                        ?structure a nltl:supportingStructure .
                        FILTER NOT EXISTS {
                            ?structure nltl:hasSupportingStructureAttachment ?attachment .
                            ?attachment nltl:hasAttachedSupportingStructure ?structure ;
                                nltl:hasConnectionBracket ?bracket .
                            ?bracket a nltl:connectionBracket .
                        }
                    }
                ") ], [ sh:message Literal("A terminating transverse frame must have either a connection bracket or a similar attachment construction.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this a nltl:transverseFrame ;
                            nltl:terminatesAtDeckOrIceStringer true ;
                            nltl:hasFrameAttachment ?attachment .
                        FILTER NOT EXISTS {
                            {
                                ?attachment nltl:hasConnectionBracket ?bracket .
                                ?bracket a nltl:connectionBracket .
                            }
                            UNION
                            {
                                ?attachment nltl:similarAttachmentConstructionPresent true .
                            }
                        }
                    }
                ") ], [ sh:message Literal("Each in-ice frame attachment must be effective and must identify a supporting structure linked from the frame.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasFrameAttachment ?attachment .
                        FILTER NOT EXISTS {
                            ?attachment a nltl:frameAttachment ;
                                nltl:effectiveAttachmentConfirmed true ;
                                nltl:hasAttachedSupportingStructure ?structure .
                            $this (nltl:hasSupportingBulkhead|nltl:hasSupportingWebFrame) ?structure .
                            ?structure a nltl:supportingStructure .
                        }
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:withinIceStrengthenedArea ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF049_FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ;
            sh:resultMessage "Less than 1 values on ex:frame->nltl:frameWebThickness" ;
            sh:resultPath nltl:frameWebThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue unit:MilliM ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:frameWebThickness ] ] .

