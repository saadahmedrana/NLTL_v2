@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F01/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in <urn:nltl:generated-shape:TRF-052-normal-arrangement> , <urn:nltl:generated-shape:TRF-052-equivalent-arrangement>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-052> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F01/frame> ] .

