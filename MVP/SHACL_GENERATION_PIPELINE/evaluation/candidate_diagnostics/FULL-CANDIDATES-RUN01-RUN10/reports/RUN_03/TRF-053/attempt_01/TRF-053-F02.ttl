@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F02/iceStringer> ;
            sh:resultMessage "Design line load, section modulus, and required shear area must satisfy the TRF-053 calculations within a relative tolerance of 1e-6, with an absolute fallback tolerance of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Design line load, section modulus, and required shear area must satisfy the TRF-053 calculations within a relative tolerance of 1e-6, with an absolute fallback tolerance of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:designLineLoad ?lineNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?sigmaNode qudt:numericValue ?sigma .
                ?lineNode qudt:numericValue ?line .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND (?p * ?h AS ?product)
                BIND (IF (?product > 0.15, ?product, 0.15) AS ?lineExpected)
                BIND ((0.9 * 1.8 * ?lineExpected * ?l * ?l / (?m * ?sigma)) * 1000000 AS ?zExpected)
                BIND (((1.7320508075688772 * 0.9 * 1.8 * 1.2 * ?lineExpected * ?l) / (2 * ?sigma)) * 10000 AS ?aExpected)

                FILTER (
                    (?line != ?lineExpected) ||
                    ((ABS(?z - ?zExpected) > (0.000001 * ABS(?zExpected))) &&
                     (ABS(?z - ?zExpected) > 0.000000001)) ||
                    ((ABS(?a - ?aExpected) > (0.000001 * ABS(?aExpected))) &&
                     (ABS(?a - ?aExpected) > 0.000000001))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF053IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F02/iceStringer> ] .

