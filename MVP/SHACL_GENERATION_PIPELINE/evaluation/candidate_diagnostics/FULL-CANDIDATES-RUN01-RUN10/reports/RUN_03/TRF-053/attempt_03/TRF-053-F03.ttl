@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ;
            sh:resultMessage "Design line load, section modulus, and required shear area must satisfy the declared ice-stringer formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Design line load, section modulus, and required shear area must satisfy the declared ice-stringer formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:span/qudt:numericValue ?l ;
                      nltl:frameMomentFactorM/qudt:numericValue ?m ;
                      nltl:yieldStrength/qudt:numericValue ?sigma ;
                      nltl:designLineLoad/qudt:numericValue ?reportedLine ;
                      nltl:sectionModulus/qudt:numericValue ?reportedZ ;
                      nltl:requiredShearArea/qudt:numericValue ?reportedA .

                BIND(IF((?p * ?h) > 0.15, (?p * ?h), 0.15) AS ?designLineMN)
                BIND(?designLineMN * 1000 AS ?expectedLine)
                BIND(0.9 * 1.8 * ?designLineMN * ?l * ?l / (?m * ?sigma) * 1000000 AS ?expectedZ)
                BIND(1.7320508075688772 * 0.9 * 1.8 * 1.2 * ?designLineMN * ?l / (2 * ?sigma) * 10000 AS ?expectedA)

                BIND(IF((?expectedLine * 0.000001) > 0.000000001, (?expectedLine * 0.000001), 0.000000001) AS ?tolLine)
                BIND(IF((?expectedZ * 0.000001) > 0.000000001, (?expectedZ * 0.000001), 0.000000001) AS ?tolZ)
                BIND(IF((?expectedA * 0.000001) > 0.000000001, (?expectedA * 0.000001), 0.000000001) AS ?tolA)

                FILTER(
                    (?reportedLine < (?expectedLine - ?tolLine)) ||
                    (?reportedLine > (?expectedLine + ?tolLine)) ||
                    (?reportedZ < (?expectedZ - ?tolZ)) ||
                    (?reportedZ > (?expectedZ + ?tolZ)) ||
                    (?reportedA < (?expectedA - ?tolA)) ||
                    (?reportedA > (?expectedA + ?tolA))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF053IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ] .

