@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ;
            sh:resultMessage "The ice stringer must be located within the ice belt." ;
            sh:resultPath nltl:locatedWithinIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n3abe30a5ecc446df9d5f6164bc9a6bf4b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ;
            sh:resultMessage "The ice stringer must be located within the ice belt." ;
            sh:resultPath nltl:locatedWithinIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n3abe30a5ecc446df9d5f6164bc9a6bf4b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ;
            sh:resultMessage "The design line load, section modulus, and required shear area must satisfy the declared ice stringer formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The design line load, section modulus, and required shear area must satisfy the declared ice stringer formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:designLineLoad ?lineNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?sigmaNode qudt:numericValue ?sigma .
                ?lineNode qudt:numericValue ?line .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND(IF((?p * ?h) > 0.15, (?p * ?h), 0.15) AS ?designLoad)
                BIND(?designLoad * 1000 AS ?expectedLine)
                BIND((0.9 * 1.8 * ?designLoad * ?l * ?l / (?m * ?sigma)) * 1000000 AS ?expectedZ)
                BIND((1.7320508075688772 * 0.9 * 1.8 * 1.2 * ?designLoad * ?l / (2 * ?sigma)) * 10000 AS ?expectedA)

                BIND(IF((?expectedLine * 0.000001) > 0.000000001, (?expectedLine * 0.000001), 0.000000001) AS ?lineTol)
                BIND(IF((?expectedZ * 0.000001) > 0.000000001, (?expectedZ * 0.000001), 0.000000001) AS ?zTol)
                BIND(IF((?expectedA * 0.000001) > 0.000000001, (?expectedA * 0.000001), 0.000000001) AS ?aTol)

                FILTER(
                    (?line < (?expectedLine - ?lineTol)) ||
                    (?line > (?expectedLine + ?lineTol)) ||
                    (?z < (?expectedZ - ?zTol)) ||
                    (?z > (?expectedZ + ?zTol)) ||
                    (?a < (?expectedA - ?aTol)) ||
                    (?a > (?expectedA + ?aTol))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF053IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ] .

_:n3abe30a5ecc446df9d5f6164bc9a6bf4b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice stringer must be located within the ice belt." ;
    sh:minCount 1 ;
    sh:path nltl:locatedWithinIceBelt .

