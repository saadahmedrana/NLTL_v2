@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-P01/iceStringer> ;
            sh:resultMessage "The ice stringer must be located within the ice belt." ;
            sh:resultPath nltl:locatedWithinIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n3abe30a5ecc446df9d5f6164bc9a6bf4b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-P01/iceStringer> ;
            sh:resultMessage "The ice stringer must be located within the ice belt." ;
            sh:resultPath nltl:locatedWithinIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n3abe30a5ecc446df9d5f6164bc9a6bf4b1 ] .

_:n3abe30a5ecc446df9d5f6164bc9a6bf4b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice stringer must be located within the ice belt." ;
    sh:minCount 1 ;
    sh:path nltl:locatedWithinIceBelt .

