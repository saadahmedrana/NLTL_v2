@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F02/iceStringer> ;
            sh:resultMessage "Design line load, outside ice belt factor, section modulus, and required shear area must satisfy the declared calculation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Design line load, outside ice belt factor, section modulus, and required shear area must satisfy the declared calculation." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:stringerSpan ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sNode ;
                      nltl:distanceToIceBelt ?hsNode ;
                      nltl:designLineLoad ?qNode ;
                      nltl:outsideIceBeltFactor ?fNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode <http://qudt.org/schema/qudt/numericValue> ?p .
                ?hNode <http://qudt.org/schema/qudt/numericValue> ?h .
                ?lNode <http://qudt.org/schema/qudt/numericValue> ?l .
                ?mNode <http://qudt.org/schema/qudt/numericValue> ?m .
                ?sNode <http://qudt.org/schema/qudt/numericValue> ?s .
                ?hsNode <http://qudt.org/schema/qudt/numericValue> ?hs .
                ?qNode <http://qudt.org/schema/qudt/numericValue> ?q .
                ?fNode <http://qudt.org/schema/qudt/numericValue> ?f .
                ?zNode <http://qudt.org/schema/qudt/numericValue> ?z .
                ?aNode <http://qudt.org/schema/qudt/numericValue> ?a .

                BIND((?p * ?h) AS ?product)
                BIND(IF(?product < 0.15, 0.15, ?product) AS ?lineMn)
                BIND((?lineMn * 1000) AS ?qExpected)
                BIND((1 - (?hs / ?l)) AS ?fExpected)
                BIND((0.80 * 1.8 * ?lineMn * ?l * ?l /
                      (?m * ?s) * ?fExpected * 1000000) AS ?zExpected)
                BIND((1.7320508075688772 * 0.80 * 1.8 * 1.2 * ?lineMn * ?l /
                      (2 * ?s) * ?fExpected * 10000) AS ?aExpected)

                BIND(IF(?qExpected < 0, 0 - ?qExpected, ?qExpected) AS ?qScale)
                BIND(IF(?fExpected < 0, 0 - ?fExpected, ?fExpected) AS ?fScale)
                BIND(IF(?zExpected < 0, 0 - ?zExpected, ?zExpected) AS ?zScale)
                BIND(IF(?aExpected < 0, 0 - ?aExpected, ?aExpected) AS ?aScale)

                BIND(IF(?qScale < 0.000001, 0.000001, 0.000001 * ?qScale) AS ?qTol)
                BIND(IF(?fScale < 0.000001, 0.000001, 0.000001 * ?fScale) AS ?fTol)
                BIND(IF(?zScale < 0.000001, 0.000001, 0.000001 * ?zScale) AS ?zTol)
                BIND(IF(?aScale < 0.000001, 0.000001, 0.000001 * ?aScale) AS ?aTol)

                BIND(IF(?q - ?qExpected < 0, 0 - (?q - ?qExpected), ?q - ?qExpected) AS ?qDiff)
                BIND(IF(?f - ?fExpected < 0, 0 - (?f - ?fExpected), ?f - ?fExpected) AS ?fDiff)
                BIND(IF(?z - ?zExpected < 0, 0 - (?z - ?zExpected), ?z - ?zExpected) AS ?zDiff)
                BIND(IF(?a - ?aExpected < 0, 0 - (?a - ?aExpected), ?a - ?aExpected) AS ?aDiff)

                FILTER(?qDiff > ?qTol ||
                       ?fDiff > ?fTol ||
                       ?zDiff > ?zTol ||
                       ?aDiff > ?aTol)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF054_IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F02/iceStringer> ] .

