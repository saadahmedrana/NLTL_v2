@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P01/narrowDeckStrip> ;
            sh:resultMessage "The narrow deck strip must either be outside the stated applicability or satisfy the applicable deck-strip requirements." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF055_NarrowDeckStripShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P01/narrowDeckStrip> ] .

