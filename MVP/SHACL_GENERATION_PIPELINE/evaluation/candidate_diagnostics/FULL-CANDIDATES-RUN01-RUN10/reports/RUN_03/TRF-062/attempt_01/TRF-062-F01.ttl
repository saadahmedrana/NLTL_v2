@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-062-F01/ship> ;
            sh:resultMessage "The propeller blade tip to hull clearance must be no less than the minimum clearance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The propeller blade tip to hull clearance must be no less than the minimum clearance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerBladeTipHullClearance ?observedNode .
                ?observedNode qudt:numericValue ?observedValue .
                ?observedNode qudt:unit <http://qudt.org/vocab/unit/M> .
                $this nltl:minimumClearance ?requiredNode .
                ?requiredNode qudt:numericValue ?requiredValue .
                ?requiredNode qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (
                    ?observedValue < ?requiredValue
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-062-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-062-F01/ship> ] .

