@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:TRF064DetachedStrutBranch , gen:TRF064NormalEnclosureBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF064Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/ship> ;
            sh:resultMessage "The detached-strut applicability state must be recorded as one boolean value." ;
            sh:resultPath nltl:detachedStrut ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The detached-strut applicability state must be recorded as one boolean value." ;
                    sh:minCount 1 ;
                    sh:path nltl:detachedStrut ] ] .

