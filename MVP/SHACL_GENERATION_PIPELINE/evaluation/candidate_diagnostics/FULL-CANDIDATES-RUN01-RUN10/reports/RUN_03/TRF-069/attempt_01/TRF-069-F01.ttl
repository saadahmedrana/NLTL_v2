@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:message Literal("For an applicable propulsion-machinery configuration, the required design-load scope conditions shall be recorded.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:fixedPitchPropellerReversalLoadIncluded ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:normalOperationalConditions ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:normalServiceLifePropellerIceLoadCondition ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:radialIceEntryOutsideLoadModel ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stoppedPropellerDraggingOutsideLoadModel ] ] ; sh:path nltl:hasDesignCondition ] ] , [ sh:sparql [ sh:message Literal("This branch is valid only when the propulsion-machinery applicability conditions are not all satisfied.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass ;
                              nltl:propellerType ?propellerType ;
                              nltl:pitchType ?pitchType .
                        FILTER (
                            ?iceClass IN (
                                nltl:iceClassIaSuper,
                                nltl:iceClassIa,
                                nltl:iceClassIb,
                                nltl:iceClassIc
                            )
                            && ?propellerType IN ("open"^^xsd:string, "ducted"^^xsd:string)
                            && ?pitchType IN ("controllable"^^xsd:string, "fixed"^^xsd:string)
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-069> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-F01/ship> ] .

