@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extremeLoad ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For an extreme-load design, the thruster-body local-strength assessment must be satisfied.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:thrusterBodyLocalStrength ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extremeLoad ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-070-ExtremeDesignConditionShape> ; sh:path nltl:hasDesignCondition ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-070-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F03/ship> ;
            sh:resultMessage "Each design condition must identify whether it represents normal operational conditions." ;
            sh:resultPath nltl:normalOperationalConditions ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n6aba8d89131a46f2af50373ecdc6c071b6 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F03/designCondition> ;
            sh:resultMessage "Each design condition must identify whether it represents normal operational conditions." ;
            sh:resultPath nltl:normalOperationalConditions ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n6aba8d89131a46f2af50373ecdc6c071b6 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F03/designCondition> ;
            sh:resultMessage "Each design condition must provide the expected thruster-body ice load in kN." ;
            sh:resultPath nltl:designConditionExpectedLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n6aba8d89131a46f2af50373ecdc6c071b5 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F03/ship> ;
            sh:resultMessage "Each design condition must provide the expected thruster-body ice load in kN." ;
            sh:resultPath nltl:designConditionExpectedLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n6aba8d89131a46f2af50373ecdc6c071b5 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F03/ship> ;
            sh:resultMessage "The ship must identify an azimuthing or fixed thruster type." ;
            sh:resultPath nltl:thrusterType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "azimuthing" "fixed" ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship must identify an azimuthing or fixed thruster type." ;
                    sh:minCount 1 ;
                    sh:path nltl:thrusterType ] ;
            sh:value "azimuthing"^^xsd:string ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F03/ship> ;
            sh:resultMessage "The ship must provide its linked design condition." ;
            sh:resultPath nltl:hasDesignCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:designCondition ;
                    sh:message "The ship must provide its linked design condition." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-070-DesignConditionShape> ;
                    sh:path nltl:hasDesignCondition ] ] .

_:n6aba8d89131a46f2af50373ecdc6c071b5 sh:maxCount 1 ;
    sh:message "Each design condition must provide the expected thruster-body ice load in kN." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:TRF-070-ForceQuantityShape> ;
    sh:path nltl:designConditionExpectedLoad .

_:n6aba8d89131a46f2af50373ecdc6c071b6 sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:message "Each design condition must identify whether it represents normal operational conditions." ;
    sh:minCount 1 ;
    sh:path nltl:normalOperationalConditions .

