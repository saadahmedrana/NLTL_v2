@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "The ship must identify that the thruster is for main propulsion." ;
            sh:resultPath nltl:mainPropulsionThruster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The ship must identify that the thruster is for main propulsion." ;
                    sh:minCount 1 ;
                    sh:path nltl:mainPropulsionThruster ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "The ship must provide the thruster-body/ice interaction load in kN." ;
            sh:resultPath nltl:thrusterBodyIceInteractionLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the thruster-body/ice interaction load in kN." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-070-ForceQuantityShape> ;
                    sh:path nltl:thrusterBodyIceInteractionLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "The ship must provide the local ice pressure in MPa." ;
            sh:resultPath nltl:localIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the local ice pressure in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-070-PressureQuantityShape> ;
                    sh:path nltl:localIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extremeLoad ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For an extreme-load design, the thruster-body local-strength assessment must be satisfied.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:thrusterBodyLocalStrength ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extremeLoad ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-070-ExtremeDesignConditionShape> ; sh:path nltl:hasDesignCondition ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-070-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "The ship must provide its linked design condition." ;
            sh:resultPath nltl:hasDesignCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:designCondition ;
                    sh:message "The ship must provide its linked design condition." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-070-DesignConditionShape> ;
                    sh:path nltl:hasDesignCondition ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "The ship must provide the propeller/ice interaction load in kN." ;
            sh:resultPath nltl:propellerIceInteractionLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the propeller/ice interaction load in kN." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-070-ForceQuantityShape> ;
                    sh:path nltl:propellerIceInteractionLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "The ship must identify an azimuthing or fixed thruster type." ;
            sh:resultPath nltl:thrusterType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "azimuthing" "fixed" ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship must identify an azimuthing or fixed thruster type." ;
                    sh:minCount 1 ;
                    sh:path nltl:thrusterType ] ;
            sh:value "azimuthing"^^xsd:string ] .

