@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-P01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc ) ; sh:path nltl:iceClass ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF074_QuantityValueShape ; sh:path nltl:ballastConditionPropellerTopDepth ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF074_QuantityValueShape ; sh:path nltl:requiredPropellerSubmersionDepthHi ] ; sh:sparql [ sh:message Literal("For ice classes IB or IC, when the ballast-condition propeller top depth is below hi, the propulsion system shall be designed for ice class IA.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
                        $this nltl:ballastConditionPropellerTopDepth ?depthNode .
                        ?depthNode qudt:numericValue ?depth ;
                            qudt:unit qudt:M .
                        $this nltl:requiredPropellerSubmersionDepthHi ?hiNode .
                        ?hiNode qudt:numericValue ?hi ;
                            qudt:unit qudt:M .
                        FILTER (?depth < ?hi)
                        FILTER NOT EXISTS {
                            $this nltl:propulsionSystemDesignedForIceClass
                                nltl:iceClassIa
                        }
                    }
                ") ] ] , [ sh:property [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF074_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-P01/ship> ] .

