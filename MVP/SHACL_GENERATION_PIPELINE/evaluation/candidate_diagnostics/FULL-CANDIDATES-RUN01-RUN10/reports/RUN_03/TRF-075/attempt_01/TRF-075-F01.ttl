@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F01/case> ;
                    sh:resultMessage "Node ex:case must conform to exactly one shape in [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:backwardBladeForce ] , [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:forwardBladeForce ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:XoneConstraintComponent ;
                    sh:sourceShape nltlgen:TRF_075_LoadCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F01/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F01/ship> ;
            sh:resultMessage "Each linked propeller blade load case must conform to the required blade, ice-block, and force-choice constraints." ;
            sh:resultPath nltl:hasPropellerBladeLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked propeller blade load case must conform to the required blade, ice-block, and force-choice constraints." ;
                    sh:node nltlgen:TRF_075_LoadCaseShape ;
                    sh:path nltl:hasPropellerBladeLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F01/case> ] .

