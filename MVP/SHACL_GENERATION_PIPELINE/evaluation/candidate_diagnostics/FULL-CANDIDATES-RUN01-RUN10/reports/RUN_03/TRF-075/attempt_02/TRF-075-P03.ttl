@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-P03/ship> ;
            sh:resultMessage "Each linked propeller blade load case must be structurally complete and select exactly one blade force." ;
            sh:resultPath nltl:hasPropellerBladeLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked propeller blade load case must be structurally complete and select exactly one blade force." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF075_LoadCaseShape ;
                    sh:path nltl:hasPropellerBladeLoadCase ] ] .

