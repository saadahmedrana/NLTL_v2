@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("CP") ; sh:path nltl:propellerType ] ; sh:sparql [ sh:message Literal("CP propellers must cover load cases 1 through 4.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  FILTER (
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c1 .
      ?c1 nltl:propellerBladeLoadCaseNumber ?n1 .
      FILTER (?n1 = 1)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c2 .
      ?c2 nltl:propellerBladeLoadCaseNumber ?n2 .
      FILTER (?n2 = 2)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c3 .
      ?c3 nltl:propellerBladeLoadCaseNumber ?n3 .
      FILTER (?n3 = 3)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c4 .
      ?c4 nltl:propellerBladeLoadCaseNumber ?n4 .
      FILTER (?n4 = 4)
    }
  )
}
") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerReversingCapability ], [ sh:hasValue Literal("FP") ; sh:path nltl:propellerType ] ; sh:sparql [ sh:message Literal("Non-reversing FP propellers must cover load cases 1 through 4.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  FILTER (
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c1 .
      ?c1 nltl:propellerBladeLoadCaseNumber ?n1 .
      FILTER (?n1 = 1)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c2 .
      ?c2 nltl:propellerBladeLoadCaseNumber ?n2 .
      FILTER (?n2 = 2)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c3 .
      ?c3 nltl:propellerBladeLoadCaseNumber ?n3 .
      FILTER (?n3 = 3)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c4 .
      ?c4 nltl:propellerBladeLoadCaseNumber ?n4 .
      FILTER (?n4 = 4)
    }
  )
}
") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerReversingCapability ], [ sh:hasValue Literal("FP") ; sh:path nltl:propellerType ] ; sh:sparql [ sh:message Literal("Reversing FP propellers must cover load cases 1 through 5.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  FILTER (
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c1 .
      ?c1 nltl:propellerBladeLoadCaseNumber ?n1 .
      FILTER (?n1 = 1)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c2 .
      ?c2 nltl:propellerBladeLoadCaseNumber ?n2 .
      FILTER (?n2 = 2)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c3 .
      ?c3 nltl:propellerBladeLoadCaseNumber ?n3 .
      FILTER (?n3 = 3)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c4 .
      ?c4 nltl:propellerBladeLoadCaseNumber ?n4 .
      FILTER (?n4 = 4)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c5 .
      ?c5 nltl:propellerBladeLoadCaseNumber ?n5 .
      FILTER (?n5 = 5)
    }
  )
}
") ] ] , [ sh:sparql [ sh:message Literal("Propeller types other than CP and FP are outside this load-case requirement.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:propellerType ?type .
  FILTER (STR(?type) = "CP" || STR(?type) = "FP")
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF076Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F01/ship> ] .

