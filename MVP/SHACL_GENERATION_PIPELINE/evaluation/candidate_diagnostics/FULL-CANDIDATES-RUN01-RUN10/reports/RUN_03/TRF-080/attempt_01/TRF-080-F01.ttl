@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ;
            sh:resultMessage "effectiveIceLoadCycleCount must equal iceLoadCycleCount multiplied by propellerBladeCount." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "effectiveIceLoadCycleCount must equal iceLoadCycleCount multiplied by propellerBladeCount." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?cycles ;
                      nltl:propellerBladeCount ?blades ;
                      nltl:effectiveIceLoadCycleCount ?quantity .

                ?quantity qudt:numericValue ?actual .

                BIND((xsd:decimal(?cycles) * xsd:decimal(?blades)) AS ?expected)
                FILTER (
                    ABS(?actual - ?expected) >
                    ((ABS(?expected) * 0.000001) + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF080Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ] .

