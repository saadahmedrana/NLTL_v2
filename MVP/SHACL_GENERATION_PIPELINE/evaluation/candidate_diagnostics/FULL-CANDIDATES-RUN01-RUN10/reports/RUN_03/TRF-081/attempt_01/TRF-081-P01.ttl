@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-P01/ship> ;
            sh:resultMessage "Ice thrust and propeller shaft design thrust values must satisfy the TRF-081 formulas; calculated-result comparisons use a relative tolerance of 1e-6 plus an absolute tolerance of 1e-6 kN." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ice thrust and propeller shaft design thrust values must satisfy the TRF-081 formulas; calculated-result comparisons use a relative tolerance of 1e-6 plus an absolute tolerance of 1e-6 kN." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce ?forwardBladeNode ;
                      nltl:backwardBladeForce ?backwardBladeNode ;
                      nltl:hydrodynamicBollardThrust ?bollardNode ;
                      nltl:forwardIceThrust ?forwardIceNode ;
                      nltl:backwardIceThrust ?backwardIceNode ;
                      nltl:forwardPropellerShaftDesignThrust ?forwardDesignNode ;
                      nltl:backwardPropellerShaftDesignThrust ?backwardDesignNode ;
                      nltl:propellerShaftDesignThrust ?designNode .

                ?forwardBladeNode qudt:numericValue ?forwardBlade .
                ?backwardBladeNode qudt:numericValue ?backwardBlade .
                ?bollardNode qudt:numericValue ?bollard .
                ?forwardIceNode qudt:numericValue ?forwardIce .
                ?backwardIceNode qudt:numericValue ?backwardIce .
                ?forwardDesignNode qudt:numericValue ?forwardDesign .
                ?backwardDesignNode qudt:numericValue ?backwardDesign .
                ?designNode qudt:numericValue ?design .

                BIND (1.1 * ?forwardBlade AS ?forwardIceExpected)
                BIND (1.1 * ?backwardBlade AS ?backwardIceExpected)
                BIND (?bollard + 2.2 * ?forwardIceExpected AS ?forwardDesignExpected)
                BIND (1.5 * ?backwardIceExpected AS ?backwardDesignExpected)
                BIND (
                    IF(
                        ?forwardDesignExpected >= ?backwardDesignExpected,
                        ?forwardDesignExpected,
                        ?backwardDesignExpected
                    )
                    AS ?designExpected
                )

                FILTER (
                    ABS(?forwardIce - ?forwardIceExpected) >
                        (0.000001 * ABS(?forwardIceExpected) + 0.000001)
                    ||
                    ABS(?backwardIce - ?backwardIceExpected) >
                        (0.000001 * ABS(?backwardIceExpected) + 0.000001)
                    ||
                    ABS(?forwardDesign - ?designExpected) >
                        (0.000001 * ABS(?designExpected) + 0.000001)
                    ||
                    ABS(?backwardDesign - ?designExpected) >
                        (0.000001 * ABS(?designExpected) + 0.000001)
                    ||
                    ABS(?design - ?designExpected) >
                        (0.000001 * ABS(?designExpected) + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF_081_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-P01/ship> ] .

