@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-083-F01/ship> ;
            sh:resultMessage "The bollard propeller speed must be known and recorded, or attributed using the required Table 6-9 lookup." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-083> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-083-F01/ship> ] .

