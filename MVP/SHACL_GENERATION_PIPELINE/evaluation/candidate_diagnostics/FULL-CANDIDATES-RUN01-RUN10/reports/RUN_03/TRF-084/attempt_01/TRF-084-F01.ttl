@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ;
            sh:resultMessage "For a CP propeller with unknown pitch, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within the permitted numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a CP propeller with unknown pitch, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within the permitted numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType ?propellerType ;
                      nltl:pitchValueKnown ?pitchValueKnown ;
                      nltl:propellerPitchAtMcrFreeRunning ?freeRunningPitch ;
                      nltl:propellerPitchAtMcrBollard ?bollardPitch .

                FILTER (
                    ?propellerType = "CP"^^xsd:string &&
                    ?pitchValueKnown = false
                )

                ?freeRunningPitch qudt:numericValue ?freeRunningValue ;
                                  qudt:unit unit:M .
                ?bollardPitch qudt:numericValue ?bollardValue ;
                              qudt:unit unit:M .

                BIND (0.7 * ?freeRunningValue AS ?expectedValue)
                FILTER (
                    ABS(?bollardValue - ?expectedValue) >
                    (ABS(?expectedValue) * 0.000001 + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:Shape_TRF_084 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ] .

