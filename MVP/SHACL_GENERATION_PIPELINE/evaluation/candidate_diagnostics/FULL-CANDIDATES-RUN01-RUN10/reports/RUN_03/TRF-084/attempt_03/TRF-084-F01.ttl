@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ;
            sh:resultMessage "For a CP propeller with unknown pitch value, the MCR bollard-condition pitch must equal 0.7 times the free-running MCR pitch within the permitted tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a CP propeller with unknown pitch value, the MCR bollard-condition pitch must equal 0.7 times the free-running MCR pitch within the permitted tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType "CP"^^xsd:string ;
                      nltl:pitchValueKnown false ;
                      nltl:propellerPitchAtMcrFreeRunning ?free ;
                      nltl:propellerPitchAtMcrBollard ?bollard .

                ?free qudt:numericValue ?freeValue ;
                      qudt:unit unit:M .
                ?bollard qudt:numericValue ?bollardValue ;
                         qudt:unit unit:M .

                BIND(0.7 * ?freeValue AS ?expected)
                BIND(
                    IF(
                        (?bollardValue - ?expected) < 0,
                        - (?bollardValue - ?expected),
                        (?bollardValue - ?expected)
                    )
                    AS ?difference
                )
                BIND(
                    IF(?expected < 0, - ?expected, ?expected)
                    AS ?scale
                )

                FILTER(
                    ?difference >
                    (?scale * 0.000001 + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF084Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ] .

