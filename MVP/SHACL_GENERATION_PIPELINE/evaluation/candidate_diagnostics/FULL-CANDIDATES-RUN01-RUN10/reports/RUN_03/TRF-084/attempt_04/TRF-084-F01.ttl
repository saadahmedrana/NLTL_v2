@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ;
            sh:resultMessage "For an unknown CP propeller pitch, bollard pitch must equal 0.7 times free-running pitch within a relative tolerance of 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an unknown CP propeller pitch, bollard pitch must equal 0.7 times free-running pitch within a relative tolerance of 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType "CP"^^xsd:string ;
                       nltl:pitchValueKnown false ;
                       nltl:propellerPitchAtMcrBollard ?bollard ;
                       nltl:propellerPitchAtMcrFreeRunning ?freeRunning .

                ?bollard qudt:numericValue ?bollardValue ;
                         qudt:unit unit:M .
                ?freeRunning qudt:numericValue ?freeRunningValue ;
                             qudt:unit unit:M .

                BIND((0.7 * ?freeRunningValue) AS ?expected)
                BIND(IF((?bollardValue - ?expected) < 0,
                        - (?bollardValue - ?expected),
                        (?bollardValue - ?expected)) AS ?difference)
                BIND(IF(?expected < 0, -?expected, ?expected) AS ?expectedScale)

                FILTER(
                    ?difference >
                    ((0.000001 * ?expectedScale) + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_084_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ] .

