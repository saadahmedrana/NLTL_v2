@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:bollardPropellerSpeedKnown ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:PropellerSpeedQuantityShape ; sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:bollardPropellerSpeedKnown ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:PropellerDiameterQuantityShape ; sh:path nltl:propellerDiameter ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF085TableLookupCaseShape ; sh:path nltl:hasTableLookupCase ] ; sh:sparql [ sh:message Literal("When bollard propeller speed is unknown, the lookup case must use the ship's propeller diameter and produce its bollard MCR propeller speed.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:propellerDiameter ?diameter ;
                              nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ?speed ;
                              nltl:hasTableLookupCase ?case .
                        ?case nltl:lookupInputQuantity ?input ;
                              nltl:lookupResultQuantity ?result .
                        ?diameter qudt:numericValue ?diameterValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?input qudt:numericValue ?inputValue ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?speed qudt:numericValue ?speedValue ;
                               qudt:unit <http://qudt.org/vocab/unit/REV-PER-MIN> .
                        ?result qudt:numericValue ?resultValue ;
                                qudt:unit <http://qudt.org/vocab/unit/REV-PER-MIN> .
                        FILTER (
                            xsd:decimal(?inputValue) != xsd:decimal(?diameterValue) ||
                            xsd:decimal(?resultValue) != xsd:decimal(?speedValue)
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF085Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bollardPropellerSpeedKnown" ;
            sh:resultPath nltl:bollardPropellerSpeedKnown ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:bollardPropellerSpeedKnown ] ] .

