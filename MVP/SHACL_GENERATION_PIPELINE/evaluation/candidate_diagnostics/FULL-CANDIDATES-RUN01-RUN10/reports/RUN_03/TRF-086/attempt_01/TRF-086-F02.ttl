@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:path nltl:propellerType ; sh:pattern Literal(\"^[^C].*$\") ] ] , [ sh:property [ sh:path nltl:propellerType ; sh:pattern Literal(\"^C([^P].*|P.+)$\") ] ] , [ sh:property [ sh:hasValue Literal(\"CP\") ; sh:path nltl:propellerType ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:pitchValueKnown ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-086-LengthQuantityShape> ; sh:path nltl:propellerPitchAtMcrBollard ] ] , [ sh:property [ sh:hasValue Literal(\"CP\") ; sh:path nltl:propellerType ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:pitchValueKnown ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-086-LengthQuantityShape> ; sh:path nltl:propellerPitchAtMcrBollard ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-086-LengthQuantityShape> ; sh:path nltl:propellerPitchAtMcrFreeRunning ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-086-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-F02/ship> ] .

