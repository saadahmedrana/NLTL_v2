@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/ship> ;
            sh:resultMessage "A ship shall identify a propulsion load case for the required strength evaluation." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:neb4975e0ff83481ab6e5d7e23003e20bb2 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ;
                    sh:resultMessage "The propulsion load case shall be designated for propulsion line strength evaluation and not for stalling analysis." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:propulsionLineStrengthEvaluationPurpose ) ;
                            sh:message "The propulsion load case shall be designated for propulsion line strength evaluation and not for stalling analysis." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:loadCasePurpose ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/milling> ;
            sh:resultMessage "A ship shall identify a propulsion load case for the required strength evaluation." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:neb4975e0ff83481ab6e5d7e23003e20bb2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/milling> ;
            sh:resultMessage "A ship shall identify the ice milling sequence case." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceMillingSequenceCase ;
                    sh:message "A ship shall identify the ice milling sequence case." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceMillingSequenceCase ] ] .

_:neb4975e0ff83481ab6e5d7e23003e20bb2 sh:class nltl:loadCase ;
    sh:message "A ship shall identify a propulsion load case for the required strength evaluation." ;
    sh:minCount 1 ;
    sh:node gen:TRF091PropulsionLoadCaseShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasPropulsionLoadCase .

