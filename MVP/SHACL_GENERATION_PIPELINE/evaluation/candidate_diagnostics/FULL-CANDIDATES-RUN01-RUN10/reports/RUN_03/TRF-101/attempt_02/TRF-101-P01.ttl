@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qdt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P01/ship> ;
            sh:resultMessage "Value is not Literal with datatype qdt:QuantityValue" ;
            sh:resultPath nltl:bladeTipOffset ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype qdt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qdt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qdt:numericValue ] ] ;
                    sh:path nltl:bladeTipOffset ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P01/bladeTipOffsetValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P01/ship> ;
            sh:resultMessage "Value is not Literal with datatype qdt:QuantityValue" ;
            sh:resultPath nltl:propellerDiameter ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype qdt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qdt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qdt:numericValue ] ] ;
                    sh:path nltl:propellerDiameter ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P01/propellerDiameterValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:approvalRecord ] ; sh:path nltl:approvedNonlinearBladeStressAnalysis ] ] , [ sh:property [ sh:datatype qdt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qdt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qdt:unit ] ] ; sh:path nltl:bladeFailureUltimateLoad ], [ sh:datatype qdt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qdt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qdt:unit ] ] ; sh:path nltl:bladeChordLengthAtWeakestSection ], [ sh:datatype qdt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qdt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qdt:unit ] ] ; sh:path nltl:bladeCylindricalRootRadius ], [ sh:datatype qdt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qdt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qdt:unit ] ] ; sh:path nltl:bladeMaximumThicknessAtWeakestSection ], [ sh:datatype qdt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qdt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qdt:unit ] ] ; sh:path nltl:bladeMinimumYieldStrength ], [ sh:datatype qdt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qdt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qdt:unit ] ] ; sh:path nltl:bladeReferenceStrength1 ], [ sh:datatype qdt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qdt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qdt:unit ] ] ; sh:path nltl:bladeUltimateTensileStrength ] ; sh:sparql [ sh:message Literal("Blade ultimate load and reference strength must satisfy the declared blade-failure calculation within a 1e-6 expected-result-scaled tolerance.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qdt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerDiameter ?dNode ;
                              nltl:bladeChordLengthAtWeakestSection ?cNode ;
                              nltl:bladeMaximumThicknessAtWeakestSection ?tNode ;
                              nltl:bladeCylindricalRootRadius ?rNode ;
                              nltl:bladeMinimumYieldStrength ?yNode ;
                              nltl:bladeUltimateTensileStrength ?uNode ;
                              nltl:bladeReferenceStrength1 ?sNode ;
                              nltl:bladeFailureUltimateLoad ?fNode .
                        ?dNode qdt:numericValue ?d .
                        ?cNode qdt:numericValue ?c .
                        ?tNode qdt:numericValue ?t .
                        ?rNode qdt:numericValue ?r .
                        ?yNode qdt:numericValue ?y .
                        ?uNode qdt:numericValue ?u .
                        ?sNode qdt:numericValue ?s .
                        ?fNode qdt:numericValue ?f .
                        BIND ((0.6 * ?y) + (0.4 * ?u) AS ?expectedStrength)
                        BIND ((300 * ?c * ?t * ?t * ?expectedStrength) /
                              ((0.8 * ?d) - (2 * ?r)) AS ?expectedLoad)
                        FILTER (
                            ((0.8 * ?d) - (2 * ?r) <= 0) ||
                            (?s < (?expectedStrength * (1 - 0.000001)) ||
                             ?s > (?expectedStrength * (1 + 0.000001)) ||
                             (?expectedStrength <= 0 &&
                              (?s < (?expectedStrength - 0.000001) ||
                               ?s > (?expectedStrength + 0.000001))) ||
                             ?f < (?expectedLoad * (1 - 0.000001)) ||
                             ?f > (?expectedLoad * (1 + 0.000001)) ||
                             (?expectedLoad <= 0 &&
                              (?f < (?expectedLoad - 0.000001) ||
                               ?f > (?expectedLoad + 0.000001))))
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF101BladeFailureShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bladeFailureStatus" ;
            sh:resultPath nltl:bladeFailureStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:bladeFailureStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasLoadCase" ;
            sh:resultPath nltl:hasLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:bladeFailureLoadWeakestDirectionConfirmed ],
                                [ sh:datatype qdt:QuantityValue ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qdt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:maxInclusive 0.8 ;
                                                    sh:minCount 1 ;
                                                    sh:minInclusive 0.8 ;
                                                    sh:path qdt:numericValue ] ] ;
                                    sh:path nltl:bladeFailureLoadApplicationRadiusRatio ] ] ;
                    sh:path nltl:hasLoadCase ] ] .

