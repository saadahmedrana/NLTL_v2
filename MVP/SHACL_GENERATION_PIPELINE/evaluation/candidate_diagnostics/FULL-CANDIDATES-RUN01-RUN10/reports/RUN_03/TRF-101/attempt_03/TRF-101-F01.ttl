@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/bladeTipOffsetValue> ;
                    sh:resultMessage "Node ex:bladeTipOffsetValue-><http://qudt.org/schema/qudtunit> does not contain a value in the set: ['<http://qudt.org/vocab/unit/M>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n95d671d419c545a68b072e2fd4cc9157b24 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/bladeTipOffsetValue> ;
                    sh:resultMessage "Less than 1 values on ex:bladeTipOffsetValue-><http://qudt.org/schema/qudtnumericValue>" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:numericValue ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/bladeTipOffsetValue> ;
                    sh:resultMessage "Less than 1 values on ex:bladeTipOffsetValue-><http://qudt.org/schema/qudtunit>" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n95d671d419c545a68b072e2fd4cc9157b24 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "A blade tip offset quantity in metres is required." ;
            sh:resultPath nltl:bladeTipOffset ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A blade tip offset quantity in metres is required." ;
                    sh:minCount 1 ;
                    sh:node gen:BladeTipOffsetQuantity ;
                    sh:path nltl:bladeTipOffset ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/bladeTipOffsetValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/propellerDiameterValue> ;
                    sh:resultMessage "Node ex:propellerDiameterValue-><http://qudt.org/schema/qudtunit> does not contain a value in the set: ['<http://qudt.org/vocab/unit/M>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n95d671d419c545a68b072e2fd4cc9157b22 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/propellerDiameterValue> ;
                    sh:resultMessage "Less than 1 values on ex:propellerDiameterValue-><http://qudt.org/schema/qudtunit>" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n95d671d419c545a68b072e2fd4cc9157b22 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/propellerDiameterValue> ;
                    sh:resultMessage "Less than 1 values on ex:propellerDiameterValue-><http://qudt.org/schema/qudtnumericValue>" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:numericValue ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "A propeller diameter quantity in metres is required." ;
            sh:resultPath nltl:propellerDiameter ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A propeller diameter quantity in metres is required." ;
                    sh:minCount 1 ;
                    sh:node gen:PropellerDiameterQuantity ;
                    sh:path nltl:propellerDiameter ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/propellerDiameterValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:approvalRecord ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An approved nonlinear blade stress analysis is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:approvedNonlinearBladeStressAnalysis ] ] , [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:BladeChordQuantity ; sh:path nltl:bladeChordLengthAtWeakestSection ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:BladeReferenceStrengthQuantity ; sh:path nltl:bladeReferenceStrength1 ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:BladeRootRadiusQuantity ; sh:path nltl:bladeCylindricalRootRadius ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:BladeThicknessQuantity ; sh:path nltl:bladeMaximumThicknessAtWeakestSection ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:BladeUltimateLoadQuantity ; sh:path nltl:bladeFailureUltimateLoad ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:BladeUltimateStrengthQuantity ; sh:path nltl:bladeUltimateTensileStrength ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:BladeYieldStrengthQuantity ; sh:path nltl:bladeMinimumYieldStrength ] ; sh:sparql [ sh:message Literal("The reported reference strength and blade failure load must match the declared calculation within an expected-result-scaled tolerance of 1e-6, with a 1e-6 absolute fallback near zero.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerDiameter ?dNode ;
                              nltl:bladeChordLengthAtWeakestSection ?cNode ;
                              nltl:bladeMaximumThicknessAtWeakestSection ?tNode ;
                              nltl:bladeCylindricalRootRadius ?rNode ;
                              nltl:bladeMinimumYieldStrength ?yieldNode ;
                              nltl:bladeUltimateTensileStrength ?ultimateNode ;
                              nltl:bladeReferenceStrength1 ?refNode ;
                              nltl:bladeFailureUltimateLoad ?loadNode .
                        ?dNode qudt:numericValue ?d ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?cNode qudt:numericValue ?c ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?tNode qudt:numericValue ?t ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?rNode qudt:numericValue ?r ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?yieldNode qudt:numericValue ?yield ;
                                   qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                        ?ultimateNode qudt:numericValue ?ultimate ;
                                      qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                        ?refNode qudt:numericValue ?ref ;
                                qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                        ?loadNode qudt:numericValue ?load ;
                                 qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        BIND ((0.6 * ?yield) + (0.4 * ?ultimate) AS ?expectedRef)
                        BIND ((300 * ?c * ?t * ?t * ?expectedRef) /
                              ((0.8 * ?d) - (2 * ?r)) AS ?expectedLoad)
                        BIND (IF(?expectedRef >= 0.001,
                                 0.000001 * ?expectedRef,
                                 0.000001) AS ?refTolerance)
                        BIND (IF(?expectedLoad >= 0.001,
                                 0.000001 * ?expectedLoad,
                                 0.000001) AS ?loadTolerance)
                        FILTER (
                            (?ref < (?expectedRef - ?refTolerance)) ||
                            (?ref > (?expectedRef + ?refTolerance)) ||
                            (?load < (?expectedLoad - ?loadTolerance)) ||
                            (?load > (?expectedLoad + ?loadTolerance))
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF101Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "A blade-failure load case with the specified application conditions is required." ;
            sh:resultPath nltl:hasLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A blade-failure load case with the specified application conditions is required." ;
                    sh:minCount 1 ;
                    sh:node gen:BladeFailureLoadCase ;
                    sh:path nltl:hasLoadCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bladeFailureStatus" ;
            sh:resultPath nltl:bladeFailureStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:bladeFailureStatus ] ] .

