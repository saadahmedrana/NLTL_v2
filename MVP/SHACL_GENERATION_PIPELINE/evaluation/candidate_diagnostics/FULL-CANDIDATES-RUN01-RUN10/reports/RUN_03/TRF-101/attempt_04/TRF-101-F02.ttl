@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to exactly one shape in [ sh:property [ sh:class nltl:approvalRecord ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An approved nonlinear blade stress analysis is required when the calculation branch is not used") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:approvedNonlinearBladeStressAnalysis ] ] , [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-KiloN> ; sh:path nltl:bladeFailureUltimateLoad ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-M> ; sh:path nltl:bladeChordLengthAtWeakestSection ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-M> ; sh:path nltl:bladeCylindricalRootRadius ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-M> ; sh:path nltl:bladeMaximumThicknessAtWeakestSection ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-MegaPA> ; sh:path nltl:bladeMinimumYieldStrength ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-MegaPA> ; sh:path nltl:bladeReferenceStrength1 ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-MegaPA> ; sh:path nltl:bladeUltimateTensileStrength ] ; sh:sparql [ sh:message Literal("bladeReferenceStrength1 and bladeFailureUltimateLoad must satisfy the declared blade failure load calculation within an expected-result-scaled tolerance") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerDiameter ?diameterNode ;
                              nltl:bladeChordLengthAtWeakestSection ?chordNode ;
                              nltl:bladeMaximumThicknessAtWeakestSection ?thicknessNode ;
                              nltl:bladeCylindricalRootRadius ?radiusNode ;
                              nltl:bladeMinimumYieldStrength ?yieldNode ;
                              nltl:bladeUltimateTensileStrength ?ultimateNode ;
                              nltl:bladeReferenceStrength1 ?referenceNode ;
                              nltl:bladeFailureUltimateLoad ?loadNode ;
                              nltl:hasLoadCase ?case .
                        ?diameterNode qudt:numericValue ?diameter .
                        ?chordNode qudt:numericValue ?chord .
                        ?thicknessNode qudt:numericValue ?thickness .
                        ?radiusNode qudt:numericValue ?radius .
                        ?yieldNode qudt:numericValue ?yield .
                        ?ultimateNode qudt:numericValue ?ultimate .
                        ?referenceNode qudt:numericValue ?reference .
                        ?loadNode qudt:numericValue ?reportedLoad .
                        ?case nltl:bladeFailureLoadApplicationRadiusRatio ?ratioNode .
                        ?ratioNode qudt:numericValue ?ratio .
                        BIND ((0.6 * ?yield) + (0.4 * ?ultimate) AS ?expectedReference)
                        BIND ((300 * ?chord * ?thickness * ?thickness * ?expectedReference) /
                              ((?ratio * ?diameter) - (2 * ?radius)) AS ?expectedLoad)
                        BIND (IF(?expectedLoad > 0.000001,
                                 ?expectedLoad * 0.000001,
                                 0.000001) AS ?tolerance)
                        FILTER (
                            (?reference < (?expectedReference - ?tolerance) ||
                             ?reference > (?expectedReference + ?tolerance)) ||
                            (?reportedLoad < (?expectedLoad - ?tolerance) ||
                             ?reportedLoad > (?expectedLoad + ?tolerance))
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:XoneConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-101-Ship> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasLoadCase" ;
            sh:resultPath nltl:hasLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-101-LoadCase> ;
                    sh:path nltl:hasLoadCase ] ] .

