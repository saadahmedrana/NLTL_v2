@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-P02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:leadingEdgeChordPortionAtZeroPointEightRadius" ;
            sh:resultPath nltl:leadingEdgeChordPortionAtZeroPointEightRadius ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:LengthQuantity> ;
                    sh:path nltl:leadingEdgeChordPortionAtZeroPointEightRadius ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-P02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bladeFailureSpindleTorqueFactor" ;
            sh:resultPath nltl:bladeFailureSpindleTorqueFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:DimensionlessQuantity> ;
                    sh:path nltl:bladeFailureSpindleTorqueFactor ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-P02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:extremeIceForce" ;
            sh:resultPath nltl:extremeIceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:ForceQuantity> ;
                    sh:path nltl:extremeIceForce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-P02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:trailingEdgeChordPortionAtZeroPointEightRadius" ;
            sh:resultPath nltl:trailingEdgeChordPortionAtZeroPointEightRadius ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:LengthQuantity> ;
                    sh:path nltl:trailingEdgeChordPortionAtZeroPointEightRadius ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-P02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bladeFailureSpindleTorque" ;
            sh:resultPath nltl:bladeFailureSpindleTorque ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TorqueQuantity> ;
                    sh:path nltl:bladeFailureSpindleTorque ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-P02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:propellerBladeCount" ;
            sh:resultPath nltl:propellerBladeCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerBladeCount ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-P02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bladeExpandedAreaRatio" ;
            sh:resultPath nltl:bladeExpandedAreaRatio ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:DimensionlessQuantity> ;
                    sh:path nltl:bladeExpandedAreaRatio ] ] .

