@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-P03/ship> ;
            sh:resultMessage "Each ship shall identify at least one propeller shaft line component and verify that blade loss causes no significant damage." ;
            sh:resultPath nltl:hasPropellerShaftLineComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:propellerShaftLineComponent ;
                    sh:message "Each ship shall identify at least one propeller shaft line component and verify that blade loss causes no significant damage." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue false ;
                                    sh:maxCount 1 ;
                                    sh:message "Loss of a propeller blade shall not cause significant damage to the propeller shaft line component." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:significantDamageFromBladeLoss ] ] ;
                    sh:path nltl:hasPropellerShaftLineComponent ] ] .

