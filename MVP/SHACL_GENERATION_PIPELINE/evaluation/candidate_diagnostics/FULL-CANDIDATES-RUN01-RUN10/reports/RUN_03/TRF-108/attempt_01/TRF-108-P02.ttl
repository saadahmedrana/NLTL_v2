@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-P02/ship> ;
            sh:resultMessage "The blade material properties must be recorded to support SN-curve selection." ;
            sh:resultPath nltl:propellerBladeMaterialProperty ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The blade material properties must be recorded to support SN-curve selection." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerBladeMaterialProperty ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-P02/otherStressLifeCurve> ;
                    sh:resultMessage "The selected SN-curve value must specify its curve type." ;
                    sh:resultPath nltl:stressLifeCurveType ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:message "The selected SN-curve value must specify its curve type." ;
                            sh:minCount 1 ;
                            sh:path nltl:stressLifeCurveType ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-P02/ship> ;
            sh:resultMessage "Exactly one SN-curve selection must be recorded." ;
            sh:resultPath nltl:stressLifeCurveSelection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:stressLifeCurveTypeValue ;
                    sh:maxCount 1 ;
                    sh:message "Exactly one SN-curve selection must be recorded." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-108-SelectedCurveValueShape> ;
                    sh:path nltl:stressLifeCurveSelection ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-P02/otherStressLifeCurve> ] .

