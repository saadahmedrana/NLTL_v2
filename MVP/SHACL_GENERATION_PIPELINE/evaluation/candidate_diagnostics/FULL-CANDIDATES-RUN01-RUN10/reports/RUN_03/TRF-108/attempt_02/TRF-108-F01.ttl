@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal("Evidence must demonstrate that the selected SN-curve corresponds to the blade material properties.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ], [ sh:class nltl:stressLifeCurveTypeValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("When the SN-curve is known, the selected curve must be identified.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelection ], [ sh:datatype xsd:string ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("When the SN-curve is known, its type must be recorded on the ship.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveType ], [ sh:datatype xsd:string ; sh:message Literal("When the SN-curve is known, the blade material properties needed for correspondence must be recorded.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerBladeMaterialProperty ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:stressLifeCurveKnown ] ; sh:sparql [ sh:message Literal("The selected SN-curve, its type, blade material properties, and correspondence evidence must be asserted together on the ship.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:stressLifeCurveKnown true ;
                              nltl:stressLifeCurveType ?curveType ;
                              nltl:propellerBladeMaterialProperty ?material ;
                              nltl:stressLifeCurveSelection ?selectedCurve ;
                              nltl:stressLifeCurveSelectionCorrespondenceEvidence ?evidence .
                    }
                ") ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:stressLifeCurveKnown ], [ sh:hasValue nltl:twoSlopeStressLifeCurve ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("When the SN-curve is unknown, the two-slope SN curve shall be used.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelection ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlg:TRF108Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F01/ship> ] .

