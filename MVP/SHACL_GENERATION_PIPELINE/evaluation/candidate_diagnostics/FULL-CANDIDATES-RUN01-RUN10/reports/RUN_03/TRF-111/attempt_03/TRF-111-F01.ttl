_:N3d91267779d24449ac284d5da010a98e sh:class nltl:loadCase ;
    sh:message "An extreme operational load case shall have a unitless component yield safety factor of at least 1.3." ;
    sh:property [ sh:class qudt:QuantityValue ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:minInclusive 1.3 ;
                            sh:path qudt:numericValue ],
                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:path nltl:componentYieldSafetyFactor ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                    sh:in ( nltl:extremeOperationalLoadCase ) ] ;
            sh:path nltl:shaftLineLoadCaseType ] .

