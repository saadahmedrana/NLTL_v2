@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P02/ship> ;
            sh:resultMessage "Each linked propeller shaft-line component shall also be linked through hasComponent." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each linked propeller shaft-line component shall also be linked through hasComponent." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?c
            WHERE {
                $this nltl:hasPropellerShaftLineComponent ?c .
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?c .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-111-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P02/ship> ;
            sh:resultMessage "Node ex:loadCase must conform to one or more shapes in [ sh:property [ sh:class qudt:QuantityValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.3\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:shaftLineLoadCaseTypeValue ; sh:in ( nltl:extremeOperationalLoadCase ) ] ; sh:path nltl:shaftLineLoadCaseType ] ] , [ sh:property [ sh:class qudt:QuantityValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.5\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:shaftLineLoadCaseTypeValue ; sh:in ( nltl:fatigueLoadCase ) ] ; sh:path nltl:shaftLineLoadCaseType ] ] , [ sh:property [ sh:class qudt:QuantityValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:shaftLineLoadCaseTypeValue ; sh:in ( nltl:bladeFailureLoadCase ) ] ; sh:path nltl:shaftLineLoadCaseType ] ]" ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape _:n927cf7e93402486fbd59c0ad1d67b21db5 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P02/loadCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P02/ship> ;
            sh:resultMessage "The ship shall provide exactly one extreme ice force quantity in kN." ;
            sh:resultPath nltl:extremeIceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship shall provide exactly one extreme ice force quantity in kN." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:extremeIceForce ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P02/loadCase> ;
                    sh:resultMessage "Less than 1 values on ex:loadCase->nltl:componentYieldSafetyFactor" ;
                    sh:resultPath nltl:componentYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class qudt:QuantityValue ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:minInclusive 1.3 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:componentYieldSafetyFactor ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode nltl:fatigueLoadCase ;
                            sh:resultMessage "Value nltl:fatigueLoadCase not in list ['nltl:extremeOperationalLoadCase']" ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:InConstraintComponent ;
                            sh:sourceShape [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                                    sh:in ( nltl:extremeOperationalLoadCase ) ] ;
                            sh:value nltl:fatigueLoadCase ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P02/loadCase> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:shaftLineLoadCaseTypeValue ; sh:in ( nltl:extremeOperationalLoadCase ) ]. See details for more information." ;
                    sh:resultPath nltl:shaftLineLoadCaseType ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                                    sh:in ( nltl:extremeOperationalLoadCase ) ] ;
                            sh:path nltl:shaftLineLoadCaseType ] ;
                    sh:value nltl:fatigueLoadCase ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:loadCase ; sh:message Literal(\"An extreme operational load case shall have a unitless component yield safety factor of at least 1.3.\") ; sh:property [ sh:class qudt:QuantityValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.3\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:shaftLineLoadCaseTypeValue ; sh:in ( nltl:extremeOperationalLoadCase ) ] ; sh:path nltl:shaftLineLoadCaseType ] ]. See details for more information." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n927cf7e93402486fbd59c0ad1d67b21db5 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P02/loadCase> ] .

