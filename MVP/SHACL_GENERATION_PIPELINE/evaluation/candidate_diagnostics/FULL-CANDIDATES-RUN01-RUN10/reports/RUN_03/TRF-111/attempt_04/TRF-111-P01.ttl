@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P01/ship> ;
            sh:resultMessage "Each linked propeller shaft-line component must also be linked through hasComponent." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each linked propeller shaft-line component must also be linked through hasComponent." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this ?c
            WHERE {
                $this nltl:hasPropellerShaftLineComponent ?c .
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?c .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-111-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P01/ship> ;
            sh:resultMessage "The ship must provide exactly one extreme ice force in kN." ;
            sh:resultPath nltl:extremeIceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide exactly one extreme ice force in kN." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue qudt:KiloN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:extremeIceForce ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P01/loadCase> ;
                    sh:resultMessage "Node ex:loadCase must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:extremeOperationalLoadCase ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shaftLineLoadCaseType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.3\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ] ] , [ sh:property [ sh:hasValue nltl:fatigueLoadCase ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shaftLineLoadCaseType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.5\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ] ] , [ sh:property [ sh:hasValue nltl:bladeFailureLoadCase ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shaftLineLoadCaseType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCase ;
                            sh:or ( [ sh:property [ sh:hasValue nltl:extremeOperationalLoadCase ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class qudt:QuantityValue ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] [ sh:property [ sh:hasValue nltl:fatigueLoadCase ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class qudt:QuantityValue ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class qudt:QuantityValue ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:componentYieldSafetyFactor ],
                                            [ sh:hasValue nltl:bladeFailureLoadCase ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ] ] ) ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:shaftLineLoadCaseTypeValue ] ;
                                    sh:path nltl:shaftLineLoadCaseType ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P01/loadCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:loadCase ; sh:or ( [ sh:property [ sh:hasValue nltl:extremeOperationalLoadCase ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shaftLineLoadCaseType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.3\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ] ] [ sh:property [ sh:hasValue nltl:fatigueLoadCase ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shaftLineLoadCaseType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.5\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ] ] [ sh:property [ sh:hasValue nltl:bladeFailureLoadCase ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shaftLineLoadCaseType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ] ] ) ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:shaftLineLoadCaseTypeValue ] ; sh:path nltl:shaftLineLoadCaseType ] ]. See details for more information." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:loadCase ;
                            sh:or ( [ sh:property [ sh:hasValue nltl:extremeOperationalLoadCase ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] [ sh:property [ sh:hasValue nltl:fatigueLoadCase ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] [ sh:property [ sh:hasValue nltl:bladeFailureLoadCase ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] ) ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:shaftLineLoadCaseTypeValue ] ;
                                    sh:path nltl:shaftLineLoadCaseType ] ] ;
                    sh:path nltl:hasPropulsionLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P01/loadCase> ] .

