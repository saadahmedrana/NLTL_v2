@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/bendingYieldSafetyFactorValue> ;
                            sh:resultMessage "Value is not >= Literal(\"1.0\", datatype=xsd:decimal)" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
                                    sh:minInclusive 1.0 ;
                                    sh:path qudt:numericValue ] ;
                            sh:value 0.9 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/component> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ]. See details for more information." ;
                    sh:resultPath nltl:bendingYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:minCount 1 ;
                                            sh:minInclusive 1.0 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:bendingYieldSafetyFactor ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/bendingYieldSafetyFactorValue> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/torsionalYieldSafetyFactorValue> ;
                            sh:resultMessage "Value is not >= Literal(\"1.0\", datatype=xsd:decimal)" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
                                    sh:minInclusive 1.0 ;
                                    sh:path qudt:numericValue ] ;
                            sh:value 0.9 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/component> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ]. See details for more information." ;
                    sh:resultPath nltl:torsionalYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:minCount 1 ;
                                            sh:minInclusive 1.0 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:torsionalYieldSafetyFactor ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/torsionalYieldSafetyFactorValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:propellerShaftLineComponent ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:bendingYieldSafetyFactor ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:torsionalYieldSafetyFactor ] ]. See details for more information." ;
            sh:resultPath nltl:hasPropellerShaftLineComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:propellerShaftLineComponent ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:minCount 1 ;
                                                    sh:minInclusive 1.0 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:bendingYieldSafetyFactor ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:minCount 1 ;
                                                    sh:minInclusive 1.0 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:torsionalYieldSafetyFactor ] ] ;
                    sh:path nltl:hasPropellerShaftLineComponent ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/component> ] .

