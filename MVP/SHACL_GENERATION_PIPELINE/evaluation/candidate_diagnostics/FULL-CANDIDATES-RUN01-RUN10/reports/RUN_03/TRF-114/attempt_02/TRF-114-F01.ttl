@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F01/ship> ;
            sh:resultMessage "The ship must provide a typical ice operating speed in knots." ;
            sh:resultPath nltl:iceOperatingSpeed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide a typical ice operating speed in knots." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:iceOperatingSpeed ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F01/impact> ;
                    sh:resultMessage "The load case must reference TRAFICOM Table 6-3 for the design ice block." ;
                    sh:resultPath nltl:designIceBlockTableReference ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:traficomTable6Dash3Reference ) ;
                            sh:maxCount 1 ;
                            sh:message "The load case must reference TRAFICOM Table 6-3 for the design ice block." ;
                            sh:minCount 1 ;
                            sh:path nltl:designIceBlockTableReference ] ;
                    sh:value nltl:traficomTable6Dash16Reference ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F01/impact> ;
                    sh:resultMessage "The externally assessed thruster resistance capacity must be at least the thruster ice impact demand." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "The externally assessed thruster resistance capacity must be at least the thruster ice impact demand." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:thrusterImpactCaseAppliesToBody ?body .
                        ?body nltl:thrusterResistanceCapacity ?capacity .
                        ?capacity qudt:numericValue ?capacityValue .
                        $this nltl:thrusterIceImpactDemand ?demand .
                        ?demand qudt:numericValue ?demandValue .
                        FILTER (
                            xsd:decimal(?capacityValue) >=
                            xsd:decimal(?demandValue)
                        )
                    }
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gs:TRF114LoadCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F01/impact> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F01/thrusterBody> ;
                            sh:resultMessage "Less than 1 values on ex:thrusterBody->nltl:thrusterResistanceCapacity" ;
                            sh:resultPath nltl:thrusterResistanceCapacity ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thrusterResistanceCapacity ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F01/impact> ;
                    sh:resultMessage "The impact case must identify the thruster body and its resistance capacity." ;
                    sh:resultPath nltl:thrusterImpactCaseAppliesToBody ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:thrusterBody ;
                            sh:maxCount 1 ;
                            sh:message "The impact case must identify the thruster body and its resistance capacity." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:class qudt:QuantityValue ;
                                                    sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ],
                                                        [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ] ] ;
                                            sh:path nltl:thrusterResistanceCapacity ] ] ;
                            sh:path nltl:thrusterImpactCaseAppliesToBody ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F01/thrusterBody> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F01/ship> ;
            sh:resultMessage "The ship must provide an applicable thruster ice impact load case." ;
            sh:resultPath nltl:hasThrusterIceImpactLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide an applicable thruster ice impact load case." ;
                    sh:minCount 1 ;
                    sh:node gs:TRF114LoadCaseShape ;
                    sh:path nltl:hasThrusterIceImpactLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F01/impact> ] .

