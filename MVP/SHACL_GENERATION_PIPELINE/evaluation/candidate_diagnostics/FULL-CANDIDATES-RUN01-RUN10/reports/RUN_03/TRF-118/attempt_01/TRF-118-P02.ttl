@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-P02/component> ;
                            sh:resultMessage "Less than 1 values on ex:component->nltl:hasMaterialProperties" ;
                            sh:resultPath nltl:hasMaterialProperties ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:materialProperties ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:message "Material properties must provide component material yield strength in MPa." ;
                                                    sh:minCount 1 ;
                                                    sh:node gs:MegaPascalQuantityShape ;
                                                    sh:path nltl:componentMaterialYieldStrength ] ] ;
                                    sh:path nltl:hasMaterialProperties ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-P02/assessment> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:shipComponent ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:materialProperties ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Material properties must provide component material yield strength in MPa.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:MegaPascalQuantityShape ; sh:path nltl:componentMaterialYieldStrength ] ] ; sh:path nltl:hasMaterialProperties ] ]. See details for more information." ;
                    sh:resultPath nltl:assessedThrusterComponent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class nltl:shipComponent ;
                                    sh:property [ sh:minCount 1 ;
                                            sh:node [ sh:class nltl:materialProperties ;
                                                    sh:property [ sh:maxCount 1 ;
                                                            sh:message "Material properties must provide component material yield strength in MPa." ;
                                                            sh:minCount 1 ;
                                                            sh:node gs:MegaPascalQuantityShape ;
                                                            sh:path nltl:componentMaterialYieldStrength ] ] ;
                                            sh:path nltl:hasMaterialProperties ] ] ;
                            sh:path nltl:assessedThrusterComponent ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-P02/component> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:factoredExtremeLoadOperabilityAssessment ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each assessment must confirm that repair is not required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:assessmentRepairRequired ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each assessment must confirm that operability is maintained.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:assessmentOperabilityMaintained ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each assessment must provide an assessed factored extreme load in kN.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:KiloNewtonQuantityShape ; sh:path nltl:assessedFactoredExtremeLoad ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:shipComponent ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:materialProperties ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Material properties must provide component material yield strength in MPa.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:MegaPascalQuantityShape ; sh:path nltl:componentMaterialYieldStrength ] ] ; sh:path nltl:hasMaterialProperties ] ] ; sh:path nltl:assessedThrusterComponent ] ]. See details for more information." ;
            sh:resultPath nltl:hasFactoredExtremeLoadOperabilityAssessment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:factoredExtremeLoadOperabilityAssessment ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "Each assessment must confirm that operability is maintained." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:assessmentOperabilityMaintained ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue false ;
                                    sh:maxCount 1 ;
                                    sh:message "Each assessment must confirm that repair is not required." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:assessmentRepairRequired ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each assessment must provide an assessed factored extreme load in kN." ;
                                    sh:minCount 1 ;
                                    sh:node gs:KiloNewtonQuantityShape ;
                                    sh:path nltl:assessedFactoredExtremeLoad ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:shipComponent ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:hasMaterialProperties ] ] ;
                                    sh:path nltl:assessedThrusterComponent ] ] ;
                    sh:path nltl:hasFactoredExtremeLoadOperabilityAssessment ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-P02/assessment> ] .

