@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/loadCase> ;
                    sh:resultMessage "The occasional force load case must confirm that the propeller blade is excluded from its scope." ;
                    sh:resultPath nltl:propellerBladeExcludedFromOccasionalForceScope ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "The occasional force load case must confirm that the propeller blade is excluded from its scope." ;
                            sh:minCount 1 ;
                            sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/component> ;
                            sh:resultMessage "Each assessed component must provide its externally calculated occasional force stress." ;
                            sh:resultPath nltl:occasionalForceComponentStress ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each assessed component must provide its externally calculated occasional force stress." ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:TRF-123-StressQuantityShape> ;
                                    sh:path nltl:occasionalForceComponentStress ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/loadCase> ;
                    sh:resultMessage "The applicable occasional force load case must identify the assessed components." ;
                    sh:resultPath nltl:occasionalForceCaseAssessedComponent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "The applicable occasional force load case must identify the assessed components." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:TRF-123-AssessedComponentShape> ;
                            sh:path nltl:occasionalForceCaseAssessedComponent ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/component> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/loadCase> ;
                    sh:resultMessage "The occasional force load case must provide the externally calculated component yield safety factor." ;
                    sh:resultPath nltl:componentYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The occasional force load case must provide the externally calculated component yield safety factor." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:TRF-123-SafetyFactorQuantityShape> ;
                            sh:path nltl:componentYieldSafetyFactor ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF-123-OccasionalForceLoadCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasOccasionalForceLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:TRF-123-OccasionalForceLoadCaseShape> ;
                    sh:path nltl:hasOccasionalForceLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/loadCase> ] .

