@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/component> ;
                            sh:resultMessage "Each assessed component must provide its externally calculated occasional-force stress." ;
                            sh:resultPath nltl:occasionalForceComponentStress ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each assessed component must provide its externally calculated occasional-force stress." ;
                                    sh:minCount 1 ;
                                    sh:node gen:TRF123MPaQuantityShape ;
                                    sh:path nltl:occasionalForceComponentStress ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/loadCase> ;
                    sh:resultMessage "The occasional-force analysis case must identify each assessed component." ;
                    sh:resultPath nltl:occasionalForceCaseAssessedComponent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "The occasional-force analysis case must identify each assessed component." ;
                            sh:minCount 1 ;
                            sh:node gen:TRF123ShipComponentShape ;
                            sh:path nltl:occasionalForceCaseAssessedComponent ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/component> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/loadCase> ;
                    sh:resultMessage "The occasional-force analysis case must provide the externally calculated component yield safety factor." ;
                    sh:resultPath nltl:componentYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The occasional-force analysis case must provide the externally calculated component yield safety factor." ;
                            sh:minCount 1 ;
                            sh:node gen:TRF123UnitlessQuantityShape ;
                            sh:path nltl:componentYieldSafetyFactor ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/ship> ;
            sh:resultMessage "The ship must provide an occasional-force analysis case for readiness verification." ;
            sh:resultPath nltl:hasOccasionalForceLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide an occasional-force analysis case for readiness verification." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF123OccasionalForceLoadCaseShape ;
                    sh:path nltl:hasOccasionalForceLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/loadCase> ] .

