@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/component> ;
                            sh:resultMessage "Each assessed component must provide its externally calculated occasional-force stress." ;
                            sh:resultPath nltl:occasionalForceComponentStress ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each assessed component must provide its externally calculated occasional-force stress." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:occasionalForceComponentStress ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/loadCase> ;
                    sh:resultMessage "Each occasional-force load case must identify its assessed component." ;
                    sh:resultPath nltl:occasionalForceCaseAssessedComponent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Each occasional-force load case must identify its assessed component." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:shipComponent ;
                                    sh:property [ sh:message "Each occasional-force case must identify the material properties of its assessed component." ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:class nltl:materialProperties ;
                                                    sh:property [ sh:maxCount 1 ;
                                                            sh:message "Each assessed component must provide the yield strength of its material." ;
                                                            sh:minCount 1 ;
                                                            sh:node [ ] ;
                                                            sh:path nltl:componentMaterialYieldStrength ] ] ;
                                            sh:path nltl:hasMaterialProperties ],
                                        [ sh:maxCount 1 ;
                                            sh:message "Each assessed component must provide its externally calculated occasional-force stress." ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:class qudt:QuantityValue ;
                                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ],
                                                        [ sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:occasionalForceComponentStress ] ] ;
                            sh:path nltl:occasionalForceCaseAssessedComponent ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/component> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/loadCase> ;
                    sh:resultMessage "The occasional-force load case must record that the propeller blade is excluded from scope." ;
                    sh:resultPath nltl:propellerBladeExcludedFromOccasionalForceScope ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "The occasional-force load case must record that the propeller blade is excluded from scope." ;
                            sh:minCount 1 ;
                            sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/loadCase> ;
                    sh:resultMessage "The externally calculated occasional-force stress, material yield strength, and yield safety factor must be connected on the same load case and assessed component for the required direct check." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "The externally calculated occasional-force stress, material yield strength, and yield safety factor must be connected on the same load case and assessed component for the required direct check." ;
                            sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:occasionalForceCaseAssessedComponent ?component .
                            ?component nltl:occasionalForceComponentStress ?stressQuantity ;
                                       nltl:hasMaterialProperties ?materialProperties .
                            ?materialProperties nltl:componentMaterialYieldStrength ?yieldQuantity .
                            $this nltl:componentYieldSafetyFactor ?factorQuantity .

                            ?stressQuantity qudt:numericValue ?stressValue ;
                                             qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                            ?yieldQuantity qudt:numericValue ?yieldValue ;
                                            qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                            ?factorQuantity qudt:numericValue ?factorValue ;
                                             qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        }
                    }
                """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:occasionalForceLoadCase ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The occasional-force load case must record that the propeller blade is excluded from scope." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ],
                                [ sh:maxCount 1 ;
                                    sh:message "The occasional-force load case must provide the externally calculated component yield safety factor." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:componentYieldSafetyFactor ],
                                [ sh:message "Each occasional-force load case must identify its assessed component." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:shipComponent ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:message "Each assessed component must provide its externally calculated occasional-force stress." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ sh:class qudt:QuantityValue ;
                                                            sh:property [ ],
                                                                [ ] ] ;
                                                    sh:path nltl:occasionalForceComponentStress ],
                                                [ sh:message "Each occasional-force case must identify the material properties of its assessed component." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ sh:class nltl:materialProperties ;
                                                            sh:property [ ] ] ;
                                                    sh:path nltl:hasMaterialProperties ] ] ;
                                    sh:path nltl:occasionalForceCaseAssessedComponent ] ;
                            sh:sparql [ sh:message "The externally calculated occasional-force stress, material yield strength, and yield safety factor must be connected on the same load case and assessed component for the required direct check." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:occasionalForceCaseAssessedComponent ?component .
                            ?component nltl:occasionalForceComponentStress ?stressQuantity ;
                                       nltl:hasMaterialProperties ?materialProperties .
                            ?materialProperties nltl:componentMaterialYieldStrength ?yieldQuantity .
                            $this nltl:componentYieldSafetyFactor ?factorQuantity .

                            ?stressQuantity qudt:numericValue ?stressValue ;
                                             qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                            ?yieldQuantity qudt:numericValue ?yieldValue ;
                                            qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                            ?factorQuantity qudt:numericValue ?factorValue ;
                                             qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        }
                    }
                """ ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/loadCase> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/loadCase> ;
                    sh:resultMessage "The occasional-force load case must provide the externally calculated component yield safety factor." ;
                    sh:resultPath nltl:componentYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The occasional-force load case must provide the externally calculated component yield safety factor." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:componentYieldSafetyFactor ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/ship> ;
            sh:resultMessage "Each represented occasional-force load case must be ready for the externally performed component stress direct check." ;
            sh:resultPath nltl:hasOccasionalForceLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each represented occasional-force load case must be ready for the externally performed component stress direct check." ;
                    sh:node [ sh:class nltl:occasionalForceLoadCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "The occasional-force load case must provide the externally calculated component yield safety factor." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:componentYieldSafetyFactor ],
                                [ sh:message "Each occasional-force load case must identify its assessed component." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:shipComponent ;
                                            sh:property [ sh:message "Each occasional-force case must identify the material properties of its assessed component." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:hasMaterialProperties ],
                                                [ sh:maxCount 1 ;
                                                    sh:message "Each assessed component must provide its externally calculated occasional-force stress." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:occasionalForceComponentStress ] ] ;
                                    sh:path nltl:occasionalForceCaseAssessedComponent ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The occasional-force load case must record that the propeller blade is excluded from scope." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ] ;
                            sh:sparql [ sh:message "The externally calculated occasional-force stress, material yield strength, and yield safety factor must be connected on the same load case and assessed component for the required direct check." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:occasionalForceCaseAssessedComponent ?component .
                            ?component nltl:occasionalForceComponentStress ?stressQuantity ;
                                       nltl:hasMaterialProperties ?materialProperties .
                            ?materialProperties nltl:componentMaterialYieldStrength ?yieldQuantity .
                            $this nltl:componentYieldSafetyFactor ?factorQuantity .

                            ?stressQuantity qudt:numericValue ?stressValue ;
                                             qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                            ?yieldQuantity qudt:numericValue ?yieldValue ;
                                            qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                            ?factorQuantity qudt:numericValue ?factorValue ;
                                             qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        }
                    }
                """ ] ] ;
                    sh:path nltl:hasOccasionalForceLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/loadCase> ] .

