@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F01/ship> ;
            sh:resultMessage "When the air receiver serves an additional purpose, its capacity must be at least the required additional-purpose air capacity." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the air receiver serves an additional purpose, its capacity must be at least the required additional-purpose air capacity." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:airReceiverServesAdditionalPurpose true .
                $this nltl:airReceiverCapacity ?capacityNode .
                ?capacityNode qudt:numericValue ?capacityValue .
                ?capacityNode qudt:unit unit:M3 .
                $this nltl:additionalPurposeRequiredAirCapacity ?requiredNode .
                ?requiredNode qudt:numericValue ?requiredValue .
                FILTER ( ?capacityValue < ?requiredValue )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF127Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F01/ship> ] .

