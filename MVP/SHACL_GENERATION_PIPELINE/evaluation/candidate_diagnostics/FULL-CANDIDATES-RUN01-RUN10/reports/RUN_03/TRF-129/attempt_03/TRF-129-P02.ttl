@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-129-P02/ship> ;
            sh:resultMessage "The ship must either provide an applicable ice navigation condition with navigatingInIce true and secured cooling water supply, or indicate that it is not navigating in ice without an ice navigation condition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_129_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-129-P02/ship> ] .

