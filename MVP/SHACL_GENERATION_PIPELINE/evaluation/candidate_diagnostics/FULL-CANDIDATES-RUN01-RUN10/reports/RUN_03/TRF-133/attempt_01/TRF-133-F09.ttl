@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F09/ship> ;
            sh:resultMessage "The ship must have one permitted Finnish-Swedish ice-class value." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceClassValue ;
                    sh:in ( nltl:iceClassIa nltl:iceClassIaSuper nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship must have one permitted Finnish-Swedish ice-class value." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:iceClass ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F09/draughtMarkAftOffsetValue> ;
                            sh:resultMessage "Value is not >= Literal(\"540\", datatype=xsd:decimal)" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 540.0 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 540.0 ;
                                    sh:path qudt:numericValue ] ;
                            sh:value 500.0 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F09/iceMark> ;
                    sh:resultMessage "The ice-class draught mark must be 540 mm abaft of the applicable reference." ;
                    sh:resultPath nltl:draughtMarkAftOffset ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The ice-class draught mark must be 540 mm abaft of the applicable reference." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue unit:MilliM ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:maxInclusive 540.0 ;
                                            sh:minCount 1 ;
                                            sh:minInclusive 540.0 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:draughtMarkAftOffset ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F09/draughtMarkAftOffsetValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F09/ship> ;
            sh:resultMessage "The ship must have a conforming ice-class draught marking." ;
            sh:resultPath nltl:hasIceClassDraughtMarking ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must have a conforming ice-class draught marking." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF133IceClassDraughtMarkingShape ;
                    sh:path nltl:hasIceClassDraughtMarking ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F09/iceMark> ] .

