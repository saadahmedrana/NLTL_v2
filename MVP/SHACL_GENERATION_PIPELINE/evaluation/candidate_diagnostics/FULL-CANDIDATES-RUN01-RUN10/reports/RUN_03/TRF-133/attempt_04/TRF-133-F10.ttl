@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F10/ship> ;
            sh:resultMessage "The ship must declare one permitted Finnish-Swedish ice-class value." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship must declare one permitted Finnish-Swedish ice-class value." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:iceClass ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F10/ship> ;
            sh:resultMessage "The timber load line selector and corresponding draught-mark reference must conform to the applicable branch." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-133-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F10/ship> ] .

