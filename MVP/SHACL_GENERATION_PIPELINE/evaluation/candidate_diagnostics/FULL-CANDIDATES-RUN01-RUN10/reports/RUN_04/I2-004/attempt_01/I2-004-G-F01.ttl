@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The ship displacement must equal the greatest displacement among its upper ice waterline cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ship displacement must equal the greatest displacement among its upper ice waterline cases." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:upperIceWaterlineDisplacement ?duiQuantity .
  ?duiQuantity qudt:numericValue ?duiValue .
  FILTER NOT EXISTS {
    $this nltl:hasUpperIceWaterlineCase ?case .
    ?case nltl:waterlineCaseDisplacement ?caseQuantity .
    ?caseQuantity qudt:numericValue ?caseValue .
    FILTER NOT EXISTS {
      $this nltl:hasUpperIceWaterlineCase ?higherCase .
      ?higherCase nltl:waterlineCaseDisplacement ?higherQuantity .
      ?higherQuantity qudt:numericValue ?higherValue .
      FILTER (?higherValue > ?caseValue)
    }
    FILTER (?caseValue = ?duiValue)
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-004-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

