@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-P01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The ship's astern ice operation intent must be recorded as true when the aft section design basis is subject to the specified hull area requirements.\") ; sh:path nltl:asternIceOperationIntent ], [ sh:datatype xsd:string ; sh:hasValue Literal(\"Bow and Bow Intermediate hull area requirements\") ; sh:message Literal(\"For astern ice operation, the aft section must use the Bow and Bow Intermediate hull area requirements as its design basis.\") ; sh:path nltl:aftSectionDesignBasis ], [ sh:datatype xsd:string ; sh:hasValue Literal(\"Bow and Bow Intermediate hull area requirements\") ; sh:message Literal(\"For astern ice operation, the applicable hull area requirement set must be the Bow and Bow Intermediate hull area requirements.\") ; sh:path nltl:hullAreaRequirementSet ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:asternIceOperationIntent ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:I2_006_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-P01/ship> ] .

