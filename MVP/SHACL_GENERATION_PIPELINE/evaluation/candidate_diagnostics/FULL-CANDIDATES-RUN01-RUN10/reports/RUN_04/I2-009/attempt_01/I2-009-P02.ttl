@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-P02/ship> ;
            sh:resultMessage "The ship shall record its hull area." ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship shall record its hull area." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-P02/ship> ;
            sh:resultMessage "Average ice pressure shall be provided as a quantity in MPa." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Average ice pressure shall be provided as a quantity in MPa." ;
                    sh:minCount 1 ;
                    sh:node gen:PressureQuantityShape ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-P02/ship> ;
            sh:resultMessage "The fixed load patch aspect ratio shall be provided as a dimensionless quantity." ;
            sh:resultPath nltl:loadPatchAspectRatio ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The fixed load patch aspect ratio shall be provided as a dimensionless quantity." ;
                    sh:minCount 1 ;
                    sh:node gen:AspectRatioQuantityShape ;
                    sh:path nltl:loadPatchAspectRatio ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-P02/ship> ;
            sh:resultMessage "The non-bow load patch length shall be provided as a quantity in metres." ;
            sh:resultPath nltl:nonBowLoadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The non-bow load patch length shall be provided as a quantity in metres." ;
                    sh:minCount 1 ;
                    sh:node gen:LengthQuantityShape ;
                    sh:path nltl:nonBowLoadPatchLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-P02/ship> ;
            sh:resultMessage "The non-bow load patch height shall be provided as a quantity in metres." ;
            sh:resultPath nltl:nonBowLoadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The non-bow load patch height shall be provided as a quantity in metres." ;
                    sh:minCount 1 ;
                    sh:node gen:LengthQuantityShape ;
                    sh:path nltl:nonBowLoadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-P02/ship> ;
            sh:resultMessage "A hull area assignment for the other ice-strengthened area is required." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A hull area assignment for the other ice-strengthened area is required." ;
                    sh:minCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:class nltl:hullAreaAssignment ;
                            sh:property [ sh:hasValue nltl:otherIceStrengthenedArea ;
                                    sh:maxCount 1 ;
                                    sh:message "The hull area assignment shall identify the other ice-strengthened area." ;
                                    sh:minCount 1 ;
                                    sh:node [ a sh:NodeShape ;
                                            sh:class nltl:hullAreaValue ] ;
                                    sh:path nltl:assignedHullArea ] ] ;
                    sh:path nltl:hasHullAreaAssignment ] ] .

