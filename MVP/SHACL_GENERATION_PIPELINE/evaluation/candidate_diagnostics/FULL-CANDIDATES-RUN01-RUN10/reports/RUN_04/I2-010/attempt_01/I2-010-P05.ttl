@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-P05/ship> ;
            sh:resultMessage "The design ice force calculation method must be recorded." ;
            sh:resultPath nltl:bowDesignForceMethod ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The design ice force calculation method must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:bowDesignForceMethod ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-P05/ship> ;
            sh:resultMessage "The ship must have a bow form with vertical sides." ;
            sh:resultPath nltl:verticalSidedBowForm ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The ship must have a bow form with vertical sides." ;
                    sh:minCount 1 ;
                    sh:path nltl:verticalSidedBowForm ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-P05/ship> ;
            sh:resultMessage "The bow vertical-side status must be true." ;
            sh:resultPath nltl:bowVerticalSideStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The bow vertical-side status must be true." ;
                    sh:minCount 1 ;
                    sh:path nltl:bowVerticalSideStatus ] ] .

