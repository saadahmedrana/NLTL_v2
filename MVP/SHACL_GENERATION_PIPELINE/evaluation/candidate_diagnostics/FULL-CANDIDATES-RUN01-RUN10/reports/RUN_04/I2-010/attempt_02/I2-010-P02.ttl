@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-P02/ship> ;
            sh:resultMessage "For a ship assigned PC6 or PC7 with a vertical-sided bow, every represented normal frame angle must be a decimal quantity in the inclusive range 0 to 10 degrees." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a ship assigned PC6 or PC7 with a vertical-sided bow, every represented normal frame angle must be a decimal quantity in the inclusive range 0 to 10 degrees." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:polarClass ?pc .
                FILTER (
                    ?pc IN (
                        nltl:polarClassPc6,
                        nltl:polarClassPc7
                    )
                )
                $this nltl:verticalSidedBowForm ?vertical .
                FILTER (?vertical = true)
                $this nltl:normalFrameAngle ?angle .
                FILTER (
                    NOT EXISTS {
                        ?angle qudt:numericValue ?missingValue
                    }
                    ||
                    EXISTS {
                        ?angle qudt:numericValue ?nonDecimalValue .
                        FILTER (datatype(?nonDecimalValue) != xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?angle qudt:numericValue ?numericValue .
                        FILTER (
                            datatype(?numericValue) = xsd:decimal &&
                            (
                                ?numericValue < 0 ||
                                ?numericValue > 10
                            )
                        )
                    }
                    ||
                    NOT EXISTS {
                        ?angle qudt:unit qudt:DEG
                    }
                    ||
                    EXISTS {
                        ?angle qudt:unit ?wrongUnit .
                        FILTER (?wrongUnit != qudt:DEG)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-010> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-P02/ship> ] .

