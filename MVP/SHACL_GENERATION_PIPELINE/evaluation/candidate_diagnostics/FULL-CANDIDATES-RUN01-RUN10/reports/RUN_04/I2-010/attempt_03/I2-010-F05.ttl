@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The applicable ship must have a bow form with vertical sides.\") ; sh:path nltl:verticalSidedBowForm ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The applicable ship must record a vertical-sided bow status.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bowVerticalSideStatus ], [ sh:datatype xsd:string ; sh:message Literal(\"The applicable ship must identify the design ice force method.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bowDesignForceMethod ], [ sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ; sh:message Literal(\"The applicable ship must have Polar Class PC6 or PC7.\") ; sh:path nltl:polarClass ], [ sh:message Literal(\"Every represented considered-sub-region normal frame angle must be between 0 and 10 degrees inclusive.\") ; sh:node gen:I2_010_NormalFrameAngleShape ; sh:path nltl:normalFrameAngle ] ] , [ sh:property [ sh:in ( nltl:polarClassPc1 nltl:polarClassPc2 nltl:polarClassPc3 nltl:polarClassPc4 nltl:polarClassPc5 ) ; sh:message Literal(\"A ship outside the PC6 or PC7 applicability scope must have a Polar Class other than PC6 or PC7.\") ; sh:path nltl:polarClass ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"A ship outside the vertical-sided-bow applicability scope must record a non-vertical-sided bow form.\") ; sh:path nltl:verticalSidedBowForm ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_010_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F05/ship> ] .

