@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F05/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:bulbousBowPresent ], [ sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ; sh:path nltl:polarClass ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The bow design force is required in kN for the applicable case.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:KiloN ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:bowDesignForce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The part-III bow design force is required in MN for the applicable case.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:MegaN ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The part-IV bow design force is required in MN for the applicable case.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:MegaN ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("loadPatchAspectRatio must be exactly 1.3 and dimensionless for the applicable case.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("1.3", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("1.3", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:loadPatchAspectRatio ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("shapeCoefficient must be exactly 0.6 and dimensionless for the applicable case.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("0.6", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("0.6", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:shapeCoefficient ] ; sh:sparql [ sh:message Literal("For PC6 or PC7 ships with bulbous bows, bowDesignForce must equal the part-IV force within tolerance and must not be less than the part-III force.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiNode ;
                              nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivNode ;
                              nltl:bowDesignForce ?resultNode .
                        ?iiiNode qudt:numericValue ?iii .
                        ?ivNode qudt:numericValue ?iv .
                        ?resultNode qudt:numericValue ?reported .
                        BIND((?iv * 1000) AS ?expected)
                        BIND((?iii * 1000) AS ?lower)
                        BIND((?reported - ?expected) AS ?rawDelta)
                        BIND(IF(?rawDelta >= 0, ?rawDelta, 0 - ?rawDelta) AS ?delta)
                        BIND(IF(?expected >= 0, ?expected, 0 - ?expected) AS ?scale)
                        BIND(
                            IF(
                                (?scale * 0.000001) > 0.000001,
                                (?scale * 0.000001),
                                0.000001
                            )
                            AS ?tolerance
                        )
                        FILTER(
                            (?delta > ?tolerance) ||
                            (?reported < ?lower)
                        )
                    }
                ") ] ] , [ sh:or ( [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:bulbousBowPresent ] ] [ sh:property [ sh:in ( nltl:polarClassPc1 nltl:polarClassPc2 nltl:polarClassPc3 nltl:polarClassPc4 nltl:polarClassPc5 ) ; sh:path nltl:polarClass ] ] ) ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_011_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F05/ship> ] .

