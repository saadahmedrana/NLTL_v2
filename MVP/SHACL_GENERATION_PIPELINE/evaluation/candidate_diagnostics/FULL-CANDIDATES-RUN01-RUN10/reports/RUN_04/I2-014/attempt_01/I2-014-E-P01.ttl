_:n3f1d5a55d53944d3b222cae4b48a1ae9b17 sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node gen:LineLoadQuantityShape ;
    sh:path nltl:glancingImpactLineLoad .

_:n3f1d5a55d53944d3b222cae4b48a1ae9b18 sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node gen:PressureQuantityShape ;
    sh:path nltl:glancingImpactPressure .

_:n3f1d5a55d53944d3b222cae4b48a1ae9b21 sh:maxCount 4 ;
    sh:message "The ship must provide exactly four bow subregion calculation cases." ;
    sh:minCount 4 ;
    sh:node gen:CaseShape ;
    sh:path nltl:hasBowSubregionCalculationCase .

