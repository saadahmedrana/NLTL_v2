@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowLength" ;
            sh:resultPath nltl:bowLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:bowLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowSubregionCount" ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:maxInclusive 4 ;
                    sh:minCount 1 ;
                    sh:minInclusive 4 ;
                    sh:path nltl:bowSubregionCount ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "Each selected maximum bow value must equal the maximum of the four reported case values within a 1e-6 relative tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each selected maximum bow value must equal the maximum of the four reported case values within a 1e-6 relative tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?sfq ;
                      nltl:selectedMaximumBowLineLoad ?slq ;
                      nltl:selectedMaximumBowPressure ?spq .
                ?sfq qudt:numericValue ?sf .
                ?slq qudt:numericValue ?sl .
                ?spq qudt:numericValue ?sp .

                {
                    SELECT (MAX(?fv) AS ?maxF)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?fc .
                        ?fc nltl:bowSubregionCalculatedForce ?fq .
                        ?fq qudt:numericValue ?fv .
                    }
                }
                {
                    SELECT (MAX(?lv) AS ?maxL)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?lc .
                        ?lc nltl:bowSubregionCalculatedLineLoad ?lq .
                        ?lq qudt:numericValue ?lv .
                    }
                }
                {
                    SELECT (MAX(?pv) AS ?maxP)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?pc .
                        ?pc nltl:bowSubregionCalculatedPressure ?pq .
                        ?pq qudt:numericValue ?pv .
                    }
                }

                FILTER (
                    ABS(?sf - ?maxF) >
                    IF(ABS(?maxF) > 0, 0.000001 * ABS(?maxF), 0.000001)
                    ||
                    ABS(?sl - ?maxL) >
                    IF(ABS(?maxL) > 0, 0.000001 * ABS(?maxL), 0.000001)
                    ||
                    ABS(?sp - ?maxP) >
                    IF(ABS(?maxP) > 0, 0.000001 * ABS(?maxP), 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_014_BowSubregionShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ] .

