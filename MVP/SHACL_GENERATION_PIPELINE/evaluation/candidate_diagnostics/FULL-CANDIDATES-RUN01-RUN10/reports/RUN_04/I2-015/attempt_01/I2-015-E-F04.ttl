@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F04/bowCase> ;
                    sh:resultMessage "An applicable bow subregion calculation case requires all declared formula inputs, the failure-factor lookup relationship, and the externally calculated bow shape coefficient with the canonical units and datatypes." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "An applicable bow subregion calculation case requires all declared formula inputs, the failure-factor lookup relationship, and the externally calculated bow shape coefficient with the canonical units and datatypes." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowFormApplicabilityClassification
                    nltl:i231vBowFormApplicability .

                OPTIONAL {
                    $this nltl:bowSubregionMidLengthPosition ?xQuantity .
                    ?xQuantity qudt:numericValue ?xValue ;
                        qudt:unit qudt:M .
                    FILTER (datatype(?xValue) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:bowSubregionWaterlineAngle ?alphaQuantity .
                    ?alphaQuantity qudt:numericValue ?alphaValue ;
                        qudt:unit qudt:DEG .
                    FILTER (datatype(?alphaValue) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:betaIPrime ?betaQuantity .
                    ?betaQuantity qudt:numericValue ?betaValue ;
                        qudt:unit qudt:UNITLESS .
                    FILTER (datatype(?betaValue) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:hasFailureClassFactorLookupCase ?lookup .
                    ?lookup a nltl:tableLookupCase ;
                        nltl:flexuralFailureClassFactor ?flexuralQuantity ;
                        nltl:crushingFailureClassFactor ?crushingQuantity .
                    ?flexuralQuantity qudt:numericValue ?flexuralValue ;
                        qudt:unit qudt:UNITLESS .
                    ?crushingQuantity qudt:numericValue ?crushingValue ;
                        qudt:unit qudt:UNITLESS .
                    FILTER (datatype(?flexuralValue) = xsd:decimal)
                    FILTER (datatype(?crushingValue) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:bowShapeCoefficient ?resultQuantity .
                    ?resultQuantity qudt:numericValue ?resultValue ;
                        qudt:unit qudt:UNITLESS .
                    FILTER (datatype(?resultValue) = xsd:decimal)
                }

                FILTER (
                    !BOUND(?xQuantity) ||
                    !BOUND(?xValue) ||
                    !BOUND(?alphaQuantity) ||
                    !BOUND(?alphaValue) ||
                    !BOUND(?betaQuantity) ||
                    !BOUND(?betaValue) ||
                    !BOUND(?lookup) ||
                    !BOUND(?flexuralQuantity) ||
                    !BOUND(?flexuralValue) ||
                    !BOUND(?crushingQuantity) ||
                    !BOUND(?crushingValue) ||
                    !BOUND(?resultQuantity) ||
                    !BOUND(?resultValue)
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-015-BowCaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F04/bowCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-015-BowCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-015-BowCaseShape> ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F04/bowCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F04/ship> ;
            sh:resultMessage "An applicable bow subregion calculation case requires a valid upper ice waterline length L_UI on the ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "An applicable bow subregion calculation case requires a valid upper ice waterline length L_UI on the ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowFormApplicabilityClassification
                    nltl:i231vBowFormApplicability .
                OPTIONAL {
                    $this nltl:upperIceWaterlineLengthLUI ?lengthQuantity .
                    ?lengthQuantity qudt:numericValue ?lengthValue ;
                        qudt:unit qudt:M .
                    FILTER (datatype(?lengthValue) = xsd:decimal)
                }
                FILTER (!BOUND(?lengthQuantity) || !BOUND(?lengthValue))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-015-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F04/ship> ] .

