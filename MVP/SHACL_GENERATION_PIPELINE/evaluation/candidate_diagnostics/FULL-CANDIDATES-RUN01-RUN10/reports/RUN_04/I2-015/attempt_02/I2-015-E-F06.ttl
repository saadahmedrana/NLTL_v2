@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/factorLookup> ;
                            sh:resultMessage "The failure-factor lookup case must provide the crushing failure class factor." ;
                            sh:resultPath nltl:crushingFailureClassFactor ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "The failure-factor lookup case must provide the crushing failure class factor." ;
                                    sh:minCount 1 ;
                                    sh:node gen:I2_015_DimensionlessQuantityShape ;
                                    sh:path nltl:crushingFailureClassFactor ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/bowCase> ;
                    sh:resultMessage "Each applicable bow subregion calculation case must reference a failure-factor lookup case." ;
                    sh:resultPath nltl:hasFailureClassFactorLookupCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each applicable bow subregion calculation case must reference a failure-factor lookup case." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:tableLookupCase ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:message "The failure-factor lookup case must provide the crushing failure class factor." ;
                                            sh:minCount 1 ;
                                            sh:node gen:I2_015_DimensionlessQuantityShape ;
                                            sh:path nltl:crushingFailureClassFactor ],
                                        [ sh:maxCount 1 ;
                                            sh:message "The failure-factor lookup case must provide the flexural failure class factor." ;
                                            sh:minCount 1 ;
                                            sh:node gen:I2_015_DimensionlessQuantityShape ;
                                            sh:path nltl:flexuralFailureClassFactor ] ] ;
                            sh:path nltl:hasFailureClassFactorLookupCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/factorLookup> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/bowCase> ;
                    sh:resultMessage "The ship associated with each applicable case must provide beta i prime." ;
                    sh:resultPath ( [ sh:inversePath nltl:hasBowSubregionCalculationCase ] nltl:betaIPrime ) ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The ship associated with each applicable case must provide beta i prime." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_015_DimensionlessQuantityShape ;
                            sh:path ( [ sh:inversePath nltl:hasBowSubregionCalculationCase ] nltl:betaIPrime ) ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:bowSubregionCalculationCase ; sh:property [ sh:class nltl:bowFormApplicabilityValue ; sh:hasValue nltl:i231vBowFormApplicability ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each bow subregion calculation case must identify the I2.3.1(v) bow-form applicability.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bowFormApplicabilityClassification ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each applicable bow subregion calculation case must provide its mid-length position.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_015_LengthQuantityShape ; sh:path nltl:bowSubregionMidLengthPosition ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each applicable bow subregion calculation case must provide its waterline angle.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_015_AngleQuantityShape ; sh:path nltl:bowSubregionWaterlineAngle ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each applicable bow subregion calculation case must provide the externally computed bow shape coefficient.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_015_DimensionlessQuantityShape ; sh:path nltl:bowShapeCoefficient ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each applicable bow subregion calculation case must reference a failure-factor lookup case.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:tableLookupCase ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The failure-factor lookup case must provide the crushing failure class factor.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_015_DimensionlessQuantityShape ; sh:path nltl:crushingFailureClassFactor ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The failure-factor lookup case must provide the flexural failure class factor.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_015_DimensionlessQuantityShape ; sh:path nltl:flexuralFailureClassFactor ] ] ; sh:path nltl:hasFailureClassFactorLookupCase ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship associated with each applicable case must provide beta i prime.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_015_DimensionlessQuantityShape ; sh:path ( [ sh:inversePath nltl:hasBowSubregionCalculationCase ] nltl:betaIPrime ) ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship associated with each applicable case must provide the upper ice waterline length.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_015_LengthQuantityShape ; sh:path ( [ sh:inversePath nltl:hasBowSubregionCalculationCase ] nltl:upperIceWaterlineLengthLUI ) ] ]. See details for more information." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:bowSubregionCalculationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "The ship associated with each applicable case must provide beta i prime." ;
                                    sh:minCount 1 ;
                                    sh:node gen:I2_015_DimensionlessQuantityShape ;
                                    sh:path ( [ sh:inversePath nltl:hasBowSubregionCalculationCase ] nltl:betaIPrime ) ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each applicable bow subregion calculation case must reference a failure-factor lookup case." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:tableLookupCase ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:message "The failure-factor lookup case must provide the flexural failure class factor." ;
                                                    sh:minCount 1 ;
                                                    sh:node gen:I2_015_DimensionlessQuantityShape ;
                                                    sh:path nltl:flexuralFailureClassFactor ],
                                                [ sh:maxCount 1 ;
                                                    sh:message "The failure-factor lookup case must provide the crushing failure class factor." ;
                                                    sh:minCount 1 ;
                                                    sh:node gen:I2_015_DimensionlessQuantityShape ;
                                                    sh:path nltl:crushingFailureClassFactor ] ] ;
                                    sh:path nltl:hasFailureClassFactorLookupCase ],
                                [ sh:class nltl:bowFormApplicabilityValue ;
                                    sh:hasValue nltl:i231vBowFormApplicability ;
                                    sh:maxCount 1 ;
                                    sh:message "Each bow subregion calculation case must identify the I2.3.1(v) bow-form applicability." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:bowFormApplicabilityClassification ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each applicable bow subregion calculation case must provide its waterline angle." ;
                                    sh:minCount 1 ;
                                    sh:node gen:I2_015_AngleQuantityShape ;
                                    sh:path nltl:bowSubregionWaterlineAngle ],
                                [ sh:maxCount 1 ;
                                    sh:message "The ship associated with each applicable case must provide the upper ice waterline length." ;
                                    sh:minCount 1 ;
                                    sh:node gen:I2_015_LengthQuantityShape ;
                                    sh:path ( [ sh:inversePath nltl:hasBowSubregionCalculationCase ] nltl:upperIceWaterlineLengthLUI ) ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each applicable bow subregion calculation case must provide the externally computed bow shape coefficient." ;
                                    sh:minCount 1 ;
                                    sh:node gen:I2_015_DimensionlessQuantityShape ;
                                    sh:path nltl:bowShapeCoefficient ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each applicable bow subregion calculation case must provide its mid-length position." ;
                                    sh:minCount 1 ;
                                    sh:node gen:I2_015_LengthQuantityShape ;
                                    sh:path nltl:bowSubregionMidLengthPosition ] ] ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/bowCase> ] .

