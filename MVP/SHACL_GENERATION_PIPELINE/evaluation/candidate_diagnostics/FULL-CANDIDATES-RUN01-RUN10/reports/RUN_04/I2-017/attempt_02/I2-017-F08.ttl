@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-017-F08/ship> ;
            sh:resultMessage "The ship must provide a non-bow ice-load calculation case." ;
            sh:resultPath nltl:hasNonBowIceLoadCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a non-bow ice-load calculation case." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:nonBowIceLoadCalculationCase ] ;
                    sh:path nltl:hasNonBowIceLoadCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-017-F08/ship> ;
            sh:resultMessage "The ship must provide a table lookup case for the required calculation inputs." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a table lookup case for the required calculation inputs." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:tableLookupCase ] ;
                    sh:path nltl:hasTableLookupCase ] ] .

