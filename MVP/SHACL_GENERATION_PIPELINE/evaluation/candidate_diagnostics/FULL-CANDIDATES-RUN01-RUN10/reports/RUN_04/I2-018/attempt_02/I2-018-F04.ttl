@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F04/lookup> ;
            sh:resultMessage "The peak pressure lookup case must identify a permitted localized structural-member category." ;
            sh:resultPath nltl:localizedStructuralMemberCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMemberCategoryValue ;
                    sh:in ( nltl:bottomStructureFrameCategory nltl:longitudinallyFramedPlatingCategory nltl:stringerSideLongitudinalOrWebFrameCategory nltl:transverseFrameWithLoadDistributingStringersCategory nltl:transverseFrameWithoutLoadDistributingStringersCategory nltl:transverselyFramedPlatingCategory ) ;
                    sh:message "The peak pressure lookup case must identify a permitted localized structural-member category." ;
                    sh:minCount 1 ;
                    sh:path nltl:localizedStructuralMemberCategory ] ] .

