@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/lookup> ;
            sh:resultMessage "The table lookup case must provide evidence for the table selection." ;
            sh:resultPath nltl:lookupSelectionEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                    sh:message "The table lookup case must provide evidence for the table selection." ;
                    sh:minCount 1 ;
                    sh:path nltl:lookupSelectionEvidence ] ] .

