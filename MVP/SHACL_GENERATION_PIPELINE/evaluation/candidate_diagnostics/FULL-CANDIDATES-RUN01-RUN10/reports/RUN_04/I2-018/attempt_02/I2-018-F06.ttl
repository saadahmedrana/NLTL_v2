@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F06/lookup> ;
            sh:resultMessage "The table lookup case must reference IACS UR I2 Table 3." ;
            sh:resultPath nltl:tableReference ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:iacsUrI2Table3 ;
                    sh:maxCount 1 ;
                    sh:message "The table lookup case must reference IACS UR I2 Table 3." ;
                    sh:minCount 1 ;
                    sh:path nltl:tableReference ] ] .

