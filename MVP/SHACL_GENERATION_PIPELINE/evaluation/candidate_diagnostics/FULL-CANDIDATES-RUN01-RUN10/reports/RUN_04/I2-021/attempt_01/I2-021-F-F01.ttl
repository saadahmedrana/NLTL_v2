@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/ship> ;
            sh:resultMessage "Each plating thickness must equal the ice-load net plate thickness plus the corrosion-abrasion allowance, converted from millimetres to metres, within a relative tolerance of 1e-6 and an absolute fallback of 1e-9 metres." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each plating thickness must equal the ice-load net plate thickness plus the corrosion-abrasion allowance, converted from millimetres to metres, within a relative tolerance of 1e-6 and an absolute fallback of 1e-9 metres." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasPlating ?plating .
                ?plating nltl:iceLoadRequiredNetPlateThickness ?netQuantity ;
                         nltl:corrosionAbrasionAllowance ?allowanceQuantity ;
                         nltl:thickness ?thicknessQuantity .
                ?netQuantity qudt:numericValue ?net .
                ?allowanceQuantity qudt:numericValue ?allowance .
                ?thicknessQuantity qudt:numericValue ?thickness .
                BIND ((?net + ?allowance) / 1000 AS ?expected)
                BIND (
                    IF(
                        ((IF(?expected < 0, -?expected, ?expected)) * 0.000001) > 0.000000001,
                        (IF(?expected < 0, -?expected, ?expected)) * 0.000001,
                        0.000000001
                    ) AS ?tolerance
                )
                FILTER (
                    ?thickness < (?expected - ?tolerance) ||
                    ?thickness > (?expected + ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-021> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/ship> ] .

