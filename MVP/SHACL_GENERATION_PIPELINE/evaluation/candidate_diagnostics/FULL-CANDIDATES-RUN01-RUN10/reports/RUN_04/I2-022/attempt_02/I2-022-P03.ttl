@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qd: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P03/member> ;
                            sh:resultMessage "The supporting structural member must provide one dimensionless selected hull area factor." ;
                            sh:resultPath nltl:selectedHullAreaFactor ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "The supporting structural member must provide one dimensionless selected hull area factor." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qd:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qd:numericValue ] ] ;
                                    sh:path nltl:selectedHullAreaFactor ] ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P03/member> ;
                            sh:resultMessage "The supporting structural member must provide frame spacing in metres." ;
                            sh:resultPath nltl:frameSpacing ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "The supporting structural member must provide frame spacing in metres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qd:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qd:unit ] ] ;
                                    sh:path nltl:frameSpacing ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P03/plating> ;
                    sh:resultMessage "Applicable plating must identify its supporting structural member." ;
                    sh:resultPath nltl:platingSupportedByStructuralMember ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Applicable plating must identify its supporting structural member." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:structuralMember ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:message "The supporting structural member must provide frame spacing in metres." ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qd:unit ],
                                                        [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qd:numericValue ] ] ;
                                            sh:path nltl:frameSpacing ],
                                        [ sh:maxCount 1 ;
                                            sh:message "The supporting structural member must provide one dimensionless selected hull area factor." ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qd:numericValue ],
                                                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qd:unit ] ] ;
                                            sh:path nltl:selectedHullAreaFactor ] ] ;
                            sh:path nltl:platingSupportedByStructuralMember ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P03/member> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P03/plating> ;
                    sh:resultMessage "Applicable plating must have a framing angle of at least 70 degrees." ;
                    sh:resultPath nltl:framingAngleOmega ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Applicable plating must have a framing angle of at least 70 degrees." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qd:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qd:unit ] ] ;
                            sh:path nltl:framingAngleOmega ;
                            sh:qualifiedMinCount 1 ;
                            sh:qualifiedValueShape [ sh:property [ sh:minInclusive 70 ;
                                            sh:path qd:numericValue ] ] ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P03/plating> ;
                    sh:resultMessage "Applicable plating must provide the externally computed net ice-load plate thickness in millimetres." ;
                    sh:resultPath nltl:iceLoadRequiredNetPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Applicable plating must provide the externally computed net ice-load plate thickness in millimetres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qd:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qd:numericValue ] ] ;
                            sh:path nltl:iceLoadRequiredNetPlateThickness ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P03/ship> ;
            sh:resultMessage "The ship must provide the plating and structural-member model needed for the complex readiness assessment." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the plating and structural-member model needed for the complex readiness assessment." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:plating ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "Applicable plating must provide the externally computed net ice-load plate thickness in millimetres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qd:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qd:numericValue ] ] ;
                                    sh:path nltl:iceLoadRequiredNetPlateThickness ],
                                [ sh:maxCount 1 ;
                                    sh:message "Applicable plating must have a framing angle of at least 70 degrees." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qd:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qd:unit ] ] ;
                                    sh:path nltl:framingAngleOmega ;
                                    sh:qualifiedMinCount 1 ;
                                    sh:qualifiedValueShape [ sh:property [ sh:minInclusive 70 ;
                                                    sh:path qd:numericValue ] ] ],
                                [ sh:message "Applicable plating must identify its supporting structural member." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:structuralMember ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:message "The supporting structural member must provide frame spacing in metres." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:frameSpacing ],
                                                [ sh:maxCount 1 ;
                                                    sh:message "The supporting structural member must provide one dimensionless selected hull area factor." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:selectedHullAreaFactor ] ] ;
                                    sh:path nltl:platingSupportedByStructuralMember ],
                                [ sh:in ( nltl:bowIntermediateBottomHullArea nltl:midbodyBottomHullArea nltl:sternBottomHullArea ) ;
                                    sh:message "Applicable plating must be classified as bow intermediate bottom, midbody bottom, or stern bottom hull area." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:platingHullAreaClassification ] ] ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P03/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P03/ship> ;
            sh:resultMessage "The ship must provide one average ice pressure quantity in MPa." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one average ice pressure quantity in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qd:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qd:unit ] ] ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P03/ship> ;
            sh:resultMessage "The ship must provide one dimensionless peak pressure factor." ;
            sh:resultPath nltl:peakPressureFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one dimensionless peak pressure factor." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qd:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qd:numericValue ] ] ;
                    sh:path nltl:peakPressureFactor ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P03/ship> ;
            sh:resultMessage "The ship must provide one load patch height quantity in metres." ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one load patch height quantity in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qd:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qd:numericValue ] ] ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P03/ship> ;
            sh:resultMessage "The ship must provide one yield strength quantity in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one yield strength quantity in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qd:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qd:unit ] ] ;
                    sh:path nltl:yieldStrength ] ] .

