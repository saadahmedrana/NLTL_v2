@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/case> ;
                    sh:resultMessage "Less than 1 values on ex:case->nltl:framingAngle" ;
                    sh:resultPath nltl:framingAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxExclusive 70 ;
                                            sh:minCount 1 ;
                                            sh:minExclusive 20 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:framingAngle ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:obliquePlatingInterpolationCase ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:interpolationPoint ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:interpolationPointResult ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:interpolationPointCoordinate ] ] ; sh:path nltl:interpolationLowerEndpoint ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:interpolationPoint ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:interpolationPointResult ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:interpolationPointCoordinate ] ] ; sh:path nltl:interpolationUpperEndpoint ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxExclusive Literal(\"70\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minExclusive Literal(\"20\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:framingAngle ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:interpolatedNetPlateThickness ] ]. See details for more information." ;
            sh:resultPath nltl:hasObliquePlatingInterpolationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:obliquePlatingInterpolationCase ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:interpolatedNetPlateThickness ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ],
                                                [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ] ] ;
                                    sh:path nltl:interpolationLowerEndpoint ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxExclusive 70 ;
                                                    sh:minCount 1 ;
                                                    sh:minExclusive 20 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:framingAngle ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ],
                                                [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ] ] ;
                                    sh:path nltl:interpolationUpperEndpoint ] ] ;
                    sh:path nltl:hasObliquePlatingInterpolationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasCalculationCase" ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:longitudinalFramingNetPlateThickness ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:transverseFramingNetPlateThickness ] ] ;
                    sh:path nltl:hasCalculationCase ] ] .

