@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F02/support> ;
            sh:resultMessage "Each member support shall have exactly one permitted frame support condition." ;
            sh:resultPath ( nltl:hasMemberSupport nltl:frameSupportCondition ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameSupportConditionValue ;
                    sh:in ( nltl:fixedFrameSupport nltl:simpleFrameSupport ) ;
                    sh:maxCount 1 ;
                    sh:message "Each member support shall have exactly one permitted frame support condition." ;
                    sh:minCount 1 ;
                    sh:path ( nltl:hasMemberSupport nltl:frameSupportCondition ) ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F02/support> ;
            sh:resultMessage "Each structural member shall identify its member support." ;
            sh:resultPath nltl:hasMemberSupport ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:memberSupport ;
                    sh:message "Each structural member shall identify its member support." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasMemberSupport ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F02/support> ;
            sh:resultMessage "Demonstrated significant rotational restraint shall have an evidence artifact." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Demonstrated significant rotational restraint shall have an evidence artifact." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:demonstratedRotationalRestraint true .
                FILTER NOT EXISTS {
                    $this nltl:significantRotationalRestraintEvidence ?evidence .
                    ?evidence a nltl:evidenceArtifact .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_026_MemberSupportShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F02/support> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F02/support> ;
            sh:resultMessage "The structural member shall state whether it terminates within the ice-strengthened area." ;
            sh:resultPath nltl:terminatesWithinIceStrengthenedArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The structural member shall state whether it terminates within the ice-strengthened area." ;
                    sh:minCount 1 ;
                    sh:path nltl:terminatesWithinIceStrengthenedArea ] ] .

