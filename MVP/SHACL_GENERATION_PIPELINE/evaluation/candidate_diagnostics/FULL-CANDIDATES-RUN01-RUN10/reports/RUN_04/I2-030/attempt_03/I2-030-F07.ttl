@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasStructuralMember" ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node g:I2_030_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/calc> ;
                    sh:resultMessage "For oblique framing, the framing angle must be strictly between 20 and 70 degrees and paired interpolation endpoints must be supplied." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "For oblique framing, the framing angle must be strictly between 20 and 70 degrees and paired interpolation endpoints must be supplied." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCaseStructuralMember ?member .
                ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                ?localCase nltl:sectionCalculationCasePlating ?plating .
                ?plating nltl:framingAngleOmega ?angleQuantity .
                ?angleQuantity qudt:numericValue ?angleValue .
                FILTER (?angleValue > 20 && ?angleValue < 70)
                FILTER NOT EXISTS {
                    $this nltl:interpolationLowerEndpoint ?lower .
                    $this nltl:interpolationUpperEndpoint ?upper .
                    ?lower nltl:interpolationPointCoordinate ?lowerCoordinate .
                    ?lower nltl:interpolationPointResult ?lowerResult .
                    ?upper nltl:interpolationPointCoordinate ?upperCoordinate .
                    ?upper nltl:interpolationPointResult ?upperResult .
                    ?lowerCoordinate qudt:numericValue ?lowerCoordinateValue .
                    ?upperCoordinate qudt:numericValue ?upperCoordinateValue .
                    FILTER (?lowerCoordinateValue < ?upperCoordinateValue)
                }
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape g:I2_030_CalculationCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/calc> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/ship> ;
            sh:resultMessage "Value does not conform to Shape g:I2_030_CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node g:I2_030_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/calc> ] .

