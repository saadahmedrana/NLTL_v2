@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "A ship must identify its frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:message "A ship must identify its frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ;
                    sh:resultMessage "For each longitudinal frame in a side structure, combined shear-and-bending demand must not exceed plastic strength, and plastic strength must equal the midspan plastic-collapse load within tolerance." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "For each longitudinal frame in a side structure, combined shear-and-bending demand must not exceed plastic strength, and plastic strength must equal the midspan plastic-collapse load within tolerance." ;
                            sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:longitudinalFrameOrientation true ;
        nltl:structuralLocation nltl:sideStructureLocation ;
        nltl:hasStructuralMemberLoadCase ?case ;
        nltl:plasticStrength ?strengthQuantity ;
        nltl:midspanPlasticCollapseLoad ?midspanQuantity .

  ?case nltl:combinedShearAndBendingDemand ?demandQuantity .
  ?demandQuantity qudt:numericValue ?demandValue .
  ?strengthQuantity qudt:numericValue ?strengthValue .
  ?midspanQuantity qudt:numericValue ?midspanValue .

  FILTER(
    ?demandValue > ?strengthValue
    ||
    ABS(?strengthValue - ?midspanValue) >
      (1e-6 * ABS(?midspanValue) + 1e-9)
  )
}
""" ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_034_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/strength> ;
                            sh:resultMessage "Plastic strength must be expressed in kilonewtons." ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:KiloN ;
                                    sh:maxCount 1 ;
                                    sh:message "Plastic strength must be expressed in kilonewtons." ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ;
                    sh:resultMessage "Each applicable longitudinal side frame must provide its plastic strength." ;
                    sh:resultPath nltl:plasticStrength ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Each applicable longitudinal side frame must provide its plastic strength." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_034_PlasticStrengthQuantityShape ;
                            sh:path nltl:plasticStrength ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/strength> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/collapse> ;
                            sh:resultMessage "Midspan plastic-collapse load must be expressed in kilonewtons." ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:KiloN ;
                                    sh:maxCount 1 ;
                                    sh:message "Midspan plastic-collapse load must be expressed in kilonewtons." ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ;
                    sh:resultMessage "Each applicable longitudinal side frame must provide its midspan plastic-collapse load." ;
                    sh:resultPath nltl:midspanPlasticCollapseLoad ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Each applicable longitudinal side frame must provide its midspan plastic-collapse load." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_034_MidspanCollapseLoadQuantityShape ;
                            sh:path nltl:midspanPlasticCollapseLoad ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/collapse> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_034_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:I2_034_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] .

