            sh:resultMessage "Value does not conform to Shape [ sh:or ( [ sh:class nltl:webFrame ] [ sh:class nltl:loadCarryingStringer ] ) ; sh:property [ sh:message Literal(\"Each web frame or load-carrying stringer must have a member capacity in kN.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:memberCapacity ], [ sh:message Literal(\"Each web frame or load-carrying stringer must have a structural-member load case.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:loadCase ; sh:property [ sh:datatype xsd:string ; sh:message Literal(\"Each structural-member load case must record the combined bending and shear effect.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:combinedShearBendingEffect ], [ sh:datatype xsd:string ; sh:message Literal(\"Each structural-member load case must record the load patch application location.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadPatchApplicationLocation ] ] ; sh:path nltl:hasStructuralMemberLoadCase ] ]. See details for more information." ;
