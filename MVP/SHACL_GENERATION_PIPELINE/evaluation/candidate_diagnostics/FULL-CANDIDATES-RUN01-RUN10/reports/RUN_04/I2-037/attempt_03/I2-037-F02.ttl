@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/member> ;
                    sh:resultMessage "Each structural member must provide one capacity in kN." ;
                    sh:resultPath nltl:memberCapacity ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class qudt:QuantityValue ;
                            sh:maxCount 1 ;
                            sh:message "Each structural member must provide one capacity in kN." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-037-CapacityShape> ;
                            sh:path nltl:memberCapacity ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/loadcase> ;
                            sh:resultMessage "The load case must identify the combined bending and shear effect." ;
                            sh:resultPath nltl:combinedShearBendingEffect ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:message "The load case must identify the combined bending and shear effect." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:combinedShearBendingEffect ] ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/loadcase> ;
                            sh:resultMessage "The load case must identify the load patch application location." ;
                            sh:resultPath nltl:loadPatchApplicationLocation ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:message "The load case must identify the load patch application location." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:loadPatchApplicationLocation ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/member> ;
                    sh:resultMessage "Each structural member must have a load case for the ice-load design." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCase ;
                            sh:message "Each structural member must have a load case for the ice-load design." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-037-LoadCaseShape> ;
                            sh:path nltl:hasStructuralMemberLoadCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/loadcase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/ship> ;
            sh:resultMessage "Each represented structural member must have the required ice-load design data." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:message "Each represented structural member must have the required ice-load design data." ;
                    sh:node <urn:nltl:generated-shape:I2-037-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/ship> ;
            sh:resultMessage "The ship must provide an ice load patch design case with minimization confirmation." ;
            sh:resultPath nltl:hasIceLoadPatchDesignCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceLoadPatchDesignCase ;
                    sh:message "The ship must provide an ice load patch design case with minimization confirmation." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-037-DesignCaseShape> ;
                    sh:path nltl:hasIceLoadPatchDesignCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/ship> ;
            sh:resultMessage "The ship must identify the ice load patch used for the design." ;
            sh:resultPath nltl:hasIceLoadPatch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceLoadPatch ;
                    sh:message "The ship must identify the ice load patch used for the design." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasIceLoadPatch ] ] .

