@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "The ship must identify the ice load patch to which the design cases apply." ;
            sh:resultPath nltl:hasIceLoadPatch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceLoadPatch ;
                    sh:message "The ship must identify the ice load patch to which the design cases apply." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceLoadPatch ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/member> ;
                    sh:resultMessage "Each represented structural member must provide its capacity in kN." ;
                    sh:resultPath nltl:memberCapacity ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each represented structural member must provide its capacity in kN." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue unit:KiloN ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:memberCapacity ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/loadcase> ;
                            sh:resultMessage "Less than 1 values on ex:loadcase->nltl:combinedShearBendingEffect" ;
                            sh:resultPath nltl:combinedShearBendingEffect ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:combinedShearBendingEffect ] ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/loadcase> ;
                            sh:resultMessage "Less than 1 values on ex:loadcase->nltl:loadPatchApplicationLocation" ;
                            sh:resultPath nltl:loadPatchApplicationLocation ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:loadPatchApplicationLocation ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/member> ;
                    sh:resultMessage "Each represented structural member must have a load case containing the patch location and combined bending-and-shear effect." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCase ;
                            sh:message "Each represented structural member must have a load case containing the patch location and combined bending-and-shear effect." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:string ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path nltl:combinedShearBendingEffect ],
                                        [ sh:datatype xsd:string ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path nltl:loadPatchApplicationLocation ] ] ;
                            sh:path nltl:hasStructuralMemberLoadCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/loadcase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:class nltl:loadCase ; sh:message Literal(\"Each represented structural member must have a load case containing the patch location and combined bending-and-shear effect.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:combinedShearBendingEffect ], [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadPatchApplicationLocation ] ] ; sh:path nltl:hasStructuralMemberLoadCase ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each represented structural member must provide its capacity in kN.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:memberCapacity ] ]. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:node [ sh:property [ sh:maxCount 1 ;
                                    sh:message "Each represented structural member must provide its capacity in kN." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:KiloN ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:memberCapacity ],
                                [ sh:class nltl:loadCase ;
                                    sh:message "Each represented structural member must have a load case containing the patch location and combined bending-and-shear effect." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:string ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:combinedShearBendingEffect ],
                                                [ sh:datatype xsd:string ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:loadPatchApplicationLocation ] ] ;
                                    sh:path nltl:hasStructuralMemberLoadCase ] ] ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/member> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ;
                    sh:resultMessage "The ice-load-patch design case must confirm capacity minimization." ;
                    sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:na99fc81ecf21449096c62a8016c380b9b4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ;
                    sh:resultMessage "Less than 1 values on ex:patchCase->nltl:loadPatchApplicationLocation" ;
                    sh:resultPath nltl:loadPatchApplicationLocation ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:loadPatchApplicationLocation ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ;
                    sh:resultMessage "Less than 1 values on ex:patchCase->nltl:combinedShearBendingEffect" ;
                    sh:resultPath nltl:combinedShearBendingEffect ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:combinedShearBendingEffect ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ;
                    sh:resultMessage "The ice-load-patch design case must confirm capacity minimization." ;
                    sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:na99fc81ecf21449096c62a8016c380b9b4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "The ship must provide one ice-load-patch design case with the required minimization result and load-case operands." ;
            sh:resultPath nltl:hasIceLoadPatchDesignCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceLoadPatchDesignCase ;
                    sh:maxCount 1 ;
                    sh:message "The ship must provide one ice-load-patch design case with the required minimization result and load-case operands." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:loadPatchApplicationLocation ],
                                [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:combinedShearBendingEffect ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The ice-load-patch design case must confirm capacity minimization." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:memberCapacityMinimizationConfirmed ] ] ;
                    sh:path nltl:hasIceLoadPatchDesignCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ] .

_:na99fc81ecf21449096c62a8016c380b9b4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice-load-patch design case must confirm capacity minimization." ;
    sh:minCount 1 ;
    sh:path nltl:memberCapacityMinimizationConfirmed .

