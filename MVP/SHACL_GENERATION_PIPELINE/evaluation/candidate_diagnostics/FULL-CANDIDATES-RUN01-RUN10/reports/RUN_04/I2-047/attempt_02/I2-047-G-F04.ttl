@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Steel renewal is required when gauged thickness is less than net thickness plus 0.0005 m.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:steelRenewalRequired ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The linked hull structure must be identified as ice strengthened.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:gaugedThickness ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:netThickness ] ; sh:sparql [ sh:message Literal("For an ice-strengthened structure, gauged thickness must be at least net thickness plus 0.0005 m unless steel renewal is required.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:gaugedThickness ?gaugedQuantity ;
                              nltl:netThickness ?netQuantity ;
                              nltl:steelRenewalRequired ?renewal .

                        ?gaugedQuantity qudt:numericValue ?gaugedValue ;
                                         qudt:unit qudt:M .
                        ?netQuantity qudt:numericValue ?netValue ;
                                     qudt:unit qudt:M .

                        FILTER EXISTS {
                            $this nltl:hasPlating ?plating .
                            ?plating nltl:iceStrengthenedStructureStatus true .
                        }

                        FILTER (?gaugedValue < (?netValue + 0.0005))
                        FILTER (?renewal != true)
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2_047> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F04/ship> ] .

