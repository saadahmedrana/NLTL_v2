@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F001/case> ;
                    sh:resultMessage "Each case must provide exactly one as-built plate thickness in millimetres." ;
                    sh:resultPath nltl:asBuiltPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each case must provide exactly one as-built plate thickness in millimetres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:asBuiltPlateThickness ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F001/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:I2_048_CaseShape. See details for more information." ;
            sh:resultPath nltl:hasSteelGradeRequirementCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeRequirementCase ;
                    sh:node gs:I2_048_CaseShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasSteelGradeRequirementCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F001/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F001/ship> ;
            sh:resultMessage "Every represented steel grade requirement case must have a ship Polar Class selector." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Every represented steel grade requirement case must have a ship Polar Class selector." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasSteelGradeRequirementCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:polarClass ?pc .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:I2_048_PolarClassReadiness ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F001/ship> ] .

