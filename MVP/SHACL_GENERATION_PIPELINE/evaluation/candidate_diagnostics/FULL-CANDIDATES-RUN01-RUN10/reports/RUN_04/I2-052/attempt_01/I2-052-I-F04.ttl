@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/lowerPoint> ;
                            sh:resultMessage "Each interpolation point shall provide its interpolation coordinate." ;
                            sh:resultPath nltl:interpolationCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n64207590db9f4cf2be71d4d81b339543b14 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/calculation> ;
                    sh:resultMessage "The calculation case shall contain interpolation points." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "The calculation case shall contain interpolation points." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-052-InterpolationPointShape> ;
                            sh:path nltl:hasInterpolationPoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/lowerPoint> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/lowerPoint> ;
                            sh:resultMessage "Each interpolation point shall provide its interpolation coordinate." ;
                            sh:resultPath nltl:interpolationCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n64207590db9f4cf2be71d4d81b339543b14 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/calculation> ;
                    sh:resultMessage "The calculation case shall identify a lower interpolation endpoint." ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "The calculation case shall identify a lower interpolation endpoint." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-052-InterpolationPointShape> ;
                            sh:path nltl:interpolationLowerEndpoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/lowerPoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/ship> ;
            sh:resultMessage "The ship shall provide a calculation case for the interpolation model." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide a calculation case for the interpolation model." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-052-CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/calculation> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/ship> ;
            sh:resultMessage "The ship shall provide the externally determined interpolated value." ;
            sh:resultPath nltl:interpolatedValue ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship shall provide the externally determined interpolated value." ;
                    sh:minCount 1 ;
                    sh:path nltl:interpolatedValue ] ] .

