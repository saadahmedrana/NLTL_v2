@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp2> ;
                            sh:resultMessage "Each interpolation point must provide its externally determined result." ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:ndc960faed0ca473cbd5b16208398b332b8 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp2> ;
                            sh:resultMessage "Each interpolation point must provide its coordinate." ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:ndc960faed0ca473cbd5b16208398b332b7 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/bendingCase> ;
                    sh:resultMessage "The calculation case must provide the declared interpolation-point structure." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:ndc960faed0ca473cbd5b16208398b332b6 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp2> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp1> ;
                            sh:resultMessage "Each interpolation point must provide its coordinate." ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:ndc960faed0ca473cbd5b16208398b332b7 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp1> ;
                            sh:resultMessage "Each interpolation point must provide its externally determined result." ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:ndc960faed0ca473cbd5b16208398b332b8 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/bendingCase> ;
                    sh:resultMessage "The calculation case must provide the declared interpolation-point structure." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:ndc960faed0ca473cbd5b16208398b332b6 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/ship> ;
            sh:resultMessage "The ship must provide a calculation case for the externally determined bending-moment calculation." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a calculation case for the externally determined bending-moment calculation." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_054_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/bendingCase> ] .

_:ndc960faed0ca473cbd5b16208398b332b6 sh:message "The calculation case must provide the declared interpolation-point structure." ;
    sh:minCount 1 ;
    sh:node gen:I2_054_InterpolationPointShape ;
    sh:path nltl:hasInterpolationPoint .

_:ndc960faed0ca473cbd5b16208398b332b7 sh:message "Each interpolation point must provide its coordinate." ;
    sh:minCount 1 ;
    sh:node gen:I2_054_DimensionlessQuantityShape ;
    sh:path nltl:interpolationPointCoordinate .

_:ndc960faed0ca473cbd5b16208398b332b8 sh:message "Each interpolation point must provide its externally determined result." ;
    sh:minCount 1 ;
    sh:node gen:I2_054_ResultQuantityShape ;
    sh:path nltl:interpolationPointResult .

