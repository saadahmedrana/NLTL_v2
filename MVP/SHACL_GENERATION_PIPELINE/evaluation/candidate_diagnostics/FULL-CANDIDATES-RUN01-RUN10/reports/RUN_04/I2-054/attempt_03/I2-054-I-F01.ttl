@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:I2_054_> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F01/ship> ;
            sh:resultMessage "The interpolation structure and hull-girder bending-moment result shall belong to the same linked calculation case." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The interpolation structure and hull-girder bending-moment result shall belong to the same linked calculation case." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                $this nltl:hasHullGirderBendingMomentCalculationCase ?case .
                ?case a nltl:calculationCase .
                ?case a nltl:hullGirderBendingMomentCalculationCase .
                FILTER NOT EXISTS {
                    ?case nltl:hasInterpolationPoint ?point .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlg:ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F01/bendingCase> ;
                    sh:resultMessage "The calculation case shall provide the five required interpolation anchors and any applicable intermediate points." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The calculation case shall provide the five required interpolation anchors and any applicable intermediate points." ;
                            sh:minCount 5 ;
                            sh:node nltlg:InterpolationPointShape ;
                            sh:path nltl:hasInterpolationPoint ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F01/bendingCase> ;
                    sh:resultMessage "The calculation case shall provide its hull-girder longitudinal position from aft in metres." ;
                    sh:resultPath nltl:hullGirderLongitudinalPositionFromAft ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The calculation case shall provide its hull-girder longitudinal position from aft in metres." ;
                            sh:minCount 1 ;
                            sh:node nltlg:LengthQuantityShape ;
                            sh:path nltl:hullGirderLongitudinalPositionFromAft ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F01/ship> ;
            sh:resultMessage "The ship shall provide a calculation case containing the interpolation structure." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide a calculation case containing the interpolation structure." ;
                    sh:minCount 1 ;
                    sh:node nltlg:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F01/bendingCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F01/ship> ;
            sh:resultMessage "The linked interpolation case shall contain exact inclusive anchors at normalized positions 0, 0.5, 0.7, 0.95, and 1 with C_m values 0, 1, 1, 0.3, and 0 respectively." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The linked interpolation case shall contain exact inclusive anchors at normalized positions 0, 0.5, 0.7, 0.95, and 1 with C_m values 0, 1, 1, 0.3, and 0 respectively." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                $this nltl:hasHullGirderBendingMomentCalculationCase ?case .
                FILTER (
                    NOT EXISTS {
                        ?case nltl:hasInterpolationPoint ?p0 .
                        ?p0 nltl:interpolationPointCoordinate ?q0 .
                        ?q0 qudt:numericValue "0.0"^^xsd:decimal .
                        ?p0 nltl:interpolationPointResult ?r0 .
                        ?r0 qudt:numericValue ?v0 .
                        FILTER (?v0 >= 0 && ?v0 <= 0)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:hasInterpolationPoint ?p5 .
                        ?p5 nltl:interpolationPointCoordinate ?q5 .
                        ?q5 qudt:numericValue "0.5"^^xsd:decimal .
                        ?p5 nltl:interpolationPointResult ?r5 .
                        ?r5 qudt:numericValue ?v5 .
                        FILTER (?v5 >= 1 && ?v5 <= 1)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:hasInterpolationPoint ?p7 .
                        ?p7 nltl:interpolationPointCoordinate ?q7 .
                        ?q7 qudt:numericValue "0.7"^^xsd:decimal .
                        ?p7 nltl:interpolationPointResult ?r7 .
                        ?r7 qudt:numericValue ?v7 .
                        FILTER (?v7 >= 1 && ?v7 <= 1)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:hasInterpolationPoint ?p95 .
                        ?p95 nltl:interpolationPointCoordinate ?q95 .
                        ?q95 qudt:numericValue "0.95"^^xsd:decimal .
                        ?p95 nltl:interpolationPointResult ?r95 .
                        ?r95 qudt:numericValue ?v95 .
                        FILTER (?v95 >= 0.3 && ?v95 <= 0.3)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:hasInterpolationPoint ?p1 .
                        ?p1 nltl:interpolationPointCoordinate ?q1 .
                        ?q1 qudt:numericValue "1.0"^^xsd:decimal .
                        ?p1 nltl:interpolationPointResult ?r1 .
                        ?r1 qudt:numericValue ?v1 .
                        FILTER (?v1 >= 0 && ?v1 <= 0)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlg:ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F01/ship> ;
            sh:resultMessage "The ship shall provide one upper ice waterline length L_UI in metres." ;
            sh:resultPath nltl:upperIceWaterlineLengthLUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide one upper ice waterline length L_UI in metres." ;
                    sh:minCount 1 ;
                    sh:node nltlg:LengthQuantityShape ;
                    sh:path nltl:upperIceWaterlineLengthLUI ] ] .

