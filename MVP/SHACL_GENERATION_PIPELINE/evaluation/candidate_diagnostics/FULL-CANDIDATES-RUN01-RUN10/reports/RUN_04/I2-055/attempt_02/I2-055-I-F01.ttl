@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F01/ship> ;
            sh:resultMessage "The design stress must not exceed the permissible stress." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The design stress must not exceed the permissible stress." ;
                    sh:select """
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl/vocab#designStress> ?designQuantity .
                ?designQuantity qudt:numericValue ?designValue .
                $this <https://w3id.org/nltl/vocab#permissibleStress> ?permissibleQuantity .
                ?permissibleQuantity qudt:numericValue ?permissibleValue .
                FILTER (?designValue > ?permissibleValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-055-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F01/ship> ] .

