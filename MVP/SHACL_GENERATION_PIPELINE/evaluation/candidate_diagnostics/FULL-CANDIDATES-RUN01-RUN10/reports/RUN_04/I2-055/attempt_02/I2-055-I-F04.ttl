@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F04/ship> ;
            sh:resultMessage "Each ship must provide one design stress in MPa." ;
            sh:resultPath nltl:designStress ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ship must provide one design stress in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-055-DesignStressQuantityShape> ;
                    sh:path nltl:designStress ] ] .

