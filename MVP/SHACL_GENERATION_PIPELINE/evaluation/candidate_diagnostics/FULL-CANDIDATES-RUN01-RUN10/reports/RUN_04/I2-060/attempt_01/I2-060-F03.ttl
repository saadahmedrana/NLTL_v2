@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/ship> ;
            sh:resultMessage "A member in way of a cutout must not be recorded as unstable." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A member in way of a cutout must not be recorded as unstable." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout .
    ?member nltl:memberInWayOfCutout ?inWay .
    FILTER(datatype(?inWay) = xsd:boolean && ?inWay = true)
    FILTER NOT EXISTS {
        $this nltl:memberInstability ?instability .
        FILTER(datatype(?instability) = xsd:boolean && ?instability = false)
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-060> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/ship> ] .

