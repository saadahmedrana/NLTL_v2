@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudt-unit: <http://qudt.org/vocab/unit/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/case> ;
                    sh:resultMessage "The prescribed analytical procedure must be used; a direct calculation method must not replace it." ;
                    sh:resultPath nltl:calculationMethod ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:prescribedAnalyticalProcedure ) ;
                            sh:message "The prescribed analytical procedure must be used; a direct calculation method must not replace it." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:calculationMethod ] ;
                    sh:value nltl:directCalculationMethodValue ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/structure> ;
                            sh:resultMessage "The assessed hull structure must have one thickness quantity expressed in metres." ;
                            sh:resultPath nltl:thickness ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:class qudt:QuantityValue ;
                                    sh:maxCount 1 ;
                                    sh:message "The assessed hull structure must have one thickness quantity expressed in metres." ;
                                    sh:minCount 1 ;
                                    sh:node [ a sh:NodeShape ;
                                            sh:property [ sh:hasValue qudt-unit:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:nodeKind sh:BlankNodeOrIRI ;
                                    sh:path nltl:thickness ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/case> ;
                    sh:resultMessage "A calculation case must identify the assessed hull structure." ;
                    sh:resultPath nltl:calculationCaseAssessedHullStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:hullStructure ;
                            sh:message "A calculation case must identify the assessed hull structure." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-061-HullStructureShape> ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:calculationCaseAssessedHullStructure ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/structure> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/ship> ;
            sh:resultMessage "Each calculation case must identify its assessed hull structure, prescribed analytical procedure, and required thickness." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "Each calculation case must identify its assessed hull structure, prescribed analytical procedure, and required thickness." ;
                    sh:node <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/case> ] .

