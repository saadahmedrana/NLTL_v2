@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ;
            sh:resultMessage "A direct calculation method must not replace the prescribed analytical procedure for shell-plating or local-frame hull structures." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:nec142812fab54ac583d68fa046b50ddbb12 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlgen:CalculationCaseShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ;
                    sh:resultMessage "A direct calculation method must not replace the prescribed analytical procedure for shell-plating or local-frame hull structures." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:nec142812fab54ac583d68fa046b50ddbb12 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape nltlgen:CalculationCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape nltlgen:CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltlgen:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ] .

_:nec142812fab54ac583d68fa046b50ddbb12 a sh:SPARQLConstraint ;
    sh:message "A direct calculation method must not replace the prescribed analytical procedure for shell-plating or local-frame hull structures." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:calculationCaseAssessedHullStructure ?structure .
                ?structure rdf:type ?structureType .
                FILTER (
                    ?structureType IN (
                        nltl:plating,
                        nltl:structuralMember
                    )
                )
                $this nltl:calculationMethod nltl:directCalculationMethodValue .
            }
        """ .

