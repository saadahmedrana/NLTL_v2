@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/case> ;
                    sh:resultMessage "A direct calculation method shall not be used for a calculation case explicitly assessed against shell plating or a local-frame structural member." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "A direct calculation method shall not be used for a calculation case explicitly assessed against shell plating or a local-frame structural member." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>

            SELECT $this
            WHERE {
                $this nltl:calculationCaseAssessedHullStructure ?structure .
                ?structure a ?structureType .
                FILTER (
                    ?structureType IN (
                        nltl:plating,
                        nltl:structuralMember
                    )
                )
                $this nltl:calculationMethod
                    nltl:directCalculationMethodValue .
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-CalculationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:node <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/case> ] .

