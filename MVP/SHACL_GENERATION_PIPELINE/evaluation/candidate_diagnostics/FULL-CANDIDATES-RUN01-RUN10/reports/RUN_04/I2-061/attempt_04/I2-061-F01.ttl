@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ;
            sh:resultMessage "A shell-plating or local-frame calculation case must use the prescribed analytical procedure and must not use a direct calculation method." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:naef575d12141423daf5d8a1126193937b7 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:CalculationCaseShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ;
                    sh:resultMessage "A shell-plating or local-frame calculation case must use the prescribed analytical procedure and must not use a direct calculation method." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:naef575d12141423daf5d8a1126193937b7 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:CalculationCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ] .

_:naef575d12141423daf5d8a1126193937b7 sh:message "A shell-plating or local-frame calculation case must use the prescribed analytical procedure and must not use a direct calculation method." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:calculationCaseAssessedHullStructure ?structure .
                ?structure a ?applicableType .
                FILTER (?applicableType IN (nltl:plating, nltl:structuralMember))
                FILTER (
                    NOT EXISTS {
                        $this nltl:calculationMethod nltl:prescribedAnalyticalProcedure
                    }
                    ||
                    EXISTS {
                        $this nltl:calculationMethod nltl:directCalculationMethodValue
                    }
                )
            }
        """ .

