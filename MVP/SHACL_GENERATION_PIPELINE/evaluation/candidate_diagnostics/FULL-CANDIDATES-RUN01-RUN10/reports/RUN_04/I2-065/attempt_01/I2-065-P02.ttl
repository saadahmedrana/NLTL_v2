@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/ship> ;
            sh:resultMessage "The ship must provide a dimensionless major buckling margin." ;
            sh:resultPath nltl:majorBucklingMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a dimensionless major buckling margin." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:majorBucklingMargin ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/ship> ;
            sh:resultMessage "The ship must provide a dimensionless fracture margin." ;
            sh:resultPath nltl:fractureMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a dimensionless fracture margin." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:fractureMargin ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/ship> ;
            sh:resultMessage "The ship must provide a dimensionless yielding margin." ;
            sh:resultPath nltl:yieldingMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a dimensionless yielding margin." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:yieldingMargin ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ;
                    sh:resultMessage "Each nonlinear calculation case must provide acceptance evidence." ;
                    sh:resultPath nltl:nonlinearAnalysisAcceptanceEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:message "Each nonlinear calculation case must provide acceptance evidence." ;
                            sh:minCount 1 ;
                            sh:path nltl:nonlinearAnalysisAcceptanceEvidence ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ;
                    sh:resultMessage "Each nonlinear calculation case must provide the relevant structural dimension in millimetres." ;
                    sh:resultPath nltl:relevantStructuralDimension ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each nonlinear calculation case must provide the relevant structural dimension in millimetres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:relevantStructuralDimension ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ;
                    sh:resultMessage "Each nonlinear calculation case must provide the permanent-deformation assessment result." ;
                    sh:resultPath nltl:minorPermanentDeformationAssessmentSatisfied ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:message "Each nonlinear calculation case must provide the permanent-deformation assessment result." ;
                            sh:minCount 1 ;
                            sh:path nltl:minorPermanentDeformationAssessmentSatisfied ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ;
                    sh:resultMessage "Each nonlinear calculation case must provide permanent lateral deformation in millimetres." ;
                    sh:resultPath nltl:permanentLateralDeformation ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each nonlinear calculation case must provide permanent lateral deformation in millimetres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:permanentLateralDeformation ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ;
                    sh:resultMessage "Each nonlinear calculation case must provide permanent out-of-plane deformation in millimetres." ;
                    sh:resultPath nltl:permanentOutOfPlaneDeformation ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each nonlinear calculation case must provide permanent out-of-plane deformation in millimetres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:permanentOutOfPlaneDeformation ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode nltl:linearCalculationMethodValue ;
                            sh:resultMessage "Node nltl:linearCalculationMethodValue value is not a in the set of values: ['nltl:nonlinearCalculationMethodValue']" ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:class nltl:calculationMethodValue ;
                                    sh:hasValue nltl:nonlinearCalculationMethodValue ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:calculationMethodValue ; sh:hasValue nltl:nonlinearCalculationMethodValue ]. See details for more information." ;
                    sh:resultPath nltl:calculationMethod ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class nltl:calculationMethodValue ;
                                    sh:hasValue nltl:nonlinearCalculationMethodValue ] ;
                            sh:path nltl:calculationMethod ] ;
                    sh:value nltl:linearCalculationMethodValue ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/ship> ;
            sh:resultMessage "The ship must provide a nonlinear calculation case with the required externally computed assessment inputs, result, and evidence." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a nonlinear calculation case with the required externally computed assessment inputs, result, and evidence." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:message "Each nonlinear calculation case must provide permanent out-of-plane deformation in millimetres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:permanentOutOfPlaneDeformation ],
                                [ sh:message "Each nonlinear calculation case must provide the relevant structural dimension in millimetres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:relevantStructuralDimension ],
                                [ sh:datatype xsd:boolean ;
                                    sh:message "Each nonlinear calculation case must provide the permanent-deformation assessment result." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:minorPermanentDeformationAssessmentSatisfied ],
                                [ sh:class nltl:evidenceArtifact ;
                                    sh:message "Each nonlinear calculation case must provide acceptance evidence." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:nonlinearAnalysisAcceptanceEvidence ],
                                [ sh:message "Each nonlinear calculation case must provide permanent lateral deformation in millimetres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:permanentLateralDeformation ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:calculationMethodValue ;
                                            sh:hasValue nltl:nonlinearCalculationMethodValue ] ;
                                    sh:path nltl:calculationMethod ] ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ] .

