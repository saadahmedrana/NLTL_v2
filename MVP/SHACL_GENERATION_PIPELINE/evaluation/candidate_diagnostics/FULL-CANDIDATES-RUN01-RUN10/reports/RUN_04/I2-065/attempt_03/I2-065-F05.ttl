@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F05/ship> ;
            sh:resultMessage "When a nonlinear calculation case is present, the required margins, deformation measurements, and relevant structural dimension must be recorded with the prescribed QUDT units." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When a nonlinear calculation case is present, the required margins, deformation measurements, and relevant structural dimension must be recorded with the prescribed QUDT units." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX qudt-unit: <http://qudt.org/vocab/unit/>

            SELECT ?this
            WHERE {
                ?this a nltl:ship ;
                      nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:nonlinearCalculationMethodValue .

                FILTER (
                    !EXISTS {
                        ?this nltl:fractureMargin ?q .
                        ?q qudt:numericValue ?number ;
                           qudt:unit qudt-unit:UNITLESS .
                        FILTER NOT EXISTS {
                            ?q qudt:unit ?otherUnit .
                            FILTER (?otherUnit != qudt-unit:UNITLESS)
                        }
                    }
                    ||
                    !EXISTS {
                        ?this nltl:majorBucklingMargin ?q .
                        ?q qudt:numericValue ?number ;
                           qudt:unit qudt-unit:UNITLESS .
                        FILTER NOT EXISTS {
                            ?q qudt:unit ?otherUnit .
                            FILTER (?otherUnit != qudt-unit:UNITLESS)
                        }
                    }
                    ||
                    !EXISTS {
                        ?this nltl:yieldingMargin ?q .
                        ?q qudt:numericValue ?number ;
                           qudt:unit qudt-unit:UNITLESS .
                        FILTER NOT EXISTS {
                            ?q qudt:unit ?otherUnit .
                            FILTER (?otherUnit != qudt-unit:UNITLESS)
                        }
                    }
                    ||
                    !EXISTS {
                        ?this nltl:permanentLateralDeformation ?q .
                        ?q qudt:numericValue ?number ;
                           qudt:unit qudt-unit:MilliM .
                        FILTER NOT EXISTS {
                            ?q qudt:unit ?otherUnit .
                            FILTER (?otherUnit != qudt-unit:MilliM)
                        }
                    }
                    ||
                    !EXISTS {
                        ?this nltl:permanentOutOfPlaneDeformation ?q .
                        ?q qudt:numericValue ?number ;
                           qudt:unit qudt-unit:MilliM .
                        FILTER NOT EXISTS {
                            ?q qudt:unit ?otherUnit .
                            FILTER (?otherUnit != qudt-unit:MilliM)
                        }
                    }
                    ||
                    !EXISTS {
                        ?this nltl:relevantStructuralDimension ?q .
                        ?q qudt:numericValue ?number ;
                           qudt:unit qudt-unit:MilliM .
                        FILTER NOT EXISTS {
                            ?q qudt:unit ?otherUnit .
                            FILTER (?otherUnit != qudt-unit:MilliM)
                        }
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-065-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F05/ship> ] .

