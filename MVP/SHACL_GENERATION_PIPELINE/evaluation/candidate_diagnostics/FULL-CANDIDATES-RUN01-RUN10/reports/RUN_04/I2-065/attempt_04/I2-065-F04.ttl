@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/calculation> ;
                    sh:resultMessage "A calculation case using the nonlinear calculation method must provide acceptance evidence, a satisfied minor permanent deformation assessment, and all six required quantity operands with their prescribed units." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "A calculation case using the nonlinear calculation method must provide acceptance evidence, a satisfied minor permanent deformation assessment, and all six required quantity operands with their prescribed units." ;
                            sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                        FILTER (
                            NOT EXISTS {
                                $this nltl:nonlinearAnalysisAcceptanceEvidence ?evidence .
                                ?evidence a nltl:evidenceArtifact .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:minorPermanentDeformationAssessmentSatisfied true .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:fractureMargin ?fracture .
                                ?fracture qudt:numericValue ?fractureNumber .
                                ?fracture qudt:unit qudt:UNITLESS .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:majorBucklingMargin ?buckling .
                                ?buckling qudt:numericValue ?bucklingNumber .
                                ?buckling qudt:unit qudt:UNITLESS .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:yieldingMargin ?yielding .
                                ?yielding qudt:numericValue ?yieldingNumber .
                                ?yielding qudt:unit qudt:UNITLESS .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:permanentLateralDeformation ?lateral .
                                ?lateral qudt:numericValue ?lateralNumber .
                                ?lateral qudt:unit qudt:MilliM .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:permanentOutOfPlaneDeformation ?outOfPlane .
                                ?outOfPlane qudt:numericValue ?outOfPlaneNumber .
                                ?outOfPlane qudt:unit qudt:MilliM .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:relevantStructuralDimension ?dimension .
                                ?dimension qudt:numericValue ?dimensionNumber .
                                ?dimension qudt:unit qudt:MilliM .
                            }
                        )
                    }
                """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:calculationCase ;
                            sh:sparql [ sh:message "A calculation case using the nonlinear calculation method must provide acceptance evidence, a satisfied minor permanent deformation assessment, and all six required quantity operands with their prescribed units." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                        FILTER (
                            NOT EXISTS {
                                $this nltl:nonlinearAnalysisAcceptanceEvidence ?evidence .
                                ?evidence a nltl:evidenceArtifact .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:minorPermanentDeformationAssessmentSatisfied true .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:fractureMargin ?fracture .
                                ?fracture qudt:numericValue ?fractureNumber .
                                ?fracture qudt:unit qudt:UNITLESS .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:majorBucklingMargin ?buckling .
                                ?buckling qudt:numericValue ?bucklingNumber .
                                ?buckling qudt:unit qudt:UNITLESS .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:yieldingMargin ?yielding .
                                ?yielding qudt:numericValue ?yieldingNumber .
                                ?yielding qudt:unit qudt:UNITLESS .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:permanentLateralDeformation ?lateral .
                                ?lateral qudt:numericValue ?lateralNumber .
                                ?lateral qudt:unit qudt:MilliM .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:permanentOutOfPlaneDeformation ?outOfPlane .
                                ?outOfPlane qudt:numericValue ?outOfPlaneNumber .
                                ?outOfPlane qudt:unit qudt:MilliM .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:relevantStructuralDimension ?dimension .
                                ?dimension qudt:numericValue ?dimensionNumber .
                                ?dimension qudt:unit qudt:MilliM .
                            }
                        )
                    }
                """ ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/calculation> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:class nltl:calculationCase ; sh:sparql [ sh:message Literal("A calculation case using the nonlinear calculation method must provide acceptance evidence, a satisfied minor permanent deformation assessment, and all six required quantity operands with their prescribed units.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                        FILTER (
                            NOT EXISTS {
                                $this nltl:nonlinearAnalysisAcceptanceEvidence ?evidence .
                                ?evidence a nltl:evidenceArtifact .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:minorPermanentDeformationAssessmentSatisfied true .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:fractureMargin ?fracture .
                                ?fracture qudt:numericValue ?fractureNumber .
                                ?fracture qudt:unit qudt:UNITLESS .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:majorBucklingMargin ?buckling .
                                ?buckling qudt:numericValue ?bucklingNumber .
                                ?buckling qudt:unit qudt:UNITLESS .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:yieldingMargin ?yielding .
                                ?yielding qudt:numericValue ?yieldingNumber .
                                ?yielding qudt:unit qudt:UNITLESS .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:permanentLateralDeformation ?lateral .
                                ?lateral qudt:numericValue ?lateralNumber .
                                ?lateral qudt:unit qudt:MilliM .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:permanentOutOfPlaneDeformation ?outOfPlane .
                                ?outOfPlane qudt:numericValue ?outOfPlaneNumber .
                                ?outOfPlane qudt:unit qudt:MilliM .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:relevantStructuralDimension ?dimension .
                                ?dimension qudt:numericValue ?dimensionNumber .
                                ?dimension qudt:unit qudt:MilliM .
                            }
                        )
                    }
                ") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:calculationCase ;
                            sh:sparql [ sh:message "A calculation case using the nonlinear calculation method must provide acceptance evidence, a satisfied minor permanent deformation assessment, and all six required quantity operands with their prescribed units." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                        FILTER (
                            NOT EXISTS {
                                $this nltl:nonlinearAnalysisAcceptanceEvidence ?evidence .
                                ?evidence a nltl:evidenceArtifact .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:minorPermanentDeformationAssessmentSatisfied true .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:fractureMargin ?fracture .
                                ?fracture qudt:numericValue ?fractureNumber .
                                ?fracture qudt:unit qudt:UNITLESS .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:majorBucklingMargin ?buckling .
                                ?buckling qudt:numericValue ?bucklingNumber .
                                ?buckling qudt:unit qudt:UNITLESS .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:yieldingMargin ?yielding .
                                ?yielding qudt:numericValue ?yieldingNumber .
                                ?yielding qudt:unit qudt:UNITLESS .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:permanentLateralDeformation ?lateral .
                                ?lateral qudt:numericValue ?lateralNumber .
                                ?lateral qudt:unit qudt:MilliM .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:permanentOutOfPlaneDeformation ?outOfPlane .
                                ?outOfPlane qudt:numericValue ?outOfPlaneNumber .
                                ?outOfPlane qudt:unit qudt:MilliM .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:relevantStructuralDimension ?dimension .
                                ?dimension qudt:numericValue ?dimensionNumber .
                                ?dimension qudt:unit qudt:MilliM .
                            }
                        )
                    }
                """ ] ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/calculation> ] .

