@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/weld2> ;
                    sh:resultMessage "Node ex:weld2 must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:withinIceStrengthenedArea ], [ sh:in ( nltl:doubleContinuousWeld ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:weldType ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"false\" = False, datatype=xsd:boolean) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:withinIceStrengthenedArea ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:or ( [ sh:property [ sh:in ( nltl:doubleContinuousWeld ) ;
                                                sh:minCount 1 ;
                                                sh:path nltl:weldType ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:in ( true ) ;
                                                sh:minCount 1 ;
                                                sh:path nltl:withinIceStrengthenedArea ] ] [ sh:property [ sh:datatype xsd:boolean ;
                                                sh:in ( false ) ;
                                                sh:minCount 1 ;
                                                sh:path nltl:withinIceStrengthenedArea ] ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/weld2> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:withinIceStrengthenedArea ], [ sh:in ( nltl:doubleContinuousWeld ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:weldType ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"false\" = False, datatype=xsd:boolean) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:withinIceStrengthenedArea ] ] ) ]. See details for more information." ;
            sh:resultPath nltl:hasWeld ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:weld ;
                    sh:node [ sh:or ( [ sh:property [ sh:in [ ] ;
                                                sh:minCount 1 ;
                                                sh:path nltl:weldType ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:in [ ] ;
                                                sh:minCount 1 ;
                                                sh:path nltl:withinIceStrengthenedArea ] ] [ sh:property [ sh:datatype xsd:boolean ;
                                                sh:in [ ] ;
                                                sh:minCount 1 ;
                                                sh:path nltl:withinIceStrengthenedArea ] ] ) ] ;
                    sh:path nltl:hasWeld ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/weld2> ] .

