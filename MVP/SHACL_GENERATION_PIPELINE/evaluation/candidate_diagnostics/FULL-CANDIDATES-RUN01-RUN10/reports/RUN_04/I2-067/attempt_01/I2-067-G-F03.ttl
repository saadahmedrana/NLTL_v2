@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F03/connection1> ;
                    sh:resultMessage "Each structural connection must record continuity of strength as true." ;
                    sh:resultPath nltl:strengthContinuityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n150f120914db40e2b07c82675c734b8bb3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F03/connection1> ;
                    sh:resultMessage "Each structural connection must record continuity of strength as true." ;
                    sh:resultPath nltl:strengthContinuityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n150f120914db40e2b07c82675c734b8bb3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Each structural connection must record continuity of strength as true.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:strengthContinuityStatus ] ]. See details for more information." ;
            sh:resultPath nltl:structuralConnection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:message "Each structural connection must record continuity of strength as true." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:strengthContinuityStatus ] ] ;
                    sh:path nltl:structuralConnection ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F03/connection1> ] .

_:n150f120914db40e2b07c82675c734b8bb3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "Each structural connection must record continuity of strength as true." ;
