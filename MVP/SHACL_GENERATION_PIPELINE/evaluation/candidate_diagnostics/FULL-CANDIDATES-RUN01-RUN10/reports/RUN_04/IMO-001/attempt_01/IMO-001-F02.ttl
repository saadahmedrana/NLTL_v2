@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-F02/ship> ;
            sh:resultMessage "A ship designed for at least medium first-year ice with possible old-ice inclusions must have ship category A and no other ship category." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship designed for at least medium first-year ice with possible old-ice inclusions must have ship category A and no other ship category." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceCondition
                    nltl:mediumFirstYearIceWithPossibleOldIceInclusions .
                FILTER (
                    NOT EXISTS {
                        $this nltl:shipCategory nltl:polarShipCategoryA .
                    }
                    ||
                    EXISTS {
                        $this nltl:shipCategory ?category .
                        FILTER (?category != nltl:polarShipCategoryA)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-001-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-F02/ship> ] .

