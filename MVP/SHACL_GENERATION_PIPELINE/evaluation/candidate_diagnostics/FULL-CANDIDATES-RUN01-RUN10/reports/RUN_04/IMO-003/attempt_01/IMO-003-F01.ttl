@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( nltl:openWaterIceCondition nltl:iceConditionLessSevereThanCategoryAAndB ) ; sh:nodeKind sh:IRI ; sh:path nltl:designIceCondition ], [ sh:in ( nltl:polarShipCategoryC ) ; sh:message Literal(\"A ship designed for open water or ice conditions less severe than categories A and B shall have Polar Ship Category C.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:shipCategory ] ] , [ sh:property [ sh:nodeKind sh:IRI ; sh:not [ sh:in ( nltl:openWaterIceCondition nltl:iceConditionLessSevereThanCategoryAAndB ) ] ; sh:path nltl:designIceCondition ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_003_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F01/ship> ] .

