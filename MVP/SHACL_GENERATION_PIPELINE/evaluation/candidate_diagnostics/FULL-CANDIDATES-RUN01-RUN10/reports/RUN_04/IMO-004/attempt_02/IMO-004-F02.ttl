@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F02/ship> ;
            sh:resultMessage "When the ice is sea ice, has no more than one winter growth, and is 0.3 m to 2.0 m thick, its classification must be exactly first-year ice." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the ice is sea ice, has no more than one winter growth, and is 0.3 m to 2.0 m thick, its classification must be exactly first-year ice." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceOriginType nltl:seaIceOrigin ;
                       nltl:winterGrowthCount ?growth ;
                       nltl:iceThickness ?thickness .
                ?thickness qudt:numericValue ?value ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (
                    xsd:decimal(?growth) <= "1"^^xsd:decimal &&
                    ?value >= "0.3"^^xsd:decimal &&
                    ?value <= "2.0"^^xsd:decimal
                )
                FILTER NOT EXISTS {
                    $this nltl:iceTypeClassification nltl:firstYearIce .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_004_Static> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F02/ship> ] .

