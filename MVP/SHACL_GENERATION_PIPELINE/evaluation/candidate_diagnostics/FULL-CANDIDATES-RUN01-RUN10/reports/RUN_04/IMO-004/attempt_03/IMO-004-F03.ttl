@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F03/ship> ;
            sh:resultMessage "When ice origin is sea ice, winter growth count and ice thickness must establish applicability, and ice type classification must be exactly firstYearIce." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When ice origin is sea ice, winter growth count and ice thickness must establish applicability, and ice type classification must be exactly firstYearIce." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceOriginType nltl:seaIceOrigin .
                FILTER (
                    NOT EXISTS {
                        $this nltl:winterGrowthCount ?growth .
                        FILTER (
                            datatype(?growth) = xsd:integer &&
                            ?growth <= 1
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceThickness ?thicknessNode .
                        ?thicknessNode qudt:numericValue ?thickness ;
                            qudt:unit unit:M .
                        FILTER (
                            datatype(?thickness) = xsd:decimal &&
                            ?thickness >= "0.3"^^xsd:decimal &&
                            ?thickness <= "2.0"^^xsd:decimal
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceTypeClassification nltl:firstYearIce .
                    }
                    ||
                    EXISTS {
                        $this nltl:iceTypeClassification ?classification .
                        FILTER (?classification != nltl:firstYearIce)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_004_Static ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F03/ship> ] .

