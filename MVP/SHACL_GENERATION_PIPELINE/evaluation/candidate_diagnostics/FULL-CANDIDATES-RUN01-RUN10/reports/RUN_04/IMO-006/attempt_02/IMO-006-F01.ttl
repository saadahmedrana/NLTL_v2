@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-006-F01/ship> ;
            sh:resultMessage "Every ice thickness for a ship classified as medium first-year ice must be a qudt:QuantityValue in metres and must be between 0.7 m and 1.2 m inclusive." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Every ice thickness for a ship classified as medium first-year ice must be a qudt:QuantityValue in metres and must be between 0.7 m and 1.2 m inclusive." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceTypeClassification nltl:mediumFirstYearIce .
                $this nltl:iceThickness ?thickness .
                FILTER (
                    NOT EXISTS {
                        ?thickness a qudt:QuantityValue .
                    }
                    ||
                    NOT EXISTS {
                        ?thickness qudt:numericValue ?numericValue .
                    }
                    ||
                    NOT EXISTS {
                        ?thickness qudt:unit unit:M .
                    }
                    ||
                    EXISTS {
                        ?thickness qudt:unit ?otherUnit .
                        FILTER (?otherUnit != unit:M)
                    }
                    ||
                    EXISTS {
                        ?thickness qudt:numericValue ?outOfRangeValue .
                        FILTER (
                            ?outOfRangeValue < "0.7"^^xsd:decimal
                            ||
                            ?outOfRangeValue > "1.2"^^xsd:decimal
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-006-Static> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-006-F01/ship> ] .

