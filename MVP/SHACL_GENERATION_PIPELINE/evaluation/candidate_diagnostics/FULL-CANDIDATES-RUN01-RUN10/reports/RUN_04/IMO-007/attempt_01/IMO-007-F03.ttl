@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F03/ship> ;
            sh:resultMessage "For an open-water ice condition, sea ice concentration must be a decimal less than 1 with unitless units, and ice of land origin must be false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an open-water ice condition, sea ice concentration must be a decimal less than 1 with unitless units, and ice of land origin must be false." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qv: <http://qudt.org/schema/qudt/>
PREFIX qudtunit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?this
WHERE {
    ?this nltl:iceConditionClassification ?condition .
    FILTER (?condition = nltl:openWaterIceCondition)
    FILTER (
        NOT EXISTS {
            ?this nltl:seaIceConcentration ?quantity .
            ?quantity qv:numericValue ?concentration ;
                      qv:unit qudtunit:UNITLESS .
            ?this nltl:iceOfLandOriginPresent ?landOrigin .
            FILTER (
                datatype(?concentration) = xsd:decimal &&
                ?concentration < 1 &&
                datatype(?landOrigin) = xsd:boolean &&
                ?landOrigin = false
            )
        }
        ||
        EXISTS {
            ?this nltl:seaIceConcentration ?quantity .
            FILTER NOT EXISTS {
                ?quantity qv:numericValue ?concentration .
                FILTER (
                    datatype(?concentration) = xsd:decimal &&
                    ?concentration < 1
                )
            }
        }
        ||
        EXISTS {
            ?this nltl:seaIceConcentration ?quantity .
            ?quantity qv:unit ?unit .
            FILTER (?unit != qudtunit:UNITLESS)
        }
        ||
        EXISTS {
            ?this nltl:iceOfLandOriginPresent ?landOrigin .
            FILTER (!(
                datatype(?landOrigin) = xsd:boolean &&
                ?landOrigin = false
            ))
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_007_OpenWaterShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F03/ship> ] .

