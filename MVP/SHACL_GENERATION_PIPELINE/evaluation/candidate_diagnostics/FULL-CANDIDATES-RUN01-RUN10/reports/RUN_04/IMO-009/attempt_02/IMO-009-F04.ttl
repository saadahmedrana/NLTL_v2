@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F04/ship> ;
            sh:resultMessage "For bergy waters, every supplied land-origin ice concentration must be a dimensionless decimal quantity less than 1, and at least one valid quantity must be supplied; every supplied total ice concentration must be a dimensionless decimal quantity no greater than 1, and at least one valid quantity must be supplied." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For bergy waters, every supplied land-origin ice concentration must be a dimensionless decimal quantity less than 1, and at least one valid quantity must be supplied; every supplied total ice concentration must be a dimensionless decimal quantity no greater than 1, and at least one valid quantity must be supplied." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:iceCondition ?condition .
    FILTER (?condition = "bergy waters"^^xsd:string)

    FILTER (
        NOT EXISTS {
            $this nltl:landOriginIceConcentration ?landQuantity .
        }
        ||
        EXISTS {
            $this nltl:landOriginIceConcentration ?landQuantity .
            FILTER NOT EXISTS {
                ?landQuantity a qudt:QuantityValue .
            }
        }
        ||
        EXISTS {
            $this nltl:landOriginIceConcentration ?landQuantity .
            FILTER NOT EXISTS {
                ?landQuantity qudt:numericValue ?landValue .
            }
        }
        ||
        EXISTS {
            $this nltl:landOriginIceConcentration ?landQuantity .
            ?landQuantity qudt:numericValue ?landValue .
            FILTER (datatype(?landValue) != xsd:decimal)
        }
        ||
        EXISTS {
            $this nltl:landOriginIceConcentration ?landQuantity .
            FILTER NOT EXISTS {
                ?landQuantity qudt:unit unit:UNITLESS .
            }
        }
        ||
        EXISTS {
            $this nltl:landOriginIceConcentration ?landQuantity .
            ?landQuantity qudt:unit ?landUnit .
            FILTER (?landUnit != unit:UNITLESS)
        }
        ||
        EXISTS {
            $this nltl:landOriginIceConcentration ?landQuantity .
            ?landQuantity qudt:numericValue ?landValue .
            FILTER (datatype(?landValue) = xsd:decimal && ?landValue >= 1)
        }
        ||
        NOT EXISTS {
            $this nltl:landOriginIceConcentration ?landQuantity .
            ?landQuantity a qudt:QuantityValue ;
                qudt:numericValue ?landValue ;
                qudt:unit unit:UNITLESS .
            FILTER (datatype(?landValue) = xsd:decimal && ?landValue < 1)
        }
        ||
        NOT EXISTS {
            $this nltl:totalIceConcentration ?totalQuantity .
        }
        ||
        EXISTS {
            $this nltl:totalIceConcentration ?totalQuantity .
            FILTER NOT EXISTS {
                ?totalQuantity a qudt:QuantityValue .
            }
        }
        ||
        EXISTS {
            $this nltl:totalIceConcentration ?totalQuantity .
            FILTER NOT EXISTS {
                ?totalQuantity qudt:numericValue ?totalValue .
            }
        }
        ||
        EXISTS {
            $this nltl:totalIceConcentration ?totalQuantity .
            ?totalQuantity qudt:numericValue ?totalValue .
            FILTER (datatype(?totalValue) != xsd:decimal)
        }
        ||
        EXISTS {
            $this nltl:totalIceConcentration ?totalQuantity .
            FILTER NOT EXISTS {
                ?totalQuantity qudt:unit unit:UNITLESS .
            }
        }
        ||
        EXISTS {
            $this nltl:totalIceConcentration ?totalQuantity .
            ?totalQuantity qudt:unit ?totalUnit .
            FILTER (?totalUnit != unit:UNITLESS)
        }
        ||
        EXISTS {
            $this nltl:totalIceConcentration ?totalQuantity .
            ?totalQuantity qudt:numericValue ?totalValue .
            FILTER (datatype(?totalValue) = xsd:decimal && ?totalValue > 1)
        }
        ||
        NOT EXISTS {
            $this nltl:totalIceConcentration ?totalQuantity .
            ?totalQuantity a qudt:QuantityValue ;
                qudt:numericValue ?totalValue ;
                qudt:unit unit:UNITLESS .
            FILTER (datatype(?totalValue) = xsd:decimal && ?totalValue <= 1)
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_009_Static> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F04/ship> ] .

