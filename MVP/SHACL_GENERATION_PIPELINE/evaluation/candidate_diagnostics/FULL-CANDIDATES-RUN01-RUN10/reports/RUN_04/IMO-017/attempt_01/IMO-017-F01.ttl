@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F01/ship> ;
            sh:resultMessage "Each SOLAS certificate schedule date shall match the corresponding Polar Ship Certificate date category and date." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each SOLAS certificate schedule date shall match the corresponding Polar Ship Certificate date category and date." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
  $this nltl:hasSolasCertificateSchedule ?schedule .
  ?schedule nltl:hasCertificateScheduleDateRecord ?record .
  ?record nltl:certificateScheduleDate ?date ;
          nltl:certificateScheduleDateType ?category .
  FILTER (
    (?category = nltl:validityDateCategory &&
     NOT EXISTS { $this nltl:polarCertificateValidityDates ?date }) ||
    (?category = nltl:surveyDateCategory &&
     NOT EXISTS { $this nltl:surveyDates ?date }) ||
    (?category = nltl:endorsementDateCategory &&
     NOT EXISTS { $this nltl:endorsementDates ?date })
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO017ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F01/ship> ;
            sh:resultMessage "Each Polar Ship Certificate validity date shall match a validity date in the applicable SOLAS certificate schedule." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each Polar Ship Certificate validity date shall match a validity date in the applicable SOLAS certificate schedule." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
  $this nltl:polarCertificateValidityDates ?date .
  FILTER NOT EXISTS {
    $this nltl:hasSolasCertificateSchedule ?schedule .
    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
    ?record nltl:certificateScheduleDateType nltl:validityDateCategory ;
            nltl:certificateScheduleDate ?date .
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO017ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F01/ship> ] .

