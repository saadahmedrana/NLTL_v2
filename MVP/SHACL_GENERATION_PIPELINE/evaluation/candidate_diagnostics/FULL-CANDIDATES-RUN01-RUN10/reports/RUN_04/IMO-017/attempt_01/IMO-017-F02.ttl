@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ;
            sh:resultMessage "Each Polar Ship Certificate validity date shall match a validity date in the applicable SOLAS certificate schedule." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each Polar Ship Certificate validity date shall match a validity date in the applicable SOLAS certificate schedule." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
  $this nltl:polarCertificateValidityDates ?date .
  FILTER NOT EXISTS {
    $this nltl:hasSolasCertificateSchedule ?schedule .
    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
    ?record nltl:certificateScheduleDateType nltl:validityDateCategory ;
            nltl:certificateScheduleDate ?date .
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO017ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ;
            sh:resultMessage "The ship shall have an applicable SOLAS certificate schedule." ;
            sh:resultPath nltl:hasSolasCertificateSchedule ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:solasCertificateSchedule ;
                    sh:message "The ship shall have an applicable SOLAS certificate schedule." ;
                    sh:minCount 1 ;
                    sh:node gs:IMO017SolasScheduleShape ;
                    sh:path nltl:hasSolasCertificateSchedule ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ;
            sh:resultMessage "Each Polar Ship Certificate survey date shall match a survey date in the applicable SOLAS certificate schedule." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each Polar Ship Certificate survey date shall match a survey date in the applicable SOLAS certificate schedule." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
  $this nltl:surveyDates ?date .
  FILTER NOT EXISTS {
    $this nltl:hasSolasCertificateSchedule ?schedule .
    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
    ?record nltl:certificateScheduleDateType nltl:surveyDateCategory ;
            nltl:certificateScheduleDate ?date .
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO017ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ;
            sh:resultMessage "Each Polar Ship Certificate endorsement date shall match an endorsement date in the applicable SOLAS certificate schedule." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each Polar Ship Certificate endorsement date shall match an endorsement date in the applicable SOLAS certificate schedule." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
  $this nltl:endorsementDates ?date .
  FILTER NOT EXISTS {
    $this nltl:hasSolasCertificateSchedule ?schedule .
    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
    ?record nltl:certificateScheduleDateType nltl:endorsementDateCategory ;
            nltl:certificateScheduleDate ?date .
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO017ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ] .

