@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/ship> ;
            sh:resultMessage "Each Polar Ship Certificate survey date shall match a survey date in the applicable SOLAS certificate schedule." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each Polar Ship Certificate survey date shall match a survey date in the applicable SOLAS certificate schedule." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
  $this nltl:surveyDates ?date .
  FILTER NOT EXISTS {
    $this nltl:hasSolasCertificateSchedule ?schedule .
    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
    ?record nltl:certificateScheduleDateType nltl:surveyDateCategory ;
            nltl:certificateScheduleDate ?date .
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO017ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/ship> ] .

