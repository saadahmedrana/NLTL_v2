@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-018-F01/ship> ;
            sh:resultMessage "When ice capability methodology is applicable, the certificate methodology reference and administration acceptance status must both be true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When ice capability methodology is applicable, the certificate methodology reference and administration acceptance status must both be true." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceCapabilityMethodologyApplicable ?applicable .
                FILTER (datatype(?applicable) = xsd:boolean && ?applicable = true)

                FILTER (
                    NOT EXISTS {
                        $this nltl:certificateMethodologyReferencePresent ?referencePresent .
                        FILTER (datatype(?referencePresent) = xsd:boolean && ?referencePresent = true)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:administrationAcceptanceStatus ?accepted .
                        FILTER (datatype(?accepted) = xsd:boolean && ?accepted = true)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-018> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-018-F01/ship> ] .

