@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-025-F02/ship> ;
            sh:resultMessage "The ship shall carry the Polar Water Operational Manual on board." ;
            sh:resultPath nltl:polarWaterOperationalManualPresentOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:neeca55861f954ff9b5cf834c7affef59b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-025-F02/ship> ;
            sh:resultMessage "The ship shall carry the Polar Water Operational Manual on board." ;
            sh:resultPath nltl:polarWaterOperationalManualPresentOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:neeca55861f954ff9b5cf834c7affef59b1 ] .

_:neeca55861f954ff9b5cf834c7affef59b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall carry the Polar Water Operational Manual on board." ;
    sh:minCount 1 ;
    sh:path nltl:polarWaterOperationalManualPresentOnBoard .

