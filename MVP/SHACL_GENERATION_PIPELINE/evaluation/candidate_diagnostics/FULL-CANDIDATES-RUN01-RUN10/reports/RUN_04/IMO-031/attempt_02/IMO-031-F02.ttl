@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F02/ship> ;
            sh:resultMessage "The approval standard must be acceptable to the Organization or offer an equivalent level of safety." ;
            sh:resultPath nltl:approvalStandard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "standard acceptable to the Organization"^^xsd:string "another standard offering an equivalent level of safety"^^xsd:string ) ;
                    sh:message "The approval standard must be acceptable to the Organization or offer an equivalent level of safety." ;
                    sh:path nltl:approvalStandard ] ;
            sh:value "uncontrolled internal standard"^^xsd:string ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F02/ship> ;
            sh:resultMessage "Each represented exposed-structure material must have an approved status, an authorized approving authority, an authorized approval standard, and a polar service temperature basis." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each represented exposed-structure material must have an approved status, an authorized approving authority, an authorized approval standard, and a polar service temperature basis." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:exposedStructureMaterial ?material .
                FILTER (
                    NOT EXISTS {
                        $this nltl:approvingAuthority ?authority .
                        FILTER (
                            ?authority IN (
                                "Administration"^^xsd:string,
                                "recognized organization accepted by the Administration"^^xsd:string
                            )
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:approvalStandard ?standard .
                        FILTER (
                            ?standard IN (
                                "standard acceptable to the Organization"^^xsd:string,
                                "another standard offering an equivalent level of safety"^^xsd:string
                            )
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:materialApprovalStatus nltl:evidenceStateApproved .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:polarServiceTemperature ?pst .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_031_MaterialApprovalShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F02/ship> ] .

