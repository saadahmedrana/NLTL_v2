@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-041-F03/ship> ;
            sh:resultMessage "Opening actuation type must be provided to determine whether the hydraulic-fluid protection condition applies." ;
            sh:resultPath nltl:openingActuationType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "Opening actuation type must be provided to determine whether the hydraulic-fluid protection condition applies." ;
                    sh:minCount 1 ;
                    sh:path nltl:openingActuationType ] ] .

