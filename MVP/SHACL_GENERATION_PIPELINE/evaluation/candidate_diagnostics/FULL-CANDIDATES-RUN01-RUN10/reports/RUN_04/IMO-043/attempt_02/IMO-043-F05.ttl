@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/mainMachineryEquipment> ;
                            sh:resultMessage "Each associated equipment item shall be linked to a machinery installation having hazard protection evidence." ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                                    sh:message "Each associated equipment item shall be linked to a machinery installation having hazard protection evidence." ;
                                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    ?installation nltl:hasAssociatedEquipment $this .
                    ?installation nltl:hasHazardProtectionEvidence ?evidence .
                }
            }
        """ ] ;
                            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                            sh:sourceShape <urn:nltl:generated-shape:IMO-043-AssociatedEquipmentShape> ;
                            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/mainMachineryEquipment> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/mainMachinery> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-043-AssociatedEquipmentShape>. See details for more information." ;
                    sh:resultPath nltl:hasAssociatedEquipment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:associatedEquipmentItem ;
                            sh:node <urn:nltl:generated-shape:IMO-043-AssociatedEquipmentShape> ;
                            sh:path nltl:hasAssociatedEquipment ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/mainMachineryEquipment> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/mainMachinery> ;
                    sh:resultMessage "Each machinery installation shall have evidence substantiating its hazard protection coverage." ;
                    sh:resultPath nltl:hasHazardProtectionEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:message "Each machinery installation shall have evidence substantiating its hazard protection coverage." ;
                            sh:minCount 1 ;
                            sh:path nltl:hasHazardProtectionEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-043-MachineryInstallationShape>. See details for more information." ;
            sh:resultPath nltl:hasMachineryInstallation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:machineryInstallationItem ;
                    sh:node <urn:nltl:generated-shape:IMO-043-MachineryInstallationShape> ;
                    sh:path nltl:hasMachineryInstallation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/mainMachinery> ] .

