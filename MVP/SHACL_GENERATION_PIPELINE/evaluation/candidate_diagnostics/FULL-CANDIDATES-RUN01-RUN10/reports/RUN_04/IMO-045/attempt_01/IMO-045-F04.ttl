@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F04/ship> ;
            sh:resultMessage "The ship must state whether a machinery seawater supply exists." ;
            sh:resultPath nltl:machinerySeawaterSupply ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ship must state whether a machinery seawater supply exists." ;
                    sh:minCount 1 ;
                    sh:path nltl:machinerySeawaterSupply ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F04/ship> ;
            sh:resultMessage "A machinery seawater supply must have ice-ingestion prevention or an approved alternate functionality arrangement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_045_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F04/ship> ] .

