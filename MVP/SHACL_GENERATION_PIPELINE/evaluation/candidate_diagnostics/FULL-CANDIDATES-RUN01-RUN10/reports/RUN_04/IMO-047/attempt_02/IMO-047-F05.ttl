@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F05/ship> ;
            sh:resultMessage "For each ship with an essential engine, combustion-air temperature control must be present and the combustion-air temperature must be within the manufacturer minimum and maximum criteria, using Celsius quantity values." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For each ship with an essential engine, combustion-air temperature control must be present and the combustion-air temperature must be within the manufacturer minimum and maximum criteria, using Celsius quantity values." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasEssentialEngine ?engine .
                FILTER NOT EXISTS {
                    $this nltl:combustionAirTemperatureControlPresent true .
                    $this nltl:combustionAirTemperature ?temperatureNode .
                    ?temperatureNode qudt:numericValue ?temperature ;
                        qudt:unit unit:DEG_C .
                    $this nltl:manufacturerMinAirTemperature ?minimumNode .
                    ?minimumNode qudt:numericValue ?minimum ;
                        qudt:unit unit:DEG_C .
                    $this nltl:manufacturerMaxAirTemperature ?maximumNode .
                    ?maximumNode qudt:numericValue ?maximum ;
                        qudt:unit unit:DEG_C .
                    FILTER(
                        datatype(?temperature) = xsd:decimal &&
                        datatype(?minimum) = xsd:decimal &&
                        datatype(?maximum) = xsd:decimal &&
                        ?temperature >= ?minimum &&
                        ?temperature <= ?maximum
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-047> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F05/ship> ] .

