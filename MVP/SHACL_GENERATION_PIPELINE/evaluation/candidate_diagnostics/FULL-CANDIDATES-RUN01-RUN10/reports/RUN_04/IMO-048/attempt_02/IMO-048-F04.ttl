@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F04/ship> ;
            sh:resultMessage "When exposed machinery or foundation material is present, approved authority, accepted or equivalent-safety standard, approved status, and polar service temperature basis are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-048-ExposedMaterialApprovalShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F04/ship> ] .

