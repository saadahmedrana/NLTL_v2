@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:exposedMachineryOrFoundationMaterial ] ] , [ sh:property [ sh:datatype xsd:string ; sh:in ( Literal(\"Administration\", datatype=xsd:string) Literal(\"recognized organization accepted by the Administration\", datatype=xsd:string) ) ; sh:message Literal(\"Each applicable exposed material shall have an authorized approving authority.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:approvingAuthority ], [ sh:datatype xsd:string ; sh:in ( Literal(\"standard acceptable to the Organization\", datatype=xsd:string) Literal(\"another standard offering an equivalent level of safety\", datatype=xsd:string) ) ; sh:message Literal(\"Each applicable exposed material shall have an accepted or equivalent-safety approval standard.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:approvalStandard ], [ sh:datatype xsd:string ; sh:message Literal(\"Each applicable ship shall identify exposed machinery or foundation material.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:exposedMachineryOrFoundationMaterial ], [ sh:in ( nltl:evidenceStateApproved ) ; sh:message Literal(\"Each applicable exposed material shall have approved material evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:materialApprovalStatus ], [ sh:message Literal(\"The applicable approval evidence shall preserve the polar service temperature basis in degrees Celsius.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG_C ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:polarServiceTemperature ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_048_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F02/ship> ] .

