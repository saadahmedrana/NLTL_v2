@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/ship> ;
            sh:resultMessage "The machinery component type selector is required to identify applicable components." ;
            sh:resultPath nltl:machineryComponentType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The machinery component type selector is required to identify applicable components." ;
                    sh:minCount 1 ;
                    sh:path nltl:machineryComponentType ] ] .

