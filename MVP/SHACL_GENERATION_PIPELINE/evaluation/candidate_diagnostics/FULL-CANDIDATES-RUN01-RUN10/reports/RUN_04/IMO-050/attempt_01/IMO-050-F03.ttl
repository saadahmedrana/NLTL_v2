@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-050-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:fireSafetyComponentExposed ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Exposed fire safety components must have ice and snow protection.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAndSnowProtectionPresent ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:fireSafetyComponentExposed ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-050-FireSafetyExposureProtectionShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-050-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-050-F03/ship> ;
            sh:resultMessage "Fire safety component exposure status must be recorded as a single boolean value." ;
            sh:resultPath nltl:fireSafetyComponentExposed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Fire safety component exposure status must be recorded as a single boolean value." ;
                    sh:minCount 1 ;
                    sh:path nltl:fireSafetyComponentExposed ] ] .

