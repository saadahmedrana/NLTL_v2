@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F03/control1> ;
                    sh:resultMessage "Each linked local control item must remain continuously accessible." ;
                    sh:resultPath nltl:localControlContinuouslyAccessible ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "Each linked local control item must remain continuously accessible." ;
                            sh:minCount 1 ;
                            sh:path nltl:localControlContinuouslyAccessible ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F03/control1> ;
                    sh:resultMessage "Each linked local control item must have freezing, snow, and ice protection present." ;
                    sh:resultPath nltl:localControlProtectionPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "Each linked local control item must have freezing, snow, and ice protection present." ;
                            sh:minCount 1 ;
                            sh:path nltl:localControlProtectionPresent ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:localControlItem ; sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"Each linked local control item must have freezing, snow, and ice protection present.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:localControlProtectionPresent ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"Each linked local control item must remain continuously accessible.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:localControlContinuouslyAccessible ] ]. See details for more information." ;
            sh:resultPath nltl:hasLocalControlItem ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:localControlItem ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:in ( true ) ;
                                    sh:message "Each linked local control item must remain continuously accessible." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:localControlContinuouslyAccessible ],
                                [ sh:datatype xsd:boolean ;
                                    sh:in ( true ) ;
                                    sh:message "Each linked local control item must have freezing, snow, and ice protection present." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:localControlProtectionPresent ] ] ;
                    sh:path nltl:hasLocalControlItem ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F03/control1> ] .

