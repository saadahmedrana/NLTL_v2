@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-P01/waterMist> ;
                    sh:resultMessage "Each extinguishing medium must have approved intended-operation compatibility." ;
                    sh:resultPath nltl:extinguishingMediumCompatibilityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nd9a6efa6b9e74f878043e6ddebdf31bbb2 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-P01/waterMist> ;
                    sh:resultMessage "Each extinguishing medium must have approved intended-operation compatibility." ;
                    sh:resultPath nltl:extinguishingMediumCompatibilityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nd9a6efa6b9e74f878043e6ddebdf31bbb2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-P01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-053-ExtinguishingMediumItemShape>. See details for more information." ;
            sh:resultPath nltl:hasExtinguishingMedium ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-053-ExtinguishingMediumItemShape> ;
                    sh:path nltl:hasExtinguishingMedium ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-P01/waterMist> ] .

_:nd9a6efa6b9e74f878043e6ddebdf31bbb2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Each extinguishing medium must have approved intended-operation compatibility." ;
    sh:minCount 1 ;
    sh:path nltl:extinguishingMediumCompatibilityStatus .

