@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Exposed isolating, pressure, or vacuum valves shall be protected from ice accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAccretionProtectionPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Exposed isolating, pressure, or vacuum valves shall remain continuously accessible.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:continuouslyAccessible ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:valveExposed ], [ sh:in ( Literal(\"isolating\", datatype=xsd:string) Literal(\"pressure\", datatype=xsd:string) Literal(\"vacuum\", datatype=xsd:string) ) ; sh:path nltl:valveType ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:valveExposed ] ] , [ sh:property [ sh:not [ sh:in ( Literal(\"isolating\", datatype=xsd:string) Literal(\"pressure\", datatype=xsd:string) Literal(\"vacuum\", datatype=xsd:string) ) ] ; sh:path nltl:valveType ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-055> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-F01/ship> ] .

