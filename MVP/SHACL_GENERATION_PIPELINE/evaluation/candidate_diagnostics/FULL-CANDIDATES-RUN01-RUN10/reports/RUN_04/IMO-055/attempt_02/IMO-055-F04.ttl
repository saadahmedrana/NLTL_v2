@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-F04/ship> ;
            sh:resultMessage "The ship must provide valve applicability evidence and, for exposed isolating, pressure, or vacuum valves, ice-accretion protection and continuous accessibility." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:IMO_055_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-F04/ship> ] .

