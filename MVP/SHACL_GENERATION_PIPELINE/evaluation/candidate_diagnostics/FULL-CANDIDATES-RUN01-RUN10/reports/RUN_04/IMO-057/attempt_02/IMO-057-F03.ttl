@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-057-F03/ship> ;
            sh:resultMessage "Every linked fire pump must have a containing compartment maintained above 0 deg C." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Every linked fire pump must have a containing compartment maintained above 0 deg C." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasComponent ?pump .
                ?pump a ?pumpType .
                FILTER (
                    ?pumpType IN (
                        nltl:firePump,
                        nltl:emergencyFirePump,
                        nltl:waterMistPump,
                        nltl:waterSprayPump
                    )
                )
                FILTER (
                    NOT EXISTS {
                        ?pump nltl:hasContainingCompartment ?missingCompartment
                    }
                    ||
                    EXISTS {
                        ?pump nltl:hasContainingCompartment ?compartment .
                        FILTER NOT EXISTS {
                            ?compartment nltl:maintainedTemperature ?temperature .
                            ?temperature a qudt:QuantityValue ;
                                qudt:unit unit:DEG_C ;
                                qudt:numericValue ?value .
                            FILTER (?value > 0)
                        }
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO057StaticShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-057-F03/ship> ] .

