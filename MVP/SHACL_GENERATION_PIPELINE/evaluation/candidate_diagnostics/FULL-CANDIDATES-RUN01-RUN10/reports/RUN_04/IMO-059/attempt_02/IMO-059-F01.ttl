@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F01/outfit1ColdClass> ;
                                    sh:resultMessage "Node ex:outfit1ColdClass value is not a in the set of values: ['nltl:warmStorageLocation']" ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape [ a sh:NodeShape ;
                                            sh:class nltl:storageTemperatureClassValue ;
                                            sh:hasValue nltl:warmStorageLocation ] ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F01/outfit1Store> ;
                            sh:resultMessage "Each firefighter outfit storage location must have the warm storage temperature class." ;
                            sh:resultPath nltl:storageTemperatureClass ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:message "Each firefighter outfit storage location must have the warm storage temperature class." ;
                                    sh:node [ a sh:NodeShape ;
                                            sh:class nltl:storageTemperatureClassValue ;
                                            sh:hasValue nltl:warmStorageLocation ] ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:storageTemperatureClass ] ;
                            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F01/outfit1ColdClass> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F01/outfit1> ;
                    sh:resultMessage "Each firefighter outfit must have a physical storage location classified as warm." ;
                    sh:resultPath nltl:hasStorageLocation ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Each firefighter outfit must have a physical storage location classified as warm." ;
                            sh:node [ a sh:NodeShape ;
                                    sh:class nltl:physicalStorageLocation ;
                                    sh:property [ sh:message "Each firefighter outfit storage location must have the warm storage temperature class." ;
                                            sh:node [ a sh:NodeShape ;
                                                    sh:class nltl:storageTemperatureClassValue ;
                                                    sh:hasValue nltl:warmStorageLocation ] ;
                                            sh:nodeKind sh:IRI ;
                                            sh:path nltl:storageTemperatureClass ] ] ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:hasStorageLocation ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F01/outfit1Store> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F01/ship> ;
            sh:resultMessage "Each linked firefighter outfit must be represented as an equipment item with a warm physical storage location." ;
            sh:resultPath nltl:hasFirefighterOutfit ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked firefighter outfit must be represented as an equipment item with a warm physical storage location." ;
                    sh:node [ a sh:NodeShape ;
                            sh:class nltl:equipmentItem,
                                nltl:firefighterOutfitItem ;
                            sh:property [ sh:message "Each firefighter outfit must have a physical storage location classified as warm." ;
                                    sh:node [ a sh:NodeShape ;
                                            sh:class nltl:physicalStorageLocation ;
                                            sh:property [ sh:message "Each firefighter outfit storage location must have the warm storage temperature class." ;
                                                    sh:node [ ] ;
                                                    sh:nodeKind sh:IRI ;
                                                    sh:path nltl:storageTemperatureClass ] ] ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:hasStorageLocation ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasFirefighterOutfit ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F01/outfit1> ] .

