@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F04/outfit2Store> ;
            sh:resultMessage "The storage location for each firefighter outfit must be classified as warm." ;
            sh:resultPath nltl:storageTemperatureClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:class nltl:storageTemperatureClassValue ;
                    sh:hasValue nltl:warmStorageLocation ;
                    sh:maxCount 1 ;
                    sh:message "The storage location for each firefighter outfit must be classified as warm." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:storageTemperatureClass ] ] .

