@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F09/ship> ;
            sh:resultMessage "Survival support duration must be at least the maximum expected rescue time." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Survival support duration must be at least the maximum expected rescue time." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:survivalSupportDuration ?supportQuantity .
                ?supportQuantity qudt:numericValue ?supportValue .
                $this nltl:maximumExpectedRescueTime ?rescueQuantity .
                ?rescueQuantity qudt:numericValue ?rescueValue .
                FILTER (
                    datatype(?supportValue) = xsd:decimal &&
                    datatype(?rescueValue) = xsd:decimal &&
                    ?supportValue >= ?rescueValue
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_065_SurvivalResourceCoverageShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F09/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F09/survivalSupportDurationValue> ;
                    sh:resultMessage "Node ex:survivalSupportDurationValue->qudt:unit does not contain a value in the set: ['qudt:DAY']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:DAY ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F09/ship> ;
            sh:resultMessage "The survival support duration must be supplied in days." ;
            sh:resultPath nltl:survivalSupportDuration ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The survival support duration must be supplied in days." ;
                    sh:minCount 1 ;
                    sh:node gen:SurvivalSupportDurationQuantityShape ;
                    sh:path nltl:survivalSupportDuration ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F09/survivalSupportDurationValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F09/maximumExpectedRescueTimeValue> ;
                    sh:resultMessage "Node ex:maximumExpectedRescueTimeValue->qudt:unit does not contain a value in the set: ['qudt:DAY']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:DAY ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F09/ship> ;
            sh:resultMessage "The maximum expected rescue time must be supplied in days." ;
            sh:resultPath nltl:maximumExpectedRescueTime ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The maximum expected rescue time must be supplied in days." ;
                    sh:minCount 1 ;
                    sh:node gen:MaximumExpectedRescueTimeQuantityShape ;
                    sh:path nltl:maximumExpectedRescueTime ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F09/maximumExpectedRescueTimeValue> ] .

