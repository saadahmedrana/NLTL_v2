@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipExposedToIceAccretion ] ] , [ sh:property [ sh:class nltl:protectedItem ; sh:message Literal("At least one embarkation area protected item with ice or snow removal or prevention means is required.") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal("1", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO_066_EmbarkationAreaCoverageShape ], [ sh:class nltl:protectedItem ; sh:message Literal("At least one escape route protected item with ice or snow removal or prevention means is required.") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal("1", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO_066_EscapeRouteCoverageShape ], [ sh:class nltl:protectedItem ; sh:message Literal("At least one launching appliance protected item with ice or snow removal or prevention means is required.") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal("1", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO_066_LaunchingApplianceCoverageShape ], [ sh:class nltl:protectedItem ; sh:message Literal("At least one muster station protected item with ice or snow removal or prevention means is required.") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal("1", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO_066_MusterStationCoverageShape ], [ sh:class nltl:protectedItem ; sh:message Literal("At least one survival craft protected item with ice or snow removal or prevention means is required.") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal("1", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO_066_SurvivalCraftCoverageShape ], [ sh:class nltl:protectedItem ; sh:message Literal("At least one survival-craft access protected item with ice or snow removal or prevention means is required.") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal("1", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO_066_SurvivalCraftAccessCoverageShape ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipExposedToIceAccretion ] ; sh:sparql [ sh:message Literal("Every represented required protected item must have associated ice or snow removal or prevention means.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasProtectedItem ?item .
                        ?item nltl:protectedItemCategory ?category .
                        FILTER (
                            ?category IN (
                                nltl:escapeRouteProtectedItem,
                                nltl:musterStationProtectedItem,
                                nltl:embarkationAreaProtectedItem,
                                nltl:survivalCraftProtectedItem,
                                nltl:launchingApplianceProtectedItem,
                                nltl:survivalCraftAccessProtectedItem
                            )
                        )
                        FILTER NOT EXISTS {
                            ?item nltl:hasIceSnowRemovalOrPreventionMeans ?means .
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_066_ShipIceAccretionShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F04/ship> ] .

