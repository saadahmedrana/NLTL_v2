@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "Each passenger ship shall record that the assigned survival equipment is properly sized." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd60aa55139e249449be38c563bc32dafb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "Each passenger ship shall record that the assigned survival equipment is properly sized." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nd60aa55139e249449be38c563bc32dafb1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/person1> ;
                    sh:resultMessage "Each person on board shall have exactly one personal survival equipment assignment." ;
                    sh:resultPath nltl:hasPersonalSurvivalEquipmentAssignment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:personalSurvivalEquipmentAssignment ;
                            sh:maxCount 1 ;
                            sh:message "Each person on board shall have exactly one personal survival equipment assignment." ;
                            sh:minCount 1 ;
                            sh:node gen:IMO_070_AssignmentShape ;
                            sh:path nltl:hasPersonalSurvivalEquipmentAssignment ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO_070_PersonOnBoardMemberShape. See details for more information." ;
            sh:resultPath nltl:hasPersonOnBoardMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:personOnBoardMember ;
                    sh:node gen:IMO_070_PersonOnBoardMemberShape ;
                    sh:path nltl:hasPersonOnBoardMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/person1> ] .

_:nd60aa55139e249449be38c563bc32dafb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Each passenger ship shall record that the assigned survival equipment is properly sized." ;
    sh:minCount 1 ;
    sh:path nltl:sizeCompatibilityStatus .

