@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F04/ship> ;
            sh:resultMessage "Each passenger ship shall record that the assigned survival equipment is properly sized." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd60aa55139e249449be38c563bc32dafb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F04/ship> ;
            sh:resultMessage "Each passenger ship shall record that the assigned survival equipment is properly sized." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nd60aa55139e249449be38c563bc32dafb1 ] .

_:nd60aa55139e249449be38c563bc32dafb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Each passenger ship shall record that the assigned survival equipment is properly sized." ;
    sh:minCount 1 ;
    sh:path nltl:sizeCompatibilityStatus .

