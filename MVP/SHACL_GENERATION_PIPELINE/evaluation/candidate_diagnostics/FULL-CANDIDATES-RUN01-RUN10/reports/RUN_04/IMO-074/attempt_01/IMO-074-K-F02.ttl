@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-074-K-F02/ship> ;
            sh:resultMessage "The abandonment onto ice or land potential assessment must be recorded as a single boolean value." ;
            sh:resultPath nltl:abandonmentOntoIceOrLandPotential ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The abandonment onto ice or land potential assessment must be recorded as a single boolean value." ;
                    sh:minCount 1 ;
                    sh:path nltl:abandonmentOntoIceOrLandPotential ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-074-K-F02/ship> ;
            sh:resultMessage "When abandonment onto ice or land is identified as potential, group survival equipment must be carried or approved equivalent functionality must be provided by normal life-saving appliances." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-074> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-074-K-F02/ship> ] .

