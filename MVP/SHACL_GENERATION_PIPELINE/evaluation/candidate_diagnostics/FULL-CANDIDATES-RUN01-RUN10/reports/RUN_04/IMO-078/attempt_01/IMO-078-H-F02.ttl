@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F02/crew1> ;
                    sh:resultMessage "Every linked crew member must have completed personal and group survival equipment training." ;
                    sh:resultPath nltl:personalAndGroupSurvivalEquipmentTrainingCompleted ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:message "Every linked crew member must have completed personal and group survival equipment training." ;
                            sh:minCount 1 ;
                            sh:path nltl:personalAndGroupSurvivalEquipmentTrainingCompleted ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Every linked crew member must have completed personal and group survival equipment training.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:personalAndGroupSurvivalEquipmentTrainingCompleted ] ]. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:message "Every linked crew member must have completed personal and group survival equipment training." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:personalAndGroupSurvivalEquipmentTrainingCompleted ] ] ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F02/crew1> ] .

