@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F02/ship> ;
            sh:resultMessage "For ships constructed on or after 1 January 2017 and ice strengthened, the required echo-sounding equipment topology must be provided." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-081-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:constructionDate" ;
            sh:resultPath nltl:constructionDate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:date ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:constructionDate ] ] .

