@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F05/ship> ;
            sh:resultMessage "When the bridge configuration requires an astern view, clearViewAsternStatus shall contain exactly one compliant xsd:boolean value." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the bridge configuration requires an astern view, clearViewAsternStatus shall contain exactly one compliant xsd:boolean value." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bridgeConfigurationType
                    nltl:asternViewRequiredBridgeConfiguration .
                FILTER (
                    NOT EXISTS {
                        $this nltl:clearViewAsternStatus ?status .
                        FILTER (
                            datatype(?status) = xsd:boolean &&
                            ?status = true
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:clearViewAsternStatus ?status .
                        FILTER (
                            datatype(?status) != xsd:boolean ||
                            !(?status = true)
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:clearViewAsternStatus ?status1 .
                        $this nltl:clearViewAsternStatus ?status2 .
                        FILTER (?status1 != ?status2)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-082-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F05/ship> ] .

