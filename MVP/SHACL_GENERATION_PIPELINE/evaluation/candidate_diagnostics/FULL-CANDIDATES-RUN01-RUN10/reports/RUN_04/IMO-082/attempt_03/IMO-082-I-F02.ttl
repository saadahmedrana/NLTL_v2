@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A clear astern view status of true is required for the applicable bridge configuration.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:clearViewAsternStatus ], [ sh:hasValue nltl:asternViewRequiredBridgeConfiguration ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:bridgeConfigurationType ] ; sh:sparql [ sh:message Literal("The clear astern view status must be exactly one distinct RDF value.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        {
                            SELECT $this (COUNT(DISTINCT ?status) AS ?distinctStatusCount)
                            WHERE {
                                $this nltl:clearViewAsternStatus ?status .
                            }
                            GROUP BY $this
                        }
                        FILTER (?distinctStatusCount != 1)
                    }
                ") ] ] , [ sh:property [ sh:message Literal("Bridge configuration is required to determine astern-view applicability.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:bridgeConfigurationType ] ; sh:sparql [ sh:message Literal("The astern-view-required bridge configuration requires a compliant clear astern view status.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:bridgeConfigurationType
                              nltl:asternViewRequiredBridgeConfiguration .
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_082_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F02/ship> ] .

