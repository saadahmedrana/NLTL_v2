@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:iceAccretionLikely ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:iceAccretionLikely ], [ sh:message Literal(\"When ice accretion is likely, the required navigation or communication antenna evidence must be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Each required navigation or communication antenna must have ice-accumulation prevention means.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:antennaIceAccumulationPreventionPresent ] ] ; sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_083_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F04/ship> ] .

