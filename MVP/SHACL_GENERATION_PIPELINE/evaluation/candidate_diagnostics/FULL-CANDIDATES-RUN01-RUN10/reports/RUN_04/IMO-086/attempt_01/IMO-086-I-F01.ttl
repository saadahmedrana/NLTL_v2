@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/heading1> ;
                    sh:resultMessage "Less than 1 values on ex:heading1->nltl:independentFromHeadingMeans" ;
                    sh:resultPath nltl:independentFromHeadingMeans ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:nonMagneticHeadingMeans ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:independentFromHeadingMeans ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:class nltl:benchmarkEntity ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:connectedToEmergencyPower ], [ sh:class nltl:benchmarkEntity ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:connectedToMainPower ], [ sh:class nltl:nonMagneticHeadingMeans ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:independentFromHeadingMeans ] ]. See details for more information." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n2abd14aeee8046f29bf73d90244e8efbb1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/heading1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "Each non-magnetic heading means must be independent from another distinct non-magnetic heading means of the ship and connected to both main and emergency power." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each non-magnetic heading means must be independent from another distinct non-magnetic heading means of the ship and connected to both main and emergency power." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:hasNonMagneticHeadingMeans ?means .
    FILTER (
        NOT EXISTS {
            ?means nltl:connectedToMainPower ?mainPower .
        }
        ||
        NOT EXISTS {
            ?means nltl:connectedToEmergencyPower ?emergencyPower .
        }
        ||
        NOT EXISTS {
            ?means nltl:independentFromHeadingMeans ?otherMeans .
            $this nltl:hasNonMagneticHeadingMeans ?otherMeans .
            FILTER (?otherMeans != ?means)
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-086-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "Less than 2 values on ex:ship->nltl:hasNonMagneticHeadingMeans" ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n2abd14aeee8046f29bf73d90244e8efbb1 ] .

_:N08707703045d4125ab096f822603c0f6 sh:class nltl:benchmarkEntity ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:connectedToEmergencyPower .

_:N7e177917182942d5ac6f1bb8af0edae5 sh:class nltl:nonMagneticHeadingMeans ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:independentFromHeadingMeans .

_:Ncd2946a5ecaf40a0a375e9a2bd622837 sh:class nltl:benchmarkEntity ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:connectedToMainPower .

_:Nd6a5530a9c1e429bb81dadec3739acb1 sh:property _:N08707703045d4125ab096f822603c0f6,
        _:N7e177917182942d5ac6f1bb8af0edae5,
        _:Ncd2946a5ecaf40a0a375e9a2bd622837 .

_:n2abd14aeee8046f29bf73d90244e8efbb1 sh:class nltl:nonMagneticHeadingMeans ;
    sh:minCount 2 ;
    sh:node _:Nd6a5530a9c1e429bb81dadec3739acb1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasNonMagneticHeadingMeans .

