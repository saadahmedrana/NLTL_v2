@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-F03/ship> ;
            sh:resultMessage "If the ship is involved in an icebreaker escort operation, the required stopped-light properties and visibility range must conform." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_089_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-F03/ship> ] .

