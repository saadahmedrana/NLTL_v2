            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nd422a0da567b4e52a86b938580298122b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-092-J-F02/ship> ;
            sh:resultMessage "Telemedical assistance communication equipment shall be provided for the ship." ;
