@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F01/ship> ;
            sh:resultMessage "The ship must provide unambiguous low-temperature and released-craft applicability information and satisfy the applicable survival-craft communication requirements." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_097_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F01/ship> ] .

