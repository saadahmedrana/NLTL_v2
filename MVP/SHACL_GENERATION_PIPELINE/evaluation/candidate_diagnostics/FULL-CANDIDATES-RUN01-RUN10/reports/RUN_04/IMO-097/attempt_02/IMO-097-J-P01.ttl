@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInLowAirTemperature ] ] , [ sh:property [ sh:class nltl:lifeboat ; sh:message Literal(\"The applicable ship must identify its lifeboat relationship.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasLifeboat ], [ sh:class nltl:lifeboat ; sh:message Literal(\"The applicable ship must identify the required rescue boat or lifeboat.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasRequiredRescueBoatOrLifeboat ], [ sh:class nltl:otherSurvivalCraft ; sh:message Literal(\"The applicable ship must identify its other-survival-craft relationship.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasOtherSurvivalCraft ], [ sh:class nltl:survivalCraft ; sh:message Literal(\"Each applicable survival craft must carry the required communication devices.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:IMO-097-SurvivalCraftShape> ; sh:path nltl:hasSurvivalCraft ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Release applicability evidence must be true for the applicable rescue boat or lifeboat requirement.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:releasedRescueBoatOrLifeboat ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInLowAirTemperature ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-097-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P01/ship> ] .

