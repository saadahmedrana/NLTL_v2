@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship's low-air-temperature applicability must be recorded as false for the non-applicable branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipOperatesInLowAirTemperature ] ] , [ sh:or ( [ sh:property [ sh:message Literal(\"The applicable ship must link its lifeboat inventory.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:IMO-097-LifeboatShape> ; sh:path nltl:hasLifeboat ] ] [ sh:property [ sh:message Literal(\"The applicable ship must link its other-survival-craft inventory.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltl:otherSurvivalCraft ; sh:path nltl:hasOtherSurvivalCraft ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship's low-air-temperature applicability must be recorded as true for this requirement to apply.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipOperatesInLowAirTemperature ], [ sh:message Literal(\"An applicable released rescue boat or lifeboat must be linked through the required-rescue-boat-or-lifeboat relationship.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:IMO-097-LifeboatShape> ; sh:path nltl:hasRequiredRescueBoatOrLifeboat ], [ sh:message Literal(\"Applicable survival craft must be linked and carry the required communication devices.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:IMO-097-SurvivalCraftShape> ; sh:path nltl:hasSurvivalCraft ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-097-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F03/ship> ] .

