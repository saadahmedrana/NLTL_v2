@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-P03/ship> ;
            sh:resultMessage "At least one identified intended-voyage hazard shall be recorded." ;
            sh:resultPath nltl:identifiedIntendedVoyageHazard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "At least one identified intended-voyage hazard shall be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:identifiedIntendedVoyageHazard ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-P03/ship> ;
            sh:resultMessage "The voyage plan shall address every identified intended-voyage hazard." ;
            sh:resultPath nltl:voyagePlanHazardCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n1827c1c000eb44349d62c242d5b7b952b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-P03/ship> ;
            sh:resultMessage "The voyage plan shall address every identified intended-voyage hazard." ;
            sh:resultPath nltl:voyagePlanHazardCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n1827c1c000eb44349d62c242d5b7b952b3 ] .

_:n1827c1c000eb44349d62c242d5b7b952b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The voyage plan shall address every identified intended-voyage hazard." ;
    sh:minCount 1 ;
    sh:path nltl:voyagePlanHazardCoverage .

