@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/routePlan> ;
                    sh:resultMessage "The polar-route planning record must indicate that voyage-planning topic coverage is true." ;
                    sh:resultPath nltl:voyagePlanningTopicCoverage ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n2af158cf925e40199d7d63a73ae3fbd4b2 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/routePlan> ;
                    sh:resultMessage "The polar-route planning record must indicate that voyage-planning topic coverage is true." ;
                    sh:resultPath nltl:voyagePlanningTopicCoverage ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n2af158cf925e40199d7d63a73ae3fbd4b2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/ship> ;
            sh:resultMessage "The ship must have a polar-route planning record covering the required voyage-planning topics." ;
            sh:resultPath nltl:hasPolarRoutePlan ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarRoutePlan ;
                    sh:message "The ship must have a polar-route planning record covering the required voyage-planning topics." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO101PolarRoutePlanShape ;
                    sh:path nltl:hasPolarRoutePlan ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/routePlan> ] .

_:n2af158cf925e40199d7d63a73ae3fbd4b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The polar-route planning record must indicate that voyage-planning topic coverage is true." ;
    sh:minCount 1 ;
    sh:path nltl:voyagePlanningTopicCoverage .

