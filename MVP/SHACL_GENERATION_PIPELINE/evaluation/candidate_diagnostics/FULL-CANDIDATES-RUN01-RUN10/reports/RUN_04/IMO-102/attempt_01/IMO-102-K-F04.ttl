@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F04/ship> ;
            sh:resultMessage "Each applicable crew member must have a matching polar training record with the matrix-required training level and a valid STCW qualification." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each applicable crew member must have a matching polar training record with the matrix-required training level and a valid STCW qualification." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType ;
                      nltl:hasCrewMemberInventory ?crew ;
                      .
                ?crew nltl:polarTrainingCrewRoleClassification ?role .

                BIND(
                    IF(
                        ?ice = nltl:iceFreeIceCondition,
                        nltl:polarTrainingNotApplicable,
                        IF(
                            ?ice = nltl:openWaterIceCondition &&
                            ?shipType = nltl:otherShipPolarTrainingType,
                            nltl:polarTrainingNotApplicable,
                            IF(
                                ?ice = nltl:openWaterIceCondition,
                                nltl:basicPolarTrainingLevel,
                                IF(
                                    ?ice = nltl:otherWatersIceCondition &&
                                    (?role = nltl:masterPolarTrainingRole ||
                                     ?role = nltl:chiefMatePolarTrainingRole),
                                    nltl:advancedPolarTrainingLevel,
                                    IF(
                                        ?ice = nltl:otherWatersIceCondition &&
                                        ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole,
                                        nltl:basicPolarTrainingLevel,
                                        nltl:polarTrainingNotApplicable
                                    )
                                )
                            )
                        )
                    ) AS ?expectedLevel
                )

                FILTER(?expectedLevel != nltl:polarTrainingNotApplicable)

                FILTER NOT EXISTS {
                    ?crew nltl:hasCrewTrainingRecord ?record ;
                          nltl:hasPolarTrainingRecord ?record .
                    ?record nltl:requiredTrainingLevel ?requiredLevel ;
                            nltl:trainingRecordLevel ?recordLevel ;
                            nltl:stcwQualificationValid true .
                    FILTER(?requiredLevel = ?expectedLevel)
                    FILTER(?recordLevel = ?expectedLevel)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO102ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F04/ship> ] .

