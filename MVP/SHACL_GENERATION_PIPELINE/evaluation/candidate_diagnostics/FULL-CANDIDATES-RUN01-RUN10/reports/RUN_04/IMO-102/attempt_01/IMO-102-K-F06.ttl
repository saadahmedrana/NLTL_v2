_:N08f40ecb963b493a9bc0c0fd03c69e4f rdf:first nltl:advancedPolarTrainingLevel ;
    rdf:rest ( nltl:polarTrainingNotApplicable ) .

_:N36943ea179b74a589c778ff9e452db05 rdf:first nltl:chiefMatePolarTrainingRole ;
    rdf:rest ( nltl:officerInChargeOfNavigationalWatchPolarTrainingRole ) .

_:N53422847995a49a7ab4a2a2696bac251 rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest _:N08f40ecb963b493a9bc0c0fd03c69e4f .

_:N8913525c79c944308d30e2a05d7d5b74 rdf:first nltl:masterPolarTrainingRole ;
    rdf:rest _:N36943ea179b74a589c778ff9e452db05 .

_:nca25fd0adb454e3b9c3d9b50f09637a6b12 sh:class nltl:polarTrainingCrewRoleValue ;
    sh:in _:N8913525c79c944308d30e2a05d7d5b74 ;
    sh:maxCount 1 ;
    sh:message "Each linked crew member must have exactly one controlled polar training role." ;
    sh:minCount 1 ;
    sh:path nltl:polarTrainingCrewRoleClassification .

_:nca25fd0adb454e3b9c3d9b50f09637a6b16 sh:class nltl:polarTrainingRecord ;
