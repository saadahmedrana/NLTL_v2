@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P13/trainingRecord> ;
                            sh:resultMessage "Less than 1 values on ex:trainingRecord->nltl:requiredTrainingLevel" ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nca25fd0adb454e3b9c3d9b50f09637a6b18 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P13/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:IMO102PolarTrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasPolarTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nca25fd0adb454e3b9c3d9b50f09637a6b17 ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P13/trainingRecord> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P13/trainingRecord> ;
                            sh:resultMessage "Less than 1 values on ex:trainingRecord->nltl:requiredTrainingLevel" ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nca25fd0adb454e3b9c3d9b50f09637a6b18 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P13/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:IMO102PolarTrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasCrewTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nca25fd0adb454e3b9c3d9b50f09637a6b16 ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P13/trainingRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P13/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO102CrewMemberShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:crewMember ;
                    sh:node gen:IMO102CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P13/crew> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P13/ship> ;
            sh:resultMessage "Each applicable crew member must have a matching polar training record with the matrix-required training level and a valid STCW qualification." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each applicable crew member must have a matching polar training record with the matrix-required training level and a valid STCW qualification." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType ;
                      nltl:hasCrewMemberInventory ?crew ;
                      .
                ?crew nltl:polarTrainingCrewRoleClassification ?role .

                BIND(
                    IF(
                        ?ice = nltl:iceFreeIceCondition,
                        nltl:polarTrainingNotApplicable,
                        IF(
                            ?ice = nltl:openWaterIceCondition &&
                            ?shipType = nltl:otherShipPolarTrainingType,
                            nltl:polarTrainingNotApplicable,
                            IF(
                                ?ice = nltl:openWaterIceCondition,
                                nltl:basicPolarTrainingLevel,
                                IF(
                                    ?ice = nltl:otherWatersIceCondition &&
                                    (?role = nltl:masterPolarTrainingRole ||
                                     ?role = nltl:chiefMatePolarTrainingRole),
                                    nltl:advancedPolarTrainingLevel,
                                    IF(
                                        ?ice = nltl:otherWatersIceCondition &&
                                        ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole,
                                        nltl:basicPolarTrainingLevel,
                                        nltl:polarTrainingNotApplicable
                                    )
                                )
                            )
                        )
                    ) AS ?expectedLevel
                )

                FILTER(?expectedLevel != nltl:polarTrainingNotApplicable)

                FILTER NOT EXISTS {
                    ?crew nltl:hasCrewTrainingRecord ?record ;
                          nltl:hasPolarTrainingRecord ?record .
                    ?record nltl:requiredTrainingLevel ?requiredLevel ;
                            nltl:trainingRecordLevel ?recordLevel ;
                            nltl:stcwQualificationValid true .
                    FILTER(?requiredLevel = ?expectedLevel)
                    FILTER(?recordLevel = ?expectedLevel)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO102ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P13/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P13/trainingRecord> ;
                    sh:resultMessage "Less than 1 values on ex:trainingRecord->nltl:requiredTrainingLevel" ;
                    sh:resultPath nltl:requiredTrainingLevel ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nca25fd0adb454e3b9c3d9b50f09637a6b18 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P13/crew> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO102PolarTrainingRecordShape. See details for more information." ;
            sh:resultPath nltl:hasPolarTrainingRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nca25fd0adb454e3b9c3d9b50f09637a6b17 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P13/trainingRecord> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P13/trainingRecord> ;
                    sh:resultMessage "Less than 1 values on ex:trainingRecord->nltl:requiredTrainingLevel" ;
                    sh:resultPath nltl:requiredTrainingLevel ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nca25fd0adb454e3b9c3d9b50f09637a6b18 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P13/crew> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO102PolarTrainingRecordShape. See details for more information." ;
            sh:resultPath nltl:hasCrewTrainingRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nca25fd0adb454e3b9c3d9b50f09637a6b16 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P13/trainingRecord> ] .

_:N0122190d2efc401ea3fc3c26971d58f7 rdf:first nltl:polarTrainingNotApplicable ;
    rdf:rest () .

_:N57c2df43db604d638399c21b63b9cfe1 rdf:first nltl:advancedPolarTrainingLevel ;
    rdf:rest _:N0122190d2efc401ea3fc3c26971d58f7 .

_:Ndced8c3f83cd4d808ab60af9cdbd3bfe rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest _:N57c2df43db604d638399c21b63b9cfe1 .

_:nca25fd0adb454e3b9c3d9b50f09637a6b16 sh:class nltl:polarTrainingRecord ;
    sh:node gen:IMO102PolarTrainingRecordShape ;
    sh:path nltl:hasCrewTrainingRecord .

_:nca25fd0adb454e3b9c3d9b50f09637a6b17 sh:class nltl:polarTrainingRecord ;
    sh:node gen:IMO102PolarTrainingRecordShape ;
    sh:path nltl:hasPolarTrainingRecord .

_:nca25fd0adb454e3b9c3d9b50f09637a6b18 sh:class nltl:trainingLevelValue ;
    sh:in _:Ndced8c3f83cd4d808ab60af9cdbd3bfe ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:requiredTrainingLevel .

