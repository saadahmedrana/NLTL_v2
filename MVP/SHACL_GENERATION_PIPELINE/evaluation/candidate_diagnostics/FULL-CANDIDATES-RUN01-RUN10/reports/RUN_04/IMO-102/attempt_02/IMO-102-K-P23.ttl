@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P23/ship> ;
            sh:resultMessage "Each applicable crew member must have a training record whose required level and recorded level match the 12.3.1 matrix and whose STCW qualification is valid." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each applicable crew member must have a training record whose required level and recorded level match the 12.3.1 matrix and whose STCW qualification is valid." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType ;
                      nltl:hasCrewMemberInventory ?crew .
                ?crew nltl:polarTrainingCrewRoleClassification ?role .
                FILTER (
                    (
                        ?ice = nltl:openWaterIceCondition &&
                        (?shipType = nltl:tankerPolarTrainingShipType ||
                         ?shipType = nltl:passengerShipPolarTrainingShipType) &&
                        (?role = nltl:masterPolarTrainingRole ||
                         ?role = nltl:chiefMatePolarTrainingRole ||
                         ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole)
                    )
                    ||
                    (
                        ?ice = nltl:otherWatersIceCondition &&
                        (?role = nltl:masterPolarTrainingRole ||
                         ?role = nltl:chiefMatePolarTrainingRole)
                    )
                    ||
                    (
                        ?ice = nltl:otherWatersIceCondition &&
                        ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
                    )
                )
                FILTER NOT EXISTS {
                    ?crew nltl:hasCrewTrainingRecord ?record .
                    ?record nltl:requiredTrainingLevel ?required ;
                            nltl:trainingRecordLevel ?recorded ;
                            nltl:stcwQualificationValid true .
                    FILTER (
                        (
                            ?ice = nltl:openWaterIceCondition &&
                            (?shipType = nltl:tankerPolarTrainingShipType ||
                             ?shipType = nltl:passengerShipPolarTrainingShipType) &&
                            ?required = nltl:basicPolarTrainingLevel &&
                            ?recorded = nltl:basicPolarTrainingLevel
                        )
                        ||
                        (
                            ?ice = nltl:otherWatersIceCondition &&
                            (?role = nltl:masterPolarTrainingRole ||
                             ?role = nltl:chiefMatePolarTrainingRole) &&
                            ?required = nltl:advancedPolarTrainingLevel &&
                            ?recorded = nltl:advancedPolarTrainingLevel
                        )
                        ||
                        (
                            ?ice = nltl:otherWatersIceCondition &&
                            ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole &&
                            ?required = nltl:basicPolarTrainingLevel &&
                            ?recorded = nltl:basicPolarTrainingLevel
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO102ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P23/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P23/trainingRecord> ;
                            sh:resultMessage "A training record must state one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:in ( nltl:basicPolarTrainingLevel nltl:advancedPolarTrainingLevel nltl:polarTrainingNotApplicable ) ;
                                    sh:maxCount 1 ;
                                    sh:message "A training record must state one controlled required training level." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:requiredTrainingLevel ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P23/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:IMO102TrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasCrewTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node gen:IMO102TrainingRecordShape ;
                            sh:path nltl:hasCrewTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P23/trainingRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P23/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO102CrewMemberShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:IMO102CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P23/crew> ] .

