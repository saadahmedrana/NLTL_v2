@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-105-L-P02/ship> ;
            sh:resultMessage "The Arctic-waters discharge prohibition applies when the ship operates in Arctic waters." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-105-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-105-L-P02/ship> ] .

