@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F01/ship> ;
            sh:resultMessage "For clean ballast or segregated ballast, the paragraph 1.1.1 oil-discharge prohibition must be recorded as not applicable." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For clean ballast or segregated ballast, the paragraph 1.1.1 oil-discharge prohibition must be recorded as not applicable." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:dischargedMaterialClassification ?material .
    FILTER (?material IN (
        nltl:cleanBallastMaterial,
        nltl:segregatedBallastMaterial
    ))
    FILTER NOT EXISTS {
        $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?applicable .
        FILTER (?applicable = "false"^^xsd:boolean)
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO106Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F01/ship> ] .

