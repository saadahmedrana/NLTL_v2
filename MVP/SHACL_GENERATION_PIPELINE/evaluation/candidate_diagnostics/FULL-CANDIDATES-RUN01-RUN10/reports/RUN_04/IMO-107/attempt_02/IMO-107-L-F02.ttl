@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-F02/ship> ;
            sh:resultMessage "When the ship operates in polar waters, Oil Record Book, manual, and pollution emergency plan polar-operation coverage shall all be true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the ship operates in polar waters, Oil Record Book, manual, and pollution emergency plan polar-operation coverage shall all be true." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:ship .
                $this nltl:shipOperatesInPolarWaters true .
                FILTER (
                    NOT EXISTS {
                        $this nltl:oilRecordBookPolarCoverage true
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:manualPolarCoverage true
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:pollutionEmergencyPlanPolarCoverage true
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_107_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-F02/ship> ] .

