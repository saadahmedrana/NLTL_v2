@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:not [ sh:class nltl:oilTanker ] ; sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:cargoTankCarriesOil ], [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ; sh:path nltl:shipCategory ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Cargo tanks carrying oil must be separated from the outer shell by at least 0.76 m.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"0.76\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:cargoTankOuterShellSeparation ], [ sh:minInclusive Literal(\"2017-01-01\", datatype=xsd:date) ; sh:path nltl:constructionDate ] ] , [ sh:property [ sh:hasValue nltl:polarShipCategoryC ; sh:path nltl:shipCategory ] ] , [ sh:property [ sh:maxInclusive Literal(\"2016-12-31\", datatype=xsd:date) ; sh:path nltl:constructionDate ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:cargoTankCarriesOil ] ] , [ sh:class nltl:oilTanker ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-109> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-F02/ship> ] .

