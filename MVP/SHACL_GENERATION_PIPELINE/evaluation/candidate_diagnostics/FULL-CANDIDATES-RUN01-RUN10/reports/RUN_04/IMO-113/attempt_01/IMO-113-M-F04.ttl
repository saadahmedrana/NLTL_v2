@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-113-M-F04/ship> ;
            sh:resultMessage "Polar operation coverage must be recorded in the applicable documents." ;
            sh:resultPath nltl:polarOperationCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "Polar operation coverage must be recorded in the applicable documents." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarOperationCoverage ] ] .

