@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-113-M-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"The ship's polar-waters applicability must be recorded as false when the conditional coverage requirement does not apply.\") ; sh:path nltl:shipOperatesInPolarWaters ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The Cargo Record Book must account for polar operation when the ship operates in polar waters.\") ; sh:path nltl:cargoRecordBookPolarCoverage ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The Manual must account for polar operation when the ship operates in polar waters.\") ; sh:path nltl:manualPolarCoverage ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The applicable noxious-liquid-substance or marine pollution emergency plan must account for polar operation when the ship operates in polar waters.\") ; sh:path nltl:noxiousLiquidSubstanceEmergencyPlanPolarCoverage ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The ship's polar-waters applicability must be recorded as true to require polar document coverage.\") ; sh:path nltl:shipOperatesInPolarWaters ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_113_PolarDocumentCoverageShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-113-M-F02/ship> ] .

