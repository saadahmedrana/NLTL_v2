@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-F05/ship> ;
            sh:resultMessage "When sewage is not comminuted or disinfected, MARPOL compliance, distance greater than 12 nautical miles, the recorded qualifying-ice-area distance, and ice concentration exceeding 0.1 are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_116_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-F05/ship> ] .

