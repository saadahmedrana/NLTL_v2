@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F06/distanceRecord> ;
            sh:resultMessage "Each discharge-distance record linked to an applicable ship must contain both required nautical-mile distance quantities." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each discharge-distance record linked to an applicable ship must contain both required nautical-mile distance quantities." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                ?ship nltl:hasDischargeDistanceRecord $this .
                ?ship nltl:sewageDischargeUsesTreatmentPlant ?selector .
                FILTER (sameTerm(?selector, true))

                FILTER (
                    NOT EXISTS {
                        $this nltl:distanceToNearestLandIceShelfOrFastIce ?landIceDistance .
                        ?landIceDistance qudt:numericValue ?landIceValue ;
                                         qudt:unit <http://qudt.org/vocab/unit/MI_N> .
                        FILTER (datatype(?landIceValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ?iceDistance .
                        ?iceDistance qudt:numericValue ?iceValue ;
                                      qudt:unit <http://qudt.org/vocab/unit/MI_N> .
                        FILTER (datatype(?iceValue) = xsd:decimal)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO117DischargeDistanceRecordShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F06/distanceRecord> ] .

