@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in nltlgen:IMO119ApplicableShape , nltlgen:IMO119NonApplicableShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:IMO119ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F03/ship> ] .

