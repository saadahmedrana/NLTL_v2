@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-121-N-F01/ship> ;
            sh:resultMessage "The food-waste discharge condition shall be represented as either not discharged to sea or as satisfying all applicable food-waste controls." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_121_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-121-N-F01/ship> ] .

