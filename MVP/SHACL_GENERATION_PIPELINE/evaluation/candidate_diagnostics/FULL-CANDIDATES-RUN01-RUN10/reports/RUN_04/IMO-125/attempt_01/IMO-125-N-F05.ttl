@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F05/ship> ;
            sh:resultMessage "When the ship operates in polar waters, the Garbage Record Book, Garbage Management Plan, and garbage placards must provide polar-operation coverage." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO_125_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F05/ship> ] .

