@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F02/ship> ;
            sh:resultMessage "Chapter 9-1 applicability does not match the ship type, dimensions, gross tonnage, and trade status." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Chapter 9-1 applicability does not match the ship type, dimensions, gross tonnage, and trade status." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipType ?shipType ;
                      nltl:lengthOverall/qudt:numericValue ?length ;
                      nltl:grossTonnage/qudt:numericValue ?tonnage ;
                      nltl:engagedInTrade ?tradeStatus ;
                      nltl:polarCodeChapter9Dash1Applicable ?actual .

                BIND(
                    (
                        (?shipType = "fishing_vessel" && ?length >= 24) ||
                        (?shipType = "pleasure_yacht" && ?tonnage >= 300 && ?tradeStatus = false) ||
                        (?shipType = "cargo_ship" && ?tonnage >= 300 && ?tonnage < 500)
                    )
                    AS ?expected
                )

                FILTER (?actual != ?expected)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-002> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F02/ship> ] .

