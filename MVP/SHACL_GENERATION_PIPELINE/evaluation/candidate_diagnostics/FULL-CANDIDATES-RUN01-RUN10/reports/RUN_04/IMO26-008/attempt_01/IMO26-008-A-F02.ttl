@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-008-A-F02/ship> ;
            sh:resultMessage "The ship must have compliant SOLAS V/22.1.9.4 status and a clear view astern, or an Administration-approved equivalent visibility arrangement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO26_008_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-008-A-F02/ship> ] .

