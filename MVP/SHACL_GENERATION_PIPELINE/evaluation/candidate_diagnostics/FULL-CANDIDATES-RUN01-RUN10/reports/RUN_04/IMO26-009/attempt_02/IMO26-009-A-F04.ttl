@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-009-A-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"iceAccretionLikely must be explicitly true or false.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ], [ sh:message Literal(\"Every linked required navigation or communication antenna must have ice accumulation prevention means when ice accretion is likely.\") ; sh:node gen:IMO26_009_AntennaShape ; sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"iceAccretionLikely must be explicitly true or false.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO26_009_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-009-A-F04/ship> ] .

