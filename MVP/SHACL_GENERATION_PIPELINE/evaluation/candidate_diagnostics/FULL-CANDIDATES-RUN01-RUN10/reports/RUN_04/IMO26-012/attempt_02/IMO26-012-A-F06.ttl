@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F06/ship> ;
            sh:resultMessage "Gross tonnage is required as a single unitless decimal quantity to determine applicability." ;
            sh:resultPath nltl:grossTonnage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Gross tonnage is required as a single unitless decimal quantity to determine applicability." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO26-012-QuantityShape> ;
                    sh:nodeKind sh:BlankNodeOrIRI ;
                    sh:path nltl:grossTonnage ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F06/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:node <urn:nltl:generated-shape:IMO26-012-ApplicableShipShape> ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:IMO26-012-GrossTonnageAtLeast500Shape> ; sh:path nltl:grossTonnage ] ] , [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:IMO26-012-GrossTonnageBelow500Shape> ; sh:path nltl:grossTonnage ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-012-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F06/ship> ] .

