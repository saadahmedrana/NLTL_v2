@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-015-B-P02/ship> ;
            sh:resultMessage "A ship within the scope of Polar Code chapter 11 must record SOLAS chapter I certification as true." ;
            sh:resultPath nltl:solasChapterICertified ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "A ship within the scope of Polar Code chapter 11 must record SOLAS chapter I certification as true." ;
                    sh:minCount 1 ;
                    sh:path nltl:solasChapterICertified ] ] .

