@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:polarCodeChapter11Dash1Applicable ], [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInPolarWaters ] ] , [ sh:property [ sh:datatype xsd:string ; sh:hasValue Literal("fishing_vessel") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipType ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:polarCodeChapter11Dash1Applicable ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInPolarWaters ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:lengthOverall ] ; sh:sparql [ sh:message Literal("A fishing vessel operating in polar waters requires length overall of at least 24 m for chapter 11-1 applicability.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:lengthOverall ?lengthNode .
                            ?lengthNode qudt:numericValue ?length .
                            ?lengthNode qudt:unit <http://qudt.org/vocab/unit/M> .
                            FILTER ( ?length >= 24 )
                        }
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:engagedInTrade ], [ sh:datatype xsd:string ; sh:hasValue Literal("pleasure_yacht") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipType ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:polarCodeChapter11Dash1Applicable ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInPolarWaters ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:GrossTonnageQuantityShape ; sh:path nltl:grossTonnage ] ; sh:sparql [ sh:message Literal("A pleasure yacht not engaged in trade requires gross tonnage of at least 300 for chapter 11-1 applicability.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:grossTonnage ?tonnageNode .
                            ?tonnageNode qudt:numericValue ?tonnage .
                            ?tonnageNode qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                            FILTER ( ?tonnage >= 300 )
                        }
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:string ; sh:hasValue Literal("cargo_ship") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipType ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:polarCodeChapter11Dash1Applicable ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInPolarWaters ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:GrossTonnageQuantityShape ; sh:path nltl:grossTonnage ] ; sh:sparql [ sh:message Literal("A cargo ship requires gross tonnage from 300 inclusive to below 500 for chapter 11-1 applicability.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:grossTonnage ?tonnageNode .
                            ?tonnageNode qudt:numericValue ?tonnage .
                            ?tonnageNode qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                            FILTER ( ?tonnage >= 300 && ?tonnage < 500 )
                        }
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:string ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipType ], [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:polarCodeChapter11Dash1Applicable ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInPolarWaters ] ; sh:sparql [ sh:message Literal("A ship operating in polar waters outside the qualifying chapter 11-1 alternatives must explicitly indicate non-applicability.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            {
                                $this nltl:shipType "fishing_vessel" .
                                $this nltl:lengthOverall ?lengthNode .
                                ?lengthNode qudt:numericValue ?length .
                                ?lengthNode qudt:unit <http://qudt.org/vocab/unit/M> .
                                FILTER ( ?length < 24 )
                            }
                            UNION
                            {
                                $this nltl:shipType "pleasure_yacht" .
                                $this nltl:grossTonnage ?tonnageNode .
                                ?tonnageNode qudt:numericValue ?tonnage .
                                ?tonnageNode qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER ( ?tonnage < 300 )
                            }
                            UNION
                            {
                                $this nltl:shipType "pleasure_yacht" .
                                $this nltl:grossTonnage ?tonnageNode .
                                ?tonnageNode qudt:numericValue ?tonnage .
                                ?tonnageNode qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                $this nltl:engagedInTrade true .
                                FILTER ( ?tonnage >= 300 )
                            }
                            UNION
                            {
                                $this nltl:shipType "cargo_ship" .
                                $this nltl:grossTonnage ?tonnageNode .
                                ?tonnageNode qudt:numericValue ?tonnage .
                                ?tonnageNode qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER ( ?tonnage < 300 || ?tonnage >= 500 )
                            }
                            UNION
                            {
                                $this nltl:shipType ?type .
                                FILTER ( ?type NOT IN ( "fishing_vessel", "pleasure_yacht", "cargo_ship" ) )
                            }
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:Chapter11Dash1ApplicabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F04/ship> ] .

