@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F02/ship> ;
            sh:resultMessage "Chapter 11-1 applicability must match the ship's polar-waters status, type, dimensions, gross tonnage, and trade status." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Chapter 11-1 applicability must match the ship's polar-waters status, type, dimensions, gross tonnage, and trade status." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters ?operates .
                $this nltl:polarCodeChapter11Dash1Applicable ?applicable .

                FILTER (
                    (
                        ?operates = false &&
                        ?applicable != false
                    )
                    ||
                    (
                        ?operates = true &&
                        (
                            (
                                (
                                    EXISTS {
                                        $this rdf:type nltl:fishingVessel .
                                        $this nltl:lengthOverall ?lengthQuantity .
                                        ?lengthQuantity qudt:numericValue ?lengthValue ;
                                                         qudt:unit qudt:M .
                                        FILTER (
                                            datatype(?lengthValue) = xsd:decimal &&
                                            ?lengthValue >= 24
                                        )
                                    }
                                )
                                ||
                                (
                                    EXISTS {
                                        $this rdf:type nltl:pleasureYacht .
                                        $this nltl:grossTonnage ?yachtTonnageQuantity .
                                        ?yachtTonnageQuantity qudt:numericValue ?yachtTonnage ;
                                                            qudt:unit qudt:UNITLESS .
                                        $this nltl:engagedInTrade false .
                                        FILTER (
                                            datatype(?yachtTonnage) = xsd:decimal &&
                                            ?yachtTonnage >= 300
                                        )
                                    }
                                )
                                ||
                                (
                                    EXISTS {
                                        $this rdf:type nltl:cargoShip .
                                        $this nltl:grossTonnage ?cargoTonnageQuantity .
                                        ?cargoTonnageQuantity qudt:numericValue ?cargoTonnage ;
                                                            qudt:unit qudt:UNITLESS .
                                        FILTER (
                                            datatype(?cargoTonnage) = xsd:decimal &&
                                            ?cargoTonnage >= 300 &&
                                            ?cargoTonnage < 500
                                        )
                                    }
                                )
                            )
                            &&
                            ?applicable != true
                        )
                    )
                    ||
                    (
                        ?operates = true &&
                        ?applicable = false &&
                        (
                            (
                                EXISTS { $this rdf:type nltl:fishingVessel . }
                                &&
                                NOT EXISTS {
                                    $this nltl:lengthOverall ?fishingLengthQuantity .
                                    ?fishingLengthQuantity qudt:numericValue ?fishingLength ;
                                                            qudt:unit qudt:M .
                                    FILTER (
                                        datatype(?fishingLength) = xsd:decimal &&
                                        ?fishingLength < 24
                                    )
                                }
                            )
                            ||
                            (
                                EXISTS { $this rdf:type nltl:pleasureYacht . }
                                &&
                                NOT EXISTS {
                                    $this nltl:grossTonnage ?pleasureTonnageQuantity .
                                    ?pleasureTonnageQuantity qudt:numericValue ?pleasureTonnage ;
                                                              qudt:unit qudt:UNITLESS .
                                    $this nltl:engagedInTrade false .
                                    FILTER (
                                        datatype(?pleasureTonnage) = xsd:decimal &&
                                        ?pleasureTonnage >= 300
                                    )
                                }
                                &&
                                NOT EXISTS {
                                    $this nltl:grossTonnage ?pleasureLowTonnageQuantity .
                                    ?pleasureLowTonnageQuantity qudt:numericValue ?pleasureLowTonnage ;
                                                               qudt:unit qudt:UNITLESS .
                                    FILTER (
                                        datatype(?pleasureLowTonnage) = xsd:decimal &&
                                        ?pleasureLowTonnage < 300
                                    )
                                }
                            )
                            ||
                            (
                                EXISTS { $this rdf:type nltl:cargoShip . }
                                &&
                                NOT EXISTS {
                                    $this nltl:grossTonnage ?cargoQualifyingQuantity .
                                    ?cargoQualifyingQuantity qudt:numericValue ?cargoQualifyingTonnage ;
                                                              qudt:unit qudt:UNITLESS .
                                    FILTER (
                                        datatype(?cargoQualifyingTonnage) = xsd:decimal &&
                                        ?cargoQualifyingTonnage >= 300 &&
                                        ?cargoQualifyingTonnage < 500
                                    )
                                }
                                &&
                                NOT EXISTS {
                                    $this nltl:grossTonnage ?cargoNonQualifyingQuantity .
                                    ?cargoNonQualifyingQuantity qudt:numericValue ?cargoNonQualifyingTonnage ;
                                                                 qudt:unit qudt:UNITLESS .
                                    FILTER (
                                        datatype(?cargoNonQualifyingTonnage) = xsd:decimal &&
                                        (
                                            ?cargoNonQualifyingTonnage < 300 ||
                                            ?cargoNonQualifyingTonnage >= 500
                                        )
                                    )
                                }
                            )
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO26_016_Chapter11_1ApplicabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F02/ship> ] .

