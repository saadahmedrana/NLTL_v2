@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F01/ship> ;
            sh:resultMessage "Chapter 11-1 applicability must be false for non-polar ships and must match the applicable fishing-vessel, pleasure-yacht, or cargo-ship threshold when the ship operates in polar waters." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Chapter 11-1 applicability must be false for non-polar ships and must match the applicable fishing-vessel, pleasure-yacht, or cargo-ship threshold when the ship operates in polar waters." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters ?operates ;
                      nltl:shipType ?type ;
                      nltl:polarCodeChapter11Dash1Applicable ?app .

                FILTER (
                    (
                        ?operates = false &&
                        ?app != false
                    )
                    ||
                    (
                        ?operates = true &&
                        ?type = "fishing_vessel" &&
                        (
                            (
                                ?app = true &&
                                NOT EXISTS {
                                    $this nltl:lengthOverall ?lengthNode .
                                    ?lengthNode qudt:numericValue ?lengthValue ;
                                                 qudt:unit qudt:M .
                                    FILTER (?lengthValue >= 24)
                                }
                            )
                            ||
                            (
                                ?app = false &&
                                (
                                    NOT EXISTS {
                                        $this nltl:lengthOverall ?lengthNode .
                                        ?lengthNode qudt:numericValue ?lengthValue ;
                                                     qudt:unit qudt:M .
                                    }
                                    ||
                                    EXISTS {
                                        $this nltl:lengthOverall ?lengthNode .
                                        ?lengthNode qudt:numericValue ?lengthValue ;
                                                     qudt:unit qudt:M .
                                        FILTER (?lengthValue >= 24)
                                    }
                                )
                            )
                        )
                    )
                    ||
                    (
                        ?operates = true &&
                        ?type = "pleasure_yacht" &&
                        (
                            (
                                ?app = true &&
                                NOT EXISTS {
                                    $this nltl:grossTonnage ?tonnageNode ;
                                          nltl:engagedInTrade ?trade .
                                    ?tonnageNode qudt:numericValue ?tonnageValue ;
                                                 qudt:unit qudt:UNITLESS .
                                    FILTER (
                                        ?tonnageValue >= 300 &&
                                        ?trade = false
                                    )
                                }
                            )
                            ||
                            (
                                ?app = false &&
                                (
                                    NOT EXISTS {
                                        $this nltl:grossTonnage ?tonnageNode ;
                                              nltl:engagedInTrade ?trade .
                                        ?tonnageNode qudt:numericValue ?tonnageValue ;
                                                     qudt:unit qudt:UNITLESS .
                                    }
                                    ||
                                    EXISTS {
                                        $this nltl:grossTonnage ?tonnageNode ;
                                              nltl:engagedInTrade ?trade .
                                        ?tonnageNode qudt:numericValue ?tonnageValue ;
                                                     qudt:unit qudt:UNITLESS .
                                        FILTER (
                                            ?tonnageValue >= 300 &&
                                            ?trade = false
                                        )
                                    }
                                )
                            )
                        )
                    )
                    ||
                    (
                        ?operates = true &&
                        ?type = "cargo_ship" &&
                        (
                            (
                                ?app = true &&
                                NOT EXISTS {
                                    $this nltl:grossTonnage ?tonnageNode .
                                    ?tonnageNode qudt:numericValue ?tonnageValue ;
                                                 qudt:unit qudt:UNITLESS .
                                    FILTER (
                                        ?tonnageValue >= 300 &&
                                        ?tonnageValue < 500
                                    )
                                }
                            )
                            ||
                            (
                                ?app = false &&
                                (
                                    NOT EXISTS {
                                        $this nltl:grossTonnage ?tonnageNode .
                                        ?tonnageNode qudt:numericValue ?tonnageValue ;
                                                     qudt:unit qudt:UNITLESS .
                                    }
                                    ||
                                    EXISTS {
                                        $this nltl:grossTonnage ?tonnageNode .
                                        ?tonnageNode qudt:numericValue ?tonnageValue ;
                                                     qudt:unit qudt:UNITLESS .
                                        FILTER (
                                            ?tonnageValue >= 300 &&
                                            ?tonnageValue < 500
                                        )
                                    }
                                )
                            )
                        )
                    )
                    ||
                    (
                        ?operates = true &&
                        ?type != "fishing_vessel" &&
                        ?type != "pleasure_yacht" &&
                        ?type != "cargo_ship" &&
                        ?app != false
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:Chapter11Dash1ApplicabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F01/grossTonnageValue> ;
                    sh:resultMessage "Node ex:grossTonnageValue->qudt:unit does not contain a value in the set: ['qudt:UNITLESS']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:GrossTonnageQuantityShape. See details for more information." ;
            sh:resultPath nltl:grossTonnage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:node gen:GrossTonnageQuantityShape ;
                    sh:path nltl:grossTonnage ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F01/grossTonnageValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F01/lengthOverallValue> ;
                    sh:resultMessage "Node ex:lengthOverallValue->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:LengthOverallQuantityShape. See details for more information." ;
            sh:resultPath nltl:lengthOverall ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:node gen:LengthOverallQuantityShape ;
                    sh:path nltl:lengthOverall ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F01/lengthOverallValue> ] .

