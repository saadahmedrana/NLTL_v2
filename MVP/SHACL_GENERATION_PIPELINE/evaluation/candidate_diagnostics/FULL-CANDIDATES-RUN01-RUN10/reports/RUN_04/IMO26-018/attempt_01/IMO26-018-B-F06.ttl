@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-018-B-F06/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:IMO26_018_ApplicableBranch , gen:IMO26_018_NonApplicableBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO26_018_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-018-B-F06/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-018-B-F06/ship> ;
            sh:resultMessage "Chapter 11-1 applicability must be provided to select the applicable planning constraint." ;
            sh:resultPath nltl:polarCodeChapter11Dash1Applicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "Chapter 11-1 applicability must be provided to select the applicable planning constraint." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarCodeChapter11Dash1Applicable ] ] .

