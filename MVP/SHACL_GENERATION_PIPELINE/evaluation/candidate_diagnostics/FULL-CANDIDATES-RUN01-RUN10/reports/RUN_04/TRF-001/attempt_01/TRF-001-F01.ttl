@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2021-07-05\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ], [ sh:hasValue nltl:iceClassRegulationEdition2021 ; sh:message Literal(\"Ships contracted for construction on or after 5 July 2021 must use the 2021 Ice Class Regulations.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:applicableIceClassRegulationEdition ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxInclusive Literal(\"2021-07-04\", datatype=xsd:date) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:constructionContractDate ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF001ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "The 2021 Ice Class Draught provision must apply to the ship." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n5697e96404e345dd842ede8743445eeeb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "The 2021 section 1.8 Ice Classes provision must apply to the ship." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n5697e96404e345dd842ede8743445eeeb2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "The 2021 section 1.8 Ice Classes provision must apply to the ship." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n5697e96404e345dd842ede8743445eeeb2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "The 2021 Ice Class Draught provision must apply to the ship." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n5697e96404e345dd842ede8743445eeeb1 ] .

_:n5697e96404e345dd842ede8743445eeeb1 sh:hasValue nltl:iceClassDraughtChapter2Provision2021 ;
    sh:message "The 2021 Ice Class Draught provision must apply to the ship." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:applicableIceClassRegulatoryProvision .

_:n5697e96404e345dd842ede8743445eeeb2 sh:hasValue nltl:iceClassSection1Point8Provision2021 ;
