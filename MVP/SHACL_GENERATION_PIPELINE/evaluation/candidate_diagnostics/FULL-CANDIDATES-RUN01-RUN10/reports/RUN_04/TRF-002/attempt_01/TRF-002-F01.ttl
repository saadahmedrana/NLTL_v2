@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-002-F01/ship> ;
            sh:resultMessage "For a ship contracted on or after 1 January 2019 and before 5 July 2021, applicableIceClassRegulationEdition must be iceClassRegulationEdition2017." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a ship contracted on or after 1 January 2019 and before 5 July 2021, applicableIceClassRegulationEdition must be iceClassRegulationEdition2017." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    (
                        YEAR(?date) > 2019
                        ||
                        (
                            YEAR(?date) = 2019
                            &&
                            (
                                MONTH(?date) > 1
                                ||
                                (MONTH(?date) = 1 && DAY(?date) >= 1)
                            )
                        )
                    )
                    &&
                    (
                        YEAR(?date) < 2021
                        ||
                        (
                            YEAR(?date) = 2021
                            &&
                            (
                                MONTH(?date) < 7
                                ||
                                (MONTH(?date) = 7 && DAY(?date) < 5)
                            )
                        )
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRegulationEdition2017 .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-002-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-002-F01/ship> ] .

