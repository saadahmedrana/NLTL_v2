@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:iceClassRegulationEdition2008 ; sh:message Literal(\"Ships contracted from 1 January 2010 through 31 December 2011 must identify the 2008 Ice Class Regulations as the applicable regulation edition.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:applicableIceClassRegulationEdition ], [ sh:maxExclusive Literal(\"2012-01-01\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ], [ sh:minInclusive Literal(\"2010-01-01\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ] ] , [ sh:or ( [ sh:property [ sh:maxExclusive Literal(\"2010-01-01\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ] ] [ sh:property [ sh:minInclusive Literal(\"2012-01-01\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ] ] ) ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF004Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ] .

