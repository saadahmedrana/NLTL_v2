@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F01/ship> ;
            sh:resultMessage "For a ship whose construction stage date is on or after 2003-09-01 and whose construction contract date is before 2010-01-01, the applicable Ice Class regulation edition must be the 2002 edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a ship whose construction stage date is on or after 2003-09-01 and whose construction contract date is before 2010-01-01, the applicable Ice Class regulation edition must be the 2002 edition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?stageDate ;
                      nltl:constructionContractDate ?contractDate .

                FILTER (
                    (
                        YEAR(?stageDate) > 2003 ||
                        (YEAR(?stageDate) = 2003 && MONTH(?stageDate) > 9) ||
                        (YEAR(?stageDate) = 2003 && MONTH(?stageDate) = 9 && DAY(?stageDate) >= 1)
                    ) &&
                    (
                        YEAR(?contractDate) < 2010 ||
                        (YEAR(?contractDate) = 2010 && MONTH(?contractDate) = 1 && DAY(?contractDate) < 1)
                    )
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:applicableIceClassRegulationEdition
                              nltl:iceClassRegulationEdition2002
                    }
                    ||
                    EXISTS {
                        $this nltl:applicableIceClassRegulationEdition ?otherEdition .
                        FILTER (?otherEdition != nltl:iceClassRegulationEdition2002)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape [ a sh:NodeShape ;
                    sh:property [ sh:datatype xsd:date ;
                            sh:message "A construction stage date is required to determine whether the 2002 Ice Class Regulations apply." ;
                            sh:minCount 1 ;
                            sh:path nltl:constructionStageDate ],
                        [ sh:datatype xsd:date ;
                            sh:message "A construction contract date is required to determine whether the 2002 Ice Class Regulations apply." ;
                            sh:minCount 1 ;
                            sh:path nltl:constructionContractDate ] ;
                    sh:sparql [ a sh:SPARQLConstraint ;
                            sh:message "For a ship whose construction stage date is on or after 2003-09-01 and whose construction contract date is before 2010-01-01, the applicable Ice Class regulation edition must be the 2002 edition." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?stageDate ;
                      nltl:constructionContractDate ?contractDate .

                FILTER (
                    (
                        YEAR(?stageDate) > 2003 ||
                        (YEAR(?stageDate) = 2003 && MONTH(?stageDate) > 9) ||
                        (YEAR(?stageDate) = 2003 && MONTH(?stageDate) = 9 && DAY(?stageDate) >= 1)
                    ) &&
                    (
                        YEAR(?contractDate) < 2010 ||
                        (YEAR(?contractDate) = 2010 && MONTH(?contractDate) = 1 && DAY(?contractDate) < 1)
                    )
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:applicableIceClassRegulationEdition
                              nltl:iceClassRegulationEdition2002
                    }
                    ||
                    EXISTS {
                        $this nltl:applicableIceClassRegulationEdition ?otherEdition .
                        FILTER (?otherEdition != nltl:iceClassRegulationEdition2002)
                    }
                )
            }
        """ ] ;
                    sh:targetClass nltl:ship ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F01/ship> ] .

