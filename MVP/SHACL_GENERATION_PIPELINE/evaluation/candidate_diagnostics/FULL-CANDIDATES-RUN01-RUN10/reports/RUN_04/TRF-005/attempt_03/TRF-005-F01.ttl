@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F01/ship> ;
            sh:resultMessage "A ship with a construction stage date on or after 2003-09-01 and a contract date before 2010-01-01 must specify exactly the 2002 ice-class regulation edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A ship with a construction stage date on or after 2003-09-01 and a contract date before 2010-01-01 must specify exactly the 2002 ice-class regulation edition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?stageDate ;
                      nltl:constructionContractDate ?contractDate .

                FILTER (
                    (
                        YEAR(?stageDate) > 2003 ||
                        (
                            YEAR(?stageDate) = 2003 &&
                            (
                                MONTH(?stageDate) > 9 ||
                                (
                                    MONTH(?stageDate) = 9 &&
                                    DAY(?stageDate) >= 1
                                )
                            )
                        )
                    ) &&
                    YEAR(?contractDate) < 2010
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:applicableIceClassRegulationEdition
                              nltl:iceClassRegulationEdition2002
                    }
                    ||
                    EXISTS {
                        $this nltl:applicableIceClassRegulationEdition ?edition .
                        FILTER (
                            ?edition != nltl:iceClassRegulationEdition2002
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape [ a sh:NodeShape ;
                    sh:property [ sh:datatype xsd:date ;
                            sh:path nltl:constructionContractDate ],
                        [ sh:datatype xsd:date ;
                            sh:path nltl:constructionStageDate ] ;
                    sh:sparql [ sh:message "A ship with a construction stage date on or after 2003-09-01 and a contract date before 2010-01-01 must specify exactly the 2002 ice-class regulation edition." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?stageDate ;
                      nltl:constructionContractDate ?contractDate .

                FILTER (
                    (
                        YEAR(?stageDate) > 2003 ||
                        (
                            YEAR(?stageDate) = 2003 &&
                            (
                                MONTH(?stageDate) > 9 ||
                                (
                                    MONTH(?stageDate) = 9 &&
                                    DAY(?stageDate) >= 1
                                )
                            )
                        )
                    ) &&
                    YEAR(?contractDate) < 2010
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:applicableIceClassRegulationEdition
                              nltl:iceClassRegulationEdition2002
                    }
                    ||
                    EXISTS {
                        $this nltl:applicableIceClassRegulationEdition ?edition .
                        FILTER (
                            ?edition != nltl:iceClassRegulationEdition2002
                        )
                    }
                )
            }
        """ ] ;
                    sh:targetClass nltl:ship ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F01/ship> ] .

