@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxExclusive Literal(\"1986-11-01\", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ] , [ sh:property [ sh:minInclusive Literal(\"2003-09-01\", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ] , [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:ownerRequested2008EngineOutputRequirements ], [ sh:hasValue nltl:iceClassRegulationEdition2008 ; sh:message Literal(\"When the owner requests the 2008 requirements, engine output must use the 2008 Ice Class Regulations.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:engineOutputRegulationEdition ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:ownerRequested2008EngineOutputRequirements ], [ sh:hasValue nltl:iceClassRuleEdition1985 ; sh:message Literal(\"Without an owner request for the 2008 requirements, engine output remains governed by the 1985 ice-class rules.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:engineOutputRegulationEdition ] ] ) ; sh:property [ sh:hasValue nltl:iceClassRuleEdition1985 ; sh:message Literal(\"Ships in the specified construction-stage cohort must use the 1985 ice-class rules.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:applicableIceClassRegulationEdition ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:message Literal(\"An applicable ship must identify its permitted ice class.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:maxExclusive Literal(\"2003-09-01\", datatype=xsd:date) ; sh:minInclusive Literal(\"1986-11-01\", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-006> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F03/ship> ] .

