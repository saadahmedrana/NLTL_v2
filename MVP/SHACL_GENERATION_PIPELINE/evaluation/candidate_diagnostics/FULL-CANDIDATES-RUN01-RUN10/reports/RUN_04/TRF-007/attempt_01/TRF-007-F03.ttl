@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:maxInclusive Literal("2003-08-31", datatype=xsd:date) ; sh:message Literal("The construction stage date is required to establish applicability of TRF-007.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:datatype xsd:date ; sh:message Literal("A delivery date is required for the twenty-year deadline calculation.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:deliveryDate ], [ sh:datatype xsd:date ; sh:message Literal("An assessment date is required to verify the TRF-007 deadline.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:assessmentDate ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ; sh:message Literal("A ship subject to the conditional rule must identify ice class IA Super or IA.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ], [ sh:in ( nltl:traficom2017Section3Point2Point2Method nltl:traficom2017Section3Point2Point4Method ) ; sh:message Literal("The applicable ship must identify compliance with section 3.2.2 or 3.2.4 of the 2017 Ice Class Regulations.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:engineOutputComplianceMethod ] ; sh:sparql [ sh:message Literal("The applicable ship must comply no later than 1 January of the year twenty years after delivery.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:deliveryDate ?delivery ;
                              nltl:assessmentDate ?assessment .
                        FILTER (
                            YEAR(?assessment) < YEAR(?delivery) + 20
                            ||
                            (
                                YEAR(?assessment) = YEAR(?delivery) + 20
                                &&
                                MONTH(?assessment) = 1
                                &&
                                DAY(?assessment) <= 1
                            )
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:date ; sh:message Literal("The construction stage date is required to establish non-applicability of TRF-007.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("2003-09-01", datatype=xsd:date) ; sh:path nltl:constructionStageDate ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF007ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-F03/ship> ] .

