@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/upperIceWaterline> ;
                    sh:resultMessage "Less than 1 values on ex:upperIceWaterline->nltl:hasWaterlineProfilePoint" ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:waterlineProfilePoint ;
                            sh:minCount 1 ;
                            sh:node gen:TRF011ProfilePointShape ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:hasWaterlineProfilePoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF011UpperWaterlineShape. See details for more information." ;
            sh:resultPath nltl:hasUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:minCount 1 ;
                    sh:node gen:TRF011UpperWaterlineShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasUpperIceWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/upperIceWaterline> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ;
            sh:resultMessage "The upper ice waterline must contain exactly the intended waterline envelope: at every intended longitudinal position its vertical coordinate must equal the maximum intended vertical coordinate within tolerance, and no upper-waterline position may be extra or unmatched." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The upper ice waterline must contain exactly the intended waterline envelope: at every intended longitudinal position its vertical coordinate must equal the maximum intended vertical coordinate within tolerance, and no upper-waterline position may be extra or unmatched." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this ?longPos ?expected
            WHERE {
                {
                    SELECT ?this ?longPos (MAX(?intVertical) AS ?expected)
                    WHERE {
                        ?this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
                        ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
                        ?intendedPoint nltl:longitudinalPosition ?intendedLongQuantity ;
                            nltl:verticalCoordinate ?intendedVerticalQuantity .
                        ?intendedLongQuantity qudt:numericValue ?longPos ;
                            qudt:unit unit:M .
                        ?intendedVerticalQuantity qudt:numericValue ?intVertical ;
                            qudt:unit unit:M .
                    }
                    GROUP BY ?this ?longPos
                }

                FILTER (
                    NOT EXISTS {
                        ?this nltl:hasUpperIceWaterline ?upperWaterline .
                        ?upperWaterline nltl:hasWaterlineProfilePoint ?upperPoint .
                        ?upperPoint nltl:longitudinalPosition ?upperLongQuantity ;
                            nltl:verticalCoordinate ?upperVerticalQuantity .
                        ?upperLongQuantity qudt:numericValue ?upperLong ;
                            qudt:unit unit:M .
                        ?upperVerticalQuantity qudt:numericValue ?upperVertical ;
                            qudt:unit unit:M .
                        FILTER (?upperLong = ?longPos)
                    }
                    ||
                    EXISTS {
                        ?this nltl:hasUpperIceWaterline ?upperWaterline .
                        ?upperWaterline nltl:hasWaterlineProfilePoint ?upperPoint .
                        ?upperPoint nltl:longitudinalPosition ?upperLongQuantity ;
                            nltl:verticalCoordinate ?upperVerticalQuantity .
                        ?upperLongQuantity qudt:numericValue ?upperLong ;
                            qudt:unit unit:M .
                        ?upperVerticalQuantity qudt:numericValue ?upperVertical ;
                            qudt:unit unit:M .
                        FILTER (
                            ?upperLong = ?longPos &&
                            ABS(?upperVertical - ?expected) >
                            (1e-6 * ABS(?expected) + 1e-9)
                        )
                    }
                    ||
                    EXISTS {
                        ?this nltl:hasUpperIceWaterline ?upperWaterline .
                        ?upperWaterline nltl:hasWaterlineProfilePoint ?upperPoint .
                        ?upperPoint nltl:longitudinalPosition ?upperLongQuantity .
                        ?upperLongQuantity qudt:numericValue ?upperLong ;
                            qudt:unit unit:M .
                        FILTER NOT EXISTS {
                            ?this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline2 .
                            ?intendedWaterline2 nltl:hasWaterlineProfilePoint ?intendedPoint2 .
                            ?intendedPoint2 nltl:longitudinalPosition ?intendedLongQuantity2 .
                            ?intendedLongQuantity2 qudt:numericValue ?intendedLong ;
                                qudt:unit unit:M .
                            FILTER (?intendedLong = ?upperLong)
                        }
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF011ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ] .

