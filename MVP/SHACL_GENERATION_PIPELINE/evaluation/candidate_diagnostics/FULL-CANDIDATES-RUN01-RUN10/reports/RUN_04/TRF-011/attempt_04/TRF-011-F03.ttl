@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasUpperIceWaterline" ;
            sh:resultPath nltl:hasUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:minCount 1 ;
                    sh:node nltlgen:TRF011IceWaterlineShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasUpperIceWaterline ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/ship> ;
            sh:resultMessage "The upper ice waterline must match the envelope of the highest intended ice-operating waterline points." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The upper ice waterline must match the envelope of the highest intended ice-operating waterline points." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?this
WHERE {
  {
    SELECT ?this ?x
           (MAX(?intVertical) AS ?expected)
           (MIN(?uiVertical) AS ?uiMinimum)
           (MAX(?uiVertical) AS ?uiMaximum)
           (COUNT(?intVertical) AS ?intCount)
           (COUNT(?uiVertical) AS ?uiCount)
    WHERE {
      {
        ?this nltl:hasIntendedIceOperatingWaterline ?intWaterline .
        ?intWaterline nltl:hasWaterlineProfilePoint ?intPoint .
        ?intPoint nltl:longitudinalPosition ?intPosition .
        ?intPosition qudt:numericValue ?intX .
        ?intPosition qudt:unit <http://qudt.org/vocab/unit/M> .
        ?intPoint nltl:verticalCoordinate ?intCoordinate .
        ?intCoordinate qudt:numericValue ?intVertical .
        ?intCoordinate qudt:unit <http://qudt.org/vocab/unit/M> .
        FILTER (
          DATATYPE(?intX) = xsd:decimal &&
          DATATYPE(?intVertical) = xsd:decimal
        )
        BIND(?intX AS ?x)
      }
      UNION
      {
        ?this nltl:hasUpperIceWaterline ?uiWaterline .
        ?uiWaterline nltl:hasWaterlineProfilePoint ?uiPoint .
        ?uiPoint nltl:longitudinalPosition ?uiPosition .
        ?uiPosition qudt:numericValue ?uiX .
        ?uiPosition qudt:unit <http://qudt.org/vocab/unit/M> .
        ?uiPoint nltl:verticalCoordinate ?uiCoordinate .
        ?uiCoordinate qudt:numericValue ?uiVertical .
        ?uiCoordinate qudt:unit <http://qudt.org/vocab/unit/M> .
        FILTER (
          DATATYPE(?uiX) = xsd:decimal &&
          DATATYPE(?uiVertical) = xsd:decimal
        )
        BIND(?uiX AS ?x)
      }
    }
    GROUP BY ?this ?x
  }
  FILTER (
    ?intCount = 0 ||
    ?uiCount = 0 ||
    !BOUND(?expected) ||
    !BOUND(?uiMinimum) ||
    !BOUND(?uiMaximum) ||
    ABS(?uiMinimum - ?expected) >
      IF(
        ABS(?expected) * 0.000001 > 0.000001,
        ABS(?expected) * 0.000001,
        0.000001
      ) ||
    ABS(?uiMaximum - ?expected) >
      IF(
        ABS(?expected) * 0.000001 > 0.000001,
        ABS(?expected) * 0.000001,
        0.000001
      )
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlgen:TRF011ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/ship> ] .

