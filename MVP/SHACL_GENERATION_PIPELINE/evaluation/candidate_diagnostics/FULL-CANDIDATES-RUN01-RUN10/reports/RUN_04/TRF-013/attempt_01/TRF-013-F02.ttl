@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-F02/ship> ;
            sh:resultMessage "At the fore perpendicular, the operating draught must be between the minimum and maximum ice-class draughts, and at the aft perpendicular it must likewise be between its corresponding bounds." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "At the fore perpendicular, the operating draught must be between the minimum and maximum ice-class draughts, and at the aft perpendicular it must likewise be between its corresponding bounds." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:operatingForeDraught/qudt:numericValue ?operatingFore ;
                       nltl:operatingAftDraught/qudt:numericValue ?operatingAft ;
                       nltl:maximumIceClassDraughtFore/qudt:numericValue ?maximumFore ;
                       nltl:maximumIceClassDraughtAft/qudt:numericValue ?maximumAft ;
                       nltl:minimumIceClassDraughtFore/qudt:numericValue ?minimumFore ;
                       nltl:minimumIceClassDraughtAft/qudt:numericValue ?minimumAft .
                FILTER (
                    !(
                        ?minimumFore <= ?operatingFore &&
                        ?operatingFore <= ?maximumFore &&
                        ?minimumAft <= ?operatingAft &&
                        ?operatingAft <= ?maximumAft
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF013ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-F02/ship> ] .

