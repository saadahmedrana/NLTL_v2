@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-F03/ship> ;
            sh:resultMessage "The maximum ice-class draught at the fore perpendicular is required in metres." ;
            sh:resultPath nltl:maximumIceClassDraughtFore ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The maximum ice-class draught at the fore perpendicular is required in metres." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF013LengthQuantityShape ;
                    sh:path nltl:maximumIceClassDraughtFore ] ] .

