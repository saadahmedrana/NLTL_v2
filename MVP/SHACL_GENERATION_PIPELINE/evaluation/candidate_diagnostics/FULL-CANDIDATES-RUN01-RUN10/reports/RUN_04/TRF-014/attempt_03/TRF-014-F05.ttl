@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:sparql [ sh:message Literal("The marking condition is not applicable when the summer load line draught is not above the UIWL.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:summerLoadLineFreshWaterDraught/qudt:numericValue ?summer ;
                              nltl:upperIceWaterlineDraught/qudt:numericValue ?uiwl .
                        FILTER (?summer > ?uiwl)
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClassDraughtMarkPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:warningTrianglePresent ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:iceClassDraughtMarkDraughtAmidships ] ; sh:sparql [ sh:message Literal("Post-cutoff ships with an applicable marking condition require the warning triangle and maximum amidships draught mark.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionDate ?construction ;
                              nltl:summerLoadLineFreshWaterDraught/qudt:numericValue ?summer ;
                              nltl:upperIceWaterlineDraught/qudt:numericValue ?uiwl .
                        FILTER (?construction < "2007-07-01"^^xsd:date || !(?summer > ?uiwl))
                    }
                ") ], [ sh:message Literal("The marking draught must equal the linked class certificate maximum amidships draught.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClassDraughtMarkDraughtAmidships/qudt:numericValue ?mark ;
                              nltl:hasClassCertificate/nltl:maximumIceClassDraughtAmidships/qudt:numericValue ?maximum .
                        FILTER (?mark != ?maximum)
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClassDraughtMarkPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:warningTrianglePresent ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClassDraughtMarkDraughtAmidships ] ; sh:sparql [ sh:message Literal("A pre-cutoff ship with complete marking evidence is valid without a scheduled dry docking date.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionDate ?construction ;
                              nltl:summerLoadLineFreshWaterDraught/qudt:numericValue ?summer ;
                              nltl:upperIceWaterlineDraught/qudt:numericValue ?uiwl .
                        FILTER (?construction >= "2007-07-01"^^xsd:date || !(?summer > ?uiwl))
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:firstScheduledDryDockingDate ] ; sh:sparql [ sh:message Literal("A pre-cutoff ship deferred beyond assessment must have an incomplete marking state and a future first scheduled dry docking date.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionDate ?construction ;
                              nltl:assessmentDate ?assessment ;
                              nltl:firstScheduledDryDockingDate ?docking ;
                              nltl:summerLoadLineFreshWaterDraught/qudt:numericValue ?summer ;
                              nltl:upperIceWaterlineDraught/qudt:numericValue ?uiwl .
                        FILTER (?construction >= "2007-07-01"^^xsd:date ||
                                !(?summer > ?uiwl) ||
                                ?docking <= ?assessment)
                        FILTER NOT EXISTS {
                            $this nltl:warningTrianglePresent true ;
                                  nltl:iceClassDraughtMarkPresent true
                        }
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClassDraughtMarkPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:warningTrianglePresent ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:firstScheduledDryDockingDate ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClassDraughtMarkDraughtAmidships ] ; sh:sparql [ sh:message Literal("A pre-cutoff ship whose docking is due by the assessment date must have the required markings.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionDate ?construction ;
                              nltl:assessmentDate ?assessment ;
                              nltl:firstScheduledDryDockingDate ?docking ;
                              nltl:summerLoadLineFreshWaterDraught/qudt:numericValue ?summer ;
                              nltl:upperIceWaterlineDraught/qudt:numericValue ?uiwl .
                        FILTER (?construction >= "2007-07-01"^^xsd:date ||
                                !(?summer > ?uiwl) ||
                                ?docking > ?assessment)
                    }
                ") ], [ sh:message Literal("The marking draught must equal the linked class certificate maximum amidships draught.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClassDraughtMarkDraughtAmidships/qudt:numericValue ?mark ;
                              nltl:hasClassCertificate/nltl:maximumIceClassDraughtAmidships/qudt:numericValue ?maximum .
                        FILTER (?mark != ?maximum)
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF014ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:retainedOnBoard" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd21c1f560abf4ae282aed74ed0e8fcfeb39 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "Node ex:ship->nltl:readilyAvailableToMaster does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nd21c1f560abf4ae282aed74ed0e8fcfeb40 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "Node ex:ship->nltl:retainedOnBoard does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nd21c1f560abf4ae282aed74ed0e8fcfeb39 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:readilyAvailableToMaster" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd21c1f560abf4ae282aed74ed0e8fcfeb40 ] .

_:nd21c1f560abf4ae282aed74ed0e8fcfeb39 sh:datatype xsd:boolean ;
