                ") ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxExclusive Literal("2007-07-01", datatype=xsd:date) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionDate ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:firstScheduledDryDockingDate ] ; sh:sparql [ sh:message Literal("For a pre-2007 ship whose first scheduled dry docking is due by the assessment date, the warning triangle and ice-class draught mark are required when the summer load line fresh-water draught is above the UIWL.") ; sh:select Literal("
