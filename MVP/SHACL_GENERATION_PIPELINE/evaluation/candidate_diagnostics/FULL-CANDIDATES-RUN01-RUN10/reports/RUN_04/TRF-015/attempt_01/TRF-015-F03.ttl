@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F03/ship> ;
            sh:resultMessage "Loading calculation sea-water salinity must equal the intended-route sea-water salinity." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Loading calculation sea-water salinity must equal the intended-route sea-water salinity." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:intendedRouteSeaWaterSalinity ?routeValue .
                ?routeValue qudt:numericValue ?routeSalinity .
                $this nltl:loadingCalculationSeaWaterSalinity ?loadValue .
                ?loadValue qudt:numericValue ?loadSalinity .
                FILTER(?routeSalinity != ?loadSalinity)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF015Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F03/ship> ] .

