@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P04/ship> ;
            sh:resultMessage "When propulsion output is restricted, maximum continuous rating power must equal restricted propulsion output." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When propulsion output is restricted, maximum continuous rating power must equal restricted propulsion output." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies true ;
                      nltl:maximumContinuousRatingPower ?maximum ;
                      nltl:restrictedPropulsionOutput ?restricted .
                ?maximum qudt:numericValue ?maximumValue .
                ?restricted qudt:numericValue ?restrictedValue .
                FILTER (?maximumValue != ?restrictedValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF017_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P04/ship> ] .

