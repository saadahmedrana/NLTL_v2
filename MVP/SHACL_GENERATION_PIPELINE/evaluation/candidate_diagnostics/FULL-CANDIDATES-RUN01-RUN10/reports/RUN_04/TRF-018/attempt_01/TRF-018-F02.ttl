@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F02/ship> ;
            sh:resultMessage "For ice class IA, IB, or IC, maximum continuous rating power must be at least the greater of calculated required power and 1000 kW; for IA Super, it must be at least the greater of calculated required power and 2800 kW." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For ice class IA, IB, or IC, maximum continuous rating power must be at least the greater of calculated required power and 1000 kW; for IA Super, it must be at least the greater of calculated required power and 2800 kW." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:calculatedRequiredPower ?calculatedNode ;
                      nltl:maximumContinuousRatingPower ?maximumNode .

                ?calculatedNode qudt:numericValue ?calculatedPower .
                ?maximumNode qudt:numericValue ?maximumPower .

                FILTER (
                    (
                        ?ice IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                        &&
                        ?maximumPower < IF(
                            ?calculatedPower > 1000.0,
                            ?calculatedPower,
                            1000.0
                        )
                    )
                    ||
                    (
                        ?ice = nltl:iceClassIaSuper
                        &&
                        ?maximumPower < IF(
                            ?calculatedPower > 2800.0,
                            ?calculatedPower,
                            2800.0
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF018Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F02/ship> ] .

