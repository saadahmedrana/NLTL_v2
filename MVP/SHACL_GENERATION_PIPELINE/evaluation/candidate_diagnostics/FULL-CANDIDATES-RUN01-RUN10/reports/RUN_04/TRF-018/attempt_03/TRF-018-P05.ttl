@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:node gen:IceClassIaSuperCaseShape ] , [ sh:node gen:IceClassIaIbIcCaseShape ] , [ sh:node gen:IceClassIiIiiCaseShape ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF018ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P05/ship> ] .

