@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F03/ship> ;
            sh:resultMessage "Maximum continuous rating power must be at least the calculated required power and the applicable minimum threshold." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Maximum continuous rating power must be at least the calculated required power and the applicable minimum threshold." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:calculatedRequiredPower ?calculatedQuantity ;
                      nltl:maximumContinuousRatingPower ?ratingQuantity .
                ?calculatedQuantity qudt:numericValue ?calculatedValue ;
                                    qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                ?ratingQuantity qudt:numericValue ?ratingValue ;
                                qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                FILTER (
                    (
                        ?ice = nltl:iceClassIaSuper &&
                        (
                            ?ratingValue < ?calculatedValue ||
                            ?ratingValue < 2800
                        )
                    ) ||
                    (
                        ?ice IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        ) &&
                        (
                            ?ratingValue < ?calculatedValue ||
                            ?ratingValue < 1000
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF018ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F03/ship> ] .

