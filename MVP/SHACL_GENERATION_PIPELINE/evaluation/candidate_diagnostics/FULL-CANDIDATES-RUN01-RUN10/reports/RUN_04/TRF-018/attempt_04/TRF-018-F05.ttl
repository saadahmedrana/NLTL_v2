@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F05/ship> ;
            sh:resultMessage "maximumContinuousRatingPower must contain an xsd:decimal numeric value in kW." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "maximumContinuousRatingPower must contain an xsd:decimal numeric value in kW." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:iceClass ?ice ;
                          nltl:maximumContinuousRatingPower ?ratingQuantity .
                    FILTER (
                        ?ice = nltl:iceClassIaSuper ||
                        ?ice IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                    )
                    FILTER NOT EXISTS {
                        ?ratingQuantity qudt:numericValue ?ratingValue .
                    }
                }
                UNION
                {
                    $this nltl:iceClass ?ice ;
                          nltl:maximumContinuousRatingPower ?ratingQuantity .
                    FILTER (
                        ?ice = nltl:iceClassIaSuper ||
                        ?ice IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                    )
                    ?ratingQuantity qudt:numericValue ?ratingValue .
                    FILTER (datatype(?ratingValue) != xsd:decimal)
                }
                UNION
                {
                    $this nltl:iceClass ?ice ;
                          nltl:maximumContinuousRatingPower ?ratingQuantity .
                    FILTER (
                        ?ice = nltl:iceClassIaSuper ||
                        ?ice IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                    )
                    FILTER NOT EXISTS {
                        ?ratingQuantity qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF018ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F05/ship> ] .

