@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/mcr> ;
            sh:resultMessage "Node ex:mcr->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/KiloW>']" ;
            sh:resultPath qudt:unit ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path qudt:unit ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/ship> ;
            sh:resultMessage "For a ship under the 1985 ice-class regulations retaining ice class IB or IC, maximum continuous rating power shall be at least the required power under the 1985 rules." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a ship under the 1985 ice-class regulations retaining ice class IB or IC, maximum continuous rating power shall be at least the required power under the 1985 rules." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:applicableIceClassRegulationEdition
                    nltl:iceClassRuleEdition1985 ;
                    nltl:iceClass ?iceClass .

                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )

                FILTER NOT EXISTS {
                    $this nltl:maximumContinuousRatingPower ?maximumPower ;
                        nltl:requiredPowerUnder1985Rules ?requiredPower .

                    ?maximumPower qudt:numericValue ?maximumValue ;
                        qudt:unit <http://qudt.org/vocab/unit/KiloW> .

                    ?requiredPower qudt:numericValue ?requiredValue ;
                        qudt:unit <http://qudt.org/vocab/unit/KiloW> .

                    FILTER (?maximumValue >= ?requiredValue)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-023-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/ship> ] .

