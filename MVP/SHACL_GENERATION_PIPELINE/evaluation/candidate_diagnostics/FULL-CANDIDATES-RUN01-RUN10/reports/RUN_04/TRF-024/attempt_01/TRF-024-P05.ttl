@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-P05/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:sparql [ sh:message Literal("The rule is not applicable to ice class IA Super or IA when the construction-stage condition is absent because another permitted ice class is not recorded.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER (
                            ?iceClass NOT IN (
                                nltl:iceClassIaSuper,
                                nltl:iceClassIa
                            )
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("2003-09-01", datatype=xsd:date) ; sh:path nltl:constructionStageDate ], [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("2003-09-01", datatype=xsd:date) ; sh:path nltl:constructionStageDate ], [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxExclusive Literal("2003-09-01", datatype=xsd:date) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:assessmentDate ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:deliveryDate ], [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ], [ sh:in ( nltl:traficom2017Section3Point2Point2Method ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:engineOutputComplianceMethod ] ; sh:sparql [ sh:message Literal("For an applicable IA Super ship, section 3.2.2 compliance must be established by 1 January in the year twenty years after delivery.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:deliveryDate ?deliveryDate ;
                              nltl:assessmentDate ?assessmentDate .
                        BIND (YEAR(?deliveryDate) + 20 AS ?deadlineYear)
                        BIND (YEAR(?assessmentDate) AS ?assessmentYear)
                        FILTER (
                            ?assessmentYear > ?deadlineYear
                            ||
                            (
                                ?assessmentYear = ?deadlineYear
                                &&
                                (
                                    MONTH(?assessmentDate) > 1
                                    ||
                                    (
                                        MONTH(?assessmentDate) = 1
                                        && DAY(?assessmentDate) > 1
                                    )
                                )
                            )
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxExclusive Literal("2003-09-01", datatype=xsd:date) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:assessmentDate ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:deliveryDate ], [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ], [ sh:in ( nltl:traficom2017Section3Point2Point2Method ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:engineOutputComplianceMethod ] ; sh:sparql [ sh:message Literal("For an applicable IA ship, section 3.2.2 compliance must be established by 1 January in the year twenty years after delivery.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:deliveryDate ?deliveryDate ;
                              nltl:assessmentDate ?assessmentDate .
                        BIND (YEAR(?deliveryDate) + 20 AS ?deadlineYear)
                        BIND (YEAR(?assessmentDate) AS ?assessmentYear)
                        FILTER (
                            ?assessmentYear > ?deadlineYear
                            ||
                            (
                                ?assessmentYear = ?deadlineYear
                                &&
                                (
                                    MONTH(?assessmentDate) > 1
                                    ||
                                    (
                                        MONTH(?assessmentDate) = 1
                                        && DAY(?assessmentDate) > 1
                                    )
                                )
                            )
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF024ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-P05/ship> ] .

