@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("constructionStageDate is required to establish applicability for IA Super or IA ships.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ; sh:path nltl:iceClass ], gen:ClampedHullGeometryTerm, gen:CoefficientC3, gen:CoefficientC4, gen:CoefficientC5, gen:CoefficientF1, gen:CoefficientF2, gen:CoefficientF3, gen:CoefficientF4, gen:CoefficientG1, gen:CoefficientG2, gen:CoefficientG3, gen:IceClassDraught, gen:ShipBreadth, gen:ShipLength ; sh:sparql [ sh:message Literal("The construction stage date must be before 1 September 2003 for the applicable IA Super or IA rule.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass ;
                              nltl:constructionStageDate ?date .
                        FILTER (
                            ?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa)
                        )
                        FILTER (
                            YEAR(?date) > 2003 ||
                            (YEAR(?date) = 2003 && MONTH(?date) > 9) ||
                            (YEAR(?date) = 2003 && MONTH(?date) = 9 && DAY(?date) >= 1)
                        )
                    }
                ") ], [ sh:message Literal("clampedHullGeometryTerm must equal the clamped value of ((shipLength * iceClassDraught) / shipBreadth squared) cubed.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:shipLength ?lengthNode ;
                              nltl:iceClassDraught ?draughtNode ;
                              nltl:shipBreadth ?breadthNode ;
                              nltl:clampedHullGeometryTerm ?resultNode .
                        ?lengthNode qudt:numericValue ?length .
                        ?draughtNode qudt:numericValue ?draught .
                        ?breadthNode qudt:numericValue ?breadth .
                        ?resultNode qudt:numericValue ?reported .
                        BIND (((?length * ?draught) / (?breadth * ?breadth)) *
                              ((?length * ?draught) / (?breadth * ?breadth)) *
                              ((?length * ?draught) / (?breadth * ?breadth)) AS ?raw)
                        BIND (IF(?raw < 5, 5, IF(?raw > 20, 20, ?raw)) AS ?expected)
                        BIND ((ABS(?expected) * 0.000001) + 0.000000001 AS ?tolerance)
                        FILTER (ABS(?reported - ?expected) > ?tolerance)
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("constructionStageDate is required to establish applicability for IA Super or IA ships.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ; sh:path nltl:iceClass ] ; sh:sparql [ sh:message Literal("The Table 3-3 and clamped-geometry constraints must not be selected for a construction stage on or after 1 September 2003.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass ;
                              nltl:constructionStageDate ?date .
                        FILTER (
                            ?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa)
                        )
                        FILTER (
                            YEAR(?date) < 2003 ||
                            (YEAR(?date) = 2003 && MONTH(?date) < 9) ||
                            (YEAR(?date) = 2003 && MONTH(?date) = 9 && DAY(?date) < 1)
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF027Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-F02/ship> ] .

