@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:node nltlgen:TRF027ApplicableShape ; sh:property [ sh:datatype xsd:date ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxExclusive Literal(\"2003-09-01\", datatype=xsd:date) ; sh:message Literal(\"IA Super ships subject to this rule must have a construction stage date before 1 September 2003.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:hasValue nltl:iceClassIaSuper ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:node nltlgen:TRF027ApplicableShape ; sh:property [ sh:datatype xsd:date ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxExclusive Literal(\"2003-09-01\", datatype=xsd:date) ; sh:message Literal(\"IA ships subject to this rule must have a construction stage date before 1 September 2003.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:hasValue nltl:iceClassIa ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For an IA Super or IA ship dated on or after 1 September 2003, the Section 3.2.4 calculation is not applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2003-09-01\", datatype=xsd:date) ; sh:path nltl:constructionStageDate ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:TRF027Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-F03/ship> ] .

