@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F03/ship> ;
            sh:resultMessage "The ship shall provide alternative-calculation or model-test evidence." ;
            sh:resultPath nltl:hasEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide alternative-calculation or model-test evidence." ;
                    sh:minCount 1 ;
                    sh:node [ sh:or ( [ sh:class nltl:alternativeCalculationEvidence ] [ sh:class nltl:modelTestEvidence ] ) ] ;
                    sh:path nltl:hasEvidence ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F03/ship> ;
            sh:resultMessage "The alternative Ke or RCH determination shall have approved status." ;
            sh:resultPath nltl:approvalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The alternative Ke or RCH determination shall have approved status." ;
                    sh:minCount 1 ;
                    sh:path nltl:approvalStatus ] ] .

