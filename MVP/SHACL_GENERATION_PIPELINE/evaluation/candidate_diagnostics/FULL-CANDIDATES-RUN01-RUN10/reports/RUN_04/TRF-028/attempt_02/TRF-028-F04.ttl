@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F04/ship> ;
            sh:resultMessage "The alternative determination must have the controlled Approved revocation status." ;
            sh:resultPath nltl:approvalRevocationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:evidenceStateApproved ) ;
                    sh:maxCount 1 ;
                    sh:message "The alternative determination must have the controlled Approved revocation status." ;
                    sh:minCount 1 ;
                    sh:path nltl:approvalRevocationStatus ] ;
            sh:value nltl:evidenceStateRevoked ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F04/ship> ;
            sh:resultMessage "The ship must provide approved alternative calculation or model-test evidence together with an alternative Ke or RCH result." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-028> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F04/ship> ] .

