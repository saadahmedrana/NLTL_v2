@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-029-F02/ship> ;
            sh:resultMessage "Record whether direct analysis is used and satisfy the corresponding prescribed-procedure and approval conditions." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-029-DirectAnalysisShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-029-F02/ship> ] .

