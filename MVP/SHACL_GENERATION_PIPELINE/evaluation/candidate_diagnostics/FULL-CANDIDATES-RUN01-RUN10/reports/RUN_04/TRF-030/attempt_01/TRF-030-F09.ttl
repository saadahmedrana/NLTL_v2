            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n05274647fada49679f49a81a9a60f873b4 ;
