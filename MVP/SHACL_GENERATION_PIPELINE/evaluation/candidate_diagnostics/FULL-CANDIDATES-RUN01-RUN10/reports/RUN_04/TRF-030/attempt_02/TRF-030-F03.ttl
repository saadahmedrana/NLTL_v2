@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchHeight" ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-LengthQuantityShape> ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ;
            sh:resultMessage "Less than 3 values on ex:ship->nltl:hasDirectAnalysisCase" ;
            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 3 ;
                    sh:or ( [ sh:property [ sh:datatype xsd:boolean ;
                                        sh:hasValue true ;
                                        sh:minCount 1 ;
                                        sh:path nltl:loadLengthDeterminedFromArrangement ] ] [ sh:property [ sh:datatype xsd:boolean ;
                                        sh:hasValue false ;
                                        sh:minCount 1 ;
                                        sh:path nltl:loadLengthDeterminedFromArrangement ] ] ) ;
                    sh:path nltl:hasDirectAnalysisCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadLengthDeterminedFromArrangement ], [ sh:minCount Literal(\"3\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-030-ArrangementDeterminedCaseShape> ; sh:path nltl:hasDirectAnalysisCase ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadLengthDeterminedFromArrangement ], [ sh:minCount Literal(\"3\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-030-ArrangementUndeterminedCaseShape> ; sh:path nltl:hasDirectAnalysisCase ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-030-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ;
            sh:resultMessage "At least one direct analysis case must represent an intermediate vertical load position." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "At least one direct analysis case must represent an intermediate vertical load position." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasDirectAnalysisCase ?case .
                    ?case nltl:verticalLoadPositionType nltl:intermediateVerticalPosition .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-030-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ;
            sh:resultMessage "At least one direct analysis case must be positioned 0.5h0 below the lower ice waterline and provide its lower ice waterline reference position." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "At least one direct analysis case must be positioned 0.5h0 below the lower ice waterline and provide its lower ice waterline reference position." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasDirectAnalysisCase ?case .
                    ?case nltl:verticalLoadPositionType nltl:halfLoadHeightBelowLowerIceWaterlinePosition ;
                          nltl:lowerIceWaterlineReferencePosition ?reference .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-030-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ;
            sh:resultMessage "At least one direct analysis case must be centred at the mid-span or mid-spacing position." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "At least one direct analysis case must be centred at the mid-span or mid-spacing position." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasDirectAnalysisCase ?case .
                    ?case nltl:horizontalLoadPositionType nltl:midSpanOrSpacingCenteredPosition .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-030-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:appliedIcePressure" ;
            sh:resultPath nltl:appliedIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-PressureQuantityShape> ;
                    sh:path nltl:appliedIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ;
            sh:resultMessage "At least one direct analysis case must be centred at the upper ice waterline and provide its upper ice waterline reference position." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "At least one direct analysis case must be centred at the upper ice waterline and provide its upper ice waterline reference position." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasDirectAnalysisCase ?case .
                    ?case nltl:verticalLoadPositionType nltl:upperIceWaterlineCenteredPosition ;
                          nltl:upperIceWaterlineReferencePosition ?reference .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-030-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadLengthDeterminedFromArrangement" ;
            sh:resultPath nltl:loadLengthDeterminedFromArrangement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:minCount 1 ;
                    sh:path nltl:loadLengthDeterminedFromArrangement ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:span" ;
            sh:resultPath nltl:span ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-LengthQuantityShape> ;
                    sh:path nltl:span ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:spacing" ;
            sh:resultPath nltl:spacing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-LengthQuantityShape> ;
                    sh:path nltl:spacing ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:icePressure" ;
            sh:resultPath nltl:icePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-PressureQuantityShape> ;
                    sh:path nltl:icePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ;
            sh:resultMessage "Several horizontal direct analysis locations must include an other horizontal position." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Several horizontal direct analysis locations must include an other horizontal position." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasDirectAnalysisCase ?case .
                    ?case nltl:horizontalLoadPositionType nltl:otherHorizontalPosition .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-030-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F03/ship> ] .

