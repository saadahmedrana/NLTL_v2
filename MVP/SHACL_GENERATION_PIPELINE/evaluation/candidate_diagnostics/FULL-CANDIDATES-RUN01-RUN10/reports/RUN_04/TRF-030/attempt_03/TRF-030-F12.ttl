@prefix n: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F12/ship> ;
            sh:resultMessage "The ship must provide load patch height as a decimal metre quantity." ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide load patch height as a decimal metre quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F12/ship> ;
            sh:resultMessage "The ship must provide spacing as a decimal metre quantity." ;
            sh:resultPath nltl:spacing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide spacing as a decimal metre quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:spacing ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F12/directAnalysis> ;
                    sh:resultMessage "Less than 1 values on ex:directAnalysis->nltl:verticalLoadPositionType" ;
                    sh:resultPath nltl:verticalLoadPositionType ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:upperIceWaterlineCenteredPosition nltl:halfLoadHeightBelowLowerIceWaterlinePosition nltl:intermediateVerticalPosition ) ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:verticalLoadPositionType ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F12/directAnalysis> ;
                    sh:resultMessage "Node ex:directAnalysis must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:upperIceWaterlineCenteredPosition ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:verticalLoadPositionType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:upperIceWaterlineReferencePosition ] ] , [ sh:property [ sh:hasValue nltl:halfLoadHeightBelowLowerIceWaterlinePosition ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:verticalLoadPositionType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:lowerIceWaterlineReferencePosition ] ] , [ sh:property [ sh:hasValue nltl:intermediateVerticalPosition ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:verticalLoadPositionType ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape n:TRF030DirectAnalysisCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F12/directAnalysis> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F12/directAnalysis> ;
                    sh:resultMessage "Less than 1 values on ex:directAnalysis->nltl:horizontalLoadPositionType" ;
                    sh:resultPath nltl:horizontalLoadPositionType ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:midSpanOrSpacingCenteredPosition nltl:otherHorizontalPosition ) ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:horizontalLoadPositionType ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F12/ship> ;
            sh:resultMessage "The ship must provide direct analysis cases with the required load-position and analysis results." ;
            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide direct analysis cases with the required load-position and analysis results." ;
                    sh:minCount 1 ;
                    sh:node n:TRF030DirectAnalysisCaseShape ;
                    sh:path nltl:hasDirectAnalysisCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F12/directAnalysis> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F12/ship> ;
            sh:resultMessage "The ship must state whether load length was determined from the arrangement." ;
            sh:resultPath nltl:loadLengthDeterminedFromArrangement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ship must state whether load length was determined from the arrangement." ;
                    sh:minCount 1 ;
                    sh:path nltl:loadLengthDeterminedFromArrangement ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F12/ship> ;
            sh:resultMessage "The ship must provide ice pressure as a decimal MPa quantity." ;
            sh:resultPath nltl:icePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide ice pressure as a decimal MPa quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:icePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F12/ship> ;
            sh:resultMessage "Direct analysis cases must cover UIWL, 0.5h0 below LIWL, several intermediate vertical locations, and several horizontal locations including mid-span or spacing-centered and other horizontal positions." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Direct analysis cases must cover UIWL, 0.5h0 below LIWL, several intermediate vertical locations, and several horizontal locations including mid-span or spacing-centered and other horizontal positions." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasDirectAnalysisCase ?uiwlCase .
                        ?uiwlCase nltl:verticalLoadPositionType
                            nltl:upperIceWaterlineCenteredPosition .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasDirectAnalysisCase ?liwlCase .
                        ?liwlCase nltl:verticalLoadPositionType
                            nltl:halfLoadHeightBelowLowerIceWaterlinePosition .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasDirectAnalysisCase ?intermediateCase1 .
                        ?intermediateCase1 nltl:verticalLoadPositionType
                            nltl:intermediateVerticalPosition .
                        $this nltl:hasDirectAnalysisCase ?intermediateCase2 .
                        ?intermediateCase2 nltl:verticalLoadPositionType
                            nltl:intermediateVerticalPosition .
                        FILTER (?intermediateCase1 != ?intermediateCase2)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasDirectAnalysisCase ?midCase .
                        ?midCase nltl:horizontalLoadPositionType
                            nltl:midSpanOrSpacingCenteredPosition .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasDirectAnalysisCase ?otherCase1 .
                        ?otherCase1 nltl:horizontalLoadPositionType
                            nltl:otherHorizontalPosition .
                        $this nltl:hasDirectAnalysisCase ?otherCase2 .
                        ?otherCase2 nltl:horizontalLoadPositionType
                            nltl:otherHorizontalPosition .
                        FILTER (?otherCase1 != ?otherCase2)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape n:TRF030ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F12/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F12/ship> ;
            sh:resultMessage "The ship must provide span as a decimal metre quantity." ;
            sh:resultPath nltl:span ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide span as a decimal metre quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:span ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F12/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:loadLengthDeterminedFromArrangement ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:loadLengthDeterminedFromArrangement ] ; sh:sparql [ sh:message Literal("When load length is not determined from the arrangement, several distinct direct analysis cases must pair load patch length with ice load area factor ca on the same case.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:hasDirectAnalysisCase ?case1 .
                            ?case1 nltl:loadPatchLength ?length1 ;
                                   nltl:iceLoadAreaFactorCa ?ca1 .
                            $this nltl:hasDirectAnalysisCase ?case2 .
                            ?case2 nltl:loadPatchLength ?length2 ;
                                   nltl:iceLoadAreaFactorCa ?ca2 .
                            FILTER (?case1 != ?case2)
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape n:TRF030ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F12/ship> ] .

