@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:TRF032NotIceStrengthenedBranch , gen:TRF032IceStrengthenedBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF032Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:iceStrengtheningStatus" ;
            sh:resultPath nltl:iceStrengtheningStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:iceStrengtheningStatus ] ] .

