@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F04/effectiveSection> ;
            sh:resultMessage "The member-normal-to-plating status must be stated; classification-society section-property calculation evidence is required when the member is not normal to the plating." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-034-effective-member-cross-section> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F04/effectiveSection> ] .

