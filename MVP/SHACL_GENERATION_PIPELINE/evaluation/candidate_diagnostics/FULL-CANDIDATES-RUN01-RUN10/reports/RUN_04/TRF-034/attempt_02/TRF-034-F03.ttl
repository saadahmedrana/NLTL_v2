@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/member> ;
            sh:resultMessage "Each hull structure must state whether the member is normal to the plating." ;
            sh:resultPath nltl:memberNormalToPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Each hull structure must state whether the member is normal to the plating." ;
                    sh:minCount 1 ;
                    sh:path nltl:memberNormalToPlating ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/member> ;
            sh:resultMessage "Node ex:member must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:memberNormalToPlating ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:memberNormalToPlating ], [ sh:node gs:EffectiveMemberCrossSectionEvidenceShape ; sh:path nltl:hasEffectiveMemberCrossSection ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:HullStructureShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/member> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/effectiveSection> ;
                    sh:resultMessage "Each effective member cross section must provide one shear area in square metres." ;
                    sh:resultPath nltl:shearArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nd63326d6feeb4a72903b3a6918d2bd78b5 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/effectiveSection> ;
            sh:resultMessage "Value does not conform to Shape gs:EffectiveMemberCrossSectionShape. See details for more information." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape gs:EffectiveMemberCrossSectionTargetShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/effectiveSection> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/effectiveSection> ;
                            sh:resultMessage "Each effective member cross section must provide one shear area in square metres." ;
                            sh:resultPath nltl:shearArea ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nd63326d6feeb4a72903b3a6918d2bd78b5 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/effectiveSection> ;
                    sh:resultMessage "Value does not conform to Shape gs:EffectiveMemberCrossSectionShape. See details for more information." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape gs:EffectiveMemberCrossSectionRelationshipShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/effectiveSection> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/member> ;
            sh:resultMessage "Each hull structure must identify its effective member cross section." ;
            sh:resultPath nltl:hasEffectiveMemberCrossSection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each hull structure must identify its effective member cross section." ;
                    sh:minCount 1 ;
                    sh:node gs:EffectiveMemberCrossSectionRelationshipShape ;
                    sh:path nltl:hasEffectiveMemberCrossSection ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F03/effectiveSection> ] .

_:N73211f1787664753a83a19295540dfd7 sh:class qudt:QuantityValue ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ],
        [ sh:hasValue <http://qudt.org/vocab/unit/M2> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:nd63326d6feeb4a72903b3a6918d2bd78b5 sh:maxCount 1 ;
