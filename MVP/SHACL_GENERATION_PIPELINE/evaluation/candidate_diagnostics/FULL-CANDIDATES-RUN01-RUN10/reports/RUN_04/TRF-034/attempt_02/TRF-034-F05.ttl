@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F05/member> ;
            sh:resultMessage "Node ex:member must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:memberNormalToPlating ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:memberNormalToPlating ], [ sh:node gs:EffectiveMemberCrossSectionEvidenceShape ; sh:path nltl:hasEffectiveMemberCrossSection ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:HullStructureShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F05/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F05/member> ;
            sh:resultMessage "Each hull structure must state whether the member is normal to the plating." ;
            sh:resultPath nltl:memberNormalToPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Each hull structure must state whether the member is normal to the plating." ;
                    sh:minCount 1 ;
                    sh:path nltl:memberNormalToPlating ] ] .

