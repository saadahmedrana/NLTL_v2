@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F06/designParameters> ;
            sh:resultMessage "The ice class, level ice thickness, and design ice load height must match the applicable Table 4-1 values." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The ice class, level ice thickness, and design ice load height must match the applicable Table 4-1 values." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  FILTER NOT EXISTS {
    ?ship nltl:hasIceClassDesignParameterSet $this .
    ?ship nltl:iceClass ?iceClass .
    $this nltl:levelIceThickness ?levelQuantity .
    $this nltl:designIceLoadHeight ?heightQuantity .
    ?levelQuantity qudt:numericValue ?levelValue .
    ?heightQuantity qudt:numericValue ?heightValue .
    FILTER (
      (
        ?iceClass = nltl:iceClassIaSuper &&
        ?levelValue >= "1.0"^^xsd:decimal &&
        ?levelValue <= "1.0"^^xsd:decimal &&
        ?heightValue >= "0.35"^^xsd:decimal &&
        ?heightValue <= "0.35"^^xsd:decimal
      ) ||
      (
        ?iceClass = nltl:iceClassIa &&
        ?levelValue >= "0.8"^^xsd:decimal &&
        ?levelValue <= "0.8"^^xsd:decimal &&
        ?heightValue >= "0.30"^^xsd:decimal &&
        ?heightValue <= "0.30"^^xsd:decimal
      ) ||
      (
        ?iceClass = nltl:iceClassIb &&
        ?levelValue >= "0.6"^^xsd:decimal &&
        ?levelValue <= "0.6"^^xsd:decimal &&
        ?heightValue >= "0.25"^^xsd:decimal &&
        ?heightValue <= "0.25"^^xsd:decimal
      ) ||
      (
        ?iceClass = nltl:iceClassIc &&
        ?levelValue >= "0.4"^^xsd:decimal &&
        ?levelValue <= "0.4"^^xsd:decimal &&
        ?heightValue >= "0.22"^^xsd:decimal &&
        ?heightValue <= "0.22"^^xsd:decimal
      )
    )
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-036_IceClassDesignParameterSetShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F06/designParameters> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F06/levelIceThickness> ;
                    sh:resultMessage "Node ex:levelIceThickness->qudt:unit does not contain a value in the set: ['unit:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue unit:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F06/designParameters> ;
            sh:resultMessage "The level ice thickness must be provided as one metre quantity." ;
            sh:resultPath nltl:levelIceThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The level ice thickness must be provided as one metre quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:levelIceThickness ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F06/levelIceThickness> ] .

