@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F05/designParameters> ;
            sh:resultMessage "Each ice-class design parameter set must be associated with a ship that has a permitted ice class." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each ice-class design parameter set must be associated with a ship that has a permitted ice class." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    ?ship a nltl:ship ;
                          nltl:hasIceClassDesignParameterSet $this ;
                          nltl:iceClass ?iceClass .
                    FILTER (?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    ))
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-036-IceClassDesignParameterSetShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F05/designParameters> ] .

