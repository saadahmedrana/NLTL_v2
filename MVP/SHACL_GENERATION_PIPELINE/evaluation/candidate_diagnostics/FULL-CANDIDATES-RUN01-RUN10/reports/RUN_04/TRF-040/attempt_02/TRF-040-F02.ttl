@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F02/ship> ;
            sh:resultMessage "The shell thickness shall be supplied as one quantity in metres." ;
            sh:resultPath nltl:thickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The shell thickness shall be supplied as one quantity in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:thickness ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F02/ship> ;
            sh:resultMessage "The conditional ice-belt strengthening statuses shall be satisfied for the ship's ice class, service speed, and weather-deck condition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The conditional ice-belt strengthening statuses shall be satisfied for the ship's ice class, service speed, and weather-deck condition." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:iceClass ?iceClass .
  FILTER (
    (
      ?iceClass = nltl:iceClassIaSuper &&
      NOT EXISTS {
        $this nltl:forefootShellStrengtheningStatus ?forefootStatus .
        FILTER (?forefootStatus = true)
      }
    )
    ||
    (
      ?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa) &&
      EXISTS {
        $this nltl:openWaterServiceSpeed ?speed .
        ?speed qudt:numericValue ?speedValue .
        FILTER (datatype(?speedValue) = xsd:decimal && ?speedValue >= 18)
      } &&
      NOT EXISTS {
        $this nltl:upperBowIceBeltStrengtheningStatus ?upperBowStatus .
        FILTER (?upperBowStatus = true)
      }
    )
    ||
    (
      EXISTS {
        $this nltl:weatherDeckBelowIceBeltUpperLimit ?deckStatus .
        FILTER (?deckStatus = true)
      } &&
      (
        NOT EXISTS {
          $this nltl:bulwarkStrengthStatus ?bulwarkStatus .
          FILTER (?bulwarkStatus = true)
        }
        ||
        NOT EXISTS {
          $this nltl:freeingPortStrengthStatus ?freeingPortStatus .
          FILTER (?freeingPortStatus = true)
        }
      )
    )
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-040> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F02/ship> ;
            sh:resultMessage "The design operation speed in ice shall be supplied as one quantity in knots." ;
            sh:resultPath nltl:designOperationSpeedInIce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The design operation speed in ice shall be supplied as one quantity in knots." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designOperationSpeedInIce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F02/ship> ;
            sh:resultMessage "The main-frame spacing shall be supplied as one quantity in metres." ;
            sh:resultPath nltl:spacing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The main-frame spacing shall be supplied as one quantity in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:spacing ] ] .

