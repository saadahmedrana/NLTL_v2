@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F05/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in ([ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("For ice class IA Super, the forefoot shell plating below the ice belt shall be equivalent to the bow region from the bow-profile departure through five main-frame spacings abaft that point.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bowRegionEquivalent ], [ sh:hasValue nltl:iceClassIaSuper ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:in ( nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ] ]) and ([ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ] ; sh:sparql [ sh:message Literal("For ice class IA Super or IA below 18 knots, the upper-bow strengthening obligation is not triggered by the speed condition.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER (?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
                        $this nltl:designOperationSpeedInIce ?speedQuantity .
                        ?speedQuantity qudt:numericValue ?speed .
                        FILTER (?speed < 18)
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The upper-bow ice-belt region shall be strengthened in the same way as the midbody region for the specified vertical and longitudinal extent.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:midbodyEquivalent ] ; sh:sparql [ sh:message Literal("For ice class IA Super or IA at or above 18 knots, the upper-bow ice-belt strengthening shall be equivalent to the midbody region from the ice-belt upper limit to 2 m above it and at least 0.2 L abaft the forward perpendicular.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER (?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
                        $this nltl:designOperationSpeedInIce ?speedQuantity .
                        ?speedQuantity qudt:numericValue ?speed .
                        FILTER (?speed >= 18)
                    }
                ") ] ]) and ([ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Where the weather deck is below the ice-belt upper limit, the bulwark shall have at least the strength required for the ice-belt shell.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bulwarkStrengthStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Where the weather deck is below the ice-belt upper limit, the freeing-port construction shall meet the ice-belt shell strength requirements.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:freeingPortStrengthStatus ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:weatherDeckBelowIceBeltUpperLimit ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:weatherDeckBelowIceBeltUpperLimit ] ])""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_040_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:spacing" ;
            sh:resultPath nltl:spacing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:spacing ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F05/ship> ;
            sh:resultMessage "The declared design operation speed in ice shall be supplied as a single quantity in knots." ;
            sh:resultPath nltl:designOperationSpeedInIce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The declared design operation speed in ice shall be supplied as a single quantity in knots." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designOperationSpeedInIce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:thickness" ;
            sh:resultPath nltl:thickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:thickness ] ] .

