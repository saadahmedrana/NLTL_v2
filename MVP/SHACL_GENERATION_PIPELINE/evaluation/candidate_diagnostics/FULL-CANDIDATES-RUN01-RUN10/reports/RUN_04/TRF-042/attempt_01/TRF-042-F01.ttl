@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "The longitudinal plating factor f2 shall equal the applicable piecewise formula for h/s within the permitted range, using tolerance max(1e-6*ABS(expected),1e-12)." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The longitudinal plating factor f2 shall equal the applicable piecewise formula for h/s within the permitted range, using tolerance max(1e-6*ABS(expected),1e-12)." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?hValue ;
                      nltl:spacing ?sValue ;
                      nltl:longitudinalPlatingFactorF2 ?f2Value .

                ?hValue qudt:numericValue ?h .
                ?sValue qudt:numericValue ?s .
                ?f2Value qudt:numericValue ?actual .

                BIND((?h / ?s) AS ?ratio)
                BIND(
                    IF(
                        ?ratio <= 1.0,
                        (0.4 / ?ratio) + 0.6,
                        1.4 - (0.4 * ?ratio)
                    )
                    AS ?expected
                )
                BIND(
                    IF(
                        (1e-6 * ABS(?expected)) > 1e-12,
                        (1e-6 * ABS(?expected)),
                        1e-12
                    )
                    AS ?tolerance
                )

                FILTER(
                    ?s <= 0 ||
                    ?ratio < 0 ||
                    ?ratio > 1.8 ||
                    ABS(?actual - ?expected) > ?tolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-042-PlatingShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "Each plating shall provide one corrosion and abrasion addition in millimetres." ;
            sh:resultPath nltl:corrosionAbrasionAddition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each plating shall provide one corrosion and abrasion addition in millimetres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-042-LengthMillimetres> ;
                    sh:path nltl:corrosionAbrasionAddition ] ] .

