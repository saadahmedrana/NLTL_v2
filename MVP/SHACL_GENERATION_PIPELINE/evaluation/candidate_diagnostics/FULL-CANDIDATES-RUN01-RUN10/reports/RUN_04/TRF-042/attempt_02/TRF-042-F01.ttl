@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "longitudinalPlatingFactorF2 must equal the applicable f2 formula within max(1e-6*ABS(expected),1e-12)." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "longitudinalPlatingFactorF2 must equal the applicable f2 formula within max(1e-6*ABS(expected),1e-12)." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?hNode ;
                      nltl:spacing ?sNode ;
                      nltl:longitudinalPlatingFactorF2 ?fNode .
                ?hNode qudt:numericValue ?h .
                ?sNode qudt:numericValue ?s .
                ?fNode qudt:numericValue ?actual .
                FILTER (
                    ?s = 0 ||
                    ?h / ?s > 1.8 ||
                    ABS(
                        ?actual -
                        IF(
                            (?h / ?s) <= 1,
                            0.4 / (?h / ?s) + 0.6,
                            1.4 - 0.4 * (?h / ?s)
                        )
                    ) >
                    IF(
                        1e-6 * ABS(
                            IF(
                                (?h / ?s) <= 1,
                                0.4 / (?h / ?s) + 0.6,
                                1.4 - 0.4 * (?h / ?s)
                            )
                        ) > 1e-12,
                        1e-6 * ABS(
                            IF(
                                (?h / ?s) <= 1,
                                0.4 / (?h / ?s) + 0.6,
                                1.4 - 0.4 * (?h / ?s)
                            )
                        ),
                        1e-12
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF042PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "Node ex:plating must conform to one or more shapes in gen:CorrosionNormalBranch , gen:CorrosionLowerApprovedBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF042PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ] .

