@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F04/designIceLoadHeightValue> ;
                    sh:resultMessage "Node ex:designIceLoadHeightValue->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/M>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F04/plating> ;
            sh:resultMessage "designIceLoadHeight is required in metres." ;
            sh:resultPath nltl:designIceLoadHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "designIceLoadHeight is required in metres." ;
                    sh:minCount 1 ;
                    sh:node gen:HeightQuantityShape ;
                    sh:path nltl:designIceLoadHeight ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F04/designIceLoadHeightValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F04/plating> ;
            sh:resultMessage "Node ex:plating must conform to one or more shapes in gen:CorrosionNormalBranch , gen:CorrosionLowerApprovedBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF042PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F04/plating> ] .

