@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/terminationCase> ;
                    sh:resultMessage "Termination at the adjacent boundary must be permitted when the extension is no more than 250 mm." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Termination at the adjacent boundary must be permitted when the extension is no more than 250 mm." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?extensionQuantity .
                ?extensionQuantity qudt:numericValue ?extension ;
                    qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                FILTER (
                    ?extension <= 250 &&
                    NOT EXISTS {
                        $this nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted true
                    }
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:FramingIceStrengtheningTerminationCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/terminationCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:FramingIceStrengtheningTerminationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasFramingIceStrengtheningTerminationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:FramingIceStrengtheningTerminationCaseShape ;
                    sh:path nltl:hasFramingIceStrengtheningTerminationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/terminationCase> ] .

