@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/terminationCase> ;
            sh:resultMessage "Each framing termination case must identify a deck, tank boundary plating, or tank top as the adjacent boundary." ;
            sh:resultPath nltl:terminationAdjacentBoundary ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape _:n59ed840c1dbd4e62a00026c5d69c6597b2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/boundary> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/terminationCase> ;
                    sh:resultMessage "Each framing termination case must identify a deck, tank boundary plating, or tank top as the adjacent boundary." ;
                    sh:resultPath nltl:terminationAdjacentBoundary ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape _:n59ed840c1dbd4e62a00026c5d69c6597b2 ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/boundary> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape nltl:TRF043_TerminationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasFramingIceStrengtheningTerminationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltl:TRF043_TerminationCaseShape ;
                    sh:path nltl:hasFramingIceStrengtheningTerminationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/terminationCase> ] .

_:N3325dbc0ea9147bf9a3e5f4e45bc01ed rdf:first [ sh:class nltl:deckStructure ] ;
    rdf:rest ( [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] ) .

_:n59ed840c1dbd4e62a00026c5d69c6597b2 sh:maxCount 1 ;
    sh:message "Each framing termination case must identify a deck, tank boundary plating, or tank top as the adjacent boundary." ;
    sh:minCount 1 ;
    sh:or _:N3325dbc0ea9147bf9a3e5f4e45bc01ed ;
    sh:path nltl:terminationAdjacentBoundary .

