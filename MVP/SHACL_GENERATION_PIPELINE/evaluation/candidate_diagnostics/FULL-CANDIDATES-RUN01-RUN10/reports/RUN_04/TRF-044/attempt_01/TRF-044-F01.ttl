@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ;
            sh:resultMessage "Frame moment factor, section modulus, and required shear area must satisfy the prescribed calculation formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Frame moment factor, section modulus, and required shear area must satisfy the prescribed calculation formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:spacing ?sNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?sNode qudt:numericValue ?s .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?m0Node qudt:numericValue ?m0 .
                ?mtNode qudt:numericValue ?mt .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND((7 - 5 * (?h / ?l)) AS ?denominator)
                BIND(IF(?denominator = 0, 0, 7 * ?m0 / ?denominator) AS ?expectedMt)
                BIND(IF(?denominator = 0, 0,
                    ?p * ?s * ?h * ?l / ?expectedMt * 1000000) AS ?expectedZ)
                BIND((1.7320508075688772 * 1.2 * ?p * ?h * ?s /
                    (2 * ?m0) * 10000) AS ?expectedA)

                FILTER (
                    ?denominator = 0 ||
                    ABS(?mt - ?expectedMt) >
                        (0.000001 * ABS(?expectedMt) + 0.000000001) ||
                    ABS(?z - ?expectedZ) >
                        (0.000001 * ABS(?expectedZ) + 0.000000001) ||
                    ABS(?a - ?expectedA) >
                        (0.000001 * ABS(?expectedA) + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-044> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ;
            sh:resultMessage "Node ex:transverseFrame must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:bulkCarrierTopWingTankFrameCondition ; sh:path nltl:frameBoundaryConditionType ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"7\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"7\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:frameBoundaryConditionFactorM0 ] ] , [ sh:property [ sh:hasValue nltl:singleDeckTankTopToMainDeckFrameCondition ; sh:path nltl:frameBoundaryConditionType ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"6\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"6\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:frameBoundaryConditionFactorM0 ] ] , [ sh:property [ sh:hasValue nltl:multiDeckOrStringerContinuousFrameCondition ; sh:path nltl:frameBoundaryConditionType ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"5.7\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"5.7\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:frameBoundaryConditionFactorM0 ] ] , [ sh:property [ sh:hasValue nltl:twoDeckFrameCondition ; sh:path nltl:frameBoundaryConditionType ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"5\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"5\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:frameBoundaryConditionFactorM0 ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-044> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ] .

