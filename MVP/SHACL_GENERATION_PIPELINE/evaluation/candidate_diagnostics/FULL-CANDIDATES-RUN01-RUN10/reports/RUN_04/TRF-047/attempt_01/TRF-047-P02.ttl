@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P02/frame> ;
            sh:resultMessage "Each lower end shall be attached to an allowed supporting structure, or shall use the permitted horizontal connection to an adjacent main frame with the same scantlings when the supporting structure is at or below the lower ice-belt limit." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each lower end shall be attached to an allowed supporting structure, or shall use the permitted horizontal connection to an adjacent main frame with the same scantlings when the supporting structure is at or below the lower ice-belt limit." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasLowerEnd ?end .
                FILTER (
                    (
                        NOT EXISTS {
                            ?end nltl:hasAttachedSupportingStructure ?attached .
                        }
                        &&
                        NOT EXISTS {
                            $this nltl:supportingStructureAtOrBelowIceBeltLowerLimit true .
                            $this nltl:sameScantlingsAsMainFrame true .
                            ?end nltl:hasHorizontalConnectionMember ?member .
                            ?member nltl:connectsToAdjacentMainFrame ?mainFrame .
                        }
                    )
                    ||
                    EXISTS {
                        ?end nltl:hasHorizontalConnectionMember ?member .
                        FILTER (
                            NOT EXISTS {
                                $this nltl:supportingStructureAtOrBelowIceBeltLowerLimit true .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:sameScantlingsAsMainFrame true .
                            }
                            ||
                            NOT EXISTS {
                                ?member nltl:connectsToAdjacentMainFrame ?mainFrame .
                            }
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:TRF_047_FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P02/frame> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P02/lowerEnd> ;
                    sh:resultMessage "The lower end shall have an attached supporting structure or a permitted horizontal connection member." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape nltl:TRF_047_LowerEndShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P02/lowerEnd> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P02/frame> ;
            sh:resultMessage "A transverse frame shall identify its lower end." ;
            sh:resultPath nltl:hasLowerEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A transverse frame shall identify its lower end." ;
                    sh:minCount 1 ;
                    sh:node nltl:TRF_047_LowerEndShape ;
                    sh:path nltl:hasLowerEnd ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P02/lowerEnd> ] .

