@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/frame> ;
            sh:resultMessage "A qualifying intermediate ice frame lower end must have an allowed attached structure or a fully qualified horizontal connection." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A qualifying intermediate ice frame lower end must have an allowed attached structure or a fully qualified horizontal connection." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this a nltl:intermediateIceFrame ;
                      nltl:hasLowerEnd ?lowerEnd .
                FILTER (
                    NOT EXISTS {
                        ?lowerEnd nltl:hasAttachedSupportingStructure ?supportingStructure .
                        ?supportingStructure a ?supportingStructureType .
                        FILTER (
                            ?supportingStructureType IN (
                                nltl:deckStructure,
                                nltl:tankBoundaryPlating,
                                nltl:tankTop,
                                nltl:iceStringer
                            )
                        )
                    }
                    &&
                    NOT EXISTS {
                        $this nltl:supportingStructureAtOrBelowIceBeltLowerLimit true ;
                              nltl:sameScantlingsAsMainFrame true .
                        ?lowerEnd nltl:hasTerminationBelowSupportingStructure ?supportingStructure ;
                                  nltl:hasHorizontalConnectionMember ?horizontalMember .
                        ?horizontalMember nltl:connectsToAdjacentMainFrame ?adjacentMainFrame .
                        ?adjacentMainFrame a nltl:mainFrame .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_047_FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/adjacentMainFrame> ;
            sh:resultMessage "Each applicable main frame or intermediate ice frame must have a strengthened part and a lower end." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each applicable main frame or intermediate ice frame must have a strengthened part and a lower end." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                {
                    $this a nltl:mainFrame .
                }
                UNION
                {
                    $this a nltl:intermediateIceFrame .
                }
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasStrengthenedPart ?strengthenedPart .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasLowerEnd ?lowerEnd .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_047_FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/adjacentMainFrame> ] .

