@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F02/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:class nltl:mainFrame ; sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A main frame below the lower limit of the ice belt must be ice strengthened.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:mainFrameBelowIceBeltStrengthened ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ] ] ) ; sh:property [ sh:message Literal(\"A main frame must have a strengthened part.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrengthenedPart ], [ sh:message Literal(\"The lower end of a main frame strengthened part must be attached to a deck, qualifying tank plating, tank top, or ice stringer.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasLowerEnd ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasAttachedSupportingStructure ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] [ sh:class nltl:iceStringer ] ) ] ] ] ] ] , [ sh:class nltl:intermediateIceFrame ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sameScantlingsAsMainFrame ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ], [ sh:message Literal(\"An intermediate ice frame lower end must be attached to a qualifying structure or satisfy the permitted termination and horizontal-connection alternative.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasLowerEnd ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:or ( [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasAttachedSupportingStructure ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape <http://recursion.too.deep> ] ] [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasHorizontalConnectionMember ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape <http://recursion.too.deep> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasTerminationBelowSupportingStructure ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape <http://recursion.too.deep> ] ] ) ] ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_047_FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F02/frame> ] .

