                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/lowerEnd> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/frame> ;
            sh:resultMessage "Value does not conform to Shape [ sh:or ( [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] [ sh:class nltl:iceStringer ] ) ] ; sh:path nltl:hasAttachedSupportingStructure ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sameScantlingsAsMainFrame ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] [ sh:class nltl:iceStringer ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ] ] ; sh:path nltl:hasTerminationBelowSupportingStructure ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:mainFrame ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:connectsToAdjacentMainFrame ] ] ; sh:path nltl:hasHorizontalConnectionMember ] ] ) ]. See details for more information." ;
            sh:resultPath nltl:hasLowerEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:or ( [ sh:property [ sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:hasAttachedSupportingStructure ] ] [ sh:property [ sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:hasHorizontalConnectionMember ],
                                            [ sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:hasTerminationBelowSupportingStructure ],
