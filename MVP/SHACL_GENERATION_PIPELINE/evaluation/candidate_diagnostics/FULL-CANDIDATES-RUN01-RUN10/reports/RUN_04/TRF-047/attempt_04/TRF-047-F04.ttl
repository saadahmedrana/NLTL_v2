@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/adjacentMainFrame> ;
            sh:resultMessage "A frame shall have a strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameStrengthenedPart ;
                    sh:message "A frame shall have a strengthened part." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasStrengthenedPart ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/lowerEnd> ;
                    sh:resultMessage "Node ex:lowerEnd must conform to one or more shapes in [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] [ sh:class nltl:iceStringer ] ) ] ; sh:path nltl:hasAttachedSupportingStructure ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sameScantlingsAsMainFrame ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] [ sh:class nltl:iceStringer ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ] ] ; sh:path nltl:hasTerminationBelowSupportingStructure ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:mainFrame ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:connectsToAdjacentMainFrame ] ] ; sh:path nltl:hasHorizontalConnectionMember ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:or ( [ sh:property [ sh:minCount 1 ;
                                                sh:node [ sh:or [ ] ] ;
                                                sh:path nltl:hasAttachedSupportingStructure ] ] [ sh:property [ sh:minCount 1 ;
                                                sh:node [ sh:property [ ] ] ;
                                                sh:path nltl:hasHorizontalConnectionMember ],
