                                                sh:hasValue true ;
                                                sh:minCount 1 ;
                                                sh:path nltl:sameScantlingsAsMainFrame ] ] ) ] ;
                    sh:path nltl:hasLowerEnd ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/lowerEnd> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:property [ sh:message Literal(\"The lower end shall be attached to a deck, qualifying tank plating, tank top, or ice stringer.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] [ sh:class nltl:iceStringer ] ) ] ; sh:path nltl:hasAttachedSupportingStructure ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The horizontal connection member shall have the same scantlings as the main frames.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sameScantlingsAsMainFrame ], [ sh:message Literal(\"A qualifying intermediate-frame termination shall have a horizontal member connected to an adjacent main frame.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:mainFrame ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:connectsToAdjacentMainFrame ] ] ; sh:path nltl:hasHorizontalConnectionMember ], [ sh:message Literal(\"The qualifying termination shall be on an allowed supporting structure at or below the lower limit of the ice belt.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] [ sh:class nltl:iceStringer ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ] ] ; sh:path nltl:hasTerminationBelowSupportingStructure ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_047_FrameEndShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/adjacentMainFrame> ;
            sh:resultMessage "Node ex:adjacentMainFrame must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"A main frame identified as below the ice belt shall be ice strengthened.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:mainFrameBelowIceBeltStrengthened ] ] , [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:mainFrameBelowIceBeltStrengthened ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_047_MainFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/adjacentMainFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/lowerEnd> ;
            sh:resultMessage "Node ex:lowerEnd must conform to one or more shapes in [ sh:property [ sh:message Literal(\"The lower end shall be attached to a deck, qualifying tank plating, tank top, or ice stringer.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] [ sh:class nltl:iceStringer ] ) ] ; sh:path nltl:hasAttachedSupportingStructure ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The horizontal connection member shall have the same scantlings as the main frames.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sameScantlingsAsMainFrame ], [ sh:message Literal(\"A qualifying intermediate-frame termination shall have a horizontal member connected to an adjacent main frame.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:mainFrame ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:connectsToAdjacentMainFrame ] ] ; sh:path nltl:hasHorizontalConnectionMember ], [ sh:message Literal(\"The qualifying termination shall be on an allowed supporting structure at or below the lower limit of the ice belt.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] [ sh:class nltl:iceStringer ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ] ] ; sh:path nltl:hasTerminationBelowSupportingStructure ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_047_FrameEndShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/lowerEnd> ] .

