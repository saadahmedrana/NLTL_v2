@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ;
            sh:resultMessage "Value is not Literal with datatype qudt:QuantityValue" ;
            sh:resultPath nltl:icePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:node <urn:nltl:generated-shape:TRF-048-QuantityValueShape> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:icePressure ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/icePressureValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ;
            sh:resultMessage "Node ex:longitudinalFrame must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:significantlyDifferentBoundaryConditions ], [ sh:hasValue nltl:continuousBeamWithBracketsFrameCondition ; sh:path nltl:frameBoundaryConditionType ], [ sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxInclusive Literal(\"13.3\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"13.3\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:path qudt:unit ] ] ; sh:path nltl:frameMomentFactorM ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:significantlyDifferentBoundaryConditions ] ] , [ sh:property [ sh:hasValue nltl:bulkCarrierTopWingTankFrameCondition ; sh:path nltl:frameBoundaryConditionType ] ] , [ sh:property [ sh:hasValue nltl:multiDeckOrStringerContinuousFrameCondition ; sh:path nltl:frameBoundaryConditionType ] ] , [ sh:property [ sh:hasValue nltl:singleDeckTankTopToMainDeckFrameCondition ; sh:path nltl:frameBoundaryConditionType ] ] , [ sh:property [ sh:hasValue nltl:twoDeckFrameCondition ; sh:path nltl:frameBoundaryConditionType ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-048-LongitudinalFrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ] .

