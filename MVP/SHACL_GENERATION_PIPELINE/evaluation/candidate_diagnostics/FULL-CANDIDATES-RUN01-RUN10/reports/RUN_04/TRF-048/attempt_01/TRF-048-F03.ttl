@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/longitudinalFrame> ;
            sh:resultMessage "Value is not Literal with datatype qudt:QuantityValue" ;
            sh:resultPath nltl:icePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:node <urn:nltl:generated-shape:TRF-048-QuantityValueShape> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:icePressure ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/icePressureValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/longitudinalFrame> ;
            sh:resultMessage "f4, section modulus, and required shear area must satisfy the declared formulas within a relative tolerance of 1e-6 plus an absolute fallback of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "f4, section modulus, and required shear area must satisfy the declared formulas within a relative tolerance of 1e-6 plus an absolute fallback of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:spacing ?sNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Node ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p ;
                       qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?hNode qudt:numericValue ?h ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?sNode qudt:numericValue ?s ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?lNode qudt:numericValue ?l ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?mNode qudt:numericValue ?m ;
                       qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?sigmaNode qudt:numericValue ?sigma ;
                           qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?f4Node qudt:numericValue ?f4 ;
                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?zNode qudt:numericValue ?z ;
                       qudt:unit <http://qudt.org/vocab/unit/CentiM3> .
                ?aNode qudt:numericValue ?a ;
                       qudt:unit <http://qudt.org/vocab/unit/CentiM2> .

                BIND ((1 - (0.2 * ?h / ?s)) AS ?expectedF4)
                BIND (((1 - (0.2 * ?h / ?s)) * ?p * ?h * ?l * ?l /
                       (4 * ?m * ?sigma) * 1000000) AS ?expectedZ)
                BIND ((1.7320508075688772 * (1 - (0.2 * ?h / ?s)) * 2.16 *
                       ?p * ?h * ?l / (2 * ?sigma) * 10000) AS ?expectedA)

                FILTER (
                    ABS(?f4 - ?expectedF4) >
                        (ABS(?expectedF4) * 0.000001 + 0.000000001)
                    ||
                    ABS(?z - ?expectedZ) >
                        (ABS(?expectedZ) * 0.000001 + 0.000000001)
                    ||
                    ABS(?a - ?expectedA) >
                        (ABS(?expectedA) * 0.000001 + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-048-LongitudinalFrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/longitudinalFrame> ] .

