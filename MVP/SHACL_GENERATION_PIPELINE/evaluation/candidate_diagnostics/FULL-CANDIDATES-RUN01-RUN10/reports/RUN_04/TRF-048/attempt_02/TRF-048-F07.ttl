@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ;
            sh:resultMessage "Less than 1 values on ex:longitudinalFrame->nltl:longitudinalFrameShearFactorF5" ;
            sh:resultPath nltl:longitudinalFrameShearFactorF5 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node g:ShearFactorShape ;
                    sh:path nltl:longitudinalFrameShearFactorF5 ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ;
            sh:resultMessage "Actual frame shear area must exclude bracket area." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Actual frame shear area must exclude bracket area." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:grossFrameShearArea ?grossNode ;
                      nltl:bracketArea ?bracketNode ;
                      nltl:actualFrameShearArea ?actualNode .
                ?grossNode qudt:numericValue ?gross .
                ?bracketNode qudt:numericValue ?bracket .
                ?actualNode qudt:numericValue ?actual .
                BIND (?gross - ?bracket AS ?expected)
                FILTER (ABS(?actual - ?expected) > (ABS(?expected) * 0.000001 + 0.000000001))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape g:LongitudinalFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ] .

