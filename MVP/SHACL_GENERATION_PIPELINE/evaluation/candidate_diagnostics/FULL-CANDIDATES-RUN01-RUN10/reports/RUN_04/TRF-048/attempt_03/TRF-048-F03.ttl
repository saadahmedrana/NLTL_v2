@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/longitudinalFrame> ;
            sh:resultMessage "The reported f4, section modulus, and required shear area must satisfy the declared formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The reported f4, section modulus, and required shear area must satisfy the declared formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:spacing ?sNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?yNode ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Node ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .
                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?sNode qudt:numericValue ?s .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?yNode qudt:numericValue ?y .
                ?f4Node qudt:numericValue ?f4 .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .
                BIND (1 - 0.2 * ?h / ?s AS ?expectedF4)
                BIND (?expectedF4 * ?p * ?h * ?l * ?l / (4 * ?m * ?y) * 1000000 AS ?expectedZ)
                BIND (1.7320508075688772 * ?expectedF4 * 2.16 * ?p * ?h * ?l / (2 * ?y) * 10000 AS ?expectedA)
                FILTER (
                    ABS(?f4 - ?expectedF4) >
                    0.000001 * IF(ABS(?expectedF4) > 0.000001, ABS(?expectedF4), 0.000001)
                    ||
                    ABS(?z - ?expectedZ) >
                    0.000001 * IF(ABS(?expectedZ) > 0.000001, ABS(?expectedZ), 0.000001)
                    ||
                    ABS(?a - ?expectedA) >
                    0.000001 * IF(ABS(?expectedA) > 0.000001, ABS(?expectedA), 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-048> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/longitudinalFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/longitudinalFrame> ;
            sh:resultMessage "Less than 1 values on ex:longitudinalFrame->nltl:bracketArea" ;
            sh:resultPath nltl:bracketArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:CentiM2 ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:bracketArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/longitudinalFrame> ;
            sh:resultMessage "Less than 1 values on ex:longitudinalFrame->nltl:grossFrameShearArea" ;
            sh:resultPath nltl:grossFrameShearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:CentiM2 ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:grossFrameShearArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F03/longitudinalFrame> ;
            sh:resultMessage "Less than 1 values on ex:longitudinalFrame->nltl:actualFrameShearArea" ;
            sh:resultPath nltl:actualFrameShearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:CentiM2 ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:actualFrameShearArea ] ] .

