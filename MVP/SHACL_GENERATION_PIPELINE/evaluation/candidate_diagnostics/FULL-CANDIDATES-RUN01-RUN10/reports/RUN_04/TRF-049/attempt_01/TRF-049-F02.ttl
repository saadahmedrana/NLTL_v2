@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ;
            sh:resultMessage "The frame must have an effective frame-attachment record." ;
            sh:resultPath nltl:hasFrameAttachment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The frame must have an effective frame-attachment record." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-049_FrameAttachmentShape> ;
                    sh:path nltl:hasFrameAttachment ] ] .

