@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P01/frame> ;
            sh:resultMessage "The frame must be within the ice-strengthened area." ;
            sh:resultPath nltl:withinIceStrengthenedArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The frame must be within the ice-strengthened area." ;
                    sh:minCount 1 ;
                    sh:path nltl:withinIceStrengthenedArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P01/frame> ;
            sh:resultMessage "The frame must have an effective frame-attachment record." ;
            sh:resultPath nltl:hasFrameAttachment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The frame must have an effective frame-attachment record." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-049_FrameAttachmentShape> ;
                    sh:path nltl:hasFrameAttachment ] ] .

