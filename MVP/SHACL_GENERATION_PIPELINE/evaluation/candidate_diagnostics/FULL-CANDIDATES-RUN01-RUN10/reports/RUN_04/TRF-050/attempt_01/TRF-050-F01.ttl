@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F01/attachmentRecord> ;
            sh:resultMessage "Node ex:attachmentRecord must conform to one or more shapes in gen:TRF050ButtCrossingShape , gen:TRF050NoButtCrossingShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF050FrameAttachmentRecordShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F01/attachmentRecord> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F01/attachmentRecord> ;
                    sh:resultMessage "Node ex:attachmentRecord must conform to one or more shapes in gen:TRF050ButtCrossingShape , gen:TRF050NoButtCrossingShape" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:TRF050FrameAttachmentRecordShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F01/attachmentRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F01/frame> ;
            sh:resultMessage "Each frame shall have a frame attachment record." ;
            sh:resultPath nltl:frameAttachment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each frame shall have a frame attachment record." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF050FrameAttachmentRecordShape ;
                    sh:path nltl:frameAttachment ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F01/attachmentRecord> ] .

