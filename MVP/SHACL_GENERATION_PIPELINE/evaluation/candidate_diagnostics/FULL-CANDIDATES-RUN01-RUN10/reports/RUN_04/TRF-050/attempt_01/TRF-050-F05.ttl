@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/attachmentRecord> ;
                    sh:resultMessage "The frame shall be attached to the shell by a double continuous weld." ;
                    sh:resultPath nltl:frameShellWeldType ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n5d27affc83054d6aa4a1697022547dfdb2 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/attachmentRecord> ;
                    sh:resultMessage "The frame shall be attached to the shell by a double continuous weld." ;
                    sh:resultPath nltl:frameShellWeldType ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n5d27affc83054d6aa4a1697022547dfdb2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ;
            sh:resultMessage "Each frame shall have a frame attachment record." ;
            sh:resultPath nltl:frameAttachment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each frame shall have a frame attachment record." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF050FrameAttachmentRecordShape ;
                    sh:path nltl:frameAttachment ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/attachmentRecord> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/attachmentRecord> ;
            sh:resultMessage "The frame shall be attached to the shell by a double continuous weld." ;
            sh:resultPath nltl:frameShellWeldType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n5d27affc83054d6aa4a1697022547dfdb2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in gen:TRF050ButtCrossingShape , gen:TRF050NoButtCrossingShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF050FrameAttachmentRecordShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/attachmentRecord> ;
            sh:resultMessage "The frame shall be attached to the shell by a double continuous weld." ;
            sh:resultPath nltl:frameShellWeldType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n5d27affc83054d6aa4a1697022547dfdb2 ] .

_:n5d27affc83054d6aa4a1697022547dfdb2 sh:hasValue nltl:doubleContinuousWeld ;
    sh:message "The frame shall be attached to the shell by a double continuous weld." ;
    sh:minCount 1 ;
    sh:path nltl:frameShellWeldType .

