@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P02/frame> ;
            sh:resultMessage "The antitripping support region does not satisfy the required frame-span and ice-class scope." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The antitripping support region does not satisfy the required frame-span and ice-class scope." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameSpan ?spanNode .
                ?spanNode qudt:numericValue ?span .
                $this nltl:iceClass ?ice .
                FILTER (
                    (
                        ?span > 4 &&
                        (
                            NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:bowRegion } ||
                            NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion } ||
                            NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:sternRegion } ||
                            NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue }
                        )
                    )
                    ||
                    (
                        ?span <= 4 &&
                        ?ice = nltl:iceClassIaSuper &&
                        (
                            NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:bowRegion } ||
                            NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion } ||
                            NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:sternRegion } ||
                            NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue }
                        )
                    )
                    ||
                    (
                        ?span <= 4 &&
                        ?ice = nltl:iceClassIa &&
                        (
                            NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:bowRegion } ||
                            NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion }
                        )
                    )
                    ||
                    (
                        ?span <= 4 &&
                        (
                            ?ice = nltl:iceClassIb ||
                            ?ice = nltl:iceClassIc
                        ) &&
                        NOT EXISTS {
                            $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                        }
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:TRF052Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P02/frame> ] .

