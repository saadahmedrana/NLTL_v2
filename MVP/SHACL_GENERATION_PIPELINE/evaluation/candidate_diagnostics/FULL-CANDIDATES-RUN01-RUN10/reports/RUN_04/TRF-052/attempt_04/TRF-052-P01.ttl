@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P01/frame> ;
            sh:resultMessage "The frame does not satisfy the applicable antitripping support spacing and region-scope requirement, or the direct-calculation alternative is not valid." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The frame does not satisfy the applicable antitripping support spacing and region-scope requirement, or the direct-calculation alternative is not valid." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:equivalentSupportStatusByDirectCalculation ?alternativeStatus .
                FILTER (
                    ?alternativeStatus = true
                    ||
                    EXISTS {
                        $this nltl:frameAsymmetrical ?asymmetrical .
                        $this nltl:frameWebAngleToShell ?angleQuantity .
                        ?angleQuantity qudt:numericValue ?angle .
                        ?angleQuantity qudt:unit <http://qudt.org/vocab/unit/DEG> .
                        $this nltl:frameSpan ?spanQuantity .
                        ?spanQuantity qudt:numericValue ?span .
                        ?spanQuantity qudt:unit <http://qudt.org/vocab/unit/M> .
                        $this nltl:iceClass ?iceClass .

                        FILTER (
                            ?asymmetrical = true
                            || ?angle < 90
                        )

                        FILTER EXISTS {
                            $this nltl:antitrippingSupportSpacing ?spacingQuantity .
                            ?spacingQuantity qudt:numericValue ?spacing .
                            ?spacingQuantity qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                            FILTER ( ?spacing <= 1300 )
                        }

                        FILTER (
                            (
                                ?span > 4
                                &&
                                NOT EXISTS {
                                    $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                                }
                                ||
                                ?span > 4
                                &&
                                NOT EXISTS {
                                    $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion
                                }
                                ||
                                ?span > 4
                                &&
                                NOT EXISTS {
                                    $this nltl:hasAntitrippingSupportRegion nltl:sternRegion
                                }
                                ||
                                ?span > 4
                                &&
                                NOT EXISTS {
                                    $this nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue
                                }
                            )
                            ||
                            (
                                ?span <= 4
                                &&
                                ?iceClass = nltl:iceClassIaSuper
                                &&
                                NOT EXISTS {
                                    $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                                }
                                ||
                                ?span <= 4
                                &&
                                ?iceClass = nltl:iceClassIaSuper
                                &&
                                NOT EXISTS {
                                    $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion
                                }
                                ||
                                ?span <= 4
                                &&
                                ?iceClass = nltl:iceClassIaSuper
                                &&
                                NOT EXISTS {
                                    $this nltl:hasAntitrippingSupportRegion nltl:sternRegion
                                }
                                ||
                                ?span <= 4
                                &&
                                ?iceClass = nltl:iceClassIaSuper
                                &&
                                NOT EXISTS {
                                    $this nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue
                                }
                            )
                            ||
                            (
                                ?span <= 4
                                &&
                                ?iceClass = nltl:iceClassIa
                                &&
                                NOT EXISTS {
                                    $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                                }
                                ||
                                ?span <= 4
                                &&
                                ?iceClass = nltl:iceClassIa
                                &&
                                NOT EXISTS {
                                    $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion
                                }
                            )
                            ||
                            (
                                ?span <= 4
                                &&
                                (
                                    ?iceClass = nltl:iceClassIb
                                    ||
                                    ?iceClass = nltl:iceClassIc
                                )
                                &&
                                NOT EXISTS {
                                    $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                                }
                            )
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF052Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P01/frame> ] .

