@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/iceStringer> ;
            sh:resultMessage "The design line load, section modulus, and required shear area must satisfy the TRF-053 calculations." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The design line load, section modulus, and required shear area must satisfy the TRF-053 calculations." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:designLineLoad ?lineNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?sigmaNode qudt:numericValue ?sigma .
                ?lineNode qudt:numericValue ?line .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND(IF((?p * ?h) > 0.15, (?p * ?h), 0.15) AS ?designLineLoadMN)
                BIND((1000.0 * ?designLineLoadMN) AS ?expectedLine)
                BIND((0.9 * 1.8 * ?designLineLoadMN * ?l * ?l /
                      (?m * ?sigma) * 1000000.0) AS ?expectedZ)
                BIND((1.7320508075688772 * 0.9 * 1.8 * 1.2 *
                      ?designLineLoadMN * ?l /
                      (2.0 * ?sigma) * 10000.0) AS ?expectedA)

                FILTER(
                    ABS(?line - ?expectedLine) >
                    (0.000001 * ABS(?expectedLine) + 0.000000001)
                    ||
                    ABS(?z - ?expectedZ) >
                    (0.000001 * ABS(?expectedZ) + 0.000000001)
                    ||
                    ABS(?a - ?expectedA) >
                    (0.000001 * ABS(?expectedA) + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF053IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/iceStringer> ] .

