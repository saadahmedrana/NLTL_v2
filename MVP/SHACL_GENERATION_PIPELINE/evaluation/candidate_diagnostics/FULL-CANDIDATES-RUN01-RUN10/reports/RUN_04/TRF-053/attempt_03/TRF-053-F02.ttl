@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F02/iceStringer> ;
            sh:resultMessage "Design line load, section modulus, and required shear area must satisfy the declared formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Design line load, section modulus, and required shear area must satisfy the declared formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:designIceLoadHeight ?heightNode ;
                      nltl:span ?spanNode ;
                      nltl:frameMomentFactorM ?momentNode ;
                      nltl:yieldStrength ?yieldNode ;
                      nltl:designLineLoad ?lineNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?areaNode .

                ?pressureNode qudt:numericValue ?p .
                ?heightNode qudt:numericValue ?h .
                ?spanNode qudt:numericValue ?l .
                ?momentNode qudt:numericValue ?m .
                ?yieldNode qudt:numericValue ?sigma .
                ?lineNode qudt:numericValue ?line .
                ?zNode qudt:numericValue ?z .
                ?areaNode qudt:numericValue ?a .

                BIND((?p * ?h) AS ?product)
                BIND(IF(?product < 0.15, 0.15, ?product) AS ?expectedLineMN)
                BIND((1000 * ?expectedLineMN) AS ?expectedLine)
                BIND((0.9 * 1.8 * ?expectedLineMN * ?l * ?l / (?m * ?sigma) * 1000000) AS ?expectedZ)
                BIND((1.7320508075688772 * 0.9 * 1.8 * 1.2 * ?expectedLineMN * ?l / (2 * ?sigma) * 10000) AS ?expectedA)

                FILTER(
                    ?line < (?expectedLine - (0.000001 * ?expectedLine + 0.000000001)) ||
                    ?line > (?expectedLine + (0.000001 * ?expectedLine + 0.000000001)) ||
                    ?z < (?expectedZ - (0.000001 * ?expectedZ + 0.000000001)) ||
                    ?z > (?expectedZ + (0.000001 * ?expectedZ + 0.000000001)) ||
                    ?a < (?expectedA - (0.000001 * ?expectedA + 0.000000001)) ||
                    ?a > (?expectedA + (0.000001 * ?expectedA + 0.000000001))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_053_IceStringerCalculationShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F02/iceStringer> ] .

