@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F02/iceStringer> ;
            sh:resultMessage "The ice stringer must be located outside the ice belt." ;
            sh:resultPath nltl:locatedOutsideIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n0b245d2142784b95bc7e73747b028936b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F02/iceStringer> ;
            sh:resultMessage "The ice stringer must support ice-strengthened frames." ;
            sh:resultPath nltl:supportsIceStrengthenedFrames ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n0b245d2142784b95bc7e73747b028936b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F02/iceStringer> ;
            sh:resultMessage "The ice stringer must be located outside the ice belt." ;
            sh:resultPath nltl:locatedOutsideIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n0b245d2142784b95bc7e73747b028936b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F02/iceStringer> ;
            sh:resultMessage "The ice stringer must support ice-strengthened frames." ;
            sh:resultPath nltl:supportsIceStrengthenedFrames ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n0b245d2142784b95bc7e73747b028936b2 ] .

_:n0b245d2142784b95bc7e73747b028936b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice stringer must be located outside the ice belt." ;
    sh:minCount 1 ;
    sh:path nltl:locatedOutsideIceBelt .

_:n0b245d2142784b95bc7e73747b028936b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice stringer must support ice-strengthened frames." ;
    sh:minCount 1 ;
    sh:path nltl:supportsIceStrengthenedFrames .

