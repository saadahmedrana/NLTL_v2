@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "The actual section modulus and actual shear area must each be at least their corresponding required value." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The actual section modulus and actual shear area must each be at least their corresponding required value." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:actualSectionModulus ?actualSectionModulusNode .
                ?actualSectionModulusNode qudt:numericValue ?actualSectionModulus .

                $this nltl:requiredSectionModulus ?requiredSectionModulusNode .
                ?requiredSectionModulusNode qudt:numericValue ?requiredSectionModulus .

                $this nltl:actualShearArea ?actualShearAreaNode .
                ?actualShearAreaNode qudt:numericValue ?actualShearArea .

                $this nltl:requiredShearArea ?requiredShearAreaNode .
                ?requiredShearAreaNode qudt:numericValue ?requiredShearArea .

                FILTER (
                    ?actualSectionModulus < ?requiredSectionModulus ||
                    ?actualShearArea < ?requiredShearArea
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF055_NarrowDeckStripShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ] .

