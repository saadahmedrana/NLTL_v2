@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "Less than 1 values on ex:webFrame->nltl:loadLengthParameter" ;
            sh:resultPath nltl:loadLengthParameter ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:loadLengthParameter ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "webFrameIceLoad must equal 1.8 times the applicable ice line load and webFrameSpacing, reported in kN; the calculation uses a 1e-6 relative tolerance with a 1e-9 absolute fallback." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "webFrameIceLoad must equal 1.8 times the applicable ice line load and webFrameSpacing, reported in kN; the calculation uses a 1e-6 relative tolerance with a 1e-9 absolute fallback." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureValue ;
                      nltl:iceLoadHeight ?heightValue ;
                      nltl:webFrameSpacing ?spacingValue ;
                      nltl:webFrameIceLoad ?loadValue .
                ?pressureValue qudt:numericValue ?pressure .
                ?heightValue qudt:numericValue ?height .
                ?spacingValue qudt:numericValue ?spacing .
                ?loadValue qudt:numericValue ?load .
                BIND((?pressure * ?height) AS ?lineLoad)
                BIND(
                    IF(?lineLoad < 0.15, 0.15, ?lineLoad)
                    AS ?applicableLineLoad
                )
                BIND(
                    (1000 * 1.8 * ?applicableLineLoad * ?spacing)
                    AS ?expectedLoad
                )
                FILTER(
                    ABS(?load - ?expectedLoad) >
                    ((0.000001 * ABS(?expectedLoad)) + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_057_WebFrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ] .

