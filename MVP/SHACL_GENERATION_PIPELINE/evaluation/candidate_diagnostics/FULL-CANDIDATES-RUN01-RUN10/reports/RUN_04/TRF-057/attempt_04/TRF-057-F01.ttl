@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "webFrameIceLoad must equal 1000 times 1.8 times the capped pressure-height product times webFrameSpacing within numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "webFrameIceLoad must equal 1000 times 1.8 times the capped pressure-height product times webFrameSpacing within numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:iceLoadHeight ?heightNode ;
                      nltl:webFrameSpacing ?spacingNode ;
                      nltl:webFrameIceLoad ?loadNode .
                ?pressureNode qudt:numericValue ?pressure .
                ?heightNode qudt:numericValue ?height .
                ?spacingNode qudt:numericValue ?spacing .
                ?loadNode qudt:numericValue ?load .
                BIND (?pressure * ?height AS ?pressureHeight)
                BIND (
                    1000 * 1.8 *
                    IF(?pressureHeight < 0.15, 0.15, ?pressureHeight) *
                    ?spacing
                    AS ?expected
                )
                FILTER (
                    ABS(?load - ?expected) >
                    ((ABS(?expected) * 0.000001) + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF057WebFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "Less than 1 values on ex:webFrame->nltl:loadLengthParameter" ;
            sh:resultPath nltl:loadLengthParameter ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:loadLengthParameter ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "The ice load source must be an ice stringer or longitudinal framing." ;
            sh:resultPath nltl:iceLoadSourceType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ice load source must be an ice stringer or longitudinal framing." ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:hasValue nltl:iceStringerLoadSource ] [ sh:hasValue nltl:longitudinalFramingLoadSource ] ) ;
                    sh:path nltl:iceLoadSourceType ] ] .

