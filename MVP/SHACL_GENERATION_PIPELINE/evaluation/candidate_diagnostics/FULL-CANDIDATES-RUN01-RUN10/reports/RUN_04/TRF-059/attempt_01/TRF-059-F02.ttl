@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ;
            sh:resultMessage "Required shear area must equal sqrt(3) times alpha times 1.1 times maximum shear force in MN divided by yield strength, multiplied by 10^4, within numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Required shear area must equal sqrt(3) times alpha times 1.1 times maximum shear force in MN divided by yield strength, multiplied by 10^4, within numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?forceQuantity ;
                      nltl:webFrameShearFactorAlpha ?alphaQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:requiredShearArea ?areaQuantity .

                ?forceQuantity qudt:numericValue ?forceKn .
                ?alphaQuantity qudt:numericValue ?alpha .
                ?yieldQuantity qudt:numericValue ?yield .
                ?areaQuantity qudt:numericValue ?area .

                BIND (1.7320508075688772 * ?alpha * 1.1 * (?forceKn / 1000) / ?yield * 10000 AS ?expected)
                FILTER (ABS(?area - ?expected) > (0.000001 * ABS(?expected) + 0.000000001))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF059WebFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ] .

