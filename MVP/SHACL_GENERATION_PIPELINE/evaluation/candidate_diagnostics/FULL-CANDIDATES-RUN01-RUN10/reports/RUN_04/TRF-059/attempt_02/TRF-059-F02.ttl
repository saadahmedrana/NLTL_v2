@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ;
            sh:resultMessage "requiredShearArea must equal sqrt(3) times the selected alpha, 1.1, and maximum calculated shear force in MN, divided by yield strength, with a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "requiredShearArea must equal sqrt(3) times the selected alpha, 1.1, and maximum calculated shear force in MN, divided by yield strength, with a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?forceNode ;
                      nltl:webFrameShearFactorAlpha ?alphaNode ;
                      nltl:yieldStrength ?yieldNode ;
                      nltl:requiredShearArea ?areaNode .
                ?forceNode qudt:numericValue ?forceKN .
                ?alphaNode qudt:numericValue ?alpha .
                ?yieldNode qudt:numericValue ?yieldMPa .
                ?areaNode qudt:numericValue ?area .
                BIND (1.7320508075688772935 * ?alpha * 1.1 * (?forceKN / 1000.0) / ?yieldMPa * 10000.0 AS ?expected)
                BIND ((?expected * 0.000001) + 0.000000001 AS ?tolerance)
                FILTER (
                    ?area < (?expected - ?tolerance) ||
                    ?area > (?expected + ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF059WebFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ;
            sh:resultMessage "freeFlangeToWebAreaRatio and webFrameShearFactorAlpha must be one permitted Table 4-8 pair." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "freeFlangeToWebAreaRatio and webFrameShearFactorAlpha must be one permitted Table 4-8 pair." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:freeFlangeToWebAreaRatio ?ratioNode ;
                      nltl:webFrameShearFactorAlpha ?alphaNode .
                ?ratioNode qudt:numericValue ?ratio .
                ?alphaNode qudt:numericValue ?alpha .
                FILTER (
                    (?ratio = 0 && ?alpha = 1.5) ||
                    (?ratio = 0.2 && ?alpha = 1.23) ||
                    (?ratio = 0.4 && ?alpha = 1.16) ||
                    (?ratio = 0.6 && ?alpha = 1.11) ||
                    (?ratio = 0.8 && ?alpha = 1.09) ||
                    (?ratio = 1.0 && ?alpha = 1.07) ||
                    (?ratio = 1.2 && ?alpha = 1.06) ||
                    (?ratio = 1.4 && ?alpha = 1.05) ||
                    (?ratio = 1.6 && ?alpha = 1.05) ||
                    (?ratio = 1.8 && ?alpha = 1.04) ||
                    (?ratio = 2.0 && ?alpha = 1.04)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF059WebFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ] .

