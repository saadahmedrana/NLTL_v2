@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ;
            sh:resultMessage "The free-flange to web area ratio and alpha must form one permitted Table 4-8 pair.",
                "requiredShearArea must equal sqrt(3) times alpha, 1.1, maximum calculated shear force in MN, and 10^4, divided by yield strength, within an expected-result-scaled tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "requiredShearArea must equal sqrt(3) times alpha, 1.1, maximum calculated shear force in MN, and 10^4, divided by yield strength, within an expected-result-scaled tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?qNode ;
                      nltl:webFrameShearFactorAlpha ?alphaNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:requiredShearArea ?areaNode .

                ?qNode qudt:numericValue ?q .
                ?alphaNode qudt:numericValue ?alpha .
                ?sigmaNode qudt:numericValue ?sigma .
                ?areaNode qudt:numericValue ?area .

                BIND ((1.7320508075688772 * ?alpha * 1.1 * (?q / 1000) / ?sigma) * 10000 AS ?expected)
                BIND (IF(?expected > 0.000001, ?expected * 0.000001, 0.000001) AS ?tolerance)

                FILTER (
                    ?area < (?expected - ?tolerance)
                    || ?area > (?expected + ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-059-WebFrameShearAreaShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ] .

