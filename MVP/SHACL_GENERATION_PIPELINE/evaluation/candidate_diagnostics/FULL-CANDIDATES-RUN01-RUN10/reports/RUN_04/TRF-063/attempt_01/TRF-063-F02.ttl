@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F02/strengtheningAftExtentValue> ;
                            sh:resultMessage "Value is not >= Literal(\"1.5\", datatype=xsd:decimal)" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 1.5 ;
                                    sh:path qudt:numericValue ] ;
                            sh:value 1.49 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F02/envelope> ;
                    sh:resultMessage "The strengthening aft extent must be at least 1.5 m." ;
                    sh:resultPath nltl:strengtheningAftExtent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The strengthening aft extent must be at least 1.5 m." ;
                            sh:minCount 1 ;
                            sh:node gen:TRF063AftExtentQuantityShape ;
                            sh:path nltl:strengtheningAftExtent ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F02/strengtheningAftExtentValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF063EnvelopeShape. See details for more information." ;
            sh:resultPath nltl:hasSidePropellerStrengtheningEnvelope ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:sidePropellerStrengtheningEnvelope ;
                    sh:minCount 1 ;
                    sh:node gen:TRF063EnvelopeShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasSidePropellerStrengtheningEnvelope ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F02/envelope> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:propellerCount" ;
            sh:resultPath nltl:propellerCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:maxInclusive 2 ;
                                sh:minInclusive 2 ;
                                sh:path nltl:propellerCount ] [ sh:maxInclusive 3 ;
                                sh:minInclusive 3 ;
                                sh:path nltl:propellerCount ] ) ;
                    sh:path nltl:propellerCount ] ] .

