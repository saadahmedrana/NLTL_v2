@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasSidePropellerStrengtheningEnvelope" ;
            sh:resultPath nltl:hasSidePropellerStrengtheningEnvelope ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:sidePropellerStrengtheningEnvelope ;
                    sh:minCount 1 ;
                    sh:node gen:TRF063EnvelopeShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasSidePropellerStrengtheningEnvelope ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:propellerCount" ;
            sh:resultPath nltl:propellerCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:maxInclusive 2 ;
                                sh:minInclusive 2 ;
                                sh:path nltl:propellerCount ] [ sh:maxInclusive 3 ;
                                sh:minInclusive 3 ;
                                sh:path nltl:propellerCount ] ) ;
                    sh:path nltl:propellerCount ] ] .

