@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F06/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:propellerCount" ;
            sh:resultPath nltl:propellerCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:maxInclusive 2 ;
                                sh:minInclusive 2 ;
                                sh:path nltl:propellerCount ] [ sh:maxInclusive 3 ;
                                sh:minInclusive 3 ;
                                sh:path nltl:propellerCount ] ) ;
                    sh:path nltl:propellerCount ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F06/strengtheningForwardExtentValue> ;
                            sh:resultMessage "Node ex:strengtheningForwardExtentValue->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/M>']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F06/envelope> ;
                    sh:resultMessage "The strengthening forward extent must be at least 1.5 m." ;
                    sh:resultPath nltl:strengtheningForwardExtent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The strengthening forward extent must be at least 1.5 m." ;
                            sh:minCount 1 ;
                            sh:node gen:TRF063ForwardExtentQuantityShape ;
                            sh:path nltl:strengtheningForwardExtent ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F06/strengtheningForwardExtentValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF063EnvelopeShape. See details for more information." ;
            sh:resultPath nltl:hasSidePropellerStrengtheningEnvelope ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:sidePropellerStrengtheningEnvelope ;
                    sh:minCount 1 ;
                    sh:node gen:TRF063EnvelopeShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasSidePropellerStrengtheningEnvelope ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F06/envelope> ] .

