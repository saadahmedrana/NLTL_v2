@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:sidePropellerShaftingAssembly ; sh:message Literal(\"The ship shall identify its side propeller shafting and its plated-bossing enclosure.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:shipComponent ; sh:property [ sh:class nltl:platedBossingStructure ; sh:message Literal(\"Side propeller shafting shall be enclosed within plated bossing.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:enclosedByPlatedBossing ] ] ; sh:path nltl:hasSidePropellerShafting ], [ sh:class nltl:sternTube ; sh:message Literal(\"The ship shall identify its stern tube and its plated-bossing enclosure.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:shipComponent ; sh:property [ sh:class nltl:platedBossingStructure ; sh:message Literal(\"The stern tube shall be enclosed within plated bossing.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:enclosedByPlatedBossing ] ] ; sh:path nltl:hasSternTube ] ] , [ sh:property [ sh:class nltl:detachedStrutStructure ; sh:message Literal(\"When detached struts are used, design, strength, and hull-attachment evidence shall be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:strutDesignEvidence ; sh:message Literal(\"Evidence for detached-strut design shall be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutDesignEvidence ], [ sh:class nltl:strutHullAttachmentEvidence ; sh:message Literal(\"Evidence for detached-strut hull attachment shall be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutHullAttachmentEvidence ], [ sh:class nltl:strutStrengthEvidence ; sh:message Literal(\"Evidence for detached-strut strength shall be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutStrengthEvidence ] ] ; sh:path nltl:hasDetachedStrut ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF064Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/ship> ] .

