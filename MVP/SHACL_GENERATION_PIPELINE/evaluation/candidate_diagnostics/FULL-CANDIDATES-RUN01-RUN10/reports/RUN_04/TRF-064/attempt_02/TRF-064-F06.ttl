@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F06/detachedStrut> ;
                    sh:resultMessage "Detached-strut design evidence is required." ;
                    sh:resultPath nltl:hasStrutDesignEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:strutDesignEvidence ;
                            sh:message "Detached-strut design evidence is required." ;
                            sh:minCount 1 ;
                            sh:path nltl:hasStrutDesignEvidence ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F06/detachedStrut> ;
                    sh:resultMessage "Detached-strut strength evidence is required." ;
                    sh:resultPath nltl:hasStrutStrengthEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:strutStrengthEvidence ;
                            sh:message "Detached-strut strength evidence is required." ;
                            sh:minCount 1 ;
                            sh:path nltl:hasStrutStrengthEvidence ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F06/detachedStrut> ;
                    sh:resultMessage "Detached-strut hull-attachment evidence is required." ;
                    sh:resultPath nltl:hasStrutHullAttachmentEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:strutHullAttachmentEvidence ;
                            sh:message "Detached-strut hull-attachment evidence is required." ;
                            sh:minCount 1 ;
                            sh:path nltl:hasStrutHullAttachmentEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F06/ship> ;
            sh:resultMessage "Each detached strut must have design, strength, and hull-attachment evidence." ;
            sh:resultPath nltl:hasDetachedStrut ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each detached strut must have design, strength, and hull-attachment evidence." ;
                    sh:node gen:TRF064DetachedStrutShape ;
                    sh:path nltl:hasDetachedStrut ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F06/detachedStrut> ] .

