@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F04/ship> ;
            sh:resultMessage "For ice class IA or IA Super, practicability must be stated and the rudder protection arrangement must be an ice knife extending below the LIWL when practicable, or an equivalent rudder protection means when not practicable." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ice class IA or IA Super, practicability must be stated and the rudder protection arrangement must be an ice knife extending below the LIWL when practicable, or an equivalent rudder protection means when not practicable." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass .
    FILTER (
        ?iceClass = nltl:iceClassIa ||
        ?iceClass = nltl:iceClassIaSuper
    )
    FILTER NOT EXISTS {
        $this nltl:iceKnifePracticable ?practicable .
        FILTER (?practicable = true || ?practicable = false)
        $this nltl:hasRudderProtectionArrangement ?arrangement .
        FILTER (
            (
                ?practicable = true &&
                EXISTS {
                    ?arrangement rdf:type nltl:iceKnife ;
                        nltl:extendsBelowLowerIceWaterline true .
                }
            ) ||
            (
                ?practicable = false &&
                EXISTS {
                    ?arrangement rdf:type nltl:equivalentRudderProtectionMeans .
                }
            )
        )
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-066> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F04/ship> ] .

