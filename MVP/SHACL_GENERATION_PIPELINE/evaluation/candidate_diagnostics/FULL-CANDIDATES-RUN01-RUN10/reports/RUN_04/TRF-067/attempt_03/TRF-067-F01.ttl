@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-067-F01/ship> ;
            sh:resultMessage "Ships with ice class IA or IA Super shall have a rudder protection arrangement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ships with ice class IA or IA Super shall have a rudder protection arrangement." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (?iceClass IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                FILTER NOT EXISTS {
                    $this nltl:hasRudderProtectionArrangement ?arrangement .
                    ?arrangement a nltl:rudderProtectionArrangement .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF067Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-067-F01/ship> ] .

