@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-P02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:TRF069ApplicableControllableShape , gen:TRF069ApplicableFixedShape , gen:TRF069NonApplicableShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF069Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-P02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-P02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasDesignCondition" ;
            sh:resultPath nltl:hasDesignCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasDesignCondition ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-P02/ship> ;
            sh:resultMessage "Value nltl:iceClassIi not in list ['nltl:iceClassIa', 'nltl:iceClassIaSuper', 'nltl:iceClassIb', 'nltl:iceClassIc']" ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc ) ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:iceClass ] ;
            sh:value nltl:iceClassIi ] .

