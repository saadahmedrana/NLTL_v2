@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-F03/ship> ;
            sh:resultMessage "For ice class IB or IC, the propulsion system shall be designed for ice class IA when the ballast-condition propeller top depth is less than the required submersion depth hi." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ice class IB or IC, the propulsion system shall be designed for ice class IA when the ballast-condition propeller top depth is less than the required submersion depth hi." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )

                ?this nltl:ballastConditionPropellerTopDepth ?depthQuantity .
                ?depthQuantity qudt:numericValue ?depth .

                ?this nltl:requiredPropellerSubmersionDepthHi ?requiredQuantity .
                ?requiredQuantity qudt:numericValue ?requiredDepth .

                FILTER (
                    xsd:decimal(?depth) < xsd:decimal(?requiredDepth)
                )

                FILTER NOT EXISTS {
                    ?this nltl:propulsionSystemDesignedForIceClass
                        nltl:iceClassIa
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF074Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-F03/ship> ] .

