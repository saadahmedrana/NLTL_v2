            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc8f4eb2161344433940f556c6a95c538b4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/table6> ;
            sh:resultMessage "The Table 6-7 lookup case must have one propeller-location selection key." ;
            sh:resultPath nltl:tableLookupPropellerLocation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc8f4eb2161344433940f556c6a95c538b11 ] .

