            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc8f4eb2161344433940f556c6a95c538b12 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/table6> ;
            sh:resultMessage "The Table 6-7 lookup case must provide one selected propeller-location factor." ;
            sh:resultPath nltl:selectedPropellerLocationFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc8f4eb2161344433940f556c6a95c538b13 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ;
            sh:resultMessage "iceLoadCycleCount must equal k1 times k2 times k3 times N_class times n_n, within a relative tolerance of 1e-6 and an absolute tolerance of 1e-9 near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "iceLoadCycleCount must equal k1 times k2 times k3 times N_class times n_n, within a relative tolerance of 1e-6 and an absolute tolerance of 1e-9 near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:ship ;
                    nltl:hasTableLookupCase ?case6 ;
                    nltl:hasTableLookupCase ?case7 ;
                    nltl:iceLoadCycleCoefficientK2 ?k2Node ;
                    nltl:iceLoadCycleCoefficientK3 ?k3Node ;
                    nltl:propellerBladeLoadSpectrumCountFactor ?nnNode ;
                    nltl:iceLoadCycleCount ?nice .

                ?case6 nltl:tableReference nltl:traficomTable6Dash6 ;
                    nltl:iceClass ?iceClass ;
                    nltl:selectedIceClassCycleCount ?nclassNode .

                ?case7 nltl:tableReference nltl:traficomTable6Dash7 ;
                    nltl:tableLookupPropellerLocation ?location ;
                    nltl:selectedPropellerLocationFactor ?k1Node .

                ?k1Node qudt:numericValue ?k1 .
                ?k2Node qudt:numericValue ?k2 .
                ?k3Node qudt:numericValue ?k3 .
                ?nclassNode qudt:numericValue ?nclass .
                ?nnNode qudt:numericValue ?nn .

                BIND((?k1 * ?k2 * ?k3 * ?nclass * ?nn) AS ?expected)
                FILTER (
                    ABS(?nice - ?expected) >
                    IF(
                        ABS(?expected) * 0.000001 > 0.000000001,
                        ABS(?expected) * 0.000001,
                        0.000000001
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:TRF078ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/table6> ;
