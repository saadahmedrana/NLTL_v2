@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ;
            sh:resultMessage "iceLoadCycleCount must equal k1*k2*k3*N_class*n_n within the permitted numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "iceLoadCycleCount must equal k1*k2*k3*N_class*n_n within the permitted numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCoefficientK2/qudt:numericValue ?k2 ;
                      nltl:iceLoadCycleCoefficientK3/qudt:numericValue ?k3 ;
                      nltl:propellerBladeLoadSpectrumCountFactor/qudt:numericValue ?nn ;
                      nltl:iceLoadCycleCount ?reported ;
                      nltl:hasTableLookupCase ?table6Case ;
                      nltl:hasTableLookupCase ?table7Case .

                ?table6Case a nltl:tableLookupCase ;
                            nltl:tableReference nltl:traficomTable6Dash6 ;
                            nltl:selectedIceClassCycleCount/qudt:numericValue ?nclass .

                ?table7Case a nltl:tableLookupCase ;
                            nltl:tableReference nltl:traficomTable6Dash7 ;
                            nltl:selectedPropellerLocationFactor/qudt:numericValue ?k1 .

                BIND((xsd:decimal(?k1) * xsd:decimal(?k2) *
                      xsd:decimal(?k3) * xsd:decimal(?nclass) *
                      xsd:decimal(?nn)) AS ?expected)
                BIND((ABS(?expected) * 0.000001 + 0.000000001) AS ?tolerance)

                FILTER(ABS(xsd:decimal(?reported) - ?expected) > ?tolerance)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF078ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ;
            sh:resultMessage "The ship must have both the Table 6-6 and Table 6-7 lookup cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ship must have both the Table 6-6 and Table 6-7 lookup cases." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?table6Case ;
                      nltl:hasTableLookupCase ?table7Case .
                ?table6Case a nltl:tableLookupCase ;
                            nltl:tableReference nltl:traficomTable6Dash6 .
                ?table7Case a nltl:tableLookupCase ;
                            nltl:tableReference nltl:traficomTable6Dash7 .
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF078ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ] .

