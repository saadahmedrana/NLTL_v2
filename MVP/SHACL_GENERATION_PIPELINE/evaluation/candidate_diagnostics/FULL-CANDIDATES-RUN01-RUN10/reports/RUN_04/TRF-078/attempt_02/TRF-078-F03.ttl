@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:iceLoadCycleCoefficientK2" ;
            sh:resultPath nltl:iceLoadCycleCoefficientK2 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:iceLoadCycleCoefficientK2 ;
                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ],
                        [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:numericValue ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F03/ship> ;
            sh:resultMessage "The ship must have both the Table 6-6 and Table 6-7 lookup cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ship must have both the Table 6-6 and Table 6-7 lookup cases." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?table6Case ;
                      nltl:hasTableLookupCase ?table7Case .
                ?table6Case a nltl:tableLookupCase ;
                            nltl:tableReference nltl:traficomTable6Dash6 .
                ?table7Case a nltl:tableLookupCase ;
                            nltl:tableReference nltl:traficomTable6Dash7 .
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF078ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F03/ship> ] .

