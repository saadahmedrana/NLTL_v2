@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ;
            sh:resultMessage "The immersion function and submersion factor must satisfy the specified formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The immersion function and submersion factor must satisfy the specified formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?hNode ;
                      nltl:propellerShaftCentrelineDepth ?h0Node ;
                      nltl:propellerDiameter ?dNode ;
                      nltl:propellerImmersionFunction ?fNode ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node .

                ?hNode qudt:numericValue ?h .
                ?h0Node qudt:numericValue ?h0 .
                ?dNode qudt:numericValue ?d .
                ?fNode qudt:numericValue ?f .
                ?k2Node qudt:numericValue ?k2 .

                BIND(( (?h0 - ?h) / (?d / 2) ) - 1 AS ?expectedF)
                BIND(
                    IF(?expectedF < 0,
                       0.8 - ?expectedF,
                       IF(?expectedF <= 1,
                          0.8 - (0.4 * ?expectedF),
                          IF(?expectedF <= 2.5,
                             0.6 - (0.2 * ?expectedF),
                             0.1
                          )
                       )
                    ) AS ?expectedK2
                )

                FILTER(
                    ABS(?f - ?expectedF) >
                    IF(ABS(?expectedF) * 0.000001 > 0.000000001,
                       ABS(?expectedF) * 0.000001,
                       0.000000001)
                    ||
                    ABS(?k2 - ?expectedK2) >
                    IF(ABS(?expectedK2) * 0.000001 > 0.000000001,
                       ABS(?expectedK2) * 0.000001,
                       0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_079_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ] .

