@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ;
            sh:resultMessage "The propeller immersion function and ice load cycle coefficient k2 must match their declared formula results within numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The propeller immersion function and ice load cycle coefficient k2 must match their declared formula results within numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?hNode ;
                      nltl:propellerDiameter ?dNode ;
                      nltl:propellerShaftCentrelineDepth ?h0Node ;
                      nltl:propellerImmersionFunction ?fNode ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node .

                ?hNode qudt:numericValue ?h .
                ?dNode qudt:numericValue ?d .
                ?h0Node qudt:numericValue ?h0 .
                ?fNode qudt:numericValue ?fReported .
                ?k2Node qudt:numericValue ?k2Reported .

                BIND(((?h0 - ?h) / (?d / 2)) - 1 AS ?fExpected)
                BIND(
                    IF(
                        ?fExpected < 0,
                        0.8 - ?fExpected,
                        IF(
                            ?fExpected <= 1,
                            0.8 - (0.4 * ?fExpected),
                            IF(
                                ?fExpected <= 2.5,
                                0.6 - (0.2 * ?fExpected),
                                0.1
                            )
                        )
                    ) AS ?k2Expected
                )
                BIND(IF(?fExpected >= 0, ?fExpected, -?fExpected) AS ?fScale)
                BIND(IF(?k2Expected >= 0, ?k2Expected, -?k2Expected) AS ?k2Scale)

                FILTER(
                    IF(?fReported - ?fExpected >= 0,
                       ?fReported - ?fExpected,
                       -(?fReported - ?fExpected))
                    > (0.000001 * ?fScale + 0.000000001)
                    ||
                    IF(?k2Reported - ?k2Expected >= 0,
                       ?k2Reported - ?k2Expected,
                       -(?k2Reported - ?k2Expected))
                    > (0.000001 * ?k2Scale + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-079> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ] .

