@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-P01/ship> ;
            sh:resultMessage "Ice thrust and both directional design thrust results must match the specified calculations; the common design thrust must equal the greater directional load within tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ice thrust and both directional design thrust results must match the specified calculations; the common design thrust must equal the greater directional load within tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce/qudt:numericValue ?ff ;
                      nltl:backwardBladeForce/qudt:numericValue ?fb ;
                      nltl:hydrodynamicBollardThrust/qudt:numericValue ?t ;
                      nltl:forwardIceThrust/qudt:numericValue ?tf ;
                      nltl:backwardIceThrust/qudt:numericValue ?tb ;
                      nltl:forwardPropellerShaftDesignThrust/qudt:numericValue ?trf ;
                      nltl:backwardPropellerShaftDesignThrust/qudt:numericValue ?trb ;
                      nltl:propellerShaftDesignThrust/qudt:numericValue ?tr .

                BIND (1.1 * ?ff AS ?tfExpected)
                BIND (1.1 * ?fb AS ?tbExpected)
                BIND (?t + 2.2 * ?tfExpected AS ?forwardExpected)
                BIND (1.5 * ?tbExpected AS ?backwardExpected)
                BIND (
                    IF(?forwardExpected >= ?backwardExpected,
                       ?forwardExpected,
                       ?backwardExpected)
                    AS ?designExpected
                )

                FILTER (
                    ABS(?tf - ?tfExpected) >
                    IF(ABS(?tfExpected) * 0.000001 > 0.000001,
                       ABS(?tfExpected) * 0.000001,
                       0.000001)
                    ||
                    ABS(?tb - ?tbExpected) >
                    IF(ABS(?tbExpected) * 0.000001 > 0.000001,
                       ABS(?tbExpected) * 0.000001,
                       0.000001)
                    ||
                    ABS(?trf - ?designExpected) >
                    IF(ABS(?designExpected) * 0.000001 > 0.000001,
                       ABS(?designExpected) * 0.000001,
                       0.000001)
                    ||
                    ABS(?trb - ?designExpected) >
                    IF(ABS(?designExpected) * 0.000001 > 0.000001,
                       ABS(?designExpected) * 0.000001,
                       0.000001)
                    ||
                    ABS(?tr - ?designExpected) >
                    IF(ABS(?designExpected) * 0.000001 > 0.000001,
                       ABS(?designExpected) * 0.000001,
                       0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF_081_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-P01/ship> ] .

