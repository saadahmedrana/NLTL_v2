@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-083-P02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:rotationalSpeedKnown ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:rotationalSpeedKnown ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node nltlgen:TRF083UnknownSpeedLookupCaseShape ; sh:path nltl:hasTableLookupCase ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("When the bollard propeller speed is unknown, the Table 6-9 lookup case must attribute its selected result to the ship's required bollard propeller rotational-speed quantity.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX qudtunit: <http://qudt.org/vocab/unit/>

                    SELECT $this
                    WHERE {
                        $this nltl:rotationalSpeedKnown false ;
                              nltl:hasTableLookupCase ?lookupCase ;
                              nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ?speedQuantity .
                        ?lookupCase nltl:tableLookupApplied true ;
                                    nltl:tableReference nltl:traficomTable6Dash9 .
                        ?speedQuantity qudt:numericValue ?speedValue ;
                                        qudt:unit qudtunit:REV-PER-MIN .
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:TRF083ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-083-P02/ship> ] .

