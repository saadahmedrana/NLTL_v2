@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ;
            sh:resultMessage "For a CP propeller, pitchValueKnown must be true or false; when true, propellerPitchAtMcrBollard must be supplied in metres, and when false, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within a relative tolerance of 1e-6 or an absolute tolerance of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a CP propeller, pitchValueKnown must be true or false; when true, propellerPitchAtMcrBollard must be supplied in metres, and when false, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within a relative tolerance of 1e-6 or an absolute tolerance of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType ?type .
                FILTER (?type = "CP")

                FILTER (
                    !EXISTS {
                        $this nltl:pitchValueKnown ?known .
                        FILTER (?known = true || ?known = false)
                    }
                    ||
                    (
                        EXISTS {
                            $this nltl:pitchValueKnown false .
                        }
                        &&
                        !EXISTS {
                            $this nltl:propellerPitchAtMcrBollard ?bollard .
                            ?bollard qudt:numericValue ?bollardValue ;
                                     qudt:unit unit:M .
                            $this nltl:propellerPitchAtMcrFreeRunning ?freeRunning .
                            ?freeRunning qudt:numericValue ?freeRunningValue ;
                                         qudt:unit unit:M .
                            FILTER (
                                datatype(?bollardValue) = xsd:decimal &&
                                datatype(?freeRunningValue) = xsd:decimal
                            )
                            FILTER (
                                ABS(?bollardValue - (0.7 * ?freeRunningValue))
                                    <= ABS(0.7 * ?freeRunningValue) * 0.000001
                                ||
                                ABS(?bollardValue - (0.7 * ?freeRunningValue))
                                    <= 0.000000001
                            )
                        }
                    )
                    ||
                    (
                        EXISTS {
                            $this nltl:pitchValueKnown true .
                        }
                        &&
                        !EXISTS {
                            $this nltl:propellerPitchAtMcrBollard ?bollard .
                            ?bollard qudt:numericValue ?bollardValue ;
                                     qudt:unit unit:M .
                            FILTER (datatype(?bollardValue) = xsd:decimal)
                        }
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-084> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ] .

