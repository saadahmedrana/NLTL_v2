@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ;
            sh:resultMessage "For a CP propeller with unknown pitch, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within the specified tolerance; both quantities must be singular metre quantities." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a CP propeller with unknown pitch, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within the specified tolerance; both quantities must be singular metre quantities." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerType "CP"^^xsd:string ;
                      nltl:pitchValueKnown false .

                FILTER (
                    NOT EXISTS {
                        $this nltl:propellerPitchAtMcrBollard ?b .
                        ?b qudt:numericValue ?bv ;
                           qudt:unit unit:M .
                        $this nltl:propellerPitchAtMcrFreeRunning ?f .
                        ?f qudt:numericValue ?fv ;
                           qudt:unit unit:M .
                        FILTER (
                            ABS(?bv - (0.7 * ?fv)) <=
                            (1e-6 * ABS(0.7 * ?fv))
                            ||
                            ABS(?bv - (0.7 * ?fv)) <= 1e-9
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:propellerPitchAtMcrBollard ?q1, ?q2 .
                        FILTER (?q1 != ?q2)
                    }
                    ||
                    EXISTS {
                        $this nltl:propellerPitchAtMcrBollard ?q .
                        ?q qudt:numericValue ?v1, ?v2 .
                        FILTER (?v1 != ?v2)
                    }
                    ||
                    EXISTS {
                        $this nltl:propellerPitchAtMcrBollard ?q .
                        ?q qudt:unit ?u1, ?u2 .
                        FILTER (?u1 != ?u2)
                    }
                    ||
                    EXISTS {
                        $this nltl:propellerPitchAtMcrFreeRunning ?q1, ?q2 .
                        FILTER (?q1 != ?q2)
                    }
                    ||
                    EXISTS {
                        $this nltl:propellerPitchAtMcrFreeRunning ?q .
                        ?q qudt:numericValue ?v1, ?v2 .
                        FILTER (?v1 != ?v2)
                    }
                    ||
                    EXISTS {
                        $this nltl:propellerPitchAtMcrFreeRunning ?q .
                        ?q qudt:unit ?u1, ?u2 .
                        FILTER (?u1 != ?u2)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-084> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ] .

