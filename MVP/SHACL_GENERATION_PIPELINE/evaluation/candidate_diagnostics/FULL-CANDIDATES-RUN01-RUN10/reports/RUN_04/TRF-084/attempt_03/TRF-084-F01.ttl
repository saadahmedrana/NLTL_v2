@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ;
            sh:resultMessage "For a CP propeller with unknown pitch value, the bollard pitch must equal 0.7 times the free-running pitch." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a CP propeller with unknown pitch value, the bollard pitch must equal 0.7 times the free-running pitch." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType "CP"^^xsd:string ;
                      nltl:pitchValueKnown false ;
                      nltl:propellerPitchAtMcrBollard ?bollardQuantity ;
                      nltl:propellerPitchAtMcrFreeRunning ?freeRunningQuantity .

                ?bollardQuantity qudt:numericValue ?bollardValue ;
                                  qudt:unit unit:M .
                ?freeRunningQuantity qudt:numericValue ?freeRunningValue ;
                                      qudt:unit unit:M .

                BIND (0.7 * ?freeRunningValue AS ?expectedValue)
                FILTER (
                    ABS(?bollardValue - ?expectedValue)
                    > ABS(?expectedValue) * 0.000001
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-084> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ] .

