@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:bollardPropellerSpeedKnown ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The known bollard propeller speed at MCR is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:RotationalSpeedQuantityShape ; sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ] ] , [ sh:property [ sh:class nltl:tableLookupCase ; sh:message Literal("A Table 6-9 lookup case is required when the bollard propeller speed is not known.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TableLookupCaseShape ; sh:path nltl:hasTableLookupCase ], [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:bollardPropellerSpeedKnown ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The bollard propeller speed selected from Table 6-9 is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:RotationalSpeedQuantityShape ; sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ] ; sh:sparql [ sh:message Literal("The selected bollard propeller speed must equal the table lookup result and the lookup input must equal the propeller diameter.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:propellerDiameter ?diameter ;
                              nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ?speed ;
                              nltl:hasTableLookupCase ?case .
                        ?diameter qudt:numericValue ?diameterValue .
                        ?speed qudt:numericValue ?speedValue .
                        ?case nltl:lookupInputQuantity ?input ;
                              nltl:lookupResultQuantity ?result .
                        ?input qudt:numericValue ?inputValue .
                        ?result qudt:numericValue ?resultValue .
                        FILTER (?diameterValue != ?inputValue ||
                                ?speedValue != ?resultValue)
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:PropellerBollardSpeedShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-F01/ship> ;
            sh:resultMessage "The known-status of the bollard propeller speed is required." ;
            sh:resultPath nltl:bollardPropellerSpeedKnown ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The known-status of the bollard propeller speed is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:bollardPropellerSpeedKnown ] ] .

