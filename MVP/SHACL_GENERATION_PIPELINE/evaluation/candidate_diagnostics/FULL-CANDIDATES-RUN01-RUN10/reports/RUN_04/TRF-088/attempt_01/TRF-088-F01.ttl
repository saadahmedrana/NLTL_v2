@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to exactly one shape in <urn:nltl:generated-shape:TRF-088-KnownBranchShape> , <urn:nltl:generated-shape:TRF-088-UnknownBranchShape>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:XoneConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-088-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F01/ship> ] .

