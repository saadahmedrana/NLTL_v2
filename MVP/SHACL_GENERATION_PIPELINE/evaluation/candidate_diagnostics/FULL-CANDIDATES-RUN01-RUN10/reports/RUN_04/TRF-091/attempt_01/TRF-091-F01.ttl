@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ;
                    sh:resultMessage "The ice milling load sequence shall not be identified for propulsion system stalling analysis." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NotConstraintComponent ;
                    sh:sourceShape [ sh:message "The ice milling load sequence shall not be identified for propulsion system stalling analysis." ;
                            sh:not [ sh:hasValue nltl:stallingAnalysisPurposeValue ] ;
                            sh:path nltl:loadCasePurpose ] ;
                    sh:value nltl:stallingAnalysisPurposeValue ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ;
                    sh:resultMessage "The propulsion load case shall be identified for propulsion line strength evaluation." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCasePurposeValue ;
                            sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                            sh:message "The propulsion load case shall be identified for propulsion line strength evaluation." ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:loadCasePurpose ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/milling> ;
            sh:resultMessage "The ship shall identify a propulsion load case with the required purpose." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:na6ce72b8619f4c65a4240e8431bb3897b2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/ship> ;
            sh:resultMessage "The ship shall identify a propulsion load case with the required purpose." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:na6ce72b8619f4c65a4240e8431bb3897b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/milling> ;
            sh:resultMessage "The ship shall identify a propeller ice milling load sequence case." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceMillingSequenceCase ;
                    sh:message "The ship shall identify a propeller ice milling load sequence case." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceMillingSequenceCase ] ] .

_:N0507f69e5d174d5fae9883e3ef3aaa9e a sh:NodeShape ;
    sh:property [ sh:message "The ice milling load sequence shall not be identified for propulsion system stalling analysis." ;
            sh:not [ sh:hasValue nltl:stallingAnalysisPurposeValue ] ;
            sh:path nltl:loadCasePurpose ],
        [ sh:class nltl:loadCasePurposeValue ;
            sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
            sh:message "The propulsion load case shall be identified for propulsion line strength evaluation." ;
            sh:nodeKind sh:IRI ;
            sh:path nltl:loadCasePurpose ] .

_:na6ce72b8619f4c65a4240e8431bb3897b2 sh:class nltl:loadCase ;
    sh:message "The ship shall identify a propulsion load case with the required purpose." ;
    sh:minCount 1 ;
    sh:node _:N0507f69e5d174d5fae9883e3ef3aaa9e ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasPropulsionLoadCase .

