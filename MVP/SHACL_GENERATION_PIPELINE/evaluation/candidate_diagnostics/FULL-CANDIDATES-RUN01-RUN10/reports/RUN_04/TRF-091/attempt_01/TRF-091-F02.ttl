@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ;
                    sh:resultMessage "The propulsion load case shall be identified for propulsion line strength evaluation." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCasePurposeValue ;
                            sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                            sh:message "The propulsion load case shall be identified for propulsion line strength evaluation." ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:loadCasePurpose ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/milling> ;
            sh:resultMessage "The ship shall identify a propulsion load case with the required purpose." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:na6ce72b8619f4c65a4240e8431bb3897b2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/milling> ;
            sh:resultMessage "The ship shall identify a propeller ice milling load sequence case." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceMillingSequenceCase ;
                    sh:message "The ship shall identify a propeller ice milling load sequence case." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceMillingSequenceCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/ship> ;
            sh:resultMessage "The ship shall identify a propulsion load case with the required purpose." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:na6ce72b8619f4c65a4240e8431bb3897b2 ] .

_:N3dc4da55b2fd49aaaf2d4fa88821674a sh:class nltl:loadCasePurposeValue ;
    sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
    sh:message "The propulsion load case shall be identified for propulsion line strength evaluation." ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:loadCasePurpose .

_:N78cc48e42a454942a9cb15db44039018 sh:hasValue nltl:stallingAnalysisPurposeValue .

_:N7f1976f726d341c3903461dd031f848f sh:message "The ice milling load sequence shall not be identified for propulsion system stalling analysis." ;
    sh:not _:N78cc48e42a454942a9cb15db44039018 ;
    sh:path nltl:loadCasePurpose .

_:Nb68599f169534bd19d228b6dbe94e298 a sh:NodeShape ;
    sh:property _:N3dc4da55b2fd49aaaf2d4fa88821674a,
