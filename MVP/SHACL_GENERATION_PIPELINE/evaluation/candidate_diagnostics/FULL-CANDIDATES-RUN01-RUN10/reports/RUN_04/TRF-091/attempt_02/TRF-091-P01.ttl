@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/milling> ;
            sh:resultMessage "Every propulsion load case represented for this requirement must be the ice-milling sequence case." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Every propulsion load case represented for this requirement must be the ice-milling sequence case." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:hasPropulsionLoadCase ?propulsionCase .
                FILTER NOT EXISTS {
                    $this nltl:hasIceMillingSequenceCase ?propulsionCase .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_091_LoadCasePathShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/milling> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/milling> ;
            sh:resultMessage "Less than 1 values on ex:milling->nltl:hasIceMillingSequenceCase" ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd71309d344ca4503b7ca8638ca590082b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/ship> ;
            sh:resultMessage "The ice-milling sequence case must be the same load case used for propulsion-line strength evaluation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ice-milling sequence case must be the same load case used for propulsion-line strength evaluation." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:hasIceMillingSequenceCase ?iceCase .
                FILTER NOT EXISTS {
                    $this nltl:hasPropulsionLoadCase ?iceCase .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_091_LoadCasePathShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/milling> ;
                    sh:resultMessage "Node ex:milling->nltl:loadCasePurpose does not contain a value in the set: ['nltl:propulsionLineStrengthEvaluationPurpose']" ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nd71309d344ca4503b7ca8638ca590082b3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/milling> ;
                    sh:resultMessage "Less than 1 values on ex:milling->nltl:loadCasePurpose" ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nd71309d344ca4503b7ca8638ca590082b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:iceMillingSequenceCase, nltl:loadCase ; sh:not [ sh:property [ sh:hasValue nltl:stallingAnalysisPurposeValue ; sh:path nltl:loadCasePurpose ] ] ; sh:property [ sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadCasePurpose ] ]. See details for more information." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nd71309d344ca4503b7ca8638ca590082b1 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/milling> ],
        [ a sh:ValidationResult ;
