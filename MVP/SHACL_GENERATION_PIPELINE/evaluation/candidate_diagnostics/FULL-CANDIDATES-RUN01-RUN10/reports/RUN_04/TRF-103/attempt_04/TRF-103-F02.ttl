@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-103-F02/bladeFailureSpindleTorqueFactorValue> ;
                    sh:resultMessage "Value is not >= Literal(\"0.3\")" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:minInclusive "0.3" ;
                            sh:path qudt:numericValue ] ;
                    sh:value 0.3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-103-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:hasValue unit:UNITLESS ; sh:path qudt:unit ], [ sh:minInclusive Literal(\"0.3\") ; sh:path qudt:numericValue ] ]. See details for more information." ;
            sh:resultPath nltl:bladeFailureSpindleTorqueFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:UNITLESS ;
                                    sh:path qudt:unit ],
                                [ sh:minInclusive "0.3" ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:bladeFailureSpindleTorqueFactor ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-103-F02/bladeFailureSpindleTorqueFactorValue> ] .

