@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F02/ship> ;
            sh:resultMessage "Evidence shall show that the selected SN-curve type corresponds to the blade material properties." ;
            sh:resultPath nltl:stressLifeCurveSelectionCorrespondenceEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                    sh:message "Evidence shall show that the selected SN-curve type corresponds to the blade material properties." ;
                    sh:minCount 1 ;
                    sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F02/ship> ;
            sh:resultMessage "The ship shall record the propeller blade material properties used for SN-curve selection." ;
            sh:resultPath nltl:propellerBladeMaterialProperty ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship shall record the propeller blade material properties used for SN-curve selection." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerBladeMaterialProperty ] ] .

