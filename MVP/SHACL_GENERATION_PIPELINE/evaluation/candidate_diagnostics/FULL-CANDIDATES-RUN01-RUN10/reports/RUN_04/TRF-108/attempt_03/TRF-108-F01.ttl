@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F01/ship> ;
            sh:resultMessage "Each ship must record the propeller blade material property." ;
            sh:resultPath nltl:propellerBladeMaterialProperty ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "Each ship must record the propeller blade material property." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerBladeMaterialProperty ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:evidenceArtifact ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ], [ sh:class nltl:stressLifeCurveTypeValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelection ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:stressLifeCurveKnown ] ] , [ sh:property [ sh:class nltl:stressLifeCurveTypeValue ; sh:hasValue nltl:twoSlopeStressLifeCurve ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelection ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:stressLifeCurveKnown ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ a sh:NodeShape ;
                    sh:or ( [ sh:property [ sh:hasValue true ;
                                        sh:path nltl:stressLifeCurveKnown ],
                                    [ sh:class nltl:stressLifeCurveTypeValue ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:path nltl:stressLifeCurveSelection ],
                                    [ sh:class nltl:evidenceArtifact ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ] ] [ sh:property [ sh:hasValue false ;
                                        sh:path nltl:stressLifeCurveKnown ],
                                    [ sh:class nltl:stressLifeCurveTypeValue ;
                                        sh:hasValue nltl:twoSlopeStressLifeCurve ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:path nltl:stressLifeCurveSelection ] ] ) ;
                    sh:property [ sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:message "Each ship must record the propeller blade material property." ;
                            sh:minCount 1 ;
                            sh:path nltl:propellerBladeMaterialProperty ],
                        [ sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:message "Each ship must record the SN-curve type." ;
                            sh:minCount 1 ;
                            sh:path nltl:stressLifeCurveType ],
                        [ sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:message "Each ship must state whether the SN-curve is known." ;
                            sh:minCount 1 ;
                            sh:path nltl:stressLifeCurveKnown ] ;
                    sh:targetClass nltl:ship ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F01/ship> ] .

