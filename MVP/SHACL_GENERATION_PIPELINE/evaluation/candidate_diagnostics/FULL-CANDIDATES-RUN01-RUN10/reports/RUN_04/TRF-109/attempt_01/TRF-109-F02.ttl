@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F02/lookup> ;
                    sh:resultMessage "Node ex:lookup must conform to one or more shapes in gen:TRF109OpenCaseShape , gen:TRF109DuctedCaseShape" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:tableLookupCase ;
                            sh:or ( gen:TRF109OpenCaseShape gen:TRF109DuctedCaseShape ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F02/lookup> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F02/ship> ;
            sh:resultMessage "Each table lookup case must reference TRAFICOM Table 6-14 and match the open or ducted coefficient row." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each table lookup case must reference TRAFICOM Table 6-14 and match the open or ducted coefficient row." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:tableLookupCase ;
                            sh:or ( gen:TRF109OpenCaseShape gen:TRF109DuctedCaseShape ) ] ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F02/lookup> ] .

