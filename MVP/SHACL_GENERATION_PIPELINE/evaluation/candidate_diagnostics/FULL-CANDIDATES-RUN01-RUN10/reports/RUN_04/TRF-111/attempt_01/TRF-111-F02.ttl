@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qv: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/loadCase> ;
                    sh:resultMessage "The component yield safety factor must be at least 1.3 for extreme operational loads and at least 1.0 for blade failure loads." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "The component yield safety factor must be at least 1.3 for extreme operational loads and at least 1.0 for blade failure loads." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:shaftLineLoadCaseType ?caseType .
                FILTER (
                    (
                        ?caseType = nltl:extremeOperationalLoadCase &&
                        NOT EXISTS {
                            ?this nltl:componentYieldSafetyFactor ?sf .
                            ?sf qudt:numericValue ?value .
                            FILTER (datatype(?value) = xsd:decimal && ?value >= 1.3)
                        }
                    )
                    ||
                    (
                        ?caseType = nltl:bladeFailureLoadCase &&
                        NOT EXISTS {
                            ?this nltl:componentYieldSafetyFactor ?sf .
                            ?sf qudt:numericValue ?value .
                            FILTER (datatype(?value) = xsd:decimal && ?value >= 1.0)
                        }
                    )
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape qv:LoadCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/loadCase> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/loadCase> ;
                    sh:resultMessage "Each propulsion load case must provide its externally calculated component yield safety factor." ;
                    sh:resultPath nltl:componentYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each propulsion load case must provide its externally calculated component yield safety factor." ;
                            sh:minCount 1 ;
                            sh:node qv:UnitlessQuantityShape ;
                            sh:path nltl:componentYieldSafetyFactor ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/ship> ;
            sh:resultMessage "The ship must provide the applicable propulsion load cases and their externally calculated safety factors." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the applicable propulsion load cases and their externally calculated safety factors." ;
                    sh:minCount 1 ;
                    sh:node qv:LoadCaseShape ;
                    sh:path nltl:hasPropulsionLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/loadCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/ship> ;
            sh:resultMessage "The ship must identify the ship components for which fatigue safety factors are assessed." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must identify the ship components for which fatigue safety factors are assessed." ;
                    sh:minCount 1 ;
                    sh:node qv:ShipComponentShape ;
                    sh:path nltl:hasComponent ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/ship> ;
            sh:resultMessage "The ship must provide the extreme ice force input in kN." ;
            sh:resultPath nltl:extremeIceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the extreme ice force input in kN." ;
                    sh:minCount 1 ;
                    sh:node qv:KiloNewtonQuantityShape ;
                    sh:path nltl:extremeIceForce ] ] .

