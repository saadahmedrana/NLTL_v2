@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/component> ;
            sh:resultMessage "Each propulsion load case shall identify an allowed load-case type and meet the applicable direct safety-factor check." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF111LoadCaseShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/component> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/ship> ;
            sh:resultMessage "The ship shall provide one extreme ice force in kN." ;
            sh:resultPath nltl:extremeIceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide one extreme ice force in kN." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class q:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path q:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path q:numericValue ] ] ;
                    sh:path nltl:extremeIceForce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/ship> ;
            sh:resultMessage "The ship shall identify the applicable ship-component owners." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify the applicable ship-component owners." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:shipComponent ] ;
                    sh:path nltl:hasComponent ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/loadCase> ;
            sh:resultMessage "Each propulsion load case shall identify an allowed load-case type and meet the applicable direct safety-factor check." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF111LoadCaseShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/loadCase> ] .

