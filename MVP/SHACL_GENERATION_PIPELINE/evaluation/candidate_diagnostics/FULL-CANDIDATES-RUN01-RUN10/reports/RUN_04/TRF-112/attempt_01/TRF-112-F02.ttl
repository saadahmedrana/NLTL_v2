@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F02/loadCase> ;
                    sh:resultMessage "Value is not Literal with datatype xsd:decimal" ;
                    sh:resultPath nltl:bladeFailureUltimateLoad ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:bladeFailureUltimateLoad ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F02/bladeFailureUltimateLoadValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F02/ship> ;
            sh:resultMessage "A blade-failure propulsion load case with the required externally calculated load inputs is required." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A blade-failure propulsion load case with the required externally calculated load inputs is required." ;
                    sh:minCount 1 ;
                    sh:node gs:TRF112LoadCaseShape ;
                    sh:path nltl:hasPropulsionLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F02/loadCase> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F02/component> ;
                    sh:resultMessage "The externally calculated bending yield safety factor must be at least 1.0." ;
                    sh:resultPath nltl:bendingYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The externally calculated bending yield safety factor must be at least 1.0." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:minInclusive 1.0 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:bendingYieldSafetyFactor ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F02/ship> ;
            sh:resultMessage "A propeller shaft-line component with bending and torsional yield safety factors is required." ;
            sh:resultPath nltl:hasPropellerShaftLineComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A propeller shaft-line component with bending and torsional yield safety factors is required." ;
                    sh:minCount 1 ;
                    sh:node gs:TRF112ComponentShape ;
                    sh:path nltl:hasPropellerShaftLineComponent ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F02/component> ] .

