@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/ship> ;
            sh:resultMessage "For an applicable total blade failure load case, bending and torsional yield safety factors of the linked shaft-line components must be at least 1.0." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an applicable total blade failure load case, bending and torsional yield safety factors of the linked shaft-line components must be at least 1.0." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:ship .
                $this nltl:hasPropulsionLoadCase ?loadCase .
                ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
                $this nltl:hasPropellerShaftLineComponent ?component .
                FILTER (
                    NOT EXISTS {
                        ?component nltl:bendingYieldSafetyFactor ?bending .
                        ?bending qudt:numericValue ?bendingValue .
                        ?bending qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (
                            datatype(?bendingValue) = xsd:decimal &&
                            ?bendingValue >= 1
                        )
                    }
                    ||
                    NOT EXISTS {
                        ?component nltl:torsionalYieldSafetyFactor ?torsional .
                        ?torsional qudt:numericValue ?torsionalValue .
                        ?torsional qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (
                            datatype(?torsionalValue) = xsd:decimal &&
                            ?torsionalValue >= 1
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-112-ComplexReadiness> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/ship> ] .

