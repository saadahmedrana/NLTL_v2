@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F01/ship> ;
            sh:resultMessage "Each applicable blade-failure load case must contain externally calculated ultimate and combined-load inputs, and each linked shaft-line component must report bending and torsional yield safety factors of at least 1.0 with the declared units." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each applicable blade-failure load case must contain externally calculated ultimate and combined-load inputs, and each linked shaft-line component must report bending and torsional yield safety factors of at least 1.0 with the declared units." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasPropulsionLoadCase ?loadCase .
                ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .

                FILTER (
                    NOT EXISTS {
                        ?loadCase nltl:bladeFailureUltimateLoad ?ultimateLoad .
                        ?ultimateLoad qudt:numericValue ?ultimateValue ;
                                      qudt:unit qudt:KiloN .
                        FILTER (datatype(?ultimateValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?loadCase nltl:combinedAxialBendingTorsionLoad ?combinedLoad .
                        ?combinedLoad qudt:numericValue ?combinedValue ;
                                     qudt:unit qudt:KiloN .
                        FILTER (datatype(?combinedValue) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasPropellerShaftLineComponent ?component .
                        FILTER NOT EXISTS {
                            ?component nltl:bendingYieldSafetyFactor ?bendingFactor .
                            ?bendingFactor qudt:numericValue ?bendingValue ;
                                            qudt:unit qudt:UNITLESS .
                            FILTER (
                                datatype(?bendingValue) = xsd:decimal &&
                                ?bendingValue >= 1.0
                            )
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:hasPropellerShaftLineComponent ?component .
                        FILTER NOT EXISTS {
                            ?component nltl:torsionalYieldSafetyFactor ?torsionalFactor .
                            ?torsionalFactor qudt:numericValue ?torsionalValue ;
                                              qudt:unit qudt:UNITLESS .
                            FILTER (
                                datatype(?torsionalValue) = xsd:decimal &&
                                ?torsionalValue >= 1.0
                            )
                        }
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-112> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F01/ship> ] .

