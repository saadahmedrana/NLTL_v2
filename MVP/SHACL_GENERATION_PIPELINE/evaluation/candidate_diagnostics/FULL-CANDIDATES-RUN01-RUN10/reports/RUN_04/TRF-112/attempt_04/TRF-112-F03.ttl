@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/ship> ;
            sh:resultMessage "For an applicable total-blade-failure load case, every linked propeller shaft line component must have bending and torsional yield safety factors of at least 1.0 with dimensionless units." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an applicable total-blade-failure load case, every linked propeller shaft line component must have bending and torsional yield safety factors of at least 1.0 with dimensionless units." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasPropulsionLoadCase ?loadCase .
                ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
                $this nltl:hasPropellerShaftLineComponent ?component .
                FILTER NOT EXISTS {
                    ?component nltl:bendingYieldSafetyFactor ?bending .
                    ?bending qudt:numericValue ?bendingValue .
                    ?bending qudt:unit unit:UNITLESS .
                    FILTER (
                        datatype(?bendingValue) = xsd:decimal &&
                        ?bendingValue >= 1
                    )
                }
                FILTER NOT EXISTS {
                    ?component nltl:torsionalYieldSafetyFactor ?torsional .
                    ?torsional qudt:numericValue ?torsionalValue .
                    ?torsional qudt:unit unit:UNITLESS .
                    FILTER (
                        datatype(?torsionalValue) = xsd:decimal &&
                        ?torsionalValue >= 1
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF112Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/ship> ] .

