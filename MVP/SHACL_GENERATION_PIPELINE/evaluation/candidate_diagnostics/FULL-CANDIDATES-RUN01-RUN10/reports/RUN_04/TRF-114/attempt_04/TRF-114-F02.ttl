@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudtunit: <http://qudt.org/vocab/unit/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:iceOperatingSpeed" ;
            sh:resultPath nltl:iceOperatingSpeed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudtunit:KN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:iceOperatingSpeed ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/ship> ;
            sh:resultMessage "Non-hemispherical contact geometry requires an equivalent impact sphere radius." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Non-hemispherical contact geometry requires an equivalent impact sphere radius." ;
                    sh:select """PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:hasThrusterIceImpactLoadCase ?case .
    ?case nltl:contactGeometryClassification nltl:nonHemisphericalContactGeometry .
    FILTER NOT EXISTS {
        $this nltl:equivalentImpactSphereRadius ?radius .
    }
}""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-114-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/thrusterBody> ;
                            sh:resultMessage "Less than 1 values on ex:thrusterBody->nltl:thrusterResistanceCapacity" ;
                            sh:resultPath nltl:thrusterResistanceCapacity ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue qudtunit:KiloN ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:thrusterResistanceCapacity ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/impact> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:thrusterBody ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudtunit:KiloN ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterResistanceCapacity ] ]. See details for more information." ;
                    sh:resultPath nltl:thrusterImpactCaseAppliesToBody ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:thrusterBody ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:hasValue qudtunit:KiloN ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ],
                                                        [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:thrusterResistanceCapacity ] ] ;
                            sh:path nltl:thrusterImpactCaseAppliesToBody ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/thrusterBody> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/impact> ;
                    sh:resultMessage "Less than 1 values on ex:impact->nltl:thrusterIceImpactLoadCaseIdentifier" ;
                    sh:resultPath nltl:thrusterIceImpactLoadCaseIdentifier ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:thrusterIceImpactLoadCaseIdentifier ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:class nltl:thrusterIceImpactLoadCase ; sh:property [ sh:class nltl:evidenceArtifact ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:thrusterIceImpactLoadedAreaEvidence ], [ sh:class nltl:evidenceArtifact ; sh:path nltl:contactGeometryCorrespondenceEvidence ], [ sh:datatype xsd:string ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:thrusterIceImpactLoadCaseIdentifier ], [ sh:hasValue nltl:traficomTable6Dash16Reference ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:impactLoadCaseTableReference ], [ sh:hasValue nltl:traficomTable6Dash3Reference ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:designIceBlockTableReference ], [ sh:in ( nltl:hemisphericalContactGeometry nltl:nonHemisphericalContactGeometry ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:contactGeometryClassification ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:thrusterBody ; sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudtunit:KiloN ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterResistanceCapacity ] ] ; sh:path nltl:thrusterImpactCaseAppliesToBody ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudtunit:KiloN ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterIceImpactDemand ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudtunit:KiloN ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterIceImpactLoad ] ; sh:sparql [ sh:message Literal("Non-hemispherical contact geometry requires correspondence evidence.") ; sh:select Literal("PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:contactGeometryClassification nltl:nonHemisphericalContactGeometry .
    FILTER NOT EXISTS {
        $this nltl:contactGeometryCorrespondenceEvidence ?evidence .
    }
}") ], [ sh:message Literal("Thruster resistance capacity must be at least the impact demand.") ; sh:select Literal("PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX qudtunit: <http://qudt.org/vocab/unit/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:thrusterIceImpactDemand ?demandQuantity .
    ?demandQuantity qudt:numericValue ?demandValue ;
                    qudt:unit qudtunit:KiloN .
    $this nltl:thrusterImpactCaseAppliesToBody ?body .
    ?body nltl:thrusterResistanceCapacity ?capacityQuantity .
    ?capacityQuantity qudt:numericValue ?capacityValue ;
                      qudt:unit qudtunit:KiloN .
    FILTER (?capacityValue < ?demandValue)
}") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasThrusterIceImpactLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:thrusterIceImpactLoadCase ;
                            sh:property [ sh:in ( nltl:hemisphericalContactGeometry nltl:nonHemisphericalContactGeometry ) ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:contactGeometryClassification ],
                                [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:thrusterIceImpactLoadCaseIdentifier ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue qudtunit:KiloN ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thrusterIceImpactLoad ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:thrusterBody ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:thrusterResistanceCapacity ] ] ;
                                    sh:path nltl:thrusterImpactCaseAppliesToBody ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue qudtunit:KiloN ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thrusterIceImpactDemand ],
                                [ sh:hasValue nltl:traficomTable6Dash16Reference ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:impactLoadCaseTableReference ],
                                [ sh:hasValue nltl:traficomTable6Dash3Reference ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:designIceBlockTableReference ],
                                [ sh:class nltl:evidenceArtifact ;
                                    sh:path nltl:contactGeometryCorrespondenceEvidence ],
                                [ sh:class nltl:evidenceArtifact ;
                                    sh:minCount 1 ;
                                    sh:path nltl:thrusterIceImpactLoadedAreaEvidence ] ;
                            sh:sparql [ sh:message "Non-hemispherical contact geometry requires correspondence evidence." ;
                                    sh:select """PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:contactGeometryClassification nltl:nonHemisphericalContactGeometry .
    FILTER NOT EXISTS {
        $this nltl:contactGeometryCorrespondenceEvidence ?evidence .
    }
}""" ],
                                [ sh:message "Thruster resistance capacity must be at least the impact demand." ;
                                    sh:select """PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX qudtunit: <http://qudt.org/vocab/unit/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:thrusterIceImpactDemand ?demandQuantity .
    ?demandQuantity qudt:numericValue ?demandValue ;
                    qudt:unit qudtunit:KiloN .
    $this nltl:thrusterImpactCaseAppliesToBody ?body .
    ?body nltl:thrusterResistanceCapacity ?capacityQuantity .
    ?capacityQuantity qudt:numericValue ?capacityValue ;
                      qudt:unit qudtunit:KiloN .
    FILTER (?capacityValue < ?demandValue)
}""" ] ] ;
                    sh:path nltl:hasThrusterIceImpactLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/impact> ] .

