@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:integer ; sh:message Literal(\"When the propulsion engine must be reversed for astern movement, the air receiver capacity must provide at least 12 consecutive starts.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"12\", datatype=xsd:integer) ; sh:path nltl:airReceiverConsecutiveStartCapacity ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:propulsionEngineReversedForAstern ] ] , [ sh:property [ sh:datatype xsd:integer ; sh:message Literal(\"When the propulsion engine does not have to be reversed for astern movement, the air receiver capacity must provide at least 6 consecutive starts.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"6\", datatype=xsd:integer) ; sh:path nltl:airReceiverConsecutiveStartCapacity ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:propulsionEngineReversedForAstern ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-126> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-F03/ship> ;
            sh:resultMessage "The propulsion engine astern-reversal applicability state must be provided." ;
            sh:resultPath nltl:propulsionEngineReversedForAstern ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The propulsion engine astern-reversal applicability state must be provided." ;
                    sh:minCount 1 ;
                    sh:path nltl:propulsionEngineReversedForAstern ] ] .

