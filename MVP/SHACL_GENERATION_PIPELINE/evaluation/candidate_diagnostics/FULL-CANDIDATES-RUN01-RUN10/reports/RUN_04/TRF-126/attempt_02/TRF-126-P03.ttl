@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-P03/ship> ;
            sh:resultMessage "The propulsion-engine astern-reversal state and corresponding air receiver capacity must satisfy the applicable consecutive-start threshold." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-126> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-P03/ship> ] .

