@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F04/ship> ;
            sh:resultMessage "If the air receivers serve an additional purpose, both capacities must be provided and the existing air receiver capacity must be sufficient for that purpose." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_127_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F04/ship> ] .

