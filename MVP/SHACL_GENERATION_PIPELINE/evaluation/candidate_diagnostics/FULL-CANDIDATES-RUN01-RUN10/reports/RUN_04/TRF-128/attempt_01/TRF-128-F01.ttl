@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F01/ship> ;
            sh:resultMessage "The compressor charge time shall be at most 0.5 hours for an IA Super ship requiring propulsion-engine reversal for astern; otherwise it shall be at most 1 hour." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF128Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F01/ship> ] .

