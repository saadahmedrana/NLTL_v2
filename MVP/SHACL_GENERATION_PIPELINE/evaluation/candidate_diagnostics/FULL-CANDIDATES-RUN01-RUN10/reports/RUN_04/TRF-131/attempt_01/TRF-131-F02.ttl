@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-131-F02/ship> ;
            sh:resultMessage "A ballast-water cooling arrangement must not be recorded as a substitute for an inlet chest." ;
            sh:resultPath nltl:substituteArrangementStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc0bf75f6378f40f89040537bf61299c7b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-131-F02/ship> ;
            sh:resultMessage "A ballast-water cooling arrangement must not be recorded as a substitute for an inlet chest." ;
            sh:resultPath nltl:substituteArrangementStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nc0bf75f6378f40f89040537bf61299c7b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-131-F02/ship> ;
            sh:resultMessage "The ship must have an inlet chest; a ballast-water cooling arrangement cannot substitute for it." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must have an inlet chest; a ballast-water cooling arrangement cannot substitute for it." ;
                    sh:path nltl:hasComponent ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:inletChest ] ] ] .

_:nc0bf75f6378f40f89040537bf61299c7b1 sh:datatype xsd:boolean ;
    sh:hasValue false ;
    sh:maxCount 1 ;
    sh:message "A ballast-water cooling arrangement must not be recorded as a substitute for an inlet chest." ;
    sh:minCount 1 ;
    sh:path nltl:substituteArrangementStatus .

