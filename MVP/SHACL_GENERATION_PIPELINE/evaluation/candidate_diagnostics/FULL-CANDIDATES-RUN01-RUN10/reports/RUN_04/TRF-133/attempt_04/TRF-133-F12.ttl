@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F12/ship> ;
            sh:resultMessage "The ship must have one permitted Finnish-Swedish ice class." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship must have one permitted Finnish-Swedish ice class." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:iceClass ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F12/iceMark> ;
                    sh:resultMessage "The ice-class draught-mark letters must have the same dimensions as the load-line mark." ;
                    sh:resultPath nltl:letterDimensionsEqualLoadLineMark ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "The ice-class draught-mark letters must have the same dimensions as the load-line mark." ;
                            sh:minCount 1 ;
                            sh:path nltl:letterDimensionsEqualLoadLineMark ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F12/ship> ;
            sh:resultMessage "The ship must have one conforming ice-class draught marking." ;
            sh:resultPath nltl:hasIceClassDraughtMarking ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceClassDraughtMarking ;
                    sh:maxCount 1 ;
                    sh:message "The ship must have one conforming ice-class draught marking." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF133IceClassDraughtMarkingShape ;
                    sh:path nltl:hasIceClassDraughtMarking ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F12/iceMark> ] .

