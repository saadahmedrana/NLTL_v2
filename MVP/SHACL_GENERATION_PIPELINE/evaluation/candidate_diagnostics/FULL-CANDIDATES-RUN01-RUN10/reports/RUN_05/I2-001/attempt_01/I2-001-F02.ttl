@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-001-F02/ship> ;
            sh:resultMessage "When a construction contract date is supplied, UR I2 Rev.4 applicability must be true on or after 2021-01-01 and false before that date." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When a construction contract date is supplied, UR I2 Rev.4 applicability must be true on or after 2021-01-01 and false before that date." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    DATATYPE(?date) = xsd:date
                    &&
                    (
                        (
                            (
                                YEAR(?date) > 2021
                                ||
                                (YEAR(?date) = 2021 && MONTH(?date) > 1)
                                ||
                                (YEAR(?date) = 2021 && MONTH(?date) = 1 && DAY(?date) >= 1)
                            )
                            &&
                            (
                                NOT EXISTS {
                                    $this nltl:urI2RevisionApplicability ?applicable .
                                    FILTER (?applicable = true)
                                }
                            )
                        )
                        ||
                        (
                            (
                                YEAR(?date) < 2021
                                ||
                                (YEAR(?date) = 2021 && MONTH(?date) < 1)
                                ||
                                (YEAR(?date) = 2021 && MONTH(?date) = 1 && DAY(?date) < 1)
                            )
                            &&
                            (
                                NOT EXISTS {
                                    $this nltl:urI2RevisionApplicability ?applicable .
                                    FILTER (?applicable = false)
                                }
                            )
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_001_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-001-F02/ship> ] .

