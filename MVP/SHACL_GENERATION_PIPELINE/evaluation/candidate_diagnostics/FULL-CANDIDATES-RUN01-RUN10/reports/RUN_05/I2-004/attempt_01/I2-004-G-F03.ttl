@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/selectedDui> ;
                    sh:resultMessage "Node ex:selectedDui->qudt:unit does not contain a value in the set: ['unit:KiloTON_Metric']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue unit:KiloTON_Metric ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloTON_Metric ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:upperIceWaterlineDisplacement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:KiloTON_Metric ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:upperIceWaterlineDisplacement ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/selectedDui> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/ship> ;
            sh:resultMessage "The ship displacement must equal the greatest displacement among its upper ice waterline cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The ship displacement must equal the greatest displacement among its upper ice waterline cases." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?duiQuantity .
                ?duiQuantity qudt:numericValue ?duiValue .

                $this nltl:hasUpperIceWaterlineCase ?matchingCase .
                ?matchingCase nltl:waterlineCaseDisplacement ?matchingQuantity .
                ?matchingQuantity qudt:numericValue ?matchingValue .

                FILTER (
                    ABS(?duiValue - ?matchingValue)
                    <= IF(
                        ABS(?matchingValue) * 0.000001 > 0.000000001,
                        ABS(?matchingValue) * 0.000001,
                        0.000000001
                    )
                )

                FILTER NOT EXISTS {
                    $this nltl:hasUpperIceWaterlineCase ?greaterCase .
                    ?greaterCase nltl:waterlineCaseDisplacement ?greaterQuantity .
                    ?greaterQuantity qudt:numericValue ?greaterValue .
                    FILTER (
                        ?greaterValue - ?duiValue
                        > IF(
                            ABS(?greaterValue) * 0.000001 > 0.000000001,
                            ABS(?greaterValue) * 0.000001,
                            0.000000001
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_004_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/ship> ] .

