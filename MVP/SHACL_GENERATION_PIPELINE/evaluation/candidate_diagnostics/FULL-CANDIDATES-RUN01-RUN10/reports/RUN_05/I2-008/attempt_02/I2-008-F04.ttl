@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchHeight" ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:QuantityLengthShape ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:localIcePressure" ;
            sh:resultPath nltl:localIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:QuantityPressureShape ;
                    sh:path nltl:localIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/ship> ;
            sh:resultMessage "The actual bow shape is required for the ice-load calculation." ;
            sh:resultPath nltl:bowShape ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The actual bow shape is required for the ice-load calculation." ;
                    sh:minCount 1 ;
                    sh:path nltl:bowShape ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/bowCase> ;
                    sh:resultMessage "Less than 1 values on ex:bowCase->nltl:glancingImpactPressure" ;
                    sh:resultPath nltl:glancingImpactPressure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node gen:QuantityPressureShape ;
                            sh:path nltl:glancingImpactPressure ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:bowSubregionCalculationCase ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:QuantityForceShape ; sh:path nltl:totalGlancingImpactForce ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:QuantityLineLoadShape ; sh:path nltl:glancingImpactLineLoad ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:QuantityPressureShape ; sh:path nltl:glancingImpactPressure ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:QuantityUnitlessShape ; sh:path nltl:bowShapeCoefficient ] ]. See details for more information." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:bowSubregionCalculationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node gen:QuantityUnitlessShape ;
                                    sh:path nltl:bowShapeCoefficient ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node gen:QuantityPressureShape ;
                                    sh:path nltl:glancingImpactPressure ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node gen:QuantityLineLoadShape ;
                                    sh:path nltl:glancingImpactLineLoad ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node gen:QuantityForceShape ;
                                    sh:path nltl:totalGlancingImpactForce ] ] ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/bowCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:lineLoad" ;
            sh:resultPath nltl:lineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:QuantityLineLoadShape ;
                    sh:path nltl:lineLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:averageIcePressure" ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:QuantityPressureShape ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:shapeCoefficient" ;
            sh:resultPath nltl:shapeCoefficient ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:QuantityUnitlessShape ;
                    sh:path nltl:shapeCoefficient ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchLength" ;
            sh:resultPath nltl:loadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:QuantityLengthShape ;
                    sh:path nltl:loadPatchLength ] ] .

