@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F02/ship> ;
            sh:resultMessage "The ship must have one hull area assignment following the declared assignment path." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must have one hull area assignment following the declared assignment path." ;
                    sh:minCount 1 ;
                    sh:node gen:HullAreaAssignmentShape ;
                    sh:path nltl:hasHullAreaAssignment ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hullArea" ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:ApplicableBowFormShape , gen:NonApplicableBowFormShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_009_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F02/ship> ] .

