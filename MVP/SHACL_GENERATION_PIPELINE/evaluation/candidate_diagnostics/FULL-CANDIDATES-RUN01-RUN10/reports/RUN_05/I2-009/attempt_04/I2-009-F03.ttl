@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/assignment> ;
                    sh:resultMessage "The assigned hull area shall be one of the two declared other-ice-strengthened-area alternatives." ;
                    sh:resultPath nltl:assignedHullArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:otherIceStrengthenedArea nltl:otherIceStrengthenedAreaValue ) ;
                            sh:maxCount 1 ;
                            sh:message "The assigned hull area shall be one of the two declared other-ice-strengthened-area alternatives." ;
                            sh:minCount 1 ;
                            sh:path nltl:assignedHullArea ] ;
                    sh:value nltl:bowRegion ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ;
            sh:resultMessage "The ship shall provide a hull-area assignment with an allowed controlled area alternative." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide a hull-area assignment with an allowed controlled area alternative." ;
                    sh:minCount 1 ;
                    sh:node gs:I2_009_HullAreaAssignmentShape ;
                    sh:path nltl:hasHullAreaAssignment ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/assignment> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ;
            sh:resultMessage "The hull area representation shall be supplied." ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The hull area representation shall be supplied." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:node gs:I2_009_ApplicableBowFormShape ] , [ sh:node gs:I2_009_NonApplicableBowFormShape ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:I2_009_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ] .

