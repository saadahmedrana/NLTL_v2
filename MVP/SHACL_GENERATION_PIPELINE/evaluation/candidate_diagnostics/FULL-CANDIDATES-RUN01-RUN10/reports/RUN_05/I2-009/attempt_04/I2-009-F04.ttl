@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/ship> ;
            sh:resultMessage "Average ice pressure shall be supplied as a pressure quantity in MPa." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Average ice pressure shall be supplied as a pressure quantity in MPa." ;
                    sh:minCount 1 ;
                    sh:node gs:I2_009_AverageIcePressureShape ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/ship> ;
            sh:resultMessage "The non-bow load-patch height shall be supplied as a length in metres." ;
            sh:resultPath nltl:nonBowLoadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The non-bow load-patch height shall be supplied as a length in metres." ;
                    sh:minCount 1 ;
                    sh:node gs:I2_009_LengthShape ;
                    sh:path nltl:nonBowLoadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/ship> ;
            sh:resultMessage "The hull area representation shall be supplied." ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The hull area representation shall be supplied." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/ship> ;
            sh:resultMessage "The ship shall provide a hull-area assignment with an allowed controlled area alternative." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide a hull-area assignment with an allowed controlled area alternative." ;
                    sh:minCount 1 ;
                    sh:node gs:I2_009_HullAreaAssignmentShape ;
                    sh:path nltl:hasHullAreaAssignment ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/ship> ;
            sh:resultMessage "The non-bow load-patch length shall be supplied as a length in metres." ;
            sh:resultPath nltl:nonBowLoadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The non-bow load-patch length shall be supplied as a length in metres." ;
                    sh:minCount 1 ;
                    sh:node gs:I2_009_LengthShape ;
                    sh:path nltl:nonBowLoadPatchLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/ship> ;
            sh:resultMessage "The fixed load-patch aspect ratio shall be exactly 3.6 and dimensionless." ;
            sh:resultPath nltl:loadPatchAspectRatio ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The fixed load-patch aspect ratio shall be exactly 3.6 and dimensionless." ;
                    sh:minCount 1 ;
                    sh:node gs:I2_009_LoadPatchAspectRatioShape ;
                    sh:path nltl:loadPatchAspectRatio ] ] .

