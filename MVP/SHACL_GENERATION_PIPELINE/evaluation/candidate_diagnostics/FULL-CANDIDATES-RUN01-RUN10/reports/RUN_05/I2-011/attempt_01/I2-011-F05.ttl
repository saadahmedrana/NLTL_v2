@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F05/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:message Literal("Bulbous-bow status is required and must be true for the applicable case.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bulbousBowPresent ], [ sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ; sh:message Literal("A Polar Class of PC6 or PC7 is required to establish applicability.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:polarClass ], [ sh:message Literal("The applicable load-patch aspect ratio must be 1.3 and dimensionless.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:loadPatchAspectRatio ; sh:property [ sh:datatype xsd:decimal ; sh:maxInclusive Literal("1.3", datatype=xsd:decimal) ; sh:minInclusive Literal("1.3", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ], [ sh:message Literal("The applicable shape coefficient must be 0.6 and dimensionless.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shapeCoefficient ; sh:property [ sh:datatype xsd:decimal ; sh:maxInclusive Literal("0.6", datatype=xsd:decimal) ; sh:minInclusive Literal("0.6", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ], [ sh:message Literal("The bow design force must be supplied in kN.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bowDesignForce ; sh:property [ sh:datatype xsd:decimal ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ], [ sh:message Literal("The force from I2.3.2.1(iii) must be supplied in MN.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ; sh:property [ sh:datatype xsd:decimal ; sh:path qudt:numericValue ], [ sh:hasValue unit:MegaN ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ], [ sh:message Literal("The force from I2.3.2.1(iv) must be supplied in MN.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ; sh:property [ sh:datatype xsd:decimal ; sh:path qudt:numericValue ], [ sh:hasValue unit:MegaN ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:sparql [ sh:message Literal("For an applicable PC6 or PC7 bulbous-bow ship, the bow design force must equal the I2.3.2.1(iv) force within a relative tolerance of 1e-6 with a 1e-6 kN absolute fallback and must not be less than the I2.3.2.1(iii) force.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iii ;
                              nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?iv ;
                              nltl:bowDesignForce ?result .
                        ?iii qudt:numericValue ?iiiValue ;
                             qudt:unit <http://qudt.org/vocab/unit/MegaN> .
                        ?iv qudt:numericValue ?ivValue ;
                            qudt:unit <http://qudt.org/vocab/unit/MegaN> .
                        ?result qudt:numericValue ?resultValue ;
                               qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        FILTER (
                            ?resultValue < (1000 * ?iiiValue)
                            ||
                            ABS(?resultValue - (1000 * ?ivValue))
                                > ((0.000001 * ABS(1000 * ?ivValue)) + 0.000001)
                        )
                    }
                ") ] ] , [ sh:property [ sh:in ( nltl:polarClassPc1 nltl:polarClassPc2 nltl:polarClassPc3 nltl:polarClassPc4 nltl:polarClassPc5 ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:polarClass ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bulbousBowPresent ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_011_BowDesignForceShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F05/ship> ] .

