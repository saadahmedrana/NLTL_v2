@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in <urn:nltl:generated-shape:I2-011-applicable> , <urn:nltl:generated-shape:I2-011-not-applicable>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-011> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F04/ship> ] .

