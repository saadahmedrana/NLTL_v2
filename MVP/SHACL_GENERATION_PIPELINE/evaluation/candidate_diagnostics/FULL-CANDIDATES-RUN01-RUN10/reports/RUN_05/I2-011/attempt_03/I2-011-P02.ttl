@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-P02/ship> ;
            sh:resultMessage "For an applicable PC6 or PC7 ship with a bulbous bow, bowDesignForce must equal the I2.3.2.1(iv) force within a bounded tolerance and must not be less than the I2.3.2.1(iii) force; MN operands are converted to kN." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an applicable PC6 or PC7 ship with a bulbous bow, bowDesignForce must equal the I2.3.2.1(iv) force within a bounded tolerance and must not be less than the I2.3.2.1(iii) force; MN operands are converted to kN." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:polarClass ?polarClass ;
                      nltl:bulbousBowPresent ?bulbous ;
                      nltl:bowDesignForce ?reportedNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?minimumNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?expectedNode .

                ?reportedNode qudt:numericValue ?reported .
                ?minimumNode qudt:numericValue ?minimumMn .
                ?expectedNode qudt:numericValue ?expectedMn .

                FILTER (
                    ?bulbous = true &&
                    (?polarClass = nltl:polarClassPc6 ||
                     ?polarClass = nltl:polarClassPc7)
                )

                BIND(?minimumMn * 1000 AS ?minimumKn)
                BIND(?expectedMn * 1000 AS ?expectedKn)
                BIND(
                    IF(?expectedKn >= 0.001,
                       ?expectedKn * 0.000001,
                       0.001)
                    AS ?toleranceKn
                )

                FILTER (
                    ?reported < ?minimumKn ||
                    ?reported < (?expectedKn - ?toleranceKn) ||
                    ?reported > (?expectedKn + ?toleranceKn)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_011_BowDesignForceShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-P02/ship> ] .

