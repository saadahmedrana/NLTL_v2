@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F01/fa> ;
                    sh:resultMessage "Value is not >= Literal(\"0.6\", datatype=xsd:decimal)" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:maxInclusive 0.6 ;
                            sh:minCount 1 ;
                            sh:minInclusive 0.6 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 0.5 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F01/ship> ;
            sh:resultMessage "shapeCoefficient must equal the required fa value of 0.6." ;
            sh:resultPath nltl:shapeCoefficient ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "shapeCoefficient must equal the required fa value of 0.6." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue unit:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 0.6 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 0.6 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:shapeCoefficient ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F01/fa> ] .

