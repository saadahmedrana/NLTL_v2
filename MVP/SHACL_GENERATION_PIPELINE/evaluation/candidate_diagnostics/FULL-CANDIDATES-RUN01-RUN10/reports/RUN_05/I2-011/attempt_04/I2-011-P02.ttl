@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-P02/ship> ;
            sh:resultMessage "For PC6 or PC7 ships with bulbous bows, bowDesignForce must match the I2.3.2.1(iv) force within the permitted tolerance and must not be less than the I2.3.2.1(iii) force." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For PC6 or PC7 ships with bulbous bows, bowDesignForce must match the I2.3.2.1(iv) force within the permitted tolerance and must not be less than the I2.3.2.1(iii) force." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:polarClass ?polarClass ;
                      nltl:bulbousBowPresent true ;
                      nltl:bowDesignForce ?reportedNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?minimumNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?expectedNode .

                ?reportedNode qudt:numericValue ?reported ;
                              qudt:unit unit:KiloN .
                ?minimumNode qudt:numericValue ?minimum ;
                              qudt:unit unit:MegaN .
                ?expectedNode qudt:numericValue ?expected ;
                              qudt:unit unit:MegaN .

                FILTER (
                    ?polarClass IN (nltl:polarClassPc6, nltl:polarClassPc7)
                )

                FILTER (
                    (?reported < (?minimum * 1000))
                    ||
                    (
                        (?expected >= 1.0)
                        &&
                        (
                            ?reported < ((?expected * 1000) - ((?expected * 1000) * 0.000001))
                            ||
                            ?reported > ((?expected * 1000) + ((?expected * 1000) * 0.000001))
                        )
                    )
                    ||
                    (
                        (?expected < 1.0)
                        &&
                        (
                            ?reported < ((?expected * 1000) - 0.000001)
                            ||
                            ?reported > ((?expected * 1000) + 0.000001)
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-011-BowDesignForce> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-P02/ship> ] .

