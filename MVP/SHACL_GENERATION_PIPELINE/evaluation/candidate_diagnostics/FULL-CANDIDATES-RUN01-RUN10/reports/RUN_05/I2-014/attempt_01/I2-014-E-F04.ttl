@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "The bow region must be divided into four subregions." ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:maxInclusive 4 ;
                    sh:message "The bow region must be divided into four subregions." ;
                    sh:minCount 1 ;
                    sh:minInclusive 4 ;
                    sh:path nltl:bowSubregionCount ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "The ship must provide its bow length in metres." ;
            sh:resultPath nltl:bowLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship must provide its bow length in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:bowLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "The selected maximum bow force must equal the maximum force reported for the four bow subregions." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The selected maximum bow force must equal the maximum force reported for the four bow subregions." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedNode .
                ?selectedNode qudt:numericValue ?selectedValue .
                FILTER (
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?greaterCase .
                        ?greaterCase nltl:bowSubregionCalculatedForce ?greaterNode .
                        ?greaterNode qudt:numericValue ?greaterValue .
                        FILTER (?greaterValue > ?selectedValue)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?equalCase .
                        ?equalCase nltl:bowSubregionCalculatedForce ?equalNode .
                        ?equalNode qudt:numericValue ?equalValue .
                        FILTER (?equalValue = ?selectedValue)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_014_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ] .

