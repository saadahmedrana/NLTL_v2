@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "The ship must provide bowLength as a metre-valued quantity." ;
            sh:resultPath nltl:bowLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide bowLength as a metre-valued quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:bowLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "selectedMaximumBowForce must not be less than a calculated bow subregion force." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "selectedMaximumBowForce must not be less than a calculated bow subregion force." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedQuantity .
                ?selectedQuantity qudt:numericValue ?selectedValue .
                $this nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowSubregionCalculatedForce ?caseQuantity .
                ?caseQuantity qudt:numericValue ?caseValue .
                FILTER (?caseValue > ?selectedValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:I2_014_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "The bow region must be divided into four subregions." ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:maxInclusive 4 ;
                    sh:message "The bow region must be divided into four subregions." ;
                    sh:minCount 1 ;
                    sh:minInclusive 4 ;
                    sh:path nltl:bowSubregionCount ] ] .

