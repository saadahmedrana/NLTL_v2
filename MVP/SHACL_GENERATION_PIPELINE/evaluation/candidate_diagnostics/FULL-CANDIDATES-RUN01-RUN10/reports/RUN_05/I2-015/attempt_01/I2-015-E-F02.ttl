@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F02/ship> ;
            sh:resultMessage "A ship with an applicable I2.3.1(v) bow case shall provide upper ice waterline length and beta i prime inputs." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A ship with an applicable I2.3.1(v) bow case shall provide upper ice waterline length and beta i prime inputs." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowFormApplicabilityClassification
                      nltl:i231vBowFormApplicability .
                FILTER (
                    NOT EXISTS {
                        $this nltl:upperIceWaterlineLengthLUI ?upperLength
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:betaIPrime ?beta
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape g:ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F02/ship> ] .

