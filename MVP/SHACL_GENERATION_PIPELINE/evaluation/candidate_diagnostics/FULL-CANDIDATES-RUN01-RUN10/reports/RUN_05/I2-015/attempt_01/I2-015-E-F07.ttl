@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F07/ship> ;
            sh:resultMessage "A ship with an applicable I2.3.1(v) bow case shall provide upper ice waterline length and beta i prime inputs." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A ship with an applicable I2.3.1(v) bow case shall provide upper ice waterline length and beta i prime inputs." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowFormApplicabilityClassification
                      nltl:i231vBowFormApplicability .
                FILTER (
                    NOT EXISTS {
                        $this nltl:upperIceWaterlineLengthLUI ?upperLength
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:betaIPrime ?beta
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape g:ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F07/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F07/bowCase> ;
                    sh:resultMessage "Less than 1 values on ex:bowCase->nltl:bowShapeCoefficient" ;
                    sh:resultPath nltl:bowShapeCoefficient ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node g:DimensionlessQuantityShape ;
                            sh:path nltl:bowShapeCoefficient ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F07/ship> ;
            sh:resultMessage "Value does not conform to Shape g:BowSubregionCalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:bowSubregionCalculationCase ;
                    sh:node g:BowSubregionCalculationCaseShape ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F07/bowCase> ] .

