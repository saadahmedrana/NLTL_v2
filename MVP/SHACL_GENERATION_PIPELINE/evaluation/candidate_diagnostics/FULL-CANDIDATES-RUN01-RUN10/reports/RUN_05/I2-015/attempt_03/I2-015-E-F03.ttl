@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/bowCase> ;
                    sh:resultMessage "The applicable bow calculation case must provide the waterline angle in degrees." ;
                    sh:resultPath nltl:bowSubregionWaterlineAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n7d3f46651510425996dace37b60c7048b15 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/ship> ;
            sh:resultMessage "At least one applicable bow subregion calculation case is required." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:bowSubregionCalculationCase ;
                    sh:message "At least one applicable bow subregion calculation case is required." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-015-BowCaseShape> ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/bowCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/ship> ;
            sh:resultMessage "The ship must provide one dimensionless beta_i_prime value." ;
            sh:resultPath nltl:betaIPrime ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one dimensionless beta_i_prime value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue unit:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:betaIPrime ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/bowCase> ;
            sh:resultMessage "The applicable bow calculation case must provide the waterline angle in degrees." ;
            sh:resultPath nltl:bowSubregionWaterlineAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n7d3f46651510425996dace37b60c7048b15 ] .

_:N8368cde34bf742c78e6ac9fe2827fdd8 sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:Na40f6bbac60c446990075f139637e06a sh:property _:N8368cde34bf742c78e6ac9fe2827fdd8,
        [ sh:hasValue unit:DEG ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:n7d3f46651510425996dace37b60c7048b15 sh:maxCount 1 ;
    sh:message "The applicable bow calculation case must provide the waterline angle in degrees." ;
    sh:minCount 1 ;
    sh:node _:Na40f6bbac60c446990075f139637e06a ;
    sh:path nltl:bowSubregionWaterlineAngle .

