@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/ship> ;
            sh:resultMessage "The ship must provide one dimensionless beta_i_prime value." ;
            sh:resultPath nltl:betaIPrime ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one dimensionless beta_i_prime value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue unit:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:betaIPrime ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/factorLookup> ;
                            sh:resultMessage "The failure-class-factor lookup case must provide one dimensionless crushing failure class factor." ;
                            sh:resultPath nltl:crushingFailureClassFactor ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n7d3f46651510425996dace37b60c7048b28 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/bowCase> ;
                    sh:resultMessage "The applicable bow calculation case must provide its failure-class-factor lookup case." ;
                    sh:resultPath nltl:hasFailureClassFactorLookupCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n7d3f46651510425996dace37b60c7048b23 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/factorLookup> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/ship> ;
            sh:resultMessage "At least one applicable bow subregion calculation case is required." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:bowSubregionCalculationCase ;
                    sh:message "At least one applicable bow subregion calculation case is required." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-015-BowCaseShape> ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/bowCase> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/factorLookup> ;
                    sh:resultMessage "The failure-class-factor lookup case must provide one dimensionless crushing failure class factor." ;
                    sh:resultPath nltl:crushingFailureClassFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n7d3f46651510425996dace37b60c7048b28 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/bowCase> ;
            sh:resultMessage "The applicable bow calculation case must provide its failure-class-factor lookup case." ;
            sh:resultPath nltl:hasFailureClassFactorLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n7d3f46651510425996dace37b60c7048b23 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F06/factorLookup> ] .

_:N74dcf29a881541a58d37c637e8bd0f6b sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:N8d7d10f6093345d48eb35265fb0159a7 sh:hasValue unit:UNITLESS ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

_:Ne19a770e1c7844f2b60b27a69e4ec7b3 sh:property _:N74dcf29a881541a58d37c637e8bd0f6b,
        _:N8d7d10f6093345d48eb35265fb0159a7 .

_:n7d3f46651510425996dace37b60c7048b23 sh:class nltl:tableLookupCase ;
    sh:message "The applicable bow calculation case must provide its failure-class-factor lookup case." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-015-TableLookupShape> ;
    sh:path nltl:hasFailureClassFactorLookupCase .

_:n7d3f46651510425996dace37b60c7048b28 sh:maxCount 1 ;
    sh:message "The failure-class-factor lookup case must provide one dimensionless crushing failure class factor." ;
    sh:minCount 1 ;
    sh:node _:Ne19a770e1c7844f2b60b27a69e4ec7b3 ;
    sh:path nltl:crushingFailureClassFactor .

