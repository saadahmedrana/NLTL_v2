@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F01/ship> ;
            sh:resultMessage "The selected hull area factor must equal the maximum hull area factor among all hull areas spanned by the structural member." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The selected hull area factor must equal the maximum hull area factor among all hull areas spanned by the structural member." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:selectedHullAreaFactor ?selectedNode ;
                        nltl:hasSpannedHullArea ?areaNode .
                ?selectedNode qudt:numericValue ?selected .
                ?areaNode nltl:hullAreaFactor ?factorNode .
                ?factorNode qudt:numericValue ?factor .
            }
            GROUP BY $this ?member ?selected
            HAVING (
                ABS(?selected - MAX(?factor)) >
                IF(
                    ABS(MAX(?factor)) * 0.000001 > 0.000000000001,
                    ABS(MAX(?factor)) * 0.000001,
                    0.000000000001
                )
            )
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-019> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F01/ship> ] .

