@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F01/member> ;
                    sh:resultMessage "Node ex:member must conform to one or more shapes in nltlg:I2_019_ApplicableMemberShape , nltlg:I2_019_NonApplicableMemberShape" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:or ( nltlg:I2_019_ApplicableMemberShape nltlg:I2_019_NonApplicableMemberShape ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:or ( nltlg:I2_019_ApplicableMemberShape nltlg:I2_019_NonApplicableMemberShape ) ]. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:or ( nltlg:I2_019_ApplicableMemberShape nltlg:I2_019_NonApplicableMemberShape ) ] ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F01/member> ] .

