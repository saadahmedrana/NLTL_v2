@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/member> ;
                    sh:resultMessage """Node ex:member must conform to one or more shapes in [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:selectedHullAreaFactor ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:HullAreaValueShape ; sh:path nltl:hasSpannedHullArea ] ; sh:sparql [ sh:message Literal("selectedHullAreaFactor must equal the maximum hullAreaFactor over all spanned hull areas within relative tolerance 1e-6, with an absolute fallback of 1e-12.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                            SELECT $this
                            WHERE {
                                $this nltl:hasSpannedHullArea ?area ;
                                      nltl:selectedHullAreaFactor ?selected .
                                ?area nltl:hullAreaFactor ?factor .
                                ?factor qudt:numericValue ?expected .
                                ?selected qudt:numericValue ?actual .
                                FILTER NOT EXISTS {
                                    $this nltl:hasSpannedHullArea ?otherArea .
                                    ?otherArea nltl:hullAreaFactor ?otherFactor .
                                    ?otherFactor qudt:numericValue ?greater .
                                    FILTER (?greater > ?expected)
                                }
                                FILTER (
                                    ABS(?actual - ?expected) >
                                    IF(
                                        ABS(?expected) > "0"^^xsd:decimal,
                                        0.000001 * ABS(?expected),
                                        0.000000000001
                                    )
                                )
                            }
                        ") ] ] , [ sh:property [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:path nltl:hasSpannedHullArea ], [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:path nltl:selectedHullAreaFactor ] ]""" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:structuralMember ;
                            sh:or ( [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class qudt:QuantityValue ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:selectedHullAreaFactor ],
                                            [ sh:minCount 1 ;
                                                sh:node gen:HullAreaValueShape ;
                                                sh:path nltl:hasSpannedHullArea ] ;
                                        sh:sparql [ sh:message "selectedHullAreaFactor must equal the maximum hullAreaFactor over all spanned hull areas within relative tolerance 1e-6, with an absolute fallback of 1e-12." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                            SELECT $this
                            WHERE {
                                $this nltl:hasSpannedHullArea ?area ;
                                      nltl:selectedHullAreaFactor ?selected .
                                ?area nltl:hullAreaFactor ?factor .
                                ?factor qudt:numericValue ?expected .
                                ?selected qudt:numericValue ?actual .
                                FILTER NOT EXISTS {
                                    $this nltl:hasSpannedHullArea ?otherArea .
                                    ?otherArea nltl:hullAreaFactor ?otherFactor .
                                    ?otherFactor qudt:numericValue ?greater .
                                    FILTER (?greater > ?expected)
                                }
                                FILTER (
                                    ABS(?actual - ?expected) >
                                    IF(
                                        ABS(?expected) > "0"^^xsd:decimal,
                                        0.000001 * ABS(?expected),
                                        0.000000000001
                                    )
                                )
                            }
                        """ ] ] [ sh:property [ sh:maxCount 0 ;
                                                sh:path nltl:selectedHullAreaFactor ],
                                            [ sh:maxCount 0 ;
                                                sh:path nltl:hasSpannedHullArea ] ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:class nltl:structuralMember ; sh:or ( [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:selectedHullAreaFactor ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:HullAreaValueShape ; sh:path nltl:hasSpannedHullArea ] ; sh:sparql [ sh:message Literal("selectedHullAreaFactor must equal the maximum hullAreaFactor over all spanned hull areas within relative tolerance 1e-6, with an absolute fallback of 1e-12.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                            SELECT $this
                            WHERE {
                                $this nltl:hasSpannedHullArea ?area ;
                                      nltl:selectedHullAreaFactor ?selected .
                                ?area nltl:hullAreaFactor ?factor .
                                ?factor qudt:numericValue ?expected .
                                ?selected qudt:numericValue ?actual .
                                FILTER NOT EXISTS {
                                    $this nltl:hasSpannedHullArea ?otherArea .
                                    ?otherArea nltl:hullAreaFactor ?otherFactor .
                                    ?otherFactor qudt:numericValue ?greater .
                                    FILTER (?greater > ?expected)
                                }
                                FILTER (
                                    ABS(?actual - ?expected) >
                                    IF(
                                        ABS(?expected) > "0"^^xsd:decimal,
                                        0.000001 * ABS(?expected),
                                        0.000000000001
                                    )
                                )
                            }
                        ") ] ] [ sh:property [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:path nltl:hasSpannedHullArea ], [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:path nltl:selectedHullAreaFactor ] ] ) ]. See details for more information.""" ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:structuralMember ;
                            sh:or ( [ sh:property [ sh:minCount 1 ;
                                                sh:node gen:HullAreaValueShape ;
                                                sh:path nltl:hasSpannedHullArea ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:selectedHullAreaFactor ] ;
                                        sh:sparql [ sh:message "selectedHullAreaFactor must equal the maximum hullAreaFactor over all spanned hull areas within relative tolerance 1e-6, with an absolute fallback of 1e-12." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                            SELECT $this
                            WHERE {
                                $this nltl:hasSpannedHullArea ?area ;
                                      nltl:selectedHullAreaFactor ?selected .
                                ?area nltl:hullAreaFactor ?factor .
                                ?factor qudt:numericValue ?expected .
                                ?selected qudt:numericValue ?actual .
                                FILTER NOT EXISTS {
                                    $this nltl:hasSpannedHullArea ?otherArea .
                                    ?otherArea nltl:hullAreaFactor ?otherFactor .
                                    ?otherFactor qudt:numericValue ?greater .
                                    FILTER (?greater > ?expected)
                                }
                                FILTER (
                                    ABS(?actual - ?expected) >
                                    IF(
                                        ABS(?expected) > "0"^^xsd:decimal,
                                        0.000001 * ABS(?expected),
                                        0.000000000001
                                    )
                                )
                            }
                        """ ] ] [ sh:property [ sh:maxCount 0 ;
                                                sh:path nltl:hasSpannedHullArea ],
                                            [ sh:maxCount 0 ;
                                                sh:path nltl:selectedHullAreaFactor ] ] ) ] ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/member> ] .

