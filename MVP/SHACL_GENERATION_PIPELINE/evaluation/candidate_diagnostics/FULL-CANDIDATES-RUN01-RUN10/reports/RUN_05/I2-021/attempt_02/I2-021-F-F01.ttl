@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/plating> ;
                    sh:resultMessage "thickness must equal (iceLoadRequiredNetPlateThickness plus corrosionAbrasionAllowance) converted from millimetres to metres, within a relative tolerance of 1e-6 and an absolute fallback tolerance of 1e-9" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "thickness must equal (iceLoadRequiredNetPlateThickness plus corrosionAbrasionAllowance) converted from millimetres to metres, within a relative tolerance of 1e-6 and an absolute fallback tolerance of 1e-9" ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceLoadRequiredNetPlateThickness ?tnetNode ;
                      nltl:corrosionAbrasionAllowance ?allowanceNode ;
                      nltl:thickness ?thicknessNode .

                ?tnetNode qudt:numericValue ?tnet ;
                           qudt:unit unit:MilliM .
                ?allowanceNode qudt:numericValue ?allowance ;
                               qudt:unit unit:MilliM .
                ?thicknessNode qudt:numericValue ?actual ;
                               qudt:unit unit:M .

                BIND((?tnet + ?allowance) / 1000 AS ?expected)
                BIND(ABS(?actual - ?expected) AS ?difference)

                FILTER (
                    ?difference > (0.000001 * ABS(?expected))
                    && ?difference > 0.000000001
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape nltlgen:PlatingThicknessShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape nltlgen:PlatingThicknessShape. See details for more information." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltlgen:PlatingThicknessShape ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/plating> ] .

