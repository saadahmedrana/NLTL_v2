_:n54c5bb5db08f49029c9dbbda6a913208b12 a sh:SPARQLConstraint ;
    sh:message "Framing angle for an oblique plating interpolation case must be strictly between 20 and 70 degrees." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:framingAngle ?angle .
                ?angle qudt:numericValue ?value .
                FILTER ( ?value <= 20 || ?value >= 70 )
            }
        """ .

