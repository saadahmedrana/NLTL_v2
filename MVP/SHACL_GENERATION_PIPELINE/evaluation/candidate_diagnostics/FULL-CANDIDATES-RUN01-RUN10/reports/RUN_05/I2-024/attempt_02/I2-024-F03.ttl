@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/case> ;
                    sh:resultMessage "The framing angle for an oblique plating case must be greater than 20 degrees and less than 70 degrees." ;
                    sh:resultPath nltl:framingAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The framing angle for an oblique plating case must be greater than 20 degrees and less than 70 degrees." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:maxExclusive 70.0 ;
                                            sh:minCount 1 ;
                                            sh:minExclusive 20.0 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:framingAngle ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/ship> ;
            sh:resultMessage "Each oblique plating interpolation case must provide the applicable angle, interpolation endpoints, and externally computed interpolated thickness." ;
            sh:resultPath nltl:hasObliquePlatingInterpolationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each oblique plating interpolation case must provide the applicable angle, interpolation endpoints, and externally computed interpolated thickness." ;
                    sh:node <urn:nltl:generated-shape:I2_024_ObliqueCaseShape> ;
                    sh:path nltl:hasObliquePlatingInterpolationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/case> ] .

