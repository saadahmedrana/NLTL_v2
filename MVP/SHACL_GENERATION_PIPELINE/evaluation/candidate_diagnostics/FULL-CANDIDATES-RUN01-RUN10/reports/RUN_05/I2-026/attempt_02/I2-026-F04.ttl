@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/support> ;
            sh:resultMessage "Each structural member must identify a support and its support condition." ;
            sh:resultPath nltl:hasMemberSupport ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:na21d42305bde471db2c6dc99712d6354b2 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/member> ;
                    sh:resultMessage "Each structural member must identify a support and its support condition." ;
                    sh:resultPath nltl:hasMemberSupport ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:na21d42305bde471db2c6dc99712d6354b2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape nltl:I2_026_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltl:I2_026_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/member> ;
            sh:resultMessage "Each structural member must identify a support and its support condition." ;
            sh:resultPath nltl:hasMemberSupport ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:na21d42305bde471db2c6dc99712d6354b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/support> ;
            sh:resultMessage "Less than 1 values on ex:support->nltl:continuousThroughSupport" ;
            sh:resultPath nltl:continuousThroughSupport ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:continuousThroughSupport ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/support> ;
            sh:resultMessage "Less than 1 values on ex:support->nltl:terminatesWithinIceStrengthenedArea" ;
            sh:resultPath nltl:terminatesWithinIceStrengthenedArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:terminatesWithinIceStrengthenedArea ] ] .

_:na21d42305bde471db2c6dc99712d6354b2 sh:message "Each structural member must identify a support and its support condition." ;
    sh:minCount 1 ;
    sh:node nltl:I2_026_MemberSupportBaseShape ;
    sh:path nltl:hasMemberSupport .

