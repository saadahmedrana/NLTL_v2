@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P02/support> ;
            sh:resultMessage "Each structural member must identify a support and its support condition." ;
            sh:resultPath nltl:hasMemberSupport ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Each structural member must identify a support and its support condition." ;
                    sh:minCount 1 ;
                    sh:node nltl:I2_026_MemberSupportBaseShape ;
                    sh:path nltl:hasMemberSupport ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P02/support> ;
            sh:resultMessage "Less than 1 values on ex:support->nltl:continuousThroughSupport" ;
            sh:resultPath nltl:continuousThroughSupport ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:continuousThroughSupport ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P02/support> ;
            sh:resultMessage "Less than 1 values on ex:support->nltl:terminatesWithinIceStrengthenedArea" ;
            sh:resultPath nltl:terminatesWithinIceStrengthenedArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:terminatesWithinIceStrengthenedArea ] ] .

