@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P04/member> ;
            sh:resultMessage "Demonstrated significant rotational restraint requires evidence on the structural member." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:n9bbc094d329d4bc7b9e6a0de1327b4eab11 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_026_StructuralMemberShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P04/member> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P04/member> ;
                    sh:resultMessage "Less than 1 values on ex:member->nltl:frameSupportCondition" ;
                    sh:resultPath nltl:frameSupportCondition ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n9bbc094d329d4bc7b9e6a0de1327b4eab4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P04/member> ;
                    sh:resultMessage "Demonstrated significant rotational restraint requires evidence on the structural member." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:n9bbc094d329d4bc7b9e6a0de1327b4eab11 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_026_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P04/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P04/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_026_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:I2_026_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P04/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P04/member> ;
            sh:resultMessage "Less than 1 values on ex:member->nltl:frameSupportCondition" ;
            sh:resultPath nltl:frameSupportCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n9bbc094d329d4bc7b9e6a0de1327b4eab4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P04/support> ;
            sh:resultMessage "Less than 1 values on ex:support->nltl:terminatesWithinIceStrengthenedArea" ;
            sh:resultPath nltl:terminatesWithinIceStrengthenedArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:terminatesWithinIceStrengthenedArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P04/support> ;
            sh:resultMessage "Less than 1 values on ex:support->nltl:continuousThroughSupport" ;
            sh:resultPath nltl:continuousThroughSupport ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:continuousThroughSupport ] ] .

_:N726afa2e7935434693080c8cabb0d5f2 rdf:first [ sh:hasValue nltl:fixedFrameSupport ] ;
    rdf:rest ( [ sh:hasValue nltl:simpleFrameSupport ] ) .

_:n9bbc094d329d4bc7b9e6a0de1327b4eab11 a sh:SPARQLConstraint ;
    sh:message "Demonstrated significant rotational restraint requires evidence on the structural member." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasMemberSupport ?support .
                ?support nltl:demonstratedRotationalRestraint true .
                FILTER NOT EXISTS {
                    $this nltl:significantRotationalRestraintEvidence ?evidence .
                }
            }
        """ .

_:n9bbc094d329d4bc7b9e6a0de1327b4eab4 sh:class nltl:frameSupportConditionValue ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:or _:N726afa2e7935434693080c8cabb0d5f2 ;
    sh:path nltl:frameSupportCondition .

