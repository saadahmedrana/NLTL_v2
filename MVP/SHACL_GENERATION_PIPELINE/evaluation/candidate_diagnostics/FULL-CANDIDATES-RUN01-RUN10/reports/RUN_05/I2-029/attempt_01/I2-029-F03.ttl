@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F03/case> ;
                    sh:resultMessage "Flange material inclusion in shear area must be explicitly represented; when included, the linked structural member must have a fitted flange." ;
                    sh:resultPath nltl:flangeMaterialIncludedInShearArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:message "Flange material inclusion in shear area must be explicitly represented; when included, the linked structural member must have a fitted flange." ;
                            sh:minCount 1 ;
                            sh:or ( [ sh:hasValue true ;
                                        sh:property [ sh:class nltl:structuralMember ;
                                                sh:minCount 1 ;
                                                sh:node gs:I2_029_FittedStructuralMemberShape ;
                                                sh:path nltl:sectionCalculationCaseStructuralMember ] ] [ sh:hasValue false ] ) ;
                            sh:path nltl:flangeMaterialIncludedInShearArea ] ;
                    sh:value true ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F03/ship> ;
            sh:resultMessage "Each linked calculation case must satisfy the section modulus and shear area conditions." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "Each linked calculation case must satisfy the section modulus and shear area conditions." ;
                    sh:node gs:I2_029_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F03/case> ] .

