@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F06/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasStructuralMember" ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-030-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F06/calc> ;
                    sh:resultMessage "For framing angles strictly between 20 and 70 degrees, both interpolation endpoints are required." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "For framing angles strictly between 20 and 70 degrees, both interpolation endpoints are required." ;
                            sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:sectionCalculationCaseStructuralMember ?member .
                        ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                        ?localCase nltl:sectionCalculationCasePlating ?plating .
                        ?plating nltl:framingAngleOmega ?angle .
                        ?angle qudt:numericValue ?angleValue .
                        FILTER (?angleValue > 20 && ?angleValue < 70)
                        FILTER NOT EXISTS {
                            $this nltl:interpolationLowerEndpoint ?lower ;
                                  nltl:interpolationUpperEndpoint ?upper .
                        }
                    }
                """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:calculationCase ;
                            sh:property [ sh:node <urn:nltl:generated-shape:I2-030-LengthQuantity> ;
                                    sh:path nltl:plasticNeutralAxisHeight ],
                                [ sh:class nltl:structuralMember ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:sectionCalculationCaseStructuralMember ],
                                [ sh:node [ sh:class nltl:interpolationPoint ] ;
                                    sh:path nltl:interpolationUpperEndpoint ],
                                [ sh:node [ sh:class nltl:interpolationPoint ] ;
                                    sh:path nltl:interpolationLowerEndpoint ] ;
                            sh:sparql [ sh:message "Interpolation endpoints are applicable only for framing angles strictly between 20 and 70 degrees." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:sectionCalculationCaseStructuralMember ?member .
                        ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                        ?localCase nltl:sectionCalculationCasePlating ?plating .
                        ?plating nltl:framingAngleOmega ?angle .
                        ?angle qudt:numericValue ?angleValue .
                        FILTER (?angleValue <= 20 || ?angleValue >= 70)
                        {
                            $this nltl:interpolationLowerEndpoint ?endpoint .
                        }
                        UNION
                        {
                            $this nltl:interpolationUpperEndpoint ?endpoint .
                        }
                    }
                """ ],
                                [ sh:message "For framing angles strictly between 20 and 70 degrees, both interpolation endpoints are required." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:sectionCalculationCaseStructuralMember ?member .
                        ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                        ?localCase nltl:sectionCalculationCasePlating ?plating .
                        ?plating nltl:framingAngleOmega ?angle .
                        ?angle qudt:numericValue ?angleValue .
                        FILTER (?angleValue > 20 && ?angleValue < 70)
                        FILTER NOT EXISTS {
                            $this nltl:interpolationLowerEndpoint ?lower ;
                                  nltl:interpolationUpperEndpoint ?upper .
                        }
                    }
                """ ],
                                [ sh:message "The calculation case structural member must be the structural member that links to the local-frame section calculation case." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>

                    SELECT $this
                    WHERE {
                        $this nltl:sectionCalculationCaseStructuralMember ?member .
                        FILTER NOT EXISTS {
                            ?member nltl:hasLocalFrameSectionCalculationCase $this .
                        }
                    }
                """ ],
                                [ sh:message "The plastic neutral axis height is required when 100 times the local-frame flange area exceeds 1000 times the net attached shell plate thickness times frame spacing." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:sectionCalculationCaseStructuralMember ?member .
                        ?member nltl:netLocalFrameFlangeArea ?area ;
                                nltl:netAttachedShellPlateThickness ?thickness ;
                                nltl:frameSpacing ?spacing .
                        ?area qudt:numericValue ?areaValue .
                        ?thickness qudt:numericValue ?thicknessValue .
                        ?spacing qudt:numericValue ?spacingValue .
                        FILTER (100 * ?areaValue > 1000 * ?thicknessValue * ?spacingValue)
                        FILTER NOT EXISTS {
                            $this nltl:plasticNeutralAxisHeight ?neutralAxis .
                        }
                    }
                """ ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F06/calc> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F06/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:class nltl:calculationCase ; sh:property [ sh:class nltl:structuralMember ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:sectionCalculationCaseStructuralMember ], [ sh:node <urn:nltl:generated-shape:I2-030-LengthQuantity> ; sh:path nltl:plasticNeutralAxisHeight ], [ sh:node [ sh:class nltl:interpolationPoint ] ; sh:path nltl:interpolationLowerEndpoint ], [ sh:node [ sh:class nltl:interpolationPoint ] ; sh:path nltl:interpolationUpperEndpoint ] ; sh:sparql [ sh:message Literal("For framing angles strictly between 20 and 70 degrees, both interpolation endpoints are required.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:sectionCalculationCaseStructuralMember ?member .
                        ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                        ?localCase nltl:sectionCalculationCasePlating ?plating .
                        ?plating nltl:framingAngleOmega ?angle .
                        ?angle qudt:numericValue ?angleValue .
                        FILTER (?angleValue > 20 && ?angleValue < 70)
                        FILTER NOT EXISTS {
                            $this nltl:interpolationLowerEndpoint ?lower ;
                                  nltl:interpolationUpperEndpoint ?upper .
                        }
                    }
                ") ], [ sh:message Literal("Interpolation endpoints are applicable only for framing angles strictly between 20 and 70 degrees.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:sectionCalculationCaseStructuralMember ?member .
                        ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                        ?localCase nltl:sectionCalculationCasePlating ?plating .
                        ?plating nltl:framingAngleOmega ?angle .
                        ?angle qudt:numericValue ?angleValue .
                        FILTER (?angleValue <= 20 || ?angleValue >= 70)
                        {
                            $this nltl:interpolationLowerEndpoint ?endpoint .
                        }
                        UNION
                        {
                            $this nltl:interpolationUpperEndpoint ?endpoint .
                        }
                    }
                ") ], [ sh:message Literal("The calculation case structural member must be the structural member that links to the local-frame section calculation case.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>

                    SELECT $this
                    WHERE {
                        $this nltl:sectionCalculationCaseStructuralMember ?member .
                        FILTER NOT EXISTS {
                            ?member nltl:hasLocalFrameSectionCalculationCase $this .
                        }
                    }
                ") ], [ sh:message Literal("The plastic neutral axis height is required when 100 times the local-frame flange area exceeds 1000 times the net attached shell plate thickness times frame spacing.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:sectionCalculationCaseStructuralMember ?member .
                        ?member nltl:netLocalFrameFlangeArea ?area ;
                                nltl:netAttachedShellPlateThickness ?thickness ;
                                nltl:frameSpacing ?spacing .
                        ?area qudt:numericValue ?areaValue .
                        ?thickness qudt:numericValue ?thicknessValue .
                        ?spacing qudt:numericValue ?spacingValue .
                        FILTER (100 * ?areaValue > 1000 * ?thicknessValue * ?spacingValue)
                        FILTER NOT EXISTS {
                            $this nltl:plasticNeutralAxisHeight ?neutralAxis .
                        }
                    }
                ") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:node [ sh:class nltl:interpolationPoint ] ;
                                    sh:path nltl:interpolationLowerEndpoint ],
                                [ sh:node <urn:nltl:generated-shape:I2-030-LengthQuantity> ;
                                    sh:path nltl:plasticNeutralAxisHeight ],
                                [ sh:class nltl:structuralMember ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:sectionCalculationCaseStructuralMember ],
                                [ sh:node [ sh:class nltl:interpolationPoint ] ;
                                    sh:path nltl:interpolationUpperEndpoint ] ;
                            sh:sparql [ sh:message "For framing angles strictly between 20 and 70 degrees, both interpolation endpoints are required." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:sectionCalculationCaseStructuralMember ?member .
                        ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                        ?localCase nltl:sectionCalculationCasePlating ?plating .
                        ?plating nltl:framingAngleOmega ?angle .
                        ?angle qudt:numericValue ?angleValue .
                        FILTER (?angleValue > 20 && ?angleValue < 70)
                        FILTER NOT EXISTS {
                            $this nltl:interpolationLowerEndpoint ?lower ;
                                  nltl:interpolationUpperEndpoint ?upper .
                        }
                    }
                """ ],
                                [ sh:message "Interpolation endpoints are applicable only for framing angles strictly between 20 and 70 degrees." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:sectionCalculationCaseStructuralMember ?member .
                        ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                        ?localCase nltl:sectionCalculationCasePlating ?plating .
                        ?plating nltl:framingAngleOmega ?angle .
                        ?angle qudt:numericValue ?angleValue .
                        FILTER (?angleValue <= 20 || ?angleValue >= 70)
                        {
                            $this nltl:interpolationLowerEndpoint ?endpoint .
                        }
                        UNION
                        {
                            $this nltl:interpolationUpperEndpoint ?endpoint .
                        }
                    }
                """ ],
                                [ sh:message "The plastic neutral axis height is required when 100 times the local-frame flange area exceeds 1000 times the net attached shell plate thickness times frame spacing." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:sectionCalculationCaseStructuralMember ?member .
                        ?member nltl:netLocalFrameFlangeArea ?area ;
                                nltl:netAttachedShellPlateThickness ?thickness ;
                                nltl:frameSpacing ?spacing .
                        ?area qudt:numericValue ?areaValue .
                        ?thickness qudt:numericValue ?thicknessValue .
                        ?spacing qudt:numericValue ?spacingValue .
                        FILTER (100 * ?areaValue > 1000 * ?thicknessValue * ?spacingValue)
                        FILTER NOT EXISTS {
                            $this nltl:plasticNeutralAxisHeight ?neutralAxis .
                        }
                    }
                """ ],
                                [ sh:message "The calculation case structural member must be the structural member that links to the local-frame section calculation case." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>

                    SELECT $this
                    WHERE {
                        $this nltl:sectionCalculationCaseStructuralMember ?member .
                        FILTER NOT EXISTS {
                            ?member nltl:hasLocalFrameSectionCalculationCase $this .
                        }
                    }
                """ ] ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F06/calc> ] .

