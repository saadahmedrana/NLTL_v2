@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ;
                    sh:resultMessage "For a longitudinal frame in a side structure, each represented load case must provide a decimal combined shear-and-bending demand, plastic strength, and midspan plastic collapse load; strength quantities must use qudt:KiloN." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "For a longitudinal frame in a side structure, each represented load case must provide a decimal combined shear-and-bending demand, plastic strength, and midspan plastic collapse load; strength quantities must use qudt:KiloN." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:longitudinalFrameOrientation true ;
                      nltl:structuralLocation nltl:sideStructureLocation ;
                      nltl:hasStructuralMemberLoadCase ?loadCase .

                OPTIONAL {
                    ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                    OPTIONAL { ?demand qudt:numericValue ?demandValue . }
                }
                OPTIONAL {
                    ?loadCase nltl:plasticStrength ?strength .
                    OPTIONAL { ?strength qudt:numericValue ?strengthValue . }
                    OPTIONAL { ?strength qudt:unit ?strengthUnit . }
                }
                OPTIONAL {
                    ?loadCase nltl:midspanPlasticCollapseLoad ?collapseLoad .
                    OPTIONAL { ?collapseLoad qudt:numericValue ?collapseValue . }
                    OPTIONAL { ?collapseLoad qudt:unit ?collapseUnit . }
                }

                FILTER(
                    !BOUND(?demand) ||
                    !BOUND(?demandValue) ||
                    datatype(?demandValue) != xsd:decimal ||
                    !BOUND(?strength) ||
                    !BOUND(?strengthValue) ||
                    datatype(?strengthValue) != xsd:decimal ||
                    !BOUND(?strengthUnit) ||
                    ?strengthUnit != qudt:KiloN ||
                    !BOUND(?collapseLoad) ||
                    !BOUND(?collapseValue) ||
                    datatype(?collapseValue) != xsd:decimal ||
                    !BOUND(?collapseUnit) ||
                    ?collapseUnit != qudt:KiloN
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-034-StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "The ship must provide one frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship must provide one frame profile type." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:frameProfileType ] ] .

