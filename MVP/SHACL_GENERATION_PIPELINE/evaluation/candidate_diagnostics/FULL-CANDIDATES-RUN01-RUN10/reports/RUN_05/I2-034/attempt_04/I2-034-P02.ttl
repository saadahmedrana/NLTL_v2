@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-P02/member> ;
                    sh:resultMessage "For each longitudinal structural member in a side structure, every represented load case must provide combined shear-and-bending demand, midspan plastic-collapse load, and plastic strength in kN." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "For each longitudinal structural member in a side structure, every represented load case must provide combined shear-and-bending demand, midspan plastic-collapse load, and plastic strength in kN." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:longitudinalFrameOrientation true ;
                      nltl:structuralLocation nltl:sideStructureLocation ;
                      nltl:hasStructuralMemberLoadCase ?loadCase .

                FILTER NOT EXISTS {
                    ?loadCase nltl:combinedShearAndBendingDemand ?demand ;
                              nltl:midspanPlasticCollapseLoad ?midspan ;
                              nltl:plasticStrength ?strength .

                    ?demand qudt:numericValue ?demandValue ;
                            qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                    ?midspan qudt:numericValue ?midspanValue ;
                             qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                    ?strength qudt:numericValue ?strengthValue ;
                              qudt:unit <http://qudt.org/vocab/unit/KiloN> .

                    FILTER (datatype(?demandValue) = xsd:decimal)
                    FILTER (datatype(?midspanValue) = xsd:decimal)
                    FILTER (datatype(?strengthValue) = xsd:decimal)
                }
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape g:I2_034_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-P02/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape g:I2_034_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:node g:I2_034_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-P02/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-P02/ship> ;
            sh:resultMessage "The ship must specify one permitted frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:flatBarSection nltl:profileSection ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship must specify one permitted frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ] .

