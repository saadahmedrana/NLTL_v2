@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasIceLoadPatchDesignCase" ;
            sh:resultPath nltl:hasIceLoadPatchDesignCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceLoadPatchDesignCase ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The ice-load patch design case must confirm capacity minimization under the combined bending and shear condition." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:memberCapacityMinimizationConfirmed ] ] ;
                    sh:path nltl:hasIceLoadPatchDesignCase ] ] .

