@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ;
                    sh:resultMessage "The ice-load patch design case must confirm capacity minimization under the combined bending and shear condition." ;
                    sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n1d7b97aa44c5415ca283f40ba68d8a6db3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ;
                    sh:resultMessage "The ice-load patch design case must confirm capacity minimization under the combined bending and shear condition." ;
                    sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n1d7b97aa44c5415ca283f40ba68d8a6db3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ice-load patch design case must confirm capacity minimization under the combined bending and shear condition.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:memberCapacityMinimizationConfirmed ] ]. See details for more information." ;
            sh:resultPath nltl:hasIceLoadPatchDesignCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceLoadPatchDesignCase ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The ice-load patch design case must confirm capacity minimization under the combined bending and shear condition." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:memberCapacityMinimizationConfirmed ] ] ;
                    sh:path nltl:hasIceLoadPatchDesignCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ] .

_:n1d7b97aa44c5415ca283f40ba68d8a6db3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice-load patch design case must confirm capacity minimization under the combined bending and shear condition." ;
    sh:minCount 1 ;
    sh:path nltl:memberCapacityMinimizationConfirmed .

