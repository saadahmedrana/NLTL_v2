@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/ship> ;
            sh:resultMessage "Each applicable web frame or load-carrying stringer must have a structural-member load case with combined shear and bending effect and application location data, a member capacity in kN, an applicable ice load patch and design case, and confirmation that the member capacity is minimized." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each applicable web frame or load-carrying stringer must have a structural-member load case with combined shear and bending effect and application location data, a member capacity in kN, an applicable ice load patch and design case, and confirmation that the member capacity is minimized." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member rdf:type ?memberType .
                FILTER (
                    ?memberType IN (
                        nltl:webFrame,
                        nltl:loadCarryingStringer
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:hasIceLoadPatch ?patch .
                    ?patch rdf:type nltl:iceLoadPatch .

                    ?member nltl:hasStructuralMemberLoadCase ?loadCase .
                    ?loadCase rdf:type nltl:loadCase .
                    ?loadCase nltl:combinedShearBendingEffect ?effect .
                    ?loadCase nltl:loadPatchApplicationLocation ?location .

                    ?member nltl:memberCapacity ?capacity .
                    ?capacity rdf:type qudt:QuantityValue .
                    ?capacity qudt:numericValue ?capacityValue .
                    ?capacity qudt:unit unit:KiloN .
                    FILTER (datatype(?effect) = xsd:string)
                    FILTER (datatype(?location) = xsd:string)
                    FILTER (datatype(?capacityValue) = xsd:decimal)

                    $this nltl:hasIceLoadPatchDesignCase ?designCase .
                    ?designCase rdf:type nltl:iceLoadPatchDesignCase .
                    ?designCase nltl:memberCapacityMinimizationConfirmed true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2_037_Static> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/ship> ] .

