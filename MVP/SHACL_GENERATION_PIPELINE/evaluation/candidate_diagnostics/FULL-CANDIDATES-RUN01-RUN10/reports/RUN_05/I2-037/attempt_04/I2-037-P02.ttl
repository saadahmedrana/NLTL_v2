@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ;
                    sh:resultMessage "Node ex:patchCase->nltl:memberCapacityMinimizationConfirmed does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
                    sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nbdca26ca8177471e9f2f6f6acea37b6bb5 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ;
                    sh:resultMessage "Less than 1 values on ex:patchCase->nltl:memberCapacityMinimizationConfirmed" ;
                    sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nbdca26ca8177471e9f2f6f6acea37b6bb5 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:iceLoadPatchDesignCase ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:memberCapacityMinimizationConfirmed ] ]. See details for more information." ;
            sh:resultPath nltl:hasIceLoadPatchDesignCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:iceLoadPatchDesignCase ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:minCount 1 ;
                                    sh:path nltl:memberCapacityMinimizationConfirmed ] ] ;
                    sh:path nltl:hasIceLoadPatchDesignCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "Each linked web frame or load-carrying stringer must have a load case, combined bending-and-shear effect, application location, kN member capacity, and linked ice-patch design confirmation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each linked web frame or load-carrying stringer must have a load case, combined bending-and-shear effect, application location, kN member capacity, and linked ice-patch design confirmation." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                {
                    ?member rdf:type nltl:webFrame .
                }
                UNION
                {
                    ?member rdf:type nltl:loadCarryingStringer .
                }
                FILTER NOT EXISTS {
                    ?member nltl:hasStructuralMemberLoadCase ?loadCase .
                    ?loadCase rdf:type nltl:loadCase ;
                              nltl:combinedShearBendingEffect ?effect ;
                              nltl:loadPatchApplicationLocation ?location .
                    FILTER NOT EXISTS {
                        ?loadCase nltl:combinedShearBendingEffect ?badEffect .
                        FILTER (datatype(?badEffect) != xsd:string)
                    }
                    FILTER NOT EXISTS {
                        ?loadCase nltl:loadPatchApplicationLocation ?badLocation .
                        FILTER (datatype(?badLocation) != xsd:string)
                    }
                    ?member nltl:memberCapacity ?capacity .
                    ?capacity rdf:type qudt:QuantityValue ;
                              qudt:numericValue ?capacityValue ;
                              qudt:unit unit:KiloN .
                    FILTER (datatype(?capacityValue) = xsd:decimal)
                    FILTER NOT EXISTS {
                        ?capacity qudt:unit ?badUnit .
                        FILTER (?badUnit != unit:KiloN)
                    }
                    FILTER NOT EXISTS {
                        ?capacity qudt:numericValue ?badValue .
                        FILTER (datatype(?badValue) != xsd:decimal)
                    }
                    $this nltl:hasIceLoadPatch ?patch .
                    ?patch rdf:type nltl:iceLoadPatch .
                    $this nltl:hasIceLoadPatchDesignCase ?designCase .
                    ?designCase rdf:type nltl:iceLoadPatchDesignCase ;
                                nltl:memberCapacityMinimizationConfirmed true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape g:I2_037_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasIceLoadPatch" ;
            sh:resultPath nltl:hasIceLoadPatch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:iceLoadPatch ] ;
                    sh:path nltl:hasIceLoadPatch ] ] .

_:nbdca26ca8177471e9f2f6f6acea37b6bb5 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:minCount 1 ;
    sh:path nltl:memberCapacityMinimizationConfirmed .

