@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:I2_046_ApplicableShape , gen:I2_046_NonApplicableShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_046_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/ship> ;
            sh:resultMessage "Exactly one polarClassRequirementsApplicable boolean is required." ;
            sh:resultPath nltl:polarClassRequirementsApplicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:in ( true false ) ;
                    sh:maxCount 1 ;
                    sh:message "Exactly one polarClassRequirementsApplicable boolean is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarClassRequirementsApplicable ] ] .

