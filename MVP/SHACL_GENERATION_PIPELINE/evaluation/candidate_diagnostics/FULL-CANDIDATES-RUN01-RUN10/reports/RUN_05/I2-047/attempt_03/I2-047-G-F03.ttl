@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->( nltl:hasPlating nltl:iceStrengthenedStructureStatus )" ;
            sh:resultPath ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:I2_047_NotIceStrengthenedShape , gen:I2_047_IceStrengthenedShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_047_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F03/ship> ] .

