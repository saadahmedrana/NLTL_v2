@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T100/case> ;
                    sh:resultMessage "Less than 1 values on ex:case->nltl:asBuiltPlateThickness" ;
                    sh:resultPath nltl:asBuiltPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ a sh:NodeShape ;
                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:nodeKind sh:IRI ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:asBuiltPlateThickness ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T100/ship> ;
            sh:resultMessage """Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:class nltl:plating ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:steelGradeRequirementCasePlating ], [ sh:class nltl:steelGradeValue ; sh:in ( nltl:steelGradeAh nltl:steelGradeB nltl:steelGradeD nltl:steelGradeDh nltl:steelGradeE nltl:steelGradeEh nltl:steelGradeFh ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:actualHullStructuralSteelGrade ], [ sh:class nltl:steelGradeValue ; sh:in ( nltl:steelGradeAh nltl:steelGradeB nltl:steelGradeD nltl:steelGradeDh nltl:steelGradeE nltl:steelGradeEh nltl:steelGradeFh ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:requiredHullStructuralSteelGrade ], [ sh:class nltl:steelMaterialClassValue ; sh:in ( nltl:steelMaterialClassOne nltl:steelMaterialClassTwo nltl:steelMaterialClassThree ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:steelMaterialClass ], [ sh:class nltl:steelStrengthCategoryValue ; sh:in ( nltl:normalStrengthSteelCategory nltl:highTensileSteelCategory ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:steelStrengthCategory ], [ sh:class nltl:tableReferenceValue ; sh:hasValue nltl:iacsUrI2Table8 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:tableReference ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:asBuiltPlateThickness ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("The steel-grade table selection, applicability, grade family, or rank comparison is non-conforming.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  ?ship nltl:hasSteelGradeRequirementCase $this ;
        nltl:polarClass ?pc .
  $this nltl:asBuiltPlateThickness ?thicknessNode ;
        nltl:steelMaterialClass ?material ;
        nltl:steelStrengthCategory ?category ;
        nltl:actualHullStructuralSteelGrade ?actual .
  ?thicknessNode qudt:numericValue ?t ;
                 qudt:unit <http://qudt.org/vocab/unit/MilliM> .
  ?actual nltl:steelGradeOrderRank ?actualRank .

  OPTIONAL {
    $this nltl:requiredHullStructuralSteelGrade ?required .
    ?required nltl:steelGradeOrderRank ?requiredRank .
  }

  BIND(
    IF(?t <= 10,
      IF(?material IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo),
        1,
        IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 1)
      ),
      IF(?t <= 25,
        IF(?material = nltl:steelMaterialClassOne,
          1,
          IF(?material = nltl:steelMaterialClassTwo,
            IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 2, 1),
            IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2)
          )
        ),
        IF(?t <= 35,
          IF(?material = nltl:steelMaterialClassOne,
            IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 2, 1),
            IF(?material = nltl:steelMaterialClassTwo,
              IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2),
              IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 1)
            )
          ),
          IF(?t <= 45,
            IF(?material = nltl:steelMaterialClassOne,
              2,
              IF(?material = nltl:steelMaterialClassTwo,
                IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2),
                IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3),
                  IF(?category = nltl:normalStrengthSteelCategory, 0, 4),
                  3
                )
              )
            ),
            IF(?t <= 50,
              IF(?material = nltl:steelMaterialClassOne,
                IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2),
                IF(?material = nltl:steelMaterialClassTwo,
                  IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2),
                  IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5),
                    IF(?category = nltl:normalStrengthSteelCategory,
                      IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3), 0, 0),
                      4
                    ),
                    3
                  )
                )
              ),
              0
            )
          )
        )
      )
    ) AS ?expectedRank
  )

  FILTER (
    ?t <= 0 ||
    ?t > 50 ||
    (?expectedRank = 0 && BOUND(?required)) ||
    (?expectedRank > 0 && (
      !BOUND(?required) ||
      ?requiredRank != ?expectedRank ||
      (
        ?category = nltl:normalStrengthSteelCategory &&
        (
          ?actual NOT IN (
            nltl:steelGradeB,
            nltl:steelGradeD,
            nltl:steelGradeE
          ) ||
          ?required NOT IN (
            nltl:steelGradeB,
            nltl:steelGradeD,
            nltl:steelGradeE
          )
        )
      ) ||
      (
        ?category = nltl:highTensileSteelCategory &&
        (
          ?actual NOT IN (
            nltl:steelGradeAh,
            nltl:steelGradeDh,
            nltl:steelGradeEh,
            nltl:steelGradeFh
          ) ||
          ?required NOT IN (
            nltl:steelGradeAh,
            nltl:steelGradeDh,
            nltl:steelGradeEh,
            nltl:steelGradeFh
          )
        )
      ) ||
      ?actualRank < ?requiredRank
    ))
  )
}
") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasSteelGradeRequirementCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeRequirementCase ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ sh:class nltl:plating ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:steelGradeRequirementCasePlating ],
                                [ sh:class nltl:steelGradeValue ;
                                    sh:in ( nltl:steelGradeAh nltl:steelGradeB nltl:steelGradeD nltl:steelGradeDh nltl:steelGradeE nltl:steelGradeEh nltl:steelGradeFh ) ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:actualHullStructuralSteelGrade ],
                                [ sh:class nltl:steelMaterialClassValue ;
                                    sh:in ( nltl:steelMaterialClassOne nltl:steelMaterialClassTwo nltl:steelMaterialClassThree ) ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:steelMaterialClass ],
                                [ sh:class nltl:tableReferenceValue ;
                                    sh:hasValue nltl:iacsUrI2Table8 ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:tableReference ],
                                [ sh:class nltl:steelStrengthCategoryValue ;
                                    sh:in ( nltl:normalStrengthSteelCategory nltl:highTensileSteelCategory ) ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:steelStrengthCategory ],
                                [ sh:class nltl:steelGradeValue ;
                                    sh:in ( nltl:steelGradeAh nltl:steelGradeB nltl:steelGradeD nltl:steelGradeDh nltl:steelGradeE nltl:steelGradeEh nltl:steelGradeFh ) ;
                                    sh:maxCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:requiredHullStructuralSteelGrade ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ a sh:NodeShape ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:nodeKind sh:IRI ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:asBuiltPlateThickness ] ;
                            sh:sparql [ a sh:SPARQLConstraint ;
                                    sh:message "The steel-grade table selection, applicability, grade family, or rank comparison is non-conforming." ;
                                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  ?ship nltl:hasSteelGradeRequirementCase $this ;
        nltl:polarClass ?pc .
  $this nltl:asBuiltPlateThickness ?thicknessNode ;
        nltl:steelMaterialClass ?material ;
        nltl:steelStrengthCategory ?category ;
        nltl:actualHullStructuralSteelGrade ?actual .
  ?thicknessNode qudt:numericValue ?t ;
                 qudt:unit <http://qudt.org/vocab/unit/MilliM> .
  ?actual nltl:steelGradeOrderRank ?actualRank .

  OPTIONAL {
    $this nltl:requiredHullStructuralSteelGrade ?required .
    ?required nltl:steelGradeOrderRank ?requiredRank .
  }

  BIND(
    IF(?t <= 10,
      IF(?material IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo),
        1,
        IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 1)
      ),
      IF(?t <= 25,
        IF(?material = nltl:steelMaterialClassOne,
          1,
          IF(?material = nltl:steelMaterialClassTwo,
            IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 2, 1),
            IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2)
          )
        ),
        IF(?t <= 35,
          IF(?material = nltl:steelMaterialClassOne,
            IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 2, 1),
            IF(?material = nltl:steelMaterialClassTwo,
              IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2),
              IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 1)
            )
          ),
          IF(?t <= 45,
            IF(?material = nltl:steelMaterialClassOne,
              2,
              IF(?material = nltl:steelMaterialClassTwo,
                IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2),
                IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3),
                  IF(?category = nltl:normalStrengthSteelCategory, 0, 4),
                  3
                )
              )
            ),
            IF(?t <= 50,
              IF(?material = nltl:steelMaterialClassOne,
                IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2),
                IF(?material = nltl:steelMaterialClassTwo,
                  IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2),
                  IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5),
                    IF(?category = nltl:normalStrengthSteelCategory,
                      IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3), 0, 0),
                      4
                    ),
                    3
                  )
                )
              ),
              0
            )
          )
        )
      )
    ) AS ?expectedRank
  )

  FILTER (
    ?t <= 0 ||
    ?t > 50 ||
    (?expectedRank = 0 && BOUND(?required)) ||
    (?expectedRank > 0 && (
      !BOUND(?required) ||
      ?requiredRank != ?expectedRank ||
      (
        ?category = nltl:normalStrengthSteelCategory &&
        (
          ?actual NOT IN (
            nltl:steelGradeB,
            nltl:steelGradeD,
            nltl:steelGradeE
          ) ||
          ?required NOT IN (
            nltl:steelGradeB,
            nltl:steelGradeD,
            nltl:steelGradeE
          )
        )
      ) ||
      (
        ?category = nltl:highTensileSteelCategory &&
        (
          ?actual NOT IN (
            nltl:steelGradeAh,
            nltl:steelGradeDh,
            nltl:steelGradeEh,
            nltl:steelGradeFh
          ) ||
          ?required NOT IN (
            nltl:steelGradeAh,
            nltl:steelGradeDh,
            nltl:steelGradeEh,
            nltl:steelGradeFh
          )
        )
      ) ||
      ?actualRank < ?requiredRank
    ))
  )
}
""" ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasSteelGradeRequirementCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T100/case> ] .

