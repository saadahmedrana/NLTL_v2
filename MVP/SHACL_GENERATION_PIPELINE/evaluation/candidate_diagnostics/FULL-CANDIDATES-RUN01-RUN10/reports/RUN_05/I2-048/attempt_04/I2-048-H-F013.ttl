@prefix ex: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F013/case> ;
            sh:resultMessage "The material class, strength category, and actual grade must use the declared controlled values and family." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The material class, strength category, and actual grade must use the declared controlled values and family." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                {
                    $this nltl:steelMaterialClass ?mat ;
                          nltl:steelStrengthCategory ?fam ;
                          nltl:actualHullStructuralSteelGrade ?actual .
                    FILTER (?mat NOT IN (
                        nltl:steelMaterialClassOne,
                        nltl:steelMaterialClassTwo,
                        nltl:steelMaterialClassThree
                    ))
                }
                UNION
                {
                    $this nltl:steelStrengthCategory ?fam ;
                          nltl:actualHullStructuralSteelGrade ?actual .
                    FILTER (?fam NOT IN (
                        nltl:normalStrengthSteelCategory,
                        nltl:highTensileSteelCategory
                    ))
                }
                UNION
                {
                    $this nltl:steelStrengthCategory nltl:normalStrengthSteelCategory ;
                          nltl:actualHullStructuralSteelGrade ?actual .
                    FILTER (?actual NOT IN (
                        nltl:steelGradeB,
                        nltl:steelGradeD,
                        nltl:steelGradeE
                    ))
                }
                UNION
                {
                    $this nltl:steelStrengthCategory nltl:highTensileSteelCategory ;
                          nltl:actualHullStructuralSteelGrade ?actual .
                    FILTER (?actual NOT IN (
                        nltl:steelGradeAh,
                        nltl:steelGradeDh,
                        nltl:steelGradeEh,
                        nltl:steelGradeFh
                    ))
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape ex:I2_048_CaseShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F013/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F013/case> ;
            sh:resultMessage "Less than 1 values on ex:case->nltl:asBuiltPlateThickness" ;
            sh:resultPath nltl:asBuiltPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:asBuiltPlateThickness ] ] .

