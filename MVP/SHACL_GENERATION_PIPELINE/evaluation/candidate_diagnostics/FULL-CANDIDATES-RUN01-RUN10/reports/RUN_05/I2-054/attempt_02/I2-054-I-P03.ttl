@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp2> ;
                            sh:resultMessage "Each interpolation point shall provide its externally determined result." ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nded6dbe276194370ae2e925c572d3156b32 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp2> ;
                            sh:resultMessage "Each interpolation point shall provide its coordinate as a dimensionless quantity." ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nded6dbe276194370ae2e925c572d3156b28 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/bendingCase> ;
                    sh:resultMessage "The calculation case shall provide the interpolation points used for the distribution factor." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nded6dbe276194370ae2e925c572d3156b15 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp2> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp1> ;
                            sh:resultMessage "Each interpolation point shall provide its externally determined result." ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nded6dbe276194370ae2e925c572d3156b32 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp1> ;
                            sh:resultMessage "Each interpolation point shall provide its coordinate as a dimensionless quantity." ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nded6dbe276194370ae2e925c572d3156b28 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/bendingCase> ;
                    sh:resultMessage "The calculation case shall provide the interpolation points used for the distribution factor." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nded6dbe276194370ae2e925c572d3156b15 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/ship> ;
            sh:resultMessage "The ship shall provide a calculation case for the externally determined bending-moment calculation." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide a calculation case for the externally determined bending-moment calculation." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_054_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/bendingCase> ] .

_:N321c6ea2a0924ce794e35e1e1162c8a9 sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

_:N4f3a8b79a67d4a39a9babd8f324352c4 sh:class qudt:QuantityValue ;
    sh:property _:N321c6ea2a0924ce794e35e1e1162c8a9,
        [ sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:N6f959e1311a246a185077af1bc7fb105 sh:minCount 1 ;
    sh:path qudt:numericValue .

_:Nf6a76722816d4736b4baa6bbdb2cc170 sh:class qudt:QuantityValue ;
    sh:property _:N6f959e1311a246a185077af1bc7fb105 .

_:nded6dbe276194370ae2e925c572d3156b15 sh:message "The calculation case shall provide the interpolation points used for the distribution factor." ;
    sh:minCount 1 ;
    sh:node gen:I2_054_InterpolationPointShape ;
    sh:path nltl:hasInterpolationPoint .

_:nded6dbe276194370ae2e925c572d3156b28 sh:message "Each interpolation point shall provide its coordinate as a dimensionless quantity." ;
    sh:minCount 1 ;
    sh:node _:N4f3a8b79a67d4a39a9babd8f324352c4 ;
    sh:path nltl:interpolationPointCoordinate .

_:nded6dbe276194370ae2e925c572d3156b32 sh:message "Each interpolation point shall provide its externally determined result." ;
    sh:minCount 1 ;
    sh:node _:Nf6a76722816d4736b4baa6bbdb2cc170 ;
    sh:path nltl:interpolationPointResult .

