@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-P01/ship> ;
            sh:resultMessage "A member in way of a cutout requires the ship-owned memberInstability value to be explicitly false and not true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A member in way of a cutout requires the ship-owned memberInstability value to be explicitly false and not true." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasCutout ?cutout .
                ?cutout a nltl:cutout .
                ?member nltl:memberInWayOfCutout true .
                FILTER (
                    NOT EXISTS {
                        $this nltl:memberInstability false
                    }
                    ||
                    EXISTS {
                        $this nltl:memberInstability true
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:I2_060_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-P01/ship> ] .

