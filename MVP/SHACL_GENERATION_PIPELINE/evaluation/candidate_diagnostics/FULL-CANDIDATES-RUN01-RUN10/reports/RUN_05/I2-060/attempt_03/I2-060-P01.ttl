@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-P01/ship> ;
            sh:resultMessage "A member linked to a cutout requires exactly a non-contradictory explicitly typed false nltl:memberInstability value on the ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A member linked to a cutout requires exactly a non-contradictory explicitly typed false nltl:memberInstability value on the ship." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout .
    FILTER (
        NOT EXISTS {
            $this nltl:memberInstability ?instability .
            FILTER (
                datatype(?instability) = xsd:boolean &&
                ?instability = "false"^^xsd:boolean
            )
        }
        ||
        EXISTS {
            $this nltl:memberInstability ?instabilityTrue .
            FILTER (
                datatype(?instabilityTrue) = xsd:boolean &&
                ?instabilityTrue = "true"^^xsd:boolean
            )
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_060_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-P01/ship> ] .

