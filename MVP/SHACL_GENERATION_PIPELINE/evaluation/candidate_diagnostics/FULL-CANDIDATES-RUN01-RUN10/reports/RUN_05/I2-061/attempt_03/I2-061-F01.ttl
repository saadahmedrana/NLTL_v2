@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ;
                    sh:resultMessage "Value nltl:directCalculationMethodValue not in list ['nltl:prescribedAnalyticalProcedure']" ;
                    sh:resultPath nltl:calculationMethod ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:calculationMethodValue ;
                            sh:in ( nltl:prescribedAnalyticalProcedure ) ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:calculationMethod ] ;
                    sh:value nltl:directCalculationMethodValue ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/structure> ;
                            sh:resultMessage "Node ex:structure must conform to one or more shapes in [ sh:class nltl:plating ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:thickness ] ] , [ sh:class nltl:structuralMember ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:thickness ] ]" ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:OrConstraintComponent ;
                            sh:sourceShape [ sh:or ( [ sh:class nltl:plating ;
                                                sh:property [ sh:minCount 1 ;
                                                        sh:node [ sh:property [ ],
                                                                    [ ] ] ;
                                                        sh:nodeKind sh:IRI ;
                                                        sh:path nltl:thickness ] ] [ sh:class nltl:structuralMember ;
                                                sh:property [ sh:minCount 1 ;
                                                        sh:node [ sh:property [ ],
                                                                    [ ] ] ;
                                                        sh:nodeKind sh:IRI ;
                                                        sh:path nltl:thickness ] ] ) ] ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/structure> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:or ( [ sh:class nltl:plating ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:thickness ] ] [ sh:class nltl:structuralMember ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:thickness ] ] ) ]. See details for more information." ;
                    sh:resultPath nltl:calculationCaseAssessedHullStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:hullStructure ;
                            sh:minCount 1 ;
                            sh:node [ sh:or ( [ sh:class nltl:plating ;
                                                sh:property [ sh:minCount 1 ;
                                                        sh:node [ ] ;
                                                        sh:nodeKind sh:IRI ;
                                                        sh:path nltl:thickness ] ] [ sh:class nltl:structuralMember ;
                                                sh:property [ sh:minCount 1 ;
                                                        sh:node [ ] ;
                                                        sh:nodeKind sh:IRI ;
                                                        sh:path nltl:thickness ] ] ) ] ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:calculationCaseAssessedHullStructure ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/structure> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-CalculationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:node <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ] .

