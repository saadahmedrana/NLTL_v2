@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/ship> ;
            sh:resultMessage "For a shell-plating or local-frame calculation case, the prescribed analytical procedure is required and direct calculation may not be used." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a shell-plating or local-frame calculation case, the prescribed analytical procedure is required and direct calculation may not be used." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationCaseAssessedHullStructure ?hullStructure .
                ?hullStructure a ?hullStructureKind .
                FILTER (
                    ?hullStructureKind IN (
                        nltl:plating,
                        nltl:structuralMember
                    )
                )
                FILTER (
                    EXISTS {
                        ?case nltl:calculationMethod
                            nltl:directCalculationMethodValue
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:calculationMethod
                            nltl:prescribedAnalyticalProcedure
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-061-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/structure> ;
            sh:resultMessage "Less than 1 values on ex:structure->nltl:thickness" ;
            sh:resultPath nltl:thickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ sh:hasValue qudt:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:thickness ] ] .

