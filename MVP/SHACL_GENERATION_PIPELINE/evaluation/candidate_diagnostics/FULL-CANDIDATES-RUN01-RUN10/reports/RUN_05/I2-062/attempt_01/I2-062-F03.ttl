@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-F03/ship> ;
            sh:resultMessage "The ship shall identify a load carrying stringer forming part of a grillage system." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify a load carrying stringer forming part of a grillage system." ;
                    sh:path nltl:hasStructuralMember ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:loadCarryingStringer ;
                            sh:property [ sh:class nltl:grillageSystem ;
                                    sh:minCount 1 ;
                                    sh:path nltl:partOfGrillageSystem ] ] ] ] .

