@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode nltl:nonlinearCalculationMethodValue ;
                            sh:resultMessage "Node nltl:nonlinearCalculationMethodValue value is not a in the set of values: ['nltl:linearCalculationMethodValue']" ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:class nltl:calculationMethodValue ;
                                    sh:hasValue nltl:linearCalculationMethodValue ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/calculation> ;
                    sh:resultMessage "Each calculation case must identify the linear calculation method." ;
                    sh:resultPath nltl:calculationMethod ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Each calculation case must identify the linear calculation method." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:calculationMethodValue ;
                                    sh:hasValue nltl:linearCalculationMethodValue ] ;
                            sh:path nltl:calculationMethod ] ;
                    sh:value nltl:nonlinearCalculationMethodValue ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/ship> ;
            sh:resultMessage "A linear calculation case is required to establish applicability." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A linear calculation case is required to establish applicability." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:message "Each calculation case must identify the linear calculation method." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:calculationMethodValue ;
                                            sh:hasValue nltl:linearCalculationMethodValue ] ;
                                    sh:path nltl:calculationMethod ] ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/calculation> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/ship> ;
            sh:resultMessage "The ship must provide yield strength in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide yield strength in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:MegaPA ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:yieldStrength ] ] .

