@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F06/ship> ;
            sh:resultMessage "When a linked calculation case uses the nonlinear method, the ship must provide the required acceptance margins." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_065_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F06/ship> ] .

