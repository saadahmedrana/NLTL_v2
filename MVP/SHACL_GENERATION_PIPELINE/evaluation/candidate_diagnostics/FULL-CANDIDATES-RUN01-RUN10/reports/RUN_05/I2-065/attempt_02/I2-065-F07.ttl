@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/calculation> ;
            sh:resultMessage "A nonlinear calculation case must provide the declared method, evidence, assessment result, and deformation-related inputs." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_065_CalculationCaseShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/calculation> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "When a linked calculation case uses the nonlinear method, the ship must provide the required acceptance margins." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_065_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/calculation> ;
                    sh:resultMessage "A nonlinear calculation case must provide the declared method, evidence, assessment result, and deformation-related inputs." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:I2_065_CalculationCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/calculation> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "Each linked calculation case must follow the declared nonlinear-calculation case model." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "Each linked calculation case must follow the declared nonlinear-calculation case model." ;
                    sh:node gen:I2_065_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/calculation> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "A calculation case must declare its calculation method." ;
            sh:resultPath nltl:calculationMethod ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A calculation case must declare its calculation method." ;
                    sh:minCount 1 ;
                    sh:path nltl:calculationMethod ] ] .

