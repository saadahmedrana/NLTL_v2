@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F01/weld1> ;
                    sh:resultMessage "Welding within an ice-strengthened area must be of the double continuous type." ;
                    sh:resultPath nltl:weldType ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue nltl:doubleContinuousWeld ;
                            sh:message "Welding within an ice-strengthened area must be of the double continuous type." ;
                            sh:minCount 1 ;
                            sh:path nltl:weldType ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F01/ship> ;
            sh:resultMessage "Each linked weld must conform to the ice-strengthened-area welding rule." ;
            sh:resultPath nltl:hasWeld ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked weld must conform to the ice-strengthened-area welding rule." ;
                    sh:node <urn:nltl:generated-shape:I2-066-WeldShape> ;
                    sh:path nltl:hasWeld ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F01/weld1> ] .

