@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F03/weld1> ;
                    sh:resultMessage "A weld in scope must explicitly be identified as within an ice-strengthened area." ;
                    sh:resultPath nltl:withinIceStrengthenedArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n3e03ea9c47734b30b5e78a6089347143b2 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F03/weld1> ;
                    sh:resultMessage "A weld in scope must explicitly be identified as within an ice-strengthened area." ;
                    sh:resultPath nltl:withinIceStrengthenedArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n3e03ea9c47734b30b5e78a6089347143b2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F03/ship> ;
            sh:resultMessage "Each linked weld must conform to the ice-strengthened-area welding rule." ;
            sh:resultPath nltl:hasWeld ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked weld must conform to the ice-strengthened-area welding rule." ;
                    sh:node <urn:nltl:generated-shape:I2-066-WeldShape> ;
                    sh:path nltl:hasWeld ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F03/weld1> ] .

_:n3e03ea9c47734b30b5e78a6089347143b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "A weld in scope must explicitly be identified as within an ice-strengthened area." ;
    sh:minCount 1 ;
    sh:path nltl:withinIceStrengthenedArea .

