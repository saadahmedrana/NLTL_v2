@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F03/weld1> ;
                    sh:resultMessage "Each linked weld must explicitly state whether it is within the ice-strengthened area." ;
                    sh:resultPath nltl:withinIceStrengthenedArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:message "Each linked weld must explicitly state whether it is within the ice-strengthened area." ;
                            sh:minCount 1 ;
                            sh:path nltl:withinIceStrengthenedArea ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F03/weld1> ;
                    sh:resultMessage "Node ex:weld1 must conform to one or more shapes in <urn:nltl:generated-shape:I2-066-InScopeWeldShape> , <urn:nltl:generated-shape:I2-066-OutOfScopeWeldShape>" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-066-WeldShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F03/weld1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-066-WeldShape>. See details for more information." ;
            sh:resultPath nltl:hasWeld ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-066-WeldShape> ;
                    sh:path nltl:hasWeld ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F03/weld1> ] .

