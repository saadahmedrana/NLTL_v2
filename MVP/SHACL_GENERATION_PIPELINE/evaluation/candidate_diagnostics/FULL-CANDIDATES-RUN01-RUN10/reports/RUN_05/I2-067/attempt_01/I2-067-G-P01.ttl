@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-P01/ship> ;
            sh:resultMessage "The ship must record that continuity of strength is ensured at its structural connections." ;
            sh:resultPath nltl:strengthContinuityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb78de9ee7ef648a0bb821da6cdea364bb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-P01/ship> ;
            sh:resultMessage "The ship must record that continuity of strength is ensured at its structural connections." ;
            sh:resultPath nltl:strengthContinuityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb78de9ee7ef648a0bb821da6cdea364bb1 ] .

_:nb78de9ee7ef648a0bb821da6cdea364bb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record that continuity of strength is ensured at its structural connections." ;
    sh:minCount 1 ;
    sh:path nltl:strengthContinuityStatus .

