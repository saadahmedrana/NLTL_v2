@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-P03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:polarShipCategoryA ; sh:path nltl:shipCategory ] ] , [ sh:property [ sh:hasValue nltl:iceConditionLessSevereThanCategoryAAndB ; sh:path nltl:designIceCondition ] ] , [ sh:property [ sh:hasValue nltl:polarShipCategoryB ; sh:message Literal(\"A ship designed for at least thin first-year ice must be category B unless it is category A.\") ; sh:path nltl:shipCategory ], [ sh:in ( nltl:thinFirstYearIceWithPossibleOldIceInclusions nltl:mediumFirstYearIceWithPossibleOldIceInclusions ) ; sh:path nltl:designIceCondition ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-002-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-P03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-P03/ship> ;
            sh:resultMessage "A ship must declare one design ice condition." ;
            sh:resultPath nltl:designIceCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceConditionValue ;
                    sh:maxCount 1 ;
                    sh:message "A ship must declare one design ice condition." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:or ( [ sh:hasValue nltl:iceConditionLessSevereThanCategoryAAndB ] [ sh:in ( nltl:thinFirstYearIceWithPossibleOldIceInclusions nltl:mediumFirstYearIceWithPossibleOldIceInclusions ) ] ) ;
                    sh:path nltl:designIceCondition ] ;
            sh:value nltl:openWaterIceCondition ] .

