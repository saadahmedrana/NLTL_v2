@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F01/ship> ;
            sh:resultMessage "When the ice-origin, winter-growth, and thickness conditions apply, ice type classification must be first-year ice." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the ice-origin, winter-growth, and thickness conditions apply, ice type classification must be first-year ice." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceOriginType nltl:seaIceOrigin ;
                    nltl:winterGrowthCount ?growth ;
                    nltl:iceThickness ?thicknessNode .
                ?thicknessNode qudt:numericValue ?thicknessValue ;
                    qudt:unit unit:M .
                FILTER (
                    ?growth <= 1 &&
                    ?thicknessValue >= 0.3 &&
                    ?thicknessValue <= 2.0
                )
                FILTER NOT EXISTS {
                    $this nltl:iceTypeClassification nltl:firstYearIce .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlg:IMO_004_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F01/ship> ;
            sh:resultMessage "An applicable ship must not have an ice type classification other than first-year ice." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "An applicable ship must not have an ice type classification other than first-year ice." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceOriginType nltl:seaIceOrigin ;
                    nltl:winterGrowthCount ?growth ;
                    nltl:iceThickness ?thicknessNode ;
                    nltl:iceTypeClassification ?classification .
                ?thicknessNode qudt:numericValue ?thicknessValue ;
                    qudt:unit unit:M .
                FILTER (
                    ?growth <= 1 &&
                    ?thicknessValue >= 0.3 &&
                    ?thicknessValue <= 2.0
                )
                FILTER (?classification != nltl:firstYearIce)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlg:IMO_004_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F01/ship> ] .

