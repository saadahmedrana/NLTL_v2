@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F01/ship> ;
            sh:resultMessage "For bergy waters, land-origin ice concentration must be less than 1 and total ice concentration must be no greater than 1." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For bergy waters, land-origin ice concentration must be less than 1 and total ice concentration must be no greater than 1." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceCondition ?condition .
                FILTER (STR(?condition) = "bergy waters")
                FILTER NOT EXISTS {
                    $this nltl:landOriginIceConcentration ?landQuantity .
                    ?landQuantity a qudt:QuantityValue ;
                        qudt:numericValue ?landValue ;
                        qudt:unit unit:UNITLESS .
                    FILTER (datatype(?landValue) = xsd:decimal)
                    FILTER (?landValue < 1)
                    $this nltl:totalIceConcentration ?totalQuantity .
                    ?totalQuantity a qudt:QuantityValue ;
                        qudt:numericValue ?totalValue ;
                        qudt:unit unit:UNITLESS .
                    FILTER (datatype(?totalValue) = xsd:decimal)
                    FILTER (?totalValue <= 1)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_009_BergyWatersShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F01/ship> ] .

