@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-013-F03/ship> ;
            sh:resultMessage "The low-air-temperature classification must be true when the lowest MDLT is below -10 degrees Celsius and false otherwise." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-013-ShipLowAirTemperature> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-013-F03/ship> ] .

