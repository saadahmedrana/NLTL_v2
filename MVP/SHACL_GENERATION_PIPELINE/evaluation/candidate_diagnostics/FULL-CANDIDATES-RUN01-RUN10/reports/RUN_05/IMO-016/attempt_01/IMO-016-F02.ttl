@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ;
            sh:resultMessage "The ship must state the language used for the Polar Ship Certificate." ;
            sh:resultPath nltl:certificateLanguage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must state the language used for the Polar Ship Certificate." ;
                    sh:minCount 1 ;
                    sh:path nltl:certificateLanguage ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/certificate> ;
                    sh:resultMessage "The Polar Ship Certificate must use the Appendix I certificate form model." ;
                    sh:resultPath nltl:certificateFormModel ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:certificateFormModelValue ;
                            sh:hasValue nltl:appendixIPolarShipCertificateModel ;
                            sh:message "The Polar Ship Certificate must use the Appendix I certificate form model." ;
                            sh:minCount 1 ;
                            sh:path nltl:certificateFormModel ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ;
            sh:resultMessage "The ship must have a Polar Ship Certificate corresponding to the Appendix I model." ;
            sh:resultPath nltl:hasPolarShipCertificate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must have a Polar Ship Certificate corresponding to the Appendix I model." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO_016_CertificateShape ;
                    sh:path nltl:hasPolarShipCertificate ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/certificate> ] .

