@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/ship> ;
            sh:resultMessage "Polar Ship Certificate dates and endorsements shall match the corresponding SOLAS certificate schedule dates." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Polar Ship Certificate dates and endorsements shall match the corresponding SOLAS certificate schedule dates." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    $this nltl:polarCertificateValidityDates ?d .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule/
                              nltl:hasCertificateScheduleDateRecord ?r .
                        ?r nltl:certificateScheduleDate ?d ;
                           nltl:certificateScheduleDateType nltl:validityDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:surveyDates ?d .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule/
                              nltl:hasCertificateScheduleDateRecord ?r .
                        ?r nltl:certificateScheduleDate ?d ;
                           nltl:certificateScheduleDateType nltl:surveyDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:endorsementDates ?d .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule/
                              nltl:hasCertificateScheduleDateRecord ?r .
                        ?r nltl:certificateScheduleDate ?d ;
                           nltl:certificateScheduleDateType nltl:endorsementDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule/
                          nltl:hasCertificateScheduleDateRecord ?r .
                    ?r nltl:certificateScheduleDate ?d ;
                       nltl:certificateScheduleDateType nltl:validityDateCategory .
                    FILTER NOT EXISTS {
                        $this nltl:polarCertificateValidityDates ?d .
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule/
                          nltl:hasCertificateScheduleDateRecord ?r .
                    ?r nltl:certificateScheduleDate ?d ;
                       nltl:certificateScheduleDateType nltl:surveyDateCategory .
                    FILTER NOT EXISTS {
                        $this nltl:surveyDates ?d .
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule/
                          nltl:hasCertificateScheduleDateRecord ?r .
                    ?r nltl:certificateScheduleDate ?d ;
                       nltl:certificateScheduleDateType nltl:endorsementDateCategory .
                    FILTER NOT EXISTS {
                        $this nltl:endorsementDates ?d .
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO017ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/ship> ] .

