@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-029-F02/ship> ;
            sh:resultMessage "The ship must record that the PWOM includes procedures for encounters exceeding its design capabilities or limitations." ;
            sh:resultPath nltl:exceedanceResponseProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb2dbf3f9dbcf444289536e32ced74b24b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-029-F02/ship> ;
            sh:resultMessage "The ship must record that the PWOM includes procedures for encounters exceeding its design capabilities or limitations." ;
            sh:resultPath nltl:exceedanceResponseProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb2dbf3f9dbcf444289536e32ced74b24b1 ] .

_:nb2dbf3f9dbcf444289536e32ced74b24b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship must record that the PWOM includes procedures for encounters exceeding its design capabilities or limitations." ;
    sh:minCount 1 ;
    sh:path nltl:exceedanceResponseProcedurePresent .

