@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"iceOperationApplicable must be recorded as false when the conditional PWOM requirements do not apply.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceOperationApplicable ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The PWOM must include applicable escort or icebreaker-assistance requirements.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:escortRequirementsPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The PWOM must include ice-operation monitoring and safety procedures.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceSafetyMonitoringProcedurePresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"iceOperationApplicable must be recorded as true to select the applicable ice-operation PWOM requirements.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceOperationApplicable ], [ sh:datatype xsd:string ; sh:message Literal(\"The PWOM must specify limitations for escorted operation.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:escortedOperationLimits ], [ sh:datatype xsd:string ; sh:message Literal(\"The PWOM must specify limitations for independent operation.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:independentOperationLimits ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO_030_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F04/ship> ] .

