@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F02/ship> ;
            sh:resultMessage "Approval must reference an Organization-acceptable standard or an equivalent-safety standard." ;
            sh:resultPath nltl:approvalStandard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "standard acceptable to the Organization"^^xsd:string "another standard offering an equivalent level of safety"^^xsd:string ) ;
                    sh:message "Approval must reference an Organization-acceptable standard or an equivalent-safety standard." ;
                    sh:minCount 1 ;
                    sh:path nltl:approvalStandard ] ;
            sh:value "uncontrolled internal standard"^^xsd:string ] .

