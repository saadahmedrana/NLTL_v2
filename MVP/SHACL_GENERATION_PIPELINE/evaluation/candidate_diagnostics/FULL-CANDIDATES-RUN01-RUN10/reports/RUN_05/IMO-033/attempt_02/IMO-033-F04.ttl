@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F04/ship> ;
            sh:resultMessage "For likely ice accretion, discontinuous surface projected area must equal continuous surface projected area multiplied by 1.05, and discontinuous surface static moment must equal continuous surface static moment multiplied by 1.10 within the permitted numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For likely ice accretion, discontinuous surface projected area must equal continuous surface projected area multiplied by 1.05, and discontinuous surface static moment must equal continuous surface static moment multiplied by 1.10 within the permitted numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely ?app ;
                      nltl:continuousSurfaceProjectedArea ?continuousArea ;
                      nltl:discontinuousSurfaceProjectedArea ?discontinuousArea ;
                      nltl:continuousSurfaceStaticMoment ?continuousMoment ;
                      nltl:discontinuousSurfaceStaticMoment ?discontinuousMoment .

                ?continuousArea qudt:numericValue ?ca .
                ?discontinuousArea qudt:numericValue ?da .
                ?continuousMoment qudt:numericValue ?cm .
                ?discontinuousMoment qudt:numericValue ?dm .

                FILTER (?app = true)
                FILTER (
                    ?da < ((?ca * 1.05) - ((?ca * 1.05) * 0.000001 + 0.000000001)) ||
                    ?da > ((?ca * 1.05) + ((?ca * 1.05) * 0.000001 + 0.000000001)) ||
                    ?dm < ((?cm * 1.10) - ((?cm * 1.10) * 0.000001 + 0.000000001)) ||
                    ?dm > ((?cm * 1.10) + ((?cm * 1.10) * 0.000001 + 0.000000001))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-033> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F04/ship> ] .

