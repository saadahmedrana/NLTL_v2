@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F05/ship> ;
            sh:resultMessage "The stability calculation icing allowance values must match the PWOM." ;
            sh:resultPath nltl:stabilityCalculationIcingAllowanceValues ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n9336727740eb4b39a38046d36f9b0d23b5 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F05/ship> ;
            sh:resultMessage "The stability calculation icing allowance values must match the PWOM." ;
            sh:resultPath nltl:stabilityCalculationIcingAllowanceValues ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
            sh:sourceShape _:n9336727740eb4b39a38046d36f9b0d23b5 ;
            sh:value "deck=30 kg/m2; side=7.5 kg/m2"^^xsd:string ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F05/ship> ;
            sh:resultMessage "The icing allowance values in the PWOM must match the stability calculation." ;
            sh:resultPath nltl:polarWaterOperationalManualIcingAllowanceValues ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:equals nltl:stabilityCalculationIcingAllowanceValues ;
                    sh:message "The icing allowance values in the PWOM must match the stability calculation." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarWaterOperationalManualIcingAllowanceValues ] ;
            sh:value "deck=30 kg/m2; side=7.5 kg/m2"^^xsd:string ] .

_:n9336727740eb4b39a38046d36f9b0d23b5 sh:datatype xsd:string ;
    sh:equals nltl:polarWaterOperationalManualIcingAllowanceValues ;
    sh:message "The stability calculation icing allowance values must match the PWOM." ;
    sh:minCount 1 ;
    sh:path nltl:stabilityCalculationIcingAllowanceValues .

