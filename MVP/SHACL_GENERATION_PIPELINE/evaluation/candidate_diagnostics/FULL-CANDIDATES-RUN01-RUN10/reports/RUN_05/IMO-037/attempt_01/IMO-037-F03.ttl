@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F03/ship> ;
            sh:resultMessage "A single canonical ship category is required." ;
            sh:resultPath nltl:shipCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype nltl:polarShipCategoryValue ;
                    sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB nltl:polarShipCategoryC ) ;
                    sh:maxCount 1 ;
                    sh:message "A single canonical ship category is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:shipCategory ] ;
            sh:value nltl:polarShipCategoryA ] .

