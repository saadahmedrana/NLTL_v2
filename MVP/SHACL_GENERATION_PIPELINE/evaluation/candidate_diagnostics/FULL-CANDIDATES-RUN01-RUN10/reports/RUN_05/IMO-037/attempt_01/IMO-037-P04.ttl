@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-P04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:sparql [ sh:message Literal("The ship is not in category A or B constructed on or after 1 January 2017.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:shipCategory ?category ;
          nltl:constructionDate ?date .
    FILTER (
        ?category NOT IN (
            nltl:polarShipCategoryA,
            nltl:polarShipCategoryB
        )
        || ?date < "2017-01-01"^^xsd:date
    )
}
") ] ] , [ sh:property [ sh:node [ sh:class nltl:loadingConditionCase ; sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The alternative-instrument residual stability status must be compliant.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:alternativeInstrumentResidualStabilityStatus ] ; sh:sparql [ sh:message Literal("An applicable alternative instrument must have a compliant residual-stability outcome.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this
WHERE {
    $this nltl:alternativeInstrumentApplicable ?applicable .
    FILTER (?applicable != true)
}
") ] ] [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The externally calculated residual stability factor must equal one and use the unitless quantity representation.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:residualStabilityFactorSI ] ; sh:sparql [ sh:message Literal("A non-alternative loading condition must provide the residual stability factor.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this
WHERE {
    $this nltl:alternativeInstrumentApplicable ?applicable .
    FILTER (?applicable = true)
}
") ] ] ) ; sh:property [ sh:class nltl:evidenceArtifact ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasLoadingConditionResultEvidence ], [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Each loading-condition result must state whether the permitted alternative instrument applies.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:alternativeInstrumentApplicable ], [ sh:datatype xsd:string ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:loadingConditionIdentifier ] ] ; sh:path nltl:hasLoadingConditionCase ] ; sh:sparql [ sh:message Literal("The ship does not satisfy the category and construction-date applicability condition.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:shipCategory ?category ;
          nltl:constructionDate ?date .
    FILTER (
        !(
            ?category IN (
                nltl:polarShipCategoryA,
                nltl:polarShipCategoryB
            )
            && ?date >= "2017-01-01"^^xsd:date
        )
    )
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_037_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-P04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-P04/ship> ;
            sh:resultMessage "A single canonical ship category is required." ;
            sh:resultPath nltl:shipCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype nltl:polarShipCategoryValue ;
                    sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB nltl:polarShipCategoryC ) ;
                    sh:maxCount 1 ;
                    sh:message "A single canonical ship category is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:shipCategory ] ;
            sh:value nltl:polarShipCategoryC ] .

