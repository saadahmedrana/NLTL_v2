@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-041-F01/ship> ;
            sh:resultMessage "If an opening or door is hydraulically operated, hydraulic-fluid freezing or excessive-viscosity control must be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "If an opening or door is hydraulically operated, hydraulic-fluid freezing or excessive-viscosity control must be present." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:openingActuationType ?actuation .
                FILTER (STR(?actuation) = "hydraulic")
                FILTER NOT EXISTS {
                    $this nltl:hydraulicFluidFreezingOrViscosityControlPresent ?control .
                    FILTER (?control = "true"^^xsd:boolean)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_041_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-041-F01/ship> ] .

