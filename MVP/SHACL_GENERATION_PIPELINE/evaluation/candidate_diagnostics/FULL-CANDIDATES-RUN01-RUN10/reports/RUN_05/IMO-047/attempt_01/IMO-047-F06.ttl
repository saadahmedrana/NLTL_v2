@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F06/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:path nltl:hasEssentialEngine ] ] , [ sh:property [ sh:class nltl:essentialEngine ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasEssentialEngine ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Combustion air temperature control must be present and true for essential engines.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:combustionAirTemperatureControlPresent ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Combustion air temperature must be recorded as a single degree-Celsius quantity.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:combustionAirTemperature ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The manufacturer's maximum combustion-air temperature must be recorded as a single degree-Celsius quantity.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:manufacturerMaxAirTemperature ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The manufacturer's minimum combustion-air temperature must be recorded as a single degree-Celsius quantity.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:manufacturerMinAirTemperature ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("Combustion air temperature must be within the engine manufacturer's minimum and maximum criteria.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:combustionAirTemperature ?temperatureNode ;
        nltl:manufacturerMinAirTemperature ?minimumNode ;
        nltl:manufacturerMaxAirTemperature ?maximumNode .
  ?temperatureNode qudt:numericValue ?temperature ;
                   qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
  ?minimumNode qudt:numericValue ?minimum ;
               qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
  ?maximumNode qudt:numericValue ?maximum ;
               qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
  FILTER (?temperature < ?minimum || ?temperature > ?maximum)
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_047_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F06/ship> ] .

