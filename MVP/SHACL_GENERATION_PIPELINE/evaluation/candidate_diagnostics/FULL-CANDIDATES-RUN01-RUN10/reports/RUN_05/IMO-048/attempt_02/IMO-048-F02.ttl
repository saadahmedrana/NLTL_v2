@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F02/ship> ;
            sh:resultMessage "When an exposed machinery or foundation material exists, approval evidence, an accepted authority and standard, approved status, and the polar service temperature basis must be recorded." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When an exposed machinery or foundation material exists, approval evidence, an accepted authority and standard, approved status, and the polar service temperature basis must be recorded." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER EXISTS {
                    $this nltl:exposedMachineryOrFoundationMaterial ?material .
                }
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasEvidence ?evidence .
                        ?evidence a nltl:evidenceArtifact ;
                                  a nltl:approvalEvidence .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:approvingAuthority ?authority .
                        FILTER (
                            ?authority = "Administration"^^xsd:string ||
                            ?authority = "recognized organization accepted by the Administration"^^xsd:string
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:approvalStandard ?standard .
                        FILTER (
                            ?standard = "standard acceptable to the Organization"^^xsd:string ||
                            ?standard = "another standard offering an equivalent level of safety"^^xsd:string
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:materialApprovalStatus nltl:evidenceStateApproved .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:polarServiceTemperature ?temperature .
                        ?temperature qudt:numericValue ?value ;
                                     qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
                        FILTER (datatype(?value) = xsd:decimal)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_048_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F02/ship> ] .

