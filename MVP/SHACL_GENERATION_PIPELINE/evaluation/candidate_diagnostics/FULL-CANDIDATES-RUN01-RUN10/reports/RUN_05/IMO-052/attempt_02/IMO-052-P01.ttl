@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-P01/access1> ;
                    sh:resultMessage "Each required access item must be associated with at least one ice or snow removal or prevention means." ;
                    sh:resultPath ( [ sh:inversePath nltl:hasRequiredAccessItem ] nltl:hasEquipmentItem nltl:hasIceOrSnowRemovalOrPreventionMeans ) ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:iceSnowRemovalOrPreventionMeans ;
                            sh:message "Each required access item must be associated with at least one ice or snow removal or prevention means." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path ( [ sh:inversePath nltl:hasRequiredAccessItem ] nltl:hasEquipmentItem nltl:hasIceOrSnowRemovalOrPreventionMeans ) ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-P01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:class nltl:iceSnowRemovalOrPreventionMeans ; sh:message Literal(\"Each required access item must be associated with at least one ice or snow removal or prevention means.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path ( [ sh:inversePath nltl:hasRequiredAccessItem ] nltl:hasEquipmentItem nltl:hasIceOrSnowRemovalOrPreventionMeans ) ] ]. See details for more information." ;
            sh:resultPath nltl:hasRequiredAccessItem ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:requiredAccessItem ;
                    sh:node [ sh:property [ sh:class nltl:iceSnowRemovalOrPreventionMeans ;
                                    sh:message "Each required access item must be associated with at least one ice or snow removal or prevention means." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path ( [ sh:inversePath nltl:hasRequiredAccessItem ] nltl:hasEquipmentItem nltl:hasIceOrSnowRemovalOrPreventionMeans ) ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasRequiredAccessItem ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-P01/access1> ] .

