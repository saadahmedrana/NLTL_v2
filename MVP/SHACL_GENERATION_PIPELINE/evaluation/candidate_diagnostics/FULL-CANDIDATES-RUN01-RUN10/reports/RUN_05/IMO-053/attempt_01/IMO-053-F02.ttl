@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-F02/ship> ;
            sh:resultMessage "The extinguishing medium must be approved as suitable for the intended operation." ;
            sh:resultPath nltl:intendedOperationCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n8ecd9cbe64ff4c86b5957b56bf619720b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-F02/ship> ;
            sh:resultMessage "The extinguishing medium must be approved as suitable for the intended operation." ;
            sh:resultPath nltl:intendedOperationCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n8ecd9cbe64ff4c86b5957b56bf619720b2 ] .

_:n8ecd9cbe64ff4c86b5957b56bf619720b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The extinguishing medium must be approved as suitable for the intended operation." ;
    sh:minCount 1 ;
    sh:path nltl:intendedOperationCompatibilityStatus .

