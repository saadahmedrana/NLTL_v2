@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F03/outfit1Store> ;
                            sh:resultMessage "Each firefighter outfit storage location must have the warm storage temperature class." ;
                            sh:resultPath nltl:storageTemperatureClass ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:class nltl:storageTemperatureClassValue ;
                                    sh:hasValue nltl:warmStorageLocation ;
                                    sh:message "Each firefighter outfit storage location must have the warm storage temperature class." ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:storageTemperatureClass ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F03/outfit1> ;
                    sh:resultMessage "Each firefighter outfit must have a storage location classified as warm." ;
                    sh:resultPath nltl:hasStorageLocation ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:physicalStorageLocation ;
                            sh:message "Each firefighter outfit must have a storage location classified as warm." ;
                            sh:node [ sh:property [ sh:class nltl:storageTemperatureClassValue ;
                                            sh:hasValue nltl:warmStorageLocation ;
                                            sh:message "Each firefighter outfit storage location must have the warm storage temperature class." ;
                                            sh:nodeKind sh:IRI ;
                                            sh:path nltl:storageTemperatureClass ] ] ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:hasStorageLocation ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F03/outfit1Store> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F03/ship> ;
            sh:resultMessage "Each linked firefighter outfit must also be an equipment item." ;
            sh:resultPath nltl:hasFirefighterOutfit ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked firefighter outfit must also be an equipment item." ;
                    sh:node [ sh:class nltl:equipmentItem,
                                nltl:firefighterOutfitItem ;
                            sh:property [ sh:class nltl:physicalStorageLocation ;
                                    sh:message "Each firefighter outfit must have a storage location classified as warm." ;
                                    sh:node [ sh:property [ sh:class nltl:storageTemperatureClassValue ;
                                                    sh:hasValue nltl:warmStorageLocation ;
                                                    sh:message "Each firefighter outfit storage location must have the warm storage temperature class." ;
                                                    sh:nodeKind sh:IRI ;
                                                    sh:path nltl:storageTemperatureClass ] ] ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:hasStorageLocation ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasFirefighterOutfit ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F03/outfit1> ] .

