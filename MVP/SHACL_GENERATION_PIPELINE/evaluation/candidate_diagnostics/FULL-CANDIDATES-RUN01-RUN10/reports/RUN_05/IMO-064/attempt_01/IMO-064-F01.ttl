@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F01/ship> ;
            sh:resultMessage "Thermal-protection equipment shall be assigned for all persons on board." ;
            sh:resultPath nltl:assignedThermalProtection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:message "Thermal-protection equipment shall be assigned for all persons on board." ;
                    sh:minCount 1 ;
                    sh:path nltl:assignedThermalProtection ] ] .

