            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n8845f04c813643df97796ea0c7e7eb35b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F06/ship> ;
            sh:resultMessage "Assigned thermal protection shall have approved adequacy evidence." ;
            sh:resultPath nltl:thermalProtectionApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n8845f04c813643df97796ea0c7e7eb35b3 ] .

_:n8845f04c813643df97796ea0c7e7eb35b3 sh:class nltl:evidenceState ;
