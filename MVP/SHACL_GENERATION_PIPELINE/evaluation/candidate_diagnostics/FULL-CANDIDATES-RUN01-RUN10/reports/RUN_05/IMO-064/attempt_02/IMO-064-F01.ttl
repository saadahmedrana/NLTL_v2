@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F01/ship> ;
            sh:resultMessage "Approved thermal-protection adequacy evidence must be tied to the ship's intended voyage, anticipated cold and wind, immersion potential, person-on-board count, and assigned thermal protection." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Approved thermal-protection adequacy evidence must be tied to the ship's intended voyage, anticipated cold and wind, immersion potential, person-on-board count, and assigned thermal protection." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this a nltl:ship .
                FILTER NOT EXISTS {
                    $this nltl:personOnBoard ?persons ;
                          nltl:assignedThermalProtection true ;
                          nltl:intendedVoyage ?voyage ;
                          nltl:anticipatedCold ?cold ;
                          nltl:anticipatedWind ?wind ;
                          nltl:immersionPotential ?immersion ;
                          nltl:thermalProtectionApprovalStatus nltl:evidenceStateApproved .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO-064-StaticShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F01/ship> ;
            sh:resultMessage "Assigned thermal protection must be recorded as provided." ;
            sh:resultPath nltl:assignedThermalProtection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "Assigned thermal protection must be recorded as provided." ;
                    sh:minCount 1 ;
                    sh:path nltl:assignedThermalProtection ] ] .

