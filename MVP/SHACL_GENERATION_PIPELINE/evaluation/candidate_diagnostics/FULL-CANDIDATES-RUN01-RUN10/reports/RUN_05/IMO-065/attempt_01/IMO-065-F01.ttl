@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F01/ship> ;
            sh:resultMessage "Survival support duration must be at least the maximum expected rescue time." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Survival support duration must be at least the maximum expected rescue time." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:survivalSupportDuration ?durationNode .
                $this nltl:maximumExpectedRescueTime ?maximumNode .
                ?durationNode qudt:numericValue ?duration .
                ?maximumNode qudt:numericValue ?maximum .
                FILTER (?duration < ?maximum)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO065SurvivalResourcesShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F01/ship> ] .

