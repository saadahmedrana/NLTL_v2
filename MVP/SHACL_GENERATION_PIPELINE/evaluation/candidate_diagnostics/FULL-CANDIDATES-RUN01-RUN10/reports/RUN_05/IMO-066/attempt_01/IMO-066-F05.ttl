@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to exactly one shape in gen:IMO066_ApplicableShape , gen:IMO066_NotApplicableShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:XoneConstraintComponent ;
            sh:sourceShape gen:IMO066_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F05/ship> ] .

