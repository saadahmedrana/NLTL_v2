@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-069-F01/ship> ;
            sh:resultMessage "When an added life-saving device requires power, its power source must be independent of the ship's main source of power." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When an added life-saving device requires power, its power source must be independent of the ship's main source of power." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:addedLifeSavingDeviceRequiresPower true .
                FILTER NOT EXISTS {
                    $this nltl:devicePowerSourceIndependentOfMainPower true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-069> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-069-F01/ship> ] .

