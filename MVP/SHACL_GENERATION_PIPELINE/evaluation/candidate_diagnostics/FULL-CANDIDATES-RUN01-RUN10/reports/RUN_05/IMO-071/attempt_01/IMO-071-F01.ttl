@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:immersionSuitTypeValue ; sh:hasValue nltl:insulatedImmersionSuit ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Where immersion suits are required, the ship must specify the insulated immersion suit type.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:immersionSuitTypeClassification ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:immersionSuitRequired ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:immersionSuitRequired ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-071-ImmersionSuit> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F01/ship> ] .

