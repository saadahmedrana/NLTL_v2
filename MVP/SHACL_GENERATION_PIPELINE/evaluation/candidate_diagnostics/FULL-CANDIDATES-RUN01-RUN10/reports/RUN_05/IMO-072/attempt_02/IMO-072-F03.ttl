@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in nltlgen:IMO072ExtendedDarknessTrueBranch , nltlgen:IMO072ExtendedDarknessFalseBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:IMO072ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F03/ship> ] .

