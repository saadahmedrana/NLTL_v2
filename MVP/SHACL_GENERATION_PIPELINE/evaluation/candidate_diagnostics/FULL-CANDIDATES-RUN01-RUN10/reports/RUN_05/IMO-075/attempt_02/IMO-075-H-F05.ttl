@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F05/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("personalOrGroupSurvivalEquipmentRequired must be false when the survival-equipment rule is not applicable.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:personalOrGroupSurvivalEquipmentRequired ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Survival equipment must be stored in an easily accessible location.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:storageAccessibilityStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("personalOrGroupSurvivalEquipmentRequired must be recorded as true when the survival-equipment rule is applicable.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:personalOrGroupSurvivalEquipmentRequired ], [ sh:datatype xsd:integer ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Available survival equipment capacity is required when personal or group survival equipment is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:availableSurvivalEquipmentCapacity ], [ sh:datatype xsd:integer ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The number of persons on board is required to determine survival-equipment capacity.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:personsOnBoard ] ; sh:sparql [ sh:message Literal("Available survival equipment capacity must be at least 110% of the persons on board, rounded up to the next integer.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:personsOnBoard ?persons ;
                              nltl:availableSurvivalEquipmentCapacity ?capacity .
                        FILTER (?capacity * 10 < ?persons * 11)
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_075_SurvivalEquipmentCapacityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F05/ship> ] .

