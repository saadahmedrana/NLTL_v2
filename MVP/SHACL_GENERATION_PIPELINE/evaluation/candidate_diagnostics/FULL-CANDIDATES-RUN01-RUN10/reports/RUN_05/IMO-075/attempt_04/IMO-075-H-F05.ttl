@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class qudt:QuantityValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When survival equipment is required, its storage distance to the muster or embarkation station must be provided in metres.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:storageDistanceToMusterOrEmbarkation ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Required survival equipment must be recorded as stored in an easily accessible location.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:storageAccessibilityStatus ], [ sh:datatype xsd:integer ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When survival equipment is required, available survival equipment capacity must be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:availableSurvivalEquipmentCapacity ], [ sh:datatype xsd:integer ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When survival equipment is required, persons on board must be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:personsOnBoard ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:personalOrGroupSurvivalEquipmentRequired ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:personalOrGroupSurvivalEquipmentRequired ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-075> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F05/ship> ] .

