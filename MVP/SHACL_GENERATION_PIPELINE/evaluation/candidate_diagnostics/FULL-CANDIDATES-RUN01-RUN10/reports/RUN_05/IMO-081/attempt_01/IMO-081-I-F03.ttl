@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:IMO_081_NonApplicableByDate , gen:IMO_081_NonApplicableByIceStatus , gen:IMO_081_Applicable" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_081_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:shipIceStrengthened" ;
            sh:resultPath nltl:shipIceStrengthened ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:shipIceStrengthened ] ] .

