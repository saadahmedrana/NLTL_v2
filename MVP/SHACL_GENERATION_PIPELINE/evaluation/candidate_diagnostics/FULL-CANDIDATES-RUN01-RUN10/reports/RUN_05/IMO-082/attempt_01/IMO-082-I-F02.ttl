@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F02/ship> ;
            sh:resultMessage "Where the bridge configuration requires an astern view, the clear astern view status shall be compliant." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Where the bridge configuration requires an astern view, the clear astern view status shall be compliant." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bridgeConfigurationType
                    nltl:asternViewRequiredBridgeConfiguration .
                FILTER NOT EXISTS {
                    $this nltl:clearViewAsternStatus ?status .
                    FILTER (?status = true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_082_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F02/ship> ] .

