@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading1> ;
                    sh:resultMessage "The independent heading means relation shall identify another distinct non-magnetic heading means belonging to the same ship." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:ne60780b6eaba426f90e1fd0f3dbd7fcdb5 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:IMO086HeadingMeansShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading1> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading1> ;
                    sh:resultMessage "Each non-magnetic heading means shall be connected to emergency power." ;
                    sh:resultPath nltl:connectedToEmergencyPower ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:ne60780b6eaba426f90e1fd0f3dbd7fcdb3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic heading means, each meeting the required power and independence constraints." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:ne60780b6eaba426f90e1fd0f3dbd7fcdb1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading1> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading2> ;
                    sh:resultMessage "The independent heading means relation shall identify another distinct non-magnetic heading means belonging to the same ship." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:ne60780b6eaba426f90e1fd0f3dbd7fcdb5 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:IMO086HeadingMeansShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading2> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading2> ;
                    sh:resultMessage "Each non-magnetic heading means shall be connected to emergency power." ;
                    sh:resultPath nltl:connectedToEmergencyPower ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:ne60780b6eaba426f90e1fd0f3dbd7fcdb3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic heading means, each meeting the required power and independence constraints." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:ne60780b6eaba426f90e1fd0f3dbd7fcdb1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading2> ] .

_:ne60780b6eaba426f90e1fd0f3dbd7fcdb1 sh:class nltl:nonMagneticHeadingMeans ;
    sh:message "The ship shall have at least two non-magnetic heading means, each meeting the required power and independence constraints." ;
    sh:minCount 2 ;
    sh:node gen:IMO086HeadingMeansShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasNonMagneticHeadingMeans .

_:ne60780b6eaba426f90e1fd0f3dbd7fcdb3 sh:class nltl:benchmarkEntity ;
    sh:message "Each non-magnetic heading means shall be connected to emergency power." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:connectedToEmergencyPower .

_:ne60780b6eaba426f90e1fd0f3dbd7fcdb5 sh:message "The independent heading means relation shall identify another distinct non-magnetic heading means belonging to the same ship." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                ?ship nltl:hasNonMagneticHeadingMeans $this .
                ?ship nltl:hasNonMagneticHeadingMeans ?other .
                $this nltl:independentFromHeadingMeans ?other .
                FILTER (?other != $this)
            }
        """ .

