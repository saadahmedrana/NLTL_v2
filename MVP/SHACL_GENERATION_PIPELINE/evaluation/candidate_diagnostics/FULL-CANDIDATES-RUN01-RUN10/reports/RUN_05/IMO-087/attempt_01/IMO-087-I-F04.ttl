@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F04/ship> ;
            sh:resultMessage "Latitude must be recorded; ships proceeding over 80 degrees require at least one GNSS compass or equivalent connected to both main and emergency power." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-087-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F04/ship> ] .

