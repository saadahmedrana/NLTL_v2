@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-F05/ship> ;
            sh:resultMessage "When the ship is involved in an icebreaker escort operation, it must have a manually initiated flashing red stopped light visible from astern, with a visibility range of at least two nautical miles and compliant stern-light arcs." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the ship is involved in an icebreaker escort operation, it must have a manually initiated flashing red stopped light visible from astern, with a visibility range of at least two nautical miles and compliant stern-light arcs." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    FILTER EXISTS {
        $this nltl:icebreakerEscortOperation true .
    }
    FILTER NOT EXISTS {
        $this nltl:manuallyInitiatedFlashingRedStoppedLightPresent true ;
              nltl:lightVisibleFromAstern true ;
              nltl:visibilityRange ?quantity ;
              nltl:colregSternLightArcComplianceStatus true .

        ?quantity a qudt:QuantityValue ;
                  qudt:numericValue ?value ;
                  qudt:unit unit:MI_N .

        FILTER (
            datatype(?value) = xsd:decimal &&
            ?value >= 2
        )
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_089_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-F05/ship> ] .

