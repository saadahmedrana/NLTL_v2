@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-092-J-F02/ship> ;
            sh:resultMessage "Telemedical assistance communication equipment shall be provided." ;
            sh:resultPath nltl:telemedicalAssistanceCommunicationEquipmentPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ne1919e6e3fa1413a93f9435036cf76ceb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-092-J-F02/ship> ;
            sh:resultMessage "Telemedical assistance communication equipment shall be provided." ;
            sh:resultPath nltl:telemedicalAssistanceCommunicationEquipmentPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ne1919e6e3fa1413a93f9435036cf76ceb1 ] .

_:ne1919e6e3fa1413a93f9435036cf76ceb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Telemedical assistance communication equipment shall be provided." ;
    sh:minCount 1 ;
    sh:path nltl:telemedicalAssistanceCommunicationEquipmentPresent .

