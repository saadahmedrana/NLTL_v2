@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F04/ship> ;
            sh:resultMessage "The ship shall support aircraft voice communication on 121.5 MHz." ;
            sh:resultPath nltl:supportedAircraftVoiceFrequency ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall support aircraft voice communication on 121.5 MHz." ;
                    sh:path nltl:supportedAircraftVoiceFrequency ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:property [ sh:hasValue qudt:MegaHZ ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxInclusive 121.5 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 121.5 ;
                                    sh:path qudt:numericValue ] ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F04/ship> ;
            sh:resultMessage "The ship shall support aircraft voice communication on 123.1 MHz." ;
            sh:resultPath nltl:supportedAircraftVoiceFrequency ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall support aircraft voice communication on 123.1 MHz." ;
                    sh:path nltl:supportedAircraftVoiceFrequency ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:property [ sh:hasValue qudt:MegaHZ ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxInclusive 123.1 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 123.1 ;
                                    sh:path qudt:numericValue ] ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F04/ship> ;
            sh:resultMessage "The ship shall provide voice or data communications with relevant rescue coordination centres." ;
            sh:resultPath nltl:rescueCoordinationCentreVoiceOrData ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n5896ec432d504b0c81871be6979fce0bb2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F04/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath nltl:searchAndRescueCommunicationCapability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n5896ec432d504b0c81871be6979fce0bb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F04/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath nltl:searchAndRescueCommunicationCapability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n5896ec432d504b0c81871be6979fce0bb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F04/ship> ;
            sh:resultMessage "The ship shall provide voice or data communications with relevant rescue coordination centres." ;
            sh:resultPath nltl:rescueCoordinationCentreVoiceOrData ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n5896ec432d504b0c81871be6979fce0bb2 ] .

_:n5896ec432d504b0c81871be6979fce0bb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship shall declare search and rescue communication capability." ;
    sh:minCount 1 ;
    sh:path nltl:searchAndRescueCommunicationCapability .

_:n5896ec432d504b0c81871be6979fce0bb2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship shall provide voice or data communications with relevant rescue coordination centres." ;
    sh:minCount 1 ;
    sh:path nltl:rescueCoordinationCentreVoiceOrData .

