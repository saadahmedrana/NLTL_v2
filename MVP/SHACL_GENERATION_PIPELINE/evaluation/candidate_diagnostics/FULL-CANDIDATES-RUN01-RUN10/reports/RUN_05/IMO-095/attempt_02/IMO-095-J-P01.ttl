@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-P01/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath nltl:searchAndRescueCommunicationCapability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:na7b258b65b5a4287a5405c5c27b0c53db1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-P01/ship> ;
            sh:resultMessage "Supported aircraft voice frequencies shall include both 121.5 MHz and 123.1 MHz." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Supported aircraft voice frequencies shall include both 121.5 MHz and 123.1 MHz." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this
            WHERE {
                $this nltl:supportedAircraftVoiceFrequency ?frequency121 .
                ?frequency121 qudt:numericValue ?value121 .
                ?frequency121 qudt:unit unit:MegaHZ .
                FILTER (?value121 >= 121.5 && ?value121 <= 121.5)

                $this nltl:supportedAircraftVoiceFrequency ?frequency123 .
                ?frequency123 qudt:numericValue ?value123 .
                ?frequency123 qudt:unit unit:MegaHZ .
                FILTER (?value123 >= 123.1 && ?value123 <= 123.1)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-095> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-P01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-P01/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath nltl:searchAndRescueCommunicationCapability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:na7b258b65b5a4287a5405c5c27b0c53db1 ] .

_:na7b258b65b5a4287a5405c5c27b0c53db1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall declare search and rescue communication capability." ;
    sh:minCount 1 ;
    sh:path nltl:searchAndRescueCommunicationCapability .

