@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-P03/ship> ;
            sh:resultMessage "The voyage plan must address every identified intended-voyage hazard." ;
            sh:resultPath nltl:voyagePlanHazardCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb1d25b9e66404e79a3eaa3c93f908fb1b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-P03/ship> ;
            sh:resultMessage "The voyage plan must address every identified intended-voyage hazard." ;
            sh:resultPath nltl:voyagePlanHazardCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb1d25b9e66404e79a3eaa3c93f908fb1b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-P03/ship> ;
            sh:resultMessage "The intended-voyage hazard register must identify at least one hazard." ;
            sh:resultPath nltl:identifiedIntendedVoyageHazard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The intended-voyage hazard register must identify at least one hazard." ;
                    sh:minCount 1 ;
                    sh:path nltl:identifiedIntendedVoyageHazard ] ] .

_:nb1d25b9e66404e79a3eaa3c93f908fb1b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The voyage plan must address every identified intended-voyage hazard." ;
    sh:minCount 1 ;
    sh:path nltl:voyagePlanHazardCoverage .

