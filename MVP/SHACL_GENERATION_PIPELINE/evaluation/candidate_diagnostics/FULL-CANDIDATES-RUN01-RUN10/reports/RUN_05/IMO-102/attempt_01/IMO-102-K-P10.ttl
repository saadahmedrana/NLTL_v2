@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/ship> ;
            sh:resultMessage "Each applicable crew member must have a shared polar training record linked by both crew-training paths, with a matching required and recorded training level and a valid STCW qualification." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each applicable crew member must have a shared polar training record linked by both crew-training paths, with a matching required and recorded training level and a valid STCW qualification." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType ;
                      nltl:hasCrewMemberInventory ?crew .

                ?crew nltl:polarTrainingCrewRoleClassification ?role .

                FILTER (
                    (
                        ?ice = nltl:openWaterIceCondition &&
                        (
                            ?shipType = nltl:tankerPolarTrainingShipType ||
                            ?shipType = nltl:passengerShipPolarTrainingShipType
                        ) &&
                        (
                            ?role = nltl:masterPolarTrainingRole ||
                            ?role = nltl:chiefMatePolarTrainingRole ||
                            ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
                        )
                    )
                    ||
                    (
                        ?ice = nltl:otherWatersIceCondition &&
                        (
                            ?role = nltl:masterPolarTrainingRole ||
                            ?role = nltl:chiefMatePolarTrainingRole
                        )
                    )
                    ||
                    (
                        ?ice = nltl:otherWatersIceCondition &&
                        ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
                    )
                )

                FILTER NOT EXISTS {
                    ?crew nltl:hasCrewTrainingRecord ?record ;
                          nltl:hasPolarTrainingRecord ?record .

                    ?record nltl:requiredTrainingLevel ?requiredLevel ;
                            nltl:trainingRecordLevel ?recordLevel ;
                            nltl:stcwQualificationValid true .

                    FILTER (
                        ?requiredLevel = ?recordLevel &&
                        (
                            (
                                ?ice = nltl:openWaterIceCondition &&
                                (
                                    ?shipType = nltl:tankerPolarTrainingShipType ||
                                    ?shipType = nltl:passengerShipPolarTrainingShipType
                                ) &&
                                ?requiredLevel = nltl:basicPolarTrainingLevel
                            )
                            ||
                            (
                                ?ice = nltl:otherWatersIceCondition &&
                                (
                                    ?role = nltl:masterPolarTrainingRole ||
                                    ?role = nltl:chiefMatePolarTrainingRole
                                ) &&
                                ?requiredLevel = nltl:advancedPolarTrainingLevel
                            )
                            ||
                            (
                                ?ice = nltl:otherWatersIceCondition &&
                                ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole &&
                                ?requiredLevel = nltl:basicPolarTrainingLevel
                            )
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO102ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/trainingRecord> ;
                            sh:resultMessage "A polar training record must state exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n5a57cdb421a640a38e0c259590c79d5eb17 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:IMO102TrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasCrewTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:polarTrainingRecord ;
                            sh:node gen:IMO102TrainingRecordShape ;
                            sh:path nltl:hasCrewTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/trainingRecord> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/trainingRecord> ;
                            sh:resultMessage "A polar training record must state exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n5a57cdb421a640a38e0c259590c79d5eb17 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:IMO102TrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasPolarTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:polarTrainingRecord ;
                            sh:node gen:IMO102TrainingRecordShape ;
                            sh:path nltl:hasPolarTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/trainingRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO102CrewMemberShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:crewMember ;
                    sh:node gen:IMO102CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/crew> ] .

_:N0635e53fd7c243b8947bf09708bfeab6 rdf:first nltl:polarTrainingNotApplicable ;
    rdf:rest () .

_:Nd14d757611f0468e86d6ecc46aed21b5 rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest ( nltl:advancedPolarTrainingLevel nltl:polarTrainingNotApplicable ) .

_:n5a57cdb421a640a38e0c259590c79d5eb17 sh:in _:Nd14d757611f0468e86d6ecc46aed21b5 ;
    sh:maxCount 1 ;
    sh:message "A polar training record must state exactly one controlled required training level." ;
    sh:minCount 1 ;
    sh:path nltl:requiredTrainingLevel .

