@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-F03/ship> ;
            sh:resultMessage "If the ship operates in polar waters, the Oil Record Book, manuals, and applicable oil or marine pollution emergency plan shall include polar-operation coverage." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-107> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-F03/ship> ] .

