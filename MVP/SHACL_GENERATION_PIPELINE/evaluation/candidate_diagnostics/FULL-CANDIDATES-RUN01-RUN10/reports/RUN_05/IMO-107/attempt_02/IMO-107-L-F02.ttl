@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-F02/ship> ;
            sh:resultMessage "When the ship operates in polar waters, polar-operation coverage must be recorded in the Oil Record Book, manuals, the applicable pollution emergency plan, and the declared polar-operation coverage indicator." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the ship operates in polar waters, polar-operation coverage must be recorded in the Oil Record Book, manuals, the applicable pollution emergency plan, and the declared polar-operation coverage indicator." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters ?applicability .
                FILTER (?applicability = "true"^^xsd:boolean)
                FILTER (
                    NOT EXISTS {
                        $this nltl:oilRecordBookPolarCoverage ?oilCoverage .
                        FILTER (?oilCoverage = "true"^^xsd:boolean)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:manualPolarCoverage ?manualCoverage .
                        FILTER (?manualCoverage = "true"^^xsd:boolean)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:pollutionEmergencyPlanPolarCoverage ?planCoverage .
                        FILTER (?planCoverage = "true"^^xsd:boolean)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:polarOperationCoverage ?operationCoverage .
                        FILTER (?operationCoverage = "true"^^xsd:boolean)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO107PolarOperationCoverageShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-F02/ship> ] .

