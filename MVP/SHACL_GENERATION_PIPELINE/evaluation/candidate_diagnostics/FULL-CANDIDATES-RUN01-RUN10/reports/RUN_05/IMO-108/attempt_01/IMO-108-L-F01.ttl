@prefix n: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in n:IMO108ApplicableShape , n:IMO108NonApplicableCategoryShape , n:IMO108NonApplicableDateShape , n:IMO108NonApplicableAggregateCapacityShape , n:IMO108NonApplicableIndividualCapacityShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape n:IMO108Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-F01/ship> ] .

