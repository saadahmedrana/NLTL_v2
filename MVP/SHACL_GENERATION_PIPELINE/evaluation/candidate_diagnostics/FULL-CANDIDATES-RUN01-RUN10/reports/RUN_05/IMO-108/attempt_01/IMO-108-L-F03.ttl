@prefix n: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-F03/ship> ;
            sh:resultMessage "A single aggregate oil fuel capacity in cubic metres is required." ;
            sh:resultPath nltl:aggregateOilFuelCapacity ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A single aggregate oil fuel capacity in cubic metres is required." ;
                    sh:minCount 1 ;
                    sh:node n:AggregateOilFuelCapacityShape ;
                    sh:path nltl:aggregateOilFuelCapacity ] ] .

