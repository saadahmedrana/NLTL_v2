@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-110-L-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Applicable ships shall have compliant double-bottom protection for the entire cargo tank length.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:entireCargoTankLengthDoubleBottomProtectionStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Applicable ships shall have compliant wing-tank protection.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:wingTankProtectionStatus ], [ sh:hasValue Literal("oil_tanker", datatype=xsd:string) ; sh:path nltl:shipType ], [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ; sh:path nltl:shipCategory ], [ sh:minInclusive Literal("2017-01-01", datatype=xsd:date) ; sh:path nltl:constructionDate ], [ sh:node [ sh:property [ sh:maxExclusive Literal("5000", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:deadweight ] ] , [ sh:sparql [ sh:message Literal("The protection obligations apply only when the ship is Category A or B, an oil tanker, below 5,000 tonnes deadweight, and constructed on or after 1 January 2017.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:shipCategory ?category ;
                              nltl:shipType ?shipType ;
                              nltl:constructionDate ?constructionDate ;
                              nltl:deadweight ?deadweightNode .
                        ?deadweightNode qudt:numericValue ?deadweightValue ;
                                         qudt:unit unit:TON_Metric .
                        FILTER (
                            ?category NOT IN (
                                nltl:polarShipCategoryA,
                                nltl:polarShipCategoryB
                            )
                            || ?shipType != "oil_tanker"^^xsd:string
                            || ?deadweightValue >= "5000"^^xsd:decimal
                            || ?constructionDate < "2017-01-01"^^xsd:date
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO110Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-110-L-F01/ship> ] .

