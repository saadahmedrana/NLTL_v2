@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-110-L-P04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:entireCargoTankLengthDoubleBottomProtectionStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:wingTankProtectionStatus ], [ sh:hasValue Literal("oil_tanker", datatype=xsd:string) ; sh:path nltl:shipType ], [ sh:hasValue nltl:oilTanker ; sh:path rdf:type ], [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ; sh:path nltl:shipCategory ] ] , [ sh:sparql [ sh:message Literal("The ship is not an applicable category A or B oil tanker constructed on or after 1 January 2017 with deadweight below 5,000 tonnes.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    FILTER NOT EXISTS {
        $this nltl:shipCategory ?category ;
              rdf:type nltl:oilTanker ;
              nltl:shipType "oil_tanker"^^xsd:string ;
              nltl:constructionDate ?date ;
              nltl:deadweight ?deadweight .
        ?deadweight qudt:numericValue ?value ;
                    qudt:unit unit:TON_Metric .
        FILTER (
            ?category IN (
                nltl:polarShipCategoryA,
                nltl:polarShipCategoryB
            )
            && ?date >= "2017-01-01"^^xsd:date
            && ?value < "5000"^^xsd:decimal
        )
    }
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_110> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-110-L-P04/ship> ] .

