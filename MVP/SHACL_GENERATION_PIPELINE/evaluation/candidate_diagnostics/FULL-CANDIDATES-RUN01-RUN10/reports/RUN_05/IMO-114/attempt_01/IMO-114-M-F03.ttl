@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-F03/ship> ;
            sh:resultMessage "For an applicable Category A or B ship constructed on or after 2017-01-01 carrying NLS requiring a type 3 tank in a type 3 cargo tank, Administration approval and the applicable certificate polar-operation entry are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an applicable Category A or B ship constructed on or after 2017-01-01 carrying NLS requiring a type 3 tank in a type 3 cargo tank, Administration approval and the applicable certificate polar-operation entry are required." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?constructionDate ;
                      nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ?requiresType3 ;
                      nltl:cargoTankType ?cargoTankType .

                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )
                FILTER (
                    ?constructionDate >= "2017-01-01"^^xsd:date
                )
                FILTER (?requiresType3 = true)
                FILTER (?cargoTankType = "3"^^xsd:string)

                FILTER (
                    NOT EXISTS {
                        $this nltl:administrationCarriageApprovalStatus
                              nltl:evidenceStateApproved
                    }
                    ||
                    EXISTS {
                        $this nltl:administrationCarriageApprovalStatus ?status .
                        FILTER (?status != nltl:evidenceStateApproved)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:applicableCertificatePolarOperationEntryPresent true
                    }
                    ||
                    EXISTS {
                        $this nltl:applicableCertificatePolarOperationEntryPresent ?entry .
                        FILTER (?entry != true)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_114_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-F03/ship> ] .

