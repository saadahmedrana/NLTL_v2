@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F02/ship> ;
            sh:resultMessage "The ship must satisfy the applicable category or passenger-ship condition and the sewage-discharge rule." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO118Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F02/ship> ] .

