@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-P03/ship> ;
            sh:resultMessage "The ship must satisfy the applicable category or passenger-ship condition and the sewage-discharge rule." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO118Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-P03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-P03/ship> ;
            sh:resultMessage "A ship subject to the rule must have a construction date on or after 2017-01-01." ;
            sh:resultPath nltl:constructionDate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:date ;
                    sh:maxCount 1 ;
                    sh:message "A ship subject to the rule must have a construction date on or after 2017-01-01." ;
                    sh:minCount 1 ;
                    sh:minInclusive "2017-01-01"^^xsd:date ;
                    sh:path nltl:constructionDate ] ;
            sh:value "2016-12-31"^^xsd:date ] .

