@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F08/distanceRecord> ;
                    sh:resultMessage "Less than 1 values on ex:distanceRecord->nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth" ;
                    sh:resultPath nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MI_N> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F08/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-123-DischargeDistanceRecord>. See details for more information." ;
            sh:resultPath nltl:hasDischargeDistanceRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-123-DischargeDistanceRecord> ;
                    sh:path nltl:hasDischargeDistanceRecord ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F08/distanceRecord> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F08/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in <urn:nltl:generated-shape:IMO-123-ApplicableDischarge> , <urn:nltl:generated-shape:IMO-123-NoDischarge>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-123-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F08/ship> ] .

