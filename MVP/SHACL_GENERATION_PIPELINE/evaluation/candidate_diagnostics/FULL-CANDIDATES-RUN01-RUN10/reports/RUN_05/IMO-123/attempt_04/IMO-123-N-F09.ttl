@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F09/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:IMO123ApplicableShape , gen:IMO123NotResidueApplicableShape , gen:IMO123NotEnRouteShape , gen:IMO123HarmfulShape , gen:IMO123NotArcticPortsShape , gen:IMO123OutsideArcticRouteShape , gen:IMO123ReceptionFacilitiesShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO123DischargeShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F09/ship> ] .

