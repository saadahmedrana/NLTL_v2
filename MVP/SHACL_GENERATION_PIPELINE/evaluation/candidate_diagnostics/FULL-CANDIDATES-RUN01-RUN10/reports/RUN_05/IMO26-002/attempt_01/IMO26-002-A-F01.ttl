@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/ship> ;
            sh:resultMessage "Chapter 9-1 applicability must equal the applicable ship-type, dimension, gross-tonnage, and trade-status conditions." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Chapter 9-1 applicability must equal the applicable ship-type, dimension, gross-tonnage, and trade-status conditions." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qv: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipType ?shipType ;
                      nltl:lengthOverall ?lengthQuantity ;
                      nltl:grossTonnage ?tonnageQuantity ;
                      nltl:engagedInTrade ?engagedInTrade ;
                      nltl:polarCodeChapter9Dash1Applicable ?actual .

                ?lengthQuantity qv:numericValue ?lengthValue .
                ?tonnageQuantity qv:numericValue ?tonnageValue .

                BIND(
                    IF(
                        (
                            ?shipType = "fishing_vessel"
                            && ?lengthValue >= 24
                        )
                        ||
                        (
                            ?shipType = "pleasure_yacht"
                            && ?tonnageValue >= 300
                            && ?engagedInTrade = false
                        )
                        ||
                        (
                            ?shipType = "cargo_ship"
                            && ?tonnageValue >= 300
                            && ?tonnageValue < 500
                        ),
                        true,
                        false
                    )
                    AS ?expected
                )

                FILTER(?actual != ?expected)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:Chapter9Dash1ApplicabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/ship> ] .

