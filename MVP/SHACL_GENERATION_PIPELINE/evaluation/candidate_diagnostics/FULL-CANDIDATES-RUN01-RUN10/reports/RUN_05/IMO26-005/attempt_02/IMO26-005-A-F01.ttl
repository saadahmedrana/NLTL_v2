@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-F01/ship> ;
            sh:resultMessage "When heading-reference or position-fixing systems are represented, the ship must provide an intended area and an Approved suitability status for those systems." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When heading-reference or position-fixing systems are represented, the ship must provide an intended area and an Approved suitability status for those systems." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:headingOrPositionSystem ?system .
                FILTER (
                    NOT EXISTS {
                        $this nltl:intendedArea ?area .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:intendedAreaSuitabilityApprovalStatus nltl:evidenceStateApproved .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO26_005_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-F01/ship> ;
            sh:resultMessage "Any intended-area suitability approval status must be Approved." ;
            sh:resultPath nltl:intendedAreaSuitabilityApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceState ;
                    sh:in ( nltl:evidenceStateApproved ) ;
                    sh:message "Any intended-area suitability approval status must be Approved." ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:intendedAreaSuitabilityApprovalStatus ] ;
            sh:value nltl:evidenceStateRejected ] .

