@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P01/ship> ;
            sh:resultMessage "When heading-reference or position-fixing systems are represented, the ship must provide an intended area and an Approved suitability status for those systems." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When heading-reference or position-fixing systems are represented, the ship must provide an intended area and an Approved suitability status for those systems." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:headingOrPositionSystem ?system .
                FILTER (
                    NOT EXISTS {
                        $this nltl:intendedArea ?area .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:intendedAreaSuitabilityApprovalStatus nltl:evidenceStateApproved .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO26_005_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P01/ship> ] .

