@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-009-A-F03/ship> ;
            sh:resultMessage "iceAccretionLikely must be explicitly true or false; when true, every required navigation or communication antenna must have ice accumulation prevention." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO26_009_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-009-A-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-009-A-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:iceAccretionLikely" ;
            sh:resultPath nltl:iceAccretionLikely ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:iceAccretionLikely ] ] .

