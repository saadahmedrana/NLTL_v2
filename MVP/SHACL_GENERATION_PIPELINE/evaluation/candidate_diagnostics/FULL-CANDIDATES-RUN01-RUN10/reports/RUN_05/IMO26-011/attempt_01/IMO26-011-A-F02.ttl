@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-011-A-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:IMO26_011_CategoryC_Branch , gen:IMO26_011_CategoryAB_Before2026_Branch , gen:IMO26_011_CategoryAB_From2026_Branch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO26_011_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-011-A-F02/ship> ] .

