@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-013-A-F03/ship> ;
            sh:resultMessage "For ships proceeding to latitudes over 80 degrees, at least one GNSS compass or equivalent must be connected to both main and emergency power." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ships proceeding to latitudes over 80 degrees, at least one GNSS compass or equivalent must be connected to both main and emergency power." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:plannedOrActualLatitude ?latitudeNode .
                ?latitudeNode qudt:numericValue ?latitude .
                FILTER (?latitude > 80)
                FILTER (
                    NOT EXISTS {
                        $this nltl:gnssCompassOrEquivalentCount ?count .
                        FILTER (datatype(?count) = xsd:integer && ?count >= 1)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:connectedToMainPower ?mainPowerConnection .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:connectedToEmergencyPower ?emergencyPowerConnection .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO26_013_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-013-A-F03/ship> ] .

