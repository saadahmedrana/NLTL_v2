@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-014-A-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to exactly one shape in [ sh:property [ sh:datatype xsd:integer ; sh:message Literal(\"A ship not operating solely in continuous daylight shall have at least two means of illumination to aid visual detection of ice.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:visualIceDetectionIlluminationMeansCount ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:operatesOnlyInContinuousDaylight ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:operatesOnlyInContinuousDaylight ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:XoneConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-014> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-014-A-F01/ship> ] .

