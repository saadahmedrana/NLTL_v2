@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-017-B-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:message Literal("The Polar Code chapter 11-1 applicability state must be recorded as false for this non-applicable branch.") ; sh:path nltl:polarCodeChapter11Dash1Applicable ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:message Literal("The Polar Code chapter 11-1 applicability state must be recorded as true for this applicable branch.") ; sh:path nltl:polarCodeChapter11Dash1Applicable ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:message Literal("When chapter 11-1 applies, a voyage plan must be present.") ; sh:path nltl:voyagePlanPresent ], [ sh:datatype xsd:boolean ; sh:message Literal("Voyage-plan coverage values must be boolean.") ; sh:path nltl:voyagePlanCoverage ], [ sh:datatype xsd:string ; sh:message Literal("Each recorded intended voyage hazard must be a string.") ; sh:path nltl:intendedVoyageHazard ] ; sh:sparql [ sh:message Literal("When chapter 11-1 applies, every recorded intended voyage hazard must have voyage-plan coverage set to true.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:intendedVoyageHazard ?hazard .
                        FILTER NOT EXISTS {
                            $this nltl:voyagePlanCoverage true
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO26_017_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-017-B-F03/ship> ] .

