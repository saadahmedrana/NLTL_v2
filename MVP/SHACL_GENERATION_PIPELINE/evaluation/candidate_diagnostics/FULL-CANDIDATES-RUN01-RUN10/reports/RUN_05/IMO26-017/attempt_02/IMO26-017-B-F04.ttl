@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-017-B-F04/ship> ;
            sh:resultMessage "When Chapter 11-1 is applicable, a voyage plan must be present and cover every intended voyage hazard; contradictory applicability states are not permitted." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO26_017_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-017-B-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-017-B-F04/ship> ;
            sh:resultMessage "The Chapter 11-1 applicability state must be present as one boolean value." ;
            sh:resultPath nltl:polarCodeChapter11Dash1Applicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The Chapter 11-1 applicability state must be present as one boolean value." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarCodeChapter11Dash1Applicable ] ] .

