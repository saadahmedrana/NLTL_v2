@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-018-B-F02/ship> ;
            sh:resultMessage "If no safety management system is implemented, a documented procedure for operation in polar waters shall be present.",
                "When chapter 11-1 is applicable, the route planning record shall cover all nine clause 11-1.3 topics." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO26_018_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-018-B-F02/ship> ] .

