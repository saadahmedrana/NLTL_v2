@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-002-F02/ship> ;
            sh:resultMessage "The 2017 ice-class regulation edition must not be asserted for ships contracted outside the 2019-01-01 inclusive to 2021-07-05 exclusive interval." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The 2017 ice-class regulation edition must not be asserted for ships contracted outside the 2019-01-01 inclusive to 2021-07-05 exclusive interval." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    ?date < "2019-01-01"^^xsd:date ||
                    ?date >= "2021-07-05"^^xsd:date
                )
                $this nltl:applicableIceClassRegulationEdition
                    nltl:iceClassRegulationEdition2017 .
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-002> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-002-F02/ship> ] .

