@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:maxInclusive Literal(\"1986-10-31\", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ] , [ sh:property [ sh:datatype xsd:date ; sh:minInclusive Literal(\"2003-09-01\", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ] , [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:ownerRequested2008EngineOutputRequirements ], [ sh:hasValue nltl:iceClassRegulationEdition2008 ; sh:message Literal(\"When the owner requests the 2008 engine-output requirements, the engine-output edition must be 2008.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:engineOutputRegulationEdition ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:ownerRequested2008EngineOutputRequirements ], [ sh:hasValue nltl:iceClassRuleEdition1985 ; sh:message Literal(\"Without an owner request for the 2008 engine-output requirements, the engine-output edition must remain the 1985 rule edition.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:engineOutputRegulationEdition ] ] ) ; sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2003-09-01\", datatype=xsd:date) ; sh:minInclusive Literal(\"1986-11-01\", datatype=xsd:date) ; sh:path nltl:constructionStageDate ], [ sh:hasValue nltl:iceClassRuleEdition1985 ; sh:message Literal(\"Ships in the applicable construction-stage cohort must identify the 1985 ice-class rule edition.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:applicableIceClassRegulationEdition ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:message Literal(\"An applicable ship must have an ice class from the permitted controlled values.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF006_Static ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F02/ship> ] .

