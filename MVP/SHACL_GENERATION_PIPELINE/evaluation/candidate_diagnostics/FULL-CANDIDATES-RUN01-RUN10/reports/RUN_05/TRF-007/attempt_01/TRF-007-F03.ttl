@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-F03/ship> ;
            sh:resultMessage "For an IA Super or IA ship constructed before 1 September 2003, the ship must have a permitted 2017 Ice Class Regulations compliance method and delivery and assessment dates showing compliance no later than 1 January of the year twenty years after delivery." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an IA Super or IA ship constructed before 1 September 2003, the ship must have a permitted 2017 Ice Class Regulations compliance method and delivery and assessment dates showing compliance no later than 1 January of the year twenty years after delivery." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:ship .
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass = nltl:iceClassIaSuper ||
                    ?iceClass = nltl:iceClassIa
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:constructionStageDate ?missingConstructionDate
                    }
                    ||
                    (
                        EXISTS {
                            $this nltl:constructionStageDate ?constructionDate .
                            FILTER (
                                YEAR(?constructionDate) < 2003 ||
                                (
                                    YEAR(?constructionDate) = 2003 &&
                                    MONTH(?constructionDate) < 9
                                ) ||
                                (
                                    YEAR(?constructionDate) = 2003 &&
                                    MONTH(?constructionDate) = 9 &&
                                    DAY(?constructionDate) < 1
                                )
                            )
                        }
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:deliveryDate ?missingDeliveryDate
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:assessmentDate ?missingAssessmentDate
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:engineOutputComplianceMethod ?method .
                                FILTER (
                                    ?method = nltl:traficom2017Section3Point2Point2Method ||
                                    ?method = nltl:traficom2017Section3Point2Point4Method
                                )
                            }
                            ||
                            EXISTS {
                                $this nltl:deliveryDate ?deliveryDate .
                                $this nltl:assessmentDate ?assessmentDate .
                                FILTER (
                                    YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20 ||
                                    (
                                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                                        MONTH(?assessmentDate) > 1
                                    ) ||
                                    (
                                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                                        MONTH(?assessmentDate) = 1 &&
                                        DAY(?assessmentDate) > 1
                                    )
                                )
                            }
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-007_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-F03/ship> ] .

