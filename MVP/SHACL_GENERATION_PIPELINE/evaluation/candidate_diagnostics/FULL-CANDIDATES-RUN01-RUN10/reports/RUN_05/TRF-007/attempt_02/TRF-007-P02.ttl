@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P02/ship> ;
            sh:resultMessage "The conditional requirements apply to IA Super or IA ships constructed before 1 September 2003; such ships must satisfy the stated delivery-date deadline and use one permitted compliance method." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF007ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P02/ship> ] .

