@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-P03/ship> ;
            sh:resultMessage "Applicable IA or IA Super ships must use a permitted 2017 method and have delivery and assessment dates no later than 1 January of the year twenty years after delivery." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Applicable IA or IA Super ships must use a permitted 2017 method and have delivery and assessment dates no later than 1 January of the year twenty years after delivery." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:iceClass ?ice .
    FILTER (
        ?ice IN (
            nltl:iceClassIa,
            nltl:iceClassIaSuper
        )
    )

    $this nltl:constructionStageDate ?construction .
    FILTER (
        datatype(?construction) = xsd:date &&
        ?construction < "2003-09-01"^^xsd:date
    )

    OPTIONAL { $this nltl:deliveryDate ?delivery . }
    OPTIONAL { $this nltl:assessmentDate ?assessment . }
    OPTIONAL { $this nltl:engineOutputComplianceMethod ?method . }

    FILTER (
        !BOUND(?delivery) ||
        datatype(?delivery) != xsd:date ||
        !BOUND(?assessment) ||
        datatype(?assessment) != xsd:date ||
        !BOUND(?method) ||
        ?method NOT IN (
            nltl:traficom2017Section3Point2Point2Method,
            nltl:traficom2017Section3Point2Point4Method
        ) ||
        (
            datatype(?delivery) = xsd:date &&
            datatype(?assessment) = xsd:date &&
            (
                YEAR(?assessment) > YEAR(?delivery) + 20 ||
                (
                    YEAR(?assessment) = YEAR(?delivery) + 20 &&
                    (
                        MONTH(?assessment) > 1 ||
                        (
                            MONTH(?assessment) = 1 &&
                            DAY(?assessment) > 1
                        )
                    )
                )
            )
        )
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-009> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-P03/ship> ] .

