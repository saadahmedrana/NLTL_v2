@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F01/ship> ;
            sh:resultMessage "The upper ice waterline must contain, at every longitudinal position, the maximum vertical coordinate of the intended ice-operating waterlines, and both waterlines must cover the same positions." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The upper ice waterline must contain, at every longitudinal position, the maximum vertical coordinate of the intended ice-operating waterlines, and both waterlines must cover the same positions." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?this
WHERE {
  {
    SELECT ?this ?x
           (MAX(?ivn) AS ?imax)
           (MAX(?uvn) AS ?umax)
           (COUNT(DISTINCT ?ip) AS ?icount)
           (COUNT(DISTINCT ?up) AS ?ucount)
    WHERE {
      {
        ?this nltl:hasIntendedIceOperatingWaterline ?iw .
        ?iw nltl:hasWaterlineProfilePoint ?ip .
        ?ip nltl:longitudinalPosition ?ixq ;
            nltl:verticalCoordinate ?iyq .
        ?ixq qudt:numericValue ?x ;
             qudt:unit <http://qudt.org/vocab/unit/M> .
        ?iyq qudt:numericValue ?ivn ;
             qudt:unit <http://qudt.org/vocab/unit/M> .
      }
      UNION
      {
        ?this nltl:hasUpperIceWaterline ?uw .
        ?uw nltl:hasWaterlineProfilePoint ?up .
        ?up nltl:longitudinalPosition ?uxq ;
            nltl:verticalCoordinate ?uyq .
        ?uxq qudt:numericValue ?x ;
             qudt:unit <http://qudt.org/vocab/unit/M> .
        ?uyq qudt:numericValue ?uvn ;
             qudt:unit <http://qudt.org/vocab/unit/M> .
      }
    }
    GROUP BY ?this ?x
  }
  FILTER(
    ?icount = 0 ||
    ?ucount = 0 ||
    !BOUND(?imax) ||
    !BOUND(?umax) ||
    ABS(?imax - ?umax) >
      (1e-6 *
       IF(ABS(?imax) > ABS(?umax), ABS(?imax), ABS(?umax))
       + 1e-9)
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF011ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F01/ship> ] .

