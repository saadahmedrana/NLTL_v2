@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasUpperIceWaterline" ;
            sh:resultPath nltl:hasUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node g:TRF011IceWaterlineShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasUpperIceWaterline ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/ship> ;
            sh:resultMessage "The upper ice waterline must be the pointwise envelope of the highest intended ice-operating waterline points at every longitudinal position." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The upper ice waterline must be the pointwise envelope of the highest intended ice-operating waterline points at every longitudinal position." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                {
                    SELECT ?this ?x
                           (MAX(?ivn) AS ?imax)
                           (MIN(?uvn) AS ?umin)
                           (MAX(?uvn) AS ?umax)
                           (COUNT(?ivn) AS ?icount)
                           (COUNT(?uvn) AS ?ucount)
                    WHERE {
                        {
                            ?this nltl:hasIntendedIceOperatingWaterline ?iw .
                            ?iw nltl:hasWaterlineProfilePoint ?ip .
                            ?ip nltl:longitudinalPosition ?ipxq .
                            ?ipxq qudt:numericValue ?x .
                            ?ip nltl:verticalCoordinate ?ivq .
                            ?ivq qudt:numericValue ?ivn .
                            OPTIONAL {
                                ?this nltl:hasUpperIceWaterline ?uw .
                                ?uw nltl:hasWaterlineProfilePoint ?up .
                                ?up nltl:longitudinalPosition ?upxq .
                                ?upxq qudt:numericValue ?upx .
                                FILTER (?upx = ?x)
                                ?up nltl:verticalCoordinate ?uvq .
                                ?uvq qudt:numericValue ?uvn .
                            }
                        }
                        UNION
                        {
                            ?this nltl:hasUpperIceWaterline ?uw .
                            ?uw nltl:hasWaterlineProfilePoint ?up .
                            ?up nltl:longitudinalPosition ?upxq .
                            ?upxq qudt:numericValue ?x .
                            ?up nltl:verticalCoordinate ?uvq .
                            ?uvq qudt:numericValue ?uvn .
                            OPTIONAL {
                                ?this nltl:hasIntendedIceOperatingWaterline ?iw .
                                ?iw nltl:hasWaterlineProfilePoint ?ip .
                                ?ip nltl:longitudinalPosition ?ipxq .
                                ?ipxq qudt:numericValue ?ipx .
                                FILTER (?ipx = ?x)
                                ?ip nltl:verticalCoordinate ?ivq .
                                ?ivq qudt:numericValue ?ivn .
                            }
                        }
                    }
                    GROUP BY ?this ?x
                    HAVING (
                        COUNT(?ivn) = 0 ||
                        COUNT(?uvn) = 0 ||
                        ABS(?umin - ?imax) > (0.000001 * ABS(?imax) + 0.000000001) ||
                        ABS(?umax - ?imax) > (0.000001 * ABS(?imax) + 0.000000001)
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape g:TRF011ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/ship> ] .

