                        $this nltl:minimumIceClassDraughtAft ?minAft .
                        ?minAft qudt:numericValue ?minAftValue .
                        $this nltl:maximumIceClassDraughtAft ?maxAft .
                        ?maxAft qudt:numericValue ?maxAftValue .
