@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "The ice draught restriction document must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb1019f9a483745b9a9412a71bff7bcf8b40 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "The required warning triangle and ice-class draught mark conditions are not satisfied for the supplied construction, draught, docking, and assessment dates." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The required warning triangle and ice-class draught mark conditions are not satisfied for the supplied construction, draught, docking, and assessment dates." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:assessmentDate ?assessmentDate ;
                      nltl:constructionDate ?constructionDate ;
                      nltl:summerLoadLineFreshWaterDraught ?summerQuantity ;
                      nltl:upperIceWaterlineDraught ?uiwlQuantity ;
                      nltl:hasClassCertificate ?certificate .

                ?summerQuantity qudt:numericValue ?summerDraught .
                ?uiwlQuantity qudt:numericValue ?uiwlDraught .
                ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
                ?maximumQuantity qudt:numericValue ?maximumDraught .

                FILTER (
                    !(
                        (
                            ?constructionDate >= "2007-07-01"^^xsd:date &&
                            ?summerDraught <= ?uiwlDraught
                        )
                        ||
                        (
                            ?constructionDate >= "2007-07-01"^^xsd:date &&
                            ?summerDraught > ?uiwlDraught &&
                            EXISTS {
                                $this nltl:warningTrianglePresent true ;
                                      nltl:iceClassDraughtMarkPresent true ;
                                      nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity .
                                ?markQuantity qudt:numericValue ?markDraught .
                                FILTER (?markDraught = ?maximumDraught)
                            }
                        )
                        ||
                        (
                            ?constructionDate < "2007-07-01"^^xsd:date &&
                            EXISTS {
                                $this nltl:warningTrianglePresent true ;
                                      nltl:iceClassDraughtMarkPresent true ;
                                      nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity .
                                ?markQuantity qudt:numericValue ?markDraught .
                                FILTER (?markDraught = ?maximumDraught)
                            }
                        )
                        ||
                        (
                            ?constructionDate < "2007-07-01"^^xsd:date &&
                            NOT EXISTS {
                                $this nltl:warningTrianglePresent true ;
                                      nltl:iceClassDraughtMarkPresent true ;
                                      nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity .
                                ?markQuantity qudt:numericValue ?markDraught .
                                FILTER (?markDraught = ?maximumDraught)
                            } &&
                            EXISTS {
                                $this nltl:firstScheduledDryDockingDate ?dryDockingDate .
                                FILTER (?dryDockingDate > ?assessmentDate)
                            }
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-014> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "The ice draught restriction document must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb1019f9a483745b9a9412a71bff7bcf8b39 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "The ice draught restriction document must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb1019f9a483745b9a9412a71bff7bcf8b40 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "The ice draught restriction document must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb1019f9a483745b9a9412a71bff7bcf8b39 ] .

_:nb1019f9a483745b9a9412a71bff7bcf8b39 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice draught restriction document must be readily available to the master." ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

_:nb1019f9a483745b9a9412a71bff7bcf8b40 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice draught restriction document must be retained on board." ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

