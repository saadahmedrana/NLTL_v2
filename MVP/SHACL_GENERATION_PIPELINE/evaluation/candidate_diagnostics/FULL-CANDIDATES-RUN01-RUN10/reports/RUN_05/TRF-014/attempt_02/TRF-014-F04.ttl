@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:retainedOnBoard" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb14302f9c9844e7eb0202d5a7d8215f5b41 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:readilyAvailableToMaster" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb14302f9c9844e7eb0202d5a7d8215f5b42 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Node ex:ship->nltl:retainedOnBoard does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb14302f9c9844e7eb0202d5a7d8215f5b41 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Node ex:ship->nltl:readilyAvailableToMaster does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb14302f9c9844e7eb0202d5a7d8215f5b42 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "The required warning triangle and ice-class draught marking are missing or incomplete for the applicable date and draught condition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The required warning triangle and ice-class draught marking are missing or incomplete for the applicable date and draught condition." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:assessmentDate ?assessment ;
        nltl:constructionDate ?construction ;
        nltl:summerLoadLineFreshWaterDraught ?summerNode ;
        nltl:upperIceWaterlineDraught ?uiwlNode .

  ?summerNode qudt:numericValue ?summer .
  ?uiwlNode qudt:numericValue ?uiwl .

  OPTIONAL {
    $this nltl:firstScheduledDryDockingDate ?dryDocking
  }

  FILTER (
    (
      ?construction >= "2007-07-01"^^xsd:date &&
      ?summer < ?uiwl &&
      (
        NOT EXISTS {
          $this nltl:warningTrianglePresent true
        } ||
        NOT EXISTS {
          $this nltl:iceClassDraughtMarkPresent true
        } ||
        NOT EXISTS {
          $this nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
          ?markNode qudt:numericValue ?markValue
        }
      )
    )
    ||
    (
      ?construction < "2007-07-01"^^xsd:date &&
      (
        NOT EXISTS {
          $this nltl:warningTrianglePresent true
        } ||
        NOT EXISTS {
          $this nltl:iceClassDraughtMarkPresent true
        } ||
        NOT EXISTS {
          $this nltl:iceClassDraughtMarkDraughtAmidships ?preMarkNode .
          ?preMarkNode qudt:numericValue ?preMarkValue
        }
      ) &&
      (
        !BOUND(?dryDocking) ||
        ?dryDocking <= ?assessment
      ) &&
      (
        NOT EXISTS {
          $this nltl:warningTrianglePresent true
        } ||
        NOT EXISTS {
          $this nltl:iceClassDraughtMarkPresent true
        } ||
        NOT EXISTS {
          $this nltl:iceClassDraughtMarkDraughtAmidships ?dueMarkNode .
          ?dueMarkNode qudt:numericValue ?dueMarkValue
        }
      )
    )
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-014> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ] .

_:nb14302f9c9844e7eb0202d5a7d8215f5b41 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

_:nb14302f9c9844e7eb0202d5a7d8215f5b42 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

