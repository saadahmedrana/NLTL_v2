@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:navigatingInIce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:maximumPermittedIceTrim ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:operatingDraught ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:operatingTrim ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:upperIceWaterlineDraught ] ; sh:sparql [ sh:message Literal("When navigating in ice, operating draught and trim must not exceed their applicable limits.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:operatingDraught ?draught .
                        ?draught qudt:numericValue ?draughtValue .
                        $this nltl:upperIceWaterlineDraught ?waterline .
                        ?waterline qudt:numericValue ?waterlineValue .
                        $this nltl:operatingTrim ?trim .
                        ?trim qudt:numericValue ?trimValue .
                        $this nltl:maximumPermittedIceTrim ?maximumTrim .
                        ?maximumTrim qudt:numericValue ?maximumTrimValue .
                        FILTER (
                            ?draughtValue > ?waterlineValue ||
                            ?trimValue > ?maximumTrimValue
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:navigatingInIce ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF015Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F02/ship> ] .

