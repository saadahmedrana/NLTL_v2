@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-P03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:iceWaterline ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasLowerIceWaterline ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerHighestPointSubmerged ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:navigatingInIce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:draughtAmidships ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:forwardDraught ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:levelIceThickness ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:liwlDraughtAmidships ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/TON_Metric> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:displacementAtUpperIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:iceWaterline ; sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/TON_Metric> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:waterlineDisplacement ] ] ; sh:path nltl:hasUpperIceWaterline ], [ sh:node [ sh:class nltl:ballastTank ; sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A ballast tank above and needed to reach the LIWL must have freezing prevention.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:freezingPreventionPresent ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:situatedAboveLowerIceWaterline ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:usedToReachLowerIceWaterline ] ] [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:situatedAboveLowerIceWaterline ] ] [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:usedToReachLowerIceWaterline ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:situatedAboveLowerIceWaterline ], [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:usedToReachLowerIceWaterline ] ] ; sh:path nltl:hasBallastTank ] ; sh:sparql [ sh:message Literal("When navigating in ice, draught amidships must reach the LIWL and forward draught must meet the UIWL displacement and level-ice-thickness formula; the selected UIWL displacement must be the greatest linked UIWL displacement.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX q: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:draughtAmidships ?amidQ ;
                              nltl:liwlDraughtAmidships ?liwlQ ;
                              nltl:forwardDraught ?forwardQ ;
                              nltl:levelIceThickness ?iceQ ;
                              nltl:displacementAtUpperIceWaterline ?dispQ ;
                              nltl:hasUpperIceWaterline ?waterline .

                        ?amidQ q:numericValue ?amid ;
                               q:unit <http://qudt.org/vocab/unit/M> .
                        ?liwlQ q:numericValue ?liwl ;
                              q:unit <http://qudt.org/vocab/unit/M> .
                        ?forwardQ q:numericValue ?forward ;
                                 q:unit <http://qudt.org/vocab/unit/M> .
                        ?iceQ q:numericValue ?ice ;
                              q:unit <http://qudt.org/vocab/unit/M> .
                        ?dispQ q:numericValue ?disp ;
                              q:unit <http://qudt.org/vocab/unit/TON_Metric> .

                        ?waterline nltl:waterlineDisplacement ?waterlineDispQ .
                        ?waterlineDispQ q:numericValue ?waterlineDisp ;
                                        q:unit <http://qudt.org/vocab/unit/TON_Metric> .

                        FILTER (
                            ?amid < ?liwl ||
                            ?forward < IF(
                                ((2 + (0.00025 * ?disp)) * ?ice) < (4 * ?ice),
                                ((2 + (0.00025 * ?disp)) * ?ice),
                                (4 * ?ice)
                            ) ||
                            ?waterlineDisp > ?disp ||
                            NOT EXISTS {
                                $this nltl:hasUpperIceWaterline ?equalWaterline .
                                ?equalWaterline nltl:waterlineDisplacement ?equalDispQ .
                                ?equalDispQ q:numericValue ?equalDisp ;
                                             q:unit <http://qudt.org/vocab/unit/TON_Metric> .
                                FILTER (?equalDisp = ?disp)
                            }
                        )
                    }
                ") ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:navigatingInIce ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-016-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-P03/ship> ] .

