@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:navigatingInIce ] ] , [ sh:property [ sh:class nltl:iceWaterline ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasUpperIceWaterline ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerHighestPointSubmerged ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:navigatingInIce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:draughtAmidships ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:forwardDraught ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:levelIceThickness ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:liwlDraughtAmidships ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:MassQuantityShape ; sh:path nltl:displacementAtUpperIceWaterline ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:MassQuantityShape ; sh:path nltl:waterlineDisplacement ], [ sh:node gen:BallastTankShape ; sh:path nltl:hasBallastTank ] ; sh:sparql [ sh:message Literal("Draught amidships shall be at least the LIWL draught amidships.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:draughtAmidships/qudt:numericValue ?draught ;
                              nltl:liwlDraughtAmidships/qudt:numericValue ?liwl .
                        FILTER (?draught < ?liwl)
                    }
                ") ], [ sh:message Literal("Forward draught shall meet the applicable lower bound based on level ice thickness and UIWL displacement.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:forwardDraught/qudt:numericValue ?forward ;
                              nltl:levelIceThickness/qudt:numericValue ?hi ;
                              nltl:displacementAtUpperIceWaterline/qudt:numericValue ?delta .
                        BIND (
                            IF(
                                (2 + 0.00025 * ?delta) * ?hi < 4 * ?hi,
                                (2 + 0.00025 * ?delta) * ?hi,
                                4 * ?hi
                            ) AS ?expected
                        )
                        FILTER (
                            ?forward + IF(
                                ABS(?expected) * 0.000001 > 0.000000001,
                                ABS(?expected) * 0.000001,
                                0.000000001
                            ) < ?expected
                        )
                    }
                ") ], [ sh:message Literal("The displacement at the upper ice waterline shall correspond to the selected ship waterline displacement.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasUpperIceWaterline ?uiwl ;
                              nltl:waterlineDisplacement/qudt:numericValue ?selected ;
                              nltl:displacementAtUpperIceWaterline/qudt:numericValue ?actual .
                        ?uiwl a nltl:iceWaterline .
                        FILTER (
                            ?actual + IF(
                                ABS(?selected) * 0.000001 > 0.000000001,
                                ABS(?selected) * 0.000001,
                                0.000000001
                            ) < ?selected ||
                            ?actual - IF(
                                ABS(?selected) * 0.000001 > 0.000000001,
                                ABS(?selected) * 0.000001,
                                0.000000001
                            ) > ?selected
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF016Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F01/ship> ] .

