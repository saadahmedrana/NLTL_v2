@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F02/ship> ;
            sh:resultMessage "For ice class IA, IB, or IC, maximumContinuousRatingPower must be at least calculatedRequiredPower and 1000 kW; for IA Super, it must be at least calculatedRequiredPower and 2800 kW." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For ice class IA, IB, or IC, maximumContinuousRatingPower must be at least calculatedRequiredPower and 1000 kW; for IA Super, it must be at least calculatedRequiredPower and 2800 kW." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:calculatedRequiredPower ?calculatedQuantity ;
                      nltl:maximumContinuousRatingPower ?maximumQuantity .

                ?calculatedQuantity qudt:numericValue ?calculatedPower .
                ?maximumQuantity qudt:numericValue ?maximumPower .

                FILTER (
                    (
                        (?ice = nltl:iceClassIa ||
                         ?ice = nltl:iceClassIb ||
                         ?ice = nltl:iceClassIc)
                        &&
                        (?maximumPower < ?calculatedPower ||
                         ?maximumPower < "1000.0"^^xsd:decimal)
                    )
                    ||
                    (
                        ?ice = nltl:iceClassIaSuper
                        &&
                        (?maximumPower < ?calculatedPower ||
                         ?maximumPower < "2800.0"^^xsd:decimal)
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-018> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F02/ship> ] .

