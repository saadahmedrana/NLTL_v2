@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-P01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:iceWaterline ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:LengthQuantityShape ; sh:path nltl:upperIceWaterlineBreadth ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:LengthQuantityShape ; sh:path nltl:upperIceWaterlineLength ] ] ; sh:path nltl:hasUpperIceWaterline ], [ sh:class nltl:iceWaterline ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasLowerIceWaterline ], [ sh:datatype xsd:date ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:datatype xsd:integer ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerCount ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:DecimalQuantityShape ; sh:path nltl:brashIceChannelResistanceAtLowerIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:DecimalQuantityShape ; sh:path nltl:brashIceChannelResistanceAtUpperIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:LengthQuantityShape ; sh:path nltl:propellerDiameter ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:PowerQuantityShape ; sh:path nltl:maximumContinuousRatingPower ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:PowerQuantityShape ; sh:path nltl:minimumRequiredPowerAtLowerIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:PowerQuantityShape ; sh:path nltl:minimumRequiredPowerAtUpperIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:UnitlessQuantityShape ; sh:path nltl:engineOutputCoefficientKe ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:or ( [ sh:hasValue nltl:controllablePitch ] [ sh:hasValue nltl:fixedPitch ] ) ; sh:path nltl:propellerPitchControlType ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:or ( [ sh:hasValue nltl:conventionalPropulsionSystem ] [ sh:hasValue nltl:electricPropulsionMachinery ] [ sh:hasValue nltl:hydraulicPropulsionMachinery ] ) ; sh:path nltl:propulsionSystemType ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:or ( [ sh:hasValue nltl:iceClassIaSuper ] [ sh:hasValue nltl:iceClassIa ] [ sh:hasValue nltl:iceClassIb ] [ sh:hasValue nltl:iceClassIc ] [ sh:hasValue nltl:iceClassIi ] [ sh:hasValue nltl:iceClassIii ] ) ; sh:path nltl:iceClass ] ; sh:sparql [ sh:message Literal("Maximum continuous rating power is less than one of the externally calculated minimum powers.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:maximumContinuousRatingPower ?mcr .
                        ?mcr qudt:numericValue ?mcrValue .
                        $this nltl:minimumRequiredPowerAtLowerIceWaterline ?lower .
                        ?lower qudt:numericValue ?lowerValue .
                        $this nltl:minimumRequiredPowerAtUpperIceWaterline ?upper .
                        ?upper qudt:numericValue ?upperValue .
                        FILTER (
                            xsd:decimal(?mcrValue) < xsd:decimal(?lowerValue) ||
                            xsd:decimal(?mcrValue) < xsd:decimal(?upperValue)
                        )
                    }
                ") ], [ sh:message Literal("The construction date and ice class do not establish applicability of the TRF-020 engine-output rule.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:constructionStageDate ?date .
                            $this nltl:iceClass ?class .
                            FILTER (
                                YEAR(?date) > 2003 ||
                                (YEAR(?date) = 2003 && MONTH(?date) > 9) ||
                                (YEAR(?date) = 2003 && MONTH(?date) = 9 && DAY(?date) >= 1)
                            )
                            FILTER (?class IN (
                                nltl:iceClassIaSuper,
                                nltl:iceClassIa,
                                nltl:iceClassIb,
                                nltl:iceClassIc
                            ))
                        }
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:date ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:or ( [ sh:hasValue nltl:iceClassIaSuper ] [ sh:hasValue nltl:iceClassIa ] [ sh:hasValue nltl:iceClassIb ] [ sh:hasValue nltl:iceClassIc ] [ sh:hasValue nltl:iceClassIi ] [ sh:hasValue nltl:iceClassIii ] ) ; sh:path nltl:iceClass ] ; sh:sparql [ sh:message Literal("The construction date and ice class establish applicability, but the applicable engine-output inputs and externally calculated results are missing.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        FILTER EXISTS {
                            $this nltl:constructionStageDate ?date .
                            $this nltl:iceClass ?class .
                            FILTER (
                                YEAR(?date) > 2003 ||
                                (YEAR(?date) = 2003 && MONTH(?date) > 9) ||
                                (YEAR(?date) = 2003 && MONTH(?date) = 9 && DAY(?date) >= 1)
                            )
                            FILTER (?class IN (
                                nltl:iceClassIaSuper,
                                nltl:iceClassIa,
                                nltl:iceClassIb,
                                nltl:iceClassIc
                            ))
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF020Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-P01/ship> ] .

