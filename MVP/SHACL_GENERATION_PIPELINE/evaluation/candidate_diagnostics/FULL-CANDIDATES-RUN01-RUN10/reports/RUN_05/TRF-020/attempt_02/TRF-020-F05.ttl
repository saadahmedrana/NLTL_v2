@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:node gen:ApplicableTRF020 ] , [ sh:node gen:NonApplicableByDateTRF020 ] , [ sh:node gen:NonApplicableByClassTRF020 ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF020Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-F05/ship> ] .

