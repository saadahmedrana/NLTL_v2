@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P03/ship> ;
            sh:resultMessage "Maximum continuous rating power must be numeric and at least the required power under the 1985 rules." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Maximum continuous rating power must be numeric and at least the required power under the 1985 rules." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:maximumContinuousRatingPower ?maximumPower .
                ?maximumPower qudt:numericValue ?maximumValue ;
                    qudt:unit <http://qudt.org/vocab/unit/KiloW> .

                $this nltl:requiredPowerUnder1985Rules ?requiredPower .
                ?requiredPower qudt:numericValue ?requiredValue ;
                    qudt:unit <http://qudt.org/vocab/unit/KiloW> .

                FILTER (
                    !isNumeric(?maximumValue) ||
                    !isNumeric(?requiredValue) ||
                    ?maximumValue < ?requiredValue
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-023> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P03/ship> ] .

