@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F01/ship> ;
            sh:resultMessage "Maximum continuous rating power must be at least the required power under the 1985 rules." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Maximum continuous rating power must be at least the required power under the 1985 rules." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:maximumContinuousRatingPower ?maximumQuantity ;
                      nltl:requiredPowerUnder1985Rules ?requiredQuantity .
                ?maximumQuantity qudt:numericValue ?maximumPower .
                ?requiredQuantity qudt:numericValue ?requiredPower .
                FILTER (?maximumPower < ?requiredPower)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:ApplicableShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F01/ship> ] .

