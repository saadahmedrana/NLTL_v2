@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F03/ship> ;
            sh:resultMessage "Applicable ships require exactly one required power under the 1985 rules in kW." ;
            sh:resultPath nltl:requiredPowerUnder1985Rules ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Applicable ships require exactly one required power under the 1985 rules in kW." ;
                    sh:minCount 1 ;
                    sh:node gen:PowerQuantityShape ;
                    sh:path nltl:requiredPowerUnder1985Rules ] ] .

