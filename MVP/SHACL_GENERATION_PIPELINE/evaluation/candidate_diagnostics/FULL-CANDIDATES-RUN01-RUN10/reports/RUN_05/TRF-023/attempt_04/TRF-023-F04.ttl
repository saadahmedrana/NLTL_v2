@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/mcr> ;
                    sh:resultMessage "The quantity must use kW as its unit." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                            sh:maxCount 1 ;
                            sh:message "The quantity must use kW as its unit." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/ship> ;
            sh:resultMessage "Applicable ships require exactly one maximum continuous rating power in kW." ;
            sh:resultPath nltl:maximumContinuousRatingPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Applicable ships require exactly one maximum continuous rating power in kW." ;
                    sh:minCount 1 ;
                    sh:node gen:PowerQuantityShape ;
                    sh:path nltl:maximumContinuousRatingPower ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/mcr> ] .

