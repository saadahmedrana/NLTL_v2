@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in ([ sh:property [ sh:hasValue nltl:iceClassIaSuper ; sh:or ( [ sh:property [ sh:datatype xsd:date ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ] ] [ sh:property [ sh:datatype xsd:date ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:deliveryDate ] ] [ sh:property [ sh:datatype xsd:date ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:assessmentDate ] ] ) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ]) and ([ sh:property [ sh:datatype xsd:date ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:assessmentDate ], [ sh:datatype xsd:date ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:datatype xsd:date ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:deliveryDate ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ; sh:path nltl:iceClass ] ; sh:sparql [ sh:message Literal("For IA Super or IA ships constructed before 1 September 2003, the assessment date must be no later than 1 January in the year twenty years after delivery.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass .
    FILTER (?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
    $this nltl:constructionStageDate ?constructionDate .
    $this nltl:deliveryDate ?deliveryDate .
    $this nltl:assessmentDate ?assessmentDate .
    FILTER (
        datatype(?constructionDate) = xsd:date &&
        datatype(?deliveryDate) = xsd:date &&
        datatype(?assessmentDate) = xsd:date
    )
    FILTER (
        YEAR(?constructionDate) < 2003 ||
        (
            YEAR(?constructionDate) = 2003 &&
            (
                MONTH(?constructionDate) < 9 ||
                (MONTH(?constructionDate) = 9 && DAY(?constructionDate) < 1)
            )
        )
    )
    FILTER (
        YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20 ||
        (
            YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
            (
                MONTH(?assessmentDate) > 1 ||
                (MONTH(?assessmentDate) = 1 && DAY(?assessmentDate) > 1)
            )
        )
    )
}
") ] ] , [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ])""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-024-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-F03/ship> ] .

