@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-025-P02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:bulbousBowPresent ], [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"C1 must be supplied as a Newton quantity value.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF025NewtonQuantityShape ; sh:path nltl:brashIceResistanceCoefficientC1 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"C2 must be supplied as a Newton quantity value.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF025NewtonQuantityShape ; sh:path nltl:brashIceResistanceCoefficientC2 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF025CoefficientF1Shape ; sh:path nltl:coefficientF1 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF025CoefficientF2Shape ; sh:path nltl:coefficientF2 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF025CoefficientF3Shape ; sh:path nltl:coefficientF3 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF025CoefficientF4Shape ; sh:path nltl:coefficientF4 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF025CoefficientG1Shape ; sh:path nltl:coefficientG1 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF025CoefficientG2Shape ; sh:path nltl:coefficientG2 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF025CoefficientG3Shape ; sh:path nltl:coefficientG3 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF025PositiveMetreQuantityShape ; sh:path nltl:iceClassDraught ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF025PositiveMetreQuantityShape ; sh:path nltl:shipBreadth ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF025PositiveMetreQuantityShape ; sh:path nltl:shipLength ] ] , [ sh:property [ sh:in ( nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF025ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-025-P02/ship> ] .

