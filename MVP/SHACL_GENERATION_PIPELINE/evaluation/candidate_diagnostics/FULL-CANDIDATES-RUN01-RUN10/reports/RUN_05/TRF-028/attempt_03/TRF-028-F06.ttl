@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F06/rch> ;
                    sh:resultMessage "Node ex:rch->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/N>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/N> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:RchQuantityValueShape. See details for more information." ;
            sh:resultPath nltl:brashIceChannelResistanceRch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:RchQuantityValueShape ;
                    sh:path nltl:brashIceChannelResistanceRch ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F06/rch> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F06/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:engineOutputCoefficientKe" ;
            sh:resultPath nltl:engineOutputCoefficientKe ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:KeQuantityValueShape ;
                    sh:path nltl:engineOutputCoefficientKe ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F06/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasEvidence" ;
            sh:resultPath nltl:hasEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:AlternativeEvidenceShape ;
                    sh:path nltl:hasEvidence ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F06/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in ([ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:KeQuantityValueShape ; sh:path nltl:engineOutputCoefficientKe ] ] , [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:RchQuantityValueShape ; sh:path nltl:brashIceChannelResistanceRch ] ]) and ([ sh:node gen:ApprovedStatusShape ] , [ sh:node gen:RevokedStatusShape ])" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF028Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F06/ship> ] .

