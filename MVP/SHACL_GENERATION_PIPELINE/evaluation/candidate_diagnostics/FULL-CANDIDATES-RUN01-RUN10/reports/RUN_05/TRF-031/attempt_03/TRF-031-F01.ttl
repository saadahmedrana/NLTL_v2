@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/ship> ;
            sh:resultMessage "Combined bending and shear stress must be lower than the yield point." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Combined bending and shear stress must be lower than the yield point." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:combinedBendingShearStress ?combinedNode ;
                      nltl:yieldPoint ?yieldPointNode .
                ?combinedNode qudt:numericValue ?combined .
                ?yieldPointNode qudt:numericValue ?yieldPoint .
                FILTER (?combined >= ?yieldPoint)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_031_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/ship> ] .

