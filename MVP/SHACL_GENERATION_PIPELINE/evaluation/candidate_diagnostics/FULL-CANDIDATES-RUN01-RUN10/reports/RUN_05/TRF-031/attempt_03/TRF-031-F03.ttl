@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ;
            sh:resultMessage "yieldShearStress must equal yieldPoint divided by the square root of three within a relative tolerance of 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "yieldShearStress must equal yieldPoint divided by the square root of three within a relative tolerance of 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldPointNode ;
                      nltl:yieldShearStress ?yieldShearNode .
                ?yieldPointNode qudt:numericValue ?yieldPoint .
                ?yieldShearNode qudt:numericValue ?yieldShear .
                BIND ((?yieldPoint / 1.7320508075688772) AS ?expected)
                FILTER (
                    ABS(?yieldShear - ?expected) >
                    (ABS(?expected) * 0.000001 + 0.000000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_031_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ] .

