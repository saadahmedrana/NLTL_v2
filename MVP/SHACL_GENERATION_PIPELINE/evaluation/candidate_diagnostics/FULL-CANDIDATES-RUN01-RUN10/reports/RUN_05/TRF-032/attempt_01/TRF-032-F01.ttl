@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:iceStrengtheningStatus" ;
            sh:resultPath nltl:iceStrengtheningStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:iceStrengtheningStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceStrengtheningStatus ] ] , [ sh:or ( [ sh:sparql [ sh:message Literal("For a non-ice-strengthened ship, the regulation-derived scantling must not be less than the classification-society-required scantling unless the selected design scantling is the classification-society-required scantling.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:regulationRequiredScantling ?regulation ;
          nltl:classificationSocietyRequiredScantling ?classification .
    ?regulation qudt:numericValue ?regulationValue .
    ?classification qudt:numericValue ?classificationValue .
    FILTER (?regulationValue < ?classificationValue)
}
") ] ] [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:ScantlingQuantityShape ; sh:path nltl:selectedDesignScantling ] ; sh:sparql [ sh:message Literal("When the regulation-derived scantling is less than the classification-society-required scantling for a non-ice-strengthened ship, the selected design scantling must equal the classification-society-required scantling.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:regulationRequiredScantling ?regulation ;
          nltl:classificationSocietyRequiredScantling ?classification ;
          nltl:selectedDesignScantling ?selected .
    ?regulation qudt:numericValue ?regulationValue .
    ?classification qudt:numericValue ?classificationValue .
    ?selected qudt:numericValue ?selectedValue .
    FILTER (
        ?regulationValue >= ?classificationValue ||
        ?selectedValue != ?classificationValue
    )
}
") ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceStrengtheningStatus ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF032Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-F01/ship> ] .

