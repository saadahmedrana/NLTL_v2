@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-F12/ship> ;
            sh:resultMessage "The ship must provide a direct analysis case containing ice load area factor ca." ;
            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide a direct analysis case containing ice load area factor ca." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:directAnalysisCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:iceLoadAreaFactorCa ] ] ;
                    sh:path nltl:hasDirectAnalysisCase ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-F12/icePressure> ;
                    sh:resultMessage "Node ex:icePressure->qudt:unit does not contain a value in the set: ['unit:MegaPA']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue unit:MegaPA ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-F12/ship> ;
            sh:resultMessage "The ship must provide design ice pressure in MPa." ;
            sh:resultPath nltl:icePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide design ice pressure in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:MegaPA ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:icePressure ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-F12/icePressure> ] .

