@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F05/plating> ;
            sh:resultMessage "Node ex:plating must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:transverseFramingOrientation ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:platingFramingOrientation ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:DimensionlessQuantityShape ; sh:path nltl:transversePlatingFactorF1 ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:PressureQuantityShape ; sh:path nltl:platingPressure ] ] , [ sh:property [ sh:hasValue nltl:longitudinalFramingOrientation ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:platingFramingOrientation ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:DimensionlessQuantityShape ; sh:path nltl:longitudinalPlatingFactorF2 ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:PressureQuantityShape ; sh:path nltl:icePressure ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:ComplexReadinessPlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F05/plating> ] .

