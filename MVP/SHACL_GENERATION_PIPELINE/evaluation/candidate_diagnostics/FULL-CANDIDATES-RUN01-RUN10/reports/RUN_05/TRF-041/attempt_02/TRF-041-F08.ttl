@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F08/plating> ;
            sh:resultMessage "A transverse or longitudinal framing orientation is required." ;
            sh:resultPath nltl:platingFramingOrientation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:transverseFramingOrientation nltl:longitudinalFramingOrientation ) ;
                    sh:message "A transverse or longitudinal framing orientation is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:platingFramingOrientation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F08/plating> ;
            sh:resultMessage "Node ex:plating must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:transverseFramingOrientation ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:platingFramingOrientation ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:DimensionlessQuantityShape ; sh:path nltl:transversePlatingFactorF1 ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:PressureQuantityShape ; sh:path nltl:platingPressure ] ] , [ sh:property [ sh:hasValue nltl:longitudinalFramingOrientation ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:platingFramingOrientation ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:DimensionlessQuantityShape ; sh:path nltl:longitudinalPlatingFactorF2 ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:PressureQuantityShape ; sh:path nltl:icePressure ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:ComplexReadinessPlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F08/plating> ] .

