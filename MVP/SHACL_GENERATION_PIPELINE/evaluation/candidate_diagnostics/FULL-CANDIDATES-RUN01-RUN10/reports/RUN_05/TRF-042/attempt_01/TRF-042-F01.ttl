@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "longitudinalPlatingFactorF2 must follow the applicable piecewise formula using designIceLoadHeight divided by spacing, with relative tolerance max(1e-6*ABS(expected),1e-12)." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "longitudinalPlatingFactorF2 must follow the applicable piecewise formula using designIceLoadHeight divided by spacing, with relative tolerance max(1e-6*ABS(expected),1e-12)." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?hNode ;
                      nltl:spacing ?sNode ;
                      nltl:longitudinalPlatingFactorF2 ?fNode .

                ?hNode qudt:numericValue ?h ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?sNode qudt:numericValue ?s ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?fNode qudt:numericValue ?actual ;
                       qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

                BIND (?h / ?s AS ?ratio)
                BIND (IF(?ratio <= 1.0,
                         0.4 / ?ratio + 0.6,
                         1.4 - 0.4 * ?ratio) AS ?expected)
                BIND (IF(1e-6 * ABS(?expected) > 1e-12,
                         1e-6 * ABS(?expected),
                         1e-12) AS ?tolerance)

                FILTER (
                    ?ratio > 1.8 ||
                    ABS(?actual - ?expected) > ?tolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF042PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ] .

