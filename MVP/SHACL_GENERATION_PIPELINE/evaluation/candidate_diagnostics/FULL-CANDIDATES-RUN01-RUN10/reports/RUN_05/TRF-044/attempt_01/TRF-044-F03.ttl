@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F03/transverseFrame> ;
            sh:resultMessage "Frame moment factor, section modulus, and required shear area must satisfy the declared formulas within a relative tolerance of 1e-6 with an absolute fallback of 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Frame moment factor, section modulus, and required shear area must satisfy the declared formulas within a relative tolerance of 1e-6 with an absolute fallback of 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:spacing ?sNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?sNode qudt:numericValue ?s .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?m0Node qudt:numericValue ?m0 .
                ?sigmaNode qudt:numericValue ?sigma .
                ?mtNode qudt:numericValue ?mt .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                FILTER (
                    ?l != "0"^^xsd:decimal &&
                    (7 - (5 * ?h / ?l)) != "0"^^xsd:decimal
                )

                BIND ((7 * ?m0) / (7 - (5 * ?h / ?l)) AS ?expectedMt)
                BIND ((?p * ?s * ?h * ?l / (?expectedMt * ?sigma)) * 1000000 AS ?expectedZ)
                BIND ((1.7320508075688772 * 1.2 * ?p * ?h * ?s / (2 * ?sigma)) * 10000 AS ?expectedA)

                FILTER (
                    ABS(?mt - ?expectedMt) >
                    (ABS(?expectedMt) * 0.000001 + 0.000001)
                    ||
                    ABS(?z - ?expectedZ) >
                    (ABS(?expectedZ) * 0.000001 + 0.000001)
                    ||
                    ABS(?a - ?expectedA) >
                    (ABS(?expectedA) * 0.000001 + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-044> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F03/transverseFrame> ] .

