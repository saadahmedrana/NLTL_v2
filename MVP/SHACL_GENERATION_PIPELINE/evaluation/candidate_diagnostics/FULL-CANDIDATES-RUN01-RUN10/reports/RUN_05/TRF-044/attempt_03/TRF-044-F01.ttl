@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ;
            sh:resultMessage "The frame moment factor, section modulus, and required shear area must satisfy the prescribed calculations." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The frame moment factor, section modulus, and required shear area must satisfy the prescribed calculations." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:spacing ?sNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?sNode qudt:numericValue ?s .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?m0Node qudt:numericValue ?m0 .
                ?sigmaNode qudt:numericValue ?sigma .
                ?mtNode qudt:numericValue ?actualMt .
                ?zNode qudt:numericValue ?actualZ .
                ?aNode qudt:numericValue ?actualA .

                FILTER (?l != 0)
                FILTER (?sigma != 0)
                BIND (7 - 5 * ?h / ?l AS ?mtDenominator)
                FILTER (?mtDenominator != 0)
                BIND (7 * ?m0 / ?mtDenominator AS ?expectedMt)
                FILTER (?expectedMt != 0)
                BIND (?p * ?s * ?h * ?l / (?expectedMt * ?sigma) * 1000000 AS ?expectedZ)
                BIND (1.7320508075688772 * 1.2 * ?p * ?h * ?s / (2 * ?sigma) * 10000 AS ?expectedA)
                BIND (0.000001 * IF(?expectedMt >= 0, ?expectedMt, -?expectedMt) + 0.000000001 AS ?mtTolerance)
                BIND (0.000001 * IF(?expectedZ >= 0, ?expectedZ, -?expectedZ) + 0.000000001 AS ?zTolerance)
                BIND (0.000001 * IF(?expectedA >= 0, ?expectedA, -?expectedA) + 0.000000001 AS ?aTolerance)

                FILTER (?actualMt - ?expectedMt <= ?mtTolerance &&
                        ?expectedMt - ?actualMt <= ?mtTolerance)
                FILTER (?actualZ - ?expectedZ <= ?zTolerance &&
                        ?expectedZ - ?actualZ <= ?zTolerance)
                FILTER (?actualA - ?expectedA <= ?aTolerance &&
                        ?expectedA - ?actualA <= ?aTolerance)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-044> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ;
            sh:resultMessage "Node ex:transverseFrame must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:bulkCarrierTopWingTankFrameCondition ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:frameBoundaryConditionType ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"7\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"7\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:frameBoundaryConditionFactorM0 ] ] , [ sh:property [ sh:hasValue nltl:singleDeckTankTopToMainDeckFrameCondition ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:frameBoundaryConditionType ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"6\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"6\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:frameBoundaryConditionFactorM0 ] ] , [ sh:property [ sh:hasValue nltl:multiDeckOrStringerContinuousFrameCondition ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:frameBoundaryConditionType ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"5.7\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"5.7\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:frameBoundaryConditionFactorM0 ] ] , [ sh:property [ sh:hasValue nltl:twoDeckFrameCondition ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:frameBoundaryConditionType ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"5\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"5\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:frameBoundaryConditionFactorM0 ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-044> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ] .

