@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F06/transverseFrame> ;
            sh:resultMessage "The frame moment factor, section modulus, and required shear area must satisfy the prescribed calculations." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The frame moment factor, section modulus, and required shear area must satisfy the prescribed calculations." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:spacing ?sNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?sNode qudt:numericValue ?s .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?m0Node qudt:numericValue ?m0 .
                ?sigmaNode qudt:numericValue ?sigma .
                ?mtNode qudt:numericValue ?actualMt .
                ?zNode qudt:numericValue ?actualZ .
                ?aNode qudt:numericValue ?actualA .

                FILTER (?l != 0)
                FILTER (?sigma != 0)
                BIND (7 - 5 * ?h / ?l AS ?mtDenominator)
                FILTER (?mtDenominator != 0)
                BIND (7 * ?m0 / ?mtDenominator AS ?expectedMt)
                FILTER (?expectedMt != 0)
                BIND (?p * ?s * ?h * ?l / (?expectedMt * ?sigma) * 1000000 AS ?expectedZ)
                BIND (1.7320508075688772 * 1.2 * ?p * ?h * ?s / (2 * ?sigma) * 10000 AS ?expectedA)
                BIND (0.000001 * IF(?expectedMt >= 0, ?expectedMt, -?expectedMt) + 0.000000001 AS ?mtTolerance)
                BIND (0.000001 * IF(?expectedZ >= 0, ?expectedZ, -?expectedZ) + 0.000000001 AS ?zTolerance)
                BIND (0.000001 * IF(?expectedA >= 0, ?expectedA, -?expectedA) + 0.000000001 AS ?aTolerance)

                FILTER (?actualMt - ?expectedMt <= ?mtTolerance &&
                        ?expectedMt - ?actualMt <= ?mtTolerance)
                FILTER (?actualZ - ?expectedZ <= ?zTolerance &&
                        ?expectedZ - ?actualZ <= ?zTolerance)
                FILTER (?actualA - ?expectedA <= ?aTolerance &&
                        ?expectedA - ?actualA <= ?aTolerance)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-044> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F06/transverseFrame> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F06/icePressureValue> ;
                    sh:resultMessage "Node ex:icePressureValue->qudt:unit does not contain a value in the set: ['unit:MegaPA']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue unit:MegaPA ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F06/transverseFrame> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MegaPA ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:icePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:MegaPA ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:icePressure ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F06/icePressureValue> ] .

