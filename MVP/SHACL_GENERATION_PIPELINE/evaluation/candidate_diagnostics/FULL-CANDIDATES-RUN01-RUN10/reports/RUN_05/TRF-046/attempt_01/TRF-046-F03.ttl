@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/adjacentMainFrame> ;
            sh:resultMessage "The frame must identify an upper end with an eligible attached supporting structure." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n08a382ad792e4988b4879e97a3338449b2 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/upperEnd> ;
                    sh:resultMessage "The strengthened upper end must be attached to a deck structure, tank boundary plating, or ice stringer." ;
                    sh:resultPath nltl:hasAttachedSupportingStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The strengthened upper end must be attached to a deck structure, tank boundary plating, or ice stringer." ;
                            sh:minCount 1 ;
                            sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:iceStringer ] ) ] ;
                            sh:path nltl:hasAttachedSupportingStructure ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/frame> ;
            sh:resultMessage "The frame must identify an upper end with an eligible attached supporting structure." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n08a382ad792e4988b4879e97a3338449b2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/upperEnd> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/adjacentMainFrame> ;
            sh:resultMessage "The frame must identify its strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The frame must identify its strengthened part." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasStrengthenedPart ] ] .

_:N5c25c84d3eba40a9a274455c2831f00e sh:property [ sh:message "The strengthened upper end must be attached to a deck structure, tank boundary plating, or ice stringer." ;
            sh:minCount 1 ;
            sh:node [ sh:or ( [ ] [ ] [ ] ) ] ;
            sh:path nltl:hasAttachedSupportingStructure ] .

_:n08a382ad792e4988b4879e97a3338449b2 sh:message "The frame must identify an upper end with an eligible attached supporting structure." ;
    sh:minCount 1 ;
    sh:node _:N5c25c84d3eba40a9a274455c2831f00e ;
    sh:path nltl:hasUpperEnd .

