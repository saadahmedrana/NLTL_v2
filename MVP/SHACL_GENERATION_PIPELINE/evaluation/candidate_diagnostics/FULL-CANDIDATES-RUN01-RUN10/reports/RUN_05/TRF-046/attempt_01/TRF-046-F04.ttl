@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/adjacentMainFrame> ;
            sh:resultMessage "The frame must identify an upper end with an eligible attached supporting structure." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n08a382ad792e4988b4879e97a3338449b2 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/upperEnd> ;
                    sh:resultMessage "The strengthened upper end must be attached to a deck structure, tank boundary plating, or ice stringer." ;
                    sh:resultPath nltl:hasAttachedSupportingStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The strengthened upper end must be attached to a deck structure, tank boundary plating, or ice stringer." ;
                            sh:minCount 1 ;
                            sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:iceStringer ] ) ] ;
                            sh:path nltl:hasAttachedSupportingStructure ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/frame> ;
            sh:resultMessage "The frame must identify an upper end with an eligible attached supporting structure." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n08a382ad792e4988b4879e97a3338449b2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/upperEnd> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/adjacentMainFrame> ;
            sh:resultMessage "The frame must identify its strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The frame must identify its strengthened part." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasStrengthenedPart ] ] .

_:N236efd0926224ba7b1bfada3ac5861c8 rdf:first [ ] ;
    rdf:rest ( [ ] ) .

_:N2fe1cd011aaa44a19601fbe6665f43b4 sh:or ( [ ] _:N13dbfdada206498f80c84f96474fdc4d _:N946741150f0b4d269a60e3ab157089ad ) .

_:N46998d7bedda4505bb910498186ebc0c sh:property [ sh:message "The strengthened upper end must be attached to a deck structure, tank boundary plating, or ice stringer." ;
            sh:minCount 1 ;
            sh:node _:N2fe1cd011aaa44a19601fbe6665f43b4 ;
            sh:path nltl:hasAttachedSupportingStructure ] .

_:n08a382ad792e4988b4879e97a3338449b2 sh:message "The frame must identify an upper end with an eligible attached supporting structure." ;
    sh:minCount 1 ;
    sh:node _:N46998d7bedda4505bb910498186ebc0c ;
    sh:path nltl:hasUpperEnd .

