@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F04/longitudinalFrame> ;
            sh:resultMessage "f4, section modulus, and required shear area must satisfy the declared formulas within relative tolerance 1e-6 plus absolute tolerance 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "f4, section modulus, and required shear area must satisfy the declared formulas within relative tolerance 1e-6 plus absolute tolerance 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX q: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure/q:numericValue ?p ;
                      nltl:designIceLoadHeight/q:numericValue ?h ;
                      nltl:spacing/q:numericValue ?s ;
                      nltl:span/q:numericValue ?l ;
                      nltl:frameMomentFactorM/q:numericValue ?m ;
                      nltl:yieldStrength/q:numericValue ?sigma ;
                      nltl:longitudinalFrameLoadDistributionFactorF4/q:numericValue ?reportedF4 ;
                      nltl:sectionModulus/q:numericValue ?reportedZ ;
                      nltl:requiredShearArea/q:numericValue ?reportedA .

                BIND ((1 - (0.2 * ?h / ?s)) AS ?expectedF4)
                BIND ((?expectedF4 * ?p * ?h * ?l * ?l / (4 * ?m * ?sigma) * 1000000) AS ?expectedZ)
                BIND ((1.7320508075688772 * ?expectedF4 * 2.16 * ?p * ?h * ?l / (2 * ?sigma) * 10000) AS ?expectedA)

                FILTER (
                    ABS(?reportedF4 - ?expectedF4) >
                    (0.000001 * ABS(?expectedF4) + 0.000000001)
                    ||
                    ABS(?reportedZ - ?expectedZ) >
                    (0.000001 * ABS(?expectedZ) + 0.000000001)
                    ||
                    ABS(?reportedA - ?expectedA) >
                    (0.000001 * ABS(?expectedA) + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF048LongitudinalFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F04/longitudinalFrame> ] .

