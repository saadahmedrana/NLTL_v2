@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F03/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:or ( [ sh:class nltl:longitudinalFrame ; sh:property [ sh:node gs:TRF049LongitudinalAttachmentShape ; sh:path nltl:hasFrameAttachment ], [ sh:node gs:TRF049SupportingStructureShape ; sh:path nltl:hasSupportingBulkhead ], [ sh:node gs:TRF049SupportingStructureShape ; sh:path nltl:hasSupportingWebFrame ] ] [ sh:class nltl:transverseFrame ; sh:or ( [ sh:property [ sh:datatype xsd:integer ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:webPlateConnectionSideCount ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:passesThroughSupportingStructure ] ] [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:passesThroughSupportingStructure ] ] ), ( [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:terminatesAtDeckOrIceStringer ], [ sh:node gs:TRF049TerminatingAttachmentShape ; sh:path nltl:hasFrameAttachment ] ] [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:terminatesAtDeckOrIceStringer ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:passesThroughSupportingStructure ], [ sh:datatype xsd:boolean ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:terminatesAtDeckOrIceStringer ], [ sh:node gs:TRF049TransverseAttachmentShape ; sh:path nltl:hasFrameAttachment ] ] [ sh:not [ sh:class nltl:longitudinalFrame ], [ sh:class nltl:transverseFrame ] ] ) ; sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:TRF049FrameAttachmentShape ; sh:path nltl:hasFrameAttachment ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF049FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F03/frame> ] .

