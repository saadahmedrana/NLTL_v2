@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P07/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:or ( [ sh:property [ sh:class nltl:supportingStructure ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF049SupportingStructureShape ; sh:path nltl:hasSupportingBulkhead ], [ sh:class nltl:supportingStructure ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF049SupportingStructureShape ; sh:path nltl:hasSupportingWebFrame ], [ sh:hasValue nltl:longitudinalFrame ; sh:path rdf:type ] ] [ sh:or ( [ sh:property [ sh:class nltl:connectionBracket ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF049ConnectionBracketShape ; sh:path ( nltl:hasFrameAttachment nltl:hasConnectionBracket ) ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path ( nltl:hasFrameAttachment nltl:similarAttachmentConstructionPresent ) ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:terminatesAtDeckOrIceStringer ], [ sh:hasValue nltl:transverseFrame ; sh:path rdf:type ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:withinIceStrengthenedArea ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF049FrameAttachmentShape ; sh:path nltl:hasFrameAttachment ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:withinIceStrengthenedArea ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF049FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P07/frame> ] .

