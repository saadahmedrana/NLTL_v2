@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P01/frame> ;
            sh:resultMessage "The frame web thickness must be supplied as a millimetre quantity." ;
            sh:resultPath nltl:frameWebThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The frame web thickness must be supplied as a millimetre quantity." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-049_FrameWebThicknessShape> ;
                    sh:path nltl:frameWebThickness ] ] .

