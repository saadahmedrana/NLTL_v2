@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P06/frame> ;
            sh:resultMessage "The frame web thickness must be supplied as a millimetre quantity." ;
            sh:resultPath nltl:frameWebThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The frame web thickness must be supplied as a millimetre quantity." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-049_FrameWebThicknessShape> ;
                    sh:path nltl:frameWebThickness ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P06/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:or ( [ sh:property [ sh:hasValue nltl:longitudinalFrame ; sh:path rdf:type ], [ sh:message Literal(\"A longitudinal frame must be attached to supporting bulkheads.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-049_SupportingStructureShape> ; sh:path nltl:hasSupportingBulkhead ], [ sh:message Literal(\"A longitudinal frame must be attached to supporting web frames.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-049_SupportingStructureShape> ; sh:path nltl:hasSupportingWebFrame ] ] [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:terminatesAtDeckOrIceStringer ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-049_TerminatingAttachmentShape> ; sh:path nltl:hasFrameAttachment ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:terminatesAtDeckOrIceStringer ] ] ) ; sh:property [ sh:hasValue nltl:transverseFrame ; sh:path rdf:type ] ] ) ; sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ], [ sh:message Literal(\"An applicable frame must have an effectively validated frame attachment.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-049_FrameAttachmentShape> ; sh:path nltl:hasFrameAttachment ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-049_FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P06/frame> ] .

