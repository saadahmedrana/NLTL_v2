            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-P02/frame> ;
            sh:resultMessage "Each frame shall have a frame attachment record." ;
            sh:resultPath nltl:frameAttachment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each frame shall have a frame attachment record." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF_050_FrameAttachmentRecordShape ;
                    sh:path nltl:frameAttachment ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-P02/attachmentRecord> ] .

_:nb5738b685fc0493bb1817cd1cb6dce95b2 sh:datatype nltl:weldTypeValue ;
