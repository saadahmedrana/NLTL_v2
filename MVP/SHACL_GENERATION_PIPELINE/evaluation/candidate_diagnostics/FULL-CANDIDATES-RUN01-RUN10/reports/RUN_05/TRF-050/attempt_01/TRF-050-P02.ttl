[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-P02/attachmentRecord> ;
            sh:resultMessage "The frame shall be attached to the shell by a double continuous weld." ;
            sh:resultPath nltl:frameShellWeldType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape _:nb5738b685fc0493bb1817cd1cb6dce95b2 ;
            sh:value nltl:doubleContinuousWeld ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-P02/attachmentRecord> ;
                    sh:resultMessage "The frame shall be attached to the shell by a double continuous weld." ;
