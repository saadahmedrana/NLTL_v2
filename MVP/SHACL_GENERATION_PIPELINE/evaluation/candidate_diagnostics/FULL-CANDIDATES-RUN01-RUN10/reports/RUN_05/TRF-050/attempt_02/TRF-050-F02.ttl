@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F02/attachmentRecord> ;
                    sh:resultMessage "Each frame attachment record shall specify a double continuous weld." ;
                    sh:resultPath nltl:frameShellWeldType ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:na8e2880bd0fe457da5c5fcb3401ccf6fb1 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F02/frame> ;
            sh:resultMessage "Each frame shall be linked to a conforming frame attachment record." ;
            sh:resultPath nltl:frameAttachment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameAttachmentRecord ;
                    sh:message "Each frame shall be linked to a conforming frame attachment record." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-050_FrameAttachmentRecordShape> ;
                    sh:path nltl:frameAttachment ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F02/attachmentRecord> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F02/attachmentRecord> ;
            sh:resultMessage "Each frame attachment record shall specify a double continuous weld." ;
            sh:resultPath nltl:frameShellWeldType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:na8e2880bd0fe457da5c5fcb3401ccf6fb1 ] .

_:na8e2880bd0fe457da5c5fcb3401ccf6fb1 sh:class nltl:weldTypeValue ;
    sh:hasValue nltl:doubleContinuousWeld ;
    sh:maxCount 1 ;
    sh:message "Each frame attachment record shall specify a double continuous weld." ;
    sh:minCount 1 ;
    sh:path nltl:frameShellWeldType .

