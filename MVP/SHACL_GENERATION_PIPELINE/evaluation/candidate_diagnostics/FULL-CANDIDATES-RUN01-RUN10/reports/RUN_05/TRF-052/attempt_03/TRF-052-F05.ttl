@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F05/frame> ;
            sh:resultMessage "When the frame is asymmetrical or its web angle is below 90 degrees, antitripping support spacing of no more than 1300 mm must be represented." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the frame is asymmetrical or its web angle is below 90 degrees, antitripping support spacing of no more than 1300 mm must be represented." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:frameAsymmetrical ?asym ;
                      nltl:frameWebAngleToShell ?angleNode .
                ?angleNode qudt:numericValue ?angle .
                FILTER (
                    (?asym = true || ?angle < 90) &&
                    NOT EXISTS {
                        $this nltl:antitrippingSupportSpacing ?spacingNode .
                        ?spacingNode qudt:numericValue ?spacing ;
                                     qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER (?spacing <= 1300)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF052FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F05/frame> ] .

