    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P05/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:equivalentSupportStatusByDirectCalculation ] ] , [ sh:property [ sh:hasValue nltl:bowRegion ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasAntitrippingSupportRegion ], [ sh:hasValue nltl:midbodyRegion ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasAntitrippingSupportRegion ], [ sh:hasValue nltl:otherIceStrengthenedAreaValue ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasAntitrippingSupportRegion ], [ sh:hasValue nltl:sternRegion ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasAntitrippingSupportRegion ], [ sh:node [ sh:property [ sh:minExclusive Literal(\"4\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:frameSpan ] ] , [ sh:property [ sh:hasValue nltl:bowRegion ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasAntitrippingSupportRegion ], [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ], [ sh:hasValue nltl:midbodyRegion ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasAntitrippingSupportRegion ], [ sh:hasValue nltl:otherIceStrengthenedAreaValue ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasAntitrippingSupportRegion ], [ sh:hasValue nltl:sternRegion ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasAntitrippingSupportRegion ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"4\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:frameSpan ] ] , [ sh:property [ sh:hasValue nltl:bowRegion ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasAntitrippingSupportRegion ], [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ], [ sh:hasValue nltl:midbodyRegion ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasAntitrippingSupportRegion ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"4\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:frameSpan ] ] , [ sh:property [ sh:hasValue nltl:bowRegion ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasAntitrippingSupportRegion ], [ sh:in ( nltl:iceClassIb nltl:iceClassIc ) ; sh:path nltl:iceClass ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"4\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:frameSpan ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF052FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P05/frame> ] .

