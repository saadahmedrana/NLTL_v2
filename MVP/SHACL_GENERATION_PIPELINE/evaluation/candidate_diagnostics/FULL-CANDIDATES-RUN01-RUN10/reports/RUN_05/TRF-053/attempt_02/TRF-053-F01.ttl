@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/iceStringer> ;
            sh:resultMessage "designLineLoad must equal max(icePressure times designIceLoadHeight, 0.15) MN/m, reported in kN/m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "designLineLoad must equal max(icePressure times designIceLoadHeight, 0.15) MN/m, reported in kN/m." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:designLineLoad ?lineNode .
                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?lineNode qudt:numericValue ?reported .
                BIND (?p * ?h AS ?product)
                BIND (IF(?product < 0.15, 0.15, ?product) AS ?expectedMN)
                BIND (?expectedMN * 1000 AS ?expectedKN)
                FILTER (
                    (?expectedKN > 0 &&
                     (?reported < ?expectedKN * (1 - 0.000001) ||
                      ?reported > ?expectedKN * (1 + 0.000001)))
                    ||
                    (?expectedKN = 0 &&
                     (?reported < -0.000001 || ?reported > 0.000001))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF053IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/iceStringer> ] .

