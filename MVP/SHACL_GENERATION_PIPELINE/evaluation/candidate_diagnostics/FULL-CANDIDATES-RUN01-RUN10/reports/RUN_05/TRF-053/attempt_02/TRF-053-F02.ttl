@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F02/iceStringer> ;
            sh:resultMessage "sectionModulus must equal the specified ice-stringer section-modulus calculation within a relative tolerance of 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "sectionModulus must equal the specified ice-stringer section-modulus calculation within a relative tolerance of 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:sectionModulus ?zNode .
                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?sigmaNode qudt:numericValue ?sigma .
                ?zNode qudt:numericValue ?reportedZ .
                BIND (?p * ?h AS ?product)
                BIND (IF(?product < 0.15, 0.15, ?product) AS ?lineMN)
                BIND (0.9 * 1.8 * ?lineMN * ?l * ?l / (?m * ?sigma) * 1000000 AS ?expectedZ)
                FILTER (
                    (?expectedZ > 0 &&
                     (?reportedZ < ?expectedZ * (1 - 0.000001) ||
                      ?reportedZ > ?expectedZ * (1 + 0.000001)))
                    ||
                    (?expectedZ = 0 &&
                     (?reportedZ < -0.000001 || ?reportedZ > 0.000001))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF053IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F02/iceStringer> ] .

