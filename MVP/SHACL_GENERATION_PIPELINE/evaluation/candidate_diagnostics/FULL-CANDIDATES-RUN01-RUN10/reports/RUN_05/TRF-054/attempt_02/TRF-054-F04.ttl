@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F04/iceStringer> ;
            sh:resultMessage """Node ex:iceStringer must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:locatedOutsideIceBelt ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:supportsIceStrengthenedFrames ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:AreaQuantityShape ; sh:path nltl:requiredShearArea ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:DimensionlessQuantityShape ; sh:path nltl:frameMomentFactorM ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:DimensionlessQuantityShape ; sh:path nltl:outsideIceBeltFactor ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthMetreQuantityShape ; sh:path nltl:designIceLoadHeight ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthMetreQuantityShape ; sh:path nltl:distanceToAdjacentIceStringer ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthMetreQuantityShape ; sh:path nltl:distanceToIceBelt ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthMetreQuantityShape ; sh:path nltl:span ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LineLoadQuantityShape ; sh:path nltl:designLineLoad ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:PressureMegaPascalQuantityShape ; sh:path nltl:icePressure ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:PressureMegaPascalQuantityShape ; sh:path nltl:yieldStrength ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:SectionModulusQuantityShape ; sh:path nltl:sectionModulus ] ; sh:sparql [ sh:message Literal("The derived design line load, outside-ice-belt factor, section modulus, and required shear area must satisfy TRF-054.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:icePressure ?pNode ;
                              nltl:designIceLoadHeight ?hNode ;
                              nltl:span ?lNode ;
                              nltl:frameMomentFactorM ?mNode ;
                              nltl:yieldStrength ?yNode ;
                              nltl:distanceToIceBelt ?hsNode ;
                              nltl:distanceToAdjacentIceStringer ?lsNode ;
                              nltl:designLineLoad ?qNode ;
                              nltl:outsideIceBeltFactor ?fNode ;
                              nltl:sectionModulus ?zNode ;
                              nltl:requiredShearArea ?aNode .
                        ?pNode qudt:numericValue ?p .
                        ?hNode qudt:numericValue ?h .
                        ?lNode qudt:numericValue ?l .
                        ?mNode qudt:numericValue ?m .
                        ?yNode qudt:numericValue ?y .
                        ?hsNode qudt:numericValue ?hs .
                        ?lsNode qudt:numericValue ?ls .
                        ?qNode qudt:numericValue ?q .
                        ?fNode qudt:numericValue ?f .
                        ?zNode qudt:numericValue ?z .
                        ?aNode qudt:numericValue ?a .
                        BIND(IF((?p * ?h) < 0.15, 0.15, (?p * ?h)) AS ?qMn)
                        BIND((?qMn * 1000) AS ?expectedQ)
                        BIND((1 - (?hs / ?ls)) AS ?expectedF)
                        BIND((0.80 * 1.8 * ?qMn * ?l * ?l / (?m * ?y) * ?expectedF * 1000000) AS ?expectedZ)
                        BIND((1.7320508075688772 * 0.80 * 1.8 * 1.2 * ?qMn * ?l / (2 * ?y) * ?expectedF * 10000) AS ?expectedA)
                        FILTER (
                            ABS(?q - ?expectedQ) > (1e-6 * IF(ABS(?expectedQ) > 1e-9, ABS(?expectedQ), 1e-9))
                            ||
                            ABS(?f - ?expectedF) > (1e-6 * IF(ABS(?expectedF) > 1e-9, ABS(?expectedF), 1e-9))
                            ||
                            ABS(?z - ?expectedZ) > (1e-6 * IF(ABS(?expectedZ) > 1e-9, ABS(?expectedZ), 1e-9))
                            ||
                            ABS(?a - ?expectedA) > (1e-6 * IF(ABS(?expectedA) > 1e-9, ABS(?expectedA), 1e-9))
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:locatedOutsideIceBelt ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:supportsIceStrengthenedFrames ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF054IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F04/iceStringer> ] .

