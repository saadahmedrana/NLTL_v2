        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/iceStringer> ;
            sh:resultMessage "The distance to the adjacent ice stringer in metres is required." ;
            sh:resultPath nltl:distanceToAdjacentIceStringer ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The distance to the adjacent ice stringer in metres is required." ;
                    sh:minCount 1 ;
                    sh:node gen:LengthQuantityShape ;
                    sh:path nltl:distanceToAdjacentIceStringer ] ] .

_:n68c6378c42de4e7d9fbe6419b6f3416cb6 sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
