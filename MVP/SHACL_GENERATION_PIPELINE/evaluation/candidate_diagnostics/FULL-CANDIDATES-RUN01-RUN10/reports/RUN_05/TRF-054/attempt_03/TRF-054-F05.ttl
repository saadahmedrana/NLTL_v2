@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/outsideIceBeltFactorValue> ;
                    sh:resultMessage "Node ex:outsideIceBeltFactorValue->qdt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/UNITLESS>']" ;
                    sh:resultPath qdt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n68c6378c42de4e7d9fbe6419b6f3416cb6 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/iceStringer> ;
            sh:resultMessage "Value does not conform to Shape gen:DimensionlessQuantityShape. See details for more information." ;
            sh:resultPath nltl:outsideIceBeltFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:DimensionlessQuantityShape ;
                    sh:path nltl:outsideIceBeltFactor ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/outsideIceBeltFactorValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/designLineLoadValue> ;
                    sh:resultMessage "Node ex:designLineLoadValue->qdt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/UNITLESS>']" ;
                    sh:resultPath qdt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n68c6378c42de4e7d9fbe6419b6f3416cb6 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/iceStringer> ;
            sh:resultMessage "Value does not conform to Shape gen:DimensionlessQuantityShape. See details for more information." ;
            sh:resultPath nltl:designLineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
