@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P04/narrowDeckStrip> ;
            sh:resultMessage "The narrow deck strip must be abreast of a hatch." ;
            sh:resultPath nltl:abreastOfHatch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The narrow deck strip must be abreast of a hatch." ;
                    sh:minCount 1 ;
                    sh:path nltl:abreastOfHatch ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P04/narrowDeckStrip> ;
            sh:resultMessage "Actual section modulus and actual shear area must meet their respective required values." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Actual section modulus and actual shear area must meet their respective required values." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:actualSectionModulus ?actualZ ;
                      nltl:requiredSectionModulus ?requiredZ ;
                      nltl:actualShearArea ?actualA ;
                      nltl:requiredShearArea ?requiredA .
                ?actualZ qudt:numericValue ?actualZValue .
                ?requiredZ qudt:numericValue ?requiredZValue .
                ?actualA qudt:numericValue ?actualAValue .
                ?requiredA qudt:numericValue ?requiredAValue .
                FILTER (
                    ?actualZValue >= ?requiredZValue &&
                    ?actualAValue >= ?requiredAValue
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF055Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P04/narrowDeckStrip> ] .

