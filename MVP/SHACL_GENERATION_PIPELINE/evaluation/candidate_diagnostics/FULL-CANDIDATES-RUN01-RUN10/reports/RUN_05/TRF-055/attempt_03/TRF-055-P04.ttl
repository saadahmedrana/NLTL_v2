@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P04/narrowDeckStrip> ;
            sh:resultMessage "The narrow deck strip must be abreast of a hatch." ;
            sh:resultPath nltl:abreastOfHatch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The narrow deck strip must be abreast of a hatch." ;
                    sh:minCount 1 ;
                    sh:path nltl:abreastOfHatch ] ] .

