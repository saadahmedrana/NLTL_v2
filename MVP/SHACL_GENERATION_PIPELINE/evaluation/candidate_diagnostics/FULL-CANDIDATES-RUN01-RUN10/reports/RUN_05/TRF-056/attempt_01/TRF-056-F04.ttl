@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F04/ship> ;
            sh:resultMessage "For a hatch opening longer than half the ship breadth, ship-side deflection and both hatch design evidence records must be represented." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a hatch opening longer than half the ship breadth, ship-side deflection and both hatch design evidence records must be represented." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasWeatherdeckHatch ?hatch ;
                    nltl:shipBreadth ?breadth .
                ?hatch nltl:hatchOpeningLength ?opening .
                ?opening qudt:numericValue ?openingValue ;
                    qudt:unit unit:M .
                ?breadth qudt:numericValue ?breadthValue ;
                    qudt:unit unit:M .
                FILTER (datatype(?openingValue) = xsd:decimal)
                FILTER (datatype(?breadthValue) = xsd:decimal)
                FILTER (?openingValue > (?breadthValue / 2))
                FILTER (
                    NOT EXISTS {
                        ?hatch nltl:shipSideDeflection ?deflection .
                        ?deflection a qudt:QuantityValue ;
                            qudt:numericValue ?deflectionValue ;
                            qudt:unit unit:M .
                        FILTER (datatype(?deflectionValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?hatch nltl:hasHatchCoverDesignEvidence ?coverEvidence .
                        ?coverEvidence a nltl:hatchCoverDesignEvidence .
                    }
                    ||
                    NOT EXISTS {
                        ?hatch nltl:hasHatchFittingDesignEvidence ?fittingEvidence .
                        ?fittingEvidence a nltl:hatchFittingDesignEvidence .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-056_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F04/ship> ] .

