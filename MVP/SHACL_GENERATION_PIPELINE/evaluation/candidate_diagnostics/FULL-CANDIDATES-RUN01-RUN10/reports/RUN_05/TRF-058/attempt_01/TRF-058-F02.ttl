@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-F02/webFrame> ;
            sh:resultMessage """Node ex:webFrame must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The supported-stringer-outside-ice-belt applicability value must be true or false.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:supportedStringerOutsideIceBelt ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An ice load force in kN is required when the supported stringer is outside the ice belt.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF058ForceKiloNewtonShape ; sh:path nltl:iceLoadForce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The adjusted ice load force in kN is required when the supported stringer is outside the ice belt.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF058ForceKiloNewtonShape ; sh:path nltl:adjustedIceLoadForce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The stringer height outside the ice belt in metres is required when the supported stringer is outside the ice belt.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF058LengthMetreShape ; sh:path nltl:stringerOutsideIceBeltHeight ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The stringer span in metres is required when the supported stringer is outside the ice belt.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF058LengthMetreShape ; sh:path nltl:stringerSpan ] ; sh:sparql [ sh:message Literal("Adjusted ice load force must equal ice load force multiplied by (1 - stringer outside ice belt height / stringer span), within a relative tolerance of 1e-6 and an absolute fallback of 1e-6 kN.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:iceLoadForce ?forceNode ;
                              nltl:stringerOutsideIceBeltHeight ?heightNode ;
                              nltl:stringerSpan ?spanNode ;
                              nltl:adjustedIceLoadForce ?adjustedNode .

                        ?forceNode qudt:numericValue ?force ;
                                   qudt:unit unit:KiloN .
                        ?heightNode qudt:numericValue ?height ;
                                    qudt:unit unit:M .
                        ?spanNode qudt:numericValue ?span ;
                                   qudt:unit unit:M .
                        ?adjustedNode qudt:numericValue ?adjusted ;
                                      qudt:unit unit:KiloN .

                        BIND (?force * (1 - (?height / ?span)) AS ?expected)
                        FILTER (
                            ABS(?adjusted - ?expected) >
                            (0.000001 * ABS(?expected) + 0.000001)
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The supported-stringer-outside-ice-belt applicability value must be true or false.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:supportedStringerOutsideIceBelt ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF058WebFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-F02/webFrame> ] .

