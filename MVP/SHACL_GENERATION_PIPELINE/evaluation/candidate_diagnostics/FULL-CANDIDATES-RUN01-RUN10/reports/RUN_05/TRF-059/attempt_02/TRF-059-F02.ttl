@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ;
            sh:resultMessage "requiredShearArea must equal sqrt(3) times alpha times 1.1 times maximum calculated shear force in MN divided by yield strength, converted to cm2, within a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "requiredShearArea must equal sqrt(3) times alpha times 1.1 times maximum calculated shear force in MN divided by yield strength, converted to cm2, within a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?forceNode ;
                      nltl:webFrameShearFactorAlpha ?alphaNode ;
                      nltl:yieldStrength ?strengthNode ;
                      nltl:requiredShearArea ?areaNode .
                ?forceNode qudt:numericValue ?force .
                ?alphaNode qudt:numericValue ?alpha .
                ?strengthNode qudt:numericValue ?strength .
                ?areaNode qudt:numericValue ?area .
                BIND ((1.7320508075688772 * ?alpha * 1.1 * (?force / 1000.0) / ?strength * 10000.0) AS ?expected)
                FILTER (ABS(?area - ?expected) > (0.000001 * ABS(?expected) + 0.000000001))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF059WebFrameShearAreaShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ] .

