@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ;
            sh:resultMessage "requiredShearArea must equal the calculated effective shear area within the permitted numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "requiredShearArea must equal the calculated effective shear area within the permitted numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?forceQuantity ;
                      nltl:webFrameShearFactorAlpha ?alphaQuantity ;
                      nltl:yieldStrength ?strengthQuantity ;
                      nltl:requiredShearArea ?areaQuantity .
                ?forceQuantity qudt:numericValue ?force .
                ?alphaQuantity qudt:numericValue ?alpha .
                ?strengthQuantity qudt:numericValue ?strength .
                ?areaQuantity qudt:numericValue ?reportedArea .
                BIND (1.7320508075688772 * ?alpha * 1.1 *
                      (?force / 1000.0) / ?strength * 10000.0 AS ?expectedArea)
                BIND (
                    IF(
                        ?expectedArea >= ?reportedArea,
                        ?expectedArea - ?reportedArea,
                        ?reportedArea - ?expectedArea
                    ) AS ?difference
                )
                BIND (
                    IF(
                        ?expectedArea >= 0.001,
                        ?expectedArea * 0.000001,
                        0.000000001
                    ) AS ?tolerance
                )
                FILTER (?difference > ?tolerance)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF059WebFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ] .

