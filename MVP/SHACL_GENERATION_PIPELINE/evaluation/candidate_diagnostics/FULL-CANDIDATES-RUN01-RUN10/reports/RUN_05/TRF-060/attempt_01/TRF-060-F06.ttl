@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F06/lookup> ;
                    sh:resultMessage "The externally selected Table 4-8 gamma factor is required." ;
                    sh:resultPath nltl:webFrameTable4Dash8GammaFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The externally selected Table 4-8 gamma factor is required." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:webFrameTable4Dash8GammaFactor ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F06/ship> ;
            sh:resultMessage "A Table 4-8 lookup case is required for the external section-modulus calculation." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A Table 4-8 lookup case is required for the external section-modulus calculation." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:tableLookupCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "The externally selected Table 4-8 gamma factor is required." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:webFrameTable4Dash8GammaFactor ],
                                [ sh:hasValue nltl:traficomTable4Dash8 ;
                                    sh:maxCount 1 ;
                                    sh:message "The gamma factor must be selected from TRAFICOM Table 4-8." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:tableReference ],
                                [ sh:class nltl:evidenceArtifact ;
                                    sh:message "Table 4-8 selection evidence is required." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:lookupSelectionEvidence ] ] ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F06/lookup> ] .

