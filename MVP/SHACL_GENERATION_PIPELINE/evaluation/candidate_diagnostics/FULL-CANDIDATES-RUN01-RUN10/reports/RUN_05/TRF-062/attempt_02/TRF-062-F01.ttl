@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-062-F01/ship> ;
            sh:resultMessage "The propeller blade tip-to-hull clearance must be no less than the applicable h0 minimum clearance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The propeller blade tip-to-hull clearance must be no less than the applicable h0 minimum clearance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerBladeTipHullClearance ?clearanceQuantity .
                ?clearanceQuantity qudt:numericValue ?clearanceValue ;
                                    qudt:unit <http://qudt.org/vocab/unit/M> .
                $this nltl:minimumClearance ?thresholdQuantity .
                ?thresholdQuantity qudt:numericValue ?thresholdValue ;
                                    qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER(
                    datatype(?clearanceValue) = xsd:decimal &&
                    datatype(?thresholdValue) = xsd:decimal &&
                    ?clearanceValue < ?thresholdValue
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF_062_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-062-F01/ship> ] .

