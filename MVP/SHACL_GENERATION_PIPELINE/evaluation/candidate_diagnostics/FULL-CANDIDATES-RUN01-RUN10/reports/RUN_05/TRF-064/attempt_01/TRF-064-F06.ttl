@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F06/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:detachedStrut ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:SidePropellerShaftingEnclosedShape ; sh:path nltl:hasSidePropellerShafting ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:SternTubeEnclosedShape ; sh:path nltl:hasSternTube ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:detachedStrut ], [ sh:message Literal(\"A detached strut shall have design, strength, and hull-attachment evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:DetachedStrutShape ; sh:path nltl:hasDetachedStrut ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:SidePropellerShaftingShape ; sh:path nltl:hasSidePropellerShafting ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:SternTubeShape ; sh:path nltl:hasSternTube ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF064ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F06/ship> ] .

