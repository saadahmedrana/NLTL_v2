@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F02/ship> ;
            sh:resultMessage "The ship must consistently indicate whether detached struts are used and satisfy the applicable enclosure or detached-strut evidence requirements." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF064Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F02/sternTube> ;
                    sh:resultMessage "The side-propeller shafting or stern tube must be enclosed within plated bossing." ;
                    sh:resultPath nltl:enclosedByPlatedBossing ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:platedBossingStructure ;
                            sh:message "The side-propeller shafting or stern tube must be enclosed within plated bossing." ;
                            sh:minCount 1 ;
                            sh:path nltl:enclosedByPlatedBossing ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF064EnclosedComponentShape. See details for more information." ;
            sh:resultPath nltl:hasSternTube ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:sternTube ;
                    sh:node gen:TRF064EnclosedComponentShape ;
                    sh:path nltl:hasSternTube ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F02/sternTube> ] .

