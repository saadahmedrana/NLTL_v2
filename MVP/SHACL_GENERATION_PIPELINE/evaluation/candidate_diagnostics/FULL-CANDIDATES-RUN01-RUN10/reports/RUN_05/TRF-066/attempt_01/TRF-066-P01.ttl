@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-P01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For an IA ship, practicability of an ice knife shall be recorded as true when the ice-knife alternative is used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The lower ice waterline shall be recorded for an IA ship subject to this requirement.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lowerIceWaterline ], [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ], [ sh:message Literal(\"An IA ship shall have a rudder protection arrangement using an ice knife extending below the lower ice waterline.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:TRF066IceKnifeArrangementShape ; sh:path nltl:hasRudderProtectionArrangement ] ] , [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For an IA Super ship, practicability of an ice knife shall be recorded as true when the ice-knife alternative is used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The lower ice waterline shall be recorded for an IA Super ship subject to this requirement.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lowerIceWaterline ], [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ], [ sh:message Literal(\"An IA Super ship shall have a rudder protection arrangement using an ice knife extending below the lower ice waterline.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:TRF066IceKnifeArrangementShape ; sh:path nltl:hasRudderProtectionArrangement ] ] , [ rdf:type sh:NodeShape ; sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF066ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-P01/ship> ] .

