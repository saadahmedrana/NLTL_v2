@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:in ( nltl:iceClassIa nltl:iceClassIaSuper ) ; sh:path nltl:iceClass ], [ sh:message Literal(\"A practicable ice-knife arrangement must include an ice knife.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:iceKnife ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ice knife must extend below the lower ice waterline.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendsBelowLowerIceWaterline ] ] ; sh:path nltl:hasComponent ], [ sh:message Literal(\"An applicable ship must have a rudder protection arrangement.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:rudderProtectionArrangement ] ; sh:path nltl:hasRudderProtectionArrangement ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:in ( nltl:iceClassIa nltl:iceClassIaSuper ) ; sh:path nltl:iceClass ], [ sh:message Literal(\"When an ice knife is not practicable, equivalent rudder protection means must be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:equivalentRudderProtectionMeans, nltl:rudderProtectionArrangement ] ; sh:path nltl:hasRudderProtectionArrangement ] ] , [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-066> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F01/ship> ;
            sh:resultMessage "The lower ice waterline must be recorded." ;
            sh:resultPath nltl:lowerIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The lower ice waterline must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:lowerIceWaterline ] ] .

