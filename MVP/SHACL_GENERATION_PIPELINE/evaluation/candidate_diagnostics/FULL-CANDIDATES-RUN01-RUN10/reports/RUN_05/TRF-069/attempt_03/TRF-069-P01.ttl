@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-P01/ship> ;
            sh:resultMessage "The propeller type shall be open or ducted." ;
            sh:resultPath nltl:propellerType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "open" "ducted" ) ;
                    sh:maxCount 1 ;
                    sh:message "The propeller type shall be open or ducted." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerType ] ;
            sh:value "open"^^xsd:string ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-P01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:string ; sh:hasValue Literal(\"fixed\") ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:pitchType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:designCondition ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Fixed-pitch propeller reversal loads shall be included.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:fixedPitchPropellerReversalLoadIncluded ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:normalOperationalConditions ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:normalServiceLifePropellerIceLoadCondition ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:radialIceEntryOutsideLoadModel ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stoppedPropellerDraggingOutsideLoadModel ] ] ; sh:path nltl:hasDesignCondition ] ] , [ sh:property [ sh:datatype xsd:string ; sh:hasValue Literal(\"controllable\") ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:pitchType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:designCondition ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:normalOperationalConditions ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:normalServiceLifePropellerIceLoadCondition ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:radialIceEntryOutsideLoadModel ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stoppedPropellerDraggingOutsideLoadModel ] ] ; sh:path nltl:hasDesignCondition ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ a sh:NodeShape ;
                    sh:or ( [ sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class nltl:designCondition ;
                                                sh:property [ ],
                                                    [ ],
                                                    [ ],
                                                    [ ],
                                                    [ ] ] ;
                                        sh:path nltl:hasDesignCondition ],
                                    [ sh:datatype xsd:string ;
                                        sh:hasValue "fixed" ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:path nltl:pitchType ] ] [ sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class nltl:designCondition ;
                                                sh:property [ ],
                                                    [ ],
                                                    [ ],
                                                    [ ] ] ;
                                        sh:path nltl:hasDesignCondition ],
                                    [ sh:datatype xsd:string ;
                                        sh:hasValue "controllable" ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:path nltl:pitchType ] ] ) ;
                    sh:property [ sh:datatype xsd:string ;
                            sh:in ( "open" "ducted" ) ;
                            sh:maxCount 1 ;
                            sh:message "The propeller type shall be open or ducted." ;
                            sh:minCount 1 ;
                            sh:path nltl:propellerType ],
                        [ sh:maxCount 1 ;
                            sh:message "The maximum ice torque shall be supplied as a kilonewton-metre quantity." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue unit:KiloN-M ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:maximumIceTorque ],
                        [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc ) ;
                            sh:maxCount 1 ;
                            sh:message "The ship shall have an applicable Finnish-Swedish ice class." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:iceClass ] ;
                    sh:targetClass nltl:ship ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-P01/ship> ] .

