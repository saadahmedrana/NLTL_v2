@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:node gs:TRF070ApplicableShape ; sh:property [ sh:datatype xsd:string ; sh:hasValue Literal(\"azimuthing\") ; sh:path nltl:thrusterType ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:mainPropulsionThruster ] ] , [ sh:node gs:TRF070ApplicableShape ; sh:property [ sh:datatype xsd:string ; sh:hasValue Literal(\"fixed\") ; sh:path nltl:thrusterType ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:mainPropulsionThruster ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:mainPropulsionThruster ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF070ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F01/ship> ] .

