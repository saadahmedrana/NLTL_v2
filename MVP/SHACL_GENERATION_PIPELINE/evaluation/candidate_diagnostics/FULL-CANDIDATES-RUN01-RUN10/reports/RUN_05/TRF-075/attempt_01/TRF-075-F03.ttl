@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F03/case> ;
                    sh:resultMessage "A propeller blade load case must link to exactly one propeller blade." ;
                    sh:resultPath nltl:propellerBladeLoadCaseBlade ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "A propeller blade load case must link to exactly one propeller blade." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:propellerBlade ] ;
                            sh:path nltl:propellerBladeLoadCaseBlade ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F03/ship> ;
            sh:resultMessage "Each linked propeller blade load case must satisfy the blade, ice-block, and force-choice constraints." ;
            sh:resultPath nltl:hasPropellerBladeLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked propeller blade load case must satisfy the blade, ice-block, and force-choice constraints." ;
                    sh:node gs:TRF075LoadCaseShape ;
                    sh:path nltl:hasPropellerBladeLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F03/case> ] .

