@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F01/ship> ;
            sh:resultMessage "The propeller type must be recorded as CP or FP." ;
            sh:resultPath nltl:propellerType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "CP" "FP" ) ;
                    sh:message "The propeller type must be recorded as CP or FP." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerType ] ;
            sh:value "CP"^^xsd:string ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:CPBranchShape , gen:FPReversingBranchShape , gen:FPNonReversingBranchShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF076PropellerBladeLoadCaseShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F01/ship> ] .

