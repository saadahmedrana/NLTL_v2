@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ;
            sh:resultMessage "iceLoadCycleCount must equal k1*k2*k3*N_class*n_n within the required numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "iceLoadCycleCount must equal k1*k2*k3*N_class*n_n within the required numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?table6Case ;
                      nltl:hasTableLookupCase ?table7Case ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Node ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnNode ;
                      nltl:iceLoadCycleCount ?actual .

                ?table6Case nltl:tableReference nltl:traficomTable6Dash6 ;
                             nltl:selectedIceClassCycleCount ?nClassNode .

                ?table7Case nltl:tableReference nltl:traficomTable6Dash7 ;
                             nltl:selectedPropellerLocationFactor ?k1Node .

                ?k1Node qudt:numericValue ?k1Value .
                ?k2Node qudt:numericValue ?k2Value .
                ?k3Node qudt:numericValue ?k3Value .
                ?nClassNode qudt:numericValue ?nClassValue .
                ?nnNode qudt:numericValue ?nnValue .

                BIND (
                    ?k1Value * ?k2Value * ?k3Value * ?nClassValue * ?nnValue
                    AS ?expected
                )

                FILTER (
                    ABS(?actual - ?expected)
                    >
                    IF(
                        1e-6 * ABS(?expected) > 1e-9,
                        1e-6 * ABS(?expected),
                        1e-9
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF078ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ] .

