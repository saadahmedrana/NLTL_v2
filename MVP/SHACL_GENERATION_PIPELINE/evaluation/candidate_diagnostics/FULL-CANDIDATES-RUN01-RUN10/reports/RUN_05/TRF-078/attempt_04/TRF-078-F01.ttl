@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "Node ex:table6 must conform to one or more shapes in [ sh:node gen:TRF078Table6_6CaseShape ] , [ sh:node gen:TRF078Table6_7CaseShape ]" ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ sh:class nltl:tableLookupCase ;
                    sh:minCount 2 ;
                    sh:or ( [ sh:node gen:TRF078Table6_6CaseShape ] [ sh:node gen:TRF078Table6_7CaseShape ] ) ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/table6> ] .

