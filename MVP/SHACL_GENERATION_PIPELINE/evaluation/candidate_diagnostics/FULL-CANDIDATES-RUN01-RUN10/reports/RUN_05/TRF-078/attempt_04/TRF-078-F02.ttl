@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ;
            sh:resultMessage "The ship must provide both the Table 6-6 and Table 6-7 lookup cases with a reported ice-load cycle count equal to k1*k2*k3*N_class*n_n within the required tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ship must provide both the Table 6-6 and Table 6-7 lookup cases with a reported ice-load cycle count equal to k1*k2*k3*N_class*n_n within the required tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?case6 ;
                      nltl:hasTableLookupCase ?case7 ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Node ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnNode ;
                      nltl:iceLoadCycleCount ?actual .

                ?case6 a nltl:tableLookupCase ;
                       nltl:tableReference nltl:traficomTable6Dash6 ;
                       nltl:iceClass ?iceClass ;
                       nltl:selectedIceClassCycleCount ?nClassNode .

                ?case7 a nltl:tableLookupCase ;
                       nltl:tableReference nltl:traficomTable6Dash7 ;
                       nltl:tableLookupPropellerLocation ?location ;
                       nltl:selectedPropellerLocationFactor ?k1Node .

                ?k2Node <http://qudt.org/schema/qudt/numericValue> ?k2 .
                ?k3Node <http://qudt.org/schema/qudt/numericValue> ?k3 .
                ?nnNode <http://qudt.org/schema/qudt/numericValue> ?nn .
                ?nClassNode <http://qudt.org/schema/qudt/numericValue> ?nClass .
                ?k1Node <http://qudt.org/schema/qudt/numericValue> ?k1 .

                BIND((?k1 * ?k2 * ?k3 * ?nClass * ?nn) AS ?expected)
                BIND(ABS(?actual - ?expected) AS ?difference)

                FILTER (
                    ?difference > (1e-6 * ABS(?expected))
                    && ?difference > 1e-9
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF078ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ] .

