@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ;
            sh:resultMessage "The immersion function and submersion factor do not satisfy the specified formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The immersion function and submersion factor do not satisfy the specified formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?iceQuantity ;
                      nltl:propellerDiameter ?diameterQuantity ;
                      nltl:propellerShaftCentrelineDepth ?depthQuantity ;
                      nltl:propellerImmersionFunction ?immersionQuantity ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Quantity .

                ?iceQuantity <http://qudt.org/schema/qudt/numericValue> ?ice .
                ?diameterQuantity <http://qudt.org/schema/qudt/numericValue> ?diameter .
                ?depthQuantity <http://qudt.org/schema/qudt/numericValue> ?depth .
                ?immersionQuantity <http://qudt.org/schema/qudt/numericValue> ?immersion .
                ?k2Quantity <http://qudt.org/schema/qudt/numericValue> ?k2 .

                BIND (((?depth - ?ice) / (?diameter / 2)) - 1 AS ?expectedImmersion)
                BIND (
                    IF(
                        ?expectedImmersion < 0,
                        0.8 - ?expectedImmersion,
                        IF(
                            ?expectedImmersion <= 1,
                            0.8 - (0.4 * ?expectedImmersion),
                            IF(
                                ?expectedImmersion <= 2.5,
                                0.6 - (0.2 * ?expectedImmersion),
                                0.1
                            )
                        )
                    ) AS ?expectedK2
                )
                BIND (
                    IF(
                        ABS(?expectedImmersion) * 0.000001 > 0.000000001,
                        ABS(?expectedImmersion) * 0.000001,
                        0.000000001
                    ) AS ?immersionTolerance
                )
                BIND (
                    IF(
                        ABS(?expectedK2) * 0.000001 > 0.000000001,
                        ABS(?expectedK2) * 0.000001,
                        0.000000001
                    ) AS ?k2Tolerance
                )

                FILTER (
                    ABS(?immersion - ?expectedImmersion) > ?immersionTolerance
                    ||
                    ABS(?k2 - ?expectedK2) > ?k2Tolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_079_StaticCalculationShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ] .

