@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-P04/ship> ;
            sh:resultMessage "The propeller immersion function and ice load cycle coefficient k2 must satisfy the specified formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The propeller immersion function and ice load cycle coefficient k2 must satisfy the specified formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?iceQuantity ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Quantity ;
                      nltl:propellerDiameter ?diameterQuantity ;
                      nltl:propellerImmersionFunction ?fQuantity ;
                      nltl:propellerShaftCentrelineDepth ?depthQuantity .

                ?iceQuantity <http://qudt.org/schema/qudt/numericValue> ?hIce ;
                             <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/M> .
                ?k2Quantity <http://qudt.org/schema/qudt/numericValue> ?k2 ;
                             <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/UNITLESS> .
                ?diameterQuantity <http://qudt.org/schema/qudt/numericValue> ?diameter ;
                                  <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/M> .
                ?fQuantity <http://qudt.org/schema/qudt/numericValue> ?f ;
                            <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/UNITLESS> .
                ?depthQuantity <http://qudt.org/schema/qudt/numericValue> ?h0 ;
                               <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/M> .

                BIND((((?h0 - ?hIce) / (?diameter / 2)) - 1) AS ?expectedF)
                BIND(IF(?expectedF >= 0, ?expectedF, -?expectedF) AS ?fScale)
                BIND(IF(?fScale >= 1, 0.000001 * ?fScale, 0.000001) AS ?fTolerance)

                BIND(
                    IF(
                        ?expectedF < 0,
                        0.8 - ?expectedF,
                        IF(
                            ?expectedF <= 1,
                            0.8 - (0.4 * ?expectedF),
                            IF(
                                ?expectedF <= 2.5,
                                0.6 - (0.2 * ?expectedF),
                                0.1
                            )
                        )
                    ) AS ?expectedK2
                )
                BIND(IF(?expectedK2 >= 0, ?expectedK2, -?expectedK2) AS ?k2Scale)
                BIND(IF(?k2Scale >= 1, 0.000001 * ?k2Scale, 0.000001) AS ?k2Tolerance)

                FILTER(
                    (?f - ?expectedF <= ?fTolerance) &&
                    (?f - ?expectedF >= -?fTolerance)
                )
                FILTER(
                    (?k2 - ?expectedK2 <= ?k2Tolerance) &&
                    (?k2 - ?expectedK2 >= -?k2Tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-079> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-P04/ship> ] .

