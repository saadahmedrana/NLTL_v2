@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-F01/ship> ;
            sh:resultMessage "Ice thrust and propeller shaft design thrust values must satisfy the declared formulas within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-6 kN." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ice thrust and propeller shaft design thrust values must satisfy the declared formulas within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-6 kN." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce ?ffNode ;
                      nltl:backwardBladeForce ?fbNode ;
                      nltl:hydrodynamicBollardThrust ?hydroNode ;
                      nltl:forwardIceThrust ?tfNode ;
                      nltl:backwardIceThrust ?tbNode ;
                      nltl:forwardPropellerShaftDesignThrust ?forwardDesignNode ;
                      nltl:backwardPropellerShaftDesignThrust ?backwardDesignNode ;
                      nltl:propellerShaftDesignThrust ?designNode .

                ?ffNode qudt:numericValue ?ff .
                ?fbNode qudt:numericValue ?fb .
                ?hydroNode qudt:numericValue ?hydro .
                ?tfNode qudt:numericValue ?tf .
                ?tbNode qudt:numericValue ?tb .
                ?forwardDesignNode qudt:numericValue ?forwardDesign .
                ?backwardDesignNode qudt:numericValue ?backwardDesign .
                ?designNode qudt:numericValue ?design .

                FILTER (
                    datatype(?ff) = xsd:decimal &&
                    datatype(?fb) = xsd:decimal &&
                    datatype(?hydro) = xsd:decimal &&
                    datatype(?tf) = xsd:decimal &&
                    datatype(?tb) = xsd:decimal &&
                    datatype(?forwardDesign) = xsd:decimal &&
                    datatype(?backwardDesign) = xsd:decimal &&
                    datatype(?design) = xsd:decimal
                )

                BIND(1.1 * ?ff AS ?tfExpected)
                BIND(1.1 * ?fb AS ?tbExpected)
                BIND(?hydro + 2.2 * ?tfExpected AS ?forwardDesignExpected)
                BIND(1.5 * ?tbExpected AS ?backwardDesignExpected)
                BIND(
                    IF(
                        ?forwardDesignExpected >= ?backwardDesignExpected,
                        ?forwardDesignExpected,
                        ?backwardDesignExpected
                    ) AS ?designExpected
                )

                FILTER (
                    ABS(?tf - ?tfExpected) >
                        (0.000001 * ABS(?tfExpected) + 0.000001) ||
                    ABS(?tb - ?tbExpected) >
                        (0.000001 * ABS(?tbExpected) + 0.000001) ||
                    ABS(?forwardDesign - ?forwardDesignExpected) >
                        (0.000001 * ABS(?forwardDesignExpected) + 0.000001) ||
                    ABS(?backwardDesign - ?backwardDesignExpected) >
                        (0.000001 * ABS(?backwardDesignExpected) + 0.000001) ||
                    ABS(?design - ?designExpected) >
                        (0.000001 * ABS(?designExpected) + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF081Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-F01/ship> ] .

