@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-P03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ rdf:type sh:NodeShape ; sh:property [ sh:hasValue Literal("CP") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerType ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:pitchValueKnown ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:propellerPitchAtMcrBollard ] ] , [ rdf:type sh:NodeShape ; sh:property [ sh:hasValue Literal("CP") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerType ], [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:pitchValueKnown ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:propellerPitchAtMcrBollard ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:propellerPitchAtMcrFreeRunning ] ; sh:sparql [ sh:message Literal("For a CP propeller with an unknown pitch value, propeller pitch at MCR in bollard condition must equal 0.7 times the free-running value within a relative tolerance of 1e-6, with an absolute fallback of 1e-9.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerType "CP" ;
                              nltl:pitchValueKnown false .
                        FILTER NOT EXISTS {
                            $this nltl:propellerPitchAtMcrFreeRunning ?freeNode ;
                                  nltl:propellerPitchAtMcrBollard ?bollardNode .
                            ?freeNode qudt:numericValue ?free ;
                                      qudt:unit unit:M .
                            ?bollardNode qudt:numericValue ?actual ;
                                      qudt:unit unit:M .
                            BIND((0.7 * ?free) AS ?expected)
                            FILTER(
                                ABS(?actual - ?expected) <=
                                IF(
                                    ABS(?expected) * "0.000001"^^xsd:decimal >
                                    "0.000000001"^^xsd:decimal,
                                    ABS(?expected) * "0.000001"^^xsd:decimal,
                                    "0.000000001"^^xsd:decimal
                                )
                            )
                        }
                    }
                ") ] ] , [ rdf:type sh:NodeShape ; sh:sparql [ sh:message Literal("The conditional pitch requirement applies only to CP propellers.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerType ?propellerType .
                        FILTER(?propellerType != "CP")
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_084_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-P03/ship> ] .

