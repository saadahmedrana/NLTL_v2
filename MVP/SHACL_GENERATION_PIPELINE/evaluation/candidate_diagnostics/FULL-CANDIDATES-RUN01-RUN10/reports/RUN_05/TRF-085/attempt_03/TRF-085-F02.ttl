@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A known bollard propeller speed at maximum continuous rating shall be provided.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/REV-PER-MIN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The ship shall identify the bollard propeller speed as known.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bollardPropellerSpeedKnown ] ] , [ sh:property [ sh:datatype qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:propellerDiameter ], [ sh:datatype qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/REV-PER-MIN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The ship shall identify the bollard propeller speed as unknown when Table 6-9 selection is used.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bollardPropellerSpeedKnown ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:tableLookupCase ; sh:property [ sh:class nltl:evidenceArtifact ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:lookupSelectionEvidence ], [ sh:hasValue nltl:traficomTable6Dash9 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:tableReference ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:lookupInputQuantity ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:lookupResultQuantity ] ] ; sh:path nltl:hasTableLookupCase ] ; sh:sparql [ sh:message Literal("Each Table 6-9 lookup case shall use the ship's propeller diameter as input and its selected result shall equal the ship's bollard propeller speed.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:propellerDiameter ?diameterQuantity ;
        nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ?speedQuantity ;
        nltl:hasTableLookupCase ?case .
  ?diameterQuantity qudt:numericValue ?diameterValue .
  ?speedQuantity qudt:numericValue ?speedValue .
  ?case nltl:lookupInputQuantity ?inputQuantity ;
        nltl:lookupResultQuantity ?resultQuantity .
  ?inputQuantity qudt:numericValue ?inputValue .
  ?resultQuantity qudt:numericValue ?resultValue .
  FILTER (
    datatype(?diameterValue) = xsd:decimal &&
    datatype(?speedValue) = xsd:decimal &&
    datatype(?inputValue) = xsd:decimal &&
    datatype(?resultValue) = xsd:decimal &&
    (?diameterValue != ?inputValue || ?speedValue != ?resultValue)
  )
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-085> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-F02/ship> ] .

