@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-F02/ship> ;
            sh:resultMessage "For a CP propeller with an unknown pitch value, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within a relative tolerance of 1e-6 plus an absolute fallback of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a CP propeller with an unknown pitch value, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within a relative tolerance of 1e-6 plus an absolute fallback of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType ?type ;
                      nltl:pitchValueKnown ?known .
                FILTER (?type = "CP"^^xsd:string)
                FILTER (?known = false)

                FILTER NOT EXISTS {
                    $this nltl:propellerPitchAtMcrBollard ?bollardQuantity .
                    ?bollardQuantity a qudt:QuantityValue ;
                                      qudt:numericValue ?bollardValue ;
                                      qudt:unit unit:M .
                    FILTER (datatype(?bollardValue) = xsd:decimal)

                    $this nltl:propellerPitchAtMcrFreeRunning ?freeRunningQuantity .
                    ?freeRunningQuantity a qudt:QuantityValue ;
                                          qudt:numericValue ?freeRunningValue ;
                                          qudt:unit unit:M .
                    FILTER (datatype(?freeRunningValue) = xsd:decimal)

                    FILTER (
                        ABS(?bollardValue - (0.7 * ?freeRunningValue))
                        <=
                        (0.000001 * ABS(0.7 * ?freeRunningValue) + 0.000000001)
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-086> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-F02/ship> ] .

