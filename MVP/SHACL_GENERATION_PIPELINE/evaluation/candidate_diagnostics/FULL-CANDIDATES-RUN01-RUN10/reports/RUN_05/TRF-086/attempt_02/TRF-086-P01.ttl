@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-P01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:message Literal("For a CP propeller with a known pitch value, the MCR bollard pitch must be supplied.") ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:pitchValueKnown ], [ sh:hasValue Literal("CP") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerType ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:propellerPitchAtMcrBollard ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:pitchValueKnown ], [ sh:hasValue Literal("CP") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerType ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:propellerPitchAtMcrBollard ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:propellerPitchAtMcrFreeRunning ] ; sh:sparql [ sh:message Literal("For a CP propeller with unknown pitch value, the MCR bollard pitch must equal 0.7 times the MCR free-running pitch within the permitted numerical tolerance.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:propellerPitchAtMcrBollard ?bollardQuantity .
                        $this nltl:propellerPitchAtMcrFreeRunning ?freeRunningQuantity .
                        ?bollardQuantity qudt:numericValue ?bollardValue .
                        ?freeRunningQuantity qudt:numericValue ?freeRunningValue .
                        BIND(0.7 * ?freeRunningValue AS ?expectedValue)
                        BIND(
                            IF(
                                ?expectedValue >= 0.001,
                                ?expectedValue * 0.000001,
                                0.000000001
                            ) AS ?tolerance
                        )
                        FILTER(
                            ?bollardValue < (?expectedValue - ?tolerance)
                            ||
                            ?bollardValue > (?expectedValue + ?tolerance)
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:string ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerType ; sh:pattern Literal("^(?!CP$).*$") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF086Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-P01/ship> ] .

