@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Maximum engine torque must be identified as known when the table-lookup condition does not apply.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:maximumEngineTorqueKnown ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"The maximum engine torque must be identified as unknown to apply the Table 6-10 value.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:maximumEngineTorqueKnown ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A single maximum engine torque quantity in kN*m is required when the torque is unknown.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:KiloN-M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:maximumEngineTorque ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal(\"The Table 6-10 selection must have supporting evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lookupSelectionEvidence ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The Table 6-10 lookup must be applied when maximum engine torque is unknown.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:tableLookupApplied ], [ sh:hasValue nltl:traficomTable6Dash10 ; sh:message Literal(\"The lookup case must reference TRAFICOM Table 6-10.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:tableReference ] ] ; sh:path nltl:hasTableLookupCase ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:TRF088Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F01/ship> ] .

