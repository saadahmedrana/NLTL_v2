@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/ship> ;
            sh:resultMessage "The propulsion line load case shall use the ice-milling load sequence for strength evaluation and not for stalling analysis." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ncbcf2060bbae4420a275120f60c2ced8b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/milling> ;
            sh:resultMessage "The ship shall identify a case where the propeller is milling an ice block." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceMillingSequenceCase ;
                    sh:message "The ship shall identify a case where the propeller is milling an ice block." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceMillingSequenceCase ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ;
                    sh:resultMessage "Node ex:loadCase must not conform to shape [ sh:property [ sh:hasValue nltl:stallingAnalysisPurposeValue ; sh:message Literal(\"The ice-milling load sequence shall not be identified as intended for propulsion system stalling analysis.\") ; sh:path nltl:loadCasePurpose ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NotConstraintComponent ;
                    sh:sourceShape [ sh:not [ sh:property [ sh:hasValue nltl:stallingAnalysisPurposeValue ;
                                            sh:message "The ice-milling load sequence shall not be identified as intended for propulsion system stalling analysis." ;
                                            sh:path nltl:loadCasePurpose ] ] ;
                            sh:property [ sh:class nltl:loadCasePurposeValue ;
                                    sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                                    sh:message "The load case shall be identified as used for propulsion line strength evaluation." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:loadCasePurpose ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ;
                    sh:resultMessage "The load case shall be identified as used for propulsion line strength evaluation." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCasePurposeValue ;
                            sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                            sh:message "The load case shall be identified as used for propulsion line strength evaluation." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:loadCasePurpose ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/milling> ;
            sh:resultMessage "The propulsion line load case shall use the ice-milling load sequence for strength evaluation and not for stalling analysis." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:ncbcf2060bbae4420a275120f60c2ced8b2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ] .

_:N31f4043f50d34788bb113dc6b19dad41 sh:not [ sh:property [ sh:hasValue nltl:stallingAnalysisPurposeValue ;
                    sh:message "The ice-milling load sequence shall not be identified as intended for propulsion system stalling analysis." ;
                    sh:path nltl:loadCasePurpose ] ] ;
    sh:property [ sh:class nltl:loadCasePurposeValue ;
            sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
            sh:message "The load case shall be identified as used for propulsion line strength evaluation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path nltl:loadCasePurpose ] .

_:ncbcf2060bbae4420a275120f60c2ced8b2 sh:class nltl:loadCase ;
    sh:message "The propulsion line load case shall use the ice-milling load sequence for strength evaluation and not for stalling analysis." ;
    sh:minCount 1 ;
    sh:node _:N31f4043f50d34788bb113dc6b19dad41 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasPropulsionLoadCase .

