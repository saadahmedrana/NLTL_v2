@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/ship> ;
            sh:resultMessage "Each ice-milling sequence case shall be the same load-case node used for the propulsion-line strength evaluation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each ice-milling sequence case shall be the same load-case node used for the propulsion-line strength evaluation." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasIceMillingSequenceCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:hasPropulsionLoadCase ?case .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF091Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/milling> ;
                    sh:resultMessage "The ice-milling load case shall have propulsion-line strength evaluation as its purpose." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n450eb388469f4597941ab1f0570ee7fab3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/milling> ;
                    sh:resultMessage "The ice-milling load case shall have propulsion-line strength evaluation as its purpose." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n450eb388469f4597941ab1f0570ee7fab3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:iceMillingSequenceCase, nltl:loadCase ; sh:property [ sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ; sh:message Literal(\"The ice-milling load case shall have propulsion-line strength evaluation as its purpose.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadCasePurpose ], [ sh:message Literal(\"The ice-milling load case shall not have stalling analysis as its purpose.\") ; sh:not [ sh:hasValue nltl:stallingAnalysisPurposeValue ] ; sh:path nltl:loadCasePurpose ] ]. See details for more information." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n450eb388469f4597941ab1f0570ee7fab1 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/milling> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasPropulsionLoadCase" ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:loadCase ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasPropulsionLoadCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/milling> ;
            sh:resultMessage "Less than 1 values on ex:milling->nltl:hasIceMillingSequenceCase" ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n450eb388469f4597941ab1f0570ee7fab1 ] .

_:N000b7dec61924a83b0c4014861be23cd sh:class nltl:iceMillingSequenceCase,
        nltl:loadCase ;
    sh:property [ sh:message "The ice-milling load case shall not have stalling analysis as its purpose." ;
            sh:not [ sh:hasValue nltl:stallingAnalysisPurposeValue ] ;
            sh:path nltl:loadCasePurpose ],
        [ sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
            sh:message "The ice-milling load case shall have propulsion-line strength evaluation as its purpose." ;
            sh:minCount 1 ;
            sh:path nltl:loadCasePurpose ] .

_:n450eb388469f4597941ab1f0570ee7fab1 sh:minCount 1 ;
    sh:node _:N000b7dec61924a83b0c4014861be23cd ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasIceMillingSequenceCase .

_:n450eb388469f4597941ab1f0570ee7fab3 sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
    sh:message "The ice-milling load case shall have propulsion-line strength evaluation as its purpose." ;
    sh:minCount 1 ;
    sh:path nltl:loadCasePurpose .

