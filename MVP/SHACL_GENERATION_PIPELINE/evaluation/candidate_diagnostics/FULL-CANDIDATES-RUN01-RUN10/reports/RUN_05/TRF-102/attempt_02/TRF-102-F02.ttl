@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-F02/ship> ;
            sh:resultMessage "The maximum spindle torque must be established either by the declared approved stress analysis or by the specified calculation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF102Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-F02/ship> ] .

