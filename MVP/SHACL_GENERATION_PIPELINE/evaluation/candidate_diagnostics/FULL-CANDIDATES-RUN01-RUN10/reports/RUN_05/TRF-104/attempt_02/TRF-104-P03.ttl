@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-P03/ship> ;
            sh:resultMessage "The ship shall identify the propeller shaft line components subject to the blade-loss damage constraint." ;
            sh:resultPath nltl:hasPropellerShaftLineComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify the propeller shaft line components subject to the blade-loss damage constraint." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-104-PropellerShaftLineComponentShape> ;
                    sh:path nltl:hasPropellerShaftLineComponent ] ] .

