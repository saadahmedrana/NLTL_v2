@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:stressLifeCurveTypeValue ; sh:hasValue nltl:twoSlopeStressLifeCurve ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("When the SN-curve type is unknown, the two-slope SN curve shall be selected.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelection ], [ sh:datatype xsd:string ; sh:hasValue Literal("unknown") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An unknown SN-curve type must be explicitly recorded.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveType ] ] , [ sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal("Evidence shall establish correspondence between the selected SN curve and the blade material properties.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ], [ sh:class nltl:stressLifeCurveTypeValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A known SN-curve type shall have a selected curve.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelection ], [ sh:datatype xsd:string ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A known SN-curve type shall be recorded.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveType ], [ sh:datatype xsd:string ; sh:message Literal("A known SN-curve selection shall correspond to the blade material properties.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerBladeMaterialProperty ] ; sh:sparql [ sh:message Literal("A known SN-curve type must not be represented as unknown and must have a material-corresponding selection with evidence.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:stressLifeCurveType ?curveType .
                        FILTER (STR(?curveType) != "unknown")
                        $this nltl:stressLifeCurveSelection ?selection .
                        $this nltl:propellerBladeMaterialProperty ?material .
                        $this nltl:stressLifeCurveSelectionCorrespondenceEvidence ?evidence .
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-108> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F01/ship> ] .

