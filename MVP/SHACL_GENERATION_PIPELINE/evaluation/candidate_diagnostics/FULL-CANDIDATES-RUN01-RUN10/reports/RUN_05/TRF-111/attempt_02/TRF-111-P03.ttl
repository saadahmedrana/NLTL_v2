@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/loadCase> ;
                    sh:resultMessage """Node ex:loadCase must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:extremeOperationalLoadCase ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shaftLineLoadCaseType ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The extreme operational load case requires a yield safety factor of at least 1.3.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("1.3", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ] ] , [ sh:property [ sh:hasValue nltl:fatigueLoadCase ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shaftLineLoadCaseType ] ; sh:sparql [ sh:message Literal("The fatigue load case requires a ship component fatigue safety factor of at least 1.5.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                FILTER NOT EXISTS {
                                    ?ship nltl:hasPropulsionLoadCase $this .
                                    ?ship nltl:hasComponent ?component .
                                    ?component nltl:fatigueSafetyFactor ?factor .
                                    ?factor qudt:numericValue ?value .
                                    ?factor qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                    FILTER (
                                        datatype(?value) = xsd:decimal &&
                                        ?value >= 1.5
                                    )
                                }
                            }
                        ") ] ] , [ sh:property [ sh:hasValue nltl:bladeFailureLoadCase ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shaftLineLoadCaseType ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The blade failure load case requires a yield safety factor of at least 1.0.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("1.0", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ] ]""" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:or ( [ sh:property [ sh:maxCount 1 ;
                                                sh:message "The extreme operational load case requires a yield safety factor of at least 1.3." ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class qudt:QuantityValue ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:componentYieldSafetyFactor ],
                                            [ sh:hasValue nltl:extremeOperationalLoadCase ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ] ] [ sh:property [ sh:hasValue nltl:fatigueLoadCase ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ] ;
                                        sh:sparql [ sh:message "The fatigue load case requires a ship component fatigue safety factor of at least 1.5." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                FILTER NOT EXISTS {
                                    ?ship nltl:hasPropulsionLoadCase $this .
                                    ?ship nltl:hasComponent ?component .
                                    ?component nltl:fatigueSafetyFactor ?factor .
                                    ?factor qudt:numericValue ?value .
                                    ?factor qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                    FILTER (
                                        datatype(?value) = xsd:decimal &&
                                        ?value >= 1.5
                                    )
                                }
                            }
                        """ ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:message "The blade failure load case requires a yield safety factor of at least 1.0." ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class qudt:QuantityValue ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:componentYieldSafetyFactor ],
                                            [ sh:hasValue nltl:bladeFailureLoadCase ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ] ] ) ;
                            sh:property [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                                    sh:maxCount 1 ;
                                    sh:message "Each propulsion load case must identify a shaft line load case type." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:shaftLineLoadCaseType ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/loadCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/ship> ;
            sh:resultMessage "The ship must provide applicable propulsion load cases." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:loadCase ;
                    sh:message "The ship must provide applicable propulsion load cases." ;
                    sh:minCount 1 ;
                    sh:node [ sh:or ( [ sh:property [ sh:hasValue nltl:extremeOperationalLoadCase ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ],
                                            [ sh:maxCount 1 ;
                                                sh:message "The extreme operational load case requires a yield safety factor of at least 1.3." ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] [ sh:property [ sh:hasValue nltl:fatigueLoadCase ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ] ;
                                        sh:sparql [ sh:message "The fatigue load case requires a ship component fatigue safety factor of at least 1.5." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                FILTER NOT EXISTS {
                                    ?ship nltl:hasPropulsionLoadCase $this .
                                    ?ship nltl:hasComponent ?component .
                                    ?component nltl:fatigueSafetyFactor ?factor .
                                    ?factor qudt:numericValue ?value .
                                    ?factor qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                    FILTER (
                                        datatype(?value) = xsd:decimal &&
                                        ?value >= 1.5
                                    )
                                }
                            }
                        """ ] ] [ sh:property [ sh:hasValue nltl:bladeFailureLoadCase ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ],
                                            [ sh:maxCount 1 ;
                                                sh:message "The blade failure load case requires a yield safety factor of at least 1.0." ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] ) ;
                            sh:property [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                                    sh:maxCount 1 ;
                                    sh:message "Each propulsion load case must identify a shaft line load case type." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:shaftLineLoadCaseType ] ] ;
                    sh:path nltl:hasPropulsionLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/loadCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/ship> ;
            sh:resultMessage "The ship must provide the extreme ice force in kN." ;
            sh:resultPath nltl:extremeIceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the extreme ice force in kN." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:extremeIceForce ] ] .

