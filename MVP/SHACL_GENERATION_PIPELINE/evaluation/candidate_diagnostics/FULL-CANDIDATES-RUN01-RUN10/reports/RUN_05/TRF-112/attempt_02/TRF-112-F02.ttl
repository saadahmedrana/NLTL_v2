@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F02/component> ;
                    sh:resultMessage "Less than 1 values on ex:component->nltl:bendingYieldSafetyFactor" ;
                    sh:resultPath nltl:bendingYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                            sh:maxCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:message "Bending yield safety factor must be at least 1.0." ;
                                            sh:minCount 1 ;
                                            sh:minInclusive 1.0 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:bendingYieldSafetyFactor ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:message Literal(\"Bending yield safety factor must be at least 1.0.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:bendingYieldSafetyFactor ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:message Literal(\"Torsional yield safety factor must be at least 1.0.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:torsionalYieldSafetyFactor ] ]. See details for more information." ;
            sh:resultPath nltl:hasPropellerShaftLineComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:message "Bending yield safety factor must be at least 1.0." ;
                                                    sh:minCount 1 ;
                                                    sh:minInclusive 1.0 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:bendingYieldSafetyFactor ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:message "Torsional yield safety factor must be at least 1.0." ;
                                                    sh:minCount 1 ;
                                                    sh:minInclusive 1.0 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:torsionalYieldSafetyFactor ] ] ;
                    sh:path nltl:hasPropellerShaftLineComponent ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F02/component> ] .

