@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F03/ship> ;
            sh:resultMessage "A steering mechanism must be represented among the ship components." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A steering mechanism must be represented among the ship components." ;
                    sh:path nltl:hasComponent ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:steeringMechanism ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F03/ship> ;
            sh:resultMessage "The ship must record plastic-bending design capability for the blade-loss case." ;
            sh:resultPath nltl:bladePlasticBending ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must record plastic-bending design capability for the blade-loss case." ;
                    sh:minCount 1 ;
                    sh:path nltl:bladePlasticBending ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F03/ship> ;
            sh:resultMessage "A thruster body must be represented among the ship components." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A thruster body must be represented among the ship components." ;
                    sh:path nltl:hasComponent ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:thrusterBody ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F03/ship> ;
            sh:resultMessage "A thruster fitting must be represented among the ship components." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A thruster fitting must be represented among the ship components." ;
                    sh:path nltl:hasComponent ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:thrusterFitting ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F03/ship> ;
            sh:resultMessage "The ship must provide a load case confirming the maximum-load blade orientation." ;
            sh:resultPath nltl:hasLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a load case confirming the maximum-load blade orientation." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:loadCase ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:message "The load case must confirm the blade orientation producing the maximum component load." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ] ] ;
                    sh:path nltl:hasLoadCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F03/ship> ;
            sh:resultMessage "The ship must record the propeller blade orientation producing the maximum component load." ;
            sh:resultPath nltl:propellerBladeOrientation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must record the propeller blade orientation producing the maximum component load." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerBladeOrientation ] ] .

