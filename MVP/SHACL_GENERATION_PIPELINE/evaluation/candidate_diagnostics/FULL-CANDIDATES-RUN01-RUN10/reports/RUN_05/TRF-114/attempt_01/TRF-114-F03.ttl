@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/impact> ;
                    sh:resultMessage "The impact case must provide evidence for the loaded-area assessment." ;
                    sh:resultPath nltl:thrusterIceImpactLoadedAreaEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:message "The impact case must provide evidence for the loaded-area assessment." ;
                            sh:minCount 1 ;
                            sh:path nltl:thrusterIceImpactLoadedAreaEvidence ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/impact> ;
                    sh:resultMessage "Less than 1 values on ex:impact->nltl:thrusterIceImpactLoadCaseIdentifier" ;
                    sh:resultPath nltl:thrusterIceImpactLoadCaseIdentifier ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:thrusterIceImpactLoadCaseIdentifier ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:class nltl:thrusterIceImpactLoadCase ; sh:or ( [ sh:property [ sh:hasValue nltl:hemisphericalContactGeometry ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:contactGeometryClassification ] ] [ sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal("A non-hemispherical contact geometry requires correspondence evidence.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:contactGeometryCorrespondenceEvidence ], [ sh:hasValue nltl:nonHemisphericalContactGeometry ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:contactGeometryClassification ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A non-hemispherical contact geometry requires an equivalent impact sphere radius in metres.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:equivalentImpactSphereRadius ] ] ; sh:path [ sh:inversePath nltl:hasThrusterIceImpactLoadCase ] ] ] ) ; sh:property [ sh:class nltl:contactGeometryValue ; sh:in ( nltl:hemisphericalContactGeometry nltl:nonHemisphericalContactGeometry ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The impact case must classify its contact geometry as hemispherical or non-hemispherical.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:contactGeometryClassification ], [ sh:class nltl:evidenceArtifact ; sh:message Literal("The impact case must provide evidence for the loaded-area assessment.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:thrusterIceImpactLoadedAreaEvidence ], [ sh:class nltl:thrusterBody ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The impact case must identify the thruster body to which it applies.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:thrusterImpactCaseAppliesToBody ], [ sh:datatype xsd:string ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:thrusterIceImpactLoadCaseIdentifier ], [ sh:hasValue nltl:traficomTable6Dash16Reference ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The impact case must reference TRAFICOM Table 6-16 for its load case.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:impactLoadCaseTableReference ], [ sh:hasValue nltl:traficomTable6Dash3Reference ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The impact case must reference TRAFICOM Table 6-3 for the design ice block.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:designIceBlockTableReference ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterIceImpactDemand ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterIceImpactLoad ], [ sh:minCount Literal("0", datatype=xsd:integer) ; sh:path nltl:iceOperatingSpeed ] ; sh:sparql [ sh:message Literal("The externally assessed thruster resistance capacity must be at least the impact demand.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:thrusterImpactCaseAppliesToBody ?body .
                        $this nltl:thrusterIceImpactDemand ?demand .
                        ?body nltl:thrusterResistanceCapacity ?capacity .
                        ?demand qudt:numericValue ?demandValue .
                        ?capacity qudt:numericValue ?capacityValue .
                        FILTER (?capacityValue < ?demandValue)
                    }
                ") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasThrusterIceImpactLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:thrusterIceImpactLoadCase ;
                            sh:or ( [ sh:property [ sh:hasValue nltl:hemisphericalContactGeometry ;
                                                sh:minCount 1 ;
                                                sh:path nltl:contactGeometryClassification ] ] [ sh:property [ sh:class nltl:evidenceArtifact ;
                                                sh:message "A non-hemispherical contact geometry requires correspondence evidence." ;
                                                sh:minCount 1 ;
                                                sh:path nltl:contactGeometryCorrespondenceEvidence ],
                                            [ sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path [ ] ],
                                            [ sh:hasValue nltl:nonHemisphericalContactGeometry ;
                                                sh:minCount 1 ;
                                                sh:path nltl:contactGeometryClassification ] ] ) ;
                            sh:property [ sh:class nltl:evidenceArtifact ;
                                    sh:message "The impact case must provide evidence for the loaded-area assessment." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:thrusterIceImpactLoadedAreaEvidence ],
                                [ sh:minCount 0 ;
                                    sh:path nltl:iceOperatingSpeed ],
                                [ sh:class nltl:thrusterBody ;
                                    sh:maxCount 1 ;
                                    sh:message "The impact case must identify the thruster body to which it applies." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:thrusterImpactCaseAppliesToBody ],
                                [ sh:hasValue nltl:traficomTable6Dash3Reference ;
                                    sh:maxCount 1 ;
                                    sh:message "The impact case must reference TRAFICOM Table 6-3 for the design ice block." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:designIceBlockTableReference ],
                                [ sh:class nltl:contactGeometryValue ;
                                    sh:in ( nltl:hemisphericalContactGeometry nltl:nonHemisphericalContactGeometry ) ;
                                    sh:maxCount 1 ;
                                    sh:message "The impact case must classify its contact geometry as hemispherical or non-hemispherical." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:contactGeometryClassification ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thrusterIceImpactLoad ],
                                [ sh:hasValue nltl:traficomTable6Dash16Reference ;
                                    sh:maxCount 1 ;
                                    sh:message "The impact case must reference TRAFICOM Table 6-16 for its load case." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:impactLoadCaseTableReference ],
                                [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:thrusterIceImpactLoadCaseIdentifier ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:thrusterIceImpactDemand ] ;
                            sh:sparql [ sh:message "The externally assessed thruster resistance capacity must be at least the impact demand." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:thrusterImpactCaseAppliesToBody ?body .
                        $this nltl:thrusterIceImpactDemand ?demand .
                        ?body nltl:thrusterResistanceCapacity ?capacity .
                        ?demand qudt:numericValue ?demandValue .
                        ?capacity qudt:numericValue ?capacityValue .
                        FILTER (?capacityValue < ?demandValue)
                    }
                """ ] ] ;
                    sh:path nltl:hasThrusterIceImpactLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/impact> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/thrusterBody> ;
            sh:resultMessage "Less than 1 values on ex:thrusterBody->nltl:thrusterResistanceCapacity" ;
            sh:resultPath nltl:thrusterResistanceCapacity ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:thrusterResistanceCapacity ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/ship> ;
            sh:resultMessage "Every referenced thruster body must have an externally assessed resistance capacity in kilonewtons." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Every referenced thruster body must have an externally assessed resistance capacity in kilonewtons." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasThrusterIceImpactLoadCase ?case .
                ?case nltl:thrusterImpactCaseAppliesToBody ?body .
                FILTER NOT EXISTS {
                    ?body nltl:thrusterResistanceCapacity ?capacity .
                    ?capacity qudt:numericValue ?value .
                    ?capacity qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-114-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/ship> ;
            sh:resultMessage "The ship must provide a single ice operating speed in knots." ;
            sh:resultPath nltl:iceOperatingSpeed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide a single ice operating speed in knots." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:iceOperatingSpeed ] ] .

