@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/impact> ;
                    sh:resultMessage "Each impact case must provide evidence for the loaded impact area." ;
                    sh:resultPath nltl:thrusterIceImpactLoadedAreaEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:message "Each impact case must provide evidence for the loaded impact area." ;
                            sh:minCount 1 ;
                            sh:path nltl:thrusterIceImpactLoadedAreaEvidence ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/thrusterBody> ;
                            sh:resultMessage "The referenced thruster body must provide one externally assessed resistance capacity in kilonewtons." ;
                            sh:resultPath nltl:thrusterResistanceCapacity ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "The referenced thruster body must provide one externally assessed resistance capacity in kilonewtons." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thrusterResistanceCapacity ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/impact> ;
                    sh:resultMessage "Each impact case must identify the thruster body to which it applies." ;
                    sh:resultPath nltl:thrusterImpactCaseAppliesToBody ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:thrusterBody ;
                            sh:maxCount 1 ;
                            sh:message "Each impact case must identify the thruster body to which it applies." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:TRF-114-ThrusterBodyShape> ;
                            sh:path nltl:thrusterImpactCaseAppliesToBody ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/thrusterBody> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF-114-ImpactCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasThrusterIceImpactLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:TRF-114-ImpactCaseShape> ;
                    sh:path nltl:hasThrusterIceImpactLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/impact> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F03/ship> ;
            sh:resultMessage "The ship must provide one typical ice operating speed in knots." ;
            sh:resultPath nltl:iceOperatingSpeed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one typical ice operating speed in knots." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:iceOperatingSpeed ] ] .

