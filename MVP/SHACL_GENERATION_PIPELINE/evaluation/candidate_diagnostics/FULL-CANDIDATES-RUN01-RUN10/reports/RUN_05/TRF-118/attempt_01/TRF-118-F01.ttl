@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/component> ;
                            sh:resultMessage "The assessed thruster component must provide material properties." ;
                            sh:resultPath nltl:hasMaterialProperties ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:class nltl:materialProperties ;
                                    sh:message "The assessed thruster component must provide material properties." ;
                                    sh:minCount 1 ;
                                    sh:node gen:MaterialPropertiesShape ;
                                    sh:path nltl:hasMaterialProperties ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/assessment> ;
                    sh:resultMessage "The assessment must identify the assessed thruster component." ;
                    sh:resultPath nltl:assessedThrusterComponent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:shipComponent ;
                            sh:message "The assessment must identify the assessed thruster component." ;
                            sh:minCount 1 ;
                            sh:node gen:AssessedThrusterComponentShape ;
                            sh:path nltl:assessedThrusterComponent ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/component> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/assessment> ;
                    sh:resultMessage "The assessment must confirm that no repair is required." ;
                    sh:resultPath nltl:assessmentRepairRequired ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue false ;
                            sh:maxCount 1 ;
                            sh:message "The assessment must confirm that no repair is required." ;
                            sh:minCount 1 ;
                            sh:path nltl:assessmentRepairRequired ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/assessment> ;
                    sh:resultMessage "The assessment must confirm that operability is maintained." ;
                    sh:resultPath nltl:assessmentOperabilityMaintained ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "The assessment must confirm that operability is maintained." ;
                            sh:minCount 1 ;
                            sh:path nltl:assessmentOperabilityMaintained ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/ship> ;
            sh:resultMessage "The ship must provide an externally assessed factored extreme-load operability assessment." ;
            sh:resultPath nltl:hasFactoredExtremeLoadOperabilityAssessment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:factoredExtremeLoadOperabilityAssessment ;
                    sh:message "The ship must provide an externally assessed factored extreme-load operability assessment." ;
                    sh:minCount 1 ;
                    sh:node gen:AssessmentCaseShape ;
                    sh:path nltl:hasFactoredExtremeLoadOperabilityAssessment ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/assessment> ] .

