@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:totalRelevantEnginePower" ;
            sh:resultPath nltl:totalRelevantEnginePower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:totalRelevantEnginePower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/ship> ;
            sh:resultMessage "When the volume and height requirements are met, at least one inlet chest must have the required calculated volume, strainer-area threshold, and derived strainer open-area ratio." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the volume and height requirements are met, at least one inlet chest must have the required calculated volume, strainer-area threshold, and derived strainer open-area ratio." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet false .
                FILTER NOT EXISTS {
                    $this nltl:totalRelevantEnginePower ?tp .
                    ?tp qudt:numericValue ?tv .
                    $this nltl:hasComponent ?ch .
                    ?ch a nltl:inletChest .
                    ?ch nltl:recommendedChestVolume ?rvn .
                    ?rvn qudt:numericValue ?rv .
                    ?ch nltl:strainerOpenArea ?oan .
                    ?oan qudt:numericValue ?oa .
                    ?ch nltl:inletPipeArea ?ian .
                    ?ian qudt:numericValue ?ia .
                    ?ch nltl:strainerOpenAreaRatio ?rrn .
                    ?rrn qudt:numericValue ?rr .
                    FILTER (?ia > 0)
                    BIND (?tv / 750 AS ?expectedVolume)
                    BIND (?oa / ?ia AS ?expectedRatio)
                    BIND (IF(ABS(?expectedVolume) * 0.000001 > 0.000001,
                             ABS(?expectedVolume) * 0.000001,
                             0.000001) AS ?volumeTolerance)
                    BIND (IF(ABS(?expectedRatio) * 0.000001 > 0.000001,
                             ABS(?expectedRatio) * 0.000001,
                             0.000001) AS ?ratioTolerance)
                    FILTER (ABS(?rv - ?expectedVolume) <= ?volumeTolerance)
                    FILTER (?oa >= 4 * ?ia)
                    FILTER (ABS(?rr - ?expectedRatio) <= ?ratioTolerance)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF130Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ], [ sh:path nltl:hasComponent ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:node gen:TRF130NormalChestShape ] ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestAlternativeArrangementUsed ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ], [ sh:path nltl:hasComponent ; sh:qualifiedMinCount Literal(\"2\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:node gen:TRF130AlternativeChestShape ] ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF130Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:maximumContinuousRatingPower" ;
            sh:resultPath nltl:maximumContinuousRatingPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:maximumContinuousRatingPower ] ] .

