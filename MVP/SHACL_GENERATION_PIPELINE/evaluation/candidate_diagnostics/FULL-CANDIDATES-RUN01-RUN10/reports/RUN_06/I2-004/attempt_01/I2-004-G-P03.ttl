@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-P03/ship> ;
            sh:resultMessage "The upper ice waterline displacement must equal the greatest displacement among the linked upper ice waterline cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The upper ice waterline displacement must equal the greatest displacement among the linked upper ice waterline cases." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this
WHERE {
    $this nltl:upperIceWaterlineDisplacement ?duiQuantity .
    ?duiQuantity qudt:numericValue ?duiValue .

    $this nltl:hasUpperIceWaterlineCase ?matchingCase .
    ?matchingCase nltl:waterlineCaseDisplacement ?matchingQuantity .
    ?matchingQuantity qudt:numericValue ?matchingValue .
    FILTER (?matchingValue = ?duiValue)

    FILTER NOT EXISTS {
        $this nltl:hasUpperIceWaterlineCase ?greaterCase .
        ?greaterCase nltl:waterlineCaseDisplacement ?greaterQuantity .
        ?greaterQuantity qudt:numericValue ?greaterValue .
        FILTER (?greaterValue > ?duiValue)
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-004> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-P03/ship> ] .

