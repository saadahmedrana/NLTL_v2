@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "The local ice pressure input is required." ;
            sh:resultPath nltl:localIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The local ice pressure input is required." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_008_PressureQuantityShape ;
                    sh:path nltl:localIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "The load patch height input is required." ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The load patch height input is required." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_008_LengthQuantityShape ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "The load patch length input is required." ;
            sh:resultPath nltl:loadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The load patch length input is required." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_008_LengthQuantityShape ;
                    sh:path nltl:loadPatchLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "The externally calculated average ice pressure is required." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The externally calculated average ice pressure is required." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_008_PressureQuantityShape ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/bowCase> ;
                    sh:resultMessage "Each bow subregion case requires an externally calculated bow shape coefficient." ;
                    sh:resultPath nltl:bowShapeCoefficient ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each bow subregion case requires an externally calculated bow shape coefficient." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_008_DimensionlessQuantityShape ;
                            sh:path nltl:bowShapeCoefficient ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "At least one bow subregion calculation case is required." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:bowSubregionCalculationCase ;
                    sh:message "At least one bow subregion calculation case is required." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_008_BowSubregionCaseShape ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/bowCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "The externally calculated shape coefficient is required." ;
            sh:resultPath nltl:shapeCoefficient ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The externally calculated shape coefficient is required." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_008_DimensionlessQuantityShape ;
                    sh:path nltl:shapeCoefficient ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "The externally calculated line load is required." ;
            sh:resultPath nltl:lineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The externally calculated line load is required." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_008_LineLoadQuantityShape ;
                    sh:path nltl:lineLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "The externally calculated total glancing impact force is required." ;
            sh:resultPath nltl:totalGlancingImpactForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The externally calculated total glancing impact force is required." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_008_ForceQuantityShape ;
                    sh:path nltl:totalGlancingImpactForce ] ] .

