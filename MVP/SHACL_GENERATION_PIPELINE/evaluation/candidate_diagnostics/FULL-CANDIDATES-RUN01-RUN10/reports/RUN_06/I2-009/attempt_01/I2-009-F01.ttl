@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "Bow-form applicability shall be recorded as a boolean." ;
            sh:resultPath nltl:bowFormApplicability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Bow-form applicability shall be recorded as a boolean." ;
                    sh:minCount 1 ;
                    sh:path nltl:bowFormApplicability ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "A ship shall provide the normal frame angle in degrees." ;
            sh:resultPath nltl:normalFrameAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A ship shall provide the normal frame angle in degrees." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-AngleValueShape> ;
                    sh:path nltl:normalFrameAngle ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ar> ;
                    sh:resultMessage "Value is not >= Literal(\"3.6\", datatype=xsd:decimal)" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:maxInclusive 3.6 ;
                            sh:minCount 1 ;
                            sh:minInclusive 3.6 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 3.5 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "The load patch aspect ratio shall be exactly 3.6 and dimensionless." ;
            sh:resultPath nltl:loadPatchAspectRatio ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The load patch aspect ratio shall be exactly 3.6 and dimensionless." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-AspectRatioValueShape> ;
                    sh:path nltl:loadPatchAspectRatio ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ar> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "A ship shall provide its hull area." ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "A ship shall provide its hull area." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/assignment> ;
                    sh:resultMessage "The hull-area assignment shall identify a permitted ice-strengthened hull area." ;
                    sh:resultPath nltl:assignedHullArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:hullAreaValue ;
                            sh:in ( nltl:bowIntermediateBottomHullArea nltl:midbodyBottomHullArea nltl:sternBottomHullArea ) ;
                            sh:maxCount 1 ;
                            sh:message "The hull-area assignment shall identify a permitted ice-strengthened hull area." ;
                            sh:minCount 1 ;
                            sh:path nltl:assignedHullArea ] ;
                    sh:value nltl:otherIceStrengthenedArea ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "A ship shall provide its hull-area assignment." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A ship shall provide its hull-area assignment." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-HullAreaAssignmentShape> ;
                    sh:path nltl:hasHullAreaAssignment ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/assignment> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "A ship shall provide the buttock angle in degrees." ;
            sh:resultPath nltl:buttockAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A ship shall provide the buttock angle in degrees." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-AngleValueShape> ;
                    sh:path nltl:buttockAngle ] ] .

