@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F02/ship> ;
            sh:resultMessage "A ship shall provide the normal frame angle in degrees." ;
            sh:resultPath nltl:normalFrameAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A ship shall provide the normal frame angle in degrees." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-AngleValueShape> ;
                    sh:path nltl:normalFrameAngle ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F02/ship> ;
            sh:resultMessage "A ship shall provide its hull-area assignment." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A ship shall provide its hull-area assignment." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-HullAreaAssignmentShape> ;
                    sh:path nltl:hasHullAreaAssignment ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F02/ship> ;
            sh:resultMessage "A ship shall provide the buttock angle in degrees." ;
            sh:resultPath nltl:buttockAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A ship shall provide the buttock angle in degrees." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-AngleValueShape> ;
                    sh:path nltl:buttockAngle ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F02/ship> ;
            sh:resultMessage "Bow-form applicability shall be recorded as a boolean." ;
            sh:resultPath nltl:bowFormApplicability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Bow-form applicability shall be recorded as a boolean." ;
                    sh:minCount 1 ;
                    sh:path nltl:bowFormApplicability ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F02/ship> ;
            sh:resultMessage "A ship shall provide its hull area." ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "A ship shall provide its hull area." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ] .

