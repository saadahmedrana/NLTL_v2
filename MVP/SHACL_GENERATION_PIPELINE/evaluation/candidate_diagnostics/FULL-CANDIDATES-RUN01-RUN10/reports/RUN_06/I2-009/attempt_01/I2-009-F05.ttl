@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F05/ship> ;
            sh:resultMessage "A ship shall provide its hull area." ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "A ship shall provide its hull area." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F05/ship> ;
            sh:resultMessage "The load patch aspect ratio shall be exactly 3.6 and dimensionless." ;
            sh:resultPath nltl:loadPatchAspectRatio ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The load patch aspect ratio shall be exactly 3.6 and dimensionless." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-AspectRatioValueShape> ;
                    sh:path nltl:loadPatchAspectRatio ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F05/ship> ;
            sh:resultMessage "A ship shall provide average ice pressure in MPa." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A ship shall provide average ice pressure in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-PressureValueShape> ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F05/ship> ;
            sh:resultMessage "A ship shall provide the non-bow load patch height in metres." ;
            sh:resultPath nltl:nonBowLoadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A ship shall provide the non-bow load patch height in metres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-LengthValueShape> ;
                    sh:path nltl:nonBowLoadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F05/ship> ;
            sh:resultMessage "A ship shall provide its hull-area assignment." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A ship shall provide its hull-area assignment." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-HullAreaAssignmentShape> ;
                    sh:path nltl:hasHullAreaAssignment ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F05/ship> ;
            sh:resultMessage "Bow-form applicability shall be true exactly when the buttock angle is positive and below 80 degrees and the normal frame angle is greater than 10 degrees." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Bow-form applicability shall be true exactly when the buttock angle is positive and below 80 degrees and the normal frame angle is greater than 10 degrees." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this
WHERE {
    ?this nltl:bowFormApplicability ?app .
    ?this nltl:buttockAngle ?gammaNode .
    ?gammaNode qudt:numericValue ?gamma .
    ?this nltl:normalFrameAngle ?betaNode .
    ?betaNode qudt:numericValue ?beta .
    FILTER (
        (?app = true && !((?gamma > 0) && (?gamma < 80) && (?beta > 10)))
        ||
        (?app = false && ((?gamma > 0) && (?gamma < 80) && (?beta > 10)))
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-009-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F05/ship> ;
            sh:resultMessage "A ship shall provide the non-bow load patch length in metres." ;
            sh:resultPath nltl:nonBowLoadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A ship shall provide the non-bow load patch length in metres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-LengthValueShape> ;
                    sh:path nltl:nonBowLoadPatchLength ] ] .

