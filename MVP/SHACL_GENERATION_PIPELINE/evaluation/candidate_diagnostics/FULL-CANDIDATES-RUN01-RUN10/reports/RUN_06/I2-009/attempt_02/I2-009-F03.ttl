@prefix ex: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ;
            sh:resultMessage "The normal frame angle must be supplied as an angle in degrees." ;
            sh:resultPath nltl:normalFrameAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The normal frame angle must be supplied as an angle in degrees." ;
                    sh:minCount 1 ;
                    sh:node ex:I2_009_AngleQuantityShape ;
                    sh:path nltl:normalFrameAngle ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ;
            sh:resultMessage "The buttock angle must be supplied as an angle in degrees." ;
            sh:resultPath nltl:buttockAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The buttock angle must be supplied as an angle in degrees." ;
                    sh:minCount 1 ;
                    sh:node ex:I2_009_AngleQuantityShape ;
                    sh:path nltl:buttockAngle ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/assignment> ;
                    sh:resultMessage "The hull-area assignment must identify an allowed other ice-strengthened area or its permitted regional value." ;
                    sh:resultPath nltl:assignedHullArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:hullAreaValue ;
                            sh:in ( nltl:otherIceStrengthenedArea nltl:otherIceStrengthenedAreaValue nltl:bowIntermediateBottomHullArea nltl:midbodyBottomHullArea nltl:sternBottomHullArea ) ;
                            sh:maxCount 1 ;
                            sh:message "The hull-area assignment must identify an allowed other ice-strengthened area or its permitted regional value." ;
                            sh:minCount 1 ;
                            sh:path nltl:assignedHullArea ] ;
                    sh:value nltl:bowRegion ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ;
            sh:resultMessage "The ship must provide a hull-area assignment for the applicable ice-strengthened area." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:hullAreaAssignment ;
                    sh:message "The ship must provide a hull-area assignment for the applicable ice-strengthened area." ;
                    sh:minCount 1 ;
                    sh:node ex:I2_009_HullAreaAssignmentShape ;
                    sh:path nltl:hasHullAreaAssignment ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/assignment> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ;
            sh:resultMessage "The ship must identify the hull area covered by this requirement." ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must identify the hull area covered by this requirement." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ] .

