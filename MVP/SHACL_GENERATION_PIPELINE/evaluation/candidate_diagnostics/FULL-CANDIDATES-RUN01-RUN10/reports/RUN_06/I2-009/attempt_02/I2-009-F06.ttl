@prefix ex: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "Design ice forces are applicable only when the buttock angle is greater than 0 degrees and less than 80 degrees, and the normal frame angle is greater than 10 degrees." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Design ice forces are applicable only when the buttock angle is greater than 0 degrees and less than 80 degrees, and the normal frame angle is greater than 10 degrees." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:buttockAngle ?buttockQuantity .
                ?buttockQuantity qudt:numericValue ?buttockAngle .

                $this nltl:normalFrameAngle ?frameQuantity .
                ?frameQuantity qudt:numericValue ?frameAngle .

                FILTER (
                    ?buttockAngle <= 0 ||
                    ?buttockAngle >= 80 ||
                    ?frameAngle <= 10
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape ex:I2_009_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "The load-patch aspect ratio must be supplied and equal 3.6." ;
            sh:resultPath nltl:loadPatchAspectRatio ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The load-patch aspect ratio must be supplied and equal 3.6." ;
                    sh:minCount 1 ;
                    sh:node ex:I2_009_LoadPatchAspectRatioShape ;
                    sh:path nltl:loadPatchAspectRatio ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "The ship must identify the hull area covered by this requirement." ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must identify the hull area covered by this requirement." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "The non-bow load-patch length must be supplied as a length in metres." ;
            sh:resultPath nltl:nonBowLoadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The non-bow load-patch length must be supplied as a length in metres." ;
                    sh:minCount 1 ;
                    sh:node ex:I2_009_LengthQuantityShape ;
                    sh:path nltl:nonBowLoadPatchLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "The ship must provide a hull-area assignment for the applicable ice-strengthened area." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:hullAreaAssignment ;
                    sh:message "The ship must provide a hull-area assignment for the applicable ice-strengthened area." ;
                    sh:minCount 1 ;
                    sh:node ex:I2_009_HullAreaAssignmentShape ;
                    sh:path nltl:hasHullAreaAssignment ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "Average ice pressure must be supplied as a pressure quantity in MPa." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Average ice pressure must be supplied as a pressure quantity in MPa." ;
                    sh:minCount 1 ;
                    sh:node ex:I2_009_AverageIcePressureShape ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "The non-bow load-patch height must be supplied as a length in metres." ;
            sh:resultPath nltl:nonBowLoadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The non-bow load-patch height must be supplied as a length in metres." ;
                    sh:minCount 1 ;
                    sh:node ex:I2_009_LengthQuantityShape ;
                    sh:path nltl:nonBowLoadPatchHeight ] ] .

