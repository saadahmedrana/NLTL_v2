@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode nltl:otherIceStrengthenedAreaValue ;
            sh:resultMessage "The other ice-strengthened area value must select an allowed hull region." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape nltl:StaticI2_009OtherAreaValueShape ;
            sh:value nltl:otherIceStrengthenedAreaValue ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ;
            sh:resultMessage "For the applicable bow form, the normal frame angle must be greater than 10 degrees." ;
            sh:resultPath nltl:normalFrameAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "For the applicable bow form, the normal frame angle must be greater than 10 degrees." ;
                    sh:minCount 1 ;
                    sh:node nltl:StaticI2_009NormalFrameAngleShape ;
                    sh:path nltl:normalFrameAngle ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ;
            sh:resultMessage "The ship must provide its hull-area designation." ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must provide its hull-area designation." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/assignment> ;
                    sh:resultMessage "The hull-area assignment must identify an allowed ice-strengthened area, including other ice-strengthened areas." ;
                    sh:resultPath nltl:assignedHullArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:otherIceStrengthenedArea nltl:bowIntermediateBottomHullArea nltl:midbodyBottomHullArea nltl:sternBottomHullArea ) ;
                            sh:message "The hull-area assignment must identify an allowed ice-strengthened area, including other ice-strengthened areas." ;
                            sh:minCount 1 ;
                            sh:path nltl:assignedHullArea ] ;
                    sh:value nltl:bowRegion ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ;
            sh:resultMessage "The ship must provide a hull-area assignment for the applicable ice-strengthened area." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:hullAreaAssignment ;
                    sh:message "The ship must provide a hull-area assignment for the applicable ice-strengthened area." ;
                    sh:minCount 1 ;
                    sh:node nltl:StaticI2_009HullAreaAssignmentShape ;
                    sh:path nltl:hasHullAreaAssignment ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/assignment> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ;
            sh:resultMessage "For the applicable bow form, the buttock angle must be greater than 0 degrees and less than 80 degrees." ;
            sh:resultPath nltl:buttockAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "For the applicable bow form, the buttock angle must be greater than 0 degrees and less than 80 degrees." ;
                    sh:minCount 1 ;
                    sh:node nltl:StaticI2_009ButtockAngleShape ;
                    sh:path nltl:buttockAngle ] ] .

