@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/ship> ;
            sh:resultMessage "Average ice pressure must be supplied as a single MPa quantity." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Average ice pressure must be supplied as a single MPa quantity." ;
                    sh:minCount 1 ;
                    sh:node nltl:StaticI2_009PressureQuantityShape ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/ship> ;
            sh:resultMessage "The non-bow load-patch length must be supplied as a single metre quantity." ;
            sh:resultPath nltl:nonBowLoadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The non-bow load-patch length must be supplied as a single metre quantity." ;
                    sh:minCount 1 ;
                    sh:node nltl:StaticI2_009LengthQuantityShape ;
                    sh:path nltl:nonBowLoadPatchLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:otherIceStrengthenedAreaValue ;
            sh:resultMessage "The other ice-strengthened area value must select an allowed hull region." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape nltl:StaticI2_009OtherAreaValueShape ;
            sh:value nltl:otherIceStrengthenedAreaValue ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/ship> ;
            sh:resultMessage "The ship must provide its hull-area designation." ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must provide its hull-area designation." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/ship> ;
            sh:resultMessage "The ship must provide a hull-area assignment for the applicable ice-strengthened area." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:hullAreaAssignment ;
                    sh:message "The ship must provide a hull-area assignment for the applicable ice-strengthened area." ;
                    sh:minCount 1 ;
                    sh:node nltl:StaticI2_009HullAreaAssignmentShape ;
                    sh:path nltl:hasHullAreaAssignment ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/ship> ;
            sh:resultMessage "The load-patch aspect ratio must be exactly 3.6 and dimensionless." ;
            sh:resultPath nltl:loadPatchAspectRatio ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The load-patch aspect ratio must be exactly 3.6 and dimensionless." ;
                    sh:minCount 1 ;
                    sh:node nltl:StaticI2_009AspectRatioShape ;
                    sh:path nltl:loadPatchAspectRatio ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/ship> ;
            sh:resultMessage "The non-bow load-patch height must be supplied as a single metre quantity." ;
            sh:resultPath nltl:nonBowLoadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The non-bow load-patch height must be supplied as a single metre quantity." ;
                    sh:minCount 1 ;
                    sh:node nltl:StaticI2_009LengthQuantityShape ;
                    sh:path nltl:nonBowLoadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/gamma> ;
                    sh:resultMessage "Value is not > Literal(\"0\", datatype=xsd:integer)" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinExclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:maxExclusive 80 ;
                            sh:minCount 1 ;
                            sh:minExclusive 0 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 0.0 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/ship> ;
            sh:resultMessage "For the applicable bow form, the buttock angle must be greater than 0 degrees and less than 80 degrees." ;
            sh:resultPath nltl:buttockAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "For the applicable bow form, the buttock angle must be greater than 0 degrees and less than 80 degrees." ;
                    sh:minCount 1 ;
                    sh:node nltl:StaticI2_009ButtockAngleShape ;
                    sh:path nltl:buttockAngle ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/gamma> ] .

