@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hullArea" ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ar> ;
                    sh:resultMessage "Value is not >= Literal(\"3.6\", datatype=xsd:decimal)" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:maxInclusive 3.6 ;
                            sh:minCount 1 ;
                            sh:minInclusive 3.6 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 3.5 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "The load patch aspect ratio must be exactly 3.6." ;
            sh:resultPath nltl:loadPatchAspectRatio ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The load patch aspect ratio must be exactly 3.6." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 3.6 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 3.6 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:loadPatchAspectRatio ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ar> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "The buttock angle must be greater than 0 degrees and less than 80 degrees." ;
            sh:resultPath nltl:buttockAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The buttock angle must be greater than 0 degrees and less than 80 degrees." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxExclusive 80 ;
                                    sh:minCount 1 ;
                                    sh:minExclusive 0 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:buttockAngle ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "The normal frame angle must be greater than 10 degrees." ;
            sh:resultPath nltl:normalFrameAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The normal frame angle must be greater than 10 degrees." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:minExclusive 10 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:normalFrameAngle ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/assignment> ;
                    sh:resultMessage "The hull area assignment must select a permitted hull area." ;
                    sh:resultPath nltl:assignedHullArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:bowIntermediateBottomHullArea nltl:midbodyBottomHullArea nltl:sternBottomHullArea ) ;
                            sh:maxCount 1 ;
                            sh:message "The hull area assignment must select a permitted hull area." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:assignedHullArea ] ;
                    sh:value nltl:otherIceStrengthenedArea ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "A hull area assignment is required for the static ice-load case." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A hull area assignment is required for the static ice-load case." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:hullAreaAssignment ;
                            sh:property [ sh:in ( nltl:bowIntermediateBottomHullArea nltl:midbodyBottomHullArea nltl:sternBottomHullArea ) ;
                                    sh:maxCount 1 ;
                                    sh:message "The hull area assignment must select a permitted hull area." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:assignedHullArea ] ] ;
                    sh:path nltl:hasHullAreaAssignment ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/assignment> ] .

