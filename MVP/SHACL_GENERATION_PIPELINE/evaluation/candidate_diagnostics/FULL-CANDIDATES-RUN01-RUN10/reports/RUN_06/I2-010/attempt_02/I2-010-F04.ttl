@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F04/ship> ;
            sh:resultMessage "The bow design force method must be I2.3.2.1 (iv)." ;
            sh:resultPath nltl:bowDesignForceMethod ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:hasValue "I2.3.2.1 (iv)" ;
                    sh:maxCount 1 ;
                    sh:message "The bow design force method must be I2.3.2.1 (iv)." ;
                    sh:minCount 1 ;
                    sh:path nltl:bowDesignForceMethod ] ] .

