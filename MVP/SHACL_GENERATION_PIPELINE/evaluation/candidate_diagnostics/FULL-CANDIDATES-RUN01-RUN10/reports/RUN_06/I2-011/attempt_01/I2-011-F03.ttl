@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F03/ship> ;
            sh:resultMessage "For an applicable PC6 or PC7 ship with a bulbous bow, bowDesignForce must equal the greater of the two method forces, converted from MN to kN, within a relative tolerance of 1e-6 and an absolute fallback of 1e-9 kN." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an applicable PC6 or PC7 ship with a bulbous bow, bowDesignForce must equal the greater of the two method forces, converted from MN to kN, within a relative tolerance of 1e-6 and an absolute fallback of 1e-9 kN." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bulbousBowPresent true ;
                      nltl:polarClass ?polarClass ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivNode ;
                      nltl:bowDesignForce ?resultNode .

                FILTER (
                    ?polarClass = nltl:polarClassPc6 ||
                    ?polarClass = nltl:polarClassPc7
                )

                ?iiiNode qudt:numericValue ?iii .
                ?ivNode qudt:numericValue ?iv .
                ?resultNode qudt:numericValue ?result .

                BIND (
                    IF(?iii >= ?iv, ?iii, ?iv) * 1000
                    AS ?expected
                )
                BIND (
                    (1e-6 * ABS(?expected)) + 1e-9
                    AS ?tolerance
                )

                FILTER (ABS(?result - ?expected) > ?tolerance)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2_011> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F03/ship> ] .

