@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F06/ship> ;
            sh:resultMessage "Selected bow force, line load, and pressure must equal the corresponding case maxima within a tolerance scaled from each expected maximum." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Selected bow force, line load, and pressure must equal the corresponding case maxima within a tolerance scaled from each expected maximum." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    SELECT $this
                           (MAX(?force) AS ?maxForce)
                           (MAX(?lineLoad) AS ?maxLineLoad)
                           (MAX(?pressure) AS ?maxPressure)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedForce ?forceNode ;
                              nltl:bowSubregionCalculatedLineLoad ?lineLoadNode ;
                              nltl:bowSubregionCalculatedPressure ?pressureNode .
                        ?forceNode qudt:numericValue ?force .
                        ?lineLoadNode qudt:numericValue ?lineLoad .
                        ?pressureNode qudt:numericValue ?pressure .
                    }
                    GROUP BY $this
                }
                $this nltl:selectedMaximumBowForce ?selectedForceNode ;
                      nltl:selectedMaximumBowLineLoad ?selectedLineLoadNode ;
                      nltl:selectedMaximumBowPressure ?selectedPressureNode .
                ?selectedForceNode qudt:numericValue ?selectedForce .
                ?selectedLineLoadNode qudt:numericValue ?selectedLineLoad .
                ?selectedPressureNode qudt:numericValue ?selectedPressure .
                FILTER (
                    ?selectedForce < (?maxForce - ((?maxForce * 0.000001) + 0.000000001)) ||
                    ?selectedForce > (?maxForce + ((?maxForce * 0.000001) + 0.000000001)) ||
                    ?selectedLineLoad < (?maxLineLoad - ((?maxLineLoad * 0.000001) + 0.000000001)) ||
                    ?selectedLineLoad > (?maxLineLoad + ((?maxLineLoad * 0.000001) + 0.000000001)) ||
                    ?selectedPressure < (?maxPressure - ((?maxPressure * 0.000001) + 0.000000001)) ||
                    ?selectedPressure > (?maxPressure + ((?maxPressure * 0.000001) + 0.000000001))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-014-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F06/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F06/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowSubregionCount" ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:maxInclusive 4 ;
                    sh:minCount 1 ;
                    sh:minInclusive 4 ;
                    sh:path nltl:bowSubregionCount ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F06/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowLength" ;
            sh:resultPath nltl:bowLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:bowLength ] ] .

