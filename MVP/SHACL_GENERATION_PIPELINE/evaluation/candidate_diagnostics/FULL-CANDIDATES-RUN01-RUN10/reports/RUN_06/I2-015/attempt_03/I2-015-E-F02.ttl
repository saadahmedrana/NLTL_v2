@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F02/ship> ;
            sh:resultMessage "A ship with an I2.3.1(v) bow-form case must provide beta i prime." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship with an I2.3.1(v) bow-form case must provide beta i prime." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowFormApplicabilityClassification
                      nltl:i231vBowFormApplicability .
                FILTER NOT EXISTS {
                    $this nltl:betaIPrime ?beta
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-015-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F02/ship> ;
            sh:resultMessage "A ship with an I2.3.1(v) bow-form case must provide the upper ice waterline length L_UI." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship with an I2.3.1(v) bow-form case must provide the upper ice waterline length L_UI." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowFormApplicabilityClassification
                      nltl:i231vBowFormApplicability .
                FILTER NOT EXISTS {
                    $this nltl:upperIceWaterlineLengthLUI ?lui
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-015-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F02/ship> ] .

