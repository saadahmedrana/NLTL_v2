@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/ship> ;
            sh:resultMessage "A ship with an I2.3.1(v) bow-form case must provide beta i prime." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship with an I2.3.1(v) bow-form case must provide beta i prime." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowFormApplicabilityClassification
                      nltl:i231vBowFormApplicability .
                FILTER NOT EXISTS {
                    $this nltl:betaIPrime ?beta
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-015-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/factorLookup> ;
                            sh:resultMessage "The failure-class lookup case must provide one flexural failure class factor." ;
                            sh:resultPath nltl:flexuralFailureClassFactor ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "The failure-class lookup case must provide one flexural failure class factor." ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:I2-015-Dimensionless> ;
                                    sh:path nltl:flexuralFailureClassFactor ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/bowCase> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The failure-class lookup case must provide one crushing failure class factor.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2-015-Dimensionless> ; sh:path nltl:crushingFailureClassFactor ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The failure-class lookup case must provide one flexural failure class factor.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2-015-Dimensionless> ; sh:path nltl:flexuralFailureClassFactor ] ]. See details for more information." ;
                    sh:resultPath nltl:hasFailureClassFactorLookupCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:tableLookupCase ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:maxCount 1 ;
                                            sh:message "The failure-class lookup case must provide one flexural failure class factor." ;
                                            sh:minCount 1 ;
                                            sh:node <urn:nltl:generated-shape:I2-015-Dimensionless> ;
                                            sh:path nltl:flexuralFailureClassFactor ],
                                        [ sh:maxCount 1 ;
                                            sh:message "The failure-class lookup case must provide one crushing failure class factor." ;
                                            sh:minCount 1 ;
                                            sh:node <urn:nltl:generated-shape:I2-015-Dimensionless> ;
                                            sh:path nltl:crushingFailureClassFactor ] ] ;
                            sh:path nltl:hasFailureClassFactorLookupCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/factorLookup> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/ship> ;
            sh:resultMessage "The ship must provide at least one bow subregion calculation case." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:bowSubregionCalculationCase ;
                    sh:message "The ship must provide at least one bow subregion calculation case." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-015-Case> ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/bowCase> ] .

