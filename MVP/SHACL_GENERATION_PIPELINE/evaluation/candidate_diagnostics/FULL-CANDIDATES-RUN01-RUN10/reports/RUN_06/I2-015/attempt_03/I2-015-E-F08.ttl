@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/ship> ;
            sh:resultMessage "The ship must provide at least one bow subregion calculation case." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:bowSubregionCalculationCase ;
                    sh:message "The ship must provide at least one bow subregion calculation case." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-015-Case> ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ] .

