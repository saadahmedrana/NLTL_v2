@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasBowSubregionCalculationCase" ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:bowSubregionCalculationCase ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:tableLookupCase ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:flexuralFailureClassFactor ],
                                                [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:crushingFailureClassFactor ] ] ;
                                    sh:path nltl:hasFailureClassFactorLookupCase ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue qudt:DEG ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:bowSubregionWaterlineAngle ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue qudt:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:bowShapeCoefficient ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue qudt:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:bowSubregionMidLengthPosition ],
                                [ sh:class nltl:bowFormApplicabilityValue ;
                                    sh:hasValue nltl:i231vBowFormApplicability ;
                                    sh:minCount 1 ;
                                    sh:path nltl:bowFormApplicabilityClassification ] ] ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/lui> ;
                    sh:resultMessage "Node ex:lui->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:upperIceWaterlineLengthLUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:upperIceWaterlineLengthLUI ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/lui> ] .

