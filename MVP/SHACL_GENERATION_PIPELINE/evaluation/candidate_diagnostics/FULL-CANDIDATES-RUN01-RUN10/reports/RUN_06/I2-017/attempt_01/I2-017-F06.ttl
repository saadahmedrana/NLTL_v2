@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-017-F06/ship> ;
            sh:resultMessage "The ship must provide a table lookup case containing the required class factors." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a table lookup case containing the required class factors." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_017_TableLookupCaseShape ;
                    sh:path nltl:hasTableLookupCase ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-017-F06/nonBowCase> ;
                    sh:resultMessage "The calculation case must contain an externally determined non-bow ice force." ;
                    sh:resultPath nltl:nonBowIceForce ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The calculation case must contain an externally determined non-bow ice force." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_017_NonBowIceForceShape ;
                            sh:path nltl:nonBowIceForce ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-017-F06/ship> ;
            sh:resultMessage "The ship must provide a non-bow ice-load calculation case with externally determined results." ;
            sh:resultPath nltl:hasNonBowIceLoadCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a non-bow ice-load calculation case with externally determined results." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_017_NonBowCalculationCaseShape ;
                    sh:path nltl:hasNonBowIceLoadCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-017-F06/nonBowCase> ] .

