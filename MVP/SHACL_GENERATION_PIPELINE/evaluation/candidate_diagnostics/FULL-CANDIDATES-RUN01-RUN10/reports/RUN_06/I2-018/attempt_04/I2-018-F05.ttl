@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchLength" ;
            sh:resultPath nltl:loadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:loadPatchLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchHeight" ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:iceForce" ;
            sh:resultPath nltl:iceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:KiloN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:iceForce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:peakPressureFactor" ;
            sh:resultPath nltl:peakPressureFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:peakPressureFactor ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/lookup> ;
                    sh:resultMessage "Less than 1 values on ex:lookup->nltl:lookupSelectionEvidence" ;
                    sh:resultPath nltl:lookupSelectionEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class nltl:evidenceArtifact ] ;
                            sh:path nltl:lookupSelectionEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:tableLookupCase ; sh:property [ sh:hasValue nltl:iacsUrI2Table3 ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:tableReference ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:evidenceArtifact ] ; sh:path nltl:lookupSelectionEvidence ] ]. See details for more information." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:tableLookupCase ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:evidenceArtifact ] ;
                                    sh:path nltl:lookupSelectionEvidence ],
                                [ sh:hasValue nltl:iacsUrI2Table3 ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:tableReference ] ] ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/lookup> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:averageIcePressure" ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:MegaPA ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/lookup> ;
                    sh:resultMessage "Less than 1 values on ex:lookup->nltl:lookupSelectionEvidence" ;
                    sh:resultPath nltl:lookupSelectionEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class nltl:evidenceArtifact ] ;
                            sh:path nltl:lookupSelectionEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:peakPressureFactorLookupCase, nltl:tableLookupCase ; sh:property [ sh:hasValue nltl:iacsUrI2Table3 ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:tableReference ], [ sh:in ( nltl:bottomStructureFrameCategory nltl:longitudinallyFramedPlatingCategory nltl:stringerSideLongitudinalOrWebFrameCategory nltl:transverseFrameWithLoadDistributingStringersCategory nltl:transverseFrameWithoutLoadDistributingStringersCategory nltl:transverselyFramedPlatingCategory ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:localizedStructuralMemberCategory ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:selectedPeakPressureFactor ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:evidenceArtifact ] ; sh:path nltl:lookupSelectionEvidence ] ]. See details for more information." ;
            sh:resultPath nltl:hasPeakPressureFactorLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:peakPressureFactorLookupCase,
                                nltl:tableLookupCase ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:evidenceArtifact ] ;
                                    sh:path nltl:lookupSelectionEvidence ],
                                [ sh:in ( nltl:bottomStructureFrameCategory nltl:longitudinallyFramedPlatingCategory nltl:stringerSideLongitudinalOrWebFrameCategory nltl:transverseFrameWithLoadDistributingStringersCategory nltl:transverseFrameWithoutLoadDistributingStringersCategory nltl:transverselyFramedPlatingCategory ) ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:localizedStructuralMemberCategory ],
                                [ sh:hasValue nltl:iacsUrI2Table3 ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:tableReference ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:selectedPeakPressureFactor ] ] ;
                    sh:path nltl:hasPeakPressureFactorLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/lookup> ] .

