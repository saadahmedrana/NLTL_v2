_:N0f3049790d3c4a39ab85b00dc28f18e7 sh:hasValue unit:UNITLESS ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

_:N6c714768187949648fbece9daebb28a2 sh:class qudt:QuantityValue ;
    sh:property _:N0f3049790d3c4a39ab85b00dc28f18e7,
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:n549cb2ee7208429d9480a45610836923b2 sh:class nltl:hullAreaValue ;
    sh:node gs:HullAreaValueShape ;
    sh:path nltl:hasSpannedHullArea .

_:n549cb2ee7208429d9480a45610836923b4 sh:message "selectedHullAreaFactor must equal the largest hullAreaFactor among the hull areas spanned by the structural member." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasSpannedHullArea ?area .
                ?area nltl:hullAreaFactor ?factorNode .
                ?factorNode qudt:numericValue ?expected .
                $this nltl:selectedHullAreaFactor ?selectedNode .
                ?selectedNode qudt:numericValue ?observed .
                FILTER (DATATYPE(?expected) = xsd:decimal)
                FILTER (DATATYPE(?observed) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:hasSpannedHullArea ?higherArea .
                    ?higherArea nltl:hullAreaFactor ?higherFactorNode .
                    ?higherFactorNode qudt:numericValue ?higher .
                    FILTER (?higher > ?expected)
                }
                FILTER (
                    ABS(?observed - ?expected) >
                    (ABS(?expected) * 0.000001 + 0.000000001)
                )
            }
        """ .

_:n549cb2ee7208429d9480a45610836923b5 sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node _:N6c714768187949648fbece9daebb28a2 ;
    sh:path nltl:hullAreaFactor .

