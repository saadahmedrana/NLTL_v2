@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/plating> ;
                    sh:resultMessage "For each plating item, thickness must equal the net ice-load thickness plus the corrosion and abrasion allowance, with millimetre-to-metre conversion and a relative tolerance of 1e-6." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "For each plating item, thickness must equal the net ice-load thickness plus the corrosion and abrasion allowance, with millimetre-to-metre conversion and a relative tolerance of 1e-6." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadRequiredNetPlateThickness ?netQuantity ;
                      nltl:corrosionAbrasionAllowance ?allowanceQuantity ;
                      nltl:thickness ?thicknessQuantity .
                ?netQuantity qudt:numericValue ?net ;
                             qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                ?allowanceQuantity qudt:numericValue ?allowance ;
                                     qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                ?thicknessQuantity qudt:numericValue ?observed ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                BIND((?net + ?allowance) / 1000 AS ?expected)
                BIND(IF(?expected < 0.001, 0.000001, ?expected * 0.000001) AS ?tolerance)
                FILTER(
                    (?observed - ?expected > ?tolerance) ||
                    (?observed - ?expected < (0 - ?tolerance))
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_021_PlatingShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_021_PlatingShape. See details for more information." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:plating ;
                    sh:minCount 1 ;
                    sh:node gen:I2_021_PlatingShape ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/plating> ] .

