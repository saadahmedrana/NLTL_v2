    ?resultQuantity a qudt:QuantityValue ;
      qudt:numericValue ?resultValue ;
      qudt:unit qudt:MilliM .
  }
}
") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:plating ;
                            sh:property [ sh:class nltl:hullAreaValue ;
                                    sh:maxCount 1 ;
