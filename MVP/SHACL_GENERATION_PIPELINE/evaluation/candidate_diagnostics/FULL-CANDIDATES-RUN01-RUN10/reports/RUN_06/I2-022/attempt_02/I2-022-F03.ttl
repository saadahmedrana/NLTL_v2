@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F03/plating> ;
                    sh:resultMessage "Applicable plating with framing angle at least 70 degrees must have the declared structural-member inputs, ship inputs, and externally computed net thickness result with the required units." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "Applicable plating with framing angle at least 70 degrees must have the declared structural-member inputs, ship inputs, and externally computed net thickness result with the required units." ;
                            sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
SELECT $this
WHERE {
  $this nltl:framingAngleOmega ?angleQuantity .
  ?angleQuantity qudt:numericValue ?angleValue .
  FILTER (?angleValue >= 70)

  ?ship nltl:hasPlating $this .

  FILTER NOT EXISTS {
    $this nltl:platingSupportedByStructuralMember ?member .
    ?member nltl:frameSpacing ?spacingQuantity .
    ?spacingQuantity a qudt:QuantityValue ;
      qudt:numericValue ?spacingValue ;
      qudt:unit qudt:M .
  }

  FILTER NOT EXISTS {
    $this nltl:platingSupportedByStructuralMember ?member2 .
    ?member2 nltl:selectedHullAreaFactor ?factorQuantity .
    ?factorQuantity a qudt:QuantityValue ;
      qudt:numericValue ?factorValue ;
      qudt:unit qudt:UNITLESS .
  }

  FILTER NOT EXISTS {
    ?ship nltl:averageIcePressure ?pressureQuantity .
    ?pressureQuantity a qudt:QuantityValue ;
      qudt:numericValue ?pressureValue ;
      qudt:unit qudt:MegaPA .
  }

  FILTER NOT EXISTS {
    ?ship nltl:peakPressureFactor ?peakFactorQuantity .
    ?peakFactorQuantity a qudt:QuantityValue ;
      qudt:numericValue ?peakFactorValue ;
      qudt:unit qudt:UNITLESS .
  }

  FILTER NOT EXISTS {
    ?ship nltl:yieldStrength ?yieldQuantity .
    ?yieldQuantity a qudt:QuantityValue ;
      qudt:numericValue ?yieldValue ;
      qudt:unit qudt:MegaPA .
  }

  FILTER NOT EXISTS {
    ?ship nltl:loadPatchHeight ?heightQuantity .
    ?heightQuantity a qudt:QuantityValue ;
      qudt:numericValue ?heightValue ;
      qudt:unit qudt:M .
  }

  FILTER NOT EXISTS {
    $this nltl:iceLoadRequiredNetPlateThickness ?resultQuantity .
    ?resultQuantity a qudt:QuantityValue ;
      qudt:numericValue ?resultValue ;
      qudt:unit qudt:MilliM .
  }
}
""" ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:plating ;
                            sh:property [ sh:class nltl:hullAreaValue ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:platingHullAreaClassification ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue qudt:DEG ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:framingAngleOmega ] ;
                            sh:sparql [ a sh:SPARQLConstraint ;
                                    sh:message "Applicable plating with framing angle at least 70 degrees must have the declared structural-member inputs, ship inputs, and externally computed net thickness result with the required units." ;
                                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
SELECT $this
WHERE {
  $this nltl:framingAngleOmega ?angleQuantity .
  ?angleQuantity qudt:numericValue ?angleValue .
  FILTER (?angleValue >= 70)

  ?ship nltl:hasPlating $this .

  FILTER NOT EXISTS {
    $this nltl:platingSupportedByStructuralMember ?member .
    ?member nltl:frameSpacing ?spacingQuantity .
    ?spacingQuantity a qudt:QuantityValue ;
      qudt:numericValue ?spacingValue ;
      qudt:unit qudt:M .
  }

  FILTER NOT EXISTS {
    $this nltl:platingSupportedByStructuralMember ?member2 .
    ?member2 nltl:selectedHullAreaFactor ?factorQuantity .
    ?factorQuantity a qudt:QuantityValue ;
      qudt:numericValue ?factorValue ;
      qudt:unit qudt:UNITLESS .
  }

  FILTER NOT EXISTS {
    ?ship nltl:averageIcePressure ?pressureQuantity .
    ?pressureQuantity a qudt:QuantityValue ;
      qudt:numericValue ?pressureValue ;
      qudt:unit qudt:MegaPA .
  }

  FILTER NOT EXISTS {
    ?ship nltl:peakPressureFactor ?peakFactorQuantity .
    ?peakFactorQuantity a qudt:QuantityValue ;
      qudt:numericValue ?peakFactorValue ;
      qudt:unit qudt:UNITLESS .
  }

  FILTER NOT EXISTS {
    ?ship nltl:yieldStrength ?yieldQuantity .
    ?yieldQuantity a qudt:QuantityValue ;
      qudt:numericValue ?yieldValue ;
      qudt:unit qudt:MegaPA .
  }

  FILTER NOT EXISTS {
    ?ship nltl:loadPatchHeight ?heightQuantity .
    ?heightQuantity a qudt:QuantityValue ;
      qudt:numericValue ?heightValue ;
      qudt:unit qudt:M .
  }

  FILTER NOT EXISTS {
    $this nltl:iceLoadRequiredNetPlateThickness ?resultQuantity .
    ?resultQuantity a qudt:QuantityValue ;
      qudt:numericValue ?resultValue ;
      qudt:unit qudt:MilliM .
  }
}
""" ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F03/plating> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F03/omega> ;
                            sh:resultMessage "Node ex:omega->qudt:unit does not contain a value in the set: ['qudt:DEG']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:DEG ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F03/plating> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:hasValue qudt:DEG ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ]. See details for more information." ;
                    sh:resultPath nltl:framingAngleOmega ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue qudt:DEG ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:framingAngleOmega ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F03/omega> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F03/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:class nltl:plating ; sh:property [ sh:class nltl:hullAreaValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:platingHullAreaClassification ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:hasValue qudt:DEG ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:framingAngleOmega ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("Applicable plating with framing angle at least 70 degrees must have the declared structural-member inputs, ship inputs, and externally computed net thickness result with the required units.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
SELECT $this
WHERE {
  $this nltl:framingAngleOmega ?angleQuantity .
  ?angleQuantity qudt:numericValue ?angleValue .
  FILTER (?angleValue >= 70)

  ?ship nltl:hasPlating $this .

  FILTER NOT EXISTS {
    $this nltl:platingSupportedByStructuralMember ?member .
    ?member nltl:frameSpacing ?spacingQuantity .
    ?spacingQuantity a qudt:QuantityValue ;
      qudt:numericValue ?spacingValue ;
      qudt:unit qudt:M .
  }

  FILTER NOT EXISTS {
    $this nltl:platingSupportedByStructuralMember ?member2 .
    ?member2 nltl:selectedHullAreaFactor ?factorQuantity .
    ?factorQuantity a qudt:QuantityValue ;
      qudt:numericValue ?factorValue ;
      qudt:unit qudt:UNITLESS .
  }

  FILTER NOT EXISTS {
    ?ship nltl:averageIcePressure ?pressureQuantity .
    ?pressureQuantity a qudt:QuantityValue ;
      qudt:numericValue ?pressureValue ;
      qudt:unit qudt:MegaPA .
  }

  FILTER NOT EXISTS {
    ?ship nltl:peakPressureFactor ?peakFactorQuantity .
    ?peakFactorQuantity a qudt:QuantityValue ;
      qudt:numericValue ?peakFactorValue ;
      qudt:unit qudt:UNITLESS .
  }

  FILTER NOT EXISTS {
    ?ship nltl:yieldStrength ?yieldQuantity .
    ?yieldQuantity a qudt:QuantityValue ;
      qudt:numericValue ?yieldValue ;
      qudt:unit qudt:MegaPA .
  }

  FILTER NOT EXISTS {
    ?ship nltl:loadPatchHeight ?heightQuantity .
    ?heightQuantity a qudt:QuantityValue ;
      qudt:numericValue ?heightValue ;
      qudt:unit qudt:M .
  }

  FILTER NOT EXISTS {
