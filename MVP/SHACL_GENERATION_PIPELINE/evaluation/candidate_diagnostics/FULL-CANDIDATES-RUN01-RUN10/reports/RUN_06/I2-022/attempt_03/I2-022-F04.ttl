@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:peakPressureFactor" ;
            sh:resultPath nltl:peakPressureFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-022-PeakPressureFactorShape> ;
                    sh:path nltl:peakPressureFactor ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchHeight" ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-022-LoadPatchHeightShape> ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F04/member> ;
                            sh:resultMessage "Less than 1 values on ex:member->nltl:frameSpacing" ;
                            sh:resultPath nltl:frameSpacing ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:I2-022-FrameSpacingShape> ;
                                    sh:path nltl:frameSpacing ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F04/plating> ;
                    sh:resultMessage "Applicable plating must identify a supporting structural member with the required calculation inputs." ;
                    sh:resultPath nltl:platingSupportedByStructuralMember ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Applicable plating must identify a supporting structural member with the required calculation inputs." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-022-StructuralMemberShape> ;
                            sh:path nltl:platingSupportedByStructuralMember ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F04/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F04/ship> ;
            sh:resultMessage "Each linked plating must provide the applicability evidence and externally computed net thickness required by I2-022." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked plating must provide the applicability evidence and externally computed net thickness required by I2-022." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-022-PlatingShape> ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F04/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:averageIcePressure" ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-022-AverageIcePressureShape> ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:yieldStrength" ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-022-YieldStrengthShape> ;
                    sh:path nltl:yieldStrength ] ] .

