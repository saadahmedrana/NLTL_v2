@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/plating> ;
                    sh:resultMessage "Each plating item requires the externally computed ice-load net plate thickness." ;
                    sh:resultPath nltl:iceLoadRequiredNetPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each plating item requires the externally computed ice-load net plate thickness." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-023-MilliMQuantityValueShape> ;
                            sh:path nltl:iceLoadRequiredNetPlateThickness ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship must provide the plating relationship required by the calculation model." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the plating relationship required by the calculation model." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-023-PlatingShape> ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship requires the peak pressure factor as an input to the external calculation." ;
            sh:resultPath nltl:peakPressureFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship requires the peak pressure factor as an input to the external calculation." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-023-UnitlessQuantityValueShape> ;
                    sh:path nltl:peakPressureFactor ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship requires frame span as an input to the external calculation." ;
            sh:resultPath nltl:frameSpan ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship requires frame span as an input to the external calculation." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-023-LengthQuantityValueShape> ;
                    sh:path nltl:frameSpan ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship requires average ice pressure as an input to the external calculation." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship requires average ice pressure as an input to the external calculation." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-023-QuantityValueShape> ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship requires yield strength as an input to the external calculation." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship requires yield strength as an input to the external calculation." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-023-QuantityValueShape> ;
                    sh:path nltl:yieldStrength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship requires load patch height as an input to the external calculation." ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship requires load patch height as an input to the external calculation." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-023-LengthQuantityValueShape> ;
                    sh:path nltl:loadPatchHeight ] ] .

