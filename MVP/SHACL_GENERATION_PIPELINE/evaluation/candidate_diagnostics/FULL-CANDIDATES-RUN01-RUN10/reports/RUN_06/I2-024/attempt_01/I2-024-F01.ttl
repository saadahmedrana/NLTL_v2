@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/ship> ;
            sh:resultMessage "The ship shall provide a calculation case containing the required framing thickness inputs." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide a calculation case containing the required framing thickness inputs." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-024-CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/lowerEndpoint> ;
                            sh:resultMessage "Each interpolation endpoint shall provide one coordinate." ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each interpolation endpoint shall provide one coordinate." ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:I2-024-CoordinateQuantityShape> ;
                                    sh:path nltl:interpolationPointCoordinate ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/case> ;
                    sh:resultMessage "The interpolation case shall provide a lower interpolation endpoint." ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The interpolation case shall provide a lower interpolation endpoint." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-024-InterpolationPointShape> ;
                            sh:path nltl:interpolationLowerEndpoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/lowerEndpoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/ship> ;
            sh:resultMessage "The ship shall provide an oblique plating interpolation case." ;
            sh:resultPath nltl:hasObliquePlatingInterpolationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide an oblique plating interpolation case." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-024-ObliqueCaseShape> ;
                    sh:path nltl:hasObliquePlatingInterpolationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/case> ] .

