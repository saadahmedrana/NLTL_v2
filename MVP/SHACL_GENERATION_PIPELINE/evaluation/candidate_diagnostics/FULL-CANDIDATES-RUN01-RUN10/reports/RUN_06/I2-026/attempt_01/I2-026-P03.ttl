@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P03/member> ;
                    sh:resultMessage "The frame support condition must be stated as fixed or simple support." ;
                    sh:resultPath nltl:frameSupportCondition ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The frame support condition must be stated as fixed or simple support." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:frameSupportConditionValue ] ;
                            sh:or ( [ sh:hasValue nltl:fixedFrameSupport ] [ sh:hasValue nltl:simpleFrameSupport ] ) ;
                            sh:path nltl:frameSupportCondition ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P03/member> ;
                    sh:resultMessage "Support fixity must be fixed for continuous members, members with a connection bracket, members with demonstrated significant rotational restraint, or members terminating within an ice-strengthened area; otherwise it must be simple. Demonstrated rotational restraint must have evidence." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Support fixity must be fixed for continuous members, members with a connection bracket, members with demonstrated significant rotational restraint, or members terminating within an ice-strengthened area; otherwise it must be simple. Demonstrated rotational restraint must have evidence." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?support
            WHERE {
                $this nltl:hasMemberSupport ?support ;
                      nltl:continuousThroughSupport ?continuous ;
                      nltl:terminatesWithinIceStrengthenedArea ?terminates .

                ?support nltl:connectionBracketPresent ?bracket ;
                         nltl:demonstratedRotationalRestraint ?restraint .

                FILTER (
                    (
                        (
                            ?continuous = true ||
                            ?bracket = true ||
                            ?restraint = true ||
                            ?terminates = true
                        )
                        &&
                        NOT EXISTS {
                            $this nltl:frameSupportCondition nltl:fixedFrameSupport
                        }
                    )
                    ||
                    (
                        ?continuous = false &&
                        ?bracket = false &&
                        ?restraint = false &&
                        ?terminates = false &&
                        NOT EXISTS {
                            $this nltl:frameSupportCondition nltl:simpleFrameSupport
                        }
                    )
                    ||
                    (
                        ?restraint = true &&
                        NOT EXISTS {
                            ?support nltl:significantRotationalRestraintEvidence ?evidence
                        }
                    )
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_026_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P03/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P03/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_026_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:I2_026_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P03/member> ] .

