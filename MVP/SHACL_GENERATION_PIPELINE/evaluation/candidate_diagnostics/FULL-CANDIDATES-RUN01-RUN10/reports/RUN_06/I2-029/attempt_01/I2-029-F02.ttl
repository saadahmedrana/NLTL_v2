@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F02/case> ;
                    sh:resultMessage "Attached shell plating must be excluded from the shear area." ;
                    sh:resultPath nltl:attachedShellPlatingExcludedFromShearArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "Attached shell plating must be excluded from the shear area." ;
                            sh:minCount 1 ;
                            sh:path nltl:attachedShellPlatingExcludedFromShearArea ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F02/ship> ;
            sh:resultMessage "Each calculation case must satisfy the section modulus and shear area inclusion requirements." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each calculation case must satisfy the section modulus and shear area inclusion requirements." ;
                    sh:node <urn:nltl:generated-shape:I2-029-CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F02/case> ] .

