@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F04/case> ;
                    sh:resultMessage "Flange material inclusion in the shear area must be explicitly represented." ;
                    sh:resultPath nltl:flangeMaterialIncludedInShearArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:message "Flange material inclusion in the shear area must be explicitly represented." ;
                            sh:minCount 1 ;
                            sh:path nltl:flangeMaterialIncludedInShearArea ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F04/case> ;
                    sh:resultMessage "Node ex:case must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:flangeMaterialIncludedInShearArea ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:flangeMaterialIncludedInShearArea ], [ sh:message Literal(\"When flange material is included in the shear area, the linked structural member must have a fitted flange.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2-029-FlangeFittedMemberShape> ; sh:path nltl:sectionCalculationCaseStructuralMember ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-029-CalculationCaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F04/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F04/ship> ;
            sh:resultMessage "Each calculation case must satisfy the section modulus and shear area inclusion requirements." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each calculation case must satisfy the section modulus and shear area inclusion requirements." ;
                    sh:node <urn:nltl:generated-shape:I2-029-CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F04/case> ] .

