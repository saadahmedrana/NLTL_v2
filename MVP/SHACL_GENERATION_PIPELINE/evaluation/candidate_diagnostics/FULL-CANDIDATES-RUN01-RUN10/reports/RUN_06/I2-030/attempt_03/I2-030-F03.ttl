@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/ship> ;
            sh:resultMessage "Each calculation case must contain the paired local-frame structural-member inputs, plating angle, externally computed results, and interpolation evidence when 20 degrees < framingAngleOmega < 70 degrees." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each calculation case must contain the paired local-frame structural-member inputs, plating angle, externally computed results, and interpolation evidence when 20 degrees < framingAngleOmega < 70 degrees." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:hasStructuralMember ?member .
                    ?member nltl:hasLocalFrameSectionCalculationCase ?local .
                    ?local nltl:sectionCalculationCasePlating ?plating ;
                           nltl:sectionCalculationCaseStructuralMember ?linkedMember .
                    ?case nltl:plasticNeutralAxisHeight ?zna ;
                          nltl:interpolationLowerEndpoint ?lower ;
                          nltl:interpolationUpperEndpoint ?upper .
                    ?zna qudt:numericValue ?znaValue ;
                         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?member nltl:netEffectivePlasticSectionModulus ?z .
                    ?z qudt:numericValue ?zValue ;
                       qudt:unit <http://qudt.org/vocab/unit/CentiM3> .

                    ?linkedMember nltl:netLocalFrameFlangeArea ?afn ;
                                  nltl:webHeight ?hw ;
                                  nltl:netWebThickness ?twn ;
                                  nltl:netAttachedShellPlateThickness ?tpn ;
                                  nltl:frameSpacing ?s ;
                                  nltl:localFrameFlangeCentreHeight ?hfc ;
                                  nltl:webAngleToShellPlate ?phi ;
                                  nltl:webToFlangeCentreDistance ?bw .

                    ?afn qudt:numericValue ?afnValue ;
                         qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
                    ?hw qudt:numericValue ?hwValue ;
                        qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?twn qudt:numericValue ?twnValue ;
                         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?tpn qudt:numericValue ?tpnValue ;
                         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?s qudt:numericValue ?sValue ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                    ?hfc qudt:numericValue ?hfcValue ;
                         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?phi qudt:numericValue ?phiValue ;
                         qudt:unit <http://qudt.org/vocab/unit/DEG> .
                    ?bw qudt:numericValue ?bwValue ;
                        qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?plating nltl:framingAngleOmega ?omega .
                    ?omega qudt:numericValue ?omegaValue ;
                           qudt:unit <http://qudt.org/vocab/unit/DEG> .

                    ?lower nltl:interpolationPointCoordinate ?lowerCoordinate ;
                           nltl:interpolationPointResult ?lowerResult .
                    ?upper nltl:interpolationPointCoordinate ?upperCoordinate ;
                           nltl:interpolationPointResult ?upperResult .
                    ?lowerCoordinate qudt:numericValue ?lowerCoordinateValue ;
                                     qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    ?upperCoordinate qudt:numericValue ?upperCoordinateValue ;
                                     qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    ?lowerResult qudt:numericValue ?lowerResultValue .
                    ?upperResult qudt:numericValue ?upperResultValue .

                    FILTER (
                        ?omegaValue <= 20 ||
                        ?omegaValue >= 70 ||
                        (
                            EXISTS {
                                ?case nltl:interpolationLowerEndpoint ?obliqueLower ;
                                      nltl:interpolationUpperEndpoint ?obliqueUpper .
                                ?obliqueLower nltl:interpolationPointCoordinate ?obliqueLowerCoordinate ;
                                              nltl:interpolationPointResult ?obliqueLowerResult .
                                ?obliqueUpper nltl:interpolationPointCoordinate ?obliqueUpperCoordinate ;
                                              nltl:interpolationPointResult ?obliqueUpperResult .
                                ?obliqueLowerCoordinate qudt:numericValue ?obliqueLowerCoordinateValue .
                                ?obliqueUpperCoordinate qudt:numericValue ?obliqueUpperCoordinateValue .
                                ?obliqueLowerResult qudt:numericValue ?obliqueLowerResultValue .
                                ?obliqueUpperResult qudt:numericValue ?obliqueUpperResultValue .
                            }
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-030-ComplexReadiness> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/calc> ;
                    sh:resultMessage "Less than 1 values on ex:calc->nltl:interpolationLowerEndpoint" ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class nltl:interpolationPoint ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ],
                                                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ] ] ;
                                            sh:path nltl:interpolationPointCoordinate ],
                                        [ sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:interpolationPointResult ] ] ;
                            sh:path nltl:interpolationLowerEndpoint ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/calc> ;
                    sh:resultMessage "Less than 1 values on ex:calc->nltl:interpolationUpperEndpoint" ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class nltl:interpolationPoint ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ],
                                                        [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:interpolationPointCoordinate ],
                                        [ sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:interpolationPointResult ] ] ;
                            sh:path nltl:interpolationUpperEndpoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:calculationCase ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:plasticNeutralAxisHeight ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:interpolationPoint ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:interpolationPointCoordinate ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:interpolationPointResult ] ] ; sh:path nltl:interpolationLowerEndpoint ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:interpolationPoint ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:interpolationPointCoordinate ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:interpolationPointResult ] ] ; sh:path nltl:interpolationUpperEndpoint ] ]. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ] ] ;
                                    sh:path nltl:interpolationLowerEndpoint ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ],
                                                [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ] ] ;
                                    sh:path nltl:interpolationUpperEndpoint ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:plasticNeutralAxisHeight ] ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/calc> ] .

