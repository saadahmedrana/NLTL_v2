@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/ship> ;
            sh:resultMessage "The ship must provide the patch load as a QUDT quantity in kN." ;
            sh:resultPath nltl:patchLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the patch load as a QUDT quantity in kN." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue unit:KiloN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:patchLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/ship> ;
            sh:resultMessage "The ship must record its frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must record its frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/loadcase> ;
                            sh:resultMessage "Each structural-member load case must provide the combined shear and bending demand." ;
                            sh:resultPath nltl:combinedShearAndBendingDemand ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:message "Each structural-member load case must provide the combined shear and bending demand." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:combinedShearAndBendingDemand ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/member> ;
                    sh:resultMessage "Value does not conform to Shape gen:I2_031_LoadCaseShape. See details for more information." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node gen:I2_031_LoadCaseShape ;
                            sh:path nltl:hasStructuralMemberLoadCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/loadcase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/ship> ;
            sh:resultMessage "Each applicable structural member must be represented." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each applicable structural member must be represented." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_031_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/member> ] .

