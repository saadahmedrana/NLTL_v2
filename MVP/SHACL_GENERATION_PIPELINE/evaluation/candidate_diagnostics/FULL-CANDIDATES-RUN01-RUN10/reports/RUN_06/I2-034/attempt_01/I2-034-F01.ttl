@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "A ship must identify its frame profile type for this requirement." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:message "A ship must identify its frame profile type for this requirement." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ;
                    sh:resultMessage "For each longitudinal structural member in the side structure, every represented load case must provide a combined shear-and-bending demand, plastic strength, and midspan plastic collapse load in the required quantity form, and the demand must not exceed the plastic strength." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "For each longitudinal structural member in the side structure, every represented load case must provide a combined shear-and-bending demand, plastic strength, and midspan plastic collapse load in the required quantity form, and the demand must not exceed the plastic strength." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:longitudinalFrameOrientation true ;
                      nltl:structuralLocation nltl:sideStructureLocation ;
                      nltl:hasStructuralMemberLoadCase ?loadCase .

                OPTIONAL {
                    ?loadCase nltl:combinedShearAndBendingDemand ?demandQuantity .
                    ?demandQuantity qudt:numericValue ?demandValue .
                }

                OPTIONAL {
                    $this nltl:plasticStrength ?strengthQuantity .
                    ?strengthQuantity qudt:numericValue ?strengthValue ;
                                       qudt:unit qudt:KiloN .
                }

                OPTIONAL {
                    $this nltl:midspanPlasticCollapseLoad ?collapseQuantity .
                    ?collapseQuantity qudt:numericValue ?collapseValue ;
                                      qudt:unit qudt:KiloN .
                }

                FILTER (
                    !BOUND(?demandQuantity) ||
                    !BOUND(?demandValue) ||
                    DATATYPE(?demandValue) != xsd:decimal ||
                    !BOUND(?strengthQuantity) ||
                    !BOUND(?strengthValue) ||
                    DATATYPE(?strengthValue) != xsd:decimal ||
                    !BOUND(?collapseQuantity) ||
                    !BOUND(?collapseValue) ||
                    DATATYPE(?collapseValue) != xsd:decimal ||
                    ?demandValue > ?strengthValue
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gs:I2_034_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:I2_034_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:node gs:I2_034_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] .

