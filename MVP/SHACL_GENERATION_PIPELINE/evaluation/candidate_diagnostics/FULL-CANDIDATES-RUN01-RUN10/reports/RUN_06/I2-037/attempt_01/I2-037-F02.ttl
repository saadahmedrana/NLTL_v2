@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/loadcase> ;
                            sh:resultMessage "Each structural-member load case must represent the combined bending and shear effects." ;
                            sh:resultPath nltl:combinedShearBendingEffect ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:message "Each structural-member load case must represent the combined bending and shear effects." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:combinedShearBendingEffect ] ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/loadcase> ;
                            sh:resultMessage "Each structural-member load case must identify the load-patch application location." ;
                            sh:resultPath nltl:loadPatchApplicationLocation ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:message "Each structural-member load case must identify the load-patch application location." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:loadPatchApplicationLocation ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/member> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:loadCase ; sh:property [ sh:datatype xsd:string ; sh:message Literal(\"Each structural-member load case must identify the load-patch application location.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadPatchApplicationLocation ], [ sh:datatype xsd:string ; sh:message Literal(\"Each structural-member load case must represent the combined bending and shear effects.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:combinedShearBendingEffect ] ]. See details for more information." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class nltl:loadCase ;
                                    sh:property [ sh:datatype xsd:string ;
                                            sh:message "Each structural-member load case must represent the combined bending and shear effects." ;
                                            sh:minCount 1 ;
                                            sh:path nltl:combinedShearBendingEffect ],
                                        [ sh:datatype xsd:string ;
                                            sh:message "Each structural-member load case must identify the load-patch application location." ;
                                            sh:minCount 1 ;
                                            sh:path nltl:loadPatchApplicationLocation ] ] ;
                            sh:path nltl:hasStructuralMemberLoadCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/loadcase> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/member> ;
                    sh:resultMessage "Each structural member must provide its capacity in kilonewtons." ;
                    sh:resultPath nltl:memberCapacity ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each structural member must provide its capacity in kilonewtons." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue unit:KiloN ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:memberCapacity ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:structuralMember ; sh:property [ sh:message Literal(\"Each structural member must provide its capacity in kilonewtons.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:memberCapacity ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:loadCase ; sh:property [ sh:datatype xsd:string ; sh:message Literal(\"Each structural-member load case must identify the load-patch application location.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadPatchApplicationLocation ], [ sh:datatype xsd:string ; sh:message Literal(\"Each structural-member load case must represent the combined bending and shear effects.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:combinedShearBendingEffect ] ] ; sh:path nltl:hasStructuralMemberLoadCase ] ]. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:structuralMember ;
                            sh:property [ sh:message "Each structural member must provide its capacity in kilonewtons." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:KiloN ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:memberCapacity ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:loadCase ;
                                            sh:property [ sh:datatype xsd:string ;
                                                    sh:message "Each structural-member load case must represent the combined bending and shear effects." ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:combinedShearBendingEffect ],
                                                [ sh:datatype xsd:string ;
                                                    sh:message "Each structural-member load case must identify the load-patch application location." ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:loadPatchApplicationLocation ] ] ;
                                    sh:path nltl:hasStructuralMemberLoadCase ] ] ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/ship> ;
            sh:resultMessage "The ship must provide an ice-load-patch design case for verifying the minimised-capacity application location." ;
            sh:resultPath nltl:hasIceLoadPatchDesignCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide an ice-load-patch design case for verifying the minimised-capacity application location." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:iceLoadPatchDesignCase ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:message "The ice-load-patch design case must confirm that member capacity is minimised under combined bending and shear." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:memberCapacityMinimizationConfirmed ] ] ;
                    sh:path nltl:hasIceLoadPatchDesignCase ] ] .

