@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ;
                    sh:resultMessage "The ice load patch design case must confirm that member capacity minimization was established." ;
                    sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n043ac9f514cc420b9180525084640f9bb4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ;
                    sh:resultMessage "The ice load patch design case must confirm that member capacity minimization was established." ;
                    sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n043ac9f514cc420b9180525084640f9bb4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "The ship must provide an ice load patch design case with minimization confirmation." ;
            sh:resultPath nltl:hasIceLoadPatchDesignCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceLoadPatchDesignCase ;
                    sh:message "The ship must provide an ice load patch design case with minimization confirmation." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The ice load patch design case must confirm that member capacity minimization was established." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:memberCapacityMinimizationConfirmed ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceLoadPatchDesignCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "The ship must identify the ice load patch defined for this design requirement." ;
            sh:resultPath nltl:hasIceLoadPatch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceLoadPatch ;
                    sh:message "The ship must identify the ice load patch defined for this design requirement." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceLoadPatch ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/member> ;
                    sh:resultMessage "Each structural member must provide its capacity in a single kilonewton quantity value." ;
                    sh:resultPath nltl:memberCapacity ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each structural member must provide its capacity in a single kilonewton quantity value." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue unit:KiloN ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:memberCapacity ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/loadcase> ;
                            sh:resultMessage "Each structural-member load case must identify the combined bending and shear effect." ;
                            sh:resultPath nltl:combinedShearBendingEffect ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:message "Each structural-member load case must identify the combined bending and shear effect." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:combinedShearBendingEffect ] ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/loadcase> ;
                            sh:resultMessage "Each structural-member load case must identify the load patch application location." ;
                            sh:resultPath nltl:loadPatchApplicationLocation ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:message "Each structural-member load case must identify the load patch application location." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:loadPatchApplicationLocation ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/member> ;
                    sh:resultMessage "Each structural member must have a load case containing the same-case location and combined-effect inputs." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCase ;
                            sh:message "Each structural member must have a load case containing the same-case location and combined-effect inputs." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:string ;
                                            sh:maxCount 1 ;
                                            sh:message "Each structural-member load case must identify the load patch application location." ;
                                            sh:minCount 1 ;
                                            sh:path nltl:loadPatchApplicationLocation ],
                                        [ sh:datatype xsd:string ;
                                            sh:maxCount 1 ;
                                            sh:message "Each structural-member load case must identify the combined bending and shear effect." ;
                                            sh:minCount 1 ;
                                            sh:path nltl:combinedShearBendingEffect ] ] ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:hasStructuralMemberLoadCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/loadcase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "Each structural member must link its load case and capacity so the patch location and combined-effect minimization result are represented for the same member case." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:message "Each structural member must link its load case and capacity so the patch location and combined-effect minimization result are represented for the same member case." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:class nltl:loadCase ;
                                    sh:message "Each structural member must have a load case containing the same-case location and combined-effect inputs." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:string ;
                                                    sh:maxCount 1 ;
                                                    sh:message "Each structural-member load case must identify the load patch application location." ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:loadPatchApplicationLocation ],
                                                [ sh:datatype xsd:string ;
                                                    sh:maxCount 1 ;
                                                    sh:message "Each structural-member load case must identify the combined bending and shear effect." ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:combinedShearBendingEffect ] ] ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:hasStructuralMemberLoadCase ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each structural member must provide its capacity in a single kilonewton quantity value." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:KiloN ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:memberCapacity ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/member> ] .

_:n043ac9f514cc420b9180525084640f9bb4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice load patch design case must confirm that member capacity minimization was established." ;
    sh:minCount 1 ;
    sh:path nltl:memberCapacityMinimizationConfirmed .

