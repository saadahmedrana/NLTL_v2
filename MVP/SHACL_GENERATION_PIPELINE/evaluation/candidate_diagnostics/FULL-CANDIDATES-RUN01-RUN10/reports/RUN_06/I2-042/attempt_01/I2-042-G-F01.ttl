@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-042-F01/ship> ;
            sh:resultMessage "For each structural member, flangeWidth must be at least five times netWebThickness." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For each structural member, flangeWidth must be at least five times netWebThickness." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:netWebThickness ?webQuantity ;
                        nltl:flangeWidth ?flangeQuantity .
                ?webQuantity qudt:numericValue ?webThickness .
                ?flangeQuantity qudt:numericValue ?flangeWidth .
                FILTER (
                    datatype(?webThickness) = xsd:decimal &&
                    datatype(?flangeWidth) = xsd:decimal &&
                    ?flangeWidth < (5 * ?webThickness)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-042-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-042-F01/ship> ] .

