@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:I2_046_ApplicableShape , gen:I2_046_NonApplicableShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_046_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/ship> ;
            sh:resultMessage "polarClassRequirementsApplicable must be recorded exactly once." ;
            sh:resultPath nltl:polarClassRequirementsApplicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "polarClassRequirementsApplicable must be recorded exactly once." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarClassRequirementsApplicable ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/addition1> ;
                            sh:resultMessage "Node ex:addition1->qudt:unit does not contain a value in the set: ['qudt:MilliM']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:MilliM ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/internalStructure1> ;
                    sh:resultMessage "Each linked internal ice-strengthened structure must have one corrosion/abrasion addition of at least 1.0 mm." ;
                    sh:resultPath nltl:internalStructureCorrosionAbrasionAddition ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each linked internal ice-strengthened structure must have one corrosion/abrasion addition of at least 1.0 mm." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_046_AllowanceQuantityShape ;
                            sh:path nltl:internalStructureCorrosionAbrasionAddition ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/addition1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_046_InternalStructureShape. See details for more information." ;
            sh:resultPath nltl:hasInternalIceStrengthenedStructure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:I2_046_InternalStructureShape ;
                    sh:path nltl:hasInternalIceStrengthenedStructure ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/internalStructure1> ] .

