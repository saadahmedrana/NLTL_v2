@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F014/case> ;
                    sh:resultMessage "As-built plate thickness must be one decimal quantity in millimetres." ;
                    sh:resultPath nltl:asBuiltPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class qudt:QuantityValue ;
                            sh:maxCount 1 ;
                            sh:message "As-built plate thickness must be one decimal quantity in millimetres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:asBuiltPlateThickness ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F014/case> ;
                    sh:resultMessage "The actual grade is below the required grade or is not in the same steel-strength family as the required grade." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "The actual grade is below the required grade or is not in the same steel-strength family as the required grade." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:steelStrengthCategory ?category ;
                      nltl:actualHullStructuralSteelGrade ?actualGrade ;
                      nltl:requiredHullStructuralSteelGrade ?requiredGrade .
                ?actualGrade nltl:steelGradeOrderRank ?actualRank .
                ?requiredGrade nltl:steelGradeOrderRank ?requiredRank .
                FILTER (
                    (
                        ?category = nltl:normalStrengthSteelCategory
                        &&
                        (
                            ?actualGrade NOT IN (
                                nltl:steelGradeB,
                                nltl:steelGradeD,
                                nltl:steelGradeE
                            )
                            ||
                            ?requiredGrade NOT IN (
                                nltl:steelGradeB,
                                nltl:steelGradeD,
                                nltl:steelGradeE
                            )
                        )
                    )
                    ||
                    (
                        ?category = nltl:highTensileSteelCategory
                        &&
                        (
                            ?actualGrade NOT IN (
                                nltl:steelGradeAh,
                                nltl:steelGradeDh,
                                nltl:steelGradeEh,
                                nltl:steelGradeFh
                            )
                            ||
                            ?requiredGrade NOT IN (
                                nltl:steelGradeAh,
                                nltl:steelGradeDh,
                                nltl:steelGradeEh,
                                nltl:steelGradeFh
                            )
                        )
                    )
                    ||
                    (?actualRank < ?requiredRank)
                )
            }
        """ ;
                            sh:severity sh:Violation ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_048_CaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F014/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F014/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_048_CaseShape. See details for more information." ;
            sh:resultPath nltl:hasSteelGradeRequirementCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeRequirementCase ;
                    sh:node gen:I2_048_CaseShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasSteelGradeRequirementCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F014/case> ] .

