@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-P02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:designVerticalIceShearForce" ;
            sh:resultPath nltl:designVerticalIceShearForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designVerticalIceShearForce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-P02/ship> ;
            sh:resultMessage "For an applicable positive-shear position, the longitudinal distribution factor must be present and equal to 0.0 or 1.0." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an applicable positive-shear position, the longitudinal distribution factor must be present and equal to 0.0 or 1.0." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case ;
                      nltl:upperIceWaterlineLengthLUI ?lui .
                ?case nltl:shearForceDirection nltl:positiveShearForce ;
                      nltl:hullGirderLongitudinalPositionFromAft ?position .
                ?position qudt:numericValue ?p .
                ?lui qudt:numericValue ?l .
                FILTER (
                    (?p >= 0 && ?p <= (0.6 * ?l)) ||
                    (?p >= (0.9 * ?l) && ?p <= ?l)
                )
                FILTER NOT EXISTS {
                    $this nltl:longitudinalDistributionFactor ?cfNode .
                    ?cfNode qudt:numericValue ?cf .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-051-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-P02/ship> ] .

