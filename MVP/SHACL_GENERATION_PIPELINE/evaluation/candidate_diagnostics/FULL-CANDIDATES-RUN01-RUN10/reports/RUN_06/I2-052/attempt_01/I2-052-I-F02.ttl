                                    sh:path nltl:interpolationLowerEndpoint ],
                                [ sh:message "Each calculation case must provide its hull-girder longitudinal position from aft in metres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
