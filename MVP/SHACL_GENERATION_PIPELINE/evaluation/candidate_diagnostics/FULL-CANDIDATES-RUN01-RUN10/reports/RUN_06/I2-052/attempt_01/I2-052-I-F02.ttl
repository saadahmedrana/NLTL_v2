                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/calculation> ;
                    sh:resultMessage "Each calculation case must provide interpolation points with their coordinates, values, and results." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nd17214685d774044ab4491650b865d90b12 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/lowerPoint> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/calculation> ;
                    sh:resultMessage "Each calculation case must identify a complete upper interpolation endpoint." ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each calculation case must identify a complete upper interpolation endpoint." ;
