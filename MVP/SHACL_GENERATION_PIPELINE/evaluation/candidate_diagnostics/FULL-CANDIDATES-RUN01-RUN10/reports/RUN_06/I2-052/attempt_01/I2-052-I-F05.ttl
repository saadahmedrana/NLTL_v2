            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F05/ship> ;
            sh:resultMessage "The ship must provide a calculation case describing the externally determined linear interpolation." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a calculation case describing the externally determined linear interpolation." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:message "Each calculation case must identify a complete lower interpolation endpoint." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:minCount 1 ;
