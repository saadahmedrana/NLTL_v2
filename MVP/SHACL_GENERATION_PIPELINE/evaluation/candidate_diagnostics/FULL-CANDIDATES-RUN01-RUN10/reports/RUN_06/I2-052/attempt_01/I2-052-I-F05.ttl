            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F05/upperPoint> ;
                            sh:resultMessage "Less than 1 values on ex:upperPoint->nltl:interpolationPointValue" ;
                            sh:resultPath nltl:interpolationPointValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
