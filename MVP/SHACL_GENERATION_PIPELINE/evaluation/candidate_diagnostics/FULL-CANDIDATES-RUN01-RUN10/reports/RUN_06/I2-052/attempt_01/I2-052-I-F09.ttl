@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F09/ship> ;
            sh:resultMessage "The ship must provide the interpolated value." ;
            sh:resultPath nltl:interpolatedValue ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must provide the interpolated value." ;
                    sh:minCount 1 ;
                    sh:path nltl:interpolatedValue ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F09/lowerPoint> ;
                            sh:resultMessage "Less than 1 values on ex:lowerPoint->nltl:interpolationPointResult" ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nd17214685d774044ab4491650b865d90b24 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F09/lowerPoint> ;
                            sh:resultMessage "Less than 1 values on ex:lowerPoint->nltl:interpolationPointCoordinate" ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nd17214685d774044ab4491650b865d90b17 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F09/calculation> ;
                    sh:resultMessage "Each calculation case must provide interpolation points with their coordinates, values, and results." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nd17214685d774044ab4491650b865d90b12 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F09/lowerPoint> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F09/upperPoint> ;
                            sh:resultMessage "Less than 1 values on ex:upperPoint->nltl:interpolationPointResult" ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nd17214685d774044ab4491650b865d90b24 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F09/upperPoint> ;
                            sh:resultMessage "Less than 1 values on ex:upperPoint->nltl:interpolationPointCoordinate" ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nd17214685d774044ab4491650b865d90b17 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F09/calculation> ;
                    sh:resultMessage "Each calculation case must provide interpolation points with their coordinates, values, and results." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nd17214685d774044ab4491650b865d90b12 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F09/upperPoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F09/ship> ;
            sh:resultMessage "The ship must provide a calculation case describing the externally determined linear interpolation." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a calculation case describing the externally determined linear interpolation." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:message "Each calculation case must provide interpolation points with their coordinates, values, and results." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationCoordinate ],
                                                [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ],
                                                [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointValue ],
                                                [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ] ] ;
                                    sh:path nltl:hasInterpolationPoint ],
                                [ sh:message "Each calculation case must identify a complete lower interpolation endpoint." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointValue ],
                                                [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationCoordinate ] ] ;
                                    sh:path nltl:interpolationLowerEndpoint ],
                                [ sh:message "Each calculation case must provide its hull-girder longitudinal position from aft in metres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:hullGirderLongitudinalPositionFromAft ],
                                [ sh:message "Each calculation case must identify a complete upper interpolation endpoint." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointValue ],
                                                [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationCoordinate ] ] ;
                                    sh:path nltl:interpolationUpperEndpoint ],
                                [ sh:message "Each calculation case must provide the interpolated longitudinal distribution factor as a dimensionless quantity." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:interpolatedLongitudinalDistributionFactor ] ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F09/calculation> ] .

_:N087a92d42bef40449404b670d355d34f sh:property [ sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ],
        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:N08f325134b064411b82ca5765f9d422f sh:property [ sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:N1a7928a50b994be4bee5c3f1df57be25 sh:minCount 1 ;
    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                    sh:minCount 1 ;
                    sh:path qudt:numericValue ],
                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                    sh:minCount 1 ;
                    sh:path qudt:unit ] ] ;
    sh:path nltl:interpolationPointCoordinate .

_:N403a975634b44250a9b2e01a943ab735 sh:minCount 1 ;
    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                    sh:minCount 1 ;
                    sh:path qudt:numericValue ] ] ;
    sh:path nltl:interpolationPointResult .

_:N458af5183c004f918de564cbbee8c91f sh:property [ sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:N469c7707d9f140d4ba09cc9f73046cbc sh:minCount 1 ;
    sh:node _:N458af5183c004f918de564cbbee8c91f ;
    sh:path nltl:interpolationPointValue .

_:N4eafa3e9b1c74499ba023ad5f09611ca sh:datatype xsd:decimal ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:N81430ce9f647489cb9769b86a4f2d582 sh:minCount 1 ;
    sh:node [ sh:property _:N4eafa3e9b1c74499ba023ad5f09611ca ] ;
    sh:path nltl:interpolationCoordinate .

_:N8dd715c23b65451fabc87a8b3bffd6e4 sh:class nltl:interpolationPoint ;
    sh:property _:N1a7928a50b994be4bee5c3f1df57be25,
        _:N403a975634b44250a9b2e01a943ab735,
        _:N469c7707d9f140d4ba09cc9f73046cbc,
        _:N81430ce9f647489cb9769b86a4f2d582 .

_:nd17214685d774044ab4491650b865d90b12 sh:message "Each calculation case must provide interpolation points with their coordinates, values, and results." ;
    sh:minCount 1 ;
    sh:node _:N8dd715c23b65451fabc87a8b3bffd6e4 ;
    sh:path nltl:hasInterpolationPoint .

_:nd17214685d774044ab4491650b865d90b17 sh:minCount 1 ;
    sh:node _:N087a92d42bef40449404b670d355d34f ;
    sh:path nltl:interpolationPointCoordinate .

