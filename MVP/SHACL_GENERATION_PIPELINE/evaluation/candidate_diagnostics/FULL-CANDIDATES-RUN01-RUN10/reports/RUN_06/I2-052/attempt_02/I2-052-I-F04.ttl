@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/lowerPoint> ;
                            sh:resultMessage "Each interpolation point shall provide its interpolation coordinate." ;
                            sh:resultPath nltl:interpolationCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n0e5c4e43d6074ee8b02bb869dbe9aec3b8 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/calculation> ;
                    sh:resultMessage "The calculation case shall provide interpolation point data." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:message "The calculation case shall provide interpolation point data." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-052-InterpolationPointShape> ;
                            sh:path nltl:hasInterpolationPoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/lowerPoint> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/lowerPoint> ;
                            sh:resultMessage "Each interpolation point shall provide its interpolation coordinate." ;
                            sh:resultPath nltl:interpolationCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n0e5c4e43d6074ee8b02bb869dbe9aec3b8 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/calculation> ;
                    sh:resultMessage "The calculation case shall identify a lower interpolation endpoint." ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:message "The calculation case shall identify a lower interpolation endpoint." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-052-InterpolationPointShape> ;
                            sh:path nltl:interpolationLowerEndpoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/lowerPoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/ship> ;
            sh:resultMessage "The ship shall provide a calculation case for the externally performed linear interpolation." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "The ship shall provide a calculation case for the externally performed linear interpolation." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-052-CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/calculation> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/ship> ;
            sh:resultMessage "The ship shall provide the externally computed interpolated value." ;
            sh:resultPath nltl:interpolatedValue ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship shall provide the externally computed interpolated value." ;
                    sh:minCount 1 ;
                    sh:path nltl:interpolatedValue ] ] .

_:n0e5c4e43d6074ee8b02bb869dbe9aec3b8 sh:message "Each interpolation point shall provide its interpolation coordinate." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-052-CoordinateQuantityShape> ;
    sh:path nltl:interpolationCoordinate .

