@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp1> ;
                            sh:resultMessage "Less than 1 values on ex:interp1->nltl:interpolationPointCoordinate" ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:ne8a92f24aad44a53b2402ae8af8dcb15b17 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp1> ;
                            sh:resultMessage "Less than 1 values on ex:interp1->nltl:interpolationPointResult" ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:ne8a92f24aad44a53b2402ae8af8dcb15b21 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/bendingCase> ;
                    sh:resultMessage "The calculation case must provide interpolation points for C_m." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:ne8a92f24aad44a53b2402ae8af8dcb15b15 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp1> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp2> ;
                            sh:resultMessage "Less than 1 values on ex:interp2->nltl:interpolationPointResult" ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:ne8a92f24aad44a53b2402ae8af8dcb15b21 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp2> ;
                            sh:resultMessage "Less than 1 values on ex:interp2->nltl:interpolationPointCoordinate" ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:ne8a92f24aad44a53b2402ae8af8dcb15b17 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/bendingCase> ;
                    sh:resultMessage "The calculation case must provide interpolation points for C_m." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:ne8a92f24aad44a53b2402ae8af8dcb15b15 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp2> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/ship> ;
            sh:resultMessage "The ship must provide a calculation case with its interpolation structure." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a calculation case with its interpolation structure." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:message "The calculation case must provide interpolation points for C_m." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ] ] ;
                                    sh:path nltl:hasInterpolationPoint ] ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/bendingCase> ] .

_:N009c617675134ca08dade859533e2740 sh:class nltl:interpolationPoint ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node [ sh:class qudt:QuantityValue ;
                    sh:property [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:numericValue ] ] ;
            sh:path nltl:interpolationPointResult ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node [ sh:class qudt:QuantityValue ;
                    sh:property [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:numericValue ],
                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:path nltl:interpolationPointCoordinate ] .

