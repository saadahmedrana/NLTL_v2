@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "The ship shall provide a calculation case containing the prescribed interpolation structure." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide a calculation case containing the prescribed interpolation structure." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:minCount 5 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ] ] ;
                                    sh:path nltl:hasInterpolationPoint ;
                                    sh:qualifiedMinCount 1 ;
                                    sh:qualifiedValueShape [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ],
                                                [ sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ] ] ;
                                    sh:qualifiedValueShapesDisjoint true ],
                                [ sh:minCount 5 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ] ] ;
                                    sh:path nltl:hasInterpolationPoint ;
                                    sh:qualifiedMinCount 1 ;
                                    sh:qualifiedValueShape [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ],
                                                [ sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ] ] ;
                                    sh:qualifiedValueShapesDisjoint true ],
                                [ sh:message "The calculation case shall contain paired interpolation coordinates and results for the prescribed C_m anchors." ;
                                    sh:minCount 5 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ] ] ;
                                    sh:path nltl:hasInterpolationPoint ;
                                    sh:qualifiedMinCount 1 ;
                                    sh:qualifiedValueShape [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ],
                                                [ sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ] ] ;
                                    sh:qualifiedValueShapesDisjoint true ],
                                [ sh:minCount 5 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ] ] ;
                                    sh:path nltl:hasInterpolationPoint ;
                                    sh:qualifiedMinCount 1 ;
                                    sh:qualifiedValueShape [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ],
                                                [ sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ] ] ;
                                    sh:qualifiedValueShapesDisjoint true ],
                                [ sh:minCount 5 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ] ] ;
                                    sh:path nltl:hasInterpolationPoint ;
                                    sh:qualifiedMinCount 1 ;
                                    sh:qualifiedValueShape [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ],
                                                [ sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ] ] ;
                                    sh:qualifiedValueShapesDisjoint true ] ] ;
                    sh:path nltl:hasCalculationCase ] ] .

