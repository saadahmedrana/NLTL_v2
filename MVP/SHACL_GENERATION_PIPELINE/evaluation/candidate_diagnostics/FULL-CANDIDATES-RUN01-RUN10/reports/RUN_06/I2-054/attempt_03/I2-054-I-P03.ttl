@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/bendingCase> ;
                    sh:resultMessage "The calculation case shall contain one coherent collection of paired interpolation points." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n85224b514d3c4b628cbeae63762001ddb15 ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp2> ;
                            sh:resultMessage "Less than 1 values on ex:interp2->nltl:interpolationPointResult" ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n85224b514d3c4b628cbeae63762001ddb21 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp2> ;
                            sh:resultMessage "Less than 1 values on ex:interp2->nltl:interpolationPointCoordinate" ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n85224b514d3c4b628cbeae63762001ddb17 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/bendingCase> ;
                    sh:resultMessage "The calculation case shall contain one coherent collection of paired interpolation points." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n85224b514d3c4b628cbeae63762001ddb15 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp2> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp1> ;
                            sh:resultMessage "Less than 1 values on ex:interp1->nltl:interpolationPointResult" ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n85224b514d3c4b628cbeae63762001ddb21 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp1> ;
                            sh:resultMessage "Less than 1 values on ex:interp1->nltl:interpolationPointCoordinate" ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n85224b514d3c4b628cbeae63762001ddb17 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/bendingCase> ;
                    sh:resultMessage "The calculation case shall contain one coherent collection of paired interpolation points." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n85224b514d3c4b628cbeae63762001ddb15 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp1> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/bendingCase> ;
                    sh:resultMessage "The interpolation collection shall contain paired anchors (0.0,0.0), (0.5,1.0), (0.7,1.0), (0.95,0.3), and (1.0,0.0)." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "The interpolation collection shall contain paired anchors (0.0,0.0), (0.5,1.0), (0.7,1.0), (0.95,0.3), and (1.0,0.0)." ;
                            sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  FILTER (
    NOT EXISTS {
      $this nltl:hasInterpolationPoint ?p0 .
      ?p0 nltl:interpolationPointCoordinate ?c0 ;
          nltl:interpolationPointResult ?r0 .
      ?c0 qudt:numericValue ?cn0 .
      ?r0 qudt:numericValue ?rn0 .
      FILTER (?cn0 = 0.0 && ?rn0 = 0.0)
    }
    ||
    NOT EXISTS {
      $this nltl:hasInterpolationPoint ?p1 .
      ?p1 nltl:interpolationPointCoordinate ?c1 ;
          nltl:interpolationPointResult ?r1 .
      ?c1 qudt:numericValue ?cn1 .
      ?r1 qudt:numericValue ?rn1 .
      FILTER (?cn1 = 0.5 && ?rn1 = 1.0)
    }
    ||
    NOT EXISTS {
      $this nltl:hasInterpolationPoint ?p2 .
      ?p2 nltl:interpolationPointCoordinate ?c2 ;
          nltl:interpolationPointResult ?r2 .
      ?c2 qudt:numericValue ?cn2 .
      ?r2 qudt:numericValue ?rn2 .
      FILTER (?cn2 = 0.7 && ?rn2 = 1.0)
    }
    ||
    NOT EXISTS {
      $this nltl:hasInterpolationPoint ?p3 .
      ?p3 nltl:interpolationPointCoordinate ?c3 ;
          nltl:interpolationPointResult ?r3 .
      ?c3 qudt:numericValue ?cn3 .
      ?r3 qudt:numericValue ?rn3 .
      FILTER (?cn3 = 0.95 && ?rn3 = 0.3)
    }
    ||
    NOT EXISTS {
      $this nltl:hasInterpolationPoint ?p4 .
      ?p4 nltl:interpolationPointCoordinate ?c4 ;
          nltl:interpolationPointResult ?r4 .
      ?c4 qudt:numericValue ?cn4 .
      ?r4 qudt:numericValue ?rn4 .
      FILTER (?cn4 = 1.0 && ?rn4 = 0.0)
    }
  )
}
""" ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_054_CalculationCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/bendingCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/ship> ;
            sh:resultMessage "The ship shall provide a calculation case containing the prescribed paired interpolation anchors." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "The ship shall provide a calculation case containing the prescribed paired interpolation anchors." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_054_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/bendingCase> ] .

_:N09911361bb8b408fa5dbe7735aa83929 sh:class qudt:QuantityValue ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ],
        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:N2b90ff47450b463eb147ecc61435e7f5 sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:Ne48434ef990241d89b1c7511ff32be13 sh:class qudt:QuantityValue ;
    sh:property _:N2b90ff47450b463eb147ecc61435e7f5 .

_:n85224b514d3c4b628cbeae63762001ddb17 sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node _:N09911361bb8b408fa5dbe7735aa83929 ;
    sh:path nltl:interpolationPointCoordinate .

_:n85224b514d3c4b628cbeae63762001ddb21 sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node _:Ne48434ef990241d89b1c7511ff32be13 ;
    sh:path nltl:interpolationPointResult .

_:n85224b514d3c4b628cbeae63762001ddb15 sh:class nltl:interpolationPoint ;
    sh:message "The calculation case shall contain one coherent collection of paired interpolation points." ;
    sh:minCount 5 ;
    sh:node gen:I2_054_InterpolationPointShape ;
    sh:path nltl:hasInterpolationPoint .

