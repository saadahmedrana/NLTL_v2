@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/ship> ;
            sh:resultMessage "Loads carried by a member in way of a cutout shall not cause instability." ;
            sh:resultPath nltl:memberInstability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb78bc6a9d98c45b3814df90897921537b6 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/member> ;
                    sh:resultMessage "Whether stiffening is necessary shall be recorded for the structural member." ;
                    sh:resultPath nltl:stiffeningNecessary ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:message "Whether stiffening is necessary shall be recorded for the structural member." ;
                            sh:minCount 1 ;
                            sh:path nltl:stiffeningNecessary ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:class nltl:cutout ; sh:message Literal(\"Each represented structural member shall be linked to a cutout.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasCutout ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The structural member shall be identified as being in way of a cutout.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:memberInWayOfCutout ], [ sh:datatype xsd:boolean ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Whether stiffening is necessary shall be recorded for the structural member.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stiffeningNecessary ] ]. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ a sh:NodeShape ;
                            sh:property [ sh:class nltl:cutout ;
                                    sh:message "Each represented structural member shall be linked to a cutout." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:hasCutout ],
                                [ sh:datatype xsd:boolean ;
                                    sh:maxCount 1 ;
                                    sh:message "Whether stiffening is necessary shall be recorded for the structural member." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:stiffeningNecessary ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The structural member shall be identified as being in way of a cutout." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:memberInWayOfCutout ] ] ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/ship> ;
            sh:resultMessage "Loads carried by a member in way of a cutout shall not cause instability." ;
            sh:resultPath nltl:memberInstability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb78bc6a9d98c45b3814df90897921537b6 ] .

_:nb78bc6a9d98c45b3814df90897921537b6 sh:datatype xsd:boolean ;
    sh:hasValue false ;
    sh:maxCount 1 ;
    sh:message "Loads carried by a member in way of a cutout shall not cause instability." ;
    sh:minCount 1 ;
    sh:path nltl:memberInstability .

