@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/member> ;
                    sh:resultMessage "Each linked structural member must state whether it is in way of a cut-out; applicable members must identify a cut-out and state whether stiffening is necessary." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/ship> ;
            sh:resultMessage "A member in way of a cut-out must be recorded as not causing instability." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A member in way of a cut-out must be recorded as not causing instability." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:memberInWayOfCutout true ;
                       nltl:hasCutout ?cutout .
                FILTER (
                    NOT EXISTS {
                        $this nltl:memberInstability ?validValue .
                        FILTER (
                            datatype(?validValue) = xsd:boolean &&
                            ?validValue = false
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:memberInstability ?invalidValue .
                        FILTER (
                            datatype(?invalidValue) != xsd:boolean ||
                            ?invalidValue != false
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/ship> ] .

