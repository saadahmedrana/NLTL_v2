@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ;
                    sh:resultMessage "For shell-plating or local-frame cases governed by I2.4, I2.6, or I2.7, the prescribed analytical procedure is required and direct calculation may not be used as an alternative." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:n7d4ac8d1218345b28354893a17866f86b4 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/ship> ;
            sh:resultMessage "Each represented calculation case must follow the prescribed calculation-case model." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each represented calculation case must follow the prescribed calculation-case model." ;
                    sh:node <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/structure> ;
            sh:resultMessage "Applicable shell plating must provide thickness in metres." ;
            sh:resultPath nltl:thickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Applicable shell plating must provide thickness in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:thickness ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ;
            sh:resultMessage "For shell-plating or local-frame cases governed by I2.4, I2.6, or I2.7, the prescribed analytical procedure is required and direct calculation may not be used as an alternative." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:n7d4ac8d1218345b28354893a17866f86b4 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ] .

_:n7d4ac8d1218345b28354893a17866f86b4 a sh:SPARQLConstraint ;
    sh:message "For shell-plating or local-frame cases governed by I2.4, I2.6, or I2.7, the prescribed analytical procedure is required and direct calculation may not be used as an alternative." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:calculationCaseAssessedHullStructure ?structure .
                ?structure a ?structureClass .
                FILTER (
                    ?structureClass IN (
                        nltl:plating,
                        nltl:structuralMember
                    )
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:calculationMethod
                            nltl:prescribedAnalyticalProcedure
                    }
                    ||
                    EXISTS {
                        $this nltl:calculationMethod
                            nltl:directCalculationMethodValue
                    }
                )
            }
        """ .

