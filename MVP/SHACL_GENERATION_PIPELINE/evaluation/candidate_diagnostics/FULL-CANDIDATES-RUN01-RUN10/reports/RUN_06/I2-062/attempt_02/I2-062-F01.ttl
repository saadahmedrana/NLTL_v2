@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-F01/ship> ;
            sh:resultMessage "A ship with a linked load carrying stringer or web frame forming part of a grillage system must record that direct calculation was used." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship with a linked load carrying stringer or web frame forming part of a grillage system must record that direct calculation was used." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member rdf:type ?memberType .
                FILTER (?memberType IN (
                    nltl:loadCarryingStringer,
                    nltl:webFrame
                ))
                ?member nltl:partOfGrillageSystem ?grillage .
                ?grillage rdf:type nltl:grillageSystem .
                FILTER NOT EXISTS {
                    $this nltl:directCalculationUsed ?used .
                    FILTER (?used = true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_062_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-F01/ship> ] .

