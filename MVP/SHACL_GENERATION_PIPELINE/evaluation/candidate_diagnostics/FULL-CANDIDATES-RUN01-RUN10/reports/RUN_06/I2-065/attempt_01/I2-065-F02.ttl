            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A dimensionless fracture margin is required." ;
                    sh:minCount 1 ;
                    sh:node gs:UnitlessQuantityShape ;
