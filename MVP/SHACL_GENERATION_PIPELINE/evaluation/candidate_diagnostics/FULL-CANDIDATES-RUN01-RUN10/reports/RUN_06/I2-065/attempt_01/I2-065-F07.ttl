@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/calculation> ;
            sh:resultMessage "Acceptance evidence for the nonlinear analysis is required." ;
            sh:resultPath nltl:nonlinearAnalysisAcceptanceEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n06f758fcdee84ff2ae686d7696795d7fb11 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "A permanent lateral deformation value in millimetres is required." ;
            sh:resultPath nltl:permanentLateralDeformation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A permanent lateral deformation value in millimetres is required." ;
                    sh:minCount 1 ;
                    sh:node gs:LengthQuantityShape ;
                    sh:path nltl:permanentLateralDeformation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "The permanent deformation assessment must be recorded as satisfied." ;
            sh:resultPath nltl:minorPermanentDeformationAssessmentSatisfied ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n06f758fcdee84ff2ae686d7696795d7fb12 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "A dimensionless major buckling margin is required." ;
            sh:resultPath nltl:majorBucklingMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A dimensionless major buckling margin is required." ;
                    sh:minCount 1 ;
                    sh:node gs:UnitlessQuantityShape ;
                    sh:path nltl:majorBucklingMargin ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "A dimensionless yielding margin is required." ;
            sh:resultPath nltl:yieldingMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A dimensionless yielding margin is required." ;
                    sh:minCount 1 ;
                    sh:node gs:UnitlessQuantityShape ;
                    sh:path nltl:yieldingMargin ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/calculation> ;
                    sh:resultMessage "Acceptance evidence for the nonlinear analysis is required." ;
                    sh:resultPath nltl:nonlinearAnalysisAcceptanceEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n06f758fcdee84ff2ae686d7696795d7fb11 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gs:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/calculation> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "A dimensionless fracture margin is required." ;
            sh:resultPath nltl:fractureMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A dimensionless fracture margin is required." ;
                    sh:minCount 1 ;
                    sh:node gs:UnitlessQuantityShape ;
                    sh:path nltl:fractureMargin ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "The permanent deformation assessment must be recorded as satisfied." ;
            sh:resultPath nltl:minorPermanentDeformationAssessmentSatisfied ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n06f758fcdee84ff2ae686d7696795d7fb12 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "A permanent out-of-plane deformation value in millimetres is required." ;
            sh:resultPath nltl:permanentOutOfPlaneDeformation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A permanent out-of-plane deformation value in millimetres is required." ;
                    sh:minCount 1 ;
                    sh:node gs:LengthQuantityShape ;
                    sh:path nltl:permanentOutOfPlaneDeformation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "The calculation case must identify the nonlinear calculation method." ;
            sh:resultPath nltl:calculationMethod ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n06f758fcdee84ff2ae686d7696795d7fb10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "The calculation case must identify the nonlinear calculation method." ;
            sh:resultPath nltl:calculationMethod ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n06f758fcdee84ff2ae686d7696795d7fb10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "The relevant structural dimension in millimetres is required." ;
            sh:resultPath nltl:relevantStructuralDimension ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The relevant structural dimension in millimetres is required." ;
                    sh:minCount 1 ;
                    sh:node gs:LengthQuantityShape ;
                    sh:path nltl:relevantStructuralDimension ] ] .

_:n06f758fcdee84ff2ae686d7696795d7fb10 sh:class nltl:calculationMethodValue ;
    sh:hasValue nltl:nonlinearCalculationMethodValue ;
    sh:maxCount 1 ;
    sh:message "The calculation case must identify the nonlinear calculation method." ;
    sh:minCount 1 ;
    sh:path nltl:calculationMethod .

_:n06f758fcdee84ff2ae686d7696795d7fb11 sh:class nltl:evidenceArtifact ;
    sh:message "Acceptance evidence for the nonlinear analysis is required." ;
    sh:minCount 1 ;
    sh:path nltl:nonlinearAnalysisAcceptanceEvidence .

_:n06f758fcdee84ff2ae686d7696795d7fb12 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The permanent deformation assessment must be recorded as satisfied." ;
    sh:minCount 1 ;
    sh:path nltl:minorPermanentDeformationAssessmentSatisfied .

