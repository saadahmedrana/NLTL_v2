@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-P03/ship> ;
            sh:resultMessage "Strength continuity must be recorded as true for the ship's structural connections." ;
            sh:resultPath nltl:strengthContinuityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n637c36c226654e42bfe0e81446db6193b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-P03/ship> ;
            sh:resultMessage "The ship must identify at least one structural connection for strength-continuity verification." ;
            sh:resultPath nltl:structuralConnection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:benchmarkEntity ;
                    sh:message "The ship must identify at least one structural connection for strength-continuity verification." ;
                    sh:minCount 1 ;
                    sh:path nltl:structuralConnection ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-P03/ship> ;
            sh:resultMessage "Strength continuity must be recorded as true for the ship's structural connections." ;
            sh:resultPath nltl:strengthContinuityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n637c36c226654e42bfe0e81446db6193b2 ] .

_:n637c36c226654e42bfe0e81446db6193b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Strength continuity must be recorded as true for the ship's structural connections." ;
    sh:minCount 1 ;
    sh:path nltl:strengthContinuityStatus .

