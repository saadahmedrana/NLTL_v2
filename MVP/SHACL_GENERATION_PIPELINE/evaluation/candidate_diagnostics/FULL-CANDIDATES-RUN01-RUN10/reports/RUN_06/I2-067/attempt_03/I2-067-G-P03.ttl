@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-P03/ship> ;
            sh:resultMessage "Each ship must record that continuity of strength is ensured at its structural connections." ;
            sh:resultPath nltl:strengthContinuityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb4c0dcf69ec04c08ad6ca4952c4d1077b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-P03/ship> ;
            sh:resultMessage "Each ship must record that continuity of strength is ensured at its structural connections." ;
            sh:resultPath nltl:strengthContinuityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb4c0dcf69ec04c08ad6ca4952c4d1077b1 ] .

_:nb4c0dcf69ec04c08ad6ca4952c4d1077b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Each ship must record that continuity of strength is ensured at its structural connections." ;
    sh:minCount 1 ;
    sh:path nltl:strengthContinuityStatus .

