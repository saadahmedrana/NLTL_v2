@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:polarShipCategoryA ; sh:path nltl:shipCategory ] ] , [ sh:and ( [ sh:property [ sh:hasValue nltl:thinFirstYearIceWithPossibleOldIceInclusions ; sh:path nltl:designIceCondition ] ] [ sh:property [ sh:hasValue nltl:polarShipCategoryB ; sh:path nltl:shipCategory ] ] ) ] , [ sh:not [ sh:property [ sh:hasValue nltl:thinFirstYearIceWithPossibleOldIceInclusions ; sh:path nltl:designIceCondition ] ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO002Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-F02/ship> ] .

