@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:polarShipCategoryValue ; sh:hasValue nltl:polarShipCategoryC ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A ship designed for open water must have Polar Code category C.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:shipCategory ], [ sh:hasValue nltl:openWaterIceCondition ; sh:path nltl:designIceCondition ] ] , [ sh:property [ sh:class nltl:polarShipCategoryValue ; sh:hasValue nltl:polarShipCategoryC ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A ship designed for ice conditions less severe than categories A and B must have Polar Code category C.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:shipCategory ], [ sh:hasValue nltl:iceConditionLessSevereThanCategoryAAndB ; sh:path nltl:designIceCondition ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-003-ShipCategoryForDesignIceCondition> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F02/ship> ] .

