@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-005-F01/ship> ;
            sh:resultMessage "The ice condition 'ice free waters' shall not be used when total ice is present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ice condition 'ice free waters' shall not be used when total ice is present." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:iceCondition ?condition ;
                      nltl:totalIcePresent ?totalIcePresent .
                FILTER (
                    str(?condition) = "ice free waters" &&
                    ?totalIcePresent = true
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-005> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-005-F01/ship> ] .

