@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-006-F01/ship> ;
            sh:resultMessage "For medium first-year ice, ice thickness must be a decimal quantity in metres from 0.7 m through 1.2 m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For medium first-year ice, ice thickness must be a decimal quantity in metres from 0.7 m through 1.2 m." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceTypeClassification nltl:mediumFirstYearIce .
                FILTER (
                    NOT EXISTS {
                        $this nltl:iceThickness ?validQuantity .
                        ?validQuantity a qudt:QuantityValue ;
                            qudt:numericValue ?validValue ;
                            qudt:unit unit:M .
                        FILTER (
                            datatype(?validValue) = xsd:decimal &&
                            ?validValue >= 0.7 &&
                            ?validValue <= 1.2
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:iceThickness ?invalidQuantity .
                        FILTER NOT EXISTS {
                            ?invalidQuantity a qudt:QuantityValue ;
                                qudt:numericValue ?invalidValue ;
                                qudt:unit unit:M .
                            FILTER (
                                datatype(?invalidValue) = xsd:decimal &&
                                ?invalidValue >= 0.7 &&
                                ?invalidValue <= 1.2
                            )
                        }
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO006Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-006-F01/ship> ] .

