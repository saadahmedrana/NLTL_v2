@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F03/ship> ;
            sh:resultMessage "For open water, sea ice concentration must be a decimal strictly less than 1 with unit UNITLESS, and ice of land origin must be false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For open water, sea ice concentration must be a decimal strictly less than 1 with unit UNITLESS, and ice of land origin must be false." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification nltl:openWaterIceCondition .

                FILTER (
                    NOT EXISTS {
                        $this nltl:seaIceConcentration ?quantity .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:seaIceConcentration ?quantity .
                        ?quantity qudt:numericValue ?value ;
                                  qudt:unit unit:UNITLESS .
                        FILTER (
                            datatype(?value) = xsd:decimal &&
                            ?value < 1
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:seaIceConcentration ?quantity .
                        FILTER NOT EXISTS {
                            ?quantity qudt:numericValue ?value ;
                                      qudt:unit unit:UNITLESS .
                            FILTER (
                                datatype(?value) = xsd:decimal &&
                                ?value < 1
                            )
                        }
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceOfLandOriginPresent false .
                    }
                    ||
                    EXISTS {
                        $this nltl:iceOfLandOriginPresent ?present .
                        FILTER ( ?present != false )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-007-OpenWater> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F03/ship> ] .

