@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F04/ship> ;
            sh:resultMessage "For open-water classification, every sea ice concentration quantity shall be a QuantityValue with decimal numeric value strictly less than 1 and unit UNITLESS; ice of land origin shall be recorded as false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For open-water classification, every sea ice concentration quantity shall be a QuantityValue with decimal numeric value strictly less than 1 and unit UNITLESS; ice of land origin shall be recorded as false." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification nltl:openWaterIceCondition .
                {
                    FILTER NOT EXISTS {
                        $this nltl:seaIceConcentration ?quantity .
                    }
                }
                UNION
                {
                    $this nltl:seaIceConcentration ?quantity .
                    FILTER NOT EXISTS {
                        ?quantity a qudt:QuantityValue .
                    }
                }
                UNION
                {
                    $this nltl:seaIceConcentration ?quantity .
                    FILTER NOT EXISTS {
                        ?quantity qudt:numericValue ?value .
                        FILTER (datatype(?value) = xsd:decimal)
                    }
                }
                UNION
                {
                    $this nltl:seaIceConcentration ?quantity .
                    ?quantity qudt:numericValue ?value .
                    FILTER (!(datatype(?value) = xsd:decimal && ?value < 1))
                }
                UNION
                {
                    $this nltl:seaIceConcentration ?quantity .
                    FILTER NOT EXISTS {
                        ?quantity qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    }
                }
                UNION
                {
                    $this nltl:seaIceConcentration ?quantity .
                    ?quantity qudt:unit ?unit .
                    FILTER (?unit != <http://qudt.org/vocab/unit/UNITLESS>)
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:iceOfLandOriginPresent ?present .
                        FILTER (datatype(?present) = xsd:boolean && ?present = false)
                    }
                }
                UNION
                {
                    $this nltl:iceOfLandOriginPresent ?present .
                    FILTER (!(datatype(?present) = xsd:boolean && ?present = false))
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-007> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F04/ship> ] .

