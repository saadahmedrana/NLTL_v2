@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-F02/ship> ;
            sh:resultMessage "A ship classified as thin first-year ice must have only ice thickness quantities with one decimal numeric value in metres, inclusive from 0.3 m to 0.7 m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship classified as thin first-year ice must have only ice thickness quantities with one decimal numeric value in metres, inclusive from 0.3 m to 0.7 m." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceTypeClassification nltl:thinFirstYearIce .
                FILTER (
                    NOT EXISTS {
                        $this nltl:iceThickness ?thickness
                    }
                    ||
                    EXISTS {
                        $this nltl:iceThickness ?thickness .
                        FILTER NOT EXISTS {
                            ?thickness qudt:numericValue ?numericValue
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:iceThickness ?thickness .
                        FILTER NOT EXISTS {
                            ?thickness qudt:unit unit:M
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:iceThickness ?thickness .
                        ?thickness qudt:numericValue ?numericValue .
                        FILTER (datatype(?numericValue) != xsd:decimal)
                    }
                    ||
                    EXISTS {
                        $this nltl:iceThickness ?thickness .
                        ?thickness qudt:numericValue ?numericValue .
                        FILTER (
                            datatype(?numericValue) = xsd:decimal &&
                            (
                                ?numericValue < "0.3"^^xsd:decimal ||
                                ?numericValue > "0.7"^^xsd:decimal
                            )
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:iceThickness ?thickness .
                        ?thickness qudt:unit ?suppliedUnit .
                        FILTER (?suppliedUnit != unit:M)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-008_ThinFirstYearIceThicknessShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-F02/ship> ] .

