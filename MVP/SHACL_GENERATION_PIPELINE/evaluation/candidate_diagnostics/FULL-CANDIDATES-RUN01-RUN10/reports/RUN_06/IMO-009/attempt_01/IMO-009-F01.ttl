@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F01/ship> ;
            sh:resultMessage "For bergy waters, land-origin ice concentration must be a dimensionless decimal less than 1 and total ice concentration must be a dimensionless decimal no greater than 1." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For bergy waters, land-origin ice concentration must be a dimensionless decimal less than 1 and total ice concentration must be a dimensionless decimal no greater than 1." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceCondition "bergy waters"^^xsd:string .

                FILTER (
                    NOT EXISTS {
                        $this nltl:landOriginIceConcentration ?landQuantity .
                        ?landQuantity a qudt:QuantityValue ;
                            qudt:numericValue ?landValue ;
                            qudt:unit unit:UNITLESS .
                        FILTER (
                            datatype(?landValue) = xsd:decimal &&
                            ?landValue < 1
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:landOriginIceConcentration ?landCandidate .
                        FILTER NOT EXISTS {
                            ?landCandidate a qudt:QuantityValue ;
                                qudt:numericValue ?landCandidateValue ;
                                qudt:unit unit:UNITLESS .
                            FILTER (
                                datatype(?landCandidateValue) = xsd:decimal &&
                                ?landCandidateValue < 1
                            )
                        }
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:totalIceConcentration ?totalQuantity .
                        ?totalQuantity a qudt:QuantityValue ;
                            qudt:numericValue ?totalValue ;
                            qudt:unit unit:UNITLESS .
                        FILTER (
                            datatype(?totalValue) = xsd:decimal &&
                            ?totalValue <= 1
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:totalIceConcentration ?totalCandidate .
                        FILTER NOT EXISTS {
                            ?totalCandidate a qudt:QuantityValue ;
                                qudt:numericValue ?totalCandidateValue ;
                                qudt:unit unit:UNITLESS .
                            FILTER (
                                datatype(?totalCandidateValue) = xsd:decimal &&
                                ?totalCandidateValue <= 1
                            )
                        }
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-009-BergyWatersShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F01/ship> ] .

