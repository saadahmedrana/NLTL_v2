@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-012-F01/ship> ;
            sh:resultMessage "polarServiceTemperature must be at least 10 degrees Celsius below lowestMdlt." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "polarServiceTemperature must be at least 10 degrees Celsius below lowestMdlt." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:lowestMdlt ?lowestNode ;
                      nltl:polarServiceTemperature ?pstNode .
                ?lowestNode qudt:numericValue ?lowest .
                ?pstNode qudt:numericValue ?pst .
                FILTER (?pst > (?lowest - 10))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_012_StaticCalculationShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-012-F01/ship> ] .

