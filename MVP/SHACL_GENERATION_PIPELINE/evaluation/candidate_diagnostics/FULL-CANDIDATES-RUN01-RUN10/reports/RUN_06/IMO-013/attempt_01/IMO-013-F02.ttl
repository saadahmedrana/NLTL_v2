@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-013-F02/ship> ;
            sh:resultMessage "shipOperatesInLowAirTemperature must be true when lowestMdlt is below -10 deg C and false otherwise." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "shipOperatesInLowAirTemperature must be true when lowestMdlt is below -10 deg C and false otherwise." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:lowestMdlt ?quantity ;
                      nltl:shipOperatesInLowAirTemperature ?operates .
                ?quantity qudt:numericValue ?value .
                FILTER (
                    (?value < "-10"^^xsd:decimal && ?operates != true)
                    ||
                    (?value >= "-10"^^xsd:decimal && ?operates != false)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_013_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-013-F02/ship> ] .

