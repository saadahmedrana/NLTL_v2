@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ;
            sh:resultMessage "Each Polar Ship Certificate validity, survey, or endorsement date shall match a correspondingly categorized date in the applicable SOLAS certificate schedule." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each Polar Ship Certificate validity, survey, or endorsement date shall match a correspondingly categorized date in the applicable SOLAS certificate schedule." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this ?shipDate ?value .
    FILTER (
        ?shipDate = nltl:polarCertificateValidityDates ||
        ?shipDate = nltl:surveyDates ||
        ?shipDate = nltl:endorsementDates
    )
    FILTER NOT EXISTS {
        $this nltl:hasSolasCertificateSchedule ?schedule .
        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
        ?record nltl:certificateScheduleDate ?recordDate ;
                nltl:certificateScheduleDateType ?category .
        FILTER (
            (?shipDate = nltl:polarCertificateValidityDates &&
             ?category = nltl:validityDateCategory) ||
            (?shipDate = nltl:surveyDates &&
             ?category = nltl:surveyDateCategory) ||
            (?shipDate = nltl:endorsementDates &&
             ?category = nltl:endorsementDateCategory)
        )
        FILTER (?value = ?recordDate)
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-017-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ;
            sh:resultMessage "The ship shall have an applicable SOLAS certificate schedule." ;
            sh:resultPath nltl:hasSolasCertificateSchedule ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall have an applicable SOLAS certificate schedule." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-017-SolasScheduleShape> ;
                    sh:path nltl:hasSolasCertificateSchedule ] ] .

