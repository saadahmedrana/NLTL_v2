@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-018-F03/ship> ;
            sh:resultMessage "When ice capability methodology is applicable, the certificate methodology reference and administration acceptance status must both be present and approved." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_018_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-018-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-018-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:iceCapabilityMethodologyApplicable" ;
            sh:resultPath nltl:iceCapabilityMethodologyApplicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:iceCapabilityMethodologyApplicable ] ] .

