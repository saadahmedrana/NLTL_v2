@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A ship operating in low air temperature must explicitly indicate applicability as true.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipOperatesInLowAirTemperature ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Systems and equipment required by the Code must be fully functional at the Polar Service Temperature.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:requiredSystemsFunctionalAtPst ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The Polar Service Temperature must be specified in degrees Celsius.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG_C ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:polarServiceTemperature ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The lowest MDLT must be specified in degrees Celsius.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG_C ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:lowestMdlt ] ; sh:sparql [ sh:message Literal("The Polar Service Temperature must be at least 10 degrees Celsius below the lowest MDLT.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:polarServiceTemperature ?pstNode ;
                              nltl:lowestMdlt ?mdltNode .
                        ?pstNode qudt:numericValue ?pst ;
                                 qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
                        ?mdltNode qudt:numericValue ?mdlt ;
                                  qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
                        FILTER (?pst > (?mdlt - 10))
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A ship outside the low-air-temperature applicability condition must explicitly indicate applicability as false.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipOperatesInLowAirTemperature ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO_019_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F01/ship> ] .

