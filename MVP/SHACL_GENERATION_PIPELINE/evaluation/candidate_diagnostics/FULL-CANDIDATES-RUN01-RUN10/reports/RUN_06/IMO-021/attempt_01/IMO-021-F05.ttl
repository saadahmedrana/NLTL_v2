@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-021-F05/assessedLowAirTemperatureValue> ;
                    sh:resultMessage "Node ex:assessedLowAirTemperatureValue->qudt:unit does not contain a value in the set: ['qudt:DEG_C']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:DEG_C ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-021-F05/ship> ;
            sh:resultMessage "The operational assessment shall cover low-air-temperature operation." ;
            sh:resultPath nltl:assessedLowAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The operational assessment shall cover low-air-temperature operation." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:DEG_C ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:assessedLowAirTemperature ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-021-F05/assessedLowAirTemperatureValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-021-F05/ship> ;
            sh:resultMessage "The operational assessment shall cover applicable hazards listed in Introduction section 3." ;
            sh:resultPath nltl:assessedCodeHazards ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:message "The operational assessment shall cover applicable hazards listed in Introduction section 3." ;
                    sh:minCount 1 ;
                    sh:path nltl:assessedCodeHazards ] ] .

