@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-026-F02/ship> ;
            sh:resultMessage "When the ice capability methodology is applicable, the PWOM must contain that methodology." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO026ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-026-F02/ship> ] .

