@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-029-F02/ship> ;
            sh:resultMessage "The ship's PWOM shall record procedures for encounters with ice or temperatures exceeding design capabilities or limitations." ;
            sh:resultPath nltl:exceedanceResponseProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n9cc56af38e624c00a8230b38d9143de8b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-029-F02/ship> ;
            sh:resultMessage "The ship's PWOM shall record procedures for encounters with ice or temperatures exceeding design capabilities or limitations." ;
            sh:resultPath nltl:exceedanceResponseProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n9cc56af38e624c00a8230b38d9143de8b1 ] .

_:n9cc56af38e624c00a8230b38d9143de8b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship's PWOM shall record procedures for encounters with ice or temperatures exceeding design capabilities or limitations." ;
    sh:minCount 1 ;
    sh:path nltl:exceedanceResponseProcedurePresent .

