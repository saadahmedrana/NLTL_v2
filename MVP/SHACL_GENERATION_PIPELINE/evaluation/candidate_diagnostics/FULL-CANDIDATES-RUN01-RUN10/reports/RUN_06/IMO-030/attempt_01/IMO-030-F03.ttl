@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For applicable ice operations, an ice-operation safety monitoring procedure must be present.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceSafetyMonitoringProcedurePresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For applicable ice operations, escort or icebreaker-assistance requirements must be included.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:escortRequirementsPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:iceOperationApplicable ], [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Escorted-operation limitations must be included for applicable ice operations.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:escortedOperationLimits ], [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Independent-operation limitations must be included for applicable ice operations.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:independentOperationLimits ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:iceOperationApplicable ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_030_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F03/ship> ] .

