@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F03/ship> ;
            sh:resultMessage "The exposed-structure material approval status must be Approved." ;
            sh:resultPath nltl:materialApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceState ;
                    sh:hasValue nltl:evidenceStateApproved ;
                    sh:maxCount 1 ;
                    sh:message "The exposed-structure material approval status must be Approved." ;
                    sh:minCount 1 ;
                    sh:path nltl:materialApprovalStatus ] ] .

