@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F05/ship> ;
            sh:resultMessage "An exposed-structure material must be recorded." ;
            sh:resultPath nltl:exposedStructureMaterial ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "An exposed-structure material must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:exposedStructureMaterial ] ] .

