@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-032-P02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:polarShipCategoryA ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipCategory ], [ sh:message Literal(\"Category A ships require a conforming scantling approval record.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:IMO032ABApprovalRecordShape ; sh:path nltl:hasApprovalRecord ] ] , [ sh:property [ sh:hasValue nltl:polarShipCategoryB ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipCategory ], [ sh:message Literal(\"Category B ships require a conforming scantling approval record.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:IMO032ABApprovalRecordShape ; sh:path nltl:hasApprovalRecord ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipIceStrengthened ], [ sh:hasValue nltl:polarShipCategoryC ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipCategory ], [ sh:message Literal(\"Ice-strengthened category C ships require approval addressing operating ice type and concentration.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:IMO032CategoryCApprovalRecordShape ; sh:path nltl:hasApprovalRecord ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO032Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-032-P02/ship> ] .

