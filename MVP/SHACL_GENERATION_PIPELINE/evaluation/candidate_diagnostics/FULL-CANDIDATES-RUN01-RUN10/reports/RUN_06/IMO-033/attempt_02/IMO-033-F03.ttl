@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("iceAccretionLikely must be false when the icing allowance rule is not applicable.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("iceAccretionLikely must be true to apply the icing allowance rule.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("deckIcingAllowance must be 30 kg/m2 when ice accretion is likely.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("30", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("30", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloGM-PER-M2 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:deckIcingAllowance ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("sideIcingAllowance must be 7.5 kg/m2 when ice accretion is likely.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("7.5", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("7.5", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloGM-PER-M2 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:sideIcingAllowance ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN-M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:continuousSurfaceStaticMoment ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN-M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:discontinuousSurfaceStaticMoment ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M2 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:continuousSurfaceProjectedArea ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M2 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:discontinuousSurfaceProjectedArea ] ; sh:sparql [ sh:message Literal("Discontinuous projected area and static moment must match the declared icing formulas within relative tolerance 1e-6, with an absolute fallback of 0.000001.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceAccretionLikely ?app ;
                              nltl:continuousSurfaceProjectedArea ?caNode ;
                              nltl:discontinuousSurfaceProjectedArea ?dpaNode ;
                              nltl:continuousSurfaceStaticMoment ?cmNode ;
                              nltl:discontinuousSurfaceStaticMoment ?dsmNode .
                        ?caNode qudt:numericValue ?ca .
                        ?dpaNode qudt:numericValue ?dpa .
                        ?cmNode qudt:numericValue ?cm .
                        ?dsmNode qudt:numericValue ?dsm .
                        FILTER (?app = true)
                        FILTER (
                            (
                                (?ca * 1.05 >= 0.000001 / 0.000001) &&
                                (
                                    (?dpa - (?ca * 1.05) > ((?ca * 1.05) * 0.000001)) ||
                                    ((?ca * 1.05) - ?dpa > ((?ca * 1.05) * 0.000001))
                                )
                            ) ||
                            (
                                (?ca * 1.05 < 1.0) &&
                                (
                                    (?dpa - (?ca * 1.05) > 0.000001) ||
                                    ((?ca * 1.05) - ?dpa > 0.000001)
                                )
                            ) ||
                            (
                                (?cm * 1.10 >= 1.0) &&
                                (
                                    (?dsm - (?cm * 1.10) > ((?cm * 1.10) * 0.000001)) ||
                                    ((?cm * 1.10) - ?dsm > ((?cm * 1.10) * 0.000001))
                                )
                            ) ||
                            (
                                (?cm * 1.10 < 1.0) &&
                                (
                                    (?dsm - (?cm * 1.10) > 0.000001) ||
                                    ((?cm * 1.10) - ?dsm > 0.000001)
                                )
                            )
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_033_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F03/ship> ] .

