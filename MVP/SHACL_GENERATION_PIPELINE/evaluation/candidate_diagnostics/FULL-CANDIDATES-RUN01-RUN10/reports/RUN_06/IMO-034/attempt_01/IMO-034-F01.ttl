@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-034-F01/ship> ;
            sh:resultMessage "The ship must declare whether ice accretion is likely and, when it is likely, provide the required ice-minimization design and ice-removal means." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO034Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-034-F01/ship> ] .

