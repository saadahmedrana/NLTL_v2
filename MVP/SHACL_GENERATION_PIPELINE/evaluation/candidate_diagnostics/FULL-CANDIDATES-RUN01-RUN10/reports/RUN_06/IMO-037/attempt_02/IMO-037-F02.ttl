@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:sparql [ sh:message Literal("For category A or B ships constructed on or after 1 January 2017, each loading condition must satisfy a residual stability outcome.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT ?this
                    WHERE {
                        ?this nltl:shipCategory ?cat ;
                              nltl:constructionDate ?date .
                        FILTER (
                            ?cat IN (
                                nltl:polarShipCategoryA,
                                nltl:polarShipCategoryB
                            )
                            &&
                            (
                                YEAR(?date) > 2017
                                ||
                                (
                                    YEAR(?date) = 2017
                                    && MONTH(?date) > 1
                                )
                                ||
                                (
                                    YEAR(?date) = 2017
                                    && MONTH(?date) = 1
                                    && DAY(?date) >= 1
                                )
                            )
                        )
                    }
                ") ] ] , [ sh:property [ sh:node [ sh:or ( [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:alternativeInstrumentApplicable ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The residual stability factor must equal one with the dimensionless QUDT unit.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("1.0", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("1.0", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:residualStabilityFactorSI ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The permitted alternative-instrument residual stability outcome must be compliant.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:alternativeInstrumentResidualStabilityStatus ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:alternativeInstrumentApplicable ] ] ) ; sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal("Each loading condition case must have result evidence.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasLoadingConditionResultEvidence ], [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:alternativeInstrumentApplicable ], [ sh:datatype xsd:string ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Each loading condition case must have an identifier.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:loadingConditionIdentifier ] ] ; sh:path nltl:hasLoadingConditionCase ] ; sh:sparql [ sh:message Literal("The applicability inputs do not establish the category A/B construction-date condition.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT ?this
                    WHERE {
                        ?this nltl:shipCategory ?cat ;
                              nltl:constructionDate ?date .
                        FILTER (
                            !(
                                ?cat IN (
                                    nltl:polarShipCategoryA,
                                    nltl:polarShipCategoryB
                                )
                                &&
                                (
                                    YEAR(?date) > 2017
                                    ||
                                    (
                                        YEAR(?date) = 2017
                                        && MONTH(?date) > 1
                                    )
                                    ||
                                    (
                                        YEAR(?date) = 2017
                                        && MONTH(?date) = 1
                                        && DAY(?date) >= 1
                                    )
                                )
                            )
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO037ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F02/ship> ] .

