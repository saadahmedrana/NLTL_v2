@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-P04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:sparql [ sh:message Literal("The requirement is non-applicable only when the ship is not Category A or B constructed on or after 2017-01-01.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    FILTER NOT EXISTS {
        $this nltl:shipCategory ?category ;
              nltl:constructionDate ?date .
        FILTER (
            ?category IN (
                nltl:polarShipCategoryA,
                nltl:polarShipCategoryB
            )
            && ?date >= "2017-01-01"^^xsd:date
        )
    }
}
") ] ] , [ sh:property [ sh:class nltl:loadingConditionCase ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:property [ sh:message Literal("The residual stability factor must equal one with the canonical unitless QUDT unit.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property <http://recursion.too.deep>, <http://recursion.too.deep> ] ; sh:path nltl:residualStabilityFactorSI ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The permitted alternative instrument must demonstrate compliant residual stability.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:alternativeInstrumentResidualStabilityStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:alternativeInstrumentApplicable ] ] ) ; sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal("Each applicable loading condition requires result evidence.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasLoadingConditionResultEvidence ], [ sh:datatype xsd:string ; sh:message Literal("Each applicable loading condition requires an identifier.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:loadingConditionIdentifier ] ] ; sh:path nltl:hasLoadingConditionCase ] ; sh:sparql [ sh:message Literal("The Category A/B ship constructed on or after 2017-01-01 must have an applicable loading-condition result.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    FILTER NOT EXISTS {
        $this nltl:shipCategory ?category ;
              nltl:constructionDate ?date .
        FILTER (
            ?category IN (
                nltl:polarShipCategoryA,
                nltl:polarShipCategoryB
            )
            && ?date >= "2017-01-01"^^xsd:date
        )
    }
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_037> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-P04/ship> ] .

