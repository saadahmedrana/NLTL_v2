@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F05/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:sparql [ sh:message Literal("The applicable ship branch requires loading-condition result checks.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:shipCategory ?category ;
                              nltl:constructionDate ?date .
                        FILTER (
                            ?category IN (
                                nltl:polarShipCategoryA,
                                nltl:polarShipCategoryB
                            )
                            &&
                            ?date >= "2017-01-01"^^xsd:date
                        )
                    }
                ") ] ] , [ sh:property [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:loadingConditionCase ; sh:or ( [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The residual stability factor must equal one with a unitless quantity.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property <http://recursion.too.deep>, <http://recursion.too.deep> ] ; sh:path nltl:residualStabilityFactorSI ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:message Literal("The alternative-instrument branch requires applicability to be true.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:alternativeInstrumentApplicable ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:message Literal("The alternative-instrument residual stability status must be compliant.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:alternativeInstrumentResidualStabilityStatus ] ] ) ; sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal("Each loading-condition case requires result evidence.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasLoadingConditionResultEvidence ], [ sh:datatype xsd:string ; sh:message Literal("Each loading-condition case requires an identifier.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:loadingConditionIdentifier ] ] ; sh:path nltl:hasLoadingConditionCase ] ; sh:sparql [ sh:message Literal("The non-applicable ship branch must not be used for a Category A or B ship constructed on or after 2017-01-01.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:shipCategory ?category ;
                              nltl:constructionDate ?date .
                        FILTER (
                            !(
                                ?category IN (
                                    nltl:polarShipCategoryA,
                                    nltl:polarShipCategoryB
                                )
                                &&
                                ?date >= "2017-01-01"^^xsd:date
                            )
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO_037_ComplexReadinessShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F05/ship> ] .

