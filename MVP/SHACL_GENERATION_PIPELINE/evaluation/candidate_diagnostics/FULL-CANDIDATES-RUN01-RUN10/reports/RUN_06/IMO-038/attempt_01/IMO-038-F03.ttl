@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ;
            sh:resultMessage "Longitudinal and vertical damage extents must satisfy the specified piecewise formulas within numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Longitudinal and vertical damage extents must satisfy the specified piecewise formulas within numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthNode ;
                      nltl:upperIceWaterlineDraught ?draughtNode ;
                      nltl:longitudinalDamageExtent ?longNode ;
                      nltl:verticalDamageExtent ?verticalNode .

                ?lengthNode qudt:numericValue ?lengthValue .
                ?draughtNode qudt:numericValue ?draughtValue .
                ?longNode qudt:numericValue ?longValue .
                ?verticalNode qudt:numericValue ?verticalValue .

                BIND(IF(?forward,
                        0.045 * ?lengthValue,
                        0.015 * ?lengthValue) AS ?expectedLong)
                BIND(IF((0.20 * ?draughtValue) < ?expectedLong,
                        0.20 * ?draughtValue,
                        ?expectedLong) AS ?expectedVertical)

                FILTER(
                    ABS(?longValue - ?expectedLong) >
                    (0.000001 * ABS(?expectedLong) + 0.000001)
                    ||
                    ABS(?verticalValue - ?expectedVertical) >
                    (0.000001 * ABS(?expectedVertical) + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO038Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ] .

