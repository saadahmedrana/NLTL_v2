@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F05/ship> ;
            sh:resultMessage "Selected vertical damage position must be between the keel and 1.20 times the upper ice waterline draught." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Selected vertical damage position must be between the keel and 1.20 times the upper ice waterline draught." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:selectedVerticalDamagePosition ?positionNode ;
                      nltl:upperIceWaterlineDraught ?draughtNode .

                ?positionNode qudt:numericValue ?positionValue .
                ?draughtNode qudt:numericValue ?draughtValue .

                FILTER(?positionValue > (1.20 * ?draughtValue))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO038Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F05/ship> ] .

