@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"iceAccretionLikely must be false when the conditional equipment requirement does not apply.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"iceAccretionLikely must be true for the applicable conditional branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ], [ sh:node [ sh:property [ sh:message Literal(\"Every relevant hatch or door must have associated means to remove or prevent ice and snow accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ] ] ; sh:path nltl:hasRelevantHatchOrDoor ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-040-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F02/ship> ] .

