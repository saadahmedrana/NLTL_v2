@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "The ship shall record hazard protection coverage." ;
            sh:resultPath nltl:hazardProtectionCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n13a2a4d5e6444e10a080ea27b4a4f3fdb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "Each machinery installation with an applicable hazard shall have hazard protection evidence." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each machinery installation with an applicable hazard shall have hazard protection evidence." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT $this
WHERE {
  $this nltl:hasMachineryInstallation ?installation .
  ?installation nltl:hasApplicableHazard ?hazard .
  FILTER (
    ?hazard IN (
      nltl:iceAccretionHazard,
      nltl:snowAccumulationHazard,
      nltl:seawaterIceIngestionHazard,
      nltl:liquidFreezingOrViscosityIncreaseHazard,
      nltl:seawaterIntakeTemperatureHazard,
      nltl:snowIngestionHazard
    )
  )
  FILTER NOT EXISTS {
    ?installation nltl:hasHazardProtectionEvidence ?evidence .
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO043ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "The ship shall record hazard protection coverage." ;
            sh:resultPath nltl:hazardProtectionCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n13a2a4d5e6444e10a080ea27b4a4f3fdb1 ] .

_:n13a2a4d5e6444e10a080ea27b4a4f3fdb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall record hazard protection coverage." ;
    sh:minCount 1 ;
    sh:path nltl:hazardProtectionCoverage .

