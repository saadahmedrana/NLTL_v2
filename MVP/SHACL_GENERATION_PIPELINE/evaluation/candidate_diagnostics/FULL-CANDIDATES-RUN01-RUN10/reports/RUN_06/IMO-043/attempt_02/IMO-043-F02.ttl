@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachinery> ;
                    sh:resultMessage "Each associated equipment item must be covered by the hazard-protection evidence recorded for its machinery installation." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Each associated equipment item must be covered by the hazard-protection evidence recorded for its machinery installation." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasAssociatedEquipment ?equipment .
                FILTER NOT EXISTS {
                    $this nltl:hasHazardProtectionEvidence ?evidence .
                }
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:IMO-043_MachineryInstallationShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachinery> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachinery> ;
                    sh:resultMessage "Each machinery installation, including its associated equipment, must have hazard-protection evidence." ;
                    sh:resultPath nltl:hasHazardProtectionEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:message "Each machinery installation, including its associated equipment, must have hazard-protection evidence." ;
                            sh:minCount 1 ;
                            sh:path nltl:hasHazardProtectionEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-043_MachineryInstallationShape>. See details for more information." ;
            sh:resultPath nltl:hasMachineryInstallation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-043_MachineryInstallationShape> ;
                    sh:path nltl:hasMachineryInstallation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachinery> ] .

