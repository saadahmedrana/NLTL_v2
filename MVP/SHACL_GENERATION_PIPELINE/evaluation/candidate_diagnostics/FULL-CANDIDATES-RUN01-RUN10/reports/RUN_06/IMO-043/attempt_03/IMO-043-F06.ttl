@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachinery> ;
                    sh:resultMessage "Each machinery installation shall identify all six applicable hazards." ;
                    sh:resultPath nltl:hasApplicableHazard ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:iceAccretionHazard nltl:snowAccumulationHazard nltl:seawaterIceIngestionHazard nltl:liquidFreezingOrViscosityIncreaseHazard nltl:seawaterIntakeTemperatureHazard nltl:snowIngestionHazard ) ;
                            sh:maxCount 6 ;
                            sh:message "Each machinery installation shall identify all six applicable hazards." ;
                            sh:minCount 6 ;
                            sh:path nltl:hasApplicableHazard ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO_043_MachineryInstallationShape. See details for more information." ;
            sh:resultPath nltl:hasMachineryInstallation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:IMO_043_MachineryInstallationShape ;
                    sh:path nltl:hasMachineryInstallation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/auxMachinery> ] .

