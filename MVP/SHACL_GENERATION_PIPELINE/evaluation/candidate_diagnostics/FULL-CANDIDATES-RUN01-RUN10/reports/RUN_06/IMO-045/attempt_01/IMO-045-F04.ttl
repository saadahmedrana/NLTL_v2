@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F04/ship> ;
            sh:resultMessage "A ship with a machinery seawater supply must have ice-ingestion prevention or approved alternate functionality arrangements." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO045Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F04/ship> ] .

