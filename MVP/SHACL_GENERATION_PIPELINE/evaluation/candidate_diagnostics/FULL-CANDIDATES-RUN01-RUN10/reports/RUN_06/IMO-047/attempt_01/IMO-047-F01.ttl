@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/engine1> ;
                    sh:resultMessage "Combustion-air temperature control must be recorded as present for each essential engine." ;
                    sh:resultPath nltl:combustionAirTemperatureControlPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "Combustion-air temperature control must be recorded as present for each essential engine." ;
                            sh:minCount 1 ;
                            sh:path nltl:combustionAirTemperatureControlPresent ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/ship> ;
            sh:resultMessage "The ship must identify its essential engine or engines and provide combustion-air temperature compliance data for each." ;
            sh:resultPath nltl:hasEssentialEngine ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:essentialEngine ;
                    sh:message "The ship must identify its essential engine or engines and provide combustion-air temperature compliance data for each." ;
                    sh:minCount 1 ;
                    sh:node gs:IMO047EssentialEngineShape ;
                    sh:path nltl:hasEssentialEngine ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/engine1> ] .

