@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F03/engine1> ;
                    sh:resultMessage "The combustion-air temperature must be within the manufacturer's stated minimum and maximum criteria." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "The combustion-air temperature must be within the manufacturer's stated minimum and maximum criteria." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:combustionAirTemperature ?temperatureQuantity .
                ?temperatureQuantity qudt:numericValue ?temperatureValue .
                $this nltl:manufacturerMinAirTemperature ?minimumQuantity .
                ?minimumQuantity qudt:numericValue ?minimumValue .
                $this nltl:manufacturerMaxAirTemperature ?maximumQuantity .
                ?maximumQuantity qudt:numericValue ?maximumValue .
                FILTER (
                    ?temperatureValue < ?minimumValue ||
                    ?temperatureValue > ?maximumValue
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gs:IMO047EssentialEngineShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F03/engine1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F03/ship> ;
            sh:resultMessage "The ship must identify its essential engine or engines and provide combustion-air temperature compliance data for each." ;
            sh:resultPath nltl:hasEssentialEngine ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:essentialEngine ;
                    sh:message "The ship must identify its essential engine or engines and provide combustion-air temperature compliance data for each." ;
                    sh:minCount 1 ;
                    sh:node gs:IMO047EssentialEngineShape ;
                    sh:path nltl:hasEssentialEngine ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F03/engine1> ] .

