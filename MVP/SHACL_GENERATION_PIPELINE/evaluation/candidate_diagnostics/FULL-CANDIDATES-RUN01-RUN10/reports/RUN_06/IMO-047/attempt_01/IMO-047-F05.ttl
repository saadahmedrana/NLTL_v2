@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F05/engine1_combustionAirTemperatureValue> ;
                            sh:resultMessage "Node ex:engine1_combustionAirTemperatureValue->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/DEG_C>']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F05/engine1> ;
                    sh:resultMessage "A combustion-air temperature in degrees Celsius is required for each essential engine." ;
                    sh:resultPath nltl:combustionAirTemperature ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "A combustion-air temperature in degrees Celsius is required for each essential engine." ;
                            sh:minCount 1 ;
                            sh:node gs:IMO047TemperatureQuantityShape ;
                            sh:path nltl:combustionAirTemperature ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F05/engine1_combustionAirTemperatureValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F05/ship> ;
            sh:resultMessage "The ship must identify its essential engine or engines and provide combustion-air temperature compliance data for each." ;
            sh:resultPath nltl:hasEssentialEngine ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:essentialEngine ;
                    sh:message "The ship must identify its essential engine or engines and provide combustion-air temperature compliance data for each." ;
                    sh:minCount 1 ;
                    sh:node gs:IMO047EssentialEngineShape ;
                    sh:path nltl:hasEssentialEngine ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F05/engine1> ] .

