@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F02/ship> ;
            sh:resultMessage "Each exposed machinery or foundation material must be paired with approval evidence from an authorized authority, using an accepted or equivalent-safety standard and the ship's polar service temperature basis." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each exposed machinery or foundation material must be paired with approval evidence from an authorized authority, using an accepted or equivalent-safety standard and the ship's polar service temperature basis." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this
            WHERE {
                $this rdf:type nltl:ship .
                $this nltl:exposedMachineryOrFoundationMaterial ?material .
                FILTER NOT EXISTS {
                    $this nltl:hasEvidence ?evidence .
                    ?evidence rdf:type nltl:approvalEvidence ;
                        nltl:exposedMachineryOrFoundationMaterial ?material ;
                        nltl:approvingAuthority ?authority ;
                        nltl:approvalStandard ?standard ;
                        nltl:materialApprovalStatus nltl:evidenceStateApproved ;
                        nltl:polarServiceTemperature ?evidenceTemperature .
                    FILTER (
                        ?authority IN (
                            "Administration",
                            "recognized organization accepted by the Administration"
                        )
                    )
                    FILTER (
                        ?standard IN (
                            "standard acceptable to the Organization",
                            "another standard offering an equivalent level of safety"
                        )
                    )
                    $this nltl:polarServiceTemperature ?shipTemperature .
                    ?shipTemperature qudt:numericValue ?shipValue ;
                        qudt:unit unit:DEG_C .
                    ?evidenceTemperature qudt:numericValue ?evidenceValue ;
                        qudt:unit unit:DEG_C .
                    FILTER (?evidenceValue = ?shipValue)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-048_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F02/ship> ] .

