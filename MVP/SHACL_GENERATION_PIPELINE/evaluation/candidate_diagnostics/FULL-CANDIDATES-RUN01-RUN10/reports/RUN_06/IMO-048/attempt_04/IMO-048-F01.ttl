@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F01/ship> ;
            sh:resultMessage "When an exposed machinery or foundation material is recorded, the ship must record an authorized approving authority, an authorized approval standard, an approved material status, and a polar service temperature quantity in degrees Celsius." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When an exposed machinery or foundation material is recorded, the ship must record an authorized approving authority, an authorized approval standard, an approved material status, and a polar service temperature quantity in degrees Celsius." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:exposedMachineryOrFoundationMaterial ?material .
                FILTER (
                    NOT EXISTS {
                        $this nltl:approvingAuthority ?authority .
                        FILTER (
                            DATATYPE(?authority) = xsd:string &&
                            ?authority IN (
                                "Administration",
                                "recognized organization accepted by the Administration"
                            )
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:approvalStandard ?standard .
                        FILTER (
                            DATATYPE(?standard) = xsd:string &&
                            ?standard IN (
                                "standard acceptable to the Organization",
                                "another standard offering an equivalent level of safety"
                            )
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:materialApprovalStatus ?status .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:polarServiceTemperature ?temperature .
                        ?temperature qudt:numericValue ?value ;
                                     qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
                        FILTER (DATATYPE(?value) = xsd:decimal)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-048> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F01/ship> ] .

