@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-050-F02/ship> ;
            sh:resultMessage "Fire-safety components exposed in positions shall have ice and snow protection." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_050_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-050-F02/ship> ] .

