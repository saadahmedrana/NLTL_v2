@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-050-F01/ship> ;
            sh:resultMessage "When a fire safety component is exposed, ice and snow protection must be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When a fire safety component is exposed, ice and snow protection must be present." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:fireSafetyComponentExposed ?exposed .
    FILTER (?exposed = "true"^^xsd:boolean)
    FILTER NOT EXISTS {
        $this nltl:iceAndSnowProtectionPresent ?protected .
        FILTER (?protected = "true"^^xsd:boolean)
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-050> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-050-F01/ship> ] .

