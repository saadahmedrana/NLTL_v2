@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-F01/access1> ;
                    sh:resultMessage "A required access item must have associated ice or snow removal or prevention means." ;
                    sh:resultPath nltl:hasIceOrSnowRemovalOrPreventionMeans ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:iceSnowRemovalOrPreventionMeans ;
                            sh:message "A required access item must have associated ice or snow removal or prevention means." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-F01/ship> ;
            sh:resultMessage "Each required access item must have associated ice or snow removal or prevention means." ;
            sh:resultPath nltl:hasRequiredAccessItem ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:requiredAccessItem ;
                    sh:message "Each required access item must have associated ice or snow removal or prevention means." ;
                    sh:node gs:IMO052RequiredAccessItemShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasRequiredAccessItem ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-F01/access1> ] .

