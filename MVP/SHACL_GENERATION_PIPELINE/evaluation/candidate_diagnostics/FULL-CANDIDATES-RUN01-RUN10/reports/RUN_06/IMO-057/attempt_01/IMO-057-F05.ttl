@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-057-F05/ship> ;
            sh:resultMessage "Every fire pump, emergency fire pump, water-mist pump, and water-spray pump must be linked to a compartment whose maintained temperature is a decimal value greater than 0 degrees Celsius." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Every fire pump, emergency fire pump, water-mist pump, and water-spray pump must be linked to a compartment whose maintained temperature is a decimal value greater than 0 degrees Celsius." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this rdf:type nltl:ship .
                $this nltl:hasComponent ?pump .
                ?pump rdf:type ?pumpClass .
                FILTER (
                    ?pumpClass IN (
                        nltl:firePump,
                        nltl:emergencyFirePump,
                        nltl:waterMistPump,
                        nltl:waterSprayPump
                    )
                )
                FILTER (
                    NOT EXISTS {
                        ?pump nltl:hasContainingCompartment ?compartment .
                    }
                    ||
                    EXISTS {
                        ?pump nltl:hasContainingCompartment ?compartment .
                        FILTER NOT EXISTS {
                            ?compartment nltl:maintainedTemperature ?temperature .
                            ?temperature rdf:type qudt:QuantityValue .
                            ?temperature qudt:numericValue ?value .
                            ?temperature qudt:unit unit:DEG_C .
                            FILTER (datatype(?value) = xsd:decimal)
                            FILTER (?value > 0)
                        }
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-057_FirePumpCompartmentTemperatureShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-057-F05/ship> ] .

