@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F04/outfit2Store> ;
                            sh:resultMessage "The storage location shall be classified as warm." ;
                            sh:resultPath nltl:storageTemperatureClass ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:InConstraintComponent ;
                            sh:sourceShape [ sh:in ( nltl:warmStorageLocation ) ;
                                    sh:message "The storage location shall be classified as warm." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:storageTemperatureClass ] ;
                            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F04/outfit2ColdClass> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F04/outfit2> ;
                    sh:resultMessage "A firefighter outfit shall have a storage location." ;
                    sh:resultPath nltl:hasStorageLocation ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:physicalStorageLocation ;
                            sh:message "A firefighter outfit shall have a storage location." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:IMO-059-StorageLocationShape> ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:hasStorageLocation ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F04/outfit2Store> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F04/ship> ;
            sh:resultMessage "Each linked firefighter outfit shall be stored in a warm location." ;
            sh:resultPath nltl:hasFirefighterOutfit ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:firefighterOutfitItem ;
                    sh:message "Each linked firefighter outfit shall be stored in a warm location." ;
                    sh:node <urn:nltl:generated-shape:IMO-059-FirefighterOutfitShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasFirefighterOutfit ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F04/outfit2> ] .

