@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F02/outfit1> ;
                    sh:resultMessage "Less than 1 values on ex:outfit1->nltl:hasStorageLocation" ;
                    sh:resultPath nltl:hasStorageLocation ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:physicalStorageLocation ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:in ( nltl:warmStorageLocation ) ;
                                            sh:minCount 1 ;
                                            sh:nodeKind sh:IRI ;
                                            sh:path nltl:storageTemperatureClass ] ] ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:hasStorageLocation ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:equipmentItem ; sh:property [ sh:class nltl:physicalStorageLocation ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:in ( nltl:warmStorageLocation ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:storageTemperatureClass ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:hasStorageLocation ] ]. See details for more information." ;
            sh:resultPath nltl:hasFirefighterOutfit ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:firefighterOutfitItem ;
                    sh:node [ sh:class nltl:equipmentItem ;
                            sh:property [ sh:class nltl:physicalStorageLocation ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:in [ ] ;
                                                    sh:minCount 1 ;
                                                    sh:nodeKind sh:IRI ;
                                                    sh:path nltl:storageTemperatureClass ] ] ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:hasStorageLocation ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasFirefighterOutfit ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F02/outfit1> ] .

