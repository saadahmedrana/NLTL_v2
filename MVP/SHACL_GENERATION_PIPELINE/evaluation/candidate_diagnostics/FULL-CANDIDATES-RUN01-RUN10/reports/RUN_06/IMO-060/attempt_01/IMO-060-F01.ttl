@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F01/ship> ;
            sh:resultMessage "When the fixed water-based firefighting system is separate from the main fire pumps and uses an independent sea suction, that sea suction must be capable of being cleared of ice accumulation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the fixed water-based firefighting system is separate from the main fire pumps and uses an independent sea suction, that sea suction must be capable of being cleared of ice accumulation." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT ?this
            WHERE {
                ?this nltl:fixedWaterSystemSeparateFromMainFirePumps true .
                ?this nltl:independentSeaSuctionUsed true .
                FILTER NOT EXISTS {
                    ?this nltl:seaSuctionIceClearingCapability true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-060-Static> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F01/ship> ] .

