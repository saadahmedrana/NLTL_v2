@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F06/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:shipExposedToIceAccretion ] ] , [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:shipExposedToIceAccretion ], [ sh:node [ sh:property [ sh:in ( nltl:escapeRouteProtectedItem nltl:musterStationProtectedItem nltl:embarkationAreaProtectedItem nltl:survivalCraftProtectedItem nltl:launchingApplianceProtectedItem nltl:survivalCraftAccessProtectedItem ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Each protected item must have one permitted protected-item category.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:protectedItemCategory ], [ sh:message Literal("Each protected item must have associated ice or snow removal or prevention means.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasIceSnowRemovalOrPreventionMeans ] ] ; sh:path nltl:hasProtectedItem ] ; sh:sparql [ sh:message Literal("For a ship exposed to ice accretion, all six specified protected-item categories must have associated ice or snow removal or prevention means.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        FILTER (
                            EXISTS {
                                $this nltl:hasProtectedItem ?escapeRouteItem .
                                ?escapeRouteItem
                                    nltl:protectedItemCategory nltl:escapeRouteProtectedItem ;
                                    nltl:hasIceSnowRemovalOrPreventionMeans ?escapeRouteMeans .
                            }
                            &&
                            EXISTS {
                                $this nltl:hasProtectedItem ?musterStationItem .
                                ?musterStationItem
                                    nltl:protectedItemCategory nltl:musterStationProtectedItem ;
                                    nltl:hasIceSnowRemovalOrPreventionMeans ?musterStationMeans .
                            }
                            &&
                            EXISTS {
                                $this nltl:hasProtectedItem ?embarkationAreaItem .
                                ?embarkationAreaItem
                                    nltl:protectedItemCategory nltl:embarkationAreaProtectedItem ;
                                    nltl:hasIceSnowRemovalOrPreventionMeans ?embarkationAreaMeans .
                            }
                            &&
                            EXISTS {
                                $this nltl:hasProtectedItem ?survivalCraftItem .
                                ?survivalCraftItem
                                    nltl:protectedItemCategory nltl:survivalCraftProtectedItem ;
                                    nltl:hasIceSnowRemovalOrPreventionMeans ?survivalCraftMeans .
                            }
                            &&
                            EXISTS {
                                $this nltl:hasProtectedItem ?launchingApplianceItem .
                                ?launchingApplianceItem
                                    nltl:protectedItemCategory nltl:launchingApplianceProtectedItem ;
                                    nltl:hasIceSnowRemovalOrPreventionMeans ?launchingApplianceMeans .
                            }
                            &&
                            EXISTS {
                                $this nltl:hasProtectedItem ?survivalCraftAccessItem .
                                ?survivalCraftAccessItem
                                    nltl:protectedItemCategory nltl:survivalCraftAccessProtectedItem ;
                                    nltl:hasIceSnowRemovalOrPreventionMeans ?survivalCraftAccessMeans .
                            }
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-066-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F06/ship> ] .

