@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Safe evacuation means must be present when the ship operates in ice-covered waters.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:safeEvacuationMeansPresent ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInIceCoveredWaters ], [ sh:hasValue nltl:evidenceStateApproved ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Survival equipment deployment approval must be approved when the ship operates in ice-covered waters.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:survivalEquipmentDeploymentApprovalStatus ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Safe evacuation means must be present when direct evacuation onto the ice is applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:safeEvacuationMeansPresent ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:directEvacuationOntoIceApplicable ], [ sh:hasValue nltl:evidenceStateApproved ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Survival equipment deployment approval must be approved when direct evacuation onto the ice is applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:survivalEquipmentDeploymentApprovalStatus ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:directEvacuationOntoIceApplicable ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInIceCoveredWaters ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_068_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-F04/ship> ;
            sh:resultMessage "Each ship must provide exactly one ice-covered-waters applicability value." ;
            sh:resultPath nltl:shipOperatesInIceCoveredWaters ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Each ship must provide exactly one ice-covered-waters applicability value." ;
                    sh:minCount 1 ;
                    sh:path nltl:shipOperatesInIceCoveredWaters ] ] .

