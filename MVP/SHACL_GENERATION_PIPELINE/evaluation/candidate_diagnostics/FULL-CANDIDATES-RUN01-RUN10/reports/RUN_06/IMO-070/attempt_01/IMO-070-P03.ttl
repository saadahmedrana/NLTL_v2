@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P03/ship> ;
            sh:resultMessage "A passenger ship shall record compatible survival equipment for every person on board." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A passenger ship shall record compatible survival equipment for every person on board." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this a nltl:ship ;
          a nltl:passengerShip .
    {
        FILTER NOT EXISTS {
            $this nltl:sizeCompatibilityStatus true .
        }
    }
    UNION
    {
        $this nltl:hasPersonOnBoardMember ?person .
        FILTER NOT EXISTS {
            ?person a nltl:personOnBoardMember ;
                    nltl:hasPersonalSurvivalEquipmentAssignment ?assignment .
            ?assignment a nltl:personalSurvivalEquipmentAssignment ;
                        nltl:assignedPersonalSurvivalEquipment ?equipment .
            ?equipment a nltl:personalSurvivalEquipment .
            {
                ?equipment a nltl:immersionSuitEquipment .
            }
            UNION
            {
                ?equipment a nltl:thermalProtectiveAidEquipment .
            }
            $this nltl:sizeCompatibilityStatus true .
        }
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-070> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P03/ship> ] .

