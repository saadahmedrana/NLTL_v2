@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Extended darkness operation must be explicitly recorded as false when the conditional equipment requirement does not apply.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendedDarknessOperation ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Extended darkness operation must be explicitly recorded as true when the conditional equipment requirement applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendedDarknessOperation ], [ sh:node [ sh:class nltl:lifeboat ; sh:property [ sh:class nltl:searchlight ; sh:message Literal(\"Each lifeboat must have an assigned searchlight during extended darkness operation.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:searchlight ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each lifeboat's assigned searchlight must be recorded as suitable for continuous use.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:searchlightContinuousUseSuitabilityStatus ] ] ; sh:path nltl:hasAssignedSearchlight ] ] ; sh:path nltl:hasLifeboat ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_072_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F01/ship> ] .

