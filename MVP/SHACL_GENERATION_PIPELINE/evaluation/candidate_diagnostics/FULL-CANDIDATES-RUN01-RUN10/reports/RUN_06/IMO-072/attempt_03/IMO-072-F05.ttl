@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F05/ship> ;
            sh:resultMessage "For extended darkness operation, every lifeboat must have an assigned searchlight with continuous-use suitability status true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For extended darkness operation, every lifeboat must have an assigned searchlight with continuous-use suitability status true." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:extendedDarknessOperation true .
                $this nltl:hasLifeboat ?lifeboat .
                FILTER NOT EXISTS {
                    ?lifeboat nltl:hasAssignedSearchlight ?searchlight .
                    ?searchlight nltl:searchlightContinuousUseSuitabilityStatus ?status .
                    FILTER (
                        datatype(?status) = xsd:boolean &&
                        ?status = true
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_072_ExtendedDarknessSearchlightShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F05/ship> ] .

