@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-073-F03/boat2> ;
                    sh:resultMessage "Any supplied lifeboat type classification must be partially enclosed or totally enclosed." ;
                    sh:resultPath nltl:lifeboatTypeClassification ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:partiallyEnclosedLifeboat nltl:totallyEnclosedLifeboat ) ;
                            sh:message "Any supplied lifeboat type classification must be partially enclosed or totally enclosed." ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:lifeboatTypeClassification ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-073-F03/boat2OpenType> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-073-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:lifeboat ; sh:property [ sh:in ( nltl:partiallyEnclosedLifeboat nltl:totallyEnclosedLifeboat ) ; sh:message Literal(\"Any supplied lifeboat type classification must be partially enclosed or totally enclosed.\") ; sh:nodeKind sh:IRI ; sh:path nltl:lifeboatTypeClassification ] ]. See details for more information." ;
            sh:resultPath nltl:hasLifeboat ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:lifeboat ;
                            sh:property [ sh:in ( nltl:partiallyEnclosedLifeboat nltl:totallyEnclosedLifeboat ) ;
                                    sh:message "Any supplied lifeboat type classification must be partially enclosed or totally enclosed." ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:lifeboatTypeClassification ] ] ;
                    sh:path nltl:hasLifeboat ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-073-F03/boat2> ] .

