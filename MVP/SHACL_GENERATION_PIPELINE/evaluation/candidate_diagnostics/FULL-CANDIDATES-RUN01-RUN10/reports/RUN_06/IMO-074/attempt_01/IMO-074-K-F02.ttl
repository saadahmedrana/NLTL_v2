@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-074-K-F02/ship> ;
            sh:resultMessage "When abandonment onto ice or land is a potential, group survival equipment must be carried or approved equivalent survival functionality must be recorded." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_074_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-074-K-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-074-K-F02/ship> ;
            sh:resultMessage "The ship must record whether abandonment onto ice or land is a potential." ;
            sh:resultPath nltl:abandonmentOntoIceOrLandPotential ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ship must record whether abandonment onto ice or land is a potential." ;
                    sh:minCount 1 ;
                    sh:path nltl:abandonmentOntoIceOrLandPotential ] ] .

