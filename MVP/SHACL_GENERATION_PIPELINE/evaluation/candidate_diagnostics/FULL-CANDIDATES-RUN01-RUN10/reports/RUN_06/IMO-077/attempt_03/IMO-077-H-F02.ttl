@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F02/ship> ;
            sh:resultMessage "When additional equipment is carried in the survival craft, capacities do not satisfy the required inclusive comparisons." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When additional equipment is carried in the survival craft, capacities do not satisfy the required inclusive comparisons." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:additionalEquipmentCarriedInSurvivalCraft true ;
                      nltl:personsCapacityRequirement ?persons ;
                      nltl:additionalEquipmentCapacityRequirement ?additional ;
                      nltl:survivalCraftAvailableCapacity ?available ;
                      nltl:loadedSurvivalCraftRequirement ?loadedNode ;
                      nltl:launchingApplianceCapacity ?launchNode .

                ?loadedNode qudt:numericValue ?loaded .
                ?launchNode qudt:numericValue ?launching .

                FILTER (
                    ?available < (?persons + ?additional)
                    || ?launching < ?loaded
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-077> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F02/ship> ] .

