@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-079-H-F01/ship> ;
            sh:resultMessage "Available emergency ration person-days must be at least persons on board multiplied by maximum expected rescue time in days." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Available emergency ration person-days must be at least persons on board multiplied by maximum expected rescue time in days." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:personsOnBoard ?persons ;
                      nltl:maximumExpectedRescueTime ?rescueQuantity ;
                      nltl:availableEmergencyRationPerson ?rationQuantity .

                ?rescueQuantity qudt:numericValue ?rescue ;
                                qudt:unit <http://qudt.org/vocab/unit/DAY> .

                ?rationQuantity qudt:numericValue ?ration ;
                               qudt:unit <http://qudt.org/vocab/unit/DAY> .

                FILTER (?ration < (?persons * ?rescue))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-079> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-079-H-F01/ship> ] .

