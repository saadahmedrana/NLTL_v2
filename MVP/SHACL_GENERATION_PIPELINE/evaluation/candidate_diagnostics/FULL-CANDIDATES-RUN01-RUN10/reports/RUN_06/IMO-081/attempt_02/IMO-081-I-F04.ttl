@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:IMO081NonApplicableGuard , gen:IMO081ApplicableShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO081ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F04/ship> ] .

