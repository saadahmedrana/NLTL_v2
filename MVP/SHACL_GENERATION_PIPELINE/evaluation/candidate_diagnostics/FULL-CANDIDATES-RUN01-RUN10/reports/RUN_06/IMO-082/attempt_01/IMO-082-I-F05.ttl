@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F05/ship> ;
            sh:resultMessage "A clear astern view shall be compliant when the bridge configuration requires it." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A clear astern view shall be compliant when the bridge configuration requires it." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                OPTIONAL {
                    $this nltl:bridgeConfigurationType ?configuration .
                }
                OPTIONAL {
                    $this nltl:clearViewAsternStatus ?clearView .
                }
                FILTER (
                    !BOUND(?configuration)
                    ||
                    (
                        ?configuration = nltl:asternViewRequiredBridgeConfiguration
                        &&
                        (
                            !BOUND(?clearView)
                            ||
                            ?clearView != true
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-082-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F05/ship> ] .

