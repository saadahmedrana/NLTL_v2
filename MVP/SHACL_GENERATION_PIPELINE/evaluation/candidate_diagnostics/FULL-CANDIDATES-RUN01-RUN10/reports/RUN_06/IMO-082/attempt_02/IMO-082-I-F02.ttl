@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F02/ship> ;
            sh:resultMessage "A clear view astern is required when the bridge configuration is astern-view-required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A clear view astern is required when the bridge configuration is astern-view-required." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:bridgeConfigurationType ?configuration .
                FILTER (?configuration = nltl:asternViewRequiredBridgeConfiguration)
                FILTER NOT EXISTS {
                    $this nltl:clearViewAsternStatus ?clearView .
                    FILTER (?clearView = true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-082-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F02/ship> ] .

