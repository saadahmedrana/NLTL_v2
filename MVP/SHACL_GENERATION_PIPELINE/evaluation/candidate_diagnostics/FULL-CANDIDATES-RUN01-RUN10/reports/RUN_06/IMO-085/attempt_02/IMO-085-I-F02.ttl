@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:IMO085ApplicableBranch , gs:IMO085CategoryCExemption , gs:IMO085Pre2017Exemption" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO085ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F02/ship> ;
            sh:resultMessage "Each ship must have exactly one permitted polar ship category." ;
            sh:resultPath nltl:shipCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB nltl:polarShipCategoryC ) ;
                    sh:maxCount 1 ;
                    sh:message "Each ship must have exactly one permitted polar ship category." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:shipCategory ] ] .

