@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F03/ship> ;
            sh:resultMessage "Each ship must have exactly one construction date." ;
            sh:resultPath nltl:constructionDate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:date ;
                    sh:maxCount 1 ;
                    sh:message "Each ship must have exactly one construction date." ;
                    sh:minCount 1 ;
                    sh:path nltl:constructionDate ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:IMO085ApplicableBranch , gs:IMO085CategoryCExemption , gs:IMO085Pre2017Exemption" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO085ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F03/ship> ] .

