@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "The ship must have at least two non-magnetic heading means." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:na65b2eacab9647ad8bb7a211e4e945c9b1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/heading1> ;
                    sh:resultMessage "Each non-magnetic heading means must identify an independent heading means." ;
                    sh:resultPath nltl:independentFromHeadingMeans ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:nonMagneticHeadingMeans ;
                            sh:message "Each non-magnetic heading means must identify an independent heading means." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:independentFromHeadingMeans ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "The ship must have at least two non-magnetic heading means." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:na65b2eacab9647ad8bb7a211e4e945c9b1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/heading1> ] .

_:na65b2eacab9647ad8bb7a211e4e945c9b1 sh:class nltl:nonMagneticHeadingMeans ;
    sh:message "The ship must have at least two non-magnetic heading means." ;
    sh:minCount 2 ;
    sh:node gen:IMO086HeadingMeansShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasNonMagneticHeadingMeans .

