_:na4224543728a440cb1be6c775ff420eeb1 sh:class nltl:nonMagneticHeadingMeans ;
    sh:message "The ship shall have at least two non-magnetic heading means." ;
    sh:minCount 2 ;
    sh:node gs:IMO086HeadingMeansShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasNonMagneticHeadingMeans .

_:na4224543728a440cb1be6c775ff420eeb4 sh:class nltl:benchmarkEntity ;
    sh:maxCount 1 ;
    sh:message "Each non-magnetic heading means shall have an independence relation to another heading means of the same ship." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:independentFromHeadingMeans .

_:na4224543728a440cb1be6c775ff420eeb5 sh:message "Each non-magnetic heading means shall be independent from another distinct non-magnetic heading means owned by the same ship." ;
    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>

SELECT $this
WHERE {
  FILTER NOT EXISTS {
    ?ship nltl:hasNonMagneticHeadingMeans $this .
    ?ship nltl:hasNonMagneticHeadingMeans ?other .
    FILTER (?other != $this)
    $this nltl:independentFromHeadingMeans ?other .
  }
}
""" .

