[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading1> ;
                    sh:resultMessage "Each non-magnetic heading means shall have an independence relation to another heading means of the same ship." ;
                    sh:resultPath nltl:independentFromHeadingMeans ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:na4224543728a440cb1be6c775ff420eeb4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading1> ;
                    sh:resultMessage "Each non-magnetic heading means shall be independent from another distinct non-magnetic heading means owned by the same ship." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:na4224543728a440cb1be6c775ff420eeb5 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gs:IMO086HeadingMeansShape ;
