@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "Each non-magnetic heading means must have a distinct independence relation to another heading means on the same ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each non-magnetic heading means must have a distinct independence relation to another heading means on the same ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasNonMagneticHeadingMeans ?means .
                FILTER NOT EXISTS {
                    ?means nltl:independentFromHeadingMeans ?other .
                    FILTER (?other != ?means)
                    $this nltl:hasNonMagneticHeadingMeans ?other .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO086ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/heading1> ;
                    sh:resultMessage "Each non-magnetic heading means must identify an independent non-magnetic heading means." ;
                    sh:resultPath nltl:independentFromHeadingMeans ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:nonMagneticHeadingMeans ;
                            sh:maxCount 1 ;
                            sh:message "Each non-magnetic heading means must identify an independent non-magnetic heading means." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:independentFromHeadingMeans ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "The ship must have at least two non-magnetic heading means." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nead145a9a0a848d1ae7fd47385d054d1b1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/heading1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "The ship must have at least two non-magnetic heading means." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nead145a9a0a848d1ae7fd47385d054d1b1 ] .

_:nead145a9a0a848d1ae7fd47385d054d1b1 sh:message "The ship must have at least two non-magnetic heading means." ;
    sh:minCount 2 ;
    sh:node gs:IMO086HeadingMeansShape ;
    sh:path nltl:hasNonMagneticHeadingMeans .

