@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-F01/ship> ;
            sh:resultMessage "The icebreaker escort applicability and, when applicable, the stopped-light requirements must conform." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_089_StaticShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-F01/ship> ] .

