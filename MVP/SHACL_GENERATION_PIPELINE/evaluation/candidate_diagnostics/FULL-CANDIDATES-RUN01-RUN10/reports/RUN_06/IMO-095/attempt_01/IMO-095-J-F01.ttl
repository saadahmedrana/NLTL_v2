@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F01/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath nltl:searchAndRescueCommunicationCapability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:na8ffdc6f369e453ba2f036cd706790f2b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F01/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath nltl:searchAndRescueCommunicationCapability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:na8ffdc6f369e453ba2f036cd706790f2b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F01/ship> ;
            sh:resultMessage "The ship shall support aircraft voice communication at 123.1 MHz." ;
            sh:resultPath nltl:supportedAircraftVoiceFrequency ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall support aircraft voice communication at 123.1 MHz." ;
                    sh:node nltl:IMO095AircraftFrequencyQuantityShape ;
                    sh:path nltl:supportedAircraftVoiceFrequency ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape nltl:IMO095Frequency123_1Shape ] ] .

_:na8ffdc6f369e453ba2f036cd706790f2b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall declare search and rescue communication capability." ;
    sh:minCount 1 ;
    sh:path nltl:searchAndRescueCommunicationCapability .

