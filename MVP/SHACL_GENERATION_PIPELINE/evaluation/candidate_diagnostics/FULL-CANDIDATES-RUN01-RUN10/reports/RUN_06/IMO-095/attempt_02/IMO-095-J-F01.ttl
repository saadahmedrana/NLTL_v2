@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F01/ship> ;
            sh:resultMessage "The ship shall support aircraft voice communication on both 121.5 MHz and 123.1 MHz." ;
            sh:resultPath nltl:supportedAircraftVoiceFrequency ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall support aircraft voice communication on both 121.5 MHz and 123.1 MHz." ;
                    sh:path nltl:supportedAircraftVoiceFrequency ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxInclusive 123.1 ;
                                    sh:minInclusive 123.1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaHZ> ;
                                    sh:path qudt:unit ] ] ;
                    sh:qualifiedValueShapesDisjoint true ] ] .

