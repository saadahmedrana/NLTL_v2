@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F03/ship> ;
            sh:resultMessage "The ship shall record voice or data communication with a relevant rescue coordination centre." ;
            sh:resultPath nltl:rescueCoordinationCentreVoiceOrData ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:message "The ship shall record voice or data communication with a relevant rescue coordination centre." ;
                    sh:minCount 1 ;
                    sh:path nltl:rescueCoordinationCentreVoiceOrData ] ] .

