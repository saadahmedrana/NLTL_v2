@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-099-J-F03/ship> ;
            sh:resultMessage "Communication equipment availability shall be at least the maximum expected rescue time." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Communication equipment availability shall be at least the maximum expected rescue time." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:communicationDeviceAvailability ?availability .
                ?availability qudt:numericValue ?availabilityValue .
                ?availability qudt:unit unit:DAY .
                $this nltl:maximumExpectedRescueTime ?rescueTime .
                ?rescueTime qudt:numericValue ?rescueValue .
                ?rescueTime qudt:unit unit:DAY .
                FILTER (?availabilityValue < ?rescueValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO099ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-099-J-F03/ship> ] .

