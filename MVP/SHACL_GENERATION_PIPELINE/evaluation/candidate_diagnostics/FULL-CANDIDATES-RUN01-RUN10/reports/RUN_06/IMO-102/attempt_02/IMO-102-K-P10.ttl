@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/ship> ;
            sh:resultMessage "Each applicable crew member shall have a polar training record with a required training level matching the clause 12.3.1 matrix, a matching training record level, and a valid STCW qualification." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each applicable crew member shall have a polar training record with a required training level matching the clause 12.3.1 matrix, a matching training record level, and a valid STCW qualification." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType ;
                      nltl:hasCrewMemberInventory ?crew .
                ?crew nltl:polarTrainingCrewRoleClassification ?role .
                BIND(
                    IF(
                        ?ice = nltl:iceFreeIceCondition,
                        nltl:polarTrainingNotApplicable,
                        IF(
                            ?ice = nltl:openWaterIceCondition,
                            IF(
                                ?shipType = nltl:otherShipPolarTrainingType,
                                nltl:polarTrainingNotApplicable,
                                nltl:basicPolarTrainingLevel
                            ),
                            IF(
                                ?role IN (
                                    nltl:masterPolarTrainingRole,
                                    nltl:chiefMatePolarTrainingRole
                                ),
                                nltl:advancedPolarTrainingLevel,
                                nltl:basicPolarTrainingLevel
                            )
                        )
                    )
                    AS ?requiredLevel
                )
                FILTER (?requiredLevel != nltl:polarTrainingNotApplicable)
                FILTER NOT EXISTS {
                    ?crew nltl:hasPolarTrainingRecord ?record .
                    ?record nltl:requiredTrainingLevel ?requiredLevel ;
                            nltl:trainingRecordLevel ?recordLevel ;
                            nltl:stcwQualificationValid true .
                    FILTER (?recordLevel = ?requiredLevel)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO102ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/trainingRecord> ;
                            sh:resultMessage "A polar training record shall have exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:in ( nltl:basicPolarTrainingLevel nltl:advancedPolarTrainingLevel nltl:polarTrainingNotApplicable ) ;
                                    sh:maxCount 1 ;
                                    sh:message "A polar training record shall have exactly one controlled required training level." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:requiredTrainingLevel ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:IMO102TrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasPolarTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node gen:IMO102TrainingRecordShape ;
                            sh:path nltl:hasPolarTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/trainingRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO102CrewMemberShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:IMO102CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/crew> ] .

