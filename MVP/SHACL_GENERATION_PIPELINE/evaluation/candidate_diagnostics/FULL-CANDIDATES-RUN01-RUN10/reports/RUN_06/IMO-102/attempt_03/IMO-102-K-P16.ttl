@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P16/crew> ;
            sh:resultMessage "A represented polar training record must have a valid STCW qualification." ;
            sh:resultPath nltl:stcwQualificationValid ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:na4bde98485e74f859a7b313b260628b0b24 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P16/crew> ;
            sh:resultMessage "A represented polar training record must have a valid STCW qualification." ;
            sh:resultPath nltl:stcwQualificationValid ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:na4bde98485e74f859a7b313b260628b0b24 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P16/crew> ;
            sh:resultMessage "A polar training record must state one controlled recorded training level." ;
            sh:resultPath nltl:trainingRecordLevel ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:basicPolarTrainingLevel nltl:advancedPolarTrainingLevel nltl:polarTrainingNotApplicable ) ;
                    sh:maxCount 1 ;
                    sh:message "A polar training record must state one controlled recorded training level." ;
                    sh:minCount 1 ;
                    sh:path nltl:trainingRecordLevel ] ] .

_:na4bde98485e74f859a7b313b260628b0b24 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "A represented polar training record must have a valid STCW qualification." ;
    sh:minCount 1 ;
    sh:path nltl:stcwQualificationValid .

