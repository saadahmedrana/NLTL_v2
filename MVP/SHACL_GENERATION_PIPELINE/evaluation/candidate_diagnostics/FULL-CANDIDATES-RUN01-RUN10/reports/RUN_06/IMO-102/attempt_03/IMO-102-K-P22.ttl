_:N7383d3d673724af189df3f51b0640a04 rdf:first nltl:polarTrainingNotApplicable ;
    rdf:rest () .

_:N8ac30a6fe6534dccb535bad94db887c0 rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest ( nltl:advancedPolarTrainingLevel nltl:polarTrainingNotApplicable ) .

_:na4bde98485e74f859a7b313b260628b0b15 sh:node gs:IMO102TrainingRecordShape ;
    sh:path nltl:hasCrewTrainingRecord .

