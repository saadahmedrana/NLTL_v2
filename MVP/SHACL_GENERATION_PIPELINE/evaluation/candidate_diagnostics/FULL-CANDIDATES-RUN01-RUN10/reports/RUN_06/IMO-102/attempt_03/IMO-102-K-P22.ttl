            sh:sourceShape [ sh:node gs:IMO102CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/crew> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/ship> ;
            sh:resultMessage "Each applicable crew member must have a training record whose required and recorded levels match the 12.3.1 matrix and whose STCW qualification is valid." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each applicable crew member must have a training record whose required and recorded levels match the 12.3.1 matrix and whose STCW qualification is valid." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType ;
                      nltl:hasCrewMemberInventory ?crew .
                ?crew nltl:polarTrainingCrewRoleClassification ?role .

                FILTER (
                    (
                        ?ice = nltl:openWaterIceCondition &&
                        (
                            ?shipType = nltl:tankerPolarTrainingShipType ||
                            ?shipType = nltl:passengerShipPolarTrainingShipType
                        )
                    ) ||
                    (
                        ?ice = nltl:otherWatersIceCondition
                    )
                )

                FILTER NOT EXISTS {
                    ?crew nltl:hasCrewTrainingRecord ?record .
                    ?record nltl:requiredTrainingLevel ?required ;
                            nltl:trainingRecordLevel ?recorded ;
                            nltl:stcwQualificationValid true .

                    FILTER (
                        (
                            ?ice = nltl:openWaterIceCondition &&
                            (
                                ?shipType = nltl:tankerPolarTrainingShipType ||
                                ?shipType = nltl:passengerShipPolarTrainingShipType
                            ) &&
                            (
                                ?role = nltl:masterPolarTrainingRole ||
                                ?role = nltl:chiefMatePolarTrainingRole ||
                                ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
                            ) &&
                            ?required = nltl:basicPolarTrainingLevel &&
                            ?recorded = nltl:basicPolarTrainingLevel
                        ) ||
                        (
                            ?ice = nltl:otherWatersIceCondition &&
                            (
                                ?role = nltl:masterPolarTrainingRole ||
                                ?role = nltl:chiefMatePolarTrainingRole
                            ) &&
                            ?required = nltl:advancedPolarTrainingLevel &&
                            ?recorded = nltl:advancedPolarTrainingLevel
                        ) ||
                        (
                            ?ice = nltl:otherWatersIceCondition &&
                            ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole &&
                            ?required = nltl:basicPolarTrainingLevel &&
                            ?recorded = nltl:basicPolarTrainingLevel
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO102ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/trainingRecord> ;
            sh:resultMessage "A polar training record must state one controlled required training level." ;
            sh:resultPath nltl:requiredTrainingLevel ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:na4bde98485e74f859a7b313b260628b0b16 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/crew> ;
            sh:resultMessage "A polar training record must state one controlled recorded training level." ;
            sh:resultPath nltl:trainingRecordLevel ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:basicPolarTrainingLevel nltl:advancedPolarTrainingLevel nltl:polarTrainingNotApplicable ) ;
                    sh:maxCount 1 ;
                    sh:message "A polar training record must state one controlled recorded training level." ;
                    sh:minCount 1 ;
                    sh:path nltl:trainingRecordLevel ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/crew> ;
            sh:resultMessage "A represented polar training record must have a valid STCW qualification." ;
            sh:resultPath nltl:stcwQualificationValid ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:na4bde98485e74f859a7b313b260628b0b24 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/crew> ;
            sh:resultMessage "A represented polar training record must have a valid STCW qualification." ;
            sh:resultPath nltl:stcwQualificationValid ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:na4bde98485e74f859a7b313b260628b0b24 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/trainingRecord> ;
                    sh:resultMessage "A polar training record must state one controlled required training level." ;
                    sh:resultPath nltl:requiredTrainingLevel ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:na4bde98485e74f859a7b313b260628b0b16 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/crew> ;
            sh:resultMessage "Value does not conform to Shape gs:IMO102TrainingRecordShape. See details for more information." ;
            sh:resultPath nltl:hasCrewTrainingRecord ;
            sh:resultSeverity sh:Violation ;
