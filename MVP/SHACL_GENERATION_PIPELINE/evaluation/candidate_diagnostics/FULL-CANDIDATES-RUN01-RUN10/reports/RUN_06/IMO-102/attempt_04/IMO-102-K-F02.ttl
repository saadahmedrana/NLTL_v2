@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F02/crew> ;
            sh:resultMessage "Less than 1 values on ex:crew->nltl:stcwQualificationValid" ;
            sh:resultPath nltl:stcwQualificationValid ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:stcwQualificationValid ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F02/trainingRecord> ;
            sh:resultMessage "Less than 1 values on ex:trainingRecord->nltl:requiredTrainingLevel" ;
            sh:resultPath nltl:requiredTrainingLevel ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:basicPolarTrainingLevel nltl:advancedPolarTrainingLevel nltl:polarTrainingNotApplicable ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:requiredTrainingLevel ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F02/crew> ;
            sh:resultMessage "Each applicable crew member shall have the required training level, a matching training record through both declared record relationships, and a valid STCW qualification." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each applicable crew member shall have the required training level, a matching training record through both declared record relationships, and a valid STCW qualification." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                ?ship nltl:hasCrewMemberInventory $this ;
                      nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType .
                $this nltl:polarTrainingCrewRoleClassification ?role .

                FILTER (
                    (
                        ?ice = nltl:openWaterIceCondition &&
                        (
                            ?shipType = nltl:tankerPolarTrainingShipType ||
                            ?shipType = nltl:passengerShipPolarTrainingShipType
                        )
                    )
                    ||
                    (
                        ?ice = nltl:otherWatersIceCondition &&
                        (
                            ?role = nltl:masterPolarTrainingRole ||
                            ?role = nltl:chiefMatePolarTrainingRole ||
                            ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
                        )
                    )
                )

                FILTER NOT EXISTS {
                    $this nltl:hasCrewTrainingRecord ?record ;
                          nltl:hasPolarTrainingRecord ?record .

                    ?record nltl:requiredTrainingLevel ?requiredLevel ;
                            nltl:trainingRecordLevel ?recordLevel ;
                            nltl:stcwQualificationValid ?stcwValid .

                    FILTER (
                        ?stcwValid = true &&
                        ?requiredLevel = ?recordLevel &&
                        (
                            (
                                ?ice = nltl:openWaterIceCondition &&
                                (
                                    ?shipType = nltl:tankerPolarTrainingShipType ||
                                    ?shipType = nltl:passengerShipPolarTrainingShipType
                                ) &&
                                ?requiredLevel = nltl:basicPolarTrainingLevel
                            )
                            ||
                            (
                                ?ice = nltl:otherWatersIceCondition &&
                                (
                                    ?role = nltl:masterPolarTrainingRole ||
                                    ?role = nltl:chiefMatePolarTrainingRole
                                ) &&
                                ?requiredLevel = nltl:advancedPolarTrainingLevel
                            )
                            ||
                            (
                                ?ice = nltl:otherWatersIceCondition &&
                                ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole &&
                                ?requiredLevel = nltl:basicPolarTrainingLevel
                            )
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO102CrewMemberShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F02/crew> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F02/crew> ;
            sh:resultMessage "Less than 1 values on ex:crew->nltl:trainingRecordLevel" ;
            sh:resultPath nltl:trainingRecordLevel ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:basicPolarTrainingLevel nltl:advancedPolarTrainingLevel nltl:polarTrainingNotApplicable ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:trainingRecordLevel ] ] .

