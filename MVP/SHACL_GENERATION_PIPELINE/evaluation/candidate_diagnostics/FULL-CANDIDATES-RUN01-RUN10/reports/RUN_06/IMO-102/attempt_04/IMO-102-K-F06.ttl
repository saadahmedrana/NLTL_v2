@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ;
            sh:resultMessage "Less than 1 values on ex:crew->nltl:trainingRecordLevel" ;
            sh:resultPath nltl:trainingRecordLevel ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:basicPolarTrainingLevel nltl:advancedPolarTrainingLevel nltl:polarTrainingNotApplicable ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:trainingRecordLevel ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ;
            sh:resultMessage "Less than 1 values on ex:trainingRecord->nltl:requiredTrainingLevel" ;
            sh:resultPath nltl:requiredTrainingLevel ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:basicPolarTrainingLevel nltl:advancedPolarTrainingLevel nltl:polarTrainingNotApplicable ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:requiredTrainingLevel ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ;
            sh:resultMessage "Each represented crew member shall have exactly one controlled polar training role." ;
            sh:resultPath nltl:polarTrainingCrewRoleClassification ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:masterPolarTrainingRole nltl:chiefMatePolarTrainingRole nltl:officerInChargeOfNavigationalWatchPolarTrainingRole ) ;
                    sh:maxCount 1 ;
                    sh:message "Each represented crew member shall have exactly one controlled polar training role." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarTrainingCrewRoleClassification ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ;
            sh:resultMessage "Less than 1 values on ex:crew->nltl:stcwQualificationValid" ;
            sh:resultPath nltl:stcwQualificationValid ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:stcwQualificationValid ] ] .

