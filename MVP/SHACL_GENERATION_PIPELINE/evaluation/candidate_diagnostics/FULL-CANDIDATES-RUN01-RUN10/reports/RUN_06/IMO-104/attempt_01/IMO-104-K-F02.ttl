@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ;
            sh:resultMessage "The ship must record completed PWOM familiarization status." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ne4cf4f6a2dca4cbbb0295731bd211cefb1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/crew1> ;
                    sh:resultMessage "Each crew member must have a PWOM familiarization record." ;
                    sh:resultPath nltl:hasFamiliarizationRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each crew member must have a PWOM familiarization record." ;
                            sh:minCount 1 ;
                            sh:node gen:IMO_104_FamiliarizationRecordShape ;
                            sh:path nltl:hasFamiliarizationRecord ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO_104_CrewMemberShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:IMO_104_CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/crew1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ;
            sh:resultMessage "Each crew member must have a familiarization record item for every PWOM procedure or equipment item relevant to an assigned duty." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each crew member must have a familiarization record item for every PWOM procedure or equipment item relevant to an assigned duty." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:hasCrewMemberInventory ?crewMember .
                ?crewMember nltl:hasAssignedDuty ?assignedDuty .
                ?assignedDuty nltl:hasRelevantPolarWaterOperationalManualItem ?manualItem .
                FILTER NOT EXISTS {
                    ?crewMember nltl:hasFamiliarizationRecord ?record .
                    ?record nltl:familiarizationRecordItem ?manualItem .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_104_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ;
            sh:resultMessage "The ship must record completed PWOM familiarization status." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ne4cf4f6a2dca4cbbb0295731bd211cefb1 ] .

_:ne4cf4f6a2dca4cbbb0295731bd211cefb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record completed PWOM familiarization status." ;
    sh:minCount 1 ;
    sh:path nltl:polarWaterOperationalManualFamiliarizationStatus .

