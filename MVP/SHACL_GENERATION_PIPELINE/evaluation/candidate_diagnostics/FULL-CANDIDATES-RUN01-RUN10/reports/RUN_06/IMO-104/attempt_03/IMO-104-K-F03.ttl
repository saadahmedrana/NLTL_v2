@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/crew1> ;
                    sh:resultMessage "Each crew member must have an assigned duty linked to relevant PWOM content." ;
                    sh:resultPath nltl:hasAssignedDuty ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each crew member must have an assigned duty linked to relevant PWOM content." ;
                            sh:minCount 1 ;
                            sh:node gen:IMO_104_AssignedDutyShape ;
                            sh:path nltl:hasAssignedDuty ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "The ship must provide the required crew-member inventory path." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the required crew-member inventory path." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO_104_CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/crew1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "The ship must link its crew members." ;
            sh:resultPath nltl:hasCrewMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must link its crew members." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO_104_CrewMemberShape ;
                    sh:path nltl:hasCrewMember ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "The ship must record completed PWOM familiarization." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ndaca859f85ac40eeaae440c4c0994f32b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "The ship must record completed PWOM familiarization." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ndaca859f85ac40eeaae440c4c0994f32b1 ] .

_:ndaca859f85ac40eeaae440c4c0994f32b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record completed PWOM familiarization." ;
    sh:minCount 1 ;
    sh:path nltl:polarWaterOperationalManualFamiliarizationStatus .

