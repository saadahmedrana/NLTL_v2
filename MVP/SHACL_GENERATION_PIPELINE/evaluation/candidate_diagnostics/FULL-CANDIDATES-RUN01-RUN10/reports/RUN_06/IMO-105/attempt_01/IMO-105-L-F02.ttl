@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-105-L-F02/ship> ;
            sh:resultMessage "The ship's operating area must establish whether the Arctic-water discharge prohibition applies." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO105ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-105-L-F02/ship> ] .

