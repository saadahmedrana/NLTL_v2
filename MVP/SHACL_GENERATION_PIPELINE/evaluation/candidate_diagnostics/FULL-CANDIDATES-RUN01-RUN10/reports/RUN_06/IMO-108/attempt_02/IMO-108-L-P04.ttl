@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-P04/oilFuelTankOuterShellSeparationValue> ;
                    sh:resultMessage "Applicable oil fuel tanks must be separated from the outer shell by at least 0.76 m." ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:message "Applicable oil fuel tanks must be separated from the outer shell by at least 0.76 m." ;
                            sh:minCount 1 ;
                            sh:minInclusive 0.76 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 0.0 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-P04/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Applicable oil fuel tanks must be separated from the outer shell by at least 0.76 m.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"0.76\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Oil fuel tank outer shell separation must use unit:M.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:oilFuelTankOuterShellSeparation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:message "Applicable oil fuel tanks must be separated from the outer shell by at least 0.76 m." ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 0.76 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:message "Oil fuel tank outer shell separation must use unit:M." ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:oilFuelTankOuterShellSeparation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-P04/oilFuelTankOuterShellSeparationValue> ] .

