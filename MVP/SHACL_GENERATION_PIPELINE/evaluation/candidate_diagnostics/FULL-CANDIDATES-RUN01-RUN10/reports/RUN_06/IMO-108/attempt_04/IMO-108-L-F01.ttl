@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-F01/ship> ;
            sh:resultMessage "For an applicable ship, every represented oil fuel tank separation must be a valid metre measurement of at least 0.76 m, and at least one valid measurement must be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an applicable ship, every represented oil fuel tank separation must be a valid metre measurement of at least 0.76 m, and at least one valid measurement must be present." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:shipCategory ?category ;
        nltl:constructionDate ?date ;
        nltl:aggregateOilFuelCapacity ?aggregateQuantity ;
        nltl:individualOilFuelTankCapacity ?individualQuantity .

  ?aggregateQuantity a qudt:QuantityValue ;
                     qudt:numericValue ?aggregateValue ;
                     qudt:unit unit:M3 .
  ?individualQuantity a qudt:QuantityValue ;
                      qudt:numericValue ?individualValue ;
                      qudt:unit unit:M3 .

  FILTER (
    ?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB)
    && datatype(?date) = xsd:date
    && ?date >= "2017-01-01"^^xsd:date
    && datatype(?aggregateValue) = xsd:decimal
    && ?aggregateValue < "600"^^xsd:decimal
    && datatype(?individualValue) = xsd:decimal
    && ?individualValue > "30"^^xsd:decimal
  )

  FILTER (
    NOT EXISTS {
      $this nltl:oilFuelTankOuterShellSeparation ?validSeparation .
      ?validSeparation a qudt:QuantityValue ;
                       qudt:numericValue ?validValue ;
                       qudt:unit unit:M .
      FILTER (
        datatype(?validValue) = xsd:decimal
        && ?validValue >= "0.76"^^xsd:decimal
      )
    }
    ||
    EXISTS {
      $this nltl:oilFuelTankOuterShellSeparation ?representedSeparation .
      FILTER NOT EXISTS {
        ?representedSeparation a qudt:QuantityValue ;
                               qudt:numericValue ?representedValue ;
                               qudt:unit unit:M .
        FILTER (
          datatype(?representedValue) = xsd:decimal
          && ?representedValue >= "0.76"^^xsd:decimal
        )
      }
    }
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-108> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-F01/ship> ] .

