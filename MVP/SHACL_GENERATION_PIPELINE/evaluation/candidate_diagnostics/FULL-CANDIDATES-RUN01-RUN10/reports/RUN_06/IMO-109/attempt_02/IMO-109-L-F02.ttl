@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-F02/ship> ;
            sh:resultMessage "For an applicable Category A or B non-oil-tanker ship constructed on or after 1 January 2017 whose cargo tanks carry oil, the cargo tank outer shell separation must be at least 0.76 m and use unit M." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an applicable Category A or B non-oil-tanker ship constructed on or after 1 January 2017 whose cargo tanks carry oil, the cargo tank outer shell separation must be at least 0.76 m and use unit M." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:shipType ?shipType ;
                      nltl:constructionDate ?constructionDate ;
                      nltl:cargoTankCarriesOil true .

                FILTER (?category IN (
                    nltl:polarShipCategoryA,
                    nltl:polarShipCategoryB
                ))
                FILTER (?shipType != "oil_tanker")
                FILTER (?constructionDate >= "2017-01-01"^^xsd:date)

                FILTER NOT EXISTS {
                    $this nltl:cargoTankOuterShellSeparation ?separation .
                    ?separation a qudt:QuantityValue ;
                                qudt:numericValue ?value ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                    FILTER (?value >= 0.76)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_109_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-F02/ship> ] .

