@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-110-L-F02/ship> ;
            sh:resultMessage "Node ex:ship->nltl:shipType does not contain a value in the set: ['Literal(\"oil_tanker\")']" ;
            sh:resultPath nltl:shipType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:hasValue "oil_tanker" ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:shipType ] ] .

