@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-112-M-F02/ship> ;
            sh:resultMessage "The ship must specify its operating area so the Arctic waters discharge prohibition can be evaluated." ;
            sh:resultPath nltl:operatingArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must specify its operating area so the Arctic waters discharge prohibition can be evaluated." ;
                    sh:minCount 1 ;
                    sh:path nltl:operatingArea ] ] .

