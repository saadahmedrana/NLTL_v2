@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-P04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The applicable polar operation shall be reflected in the required certificate.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:applicableCertificatePolarOperationEntryPresent ], [ sh:hasValue Literal("3") ; sh:path nltl:cargoTankType ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ], [ sh:hasValue nltl:evidenceStateApproved ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Applicable carriage of NLS in type 3 cargo tanks requires Administration approval.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:administrationCarriageApprovalStatus ], [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ; sh:path nltl:shipCategory ], [ sh:minInclusive Literal("2017-01-01", datatype=xsd:date) ; sh:path nltl:constructionDate ] ] , [ sh:sparql [ sh:message Literal("If the conditional applicability criteria are not all satisfied, the approval and certificate-entry obligations do not apply.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:shipCategory ?category ;
                              nltl:constructionDate ?date ;
                              nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ?requiresTank ;
                              nltl:cargoTankType ?tankType .
                        FILTER (
                            ?category NOT IN (
                                nltl:polarShipCategoryA,
                                nltl:polarShipCategoryB
                            )
                            || ?date < "2017-01-01"^^xsd:date
                            || ?requiresTank = false
                            || ?tankType != "3"
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-114> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-P04/ship> ] .

