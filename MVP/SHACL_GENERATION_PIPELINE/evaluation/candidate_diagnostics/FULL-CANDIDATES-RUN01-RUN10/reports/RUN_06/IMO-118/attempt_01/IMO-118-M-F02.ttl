@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F02/ship> ;
            sh:resultMessage "Sewage discharge to sea must be false for an applicable ship unless compliance with paragraph 4.2.1.3 is recorded as true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Sewage discharge to sea must be false for an applicable ship unless compliance with paragraph 4.2.1.3 is recorded as true." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?date .
                FILTER (?date >= "2017-01-01"^^xsd:date)
                {
                    $this nltl:shipCategory ?category .
                    FILTER (?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    ))
                }
                UNION
                {
                    $this rdf:type nltl:passengerShip .
                }
                FILTER NOT EXISTS {
                    $this nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus true .
                }
                FILTER NOT EXISTS {
                    $this nltl:sewageDischargeToSea false .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-118> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F02/ship> ] .

