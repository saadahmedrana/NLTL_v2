@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-P04/ship> ;
            sh:resultMessage "For a ship constructed on or after 1 January 2017, passenger-ship applicability evidence is required when the category is not A or B." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a ship constructed on or after 1 January 2017, passenger-ship applicability evidence is required when the category is not A or B." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?date .
                FILTER (?date >= "2017-01-01"^^xsd:date)
                FILTER NOT EXISTS {
                    $this nltl:shipCategory nltl:polarShipCategoryA .
                }
                FILTER NOT EXISTS {
                    $this nltl:shipCategory nltl:polarShipCategoryB .
                }
                FILTER NOT EXISTS {
                    $this rdf:type nltl:passengerShip .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-118> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-P04/ship> ] .

