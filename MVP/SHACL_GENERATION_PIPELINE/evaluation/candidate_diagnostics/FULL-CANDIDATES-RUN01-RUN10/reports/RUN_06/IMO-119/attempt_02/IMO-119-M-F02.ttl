@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F02/ship> ;
            sh:resultMessage "When the applicability conditions hold, an approved sewage treatment plant and compliant MARPOL certification statuses are required, together with Administration approval." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the applicability conditions hold, an approved sewage treatment plant and compliant MARPOL certification statuses are required, together with Administration approval." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                FILTER (?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))

                $this nltl:iceConcentration ?ice .
                ?ice qudt:numericValue ?iceValue ;
                     qudt:unit unit:UNITLESS .
                FILTER (datatype(?iceValue) = xsd:decimal && ?iceValue > 1)

                $this nltl:extendedPeriodOperation true .
                $this nltl:sewageDischargeOccurs true .

                FILTER (
                    NOT EXISTS {
                        $this nltl:approvedSewageTreatmentPlantUsed true
                    }
                    ||
                    EXISTS {
                        $this nltl:approvedSewageTreatmentPlantUsed ?approvedUsed .
                        FILTER (?approvedUsed != true)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus
                            nltl:complianceStateCompliant
                    }
                    ||
                    EXISTS {
                        $this nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ?annexStatus .
                        FILTER (?annexStatus != nltl:complianceStateCompliant)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:marpolCertificationStatus nltl:complianceStateCompliant
                    }
                    ||
                    EXISTS {
                        $this nltl:marpolCertificationStatus ?marpolStatus .
                        FILTER (?marpolStatus != nltl:complianceStateCompliant)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:administrationDischargeApprovalStatus nltl:evidenceStateApproved
                    }
                    ||
                    EXISTS {
                        $this nltl:administrationDischargeApprovalStatus ?approvalStatus .
                        FILTER (?approvalStatus != nltl:evidenceStateApproved)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_119_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F02/ship> ] .

