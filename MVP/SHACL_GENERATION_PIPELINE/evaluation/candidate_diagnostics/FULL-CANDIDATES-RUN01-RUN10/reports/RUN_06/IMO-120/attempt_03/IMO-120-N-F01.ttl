@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The distance from the area whose ice concentration exceeds one tenth must be recorded.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MI_N ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The nearby ice concentration must exceed one tenth.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minExclusive Literal("0.1", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:nearbyIceConcentration ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The nearest land, ice-shelf, or fast-ice distance must be at least 12 nautical miles.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("12", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MI_N ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:distanceToNearestLandIceShelfOrFastIce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The recorded ice concentration for the relevant area must exceed one tenth.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minExclusive Literal("0.1", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:iceConcentration ] ; sh:sparql [ sh:message Literal("For Arctic-waters food-waste discharge, the concentration observation exceeding one tenth and its recorded distance must be paired on the same ship.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:operatingArea ?area ;
                              nltl:foodWasteDischargeToSea ?discharge ;
                              nltl:nearbyIceConcentration ?nearbyQuantity ;
                              nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?recordedDistance .
                        ?nearbyQuantity qudt:numericValue ?nearbyValue ;
                                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (
                            ?area = "Arctic_waters"^^xsd:string &&
                            ?discharge = true &&
                            ?nearbyValue > "0.1"^^xsd:decimal
                        )
                    }
                ") ] ] , [ sh:sparql [ sh:message Literal("The conditional Arctic-waters food-waste-discharge rule is not applicable only when the operating area is not Arctic_waters or food waste is not discharged to sea.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:operatingArea ?area ;
                              nltl:foodWasteDischargeToSea ?discharge .
                        FILTER (
                            ?area != "Arctic_waters"^^xsd:string ||
                            ?discharge != true
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-120> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-F01/ship> ] .

