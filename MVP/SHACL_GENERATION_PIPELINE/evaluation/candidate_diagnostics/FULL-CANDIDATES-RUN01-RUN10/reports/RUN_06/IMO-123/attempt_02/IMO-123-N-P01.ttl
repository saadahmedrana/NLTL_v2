@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-P01/nearbyIceConcentrationValue> ;
                    sh:resultMessage "Node ex:nearbyIceConcentrationValue->qudt:unit does not contain a value in the set: ['qudt:UNITLESS']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-P01/ship> ;
            sh:resultMessage "The nearby ice concentration must be a decimal quantity greater than 0.1 and use the canonical unitless unit." ;
            sh:resultPath nltl:nearbyIceConcentration ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The nearby ice concentration must be a decimal quantity greater than 0.1 and use the canonical unitless unit." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:minExclusive 0.1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:nearbyIceConcentration ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-P01/nearbyIceConcentrationValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-P01/distanceToAreaWithIceConcentrationGreaterThanOneTenthValue> ;
                            sh:resultMessage "Node ex:distanceToAreaWithIceConcentrationGreaterThanOneTenthValue->qudt:unit does not contain a value in the set: ['qudt:MI_N']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:MI_N ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-P01/distanceRecord> ;
                    sh:resultMessage "The discharge-distance record must record the distance from the area with ice concentration greater than one tenth in nautical miles." ;
                    sh:resultPath nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The discharge-distance record must record the distance from the area with ice concentration greater than one tenth in nautical miles." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue qudt:MI_N ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-P01/distanceToAreaWithIceConcentrationGreaterThanOneTenthValue> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-P01/distanceToNearestLandIceShelfOrFastIceValue> ;
                            sh:resultMessage "Node ex:distanceToNearestLandIceShelfOrFastIceValue->qudt:unit does not contain a value in the set: ['qudt:MI_N']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:MI_N ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-P01/distanceRecord> ;
                    sh:resultMessage "The distance from the nearest land, ice shelf, or fast ice must be at least 12 nautical miles." ;
                    sh:resultPath nltl:distanceToNearestLandIceShelfOrFastIce ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The distance from the nearest land, ice shelf, or fast ice must be at least 12 nautical miles." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:minInclusive 12.0 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue qudt:MI_N ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:distanceToNearestLandIceShelfOrFastIce ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-P01/distanceToNearestLandIceShelfOrFastIceValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-P01/ship> ;
            sh:resultMessage "The ship must have a discharge-distance record containing both required distances." ;
            sh:resultPath nltl:hasDischargeDistanceRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:dischargeDistanceRecords ;
                    sh:message "The ship must have a discharge-distance record containing both required distances." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO123DischargeDistanceRecordShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasDischargeDistanceRecord ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-P01/distanceRecord> ] .

