@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-001-A-F01/ship> ;
            sh:resultMessage "Polar Code chapter 9 applicability must be true for a SOLAS chapter I certified ship, and must not be true for a ship without that certification." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Polar Code chapter 9 applicability must be true for a SOLAS chapter I certified ship, and must not be true for a ship without that certification." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:solasChapterICertified true .
                    FILTER NOT EXISTS {
                        $this nltl:polarCodeChapter9Applicable true .
                    }
                }
                UNION
                {
                    $this nltl:polarCodeChapter9Applicable true .
                    FILTER NOT EXISTS {
                        $this nltl:solasChapterICertified true .
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-001> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-001-A-F01/ship> ] .

