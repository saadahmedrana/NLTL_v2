@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:IMO26_002_FishingApplicable , gs:IMO26_002_FishingNotApplicable , gs:IMO26_002_PleasureApplicable , gs:IMO26_002_PleasureNotApplicableTrade , gs:IMO26_002_PleasureNotApplicableSmallTrade , gs:IMO26_002_PleasureNotApplicableSmall , gs:IMO26_002_CargoApplicable , gs:IMO26_002_CargoNotApplicableSmall , gs:IMO26_002_CargoNotApplicableLarge" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO26_002_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/ship> ] .

