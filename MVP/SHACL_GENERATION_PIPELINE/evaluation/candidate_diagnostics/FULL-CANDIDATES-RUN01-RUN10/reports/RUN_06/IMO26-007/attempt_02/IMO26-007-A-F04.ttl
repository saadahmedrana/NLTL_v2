@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-007-A-F04/ship> ;
            sh:resultMessage "Ice-strengthened ships constructed on or after 2026-01-01 require either two independent echo-sounding devices, one device with two independent transducers, or an administration-approved equivalent device." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO26_007_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-007-A-F04/ship> ] .

