@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-009-A-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"iceAccretionLikely must be explicitly false when the conditional antenna requirement is not applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ] ] , [ sh:property [ sh:class nltl:navigationOrCommunicationAntenna ; sh:node [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Every required navigation or communication antenna must have ice accumulation prevention.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:antennaIceAccumulationPreventionPresent ] ] ; sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"iceAccretionLikely must be explicitly true when the conditional antenna requirement applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-009-antenna-ice-prevention> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-009-A-F01/ship> ] .

