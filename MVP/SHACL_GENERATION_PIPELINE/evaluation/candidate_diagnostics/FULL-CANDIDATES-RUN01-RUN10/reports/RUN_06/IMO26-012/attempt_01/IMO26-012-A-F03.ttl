@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F03/heading1> ;
                    sh:resultMessage "Each non-magnetic heading means shall be connected to the emergency power source." ;
                    sh:resultPath nltl:connectedToEmergencyPower ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n91d5845b92d340a3a8ac6ae713e170c0b4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F03/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic heading means." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n91d5845b92d340a3a8ac6ae713e170c0b1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F03/heading1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F03/ship> ;
            sh:resultMessage "Each non-magnetic heading means shall be independently related to another distinct heading means belonging to the same ship and shall have both required power connections." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each non-magnetic heading means shall be independently related to another distinct heading means belonging to the same ship and shall have both required power connections." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT $this
WHERE {
  ?this nltl:hasNonMagneticHeadingMeans ?means .
  FILTER (
    NOT EXISTS {
      ?means nltl:connectedToMainPower ?mainPower .
    }
    ||
    NOT EXISTS {
      ?means nltl:connectedToEmergencyPower ?emergencyPower .
    }
    ||
    NOT EXISTS {
      ?means nltl:independentFromHeadingMeans ?otherMeans .
      FILTER (?otherMeans != ?means)
      ?this nltl:hasNonMagneticHeadingMeans ?otherMeans .
    }
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-012_ShipHeadingMeansShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F03/heading2> ;
                    sh:resultMessage "Each non-magnetic heading means shall be connected to the emergency power source." ;
                    sh:resultPath nltl:connectedToEmergencyPower ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n91d5845b92d340a3a8ac6ae713e170c0b4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F03/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic heading means." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n91d5845b92d340a3a8ac6ae713e170c0b1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F03/heading2> ] .

_:N0f41cbb54a6b4d7dbe372a2685db7a7a sh:class nltl:benchmarkEntity ;
    sh:maxCount 1 ;
    sh:message "Each non-magnetic heading means shall be connected to the main power source." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:connectedToMainPower .

_:N2824125f9dd547c79f3436016ad2d70e sh:class nltl:benchmarkEntity ;
    sh:maxCount 1 ;
    sh:message "Each non-magnetic heading means shall be connected to the emergency power source." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:connectedToEmergencyPower .

_:N3913903ef0554c3e8b1ba30dfc868d2c sh:property _:N0f41cbb54a6b4d7dbe372a2685db7a7a,
        _:N2824125f9dd547c79f3436016ad2d70e,
        [ sh:class nltl:nonMagneticHeadingMeans ;
            sh:message "Each non-magnetic heading means shall have an independence relationship to another heading means." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path nltl:independentFromHeadingMeans ] .

_:n91d5845b92d340a3a8ac6ae713e170c0b1 sh:class nltl:nonMagneticHeadingMeans ;
    sh:message "The ship shall have at least two non-magnetic heading means." ;
    sh:minCount 2 ;
    sh:node _:N3913903ef0554c3e8b1ba30dfc868d2c ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasNonMagneticHeadingMeans .

_:n91d5845b92d340a3a8ac6ae713e170c0b4 sh:class nltl:benchmarkEntity ;
    sh:maxCount 1 ;
    sh:message "Each non-magnetic heading means shall be connected to the emergency power source." ;
    sh:minCount 1 ;
