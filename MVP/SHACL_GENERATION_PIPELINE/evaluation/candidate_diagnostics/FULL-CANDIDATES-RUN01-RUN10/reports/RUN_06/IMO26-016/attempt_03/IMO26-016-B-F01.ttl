@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F01/ship> ;
            sh:resultMessage "For a ship operating in polar waters, chapter 11-1 applicability must be true for a qualifying fishing vessel, pleasure yacht, or cargo ship; it must not be true for a non-qualifying or non-polar ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a ship operating in polar waters, chapter 11-1 applicability must be true for a qualifying fishing vessel, pleasure yacht, or cargo ship; it must not be true for a non-qualifying or non-polar ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters ?polar ;
                      nltl:shipType ?type .

                OPTIONAL {
                    $this nltl:lengthOverall ?lengthNode .
                    ?lengthNode qudt:numericValue ?lengthValue .
                }

                OPTIONAL {
                    $this nltl:grossTonnage ?tonnageNode .
                    ?tonnageNode qudt:numericValue ?tonnageValue .
                }

                OPTIONAL {
                    $this nltl:engagedInTrade ?trade .
                }

                OPTIONAL {
                    $this nltl:polarCodeChapter11Dash1Applicable ?applicable .
                }

                FILTER (
                    (
                        ?polar = false &&
                        BOUND(?applicable) &&
                        ?applicable = true
                    )
                    ||
                    (
                        ?polar = true &&
                        ?type = "fishing_vessel"^^xsd:string &&
                        (
                            !BOUND(?lengthValue) ||
                            ?lengthValue < 24 ||
                            !BOUND(?applicable) ||
                            ?applicable != true
                        )
                    )
                    ||
                    (
                        ?polar = true &&
                        ?type = "pleasure_yacht"^^xsd:string &&
                        (
                            !BOUND(?tonnageValue) ||
                            ?tonnageValue < 300 ||
                            !BOUND(?trade) ||
                            ?trade != false ||
                            !BOUND(?applicable) ||
                            ?applicable != true
                        )
                    )
                    ||
                    (
                        ?polar = true &&
                        ?type = "cargo_ship"^^xsd:string &&
                        (
                            !BOUND(?tonnageValue) ||
                            ?tonnageValue < 300 ||
                            ?tonnageValue >= 500 ||
                            !BOUND(?applicable) ||
                            ?applicable != true
                        )
                    )
                    ||
                    (
                        ?polar = true &&
                        ?type NOT IN (
                            "fishing_vessel"^^xsd:string,
                            "pleasure_yacht"^^xsd:string,
                            "cargo_ship"^^xsd:string
                        ) &&
                        BOUND(?applicable) &&
                        ?applicable = true
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-016> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F01/ship> ] .

