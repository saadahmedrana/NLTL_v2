@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F03/ship> ;
            sh:resultMessage "The ship's polar-water operating status is required and must be single-valued." ;
            sh:resultPath nltl:shipOperatesInPolarWaters ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ship's polar-water operating status is required and must be single-valued." ;
                    sh:minCount 1 ;
                    sh:path nltl:shipOperatesInPolarWaters ] ] .

