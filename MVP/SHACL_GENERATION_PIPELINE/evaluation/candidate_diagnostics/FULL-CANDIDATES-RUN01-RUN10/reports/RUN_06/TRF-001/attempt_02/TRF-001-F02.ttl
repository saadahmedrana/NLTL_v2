@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "The 2021 Ice Class Regulations section 1.8 provision must apply." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n35f83702359a4e93a1e2919462f54698b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "A ship must provide one construction contract date to determine applicability." ;
            sh:resultPath nltl:constructionContractDate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:date ;
                    sh:maxCount 1 ;
                    sh:message "A ship must provide one construction contract date to determine applicability." ;
                    sh:minCount 1 ;
                    sh:path nltl:constructionContractDate ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "The 2021 Ice Class Regulations chapter 2 provision must apply." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n35f83702359a4e93a1e2919462f54698b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "The 2021 Ice Class Regulations chapter 2 provision must apply." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n35f83702359a4e93a1e2919462f54698b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "The 2021 Ice Class Regulations section 1.8 provision must apply." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n35f83702359a4e93a1e2919462f54698b2 ] .

_:n35f83702359a4e93a1e2919462f54698b2 sh:hasValue nltl:iceClassSection1Point8Provision2021 ;
    sh:message "The 2021 Ice Class Regulations section 1.8 provision must apply." ;
    sh:minCount 1 ;
    sh:path nltl:applicableIceClassRegulatoryProvision .

_:n35f83702359a4e93a1e2919462f54698b3 sh:hasValue nltl:iceClassDraughtChapter2Provision2021 ;
    sh:message "The 2021 Ice Class Regulations chapter 2 provision must apply." ;
    sh:minCount 1 ;
    sh:path nltl:applicableIceClassRegulatoryProvision .

