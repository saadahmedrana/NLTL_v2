            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-P03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:iceClassRegulationEdition2021 ; sh:message Literal("Ships contracted on or after 5 July 2021 must identify the 2021 Ice Class Regulations edition.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:applicableIceClassRegulationEdition ] ; sh:sparql [ sh:message Literal("The 2021 Ice Class Regulations edition applies to ships contracted on or after 5 July 2021.") ; sh:select Literal("
