@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "The section 1.8 provision of the 2021 Ice Class Regulations must apply." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n5d4e78a9b73f4d6f9ff7f6eb84408a14b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "The chapter 2 Ice Class Draught provision of the 2021 Ice Class Regulations must apply." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n5d4e78a9b73f4d6f9ff7f6eb84408a14b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "The chapter 2 Ice Class Draught provision of the 2021 Ice Class Regulations must apply." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n5d4e78a9b73f4d6f9ff7f6eb84408a14b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "The section 1.8 provision of the 2021 Ice Class Regulations must apply." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n5d4e78a9b73f4d6f9ff7f6eb84408a14b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal("2021-07-05", datatype=xsd:date) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionContractDate ] ; sh:sparql [ sh:message Literal("A ship contracted before 5 July 2021 must not assert the 2021 Ice Class Regulations edition.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionContractDate ?date .
                        FILTER (
                            ?date >= "2021-07-05"^^xsd:date
                            || EXISTS {
                                $this nltl:applicableIceClassRegulationEdition
                                    nltl:iceClassRegulationEdition2021 .
                            }
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:date ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("2021-07-05", datatype=xsd:date) ; sh:path nltl:constructionContractDate ], [ sh:hasValue nltl:iceClassRegulationEdition2021 ; sh:message Literal("Ships contracted on or after 5 July 2021 must identify the 2021 Ice Class Regulations edition.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:applicableIceClassRegulationEdition ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF001ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ] .

_:n5d4e78a9b73f4d6f9ff7f6eb84408a14b1 sh:hasValue nltl:iceClassSection1Point8Provision2021 ;
    sh:message "The section 1.8 provision of the 2021 Ice Class Regulations must apply." ;
    sh:minCount 1 ;
    sh:path nltl:applicableIceClassRegulatoryProvision .

_:n5d4e78a9b73f4d6f9ff7f6eb84408a14b2 sh:hasValue nltl:iceClassDraughtChapter2Provision2021 ;
    sh:message "The chapter 2 Ice Class Draught provision of the 2021 Ice Class Regulations must apply." ;
    sh:minCount 1 ;
    sh:path nltl:applicableIceClassRegulatoryProvision .

