@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:iceClassRegulationEdition2008 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Ships contracted from 1 January 2010 to before 1 January 2012 must identify the 2008 Ice Class Regulations.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:applicableIceClassRegulationEdition ] ; sh:sparql [ sh:message Literal("The construction contract date must be on or after 1 January 2010 and before 1 January 2012 for the 2008 regulation applicability branch.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT ?this
                    WHERE {
                        ?this nltl:constructionContractDate ?date .
                        FILTER (
                            ?date < "2010-01-01"^^xsd:date
                            || ?date >= "2012-01-01"^^xsd:date
                        )
                    }
                ") ] ] , [ sh:sparql [ sh:message Literal("The construction contract date must be outside the period from 1 January 2010 to before 1 January 2012 for the non-applicable branch.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT ?this
                    WHERE {
                        ?this nltl:constructionContractDate ?date .
                        FILTER (
                            ?date >= "2010-01-01"^^xsd:date
                            && ?date < "2012-01-01"^^xsd:date
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF004ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ] .

