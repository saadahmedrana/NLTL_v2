@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:iceClassRegulationEdition2002 ; sh:message Literal("Ships within the stated date scope must identify the 2002 Ice Class Regulations as the applicable edition.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:applicableIceClassRegulationEdition ] ; sh:sparql [ sh:message Literal("The 2002 Ice Class Regulations apply when the construction stage date is on or after 1 September 2003 and the construction contract date is before 1 January 2010.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:constructionStageDate ?stageDate ;
                                  nltl:constructionContractDate ?contractDate .
                            FILTER (
                                ?stageDate >= "2003-09-01"^^xsd:date &&
                                ?contractDate < "2010-01-01"^^xsd:date
                            )
                        }
                    }
                ") ] ] , [ sh:sparql [ sh:message Literal("The non-applicable alternative is permitted only outside the date scope for the 2002 Ice Class Regulations and must not identify the 2002 edition.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        FILTER (
                            EXISTS {
                                $this nltl:constructionStageDate ?stageDate ;
                                      nltl:constructionContractDate ?contractDate .
                                FILTER (
                                    ?stageDate >= "2003-09-01"^^xsd:date &&
                                    ?contractDate < "2010-01-01"^^xsd:date
                                )
                            } ||
                            EXISTS {
                                $this nltl:applicableIceClassRegulationEdition
                                      nltl:iceClassRegulationEdition2002
                            }
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-005_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F03/ship> ] .

