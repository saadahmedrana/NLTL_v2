@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F01/ship> ;
            sh:resultMessage "For ships constructed on or after 1986-11-01 and before 2003-09-01, the 1985 ice-class rules, the ship ice class, and the owner-request selector must be represented; engine-output edition must be 2008 when requested and 1985 otherwise." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For ships constructed on or after 1986-11-01 and before 2003-09-01, the 1985 ice-class rules, the ship ice class, and the owner-request selector must be represented; engine-output edition must be 2008 when requested and 1985 otherwise." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:constructionStageDate ?date .
    FILTER (
        ?date >= "1986-11-01"^^xsd:date &&
        ?date < "2003-09-01"^^xsd:date
    )
    FILTER NOT EXISTS {
        $this nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
              nltl:iceClass ?iceClass ;
              nltl:ownerRequested2008EngineOutputRequirements ?requested ;
              nltl:engineOutputRegulationEdition ?engineEdition .
        FILTER ( isIRI(?iceClass) )
        FILTER (
            (?requested = true &&
             ?engineEdition = nltl:iceClassRegulationEdition2008) ||
            (?requested = false &&
             ?engineEdition = nltl:iceClassRuleEdition1985)
        )
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-006> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F01/ship> ] .

