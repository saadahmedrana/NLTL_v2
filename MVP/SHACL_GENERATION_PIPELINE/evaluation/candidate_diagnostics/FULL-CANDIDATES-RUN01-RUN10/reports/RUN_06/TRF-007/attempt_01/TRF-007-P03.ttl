@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P03/ship> ;
            sh:resultMessage "An applicable IA Super or IA ship constructed before 1 September 2003 must have a permitted 2017 compliance method and must comply by 1 January of the year twenty years after delivery." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "An applicable IA Super or IA ship constructed before 1 September 2003 must have a permitted 2017 compliance method and must comply by 1 January of the year twenty years after delivery." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?constructionDate ;
                      nltl:deliveryDate ?deliveryDate ;
                      nltl:assessmentDate ?assessmentDate .

                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa
                    )
                )

                FILTER (
                    YEAR(?constructionDate) < 2003
                    ||
                    (
                        YEAR(?constructionDate) = 2003
                        && MONTH(?constructionDate) < 9
                    )
                    ||
                    (
                        YEAR(?constructionDate) = 2003
                        && MONTH(?constructionDate) = 9
                        && DAY(?constructionDate) < 1
                    )
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:engineOutputComplianceMethod ?method .
                        FILTER (
                            ?method IN (
                                nltl:traficom2017Section3Point2Point2Method,
                                nltl:traficom2017Section3Point2Point4Method
                            )
                        )
                    }
                    ||
                    YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20
                    ||
                    (
                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20
                        && MONTH(?assessmentDate) > 1
                    )
                    ||
                    (
                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20
                        && MONTH(?assessmentDate) = 1
                        && DAY(?assessmentDate) > 1
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape g:TRF007Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P03/ship> ] .

