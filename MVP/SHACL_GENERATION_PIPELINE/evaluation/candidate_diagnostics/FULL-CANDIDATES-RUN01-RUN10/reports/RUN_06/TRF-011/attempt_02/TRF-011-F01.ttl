@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F01/ship> ;
            sh:resultMessage "At every longitudinal position represented by either waterline, the UIWL must exist and all of its vertical coordinates must equal the maximum vertical coordinate of the intended ice-operating waterlines within the stated numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "At every longitudinal position represented by either waterline, the UIWL must exist and all of its vertical coordinates must equal the maximum vertical coordinate of the intended ice-operating waterlines within the stated numerical tolerance." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?this
WHERE {
    {
        SELECT ?this ?position
               (COUNT(DISTINCT ?intendedPoint) AS ?intendedCount)
               (COUNT(DISTINCT ?upperPoint) AS ?upperCount)
               (MAX(?intendedValue) AS ?intendedMaximum)
               (MIN(?upperValue) AS ?upperMinimum)
               (MAX(?upperValue) AS ?upperMaximum)
        WHERE {
            {
                ?this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
                ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
                ?intendedPoint nltl:longitudinalPosition ?intendedPositionValue ;
                                nltl:verticalCoordinate ?intendedVerticalValue .
                ?intendedPositionValue qudt:numericValue ?position .
                ?intendedVerticalValue qudt:numericValue ?intendedValue .
            }
            UNION
            {
                ?this nltl:hasUpperIceWaterline ?upperWaterline .
                ?upperWaterline nltl:hasWaterlineProfilePoint ?upperPoint .
                ?upperPoint nltl:longitudinalPosition ?upperPositionValue ;
                            nltl:verticalCoordinate ?upperVerticalValue .
                ?upperPositionValue qudt:numericValue ?position .
                ?upperVerticalValue qudt:numericValue ?upperValue .
            }
        }
        GROUP BY ?this ?position
    }
    BIND((ABS(?intendedMaximum) * 0.000001) + 0.000000001 AS ?tolerance)
    FILTER(
        IF(
            ?intendedCount = 0,
            true,
            IF(
                ?upperCount = 0,
                true,
                (ABS(?upperMinimum - ?intendedMaximum) > ?tolerance) ||
                (ABS(?upperMaximum - ?intendedMaximum) > ?tolerance)
            )
        )
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_011_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F01/ship> ] .

