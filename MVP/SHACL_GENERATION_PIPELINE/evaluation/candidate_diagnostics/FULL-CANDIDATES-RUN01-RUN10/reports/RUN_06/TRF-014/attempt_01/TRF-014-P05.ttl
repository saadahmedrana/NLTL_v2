@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/ship> ;
            sh:resultMessage "The required warning triangle and ice-class draught marking are missing or inconsistent with the construction date and assessment date." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The required warning triangle and ice-class draught marking are missing or inconsistent with the construction date and assessment date." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionDate ?construction ;
                       nltl:assessmentDate ?assessment .

                FILTER (
                    (
                        ?construction >= "2007-07-01"^^xsd:date
                        && NOT EXISTS {
                            $this nltl:warningTrianglePresent true ;
                                  nltl:iceClassDraughtMarkPresent true ;
                                  nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity ;
                                  nltl:hasClassCertificate ?certificate .
                            ?markQuantity qudt:numericValue ?markValue ;
                                          qudt:unit unit:M .
                            ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
                            ?maximumQuantity qudt:numericValue ?maximumValue ;
                                             qudt:unit unit:M .
                            FILTER (?markValue = ?maximumValue)
                        }
                    )
                    ||
                    (
                        ?construction < "2007-07-01"^^xsd:date
                        && NOT EXISTS {
                            $this nltl:firstScheduledDryDockingDate ?dryDocking
                        }
                    )
                    ||
                    (
                        ?construction < "2007-07-01"^^xsd:date
                        && EXISTS {
                            $this nltl:firstScheduledDryDockingDate ?dryDocking
                            FILTER (?dryDocking <= ?assessment)
                        }
                        && NOT EXISTS {
                            $this nltl:warningTrianglePresent true ;
                                  nltl:iceClassDraughtMarkPresent true ;
                                  nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity ;
                                  nltl:hasClassCertificate ?certificate .
                            ?markQuantity qudt:numericValue ?markValue ;
                                          qudt:unit unit:M .
                            ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
                            ?maximumQuantity qudt:numericValue ?maximumValue ;
                                             qudt:unit unit:M .
                            FILTER (?markValue = ?maximumValue)
                        }
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-014-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/ship> ;
            sh:resultMessage "Ice draught restrictions must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n097f73dfe08847f6abed6ac072342686b13 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/ship> ;
            sh:resultMessage "Ice draught restrictions must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n097f73dfe08847f6abed6ac072342686b13 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/ship> ;
            sh:resultMessage "Ice draught restrictions must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n097f73dfe08847f6abed6ac072342686b12 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/ship> ;
            sh:resultMessage "Ice draught restrictions must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n097f73dfe08847f6abed6ac072342686b12 ] .

_:n097f73dfe08847f6abed6ac072342686b12 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Ice draught restrictions must be retained on board." ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

_:n097f73dfe08847f6abed6ac072342686b13 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Ice draught restrictions must be readily available to the master." ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

