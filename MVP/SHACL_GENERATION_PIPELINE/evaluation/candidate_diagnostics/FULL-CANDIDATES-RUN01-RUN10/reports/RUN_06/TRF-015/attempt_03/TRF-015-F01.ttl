@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F01/ship> ;
            sh:resultMessage "When navigating in ice, operating draught must not exceed the upper ice waterline draught." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When navigating in ice, operating draught must not exceed the upper ice waterline draught." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:navigatingInIce true ;
                      nltl:operatingDraught ?operatingQuantity ;
                      nltl:upperIceWaterlineDraught ?waterlineQuantity .
                ?operatingQuantity qudt:numericValue ?operatingValue ;
                                    qudt:unit unit:M .
                ?waterlineQuantity qudt:numericValue ?waterlineValue ;
                                    qudt:unit unit:M .
                FILTER (
                    datatype(?operatingValue) = xsd:decimal &&
                    datatype(?waterlineValue) = xsd:decimal &&
                    ?operatingValue > ?waterlineValue
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_015_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F01/ship> ] .

