@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F02/ship> ;
            sh:resultMessage "The restriction-applicability value must select a valid output case; a restricted output is required when the restriction applies." ;
            sh:resultPath nltl:propulsionOutputRestrictionApplies ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The restriction-applicability value must select a valid output case; a restricted output is required when the restriction applies." ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:hasValue false ] [ sh:hasValue true ;
                                sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class qudt:QuantityValue ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:restrictedPropulsionOutput ] ] ) ;
                    sh:path nltl:propulsionOutputRestrictionApplies ] ;
            sh:value true ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F02/ship> ;
            sh:resultMessage "When propulsion output is restricted, maximum continuous rating power P must equal the restricted propulsion output." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When propulsion output is restricted, maximum continuous rating power P must equal the restricted propulsion output." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies ?applies .
                FILTER (?applies = true)

                $this nltl:maximumContinuousRatingPower ?pNode .
                ?pNode qudt:numericValue ?p .

                $this nltl:restrictedPropulsionOutput ?rNode .
                ?rNode qudt:numericValue ?r .

                FILTER (?p != ?r)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF017Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F02/ship> ] .

