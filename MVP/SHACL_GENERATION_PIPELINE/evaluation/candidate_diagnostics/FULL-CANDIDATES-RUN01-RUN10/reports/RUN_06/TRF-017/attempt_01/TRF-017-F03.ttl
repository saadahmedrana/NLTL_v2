@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F03/ship> ;
            sh:resultMessage "The restriction-applicability value must select a valid output case; a restricted output is required when the restriction applies." ;
            sh:resultPath nltl:propulsionOutputRestrictionApplies ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The restriction-applicability value must select a valid output case; a restricted output is required when the restriction applies." ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:hasValue false ] [ sh:hasValue true ;
                                sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class qudt:QuantityValue ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:restrictedPropulsionOutput ] ] ) ;
                    sh:path nltl:propulsionOutputRestrictionApplies ] ;
            sh:value true ] .

