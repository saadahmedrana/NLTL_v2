@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P03/ship> ;
            sh:resultMessage "Maximum continuous rating power P must equal the continuous propulsion machinery output." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Maximum continuous rating power P must equal the continuous propulsion machinery output." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:maximumContinuousRatingPower ?pNode .
                ?pNode qudt:numericValue ?p .

                $this nltl:propulsionMachineryContinuousOutput ?cNode .
                ?cNode qudt:numericValue ?c .

                FILTER (?p != ?c)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF017Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P03/ship> ] .

