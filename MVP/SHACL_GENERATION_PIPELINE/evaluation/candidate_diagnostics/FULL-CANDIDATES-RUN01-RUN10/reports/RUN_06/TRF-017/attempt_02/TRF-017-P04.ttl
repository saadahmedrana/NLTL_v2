@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P04/ship> ;
            sh:resultMessage "When propulsion output is restricted, maximum continuous rating power must equal restricted propulsion output within relative tolerance 1e-6, with a 0.001 kW absolute fallback." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When propulsion output is restricted, maximum continuous rating power must equal restricted propulsion output within relative tolerance 1e-6, with a 0.001 kW absolute fallback." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies ?applies .
                FILTER (?applies = true)

                $this nltl:maximumContinuousRatingPower ?pNode .
                ?pNode qudt:numericValue ?p .

                $this nltl:restrictedPropulsionOutput ?rNode .
                ?rNode qudt:numericValue ?r .

                FILTER (
                    ABS(?p - ?r) >
                    0.000001 *
                    IF(ABS(?r) > 0.001, ABS(?r), 0.001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_017_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P04/ship> ] .

