@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F01/ship> ;
            sh:resultMessage "Maximum continuous rating power must equal the applicable propulsion output plus any additional propulsion power, within a relative tolerance of 1e-6 and an absolute fallback of 1e-6 kW." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Maximum continuous rating power must equal the applicable propulsion output plus any additional propulsion power, within a relative tolerance of 1e-6 and an absolute fallback of 1e-6 kW." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:maximumContinuousRatingPower ?pNode ;
                      nltl:propulsionMachineryContinuousOutput ?mNode ;
                      nltl:propulsionOutputRestrictionApplies ?restricted .

                ?pNode qudt:numericValue ?p ;
                       qudt:unit unit:KiloW .
                ?mNode qudt:numericValue ?m ;
                       qudt:unit unit:KiloW .

                OPTIONAL {
                    ?this nltl:restrictedPropulsionOutput ?rNode .
                    ?rNode qudt:numericValue ?r ;
                          qudt:unit unit:KiloW .
                }

                OPTIONAL {
                    ?this nltl:additionalPropulsionPower ?aNode .
                    ?aNode qudt:numericValue ?a ;
                          qudt:unit unit:KiloW .
                }

                BIND(IF(?restricted = true, ?r, ?m) AS ?base)
                BIND(COALESCE(?a, 0) AS ?additional)
                BIND(?base + ?additional AS ?expected)

                FILTER(
                    ABS(?p - ?expected) >
                    (0.000001 * ABS(?expected) + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-017> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F01/ship> ] .

