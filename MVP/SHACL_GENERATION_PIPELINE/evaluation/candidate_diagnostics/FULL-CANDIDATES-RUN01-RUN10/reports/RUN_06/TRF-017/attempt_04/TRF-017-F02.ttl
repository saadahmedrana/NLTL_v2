@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F02/ship> ;
            sh:resultMessage "When propulsion output is restricted, maximum continuous rating power must equal restricted propulsion output plus any available additional propulsion power, within tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When propulsion output is restricted, maximum continuous rating power must equal restricted propulsion output plus any available additional propulsion power, within tolerance." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:propulsionOutputRestrictionApplies true .
    $this nltl:maximumContinuousRatingPower ?pNode .
    ?pNode qudt:numericValue ?p .
    ?pNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .
    $this nltl:restrictedPropulsionOutput ?baseNode .
    ?baseNode qudt:numericValue ?base .
    ?baseNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .
    OPTIONAL {
        $this nltl:additionalPropulsionPower ?additionalNode .
        ?additionalNode qudt:numericValue ?additional .
        ?additionalNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .
    }
    BIND(COALESCE(?additional, "0"^^xsd:decimal) AS ?additionalValue)
    BIND(?base + ?additionalValue AS ?expected)
    FILTER(
        ABS(?p - ?expected) >
        IF(ABS(?expected) > "0"^^xsd:decimal,
           "0.000001"^^xsd:decimal * ABS(?expected),
           "0.000000001"^^xsd:decimal)
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_017_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F02/ship> ] .

