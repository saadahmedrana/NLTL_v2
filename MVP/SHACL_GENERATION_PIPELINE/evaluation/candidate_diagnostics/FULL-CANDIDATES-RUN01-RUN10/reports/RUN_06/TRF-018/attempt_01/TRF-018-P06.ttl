@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P06/ship> ;
            sh:resultMessage "The ship must declare one applicable ice class: IA Super, IA, IB, or IC." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceClassValue ;
                    sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship must declare one applicable ice class: IA Super, IA, IB, or IC." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:iceClass ] ;
            sh:value nltl:iceClassIi ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P06/ship> ;
            sh:resultMessage "For the declared ice class, maximum continuous rating power must be at least the calculated required power and at least 1,000 kW for IA, IB, or IC, or 2,800 kW for IA Super." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For the declared ice class, maximum continuous rating power must be at least the calculated required power and at least 1,000 kW for IA, IB, or IC, or 2,800 kW for IA Super." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:calculatedRequiredPower ?calculatedQuantity ;
                      nltl:maximumContinuousRatingPower ?maximumQuantity .

                ?calculatedQuantity qudt:numericValue ?calculatedPower .
                ?maximumQuantity qudt:numericValue ?maximumPower .

                FILTER (
                    ?maximumPower < ?calculatedPower ||
                    (
                        ?iceClass = nltl:iceClassIaSuper &&
                        ?maximumPower < "2800"^^xsd:decimal
                    ) ||
                    (
                        ?iceClass != nltl:iceClassIaSuper &&
                        ?maximumPower < "1000"^^xsd:decimal
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-018> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P06/ship> ] .

