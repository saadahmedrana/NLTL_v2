@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-P04/ship> ;
            sh:resultMessage "Construction date and ice class must establish applicability before the complex engine-output readiness constraints are assessed." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF020Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-P04/ship> ] .

