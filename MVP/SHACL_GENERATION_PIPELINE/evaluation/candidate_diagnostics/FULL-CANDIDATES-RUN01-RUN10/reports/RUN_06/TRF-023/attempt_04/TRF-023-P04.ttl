@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P04/ship> ;
            sh:resultMessage "For an IB or IC ship subject to the 1985 rules, maximum continuous rating power must be at least the required power under the 1985 rules." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an IB or IC ship subject to the 1985 rules, maximum continuous rating power must be at least the required power under the 1985 rules." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )
                $this nltl:maximumContinuousRatingPower ?mcrQuantity .
                $this nltl:requiredPowerUnder1985Rules ?requiredQuantity .
                ?mcrQuantity qudt:numericValue ?mcrValue .
                ?requiredQuantity qudt:numericValue ?requiredValue .
                FILTER ( ?mcrValue < ?requiredValue )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF023Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:node <urn:nltl:generated-shape:TRF023ApplicableShape> ; sh:property [ sh:hasValue nltl:iceClassIb ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:node <urn:nltl:generated-shape:TRF023ApplicableShape> ; sh:property [ sh:hasValue nltl:iceClassIc ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:in ( nltl:iceClassIa nltl:iceClassIaSuper nltl:iceClassIi nltl:iceClassIii ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF023Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P04/ship> ] .

