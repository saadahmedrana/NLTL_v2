@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F03/ship> ;
            sh:resultMessage "The ship must record that the alternative Ke or RCH approval is approved." ;
            sh:resultPath nltl:approvalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The ship must record that the alternative Ke or RCH approval is approved." ;
                    sh:minCount 1 ;
                    sh:path nltl:approvalStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F03/ship> ;
            sh:resultMessage "The ship must provide approved alternative-calculation or model-test evidence together with an externally determined Ke or RCH value." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:TRF028Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F03/ship> ] .

