@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F02/ship> ;
            sh:resultMessage "combinedBendingShearStress must be lower than yieldPoint, and yieldShearStress must equal yieldPoint divided by sqrt(3) within a relative tolerance of 1e-6 plus an absolute fallback of 1e-6 MPa." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "combinedBendingShearStress must be lower than yieldPoint, and yieldShearStress must equal yieldPoint divided by sqrt(3) within a relative tolerance of 1e-6 plus an absolute fallback of 1e-6 MPa." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldPointNode ;
                      nltl:combinedBendingShearStress ?combinedNode ;
                      nltl:yieldShearStress ?yieldShearNode .

                ?yieldPointNode qudt:numericValue ?yieldPointValue ;
                                qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?combinedNode qudt:numericValue ?combinedValue ;
                              qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?yieldShearNode qudt:numericValue ?yieldShearValue ;
                                qudt:unit <http://qudt.org/vocab/unit/MegaPA> .

                BIND((?yieldPointValue / 1.7320508075688772) AS ?expectedYieldShear)

                FILTER (
                    (?combinedValue >= ?yieldPointValue)
                    ||
                    (ABS(?yieldShearValue - ?expectedYieldShear) >
                     ((ABS(?expectedYieldShear) * 0.000001) + 0.000001))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF031Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F02/ship> ] .

