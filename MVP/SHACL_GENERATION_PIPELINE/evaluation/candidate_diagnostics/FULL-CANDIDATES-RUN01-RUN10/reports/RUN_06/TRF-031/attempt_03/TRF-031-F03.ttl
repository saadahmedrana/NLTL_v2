@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ;
            sh:resultMessage "Combined bending and shear stress must be strictly lower than the yield point, and yield shear stress must equal yield point divided by sqrt(3) within the permitted numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Combined bending and shear stress must be strictly lower than the yield point, and yield shear stress must equal yield point divided by sqrt(3) within the permitted numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:vonMisesYieldCriterion ?criterion ;
                      nltl:yieldPoint ?yieldNode ;
                      nltl:combinedBendingShearStress ?combinedNode ;
                      nltl:yieldShearStress ?yieldShearNode .
                ?yieldNode qudt:numericValue ?yieldPoint ;
                           qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?combinedNode qudt:numericValue ?combinedStress ;
                              qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?yieldShearNode qudt:numericValue ?yieldShear ;
                                qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                BIND((?yieldPoint / 1.7320508075688772) AS ?expectedYieldShear)
                BIND((1e-6 * IF(?expectedYieldShear >= -?expectedYieldShear, ?expectedYieldShear, -?expectedYieldShear)) AS ?relativeTolerance)
                BIND(IF(?relativeTolerance >= 1e-9, ?relativeTolerance, 1e-9) AS ?tolerance)
                BIND((?expectedYieldShear - ?tolerance) AS ?lowerBound)
                BIND((?expectedYieldShear + ?tolerance) AS ?upperBound)
                FILTER (
                    ?combinedStress >= ?yieldPoint ||
                    ?yieldShear < ?lowerBound ||
                    ?yieldShear > ?upperBound
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlgen:TRF031Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ] .

