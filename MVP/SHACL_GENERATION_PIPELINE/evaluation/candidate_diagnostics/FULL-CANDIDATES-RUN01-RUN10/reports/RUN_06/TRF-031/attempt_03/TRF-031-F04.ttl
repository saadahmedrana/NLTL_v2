@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/ship> ;
            sh:resultMessage "When beam theory is used, allowable shear stress must not exceed 0.9 times yield shear stress." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When beam theory is used, allowable shear stress must not exceed 0.9 times yield shear stress." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:beamTheoryUsed true ;
                      nltl:vonMisesYieldCriterion ?criterion ;
                      nltl:yieldPoint ?yieldNode ;
                      nltl:allowableShearStress ?allowableNode .
                ?yieldNode qudt:numericValue ?yieldPoint ;
                           qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?allowableNode qudt:numericValue ?allowableStress ;
                                qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                BIND((0.9 * (?yieldPoint / 1.7320508075688772)) AS ?maximumAllowableStress)
                FILTER (?allowableStress > ?maximumAllowableStress)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlgen:TRF031Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/ship> ] .

