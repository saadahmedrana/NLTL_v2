@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F04/member> ;
            sh:resultMessage "Node ex:member must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:memberNormalToPlating ], [ sh:message Literal(\"A hull-structure member normal to the plating must have an effective member cross section with section modulus and shear area.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:EffectiveMemberCrossSectionShape ; sh:path nltl:hasEffectiveMemberCrossSection ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:memberNormalToPlating ], [ sh:message Literal(\"A hull-structure member not normal to the plating must have an effective member cross section and classification-society calculation evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:NonNormalEffectiveMemberCrossSectionShape ; sh:path nltl:hasEffectiveMemberCrossSection ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:HullStructureShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F04/member> ] .

