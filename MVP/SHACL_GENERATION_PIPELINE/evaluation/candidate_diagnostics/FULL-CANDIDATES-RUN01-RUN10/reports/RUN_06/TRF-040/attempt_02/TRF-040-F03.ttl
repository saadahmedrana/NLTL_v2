            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF040Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F03/ship> ;
            sh:resultMessage "Spacing shall be supplied as a single metre quantity." ;
            sh:resultPath nltl:spacing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Spacing shall be supplied as a single metre quantity." ;
                    sh:minCount 1 ;
                    sh:node gen:LengthQuantityShape ;
                    sh:path nltl:spacing ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F03/ship> ;
            sh:resultMessage "Design operation speed in ice shall be supplied as a single knot quantity." ;
            sh:resultPath nltl:designOperationSpeedInIce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Design operation speed in ice shall be supplied as a single knot quantity." ;
                    sh:minCount 1 ;
                    sh:node gen:VelocityQuantityShape ;
                    sh:path nltl:designOperationSpeedInIce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F03/ship> ;
            sh:resultMessage "Thickness shall be supplied as a single metre quantity." ;
            sh:resultPath nltl:thickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Thickness shall be supplied as a single metre quantity." ;
                    sh:minCount 1 ;
                    sh:node gen:LengthQuantityShape ;
                    sh:path nltl:thickness ] ] .

