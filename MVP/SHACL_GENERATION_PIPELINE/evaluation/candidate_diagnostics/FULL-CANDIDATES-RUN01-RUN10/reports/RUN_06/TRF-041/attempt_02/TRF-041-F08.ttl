@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F08/plating> ;
            sh:resultMessage "The plating framing orientation must identify a permitted transverse or longitudinal case." ;
            sh:resultPath nltl:platingFramingOrientation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:platingFramingOrientationValue ;
                    sh:maxCount 1 ;
                    sh:message "The plating framing orientation must identify a permitted transverse or longitudinal case." ;
                    sh:minCount 1 ;
                    sh:path nltl:platingFramingOrientation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F08/plating> ;
            sh:resultMessage "Node ex:plating must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:transverseFramingOrientation ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:platingFramingOrientation ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Transverse framing requires plating pressure in MPa.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:MegapascalQuantityShape ; sh:path nltl:platingPressure ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Transverse framing requires the plating factor f1.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:UnitlessQuantityShape ; sh:path nltl:transversePlatingFactorF1 ] ] , [ sh:property [ sh:hasValue nltl:longitudinalFramingOrientation ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:platingFramingOrientation ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Longitudinal framing requires ice pressure in MPa.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:MegapascalQuantityShape ; sh:path nltl:icePressure ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Longitudinal framing requires the plating factor f2.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:UnitlessQuantityShape ; sh:path nltl:longitudinalPlatingFactorF2 ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF041PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F08/plating> ] .

