@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "corrosionAbrasionAddition must be a millimetre-valued decimal quantity." ;
            sh:resultPath nltl:corrosionAbrasionAddition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "corrosionAbrasionAddition must be a millimetre-valued decimal quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:corrosionAbrasionAddition ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "longitudinalPlatingFactorF2 must equal the applicable formula using h/s, within max(1e-6*ABS(expected),1e-12)." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "longitudinalPlatingFactorF2 must equal the applicable formula using h/s, within max(1e-6*ABS(expected),1e-12)." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?hNode ;
                      nltl:spacing ?sNode ;
                      nltl:longitudinalPlatingFactorF2 ?f2Node .
                ?hNode qudt:numericValue ?h .
                ?sNode qudt:numericValue ?s .
                ?f2Node qudt:numericValue ?f2 .
                BIND (?h / ?s AS ?ratio)
                BIND (
                    IF(
                        ?ratio <= 1,
                        0.4 / ?ratio + 0.6,
                        1.4 - 0.4 * ?ratio
                    )
                    AS ?expected
                )
                FILTER (
                    ?ratio > 1.8 ||
                    ABS(?f2 - ?expected) >
                    IF(
                        ABS(?expected) * 0.000001 > 0.000000000001,
                        ABS(?expected) * 0.000001,
                        0.000000000001
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF042PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ] .

