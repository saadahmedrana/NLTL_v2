@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P03/plating> ;
            sh:resultMessage "Node ex:plating must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:normalStrengthHullStructuralSteel ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hullStructuralSteelGrade ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlg:YieldStrengthNormalShape ; sh:path nltl:yieldStrength ] ] , [ sh:property [ sh:hasValue nltl:highStrengthHullStructuralSteel ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hullStructuralSteelGrade ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlg:YieldStrengthHighShape ; sh:path nltl:yieldStrength ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlg:PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P03/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P03/plating> ;
            sh:resultMessage "spacing is required in metres." ;
            sh:resultPath nltl:spacing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "spacing is required in metres." ;
                    sh:minCount 1 ;
                    sh:node nltlg:LengthMetreQuantityShape ;
                    sh:path nltl:spacing ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P03/spacingValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P03/plating> ;
            sh:resultMessage "designIceLoadHeight is required in metres." ;
            sh:resultPath nltl:designIceLoadHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "designIceLoadHeight is required in metres." ;
                    sh:minCount 1 ;
                    sh:node nltlg:LengthMetreQuantityShape ;
                    sh:path nltl:designIceLoadHeight ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P03/designIceLoadHeightValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P03/plating> ;
            sh:resultMessage "longitudinalPlatingFactorF2 is required as a dimensionless quantity." ;
            sh:resultPath nltl:longitudinalPlatingFactorF2 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "longitudinalPlatingFactorF2 is required as a dimensionless quantity." ;
                    sh:minCount 1 ;
                    sh:node nltlg:DimensionlessQuantityShape ;
                    sh:path nltl:longitudinalPlatingFactorF2 ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P03/longitudinalPlatingFactorF2Value> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P03/plating> ;
            sh:resultMessage "corrosionAbrasionAddition is required in millimetres." ;
            sh:resultPath nltl:corrosionAbrasionAddition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "corrosionAbrasionAddition is required in millimetres." ;
                    sh:minCount 1 ;
                    sh:node nltlg:LengthMillimetreQuantityShape ;
                    sh:path nltl:corrosionAbrasionAddition ] ] .

