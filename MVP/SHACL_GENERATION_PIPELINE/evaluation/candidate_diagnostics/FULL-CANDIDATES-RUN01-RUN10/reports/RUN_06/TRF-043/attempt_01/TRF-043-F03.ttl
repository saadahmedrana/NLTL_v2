@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/terminationCase> ;
                    sh:resultMessage "The termination adjacent boundary must be a deck structure, tank boundary plating, or tank top." ;
                    sh:resultPath nltl:terminationAdjacentBoundary ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The termination adjacent boundary must be a deck structure, tank boundary plating, or tank top." ;
                            sh:minCount 1 ;
                            sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] ) ;
                            sh:path nltl:terminationAdjacentBoundary ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/boundary> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/terminationCase> ;
                    sh:resultMessage "Each framing ice-strengthening termination case must state the extension beyond the adjacent boundary in millimetres." ;
                    sh:resultPath nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
                    sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                            sh:maxCount 1 ;
                            sh:message "Each framing ice-strengthening termination case must state the extension beyond the adjacent boundary in millimetres." ;
                            sh:minCount 1 ;
                            sh:node gs:TRF043ExtensionQuantityShape ;
                            sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/extensionBeyondAdjacentDeckOrTankBoundaryValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:TRF043TerminationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasFramingIceStrengtheningTerminationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gs:TRF043TerminationCaseShape ;
                    sh:path nltl:hasFramingIceStrengtheningTerminationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/terminationCase> ] .

