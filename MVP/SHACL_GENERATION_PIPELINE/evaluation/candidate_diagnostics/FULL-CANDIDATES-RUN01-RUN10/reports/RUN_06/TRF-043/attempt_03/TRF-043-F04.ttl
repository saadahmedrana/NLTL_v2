_:n64f21766be6c41709982eaa09fd9de80b13 sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node nltl:TRF043_ExtensionQuantityShape ;
    sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary .

