@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ;
            sh:resultMessage "Frame boundary factor and calculated frame results do not satisfy TRF-044." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Frame boundary factor and calculated frame results do not satisfy TRF-044." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:spacing ?sNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameBoundaryConditionType ?bc ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode <http://qudt.org/schema/qudt/numericValue> ?p .
                ?sNode <http://qudt.org/schema/qudt/numericValue> ?s .
                ?hNode <http://qudt.org/schema/qudt/numericValue> ?h .
                ?lNode <http://qudt.org/schema/qudt/numericValue> ?l .
                ?m0Node <http://qudt.org/schema/qudt/numericValue> ?m0 .
                ?sigmaNode <http://qudt.org/schema/qudt/numericValue> ?sigma .
                ?mtNode <http://qudt.org/schema/qudt/numericValue> ?mt .
                ?zNode <http://qudt.org/schema/qudt/numericValue> ?z .
                ?aNode <http://qudt.org/schema/qudt/numericValue> ?a .

                BIND(
                    IF(
                        ?bc = nltl:bulkCarrierTopWingTankFrameCondition,
                        7.0,
                        IF(
                            ?bc = nltl:singleDeckTankTopToMainDeckFrameCondition,
                            6.0,
                            IF(
                                ?bc = nltl:multiDeckOrStringerContinuousFrameCondition,
                                5.7,
                                5.0
                            )
                        )
                    ) AS ?expectedM0
                )

                BIND(7.0 * ?m0 / (7.0 - 5.0 * ?h / ?l) AS ?expectedMt)
                BIND(?p * ?s * ?h * ?l / (?expectedMt * ?sigma) * 1000000.0 AS ?expectedZ)
                BIND(1.7320508075688772 * 1.2 * ?p * ?h * ?s / (2.0 * ?sigma) * 10000.0 AS ?expectedA)

                FILTER(
                    (?m0 != ?expectedM0) ||
                    (ABS(?mt - ?expectedMt) > (0.000001 * ABS(?expectedMt) + 0.000000001)) ||
                    (ABS(?z - ?expectedZ) > (0.000001 * ABS(?expectedZ) + 0.000000001)) ||
                    (ABS(?a - ?expectedA) > (0.000001 * ABS(?expectedA) + 0.000000001))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF044TransverseFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ] .

