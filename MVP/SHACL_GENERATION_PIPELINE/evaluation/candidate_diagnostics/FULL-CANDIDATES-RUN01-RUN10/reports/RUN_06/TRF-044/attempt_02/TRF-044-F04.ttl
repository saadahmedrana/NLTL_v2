@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F04/transverseFrame> ;
            sh:resultMessage "Frame moment factor, section modulus, and required shear area must satisfy the specified calculation formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Frame moment factor, section modulus, and required shear area must satisfy the specified calculation formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:spacing ?sNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?sNode qudt:numericValue ?s .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?m0Node qudt:numericValue ?m0 .
                ?sigmaNode qudt:numericValue ?sigma .
                ?mtNode qudt:numericValue ?mt .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND ((7 * ?m0) / (7 - (5 * ?h / ?l)) AS ?expectedMt)
                BIND ((?p * ?s * ?h * ?l / (?expectedMt * ?sigma)) * 1000000 AS ?expectedZ)
                BIND ((1.7320508075688772 * 1.2 * ?p * ?h * ?s / (2 * ?sigma)) * 10000 AS ?expectedA)

                BIND (IF((?expectedMt * 0.000001) > 0.000001, (?expectedMt * 0.000001), 0.000001) AS ?mtTolerance)
                BIND (IF((?expectedZ * 0.000001) > 0.000001, (?expectedZ * 0.000001), 0.000001) AS ?zTolerance)
                BIND (IF((?expectedA * 0.000001) > 0.000001, (?expectedA * 0.000001), 0.000001) AS ?aTolerance)

                FILTER (
                    (?mt < (?expectedMt - ?mtTolerance)) ||
                    (?mt > (?expectedMt + ?mtTolerance)) ||
                    (?z < (?expectedZ - ?zTolerance)) ||
                    (?z > (?expectedZ + ?zTolerance)) ||
                    (?a < (?expectedA - ?aTolerance)) ||
                    (?a > (?expectedA + ?aTolerance))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF044TransverseFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F04/transverseFrame> ] .

