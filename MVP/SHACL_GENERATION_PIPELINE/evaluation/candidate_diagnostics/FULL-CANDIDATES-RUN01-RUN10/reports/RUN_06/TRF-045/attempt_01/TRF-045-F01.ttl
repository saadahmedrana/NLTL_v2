@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F01/frame> ;
            sh:resultMessage "Ordinary frame scantlings may be used only when less than 15% of the frame span is within the ice-strengthening zone." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Ordinary frame scantlings may be used only when less than 15% of the frame span is within the ice-strengthening zone." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:ordinaryFrameScantlingsUsed ?used .
                FILTER (?used = true)

                $this nltl:frameSpanWithinIceStrengtheningZone ?zoneQuantity .
                ?zoneQuantity qudt:numericValue ?zoneSpan .
                ?zoneQuantity qudt:unit unit:M .

                $this nltl:span ?spanQuantity .
                ?spanQuantity qudt:numericValue ?span .
                ?spanQuantity qudt:unit unit:M .

                FILTER (?zoneSpan >= (0.15 * ?span))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <nltl:generated-shape:TRF045_FrameSpanApplicabilityShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F01/frame> ] .

