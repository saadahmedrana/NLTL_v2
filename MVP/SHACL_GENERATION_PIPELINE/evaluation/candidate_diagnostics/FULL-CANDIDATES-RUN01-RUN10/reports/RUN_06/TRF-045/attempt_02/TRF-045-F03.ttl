@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F03/frame> ;
            sh:resultMessage """Node ex:frame must conform to one or more shapes in [ sh:property [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:path nltl:ordinaryFrameScantlingsUsed ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:ordinaryFrameScantlingsUsed ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:ordinaryFrameScantlingsUsed ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:frameSpanWithinIceStrengtheningZone ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:span ] ; sh:sparql [ sh:message Literal("Ordinary frame scantlings may be used only when less than 15% of the frame span is within the ice-strengthening zone.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:span ?spanQuantity .
                        ?spanQuantity qudt:numericValue ?spanValue ;
                                       qudt:unit unit:M .
                        $this nltl:frameSpanWithinIceStrengtheningZone ?zoneQuantity .
                        ?zoneQuantity qudt:numericValue ?zoneValue ;
                                      qudt:unit unit:M .
                        FILTER (?zoneValue >= (0.15 * ?spanValue))
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ a sh:NodeShape ;
                    sh:or ( [ sh:property [ sh:maxCount 0 ;
                                        sh:path nltl:ordinaryFrameScantlingsUsed ] ] [ sh:property [ sh:datatype xsd:boolean ;
                                        sh:hasValue false ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:path nltl:ordinaryFrameScantlingsUsed ] ] [ sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class qudt:QuantityValue ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:frameSpanWithinIceStrengtheningZone ],
                                    [ sh:datatype xsd:boolean ;
                                        sh:hasValue true ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:path nltl:ordinaryFrameScantlingsUsed ],
                                    [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class qudt:QuantityValue ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:span ] ;
                                sh:sparql [ sh:message "Ordinary frame scantlings may be used only when less than 15% of the frame span is within the ice-strengthening zone." ;
                                        sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:span ?spanQuantity .
                        ?spanQuantity qudt:numericValue ?spanValue ;
                                       qudt:unit unit:M .
                        $this nltl:frameSpanWithinIceStrengtheningZone ?zoneQuantity .
                        ?zoneQuantity qudt:numericValue ?zoneValue ;
                                      qudt:unit unit:M .
                        FILTER (?zoneValue >= (0.15 * ?spanValue))
                    }
                """ ] ] ) ;
                    sh:property [ sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:path nltl:ordinaryFrameScantlingsUsed ] ;
                    sh:targetClass nltl:frame ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F03/frame> ] .

