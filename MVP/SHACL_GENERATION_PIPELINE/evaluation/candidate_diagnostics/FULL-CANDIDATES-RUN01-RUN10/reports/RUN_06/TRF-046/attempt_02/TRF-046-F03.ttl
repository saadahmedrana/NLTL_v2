                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The upper end must be attached to a deck, tank boundary plating, or ice stringer." ;
                            sh:minCount 1 ;
                            sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:iceStringer ] ) ;
                            sh:path nltl:hasAttachedSupportingStructure ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/frame> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:message Literal(\"The upper end must be attached to a deck, tank boundary plating, or ice stringer.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:iceStringer ] ) ; sh:path nltl:hasAttachedSupportingStructure ] ]. See details for more information." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nac720566f45f4fb7840013f287eebdc2b6 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/upperEnd> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/adjacentMainFrame> ;
            sh:resultMessage "Less than 1 values on ex:adjacentMainFrame->nltl:hasUpperEnd" ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nac720566f45f4fb7840013f287eebdc2b6 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/adjacentMainFrame> ;
            sh:resultMessage "Value does not have class nltl:transverseFrame" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
            sh:sourceShape gen:TRF_046_UpperEndAttachmentShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/adjacentMainFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/adjacentMainFrame> ;
            sh:resultMessage "A main frame or intermediate ice frame must identify its strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameStrengthenedPart ;
                    sh:message "A main frame or intermediate ice frame must identify its strengthened part." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasStrengthenedPart ] ] .

_:N023732e8082941a18b17c8714a3e6995 rdf:first [ sh:class nltl:deckStructure ] ;
    rdf:rest ( [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:iceStringer ] ) .

_:N27af4f2cd5d54ed5b375de8fa1fd6e51 sh:property [ sh:message "The upper end must be attached to a deck, tank boundary plating, or ice stringer." ;
            sh:minCount 1 ;
