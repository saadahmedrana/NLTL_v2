@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/adjacentMainFrame> ;
            sh:resultMessage "A frame covered by TRF-047 must have a strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameStrengthenedPart ;
                    sh:message "A frame covered by TRF-047 must have a strengthened part." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasStrengthenedPart ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/adjacentMainFrame> ;
            sh:resultMessage "The lower end of the strengthened frame part must be represented." ;
            sh:resultPath nltl:hasLowerEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4654b2372af44a2280278a91da76035cb2 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/lowerEnd> ;
                    sh:resultMessage "The lower end must be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
                    sh:resultPath nltl:hasAttachedSupportingStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The lower end must be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
                            sh:minCount 1 ;
                            sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] [ sh:class nltl:iceStringer ] ) ] ;
                            sh:path nltl:hasAttachedSupportingStructure ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/frame> ;
            sh:resultMessage "The lower end of the strengthened frame part must be represented." ;
            sh:resultPath nltl:hasLowerEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n4654b2372af44a2280278a91da76035cb2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/lowerEnd> ] .

_:n4654b2372af44a2280278a91da76035cb2 sh:class nltl:frameEnd ;
    sh:message "The lower end of the strengthened frame part must be represented." ;
    sh:minCount 1 ;
    sh:node gen:TRF_047_LowerEndShape ;
    sh:path nltl:hasLowerEnd .

