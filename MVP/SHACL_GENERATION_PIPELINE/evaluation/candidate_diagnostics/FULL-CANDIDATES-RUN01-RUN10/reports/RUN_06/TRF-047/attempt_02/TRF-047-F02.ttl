@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F02/support> ;
                    sh:resultMessage "Node ex:support must conform to one or more shapes in [ sh:class nltl:deckStructure ] , [ sh:class nltl:tankBoundaryPlating ] , [ sh:class nltl:tankTop ] , [ sh:class nltl:iceStringer ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] [ sh:class nltl:iceStringer ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F02/support> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F02/frame> ;
            sh:resultMessage "The lower end of the strengthened part must be attached to an allowed deck, tank boundary plating, tank top, or ice stringer." ;
            sh:resultPath nltl:hasAttachedSupportingStructure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The lower end of the strengthened part must be attached to an allowed deck, tank boundary plating, tank top, or ice stringer." ;
                    sh:minCount 1 ;
                    sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] [ sh:class nltl:iceStringer ] ) ] ;
                    sh:path nltl:hasAttachedSupportingStructure ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F02/support> ] .

