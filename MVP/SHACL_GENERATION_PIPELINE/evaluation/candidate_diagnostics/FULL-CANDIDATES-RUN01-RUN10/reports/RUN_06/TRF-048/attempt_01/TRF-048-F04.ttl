@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F04/longitudinalFrame> ;
            sh:resultMessage "The longitudinal frame calculation results must satisfy the declared f4, section modulus, and required shear area formulas within a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The longitudinal frame calculation results must satisfy the declared f4, section modulus, and required shear area formulas within a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:spacing ?sNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?syNode ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Node ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p ;
                       qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?hNode qudt:numericValue ?h ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?sNode qudt:numericValue ?s ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?lNode qudt:numericValue ?l ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?mNode qudt:numericValue ?m ;
                       qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?syNode qudt:numericValue ?sy ;
                        qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?f4Node qudt:numericValue ?f4 ;
                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?zNode qudt:numericValue ?z ;
                       qudt:unit <http://qudt.org/vocab/unit/CentiM3> .
                ?aNode qudt:numericValue ?a ;
                       qudt:unit <http://qudt.org/vocab/unit/CentiM2> .

                BIND ((1 - (0.2 * ?h / ?s)) AS ?expectedF4)
                BIND ((?expectedF4 * ?p * ?h * ?l * ?l / (4 * ?m * ?sy) * 1000000) AS ?expectedZ)
                BIND ((1.7320508075688772 * ?expectedF4 * 2.16 * ?p * ?h * ?l / (2 * ?sy) * 10000) AS ?expectedA)

                FILTER (
                    ABS(?f4 - ?expectedF4) > (ABS(?expectedF4) * 0.000001 + 0.000000001)
                    ||
                    ABS(?z - ?expectedZ) > (ABS(?expectedZ) * 0.000001 + 0.000000001)
                    ||
                    ABS(?a - ?expectedA) > (ABS(?expectedA) * 0.000001 + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-048-LongitudinalFrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F04/longitudinalFrame> ] .

