@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P05/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in ([ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A frame within the ice-strengthened area must be effectively attached.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:effectiveAttachmentConfirmed ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ], [ sh:message Literal(\"A frame within the ice-strengthened area must have an attachment record.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF049_FrameAttachmentShape ; sh:path nltl:hasFrameAttachment ] ]) and ([ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:passesThroughSupportingStructure ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:passesThroughSupportingStructure ], [ sh:datatype xsd:integer ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"2\", datatype=xsd:integer) ; sh:message Literal(\"Both sides of the frame web plate must be connected when the frame passes through the supporting structure.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:webPlateConnectionSideCount ] ])" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF049_FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P05/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P05/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in ([ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A frame within the ice-strengthened area must be effectively attached.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:effectiveAttachmentConfirmed ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ], [ sh:message Literal(\"A frame within the ice-strengthened area must have an attachment record.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF049_FrameAttachmentShape ; sh:path nltl:hasFrameAttachment ] ]) and ([ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:passesThroughSupportingStructure ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:passesThroughSupportingStructure ], [ sh:datatype xsd:integer ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"2\", datatype=xsd:integer) ; sh:message Literal(\"Both sides of the frame web plate must be connected when the frame passes through the supporting structure.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:webPlateConnectionSideCount ] ])" ;
            sh:resultSeverity sh:Violation ;
