                    sh:path ( nltl:frameWebThickness qudt:numericValue ) ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F01/frame> ;
            sh:resultMessage "A frame within the ice-strengthened area must have at least one frame attachment record." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A frame within the ice-strengthened area must have at least one frame attachment record." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:withinIceStrengthenedArea true .
  FILTER NOT EXISTS {
    $this nltl:hasFrameAttachment ?attachment .
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-049-FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F01/frame> ],
