@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F03/frame> ;
            sh:resultMessage "Less than 1 values on ex:frame->( nltl:frameWebThickness qudt:numericValue )" ;
            sh:resultPath ( nltl:frameWebThickness qudt:numericValue ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:decimal ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path ( nltl:frameWebThickness qudt:numericValue ) ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F03/frame> ;
            sh:resultMessage "A frame within the ice-strengthened area must have at least one frame attachment record." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A frame within the ice-strengthened area must have at least one frame attachment record." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:withinIceStrengthenedArea true .
  FILTER NOT EXISTS {
    $this nltl:hasFrameAttachment ?attachment .
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-049-FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F03/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F03/frame> ;
            sh:resultMessage "Less than 1 values on ex:frame->( nltl:frameWebThickness qudt:unit )" ;
            sh:resultPath _:nebf00084e046408ca254b4c9f8be300db7 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nebf00084e046408ca254b4c9f8be300db6 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F03/frame> ;
            sh:resultMessage "A frame running through a supporting structure must connect both sides of its web plate." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A frame running through a supporting structure must connect both sides of its web plate." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:withinIceStrengthenedArea true ;
        nltl:passesThroughSupportingStructure true .
  FILTER NOT EXISTS {
    $this nltl:webPlateConnectionSideCount ?count .
    FILTER (datatype(?count) = xsd:integer && ?count >= 2)
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-049-FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F03/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F03/frame> ;
            sh:resultMessage "Node ex:frame->( nltl:frameWebThickness qudt:unit ) does not contain a value in the set: ['<http://qudt.org/vocab/unit/MilliM>']" ;
            sh:resultPath _:nebf00084e046408ca254b4c9f8be300db7 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nebf00084e046408ca254b4c9f8be300db6 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F03/frame> ;
            sh:resultMessage "Each represented frame must provide its web thickness." ;
            sh:resultPath nltl:frameWebThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "Each represented frame must provide its web thickness." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameWebThickness ] ] .

_:N3e68551989a14d2ba0e6d6252eb16e11 rdf:first qudt:unit ;
    rdf:rest () .

_:N9edaaf1b564e4901a7715c4cd78464ed rdf:first nltl:frameWebThickness ;
    rdf:rest ( qudt:unit ) .

_:nebf00084e046408ca254b4c9f8be300db6 sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path _:N9edaaf1b564e4901a7715c4cd78464ed .

_:nebf00084e046408ca254b4c9f8be300db7 rdf:first nltl:frameWebThickness ;
    rdf:rest _:N3e68551989a14d2ba0e6d6252eb16e11 .

