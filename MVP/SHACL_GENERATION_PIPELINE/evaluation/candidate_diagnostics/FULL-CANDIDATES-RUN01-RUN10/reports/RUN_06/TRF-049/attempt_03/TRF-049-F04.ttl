                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:frameWebThickness ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F04/frameWebThicknessValue> ],
        [ a sh:ValidationResult ;
