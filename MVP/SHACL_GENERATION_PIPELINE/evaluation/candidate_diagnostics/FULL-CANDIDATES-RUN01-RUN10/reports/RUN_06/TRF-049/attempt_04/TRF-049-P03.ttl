@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P03/frame> ;
            sh:resultMessage "Within the ice-strengthened area, every linked supporting structure must have a reciprocal effective attachment record for this frame." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Within the ice-strengthened area, every linked supporting structure must have a reciprocal effective attachment record for this frame." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true .
                $this ?supportLink ?support .
                FILTER (?supportLink IN (
                    nltl:hasSupportingWebFrame,
                    nltl:hasSupportingBulkhead
                ))
                FILTER NOT EXISTS {
                    $this nltl:hasFrameAttachment ?attachment .
                    ?attachment nltl:effectiveAttachmentConfirmed true .
                    ?attachment nltl:hasAttachedSupportingStructure ?support .
                    ?support nltl:hasSupportingStructureAttachment ?attachment .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-049-FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P03/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P03/frame> ;
            sh:resultMessage "Every installed bracket on a longitudinal frame must attach the corresponding supporting web frame or bulkhead." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Every installed bracket on a longitudinal frame must attach the corresponding supporting web frame or bulkhead." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:longitudinalFrame ;
                      nltl:withinIceStrengthenedArea true ;
                      ?supportLink ?support .
                FILTER (?supportLink IN (
                    nltl:hasSupportingWebFrame,
                    nltl:hasSupportingBulkhead
                ))
                FILTER NOT EXISTS {
                    $this nltl:hasFrameAttachment ?attachment .
                    ?attachment nltl:effectiveAttachmentConfirmed true ;
                                nltl:hasAttachedSupportingStructure ?support ;
                                nltl:hasConnectionBracket ?bracket .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-049-FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P03/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P03/frame> ;
            sh:resultMessage "Every supporting web frame and bulkhead of an applicable longitudinal frame must be attached by an effective bracket attachment." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Every supporting web frame and bulkhead of an applicable longitudinal frame must be attached by an effective bracket attachment." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true ;
                      ?supportLink ?support .
                FILTER (?supportLink IN (
                    nltl:hasSupportingWebFrame,
                    nltl:hasSupportingBulkhead
                ))
                FILTER NOT EXISTS {
                    $this nltl:hasFrameAttachment ?attachment .
                    ?attachment nltl:effectiveAttachmentConfirmed true ;
                                nltl:hasAttachedSupportingStructure ?support ;
                                nltl:hasConnectionBracket ?bracket .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-049-LongitudinalSupportShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P03/frame> ] .

