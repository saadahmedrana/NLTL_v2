@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/iceStringer> ;
            sh:resultMessage "The design line load, section modulus, and required shear area must satisfy the declared ice-stringer formulas within a relative tolerance of 1e-6, with an absolute tolerance scale of 1 near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The design line load, section modulus, and required shear area must satisfy the declared ice-stringer formulas within a relative tolerance of 1e-6, with an absolute tolerance scale of 1 near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:designLineLoad ?dNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?sigmaNode qudt:numericValue ?sigma .
                ?dNode qudt:numericValue ?d .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND(IF((?p * ?h) < 0.15, 0.15, (?p * ?h)) AS ?designLoad)
                BIND(1000 * ?designLoad AS ?expectedD)
                BIND((0.9 * 1.8 * ?designLoad * ?l * ?l / (?m * ?sigma)) * 1000000 AS ?expectedZ)
                BIND((1.7320508075688772 * 0.9 * 1.8 * 1.2 * ?designLoad * ?l / (2 * ?sigma)) * 10000 AS ?expectedA)

                FILTER(
                    ABS(?d - ?expectedD) >
                    (0.000001 * IF(ABS(?expectedD) > 1, ABS(?expectedD), 1))
                    ||
                    ABS(?z - ?expectedZ) >
                    (0.000001 * IF(ABS(?expectedZ) > 1, ABS(?expectedZ), 1))
                    ||
                    ABS(?a - ?expectedA) >
                    (0.000001 * IF(ABS(?expectedA) > 1, ABS(?expectedA), 1))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-053-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/iceStringer> ] .

