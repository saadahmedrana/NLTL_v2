        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/designLineLoadValue> ;
                    sh:resultMessage "Node ex:designLineLoadValue->qudt:unit does not contain a value in the set: ['qudt:KiloN-PER-M']" ;
                    sh:resultPath qudt:unit ;
