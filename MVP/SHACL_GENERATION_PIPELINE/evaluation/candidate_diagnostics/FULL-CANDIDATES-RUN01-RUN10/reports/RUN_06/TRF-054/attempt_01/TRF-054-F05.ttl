                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/designIceLoadHeightValue> ;
                    sh:resultMessage "Node ex:designIceLoadHeightValue->qudt:unit does not contain a value in the set: ['qudt:M']" ;
