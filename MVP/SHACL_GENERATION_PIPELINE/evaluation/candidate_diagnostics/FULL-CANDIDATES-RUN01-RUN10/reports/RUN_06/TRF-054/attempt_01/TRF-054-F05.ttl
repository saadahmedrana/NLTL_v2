                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:frameMomentFactorM ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/frameMomentFactorMValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/distanceToIceBeltValue> ;
                    sh:resultMessage "Node ex:distanceToIceBeltValue->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/iceStringer> ;
            sh:resultMessage "distanceToIceBelt must provide one decimal value in metres." ;
            sh:resultPath nltl:distanceToIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "distanceToIceBelt must provide one decimal value in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:M ;
                                    sh:maxCount 1 ;
