            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/spanValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/iceStringer> ;
            sh:resultMessage "The derived design line load, outside-ice-belt factor, section modulus, and required shear area do not satisfy the specified formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The derived design line load, outside-ice-belt factor, section modulus, and required shear area do not satisfy the specified formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:stringerSpan ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:distanceToIceBelt ?hsNode ;
                      nltl:designLineLoad ?lineNode ;
                      nltl:outsideIceBeltFactor ?factorNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?sigmaNode qudt:numericValue ?sigma .
                ?hsNode qudt:numericValue ?hs .
                ?lineNode qudt:numericValue ?line .
                ?factorNode qudt:numericValue ?factor .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND(IF((?p * ?h) < 0.15, 0.15, (?p * ?h)) AS ?lineMN)
                BIND((1 - (?hs / ?l)) AS ?factorExpected)
                BIND((0.80 * 1.8 * ?lineMN * ?l * ?l / (?m * ?sigma) * ?factorExpected * 1000000) AS ?zExpected)
                BIND((1.7320508075688772 * 0.80 * 1.8 * 1.2 * ?lineMN * ?l / (2 * ?sigma) * ?factorExpected * 10000) AS ?aExpected)
                BIND((?lineMN * 1000) AS ?lineExpected)

                FILTER (
                    (
                        ABS(?line - ?lineExpected) > (0.000001 * ABS(?lineExpected)) &&
                        ABS(?line - ?lineExpected) > 0.000000001
                    ) ||
                    (
                        ABS(?factor - ?factorExpected) > (0.000001 * ABS(?factorExpected)) &&
                        ABS(?factor - ?factorExpected) > 0.000000001
                    ) ||
                    (
                        ABS(?z - ?zExpected) > (0.000001 * ABS(?zExpected)) &&
                        ABS(?z - ?zExpected) > 0.000000001
                    ) ||
                    (
                        ABS(?a - ?aExpected) > (0.000001 * ABS(?aExpected)) &&
                        ABS(?a - ?aExpected) > 0.000000001
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-054-IceStringerShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/iceStringer> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/outsideIceBeltFactorValue> ;
                    sh:resultMessage "Node ex:outsideIceBeltFactorValue->qudt:unit does not contain a value in the set: ['qudt:UNITLESS']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/iceStringer> ;
            sh:resultMessage "outsideIceBeltFactor must provide one dimensionless decimal value." ;
            sh:resultPath nltl:outsideIceBeltFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "outsideIceBeltFactor must provide one dimensionless decimal value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:outsideIceBeltFactor ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/outsideIceBeltFactorValue> ] .

