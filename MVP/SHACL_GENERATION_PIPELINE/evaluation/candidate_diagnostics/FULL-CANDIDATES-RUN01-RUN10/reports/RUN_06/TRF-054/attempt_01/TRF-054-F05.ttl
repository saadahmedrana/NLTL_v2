        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/spanValue> ;
                    sh:resultMessage "Node ex:spanValue->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
