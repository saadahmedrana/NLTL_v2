@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F02/iceStringer> ;
            sh:resultMessage "The calculated design line load, outside-ice-belt factor, section modulus, and required shear area must match the declared formulas within numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The calculated design line load, outside-ice-belt factor, section modulus, and required shear area must match the declared formulas within numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:span/qudt:numericValue ?span ;
                      nltl:stringerSpan/qudt:numericValue ?stringerSpan ;
                      nltl:frameMomentFactorM/qudt:numericValue ?m ;
                      nltl:yieldStrength/qudt:numericValue ?sigma ;
                      nltl:distanceToIceBelt/qudt:numericValue ?hs ;
                      nltl:designLineLoad/qudt:numericValue ?reportedLoad ;
                      nltl:outsideIceBeltFactor/qudt:numericValue ?reportedFactor ;
                      nltl:sectionModulus/qudt:numericValue ?reportedZ ;
                      nltl:requiredShearArea/qudt:numericValue ?reportedA .

                BIND(IF((?p * ?h) < 0.15, 0.15, (?p * ?h)) AS ?load)
                BIND((1 - (?hs / ?stringerSpan)) AS ?factor)
                BIND(?stringerSpan AS ?l)
                BIND((0.80 * 1.8 * ?load * ?l * ?l / (?m * ?sigma) * ?factor * 1000000) AS ?expectedZ)
                BIND((1.7320508075688772 * 0.80 * 1.8 * 1.2 * ?load * ?l / (2 * ?sigma) * ?factor * 10000) AS ?expectedA)

                FILTER (
                    ?span != ?l ||
                    ?reportedLoad < (?load * 0.999999) ||
                    ?reportedLoad > (?load * 1.000001) ||
                    ?reportedFactor < (?factor * 0.999999) ||
                    ?reportedFactor > (?factor * 1.000001) ||
                    ?reportedZ < (?expectedZ * 0.999999) ||
                    ?reportedZ > (?expectedZ * 1.000001) ||
                    ?reportedA < (?expectedA * 0.999999) ||
                    ?reportedA > (?expectedA * 1.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-054> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F02/iceStringer> ] .

