@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:shipBreadth" ;
            sh:resultPath nltl:shipBreadth ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:shipBreadth ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "Actual section modulus and actual shear area must each be at least their respective required values." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Actual section modulus and actual shear area must each be at least their respective required values." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:actualSectionModulus ?actualZ .
                ?actualZ qudt:numericValue ?actualZValue .
                $this nltl:requiredSectionModulus ?requiredZ .
                ?requiredZ qudt:numericValue ?requiredZValue .
                $this nltl:actualShearArea ?actualA .
                ?actualA qudt:numericValue ?actualAValue .
                $this nltl:requiredShearArea ?requiredA .
                ?requiredA qudt:numericValue ?requiredAValue .
                FILTER (
                    xsd:decimal(?actualZValue) < xsd:decimal(?requiredZValue) ||
                    xsd:decimal(?actualAValue) < xsd:decimal(?requiredAValue)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF055NarrowDeckStripShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:scantlingApprovalStatus" ;
            sh:resultPath nltl:scantlingApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceState ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:scantlingApprovalStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:hatchOpeningLength" ;
            sh:resultPath nltl:hatchOpeningLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:hatchOpeningLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:sectionModulus" ;
            sh:resultPath nltl:sectionModulus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:sectionModulus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:designLineLoad" ;
            sh:resultPath nltl:designLineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:designLineLoad ] ] .

