@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F01/hatch> ;
                    sh:resultMessage "Ship-side deflection must be represented for a weatherdeck hatch longer than half the ship breadth." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Ship-side deflection must be represented for a weatherdeck hatch longer than half the ship breadth." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hatchOpeningLength ?opening .
                ?opening qudt:numericValue ?openingLength ;
                         qudt:unit unit:M .
                ?ship nltl:hasWeatherdeckHatch $this ;
                      nltl:shipBreadth ?breadthQuantity .
                ?breadthQuantity qudt:numericValue ?breadth ;
                                 qudt:unit unit:M .
                FILTER(
                    datatype(?openingLength) = xsd:decimal &&
                    datatype(?breadth) = xsd:decimal &&
                    ?openingLength > (?breadth / 2)
                )
                FILTER NOT EXISTS {
                    $this nltl:shipSideDeflection ?deflection
                }
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:TRF-056-WeatherdeckHatchShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F01/hatch> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF-056-WeatherdeckHatchShape>. See details for more information." ;
            sh:resultPath nltl:hasWeatherdeckHatch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:TRF-056-WeatherdeckHatchShape> ;
                    sh:path nltl:hasWeatherdeckHatch ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F01/hatch> ] .

