@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F02/hatch> ;
                    sh:resultMessage "For a weatherdeck hatch longer than half the ship breadth, ship side deflection and both hatch cover and hatch fitting design evidence must be represented." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "For a weatherdeck hatch longer than half the ship breadth, ship side deflection and both hatch cover and hatch fitting design evidence must be represented." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                ?ship nltl:hasWeatherdeckHatch $this .
                ?ship nltl:shipBreadth ?breadthQuantity .
                ?breadthQuantity qudt:numericValue ?breadthValue ;
                    qudt:unit <http://qudt.org/vocab/unit/M> .
                $this nltl:hatchOpeningLength ?openingQuantity .
                ?openingQuantity qudt:numericValue ?openingValue ;
                    qudt:unit <http://qudt.org/vocab/unit/M> .

                FILTER (datatype(?breadthValue) = xsd:decimal)
                FILTER (datatype(?openingValue) = xsd:decimal)
                FILTER (?openingValue > (?breadthValue / 2))

                FILTER (
                    NOT EXISTS {
                        $this nltl:shipSideDeflection ?deflectionQuantity .
                        ?deflectionQuantity qudt:numericValue ?deflectionValue ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (datatype(?deflectionValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasHatchCoverDesignEvidence ?coverEvidence .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasHatchFittingDesignEvidence ?fittingEvidence .
                    }
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:TRF056WeatherdeckHatchShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F02/hatch> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF056WeatherdeckHatchShape. See details for more information." ;
            sh:resultPath nltl:hasWeatherdeckHatch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:TRF056WeatherdeckHatchShape ;
                    sh:path nltl:hasWeatherdeckHatch ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F02/hatch> ] .

