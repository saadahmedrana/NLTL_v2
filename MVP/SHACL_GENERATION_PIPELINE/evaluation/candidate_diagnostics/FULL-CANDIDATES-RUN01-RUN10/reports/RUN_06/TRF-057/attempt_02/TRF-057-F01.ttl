@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "webFrameIceLoad must equal 1.8 times the applicable ice pressure-height line load times web frame spacing, reported in kN, within a relative tolerance of 1e-6 with a 1e-6 absolute fallback" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "webFrameIceLoad must equal 1.8 times the applicable ice pressure-height line load times web frame spacing, reported in kN, within a relative tolerance of 1e-6 with a 1e-6 absolute fallback" ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureValue ;
                      nltl:iceLoadHeight ?heightValue ;
                      nltl:webFrameSpacing ?spacingValue ;
                      nltl:webFrameIceLoad ?loadValue .

                ?pressureValue qudt:numericValue ?pressure .
                ?heightValue qudt:numericValue ?height .
                ?spacingValue qudt:numericValue ?spacing .
                ?loadValue qudt:numericValue ?actualLoad .

                BIND(IF((?pressure * ?height) < 0.15,
                        0.15,
                        (?pressure * ?height)) AS ?applicableLineLoad)
                BIND((1.8 * ?applicableLineLoad * ?spacing * 1000) AS ?expectedLoad)

                FILTER (
                    ABS(?actualLoad - ?expectedLoad) >
                    IF(
                        (0.000001 * ABS(?expectedLoad)) > 0.000001,
                        (0.000001 * ABS(?expectedLoad)),
                        0.000001
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF057WebFrameIceLoadShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ] .

