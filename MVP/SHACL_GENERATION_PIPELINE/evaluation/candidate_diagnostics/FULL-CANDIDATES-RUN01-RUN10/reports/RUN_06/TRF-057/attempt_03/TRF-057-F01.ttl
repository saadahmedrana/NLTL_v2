@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "webFrameIceLoad must equal 1.8 times the greater of icePressure multiplied by iceLoadHeight and 0.15, multiplied by webFrameSpacing, with the result converted from MN to kN." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "webFrameIceLoad must equal 1.8 times the greater of icePressure multiplied by iceLoadHeight and 0.15, multiplied by webFrameSpacing, with the result converted from MN to kN." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:iceLoadHeight ?heightNode ;
                      nltl:webFrameSpacing ?spacingNode ;
                      nltl:webFrameIceLoad ?loadNode .

                ?pressureNode qudt:numericValue ?pressure .
                ?heightNode qudt:numericValue ?height .
                ?spacingNode qudt:numericValue ?spacing .
                ?loadNode qudt:numericValue ?reportedLoad .

                BIND (
                    1.8 *
                    IF(
                        (?pressure * ?height) < 0.15,
                        0.15,
                        (?pressure * ?height)
                    ) *
                    ?spacing *
                    1000
                    AS ?expectedLoad
                )

                FILTER (
                    ABS(?reportedLoad - ?expectedLoad) >
                    IF(
                        (0.000001 * ABS(?expectedLoad)) > 0.000001,
                        (0.000001 * ABS(?expectedLoad)),
                        0.000001
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_057_WebFrameIceLoadShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ] .

