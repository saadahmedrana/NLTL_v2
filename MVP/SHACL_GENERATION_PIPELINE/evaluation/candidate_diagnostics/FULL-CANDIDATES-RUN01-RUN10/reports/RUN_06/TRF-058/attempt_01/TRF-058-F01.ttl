@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-F01/webFrame> ;
            sh:resultMessage "Node ex:webFrame must conform to one or more shapes in nltlgen:TRF058ApplicableShape , nltlgen:TRF058NotApplicableShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:TRF058WebFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-F01/webFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-F01/webFrame> ;
            sh:resultMessage "Less than 1 values on ex:webFrame->nltl:supportedStringerOutsideIceBelt" ;
            sh:resultPath nltl:supportedStringerOutsideIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:supportedStringerOutsideIceBelt ] ] .

