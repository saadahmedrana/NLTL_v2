@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-F03/webFrame> ;
            sh:resultMessage """Node ex:webFrame must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:supportedStringerOutsideIceBelt ] ; sh:sparql [ sh:message Literal("Adjusted ice load force must equal ice load force multiplied by (1 - stringer outside ice belt height / stringer span) when the supported stringer is outside the ice belt.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceLoadForce ?forceNode ;
                              nltl:stringerOutsideIceBeltHeight ?heightNode ;
                              nltl:stringerSpan ?spanNode ;
                              nltl:adjustedIceLoadForce ?adjustedNode .
                        ?forceNode qudt:numericValue ?force .
                        ?heightNode qudt:numericValue ?height .
                        ?spanNode qudt:numericValue ?span .
                        ?adjustedNode qudt:numericValue ?adjusted .
                        BIND (?force * (1 - (?height / ?span)) AS ?expected)
                        BIND (IF(?expected >= 0, ?expected, -?expected) AS ?magnitude)
                        BIND ((0.000001 * ?magnitude) + 0.000001 AS ?tolerance)
                        FILTER (
                            ?adjusted < (?expected - ?tolerance) ||
                            ?adjusted > (?expected + ?tolerance)
                        )
                    }
                ") ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:supportedStringerOutsideIceBelt ] ; sh:sparql [ sh:message Literal("Adjusted ice load force must equal ice load force when the supported stringer is not outside the ice belt.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceLoadForce ?forceNode ;
                              nltl:adjustedIceLoadForce ?adjustedNode .
                        ?forceNode qudt:numericValue ?force .
                        ?adjustedNode qudt:numericValue ?adjusted .
                        BIND (?force AS ?expected)
                        BIND (IF(?expected >= 0, ?expected, -?expected) AS ?magnitude)
                        BIND ((0.000001 * ?magnitude) + 0.000001 AS ?tolerance)
                        FILTER (
                            ?adjusted < (?expected - ?tolerance) ||
                            ?adjusted > (?expected + ?tolerance)
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF058_WebFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-F03/webFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-F03/webFrame> ;
            sh:resultMessage "The supported-stringer outside-ice-belt applicability value is required." ;
            sh:resultPath nltl:supportedStringerOutsideIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The supported-stringer outside-ice-belt applicability value is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:supportedStringerOutsideIceBelt ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-F03/webFrame> ;
            sh:resultMessage "Less than 1 values on ex:webFrame->nltl:adjustedIceLoadForce" ;
            sh:resultPath nltl:adjustedIceLoadForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:adjustedIceLoadForce ] ] .

