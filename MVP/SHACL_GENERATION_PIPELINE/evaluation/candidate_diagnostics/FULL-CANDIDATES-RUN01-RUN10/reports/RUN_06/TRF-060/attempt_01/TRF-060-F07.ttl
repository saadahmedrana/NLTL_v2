@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F07/lookup> ;
                    sh:resultMessage "The lookup case must reference TRAFICOM Table 4-8." ;
                    sh:resultPath nltl:tableReference ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:tableReferenceValue ;
                            sh:in ( nltl:traficomTable4Dash8 ) ;
                            sh:maxCount 1 ;
                            sh:message "The lookup case must reference TRAFICOM Table 4-8." ;
                            sh:minCount 1 ;
                            sh:path nltl:tableReference ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F07/ship> ;
            sh:resultMessage "A table lookup case with table-selection evidence is required." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A table lookup case with table-selection evidence is required." ;
                    sh:minCount 1 ;
                    sh:node gs:TableLookupCaseShape ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F07/lookup> ] .

