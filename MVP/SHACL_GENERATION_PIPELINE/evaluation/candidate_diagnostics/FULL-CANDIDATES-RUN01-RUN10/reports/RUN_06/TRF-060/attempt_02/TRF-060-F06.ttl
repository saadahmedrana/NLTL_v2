@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F06/lookup> ;
                    sh:resultMessage "The table lookup case shall provide the Table 4-8 gamma factor as a dimensionless quantity." ;
                    sh:resultPath nltl:webFrameTable4Dash8GammaFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The table lookup case shall provide the Table 4-8 gamma factor as a dimensionless quantity." ;
                            sh:minCount 1 ;
                            sh:node gen:DimensionlessQuantityShape ;
                            sh:path nltl:webFrameTable4Dash8GammaFactor ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F06/ship> ;
            sh:resultMessage "The ship shall provide a Table 4-8 lookup case." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide a Table 4-8 lookup case." ;
                    sh:minCount 1 ;
                    sh:node gen:TableLookupCaseShape ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F06/lookup> ] .

