@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F08/webFrameSpanValue> ;
                    sh:resultMessage "Node ex:webFrameSpanValue->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/M>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F08/ship> ;
            sh:resultMessage "The ship must provide the web-frame span in m." ;
            sh:resultPath nltl:webFrameSpan ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the web-frame span in m." ;
                    sh:node gen:LengthMShape ;
                    sh:path nltl:webFrameSpan ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F08/webFrameSpanValue> ] .

