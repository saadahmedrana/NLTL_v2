@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F03/lookup> ;
                    sh:resultMessage "The table lookup case must provide the dimensionless Table 4-8 gamma factor." ;
                    sh:resultPath nltl:webFrameTable4Dash8GammaFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The table lookup case must provide the dimensionless Table 4-8 gamma factor." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:webFrameTable4Dash8GammaFactor ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:tableLookupCase ; sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal(\"The table lookup case must include selection evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lookupSelectionEvidence ], [ sh:message Literal(\"The table lookup case must provide the dimensionless Table 4-8 gamma factor.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:webFrameTable4Dash8GammaFactor ], [ sh:message Literal(\"The table lookup case must reference TRAFICOM Table 4-8.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:hasValue nltl:traficomTable4Dash8 ] ) ] ; sh:path nltl:tableReference ] ]. See details for more information." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:tableLookupCase ;
                            sh:property [ sh:class nltl:evidenceArtifact ;
                                    sh:message "The table lookup case must include selection evidence." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:lookupSelectionEvidence ],
                                [ sh:message "The table lookup case must provide the dimensionless Table 4-8 gamma factor." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:webFrameTable4Dash8GammaFactor ],
                                [ sh:message "The table lookup case must reference TRAFICOM Table 4-8." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:or ( [ ] ) ] ;
                                    sh:path nltl:tableReference ] ] ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F03/lookup> ] .

