@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-062-F01/ship> ;
            sh:resultMessage "The propeller blade tip to hull clearance must be no less than h0." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The propeller blade tip to hull clearance must be no less than h0." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:minimumClearance ?minimumNode .
                ?minimumNode qudt:numericValue ?minimum .
                $this nltl:propellerBladeTipHullClearance ?clearanceNode .
                ?clearanceNode qudt:numericValue ?clearance .
                FILTER (
                    DATATYPE(?minimum) = xsd:decimal &&
                    DATATYPE(?clearance) = xsd:decimal &&
                    ?clearance < ?minimum
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_062_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-062-F01/ship> ] .

