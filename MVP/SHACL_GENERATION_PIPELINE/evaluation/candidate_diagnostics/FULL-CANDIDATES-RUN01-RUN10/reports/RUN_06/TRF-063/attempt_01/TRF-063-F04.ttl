@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:sidePropellerStrengtheningEnvelope ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-063-EnvelopeShape> ; sh:path nltl:hasSidePropellerStrengtheningEnvelope ], [ sh:datatype xsd:integer ; sh:in ( Literal("2", datatype=xsd:integer) Literal("3", datatype=xsd:integer) ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerCount ] ] , [ sh:property [ sh:datatype xsd:integer ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerCount ] ; sh:sparql [ sh:message Literal("A non-twin or non-triple-screw ship must not have a propeller count of 2 or 3 in the non-applicable branch.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerCount ?count .
                        FILTER (?count = 2 || ?count = 3)
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-063-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F04/ship> ] .

