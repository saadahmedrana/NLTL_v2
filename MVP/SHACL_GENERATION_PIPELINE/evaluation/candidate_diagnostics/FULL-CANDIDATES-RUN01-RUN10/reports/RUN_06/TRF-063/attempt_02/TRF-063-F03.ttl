@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:sidePropellerStrengtheningEnvelope ; sh:message Literal(\"Twin-screw ships shall provide a side-propeller strengthening envelope with the required tank-top boundary and extents.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF063EnvelopeShape ; sh:nodeKind sh:IRI ; sh:path nltl:hasSidePropellerStrengtheningEnvelope ], [ sh:datatype xsd:integer ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"2\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:propellerCount ] ] , [ sh:property [ sh:class nltl:sidePropellerStrengtheningEnvelope ; sh:message Literal(\"Triple-screw ships shall provide a side-propeller strengthening envelope with the required tank-top boundary and extents.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF063EnvelopeShape ; sh:nodeKind sh:IRI ; sh:path nltl:hasSidePropellerStrengtheningEnvelope ], [ sh:datatype xsd:integer ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"3\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"3\", datatype=xsd:integer) ; sh:path nltl:propellerCount ] ] , [ sh:property [ sh:datatype xsd:integer ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For a non-twin/non-triple-screw ship, propellerCount shall be one integer value other than 2 or 3.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:or ( [ sh:maxInclusive Literal(\"1\", datatype=xsd:integer) ] [ sh:minInclusive Literal(\"4\", datatype=xsd:integer) ] ) ; sh:path nltl:propellerCount ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF063Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F03/ship> ] .

