@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-P03/ship> ;
            sh:resultMessage "The ship shall identify stern tubes enclosed within plated bossing." ;
            sh:resultPath nltl:hasSternTube ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify stern tubes enclosed within plated bossing." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:sternTube ;
                            sh:property [ sh:class nltl:platedBossingStructure ;
                                    sh:message "Stern tubes shall be enclosed within plated bossing." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:enclosedByPlatedBossing ] ] ;
                    sh:path nltl:hasSternTube ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-P03/ship> ;
            sh:resultMessage "The detached-strut applicability value shall be provided." ;
            sh:resultPath nltl:detachedStrut ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The detached-strut applicability value shall be provided." ;
                    sh:minCount 1 ;
                    sh:path nltl:detachedStrut ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-P03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:detachedStrut ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:detachedStrut ], [ sh:message Literal(\"A detached-strut structure with design, strength, and hull-attachment evidence shall be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:detachedStrutStructure ; sh:property [ sh:class nltl:strutDesignEvidence ; sh:message Literal(\"Design evidence shall be provided for a detached strut.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutDesignEvidence ], [ sh:class nltl:strutHullAttachmentEvidence ; sh:message Literal(\"Hull-attachment evidence shall be provided for a detached strut.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutHullAttachmentEvidence ], [ sh:class nltl:strutStrengthEvidence ; sh:message Literal(\"Strength evidence shall be provided for a detached strut.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutStrengthEvidence ] ] ; sh:path nltl:hasDetachedStrut ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF064ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-P03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-P03/ship> ;
            sh:resultMessage "The ship shall identify side propeller shafting enclosed within plated bossing." ;
            sh:resultPath nltl:hasSidePropellerShafting ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify side propeller shafting enclosed within plated bossing." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:sidePropellerShaftingAssembly ;
                            sh:property [ sh:class nltl:platedBossingStructure ;
                                    sh:message "Side propeller shafting shall be enclosed within plated bossing." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:enclosedByPlatedBossing ] ] ;
                    sh:path nltl:hasSidePropellerShafting ] ] .

