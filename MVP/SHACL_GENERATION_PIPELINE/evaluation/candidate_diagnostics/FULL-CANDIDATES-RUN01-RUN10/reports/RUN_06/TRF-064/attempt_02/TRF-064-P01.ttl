@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-P01/ship> ;
            sh:resultMessage "A detached-strut applicability value must be recorded." ;
            sh:resultPath nltl:detachedStrut ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "A detached-strut applicability value must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:detachedStrut ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-P01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:detachedStrutStructure ; sh:message Literal(\"When detached struts are used, a detached-strut structure must be identified.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasDetachedStrut ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:detachedStrut ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:detachedStrut ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF064Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-P01/ship> ] .

