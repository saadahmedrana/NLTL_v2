@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:detachedStrut ], [ sh:message Literal(\"When detached struts are used, the detached-strut design, hull-attachment, and strength relationships shall be represented.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:detachedStrutStructure ; sh:property [ sh:class nltl:strutDesignEvidence ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutDesignEvidence ], [ sh:class nltl:strutHullAttachmentEvidence ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutHullAttachmentEvidence ], [ sh:class nltl:strutStrengthEvidence ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutStrengthEvidence ] ] ; sh:path nltl:hasDetachedStrut ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:detachedStrut ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-064> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F02/sternTube> ;
                    sh:resultMessage "Each existing side-propeller stern tube shall be enclosed within a plated bossing." ;
                    sh:resultPath nltl:enclosedByPlatedBossing ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:platedBossingStructure ;
                            sh:message "Each existing side-propeller stern tube shall be enclosed within a plated bossing." ;
                            sh:minCount 1 ;
                            sh:path nltl:enclosedByPlatedBossing ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:sternTube ; sh:property [ sh:class nltl:platedBossingStructure ; sh:message Literal(\"Each existing side-propeller stern tube shall be enclosed within a plated bossing.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:enclosedByPlatedBossing ] ]. See details for more information." ;
            sh:resultPath nltl:hasSternTube ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:sternTube ;
                            sh:property [ sh:class nltl:platedBossingStructure ;
                                    sh:message "Each existing side-propeller stern tube shall be enclosed within a plated bossing." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:enclosedByPlatedBossing ] ] ;
                    sh:path nltl:hasSternTube ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F02/sternTube> ] .

