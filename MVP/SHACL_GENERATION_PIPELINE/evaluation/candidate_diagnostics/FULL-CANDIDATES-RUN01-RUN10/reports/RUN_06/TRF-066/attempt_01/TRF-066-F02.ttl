@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F02/ship> ;
            sh:resultMessage "For ice classes IA and IA Super, when an ice knife is practicable, the rudder protection arrangement must include an ice knife extending below the lower ice waterline." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For ice classes IA and IA Super, when an ice knife is practicable, the rudder protection arrangement must include an ice knife extending below the lower ice waterline." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (?iceClass IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                $this nltl:iceKnifePracticable ?practicable .
                FILTER (?practicable = true)
                FILTER NOT EXISTS {
                    $this nltl:hasRudderProtectionArrangement ?arrangement .
                    ?arrangement a nltl:iceKnife .
                    ?arrangement nltl:extendsBelowLowerIceWaterline true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-066> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F02/ship> ] .

