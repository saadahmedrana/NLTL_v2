@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F03/ship> ;
            sh:resultMessage "The ship must provide the lower ice waterline used by the rudder-protection requirement." ;
            sh:resultPath nltl:lowerIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship must provide the lower ice waterline used by the rudder-protection requirement." ;
                    sh:minCount 1 ;
                    sh:path nltl:lowerIceWaterline ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:rudderProtectionArrangement ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"An ice-knife rudder-protection arrangement is required when practicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:iceKnife ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ice knife must extend below the ship's declared lower ice waterline.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendsBelowLowerIceWaterline ] ] ; sh:path nltl:hasRudderProtectionArrangement ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For ice classes IA and IA Super, practicability must be recorded as true when the ice-knife alternative is used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:in ( nltl:iceClassIa nltl:iceClassIaSuper ) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:class nltl:rudderProtectionArrangement ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"An equivalent rudder-protection arrangement is required when an ice knife is not practicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:equivalentRudderProtectionMeans ; sh:message Literal(\"An equivalent rudder-protection means is required when an ice knife is not practicable.\") ] ; sh:path nltl:hasRudderProtectionArrangement ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When an ice knife is not practicable for ice class IA or IA Super, the equivalent protection alternative must be used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:in ( nltl:iceClassIa nltl:iceClassIaSuper ) ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-066> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F03/ship> ] .

