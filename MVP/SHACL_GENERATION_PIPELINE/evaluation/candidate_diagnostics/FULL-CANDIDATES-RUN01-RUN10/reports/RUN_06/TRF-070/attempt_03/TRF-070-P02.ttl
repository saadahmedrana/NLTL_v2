@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:mainPropulsionThruster ], [ sh:datatype xsd:string ; sh:in ( Literal("azimuthing") Literal("fixed") ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:thrusterType ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:mainPropulsionThruster ], [ sh:datatype xsd:string ; sh:hasValue Literal("fixed") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:thrusterType ], gen:LocalIcePressurePropertyShape, gen:PropellerIceInteractionLoadPropertyShape, gen:ThrusterBodyIceInteractionLoadPropertyShape ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:mainPropulsionThruster ], [ sh:datatype xsd:string ; sh:hasValue Literal("azimuthing") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:thrusterType ], [ sh:message Literal("An applicable azimuthing-thruster design condition is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:DesignConditionShape ; sh:path nltl:hasDesignCondition ], gen:LocalIcePressurePropertyShape, gen:PropellerIceInteractionLoadPropertyShape, gen:ThrusterBodyIceInteractionLoadPropertyShape ; sh:sparql [ sh:message Literal("For an azimuthing main-propulsion thruster, the normal-condition expected load must equal the thruster-body ice-interaction load.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX q: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasDesignCondition ?condition .
                        ?condition nltl:normalOperationalConditions true .
                        FILTER NOT EXISTS {
                            ?condition nltl:designConditionExpectedLoad ?expected .
                            ?expected q:numericValue ?expectedValue .
                            $this nltl:thrusterBodyIceInteractionLoad ?bodyLoad .
                            ?bodyLoad q:numericValue ?bodyValue .
                            FILTER (?expectedValue = ?bodyValue)
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF070Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P02/ship> ] .

