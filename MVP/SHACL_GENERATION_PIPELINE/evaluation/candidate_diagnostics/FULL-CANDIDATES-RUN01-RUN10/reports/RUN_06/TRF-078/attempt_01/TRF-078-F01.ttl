@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "Focus node does not conform to shape MinCount 1: [ sh:property [ sh:class nltl:iceClassValue ; sh:in ( nltl:iceClassIa nltl:iceClassIaSuper nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:hasValue nltl:traficomTable6Dash6 ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:tableReference ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:DimensionlessQuantityShape ; sh:path nltl:selectedIceClassCycleCount ] ]" ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:path nltl:hasTableLookupCase ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:property [ sh:class nltl:iceClassValue ;
                                    sh:in ( nltl:iceClassIa nltl:iceClassIaSuper nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:iceClass ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node gen:DimensionlessQuantityShape ;
                                    sh:path nltl:selectedIceClassCycleCount ],
                                [ sh:hasValue nltl:traficomTable6Dash6 ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:tableReference ] ] ;
                    sh:qualifiedValueShapesDisjoint true ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "Value is not Literal with datatype nltl:QuantityValue" ;
            sh:resultPath nltl:iceLoadCycleCoefficientK2 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype nltl:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:DimensionlessQuantityShape ;
                    sh:path nltl:iceLoadCycleCoefficientK2 ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/iceLoadCycleCoefficientK2Value> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "Value is not Literal with datatype nltl:QuantityValue" ;
            sh:resultPath nltl:iceLoadCycleCoefficientK3 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype nltl:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:DimensionlessQuantityShape ;
                    sh:path nltl:iceLoadCycleCoefficientK3 ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/iceLoadCycleCoefficientK3Value> ] .

