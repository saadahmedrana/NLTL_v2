@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-P01/ship> ;
            sh:resultMessage "Value is not Literal with datatype nltl:QuantityValue" ;
            sh:resultPath nltl:iceLoadCycleCoefficientK2 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype nltl:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:DimensionlessQuantityShape ;
                    sh:path nltl:iceLoadCycleCoefficientK2 ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-P01/iceLoadCycleCoefficientK2Value> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-P01/ship> ;
            sh:resultMessage "Value is not Literal with datatype nltl:QuantityValue" ;
            sh:resultPath nltl:iceLoadCycleCoefficientK3 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype nltl:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:DimensionlessQuantityShape ;
                    sh:path nltl:iceLoadCycleCoefficientK3 ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-P01/iceLoadCycleCoefficientK3Value> ] .

