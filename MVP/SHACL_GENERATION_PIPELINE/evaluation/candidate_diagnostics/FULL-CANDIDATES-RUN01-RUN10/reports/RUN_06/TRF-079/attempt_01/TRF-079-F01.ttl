@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ;
            sh:resultMessage "The immersion function and submersion factor must satisfy the stated formulas, using a relative tolerance of 1e-6 with an absolute fallback of 1e-9 for derived decimal results." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The immersion function and submersion factor must satisfy the stated formulas, using a relative tolerance of 1e-6 with an absolute fallback of 1e-9 for derived decimal results." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?iceQuantity ;
                      nltl:propellerDiameter ?diameterQuantity ;
                      nltl:propellerImmersionFunction ?immersionQuantity ;
                      nltl:propellerShaftCentrelineDepth ?depthQuantity ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Quantity .

                ?iceQuantity qudt:numericValue ?hIce .
                ?diameterQuantity qudt:numericValue ?diameter .
                ?immersionQuantity qudt:numericValue ?immersion .
                ?depthQuantity qudt:numericValue ?h0 .
                ?k2Quantity qudt:numericValue ?k2 .

                BIND(( (?h0 - ?hIce) / (?diameter / 2) ) - 1 AS ?expectedImmersion)
                BIND(
                    IF(
                        ?expectedImmersion < 0,
                        0.8 - ?expectedImmersion,
                        IF(
                            ?expectedImmersion <= 1,
                            0.8 - (0.4 * ?expectedImmersion),
                            IF(
                                ?expectedImmersion <= 2.5,
                                0.6 - (0.2 * ?expectedImmersion),
                                0.1
                            )
                        )
                    )
                    AS ?expectedK2
                )

                FILTER(
                    ABS(?immersion - ?expectedImmersion)
                    >
                    (1e-6 * ABS(?expectedImmersion) + 1e-9)
                    ||
                    ABS(?k2 - ?expectedK2)
                    >
                    (1e-6 * ABS(?expectedK2) + 1e-9)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_079_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ] .

