@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ;
            sh:resultMessage "The propeller immersion function and ice load cycle coefficient must satisfy clauses 6.15 and 6.16." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The propeller immersion function and ice load cycle coefficient must satisfy clauses 6.15 and 6.16." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?iceQuantity ;
                      nltl:propellerDiameter ?diameterQuantity ;
                      nltl:propellerShaftCentrelineDepth ?depthQuantity ;
                      nltl:propellerImmersionFunction ?immersionQuantity ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Quantity .

                ?iceQuantity qudt:numericValue ?ice .
                ?diameterQuantity qudt:numericValue ?diameter .
                ?depthQuantity qudt:numericValue ?depth .
                ?immersionQuantity qudt:numericValue ?immersion .
                ?k2Quantity qudt:numericValue ?k2 .

                BIND((?depth - ?ice) / (?diameter / 2) - 1 AS ?expectedImmersion)
                BIND(
                    IF(
                        ?expectedImmersion < 0,
                        0.8 - ?expectedImmersion,
                        IF(
                            ?expectedImmersion <= 1,
                            0.8 - 0.4 * ?expectedImmersion,
                            IF(
                                ?expectedImmersion <= 2.5,
                                0.6 - 0.2 * ?expectedImmersion,
                                0.1
                            )
                        )
                    ) AS ?expectedK2
                )

                FILTER(
                    ?diameter = 0 ||
                    !BOUND(?expectedImmersion) ||
                    !BOUND(?expectedK2) ||
                    ABS(?immersion - ?expectedImmersion) >
                        ABS(?expectedImmersion) * 0.000001 + 0.000000001 ||
                    ABS(?k2 - ?expectedK2) >
                        ABS(?expectedK2) * 0.000001 + 0.000000001
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-079> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ] .

