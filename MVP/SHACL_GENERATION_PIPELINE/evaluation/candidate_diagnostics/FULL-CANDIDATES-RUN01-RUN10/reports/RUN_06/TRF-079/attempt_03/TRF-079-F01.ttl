@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ;
            sh:resultMessage "The propeller immersion function and ice load cycle coefficient do not satisfy the specified formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The propeller immersion function and ice load cycle coefficient do not satisfy the specified formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?hNode ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node ;
                      nltl:propellerDiameter ?dNode ;
                      nltl:propellerImmersionFunction ?fNode ;
                      nltl:propellerShaftCentrelineDepth ?h0Node .

                ?hNode qudt:numericValue ?h ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?k2Node qudt:numericValue ?k2 ;
                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?dNode qudt:numericValue ?d ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?fNode qudt:numericValue ?f ;
                       qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?h0Node qudt:numericValue ?h0 ;
                        qudt:unit <http://qudt.org/vocab/unit/M> .

                BIND((($h0 - $h) / ($d / 2)) - 1 AS ?expectedF)
                BIND((1e-6 * IF(?expectedF >= 0, ?expectedF, -?expectedF) + 1e-9) AS ?fTolerance)
                BIND(IF(?f < 0,
                    0.8 - ?f,
                    IF(?f <= 1,
                        0.8 - (0.4 * ?f),
                        IF(?f <= 2.5,
                            0.6 - (0.2 * ?f),
                            0.1
                        )
                    )
                ) AS ?expectedK2)
                BIND((1e-6 * IF(?expectedK2 >= 0, ?expectedK2, -?expectedK2) + 1e-9) AS ?k2Tolerance)

                FILTER(
                    ?f < (?expectedF - ?fTolerance) ||
                    ?f > (?expectedF + ?fTolerance) ||
                    ?k2 < (?expectedK2 - ?k2Tolerance) ||
                    ?k2 > (?expectedK2 + ?k2Tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-079> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ] .

