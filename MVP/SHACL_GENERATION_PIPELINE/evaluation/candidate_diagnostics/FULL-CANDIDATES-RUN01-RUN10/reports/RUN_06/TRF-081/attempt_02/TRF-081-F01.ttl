@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-F01/ship> ;
            sh:resultMessage "Ice thrust and propeller shaft design thrust values must satisfy the TRF-081 formulas within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9 kN." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ice thrust and propeller shaft design thrust values must satisfy the TRF-081 formulas within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9 kN." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce ?ffNode ;
                      nltl:backwardBladeForce ?fbNode ;
                      nltl:hydrodynamicBollardThrust ?hNode ;
                      nltl:forwardIceThrust ?tfNode ;
                      nltl:backwardIceThrust ?tbNode ;
                      nltl:forwardPropellerShaftDesignThrust ?fdrNode ;
                      nltl:backwardPropellerShaftDesignThrust ?bdrNode ;
                      nltl:propellerShaftDesignThrust ?drNode .

                ?ffNode <http://qudt.org/schema/qudt/numericValue> ?ff .
                ?fbNode <http://qudt.org/schema/qudt/numericValue> ?fb .
                ?hNode <http://qudt.org/schema/qudt/numericValue> ?h .
                ?tfNode <http://qudt.org/schema/qudt/numericValue> ?tf .
                ?tbNode <http://qudt.org/schema/qudt/numericValue> ?tb .
                ?fdrNode <http://qudt.org/schema/qudt/numericValue> ?fdr .
                ?bdrNode <http://qudt.org/schema/qudt/numericValue> ?bdr .
                ?drNode <http://qudt.org/schema/qudt/numericValue> ?dr .

                BIND((1.1 * ?ff) AS ?tfExpected)
                BIND((1.1 * ?fb) AS ?tbExpected)
                BIND((?h + (2.2 * ?tfExpected)) AS ?forwardExpected)
                BIND((1.5 * ?tbExpected) AS ?backwardExpected)
                BIND(IF(?forwardExpected >= ?backwardExpected, ?forwardExpected, ?backwardExpected) AS ?designExpected)

                BIND(IF(?tfExpected >= 0, ?tfExpected, 0 - ?tfExpected) AS ?tfScale)
                BIND(IF(?tbExpected >= 0, ?tbExpected, 0 - ?tbExpected) AS ?tbScale)
                BIND(IF(?forwardExpected >= 0, ?forwardExpected, 0 - ?forwardExpected) AS ?forwardScale)
                BIND(IF(?backwardExpected >= 0, ?backwardExpected, 0 - ?backwardExpected) AS ?backwardScale)
                BIND(IF(?designExpected >= 0, ?designExpected, 0 - ?designExpected) AS ?designScale)

                BIND((1e-6 * ?tfScale + 1e-9) AS ?tfTolerance)
                BIND((1e-6 * ?tbScale + 1e-9) AS ?tbTolerance)
                BIND((1e-6 * ?forwardScale + 1e-9) AS ?forwardTolerance)
                BIND((1e-6 * ?backwardScale + 1e-9) AS ?backwardTolerance)
                BIND((1e-6 * ?designScale + 1e-9) AS ?designTolerance)

                BIND(IF(?tf >= ?tfExpected, ?tf - ?tfExpected, ?tfExpected - ?tf) AS ?tfDifference)
                BIND(IF(?tb >= ?tbExpected, ?tb - ?tbExpected, ?tbExpected - ?tb) AS ?tbDifference)
                BIND(IF(?fdr >= ?forwardExpected, ?fdr - ?forwardExpected, ?forwardExpected - ?fdr) AS ?forwardDifference)
                BIND(IF(?bdr >= ?backwardExpected, ?bdr - ?backwardExpected, ?backwardExpected - ?bdr) AS ?backwardDifference)
                BIND(IF(?dr >= ?designExpected, ?dr - ?designExpected, ?designExpected - ?dr) AS ?designDifference)

                FILTER (
                    ?tfDifference > ?tfTolerance ||
                    ?tbDifference > ?tbTolerance ||
                    ?forwardDifference > ?forwardTolerance ||
                    ?backwardDifference > ?backwardTolerance ||
                    ?designDifference > ?designTolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-081> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-F01/ship> ] .

