            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape _:n98d7376376854182955f356fef22c6acb1 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-082-F02/hydrodynamicBollardThrustValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
