@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-083-F01/ship> ;
            sh:resultMessage "Rotational speed must be known or attributed using the required TRAFICOM Table 6-9 lookup case." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_083_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-083-F01/ship> ] .

