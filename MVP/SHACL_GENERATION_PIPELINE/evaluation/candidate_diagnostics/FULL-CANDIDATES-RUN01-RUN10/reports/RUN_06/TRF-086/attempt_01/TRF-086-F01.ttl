@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-F01/ship> ;
            sh:resultMessage "For a CP propeller, the MCR bollard pitch is required; when the pitch value is not known, it must equal 0.7 times the MCR free-running pitch within a relative tolerance of 1e-6 plus an absolute fallback of 1e-12." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a CP propeller, the MCR bollard pitch is required; when the pitch value is not known, it must equal 0.7 times the MCR free-running pitch within a relative tolerance of 1e-6 plus an absolute fallback of 1e-12." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType ?type ;
                      nltl:pitchValueKnown ?known .

                FILTER (?type = "CP"^^xsd:string)

                FILTER (
                    (?known = true &&
                     NOT EXISTS {
                         $this nltl:propellerPitchAtMcrBollard ?bollard .
                         ?bollard a qudt:QuantityValue ;
                                  qudt:numericValue ?observed ;
                                  qudt:unit unit:M .
                         FILTER (datatype(?observed) = xsd:decimal)
                     })
                    ||
                    (?known = false &&
                     NOT EXISTS {
                         $this nltl:propellerPitchAtMcrFreeRunning ?freeRunning ;
                                nltl:propellerPitchAtMcrBollard ?bollard .

                         ?freeRunning a qudt:QuantityValue ;
                                      qudt:numericValue ?freeValue ;
                                      qudt:unit unit:M .

                         ?bollard a qudt:QuantityValue ;
                                  qudt:numericValue ?observed ;
                                  qudt:unit unit:M .

                         FILTER (datatype(?freeValue) = xsd:decimal)
                         FILTER (datatype(?observed) = xsd:decimal)

                         BIND ((0.7 * ?freeValue) AS ?expected)

                         FILTER (
                             ABS(?observed - ?expected) <=
                             (0.000001 * ABS(?expected) + 0.000000000001)
                         )
                     })
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF086Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-F01/ship> ] .

