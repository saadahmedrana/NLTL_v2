@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-P03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:pitchValueKnown ], [ sh:hasValue Literal("CP", datatype=xsd:string) ; sh:path nltl:propellerType ], [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:path nltl:propellerPitchAtMcrFreeRunning ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:MetreQuantityShape ; sh:path nltl:propellerPitchAtMcrBollard ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:pitchValueKnown ], [ sh:hasValue Literal("CP", datatype=xsd:string) ; sh:path nltl:propellerType ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:MetreQuantityShape ; sh:path nltl:propellerPitchAtMcrBollard ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:MetreQuantityShape ; sh:path nltl:propellerPitchAtMcrFreeRunning ] ; sh:sparql [ sh:message Literal("For a CP propeller with unknown pitch, the bollard-condition pitch must equal 0.7 times the free-running pitch within the specified tolerance.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT ?this
                    WHERE {
                        ?this nltl:propellerPitchAtMcrFreeRunning ?freeQuantity .
                        ?freeQuantity qudt:numericValue ?freeValue ;
                                      qudt:unit unit:M .
                        ?this nltl:propellerPitchAtMcrBollard ?bollardQuantity .
                        ?bollardQuantity qudt:numericValue ?observed ;
                                         qudt:unit unit:M .
                        BIND ((0.7 * ?freeValue) AS ?expected)
                        BIND (((0.000001 * ?expected) + 0.000000000001) AS ?tolerance)
                        FILTER (
                            ?observed < (?expected - ?tolerance) ||
                            ?observed > (?expected + ?tolerance)
                        )
                    }
                ") ] ] , [ sh:sparql [ sh:message Literal("This CP-propeller requirement is not applicable when the propeller type is not CP.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT ?this
                    WHERE {
                        ?this nltl:propellerType ?type .
                        FILTER (?type != "CP")
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF086Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-P03/ship> ] .

