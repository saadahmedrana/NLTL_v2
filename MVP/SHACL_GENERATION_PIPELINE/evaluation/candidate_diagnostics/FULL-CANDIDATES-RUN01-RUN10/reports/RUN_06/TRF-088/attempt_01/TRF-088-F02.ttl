@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F02/lookup> ;
                    sh:resultMessage "The Table 6-10 lookup case must have selection evidence." ;
                    sh:resultPath nltl:lookupSelectionEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:message "The Table 6-10 lookup case must have selection evidence." ;
                            sh:minCount 1 ;
                            sh:path nltl:lookupSelectionEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F02/lookup> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF088TableLookupCaseShape. See details for more information." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape gen:TRF088LinkedTableLookupCaseShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F02/lookup> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:maximumEngineTorqueKnown ] ] , [ sh:property [ sh:class nltl:tableLookupCase ; sh:message Literal(\"When maximum engine torque is unknown, a Table 6-10 lookup case must be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF088TableLookupCaseShape ; sh:path nltl:hasTableLookupCase ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:maximumEngineTorqueKnown ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When maximum engine torque is unknown, a maximum engine torque quantity must be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF088TorqueQuantityShape ; sh:path nltl:maximumEngineTorque ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF088ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F02/ship> ] .

