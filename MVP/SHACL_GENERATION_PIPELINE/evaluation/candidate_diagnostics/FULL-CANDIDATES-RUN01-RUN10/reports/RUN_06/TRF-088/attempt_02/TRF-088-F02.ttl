@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F02/ship> ;
            sh:resultMessage "When maximum engine torque is unknown, the ship must have a Table 6-10 lookup case with selection evidence and a reported maximum engine torque quantity." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When maximum engine torque is unknown, the ship must have a Table 6-10 lookup case with selection evidence and a reported maximum engine torque quantity." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumEngineTorqueKnown false .
                FILTER NOT EXISTS {
                    $this nltl:hasTableLookupCase ?case .
                    ?case nltl:tableLookupApplied true ;
                          nltl:tableReference nltl:traficomTable6Dash10 ;
                          nltl:lookupSelectionEvidence ?evidence .
                    $this nltl:maximumEngineTorque ?torque .
                    ?torque qudt:numericValue ?value ;
                            qudt:unit qudt:KiloN-M .
                    FILTER (
                        isLiteral(?value) &&
                        datatype(?value) = xsd:decimal
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:TRF088ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:maximumEngineTorqueKnown ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:maximumEngineTorqueKnown ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltl:TRF088TorqueQuantityShape ; sh:path nltl:maximumEngineTorque ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltl:TRF088TableLookupCaseShape ; sh:path nltl:hasTableLookupCase ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltl:TRF088ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F02/ship> ] .

