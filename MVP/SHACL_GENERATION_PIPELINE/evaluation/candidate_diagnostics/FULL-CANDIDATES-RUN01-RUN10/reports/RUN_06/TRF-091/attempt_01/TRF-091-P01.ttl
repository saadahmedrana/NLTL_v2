@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/milling> ;
            sh:resultMessage "The ship shall identify the ice-milling load-sequence case used by the requirement." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceMillingSequenceCase ;
                    sh:message "The ship shall identify the ice-milling load-sequence case used by the requirement." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceMillingSequenceCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/ship> ;
            sh:resultMessage "The ship shall identify a propulsion load case for the prescribed ice-milling load sequence." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:loadCase ;
                    sh:message "The ship shall identify a propulsion load case for the prescribed ice-milling load sequence." ;
                    sh:minCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ sh:class nltl:loadCasePurposeValue ;
                                    sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                                    sh:message "The propulsion load case shall be designated for propulsion-line strength evaluation and not for stalling analysis." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:loadCasePurpose ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasPropulsionLoadCase ] ] .

