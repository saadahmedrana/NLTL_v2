@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/milling> ;
            sh:resultMessage "The ship shall identify an ice milling sequence case." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceMillingSequenceCase ;
                    sh:message "The ship shall identify an ice milling sequence case." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF091IceMillingSequenceCaseShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceMillingSequenceCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/ship> ;
            sh:resultMessage "The ship shall identify a propulsion load case for the strength evaluation." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n797731100ba9472bb8f3fa126086b070b2 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ;
                    sh:resultMessage "Node ex:loadCase must not conform to shape [ sh:property [ sh:hasValue nltl:stallingAnalysisPurposeValue ; sh:message Literal(\"The propulsion load case shall not be designated for stalling analysis.\") ; sh:path nltl:loadCasePurpose ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NotConstraintComponent ;
                    sh:sourceShape gen:TRF091PropulsionLoadCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ;
                    sh:resultMessage "The propulsion load case shall have the strength-evaluation purpose." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                            sh:message "The propulsion load case shall have the strength-evaluation purpose." ;
                            sh:path nltl:loadCasePurpose ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/milling> ;
            sh:resultMessage "The ship shall identify a propulsion load case for the strength evaluation." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n797731100ba9472bb8f3fa126086b070b2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ] .

_:n797731100ba9472bb8f3fa126086b070b2 sh:class nltl:loadCase ;
    sh:message "The ship shall identify a propulsion load case for the strength evaluation." ;
    sh:minCount 1 ;
    sh:node gen:TRF091PropulsionLoadCaseShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasPropulsionLoadCase .

