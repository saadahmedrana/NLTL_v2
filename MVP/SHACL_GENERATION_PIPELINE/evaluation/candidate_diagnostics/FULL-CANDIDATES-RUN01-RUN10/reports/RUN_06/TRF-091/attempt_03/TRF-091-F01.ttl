                    sh:resultMessage "Node ex:loadCase->nltl:loadCasePurpose does not contain a value in the set: ['nltl:propulsionLineStrengthEvaluationPurpose']" ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCasePurposeValue ;
                            sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:loadCasePurpose ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/milling> ;
            sh:resultMessage "Value does not conform to Shape gs:TRF091PropulsionLoadCaseShape. See details for more information." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n2a00174336ee498baa2825b97de440e4b2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/milling> ;
