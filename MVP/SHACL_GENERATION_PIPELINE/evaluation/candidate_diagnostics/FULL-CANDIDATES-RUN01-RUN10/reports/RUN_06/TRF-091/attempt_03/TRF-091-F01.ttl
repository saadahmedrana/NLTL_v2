            sh:sourceShape _:n2a00174336ee498baa2825b97de440e4b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasPropulsionLoadCase" ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n2a00174336ee498baa2825b97de440e4b2 ] .

_:n2a00174336ee498baa2825b97de440e4b1 sh:class nltl:iceMillingSequenceCase ;
    sh:minCount 1 ;
    sh:node gs:TRF091IceMillingSequenceCaseShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasIceMillingSequenceCase .

_:n2a00174336ee498baa2825b97de440e4b2 sh:class nltl:loadCase ;
    sh:minCount 1 ;
    sh:node gs:TRF091PropulsionLoadCaseShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasPropulsionLoadCase .

_:n2a00174336ee498baa2825b97de440e4b4 sh:class nltl:loadCasePurposeValue ;
    sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
    sh:minCount 1 ;
