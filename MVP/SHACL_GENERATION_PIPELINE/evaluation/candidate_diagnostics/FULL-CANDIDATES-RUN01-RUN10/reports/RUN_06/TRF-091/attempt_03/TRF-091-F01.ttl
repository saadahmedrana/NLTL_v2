            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n2a00174336ee498baa2825b97de440e4b1 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/milling> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/ship> ;
            sh:resultMessage "The ice-milling sequence case shall be the load case used for the propulsion-line strength evaluation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ice-milling sequence case shall be the load case used for the propulsion-line strength evaluation." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasIceMillingSequenceCase ?iceCase .
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasPropulsionLoadCase ?iceCase
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF091ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ;
                    sh:resultMessage "Node ex:loadCase must not conform to shape [ sh:property [ sh:hasValue nltl:stallingAnalysisPurposeValue ; sh:path nltl:loadCasePurpose ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NotConstraintComponent ;
                    sh:sourceShape gs:TRF091PropulsionLoadCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ],
                [ a sh:ValidationResult ;
