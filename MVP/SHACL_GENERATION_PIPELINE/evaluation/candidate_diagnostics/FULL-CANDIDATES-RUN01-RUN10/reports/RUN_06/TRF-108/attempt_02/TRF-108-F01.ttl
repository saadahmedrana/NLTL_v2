@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F01/ship> ;
            sh:resultMessage "A propeller blade material property is required to establish the selected SN-curve correspondence." ;
            sh:resultPath nltl:propellerBladeMaterialProperty ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "A propeller blade material property is required to establish the selected SN-curve correspondence." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerBladeMaterialProperty ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:evidenceArtifact ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Evidence identifying correspondence between the selected SN-curve and the blade material properties is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ], [ sh:class nltl:stressLifeCurveTypeValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When the SN-curve is known, exactly one selected curve type must be recorded.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelection ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:stressLifeCurveKnown ] ] , [ sh:property [ sh:class nltl:evidenceArtifact ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Evidence identifying the applied fallback SN-curve selection is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:stressLifeCurveKnown ], [ sh:hasValue nltl:twoSlopeStressLifeCurve ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When the SN-curve is unknown, the two-slope SN-curve must be selected.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelection ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF108_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F01/ship> ] .

