@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F02/component> ;
                            sh:resultMessage "Each assessed component must provide the externally calculated occasional-force stress." ;
                            sh:resultPath nltl:occasionalForceComponentStress ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each assessed component must provide the externally calculated occasional-force stress." ;
                                    sh:minCount 1 ;
                                    sh:node gen:TRF123StressQuantityShape ;
                                    sh:path nltl:occasionalForceComponentStress ] ],
                        [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:detail [ a sh:ValidationResult ;
                                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F02/componentMaterialYieldStrengthValue> ;
                                            sh:resultMessage "Node ex:componentMaterialYieldStrengthValue->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                                            sh:resultPath qudt:unit ;
                                            sh:resultSeverity sh:Violation ;
                                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                            sh:sourceShape [ sh:hasValue qudt:MegaPA ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F02/material> ;
                                    sh:resultMessage "Each assessed component must provide the yield strength of its material." ;
                                    sh:resultPath nltl:componentMaterialYieldStrength ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                                    sh:sourceShape [ sh:maxCount 1 ;
                                            sh:message "Each assessed component must provide the yield strength of its material." ;
                                            sh:minCount 1 ;
                                            sh:node gen:TRF123YieldStrengthQuantityShape ;
                                            sh:path nltl:componentMaterialYieldStrength ] ;
                                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F02/componentMaterialYieldStrengthValue> ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F02/component> ;
                            sh:resultMessage "Value does not conform to Shape gen:TRF123MaterialPropertiesShape. See details for more information." ;
                            sh:resultPath nltl:hasMaterialProperties ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
                                    sh:node gen:TRF123MaterialPropertiesShape ;
                                    sh:path nltl:hasMaterialProperties ] ;
                            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F02/material> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F02/loadCase> ;
                    sh:resultMessage "Value does not conform to Shape gen:TRF123AssessedComponentShape. See details for more information." ;
                    sh:resultPath nltl:occasionalForceCaseAssessedComponent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node gen:TRF123AssessedComponentShape ;
                            sh:path nltl:occasionalForceCaseAssessedComponent ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F02/component> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F02/loadCase> ;
                    sh:resultMessage "Each applicable occasional-force load case must provide the externally calculated component yield safety factor." ;
                    sh:resultPath nltl:componentYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each applicable occasional-force load case must provide the externally calculated component yield safety factor." ;
                            sh:minCount 1 ;
                            sh:node gen:TRF123SafetyFactorQuantityShape ;
                            sh:path nltl:componentYieldSafetyFactor ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF123OccasionalForceLoadCaseShape. See details for more information." ;
            sh:resultPath nltl:hasOccasionalForceLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:TRF123OccasionalForceLoadCaseShape ;
                    sh:path nltl:hasOccasionalForceLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F02/loadCase> ] .

