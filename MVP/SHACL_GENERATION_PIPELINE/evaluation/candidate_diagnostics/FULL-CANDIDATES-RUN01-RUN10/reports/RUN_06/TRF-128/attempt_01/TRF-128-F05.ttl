@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:TRF128IaSuperReversalShape , gen:TRF128OtherIceClassShape , gen:TRF128IaSuperNoReversalShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF128ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F05/ship> ] .

