@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-001-F02/ship> ;
            sh:resultMessage "UR I2 Rev.4 applicability must be true for ships contracted for construction on or after 1 January 2021 and false for earlier ships." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "UR I2 Rev.4 applicability must be true for ships contracted for construction on or after 1 January 2021 and false for earlier ships." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?contractDate ;
                      nltl:urI2RevisionApplicability ?applicable .
                FILTER (
                    (?contractDate >= "2021-01-01"^^xsd:date && ?applicable != true) ||
                    (?contractDate < "2021-01-01"^^xsd:date && ?applicable != false)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-001> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-001-F02/ship> ] .

