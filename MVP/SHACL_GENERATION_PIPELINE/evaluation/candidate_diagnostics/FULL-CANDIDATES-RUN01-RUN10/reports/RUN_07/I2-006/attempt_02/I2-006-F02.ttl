@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F02/ship> ;
            sh:resultMessage "When astern operation in ice regions is intended, the aft section design basis must use the Bow and Bow Intermediate hull area requirements." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-006> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F02/ship> ] .

