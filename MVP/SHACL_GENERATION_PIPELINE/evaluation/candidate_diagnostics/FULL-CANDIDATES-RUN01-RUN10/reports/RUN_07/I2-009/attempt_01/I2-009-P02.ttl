@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-P02/ship> ;
            sh:resultMessage "The non-bow load-patch length must be supplied as a single metre quantity." ;
            sh:resultPath nltl:nonBowLoadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The non-bow load-patch length must be supplied as a single metre quantity." ;
                    sh:minCount 1 ;
                    sh:node nltl:GeneratedLengthQuantity_I2_009 ;
                    sh:path nltl:nonBowLoadPatchLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-P02/ship> ;
            sh:resultMessage "Average ice pressure must be supplied as a single MPa quantity." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Average ice pressure must be supplied as a single MPa quantity." ;
                    sh:minCount 1 ;
                    sh:node nltl:GeneratedPressureQuantity_I2_009 ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-P02/ship> ;
            sh:resultMessage "The load-patch aspect ratio must be recorded as 3.6 and dimensionless." ;
            sh:resultPath nltl:loadPatchAspectRatio ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The load-patch aspect ratio must be recorded as 3.6 and dimensionless." ;
                    sh:minCount 1 ;
                    sh:node nltl:GeneratedAspectRatioQuantity_I2_009 ;
                    sh:path nltl:loadPatchAspectRatio ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-P02/ship> ;
            sh:resultMessage "The ship must identify one hull-area assignment for this requirement." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:hullAreaAssignment ;
                    sh:maxCount 1 ;
                    sh:message "The ship must identify one hull-area assignment for this requirement." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasHullAreaAssignment ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-P02/ship> ;
            sh:resultMessage "The non-bow load-patch height must be supplied as a single metre quantity." ;
            sh:resultPath nltl:nonBowLoadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The non-bow load-patch height must be supplied as a single metre quantity." ;
                    sh:minCount 1 ;
                    sh:node nltl:GeneratedLengthQuantity_I2_009 ;
                    sh:path nltl:nonBowLoadPatchHeight ] ] .

