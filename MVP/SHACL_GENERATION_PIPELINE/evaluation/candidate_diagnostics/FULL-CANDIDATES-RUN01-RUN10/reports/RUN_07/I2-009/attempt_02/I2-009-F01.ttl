@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "The normal frame angle must be greater than 10 degrees." ;
            sh:resultPath nltl:normalFrameAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "The normal frame angle must be greater than 10 degrees." ;
                    sh:minCount 1 ;
                    sh:node gs:I2_009_NormalFrameAngleShape ;
                    sh:path nltl:normalFrameAngle ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "The buttock angle must be greater than 0 degrees and less than 80 degrees." ;
            sh:resultPath nltl:buttockAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "The buttock angle must be greater than 0 degrees and less than 80 degrees." ;
                    sh:minCount 1 ;
                    sh:node gs:I2_009_ButtockAngleShape ;
                    sh:path nltl:buttockAngle ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "For every other ice-strengthened area, average ice pressure, load-patch aspect ratio, load-patch height, and load-patch length must be supplied with the required units; the aspect ratio must equal 3.6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For every other ice-strengthened area, average ice pressure, load-patch aspect ratio, load-patch height, and load-patch length must be supplied with the required units; the aspect ratio must equal 3.6." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:hasHullAreaAssignment ?assignment .
  ?assignment nltl:assignedHullArea nltl:otherIceStrengthenedArea .
  FILTER (
    NOT EXISTS {
      $this nltl:averageIcePressure ?pressure .
      ?pressure qudt:numericValue ?pressureValue ;
                qudt:unit qudt:MegaPA .
      FILTER(datatype(?pressureValue) = xsd:decimal)
    }
    ||
    NOT EXISTS {
      $this nltl:loadPatchAspectRatio ?aspect .
      ?aspect qudt:numericValue ?aspectValue ;
             qudt:unit qudt:UNITLESS .
      FILTER(
        datatype(?aspectValue) = xsd:decimal &&
        ?aspectValue >= 3.6 &&
        ?aspectValue <= 3.6
      )
    }
    ||
    NOT EXISTS {
      $this nltl:nonBowLoadPatchHeight ?height .
      ?height qudt:numericValue ?heightValue ;
             qudt:unit qudt:M .
      FILTER(datatype(?heightValue) = xsd:decimal)
    }
    ||
    NOT EXISTS {
      $this nltl:nonBowLoadPatchLength ?length .
      ?length qudt:numericValue ?lengthValue ;
             qudt:unit qudt:M .
      FILTER(datatype(?lengthValue) = xsd:decimal)
    }
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:I2_009_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ] .

