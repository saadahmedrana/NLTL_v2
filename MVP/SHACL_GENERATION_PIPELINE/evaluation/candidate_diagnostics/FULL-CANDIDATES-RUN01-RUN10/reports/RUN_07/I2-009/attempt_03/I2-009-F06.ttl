@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in <urn:nltl:generated-shape:I2-009-OtherAreaShipCase> , <urn:nltl:generated-shape:I2-009-NonOtherShipCase>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-009-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/beta> ;
                    sh:resultMessage "Value is not > Literal(\"10\", datatype=xsd:integer)" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinExclusiveConstraintComponent ;
                    sh:sourceShape [ sh:minExclusive 10 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 10.0 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-009-BetaQuantity>. See details for more information." ;
            sh:resultPath nltl:normalFrameAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-BetaQuantity> ;
                    sh:path nltl:normalFrameAngle ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/beta> ] .

