@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F06/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The applicable ship shall have a bow form with vertical sides.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:verticalSidedBowForm ], [ sh:datatype xsd:string ; sh:message Literal(\"The applicable ship shall identify the design ice-force calculation method.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bowDesignForceMethod ], [ sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ; sh:message Literal(\"Applicable ships shall have Polar Class PC6 or PC7.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarClass ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The applicable ship shall have a bow form with vertical sides.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bowVerticalSideStatus ], [ sh:datatype xsd:string ; sh:message Literal(\"The applicable ship shall identify the design ice-force calculation method.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bowDesignForceMethod ], [ sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ; sh:message Literal(\"Applicable ships shall have Polar Class PC6 or PC7.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarClass ] ] , [ sh:property [ sh:datatype xsd:string ; sh:message Literal(\"The applicable ship shall identify the design ice-force calculation method.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bowDesignForceMethod ], [ sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ; sh:message Literal(\"Applicable ships shall have Polar Class PC6 or PC7.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarClass ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxInclusive Literal(\"10\", datatype=xsd:integer) ; sh:message Literal(\"The normal frame angle shall be between 0 and 10 degrees inclusive.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"0\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The normal frame angle shall use degrees.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:normalFrameAngle ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-010> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F06/ship> ] .

