@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-P04/ship> ;
            sh:resultMessage "The ship must record the design ice force calculation method." ;
            sh:resultPath nltl:bowDesignForceMethod ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must record the design ice force calculation method." ;
                    sh:minCount 1 ;
                    sh:path nltl:bowDesignForceMethod ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-P04/ship> ;
            sh:resultMessage "The ship must have Polar Class PC6 or PC7." ;
            sh:resultPath nltl:polarClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape _:n3c5e0789e7794223b7cbe7483787ff5ab1 ;
            sh:value nltl:polarClassPc5 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-P04/ship> ;
            sh:resultMessage "The ship must have Polar Class PC6 or PC7." ;
            sh:resultPath nltl:polarClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape _:n3c5e0789e7794223b7cbe7483787ff5ab1 ;
            sh:value nltl:polarClassPc5 ] .

_:N2d1c8b2adbb94ebbadab4a63212fbd30 rdf:first nltl:polarClassPc6 ;
    rdf:rest ( nltl:polarClassPc7 ) .

_:n3c5e0789e7794223b7cbe7483787ff5ab1 sh:datatype nltl:polarClassValue ;
    sh:in _:N2d1c8b2adbb94ebbadab4a63212fbd30 ;
    sh:maxCount 1 ;
    sh:message "The ship must have Polar Class PC6 or PC7." ;
    sh:minCount 1 ;
    sh:path nltl:polarClass .

