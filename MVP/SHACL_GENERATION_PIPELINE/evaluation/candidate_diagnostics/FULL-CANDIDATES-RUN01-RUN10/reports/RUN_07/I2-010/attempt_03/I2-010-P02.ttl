@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-P02/beta> ;
                    sh:resultMessage "The normal frame angle must use degrees." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:DEG ;
                            sh:maxCount 1 ;
                            sh:message "The normal frame angle must use degrees." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:decimal ; sh:maxInclusive Literal(\"10\", datatype=xsd:integer) ; sh:message Literal(\"The normal frame angle must be between 0 and 10 degrees inclusive.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"0\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:DEG ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The normal frame angle must use degrees.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:normalFrameAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxInclusive 10 ;
                                    sh:message "The normal frame angle must be between 0 and 10 degrees inclusive." ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 0 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:DEG ;
                                    sh:maxCount 1 ;
                                    sh:message "The normal frame angle must use degrees." ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:normalFrameAngle ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-P02/beta> ] .

