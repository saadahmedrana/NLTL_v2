@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "Selected maximum bow values must equal the maxima of the four reported case values." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Selected maximum bow values must equal the maxima of the four reported case values." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce/qudt:numericValue ?selectedForce ;
                      nltl:selectedMaximumBowLineLoad/qudt:numericValue ?selectedLineLoad ;
                      nltl:selectedMaximumBowPressure/qudt:numericValue ?selectedPressure .
                FILTER (
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?cf .
                        ?cf nltl:bowSubregionCalculatedForce/qudt:numericValue ?vf .
                        FILTER (?vf > ?selectedForce)
                    } ||
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?cq .
                        ?cq nltl:bowSubregionCalculatedLineLoad/qudt:numericValue ?vq .
                        FILTER (?vq > ?selectedLineLoad)
                    } ||
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?cp .
                        ?cp nltl:bowSubregionCalculatedPressure/qudt:numericValue ?vp .
                        FILTER (?vp > ?selectedPressure)
                    } ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?ef .
                        ?ef nltl:bowSubregionCalculatedForce/qudt:numericValue ?evf .
                        FILTER (?evf = ?selectedForce)
                    } ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?el .
                        ?el nltl:bowSubregionCalculatedLineLoad/qudt:numericValue ?evq .
                        FILTER (?evq = ?selectedLineLoad)
                    } ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?ep .
                        ?ep nltl:bowSubregionCalculatedPressure/qudt:numericValue ?evp .
                        FILTER (?evp = ?selectedPressure)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_014_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "Node ex:ship->nltl:bowSubregionCount does not contain a value in the set: ['Literal(\"4\", datatype=xsd:integer)']" ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nf582740bb2bf452ab43e77d0084daa0cb5 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowSubregionCount" ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf582740bb2bf452ab43e77d0084daa0cb5 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowLength" ;
            sh:resultPath nltl:bowLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:bowLength ] ] .

_:nf582740bb2bf452ab43e77d0084daa0cb5 sh:datatype xsd:integer ;
    sh:hasValue 4 ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:bowSubregionCount .

