@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "selectedMaximumBowLineLoad must equal the maximum reported bow subregion line load within tolerance and no reported line load may exceed it beyond tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "selectedMaximumBowLineLoad must equal the maximum reported bow subregion line load within tolerance and no reported line load may exceed it beyond tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    SELECT $this (MAX(?lineLoadValue) AS ?maximumLineLoad)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedLineLoad ?lineLoadQuantity .
                        ?lineLoadQuantity qudt:numericValue ?lineLoadValue .
                    }
                    GROUP BY $this
                }

                $this nltl:selectedMaximumBowLineLoad ?selectedQuantity .
                ?selectedQuantity qudt:numericValue ?selectedLineLoad .

                FILTER (
                    ABS(?selectedLineLoad - ?maximumLineLoad) >
                    (ABS(?maximumLineLoad) * 0.000001 + 0.000000001)
                    ||
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?exceedingCase .
                        ?exceedingCase nltl:bowSubregionCalculatedLineLoad ?exceedingQuantity .
                        ?exceedingQuantity qudt:numericValue ?reportedLineLoad .
                        FILTER (
                            ?reportedLineLoad >
                            ?selectedLineLoad +
                            (ABS(?maximumLineLoad) * 0.000001 + 0.000000001)
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_014_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "Node ex:ship->nltl:bowSubregionCount does not contain a value in the set: ['Literal(\"4\", datatype=xsd:integer)']" ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n6ca2ff7a58fa4dfc90b388e6d0628da9b5 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowSubregionCount" ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n6ca2ff7a58fa4dfc90b388e6d0628da9b5 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowLength" ;
            sh:resultPath nltl:bowLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:bowLength ] ] .

_:n6ca2ff7a58fa4dfc90b388e6d0628da9b5 sh:datatype xsd:integer ;
    sh:hasValue 4 ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:bowSubregionCount .

