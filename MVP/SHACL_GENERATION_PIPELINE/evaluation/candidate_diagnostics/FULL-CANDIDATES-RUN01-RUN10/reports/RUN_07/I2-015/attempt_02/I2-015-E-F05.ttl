@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/ship> ;
            sh:resultMessage "The ship must provide one dimensionless beta i prime value." ;
            sh:resultPath nltl:betaIPrime ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship must provide one dimensionless beta i prime value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:betaIPrime ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/ship> ;
            sh:resultMessage "The ship must provide one upper ice waterline length in metres." ;
            sh:resultPath nltl:upperIceWaterlineLengthLUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship must provide one upper ice waterline length in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:upperIceWaterlineLengthLUI ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/lui> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/factorLookup> ;
                            sh:resultMessage "Less than 1 values on ex:factorLookup->nltl:flexuralFailureClassFactor" ;
                            sh:resultPath nltl:flexuralFailureClassFactor ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:class qudt:QuantityValue ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:flexuralFailureClassFactor ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/bowCase> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:class qudt:QuantityValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property <http://recursion.too.deep>, <http://recursion.too.deep> ] ; sh:path nltl:crushingFailureClassFactor ], [ sh:class qudt:QuantityValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property <http://recursion.too.deep>, <http://recursion.too.deep> ] ; sh:path nltl:flexuralFailureClassFactor ] ]. See details for more information." ;
                    sh:resultPath nltl:hasFailureClassFactorLookupCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:tableLookupCase ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:class qudt:QuantityValue ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ],
                                                        [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:flexuralFailureClassFactor ],
                                        [ sh:class qudt:QuantityValue ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ],
                                                        [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:crushingFailureClassFactor ] ] ;
                            sh:path nltl:hasFailureClassFactorLookupCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/factorLookup> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/ship> ;
            sh:resultMessage "The ship must provide a complete applicable bow subregion calculation case." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:bowSubregionCalculationCase ;
                    sh:message "The ship must provide a complete applicable bow subregion calculation case." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:class qudt:QuantityValue ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:bowSubregionMidLengthPosition ],
                                [ sh:class qudt:QuantityValue ;
                                    sh:maxCount 1 ;
                                    sh:message "The applicable bow subregion case must provide the externally calculated dimensionless bow shape coefficient." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:bowShapeCoefficient ],
                                [ sh:class qudt:QuantityValue ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:bowSubregionWaterlineAngle ],
                                [ sh:class nltl:bowFormApplicabilityValue ;
                                    sh:hasValue nltl:i231vBowFormApplicability ;
                                    sh:maxCount 1 ;
                                    sh:message "The bow subregion case must identify applicability to the bow forms defined in I2.3.1(v)." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:bowFormApplicabilityClassification ],
                                [ sh:class nltl:tableLookupCase ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:class qudt:QuantityValue ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:crushingFailureClassFactor ],
                                                [ sh:class qudt:QuantityValue ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:flexuralFailureClassFactor ] ] ;
                                    sh:path nltl:hasFailureClassFactorLookupCase ] ] ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/bowCase> ] .

