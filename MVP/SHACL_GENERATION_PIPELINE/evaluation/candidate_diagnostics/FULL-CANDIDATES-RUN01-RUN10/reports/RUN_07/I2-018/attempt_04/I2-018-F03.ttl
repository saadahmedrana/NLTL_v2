@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:iceForce" ;
            sh:resultPath nltl:iceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltlg:ForceQuantityShape ;
                    sh:path nltl:iceForce ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F03/lookup> ;
                    sh:resultMessage "Node ex:lookup->nltl:tableReference does not contain a value in the set: ['nltl:iacsUrI2Table3']" ;
                    sh:resultPath nltl:tableReference ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n9a3fddf7e27d4366abfd189974e9e7b0b29 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F03/lookup> ;
                    sh:resultMessage "Less than 1 values on ex:lookup->nltl:tableReference" ;
                    sh:resultPath nltl:tableReference ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n9a3fddf7e27d4366abfd189974e9e7b0b29 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape nltlg:LookupCaseShape. See details for more information." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node nltlg:LookupCaseShape ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F03/lookup> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F03/ship> ;
            sh:resultMessage "The peak-pressure lookup case must be the Table 3 lookup case, reference IACS UR I2 Table 3, include lookup-selection evidence, and identify an approved localized structural-member category." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The peak-pressure lookup case must be the Table 3 lookup case, reference IACS UR I2 Table 3, include lookup-selection evidence, and identify an approved localized structural-member category." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasPeakPressureFactorLookupCase ?lookupCase ;
                          nltl:hasTableLookupCase ?lookupCase .
                    ?lookupCase nltl:tableReference nltl:iacsUrI2Table3 ;
                                nltl:lookupSelectionEvidence ?evidence ;
                                nltl:localizedStructuralMemberCategory ?category .
                    ?evidence rdf:type nltl:evidenceArtifact .
                    FILTER (
                        ?category IN (
                            nltl:bottomStructureFrameCategory,
                            nltl:longitudinallyFramedPlatingCategory,
                            nltl:stringerSideLongitudinalOrWebFrameCategory,
                            nltl:transverseFrameWithLoadDistributingStringersCategory,
                            nltl:transverseFrameWithoutLoadDistributingStringersCategory,
                            nltl:transverselyFramedPlatingCategory
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlg:IcePressureShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F03/lookup> ;
                    sh:resultMessage "Less than 1 values on ex:lookup->nltl:tableReference" ;
                    sh:resultPath nltl:tableReference ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n9a3fddf7e27d4366abfd189974e9e7b0b29 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F03/lookup> ;
                    sh:resultMessage "Node ex:lookup->nltl:tableReference does not contain a value in the set: ['nltl:iacsUrI2Table3']" ;
                    sh:resultPath nltl:tableReference ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n9a3fddf7e27d4366abfd189974e9e7b0b29 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape nltlg:LookupCaseShape. See details for more information." ;
            sh:resultPath nltl:hasPeakPressureFactorLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node nltlg:LookupCaseShape ;
                    sh:path nltl:hasPeakPressureFactorLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F03/lookup> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:peakPressureFactor" ;
            sh:resultPath nltl:peakPressureFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltlg:RatioQuantityShape ;
                    sh:path nltl:peakPressureFactor ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:averageIcePressure" ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltlg:PressureQuantityShape ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchHeight" ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltlg:LengthQuantityShape ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchLength" ;
            sh:resultPath nltl:loadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltlg:LengthQuantityShape ;
                    sh:path nltl:loadPatchLength ] ] .

_:n9a3fddf7e27d4366abfd189974e9e7b0b29 sh:hasValue nltl:iacsUrI2Table3 ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:tableReference .

