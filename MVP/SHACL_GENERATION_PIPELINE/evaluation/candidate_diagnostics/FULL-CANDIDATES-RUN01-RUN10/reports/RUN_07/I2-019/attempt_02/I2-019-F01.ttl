@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F01/member> ;
                    sh:resultMessage "selectedHullAreaFactor must equal the maximum hullAreaFactor over all spanned hull areas within a relative tolerance of 1e-6 plus an absolute fallback of 1e-6." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "selectedHullAreaFactor must equal the maximum hullAreaFactor over all spanned hull areas within a relative tolerance of 1e-6 plus an absolute fallback of 1e-6." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:selectedHullAreaFactor ?selectedNode .
                ?selectedNode qudt:numericValue ?selectedValue .

                {
                    SELECT $this (MAX(?factorValue) AS ?expectedValue)
                    WHERE {
                        $this nltl:hasSpannedHullArea ?areaValue .
                        ?areaValue nltl:hullAreaFactor ?factorNode .
                        ?factorNode qudt:numericValue ?factorValue .
                    }
                    GROUP BY $this
                }

                FILTER (
                    ABS(?selectedValue - ?expectedValue) >
                    (0.000001 * ABS(?expectedValue) + 0.000001)
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-019-StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-019-StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-019-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F01/member> ] .

