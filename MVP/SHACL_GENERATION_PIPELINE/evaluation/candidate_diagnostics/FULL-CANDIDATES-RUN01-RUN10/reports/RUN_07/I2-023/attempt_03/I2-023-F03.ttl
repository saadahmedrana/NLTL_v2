@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship must provide yield strength in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide yield strength in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:yieldStrength ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/plating> ;
                    sh:resultMessage "Applicable plating must provide the externally computed required net plate thickness in millimetres." ;
                    sh:resultPath nltl:iceLoadRequiredNetPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Applicable plating must provide the externally computed required net plate thickness in millimetres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:iceLoadRequiredNetPlateThickness ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship must provide the plating and structural-member relationship required for the external calculation." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the plating and structural-member relationship required for the external calculation." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:plating ;
                            sh:property [ sh:message "Applicable plating must provide framing angle omega no greater than 20 degrees." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:maxInclusive 20 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:framingAngleOmega ],
                                [ sh:message "Applicable plating must identify its supporting structural member." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:structuralMember ;
                                            sh:property [ sh:message "The supporting structural member must provide the selected hull area factor." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:selectedHullAreaFactor ],
                                                [ sh:message "The supporting structural member must provide frame spacing in metres." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:frameSpacing ] ] ;
                                    sh:path nltl:platingSupportedByStructuralMember ],
                                [ sh:message "Applicable plating must provide the externally computed required net plate thickness in millimetres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:iceLoadRequiredNetPlateThickness ] ] ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship must provide the peak pressure factor." ;
            sh:resultPath nltl:peakPressureFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the peak pressure factor." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:peakPressureFactor ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship must provide load patch height in metres." ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide load patch height in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship must provide average ice pressure in MPa." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide average ice pressure in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/ship> ;
            sh:resultMessage "The ship must provide frame span in metres." ;
            sh:resultPath nltl:frameSpan ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide frame span in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:frameSpan ] ] .

