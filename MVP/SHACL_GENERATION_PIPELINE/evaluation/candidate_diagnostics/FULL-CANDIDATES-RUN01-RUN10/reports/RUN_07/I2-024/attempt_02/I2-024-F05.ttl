@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/case> ;
            sh:resultMessage "The interpolation case shall link an upper interpolation point." ;
            sh:resultPath nltl:interpolationUpperEndpoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4ffd6d9a89d545c1a6055e069b4d1daeb8 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/lowerEndpoint> ;
            sh:resultMessage "The calculation case shall contain the transverse framing net plate thickness." ;
            sh:resultPath nltl:transverseFramingNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4ffd6d9a89d545c1a6055e069b4d1daeb4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/ship> ;
            sh:resultMessage "Each ship shall provide a calculation case with the declared framing-thickness inputs." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "Each ship shall provide a calculation case with the declared framing-thickness inputs." ;
                    sh:minCount 1 ;
                    sh:node gs:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/case> ;
                    sh:resultMessage "The interpolation case shall link an upper interpolation point." ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n4ffd6d9a89d545c1a6055e069b4d1daeb8 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/ship> ;
            sh:resultMessage "Each ship shall provide an oblique plating interpolation case." ;
            sh:resultPath nltl:hasObliquePlatingInterpolationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:obliquePlatingInterpolationCase ;
                    sh:message "Each ship shall provide an oblique plating interpolation case." ;
                    sh:minCount 1 ;
                    sh:node gs:ObliquePlatingInterpolationCaseShape ;
                    sh:path nltl:hasObliquePlatingInterpolationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/upperEndpoint> ;
            sh:resultMessage "The calculation case shall contain the longitudinal framing net plate thickness." ;
            sh:resultPath nltl:longitudinalFramingNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4ffd6d9a89d545c1a6055e069b4d1daeb3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/upperEndpoint> ;
            sh:resultMessage "The calculation case shall contain the transverse framing net plate thickness." ;
            sh:resultPath nltl:transverseFramingNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4ffd6d9a89d545c1a6055e069b4d1daeb4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/lowerEndpoint> ;
            sh:resultMessage "The calculation case shall contain the longitudinal framing net plate thickness." ;
            sh:resultPath nltl:longitudinalFramingNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4ffd6d9a89d545c1a6055e069b4d1daeb3 ] .

_:n4ffd6d9a89d545c1a6055e069b4d1daeb3 sh:message "The calculation case shall contain the longitudinal framing net plate thickness." ;
    sh:minCount 1 ;
    sh:node gs:MillimetreQuantityShape ;
    sh:path nltl:longitudinalFramingNetPlateThickness .

_:n4ffd6d9a89d545c1a6055e069b4d1daeb4 sh:message "The calculation case shall contain the transverse framing net plate thickness." ;
    sh:minCount 1 ;
    sh:node gs:MillimetreQuantityShape ;
    sh:path nltl:transverseFramingNetPlateThickness .

_:n4ffd6d9a89d545c1a6055e069b4d1daeb8 sh:class nltl:interpolationPoint ;
    sh:message "The interpolation case shall link an upper interpolation point." ;
    sh:minCount 1 ;
    sh:node gs:InterpolationPointShape ;
    sh:path nltl:interpolationUpperEndpoint .

