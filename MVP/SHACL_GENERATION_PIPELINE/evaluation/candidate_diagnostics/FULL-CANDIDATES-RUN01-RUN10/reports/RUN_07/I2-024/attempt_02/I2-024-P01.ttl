@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P01/lowerEndpoint> ;
            sh:resultMessage "The calculation case shall contain the longitudinal framing net plate thickness." ;
            sh:resultPath nltl:longitudinalFramingNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4ffd6d9a89d545c1a6055e069b4d1daeb3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P01/lowerEndpoint> ;
            sh:resultMessage "The calculation case shall contain the transverse framing net plate thickness." ;
            sh:resultPath nltl:transverseFramingNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4ffd6d9a89d545c1a6055e069b4d1daeb4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P01/ship> ;
            sh:resultMessage "Each ship shall provide a calculation case with the declared framing-thickness inputs." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "Each ship shall provide a calculation case with the declared framing-thickness inputs." ;
                    sh:minCount 1 ;
                    sh:node gs:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P01/upperEndpoint> ;
            sh:resultMessage "The calculation case shall contain the transverse framing net plate thickness." ;
            sh:resultPath nltl:transverseFramingNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4ffd6d9a89d545c1a6055e069b4d1daeb4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P01/upperEndpoint> ;
            sh:resultMessage "The calculation case shall contain the longitudinal framing net plate thickness." ;
            sh:resultPath nltl:longitudinalFramingNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4ffd6d9a89d545c1a6055e069b4d1daeb3 ] .

_:n4ffd6d9a89d545c1a6055e069b4d1daeb3 sh:message "The calculation case shall contain the longitudinal framing net plate thickness." ;
    sh:minCount 1 ;
    sh:node gs:MillimetreQuantityShape ;
    sh:path nltl:longitudinalFramingNetPlateThickness .

_:n4ffd6d9a89d545c1a6055e069b4d1daeb4 sh:message "The calculation case shall contain the transverse framing net plate thickness." ;
    sh:minCount 1 ;
    sh:node gs:MillimetreQuantityShape ;
    sh:path nltl:transverseFramingNetPlateThickness .

