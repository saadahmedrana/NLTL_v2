_:n4ffd6d9a89d545c1a6055e069b4d1daeb9 sh:message "Each interpolation point shall contain its coordinate." ;
    sh:minCount 1 ;
    sh:node gs:DimensionlessQuantityShape ;
    sh:path nltl:interpolationPointCoordinate .

_:n4ffd6d9a89d545c1a6055e069b4d1daeb3 sh:message "The calculation case shall contain the longitudinal framing net plate thickness." ;
    sh:minCount 1 ;
    sh:node gs:MillimetreQuantityShape ;
