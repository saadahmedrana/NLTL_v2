_:n4ffd6d9a89d545c1a6055e069b4d1daeb10 sh:message "Each interpolation point shall contain its externally computed result." ;
    sh:minCount 1 ;
    sh:node gs:UnspecifiedUnitQuantityShape ;
    sh:path nltl:interpolationPointResult .

_:n4ffd6d9a89d545c1a6055e069b4d1daeb11 sh:datatype xsd:decimal ;
    sh:maxExclusive 70.0 ;
    sh:minCount 1 ;
    sh:minExclusive 20.0 ;
    sh:path qudt:numericValue .

_:n4ffd6d9a89d545c1a6055e069b4d1daeb5 sh:message "The oblique plating interpolation case shall contain a framing angle strictly between 20 and 70 degrees." ;
    sh:minCount 1 ;
    sh:node gs:FramingAngleShape ;
    sh:path nltl:framingAngle .

_:n4ffd6d9a89d545c1a6055e069b4d1daeb6 sh:message "The oblique plating interpolation case shall contain the externally computed interpolated net plate thickness." ;
    sh:minCount 1 ;
    sh:node gs:UnspecifiedUnitQuantityShape ;
    sh:path nltl:interpolatedNetPlateThickness .

_:n4ffd6d9a89d545c1a6055e069b4d1daeb7 sh:class nltl:interpolationPoint ;
    sh:message "The interpolation case shall link a lower interpolation point." ;
    sh:minCount 1 ;
    sh:node gs:InterpolationPointShape ;
    sh:path nltl:interpolationLowerEndpoint .

_:n4ffd6d9a89d545c1a6055e069b4d1daeb8 sh:class nltl:interpolationPoint ;
    sh:message "The interpolation case shall link an upper interpolation point." ;
