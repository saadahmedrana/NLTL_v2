@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/upper> ;
                            sh:resultMessage "Less than 1 values on ex:upper->nltl:interpolationPointResult" ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:I2-030-ContextQuantityShape> ;
                                    sh:path nltl:interpolationPointResult ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/calc> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-030-InterpolationPointShape>. See details for more information." ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:node <urn:nltl:generated-shape:I2-030-InterpolationPointShape> ;
                            sh:path nltl:interpolationUpperEndpoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/upper> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/calc> ;
                    sh:resultMessage "For an oblique framing angle between 20 and 70 degrees, both interpolation endpoints with coordinate and result values are required." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "For an oblique framing angle between 20 and 70 degrees, both interpolation endpoints with coordinate and result values are required." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    EXISTS {
                        ?sm nltl:hasLocalFrameSectionCalculationCase ?lf .
                        ?lf nltl:sectionCalculationCasePlating ?pl .
                        ?pl nltl:framingAngleOmega ?angle .
                        ?angle qudt:numericValue ?omega .
                        FILTER (
                            datatype(?omega) = xsd:decimal &&
                            ?omega > 20 &&
                            ?omega < 70
                        )
                    }
                    &&
                    (
                        NOT EXISTS {
                            $this nltl:interpolationLowerEndpoint ?lower .
                            ?lower a nltl:interpolationPoint .
                            ?lower nltl:interpolationPointCoordinate ?lowerCoord .
                            ?lower nltl:interpolationPointResult ?lowerResult .
                        }
                        ||
                        NOT EXISTS {
                            $this nltl:interpolationUpperEndpoint ?upper .
                            ?upper a nltl:interpolationPoint .
                            ?upper nltl:interpolationPointCoordinate ?upperCoord .
                            ?upper nltl:interpolationPointResult ?upperResult .
                        }
                    )
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-030-CalculationCaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/calc> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-030-CalculationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-030-CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/calc> ] .

