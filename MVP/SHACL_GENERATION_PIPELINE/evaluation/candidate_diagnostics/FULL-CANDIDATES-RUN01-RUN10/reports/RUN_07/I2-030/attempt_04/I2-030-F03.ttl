@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/member> ;
            sh:resultMessage "Less than 1 values on ex:member->nltl:webHeight" ;
            sh:resultPath nltl:webHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:MillimetreQuantityShape ;
                    sh:path nltl:webHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/calc> ;
            sh:resultMessage "When the local-frame area exceeds 1000 times the attached shell thickness and frame spacing, the calculation case shall provide the net effective plastic section modulus." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the local-frame area exceeds 1000 times the attached shell thickness and frame spacing, the calculation case shall provide the net effective plastic section modulus." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?localCase nltl:sectionCalculationCaseStructuralMember ?member .
                ?member nltl:netLocalFrameFlangeArea ?areaNode ;
                        nltl:netAttachedShellPlateThickness ?thicknessNode ;
                        nltl:frameSpacing ?spacingNode .
                ?areaNode qudt:numericValue ?area .
                ?thicknessNode qudt:numericValue ?thickness .
                ?spacingNode qudt:numericValue ?spacing .
                FILTER (
                    100 * ?area > 1000 * ?thickness * ?spacing
                )
                FILTER NOT EXISTS {
                    $this nltl:netEffectivePlasticSectionModulus ?zNode .
                    ?zNode qudt:numericValue ?zValue .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:CalculationCaseShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/calc> ] .

