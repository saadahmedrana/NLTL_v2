@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
                    sh:resultMessage "The combined shear and bending demand must not exceed the member plastic strength, and the plastic strength must equal the midspan plastic collapse load." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "The combined shear and bending demand must not exceed the member plastic strength, and the plastic strength must equal the midspan plastic collapse load." ;
                            sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:plasticStrength ?strength ;
          nltl:midspanPlasticCollapseLoad ?midspan ;
          nltl:hasStructuralMemberLoadCase ?loadCase .
    ?strength qudt:numericValue ?strengthValue .
    ?midspan qudt:numericValue ?midspanValue .
    ?loadCase nltl:combinedShearAndBendingDemand ?demand .
    ?demand qudt:numericValue ?demandValue .
    FILTER (
        xsd:decimal(?demandValue) > xsd:decimal(?strengthValue)
        || xsd:decimal(?strengthValue) != xsd:decimal(?midspanValue)
    )
}
""" ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape nltl:GeneratedShape_I2_031_StructuralMember ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape nltl:GeneratedShape_I2_031_StructuralMember. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltl:GeneratedShape_I2_031_StructuralMember ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "The plastic collapse mechanism defining the plastic strength must be recorded." ;
            sh:resultPath nltl:plasticCollapseMechanism ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The plastic collapse mechanism defining the plastic strength must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:plasticCollapseMechanism ] ] .

