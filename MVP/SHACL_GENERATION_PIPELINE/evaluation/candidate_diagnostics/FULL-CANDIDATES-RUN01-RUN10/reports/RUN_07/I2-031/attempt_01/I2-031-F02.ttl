@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/ship> ;
            sh:resultMessage "The plastic collapse mechanism defining the plastic strength must be recorded." ;
            sh:resultPath nltl:plasticCollapseMechanism ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The plastic collapse mechanism defining the plastic strength must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:plasticCollapseMechanism ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/loadcase> ;
                            sh:resultMessage "For bottom structure, the patch-load dimension b must be parallel with the frame direction." ;
                            sh:resultPath nltl:loadPatchOrientation ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:class nltl:loadPatchOrientationValue ;
                                    sh:hasValue nltl:loadPatchHeightParallelToFrame ;
                                    sh:maxCount 1 ;
                                    sh:message "For bottom structure, the patch-load dimension b must be parallel with the frame direction." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:loadPatchOrientation ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/member> ;
                    sh:resultMessage "Value does not conform to Shape nltl:GeneratedShape_I2_031_LoadCase. See details for more information." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node nltl:GeneratedShape_I2_031_LoadCase ;
                            sh:path nltl:hasStructuralMemberLoadCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/loadcase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape nltl:GeneratedShape_I2_031_StructuralMember. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltl:GeneratedShape_I2_031_StructuralMember ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/member> ] .

