@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/loadcase> ;
                            sh:resultMessage "Each load case must specify the combined shear and bending demand in kN." ;
                            sh:resultPath nltl:combinedShearAndBendingDemand ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each load case must specify the combined shear and bending demand in kN." ;
                                    sh:minCount 1 ;
                                    sh:node gs:I2_031_ForceQuantityShape ;
                                    sh:path nltl:combinedShearAndBendingDemand ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/member> ;
                    sh:resultMessage "Each structural member must have a load case." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCase ;
                            sh:message "Each structural member must have a load case." ;
                            sh:minCount 1 ;
                            sh:node gs:I2_031_LoadCaseShape ;
                            sh:path nltl:hasStructuralMemberLoadCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/loadcase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/ship> ;
            sh:resultMessage "The ship must identify the structural members covered by the requirement." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:message "The ship must identify the structural members covered by the requirement." ;
                    sh:minCount 1 ;
                    sh:node gs:I2_031_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/ship> ;
            sh:resultMessage "The ship must specify the plastic collapse mechanism." ;
            sh:resultPath nltl:plasticCollapseMechanism ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship must specify the plastic collapse mechanism." ;
                    sh:minCount 1 ;
                    sh:path nltl:plasticCollapseMechanism ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/ship> ;
            sh:resultMessage "The ship must specify the patch load in kN." ;
            sh:resultPath nltl:patchLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must specify the patch load in kN." ;
                    sh:minCount 1 ;
                    sh:node gs:I2_031_ForceQuantityShape ;
                    sh:path nltl:patchLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/ship> ;
            sh:resultMessage "The ship must specify a frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship must specify a frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ] .

