@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "The combined shear-and-bending demand must not exceed the applicable member plastic strength or midspan plastic collapse load." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The combined shear-and-bending demand must not exceed the applicable member plastic strength or midspan plastic collapse load." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:longitudinalFrameOrientation true ;
                        nltl:structuralLocation nltl:sideStructureLocation ;
                        nltl:plasticStrength ?plasticStrength ;
                        nltl:midspanPlasticCollapseLoad ?collapseLoad ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .

                ?plasticStrength qudt:numericValue ?plasticValue ;
                                 qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                ?collapseLoad qudt:numericValue ?collapseValue ;
                              qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                ?demand qudt:numericValue ?demandValue ;
                        qudt:unit <http://qudt.org/vocab/unit/KiloN> .

                FILTER (
                    datatype(?plasticValue) = xsd:decimal &&
                    datatype(?collapseValue) = xsd:decimal &&
                    datatype(?demandValue) = xsd:decimal &&
                    (
                        ?demandValue > ?plasticValue ||
                        ?demandValue > ?collapseValue
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-034-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ] .

