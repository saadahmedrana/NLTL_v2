@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ;
                    sh:resultMessage "For each longitudinal structural member located in the side structure, every represented load-case demand must not exceed the member plastic strength and midspan plastic collapse load, and all required quantity values must be valid." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "For each longitudinal structural member located in the side structure, every represented load-case demand must not exceed the member plastic strength and midspan plastic collapse load, and all required quantity values must be valid." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:longitudinalFrameOrientation ?orientation ;
                      nltl:structuralLocation nltl:sideStructureLocation .

                FILTER (
                    ?orientation = true &&
                    (
                        NOT EXISTS {
                            $this nltl:plasticStrength ?plasticStrength .
                            ?plasticStrength qudt:numericValue ?plasticStrengthValue .
                            FILTER (datatype(?plasticStrengthValue) = xsd:decimal)
                        }
                        ||
                        NOT EXISTS {
                            $this nltl:midspanPlasticCollapseLoad ?collapseLoad .
                            ?collapseLoad qudt:numericValue ?collapseLoadValue .
                            ?collapseLoad qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                            FILTER (datatype(?collapseLoadValue) = xsd:decimal)
                        }
                        ||
                        EXISTS {
                            $this nltl:hasStructuralMemberLoadCase ?loadCase .
                            FILTER NOT EXISTS {
                                ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                                ?demand qudt:numericValue ?demandValue .
                                FILTER (datatype(?demandValue) = xsd:decimal)
                            }
                        }
                        ||
                        EXISTS {
                            $this nltl:hasStructuralMemberLoadCase ?loadCase ;
                                  nltl:plasticStrength ?plasticStrength .
                            ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                            ?demand qudt:numericValue ?demandValue .
                            ?plasticStrength qudt:numericValue ?plasticStrengthValue .
                            FILTER (
                                datatype(?demandValue) = xsd:decimal &&
                                datatype(?plasticStrengthValue) = xsd:decimal &&
                                ?demandValue > ?plasticStrengthValue
                            )
                        }
                        ||
                        EXISTS {
                            $this nltl:hasStructuralMemberLoadCase ?loadCase ;
                                  nltl:midspanPlasticCollapseLoad ?collapseLoad .
                            ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                            ?demand qudt:numericValue ?demandValue .
                            ?collapseLoad qudt:numericValue ?collapseLoadValue .
                            FILTER (
                                datatype(?demandValue) = xsd:decimal &&
                                datatype(?collapseLoadValue) = xsd:decimal &&
                                ?demandValue > ?collapseLoadValue
                            )
                        }
                    )
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-034-StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:node <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "The ship must provide one frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship must provide one frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ] .

