@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "The ship must specify one frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship must specify one frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "For each applicable represented load case, the combined shear-and-bending demand must not exceed either member plastic strength or midspan plastic-collapse load." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For each applicable represented load case, the combined shear-and-bending demand must not exceed either member plastic strength or midspan plastic-collapse load." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:longitudinalFrameOrientation true ;
                        nltl:structuralLocation nltl:sideStructureLocation ;
                        nltl:hasStructuralMemberLoadCase ?case ;
                        nltl:plasticStrength ?strength ;
                        nltl:midspanPlasticCollapseLoad ?collapse .
                ?case nltl:combinedShearAndBendingDemand ?demand .
                ?demand qudt:numericValue ?demandValue .
                ?strength qudt:numericValue ?strengthValue .
                ?collapse qudt:numericValue ?collapseValue .

                FILTER (
                    ?demandValue > ?strengthValue
                    || ?demandValue > ?collapseValue
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_034_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ] .

