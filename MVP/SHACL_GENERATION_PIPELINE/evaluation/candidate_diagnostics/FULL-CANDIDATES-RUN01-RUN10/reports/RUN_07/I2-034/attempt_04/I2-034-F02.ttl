@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/ship> ;
            sh:resultMessage "The ship must specify one frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship must specify one frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/ship> ;
            sh:resultMessage "Each applicable represented load case must provide a decimal combined shear-and-bending demand, and its member must provide decimal KiloN plastic strength and midspan plastic-collapse load." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each applicable represented load case must provide a decimal combined shear-and-bending demand, and its member must provide decimal KiloN plastic strength and midspan plastic-collapse load." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:longitudinalFrameOrientation true ;
                        nltl:structuralLocation nltl:sideStructureLocation ;
                        nltl:hasStructuralMemberLoadCase ?case .

                FILTER (
                    NOT EXISTS {
                        ?case nltl:combinedShearAndBendingDemand ?demand .
                    }
                    ||
                    NOT EXISTS {
                        ?member nltl:plasticStrength ?strength .
                    }
                    ||
                    NOT EXISTS {
                        ?member nltl:midspanPlasticCollapseLoad ?collapse .
                    }
                    ||
                    EXISTS {
                        ?case nltl:combinedShearAndBendingDemand ?demand .
                        ?demand qudt:numericValue ?demandValue .
                        FILTER (datatype(?demandValue) != xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?member nltl:plasticStrength ?strength .
                        ?strength qudt:numericValue ?strengthValue ;
                                 qudt:unit ?strengthUnit .
                        FILTER (
                            datatype(?strengthValue) != xsd:decimal
                            || ?strengthUnit != <http://qudt.org/vocab/unit/KiloN>
                        )
                    }
                    ||
                    EXISTS {
                        ?member nltl:midspanPlasticCollapseLoad ?collapse .
                        ?collapse qudt:numericValue ?collapseValue ;
                                  qudt:unit ?collapseUnit .
                        FILTER (
                            datatype(?collapseValue) != xsd:decimal
                            || ?collapseUnit != <http://qudt.org/vocab/unit/KiloN>
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_034_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/ship> ] .

