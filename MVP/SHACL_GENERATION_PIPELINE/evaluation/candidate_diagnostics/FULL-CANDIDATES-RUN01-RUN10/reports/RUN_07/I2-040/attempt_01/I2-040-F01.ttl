@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:yieldStrength" ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:yieldStrength ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F01/member> ;
                    sh:resultMessage "Less than 1 values on ex:member->nltl:structuralSectionType" ;
                    sh:resultPath nltl:structuralSectionType ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:structuralSectionTypeValue ;
                            sh:in ( nltl:flatBarStructuralSection nltl:bulbSection nltl:teeSection nltl:angleSection ) ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:structuralSectionType ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-040-StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-040-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F01/member> ] .

