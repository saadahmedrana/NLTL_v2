@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F04/ship> ;
            sh:resultMessage "Each linked plating structure must declare whether it is ice strengthened." ;
            sh:resultPath ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Each linked plating structure must declare whether it is ice strengthened." ;
                    sh:minCount 1 ;
                    sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ] ] .

