@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F009/plating> ;
            sh:resultMessage "Each steel grade requirement case must identify exactly one plating." ;
            sh:resultPath nltl:steelGradeRequirementCasePlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:plating ;
                    sh:maxCount 1 ;
                    sh:message "Each steel grade requirement case must identify exactly one plating." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelGradeRequirementCasePlating ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F009/plating> ;
            sh:resultMessage "Each case must state exactly one actual hull structural steel grade." ;
            sh:resultPath nltl:actualHullStructuralSteelGrade ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n416900dc84454e31aabd7aa8cd684c3fb22 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F009/case> ;
            sh:resultMessage "Each case must state exactly one actual hull structural steel grade." ;
            sh:resultPath nltl:actualHullStructuralSteelGrade ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n416900dc84454e31aabd7aa8cd684c3fb22 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F009/plating> ;
            sh:resultMessage "Less than 1 values on ex:plating->nltl:steelMaterialClass" ;
            sh:resultPath nltl:steelMaterialClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelMaterialClassValue ;
                    sh:in ( nltl:steelMaterialClassOne nltl:steelMaterialClassTwo nltl:steelMaterialClassThree ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelMaterialClass ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F009/plating> ;
            sh:resultMessage "Each steel grade requirement case must reference IACS UR I2 Table 8." ;
            sh:resultPath nltl:tableReference ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n416900dc84454e31aabd7aa8cd684c3fb11 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F009/case> ;
            sh:resultMessage "As-built plate thickness must be one decimal quantity in millimetres." ;
            sh:resultPath nltl:asBuiltPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "As-built plate thickness must be one decimal quantity in millimetres." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:asBuiltPlateThickness ;
                    sh:property [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:numericValue ],
                        [ sh:hasValue unit:MilliM ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F009/plating> ;
            sh:resultMessage "Less than 1 values on ex:plating->nltl:steelStrengthCategory" ;
            sh:resultPath nltl:steelStrengthCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelStrengthCategoryValue ;
                    sh:in ( nltl:normalStrengthSteelCategory nltl:highTensileSteelCategory ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelStrengthCategory ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F009/plating> ;
            sh:resultMessage "Each steel grade requirement case must reference IACS UR I2 Table 8." ;
            sh:resultPath nltl:tableReference ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n416900dc84454e31aabd7aa8cd684c3fb11 ] .

_:N1ea16d735d354edc8f52c185b7c5afc5 rdf:first nltl:steelGradeFh ;
    rdf:rest ( nltl:normalStrengthHullStructuralSteel nltl:highStrengthHullStructuralSteel ) .

_:N68f4c3921cc34bea98c930ef6500b1da rdf:first nltl:steelGradeDh ;
    rdf:rest ( nltl:steelGradeE nltl:steelGradeEh nltl:steelGradeFh nltl:normalStrengthHullStructuralSteel nltl:highStrengthHullStructuralSteel ) .

_:N924b48b9536042b99eedfa3f5b955be1 rdf:first nltl:steelGradeB ;
    rdf:rest ( nltl:steelGradeD nltl:steelGradeDh nltl:steelGradeE nltl:steelGradeEh nltl:steelGradeFh nltl:normalStrengthHullStructuralSteel nltl:highStrengthHullStructuralSteel ) .

_:Nd48f567b196541db855d5599d22f32fc rdf:first nltl:steelGradeAh ;
    rdf:rest _:N924b48b9536042b99eedfa3f5b955be1 .

_:n416900dc84454e31aabd7aa8cd684c3fb11 sh:class nltl:tableReferenceValue ;
    sh:hasValue nltl:iacsUrI2Table8 ;
    sh:maxCount 1 ;
    sh:message "Each steel grade requirement case must reference IACS UR I2 Table 8." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:tableReference .

_:n416900dc84454e31aabd7aa8cd684c3fb22 sh:class nltl:steelGradeValue ;
    sh:in _:Nd48f567b196541db855d5599d22f32fc ;
    sh:maxCount 1 ;
    sh:message "Each case must state exactly one actual hull structural steel grade." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:actualHullStructuralSteelGrade .

