@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-PH02/plating> ;
            sh:resultMessage "Each steel grade requirement case must identify exactly one plating." ;
            sh:resultPath nltl:steelGradeRequirementCasePlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:plating ;
                    sh:maxCount 1 ;
                    sh:message "Each steel grade requirement case must identify exactly one plating." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelGradeRequirementCasePlating ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-PH02/plating> ;
            sh:resultMessage "Each steel grade requirement case must reference IACS UR I2 Table 8." ;
            sh:resultPath nltl:tableReference ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n416900dc84454e31aabd7aa8cd684c3fb11 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-PH02/case> ;
            sh:resultMessage "As-built plate thickness must be one decimal quantity in millimetres." ;
            sh:resultPath nltl:asBuiltPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "As-built plate thickness must be one decimal quantity in millimetres." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:asBuiltPlateThickness ;
                    sh:property [ sh:hasValue unit:MilliM ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ],
                        [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:numericValue ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-PH02/plating> ;
            sh:resultMessage "Each case must state exactly one actual hull structural steel grade." ;
            sh:resultPath nltl:actualHullStructuralSteelGrade ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeValue ;
                    sh:in ( nltl:steelGradeAh nltl:steelGradeB nltl:steelGradeD nltl:steelGradeDh nltl:steelGradeE nltl:steelGradeEh nltl:steelGradeFh nltl:normalStrengthHullStructuralSteel nltl:highStrengthHullStructuralSteel ) ;
                    sh:maxCount 1 ;
                    sh:message "Each case must state exactly one actual hull structural steel grade." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:actualHullStructuralSteelGrade ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-PH02/plating> ;
            sh:resultMessage "Less than 1 values on ex:plating->nltl:steelStrengthCategory" ;
            sh:resultPath nltl:steelStrengthCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelStrengthCategoryValue ;
                    sh:in ( nltl:normalStrengthSteelCategory nltl:highTensileSteelCategory ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelStrengthCategory ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-PH02/plating> ;
            sh:resultMessage "Less than 1 values on ex:plating->nltl:steelMaterialClass" ;
            sh:resultPath nltl:steelMaterialClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelMaterialClassValue ;
                    sh:in ( nltl:steelMaterialClassOne nltl:steelMaterialClassTwo nltl:steelMaterialClassThree ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelMaterialClass ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-PH02/plating> ;
            sh:resultMessage "Each steel grade requirement case must reference IACS UR I2 Table 8." ;
            sh:resultPath nltl:tableReference ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n416900dc84454e31aabd7aa8cd684c3fb11 ] .

_:n416900dc84454e31aabd7aa8cd684c3fb11 sh:class nltl:tableReferenceValue ;
    sh:hasValue nltl:iacsUrI2Table8 ;
    sh:maxCount 1 ;
    sh:message "Each steel grade requirement case must reference IACS UR I2 Table 8." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:tableReference .

