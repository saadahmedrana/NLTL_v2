@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T089/plating> ;
            sh:resultMessage "Each steel-grade requirement case must provide exactly one supported steel material class." ;
            sh:resultPath nltl:steelMaterialClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelMaterialClassValue ;
                    sh:in ( nltl:steelMaterialClassOne nltl:steelMaterialClassTwo nltl:steelMaterialClassThree ) ;
                    sh:maxCount 1 ;
                    sh:message "Each steel-grade requirement case must provide exactly one supported steel material class." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelMaterialClass ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T089/plating> ;
            sh:resultMessage "Each steel-grade requirement case must identify exactly one plating." ;
            sh:resultPath nltl:steelGradeRequirementCasePlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:plating ;
                    sh:maxCount 1 ;
                    sh:message "Each steel-grade requirement case must identify exactly one plating." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelGradeRequirementCasePlating ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T089/case> ;
                    sh:resultMessage "Each steel-grade requirement case must provide exactly one as-built plate thickness in millimetres." ;
                    sh:resultPath nltl:asBuiltPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n200afa16817a4daca647b05c3c9025c9b14 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T089/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:i2-048-case>. See details for more information." ;
            sh:resultPath nltl:hasSteelGradeRequirementCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeRequirementCase ;
                    sh:node <urn:nltl:generated-shape:i2-048-case> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasSteelGradeRequirementCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T089/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T089/plating> ;
            sh:resultMessage "Each steel-grade requirement case must provide exactly one supported steel strength category." ;
            sh:resultPath nltl:steelStrengthCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelStrengthCategoryValue ;
                    sh:in ( nltl:normalStrengthSteelCategory nltl:highTensileSteelCategory ) ;
                    sh:maxCount 1 ;
                    sh:message "Each steel-grade requirement case must provide exactly one supported steel strength category." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelStrengthCategory ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T089/plating> ;
            sh:resultMessage "Each steel-grade requirement case must reference IACS UR I2 Table 8." ;
            sh:resultPath nltl:tableReference ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n200afa16817a4daca647b05c3c9025c9b13 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T089/plating> ;
            sh:resultMessage "Each steel-grade requirement case must provide exactly one actual hull structural steel grade." ;
            sh:resultPath nltl:actualHullStructuralSteelGrade ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeValue ;
                    sh:maxCount 1 ;
                    sh:message "Each steel-grade requirement case must provide exactly one actual hull structural steel grade." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:actualHullStructuralSteelGrade ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T089/plating> ;
            sh:resultMessage "Each steel-grade requirement case must reference IACS UR I2 Table 8." ;
            sh:resultPath nltl:tableReference ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n200afa16817a4daca647b05c3c9025c9b13 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T089/case> ;
            sh:resultMessage "Each steel-grade requirement case must provide exactly one as-built plate thickness in millimetres." ;
            sh:resultPath nltl:asBuiltPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n200afa16817a4daca647b05c3c9025c9b14 ] .

_:n200afa16817a4daca647b05c3c9025c9b13 sh:class nltl:tableReferenceValue ;
    sh:hasValue nltl:iacsUrI2Table8 ;
    sh:maxCount 1 ;
    sh:message "Each steel-grade requirement case must reference IACS UR I2 Table 8." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:tableReference .

_:n200afa16817a4daca647b05c3c9025c9b14 sh:maxCount 1 ;
    sh:message "Each steel-grade requirement case must provide exactly one as-built plate thickness in millimetres." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:i2-048-quantity> ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path nltl:asBuiltPlateThickness .

