@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode nltl:highStrengthHullStructuralSteel ;
            sh:resultMessage "Each steel grade value must have exactly one integer order rank." ;
            sh:resultPath nltl:steelGradeOrderRank ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n833d753a3b694228827cb826f2d041fdb39 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-PZERO/ship> ;
            sh:resultMessage "The ship must have exactly one supported Polar Class." ;
            sh:resultPath nltl:polarClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarClassValue ;
                    sh:in ( nltl:polarClassPc1 nltl:polarClassPc2 nltl:polarClassPc3 nltl:polarClassPc4 nltl:polarClassPc5 nltl:polarClassPc6 nltl:polarClassPc7 ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship must have exactly one supported Polar Class." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:polarClass ] ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:normalStrengthHullStructuralSteel ;
            sh:resultMessage "Each steel grade value must have exactly one integer order rank." ;
            sh:resultPath nltl:steelGradeOrderRank ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n833d753a3b694228827cb826f2d041fdb39 ] .

_:n833d753a3b694228827cb826f2d041fdb39 sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:message "Each steel grade value must have exactly one integer order rank." ;
    sh:minCount 1 ;
    sh:path nltl:steelGradeOrderRank .

