@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T083/case> ;
                    sh:resultMessage "As-built plate thickness must be one decimal quantity in millimetres." ;
                    sh:resultPath nltl:asBuiltPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class qudt:QuantityValue ;
                            sh:maxCount 1 ;
                            sh:message "As-built plate thickness must be one decimal quantity in millimetres." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:asBuiltPlateThickness ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T083/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-048-CaseShape>. See details for more information." ;
            sh:resultPath nltl:hasSteelGradeRequirementCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-048-CaseShape> ;
                    sh:path nltl:hasSteelGradeRequirementCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T083/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:highStrengthHullStructuralSteel ;
            sh:resultMessage "Each steel grade value must have exactly one integer order rank." ;
            sh:resultPath nltl:steelGradeOrderRank ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n833d753a3b694228827cb826f2d041fdb39 ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:normalStrengthHullStructuralSteel ;
            sh:resultMessage "Each steel grade value must have exactly one integer order rank." ;
            sh:resultPath nltl:steelGradeOrderRank ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n833d753a3b694228827cb826f2d041fdb39 ] .

_:n833d753a3b694228827cb826f2d041fdb39 sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:message "Each steel grade value must have exactly one integer order rank." ;
    sh:minCount 1 ;
    sh:path nltl:steelGradeOrderRank .

