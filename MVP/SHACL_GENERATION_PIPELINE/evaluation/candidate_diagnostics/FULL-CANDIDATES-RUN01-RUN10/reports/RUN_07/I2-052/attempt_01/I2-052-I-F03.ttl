@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F03/lowerPoint> ;
            sh:resultMessage "The calculation case shall identify interpolation points." ;
            sh:resultPath nltl:hasInterpolationPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf1981b8f63ab403ea66a8a7f168776ceb11 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F03/lowerPoint> ;
            sh:resultMessage "The calculation case shall identify an upper interpolation endpoint." ;
            sh:resultPath nltl:interpolationUpperEndpoint ;
