            sh:sourceShape _:nf1981b8f63ab403ea66a8a7f168776ceb11 ] .

_:N019e73d76d224835bc5b88b0a342784d sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ],
        [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:N14d7cef8d4fd4ce2a66ebf68a4d9ed9d sh:class nltl:interpolationPoint ;
    sh:node nltlg:InterpolationPointShape .

_:N309dfdf3569f4157a295804448ec3d2e sh:class nltl:interpolationPoint ;
    sh:node nltlg:InterpolationPointShape .

_:N4e2c252f6acd4094a7221d92f0daff3d sh:class nltl:interpolationPoint ;
    sh:node nltlg:InterpolationPointShape .

_:N66ce34b920d244b78aa9fbf42a414ca7 sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ],
        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:nf1981b8f63ab403ea66a8a7f168776ceb11 sh:message "The calculation case shall identify interpolation points." ;
    sh:minCount 1 ;
    sh:node _:N309dfdf3569f4157a295804448ec3d2e ;
    sh:path nltl:hasInterpolationPoint .

_:nf1981b8f63ab403ea66a8a7f168776ceb13 sh:message "The calculation case shall identify a lower interpolation endpoint." ;
    sh:minCount 1 ;
    sh:node _:N4e2c252f6acd4094a7221d92f0daff3d ;
    sh:path nltl:interpolationLowerEndpoint .

_:nf1981b8f63ab403ea66a8a7f168776ceb15 sh:message "The calculation case shall identify an upper interpolation endpoint." ;
    sh:minCount 1 ;
    sh:node _:N14d7cef8d4fd4ce2a66ebf68a4d9ed9d ;
    sh:path nltl:interpolationUpperEndpoint .

_:nf1981b8f63ab403ea66a8a7f168776ceb3 sh:maxCount 1 ;
    sh:message "The calculation case shall contain the hull-girder longitudinal position from aft in metres." ;
    sh:minCount 1 ;
    sh:node _:N019e73d76d224835bc5b88b0a342784d ;
    sh:path nltl:hullGirderLongitudinalPositionFromAft .

_:nf1981b8f63ab403ea66a8a7f168776ceb7 sh:maxCount 1 ;
    sh:message "The calculation case shall contain the externally determined interpolated longitudinal distribution factor." ;
    sh:minCount 1 ;
    sh:node _:N66ce34b920d244b78aa9fbf42a414ca7 ;
    sh:path nltl:interpolatedLongitudinalDistributionFactor .

