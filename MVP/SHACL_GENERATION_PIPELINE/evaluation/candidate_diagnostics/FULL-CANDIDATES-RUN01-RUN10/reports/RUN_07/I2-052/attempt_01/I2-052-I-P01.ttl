@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P01/ship> ;
            sh:resultMessage "The ship shall provide the externally determined interpolated value." ;
            sh:resultPath nltl:interpolatedValue ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship shall provide the externally determined interpolated value." ;
                    sh:minCount 1 ;
                    sh:path nltl:interpolatedValue ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P01/upperPoint> ;
            sh:resultMessage "The calculation case shall contain the hull-girder longitudinal position from aft in metres." ;
            sh:resultPath nltl:hullGirderLongitudinalPositionFromAft ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf1981b8f63ab403ea66a8a7f168776ceb3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P01/upperPoint> ;
            sh:resultMessage "The calculation case shall identify an upper interpolation endpoint." ;
            sh:resultPath nltl:interpolationUpperEndpoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf1981b8f63ab403ea66a8a7f168776ceb15 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P01/upperPoint> ;
            sh:resultMessage "The calculation case shall identify a lower interpolation endpoint." ;
            sh:resultPath nltl:interpolationLowerEndpoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf1981b8f63ab403ea66a8a7f168776ceb13 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P01/lowerPoint> ;
            sh:resultMessage "The calculation case shall contain the externally determined interpolated longitudinal distribution factor." ;
            sh:resultPath nltl:interpolatedLongitudinalDistributionFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf1981b8f63ab403ea66a8a7f168776ceb7 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P01/lowerPoint> ;
            sh:resultMessage "The calculation case shall contain the hull-girder longitudinal position from aft in metres." ;
            sh:resultPath nltl:hullGirderLongitudinalPositionFromAft ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf1981b8f63ab403ea66a8a7f168776ceb3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P01/lowerPoint> ;
            sh:resultMessage "The calculation case shall identify interpolation points." ;
            sh:resultPath nltl:hasInterpolationPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf1981b8f63ab403ea66a8a7f168776ceb11 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P01/upperPoint> ;
            sh:resultMessage "The calculation case shall contain the externally determined interpolated longitudinal distribution factor." ;
            sh:resultPath nltl:interpolatedLongitudinalDistributionFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf1981b8f63ab403ea66a8a7f168776ceb7 ],
        [ a sh:ValidationResult ;
