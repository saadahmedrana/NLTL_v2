_:N0783af17e78b4c97aa3b16d55eb43d3f sh:class nltl:interpolationPoint ;
    sh:node nltlg:InterpolationPointShape .

_:N29b77a6a63424a1d9c737aa1daa9d16d sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:N3a0b48202ba14cffbb31156838dbbcea sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ],
        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:Nd63a7f8b5d6c421ca80031fbfa355a4c sh:class nltl:interpolationPoint ;
    sh:node nltlg:InterpolationPointShape .

_:Nf278fac102e246098300326d941ab569 sh:class nltl:interpolationPoint ;
    sh:node nltlg:InterpolationPointShape .

_:nf1981b8f63ab403ea66a8a7f168776ceb11 sh:message "The calculation case shall identify interpolation points." ;
    sh:minCount 1 ;
    sh:node _:Nf278fac102e246098300326d941ab569 ;
    sh:path nltl:hasInterpolationPoint .

