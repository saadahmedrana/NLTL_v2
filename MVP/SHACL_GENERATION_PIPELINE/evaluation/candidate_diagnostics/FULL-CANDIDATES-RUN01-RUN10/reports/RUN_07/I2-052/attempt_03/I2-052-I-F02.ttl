@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/ship> ;
            sh:resultMessage "The ship shall provide an interpolated value for the linear-interpolation result." ;
            sh:resultPath nltl:interpolatedValue ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship shall provide an interpolated value for the linear-interpolation result." ;
                    sh:minCount 1 ;
                    sh:path nltl:interpolatedValue ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/lowerCoord> ;
                                    sh:resultMessage "Node ex:lowerCoord->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/UNITLESS>']" ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b14 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/lowerPoint> ;
                            sh:resultMessage "Each interpolation point shall provide one interpolation coordinate." ;
                            sh:resultPath nltl:interpolationCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b9 ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/lowerCoord> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/calculation> ;
                    sh:resultMessage "Each calculation case shall identify one lower interpolation endpoint." ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:maxCount 1 ;
                            sh:message "Each calculation case shall identify one lower interpolation endpoint." ;
                            sh:minCount 1 ;
                            sh:node g:InterpolationPointShape ;
                            sh:path nltl:interpolationLowerEndpoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/lowerPoint> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/calculation> ;
                    sh:resultMessage "Each calculation case shall identify one upper interpolation endpoint." ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:maxCount 1 ;
                            sh:message "Each calculation case shall identify one upper interpolation endpoint." ;
                            sh:minCount 1 ;
                            sh:node g:InterpolationPointShape ;
                            sh:path nltl:interpolationUpperEndpoint ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/upperCoord> ;
                                    sh:resultMessage "Node ex:upperCoord->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/UNITLESS>']" ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b14 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/upperPoint> ;
                            sh:resultMessage "Each interpolation point shall provide one interpolation coordinate." ;
                            sh:resultPath nltl:interpolationCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b9 ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/upperCoord> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/calculation> ;
                    sh:resultMessage "Value does not conform to Shape g:InterpolationPointShape. See details for more information." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b4 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/upperPoint> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/lowerCoord> ;
                                    sh:resultMessage "Node ex:lowerCoord->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/UNITLESS>']" ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b14 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/lowerPoint> ;
                            sh:resultMessage "Each interpolation point shall provide one interpolation coordinate." ;
                            sh:resultPath nltl:interpolationCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b9 ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/lowerCoord> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/calculation> ;
                    sh:resultMessage "Value does not conform to Shape g:InterpolationPointShape. See details for more information." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b4 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/lowerPoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape g:CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node g:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/calculation> ] .

_:ndac5ab7b6cf74ec082833f32facb3262b4 sh:node g:InterpolationPointShape ;
    sh:path nltl:hasInterpolationPoint .

_:ndac5ab7b6cf74ec082833f32facb3262b14 sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

_:ndac5ab7b6cf74ec082833f32facb3262b9 sh:maxCount 1 ;
    sh:message "Each interpolation point shall provide one interpolation coordinate." ;
    sh:minCount 1 ;
    sh:node g:UnitlessQuantityShape ;
    sh:path nltl:interpolationCoordinate .

