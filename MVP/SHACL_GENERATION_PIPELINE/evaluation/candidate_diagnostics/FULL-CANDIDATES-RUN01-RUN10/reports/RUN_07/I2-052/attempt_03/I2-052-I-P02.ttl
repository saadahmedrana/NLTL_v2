@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/calculation> ;
                    sh:resultMessage "The interpolation case shall link distinct lower and upper points, contain the input coordinate within their ordered interval, and report the linear-interpolation result within the endpoint envelope using a relative tolerance of 1e-6 with a 1e-6 absolute fallback." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "The interpolation case shall link distinct lower and upper points, contain the input coordinate within their ordered interval, and report the linear-interpolation result within the endpoint envelope using a relative tolerance of 1e-6 with a 1e-6 absolute fallback." ;
                            sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:hullGirderLongitudinalPositionFromAft ?xq .
  ?xq qudt:numericValue ?x .

  $this nltl:interpolationLowerEndpoint ?lo .
  $this nltl:interpolationUpperEndpoint ?hi .
  $this nltl:hasInterpolationPoint ?lo .
  $this nltl:hasInterpolationPoint ?hi .
  FILTER (?lo != ?hi)

  ?lo nltl:interpolationCoordinate ?lcq .
  ?lo nltl:interpolationPointValue ?lvq .
  ?hi nltl:interpolationCoordinate ?ucq .
  ?hi nltl:interpolationPointValue ?uvq .
  ?lcq qudt:numericValue ?lc .
  ?lvq qudt:numericValue ?lv .
  ?ucq qudt:numericValue ?uc .
  ?uvq qudt:numericValue ?uv .

  $this nltl:interpolatedLongitudinalDistributionFactor ?rq .
  ?rq qudt:numericValue ?r .

  BIND(
    ?lv + ((?x - ?lc) / (?uc - ?lc)) * (?uv - ?lv)
    AS ?expected
  )

  FILTER (
    ?lc >= ?uc
    || ?x < ?lc
    || ?x > ?uc
    || (
      (?lv <= ?uv && (?r < ?lv || ?r > ?uv))
      ||
      (?lv > ?uv && (?r < ?uv || ?r > ?lv))
    )
    || ABS(?r - ?expected) >
       (0.000001 * ABS(?expected) + 0.000001)
  )
}
""" ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape g:CalculationCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/calculation> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/upperCoord> ;
                                    sh:resultMessage "Node ex:upperCoord->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/UNITLESS>']" ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b14 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/upperPoint> ;
                            sh:resultMessage "Each interpolation point shall provide one interpolation coordinate." ;
                            sh:resultPath nltl:interpolationCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b9 ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/upperCoord> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/calculation> ;
                    sh:resultMessage "Each calculation case shall identify one upper interpolation endpoint." ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:maxCount 1 ;
                            sh:message "Each calculation case shall identify one upper interpolation endpoint." ;
                            sh:minCount 1 ;
                            sh:node g:InterpolationPointShape ;
                            sh:path nltl:interpolationUpperEndpoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/upperPoint> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/lowerCoord> ;
                                    sh:resultMessage "Node ex:lowerCoord->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/UNITLESS>']" ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b14 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/lowerPoint> ;
                            sh:resultMessage "Each interpolation point shall provide one interpolation coordinate." ;
                            sh:resultPath nltl:interpolationCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b9 ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/lowerCoord> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/calculation> ;
                    sh:resultMessage "Each calculation case shall identify one lower interpolation endpoint." ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:maxCount 1 ;
                            sh:message "Each calculation case shall identify one lower interpolation endpoint." ;
                            sh:minCount 1 ;
                            sh:node g:InterpolationPointShape ;
                            sh:path nltl:interpolationLowerEndpoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/lowerPoint> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/upperCoord> ;
                                    sh:resultMessage "Node ex:upperCoord->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/UNITLESS>']" ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b14 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/upperPoint> ;
                            sh:resultMessage "Each interpolation point shall provide one interpolation coordinate." ;
                            sh:resultPath nltl:interpolationCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b9 ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/upperCoord> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/calculation> ;
                    sh:resultMessage "Value does not conform to Shape g:InterpolationPointShape. See details for more information." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b4 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/upperPoint> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/lowerCoord> ;
                                    sh:resultMessage "Node ex:lowerCoord->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/UNITLESS>']" ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b14 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/lowerPoint> ;
                            sh:resultMessage "Each interpolation point shall provide one interpolation coordinate." ;
                            sh:resultPath nltl:interpolationCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b9 ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/lowerCoord> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/calculation> ;
                    sh:resultMessage "Value does not conform to Shape g:InterpolationPointShape. See details for more information." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:ndac5ab7b6cf74ec082833f32facb3262b4 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/lowerPoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape g:CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node g:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/calculation> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P02/ship> ;
            sh:resultMessage "The ship shall provide an interpolated value for the linear-interpolation result." ;
            sh:resultPath nltl:interpolatedValue ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship shall provide an interpolated value for the linear-interpolation result." ;
                    sh:minCount 1 ;
                    sh:path nltl:interpolatedValue ] ] .

_:ndac5ab7b6cf74ec082833f32facb3262b4 sh:node g:InterpolationPointShape ;
    sh:path nltl:hasInterpolationPoint .

_:ndac5ab7b6cf74ec082833f32facb3262b14 sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

_:ndac5ab7b6cf74ec082833f32facb3262b9 sh:maxCount 1 ;
    sh:message "Each interpolation point shall provide one interpolation coordinate." ;
    sh:minCount 1 ;
    sh:node g:UnitlessQuantityShape ;
    sh:path nltl:interpolationCoordinate .

