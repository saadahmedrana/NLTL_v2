@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F08/bendingCase> ;
                    sh:resultMessage "Less than 1 values on ex:bendingCase->nltl:hasInterpolationPoint" ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class nltl:interpolationPoint ] ;
                            sh:path nltl:hasInterpolationPoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F08/ship> ;
            sh:resultMessage "The ship shall provide a calculation case with interpolation points for the externally determined distribution factor." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide a calculation case with interpolation points for the externally determined distribution factor." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:interpolationPoint ] ;
                                    sh:path nltl:hasInterpolationPoint ] ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F08/bendingCase> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F08/designVerticalIceForceAtBow> ;
                    sh:resultMessage "Node ex:designVerticalIceForceAtBow->qudt:unit does not contain a value in the set: ['qudt:MegaN']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:MegaN ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F08/ship> ;
            sh:resultMessage "The design vertical ice force at bow is required as an input to the external calculation." ;
            sh:resultPath nltl:designVerticalIceForceAtBow ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The design vertical ice force at bow is required as an input to the external calculation." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_054_ForceQuantityShape ;
                    sh:path nltl:designVerticalIceForceAtBow ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F08/designVerticalIceForceAtBow> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F08/upperIceWaterlineLengthLUI> ;
                    sh:resultMessage "Node ex:upperIceWaterlineLengthLUI->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F08/ship> ;
            sh:resultMessage "The upper ice waterline length is required as an input to the external calculation." ;
            sh:resultPath nltl:upperIceWaterlineLengthLUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The upper ice waterline length is required as an input to the external calculation." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_054_LengthQuantityShape ;
                    sh:path nltl:upperIceWaterlineLengthLUI ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F08/upperIceWaterlineLengthLUI> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F08/stemAngle> ;
                    sh:resultMessage "Node ex:stemAngle->qudt:unit does not contain a value in the set: ['qudt:DEG']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:DEG ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F08/ship> ;
            sh:resultMessage "The stem angle is required as an input to the external calculation." ;
            sh:resultPath nltl:stemAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The stem angle is required as an input to the external calculation." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_054_AngleQuantityShape ;
                    sh:path nltl:stemAngle ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F08/stemAngle> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F08/ship> ;
            sh:resultMessage "The ship shall provide a hull girder bending moment calculation case." ;
            sh:resultPath nltl:hasHullGirderBendingMomentCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide a hull girder bending moment calculation case." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_054_HullGirderCaseShape ;
                    sh:path nltl:hasHullGirderBendingMomentCalculationCase ] ] .

