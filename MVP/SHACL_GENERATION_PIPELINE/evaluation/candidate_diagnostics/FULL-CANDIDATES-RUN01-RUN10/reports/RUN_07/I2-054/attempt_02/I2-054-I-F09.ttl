@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/caseDesignVerticalIceBendingMoment> ;
                            sh:resultMessage "Node ex:caseDesignVerticalIceBendingMoment->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/MegaN-M>']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/bendingCase> ;
                    sh:resultMessage "The hull-girder calculation case must provide its externally calculated design vertical ice bending moment." ;
                    sh:resultPath nltl:caseDesignVerticalIceBendingMoment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The hull-girder calculation case must provide its externally calculated design vertical ice bending moment." ;
                            sh:minCount 1 ;
                            sh:node gs:TorqueQuantityValueShape ;
                            sh:path nltl:caseDesignVerticalIceBendingMoment ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/caseDesignVerticalIceBendingMoment> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/ship> ;
            sh:resultMessage "The ship must provide a hull-girder bending-moment calculation case with externally calculated results." ;
            sh:resultPath nltl:hasHullGirderBendingMomentCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a hull-girder bending-moment calculation case with externally calculated results." ;
                    sh:minCount 1 ;
                    sh:node gs:HullGirderBendingMomentCalculationCaseShape ;
                    sh:path nltl:hasHullGirderBendingMomentCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/bendingCase> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/bendingCase> ;
                    sh:resultMessage "The calculation case must contain the interpolation points used for the C_m distribution." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The calculation case must contain the interpolation points used for the C_m distribution." ;
                            sh:minCount 1 ;
                            sh:node gs:InterpolationPointShape ;
                            sh:path nltl:hasInterpolationPoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/ship> ;
            sh:resultMessage "The ship must provide a calculation case containing the interpolation data." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a calculation case containing the interpolation data." ;
                    sh:minCount 1 ;
                    sh:node gs:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/bendingCase> ] .

