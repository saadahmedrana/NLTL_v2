@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp2> ;
                            sh:resultMessage "Each interpolation point must provide exactly one calculated result quantity." ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n93a7f1e604444ae68c1fee772290edadb13 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp2> ;
                            sh:resultMessage "Each interpolation point must provide exactly one dimensionless coordinate." ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n93a7f1e604444ae68c1fee772290edadb12 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/bendingCase> ;
                    sh:resultMessage "The calculation case must contain the interpolation points used for the C_m distribution." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n93a7f1e604444ae68c1fee772290edadb14 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp2> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp1> ;
                            sh:resultMessage "Each interpolation point must provide exactly one calculated result quantity." ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n93a7f1e604444ae68c1fee772290edadb13 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp1> ;
                            sh:resultMessage "Each interpolation point must provide exactly one dimensionless coordinate." ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n93a7f1e604444ae68c1fee772290edadb12 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/bendingCase> ;
                    sh:resultMessage "The calculation case must contain the interpolation points used for the C_m distribution." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n93a7f1e604444ae68c1fee772290edadb14 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/interp1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/ship> ;
            sh:resultMessage "The ship must provide a calculation case containing the interpolation data." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a calculation case containing the interpolation data." ;
                    sh:minCount 1 ;
                    sh:node gs:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P02/bendingCase> ] .

_:n93a7f1e604444ae68c1fee772290edadb12 sh:maxCount 1 ;
    sh:message "Each interpolation point must provide exactly one dimensionless coordinate." ;
    sh:minCount 1 ;
    sh:node gs:UnitlessQuantityValueShape ;
    sh:path nltl:interpolationPointCoordinate .

_:n93a7f1e604444ae68c1fee772290edadb13 sh:maxCount 1 ;
    sh:message "Each interpolation point must provide exactly one calculated result quantity." ;
    sh:minCount 1 ;
    sh:node gs:QuantityValueShape ;
    sh:path nltl:interpolationPointResult .

_:n93a7f1e604444ae68c1fee772290edadb14 sh:message "The calculation case must contain the interpolation points used for the C_m distribution." ;
    sh:minCount 1 ;
    sh:node gs:InterpolationPointShape ;
    sh:path nltl:hasInterpolationPoint .

