@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F07/designStress> ;
                    sh:resultMessage "Node ex:designStress->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/MegaPA>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F07/ship> ;
            sh:resultMessage "Each ship must provide one design stress in MPa." ;
            sh:resultPath nltl:designStress ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ship must provide one design stress in MPa." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_055_MPaQuantityShape ;
                    sh:path nltl:designStress ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F07/designStress> ] .

