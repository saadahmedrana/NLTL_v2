@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/member> ;
                    sh:resultMessage "Node ex:member must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:memberInWayOfCutout ] ] , [ sh:or ( [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:stiffeningNecessary ] ] [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:stiffeningNecessary ] ] ) ; sh:property [ sh:class nltl:cutout ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasCutout ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:memberInstability ], [ sh:datatype xsd:boolean ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stiffeningNecessary ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-060-StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-060-StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-060-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/ship> ;
            sh:resultMessage "A structural stiffening description is required when a linked member in way of a cutout requires stiffening." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A structural stiffening description is required when a linked member in way of a cutout requires stiffening." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:memberInWayOfCutout true ;
                        nltl:stiffeningNecessary true .
                FILTER (
                    NOT EXISTS {
                        $this nltl:structuralStiffening ?value .
                        FILTER (datatype(?value) = xsd:string)
                    }
                    ||
                    EXISTS {
                        $this nltl:structuralStiffening ?invalidValue .
                        FILTER (datatype(?invalidValue) != xsd:string)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-060-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/ship> ] .

