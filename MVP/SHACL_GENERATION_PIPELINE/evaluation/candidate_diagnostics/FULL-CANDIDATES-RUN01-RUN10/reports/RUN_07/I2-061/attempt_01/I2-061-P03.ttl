@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/structure> ;
                            sh:resultMessage "Node ex:structure must conform to one or more shapes in [ sh:class nltl:plating ] , [ sh:class nltl:structuralMember ]" ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:OrConstraintComponent ;
                            sh:sourceShape gen:I2_061_HullStructureShape ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/structure> ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/structure> ;
                            sh:resultMessage "The assessed hull structure must provide its thickness in metres." ;
                            sh:resultPath nltl:thickness ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:class qudt:QuantityValue ;
                                    sh:maxCount 1 ;
                                    sh:message "The assessed hull structure must provide its thickness in metres." ;
                                    sh:minCount 1 ;
                                    sh:node gen:I2_061_ThicknessQuantityShape ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:thickness ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/case> ;
                    sh:resultMessage "The calculation case must identify its assessed shell-plating or local-frame hull structure." ;
                    sh:resultPath nltl:calculationCaseAssessedHullStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:hullStructure ;
                            sh:maxCount 1 ;
                            sh:message "The calculation case must identify its assessed shell-plating or local-frame hull structure." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_061_HullStructureShape ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:calculationCaseAssessedHullStructure ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/structure> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/case> ;
                    sh:resultMessage "The calculation case must use the prescribed analytical procedure and not a direct calculation." ;
                    sh:resultPath nltl:calculationMethod ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue nltl:prescribedAnalyticalProcedure ;
                            sh:maxCount 1 ;
                            sh:message "The calculation case must use the prescribed analytical procedure and not a direct calculation." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:calculationMethod ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/ship> ;
            sh:resultMessage "The ship must identify a calculation case governed by the prescribed analytical procedure." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "The ship must identify a calculation case governed by the prescribed analytical procedure." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_061_CalculationCaseShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/case> ] .

