@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/structure> ;
                            sh:resultMessage "Less than 1 values on ex:structure->nltl:thickness" ;
                            sh:resultPath nltl:thickness ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:thickness ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/case> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:thickness ] ]. See details for more information." ;
                    sh:resultPath nltl:calculationCaseAssessedHullStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:hullStructure ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ],
                                                        [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ] ] ;
                                            sh:nodeKind sh:IRI ;
                                            sh:path nltl:thickness ] ] ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:calculationCaseAssessedHullStructure ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/structure> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:property [ sh:class nltl:hullStructure ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:thickness ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:calculationCaseAssessedHullStructure ], [ sh:hasValue nltl:prescribedAnalyticalProcedure ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An applicable calculation case shall use the prescribed analytical procedure rather than a direct calculation.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:calculationMethod ] ; sh:sparql [ sh:message Literal("A direct calculation method shall not be used for an applicable calculation case.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:calculationMethod
                              nltl:directCalculationMethodValue .
                    }
                ") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:node [ sh:property [ sh:class nltl:hullStructure ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:nodeKind sh:IRI ;
                                                    sh:path nltl:thickness ] ] ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:calculationCaseAssessedHullStructure ],
                                [ sh:hasValue nltl:prescribedAnalyticalProcedure ;
                                    sh:maxCount 1 ;
                                    sh:message "An applicable calculation case shall use the prescribed analytical procedure rather than a direct calculation." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:calculationMethod ] ;
                            sh:sparql [ sh:message "A direct calculation method shall not be used for an applicable calculation case." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:calculationMethod
                              nltl:directCalculationMethodValue .
                    }
                """ ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/case> ] .

