@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "The ship must provide the permanent lateral deformation in millimetres." ;
            sh:resultPath nltl:permanentLateralDeformation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the permanent lateral deformation in millimetres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:permanentLateralDeformation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "The ship must provide the permanent out-of-plane deformation in millimetres." ;
            sh:resultPath nltl:permanentOutOfPlaneDeformation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the permanent out-of-plane deformation in millimetres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:permanentOutOfPlaneDeformation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "The ship must provide the relevant structural dimension in millimetres." ;
            sh:resultPath nltl:relevantStructuralDimension ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the relevant structural dimension in millimetres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:relevantStructuralDimension ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "The ship must provide the fracture margin with a dimensionless quantity value." ;
            sh:resultPath nltl:fractureMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the fracture margin with a dimensionless quantity value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:fractureMargin ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "The ship must provide the major buckling margin with a dimensionless quantity value." ;
            sh:resultPath nltl:majorBucklingMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the major buckling margin with a dimensionless quantity value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:majorBucklingMargin ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "The ship must provide the yielding margin with a dimensionless quantity value." ;
            sh:resultPath nltl:yieldingMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the yielding margin with a dimensionless quantity value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:yieldingMargin ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/calculation> ;
                    sh:resultMessage "The nonlinear calculation case must confirm that permanent deformation is minor relative to the relevant structural dimensions." ;
                    sh:resultPath nltl:minorPermanentDeformationAssessmentSatisfied ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "The nonlinear calculation case must confirm that permanent deformation is minor relative to the relevant structural dimensions." ;
                            sh:minCount 1 ;
                            sh:path nltl:minorPermanentDeformationAssessmentSatisfied ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "The ship must provide a nonlinear calculation case with the required readiness information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a nonlinear calculation case with the required readiness information." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:class nltl:calculationMethodValue ;
                                    sh:hasValue nltl:nonlinearCalculationMethodValue ;
                                    sh:maxCount 1 ;
                                    sh:message "The nonlinear calculation case must identify the nonlinear calculation method." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:calculationMethod ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The nonlinear calculation case must confirm that permanent deformation is minor relative to the relevant structural dimensions." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:minorPermanentDeformationAssessmentSatisfied ],
                                [ sh:class nltl:evidenceArtifact ;
                                    sh:message "The nonlinear calculation case must provide acceptance evidence." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:nonlinearAnalysisAcceptanceEvidence ] ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/calculation> ] .

