@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "The nonlinear analysis record must state that plastic deformation is reliably captured." ;
            sh:resultPath nltl:plasticDeformation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The nonlinear analysis record must state that plastic deformation is reliably captured." ;
                    sh:minCount 1 ;
                    sh:path nltl:plasticDeformation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "The nonlinear analysis record must state that buckling is reliably captured." ;
            sh:resultPath nltl:bucklingResponse ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The nonlinear analysis record must state that buckling is reliably captured." ;
                    sh:minCount 1 ;
                    sh:path nltl:bucklingResponse ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "A nonlinear calculation method must be identified to establish applicability of the nonlinear-analysis readiness requirement." ;
            sh:resultPath nltl:nonlinearCalculationMethod ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "A nonlinear calculation method must be identified to establish applicability of the nonlinear-analysis readiness requirement." ;
                    sh:minCount 1 ;
                    sh:path nltl:nonlinearCalculationMethod ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "An applicable nonlinear calculation case must use the nonlinear calculation method and provide acceptance evidence, satisfied minor-deformation assessment, permanent lateral and out-of-plane deformation, and the relevant structural dimension in the prescribed units." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "An applicable nonlinear calculation case must use the nonlinear calculation method and provide acceptance evidence, satisfied minor-deformation assessment, permanent lateral and out-of-plane deformation, and the relevant structural dimension in the prescribed units." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:nonlinearCalculationMethod ?method
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasCalculationCase ?case .
                        ?case a nltl:calculationCase ;
                              nltl:calculationMethod nltl:nonlinearCalculationMethodValue
                    }
                    ||
                    EXISTS {
                        $this nltl:hasCalculationCase ?badCase .
                        ?badCase a nltl:calculationCase ;
                                 nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                        FILTER (
                            NOT EXISTS {
                                ?badCase nltl:nonlinearAnalysisAcceptanceEvidence ?evidence .
                                ?evidence a nltl:evidenceArtifact
                            }
                            ||
                            NOT EXISTS {
                                ?badCase nltl:minorPermanentDeformationAssessmentSatisfied true
                            }
                            ||
                            NOT EXISTS {
                                ?badCase nltl:permanentLateralDeformation ?lateral .
                                ?lateral qudt:numericValue ?lateralValue ;
                                         qudt:unit qudt:MilliM .
                                FILTER (datatype(?lateralValue) = xsd:decimal)
                            }
                            ||
                            NOT EXISTS {
                                ?badCase nltl:permanentOutOfPlaneDeformation ?outOfPlane .
                                ?outOfPlane qudt:numericValue ?outOfPlaneValue ;
                                            qudt:unit qudt:MilliM .
                                FILTER (datatype(?outOfPlaneValue) = xsd:decimal)
                            }
                            ||
                            NOT EXISTS {
                                ?badCase nltl:relevantStructuralDimension ?dimension .
                                ?dimension qudt:numericValue ?dimensionValue ;
                                           qudt:unit qudt:MilliM .
                                FILTER (datatype(?dimensionValue) = xsd:decimal)
                            }
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-065-ship> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:yieldingMargin" ;
            sh:resultPath nltl:yieldingMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:yieldingMargin ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:majorBucklingMargin" ;
            sh:resultPath nltl:majorBucklingMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:majorBucklingMargin ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:fractureMargin" ;
            sh:resultPath nltl:fractureMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:fractureMargin ] ] .

