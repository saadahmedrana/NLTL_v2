@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ;
            sh:resultMessage "Less than 1 values on ex:calculation->nltl:relevantStructuralDimension" ;
            sh:resultPath nltl:relevantStructuralDimension ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node nltlg:LengthQuantityShape ;
                    sh:path nltl:relevantStructuralDimension ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ;
            sh:resultMessage "Node ex:calculation->nltl:minorPermanentDeformationAssessmentSatisfied does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:minorPermanentDeformationAssessmentSatisfied ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n16e7e9b48b1840e0a17d59eeb72e2f39b15 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ;
            sh:resultMessage "Less than 1 values on ex:calculation->nltl:nonlinearAnalysisAcceptanceEvidence" ;
            sh:resultPath nltl:nonlinearAnalysisAcceptanceEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                    sh:minCount 1 ;
                    sh:path nltl:nonlinearAnalysisAcceptanceEvidence ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ;
            sh:resultMessage "Less than 1 values on ex:calculation->nltl:minorPermanentDeformationAssessmentSatisfied" ;
            sh:resultPath nltl:minorPermanentDeformationAssessmentSatisfied ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n16e7e9b48b1840e0a17d59eeb72e2f39b15 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/ship> ;
            sh:resultMessage "A nonlinear readiness record must identify a non-empty nonlinear calculation method, or a ship with readiness evidence must not omit that applicability selector." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A nonlinear readiness record must identify a non-empty nonlinear calculation method, or a ship with readiness evidence must not omit that applicability selector." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    (
                        NOT EXISTS {
                            $this nltl:nonlinearCalculationMethod ?missingMethod
                        }
                        &&
                        (
                            EXISTS {
                                $this nltl:hasCalculationCase ?existingCase
                            }
                            ||
                            EXISTS {
                                $this nltl:bucklingResponse ?existingBuckling
                            }
                            ||
                            EXISTS {
                                $this nltl:plasticDeformation ?existingPlastic
                            }
                            ||
                            EXISTS {
                                $this nltl:fractureMargin ?existingFracture
                            }
                            ||
                            EXISTS {
                                $this nltl:majorBucklingMargin ?existingMajorBuckling
                            }
                            ||
                            EXISTS {
                                $this nltl:yieldingMargin ?existingYielding
                            }
                        )
                    )
                    ||
                    EXISTS {
                        $this nltl:nonlinearCalculationMethod ?emptyMethod .
                        FILTER (
                            datatype(?emptyMethod) = xsd:string &&
                            STRLEN(STR(?emptyMethod)) = 0
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlg:ComplexReadinessShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ;
            sh:resultMessage "Less than 1 values on ex:calculation->nltl:permanentOutOfPlaneDeformation" ;
            sh:resultPath nltl:permanentOutOfPlaneDeformation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node nltlg:LengthQuantityShape ;
                    sh:path nltl:permanentOutOfPlaneDeformation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ;
            sh:resultMessage "Less than 1 values on ex:calculation->nltl:permanentLateralDeformation" ;
            sh:resultPath nltl:permanentLateralDeformation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node nltlg:LengthQuantityShape ;
                    sh:path nltl:permanentLateralDeformation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P02/calculation> ;
            sh:resultMessage "Node ex:calculation->nltl:calculationMethod does not contain a value in the set: ['nltl:nonlinearCalculationMethodValue']" ;
            sh:resultPath nltl:calculationMethod ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:nonlinearCalculationMethodValue ;
                    sh:minCount 1 ;
                    sh:path nltl:calculationMethod ] ] .

_:n16e7e9b48b1840e0a17d59eeb72e2f39b15 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:minCount 1 ;
    sh:path nltl:minorPermanentDeformationAssessmentSatisfied .

