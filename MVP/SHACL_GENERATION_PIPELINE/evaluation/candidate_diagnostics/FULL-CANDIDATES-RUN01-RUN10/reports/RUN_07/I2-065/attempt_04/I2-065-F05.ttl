@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:calculationCase ; sh:message Literal(\"An applicable nonlinear evaluation must provide a validated nonlinear calculation case.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2-065-NonlinearCalculationCaseShape> ; sh:path nltl:hasCalculationCase ], [ sh:datatype xsd:string ; sh:message Literal(\"An applicable nonlinear evaluation must identify the nonlinear calculation method.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:nonlinearCalculationMethod ], [ sh:datatype xsd:string ; sh:message Literal(\"The applicable analysis must record reliable buckling capture.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bucklingResponse ], [ sh:datatype xsd:string ; sh:message Literal(\"The applicable analysis must record reliable plastic-deformation capture.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:plasticDeformation ], [ sh:message Literal(\"An applicable nonlinear evaluation must provide a fracture margin.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2-065-UnitlessQuantityShape> ; sh:path nltl:fractureMargin ], [ sh:message Literal(\"An applicable nonlinear evaluation must provide a major buckling margin.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2-065-UnitlessQuantityShape> ; sh:path nltl:majorBucklingMargin ], [ sh:message Literal(\"An applicable nonlinear evaluation must provide a yielding margin.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2-065-UnitlessQuantityShape> ; sh:path nltl:yieldingMargin ] ] , [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:hasCalculationCase ], [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:nonlinearCalculationMethod ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-065-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F05/ship> ] .

