@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/weld3> ;
                    sh:resultMessage "Welding within an ice-strengthened area must be of the double continuous type." ;
                    sh:resultPath nltl:weldType ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n1a21317197fb4bbd953b9d01020c7bd0b3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/weld3> ;
                    sh:resultMessage "Each weld in an ice-strengthened area must explicitly indicate that it is within the ice-strengthened area." ;
                    sh:resultPath nltl:withinIceStrengthenedArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "Each weld in an ice-strengthened area must explicitly indicate that it is within the ice-strengthened area." ;
                            sh:minCount 1 ;
                            sh:path nltl:withinIceStrengthenedArea ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-066-WeldShape>. See details for more information." ;
            sh:resultPath nltl:hasWeld ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n1a21317197fb4bbd953b9d01020c7bd0b1 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/weld3> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/weld2> ;
                    sh:resultMessage "Welding within an ice-strengthened area must be of the double continuous type." ;
                    sh:resultPath nltl:weldType ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n1a21317197fb4bbd953b9d01020c7bd0b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-066-WeldShape>. See details for more information." ;
            sh:resultPath nltl:hasWeld ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n1a21317197fb4bbd953b9d01020c7bd0b1 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/weld2> ] .

_:n1a21317197fb4bbd953b9d01020c7bd0b1 sh:node <urn:nltl:generated-shape:I2-066-WeldShape> ;
    sh:path nltl:hasWeld .

_:n1a21317197fb4bbd953b9d01020c7bd0b3 sh:hasValue nltl:doubleContinuousWeld ;
    sh:maxCount 1 ;
    sh:message "Welding within an ice-strengthened area must be of the double continuous type." ;
    sh:minCount 1 ;
    sh:path nltl:weldType .

