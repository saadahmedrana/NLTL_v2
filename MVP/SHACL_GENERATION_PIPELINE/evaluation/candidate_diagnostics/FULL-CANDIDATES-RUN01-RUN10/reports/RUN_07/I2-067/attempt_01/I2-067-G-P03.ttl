            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n7bf0b8bab41442e6bcff8a9b1830ed16b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-P03/ship> ;
            sh:resultMessage "Strength continuity shall be ensured at all structural connections." ;
            sh:resultPath nltl:strengthContinuityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n7bf0b8bab41442e6bcff8a9b1830ed16b1 ] .

_:n7bf0b8bab41442e6bcff8a9b1830ed16b1 sh:datatype xsd:boolean ;
