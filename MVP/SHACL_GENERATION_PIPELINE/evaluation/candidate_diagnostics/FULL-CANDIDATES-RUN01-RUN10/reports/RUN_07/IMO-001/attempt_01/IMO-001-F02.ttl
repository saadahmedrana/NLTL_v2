@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:mediumFirstYearIceWithPossibleOldIceInclusions ; sh:path nltl:designIceCondition ], [ sh:hasValue nltl:polarShipCategoryA ; sh:message Literal(\"A ship designed for at least medium first-year ice with possible old-ice inclusions shall have Category A.\") ; sh:path nltl:shipCategory ] ] , [ sh:property [ sh:in ( nltl:iceConditionLessSevereThanCategoryAAndB nltl:iceFreeIceCondition nltl:openWaterIceCondition nltl:otherWatersIceCondition nltl:thinFirstYearIceWithPossibleOldIceInclusions ) ; sh:path nltl:designIceCondition ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO001ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-F02/ship> ] .

