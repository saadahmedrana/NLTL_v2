@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-F01/ship> ;
            sh:resultMessage "The ship shall either be category B for the applicable thin first-year ice condition, be category A, or declare a different permitted design ice condition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-002-ShipCategory> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-F01/ship> ] .

