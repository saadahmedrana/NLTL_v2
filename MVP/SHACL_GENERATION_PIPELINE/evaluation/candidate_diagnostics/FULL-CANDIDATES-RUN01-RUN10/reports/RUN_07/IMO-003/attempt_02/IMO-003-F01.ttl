@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F01/ship> ;
            sh:resultMessage "For open water or ice conditions less severe than categories A and B, shipCategory must be exactly Category C." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For open water or ice conditions less severe than categories A and B, shipCategory must be exactly Category C." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:designIceCondition ?condition .
                FILTER (
                    ?condition IN (
                        nltl:openWaterIceCondition,
                        nltl:iceConditionLessSevereThanCategoryAAndB
                    )
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:shipCategory nltl:polarShipCategoryC .
                    }
                    ||
                    EXISTS {
                        $this nltl:shipCategory ?declaredCategory .
                        FILTER (?declaredCategory != nltl:polarShipCategoryC)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-003-ShipCategoryC> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F01/ship> ] .

