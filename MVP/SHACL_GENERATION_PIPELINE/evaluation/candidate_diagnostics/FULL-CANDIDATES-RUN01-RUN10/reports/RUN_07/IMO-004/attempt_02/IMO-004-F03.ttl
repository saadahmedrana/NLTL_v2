@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:iceThickness" ;
            sh:resultPath nltl:iceThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:message "Ice thickness must use the metre unit." ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:maxCount 1 ;
                                    sh:maxInclusive 2.0 ;
                                    sh:message "Ice thickness must be between 0.3 m and 2.0 m, inclusive." ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 0.3 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:iceThickness ] ] .

