@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-005-F02/ship> ;
            sh:resultMessage "When iceCondition is 'ice free waters', totalIcePresent must be false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When iceCondition is 'ice free waters', totalIcePresent must be false." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceCondition ?condition .
                FILTER ( ?condition = "ice free waters" )
                FILTER NOT EXISTS {
                    $this nltl:totalIcePresent ?icePresent .
                    FILTER ( ?icePresent = false )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_005_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-005-F02/ship> ] .

