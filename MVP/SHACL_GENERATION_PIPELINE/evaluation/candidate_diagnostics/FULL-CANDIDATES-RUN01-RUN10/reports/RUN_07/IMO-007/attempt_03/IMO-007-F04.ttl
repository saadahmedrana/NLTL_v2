@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F04/ship> ;
            sh:resultMessage "For open water, sea ice concentration must have a qualifying unitless value below 1 and no supplied concentration may be 1 or greater; ice of land origin must be explicitly false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For open water, sea ice concentration must have a qualifying unitless value below 1 and no supplied concentration may be 1 or greater; ice of land origin must be explicitly false." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification nltl:openWaterIceCondition .
                FILTER (
                    EXISTS {
                        $this nltl:seaIceConcentration ?badConcentration .
                        ?badConcentration qudt:numericValue ?badValue .
                        FILTER (?badValue >= 1)
                    }
                    ||
                    EXISTS {
                        $this nltl:seaIceConcentration ?concentration .
                        ?concentration qudt:unit ?unit .
                        FILTER (?unit != qudt:UNITLESS)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:seaIceConcentration ?qualifyingConcentration .
                        ?qualifyingConcentration qudt:unit qudt:UNITLESS ;
                            qudt:numericValue ?qualifyingValue .
                        FILTER (?qualifyingValue < 1)
                    }
                    ||
                    EXISTS {
                        $this nltl:iceOfLandOriginPresent ?state .
                        FILTER (?state = true)
                    }
                    ||
                    EXISTS {
                        $this nltl:iceOfLandOriginPresent ?state .
                        FILTER (datatype(?state) != xsd:boolean)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceOfLandOriginPresent false
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO007OpenWaterShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F04/ship> ] .

