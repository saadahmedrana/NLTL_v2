@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F03/ship> ;
            sh:resultMessage "For a ship classified as open water, sea ice concentration must have a unitless quantity value less than 1, with no conflicting or non-unit concentration value, and ice of land origin must be explicitly false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a ship classified as open water, sea ice concentration must have a unitless quantity value less than 1, with no conflicting or non-unit concentration value, and ice of land origin must be explicitly false." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification nltl:openWaterIceCondition .
                FILTER (
                    EXISTS {
                        $this nltl:seaIceConcentration ?concentration .
                        ?concentration qudt:numericValue ?value .
                        FILTER (?value >= 1)
                    }
                    ||
                    EXISTS {
                        $this nltl:seaIceConcentration ?concentration .
                        ?concentration qudt:unit ?unit .
                        FILTER (?unit != <http://qudt.org/vocab/unit/UNITLESS>)
                    }
                    ||
                    EXISTS {
                        $this nltl:seaIceConcentration ?concentration .
                        FILTER NOT EXISTS {
                            ?concentration qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        }
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:seaIceConcentration ?concentration .
                        ?concentration qudt:unit <http://qudt.org/vocab/unit/UNITLESS> ;
                                      qudt:numericValue ?value .
                        FILTER (?value < 1)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceOfLandOriginPresent false .
                    }
                    ||
                    EXISTS {
                        $this nltl:iceOfLandOriginPresent ?present .
                        FILTER (?present != false)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_007_Static> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F03/ship> ] .

