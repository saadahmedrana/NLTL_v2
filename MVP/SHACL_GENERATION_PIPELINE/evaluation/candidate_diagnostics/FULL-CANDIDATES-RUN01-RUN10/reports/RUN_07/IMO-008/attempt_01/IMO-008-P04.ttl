@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-P04/iceThicknessValue> ;
                    sh:resultMessage "For thin first-year ice, ice thickness must be between 0.3 m and 0.7 m inclusive." ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MaxInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:maxInclusive 0.7 ;
                            sh:message "For thin first-year ice, ice thickness must be between 0.3 m and 0.7 m inclusive." ;
                            sh:minCount 1 ;
                            sh:minInclusive 0.3 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 1.0 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-P04/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"0.7\", datatype=xsd:decimal) ; sh:message Literal(\"For thin first-year ice, ice thickness must be between 0.3 m and 0.7 m inclusive.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"0.3\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Ice thickness must use the metre unit.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:iceThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:condition [ sh:hasValue nltl:thinFirstYearIce ;
                            sh:path nltl:iceTypeClassification ] ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 0.7 ;
                                    sh:message "For thin first-year ice, ice thickness must be between 0.3 m and 0.7 m inclusive." ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 0.3 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:message "Ice thickness must use the metre unit." ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:iceThickness ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-P04/iceThicknessValue> ] .

