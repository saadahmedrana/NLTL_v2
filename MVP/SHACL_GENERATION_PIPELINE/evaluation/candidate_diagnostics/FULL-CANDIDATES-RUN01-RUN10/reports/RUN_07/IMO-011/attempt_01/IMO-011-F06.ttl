@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F06/ship> ;
            sh:resultMessage "The data period must be at least 10 years, or a shorter period must have Administration-approved dataset status." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_011_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F06/ship> ] .

