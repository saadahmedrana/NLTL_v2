@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F01/ship> ;
            sh:resultMessage "Each SOLAS certificate schedule date must match the corresponding Polar Ship Certificate date category." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each SOLAS certificate schedule date must match the corresponding Polar Ship Certificate date category." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasSolasCertificateSchedule ?schedule .
                ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                ?record nltl:certificateScheduleDateType ?type ;
                        nltl:certificateScheduleDate ?date .
                FILTER (?type IN (
                    nltl:validityDateCategory,
                    nltl:surveyDateCategory,
                    nltl:endorsementDateCategory
                ))
                FILTER (
                    (?type = nltl:validityDateCategory &&
                     NOT EXISTS {
                         $this nltl:polarCertificateValidityDates ?date
                     })
                    ||
                    (?type = nltl:surveyDateCategory &&
                     NOT EXISTS {
                         $this nltl:surveyDates ?date
                     })
                    ||
                    (?type = nltl:endorsementDateCategory &&
                     NOT EXISTS {
                         $this nltl:endorsementDates ?date
                     })
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-017-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F01/ship> ] .

