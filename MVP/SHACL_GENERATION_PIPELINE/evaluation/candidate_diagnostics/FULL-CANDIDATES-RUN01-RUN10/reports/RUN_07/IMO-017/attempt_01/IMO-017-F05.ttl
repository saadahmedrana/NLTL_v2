@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/solasSchedule> ;
                    sh:resultMessage "A survey-date certificate schedule record is required." ;
                    sh:resultPath nltl:hasCertificateScheduleDateRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "A survey-date certificate schedule record is required." ;
                            sh:path nltl:hasCertificateScheduleDateRecord ;
                            sh:qualifiedMinCount 1 ;
                            sh:qualifiedValueShape [ sh:property [ sh:hasValue nltl:surveyDateCategory ;
                                            sh:path nltl:certificateScheduleDateType ] ] ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/ship> ;
            sh:resultMessage "A SOLAS certificate schedule with certificate schedule date records is required." ;
            sh:resultPath nltl:hasSolasCertificateSchedule ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A SOLAS certificate schedule with certificate schedule date records is required." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-017-SolasScheduleShape> ;
                    sh:path nltl:hasSolasCertificateSchedule ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F05/solasSchedule> ] .

