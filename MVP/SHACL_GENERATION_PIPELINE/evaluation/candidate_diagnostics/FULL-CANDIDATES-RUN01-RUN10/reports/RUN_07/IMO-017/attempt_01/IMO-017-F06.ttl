@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F06/ship> ;
            sh:resultMessage "A Polar Ship Certificate record is required." ;
            sh:resultPath nltl:hasPolarShipCertificate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A Polar Ship Certificate record is required." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-017-PolarShipCertificateShape> ;
                    sh:path nltl:hasPolarShipCertificate ] ] .

