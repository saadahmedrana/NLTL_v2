@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-028-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship's ice-strengthening status must be recorded.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipIceStrengthened ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The PWOM must include applicable emergency-provider contact procedures.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:emergencyProviderContactProcedurePresent ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"An ice-strengthened ship's PWOM must include prolonged-ice-entrapment life-support and ship-integrity procedures.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:prolongedEntrapmentProcedurePresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The PWOM must include applicable emergency-provider contact procedures.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:emergencyProviderContactProcedurePresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship's ice-strengthening status must be recorded.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipIceStrengthened ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-028> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-028-F02/ship> ] .

