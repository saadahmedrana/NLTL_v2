@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F05/ship> ;
            sh:resultMessage "Each ship must state whether ice operation is applicable." ;
            sh:resultPath nltl:iceOperationApplicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Each ship must state whether ice operation is applicable." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceOperationApplicable ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F05/ship> ;
            sh:resultMessage "When ice operation is applicable, the PWOM must specify the applicable operating-mode limitations and any applicable escort or icebreaker-assistance requirements." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-030> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F05/ship> ] .

