@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F03/ship> ;
            sh:resultMessage "For applicable icing conditions, discontinuous projected area must equal continuous projected area times 1.05 and discontinuous static moment must equal continuous static moment times 1.10, within a relative tolerance of 1e-6 with an absolute fallback of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For applicable icing conditions, discontinuous projected area must equal continuous projected area times 1.05 and discontinuous static moment must equal continuous static moment times 1.10, within a relative tolerance of 1e-6 with an absolute fallback of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely true ;
                      nltl:continuousSurfaceProjectedArea ?continuousAreaNode ;
                      nltl:discontinuousSurfaceProjectedArea ?discontinuousAreaNode ;
                      nltl:continuousSurfaceStaticMoment ?continuousMomentNode ;
                      nltl:discontinuousSurfaceStaticMoment ?discontinuousMomentNode .

                ?continuousAreaNode <http://qudt.org/schema/qudt/numericValue> ?continuousArea .
                ?discontinuousAreaNode <http://qudt.org/schema/qudt/numericValue> ?discontinuousArea .
                ?continuousMomentNode <http://qudt.org/schema/qudt/numericValue> ?continuousMoment .
                ?discontinuousMomentNode <http://qudt.org/schema/qudt/numericValue> ?discontinuousMoment .

                FILTER (
                    ABS(?discontinuousArea - (?continuousArea * "1.05"^^xsd:decimal))
                    >
                    (ABS(?continuousArea * "1.05"^^xsd:decimal) * "0.000001"^^xsd:decimal + "0.000000001"^^xsd:decimal)
                    ||
                    ABS(?discontinuousMoment - (?continuousMoment * "1.10"^^xsd:decimal))
                    >
                    (ABS(?continuousMoment * "1.10"^^xsd:decimal) * "0.000001"^^xsd:decimal + "0.000000001"^^xsd:decimal)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-033> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F03/ship> ] .

