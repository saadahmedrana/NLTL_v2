@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F05/LC1> ;
                    sh:resultMessage "Less than 1 values on ex:LC1->nltl:hasLoadingConditionResultEvidence" ;
                    sh:resultPath nltl:hasLoadingConditionResultEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:minCount 1 ;
                            sh:path nltl:hasLoadingConditionResultEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F05/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:or ( [ sh:sparql [ sh:message Literal("The externally calculated residual stability factor must be 1.0 within the inclusive relative tolerance of 1e-6 with a 1e-9 absolute fallback.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:residualStabilityFactorSI ?quantity .
                                ?quantity qudt:numericValue ?value .
                                FILTER (
                                    datatype(?value) = xsd:decimal &&
                                    ABS(?value - 1.0) >
                                    (0.000001 * ABS(1.0) + 0.000000001)
                                )
                            }
                        ") ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:alternativeInstrumentApplicable ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:alternativeInstrumentResidualStabilityStatus ] ] ) ; sh:property [ sh:class nltl:evidenceArtifact ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasLoadingConditionResultEvidence ], [ sh:datatype xsd:string ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:loadingConditionIdentifier ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:residualStabilityFactorSI ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasLoadingConditionCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:loadingConditionCase ;
                    sh:node [ sh:or ( [ sh:sparql [ sh:message "The externally calculated residual stability factor must be 1.0 within the inclusive relative tolerance of 1e-6 with a 1e-9 absolute fallback." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:residualStabilityFactorSI ?quantity .
                                ?quantity qudt:numericValue ?value .
                                FILTER (
                                    datatype(?value) = xsd:decimal &&
                                    ABS(?value - 1.0) >
                                    (0.000001 * ABS(1.0) + 0.000000001)
                                )
                            }
                        """ ] ] [ sh:property [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:alternativeInstrumentApplicable ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:alternativeInstrumentResidualStabilityStatus ] ] ) ;
                            sh:property [ sh:datatype xsd:string ;
                                    sh:minCount 1 ;
                                    sh:path nltl:loadingConditionIdentifier ],
                                [ sh:class nltl:evidenceArtifact ;
                                    sh:minCount 1 ;
                                    sh:path nltl:hasLoadingConditionResultEvidence ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:residualStabilityFactorSI ] ] ;
                    sh:path nltl:hasLoadingConditionCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F05/LC1> ] .

