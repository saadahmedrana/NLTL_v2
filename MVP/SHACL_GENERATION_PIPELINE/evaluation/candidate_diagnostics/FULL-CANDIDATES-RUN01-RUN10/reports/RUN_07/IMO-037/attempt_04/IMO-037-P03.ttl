@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-P03/LC1> ;
                    sh:resultMessage """Node ex:LC1 must conform to one or more shapes in [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:residualStabilityFactorSI ] ; sh:sparql [ sh:message Literal("The residual stability factor must be within the inclusive 1e-6 tolerance of the expected value 1.0.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:residualStabilityFactorSI ?quantity .
                            ?quantity qudt:numericValue ?value .
                            FILTER (
                                ?value >= "0.999999"^^xsd:decimal &&
                                ?value <= "1.000001"^^xsd:decimal
                            )
                        }
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:alternativeInstrumentResidualStabilityStatus ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:alternativeInstrumentApplicable ] ]""" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gs:IMO_037_LoadingConditionCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-P03/LC1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-P03/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:IMO_037_LoadingConditionCaseShape. See details for more information." ;
            sh:resultPath nltl:hasLoadingConditionCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gs:IMO_037_LoadingConditionCaseShape ;
                    sh:path nltl:hasLoadingConditionCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-P03/LC1> ] .

