@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ;
            sh:resultMessage "Longitudinal and vertical damage extents must satisfy the prescribed piecewise formulas, within a relative tolerance of 1e-6 plus a small absolute fallback." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Longitudinal and vertical damage extents must satisfy the prescribed piecewise formulas, within a relative tolerance of 1e-6 plus a small absolute fallback." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthNode ;
                      nltl:longitudinalDamageExtent ?longitudinalNode ;
                      nltl:upperIceWaterlineDraught ?draughtNode ;
                      nltl:verticalDamageExtent ?verticalNode .

                ?lengthNode qudt:numericValue ?length .
                ?longitudinalNode qudt:numericValue ?longitudinal .
                ?draughtNode qudt:numericValue ?draught .
                ?verticalNode qudt:numericValue ?vertical .

                FILTER (
                    ABS(
                        ?longitudinal -
                        IF(?forward = true, 0.045 * ?length, 0.015 * ?length)
                    )
                    > (
                        0.000001 *
                        ABS(IF(?forward = true, 0.045 * ?length, 0.015 * ?length))
                        + 0.000000001
                    )
                    ||
                    ABS(
                        ?vertical -
                        IF(0.20 * ?draught < ?longitudinal,
                           0.20 * ?draught,
                           ?longitudinal)
                    )
                    > (
                        0.000001 *
                        ABS(IF(0.20 * ?draught < ?longitudinal,
                               0.20 * ?draught,
                               ?longitudinal))
                        + 0.000000001
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO038ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ;
            sh:resultMessage "Allowed vertical position must be recorded." ;
            sh:resultPath nltl:allowedVerticalPosition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "Allowed vertical position must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:allowedVerticalPosition ] ] .

