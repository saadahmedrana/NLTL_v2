@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ;
            sh:resultMessage "longitudinalDamageExtent must equal 4.5% of upperIceWaterlineLength when the damage center is forward of maximum breadth, otherwise 1.5%, within the permitted numerical tolerance" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "longitudinalDamageExtent must equal 4.5% of upperIceWaterlineLength when the damage center is forward of maximum breadth, otherwise 1.5%, within the permitted numerical tolerance" ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthNode ;
                      nltl:longitudinalDamageExtent ?extentNode .
                ?lengthNode qudt:numericValue ?length .
                ?extentNode qudt:numericValue ?extent .
                FILTER (datatype(?length) = xsd:decimal)
                FILTER (datatype(?extent) = xsd:decimal)
                BIND(IF(?forward = true, "0.045"^^xsd:decimal * ?length,
                                      "0.015"^^xsd:decimal * ?length) AS ?expected)
                FILTER (ABS(?extent - ?expected) >
                        (ABS(?expected) * "0.000001"^^xsd:decimal +
                         "0.000000001"^^xsd:decimal))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO038Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ] .

