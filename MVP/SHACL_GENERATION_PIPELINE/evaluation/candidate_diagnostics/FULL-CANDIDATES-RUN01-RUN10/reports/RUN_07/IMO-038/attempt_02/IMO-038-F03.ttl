@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ;
            sh:resultMessage "verticalDamageExtent must equal the lesser of 20% of upperIceWaterlineDraught and longitudinalDamageExtent within the permitted numerical tolerance" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "verticalDamageExtent must equal the lesser of 20% of upperIceWaterlineDraught and longitudinalDamageExtent within the permitted numerical tolerance" ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDraught ?draughtNode ;
                      nltl:longitudinalDamageExtent ?longitudinalNode ;
                      nltl:verticalDamageExtent ?verticalNode .
                ?draughtNode qudt:numericValue ?draught .
                ?longitudinalNode qudt:numericValue ?longitudinal .
                ?verticalNode qudt:numericValue ?vertical .
                FILTER (datatype(?draught) = xsd:decimal)
                FILTER (datatype(?longitudinal) = xsd:decimal)
                FILTER (datatype(?vertical) = xsd:decimal)
                BIND("0.20"^^xsd:decimal * ?draught AS ?draughtLimit)
                BIND(IF(?draughtLimit < ?longitudinal, ?draughtLimit, ?longitudinal) AS ?expected)
                FILTER (ABS(?vertical - ?expected) >
                        (ABS(?expected) * "0.000001"^^xsd:decimal +
                         "0.000000001"^^xsd:decimal))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO038Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ] .

