@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F05/ship> ;
            sh:resultMessage "selectedVerticalDamagePosition must be between the keel and 120% of upperIceWaterlineDraught" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "selectedVerticalDamagePosition must be between the keel and 120% of upperIceWaterlineDraught" ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDraught ?draughtNode ;
                      nltl:selectedVerticalDamagePosition ?positionNode .
                ?draughtNode qudt:numericValue ?draught .
                ?positionNode qudt:numericValue ?position .
                FILTER (datatype(?draught) = xsd:decimal)
                FILTER (datatype(?position) = xsd:decimal)
                FILTER (?position < "0.0"^^xsd:decimal ||
                        ?position > "1.20"^^xsd:decimal * ?draught)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO038Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F05/ship> ] .

