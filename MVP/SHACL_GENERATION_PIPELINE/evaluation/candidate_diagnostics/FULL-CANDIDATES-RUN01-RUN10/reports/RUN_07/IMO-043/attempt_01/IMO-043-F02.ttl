@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachinery> ;
                    sh:resultMessage "Each machinery installation shall have hazard protection evidence." ;
                    sh:resultPath nltl:hasHazardProtectionEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:message "Each machinery installation shall have hazard protection evidence." ;
                            sh:minCount 1 ;
                            sh:path nltl:hasHazardProtectionEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO043MachineryInstallationShape. See details for more information." ;
            sh:resultPath nltl:hasMachineryInstallation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:IMO043MachineryInstallationShape ;
                    sh:path nltl:hasMachineryInstallation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachinery> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "The ship shall record hazard protection coverage." ;
            sh:resultPath nltl:hazardProtectionCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb115ecdcd8cc4b3e8b449db6c6864674b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "The ship shall record hazard protection coverage." ;
            sh:resultPath nltl:hazardProtectionCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb115ecdcd8cc4b3e8b449db6c6864674b1 ] .

_:nb115ecdcd8cc4b3e8b449db6c6864674b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall record hazard protection coverage." ;
    sh:minCount 1 ;
    sh:path nltl:hazardProtectionCoverage .

