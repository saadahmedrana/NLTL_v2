@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F01/mainMachinery> ;
                    sh:resultMessage "The machinery installation must identify all six applicable protection hazards." ;
                    sh:resultPath nltl:hasApplicableHazard ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:iceAccretionHazard nltl:snowAccumulationHazard nltl:seawaterIceIngestionHazard nltl:liquidFreezingOrViscosityIncreaseHazard nltl:seawaterIntakeTemperatureHazard nltl:snowIngestionHazard ) ;
                            sh:maxCount 6 ;
                            sh:message "The machinery installation must identify all six applicable protection hazards." ;
                            sh:minCount 6 ;
                            sh:path nltl:hasApplicableHazard ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F01/ship> ;
            sh:resultMessage "Each linked machinery installation must represent protection coverage for all specified applicable hazards and have protection evidence." ;
            sh:resultPath nltl:hasMachineryInstallation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked machinery installation must represent protection coverage for all specified applicable hazards and have protection evidence." ;
                    sh:node nltlg:IMO_043_MachineryInstallationShape ;
                    sh:path nltl:hasMachineryInstallation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F01/mainMachinery> ] .

