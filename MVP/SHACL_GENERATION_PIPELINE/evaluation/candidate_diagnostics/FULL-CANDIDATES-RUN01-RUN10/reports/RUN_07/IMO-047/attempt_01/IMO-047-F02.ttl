@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Combustion-air temperature control shall be recorded as present when an essential engine is represented.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:combustionAirTemperatureControlPresent ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:combustionAirTemperature ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:manufacturerMaxAirTemperature ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:manufacturerMinAirTemperature ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasEssentialEngine ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("Combustion air temperature shall be within the manufacturer-specified minimum and maximum air temperatures.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:combustionAirTemperature ?temperatureNode .
                        ?temperatureNode qudt:numericValue ?temperature .
                        $this nltl:manufacturerMinAirTemperature ?minimumNode .
                        ?minimumNode qudt:numericValue ?minimum .
                        $this nltl:manufacturerMaxAirTemperature ?maximumNode .
                        ?maximumNode qudt:numericValue ?maximum .
                        FILTER (
                            ?temperature < ?minimum ||
                            ?temperature > ?maximum
                        )
                    }
                ") ] ] , [ sh:property [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:path nltl:hasEssentialEngine ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO047Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F02/ship> ] .

