@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-P05/ship> ;
            sh:resultMessage "The ship category and applicable machinery-component scantling approval evidence must conform to the applicable Polar Code branch." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-049-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-P05/ship> ] .

