@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F02/control1> ;
                    sh:resultMessage "Each local control item must remain continuously accessible." ;
                    sh:resultPath nltl:localControlContinuouslyAccessible ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nfb085f6f4d9346959ee5656b5474d1a5b3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F02/control1> ;
                    sh:resultMessage "Each local control item must remain continuously accessible." ;
                    sh:resultPath nltl:localControlContinuouslyAccessible ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nfb085f6f4d9346959ee5656b5474d1a5b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO051LocalControlItemShape. See details for more information." ;
            sh:resultPath nltl:hasLocalControlItem ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:IMO051LocalControlItemShape ;
                    sh:path nltl:hasLocalControlItem ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F02/control1> ] .

_:nfb085f6f4d9346959ee5656b5474d1a5b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "Each local control item must remain continuously accessible." ;
    sh:minCount 1 ;
    sh:path nltl:localControlContinuouslyAccessible .

