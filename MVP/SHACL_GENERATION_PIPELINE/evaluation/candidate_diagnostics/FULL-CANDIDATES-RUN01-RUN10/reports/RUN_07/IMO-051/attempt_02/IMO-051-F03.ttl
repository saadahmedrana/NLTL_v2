@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F03/control1> ;
                    sh:resultMessage "Each local control item must remain continuously accessible." ;
                    sh:resultPath nltl:localControlContinuouslyAccessible ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n938ec4503c7c4d13bdb00775fdf22533b3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F03/control1> ;
                    sh:resultMessage "Each local control item must have freezing, snow, and ice protection." ;
                    sh:resultPath nltl:localControlProtectionPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n938ec4503c7c4d13bdb00775fdf22533b2 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F03/control1> ;
                    sh:resultMessage "Each local control item must have freezing, snow, and ice protection." ;
                    sh:resultPath nltl:localControlProtectionPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n938ec4503c7c4d13bdb00775fdf22533b2 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F03/control1> ;
                    sh:resultMessage "Each local control item must remain continuously accessible." ;
                    sh:resultPath nltl:localControlContinuouslyAccessible ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n938ec4503c7c4d13bdb00775fdf22533b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-051-LocalControlItemShape>. See details for more information." ;
            sh:resultPath nltl:hasLocalControlItem ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-051-LocalControlItemShape> ;
                    sh:path nltl:hasLocalControlItem ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F03/control1> ] .

_:n938ec4503c7c4d13bdb00775fdf22533b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "Each local control item must have freezing, snow, and ice protection." ;
    sh:minCount 1 ;
    sh:path nltl:localControlProtectionPresent .

_:n938ec4503c7c4d13bdb00775fdf22533b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "Each local control item must remain continuously accessible." ;
    sh:minCount 1 ;
    sh:path nltl:localControlContinuouslyAccessible .

