@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-057-F06/mist> ;
                    sh:resultMessage "Every fire pump, emergency fire pump, water-mist pump, and water-spray pump must be assigned to a compartment maintained above 0 deg C." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Every fire pump, emergency fire pump, water-mist pump, and water-spray pump must be assigned to a compartment maintained above 0 deg C." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a ?pumpType .
                FILTER (
                    ?pumpType = nltl:firePump ||
                    ?pumpType = nltl:emergencyFirePump ||
                    ?pumpType = nltl:waterMistPump ||
                    ?pumpType = nltl:waterSprayPump
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasContainingCompartment ?anyCompartment .
                    }
                    ||
                    EXISTS {
                        $this nltl:hasContainingCompartment ?compartment .
                        FILTER (
                            NOT EXISTS {
                                ?compartment nltl:maintainedTemperature ?temperature .
                            }
                            ||
                            EXISTS {
                                ?compartment nltl:maintainedTemperature ?temperature .
                                FILTER NOT EXISTS {
                                    ?temperature a qudt:QuantityValue ;
                                        qudt:unit unit:DEG_C ;
                                        qudt:numericValue ?value .
                                    FILTER (?value > 0)
                                }
                            }
                        )
                    }
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:IMO057PumpLocationShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-057-F06/mist> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-057-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO057PumpLocationShape. See details for more information." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:IMO057PumpLocationShape ;
                    sh:path nltl:hasComponent ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-057-F06/mist> ] .

