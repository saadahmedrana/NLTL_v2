@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F03/ship> ;
            sh:resultMessage "The independent sea suction status must be provided as a single boolean value." ;
            sh:resultPath nltl:independentSeaSuctionUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The independent sea suction status must be provided as a single boolean value." ;
                    sh:minCount 1 ;
                    sh:path nltl:independentSeaSuctionUsed ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When the fixed water system is separate from the main fire pumps and uses an independent sea suction, the sea suction must be capable of being cleared of ice accumulation.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:seaSuctionIceClearingCapability ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:independentSeaSuctionUsed ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:independentSeaSuctionUsed ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-060> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F03/ship> ] .

