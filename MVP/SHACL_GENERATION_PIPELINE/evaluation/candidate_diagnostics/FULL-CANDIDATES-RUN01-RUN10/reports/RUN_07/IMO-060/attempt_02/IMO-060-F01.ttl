@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F01/ship> ;
            sh:resultMessage "When the fixed water system is separate from the main fire pumps and uses an independent sea suction, that suction must be capable of being cleared of ice accumulation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the fixed water system is separate from the main fire pumps and uses an independent sea suction, that suction must be capable of being cleared of ice accumulation." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:fixedWaterSystemSeparateFromMainFirePumps ?fixedSystem .
                $this nltl:independentSeaSuctionUsed ?independentSuction .
                FILTER (
                    ?fixedSystem = true &&
                    ?independentSuction = true
                )
                FILTER NOT EXISTS {
                    $this nltl:seaSuctionIceClearingCapability true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_060_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F01/ship> ] .

