        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F02/route1> ;
                    sh:resultMessage "Every exposed escape route shall remain safe." ;
