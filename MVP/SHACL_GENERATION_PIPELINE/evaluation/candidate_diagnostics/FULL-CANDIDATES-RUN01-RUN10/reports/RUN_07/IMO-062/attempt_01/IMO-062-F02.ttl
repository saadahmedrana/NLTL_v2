            sh:sourceShape _:nf29d3b7a52214f68bd637dfce0a21782b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F02/ship> ;
