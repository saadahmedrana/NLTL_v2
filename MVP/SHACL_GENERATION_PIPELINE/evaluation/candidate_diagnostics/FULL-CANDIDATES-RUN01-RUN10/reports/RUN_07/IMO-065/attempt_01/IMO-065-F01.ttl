@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F01/ship> ;
            sh:resultMessage "The survival support duration must be at least the maximum expected rescue time." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The survival support duration must be at least the maximum expected rescue time." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:survivalSupportDuration ?supportNode .
                ?supportNode qudt:numericValue ?supportValue .
                $this nltl:maximumExpectedRescueTime ?rescueNode .
                ?rescueNode qudt:numericValue ?rescueValue .
                FILTER(datatype(?supportValue) = xsd:decimal)
                FILTER(datatype(?rescueValue) = xsd:decimal)
                FILTER(?supportValue < ?rescueValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-065-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F01/maximumExpectedRescueTimeValue> ;
                    sh:resultMessage "Node ex:maximumExpectedRescueTimeValue->qudt:unit does not contain a value in the set: ['qudt:DAY']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n3e04ad884279422eb21fabfea7ce7a6bb12 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F01/ship> ;
            sh:resultMessage "The maximum expected rescue time must be provided in days." ;
            sh:resultPath nltl:maximumExpectedRescueTime ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The maximum expected rescue time must be provided in days." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-065-TimeQuantityShape> ;
                    sh:path nltl:maximumExpectedRescueTime ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F01/maximumExpectedRescueTimeValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F01/survivalSupportDurationValue> ;
                    sh:resultMessage "Node ex:survivalSupportDurationValue->qudt:unit does not contain a value in the set: ['qudt:DAY']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n3e04ad884279422eb21fabfea7ce7a6bb12 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F01/ship> ;
            sh:resultMessage "The survival support duration must be provided in days." ;
            sh:resultPath nltl:survivalSupportDuration ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The survival support duration must be provided in days." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-065-TimeQuantityShape> ;
                    sh:path nltl:survivalSupportDuration ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F01/survivalSupportDurationValue> ] .

_:n3e04ad884279422eb21fabfea7ce7a6bb12 sh:hasValue qudt:DAY ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

