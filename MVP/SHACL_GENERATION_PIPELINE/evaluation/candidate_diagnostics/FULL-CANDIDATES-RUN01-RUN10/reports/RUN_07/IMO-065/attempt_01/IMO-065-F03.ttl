@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F03/survivalSupportDurationValue> ;
                    sh:resultMessage "Node ex:survivalSupportDurationValue->qudt:unit does not contain a value in the set: ['qudt:DAY']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n3e04ad884279422eb21fabfea7ce7a6bb12 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F03/ship> ;
            sh:resultMessage "The survival support duration must be provided in days." ;
            sh:resultPath nltl:survivalSupportDuration ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The survival support duration must be provided in days." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-065-TimeQuantityShape> ;
                    sh:path nltl:survivalSupportDuration ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F03/survivalSupportDurationValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F03/ship> ;
            sh:resultMessage "Survival resources must protect persons from cold, wind, and sun." ;
            sh:resultPath nltl:weatherProtectionPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "Survival resources must protect persons from cold, wind, and sun." ;
                    sh:minCount 1 ;
                    sh:path nltl:weatherProtectionPresent ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F03/maximumExpectedRescueTimeValue> ;
                    sh:resultMessage "Node ex:maximumExpectedRescueTimeValue->qudt:unit does not contain a value in the set: ['qudt:DAY']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n3e04ad884279422eb21fabfea7ce7a6bb12 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F03/ship> ;
            sh:resultMessage "The maximum expected rescue time must be provided in days." ;
            sh:resultPath nltl:maximumExpectedRescueTime ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The maximum expected rescue time must be provided in days." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-065-TimeQuantityShape> ;
                    sh:path nltl:maximumExpectedRescueTime ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F03/maximumExpectedRescueTimeValue> ] .

_:n3e04ad884279422eb21fabfea7ce7a6bb12 sh:hasValue qudt:DAY ;
