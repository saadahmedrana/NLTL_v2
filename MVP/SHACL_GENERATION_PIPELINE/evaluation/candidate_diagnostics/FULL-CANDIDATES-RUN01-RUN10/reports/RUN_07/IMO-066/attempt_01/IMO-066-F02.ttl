@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"The ship's ice-accretion exposure applicability must be recorded as false for this non-applicable branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipExposedToIceAccretion ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The ship's ice-accretion exposure applicability must be recorded as true for this applicable branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipExposedToIceAccretion ], [ sh:message Literal(\"Every linked protected item must have its required ice or snow removal or prevention means.\") ; sh:node gen:IMO_066_ProtectedItemShape ; sh:path nltl:hasProtectedItem ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_066_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F02/ship> ] .

