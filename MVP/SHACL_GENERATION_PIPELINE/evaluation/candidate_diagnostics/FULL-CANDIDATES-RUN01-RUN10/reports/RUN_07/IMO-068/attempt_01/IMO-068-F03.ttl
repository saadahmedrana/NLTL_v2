@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-F03/ship> ;
            sh:resultMessage "If the ship operates in ice-covered waters or direct evacuation onto ice is applicable, safe evacuation means and approved survival equipment deployment are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-068_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-F03/ship> ] .

