@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P01/ship> ;
            sh:resultMessage "Each applicable passenger ship shall have a true size compatibility status." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n436bb7b90b15415ab197d747cd336fd5b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P01/ship> ;
            sh:resultMessage "Each applicable passenger ship shall have a true size compatibility status." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n436bb7b90b15415ab197d747cd336fd5b1 ] .

_:n436bb7b90b15415ab197d747cd336fd5b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Each applicable passenger ship shall have a true size compatibility status." ;
    sh:minCount 1 ;
    sh:path nltl:sizeCompatibilityStatus .

