@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F02/ship> ;
            sh:resultMessage "Every linked crew member must have completed personal and group survival equipment training." ;
            sh:resultPath ( nltl:hasCrewMemberInventory nltl:personalAndGroupSurvivalEquipmentTrainingCompleted ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:message "Every linked crew member must have completed personal and group survival equipment training." ;
                    sh:minCount 1 ;
                    sh:path ( nltl:hasCrewMemberInventory nltl:personalAndGroupSurvivalEquipmentTrainingCompleted ) ] ] .

