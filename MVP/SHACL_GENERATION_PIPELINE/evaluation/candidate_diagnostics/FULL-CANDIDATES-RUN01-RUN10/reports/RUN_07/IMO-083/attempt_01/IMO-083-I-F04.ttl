@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Ice-accretion applicability must be recorded as true for this applicable branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:iceAccretionLikely ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ rdf:type sh:NodeShape ; sh:class nltl:navigationOrCommunicationAntenna ; sh:property [ sh:datatype xsd:boolean ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Each required navigation or communication antenna must have ice-accumulation prevention means.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:antennaIceAccumulationPreventionPresent ] ] ; sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ] ] , [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"Ice-accretion applicability must be recorded as false for this non-applicable branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:iceAccretionLikely ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-083-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F04/ship> ] .

