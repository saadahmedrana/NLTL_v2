@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-084-I-F01/ship> ;
            sh:resultMessage "When sensors project below the hull, the sensors must be protected against ice." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When sensors project below the hull, the sensors must be protected against ice." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:requiredSensorProjectsBelowHull ?required .
                FILTER (DATATYPE(?required) = xsd:boolean && ?required = true)
                FILTER NOT EXISTS {
                    $this nltl:sensorIceProtectionPresent ?protected .
                    FILTER (DATATYPE(?protected) = xsd:boolean && ?protected = true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_084_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-084-I-F01/ship> ] .

