@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F05/ship> ;
            sh:resultMessage "Each non-magnetic heading means shall be independent from another distinct heading means linked to the same ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each non-magnetic heading means shall be independent from another distinct heading means linked to the same ship." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this
WHERE {
    $this nltl:hasNonMagneticHeadingMeans ?means .
    FILTER NOT EXISTS {
        $this nltl:hasNonMagneticHeadingMeans ?otherMeans .
        ?means nltl:independentFromHeadingMeans ?otherMeans .
        FILTER (?means != ?otherMeans)
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO086ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F05/ship> ] .

