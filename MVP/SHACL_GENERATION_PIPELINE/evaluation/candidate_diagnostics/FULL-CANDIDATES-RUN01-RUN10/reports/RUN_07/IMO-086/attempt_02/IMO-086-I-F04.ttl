@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading1> ;
                    sh:resultMessage "Each non-magnetic heading means shall be independent from another distinct heading means belonging to the same ship." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:n9a44c331a6094efcbe5cc740bbe717dcb5 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gs:IMO086HeadingMeansShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading1> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading1> ;
                    sh:resultMessage "Each non-magnetic heading means shall identify an independent heading means." ;
                    sh:resultPath nltl:independentFromHeadingMeans ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n9a44c331a6094efcbe5cc740bbe717dcb4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic heading means." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n9a44c331a6094efcbe5cc740bbe717dcb1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading1> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading2> ;
                    sh:resultMessage "Each non-magnetic heading means shall identify an independent heading means." ;
                    sh:resultPath nltl:independentFromHeadingMeans ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n9a44c331a6094efcbe5cc740bbe717dcb4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading2> ;
                    sh:resultMessage "Each non-magnetic heading means shall be independent from another distinct heading means belonging to the same ship." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:n9a44c331a6094efcbe5cc740bbe717dcb5 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gs:IMO086HeadingMeansShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading2> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic heading means." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n9a44c331a6094efcbe5cc740bbe717dcb1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading2> ] .

_:n9a44c331a6094efcbe5cc740bbe717dcb1 sh:class nltl:nonMagneticHeadingMeans ;
    sh:message "The ship shall have at least two non-magnetic heading means." ;
    sh:minCount 2 ;
    sh:node gs:IMO086HeadingMeansShape ;
    sh:path nltl:hasNonMagneticHeadingMeans .

_:n9a44c331a6094efcbe5cc740bbe717dcb4 sh:class nltl:nonMagneticHeadingMeans ;
    sh:message "Each non-magnetic heading means shall identify an independent heading means." ;
    sh:minCount 1 ;
    sh:path nltl:independentFromHeadingMeans .

_:n9a44c331a6094efcbe5cc740bbe717dcb5 sh:message "Each non-magnetic heading means shall be independent from another distinct heading means belonging to the same ship." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship nltl:hasNonMagneticHeadingMeans $this .
                FILTER NOT EXISTS {
                    ?ship nltl:hasNonMagneticHeadingMeans ?other .
                    FILTER (?other != $this)
                    $this nltl:independentFromHeadingMeans ?other .
                }
            }
        """ .

