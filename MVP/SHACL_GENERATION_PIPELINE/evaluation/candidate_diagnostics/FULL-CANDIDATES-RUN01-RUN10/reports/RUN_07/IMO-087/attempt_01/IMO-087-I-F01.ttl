@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F01/ship> ;
            sh:resultMessage "For ships proceeding to latitudes over 80 degrees, at least one GNSS compass or equivalent and connections to both main and emergency power are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For ships proceeding to latitudes over 80 degrees, at least one GNSS compass or equivalent and connections to both main and emergency power are required." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:plannedOrActualLatitude ?latitudeNode .
                ?latitudeNode qudt:numericValue ?latitude .
                FILTER (?latitude > "80"^^xsd:decimal)
                FILTER (
                    NOT EXISTS {
                        $this nltl:gnssCompassOrEquivalentCount ?count .
                        FILTER (?count >= 1)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:connectedToMainPower ?mainPower .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:connectedToEmergencyPower ?emergencyPower .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_087_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F01/ship> ] .

