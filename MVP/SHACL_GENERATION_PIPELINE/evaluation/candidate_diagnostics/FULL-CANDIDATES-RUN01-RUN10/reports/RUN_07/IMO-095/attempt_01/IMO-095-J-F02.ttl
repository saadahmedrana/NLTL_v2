            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nd324ada7b820435fbfb11f5a3799782fb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F02/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath nltl:searchAndRescueCommunicationCapability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd324ada7b820435fbfb11f5a3799782fb1 ] .

_:N5f8c97c2949d44cd99a6912464539ade sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaHZ> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:decimal ;
            sh:maxInclusive 121.5 ;
            sh:minCount 1 ;
            sh:minInclusive 121.5 ;
            sh:path qudt:numericValue ] .

_:Nb4f22ace95da4193842b9920a0ff4420 sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaHZ> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
