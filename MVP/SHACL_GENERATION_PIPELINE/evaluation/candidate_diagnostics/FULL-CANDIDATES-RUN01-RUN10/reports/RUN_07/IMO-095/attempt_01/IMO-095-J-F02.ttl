        [ sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:nd324ada7b820435fbfb11f5a3799782fb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship shall declare search and rescue communication capability." ;
    sh:minCount 1 ;
    sh:path nltl:searchAndRescueCommunicationCapability .

_:nd324ada7b820435fbfb11f5a3799782fb3 sh:message "The ship shall support aircraft voice communications on both 121.5 MHz and 123.1 MHz." ;
    sh:minCount 2 ;
