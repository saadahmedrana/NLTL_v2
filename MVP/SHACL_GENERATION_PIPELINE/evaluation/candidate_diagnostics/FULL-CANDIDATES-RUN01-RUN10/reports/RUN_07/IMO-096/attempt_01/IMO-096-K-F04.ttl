@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-096-K-F04/ship> ;
            sh:resultMessage "Each ship must provide two-way data communication with a Telemedical Assistance Service (TMAS)." ;
            sh:resultPath nltl:telemedicalAssistanceServiceTwoWayDataCapability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n197a5ba1fca94b958b03c8c1d1bd33e0b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-096-K-F04/ship> ;
            sh:resultMessage "Each ship must provide two-way data communication with a Telemedical Assistance Service (TMAS)." ;
            sh:resultPath nltl:telemedicalAssistanceServiceTwoWayDataCapability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n197a5ba1fca94b958b03c8c1d1bd33e0b2 ] .

_:n197a5ba1fca94b958b03c8c1d1bd33e0b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "Each ship must provide two-way data communication with a Telemedical Assistance Service (TMAS)." ;
    sh:minCount 1 ;
    sh:path nltl:telemedicalAssistanceServiceTwoWayDataCapability .

