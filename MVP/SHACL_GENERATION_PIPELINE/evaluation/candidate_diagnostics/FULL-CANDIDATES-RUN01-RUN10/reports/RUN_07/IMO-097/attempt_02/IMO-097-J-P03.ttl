@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P03/ship> ;
            sh:resultMessage "The rescue-boat or lifeboat release applicability value must be recorded as a single boolean." ;
            sh:resultPath nltl:releasedRescueBoatOrLifeboat ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The rescue-boat or lifeboat release applicability value must be recorded as a single boolean." ;
                    sh:minCount 1 ;
                    sh:path nltl:releasedRescueBoatOrLifeboat ] ] .

