@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P02/ship> ;
            sh:resultMessage "The ship must represent its lifeboat relationship." ;
            sh:resultPath nltl:hasLifeboat ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must represent its lifeboat relationship." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasLifeboat ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P02/ship> ;
            sh:resultMessage "The ship must represent its other-survival-craft relationship." ;
            sh:resultPath nltl:hasOtherSurvivalCraft ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must represent its other-survival-craft relationship." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasOtherSurvivalCraft ] ] .

