@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F04/ship> ;
            sh:resultMessage "Each applicable crew member must have a training record with the matrix-required level and a valid STCW qualification." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each applicable crew member must have a training record with the matrix-required level and a valid STCW qualification." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType ;
                      nltl:hasCrewMemberInventory ?crew .
                ?crew nltl:polarTrainingCrewRoleClassification ?role .

                FILTER (
                    (?ice = nltl:openWaterIceCondition &&
                     ?shipType != nltl:otherShipPolarTrainingType)
                    ||
                    (?ice = nltl:otherWatersIceCondition)
                )

                BIND(
                    IF(
                        ?ice = nltl:otherWatersIceCondition &&
                        (
                            ?role = nltl:masterPolarTrainingRole ||
                            ?role = nltl:chiefMatePolarTrainingRole
                        ),
                        nltl:advancedPolarTrainingLevel,
                        nltl:basicPolarTrainingLevel
                    ) AS ?expectedLevel
                )

                FILTER NOT EXISTS {
                    ?crew nltl:hasCrewTrainingRecord ?record .
                    ?record nltl:requiredTrainingLevel ?requiredLevel ;
                            nltl:trainingRecordLevel ?recordLevel ;
                            nltl:stcwQualificationValid true .
                    FILTER (
                        ?requiredLevel = ?expectedLevel &&
                        ?recordLevel = ?expectedLevel
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-102-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F04/ship> ] .

