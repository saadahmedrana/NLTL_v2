@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ;
                            sh:resultMessage "The training record must specify exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nb7f27283b0a34853b3bfb30b9d1017e3b18 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ;
                            sh:resultMessage "The recorded training level must equal the required training level." ;
                            sh:resultPath nltl:trainingRecordLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
                            sh:sourceShape _:nb7f27283b0a34853b3bfb30b9d1017e3b22 ;
                            sh:value nltl:basicPolarTrainingLevel ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ;
                    sh:resultMessage "Each crew member must have a polar training record." ;
                    sh:resultPath nltl:hasPolarTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:equals nltl:hasCrewTrainingRecord ;
                            sh:maxCount 1 ;
                            sh:message "Each crew member must have a polar training record." ;
                            sh:minCount 1 ;
                            sh:node gen:TrainingRecordShape ;
                            sh:path nltl:hasPolarTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ;
                    sh:resultMessage "Each represented crew member must have exactly one controlled polar training role." ;
                    sh:resultPath nltl:polarTrainingCrewRoleClassification ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:masterPolarTrainingRole nltl:chiefMatePolarTrainingRole nltl:officerInChargeOfNavigationalWatchPolarTrainingRole ) ;
                            sh:maxCount 1 ;
                            sh:message "Each represented crew member must have exactly one controlled polar training role." ;
                            sh:minCount 1 ;
                            sh:path nltl:polarTrainingCrewRoleClassification ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ;
                            sh:resultMessage "The training record must specify exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nb7f27283b0a34853b3bfb30b9d1017e3b18 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ;
                            sh:resultMessage "The recorded training level must equal the required training level." ;
                            sh:resultPath nltl:trainingRecordLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
                            sh:sourceShape _:nb7f27283b0a34853b3bfb30b9d1017e3b22 ;
                            sh:value nltl:basicPolarTrainingLevel ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ;
                    sh:resultMessage "Each crew member must link the same polar training record through the required training-record relationships." ;
                    sh:resultPath nltl:hasCrewTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:equals nltl:hasPolarTrainingRecord ;
                            sh:maxCount 1 ;
                            sh:message "Each crew member must link the same polar training record through the required training-record relationships." ;
                            sh:minCount 1 ;
                            sh:node gen:TrainingRecordShape ;
                            sh:path nltl:hasCrewTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:CrewMemberShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ] .

_:N1d52f1eac6ba4455953d1981400c37a4 rdf:first nltl:polarTrainingNotApplicable ;
    rdf:rest () .

_:N5ad4810c9fff4c3fad91fbd2e29421b2 rdf:first nltl:advancedPolarTrainingLevel ;
    rdf:rest ( nltl:polarTrainingNotApplicable ) .

_:N966f1aceca9148e1872b7b7d3a64cf53 rdf:first nltl:advancedPolarTrainingLevel ;
    rdf:rest _:N1d52f1eac6ba4455953d1981400c37a4 .

_:Ne9a0624844bd47d1b2d6a37fe9180c0e rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest _:N966f1aceca9148e1872b7b7d3a64cf53 .

_:Nedc4002785da4318b64c9fb915a3c39c rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest _:N5ad4810c9fff4c3fad91fbd2e29421b2 .

_:nb7f27283b0a34853b3bfb30b9d1017e3b18 sh:in _:Ne9a0624844bd47d1b2d6a37fe9180c0e ;
    sh:maxCount 1 ;
    sh:message "The training record must specify exactly one controlled required training level." ;
    sh:minCount 1 ;
    sh:path nltl:requiredTrainingLevel .

_:nb7f27283b0a34853b3bfb30b9d1017e3b22 sh:equals nltl:requiredTrainingLevel ;
    sh:in _:Nedc4002785da4318b64c9fb915a3c39c ;
