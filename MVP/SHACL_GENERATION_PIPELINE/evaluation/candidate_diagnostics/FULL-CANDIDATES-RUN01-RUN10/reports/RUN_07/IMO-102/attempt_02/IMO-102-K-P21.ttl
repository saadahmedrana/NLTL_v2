@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P21/trainingRecord> ;
                            sh:resultMessage "The training record must specify exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nb7f27283b0a34853b3bfb30b9d1017e3b18 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P21/trainingRecord> ;
                            sh:resultMessage "The recorded training level must equal the required training level." ;
                            sh:resultPath nltl:trainingRecordLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
                            sh:sourceShape _:nb7f27283b0a34853b3bfb30b9d1017e3b22 ;
                            sh:value nltl:basicPolarTrainingLevel ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P21/crew> ;
                    sh:resultMessage "Each crew member must have a polar training record." ;
                    sh:resultPath nltl:hasPolarTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:equals nltl:hasCrewTrainingRecord ;
                            sh:maxCount 1 ;
                            sh:message "Each crew member must have a polar training record." ;
                            sh:minCount 1 ;
                            sh:node gen:TrainingRecordShape ;
                            sh:path nltl:hasPolarTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P21/trainingRecord> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P21/trainingRecord> ;
                            sh:resultMessage "The training record must specify exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nb7f27283b0a34853b3bfb30b9d1017e3b18 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P21/trainingRecord> ;
                            sh:resultMessage "The recorded training level must equal the required training level." ;
                            sh:resultPath nltl:trainingRecordLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
                            sh:sourceShape _:nb7f27283b0a34853b3bfb30b9d1017e3b22 ;
                            sh:value nltl:basicPolarTrainingLevel ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P21/crew> ;
                    sh:resultMessage "Each crew member must link the same polar training record through the required training-record relationships." ;
                    sh:resultPath nltl:hasCrewTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:equals nltl:hasPolarTrainingRecord ;
                            sh:maxCount 1 ;
                            sh:message "Each crew member must link the same polar training record through the required training-record relationships." ;
                            sh:minCount 1 ;
                            sh:node gen:TrainingRecordShape ;
                            sh:path nltl:hasCrewTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P21/trainingRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P21/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:CrewMemberShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P21/crew> ] .

_:N3773bf22cd36482a9aaa7611aca09760 rdf:first nltl:polarTrainingNotApplicable ;
    rdf:rest () .

_:N5f1b27d0b6be4a1fa4a74511de64fe50 rdf:first nltl:advancedPolarTrainingLevel ;
    rdf:rest _:N3773bf22cd36482a9aaa7611aca09760 .

_:N70e25459cbe14defa28cacba348bc893 rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest _:N5f1b27d0b6be4a1fa4a74511de64fe50 .

_:N8407e9d9e8a84e2685aa07848a90b5f5 rdf:first nltl:advancedPolarTrainingLevel ;
    rdf:rest ( nltl:polarTrainingNotApplicable ) .

_:N8ec21555eefd425abf2bf0e08e18ebcf rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest _:N8407e9d9e8a84e2685aa07848a90b5f5 .

_:nb7f27283b0a34853b3bfb30b9d1017e3b18 sh:in _:N8ec21555eefd425abf2bf0e08e18ebcf ;
    sh:maxCount 1 ;
    sh:message "The training record must specify exactly one controlled required training level." ;
    sh:minCount 1 ;
    sh:path nltl:requiredTrainingLevel .

_:nb7f27283b0a34853b3bfb30b9d1017e3b22 sh:equals nltl:requiredTrainingLevel ;
    sh:in _:N70e25459cbe14defa28cacba348bc893 ;
    sh:maxCount 1 ;
    sh:message "The recorded training level must equal the required training level." ;
    sh:minCount 1 ;
    sh:path nltl:trainingRecordLevel .

