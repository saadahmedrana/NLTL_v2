@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P26/trainingRecord> ;
                            sh:resultMessage "The recorded training level must equal the required training level." ;
                            sh:resultPath nltl:trainingRecordLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
                            sh:sourceShape _:nb7f27283b0a34853b3bfb30b9d1017e3b22 ;
                            sh:value nltl:advancedPolarTrainingLevel ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P26/trainingRecord> ;
                            sh:resultMessage "The training record must specify exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nb7f27283b0a34853b3bfb30b9d1017e3b18 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P26/crew> ;
                    sh:resultMessage "Each crew member must have a polar training record." ;
                    sh:resultPath nltl:hasPolarTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:equals nltl:hasCrewTrainingRecord ;
                            sh:maxCount 1 ;
                            sh:message "Each crew member must have a polar training record." ;
                            sh:minCount 1 ;
                            sh:node gen:TrainingRecordShape ;
                            sh:path nltl:hasPolarTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P26/trainingRecord> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P26/trainingRecord> ;
                            sh:resultMessage "The training record must specify exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nb7f27283b0a34853b3bfb30b9d1017e3b18 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P26/trainingRecord> ;
                            sh:resultMessage "The recorded training level must equal the required training level." ;
                            sh:resultPath nltl:trainingRecordLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
                            sh:sourceShape _:nb7f27283b0a34853b3bfb30b9d1017e3b22 ;
                            sh:value nltl:advancedPolarTrainingLevel ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P26/crew> ;
                    sh:resultMessage "Each crew member must link the same polar training record through the required training-record relationships." ;
                    sh:resultPath nltl:hasCrewTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:equals nltl:hasPolarTrainingRecord ;
                            sh:maxCount 1 ;
                            sh:message "Each crew member must link the same polar training record through the required training-record relationships." ;
                            sh:minCount 1 ;
                            sh:node gen:TrainingRecordShape ;
                            sh:path nltl:hasCrewTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P26/trainingRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P26/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:CrewMemberShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P26/crew> ] .

