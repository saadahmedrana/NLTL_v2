@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F04/ship> ;
            sh:resultMessage "Each applicable crew member must have the same polar training record through hasPolarTrainingRecord and hasCrewTrainingRecord, with the matrix-required training level and a valid STCW qualification." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each applicable crew member must have the same polar training record through hasPolarTrainingRecord and hasCrewTrainingRecord, with the matrix-required training level and a valid STCW qualification." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType ;
                      nltl:hasCrewMemberInventory ?crew .

                ?crew nltl:polarTrainingCrewRoleClassification ?role .

                FILTER (
                    (
                        ?ice = nltl:openWaterIceCondition &&
                        (
                            ?shipType = nltl:tankerPolarTrainingShipType ||
                            ?shipType = nltl:passengerShipPolarTrainingShipType
                        )
                    )
                    ||
                    ?ice = nltl:otherWatersIceCondition
                )

                FILTER NOT EXISTS {
                    ?crew nltl:hasPolarTrainingRecord ?record ;
                          nltl:hasCrewTrainingRecord ?record .

                    ?record nltl:requiredTrainingLevel ?level ;
                            nltl:trainingRecordLevel ?level ;
                            nltl:stcwQualificationValid true .

                    FILTER (
                        (
                            ?ice = nltl:openWaterIceCondition &&
                            (
                                ?shipType = nltl:tankerPolarTrainingShipType ||
                                ?shipType = nltl:passengerShipPolarTrainingShipType
                            ) &&
                            ?level = nltl:basicPolarTrainingLevel
                        )
                        ||
                        (
                            ?ice = nltl:otherWatersIceCondition &&
                            (
                                (
                                    (
                                        ?role = nltl:masterPolarTrainingRole ||
                                        ?role = nltl:chiefMatePolarTrainingRole
                                    ) &&
                                    ?level = nltl:advancedPolarTrainingLevel
                                )
                                ||
                                (
                                    ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole &&
                                    ?level = nltl:basicPolarTrainingLevel
                                )
                            )
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-102-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F04/ship> ] .

