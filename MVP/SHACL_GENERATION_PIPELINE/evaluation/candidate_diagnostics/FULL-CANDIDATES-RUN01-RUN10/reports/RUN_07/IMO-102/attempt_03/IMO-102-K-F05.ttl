_:N9617289d158048549fc99a459e1a5334 rdf:first nltl:polarTrainingNotApplicable ;
    rdf:rest () .

_:Nd755a8fc37884a819a46111307c8a47f rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest ( nltl:advancedPolarTrainingLevel nltl:polarTrainingNotApplicable ) .

_:nf91de74133c04ccb9b1fb4a737518d4ab15 sh:node <urn:nltl:generated-shape:IMO-102-TrainingRecordShape> ;
