@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/ship> ;
            sh:resultMessage "Each applicable crew member must have the same polar training record through hasPolarTrainingRecord and hasCrewTrainingRecord, with the matrix-required training level and a valid STCW qualification." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each applicable crew member must have the same polar training record through hasPolarTrainingRecord and hasCrewTrainingRecord, with the matrix-required training level and a valid STCW qualification." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType ;
                      nltl:hasCrewMemberInventory ?crew .

                ?crew nltl:polarTrainingCrewRoleClassification ?role .

                FILTER (
                    (
                        ?ice = nltl:openWaterIceCondition &&
                        (
                            ?shipType = nltl:tankerPolarTrainingShipType ||
                            ?shipType = nltl:passengerShipPolarTrainingShipType
                        )
                    )
                    ||
                    ?ice = nltl:otherWatersIceCondition
                )

                FILTER NOT EXISTS {
                    ?crew nltl:hasPolarTrainingRecord ?record ;
                          nltl:hasCrewTrainingRecord ?record .

                    ?record nltl:requiredTrainingLevel ?level ;
                            nltl:trainingRecordLevel ?level ;
                            nltl:stcwQualificationValid true .

                    FILTER (
                        (
                            ?ice = nltl:openWaterIceCondition &&
                            (
                                ?shipType = nltl:tankerPolarTrainingShipType ||
                                ?shipType = nltl:passengerShipPolarTrainingShipType
                            ) &&
                            ?level = nltl:basicPolarTrainingLevel
                        )
                        ||
                        (
                            ?ice = nltl:otherWatersIceCondition &&
                            (
                                (
                                    (
                                        ?role = nltl:masterPolarTrainingRole ||
                                        ?role = nltl:chiefMatePolarTrainingRole
                                    ) &&
                                    ?level = nltl:advancedPolarTrainingLevel
                                )
                                ||
                                (
                                    ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole &&
                                    ?level = nltl:basicPolarTrainingLevel
                                )
                            )
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-102-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/trainingRecord> ;
                            sh:resultMessage "Less than 1 values on ex:trainingRecord->nltl:requiredTrainingLevel" ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nf91de74133c04ccb9b1fb4a737518d4ab17 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/trainingRecord> ;
                            sh:resultMessage "Value of ex:trainingRecord->nltl:trainingRecordLevel != nltl:basicPolarTrainingLevel" ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
                            sh:sourceShape _:nf91de74133c04ccb9b1fb4a737518d4ab25 ;
                            sh:value nltl:basicPolarTrainingLevel ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/crew> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-102-TrainingRecordShape>. See details for more information." ;
                    sh:resultPath nltl:hasCrewTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nf91de74133c04ccb9b1fb4a737518d4ab16 ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/trainingRecord> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/trainingRecord> ;
                            sh:resultMessage "Less than 1 values on ex:trainingRecord->nltl:requiredTrainingLevel" ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nf91de74133c04ccb9b1fb4a737518d4ab17 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/trainingRecord> ;
                            sh:resultMessage "Value of ex:trainingRecord->nltl:trainingRecordLevel != nltl:basicPolarTrainingLevel" ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
                            sh:sourceShape _:nf91de74133c04ccb9b1fb4a737518d4ab25 ;
                            sh:value nltl:basicPolarTrainingLevel ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/crew> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-102-TrainingRecordShape>. See details for more information." ;
                    sh:resultPath nltl:hasPolarTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nf91de74133c04ccb9b1fb4a737518d4ab15 ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/trainingRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-102-CrewMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-102-CrewMemberShape> ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/crew> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/trainingRecord> ;
                    sh:resultMessage "Value of ex:trainingRecord->nltl:trainingRecordLevel != nltl:basicPolarTrainingLevel" ;
                    sh:resultPath nltl:requiredTrainingLevel ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
                    sh:sourceShape _:nf91de74133c04ccb9b1fb4a737518d4ab25 ;
                    sh:value nltl:basicPolarTrainingLevel ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/trainingRecord> ;
                    sh:resultMessage "Less than 1 values on ex:trainingRecord->nltl:requiredTrainingLevel" ;
                    sh:resultPath nltl:requiredTrainingLevel ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nf91de74133c04ccb9b1fb4a737518d4ab17 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/crew> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-102-TrainingRecordShape>. See details for more information." ;
            sh:resultPath nltl:hasPolarTrainingRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nf91de74133c04ccb9b1fb4a737518d4ab15 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/trainingRecord> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/trainingRecord> ;
                    sh:resultMessage "Less than 1 values on ex:trainingRecord->nltl:requiredTrainingLevel" ;
                    sh:resultPath nltl:requiredTrainingLevel ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nf91de74133c04ccb9b1fb4a737518d4ab17 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/trainingRecord> ;
                    sh:resultMessage "Value of ex:trainingRecord->nltl:trainingRecordLevel != nltl:basicPolarTrainingLevel" ;
                    sh:resultPath nltl:requiredTrainingLevel ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
                    sh:sourceShape _:nf91de74133c04ccb9b1fb4a737518d4ab25 ;
                    sh:value nltl:basicPolarTrainingLevel ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/crew> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-102-TrainingRecordShape>. See details for more information." ;
            sh:resultPath nltl:hasCrewTrainingRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nf91de74133c04ccb9b1fb4a737518d4ab16 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P15/trainingRecord> ] .

_:N0659e0c4889d422ea814ac25ab338e6c rdf:first nltl:polarTrainingNotApplicable ;
    rdf:rest () .

_:N16cd42250fbd40b1977abab079a43fda rdf:first nltl:advancedPolarTrainingLevel ;
    rdf:rest _:N0659e0c4889d422ea814ac25ab338e6c .

_:Nc4c12550ef854c9ead012d47d65ba521 rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest _:N16cd42250fbd40b1977abab079a43fda .

_:nf91de74133c04ccb9b1fb4a737518d4ab15 sh:node <urn:nltl:generated-shape:IMO-102-TrainingRecordShape> ;
    sh:path nltl:hasPolarTrainingRecord .

_:nf91de74133c04ccb9b1fb4a737518d4ab16 sh:node <urn:nltl:generated-shape:IMO-102-TrainingRecordShape> ;
    sh:path nltl:hasCrewTrainingRecord .

_:nf91de74133c04ccb9b1fb4a737518d4ab17 sh:in _:Nc4c12550ef854c9ead012d47d65ba521 ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:requiredTrainingLevel .

_:nf91de74133c04ccb9b1fb4a737518d4ab25 sh:equals nltl:trainingRecordLevel ;
    sh:path nltl:requiredTrainingLevel .

