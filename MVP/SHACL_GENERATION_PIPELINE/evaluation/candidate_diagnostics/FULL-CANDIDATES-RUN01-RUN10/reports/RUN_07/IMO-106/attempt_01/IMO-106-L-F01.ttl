@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F01/ship> ;
            sh:resultMessage "For clean or segregated ballast discharge, the paragraph 1.1.1 oil-discharge prohibition applicability must be false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For clean or segregated ballast discharge, the paragraph 1.1.1 oil-discharge prohibition applicability must be false." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:dischargedMaterialClassification ?material .
                FILTER (
                    ?material IN (
                        nltl:cleanBallastMaterial,
                        nltl:segregatedBallastMaterial
                    )
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?requiredValue .
                        FILTER (?requiredValue = false)
                    }
                    ||
                    EXISTS {
                        $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?conflictingValue .
                        FILTER (?conflictingValue != false)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_106_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F01/ship> ] .

