@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship's polar-waters applicability must be explicitly false when polar document coverage is not required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipOperatesInPolarWaters ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Polar operation coverage must be present in the applicable Oil Record Book.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:oilRecordBookPolarCoverage ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Polar operation coverage must be present in the applicable manuals.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:manualPolarCoverage ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Polar operation coverage must be present in the applicable oil or marine pollution emergency plan.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:pollutionEmergencyPlanPolarCoverage ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship's polar-waters applicability must be explicitly true when polar document coverage is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipOperatesInPolarWaters ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO107PolarOperationCoverageShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-F01/ship> ] .

