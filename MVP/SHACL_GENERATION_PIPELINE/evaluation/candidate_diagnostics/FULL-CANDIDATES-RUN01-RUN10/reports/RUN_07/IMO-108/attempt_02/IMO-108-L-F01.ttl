@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-F01/ship> ;
            sh:resultMessage "For Category A or B ships constructed on or after 2017-01-01, with aggregate oil fuel capacity below 600 m3 and an individual oil fuel tank capacity above 30 m3, the oil fuel tank outer shell separation must be at least 0.76 m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For Category A or B ships constructed on or after 2017-01-01, with aggregate oil fuel capacity below 600 m3 and an individual oil fuel tank capacity above 30 m3, the oil fuel tank outer shell separation must be at least 0.76 m." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:shipCategory ?category .
    FILTER (?category IN (
        nltl:polarShipCategoryA,
        nltl:polarShipCategoryB
    ))

    $this nltl:constructionDate ?constructionDate .
    FILTER (
        datatype(?constructionDate) = xsd:date &&
        ?constructionDate >= "2017-01-01"^^xsd:date
    )

    $this nltl:aggregateOilFuelCapacity ?aggregateQuantity .
    ?aggregateQuantity qudt:numericValue ?aggregateValue ;
                       qudt:unit unit:M3 .
    FILTER (
        datatype(?aggregateValue) = xsd:decimal &&
        ?aggregateValue < "600"^^xsd:decimal
    )

    $this nltl:individualOilFuelTankCapacity ?individualQuantity .
    ?individualQuantity qudt:numericValue ?individualValue ;
                        qudt:unit unit:M3 .
    FILTER (
        datatype(?individualValue) = xsd:decimal &&
        ?individualValue > "30"^^xsd:decimal
    )

    FILTER NOT EXISTS {
        $this nltl:oilFuelTankOuterShellSeparation ?separationQuantity .
        ?separationQuantity qudt:numericValue ?separationValue ;
                            qudt:unit unit:M .
        FILTER (
            datatype(?separationValue) = xsd:decimal &&
            ?separationValue >= "0.76"^^xsd:decimal
        )
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_108_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-F01/ship> ] .

