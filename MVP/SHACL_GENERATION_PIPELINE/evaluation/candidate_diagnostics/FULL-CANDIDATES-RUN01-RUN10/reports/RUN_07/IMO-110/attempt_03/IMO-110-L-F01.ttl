@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-110-L-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Applicable ships must have compliant entire cargo-tank-length double-bottom protection.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:entireCargoTankLengthDoubleBottomProtectionStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Applicable ships must have compliant wing-tank protection.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:wingTankProtectionStatus ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("2017-01-01", datatype=xsd:date) ; sh:path nltl:constructionDate ], [ sh:datatype xsd:string ; sh:hasValue Literal("oil_tanker") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipType ], [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:shipCategory ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxExclusive Literal("5000", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:TON_Metric ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:deadweight ] ] , [ sh:sparql [ sh:message Literal("The conditional protection requirement is applicable unless the ship is demonstrably outside at least one applicability condition.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        FILTER (
                            EXISTS {
                                $this nltl:shipCategory ?category .
                                FILTER (
                                    ?category NOT IN (
                                        nltl:polarShipCategoryA,
                                        nltl:polarShipCategoryB
                                    )
                                )
                            }
                            ||
                            EXISTS {
                                $this nltl:shipType ?type .
                                FILTER (?type != "oil_tanker")
                            }
                            ||
                            EXISTS {
                                $this nltl:deadweight ?deadweight .
                                ?deadweight qudt:numericValue ?value .
                                ?deadweight qudt:unit unit:TON_Metric .
                                FILTER (?value >= "5000"^^xsd:decimal)
                            }
                            ||
                            EXISTS {
                                $this nltl:constructionDate ?date .
                                FILTER (?date < "2017-01-01"^^xsd:date)
                            }
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-110> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-110-L-F01/ship> ] .

