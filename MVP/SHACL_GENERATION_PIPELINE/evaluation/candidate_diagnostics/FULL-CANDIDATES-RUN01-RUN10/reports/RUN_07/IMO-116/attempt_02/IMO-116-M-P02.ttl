@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-P02/ship> ;
            sh:resultMessage "Sewage discharge type and notComminutedOrDisinfected must identify the same applicability state." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Sewage discharge type and notComminutedOrDisinfected must identify the same applicability state." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:sewageDischargeType ?type ;
                      nltl:notComminutedOrDisinfected ?flag .
                FILTER (
                    (?type = "not_comminuted_or_disinfected"^^xsd:string && ?flag = true)
                    ||
                    (?type != "not_comminuted_or_disinfected"^^xsd:string && ?flag = false)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO116Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-P02/ship> ] .

