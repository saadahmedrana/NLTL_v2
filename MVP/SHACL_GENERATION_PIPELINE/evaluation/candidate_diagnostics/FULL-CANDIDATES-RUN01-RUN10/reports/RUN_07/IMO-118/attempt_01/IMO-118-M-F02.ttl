@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F02/ship> ;
            sh:resultMessage "For a Category A or B ship, or a passenger ship, constructed on or after 1 January 2017, sewage discharge to sea must be false unless compliance with Polar Code paragraph 4.2.1.3 is true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-118> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F02/ship> ] .

