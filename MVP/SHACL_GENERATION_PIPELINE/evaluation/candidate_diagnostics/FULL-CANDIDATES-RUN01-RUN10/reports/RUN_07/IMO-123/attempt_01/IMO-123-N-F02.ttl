@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F02/ship> ;
            sh:resultMessage "The ship must be en route." ;
            sh:resultPath nltl:shipEnRoute ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The ship must be en route." ;
                    sh:minCount 1 ;
                    sh:path nltl:shipEnRoute ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F02/distanceToAreaWithIceConcentrationGreaterThanOneTenthValue> ;
                            sh:resultMessage "Node ex:distanceToAreaWithIceConcentrationGreaterThanOneTenthValue->qudt:unit does not contain a value in the set: ['qudt:MI_N']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:MI_N ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F02/distanceRecord> ;
                    sh:resultMessage "A discharge distance from an area with ice concentration greater than one tenth must be recorded." ;
                    sh:resultPath nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "A discharge distance from an area with ice concentration greater than one tenth must be recorded." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue qudt:MI_N ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F02/distanceToAreaWithIceConcentrationGreaterThanOneTenthValue> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F02/distanceToNearestLandIceShelfOrFastIceValue> ;
                            sh:resultMessage "Node ex:distanceToNearestLandIceShelfOrFastIceValue->qudt:unit does not contain a value in the set: ['qudt:MI_N']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:MI_N ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F02/distanceRecord> ;
                    sh:resultMessage "The discharge distance must be at least 12 nautical miles from the nearest land, ice shelf, or fast ice." ;
                    sh:resultPath nltl:distanceToNearestLandIceShelfOrFastIce ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The discharge distance must be at least 12 nautical miles from the nearest land, ice shelf, or fast ice." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue qudt:MI_N ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:minInclusive 12 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:distanceToNearestLandIceShelfOrFastIce ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F02/distanceToNearestLandIceShelfOrFastIceValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO123DischargeDistanceRecordShape. See details for more information." ;
            sh:resultPath nltl:hasDischargeDistanceRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:IMO123DischargeDistanceRecordShape ;
                    sh:path nltl:hasDischargeDistanceRecord ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F02/distanceRecord> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F02/nearbyIceConcentrationValue> ;
                    sh:resultMessage "Node ex:nearbyIceConcentrationValue->qudt:unit does not contain a value in the set: ['qudt:UNITLESS']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F02/ship> ;
            sh:resultMessage "The relevant nearby ice concentration must exceed one tenth." ;
            sh:resultPath nltl:nearbyIceConcentration ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The relevant nearby ice concentration must exceed one tenth." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:minExclusive 0.1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:nearbyIceConcentration ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F02/nearbyIceConcentrationValue> ] .

