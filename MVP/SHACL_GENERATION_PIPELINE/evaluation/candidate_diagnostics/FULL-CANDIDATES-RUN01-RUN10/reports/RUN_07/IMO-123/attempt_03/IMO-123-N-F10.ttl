@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ;
                    sh:resultMessage "The nearest land, ice shelf, or fast ice distance must be at least 12 nautical miles." ;
                    sh:resultPath nltl:distanceToNearestLandIceShelfOrFastIce ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The nearest land, ice shelf, or fast ice distance must be at least 12 nautical miles." ;
                            sh:minCount 1 ;
                            sh:node gs:NearestLandIceShelfOrFastIceDistanceShape ;
                            sh:path nltl:distanceToNearestLandIceShelfOrFastIce ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ;
                    sh:resultMessage "The discharge-distance record must include the distance from an area whose ice concentration exceeds one tenth." ;
                    sh:resultPath nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The discharge-distance record must include the distance from an area whose ice concentration exceeds one tenth." ;
                            sh:minCount 1 ;
                            sh:node gs:IceConcentrationAreaDistanceShape ;
                            sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/ship> ;
            sh:resultMessage "At least one discharge-distance record is required." ;
            sh:resultPath nltl:hasDischargeDistanceRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "At least one discharge-distance record is required." ;
                    sh:minCount 1 ;
                    sh:node gs:DischargeDistanceRecordShape ;
                    sh:path nltl:hasDischargeDistanceRecord ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ] .

