@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F01/ship> ;
            sh:resultMessage "The ship must record that the cargo residue is not recoverable by common methods." ;
            sh:resultPath nltl:residueNotRecoverableByCommonMethods ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:message "The ship must record that the cargo residue is not recoverable by common methods." ;
                    sh:minCount 1 ;
                    sh:path nltl:residueNotRecoverableByCommonMethods ] ] .

