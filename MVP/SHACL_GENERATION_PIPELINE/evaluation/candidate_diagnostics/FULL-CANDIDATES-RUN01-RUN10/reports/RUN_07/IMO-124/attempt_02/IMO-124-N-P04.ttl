@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-124-N-P04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:message Literal("Food waste must not be discharged onto ice.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:foodWasteDischargeOntoIce ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:message Literal("The applicable branch requires a MARPOL Annex V regulation 6.1 discharge.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:marpolAnnexVRegulation6Point1DischargeOccurs ], [ sh:datatype xsd:string ; sh:hasValue Literal("Antarctic_area") ; sh:message Literal("An Antarctic area applicability value is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:antarcticArea ], [ sh:datatype xsd:string ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:operatingArea ], [ sh:message Literal("Distance to the nearest fast ice must be at least 12 nautical miles.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("12", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MI_N ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:distanceToNearestFastIce ], [ sh:message Literal("The associated ice concentration must exceed one tenth.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minExclusive Literal("0.1", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:iceConcentration ], [ sh:message Literal("The distance from areas with ice concentration exceeding one tenth must be recorded.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MI_N ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ], [ sh:message Literal("The nearby ice concentration must exceed one tenth.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minExclusive Literal("0.1", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:nearbyIceConcentration ] ] , [ sh:property [ sh:datatype xsd:string ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:antarcticArea ], [ sh:datatype xsd:string ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:operatingArea ] ; sh:sparql [ sh:message Literal("The operating area must be explicitly identified as non-Antarctic when this alternative is used.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:antarcticArea ?area .
                        FILTER (STR(?area) != "Antarctic_area")
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:marpolAnnexVRegulation6Point1DischargeOccurs ], [ sh:datatype xsd:string ; sh:hasValue Literal("Antarctic_area") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:antarcticArea ], [ sh:datatype xsd:string ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:operatingArea ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO124Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-124-N-P04/ship> ] .

