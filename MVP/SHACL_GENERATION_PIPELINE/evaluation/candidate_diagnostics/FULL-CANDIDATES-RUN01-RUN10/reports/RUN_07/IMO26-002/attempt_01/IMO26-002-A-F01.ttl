@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/ship> ;
            sh:resultMessage "Chapter 9-1 applicability must be true for a qualifying fishing vessel, pleasure yacht, or cargo ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Chapter 9-1 applicability must be true for a qualifying fishing vessel, pleasure yacht, or cargo ship." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:shipType ?type ;
          nltl:engagedInTrade ?trade ;
          nltl:lengthOverall ?lengthQuantity ;
          nltl:grossTonnage ?tonnageQuantity ;
          nltl:polarCodeChapter9Dash1Applicable ?applicable .
    ?lengthQuantity qudt:numericValue ?length .
    ?tonnageQuantity qudt:numericValue ?tonnage .

    FILTER (
        (
            (?type = "fishing_vessel" && ?length >= 24.0) ||
            (?type = "pleasure_yacht" && ?tonnage >= 300.0 && ?trade = false) ||
            (?type = "cargo_ship" && ?tonnage >= 300.0 && ?tonnage < 500.0)
        )
        && ?applicable != true
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-002> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/ship> ] .

