@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P03/ship> ;
            sh:resultMessage "The intended-area suitability approval status must be exactly Approved." ;
            sh:resultPath nltl:intendedAreaSuitabilityApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nd02e533e195543c8beb5835cb88a7426b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P03/ship> ;
            sh:resultMessage "The intended-area suitability approval status must be exactly Approved." ;
            sh:resultPath nltl:intendedAreaSuitabilityApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd02e533e195543c8beb5835cb88a7426b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P03/ship> ;
            sh:resultMessage "The intended area must be specified." ;
            sh:resultPath nltl:intendedArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The intended area must be specified." ;
                    sh:minCount 1 ;
                    sh:path nltl:intendedArea ] ] .

_:nd02e533e195543c8beb5835cb88a7426b3 sh:class nltl:evidenceState ;
    sh:hasValue nltl:evidenceStateApproved ;
    sh:maxCount 1 ;
    sh:message "The intended-area suitability approval status must be exactly Approved." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:intendedAreaSuitabilityApprovalStatus .

