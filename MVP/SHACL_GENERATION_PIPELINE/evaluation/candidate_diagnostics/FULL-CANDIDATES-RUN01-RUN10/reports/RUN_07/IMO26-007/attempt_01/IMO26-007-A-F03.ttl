@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-007-A-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:constructionDate" ;
            sh:resultPath nltl:constructionDate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:date ;
                    sh:minCount 1 ;
                    sh:path nltl:constructionDate ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-007-A-F03/ship> ;
            sh:resultMessage "Ice-strengthened ships constructed on or after 1 January 2026 shall have two independent echo-sounding devices, or one echo-sounding device with two independent transducers, or an Administration-approved equivalent depth-sounding device." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-007-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-007-A-F03/ship> ] .

