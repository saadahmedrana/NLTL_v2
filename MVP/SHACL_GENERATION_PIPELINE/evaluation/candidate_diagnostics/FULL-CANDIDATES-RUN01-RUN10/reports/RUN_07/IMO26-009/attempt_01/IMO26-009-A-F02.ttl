@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-009-A-F02/ship> ;
            sh:resultMessage "When ice accretion is likely, every required navigation or communication antenna must have ice accumulation prevention." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When ice accretion is likely, every required navigation or communication antenna must have ice accumulation prevention." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely true .
                $this nltl:hasRequiredNavigationOrCommunicationAntenna ?antenna .
                FILTER NOT EXISTS {
                    ?antenna nltl:antennaIceAccumulationPreventionPresent ?value .
                    FILTER (
                        datatype(?value) = xsd:boolean &&
                        ?value = true
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO26_009_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-009-A-F02/ship> ] .

