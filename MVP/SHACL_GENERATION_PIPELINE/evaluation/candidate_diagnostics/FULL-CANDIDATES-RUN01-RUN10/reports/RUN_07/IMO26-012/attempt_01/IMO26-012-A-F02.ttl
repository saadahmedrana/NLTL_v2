            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nde3ab211e4b14d13911ba9fa1869e95bb1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F02/heading2> ],
