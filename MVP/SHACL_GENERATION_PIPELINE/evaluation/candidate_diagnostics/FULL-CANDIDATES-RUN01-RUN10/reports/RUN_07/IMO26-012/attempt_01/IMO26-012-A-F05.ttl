@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F05/ship> ;
            sh:resultMessage "Each non-magnetic heading means shall be independent from a distinct non-magnetic heading means belonging to the same ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each non-magnetic heading means shall be independent from a distinct non-magnetic heading means belonging to the same ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasNonMagneticHeadingMeans ?means .
                FILTER NOT EXISTS {
                    $this nltl:hasNonMagneticHeadingMeans ?otherMeans .
                    ?means nltl:independentFromHeadingMeans ?otherMeans .
                    FILTER (?otherMeans != ?means)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-012-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F05/ship> ] .

