@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-P03/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic heading means, with the required power and independence relationships." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:nonMagneticHeadingMeans ;
                    sh:message "The ship shall have at least two non-magnetic heading means, with the required power and independence relationships." ;
                    sh:minCount 2 ;
                    sh:node <urn:nltl:generated-shape:IMO26-012-HeadingMeansShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasNonMagneticHeadingMeans ] ] .

