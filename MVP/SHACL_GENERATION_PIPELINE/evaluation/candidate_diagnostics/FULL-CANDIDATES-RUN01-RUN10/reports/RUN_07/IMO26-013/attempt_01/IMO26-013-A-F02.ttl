@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-013-A-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:benchmarkEntity ; sh:message Literal(\"At latitudes over 80 degrees, the GNSS compass or equivalent must be connected to the emergency power source.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:connectedToEmergencyPower ], [ sh:class nltl:benchmarkEntity ; sh:message Literal(\"At latitudes over 80 degrees, the GNSS compass or equivalent must be connected to the main power source.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:connectedToMainPower ], [ sh:datatype xsd:integer ; sh:message Literal(\"At latitudes over 80 degrees, at least one GNSS compass or equivalent is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:gnssCompassOrEquivalentCount ], [ sh:node [ sh:property [ sh:minExclusive Literal(\"80\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:plannedOrActualLatitude ] ] , [ sh:property [ sh:node [ sh:property [ sh:maxInclusive Literal(\"80\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:plannedOrActualLatitude ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26_013> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-013-A-F02/ship> ] .

