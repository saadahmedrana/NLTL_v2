@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-014-A-F03/ship> ;
            sh:resultMessage "The ship must specify whether it operates only in continuous daylight." ;
            sh:resultPath nltl:operatesOnlyInContinuousDaylight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "The ship must specify whether it operates only in continuous daylight." ;
                    sh:minCount 1 ;
                    sh:path nltl:operatesOnlyInContinuousDaylight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-014-A-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:IMO26_014_ContinuousDaylightBranch , gs:IMO26_014_NonContinuousDaylightBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO26_014_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-014-A-F03/ship> ] .

