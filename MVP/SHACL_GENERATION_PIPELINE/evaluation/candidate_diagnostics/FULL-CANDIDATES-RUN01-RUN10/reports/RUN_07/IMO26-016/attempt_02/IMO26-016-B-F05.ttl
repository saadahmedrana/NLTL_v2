@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F05/lengthOverallValue> ;
                    sh:resultMessage "Node ex:lengthOverallValue->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:lengthOverall ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:lengthOverall ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F05/lengthOverallValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F05/ship> ;
            sh:resultMessage "When the ship operates in polar waters, ship type and all measurements required by its applicable type branch must be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the ship operates in polar waters, ship type and all measurements required by its applicable type branch must be present." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters ?operates ;
                      nltl:shipType ?type .
                OPTIONAL { $this nltl:lengthOverall ?lengthNode . }
                OPTIONAL { $this nltl:grossTonnage ?tonnageNode . }
                OPTIONAL { $this nltl:engagedInTrade ?trade . }
                FILTER (
                    ?operates = true &&
                    (
                        (STR(?type) = "fishing_vessel" && !BOUND(?lengthNode)) ||
                        ((STR(?type) = "pleasure_yacht" || STR(?type) = "cargo_ship") && !BOUND(?tonnageNode)) ||
                        (STR(?type) = "pleasure_yacht" && !BOUND(?trade))
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-016> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F05/ship> ] .

