@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F05/ship> ;
            sh:resultMessage "Chapter 11-1 applicability must be true exactly for polar-waters ships meeting one of the specified type and threshold alternatives, and false otherwise." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Chapter 11-1 applicability must be true exactly for polar-waters ships meeting one of the specified type and threshold alternatives, and false otherwise." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters ?polar ;
                      nltl:polarCodeChapter11Dash1Applicable ?app .

                FILTER (
                    (
                        ?polar = true &&
                        ?app = true &&
                        NOT EXISTS {
                            {
                                $this nltl:shipType "fishing_vessel" ;
                                      nltl:lengthOverall ?lengthNode .
                                ?lengthNode qudt:numericValue ?lengthValue ;
                                            qudt:unit <http://qudt.org/vocab/unit/M> .
                                FILTER (?lengthValue >= 24)
                            }
                            UNION
                            {
                                $this nltl:shipType "pleasure_yacht" ;
                                      nltl:grossTonnage ?tonnageNode ;
                                      nltl:engagedInTrade false .
                                ?tonnageNode qudt:numericValue ?tonnageValue ;
                                             qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER (?tonnageValue >= 300)
                            }
                            UNION
                            {
                                $this nltl:shipType "cargo_ship" ;
                                      nltl:grossTonnage ?cargoTonnageNode .
                                ?cargoTonnageNode qudt:numericValue ?cargoTonnageValue ;
                                                    qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER (?cargoTonnageValue >= 300 && ?cargoTonnageValue < 500)
                            }
                        }
                    )
                    ||
                    (
                        ?polar = true &&
                        ?app != true &&
                        EXISTS {
                            {
                                $this nltl:shipType "fishing_vessel" ;
                                      nltl:lengthOverall ?lengthNode .
                                ?lengthNode qudt:numericValue ?lengthValue ;
                                            qudt:unit <http://qudt.org/vocab/unit/M> .
                                FILTER (?lengthValue >= 24)
                            }
                            UNION
                            {
                                $this nltl:shipType "pleasure_yacht" ;
                                      nltl:grossTonnage ?tonnageNode ;
                                      nltl:engagedInTrade false .
                                ?tonnageNode qudt:numericValue ?tonnageValue ;
                                             qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER (?tonnageValue >= 300)
                            }
                            UNION
                            {
                                $this nltl:shipType "cargo_ship" ;
                                      nltl:grossTonnage ?cargoTonnageNode .
                                ?cargoTonnageNode qudt:numericValue ?cargoTonnageValue ;
                                                    qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER (?cargoTonnageValue >= 300 && ?cargoTonnageValue < 500)
                            }
                        }
                    )
                    ||
                    (
                        ?polar != true &&
                        ?app = true
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-016> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F05/ship> ] .

