@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F01/ship> ;
            sh:resultMessage "Chapter 11-1 applicability must be true exactly for polar-water ships meeting one of the stated type and threshold alternatives, and false otherwise." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Chapter 11-1 applicability must be true exactly for polar-water ships meeting one of the stated type and threshold alternatives, and false otherwise." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this nltl:shipOperatesInPolarWaters ?polar ;
                      nltl:shipType ?type ;
                      nltl:polarCodeChapter11Dash1Applicable ?actual .

                BIND(
                    (
                        (?polar = true)
                        &&
                        (
                            (
                                ?type = "fishing_vessel"
                                &&
                                EXISTS {
                                    ?this nltl:lengthOverall ?lengthQuantity .
                                    ?lengthQuantity qudt:numericValue ?lengthValue ;
                                                     qudt:unit <http://qudt.org/vocab/unit/M> .
                                    FILTER (
                                        datatype(?lengthValue) = xsd:decimal
                                        && ?lengthValue >= 24
                                    )
                                }
                            )
                            ||
                            (
                                ?type = "pleasure_yacht"
                                &&
                                EXISTS {
                                    ?this nltl:grossTonnage ?tonnageQuantity .
                                    ?tonnageQuantity qudt:numericValue ?tonnageValue ;
                                                      qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                    FILTER (
                                        datatype(?tonnageValue) = xsd:decimal
                                        && ?tonnageValue >= 300
                                    )
                                }
                                &&
                                EXISTS {
                                    ?this nltl:engagedInTrade ?tradeStatus .
                                    FILTER (
                                        datatype(?tradeStatus) = xsd:boolean
                                        && ?tradeStatus = false
                                    )
                                }
                            )
                            ||
                            (
                                ?type = "cargo_ship"
                                &&
                                EXISTS {
                                    ?this nltl:grossTonnage ?cargoTonnageQuantity .
                                    ?cargoTonnageQuantity qudt:numericValue ?cargoTonnageValue ;
                                                           qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                    FILTER (
                                        datatype(?cargoTonnageValue) = xsd:decimal
                                        && ?cargoTonnageValue >= 300
                                        && ?cargoTonnageValue < 500
                                    )
                                }
                            )
                        )
                    )
                    AS ?expected
                )

                FILTER ((?actual = true) != ?expected)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26_016_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F01/ship> ] .

