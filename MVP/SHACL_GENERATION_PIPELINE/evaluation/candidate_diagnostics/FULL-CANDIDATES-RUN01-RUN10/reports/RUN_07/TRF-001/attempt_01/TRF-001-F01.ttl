@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "The 2021 Ice Class Regulations chapter 2 provision applies to every ship." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:iceClassDraughtChapter2Provision2021 ;
                    sh:message "The 2021 Ice Class Regulations chapter 2 provision applies to every ship." ;
                    sh:path nltl:applicableIceClassRegulatoryProvision ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "Ships contracted for construction on or after 5 July 2021 must identify the 2021 Ice Class Regulations edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ships contracted for construction on or after 5 July 2021 must identify the 2021 Ice Class Regulations edition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    YEAR(?date) > 2021 ||
                    (YEAR(?date) = 2021 && MONTH(?date) > 7) ||
                    (YEAR(?date) = 2021 && MONTH(?date) = 7 && DAY(?date) >= 5)
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRegulationEdition2021 .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF001ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "The 2021 Ice Class Regulations section 1.8 provision applies to every ship." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:iceClassSection1Point8Provision2021 ;
                    sh:message "The 2021 Ice Class Regulations section 1.8 provision applies to every ship." ;
                    sh:path nltl:applicableIceClassRegulatoryProvision ] ] .

