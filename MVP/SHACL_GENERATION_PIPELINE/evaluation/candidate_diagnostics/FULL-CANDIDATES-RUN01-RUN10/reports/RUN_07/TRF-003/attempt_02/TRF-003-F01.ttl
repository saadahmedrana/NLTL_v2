@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-003-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2019-01-01\", datatype=xsd:date) ; sh:minInclusive Literal(\"2012-01-01\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ], [ sh:in ( nltl:iceClassRegulationEdition2010 ) ; sh:message Literal(\"Ships contracted from 1 January 2012 through 31 December 2018 must identify the 2010 Ice Class Regulations.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:applicableIceClassRegulationEdition ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2012-01-01\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ] ] , [ sh:property [ sh:datatype xsd:date ; sh:minInclusive Literal(\"2019-01-01\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-003> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-003-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-003-F01/ship> ;
            sh:resultMessage "The ship must specify an allowed Finnish-Swedish ice class." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceClassValue ;
                    sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ;
                    sh:message "The ship must specify an allowed Finnish-Swedish ice class." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:iceClass ] ] .

