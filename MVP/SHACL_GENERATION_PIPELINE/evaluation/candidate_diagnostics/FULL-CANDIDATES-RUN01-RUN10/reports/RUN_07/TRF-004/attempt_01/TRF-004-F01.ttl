@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ;
            sh:resultMessage "For a ship contracted for construction on or after 1 January 2010 but before 1 January 2012, the applicable Ice Class regulation edition must be the 2008 edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a ship contracted for construction on or after 1 January 2010 but before 1 January 2012, the applicable Ice Class regulation edition must be the 2008 edition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    (
                        YEAR(?date) > 2010 ||
                        (YEAR(?date) = 2010 &&
                         (MONTH(?date) > 1 ||
                          (MONTH(?date) = 1 && DAY(?date) >= 1)))
                    )
                    &&
                    (
                        YEAR(?date) < 2012 ||
                        (YEAR(?date) = 2012 &&
                         (MONTH(?date) < 1 ||
                          (MONTH(?date) = 1 && DAY(?date) < 1)))
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                          nltl:iceClassRegulationEdition2008 .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF004Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ] .

