@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ;
            sh:resultMessage "For ships contracted on or after 2010-01-01 and before 2012-01-01, applicableIceClassRegulationEdition must have no value other than iceClassRegulationEdition2008." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ships contracted on or after 2010-01-01 and before 2012-01-01, applicableIceClassRegulationEdition must have no value other than iceClassRegulationEdition2008." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (datatype(?date) = xsd:date)
                FILTER (
                    (
                        YEAR(?date) > 2010
                        || (YEAR(?date) = 2010 && MONTH(?date) >= 1 && DAY(?date) >= 1)
                    )
                    && YEAR(?date) < 2012
                )
                $this nltl:applicableIceClassRegulationEdition ?edition .
                FILTER (?edition != nltl:iceClassRegulationEdition2008)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF004Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ;
            sh:resultMessage "For ships contracted on or after 2010-01-01 and before 2012-01-01, applicableIceClassRegulationEdition must be present as iceClassRegulationEdition2008." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ships contracted on or after 2010-01-01 and before 2012-01-01, applicableIceClassRegulationEdition must be present as iceClassRegulationEdition2008." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (datatype(?date) = xsd:date)
                FILTER (
                    (
                        YEAR(?date) > 2010
                        || (YEAR(?date) = 2010 && MONTH(?date) >= 1 && DAY(?date) >= 1)
                    )
                    && YEAR(?date) < 2012
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRegulationEdition2008 .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF004Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ] .

