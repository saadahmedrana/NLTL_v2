@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxExclusive Literal(\"1986-11-01\", datatype=xsd:date) ; sh:message Literal(\"Construction stage date must be before 1986-11-01 for the non-applicable cohort.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Construction stage date must be on or after 2003-09-01 for the non-applicable cohort.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2003-09-01\", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ] , [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The owner-request selector must be true when the 2008 engine-output edition is used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:ownerRequested2008EngineOutputRequirements ], [ sh:hasValue nltl:iceClassRegulationEdition2008 ; sh:message Literal(\"A true owner request requires the 2008 engine-output regulation edition.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:engineOutputRegulationEdition ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The owner-request selector must be false when the 1985 engine-output edition is used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:ownerRequested2008EngineOutputRequirements ], [ sh:hasValue nltl:iceClassRuleEdition1985 ; sh:message Literal(\"Without an owner request, the engine-output regulation edition must remain the 1985 edition.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:engineOutputRegulationEdition ] ] ) ; sh:property [ sh:datatype xsd:date ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxExclusive Literal(\"2003-09-01\", datatype=xsd:date) ; sh:message Literal(\"Construction stage date must identify the 1986-11-01 through 2003-08-31 cohort.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1986-11-01\", datatype=xsd:date) ; sh:path nltl:constructionStageDate ], [ sh:hasValue nltl:iceClassRuleEdition1985 ; sh:message Literal(\"Ships in the applicable cohort must use the 1985 ice-class rule edition.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:applicableIceClassRegulationEdition ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-006> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F01/ship> ] .

