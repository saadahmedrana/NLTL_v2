@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P04/ship> ;
            sh:resultMessage "The ship must have exactly one applicable ice class: IA Super or IA." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceClassValue ;
                    sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship must have exactly one applicable ice class: IA Super or IA." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:iceClass ] ;
            sh:value nltl:iceClassIb ] .

