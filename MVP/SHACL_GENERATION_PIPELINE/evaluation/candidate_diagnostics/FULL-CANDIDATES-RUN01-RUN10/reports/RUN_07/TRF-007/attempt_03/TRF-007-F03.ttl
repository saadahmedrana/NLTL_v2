@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:sparql [ sh:message Literal("The conditional requirement applies to ships of ice class IA or IA Super.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER (
                            ?iceClass = nltl:iceClassIa ||
                            ?iceClass = nltl:iceClassIaSuper
                        )
                    }
                ") ] ] , [ sh:property [ sh:class nltl:engineOutputComplianceMethodValue ; sh:in ( nltl:traficom2017Section3Point2Point2Method nltl:traficom2017Section3Point2Point4Method ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An applicable ship must identify exactly one permitted 2017 Ice Class Regulations compliance method.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:engineOutputComplianceMethod ], [ sh:class nltl:iceClassValue ; sh:in ( nltl:iceClassIa nltl:iceClassIaSuper ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An applicable ship must have exactly one ice class, IA or IA Super.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:datatype xsd:date ; sh:message Literal("An applicable ship must provide its assessment date.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:assessmentDate ], [ sh:datatype xsd:date ; sh:message Literal("An applicable ship must provide its construction-stage date.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:datatype xsd:date ; sh:message Literal("An applicable ship must provide its delivery date.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:deliveryDate ] ; sh:sparql [ sh:message Literal("For an applicable ship, the construction stage must precede 1 September 2003 and the assessment date must not be later than 1 January in the year twenty years after delivery.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:constructionStageDate ?constructionDate ;
                                  nltl:deliveryDate ?deliveryDate ;
                                  nltl:assessmentDate ?assessmentDate .
                            FILTER (
                                (
                                    YEAR(?constructionDate) < 2003 ||
                                    (
                                        YEAR(?constructionDate) = 2003 &&
                                        (
                                            MONTH(?constructionDate) < 9 ||
                                            (
                                                MONTH(?constructionDate) = 9 &&
                                                DAY(?constructionDate) < 1
                                            )
                                        )
                                    )
                                )
                                &&
                                (
                                    YEAR(?assessmentDate) < YEAR(?deliveryDate) + 20 ||
                                    (
                                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                                        MONTH(?assessmentDate) = 1 &&
                                        DAY(?assessmentDate) <= 1
                                    )
                                )
                            )
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-007> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-F03/ship> ] .

