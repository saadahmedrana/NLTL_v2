@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An applicable ship must have exactly one assessment date.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:assessmentDate ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An applicable ship must have exactly one construction stage date.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An applicable ship must have exactly one delivery date.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:deliveryDate ], [ sh:in ( nltl:iceClassIa nltl:iceClassIaSuper ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An applicable ship must have exactly one ice class: IA or IA Super.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:in ( nltl:traficom2017Section3Point2Point2Method nltl:traficom2017Section3Point2Point4Method ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An applicable ship must have exactly one permitted 2017 Ice Class Regulations compliance method.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:engineOutputComplianceMethod ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("The construction stage must precede 1 September 2003, and assessment must not be later than 1 January of the year twenty years after delivery.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionStageDate ?constructionDate ;
          nltl:deliveryDate ?deliveryDate ;
          nltl:assessmentDate ?assessmentDate .
    FILTER (
        YEAR(?constructionDate) > 2003
        || (
            YEAR(?constructionDate) = 2003
            && (
                MONTH(?constructionDate) > 9
                || (
                    MONTH(?constructionDate) = 9
                    && DAY(?constructionDate) >= 1
                )
            )
        )
        || YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20
        || (
            YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20
            && (
                MONTH(?assessmentDate) > 1
                || (
                    MONTH(?assessmentDate) = 1
                    && DAY(?assessmentDate) > 1
                )
            )
        )
    )
}
") ] ] , [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A non-applicable ship must have exactly one supplied ice class outside IA and IA Super.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-007> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P02/ship> ] .

