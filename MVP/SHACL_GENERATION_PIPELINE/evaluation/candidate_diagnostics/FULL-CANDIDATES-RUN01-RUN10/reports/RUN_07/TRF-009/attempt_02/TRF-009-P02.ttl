@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-P02/ship> ;
            sh:resultMessage "The assessment date must be no later than 1 January of the year twenty years after delivery." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The assessment date must be no later than 1 January of the year twenty years after delivery." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?ice ;
          nltl:constructionStageDate ?constructionDate ;
          nltl:deliveryDate ?deliveryDate ;
          nltl:assessmentDate ?assessmentDate .
    FILTER (
        ?ice = nltl:iceClassIaSuper ||
        ?ice = nltl:iceClassIa
    )
    FILTER (
        YEAR(?constructionDate) < 2003 ||
        (
            YEAR(?constructionDate) = 2003 &&
            (
                MONTH(?constructionDate) < 9 ||
                (MONTH(?constructionDate) = 9 && DAY(?constructionDate) < 1)
            )
        )
    )
    FILTER (
        YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20 ||
        (
            YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
            (
                MONTH(?assessmentDate) > 1 ||
                (
                    MONTH(?assessmentDate) = 1 &&
                    DAY(?assessmentDate) > 1
                )
            )
        )
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF009Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-P02/ship> ] .

