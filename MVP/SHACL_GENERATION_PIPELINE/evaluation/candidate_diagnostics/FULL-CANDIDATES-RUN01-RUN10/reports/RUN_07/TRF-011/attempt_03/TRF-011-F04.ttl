@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/upperIceWaterline> ;
                    sh:resultMessage "Each waterline used for UIWL validation must provide waterline profile points." ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:waterlineProfilePoint ;
                            sh:message "Each waterline used for UIWL validation must provide waterline profile points." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:TRF-011-ProfilePointShape> ;
                            sh:path nltl:hasWaterlineProfilePoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ;
            sh:resultMessage "The ship must identify the upper ice waterline used for UIWL envelope validation." ;
            sh:resultPath nltl:hasUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:message "The ship must identify the upper ice waterline used for UIWL envelope validation." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-011-IceWaterlineShape> ;
                    sh:path nltl:hasUpperIceWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/upperIceWaterline> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ;
            sh:resultMessage "The upper ice waterline must contain, at every intended waterline longitudinal position, the maximum intended vertical coordinate within tolerance, and it must not contain points at positions absent from the intended waterlines." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The upper ice waterline must contain, at every intended waterline longitudinal position, the maximum intended vertical coordinate within tolerance, and it must not contain points at positions absent from the intended waterlines." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?position ?expectedVertical ?minUpper ?maxUpper ?extraPosition
            WHERE {
                {
                    {
                        SELECT $this ?position
                               (MAX(?intendedVertical) AS ?expectedVertical)
                               (MIN(?upperVertical) AS ?minUpper)
                               (MAX(?upperVertical) AS ?maxUpper)
                        WHERE {
                            $this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
                            ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
                            ?intendedPoint nltl:longitudinalPosition ?intendedPositionValue ;
                                           nltl:verticalCoordinate ?intendedVerticalValue .
                            ?intendedPositionValue qudt:numericValue ?position .
                            ?intendedVerticalValue qudt:numericValue ?intendedVertical .

                            OPTIONAL {
                                $this nltl:hasUpperIceWaterline ?upperWaterline .
                                ?upperWaterline nltl:hasWaterlineProfilePoint ?upperPoint .
                                ?upperPoint nltl:longitudinalPosition ?upperPositionValue ;
                                            nltl:verticalCoordinate ?upperVerticalValue .
                                ?upperPositionValue qudt:numericValue ?upperPosition .
                                ?upperVerticalValue qudt:numericValue ?upperVertical .
                                FILTER(?upperPosition = ?position)
                            }
                        }
                        GROUP BY $this ?position
                    }

                    FILTER(
                        !BOUND(?minUpper) ||
                        ?minUpper < (
                            ?expectedVertical -
                            (ABS(?expectedVertical) * 0.000001 + 0.000000001)
                        ) ||
                        ?maxUpper > (
                            ?expectedVertical +
                            (ABS(?expectedVertical) * 0.000001 + 0.000000001)
                        )
                    )
                }

                UNION

                {
                    $this nltl:hasUpperIceWaterline ?upperWaterline .
                    ?upperWaterline nltl:hasWaterlineProfilePoint ?upperPoint .
                    ?upperPoint nltl:longitudinalPosition ?extraPositionValue .
                    ?extraPositionValue qudt:numericValue ?extraPosition .

                    FILTER NOT EXISTS {
                        $this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
                        ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
                        ?intendedPoint nltl:longitudinalPosition ?intendedPositionValue .
                        ?intendedPositionValue qudt:numericValue ?intendedPosition .
                        FILTER(?intendedPosition = ?extraPosition)
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-011-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ] .

