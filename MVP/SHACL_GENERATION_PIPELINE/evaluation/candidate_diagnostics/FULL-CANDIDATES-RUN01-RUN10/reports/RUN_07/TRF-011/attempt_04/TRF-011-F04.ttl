@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ;
            sh:resultMessage "The upper ice waterline must contain exactly the envelope of the highest intended ice-operating waterline points at every longitudinal position." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The upper ice waterline must contain exactly the envelope of the highest intended ice-operating waterline points at every longitudinal position." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  {
    SELECT $this ?position
           (MAX(?intendedVertical) AS ?expectedVertical)
           (MIN(?upperVertical) AS ?upperMinimum)
           (MAX(?upperVertical) AS ?upperMaximum)
    WHERE {
      {
        $this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
        ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
        ?intendedPoint nltl:longitudinalPosition ?intendedPositionValue ;
                        nltl:verticalCoordinate ?intendedVerticalValue .
        ?intendedPositionValue qudt:numericValue ?position ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
        ?intendedVerticalValue qudt:numericValue ?intendedVertical ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
        FILTER (
          DATATYPE(?position) = xsd:decimal &&
          DATATYPE(?intendedVertical) = xsd:decimal
        )
      }
      UNION
      {
        $this nltl:hasUpperIceWaterline ?upperWaterline .
        ?upperWaterline nltl:hasWaterlineProfilePoint ?upperPoint .
        ?upperPoint nltl:longitudinalPosition ?upperPositionValue ;
                    nltl:verticalCoordinate ?upperVerticalValue .
        ?upperPositionValue qudt:numericValue ?position ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
        ?upperVerticalValue qudt:numericValue ?upperVertical ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
        FILTER (
          DATATYPE(?position) = xsd:decimal &&
          DATATYPE(?upperVertical) = xsd:decimal
        )
      }
    }
    GROUP BY $this ?position
  }
  BIND(
    ABS(?expectedVertical) * 0.000001 + 0.000000001
    AS ?tolerance
  )
  FILTER (
    !BOUND(?expectedVertical) ||
    !BOUND(?upperMinimum) ||
    !BOUND(?upperMaximum) ||
    ?upperMinimum < (?expectedVertical - ?tolerance) ||
    ?upperMaximum > (?expectedVertical + ?tolerance)
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF011ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/upperIceWaterline> ;
                    sh:resultMessage "Less than 1 values on ex:upperIceWaterline->nltl:hasWaterlineProfilePoint" ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:waterlineProfilePoint ;
                            sh:minCount 1 ;
                            sh:node gen:TRF011ProfilePointShape ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:hasWaterlineProfilePoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF011IceWaterlineShape. See details for more information." ;
            sh:resultPath nltl:hasUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:minCount 1 ;
                    sh:node gen:TRF011IceWaterlineShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasUpperIceWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/upperIceWaterline> ] .

