@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/lowerPoint> ;
            sh:resultMessage "Each waterline profile point must carry a vertical coordinate in metres." ;
            sh:resultPath nltl:verticalCoordinate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n72c0c5ea32c74efd806165df5c265dd0b8 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/lowerPoint> ;
                    sh:resultMessage "Each waterline profile point must carry a vertical coordinate in metres." ;
                    sh:resultPath nltl:verticalCoordinate ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n72c0c5ea32c74efd806165df5c265dd0b8 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/lowerIceWaterline> ;
            sh:resultMessage "Each represented ice waterline must have at least one profile point." ;
            sh:resultPath nltl:hasWaterlineProfilePoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n72c0c5ea32c74efd806165df5c265dd0b3 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/lowerPoint> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/lowerPoint> ;
                            sh:resultMessage "Each waterline profile point must carry a vertical coordinate in metres." ;
                            sh:resultPath nltl:verticalCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n72c0c5ea32c74efd806165df5c265dd0b8 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/lowerIceWaterline> ;
                    sh:resultMessage "Each represented ice waterline must have at least one profile point." ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n72c0c5ea32c74efd806165df5c265dd0b3 ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/lowerPoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/ship> ;
            sh:resultMessage "The ship must represent the externally determined lower ice waterline with profile points." ;
            sh:resultPath nltl:hasLowerIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:message "The ship must represent the externally determined lower ice waterline with profile points." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF012IceWaterlineShape ;
                    sh:path nltl:hasLowerIceWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/lowerIceWaterline> ] .

_:N6cf191cf8ddc47578da31c0bf146be99 sh:datatype xsd:decimal ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:Nd1b11343db02467f906122e4bd339ec2 sh:property _:N6cf191cf8ddc47578da31c0bf146be99,
        [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:n72c0c5ea32c74efd806165df5c265dd0b3 sh:class nltl:waterlineProfilePoint ;
    sh:message "Each represented ice waterline must have at least one profile point." ;
    sh:minCount 1 ;
    sh:node gen:TRF012ProfilePointShape ;
    sh:path nltl:hasWaterlineProfilePoint .

_:n72c0c5ea32c74efd806165df5c265dd0b8 sh:message "Each waterline profile point must carry a vertical coordinate in metres." ;
    sh:minCount 1 ;
    sh:node _:Nd1b11343db02467f906122e4bd339ec2 ;
    sh:path nltl:verticalCoordinate .

