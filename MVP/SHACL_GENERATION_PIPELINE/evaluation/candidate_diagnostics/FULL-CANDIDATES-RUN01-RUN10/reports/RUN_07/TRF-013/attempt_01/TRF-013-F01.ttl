@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-F01/ship> ;
            sh:resultMessage "The operating fore and aft draughts must each be between their corresponding minimum and maximum ice class draughts." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The operating fore and aft draughts must each be between their corresponding minimum and maximum ice class draughts." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipIceStrengthened true ;
                      nltl:operatingForeDraught ?of ;
                      nltl:operatingAftDraught ?oa ;
                      nltl:maximumIceClassDraughtFore ?maxf ;
                      nltl:maximumIceClassDraughtAft ?maxa ;
                      nltl:minimumIceClassDraughtFore ?minf ;
                      nltl:minimumIceClassDraughtAft ?mina .
                ?of qudt:numericValue ?ofv .
                ?oa qudt:numericValue ?oav .
                ?maxf qudt:numericValue ?maxfv .
                ?maxa qudt:numericValue ?maxav .
                ?minf qudt:numericValue ?minfv .
                ?mina qudt:numericValue ?minav .
                FILTER (
                    ?ofv < ?minfv ||
                    ?ofv > ?maxfv ||
                    ?oav < ?minav ||
                    ?oav > ?maxav
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF013Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-F01/ship> ] .

