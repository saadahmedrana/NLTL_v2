@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "Node ex:ship->nltl:readilyAvailableToMaster does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n240c48db221441ad9fd6a73bd7f649bab15 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "The required ice-class marking evidence is missing or inconsistent with the construction date, assessment date, and draught condition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The required ice-class marking evidence is missing or inconsistent with the construction date, assessment date, and draught condition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:assessmentDate ?assessment .
                $this nltl:constructionDate ?construction .
                $this nltl:summerLoadLineFreshWaterDraught ?summerNode .
                $this nltl:upperIceWaterlineDraught ?upperNode .
                ?summerNode qudt:numericValue ?summer .
                ?upperNode qudt:numericValue ?upper .
                FILTER (
                    (
                        ?construction >= "2007-07-01"^^xsd:date &&
                        ?summer > ?upper &&
                        !EXISTS {
                            $this nltl:warningTrianglePresent true .
                            $this nltl:iceClassDraughtMarkPresent true .
                            $this nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                            ?markNode qudt:numericValue ?markValue .
                            ?markNode qudt:unit <http://qudt.org/vocab/unit/M> .
                            $this nltl:hasClassCertificate ?certificate .
                            ?certificate nltl:maximumIceClassDraughtAmidships ?certificateNode .
                            ?certificateNode qudt:numericValue ?certificateValue .
                            ?certificateNode qudt:unit <http://qudt.org/vocab/unit/M> .
                            FILTER (?markValue = ?certificateValue)
                        }
                    )
                    ||
                    (
                        ?construction < "2007-07-01"^^xsd:date &&
                        !EXISTS {
                            $this nltl:warningTrianglePresent true .
                            $this nltl:iceClassDraughtMarkPresent true .
                            $this nltl:iceClassDraughtMarkDraughtAmidships ?markNode2 .
                            ?markNode2 qudt:numericValue ?markValue2 .
                            ?markNode2 qudt:unit <http://qudt.org/vocab/unit/M> .
                            $this nltl:hasClassCertificate ?certificate2 .
                            ?certificate2 nltl:maximumIceClassDraughtAmidships ?certificateNode2 .
                            ?certificateNode2 qudt:numericValue ?certificateValue2 .
                            ?certificateNode2 qudt:unit <http://qudt.org/vocab/unit/M> .
                            FILTER (?markValue2 = ?certificateValue2)
                        } &&
                        (
                            !EXISTS {
                                $this nltl:firstScheduledDryDockingDate ?firstDocking .
                            }
                            ||
                            EXISTS {
                                $this nltl:firstScheduledDryDockingDate ?firstDockingAfter .
                                FILTER (?firstDockingAfter > ?assessment)
                            }
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-014-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:readilyAvailableToMaster" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n240c48db221441ad9fd6a73bd7f649bab15 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:retainedOnBoard" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n240c48db221441ad9fd6a73bd7f649bab14 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "Node ex:ship->nltl:retainedOnBoard does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n240c48db221441ad9fd6a73bd7f649bab14 ] .

_:n240c48db221441ad9fd6a73bd7f649bab14 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

_:n240c48db221441ad9fd6a73bd7f649bab15 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

