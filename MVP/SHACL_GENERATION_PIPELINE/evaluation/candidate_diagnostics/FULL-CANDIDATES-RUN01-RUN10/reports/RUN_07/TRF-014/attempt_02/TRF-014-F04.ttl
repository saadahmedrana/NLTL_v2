@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Node ex:ship->nltl:retainedOnBoard does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nd78b997e91da4b3287126d4f6e373513b23 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:readilyAvailableToMaster" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd78b997e91da4b3287126d4f6e373513b24 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:retainedOnBoard" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd78b997e91da4b3287126d4f6e373513b23 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "When the applicable ice-draught marking condition is reached, complete marking evidence is required; for a pre-2007 ship without complete marking, the first scheduled dry docking date is required and the marking is due when that date is on or before the assessment date." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the applicable ice-draught marking condition is reached, complete marking evidence is required; for a pre-2007 ship without complete marking, the first scheduled dry docking date is required and the marking is due when that date is on or before the assessment date." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:constructionDate ?construction ;
          nltl:assessmentDate ?assessment ;
          nltl:summerLoadLineFreshWaterDraught ?summerNode ;
          nltl:upperIceWaterlineDraught ?uiwlNode .
    ?summerNode qudt:numericValue ?summerValue .
    ?uiwlNode qudt:numericValue ?uiwlValue .
    FILTER (
        (
            ?construction >= "2007-07-01"^^xsd:date &&
            ?summerValue > ?uiwlValue &&
            NOT EXISTS {
                $this nltl:warningTrianglePresent true ;
                      nltl:iceClassDraughtMarkPresent true ;
                      nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                ?markNode qudt:numericValue ?markValue ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (datatype(?markValue) = xsd:decimal)
            }
        )
        ||
        (
            ?construction < "2007-07-01"^^xsd:date &&
            ?summerValue > ?uiwlValue &&
            NOT EXISTS {
                $this nltl:warningTrianglePresent true ;
                      nltl:iceClassDraughtMarkPresent true ;
                      nltl:iceClassDraughtMarkDraughtAmidships ?preMarkNode .
                ?preMarkNode qudt:numericValue ?preMarkValue ;
                             qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (datatype(?preMarkValue) = xsd:decimal)
            } &&
            (
                NOT EXISTS {
                    $this nltl:firstScheduledDryDockingDate ?docking
                }
                ||
                EXISTS {
                    $this nltl:firstScheduledDryDockingDate ?dueDate .
                    FILTER (?dueDate <= ?assessment)
                }
            )
        )
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-014> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Node ex:ship->nltl:readilyAvailableToMaster does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nd78b997e91da4b3287126d4f6e373513b24 ] .

_:nd78b997e91da4b3287126d4f6e373513b23 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

_:nd78b997e91da4b3287126d4f6e373513b24 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

