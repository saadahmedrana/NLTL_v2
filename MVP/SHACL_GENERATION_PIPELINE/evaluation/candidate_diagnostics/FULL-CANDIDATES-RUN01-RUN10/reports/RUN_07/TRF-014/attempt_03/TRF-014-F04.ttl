@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:readilyAvailableToMaster" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n7b0a2bee90184bbe94319455769944d8b47 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:retainedOnBoard" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n7b0a2bee90184bbe94319455769944d8b46 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Node ex:ship->nltl:retainedOnBoard does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n7b0a2bee90184bbe94319455769944d8b46 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Required ice-class marking evidence is missing for the applicable date and draught condition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Required ice-class marking evidence is missing for the applicable date and draught condition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:assessmentDate ?assessment ;
                      nltl:constructionDate ?construction ;
                      nltl:summerLoadLineFreshWaterDraught ?summerNode ;
                      nltl:upperIceWaterlineDraught ?upperNode .

                ?summerNode qudt:numericValue ?summer ;
                            qudt:unit unit:M .
                ?upperNode qudt:numericValue ?upper ;
                           qudt:unit unit:M .

                FILTER (
                    (
                        ?construction >= "2007-07-01"^^xsd:date &&
                        ?summer > ?upper &&
                        (
                            !EXISTS { $this nltl:warningTrianglePresent true } ||
                            !EXISTS { $this nltl:iceClassDraughtMarkPresent true } ||
                            !EXISTS {
                                $this nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                                ?markNode qudt:numericValue ?mark ;
                                          qudt:unit unit:M
                            }
                        )
                    )
                    ||
                    (
                        ?construction < "2007-07-01"^^xsd:date &&
                        (
                            !EXISTS { $this nltl:warningTrianglePresent true } ||
                            !EXISTS { $this nltl:iceClassDraughtMarkPresent true } ||
                            !EXISTS {
                                $this nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                                ?markNode qudt:numericValue ?mark ;
                                          qudt:unit unit:M
                            }
                        ) &&
                        (
                            !EXISTS { $this nltl:firstScheduledDryDockingDate ?docking } ||
                            EXISTS {
                                $this nltl:firstScheduledDryDockingDate ?docking .
                                FILTER ( ?docking <= ?assessment )
                            }
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF014Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F04/ship> ;
            sh:resultMessage "Node ex:ship->nltl:readilyAvailableToMaster does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n7b0a2bee90184bbe94319455769944d8b47 ] .

_:n7b0a2bee90184bbe94319455769944d8b46 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

_:n7b0a2bee90184bbe94319455769944d8b47 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

