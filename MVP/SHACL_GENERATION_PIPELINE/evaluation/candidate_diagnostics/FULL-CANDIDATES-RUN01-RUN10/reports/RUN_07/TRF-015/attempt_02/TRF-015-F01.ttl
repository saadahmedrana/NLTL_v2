@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F01/ship> ;
            sh:resultMessage "When navigating in ice, operating draught and operating trim must not exceed the upper ice waterline draught." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When navigating in ice, operating draught and operating trim must not exceed the upper ice waterline draught." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:navigatingInIce true ;
          nltl:operatingDraught ?draught ;
          nltl:operatingTrim ?trim ;
          nltl:upperIceWaterlineDraught ?uiwl .
    ?draught qudt:numericValue ?draughtValue .
    ?trim qudt:numericValue ?trimValue .
    ?uiwl qudt:numericValue ?uiwlValue .
    FILTER (
        ?draughtValue > ?uiwlValue ||
        ?trimValue > ?uiwlValue
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-015-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F01/ship> ] .

