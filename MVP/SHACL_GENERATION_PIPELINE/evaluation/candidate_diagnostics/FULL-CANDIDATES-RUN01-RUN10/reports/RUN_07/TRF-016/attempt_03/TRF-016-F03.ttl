@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:liwlDraughtAmidships" ;
            sh:resultPath nltl:liwlDraughtAmidships ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-016-LengthQuantityShape> ;
                    sh:path nltl:liwlDraughtAmidships ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:navigatingInIce ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:propellerHighestPointSubmerged ] ; sh:sparql [ sh:message Literal("Displacement at the UIWL must equal the ship waterline displacement.") ; sh:select Literal("
                    SELECT $this
                    WHERE {
                        $this <https://w3id.org/nltl/vocab#displacementAtUpperIceWaterline> ?uiwlNode ;
                              <https://w3id.org/nltl/vocab#waterlineDisplacement> ?waterlineNode .
                        ?uiwlNode <http://qudt.org/schema/qudt/numericValue> ?uiwl .
                        ?waterlineNode <http://qudt.org/schema/qudt/numericValue> ?waterline .
                        FILTER (?uiwl != ?waterline)
                    }
                ") ], [ sh:message Literal("Forward draught must meet the level-ice-thickness formula using UIWL displacement.") ; sh:select Literal("
                    SELECT $this
                    WHERE {
                        $this <https://w3id.org/nltl/vocab#forwardDraught> ?forwardNode ;
                              <https://w3id.org/nltl/vocab#displacementAtUpperIceWaterline> ?displacementNode ;
                              <https://w3id.org/nltl/vocab#levelIceThickness> ?thicknessNode .
                        ?forwardNode <http://qudt.org/schema/qudt/numericValue> ?forward .
                        ?displacementNode <http://qudt.org/schema/qudt/numericValue> ?displacement .
                        ?thicknessNode <http://qudt.org/schema/qudt/numericValue> ?thickness .
                        BIND ((2 + (0.00025 * ?displacement)) * ?thickness AS ?uncapped)
                        BIND (4 * ?thickness AS ?cap)
                        BIND (IF(?uncapped < ?cap, ?uncapped, ?cap) AS ?minimum)
                        FILTER (?forward < ?minimum)
                    }
                ") ], [ sh:message Literal("When navigating in ice, draught amidships must be at least the LIWL draught amidships.") ; sh:select Literal("
                    SELECT $this
                    WHERE {
                        $this <https://w3id.org/nltl/vocab#draughtAmidships> ?draughtNode ;
                              <https://w3id.org/nltl/vocab#liwlDraughtAmidships> ?liwlNode .
                        ?draughtNode <http://qudt.org/schema/qudt/numericValue> ?draught .
                        ?liwlNode <http://qudt.org/schema/qudt/numericValue> ?liwl .
                        FILTER (?draught < ?liwl)
                    }
                ") ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:navigatingInIce ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-016-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:waterlineDisplacement" ;
            sh:resultPath nltl:waterlineDisplacement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-016-MassQuantityShape> ;
                    sh:path nltl:waterlineDisplacement ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:displacementAtUpperIceWaterline" ;
            sh:resultPath nltl:displacementAtUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-016-MassQuantityShape> ;
                    sh:path nltl:displacementAtUpperIceWaterline ] ] .

