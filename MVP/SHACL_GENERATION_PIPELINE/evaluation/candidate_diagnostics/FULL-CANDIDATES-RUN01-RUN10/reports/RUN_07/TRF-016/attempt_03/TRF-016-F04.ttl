@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:liwlDraughtAmidships" ;
            sh:resultPath nltl:liwlDraughtAmidships ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-016-LengthQuantityShape> ;
                    sh:path nltl:liwlDraughtAmidships ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:displacementAtUpperIceWaterline" ;
            sh:resultPath nltl:displacementAtUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-016-MassQuantityShape> ;
                    sh:path nltl:displacementAtUpperIceWaterline ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F04/ballastTank> ;
            sh:resultMessage "A ballast tank situated above the LIWL and needed to reach it must have freezing prevention." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A ballast tank situated above the LIWL and needed to reach it must have freezing prevention." ;
                    sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl/vocab#situatedAboveLowerIceWaterline> true ;
                      <https://w3id.org/nltl/vocab#usedToReachLowerIceWaterline> true .
                FILTER NOT EXISTS {
                    $this <https://w3id.org/nltl/vocab#freezingPreventionPresent> true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-016-BallastTankShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F04/ballastTank> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:waterlineDisplacement" ;
            sh:resultPath nltl:waterlineDisplacement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-016-MassQuantityShape> ;
                    sh:path nltl:waterlineDisplacement ] ] .

