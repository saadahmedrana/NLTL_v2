@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F01/ship> ;
            sh:resultMessage "When propulsion output is unrestricted, the maximum continuous rating must equal machinery output plus additional propulsion power within a relative tolerance of 1e-6 and an absolute fallback of 1e-6 kW." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When propulsion output is unrestricted, the maximum continuous rating must equal machinery output plus additional propulsion power within a relative tolerance of 1e-6 and an absolute fallback of 1e-6 kW." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies false ;
                      nltl:maximumContinuousRatingPower ?maxNode ;
                      nltl:propulsionMachineryContinuousOutput ?machNode ;
                      nltl:additionalPropulsionPower ?addNode .
                ?maxNode qudt:numericValue ?max .
                ?machNode qudt:numericValue ?mach .
                ?addNode qudt:numericValue ?add .
                BIND((?mach + ?add) AS ?expected)
                BIND((ABS(?expected) * 0.000001 + 0.000001) AS ?tolerance)
                FILTER(
                    (?max < (?expected - ?tolerance)) ||
                    (?max > (?expected + ?tolerance))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_017_Static> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F01/ship> ] .

