@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F01/ship> ;
            sh:resultMessage "When propulsion output is unrestricted, maximum continuous rating power must equal propulsion machinery continuous output plus additional propulsion power within the permitted numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When propulsion output is unrestricted, maximum continuous rating power must equal propulsion machinery continuous output plus additional propulsion power within the permitted numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies false ;
                      nltl:maximumContinuousRatingPower ?pNode ;
                      nltl:propulsionMachineryContinuousOutput ?mNode ;
                      nltl:additionalPropulsionPower ?aNode .
                ?pNode qudt:numericValue ?p ;
                       qudt:unit unit:KiloW .
                ?mNode qudt:numericValue ?m ;
                       qudt:unit unit:KiloW .
                ?aNode qudt:numericValue ?a ;
                       qudt:unit unit:KiloW .
                BIND((?m + ?a) AS ?expected)
                BIND(IF((ABS(?expected) * 0.000001) > 0.000001,
                        ABS(?expected) * 0.000001,
                        0.000001) AS ?tolerance)
                FILTER(
                    ?p < (?expected - ?tolerance) ||
                    ?p > (?expected + ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-017> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F01/ship> ] .

