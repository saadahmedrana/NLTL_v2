@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P04/ship> ;
            sh:resultMessage "Maximum continuous rating power does not satisfy the applicable total-output or restricted-output equality." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Maximum continuous rating power does not satisfy the applicable total-output or restricted-output equality." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies ?applies ;
                      nltl:maximumContinuousRatingPower ?mcrNode ;
                      nltl:propulsionMachineryContinuousOutput ?machineryNode ;
                      nltl:additionalPropulsionPower ?additionalNode ;
                      nltl:restrictedPropulsionOutput ?restrictedNode .

                ?mcrNode qudt:numericValue ?mcr .
                ?machineryNode qudt:numericValue ?machinery .
                ?additionalNode qudt:numericValue ?additional .
                ?restrictedNode qudt:numericValue ?restricted .

                BIND((?machinery + ?additional) AS ?expected)
                BIND(IF(?expected < 0, -?expected, ?expected) AS ?absoluteExpected)
                BIND(
                    IF(
                        (?absoluteExpected * "0.000001"^^xsd:decimal) > "0.000001"^^xsd:decimal,
                        (?absoluteExpected * "0.000001"^^xsd:decimal),
                        "0.000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )

                FILTER(
                    (
                        ?applies = false &&
                        (
                            ?mcr < (?expected - ?tolerance) ||
                            ?mcr > (?expected + ?tolerance)
                        )
                    ) ||
                    (
                        ?applies = true &&
                        ?mcr != ?restricted
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF_017_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P04/ship> ] .

