@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:in ( nltl:iceClassRuleEdition1985 ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:applicableIceClassRegulationEdition ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloW> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:maximumContinuousRatingPower ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloW> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:requiredPowerUnder1985Rules ] ; sh:sparql [ sh:message Literal("For ice class IB or IC under the 1985 ice class regulations, maximum continuous rating power must be at least the required power under the 1985 rules.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:maximumContinuousRatingPower ?mcrNode .
                        ?mcrNode qudt:numericValue ?mcrValue .
                        $this nltl:requiredPowerUnder1985Rules ?requiredNode .
                        ?requiredNode qudt:numericValue ?requiredValue .
                        FILTER (?mcrValue < ?requiredValue)
                    }
                ") ] ] , [ sh:property [ sh:in ( nltl:iceClassIa nltl:iceClassIaSuper nltl:iceClassIi nltl:iceClassIii ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:in ( nltl:iceClassRegulationEdition2002 nltl:iceClassRegulationEdition2008 nltl:iceClassRegulationEdition2010 nltl:iceClassRegulationEdition2017 nltl:iceClassRegulationEdition2021 ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:applicableIceClassRegulationEdition ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-023> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F03/ship> ] .

