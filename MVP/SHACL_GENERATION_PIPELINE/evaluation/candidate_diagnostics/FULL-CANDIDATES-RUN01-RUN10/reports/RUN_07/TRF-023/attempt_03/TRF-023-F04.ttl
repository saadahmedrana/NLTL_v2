@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/ship> ;
            sh:resultMessage "For a ship of ice class IB or IC governed by the 1985 ice class regulations, maximum continuous rating power must be provided exactly once in kW and be at least the required power under the 1985 rules." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a ship of ice class IB or IC governed by the 1985 ice class regulations, maximum continuous rating power must be provided exactly once in kW and be at least the required power under the 1985 rules." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:applicableIceClassRegulationEdition ?edition .

                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                    &&
                    ?edition = nltl:iceClassRuleEdition1985
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:maximumContinuousRatingPower ?maximumPower .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:requiredPowerUnder1985Rules ?requiredPower .
                    }
                    ||
                    EXISTS {
                        $this nltl:maximumContinuousRatingPower ?maximumPower1, ?maximumPower2 .
                        FILTER (?maximumPower1 != ?maximumPower2)
                    }
                    ||
                    EXISTS {
                        $this nltl:requiredPowerUnder1985Rules ?requiredPower1, ?requiredPower2 .
                        FILTER (?requiredPower1 != ?requiredPower2)
                    }
                    ||
                    EXISTS {
                        $this nltl:maximumContinuousRatingPower ?maximumPower .
                        ?maximumPower qudt:numericValue ?maximumValue1, ?maximumValue2 .
                        FILTER (?maximumValue1 != ?maximumValue2)
                    }
                    ||
                    EXISTS {
                        $this nltl:requiredPowerUnder1985Rules ?requiredPower .
                        ?requiredPower qudt:numericValue ?requiredValue1, ?requiredValue2 .
                        FILTER (?requiredValue1 != ?requiredValue2)
                    }
                    ||
                    EXISTS {
                        $this nltl:maximumContinuousRatingPower ?maximumPower .
                        ?maximumPower qudt:unit ?maximumUnit1, ?maximumUnit2 .
                        FILTER (?maximumUnit1 != ?maximumUnit2)
                    }
                    ||
                    EXISTS {
                        $this nltl:requiredPowerUnder1985Rules ?requiredPower .
                        ?requiredPower qudt:unit ?requiredUnit1, ?requiredUnit2 .
                        FILTER (?requiredUnit1 != ?requiredUnit2)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:maximumContinuousRatingPower ?maximumPower ;
                              nltl:requiredPowerUnder1985Rules ?requiredPower .

                        ?maximumPower qudt:numericValue ?maximumValue ;
                                       qudt:unit qudt:KiloW .

                        ?requiredPower qudt:numericValue ?requiredValue ;
                                       qudt:unit qudt:KiloW .

                        FILTER (
                            datatype(?maximumValue) = xsd:decimal
                            &&
                            datatype(?requiredValue) = xsd:decimal
                            &&
                            ?maximumValue >= ?requiredValue
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-023-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/ship> ] .

