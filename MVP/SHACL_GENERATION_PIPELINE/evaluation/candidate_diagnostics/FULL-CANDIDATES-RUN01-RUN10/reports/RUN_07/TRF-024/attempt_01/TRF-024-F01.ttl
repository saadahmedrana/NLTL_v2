@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-F01/ship> ;
            sh:resultMessage "For ice class IA or IA Super, a ship constructed before 1 September 2003 must have valid construction, delivery, and assessment dates, use the section 3.2.2 compliance method, and comply by 1 January of the year twenty years after delivery." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ice class IA or IA Super, a ship constructed before 1 September 2003 must have valid construction, delivery, and assessment dates, use the section 3.2.2 compliance method, and comply by 1 January of the year twenty years after delivery." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass = nltl:iceClassIa ||
                    ?iceClass = nltl:iceClassIaSuper
                )
                FILTER (
                    !EXISTS {
                        $this nltl:constructionStageDate ?constructionDate .
                        FILTER (DATATYPE(?constructionDate) = xsd:date)
                    }
                    ||
                    (
                        EXISTS {
                            $this nltl:constructionStageDate ?applicabilityDate .
                            FILTER (DATATYPE(?applicabilityDate) = xsd:date)
                            FILTER (
                                YEAR(?applicabilityDate) < 2003 ||
                                (
                                    YEAR(?applicabilityDate) = 2003 &&
                                    (
                                        MONTH(?applicabilityDate) < 9 ||
                                        (
                                            MONTH(?applicabilityDate) = 9 &&
                                            DAY(?applicabilityDate) < 1
                                        )
                                    )
                                )
                            )
                        }
                        &&
                        (
                            !EXISTS {
                                $this nltl:deliveryDate ?deliveryDate .
                                FILTER (DATATYPE(?deliveryDate) = xsd:date)
                            }
                            ||
                            !EXISTS {
                                $this nltl:assessmentDate ?assessmentDate .
                                FILTER (DATATYPE(?assessmentDate) = xsd:date)
                            }
                            ||
                            !EXISTS {
                                $this nltl:engineOutputComplianceMethod
                                    nltl:traficom2017Section3Point2Point2Method
                            }
                            ||
                            !EXISTS {
                                $this nltl:constructionStageDate ?constructionDate2 ;
                                      nltl:deliveryDate ?deliveryDate2 ;
                                      nltl:assessmentDate ?assessmentDate2 ;
                                      nltl:engineOutputComplianceMethod
                                          nltl:traficom2017Section3Point2Point2Method .
                                FILTER (
                                    DATATYPE(?constructionDate2) = xsd:date &&
                                    DATATYPE(?deliveryDate2) = xsd:date &&
                                    DATATYPE(?assessmentDate2) = xsd:date
                                )
                                FILTER (
                                    YEAR(?constructionDate2) < 2003 ||
                                    (
                                        YEAR(?constructionDate2) = 2003 &&
                                        (
                                            MONTH(?constructionDate2) < 9 ||
                                            (
                                                MONTH(?constructionDate2) = 9 &&
                                                DAY(?constructionDate2) < 1
                                            )
                                        )
                                    )
                                )
                                FILTER (
                                    YEAR(?assessmentDate2) < YEAR(?deliveryDate2) + 20 ||
                                    (
                                        YEAR(?assessmentDate2) = YEAR(?deliveryDate2) + 20 &&
                                        (
                                            MONTH(?assessmentDate2) < 1 ||
                                            (
                                                MONTH(?assessmentDate2) = 1 &&
                                                DAY(?assessmentDate2) <= 1
                                            )
                                        )
                                    )
                                )
                            }
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF024ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-F01/ship> ] .

