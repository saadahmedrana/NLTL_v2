@prefix gen: <urn:nltl:generated-shape:TRF-025:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-025-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:ApplicableShape , gen:NonApplicableShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF025Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-025-F05/ship> ] .

