:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("825", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("825", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue nltl:kilogramPerSquareSecondUnit ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:coefficientC5 ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:iceClassDraught ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:shipBreadth ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:shipLength ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:clampedHullGeometryTerm ] ; sh:sparql [ sh:message Literal("For an applicable IA Super ship, clampedHullGeometryTerm must equal ((shipLength * iceClassDraught) / shipBreadth squared) cubed, clamped to the interval 5 through 20, within a relative tolerance of 1e-6 with an absolute fallback of 1e-12.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:shipLength ?lq ;
                              nltl:iceClassDraught ?tq ;
                              nltl:shipBreadth ?bq ;
                              nltl:clampedHullGeometryTerm ?rq .
                        ?lq qudt:numericValue ?l .
                        ?tq qudt:numericValue ?t .
                        ?bq qudt:numericValue ?b .
                        ?rq qudt:numericValue ?reported .
                        BIND((((?l * ?t) / (?b * ?b)) * ((?l * ?t) / (?b * ?b)) * ((?l * ?t) / (?b * ?b))) AS ?raw)
                        BIND(IF(?raw < 5, 5, IF(?raw > 20, 20, ?raw)) AS ?expected)
                        BIND((1e-6 * IF(ABS(?expected) > 1e-12, ABS(?expected), 1e-12)) AS ?tolerance)
                        FILTER(?reported < (?expected - ?tolerance) || ?reported > (?expected + ?tolerance))
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxExclusive Literal("2003-09-01", datatype=xsd:date) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:iceClassDraught ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:shipBreadth ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:shipLength ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:clampedHullGeometryTerm ] ; sh:sparql [ sh:message Literal("For an applicable IA ship, clampedHullGeometryTerm must satisfy the clamped hull-geometry calculation within a relative tolerance of 1e-6 with an absolute fallback of 1e-12.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:shipLength ?lq ;
                              nltl:iceClassDraught ?tq ;
                              nltl:shipBreadth ?bq ;
                              nltl:clampedHullGeometryTerm ?rq .
                        ?lq qudt:numericValue ?l .
                        ?tq qudt:numericValue ?t .
                        ?bq qudt:numericValue ?b .
                        ?rq qudt:numericValue ?reported .
                        BIND((((?l * ?t) / (?b * ?b)) * ((?l * ?t) / (?b * ?b)) * ((?l * ?t) / (?b * ?b))) AS ?raw)
                        BIND(IF(?raw < 5, 5, IF(?raw > 20, 20, ?raw)) AS ?expected)
                        BIND((1e-6 * IF(ABS(?expected) > 1e-12, ABS(?expected), 1e-12)) AS ?tolerance)
                        FILTER(?reported < (?expected - ?tolerance) || ?reported > (?expected + ?tolerance))
                    }
                ") ] ] , [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("2003-09-01", datatype=xsd:date) ; sh:path nltl:constructionStageDate ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ; sh:path nltl:iceClass ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_027_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-F01/ship> ] .

