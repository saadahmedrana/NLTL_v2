@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F06/ship> ;
            sh:resultMessage "The ship must provide evidence for the approved alternative Ke or RCH determination." ;
            sh:resultPath nltl:hasEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                    sh:message "The ship must provide evidence for the approved alternative Ke or RCH determination." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasEvidence ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F06/ship> ;
            sh:resultMessage "The ship must provide an approved alternative Ke or RCH result supported by either more precise calculation evidence or model-test evidence." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-028> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F06/ship> ] .

