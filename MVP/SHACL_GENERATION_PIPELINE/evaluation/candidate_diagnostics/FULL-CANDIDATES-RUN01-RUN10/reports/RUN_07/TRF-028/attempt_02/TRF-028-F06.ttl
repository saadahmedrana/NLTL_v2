@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F06/ship> ;
            sh:resultMessage "An alternative Ke or RCH determination requires alternative calculation or model-test evidence, approved status, and at least one valid Ke or RCH result." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "An alternative Ke or RCH determination requires alternative calculation or model-test evidence, approved status, and at least one valid Ke or RCH result." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this
WHERE {
  FILTER (
    NOT EXISTS {
      $this nltl:hasEvidence ?alternativeEvidence .
      ?alternativeEvidence rdf:type ?alternativeType .
      FILTER (
        ?alternativeType = nltl:alternativeCalculationEvidence ||
        ?alternativeType = nltl:modelTestEvidence
      )
    }
    ||
    (
      EXISTS {
        $this nltl:hasEvidence ?approvedEvidence .
        ?approvedEvidence rdf:type ?approvedType .
        FILTER (
          ?approvedType = nltl:alternativeCalculationEvidence ||
          ?approvedType = nltl:modelTestEvidence
        )
      }
      &&
      EXISTS {
        $this nltl:approvalStatus "true"^^xsd:boolean
      }
      &&
      EXISTS {
        $this nltl:approvalRevocationStatus nltl:evidenceStateApproved
      }
      &&
      (
        EXISTS {
          $this nltl:engineOutputCoefficientKe ?ke .
          ?ke qudt:numericValue ?keValue .
          ?ke qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
        }
        ||
        EXISTS {
          $this nltl:brashIceChannelResistanceRch ?rch .
          ?rch qudt:numericValue ?rchValue .
          ?rch qudt:unit <http://qudt.org/vocab/unit/N> .
        }
      )
    )
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-028> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F06/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F06/rch> ;
                    sh:resultMessage "Node ex:rch->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/N>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/N> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/N> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:brashIceChannelResistanceRch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/N> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:brashIceChannelResistanceRch ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F06/rch> ] .

