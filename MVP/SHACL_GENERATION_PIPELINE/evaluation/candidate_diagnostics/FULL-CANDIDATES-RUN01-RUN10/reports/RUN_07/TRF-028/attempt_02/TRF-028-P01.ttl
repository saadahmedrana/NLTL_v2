@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-P01/ship> ;
            sh:resultMessage "An alternative Ke or RCH determination requires alternative calculation or model-test evidence, approved status, and at least one valid Ke or RCH result." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "An alternative Ke or RCH determination requires alternative calculation or model-test evidence, approved status, and at least one valid Ke or RCH result." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this
WHERE {
  FILTER (
    NOT EXISTS {
      $this nltl:hasEvidence ?alternativeEvidence .
      ?alternativeEvidence rdf:type ?alternativeType .
      FILTER (
        ?alternativeType = nltl:alternativeCalculationEvidence ||
        ?alternativeType = nltl:modelTestEvidence
      )
    }
    ||
    (
      EXISTS {
        $this nltl:hasEvidence ?approvedEvidence .
        ?approvedEvidence rdf:type ?approvedType .
        FILTER (
          ?approvedType = nltl:alternativeCalculationEvidence ||
          ?approvedType = nltl:modelTestEvidence
        )
      }
      &&
      EXISTS {
        $this nltl:approvalStatus "true"^^xsd:boolean
      }
      &&
      EXISTS {
        $this nltl:approvalRevocationStatus nltl:evidenceStateApproved
      }
      &&
      (
        EXISTS {
          $this nltl:engineOutputCoefficientKe ?ke .
          ?ke qudt:numericValue ?keValue .
          ?ke qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
        }
        ||
        EXISTS {
          $this nltl:brashIceChannelResistanceRch ?rch .
          ?rch qudt:numericValue ?rchValue .
          ?rch qudt:unit <http://qudt.org/vocab/unit/N> .
        }
      )
    )
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-028> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-P01/ship> ] .

