@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-029-F04/ship> ;
            sh:resultMessage "Direct analysis requires approved status, non-applicability of the prescribed procedure, and a structural arrangement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:TRF029DirectAnalysisShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-029-F04/ship> ] .

