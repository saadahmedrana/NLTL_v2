@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/ship> ;
            sh:resultMessage "Focus node does not conform to shape MinCount 1: gen:OtherHorizontalCaseShape" ;
            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:path nltl:hasDirectAnalysisCase ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape gen:OtherHorizontalCaseShape ;
                    sh:qualifiedValueShapesDisjoint true ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/ship> ;
            sh:resultMessage "Focus node does not conform to shape MinCount 1: gen:UpperIceWaterlineCaseShape" ;
            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:path nltl:hasDirectAnalysisCase ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape gen:UpperIceWaterlineCaseShape ;
                    sh:qualifiedValueShapesDisjoint true ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchHeight" ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:LengthQuantityShape ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadLengthDeterminedFromArrangement ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadLengthDeterminedFromArrangement ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:DirectAnalysisCaseWithCaShape ; sh:path nltl:hasDirectAnalysisCase ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF030ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:span" ;
            sh:resultPath nltl:span ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:LengthQuantityShape ;
                    sh:path nltl:span ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/directAnalysis> ;
                    sh:resultMessage "Node ex:directAnalysis must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:upperIceWaterlineCenteredPosition ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:verticalLoadPositionType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:upperIceWaterlineReferencePosition ] ] , [ sh:property [ sh:hasValue nltl:halfLoadHeightBelowLowerIceWaterlinePosition ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:verticalLoadPositionType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:lowerIceWaterlineReferencePosition ] ] , [ sh:property [ sh:hasValue nltl:intermediateVerticalPosition ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:verticalLoadPositionType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:lowerIceWaterlineReferencePosition ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:upperIceWaterlineReferencePosition ] ] , [ sh:property [ sh:hasValue nltl:midSpanOrSpacingCenteredPosition ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:horizontalLoadPositionType ] ] , [ sh:property [ sh:hasValue nltl:otherHorizontalPosition ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:horizontalLoadPositionType ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:DirectAnalysisCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/directAnalysis> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/ship> ;
            sh:resultMessage "The ship must provide direct analysis cases." ;
            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:directAnalysisCase ;
                    sh:message "The ship must provide direct analysis cases." ;
                    sh:minCount 1 ;
                    sh:node gen:DirectAnalysisCaseShape ;
                    sh:path nltl:hasDirectAnalysisCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/directAnalysis> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/ship> ;
            sh:resultMessage "The ship must provide the applied ice pressure in MPa." ;
            sh:resultPath nltl:appliedIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the applied ice pressure in MPa." ;
                    sh:minCount 1 ;
                    sh:node gen:PressureQuantityShape ;
                    sh:path nltl:appliedIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/ship> ;
            sh:resultMessage "Focus node does not conform to shape MinCount 1: gen:HalfBelowLowerIceWaterlineCaseShape" ;
            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:path nltl:hasDirectAnalysisCase ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape gen:HalfBelowLowerIceWaterlineCaseShape ;
                    sh:qualifiedValueShapesDisjoint true ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:spacing" ;
            sh:resultPath nltl:spacing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:LengthQuantityShape ;
                    sh:path nltl:spacing ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadLengthDeterminedFromArrangement" ;
            sh:resultPath nltl:loadLengthDeterminedFromArrangement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:loadLengthDeterminedFromArrangement ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/ship> ;
            sh:resultMessage "The ship must provide the ice pressure in MPa." ;
            sh:resultPath nltl:icePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the ice pressure in MPa." ;
                    sh:minCount 1 ;
                    sh:node gen:PressureQuantityShape ;
                    sh:path nltl:icePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/ship> ;
            sh:resultMessage "Focus node does not conform to shape MinCount 1: gen:MidSpanOrSpacingCaseShape" ;
            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:path nltl:hasDirectAnalysisCase ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape gen:MidSpanOrSpacingCaseShape ;
                    sh:qualifiedValueShapesDisjoint true ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/ship> ;
            sh:resultMessage "Focus node does not conform to shape MinCount 2: gen:IntermediateVerticalCaseShape" ;
            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:path nltl:hasDirectAnalysisCase ;
                    sh:qualifiedMinCount 2 ;
                    sh:qualifiedValueShape gen:IntermediateVerticalCaseShape ;
                    sh:qualifiedValueShapesDisjoint true ] ] .

