@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F11/ship> ;
            sh:resultMessage "The externally calculated applied pressure result, representing 1.8p, must be supplied as a single MPa quantity." ;
            sh:resultPath nltl:appliedIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The externally calculated applied pressure result, representing 1.8p, must be supplied as a single MPa quantity." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-QuantityPressureShape> ;
                    sh:path nltl:appliedIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F11/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:span" ;
            sh:resultPath nltl:span ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-QuantityLengthShape> ;
                    sh:path nltl:span ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F11/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchHeight" ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-QuantityLengthShape> ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F11/ship> ;
            sh:resultMessage "The source ice pressure p must be supplied as a single MPa quantity." ;
            sh:resultPath nltl:icePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The source ice pressure p must be supplied as a single MPa quantity." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-QuantityPressureShape> ;
                    sh:path nltl:icePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F11/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadLengthDeterminedFromArrangement" ;
            sh:resultPath nltl:loadLengthDeterminedFromArrangement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:loadLengthDeterminedFromArrangement ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F11/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasDirectAnalysisCase" ;
            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:directAnalysisCase ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-DirectAnalysisCaseShape> ;
                    sh:or ( [ sh:property [ sh:hasValue true ;
                                        sh:path nltl:loadLengthDeterminedFromArrangement ] ] [ sh:property [ sh:hasValue false ;
                                        sh:path nltl:loadLengthDeterminedFromArrangement ],
                                    [ sh:path nltl:hasDirectAnalysisCase ;
                                        sh:qualifiedMinCount 2 ;
                                        sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-030-CaseWithCaShape> ;
                                        sh:qualifiedValueShapesDisjoint true ] ] ) ;
                    sh:path nltl:hasDirectAnalysisCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F11/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:spacing" ;
            sh:resultPath nltl:spacing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-QuantityLengthShape> ;
                    sh:path nltl:spacing ] ] .

