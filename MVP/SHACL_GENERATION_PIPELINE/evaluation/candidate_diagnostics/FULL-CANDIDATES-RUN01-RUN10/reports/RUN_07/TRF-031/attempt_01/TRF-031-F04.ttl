@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:beamTheoryUsed ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"allowableShearStress is required when beam theory is used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:MegaPA ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:allowableShearStress ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:beamTheoryUsed ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_031_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/ship> ;
            sh:resultMessage "When beam theory is used, allowableShearStress must be no greater than 0.9 times yieldPoint divided by sqrt(3)." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When beam theory is used, allowableShearStress must be no greater than 0.9 times yieldPoint divided by sqrt(3)." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:beamTheoryUsed true ;
                      nltl:allowableShearStress ?allowableQ ;
                      nltl:yieldPoint ?yieldQ .
                ?allowableQ qudt:numericValue ?allowable .
                ?yieldQ qudt:numericValue ?yield .
                BIND (
                    xsd:decimal("0.9") * ?yield /
                    xsd:decimal("1.7320508075688772")
                    AS ?limit
                )
                FILTER (?allowable > ?limit)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_031_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/combinedStress> ;
                    sh:resultMessage "Node ex:combinedStress->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:MegaPA ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/ship> ;
            sh:resultMessage "combinedBendingShearStress must be a single MPa quantity with a decimal numeric value." ;
            sh:resultPath nltl:combinedBendingShearStress ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "combinedBendingShearStress must be a single MPa quantity with a decimal numeric value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:MegaPA ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:combinedBendingShearStress ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/combinedStress> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/yieldShear> ;
                    sh:resultMessage "Node ex:yieldShear->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:MegaPA ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/ship> ;
            sh:resultMessage "yieldShearStress must be a single MPa quantity with a decimal numeric value." ;
            sh:resultPath nltl:yieldShearStress ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "yieldShearStress must be a single MPa quantity with a decimal numeric value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:MegaPA ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:yieldShearStress ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/yieldShear> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/yieldPoint> ;
                    sh:resultMessage "Node ex:yieldPoint->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:MegaPA ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/ship> ;
            sh:resultMessage "yieldPoint must be a single MPa quantity with a decimal numeric value." ;
            sh:resultPath nltl:yieldPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "yieldPoint must be a single MPa quantity with a decimal numeric value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:MegaPA ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:yieldPoint ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/yieldPoint> ] .

