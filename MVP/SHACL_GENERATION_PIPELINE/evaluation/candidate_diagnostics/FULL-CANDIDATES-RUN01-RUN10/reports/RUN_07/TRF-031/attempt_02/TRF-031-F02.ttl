@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F02/ship> ;
            sh:resultMessage "Combined bending and shear stress must be lower than the yield point, and yield shear stress must equal yield point divided by sqrt(3) within a relative tolerance of 1e-6, with an absolute fallback of 1e-9 near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Combined bending and shear stress must be lower than the yield point, and yield shear stress must equal yield point divided by sqrt(3) within a relative tolerance of 1e-6, with an absolute fallback of 1e-9 near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldPointNode ;
                      nltl:combinedBendingShearStress ?combinedStressNode ;
                      nltl:yieldShearStress ?yieldShearNode .

                ?yieldPointNode qudt:numericValue ?yieldPointValue .
                ?combinedStressNode qudt:numericValue ?combinedStressValue .
                ?yieldShearNode qudt:numericValue ?yieldShearValue .

                BIND((?yieldPointValue / 1.7320508075688772) AS ?expectedYieldShearValue)
                BIND(
                    IF(
                        (ABS(?expectedYieldShearValue) * 0.000001) > 0.000000001,
                        (ABS(?expectedYieldShearValue) * 0.000001),
                        0.000000001
                    )
                    AS ?tolerance
                )

                FILTER(
                    (?combinedStressValue >= ?yieldPointValue)
                    ||
                    (ABS(?yieldShearValue - ?expectedYieldShearValue) > ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_031_StaticCalculationShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F02/ship> ] .

