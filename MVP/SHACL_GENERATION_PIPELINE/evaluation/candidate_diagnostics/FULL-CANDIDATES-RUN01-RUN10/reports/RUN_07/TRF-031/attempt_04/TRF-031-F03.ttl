@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ;
            sh:resultMessage "Value is not Literal with datatype q:QuantityValue" ;
            sh:resultPath nltl:yieldShearStress ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype q:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path q:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path q:numericValue ] ] ;
                    sh:path nltl:yieldShearStress ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/yieldShear> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ;
            sh:resultMessage "Value is not Literal with datatype q:QuantityValue" ;
            sh:resultPath nltl:yieldPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype q:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path q:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path q:numericValue ] ] ;
                    sh:path nltl:yieldPoint ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/yieldPoint> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ;
            sh:resultMessage "Value is not Literal with datatype q:QuantityValue" ;
            sh:resultPath nltl:combinedBendingShearStress ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype q:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path q:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path q:unit ] ] ;
                    sh:path nltl:combinedBendingShearStress ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/combinedStress> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ;
            sh:resultMessage "Yield shear stress must equal yield point divided by the square root of three within numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Yield shear stress must equal yield point divided by the square root of three within numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX q: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldQuantity ;
                      nltl:yieldShearStress ?resultQuantity .
                ?yieldQuantity q:numericValue ?yield ;
                                q:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?resultQuantity q:numericValue ?result ;
                                 q:unit <http://qudt.org/vocab/unit/MegaPA> .
                BIND ((?yield / 1.7320508075688772) AS ?expected)
                BIND (IF(?expected >= 0, ?expected, -?expected) AS ?scale)
                BIND (IF((?scale * 0.000001) > 0.000000000001,
                         (?scale * 0.000001),
                         0.000000000001) AS ?tolerance)
                BIND ((?expected - ?result) AS ?difference)
                FILTER ((?difference > ?tolerance) || (?difference < -?tolerance))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-031> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ] .

