@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F01/member> ;
            sh:resultMessage "The applicable ice stringer must identify its effective member cross section." ;
            sh:resultPath nltl:hasEffectiveMemberCrossSection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:effectiveMemberCrossSection ;
                    sh:message "The applicable ice stringer must identify its effective member cross section." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasEffectiveMemberCrossSection ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F01/effectiveSection> ;
            sh:resultMessage "The effective member cross section must be linked from the applicable hull structure." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The effective member cross section must be linked from the applicable hull structure." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    ?owner nltl:hasEffectiveMemberCrossSection $this .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:TRF034_EffectiveMemberCrossSectionShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F01/effectiveSection> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F01/member> ;
            sh:resultMessage "The member normal-to-plating status must be provided for the applicable ice stringer." ;
            sh:resultPath nltl:memberNormalToPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The member normal-to-plating status must be provided for the applicable ice stringer." ;
                    sh:minCount 1 ;
                    sh:path nltl:memberNormalToPlating ] ] .

