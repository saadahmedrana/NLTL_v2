@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F01/designParameters> ;
            sh:resultMessage "Level ice thickness exceeds the Table 4-1 limit or the design ice load height does not match the ice-class value." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Level ice thickness exceeds the Table 4-1 limit or the design ice load height does not match the ice-class value." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?class ;
                      nltl:levelIceThickness ?hiQuantity ;
                      nltl:designIceLoadHeight ?hQuantity .

                ?hiQuantity qudt:numericValue ?hiValue .
                ?hQuantity qudt:numericValue ?hValue .

                FILTER (
                    (?class = nltl:iceClassIaSuper &&
                     (?hiValue > 1.0 || ?hValue < 0.35 || ?hValue > 0.35))
                    ||
                    (?class = nltl:iceClassIa &&
                     (?hiValue > 0.8 || ?hValue < 0.30 || ?hValue > 0.30))
                    ||
                    (?class = nltl:iceClassIb &&
                     (?hiValue > 0.6 || ?hValue < 0.25 || ?hValue > 0.25))
                    ||
                    (?class = nltl:iceClassIc &&
                     (?hiValue > 0.4 || ?hValue < 0.22 || ?hValue > 0.22))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-036-ParameterSetShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F01/designParameters> ] .

