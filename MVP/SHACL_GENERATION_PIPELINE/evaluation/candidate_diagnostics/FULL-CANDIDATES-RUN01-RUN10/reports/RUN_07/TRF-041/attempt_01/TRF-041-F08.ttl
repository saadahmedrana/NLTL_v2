@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F08/plating> ;
            sh:resultMessage "Plating framing orientation must identify the applicable transverse or longitudinal readiness branch." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_041_PlatingThicknessReadinessShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F08/plating> ] .

