@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F10/plating> ;
            sh:resultMessage "The plating record shall provide the complete operand and result set for either the transverse or longitudinal shell-plating thickness determination." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:TRF041PlatingReadinessShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F10/plating> ] .

