@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "corrosionAbrasionAddition must be a single decimal quantity in millimetres." ;
            sh:resultPath nltl:corrosionAbrasionAddition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "corrosionAbrasionAddition must be a single decimal quantity in millimetres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:corrosionAbrasionAddition ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "corrosionAbrasionAddition must normally equal 2 mm; a lower value requires an approved maintained special surface coating.",
                "longitudinalPlatingFactorF2 must equal the prescribed piecewise function of designIceLoadHeight divided by spacing within max(1e-6*ABS(expected),1e-12)." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "longitudinalPlatingFactorF2 must equal the prescribed piecewise function of designIceLoadHeight divided by spacing within max(1e-6*ABS(expected),1e-12)." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?hQuantity ;
                      nltl:spacing ?sQuantity ;
                      nltl:longitudinalPlatingFactorF2 ?fQuantity .

                ?hQuantity qudt:numericValue ?h .
                ?sQuantity qudt:numericValue ?s .
                ?fQuantity qudt:numericValue ?f .

                BIND(IF(?s = 0, 0, ?h / ?s) AS ?ratio)
                BIND(
                    IF(
                        ?ratio <= 1,
                        0.4 / ?ratio + 0.6,
                        1.4 - 0.4 * ?ratio
                    )
                    AS ?expected
                )
                BIND(
                    IF(
                        ABS(?expected) * 0.000001 > 0.000000000001,
                        ABS(?expected) * 0.000001,
                        0.000000000001
                    )
                    AS ?tolerance
                )

                FILTER (
                    ?s = 0 ||
                    ?ratio > 1.8 ||
                    ABS(?f - ?expected) > ?tolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF042PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ] .

