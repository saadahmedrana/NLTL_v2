@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "Each plating shall provide one yield strength in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each plating shall provide one yield strength in MPa." ;
                    sh:minCount 1 ;
                    sh:node gen:YieldStrengthQuantityValueShape ;
                    sh:path nltl:yieldStrength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "The longitudinal plating factor f2 shall equal the applicable h/s formula within max(1e-6*ABS(expected),1e-12)." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The longitudinal plating factor f2 shall equal the applicable h/s formula within max(1e-6*ABS(expected),1e-12)." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?hQuantity ;
                      nltl:spacing ?sQuantity ;
                      nltl:longitudinalPlatingFactorF2 ?fQuantity .

                ?hQuantity qudt:numericValue ?h .
                ?sQuantity qudt:numericValue ?s .
                ?fQuantity qudt:numericValue ?reported .

                BIND (?h / ?s AS ?ratio)
                BIND (
                    IF(
                        ?ratio <= 1,
                        0.4 / ?ratio + 0.6,
                        1.4 - 0.4 * ?ratio
                    )
                    AS ?expected
                )

                FILTER (?ratio <= 1.8)
                FILTER (
                    ABS(?reported - ?expected) >
                    IF(
                        1e-6 * ABS(?expected) > 1e-12,
                        1e-6 * ABS(?expected),
                        1e-12
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:PlatingTRF042Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "Each plating shall identify its hull structural steel grade." ;
            sh:resultPath nltl:hullStructuralSteelGrade ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeValue ;
                    sh:maxCount 1 ;
                    sh:message "Each plating shall identify its hull structural steel grade." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullStructuralSteelGrade ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "The corrosion and abrasion increment shall be one length quantity in millimetres." ;
            sh:resultPath nltl:corrosionAbrasionAddition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The corrosion and abrasion increment shall be one length quantity in millimetres." ;
                    sh:minCount 1 ;
                    sh:node gen:LengthMilliMetreQuantityValueShape ;
                    sh:path nltl:corrosionAbrasionAddition ] ] .

