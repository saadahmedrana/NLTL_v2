@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/terminationCase> ;
                    sh:resultMessage "For an extension of no more than 250 mm, termination at the identified adjacent boundary must be permitted." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "For an extension of no more than 250 mm, termination at the identified adjacent boundary must be permitted." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?extensionQ .
                ?extensionQ qudt:numericValue ?extension ;
                            qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                FILTER(?extension <= 250)
                FILTER NOT EXISTS {
                    $this nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted true ;
                          nltl:terminationAdjacentBoundary ?boundary .
                    {
                        ?boundary a nltl:deckStructure .
                    }
                    UNION
                    {
                        ?boundary a nltl:tankBoundaryPlating .
                    }
                    UNION
                    {
                        ?boundary a nltl:tankTop .
                    }
                }
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape nltl:TRF043_TerminationCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/terminationCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape nltl:TRF043_TerminationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasFramingIceStrengtheningTerminationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltl:TRF043_TerminationCaseShape ;
                    sh:path nltl:hasFramingIceStrengtheningTerminationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F03/terminationCase> ] .

