@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F02/transverseFrame> ;
            sh:resultMessage "The frame boundary-condition factor or calculated frame results do not satisfy clause 4.4.2.1." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The frame boundary-condition factor or calculated frame results do not satisfy clause 4.4.2.1." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType ?bc ;
                      nltl:icePressure ?pNode ;
                      nltl:spacing ?sNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?sNode qudt:numericValue ?s .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?m0Node qudt:numericValue ?m0 .
                ?sigmaNode qudt:numericValue ?sigma .
                ?mtNode qudt:numericValue ?mt .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND(
                    IF(?bc = nltl:bulkCarrierTopWingTankFrameCondition, 7,
                    IF(?bc = nltl:singleDeckTankTopToMainDeckFrameCondition, 6,
                    IF(?bc = nltl:multiDeckOrStringerContinuousFrameCondition, 5.7,
                    IF(?bc = nltl:twoDeckFrameCondition, 5, 0))))
                    AS ?expectedM0
                )
                BIND((7 - 5 * ?h / IF(?l = 0, 1, ?l)) AS ?denominator)
                BIND(
                    IF(?l = 0 || ?denominator = 0,
                       0,
                       7 * ?expectedM0 / ?denominator)
                    AS ?expectedMt
                )
                BIND(
                    IF(?l = 0 || ?denominator = 0 || ?sigma = 0,
                       0,
                       ?p * ?s * ?h * ?l / (?expectedMt * ?sigma) * 1000000)
                    AS ?expectedZ
                )
                BIND(
                    IF(?sigma = 0,
                       0,
                       1.7320508075688772 * 1.2 * ?p * ?h * ?s /
                       (2 * ?sigma) * 10000)
                    AS ?expectedA
                )

                FILTER(
                    ?m0 < ?expectedM0 ||
                    ?m0 > ?expectedM0 ||
                    ?l = 0 ||
                    ?denominator = 0 ||
                    ?sigma = 0 ||
                    ABS(?mt - ?expectedMt) >
                        (ABS(?expectedMt) * 0.000001 + 0.000000001) ||
                    ABS(?z - ?expectedZ) >
                        (ABS(?expectedZ) * 0.000001 + 0.000000001) ||
                    ABS(?a - ?expectedA) >
                        (ABS(?expectedA) * 0.000001 + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-044> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F02/transverseFrame> ] .

