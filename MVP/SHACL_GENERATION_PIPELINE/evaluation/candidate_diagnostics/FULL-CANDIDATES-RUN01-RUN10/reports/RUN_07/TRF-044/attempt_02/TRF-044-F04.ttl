@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F04/transverseFrame> ;
            sh:resultMessage "Frame factors and section properties do not satisfy the Table 4-7 selection and declared calculation formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Frame factors and section properties do not satisfy the Table 4-7 selection and declared calculation formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:spacing ?sNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:yieldStrength ?yNode ;
                      nltl:frameBoundaryConditionType ?condition ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?sNode qudt:numericValue ?s .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?yNode qudt:numericValue ?y .
                ?m0Node qudt:numericValue ?m0 .
                ?mtNode qudt:numericValue ?mt .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND(
                    IF(
                        ?condition = nltl:bulkCarrierTopWingTankFrameCondition,
                        7,
                        IF(
                            ?condition = nltl:singleDeckTankTopToMainDeckFrameCondition,
                            6,
                            IF(
                                ?condition = nltl:multiDeckOrStringerContinuousFrameCondition,
                                5.7,
                                5
                            )
                        )
                    )
                    AS ?expectedM0
                )

                BIND(7 * ?expectedM0 / (7 - 5 * ?h / ?l) AS ?expectedMt)
                BIND(?p * ?s * ?h * ?l / (?expectedMt * ?y) * 1000000 AS ?expectedZ)
                BIND(1.7320508075688772 * 1.2 * ?p * ?h * ?s / (2 * ?y) * 10000 AS ?expectedA)

                BIND(
                    IF(?expectedMt >= 0, ?expectedMt * 0.000001, -?expectedMt * 0.000001)
                    AS ?mtRelativeTolerance
                )
                BIND(
                    IF(?mtRelativeTolerance > 0.000001, ?mtRelativeTolerance, 0.000001)
                    AS ?mtTolerance
                )

                BIND(
                    IF(?expectedZ >= 0, ?expectedZ * 0.000001, -?expectedZ * 0.000001)
                    AS ?zRelativeTolerance
                )
                BIND(
                    IF(?zRelativeTolerance > 0.000001, ?zRelativeTolerance, 0.000001)
                    AS ?zTolerance
                )

                BIND(
                    IF(?expectedA >= 0, ?expectedA * 0.000001, -?expectedA * 0.000001)
                    AS ?aRelativeTolerance
                )
                BIND(
                    IF(?aRelativeTolerance > 0.000001, ?aRelativeTolerance, 0.000001)
                    AS ?aTolerance
                )

                FILTER(
                    ?m0 < ?expectedM0 ||
                    ?m0 > ?expectedM0 ||
                    ?mt < ?expectedMt - ?mtTolerance ||
                    ?mt > ?expectedMt + ?mtTolerance ||
                    ?z < ?expectedZ - ?zTolerance ||
                    ?z > ?expectedZ + ?zTolerance ||
                    ?a < ?expectedA - ?aTolerance ||
                    ?a > ?expectedA + ?aTolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape g:TRF044TransverseFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F04/transverseFrame> ] .

