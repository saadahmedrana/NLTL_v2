@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ;
            sh:resultMessage "frameBoundaryConditionFactorM0 must equal the Table 4-7 value for its boundary condition" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "frameBoundaryConditionFactorM0 must equal the Table 4-7 value for its boundary condition" ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType ?condition ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node .
                ?m0Node <http://qudt.org/schema/qudt/numericValue> ?m0 .
                FILTER (
                    (?condition = nltl:bulkCarrierTopWingTankFrameCondition &&
                     (?m0 < 7 || ?m0 > 7)) ||
                    (?condition = nltl:singleDeckTankTopToMainDeckFrameCondition &&
                     (?m0 < 6 || ?m0 > 6)) ||
                    (?condition = nltl:multiDeckOrStringerContinuousFrameCondition &&
                     (?m0 < 5.7 || ?m0 > 5.7)) ||
                    (?condition = nltl:twoDeckFrameCondition &&
                     (?m0 < 5 || ?m0 > 5))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF044TransverseFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ] .

