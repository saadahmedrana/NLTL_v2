@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F04/frame> ;
            sh:resultMessage "Ordinary frame scantlings may be used only when less than 15% of the frame span is within the ice-strengthening zone, with both length values expressed in metres." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Ordinary frame scantlings may be used only when less than 15% of the frame span is within the ice-strengthening zone, with both length values expressed in metres." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:ordinaryFrameScantlingsUsed true .
                FILTER NOT EXISTS {
                    $this nltl:frameSpanWithinIceStrengtheningZone ?withinQuantity .
                    ?withinQuantity qudt:numericValue ?withinValue ;
                                     qudt:unit unit:M .
                    $this nltl:span ?spanQuantity .
                    ?spanQuantity qudt:numericValue ?spanValue ;
                                  qudt:unit unit:M .
                    FILTER (datatype(?withinValue) = xsd:decimal)
                    FILTER (datatype(?spanValue) = xsd:decimal)
                    FILTER (?withinValue < (0.15 * ?spanValue))
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF045FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F04/frame> ] .

