@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/upperEnd> ;
                    sh:resultMessage "The upper end must be attached to a deck, tank boundary plating, or ice stringer." ;
                    sh:resultPath nltl:hasAttachedSupportingStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The upper end must be attached to a deck, tank boundary plating, or ice stringer." ;
                            sh:minCount 1 ;
                            sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:iceStringer ] ) ] ;
                            sh:path nltl:hasAttachedSupportingStructure ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/frame> ;
            sh:resultMessage "The frame must identify an upper end attached to an eligible supporting structure." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:ne5dac0a3039a496599652dfba9a77a19b2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/upperEnd> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/adjacentMainFrame> ;
            sh:resultMessage "The frame must identify its strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameStrengthenedPart ;
                    sh:message "The frame must identify its strengthened part." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasStrengthenedPart ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/adjacentMainFrame> ;
            sh:resultMessage "The frame must identify an upper end attached to an eligible supporting structure." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ne5dac0a3039a496599652dfba9a77a19b2 ] .

_:N1c0baaaf04ed4925acb9866403717c3c sh:property [ sh:message "The upper end must be attached to a deck, tank boundary plating, or ice stringer." ;
            sh:minCount 1 ;
            sh:node [ sh:or ( [ ] [ ] [ ] ) ] ;
            sh:path nltl:hasAttachedSupportingStructure ] .

_:ne5dac0a3039a496599652dfba9a77a19b2 sh:class nltl:frameEnd ;
    sh:message "The frame must identify an upper end attached to an eligible supporting structure." ;
    sh:minCount 1 ;
    sh:node _:N1c0baaaf04ed4925acb9866403717c3c ;
    sh:path nltl:hasUpperEnd .

