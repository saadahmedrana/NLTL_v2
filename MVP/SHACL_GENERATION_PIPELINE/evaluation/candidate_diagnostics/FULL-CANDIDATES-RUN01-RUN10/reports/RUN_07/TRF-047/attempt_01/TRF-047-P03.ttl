@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P03/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:property [ sh:class nltl:frameEnd ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] [ sh:class nltl:iceStringer ] ) ] ; sh:path nltl:hasAttachedSupportingStructure ] ] ; sh:path nltl:hasLowerEnd ] ] , [ sh:property [ sh:class nltl:frameEnd ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:horizontalConnectionMember ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:mainFrame ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:mainFrameBelowIceBeltStrengthened ] ] ; sh:path nltl:connectsToAdjacentMainFrame ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The horizontal connection member must have the same scantlings as the adjacent main frames.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sameScantlingsAsMainFrame ] ] ; sh:path nltl:hasHorizontalConnectionMember ], [ sh:class nltl:supportingStructure ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasTerminationBelowSupportingStructure ] ] ; sh:path nltl:hasLowerEnd ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The applicable main frame must be ice strengthened below the ice belt.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:mainFrameBelowIceBeltStrengthened ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The supporting structure for the conditional connection must be at or below the lower limit of the ice belt.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF_047_LowerEndOfTransverseFramingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P03/frame> ] .

