@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F02/frame> ;
            sh:resultMessage """Node ex:frame must conform to one or more shapes in [ sh:class nltl:mainFrame ; sh:property [ sh:message Literal("A main frame must identify its lower end.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasLowerEnd ], [ sh:message Literal("A main frame must identify its strengthened part.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasStrengthenedPart ], [ sh:message Literal("The lower end of the strengthened main-frame part must be attached to a deck, tank boundary plating, tank top, or ice stringer.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF_047_SpecifiedSupportingStructureShape ; sh:path nltl:hasAttachedSupportingStructure ] ] , [ sh:class nltl:intermediateIceFrame ; sh:property [ sh:message Literal("An intermediate ice frame must identify its lower end.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasLowerEnd ], [ sh:message Literal("An intermediate ice frame must identify its strengthened part.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasStrengthenedPart ], [ sh:message Literal("The lower end of the strengthened intermediate-frame part must be attached to a deck, tank boundary plating, tank top, or ice stringer.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF_047_SpecifiedSupportingStructureShape ; sh:path nltl:hasAttachedSupportingStructure ] ] , [ sh:class nltl:intermediateIceFrame ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("An intermediate frame terminating below a specified supporting structure at or below the ice-belt lower limit may use a horizontal member only when it connects to an adjacent main frame and has the same scantlings as the main frames.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this a nltl:intermediateIceFrame ;
                              nltl:hasStrengthenedPart ?strengthenedPart ;
                              nltl:hasLowerEnd ?lowerEnd ;
                              nltl:hasTerminationBelowSupportingStructure ?support ;
                              nltl:supportingStructureAtOrBelowIceBeltLowerLimit true ;
                              nltl:hasHorizontalConnectionMember ?member ;
                              nltl:sameScantlingsAsMainFrame true .
                        ?support a ?supportClass .
                        ?member nltl:connectsToAdjacentMainFrame ?adjacentMainFrame .
                        ?adjacentMainFrame a nltl:mainFrame .
                        FILTER (
                            ?supportClass IN (
                                nltl:deckStructure,
                                nltl:tankBoundaryPlating,
                                nltl:tankTop,
                                nltl:iceStringer
                            )
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_047_FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F02/frame> ] .

