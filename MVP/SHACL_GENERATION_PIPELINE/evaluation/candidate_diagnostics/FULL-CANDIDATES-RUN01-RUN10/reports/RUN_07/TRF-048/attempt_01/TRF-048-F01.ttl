@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ;
            sh:resultMessage "When the frame is a continuous beam with brackets and boundary conditions are not significantly different, frameMomentFactorM must equal 13.3." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the frame is a continuous beam with brackets and boundary conditions are not significantly different, frameMomentFactorM must equal 13.3." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType nltl:continuousBeamWithBracketsFrameCondition ;
                      nltl:significantlyDifferentBoundaryConditions false ;
                      nltl:frameMomentFactorM ?mNode .
                ?mNode qudt:numericValue ?m .
                FILTER (?m != 13.3)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF048LongitudinalFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ] .

