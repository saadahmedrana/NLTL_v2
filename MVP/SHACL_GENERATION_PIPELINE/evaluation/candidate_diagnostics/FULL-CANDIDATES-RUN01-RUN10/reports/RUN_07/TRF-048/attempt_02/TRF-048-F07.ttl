@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ;
            sh:resultMessage "Bracket area must be excluded from actual frame shear area." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Bracket area must be excluded from actual frame shear area." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:actualFrameShearArea ?actualNode ;
                      nltl:bracketArea ?bracketNode ;
                      nltl:grossFrameShearArea ?grossNode .
                ?actualNode qudt:numericValue ?actual .
                ?bracketNode qudt:numericValue ?bracket .
                ?grossNode qudt:numericValue ?gross .
                BIND ((?actual + ?bracket) AS ?expectedGross)
                FILTER (ABS(?gross - ?expectedGross) > (ABS(?expectedGross) * 0.000001 + 0.000001))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-048-LongitudinalFrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ] .

