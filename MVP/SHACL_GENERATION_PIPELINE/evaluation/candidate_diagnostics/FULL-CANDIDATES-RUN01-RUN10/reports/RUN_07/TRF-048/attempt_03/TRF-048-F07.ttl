@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ;
            sh:resultMessage "Longitudinal-frame calculated results, including gross shear area, do not satisfy the declared formulas and bracket-area exclusion." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Longitudinal-frame calculated results, including gross shear area, do not satisfy the declared formulas and bracket-area exclusion." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:spacing ?sNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Node ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode ;
                      nltl:actualFrameShearArea ?actualNode ;
                      nltl:bracketArea ?bracketNode ;
                      nltl:grossFrameShearArea ?grossNode .
                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?sNode qudt:numericValue ?s .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?sigmaNode qudt:numericValue ?sigma .
                ?f4Node qudt:numericValue ?f4 .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .
                ?actualNode qudt:numericValue ?actual .
                ?bracketNode qudt:numericValue ?bracket .
                ?grossNode qudt:numericValue ?gross .

                BIND (1.0 - (0.2 * ?h / ?s) AS ?expectedF4)
                BIND (?expectedF4 * ?p * ?h * ?l * ?l / (4.0 * ?m * ?sigma) * 1000000.0 AS ?expectedZ)
                BIND (1.7320508075688772 * ?expectedF4 * 2.16 * ?p * ?h * ?l / (2.0 * ?sigma) * 10000.0 AS ?expectedA)
                BIND (?actual + ?bracket AS ?expectedGross)

                FILTER (
                    ?f4 < (?expectedF4 - (?expectedF4 * 0.000001 + 0.000000001)) ||
                    ?f4 > (?expectedF4 + (?expectedF4 * 0.000001 + 0.000000001)) ||
                    ?z < (?expectedZ - (?expectedZ * 0.000001 + 0.000000001)) ||
                    ?z > (?expectedZ + (?expectedZ * 0.000001 + 0.000000001)) ||
                    ?a < (?expectedA - (?expectedA * 0.000001 + 0.000000001)) ||
                    ?a > (?expectedA + (?expectedA * 0.000001 + 0.000000001)) ||
                    ?gross < (?expectedGross - (?expectedGross * 0.000001 + 0.000000001)) ||
                    ?gross > (?expectedGross + (?expectedGross * 0.000001 + 0.000000001))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-048-LongitudinalFrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ] .

