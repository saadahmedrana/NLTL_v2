@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P04/bracket> ;
            sh:resultMessage "Less than 1 values on ex:bracket->nltl:bucklingStiffening" ;
            sh:resultPath nltl:bucklingStiffening ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nef29e738af6945acb9178a0d969c182ab34 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P04/frame> ;
            sh:resultMessage """Node ex:frame must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ] ] , [ sh:or ( [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:passesThroughSupportingStructure ] ] [ sh:property [ sh:datatype xsd:integer ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("2", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("2", datatype=xsd:integer) ; sh:path nltl:webPlateConnectionSideCount ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:passesThroughSupportingStructure ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:passesThroughSupportingStructure ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ], [ sh:node [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:effectiveAttachmentConfirmed ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasAttachedSupportingStructure ] ] ; sh:path nltl:hasFrameAttachment ] ; sh:sparql [ sh:message Literal("A frame running through a supporting structure must have exactly two web-plate connection sides for each paired supporting structure attachment.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:passesThroughSupportingStructure true ;
                              nltl:webPlateConnectionSideCount ?count ;
                              nltl:hasFrameAttachment ?attachment .
                        ?attachment nltl:hasAttachedSupportingStructure ?structure .
                        FILTER NOT EXISTS {
                            ?structure nltl:hasSupportingStructureAttachment ?attachment .
                        }
                        FILTER (?count != 2)
                    }
                ") ], [ sh:message Literal("A longitudinal frame must be attached by a bracket to every declared supporting bulkhead.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this a nltl:longitudinalFrame ;
                              nltl:hasSupportingBulkhead ?structure .
                        FILTER NOT EXISTS {
                            $this nltl:hasFrameAttachment ?attachment .
                            ?attachment nltl:hasAttachedSupportingStructure ?structure ;
                                       nltl:hasConnectionBracket ?bracket .
                        }
                    }
                ") ], [ sh:message Literal("A longitudinal frame must be attached by a bracket to every declared supporting web frame.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this a nltl:longitudinalFrame ;
                              nltl:hasSupportingWebFrame ?structure .
                        FILTER NOT EXISTS {
                            $this nltl:hasFrameAttachment ?attachment .
                            ?attachment nltl:hasAttachedSupportingStructure ?structure ;
                                       nltl:hasConnectionBracket ?bracket .
                        }
                    }
                ") ], [ sh:message Literal("A transverse frame terminating at a deck or ice stringer must have a bracket or similar construction on each attachment.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this a nltl:transverseFrame ;
                              nltl:terminatesAtDeckOrIceStringer true ;
                              nltl:hasFrameAttachment ?attachment .
                        FILTER NOT EXISTS {
                            ?attachment nltl:hasConnectionBracket ?bracket .
                        }
                        FILTER NOT EXISTS {
                            ?attachment nltl:similarAttachmentConstructionPresent true .
                        }
                    }
                ") ], [ sh:message Literal("Bracket thickness must be at least the frame web thickness, and the bracket edge must be stiffened against buckling.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    SELECT $this
                    WHERE {
                        $this nltl:hasFrameAttachment ?attachment ;
                              nltl:frameWebThickness ?webThickness .
                        ?attachment nltl:hasConnectionBracket ?bracket .
                        FILTER NOT EXISTS {
                            ?bracket nltl:bracketEdgeStiffened true ;
                                     nltl:bucklingStiffening true ;
                                     nltl:bracketThickness ?bracketThickness .
                            ?webThickness qudt:numericValue ?webValue ;
                                          qudt:unit unit:MilliM .
                            ?bracketThickness qudt:numericValue ?bracketValue ;
                                             qudt:unit unit:MilliM .
                            FILTER (?bracketValue >= ?webValue)
                        }
                    }
                ") ], [ sh:message Literal("Each frame attachment must identify a supporting structure and have the reciprocal supporting-structure attachment relationship.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasFrameAttachment ?attachment .
                        FILTER NOT EXISTS {
                            ?attachment nltl:hasAttachedSupportingStructure ?structure .
                            ?structure nltl:hasSupportingStructureAttachment ?attachment .
                        }
                    }
                ") ], [ sh:message Literal("Every supporting bulkhead declared for a frame must be paired with a reciprocal frame attachment.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasSupportingBulkhead ?structure .
                        FILTER NOT EXISTS {
                            $this nltl:hasFrameAttachment ?attachment .
                            ?attachment nltl:hasAttachedSupportingStructure ?structure .
                            ?structure nltl:hasSupportingStructureAttachment ?attachment .
                        }
                    }
                ") ], [ sh:message Literal("Every supporting web frame declared for a frame must be paired with a reciprocal frame attachment.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasSupportingWebFrame ?structure .
                        FILTER NOT EXISTS {
                            $this nltl:hasFrameAttachment ?attachment .
                            ?attachment nltl:hasAttachedSupportingStructure ?structure .
                            ?structure nltl:hasSupportingStructureAttachment ?attachment .
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF049FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P04/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P04/bracket> ;
            sh:resultMessage "Node ex:bracket->nltl:bucklingStiffening does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:bucklingStiffening ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nef29e738af6945acb9178a0d969c182ab34 ] .

_:nef29e738af6945acb9178a0d969c182ab34 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:bucklingStiffening .

