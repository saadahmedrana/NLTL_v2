@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ] ] , [ sh:or ( [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:passesThroughSupportingStructure ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:passesThroughSupportingStructure ], [ sh:datatype xsd:integer ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"2\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:webPlateConnectionSideCount ] ] ) ; sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltl:TRF049_FrameAttachmentShape ; sh:path nltl:hasFrameAttachment ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltl:TRF049_FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ;
            sh:resultMessage "Every supporting web frame and bulkhead of an in-area longitudinal frame must be paired with a bracketed frame attachment." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Every supporting web frame and bulkhead of an in-area longitudinal frame must be paired with a bracketed frame attachment." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this
WHERE {
  $this nltl:withinIceStrengthenedArea true .
  {
    $this nltl:hasSupportingWebFrame ?structure .
  }
  UNION
  {
    $this nltl:hasSupportingBulkhead ?structure .
  }
  FILTER NOT EXISTS {
    $this nltl:hasFrameAttachment ?attachment .
    ?attachment nltl:hasAttachedSupportingStructure ?structure .
    ?attachment nltl:hasConnectionBracket ?bracket .
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:TRF049_LongitudinalFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/webFrame> ;
            sh:resultMessage "Less than 1 values on ex:webFrame->nltl:hasSupportingStructureAttachment" ;
            sh:resultPath nltl:hasSupportingStructureAttachment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ndb1c6196d2d94ddca4b1043ae6666060b25 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/bulkhead> ;
            sh:resultMessage "Less than 1 values on ex:bulkhead->nltl:hasSupportingStructureAttachment" ;
            sh:resultPath nltl:hasSupportingStructureAttachment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ndb1c6196d2d94ddca4b1043ae6666060b25 ] .

_:ndb1c6196d2d94ddca4b1043ae6666060b25 sh:class nltl:frameAttachmentRecord ;
    sh:minCount 1 ;
    sh:path nltl:hasSupportingStructureAttachment .

