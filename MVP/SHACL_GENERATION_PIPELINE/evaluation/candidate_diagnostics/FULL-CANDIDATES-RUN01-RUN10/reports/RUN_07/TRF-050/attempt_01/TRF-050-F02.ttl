@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F02/attachmentRecord> ;
            sh:resultMessage "The frame must be attached to the shell by a double continuous weld." ;
            sh:resultPath nltl:frameShellWeldType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n14465b7c5eab4b9f99702a17d7a370ddb2 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F02/attachmentRecord> ;
                    sh:resultMessage "The frame must be attached to the shell by a double continuous weld." ;
                    sh:resultPath nltl:frameShellWeldType ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n14465b7c5eab4b9f99702a17d7a370ddb2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F02/frame> ;
            sh:resultMessage "Each frame must have a frame attachment record." ;
            sh:resultPath nltl:frameAttachment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameAttachmentRecord ;
                    sh:message "Each frame must have a frame attachment record." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF050_FrameAttachmentRecordShape ;
                    sh:path nltl:frameAttachment ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F02/attachmentRecord> ] .

_:n14465b7c5eab4b9f99702a17d7a370ddb2 sh:class nltl:weldTypeValue ;
    sh:hasValue nltl:doubleContinuousWeld ;
    sh:maxCount 1 ;
    sh:message "The frame must be attached to the shell by a double continuous weld." ;
    sh:minCount 1 ;
    sh:path nltl:frameShellWeldType .

