@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F04/attachmentRecord> ;
            sh:resultMessage "Node ex:attachmentRecord must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shellPlateButtCrossing ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Scalloping is not allowed unless crossing a shell plate butt.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:scallopingPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shellPlateButtCrossing ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF050_FrameAttachmentRecordShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F04/attachmentRecord> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F04/attachmentRecord> ;
                    sh:resultMessage "Node ex:attachmentRecord must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shellPlateButtCrossing ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Scalloping is not allowed unless crossing a shell plate butt.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:scallopingPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shellPlateButtCrossing ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:TRF050_FrameAttachmentRecordShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F04/attachmentRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F04/frame> ;
            sh:resultMessage "Each frame must have a frame attachment record." ;
            sh:resultPath nltl:frameAttachment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameAttachmentRecord ;
                    sh:message "Each frame must have a frame attachment record." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF050_FrameAttachmentRecordShape ;
                    sh:path nltl:frameAttachment ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F04/attachmentRecord> ] .

