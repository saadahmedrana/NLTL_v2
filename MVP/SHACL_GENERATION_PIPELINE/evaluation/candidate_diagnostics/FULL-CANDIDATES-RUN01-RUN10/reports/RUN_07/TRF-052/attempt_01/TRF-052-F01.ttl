@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F01/frame> ;
            sh:resultMessage "For an asymmetrical frame or a frame web angle below 90 degrees, antitripping support spacing must not exceed 1300 mm unless equivalent support is demonstrated by direct calculation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an asymmetrical frame or a frame web angle below 90 degrees, antitripping support spacing must not exceed 1300 mm unless equivalent support is demonstrated by direct calculation." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:equivalentSupportStatusByDirectCalculation true .
                }
                {
                    $this nltl:frameAsymmetrical true .
                }
                UNION
                {
                    $this nltl:frameWebAngleToShell [
                        qudt:numericValue ?angle ;
                        qudt:unit <http://qudt.org/vocab/unit/DEG>
                    ] .
                    FILTER (?angle < 90)
                }
                FILTER NOT EXISTS {
                    $this nltl:antitrippingSupportSpacing [
                        qudt:numericValue ?spacing ;
                        qudt:unit <http://qudt.org/vocab/unit/MilliM>
                    ] .
                    FILTER (?spacing <= 1300)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF052FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F01/frame> ] .

