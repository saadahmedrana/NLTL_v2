@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-P01/iceStringer> ;
            sh:resultMessage "Design line load, section modulus, and required shear area must satisfy the declared ice-stringer formulas; calculated results use a relative tolerance of 1e-6 plus an absolute fallback of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Design line load, section modulus, and required shear area must satisfy the declared ice-stringer formulas; calculated results use a relative tolerance of 1e-6 plus an absolute fallback of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this
                    nltl:icePressure/qudt:numericValue ?p ;
                    nltl:designIceLoadHeight/qudt:numericValue ?h ;
                    nltl:span/qudt:numericValue ?l ;
                    nltl:frameMomentFactorM/qudt:numericValue ?m ;
                    nltl:yieldStrength/qudt:numericValue ?sy ;
                    nltl:designLineLoad/qudt:numericValue ?line ;
                    nltl:sectionModulus/qudt:numericValue ?z ;
                    nltl:requiredShearArea/qudt:numericValue ?a .

                FILTER (
                    isNumeric(?p) &&
                    isNumeric(?h) &&
                    isNumeric(?l) &&
                    isNumeric(?m) &&
                    isNumeric(?sy) &&
                    isNumeric(?line) &&
                    isNumeric(?z) &&
                    isNumeric(?a)
                )

                BIND(IF((?p * ?h) > 0.15, (?p * ?h), 0.15) AS ?base)
                BIND(1000 * ?base AS ?expectedLine)
                BIND(0.9 * 1.8 * ?base * ?l * ?l / (?m * ?sy) * 1000000 AS ?expectedZ)
                BIND(1.7320508075688772 * 0.9 * 1.8 * 1.2 * ?base * ?l / (2 * ?sy) * 10000 AS ?expectedA)

                FILTER (
                    ?line != ?expectedLine ||
                    ABS(?z - ?expectedZ) > (0.000001 * ABS(?expectedZ) + 0.000000001) ||
                    ABS(?a - ?expectedA) > (0.000001 * ABS(?expectedA) + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF053IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-P01/iceStringer> ] .

