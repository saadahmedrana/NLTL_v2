@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F02/iceStringer> ;
            sh:resultMessage "Design line load, section modulus, and required shear area must satisfy the declared ice-stringer calculation formulas within the required numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Design line load, section modulus, and required shear area must satisfy the declared ice-stringer calculation formulas within the required numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this
                    nltl:icePressure ?pressureNode ;
                    nltl:designIceLoadHeight ?heightNode ;
                    nltl:span ?spanNode ;
                    nltl:frameMomentFactorM ?momentNode ;
                    nltl:yieldStrength ?yieldNode ;
                    nltl:designLineLoad ?lineNode ;
                    nltl:sectionModulus ?sectionNode ;
                    nltl:requiredShearArea ?areaNode .

                ?pressureNode qudt:numericValue ?p .
                ?heightNode qudt:numericValue ?h .
                ?spanNode qudt:numericValue ?l .
                ?momentNode qudt:numericValue ?m .
                ?yieldNode qudt:numericValue ?sigma .
                ?lineNode qudt:numericValue ?line .
                ?sectionNode qudt:numericValue ?z .
                ?areaNode qudt:numericValue ?area .

                BIND(IF((?p * ?h) < 0.15, 0.15, (?p * ?h)) AS ?designLineLoadMNPerM)
                BIND((1000 * ?designLineLoadMNPerM) AS ?expectedLine)
                BIND((0.9 * 1.8 * ?designLineLoadMNPerM * ?l * ?l / (?m * ?sigma) * 1000000) AS ?expectedZ)
                BIND((1.7320508075688772 * 0.9 * 1.8 * 1.2 * ?designLineLoadMNPerM * ?l / (2 * ?sigma) * 10000) AS ?expectedArea)

                FILTER (
                    ABS(?line - ?expectedLine) > (0.000001 * ABS(?expectedLine) + 0.000000001)
                    ||
                    ABS(?z - ?expectedZ) > (0.000001 * ABS(?expectedZ) + 0.000000001)
                    ||
                    ABS(?area - ?expectedArea) > (0.000001 * ABS(?expectedArea) + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-053-IceStringerCalculationShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F02/iceStringer> ] .

