@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ;
            sh:resultMessage "The design line load, section modulus, and required shear area must satisfy the declared ice stringer formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The design line load, section modulus, and required shear area must satisfy the declared ice stringer formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:designIceLoadHeight ?heightNode ;
                      nltl:span ?spanNode ;
                      nltl:frameMomentFactorM ?momentNode ;
                      nltl:yieldStrength ?strengthNode ;
                      nltl:designLineLoad ?lineNode ;
                      nltl:sectionModulus ?modulusNode ;
                      nltl:requiredShearArea ?areaNode .

                ?pressureNode qudt:numericValue ?pressure .
                ?heightNode qudt:numericValue ?height .
                ?spanNode qudt:numericValue ?span .
                ?momentNode qudt:numericValue ?moment .
                ?strengthNode qudt:numericValue ?strength .
                ?lineNode qudt:numericValue ?line .
                ?modulusNode qudt:numericValue ?modulus .
                ?areaNode qudt:numericValue ?area .

                BIND(?pressure * ?height AS ?product)
                BIND(IF(?product < 0.15, 0.15, ?product) AS ?loadMNPerM)
                BIND(1000 * ?loadMNPerM AS ?expectedLine)
                BIND(0.9 * 1.8 * ?loadMNPerM * ?span * ?span /
                     (?moment * ?strength) * 1000000 AS ?expectedModulus)
                BIND(1.7320508075688772 * 0.9 * 1.8 * 1.2 *
                     ?loadMNPerM * ?span /
                     (2 * ?strength) * 10000 AS ?expectedArea)

                FILTER(
                    ABS(?line - ?expectedLine) >
                        (0.000001 * ABS(?expectedLine) + 0.000000001)
                    ||
                    ABS(?modulus - ?expectedModulus) >
                        (0.000001 * ABS(?expectedModulus) + 0.000000001)
                    ||
                    ABS(?area - ?expectedArea) >
                        (0.000001 * ABS(?expectedArea) + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-053-IceStringerShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ] .

