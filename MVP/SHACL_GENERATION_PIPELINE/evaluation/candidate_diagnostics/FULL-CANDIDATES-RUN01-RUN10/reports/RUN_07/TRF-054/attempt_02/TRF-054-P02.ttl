@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-P02/iceStringer> ;
            sh:resultMessage "Node ex:iceStringer must conform to one or more shapes in <urn:nltl:generated-shape:TRF-054-applicable> , <urn:nltl:generated-shape:TRF-054-not-applicable>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-054> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-P02/iceStringer> ] .

