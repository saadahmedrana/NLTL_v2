) ; sh:minExclusive Literal("0", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:span ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minExclusive Literal("0", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:stringerSpan ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minExclusive Literal("0", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:icePressure ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minExclusive Literal("0", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:yieldStrength ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minExclusive Literal("0", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:frameMomentFactorM ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:requiredShearArea ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:sectionModulus ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:designLineLoad ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:outsideIceBeltFactor ] ; sh:sparql [ sh:message Literal("The applicable ice-stringer quantities and calculated results do not satisfy the verified formulas.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:icePressure ?pNode ;
                              nltl:designIceLoadHeight ?hNode ;
                              nltl:span ?spanNode ;
                              nltl:stringerSpan ?lsNode ;
                              nltl:frameMomentFactorM ?mNode ;
                              nltl:yieldStrength ?syNode ;
                              nltl:distanceToIceBelt ?hsNode ;
                              nltl:distanceToAdjacentIceStringer ?lsDistanceNode ;
                              nltl:designLineLoad ?loadNode ;
                              nltl:outsideIceBeltFactor ?factorNode ;
                              nltl:sectionModulus ?zNode ;
                              nltl:requiredShearArea ?aNode .
                        ?pNode qudt:numericValue ?p .
                        ?hNode qudt:numericValue ?h .
                        ?spanNode qudt:numericValue ?span .
                        ?lsNode qudt:numericValue ?ls .
                        ?mNode qudt:numericValue ?m .
                        ?syNode qudt:numericValue ?sy .
                        ?hsNode qudt:numericValue ?hs .
                        ?lsDistanceNode qudt:numericValue ?lsDistance .
                        ?loadNode qudt:numericValue ?load .
                        ?factorNode qudt:numericValue ?factor .
                        ?zNode qudt:numericValue ?z .
                        ?aNode qudt:numericValue ?a .
                        BIND(IF((?p * ?h) > 0.15, (?p * ?h), 0.15) AS ?loadMN)
                        BIND((1 - (?hs / ?lsDistance)) AS ?expectedFactor)
                        BIND((0.80 * 1.8 * ?loadMN * ?ls * ?ls /
                              (?m * ?sy) * ?expectedFactor * 1000000) AS ?expectedZ)
                        BIND((1.7320508075688772 * 0.80 * 1.8 * 1.2 * ?loadMN * ?ls /
                              (2 * ?sy) * ?expectedFactor * 10000) AS ?expectedA)
                        BIND((1000 * ?loadMN) AS ?expectedLoad)
                        BIND(IF(?expectedLoad > 0, ?expectedLoad,
                              IF(?expectedLoad < 0, -?expectedLoad, 0.000001)) AS ?loadScale)
                        BIND(IF(?expectedFactor > 0, ?expectedFactor,
                              IF(?expectedFactor < 0, -?expectedFactor, 0.000001)) AS ?factorScale)
                        BIND(IF(?expectedZ > 0, ?expectedZ,
                              IF(?expectedZ < 0, -?expectedZ, 0.000001)) AS ?zScale)
                        BIND(IF(?expectedA > 0, ?expectedA,
                              IF(?expectedA < 0, -?expectedA, 0.000001)) AS ?aScale)
                        FILTER(
                            (?span > ?ls + (0.000001 * IF(?span > 0, ?span, 0.000001))) ||
                            (?span < ?ls - (0.000001 * IF(?span > 0, ?span, 0.000001))) ||
                            (?factor > ?expectedFactor + (0.000001 * ?factorScale)) ||
                            (?factor < ?expectedFactor - (0.000001 * ?factorScale)) ||
                            (?load > ?expectedLoad + (0.000001 * ?loadScale)) ||
                            (?load < ?expectedLoad - (0.000001 * ?loadScale)) ||
                            (?z > ?expectedZ + (0.000001 * ?zScale)) ||
                            (?z < ?expectedZ - (0.000001 * ?zScale)) ||
                            (?a > ?expectedA + (0.000001 * ?aScale)) ||
                            (?a < ?expectedA - (0.000001 * ?aScale))
                        )
                    }
                ") ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:locatedOutsideIceBelt ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:supportsIceStrengthenedFrames ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF054Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-P03/iceStringer> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-P03/iceStringer> ;
            sh:resultMessage "Less than 1 values on ex:iceStringer->nltl:supportsIceStrengthenedFrames" ;
            sh:resultPath nltl:supportsIceStrengthenedFrames ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:supportsIceStrengthenedFrames ] ] .

