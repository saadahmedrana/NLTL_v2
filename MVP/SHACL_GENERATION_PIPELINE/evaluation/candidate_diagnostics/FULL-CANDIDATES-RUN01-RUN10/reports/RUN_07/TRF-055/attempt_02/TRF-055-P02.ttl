@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ;
            sh:resultMessage "A narrow deck strip must either be outside the stated applicability or satisfy the applicable section modulus, shear area, and conditional reduced line load requirements." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF055Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ] .

