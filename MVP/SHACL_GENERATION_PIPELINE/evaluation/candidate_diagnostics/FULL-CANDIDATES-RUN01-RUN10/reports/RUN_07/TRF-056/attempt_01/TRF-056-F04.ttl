@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F04/hatch> ;
                    sh:resultMessage "Node ex:hatch must conform to one or more shapes in gen:TRF056NonApplicableHatch , gen:TRF056ApplicableHatch" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:TRF056WeatherdeckHatchCase ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F04/hatch> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF056WeatherdeckHatchCase. See details for more information." ;
            sh:resultPath nltl:hasWeatherdeckHatch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:TRF056WeatherdeckHatchCase ;
                    sh:path nltl:hasWeatherdeckHatch ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F04/hatch> ] .

