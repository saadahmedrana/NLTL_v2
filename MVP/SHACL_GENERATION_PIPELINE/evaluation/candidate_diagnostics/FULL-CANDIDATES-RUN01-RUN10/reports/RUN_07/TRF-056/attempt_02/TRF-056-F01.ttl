@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F01/hatch> ;
                    sh:resultMessage "For a weatherdeck hatch longer than half the ship breadth, ship-side deflection and both hatch-cover and hatch-fitting design evidence must be represented." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "For a weatherdeck hatch longer than half the ship breadth, ship-side deflection and both hatch-cover and hatch-fitting design evidence must be represented." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:weatherdeckHatch ;
                    nltl:hatchOpeningLength ?opening ;
                    ^nltl:hasWeatherdeckHatch ?ship .

                ?ship a nltl:ship ;
                    nltl:shipBreadth ?breadth .

                ?opening qudt:numericValue ?openingValue ;
                    qudt:unit unit:M .

                ?breadth qudt:numericValue ?breadthValue ;
                    qudt:unit unit:M .

                FILTER (
                    ?openingValue > (?breadthValue / 2)
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:shipSideDeflection ?deflection .
                        ?deflection qudt:numericValue ?deflectionValue ;
                            qudt:unit unit:M .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasHatchCoverDesignEvidence ?coverEvidence .
                        ?coverEvidence a nltl:hatchCoverDesignEvidence .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasHatchFittingDesignEvidence ?fittingEvidence .
                        ?fittingEvidence a nltl:hatchFittingDesignEvidence .
                    }
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:TRF056WeatherdeckHatchCase ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F01/hatch> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF056WeatherdeckHatchCase. See details for more information." ;
            sh:resultPath nltl:hasWeatherdeckHatch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:TRF056WeatherdeckHatchCase ;
                    sh:path nltl:hasWeatherdeckHatch ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F01/hatch> ] .

