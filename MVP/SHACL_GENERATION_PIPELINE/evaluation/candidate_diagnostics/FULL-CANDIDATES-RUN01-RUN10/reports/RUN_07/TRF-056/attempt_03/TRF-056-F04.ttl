@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F04/ship> ;
            sh:resultMessage "For a weatherdeck hatch longer than half the ship breadth, ship-side deflection and both hatch design evidence relationships must be represented." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a weatherdeck hatch longer than half the ship breadth, ship-side deflection and both hatch design evidence relationships must be represented." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipBreadth ?breadthQuantity .
                ?breadthQuantity qudt:numericValue ?breadth .
                $this nltl:hasWeatherdeckHatch ?hatch .
                ?hatch nltl:hatchOpeningLength ?openingQuantity .
                ?openingQuantity qudt:numericValue ?openingLength .
                FILTER (?openingLength > (?breadth / 2))
                FILTER (
                    NOT EXISTS {
                        ?hatch nltl:shipSideDeflection ?deflection .
                        ?deflection a qudt:QuantityValue ;
                            qudt:numericValue ?deflectionValue ;
                            qudt:unit unit:M .
                    }
                    ||
                    NOT EXISTS {
                        ?hatch nltl:hasHatchCoverDesignEvidence ?coverEvidence .
                        ?coverEvidence a nltl:hatchCoverDesignEvidence .
                    }
                    ||
                    NOT EXISTS {
                        ?hatch nltl:hasHatchFittingDesignEvidence ?fittingEvidence .
                        ?fittingEvidence a nltl:hatchFittingDesignEvidence .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF056ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F04/ship> ] .

