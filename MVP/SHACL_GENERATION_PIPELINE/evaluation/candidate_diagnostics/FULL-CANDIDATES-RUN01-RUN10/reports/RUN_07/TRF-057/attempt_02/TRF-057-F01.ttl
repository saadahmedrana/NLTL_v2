@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "webFrameIceLoad must equal 1.8 times the effective ice pressure-height line load times webFrameSpacing, with a 0.15 MN/m minimum and conversion from MN to kN." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "webFrameIceLoad must equal 1.8 times the effective ice pressure-height line load times webFrameSpacing, with a 0.15 MN/m minimum and conversion from MN to kN." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureQuantity ;
                      nltl:iceLoadHeight ?heightQuantity ;
                      nltl:webFrameSpacing ?spacingQuantity ;
                      nltl:webFrameIceLoad ?loadQuantity .

                ?pressureQuantity qudt:numericValue ?pressure .
                ?heightQuantity qudt:numericValue ?height .
                ?spacingQuantity qudt:numericValue ?spacing .
                ?loadQuantity qudt:numericValue ?actualLoad .

                BIND((?pressure * ?height) AS ?pressureHeight)
                BIND(IF(?pressureHeight < 0.15, 0.15, ?pressureHeight) AS ?effectiveLineLoad)
                BIND((1.8 * ?effectiveLineLoad * ?spacing * 1000) AS ?expectedLoad)
                BIND(IF((?expectedLoad * 0.000001) > 0.000000001,
                        (?expectedLoad * 0.000001),
                        0.000000001) AS ?tolerance)

                FILTER (
                    ?actualLoad < (?expectedLoad - ?tolerance)
                    || ?actualLoad > (?expectedLoad + ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF057WebFrameIceLoadShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ] .

