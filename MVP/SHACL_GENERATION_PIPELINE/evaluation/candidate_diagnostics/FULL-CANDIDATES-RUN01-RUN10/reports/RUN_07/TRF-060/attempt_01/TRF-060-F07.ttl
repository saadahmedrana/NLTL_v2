@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F07/lookup> ;
                    sh:resultMessage "The table lookup case shall reference TRAFICOM Table 4-8." ;
                    sh:resultPath nltl:tableReference ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n257d308cad7348d3a615c35b1eca99c5b43 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F07/lookup> ;
                    sh:resultMessage "The table lookup case shall reference TRAFICOM Table 4-8." ;
                    sh:resultPath nltl:tableReference ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n257d308cad7348d3a615c35b1eca99c5b43 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F07/ship> ;
            sh:resultMessage "The ship shall provide a Table 4-8 lookup case with selection evidence." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide a Table 4-8 lookup case with selection evidence." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:tableLookupCase ;
                            sh:property [ sh:message "The Table 4-8 gamma factor shall be provided as an externally selected dimensionless result." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:webFrameTable4Dash8GammaFactor ],
                                [ sh:class nltl:evidenceArtifact ;
                                    sh:message "The Table 4-8 selection shall have supporting evidence." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:lookupSelectionEvidence ],
                                [ sh:class nltl:tableReferenceValue ;
                                    sh:hasValue nltl:traficomTable4Dash8 ;
                                    sh:maxCount 1 ;
                                    sh:message "The table lookup case shall reference TRAFICOM Table 4-8." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:tableReference ] ] ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F07/lookup> ] .

_:n257d308cad7348d3a615c35b1eca99c5b43 sh:class nltl:tableReferenceValue ;
    sh:hasValue nltl:traficomTable4Dash8 ;
    sh:maxCount 1 ;
    sh:message "The table lookup case shall reference TRAFICOM Table 4-8." ;
    sh:minCount 1 ;
    sh:path nltl:tableReference .

