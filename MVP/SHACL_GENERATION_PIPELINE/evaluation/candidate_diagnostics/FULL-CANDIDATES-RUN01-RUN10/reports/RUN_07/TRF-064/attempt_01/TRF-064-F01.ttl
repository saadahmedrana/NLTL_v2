@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/shafting> ;
                    sh:resultMessage "Side propeller shafting must be enclosed within plated bossing." ;
                    sh:resultPath nltl:enclosedByPlatedBossing ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Side propeller shafting must be enclosed within plated bossing." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:platedBossingStructure ] ;
                            sh:path nltl:enclosedByPlatedBossing ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:sidePropellerShaftingAssembly ; sh:property [ sh:message Literal(\"Side propeller shafting must be enclosed within plated bossing.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:platedBossingStructure ] ; sh:path nltl:enclosedByPlatedBossing ] ]. See details for more information." ;
            sh:resultPath nltl:hasSidePropellerShafting ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:sidePropellerShaftingAssembly ;
                            sh:property [ sh:message "Side propeller shafting must be enclosed within plated bossing." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:platedBossingStructure ] ;
                                    sh:path nltl:enclosedByPlatedBossing ] ] ;
                    sh:path nltl:hasSidePropellerShafting ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/shafting> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:detachedStrut ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:detachedStrut ], [ sh:message Literal(\"When detached struts are used, their design, strength, and hull attachments must be evidenced.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:detachedStrutStructure ; sh:property [ sh:message Literal(\"A detached strut requires design evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:strutDesignEvidence ] ; sh:path nltl:hasStrutDesignEvidence ], [ sh:message Literal(\"A detached strut requires hull-attachment evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:strutHullAttachmentEvidence ] ; sh:path nltl:hasStrutHullAttachmentEvidence ], [ sh:message Literal(\"A detached strut requires strength evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:strutStrengthEvidence ] ; sh:path nltl:hasStrutStrengthEvidence ] ] ; sh:path nltl:hasDetachedStrut ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_064_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/ship> ;
            sh:resultMessage "The ship must state whether detached struts are used." ;
            sh:resultPath nltl:detachedStrut ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ship must state whether detached struts are used." ;
                    sh:minCount 1 ;
                    sh:path nltl:detachedStrut ] ] .

