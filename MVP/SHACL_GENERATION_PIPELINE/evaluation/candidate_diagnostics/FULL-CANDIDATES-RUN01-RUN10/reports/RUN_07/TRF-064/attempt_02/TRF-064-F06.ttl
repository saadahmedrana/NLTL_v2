@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F06/ship> ;
            sh:resultMessage "Each represented side-propeller shafting assembly must also be the ship component enclosed by a plated bossing." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each represented side-propeller shafting assembly must also be the ship component enclosed by a plated bossing." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>

            SELECT $this
            WHERE {
                $this nltl:hasSidePropellerShafting ?shaft .
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?shaft .
                    ?shaft nltl:enclosedByPlatedBossing ?bossing .
                    ?bossing a nltl:platedBossingStructure .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF064ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F06/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F06/ship> ;
            sh:resultMessage "Each represented stern tube must also be the ship component enclosed by a plated bossing." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each represented stern tube must also be the ship component enclosed by a plated bossing." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>

            SELECT $this
            WHERE {
                $this nltl:hasSternTube ?tube .
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?tube .
                    ?tube nltl:enclosedByPlatedBossing ?bossing .
                    ?bossing a nltl:platedBossingStructure .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF064ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F06/ship> ] .

