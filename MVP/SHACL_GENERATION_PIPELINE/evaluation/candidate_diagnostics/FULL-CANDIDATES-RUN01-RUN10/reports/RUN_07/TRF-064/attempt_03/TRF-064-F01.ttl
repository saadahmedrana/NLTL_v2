@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/ship> ;
            sh:resultMessage "The side-propeller shafting and stern-tube arrangement shall include a ship component enclosed by plated bossing." ;
            sh:resultPath ( nltl:hasComponent nltl:enclosedByPlatedBossing ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:platedBossingStructure ;
                    sh:message "The side-propeller shafting and stern-tube arrangement shall include a ship component enclosed by plated bossing." ;
                    sh:minCount 1 ;
                    sh:path ( nltl:hasComponent nltl:enclosedByPlatedBossing ) ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/ship> ;
            sh:resultMessage "A detached strut shall be represented with its required design, strength, and hull-attachment relationships." ;
            sh:resultPath nltl:hasDetachedStrut ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:detachedStrutStructure ;
                    sh:message "A detached strut shall be represented with its required design, strength, and hull-attachment relationships." ;
                    sh:minCount 1 ;
                    sh:node gs:TRF064DetachedStrutShape ;
                    sh:path nltl:hasDetachedStrut ] ] .

