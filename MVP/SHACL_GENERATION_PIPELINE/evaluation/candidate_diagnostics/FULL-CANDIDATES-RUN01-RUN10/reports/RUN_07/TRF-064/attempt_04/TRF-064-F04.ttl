@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:hasDetachedStrut ] ] , [ sh:property [ sh:class nltl:detachedStrutStructure ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:strutDesignEvidence ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutDesignEvidence ], [ sh:class nltl:strutHullAttachmentEvidence ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutHullAttachmentEvidence ], [ sh:class nltl:strutStrengthEvidence ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutStrengthEvidence ] ] ; sh:path nltl:hasDetachedStrut ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF064Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F04/ship> ;
            sh:resultMessage "The applicable side-propeller shafting and stern-tube component path shall reach plated bossing." ;
            sh:resultPath ( nltl:hasComponent nltl:enclosedByPlatedBossing ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:platedBossingStructure ;
                    sh:message "The applicable side-propeller shafting and stern-tube component path shall reach plated bossing." ;
                    sh:minCount 1 ;
                    sh:path ( nltl:hasComponent nltl:enclosedByPlatedBossing ) ] ] .

