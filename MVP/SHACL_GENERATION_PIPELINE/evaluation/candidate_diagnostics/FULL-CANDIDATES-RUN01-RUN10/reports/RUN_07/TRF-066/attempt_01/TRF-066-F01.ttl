@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F01/ship> ;
            sh:resultMessage "When an ice knife is practicable for ice class IA or IA Super, the rudder protection arrangement must include an ice knife extending below the lower ice waterline." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When an ice knife is practicable for ice class IA or IA Super, the rudder protection arrangement must include an ice knife extending below the lower ice waterline." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:iceKnifePracticable ?practicable .
                FILTER (
                    (?iceClass = nltl:iceClassIa ||
                     ?iceClass = nltl:iceClassIaSuper) &&
                    datatype(?practicable) = xsd:boolean &&
                    ?practicable = true
                )
                FILTER NOT EXISTS {
                    $this nltl:hasRudderProtectionArrangement ?arrangement .
                    {
                        ?arrangement a nltl:iceKnife ;
                                     nltl:extendsBelowLowerIceWaterline true .
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF_066_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F01/ship> ] .

