@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( nltl:iceClassIa nltl:iceClassIaSuper nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc ) ; sh:path nltl:iceClass ] ; sh:sparql [ sh:message Literal("For ice class IB or IC, the ballast-condition propeller top depth must be at least hi when the non-applicable branch is used.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:ballastConditionPropellerTopDepth ?depthQuantity .
                        ?depthQuantity qudt:numericValue ?depth .
                        $this nltl:requiredPropellerSubmersionDepthHi ?hiQuantity .
                        ?hiQuantity qudt:numericValue ?hi .
                        FILTER (!(?depth >= ?hi))
                    }
                ") ] ] , [ sh:property [ sh:class nltl:iceClassValue ; sh:hasValue nltl:iceClassIa ; sh:message Literal("When the ballast-condition propeller top depth is below hi for ice class IB or IC, the propulsion system must be designed according to ice class IA.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:propulsionSystemDesignedForIceClass ], [ sh:in ( nltl:iceClassIb nltl:iceClassIc ) ; sh:path nltl:iceClass ] ; sh:sparql [ sh:message Literal("The applicable ice-class branch requires the ballast-condition propeller top depth to be below hi.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:ballastConditionPropellerTopDepth ?depthQuantity .
                        ?depthQuantity qudt:numericValue ?depth .
                        $this nltl:requiredPropellerSubmersionDepthHi ?hiQuantity .
                        ?hiQuantity qudt:numericValue ?hi .
                        FILTER (!(?depth < ?hi))
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF074ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-F01/ship> ] .

