@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in g:TRF076CPBranch , g:TRF076FPBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:TRF076Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F04/ship> ] .

