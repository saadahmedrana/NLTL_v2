@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/table6> ;
                    sh:resultMessage "Node ex:table6 must conform to one or more shapes in [ sh:property [ sh:class nltl:iceClassValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:hasValue nltl:traficomTable6Dash6 ; sh:path nltl:tableReference ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:selectedIceClassCycleCount ] ] , [ sh:property [ sh:class nltl:propellerLocationValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:tableLookupPropellerLocation ], [ sh:hasValue nltl:traficomTable6Dash7 ; sh:path nltl:tableReference ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:selectedPropellerLocationFactor ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:or ( [ sh:property [ sh:class nltl:iceClassValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:nodeKind sh:IRI ;
                                                sh:path nltl:iceClass ],
                                            [ sh:hasValue nltl:traficomTable6Dash6 ;
                                                sh:path nltl:tableReference ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:nodeKind sh:IRI ;
                                                sh:path nltl:selectedIceClassCycleCount ] ] [ sh:property [ sh:class nltl:propellerLocationValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:nodeKind sh:IRI ;
                                                sh:path nltl:tableLookupPropellerLocation ],
                                            [ sh:hasValue nltl:traficomTable6Dash7 ;
                                                sh:path nltl:tableReference ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:nodeKind sh:IRI ;
                                                sh:path nltl:selectedPropellerLocationFactor ] ] ) ;
                            sh:property [ sh:class nltl:tableReferenceValue ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:tableReference ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/table6> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:or ( [ sh:property [ sh:class nltl:iceClassValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:hasValue nltl:traficomTable6Dash6 ; sh:path nltl:tableReference ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:selectedIceClassCycleCount ] ] [ sh:property [ sh:class nltl:propellerLocationValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:tableLookupPropellerLocation ], [ sh:hasValue nltl:traficomTable6Dash7 ; sh:path nltl:tableReference ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:selectedPropellerLocationFactor ] ] ) ; sh:property [ sh:class nltl:tableReferenceValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:tableReference ] ]. See details for more information." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:tableLookupCase ;
                    sh:minCount 2 ;
                    sh:node [ sh:or ( [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:nodeKind sh:IRI ;
                                                sh:path nltl:selectedIceClassCycleCount ],
                                            [ sh:hasValue nltl:traficomTable6Dash6 ;
                                                sh:path nltl:tableReference ],
                                            [ sh:class nltl:iceClassValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:nodeKind sh:IRI ;
                                                sh:path nltl:iceClass ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:nodeKind sh:IRI ;
                                                sh:path nltl:selectedPropellerLocationFactor ],
                                            [ sh:class nltl:propellerLocationValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:nodeKind sh:IRI ;
                                                sh:path nltl:tableLookupPropellerLocation ],
                                            [ sh:hasValue nltl:traficomTable6Dash7 ;
                                                sh:path nltl:tableReference ] ] ) ;
                            sh:property [ sh:class nltl:tableReferenceValue ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:tableReference ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/table6> ] .

