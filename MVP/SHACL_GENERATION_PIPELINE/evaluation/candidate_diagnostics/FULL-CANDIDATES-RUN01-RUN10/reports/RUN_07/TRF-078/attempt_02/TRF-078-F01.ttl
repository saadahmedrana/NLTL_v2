@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "Exactly one Table 6-6 lookup case is required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Exactly one Table 6-6 lookup case is required." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasTableLookupCase ?case .
                    ?case nltl:tableReference nltl:traficomTable6Dash6 .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF078ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "The Table 6-7 case must contain a propeller-location selection and selected location factor." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The Table 6-7 case must contain a propeller-location selection and selected location factor." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?case .
                ?case nltl:tableReference nltl:traficomTable6Dash7 .
                FILTER (
                    NOT EXISTS { ?case nltl:tableLookupPropellerLocation ?location }
                    ||
                    NOT EXISTS { ?case nltl:selectedPropellerLocationFactor ?factor }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF078ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "Only one Table 6-7 lookup case is permitted." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Only one Table 6-7 lookup case is permitted." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?case1 .
                $this nltl:hasTableLookupCase ?case2 .
                ?case1 nltl:tableReference nltl:traficomTable6Dash7 .
                ?case2 nltl:tableReference nltl:traficomTable6Dash7 .
                FILTER (?case1 != ?case2)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF078ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ] .

