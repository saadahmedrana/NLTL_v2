@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ;
            sh:resultMessage "The immersion function and submersion factor k2 must satisfy the specified formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The immersion function and submersion factor k2 must satisfy the specified formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?hNode ;
                      nltl:iceLoadCycleCoefficientK2 ?kNode ;
                      nltl:propellerDiameter ?dNode ;
                      nltl:propellerImmersionFunction ?fNode ;
                      nltl:propellerShaftCentrelineDepth ?h0Node .
                ?hNode qudt:numericValue ?h .
                ?kNode qudt:numericValue ?k .
                ?dNode qudt:numericValue ?d .
                ?fNode qudt:numericValue ?fReported .
                ?h0Node qudt:numericValue ?h0 .
                FILTER (?d != 0)
                BIND (((?h0 - ?h) / (?d / 2)) - 1 AS ?fExpected)
                BIND (
                    IF(
                        ?fExpected < 0,
                        0.8 - ?fExpected,
                        IF(
                            ?fExpected <= 1,
                            0.8 - (0.4 * ?fExpected),
                            IF(
                                ?fExpected <= 2.5,
                                0.6 - (0.2 * ?fExpected),
                                0.1
                            )
                        )
                    ) AS ?kExpected
                )
                FILTER (
                    ABS(?fReported - ?fExpected) >
                    ((0.000001 * ABS(?fExpected)) + 0.000000001)
                    ||
                    ABS(?k - ?kExpected) >
                    ((0.000001 * ABS(?kExpected)) + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF_079_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ] .

