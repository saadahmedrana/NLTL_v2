@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-F01/ship> ;
            sh:resultMessage "Ice thrust and propeller shaft design thrust values must satisfy the TRF-081 formulas; calculated decimal results are checked with a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ice thrust and propeller shaft design thrust values must satisfy the TRF-081 formulas; calculated decimal results are checked with a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce ?ffNode ;
                      nltl:backwardBladeForce ?fbNode ;
                      nltl:hydrodynamicBollardThrust ?tNode ;
                      nltl:forwardIceThrust ?tfNode ;
                      nltl:backwardIceThrust ?tbNode ;
                      nltl:forwardPropellerShaftDesignThrust ?trfNode ;
                      nltl:backwardPropellerShaftDesignThrust ?trbNode ;
                      nltl:propellerShaftDesignThrust ?trNode .

                ?ffNode qudt:numericValue ?ff .
                ?fbNode qudt:numericValue ?fb .
                ?tNode qudt:numericValue ?t .
                ?tfNode qudt:numericValue ?tf .
                ?tbNode qudt:numericValue ?tb .
                ?trfNode qudt:numericValue ?trf .
                ?trbNode qudt:numericValue ?trb .
                ?trNode qudt:numericValue ?tr .

                BIND((1.1 * ?ff) AS ?expectedTf)
                BIND((1.1 * ?fb) AS ?expectedTb)
                BIND((?t + (2.2 * ?expectedTf)) AS ?forwardLoad)
                BIND((1.5 * ?expectedTb) AS ?backwardLoad)
                BIND(IF(?forwardLoad > ?backwardLoad, ?forwardLoad, ?backwardLoad) AS ?designLoad)

                FILTER(
                    ABS(?tf - ?expectedTf) >
                    ((0.000001 * ABS(?expectedTf)) + 0.000000001)
                    ||
                    ABS(?tb - ?expectedTb) >
                    ((0.000001 * ABS(?expectedTb)) + 0.000000001)
                    ||
                    ABS(?trf - ?designLoad) >
                    ((0.000001 * ABS(?designLoad)) + 0.000000001)
                    ||
                    ABS(?trb - ?designLoad) >
                    ((0.000001 * ABS(?designLoad)) + 0.000000001)
                    ||
                    ABS(?tr - ?designLoad) >
                    ((0.000001 * ABS(?designLoad)) + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF081Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-F01/ship> ] .

