@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bollardPropellerSpeedKnown ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:BollardSpeedQuantityShape ; sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bollardPropellerSpeedKnown ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF085TableLookupCaseShape ; sh:path nltl:hasTableLookupCase ] ; sh:sparql [ sh:message Literal("The Table 6-9 lookup input must represent the ship's propeller diameter.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT ?this WHERE {
                        ?this nltl:propellerDiameter ?diameter .
                        ?diameter qudt:numericValue ?diameterValue .
                        ?this nltl:hasTableLookupCase ?case .
                        ?case nltl:lookupInputQuantity ?input .
                        ?input qudt:numericValue ?inputValue .
                        FILTER(
                            ABS(?diameterValue - ?inputValue) >
                            0.000001 * IF(ABS(?diameterValue) > 1, ABS(?diameterValue), 1)
                        )
                    }
                ") ], [ sh:message Literal("The Table 6-9 lookup result must equal the selected bollard propeller speed.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT ?this WHERE {
                        ?this nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ?speed .
                        ?speed qudt:numericValue ?speedValue .
                        ?this nltl:hasTableLookupCase ?case .
                        ?case nltl:lookupResultQuantity ?result .
                        ?result qudt:numericValue ?resultValue .
                        FILTER(
                            ABS(?speedValue - ?resultValue) >
                            0.000001 * IF(ABS(?speedValue) > 1, ABS(?speedValue), 1)
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF085Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-F01/ship> ] .

