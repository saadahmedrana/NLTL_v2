@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-F01/ship> ;
            sh:resultMessage "For a CP propeller with unknown pitch value, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within a relative tolerance of 1e-6, with an absolute tolerance of 1e-9 near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a CP propeller with unknown pitch value, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within a relative tolerance of 1e-6, with an absolute tolerance of 1e-9 near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType "CP"^^xsd:string ;
                      nltl:pitchValueKnown false ;
                      nltl:propellerPitchAtMcrFreeRunning ?freeQuantity ;
                      nltl:propellerPitchAtMcrBollard ?bollardQuantity .

                ?freeQuantity qudt:numericValue ?free ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .

                ?bollardQuantity qudt:numericValue ?observed ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .

                FILTER (datatype(?free) = xsd:decimal)
                FILTER (datatype(?observed) = xsd:decimal)

                BIND ((0.7 * ?free) AS ?expected)
                BIND (IF(?expected < 0, -?expected, ?expected) AS ?magnitude)
                BIND (
                    IF(
                        ?magnitude < 0.000000000001,
                        0.000000001,
                        ?magnitude * 0.000001
                    )
                    AS ?tolerance
                )

                FILTER (
                    ?observed < (?expected - ?tolerance) ||
                    ?observed > (?expected + ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF_086_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-F01/ship> ] .

