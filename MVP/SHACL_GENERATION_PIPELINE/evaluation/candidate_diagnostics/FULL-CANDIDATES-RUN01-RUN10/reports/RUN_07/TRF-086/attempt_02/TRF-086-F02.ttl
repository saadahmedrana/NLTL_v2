@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:TRF_086_CP_Known , gs:TRF_086_CP_Unknown , gs:TRF_086_Not_CP" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF_086_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-F02/ship> ] .

