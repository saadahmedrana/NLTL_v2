@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:maximumEngineTorqueKnown ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:maximumEngineTorqueKnown ], [ sh:message Literal(\"When maximum engine torque is unknown, the ship must record an applied Table 6-10 lookup case with the required selection evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:tableLookupCase ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:tableLookupApplied ], [ sh:in ( nltl:traficomTable6Dash10 ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:tableReference ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:evidenceArtifact ] ; sh:path nltl:lookupSelectionEvidence ] ] ; sh:path nltl:hasTableLookupCase ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-088> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F01/ship> ] .

