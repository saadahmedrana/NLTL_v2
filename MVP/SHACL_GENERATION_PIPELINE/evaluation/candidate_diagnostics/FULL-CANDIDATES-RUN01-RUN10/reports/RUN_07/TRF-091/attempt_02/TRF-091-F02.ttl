_:n60cdf6fa8e1f4eeaadd5caab9f165a3ab2 sh:class nltl:loadCase ;
    sh:maxCount 1 ;
    sh:message "A propulsion-line strength-evaluation load case is required." ;
    sh:minCount 1 ;
    sh:node gen:TRF091LoadCaseShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasPropulsionLoadCase .

_:n60cdf6fa8e1f4eeaadd5caab9f165a3ab1 sh:class nltl:iceMillingSequenceCase ;
    sh:equals nltl:hasPropulsionLoadCase ;
    sh:maxCount 1 ;
    sh:message "The ice-milling sequence case must be the propulsion-line strength-evaluation load case." ;
    sh:minCount 1 ;
    sh:node gen:TRF091LoadCaseShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasIceMillingSequenceCase .

_:n60cdf6fa8e1f4eeaadd5caab9f165a3ab3 sh:class nltl:loadCasePurposeValue ;
    sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
    sh:maxCount 1 ;
    sh:message "The load case must be designated for propulsion-line strength evaluation and not for propulsion-system stalling analysis." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:loadCasePurpose .

