@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-F02/component0> ;
                    sh:resultMessage "A propeller blade loss shall not cause significant damage to the propeller shaft line component." ;
                    sh:resultPath nltl:significantDamageFromBladeLoss ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n259db3ce7eb84062b1a5be1229460754b4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-F02/component0> ;
                    sh:resultMessage "A propeller blade loss shall not cause significant damage to the propeller shaft line component." ;
                    sh:resultPath nltl:significantDamageFromBladeLoss ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n259db3ce7eb84062b1a5be1229460754b4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-F02/ship> ;
            sh:resultMessage "The ship shall identify at least one other propeller shaft line component for verification." ;
            sh:resultPath nltl:hasPropellerShaftLineComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify at least one other propeller shaft line component for verification." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue false ;
                                    sh:maxCount 1 ;
                                    sh:message "A propeller blade loss shall not cause significant damage to the propeller shaft line component." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:significantDamageFromBladeLoss ] ] ;
                    sh:path nltl:hasPropellerShaftLineComponent ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-F02/component0> ] .

_:n259db3ce7eb84062b1a5be1229460754b4 sh:datatype xsd:boolean ;
    sh:hasValue false ;
    sh:maxCount 1 ;
    sh:message "A propeller blade loss shall not cause significant damage to the propeller shaft line component." ;
    sh:minCount 1 ;
    sh:path nltl:significantDamageFromBladeLoss .

