@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-P02/ship> ;
            sh:resultMessage "The blade material properties must be recorded for SN-curve correspondence." ;
            sh:resultPath nltl:propellerBladeMaterialProperty ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The blade material properties must be recorded for SN-curve correspondence." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerBladeMaterialProperty ] ] .

