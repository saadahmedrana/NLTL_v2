@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F04/lookup> ;
                    sh:resultMessage "Less than 1 values on ex:lookup->nltl:fatigueCoefficientC4" ;
                    sh:resultPath nltl:fatigueCoefficientC4 ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:BlankNodeOrIRI ;
                            sh:path nltl:fatigueCoefficientC4 ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F04/lookup> ;
                    sh:resultMessage "Node ex:lookup must conform to one or more shapes in gen:TRF109OpenCaseShape , gen:TRF109DuctedCaseShape" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:TRF109TableLookupCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F04/lookup> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F04/ship> ;
            sh:resultMessage "The ship must have exactly one applicable Table 6-14 lookup case." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:tableLookupCase ;
                    sh:maxCount 1 ;
                    sh:message "The ship must have exactly one applicable Table 6-14 lookup case." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF109TableLookupCaseShape ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F04/lookup> ] .

