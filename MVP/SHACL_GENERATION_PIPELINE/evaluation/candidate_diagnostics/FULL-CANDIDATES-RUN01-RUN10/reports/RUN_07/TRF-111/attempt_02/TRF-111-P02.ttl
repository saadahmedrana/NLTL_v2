@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P02/ship> ;
            sh:resultMessage "When a fatigue load case is represented, each ship component must have a fatigue safety factor of at least 1.5 with a dimensionless quantity value." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When a fatigue load case is represented, each ship component must have a fatigue safety factor of at least 1.5 with a dimensionless quantity value." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasPropulsionLoadCase ?loadCase .
                ?loadCase nltl:shaftLineLoadCaseType nltl:fatigueLoadCase .
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?component .
                    FILTER NOT EXISTS {
                        ?component nltl:fatigueSafetyFactor ?factor .
                        ?factor qudt:numericValue ?value ;
                                qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (datatype(?value) = xsd:decimal && ?value >= 1.5)
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-111-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P02/ship> ] .

