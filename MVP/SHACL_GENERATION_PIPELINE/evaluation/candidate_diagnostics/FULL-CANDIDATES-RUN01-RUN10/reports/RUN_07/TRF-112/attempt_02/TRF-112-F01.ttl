@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F01/ship> ;
            sh:resultMessage "An applicable blade-failure load case must contain both declared load operands with numeric values and kN units." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "An applicable blade-failure load case must contain both declared load operands with numeric values and kN units." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>

            SELECT $this WHERE {
                $this nltl:hasPropulsionLoadCase ?loadCase .
                ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
                FILTER (
                    NOT EXISTS {
                        ?loadCase nltl:bladeFailureUltimateLoad ?ultimateLoad .
                        ?ultimateLoad qudt:numericValue ?ultimateValue .
                        ?ultimateLoad qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                    }
                    ||
                    NOT EXISTS {
                        ?loadCase nltl:combinedAxialBendingTorsionLoad ?combinedLoad .
                        ?combinedLoad qudt:numericValue ?combinedValue .
                        ?combinedLoad qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-112> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F01/ship> ] .

