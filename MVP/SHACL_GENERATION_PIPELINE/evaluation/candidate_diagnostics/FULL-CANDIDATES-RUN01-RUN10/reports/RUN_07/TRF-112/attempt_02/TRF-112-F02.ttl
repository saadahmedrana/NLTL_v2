@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F02/ship> ;
            sh:resultMessage "Every linked propeller shaft line component must report bending and torsional yield safety factors for an applicable blade-failure load case." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Every linked propeller shaft line component must report bending and torsional yield safety factors for an applicable blade-failure load case." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>

            SELECT $this WHERE {
                $this nltl:hasPropulsionLoadCase ?loadCase .
                ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
                $this nltl:hasPropellerShaftLineComponent ?component .
                FILTER (
                    NOT EXISTS {
                        ?component nltl:bendingYieldSafetyFactor ?bendingFactor .
                        ?bendingFactor qudt:numericValue ?bendingValue .
                        ?bendingFactor qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    }
                    ||
                    NOT EXISTS {
                        ?component nltl:torsionalYieldSafetyFactor ?torsionalFactor .
                        ?torsionalFactor qudt:numericValue ?torsionalValue .
                        ?torsionalFactor qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-112> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F02/ship> ] .

