@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/ship> ;
            sh:resultMessage "Every reported bending or torsional yield safety factor must be at least 1.0." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Every reported bending or torsional yield safety factor must be at least 1.0." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>

            SELECT $this WHERE {
                $this nltl:hasPropulsionLoadCase ?loadCase .
                ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
                $this nltl:hasPropellerShaftLineComponent ?component .
                ?component
                    ?factorProperty ?factorQuantity .
                FILTER (
                    ?factorProperty = nltl:bendingYieldSafetyFactor ||
                    ?factorProperty = nltl:torsionalYieldSafetyFactor
                )
                ?factorQuantity qudt:numericValue ?factorValue .
                FILTER (?factorValue < 1.0)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-112> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/ship> ] .

