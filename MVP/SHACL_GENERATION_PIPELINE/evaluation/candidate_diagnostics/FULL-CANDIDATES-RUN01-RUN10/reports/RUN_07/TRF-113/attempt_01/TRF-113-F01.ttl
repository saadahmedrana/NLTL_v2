@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The ship shall record the propeller blade orientation causing the maximum component load." ;
            sh:resultPath nltl:propellerBladeOrientation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship shall record the propeller blade orientation causing the maximum component load." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerBladeOrientation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The ship shall identify a thruster fitting subject to the blade-loss plastic-bending design requirement." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify a thruster fitting subject to the blade-loss plastic-bending design requirement." ;
                    sh:path nltl:hasComponent ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:thrusterFitting ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "Evidence of the thruster blade-loss design assessment shall be provided." ;
            sh:resultPath nltl:thrusterBladeLossDesignEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Evidence of the thruster blade-loss design assessment shall be provided." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:evidenceArtifact ] ;
                    sh:path nltl:thrusterBladeLossDesignEvidence ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The ship shall record the plastic bending design condition for the blade-loss case." ;
            sh:resultPath nltl:bladePlasticBending ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship shall record the plastic bending design condition for the blade-loss case." ;
                    sh:minCount 1 ;
                    sh:path nltl:bladePlasticBending ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The ship shall provide a propulsion load case for the blade-loss design assessment." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide a propulsion load case for the blade-loss design assessment." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:loadCase ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The propulsion load case shall confirm that the maximum component load blade orientation has been considered." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ] ] ;
                    sh:path nltl:hasPropulsionLoadCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The ship shall identify a thruster body subject to the blade-loss plastic-bending design requirement." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify a thruster body subject to the blade-loss plastic-bending design requirement." ;
                    sh:path nltl:hasComponent ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:thrusterBody ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The ship shall identify a steering mechanism subject to the blade-loss plastic-bending design requirement." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify a steering mechanism subject to the blade-loss plastic-bending design requirement." ;
                    sh:path nltl:hasComponent ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:steeringMechanism ] ] ] .

