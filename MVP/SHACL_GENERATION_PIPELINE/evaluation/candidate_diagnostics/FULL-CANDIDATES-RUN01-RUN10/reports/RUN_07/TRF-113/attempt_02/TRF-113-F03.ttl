@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F03/ship> ;
            sh:resultMessage "The ship must link the thruster body assessed for blade-loss plastic bending." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must link the thruster body assessed for blade-loss plastic bending." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:thrusterBody ] ;
                    sh:path nltl:hasComponent ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F03/ship> ;
            sh:resultMessage "The blade-loss design assessment must include a confirmed load case." ;
            sh:resultPath nltl:hasLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The blade-loss design assessment must include a confirmed load case." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:loadCase ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:message "The load case must confirm the maximum-component-load blade orientation." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ] ] ;
                    sh:path nltl:hasLoadCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F03/ship> ;
            sh:resultMessage "The ship must link the steering mechanism assessed for blade-loss plastic bending." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must link the steering mechanism assessed for blade-loss plastic bending." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:steeringMechanism ] ;
                    sh:path nltl:hasComponent ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F03/ship> ;
            sh:resultMessage "The ship must link the thruster fitting assessed for blade-loss plastic bending." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must link the thruster fitting assessed for blade-loss plastic bending." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:thrusterFitting ] ;
                    sh:path nltl:hasComponent ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F03/ship> ;
            sh:resultMessage "The ship must record the propeller blade orientation producing the maximum component load." ;
            sh:resultPath nltl:propellerBladeOrientation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must record the propeller blade orientation producing the maximum component load." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerBladeOrientation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F03/ship> ;
            sh:resultMessage "The ship must record the plastic-bending blade-loss design assessment." ;
            sh:resultPath nltl:bladePlasticBending ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must record the plastic-bending blade-loss design assessment." ;
                    sh:minCount 1 ;
                    sh:path nltl:bladePlasticBending ] ] .

