@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/ship> ;
            sh:resultMessage "Ship material properties are required for the assessment." ;
            sh:resultPath nltl:hasMaterialProperties ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Ship material properties are required for the assessment." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:materialProperties ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "Component material yield strength in MPa is required." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:componentMaterialYieldStrength ] ] ;
                    sh:path nltl:hasMaterialProperties ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/assessment> ;
                    sh:resultMessage "The assessment must confirm that operability is maintained." ;
                    sh:resultPath nltl:assessmentOperabilityMaintained ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "The assessment must confirm that operability is maintained." ;
                            sh:minCount 1 ;
                            sh:path nltl:assessmentOperabilityMaintained ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/assessment> ;
                    sh:resultMessage "The assessment must confirm that no repair is required." ;
                    sh:resultPath nltl:assessmentRepairRequired ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue false ;
                            sh:maxCount 1 ;
                            sh:message "The assessment must confirm that no repair is required." ;
                            sh:minCount 1 ;
                            sh:path nltl:assessmentRepairRequired ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/ship> ;
            sh:resultMessage "At least one factored extreme-load operability assessment is required." ;
            sh:resultPath nltl:hasFactoredExtremeLoadOperabilityAssessment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "At least one factored extreme-load operability assessment is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:factoredExtremeLoadOperabilityAssessment ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue false ;
                                    sh:maxCount 1 ;
                                    sh:message "The assessment must confirm that no repair is required." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:assessmentRepairRequired ],
                                [ sh:class nltl:shipComponent ;
                                    sh:maxCount 1 ;
                                    sh:message "Each assessment must identify its assessed thruster component." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:assessedThrusterComponent ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The assessment must confirm that operability is maintained." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:assessmentOperabilityMaintained ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each assessment must provide its factored extreme load in kN." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:assessedFactoredExtremeLoad ] ] ;
                    sh:path nltl:hasFactoredExtremeLoadOperabilityAssessment ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/assessment> ] .

