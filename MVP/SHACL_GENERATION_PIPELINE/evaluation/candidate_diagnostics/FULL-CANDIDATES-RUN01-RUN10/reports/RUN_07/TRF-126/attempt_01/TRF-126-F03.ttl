@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propulsionEngineReversedForAstern ], [ sh:datatype xsd:integer ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When the propulsion engine must be reversed for astern movement, the air receivers must provide at least 12 consecutive starts.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"12\", datatype=xsd:integer) ; sh:path nltl:airReceiverConsecutiveStartCapacity ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propulsionEngineReversedForAstern ], [ sh:datatype xsd:integer ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When the propulsion engine does not have to be reversed for astern movement, the air receivers must provide at least 6 consecutive starts.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"6\", datatype=xsd:integer) ; sh:path nltl:airReceiverConsecutiveStartCapacity ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_126_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-F03/ship> ] .

