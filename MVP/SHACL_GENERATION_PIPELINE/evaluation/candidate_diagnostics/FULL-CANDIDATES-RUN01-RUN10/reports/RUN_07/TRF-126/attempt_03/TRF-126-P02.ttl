@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-P02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The propulsion engine reversal state must be recorded as true for the 12-start capacity branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propulsionEngineReversedForAstern ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Air receiver capacity must be at least 12 m3 when the propulsion engine has to be reversed for moving astern.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"12\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M3 ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:airReceiverCapacity ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The propulsion engine reversal state must be recorded as false for the 6-start capacity branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propulsionEngineReversedForAstern ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Air receiver capacity must be at least 6 m3 when the propulsion engine does not have to be reversed for moving astern.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"6\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M3 ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:airReceiverCapacity ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_126> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-P02/ship> ] .

