@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-129-F03/ship> ;
            sh:resultMessage "The ship must state whether it is navigating in ice." ;
            sh:resultPath nltl:navigatingInIce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "The ship must state whether it is navigating in ice." ;
                    sh:minCount 1 ;
                    sh:path nltl:navigatingInIce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-129-F03/ship> ;
            sh:resultMessage "When the ship is navigating in ice, its cooling water supply must be secured." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF129CoolingWaterShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-129-F03/ship> ] .

