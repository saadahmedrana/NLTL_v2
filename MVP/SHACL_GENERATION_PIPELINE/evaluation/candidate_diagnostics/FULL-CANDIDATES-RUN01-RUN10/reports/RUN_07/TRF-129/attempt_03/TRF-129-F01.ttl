@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-129-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Cooling water supply must be secured when navigating in ice.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterSupplySecured ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The applicability evidence must establish that the ship is navigating in ice.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:navigatingInIce ], [ sh:datatype xsd:string ; sh:message Literal(\"An ice-navigation applicability condition is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceNavigationCondition ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"The non-applicable branch requires explicit evidence that the ship is not navigating in ice.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:navigatingInIce ], [ sh:datatype xsd:string ; sh:message Literal(\"An ice-navigation applicability condition is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceNavigationCondition ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF129Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-129-F01/ship> ] .

