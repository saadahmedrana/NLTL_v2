@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F03/chest1> ;
            sh:resultMessage "Less than 1 values on ex:chest1->nltl:seaInletLocation" ;
            sh:resultPath nltl:seaInletLocation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n07e2728245544f3ababc16e77ca480acb16 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:inletChest ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:TRF130StandardInletChestShape ; sh:path nltl:hasComponent ] ] , [ sh:property [ sh:class nltl:inletChest ; sh:minCount Literal(\"2\", datatype=xsd:integer) ; sh:node gs:TRF130AlternativeInletChestShape ; sh:path nltl:hasComponent ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF130ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:totalRelevantEnginePower" ;
            sh:resultPath nltl:totalRelevantEnginePower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:totalRelevantEnginePower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F03/chest1> ;
            sh:resultMessage "The inlet chest shall have a recommended volume approximately equal to total relevant engine power divided by 750, and strainer open area at least four times inlet pipe area." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The inlet chest shall have a recommended volume approximately equal to total relevant engine power divided by 750, and strainer open area at least four times inlet pipe area." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  FILTER NOT EXISTS {
    ?ship nltl:hasComponent $this .
    ?ship nltl:totalRelevantEnginePower ?totalQ .
    ?totalQ qudt:numericValue ?total .
    ?this nltl:recommendedChestVolume ?recommendedQ .
    ?recommendedQ qudt:numericValue ?recommended .
    ?this nltl:inletPipeArea ?inletQ .
    ?inletQ qudt:numericValue ?inlet .
    ?this nltl:strainerOpenArea ?strainerQ .
    ?strainerQ qudt:numericValue ?strainer .
    ?this nltl:strainerOpenAreaRatio ?ratioQ .
    ?ratioQ qudt:numericValue ?ratio .
    BIND((?total / 750) AS ?expected)
    FILTER(
      ABS(?recommended - ?expected) <=
        (ABS(?expected) * 0.000001 + 0.000000001)
      && ?strainer >= (4 * ?inlet)
      && ?ratio >= 4
    )
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF130InletChestShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F03/chest1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:maximumContinuousRatingPower" ;
            sh:resultPath nltl:maximumContinuousRatingPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:maximumContinuousRatingPower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F03/chest1> ;
            sh:resultMessage "Node ex:chest1->nltl:seaInletLocation does not contain a value in the set: ['Literal(\"near_centreline_and_well_aft_if_possible\")']" ;
            sh:resultPath nltl:seaInletLocation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n07e2728245544f3ababc16e77ca480acb16 ] .

_:n07e2728245544f3ababc16e77ca480acb16 sh:datatype xsd:string ;
    sh:hasValue "near_centreline_and_well_aft_if_possible" ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:seaInletLocation .

