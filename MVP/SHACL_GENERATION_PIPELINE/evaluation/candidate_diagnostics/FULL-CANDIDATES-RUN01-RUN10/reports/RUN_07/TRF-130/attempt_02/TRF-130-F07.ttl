@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F07/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:totalRelevantEnginePower" ;
            sh:resultPath nltl:totalRelevantEnginePower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:totalRelevantEnginePower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F07/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestAlternativeArrangementUsed ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ], [ sh:path nltl:hasComponent ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape gs:TRF130StandardChestShape ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestAlternativeArrangementUsed ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ], [ sh:path nltl:hasComponent ; sh:qualifiedMinCount Literal(\"2\", datatype=xsd:integer) ; sh:qualifiedValueShape gs:TRF130AlternativeChestShape ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF130Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F07/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F07/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:maximumContinuousRatingPower" ;
            sh:resultPath nltl:maximumContinuousRatingPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:maximumContinuousRatingPower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F07/ship> ;
            sh:resultMessage "Every linked inlet chest must have the declared quantity inputs and satisfy the chest-volume and strainer-area calculations." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Every linked inlet chest must have the declared quantity inputs and satisfy the chest-volume and strainer-area calculations." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this nltl:hasComponent ?chest .
                ?chest a nltl:inletChest .
                FILTER NOT EXISTS {
                    ?this nltl:totalRelevantEnginePower ?tp .
                    ?tp qudt:numericValue ?totalPower ;
                        qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                    ?chest nltl:recommendedChestVolume ?rv .
                    ?rv qudt:numericValue ?recommendedVolume ;
                        qudt:unit <http://qudt.org/vocab/unit/M3> .
                    ?chest nltl:strainerOpenArea ?sa .
                    ?sa qudt:numericValue ?strainerArea ;
                        qudt:unit <http://qudt.org/vocab/unit/M2> .
                    ?chest nltl:inletPipeArea ?ipa .
                    ?ipa qudt:numericValue ?pipeArea ;
                        qudt:unit <http://qudt.org/vocab/unit/M2> .
                    ?chest nltl:strainerOpenAreaRatio ?ratio .
                    ?ratio qudt:numericValue ?ratioValue ;
                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    BIND((?totalPower / 750) AS ?expectedVolume)
                    BIND((?strainerArea / ?pipeArea) AS ?expectedRatio)
                    FILTER(
                        ABS(?recommendedVolume - ?expectedVolume)
                        <= IF(
                            ABS(?expectedVolume) * "0.000001"^^xsd:decimal
                            > "0.000000001"^^xsd:decimal,
                            ABS(?expectedVolume) * "0.000001"^^xsd:decimal,
                            "0.000000001"^^xsd:decimal
                        )
                    )
                    FILTER(?strainerArea >= (4 * ?pipeArea))
                    FILTER(?ratioValue >= 4)
                    FILTER(
                        ABS(?ratioValue - ?expectedRatio)
                        <= IF(
                            ABS(?expectedRatio) * "0.000001"^^xsd:decimal
                            > "0.000000001"^^xsd:decimal,
                            ABS(?expectedRatio) * "0.000001"^^xsd:decimal,
                            "0.000000001"^^xsd:decimal
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF130Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F07/ship> ] .

