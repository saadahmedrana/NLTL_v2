@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/ship> ;
                    sh:resultMessage "Focus node does not conform to shape MinCount 2: gs:TRF130AlternatingChestValueShape" ;
                    sh:resultPath nltl:hasComponent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
                    sh:sourceShape [ sh:path nltl:hasComponent ;
                            sh:qualifiedMinCount 2 ;
                            sh:qualifiedValueShape gs:TRF130AlternatingChestValueShape ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/ship> ;
                    sh:resultMessage "Node ex:ship->nltl:coolingWaterChestAlternativeArrangementUsed does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
                    sh:resultPath nltl:coolingWaterChestAlternativeArrangementUsed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:coolingWaterChestAlternativeArrangementUsed ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/ship> ;
                    sh:resultMessage "Node ex:ship->nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
                    sh:resultPath nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:TRF130AlternatingCase. See details for more information." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape gs:TRF130AlternatingCaseShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/chest1> ;
            sh:resultMessage "Node ex:chest1->nltl:iceAccumulationSpaceAboveInlet does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:iceAccumulationSpaceAboveInlet ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:iceAccumulationSpaceAboveInlet ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:totalRelevantEnginePower" ;
            sh:resultPath nltl:totalRelevantEnginePower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:totalRelevantEnginePower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:maximumContinuousRatingPower" ;
            sh:resultPath nltl:maximumContinuousRatingPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:maximumContinuousRatingPower ] ] .

