@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-P02/ship> ;
            sh:resultMessage "The ship displacement must equal the displacement of the upper ice waterline case having the greatest displacement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The ship displacement must equal the displacement of the upper ice waterline case having the greatest displacement." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?dui .
                ?dui qudt:numericValue ?duiValue ;
                     qudt:unit unit:KiloTON_Metric .

                $this nltl:hasUpperIceWaterlineCase ?matchingCase .
                ?matchingCase nltl:waterlineCaseDisplacement ?matchingDisplacement .
                ?matchingDisplacement qudt:numericValue ?matchingValue ;
                                      qudt:unit unit:KiloTON_Metric .
                FILTER (?matchingValue = ?duiValue)

                FILTER NOT EXISTS {
                    $this nltl:hasUpperIceWaterlineCase ?greaterCase .
                    ?greaterCase nltl:waterlineCaseDisplacement ?greaterDisplacement .
                    ?greaterDisplacement qudt:numericValue ?greaterValue ;
                                          qudt:unit unit:KiloTON_Metric .
                    FILTER (?greaterValue > ?duiValue)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_004_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-P02/ship> ] .

