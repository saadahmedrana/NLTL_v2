@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The upper ice waterline displacement must equal the greatest displacement among the linked upper ice waterline cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The upper ice waterline displacement must equal the greatest displacement among the linked upper ice waterline cases." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?duiNode .
                ?duiNode qudt:numericValue ?duiValue .
                ?duiNode qudt:unit <http://qudt.org/vocab/unit/KiloTON_Metric> .

                FILTER NOT EXISTS {
                    $this nltl:hasUpperIceWaterlineCase ?matchingCase .
                    ?matchingCase nltl:waterlineCaseDisplacement ?matchingNode .
                    ?matchingNode qudt:numericValue ?matchingValue .
                    ?matchingNode qudt:unit <http://qudt.org/vocab/unit/KiloTON_Metric> .
                    FILTER (?matchingValue = ?duiValue)

                    FILTER NOT EXISTS {
                        $this nltl:hasUpperIceWaterlineCase ?greaterCase .
                        ?greaterCase nltl:waterlineCaseDisplacement ?greaterNode .
                        ?greaterNode qudt:numericValue ?greaterValue .
                        ?greaterNode qudt:unit <http://qudt.org/vocab/unit/KiloTON_Metric> .
                        FILTER (?greaterValue > ?matchingValue)
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_004_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

