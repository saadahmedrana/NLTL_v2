@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ar> ;
                    sh:resultMessage "Value is not >= Literal(\"3.6\", datatype=xsd:decimal)" ;
                    sh:resultPath q:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxInclusive 3.6 ;
                            sh:minCount 1 ;
                            sh:minInclusive 3.6 ;
                            sh:path q:numericValue ] ;
                    sh:value 3.5 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "The load patch aspect ratio must be exactly 3.6 and dimensionless." ;
            sh:resultPath nltl:loadPatchAspectRatio ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The load patch aspect ratio must be exactly 3.6 and dimensionless." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-AspectRatioValueShape> ;
                    sh:path nltl:loadPatchAspectRatio ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ar> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "The normal frame angle must be greater than 10 degrees." ;
            sh:resultPath nltl:normalFrameAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The normal frame angle must be greater than 10 degrees." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-NormalFrameAngleValueShape> ;
                    sh:path nltl:normalFrameAngle ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/assignment> ;
                    sh:resultMessage "The assignment must identify the other ice-strengthened area value." ;
                    sh:resultPath nltl:assignedHullArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue nltl:otherIceStrengthenedAreaValue ;
                            sh:maxCount 1 ;
                            sh:message "The assignment must identify the other ice-strengthened area value." ;
                            sh:minCount 1 ;
                            sh:path nltl:assignedHullArea ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "A hull-area assignment for the other ice-strengthened area must be supplied." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A hull-area assignment for the other ice-strengthened area must be supplied." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-HullAreaAssignmentShape> ;
                    sh:path nltl:hasHullAreaAssignment ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/assignment> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "The buttock angle at the stem must be greater than 0 degrees and less than 80 degrees." ;
            sh:resultPath nltl:buttockAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The buttock angle at the stem must be greater than 0 degrees and less than 80 degrees." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-ButtockAngleValueShape> ;
                    sh:path nltl:buttockAngle ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F01/ship> ;
            sh:resultMessage "The hull area identification must be supplied." ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The hull area identification must be supplied." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ] .

