@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F03/ship> ;
            sh:resultMessage "For an applicable ship, bowDesignForce must be at least the part-iii force and must agree with the part-iv force within tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an applicable ship, bowDesignForce must be at least the part-iii force and must agree with the part-iv force within tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:polarClass ?polarClass ;
                      nltl:bulbousBowPresent true ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivNode ;
                      nltl:bowDesignForce ?forceNode .

                FILTER (
                    ?polarClass IN (
                        nltl:polarClassPc6,
                        nltl:polarClassPc7
                    )
                )

                ?iiiNode qudt:numericValue ?iiiValue .
                ?ivNode qudt:numericValue ?ivValue .
                ?forceNode qudt:numericValue ?forceValue .

                FILTER (
                    ?forceValue < (?iiiValue * 1000)
                    ||
                    ABS(?forceValue - (?ivValue * 1000))
                    > (0.000001 * ABS(?ivValue * 1000) + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_011_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F03/ship> ] .

