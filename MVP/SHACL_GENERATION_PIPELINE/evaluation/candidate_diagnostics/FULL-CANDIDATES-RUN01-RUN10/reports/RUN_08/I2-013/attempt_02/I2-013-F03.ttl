@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-013-F03/ship> ;
            sh:resultMessage "The ship must provide a single unitless inertia ratio value." ;
            sh:resultPath nltl:inertiaRatioIeIt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n6482c6afaa7a4925b20716502fab8577b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-013-F03/other> ;
            sh:resultMessage "The ship must provide a single unitless inertia ratio value." ;
            sh:resultPath nltl:inertiaRatioIeIt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n6482c6afaa7a4925b20716502fab8577b1 ] .

_:N352c220baa57434cb777318321101233 sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

_:N3f5bb016be61442096f1c768ec3a65d2 sh:class qudt:QuantityValue ;
    sh:property _:N352c220baa57434cb777318321101233,
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:n6482c6afaa7a4925b20716502fab8577b1 sh:maxCount 1 ;
    sh:message "The ship must provide a single unitless inertia ratio value." ;
    sh:minCount 1 ;
    sh:node _:N3f5bb016be61442096f1c768ec3a65d2 ;
    sh:path nltl:inertiaRatioIeIt .

