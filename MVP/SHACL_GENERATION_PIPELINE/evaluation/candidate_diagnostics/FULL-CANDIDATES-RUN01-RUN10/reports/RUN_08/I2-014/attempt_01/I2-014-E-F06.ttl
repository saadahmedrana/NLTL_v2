@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F06/ship> ;
            sh:resultMessage "Each selected maximum bow value must be at least as large as the corresponding value reported for every bow subregion calculation case." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each selected maximum bow value must be at least as large as the corresponding value reported for every bow subregion calculation case." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:selectedMaximumBowForce ?selected .
                    ?selected qudt:numericValue ?selectedValue .
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionCalculatedForce ?reported .
                    ?reported qudt:numericValue ?reportedValue .
                    FILTER (?reportedValue > ?selectedValue)
                }
                UNION
                {
                    $this nltl:selectedMaximumBowLineLoad ?selected .
                    ?selected qudt:numericValue ?selectedValue .
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionCalculatedLineLoad ?reported .
                    ?reported qudt:numericValue ?reportedValue .
                    FILTER (?reportedValue > ?selectedValue)
                }
                UNION
                {
                    $this nltl:selectedMaximumBowPressure ?selected .
                    ?selected qudt:numericValue ?selectedValue .
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionCalculatedPressure ?reported .
                    ?reported qudt:numericValue ?reportedValue .
                    FILTER (?reportedValue > ?selectedValue)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F06/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F06/ship> ;
            sh:resultMessage "bowSubregionCount must be exactly four." ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:maxInclusive 4 ;
                    sh:message "bowSubregionCount must be exactly four." ;
                    sh:minCount 1 ;
                    sh:minInclusive 4 ;
                    sh:path nltl:bowSubregionCount ] ] .

