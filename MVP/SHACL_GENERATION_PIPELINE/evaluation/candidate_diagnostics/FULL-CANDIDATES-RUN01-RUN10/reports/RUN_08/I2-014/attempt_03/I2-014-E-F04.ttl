@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "Each selected bow maximum must equal one reported subregion value and be no less than every reported value." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each selected bow maximum must equal one reported subregion value and be no less than every reported value." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?c1, ?c2, ?c3, ?c4 ;
                      nltl:selectedMaximumBowForce ?sfq ;
                      nltl:selectedMaximumBowLineLoad ?sqlq ;
                      nltl:selectedMaximumBowPressure ?spq .

                ?c1 nltl:bowSubregionCalculatedForce ?f1 ;
                    nltl:bowSubregionCalculatedLineLoad ?q1 ;
                    nltl:bowSubregionCalculatedPressure ?p1 .
                ?c2 nltl:bowSubregionCalculatedForce ?f2 ;
                    nltl:bowSubregionCalculatedLineLoad ?q2 ;
                    nltl:bowSubregionCalculatedPressure ?p2 .
                ?c3 nltl:bowSubregionCalculatedForce ?f3 ;
                    nltl:bowSubregionCalculatedLineLoad ?q3 ;
                    nltl:bowSubregionCalculatedPressure ?p3 .
                ?c4 nltl:bowSubregionCalculatedForce ?f4 ;
                    nltl:bowSubregionCalculatedLineLoad ?q4 ;
                    nltl:bowSubregionCalculatedPressure ?p4 .

                ?f1 qudt:numericValue ?fv1 .
                ?f2 qudt:numericValue ?fv2 .
                ?f3 qudt:numericValue ?fv3 .
                ?f4 qudt:numericValue ?fv4 .
                ?q1 qudt:numericValue ?qv1 .
                ?q2 qudt:numericValue ?qv2 .
                ?q3 qudt:numericValue ?qv3 .
                ?q4 qudt:numericValue ?qv4 .
                ?p1 qudt:numericValue ?pv1 .
                ?p2 qudt:numericValue ?pv2 .
                ?p3 qudt:numericValue ?pv3 .
                ?p4 qudt:numericValue ?pv4 .
                ?sfq qudt:numericValue ?sf .
                ?sqlq qudt:numericValue ?sql .
                ?spq qudt:numericValue ?sp .

                FILTER (
                    (?sf < ?fv1 || ?sf < ?fv2 || ?sf < ?fv3 || ?sf < ?fv4 ||
                     (?sf != ?fv1 && ?sf != ?fv2 && ?sf != ?fv3 && ?sf != ?fv4)) ||
                    (?sql < ?qv1 || ?sql < ?qv2 || ?sql < ?qv3 || ?sql < ?qv4 ||
                     (?sql != ?qv1 && ?sql != ?qv2 && ?sql != ?qv3 && ?sql != ?qv4)) ||
                    (?sp < ?pv1 || ?sp < ?pv2 || ?sp < ?pv3 || ?sp < ?pv4 ||
                     (?sp != ?pv1 && ?sp != ?pv2 && ?sp != ?pv3 && ?sp != ?pv4))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_014_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowSubregionCount" ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:maxInclusive 4 ;
                    sh:minCount 1 ;
                    sh:minInclusive 4 ;
                    sh:path nltl:bowSubregionCount ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowLength" ;
            sh:resultPath nltl:bowLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:minExclusive 0.0 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:bowLength ] ] .

