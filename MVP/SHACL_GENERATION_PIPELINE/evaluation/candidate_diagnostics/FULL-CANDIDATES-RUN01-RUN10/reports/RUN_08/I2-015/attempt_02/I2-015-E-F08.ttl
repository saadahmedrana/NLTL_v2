                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-015-AngleQuantityShape> ;
                    sh:path nltl:bowSubregionWaterlineAngle ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/alpha> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/fa> ;
                    sh:resultMessage "The bow shape coefficient must use the dimensionless unit." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                            sh:maxCount 1 ;
                            sh:message "The bow shape coefficient must use the dimensionless unit." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/bowCase> ;
            sh:resultMessage "Each applicable bow case must provide the externally calculated bow shape coefficient." ;
            sh:resultPath nltl:bowShapeCoefficient ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each applicable bow case must provide the externally calculated bow shape coefficient." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-015-BowShapeCoefficientQuantityShape> ;
                    sh:path nltl:bowShapeCoefficient ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/fa> ],
        [ a sh:ValidationResult ;
