                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/cff> ;
                            sh:resultMessage "A failure class factor must use the dimensionless unit." ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:nd3d23d61c5334050aec058b3263b60d0b7 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/factorLookup> ;
                    sh:resultMessage "Each applicable bow case must provide a flexural failure class factor." ;
