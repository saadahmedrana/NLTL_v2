                    sh:path nltl:hasFailureClassFactorLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/factorLookup> ] .

_:nd3d23d61c5334050aec058b3263b60d0b7 sh:hasValue qudt:UNITLESS ;
