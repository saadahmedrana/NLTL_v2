                            sh:message "The bow subregion waterline angle must use degrees." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/bowCase> ;
            sh:resultMessage "Each applicable bow case must provide its waterline angle." ;
