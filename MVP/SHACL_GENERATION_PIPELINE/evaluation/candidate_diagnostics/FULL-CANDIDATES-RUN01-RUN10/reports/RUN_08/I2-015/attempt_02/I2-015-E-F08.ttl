            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each applicable bow case must provide its mid length position." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-015-MidLengthQuantityShape> ;
                    sh:path nltl:bowSubregionMidLengthPosition ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/x> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/alpha> ;
                    sh:resultMessage "The bow subregion waterline angle must use degrees." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:DEG ;
