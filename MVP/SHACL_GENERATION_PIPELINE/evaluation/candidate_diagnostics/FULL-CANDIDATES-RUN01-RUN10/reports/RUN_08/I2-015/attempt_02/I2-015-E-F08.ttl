                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/factorLookup> ;
                    sh:resultMessage "Each applicable bow case must provide a crushing failure class factor." ;
                    sh:resultPath nltl:crushingFailureClassFactor ;
                    sh:resultSeverity sh:Violation ;
