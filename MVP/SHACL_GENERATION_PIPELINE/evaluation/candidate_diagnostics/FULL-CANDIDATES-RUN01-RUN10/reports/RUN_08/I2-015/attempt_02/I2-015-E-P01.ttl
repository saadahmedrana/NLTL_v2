    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-015-MidLengthQuantityShape> ;
    sh:path nltl:bowSubregionMidLengthPosition .

_:nd3d23d61c5334050aec058b3263b60d0b12 sh:message "Each applicable bow case must provide its waterline angle." ;
