@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F02/ship> ;
            sh:resultMessage "The ship shall provide one upper ice waterline length in metres." ;
            sh:resultPath nltl:upperIceWaterlineLengthLUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide one upper ice waterline length in metres." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_015_LengthQuantityShape ;
                    sh:path nltl:upperIceWaterlineLengthLUI ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F02/ship> ;
            sh:resultMessage "The ship shall provide one beta i prime quantity with a dimensionless unit." ;
            sh:resultPath nltl:betaIPrime ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide one beta i prime quantity with a dimensionless unit." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_015_DimensionlessQuantityShape ;
                    sh:path nltl:betaIPrime ] ] .

