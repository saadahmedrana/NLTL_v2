@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/bowCase> ;
                    sh:resultMessage "The bow subregion calculation case shall provide its waterline angle in degrees." ;
                    sh:resultPath nltl:bowSubregionWaterlineAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The bow subregion calculation case shall provide its waterline angle in degrees." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_015_AngleQuantityShape ;
                            sh:path nltl:bowSubregionWaterlineAngle ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:bowSubregionCalculationCase ; sh:property [ sh:hasValue nltl:i231vBowFormApplicability ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The bow subregion calculation case shall identify applicability to the bow forms defined in I2.3.1(v).\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bowFormApplicabilityClassification ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The bow subregion calculation case shall provide its mid-length position in metres.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_015_LengthQuantityShape ; sh:path nltl:bowSubregionMidLengthPosition ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The bow subregion calculation case shall provide its waterline angle in degrees.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_015_AngleQuantityShape ; sh:path nltl:bowSubregionWaterlineAngle ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The externally calculated bow shape coefficient shall be provided with a dimensionless unit.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_015_DimensionlessQuantityShape ; sh:path nltl:bowShapeCoefficient ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:tableLookupCase ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The factor lookup case shall provide the crushing failure class factor with a dimensionless unit.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_015_DimensionlessQuantityShape ; sh:path nltl:crushingFailureClassFactor ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The factor lookup case shall provide the flexural failure class factor with a dimensionless unit.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_015_DimensionlessQuantityShape ; sh:path nltl:flexuralFailureClassFactor ] ] ; sh:path nltl:hasFailureClassFactorLookupCase ] ]. See details for more information." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:bowSubregionCalculationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "The bow subregion calculation case shall provide its mid-length position in metres." ;
                                    sh:minCount 1 ;
                                    sh:node gen:I2_015_LengthQuantityShape ;
                                    sh:path nltl:bowSubregionMidLengthPosition ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:tableLookupCase ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:message "The factor lookup case shall provide the crushing failure class factor with a dimensionless unit." ;
                                                    sh:minCount 1 ;
                                                    sh:node gen:I2_015_DimensionlessQuantityShape ;
                                                    sh:path nltl:crushingFailureClassFactor ],
                                                [ sh:maxCount 1 ;
                                                    sh:message "The factor lookup case shall provide the flexural failure class factor with a dimensionless unit." ;
                                                    sh:minCount 1 ;
                                                    sh:node gen:I2_015_DimensionlessQuantityShape ;
                                                    sh:path nltl:flexuralFailureClassFactor ] ] ;
                                    sh:path nltl:hasFailureClassFactorLookupCase ],
                                [ sh:hasValue nltl:i231vBowFormApplicability ;
                                    sh:maxCount 1 ;
                                    sh:message "The bow subregion calculation case shall identify applicability to the bow forms defined in I2.3.1(v)." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:bowFormApplicabilityClassification ],
                                [ sh:maxCount 1 ;
                                    sh:message "The bow subregion calculation case shall provide its waterline angle in degrees." ;
                                    sh:minCount 1 ;
                                    sh:node gen:I2_015_AngleQuantityShape ;
                                    sh:path nltl:bowSubregionWaterlineAngle ],
                                [ sh:maxCount 1 ;
                                    sh:message "The externally calculated bow shape coefficient shall be provided with a dimensionless unit." ;
                                    sh:minCount 1 ;
                                    sh:node gen:I2_015_DimensionlessQuantityShape ;
                                    sh:path nltl:bowShapeCoefficient ] ] ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/bowCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/ship> ;
            sh:resultMessage "The ship shall provide one beta i prime quantity with a dimensionless unit." ;
            sh:resultPath nltl:betaIPrime ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide one beta i prime quantity with a dimensionless unit." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_015_DimensionlessQuantityShape ;
                    sh:path nltl:betaIPrime ] ] .

