@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/member> ;
                    sh:resultMessage "A structural member spanning hull areas must have a selected hull area factor equal to the largest spanned hull area factor." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "A structural member spanning hull areas must have a selected hull area factor equal to the largest spanned hull area factor." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasSpannedHullArea ?area .
                ?area nltl:hullAreaFactor ?factor .
                ?factor qudt:numericValue ?factorValue .
                FILTER NOT EXISTS {
                    $this nltl:hasSpannedHullArea ?otherArea .
                    ?otherArea nltl:hullAreaFactor ?otherFactor .
                    ?otherFactor qudt:numericValue ?otherFactorValue .
                    FILTER (?otherFactorValue > ?factorValue)
                }
                FILTER NOT EXISTS {
                    $this nltl:selectedHullAreaFactor ?selected .
                    ?selected qudt:numericValue ?selectedValue .
                    FILTER (?selectedValue = ?factorValue)
                }
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gs:StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/member> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/area2> ;
                            sh:resultMessage "Less than 1 values on ex:area2->nltl:hullAreaFactor" ;
                            sh:resultPath nltl:hullAreaFactor ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:hullAreaFactor ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/member> ;
                    sh:resultMessage "Value does not conform to Shape gs:HullAreaValueShape. See details for more information." ;
                    sh:resultPath nltl:hasSpannedHullArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node gs:HullAreaValueShape ;
                            sh:path nltl:hasSpannedHullArea ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/area2> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gs:StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/member> ] .

