@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/member> ;
                    sh:resultMessage "selectedHullAreaFactor must equal the maximum spanned hull area factor within a relative tolerance of 1e-6, with an absolute fallback of 1e-12 near zero." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "selectedHullAreaFactor must equal the maximum spanned hull area factor within a relative tolerance of 1e-6, with an absolute fallback of 1e-12 near zero." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedHullAreaFactor ?selectedFactorNode .
                ?selectedFactorNode qudt:numericValue ?selected .

                {
                    SELECT $this (MAX(?factor) AS ?expectedMaximum)
                    WHERE {
                        $this nltl:hasSpannedHullArea ?hullAreaValue .
                        ?hullAreaValue nltl:hullAreaFactor ?factorNode .
                        ?factorNode qudt:numericValue ?factor .
                        FILTER (datatype(?factor) = xsd:decimal)
                    }
                    GROUP BY $this
                }

                FILTER (datatype(?selected) = xsd:decimal)
                FILTER (
                    ABS(?selected - ?expectedMaximum)
                    >
                    (0.000001 * ABS(?expectedMaximum) + 0.000000000001)
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_019_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_019_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:I2_019_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/member> ] .

