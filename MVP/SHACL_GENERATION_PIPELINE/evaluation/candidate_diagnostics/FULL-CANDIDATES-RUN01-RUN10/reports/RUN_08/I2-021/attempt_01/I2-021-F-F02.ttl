@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/ship> ;
            sh:resultMessage "For each plating item, thickness must equal iceLoadRequiredNetPlateThickness plus corrosionAbrasionAllowance within a relative tolerance of 1e-6 and an absolute fallback of 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For each plating item, thickness must equal iceLoadRequiredNetPlateThickness plus corrosionAbrasionAllowance within a relative tolerance of 1e-6 and an absolute fallback of 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasPlating ?plating .
                ?plating nltl:iceLoadRequiredNetPlateThickness/qudt:numericValue ?tnet ;
                         nltl:corrosionAbrasionAllowance/qudt:numericValue ?ts ;
                         nltl:thickness/qudt:numericValue ?t .
                BIND((?tnet + ?ts) AS ?expected)
                FILTER(
                    ABS(?t - ?expected) >
                    (0.000001 * ABS(?expected) + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-021-shell-plate-thickness> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/ship> ] .

