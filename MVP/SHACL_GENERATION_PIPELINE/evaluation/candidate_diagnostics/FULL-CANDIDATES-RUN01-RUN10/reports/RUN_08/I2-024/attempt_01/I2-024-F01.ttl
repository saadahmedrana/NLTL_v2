@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/ship> ;
            sh:resultMessage "A calculation case containing the declared framing thickness inputs is required." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "A calculation case containing the declared framing thickness inputs is required." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_024_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/lowerEndpoint> ;
                            sh:resultMessage "Each interpolation point must provide its dimensionless coordinate." ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:class qudt:QuantityValue ;
                                    sh:message "Each interpolation point must provide its dimensionless coordinate." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:interpolationPointCoordinate ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/case> ;
                    sh:resultMessage "The lower interpolation endpoint and its externally computed result must be present." ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:message "The lower interpolation endpoint and its externally computed result must be present." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_024_InterpolationPointShape ;
                            sh:path nltl:interpolationLowerEndpoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/lowerEndpoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/ship> ;
            sh:resultMessage "An oblique plating interpolation case with the required interpolation inputs and result is required." ;
            sh:resultPath nltl:hasObliquePlatingInterpolationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:obliquePlatingInterpolationCase ;
                    sh:message "An oblique plating interpolation case with the required interpolation inputs and result is required." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_024_ObliqueCaseShape ;
                    sh:path nltl:hasObliquePlatingInterpolationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/case> ] .

