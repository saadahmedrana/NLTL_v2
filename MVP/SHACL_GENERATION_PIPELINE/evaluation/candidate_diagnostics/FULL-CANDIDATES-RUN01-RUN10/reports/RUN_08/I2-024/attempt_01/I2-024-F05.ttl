@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/case> ;
                    sh:resultMessage "The upper interpolation endpoint and its externally computed result must be present." ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:message "The upper interpolation endpoint and its externally computed result must be present." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_024_InterpolationPointShape ;
                            sh:path nltl:interpolationUpperEndpoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/ship> ;
            sh:resultMessage "An oblique plating interpolation case with the required interpolation inputs and result is required." ;
            sh:resultPath nltl:hasObliquePlatingInterpolationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:obliquePlatingInterpolationCase ;
                    sh:message "An oblique plating interpolation case with the required interpolation inputs and result is required." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_024_ObliqueCaseShape ;
                    sh:path nltl:hasObliquePlatingInterpolationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/ship> ;
            sh:resultMessage "A calculation case containing the declared framing thickness inputs is required." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "A calculation case containing the declared framing thickness inputs is required." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_024_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ] .

