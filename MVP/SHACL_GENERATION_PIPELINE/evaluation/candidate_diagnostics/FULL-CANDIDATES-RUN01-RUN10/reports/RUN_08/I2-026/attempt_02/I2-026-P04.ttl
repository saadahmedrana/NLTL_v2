@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P04/member> ;
                    sh:resultMessage "Node ex:member must conform to one or more shapes in gen:ContinuousFixedBranch , gen:BracketFixedBranch , gen:DemonstratedRestraintFixedBranch , gen:TerminatingFixedBranch , gen:NonTerminatingSimpleBranch" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P04/member> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P04/member> ;
                    sh:resultMessage "A structural member must have one frame support condition." ;
                    sh:resultPath nltl:frameSupportCondition ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:frameSupportConditionValue ;
                            sh:maxCount 1 ;
                            sh:message "A structural member must have one frame support condition." ;
                            sh:minCount 1 ;
                            sh:path nltl:frameSupportCondition ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P04/ship> ;
            sh:resultMessage "Each structural member must satisfy the support-fixity rule." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each structural member must satisfy the support-fixity rule." ;
                    sh:node gen:StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-P04/member> ] .

