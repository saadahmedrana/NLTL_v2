@prefix gen: <urn:nltl:generated-shape:I2-026:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ;
                    sh:resultMessage "Each structural member must declare one permitted frame support condition." ;
                    sh:resultPath nltl:frameSupportCondition ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:fixedFrameSupport nltl:simpleFrameSupport ) ;
                            sh:maxCount 1 ;
                            sh:message "Each structural member must declare one permitted frame support condition." ;
                            sh:minCount 1 ;
                            sh:path nltl:frameSupportCondition ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ;
                    sh:resultMessage "Node ex:member must conform to one or more shapes in gen:FixedByContinuityShape , gen:FixedByConnectionBracketShape , gen:FixedByDemonstratedRestraintShape , gen:FixedByTerminationShape , gen:SimpleSupportShape" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ] .

