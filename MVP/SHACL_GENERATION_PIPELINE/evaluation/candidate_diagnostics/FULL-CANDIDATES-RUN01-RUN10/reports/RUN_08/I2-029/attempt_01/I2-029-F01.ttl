@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F01/case> ;
                    sh:resultMessage "Attached shell plating must be included in the section modulus calculation." ;
                    sh:resultPath nltl:attachedShellPlatingIncludedInSectionModulus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "Attached shell plating must be included in the section modulus calculation." ;
                            sh:minCount 1 ;
                            sh:path nltl:attachedShellPlatingIncludedInSectionModulus ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F01/ship> ;
            sh:resultMessage "Each linked calculation case must satisfy the section modulus and shear area inclusion requirements." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked calculation case must satisfy the section modulus and shear area inclusion requirements." ;
                    sh:node gs:I2_029_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F01/case> ] .

