@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F04/case> ;
                    sh:resultMessage "The calculation case must explicitly represent whether flange material is included in the shear area." ;
                    sh:resultPath nltl:flangeMaterialIncludedInShearArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:message "The calculation case must explicitly represent whether flange material is included in the shear area." ;
                            sh:minCount 1 ;
                            sh:path nltl:flangeMaterialIncludedInShearArea ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F04/case> ;
                    sh:resultMessage "Node ex:case must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:flangeMaterialIncludedInShearArea ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:I2_029_FlangeFittedMemberShape ; sh:path nltl:sectionCalculationCaseStructuralMember ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:flangeMaterialIncludedInShearArea ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gs:I2_029_CalculationCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F04/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F04/ship> ;
            sh:resultMessage "Each linked calculation case must satisfy the section modulus and shear area inclusion requirements." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked calculation case must satisfy the section modulus and shear area inclusion requirements." ;
                    sh:node gs:I2_029_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F04/case> ] .

