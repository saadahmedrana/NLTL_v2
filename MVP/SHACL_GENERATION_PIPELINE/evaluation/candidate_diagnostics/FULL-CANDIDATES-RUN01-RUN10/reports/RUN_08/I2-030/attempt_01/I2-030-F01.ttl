@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F01/calc> ;
                    sh:resultMessage "Less than 1 values on ex:calc->nltl:interpolationLowerEndpoint" ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:minCount 1 ;
                            sh:node gs:InterpolationPointShape ;
                            sh:path nltl:interpolationLowerEndpoint ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F01/member> ;
                            sh:resultMessage "Less than 1 values on ex:member->nltl:netLocalFrameFlangeArea" ;
                            sh:resultPath nltl:netLocalFrameFlangeArea ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
                                    sh:node gs:AreaCentiMetreSquaredQuantityShape ;
                                    sh:path nltl:netLocalFrameFlangeArea ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F01/calc> ;
                    sh:resultMessage "Value does not conform to Shape gs:StructuralMemberShape. See details for more information." ;
                    sh:resultPath nltl:sectionCalculationCaseStructuralMember ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:structuralMember ;
                            sh:minCount 1 ;
                            sh:node gs:StructuralMemberShape ;
                            sh:path nltl:sectionCalculationCaseStructuralMember ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F01/member> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F01/calc> ;
                    sh:resultMessage "Less than 1 values on ex:calc->nltl:interpolationUpperEndpoint" ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:minCount 1 ;
                            sh:node gs:InterpolationPointShape ;
                            sh:path nltl:interpolationUpperEndpoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:minCount 1 ;
                    sh:node gs:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F01/calc> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasStructuralMember" ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:minCount 1 ;
                    sh:node gs:StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ] .

