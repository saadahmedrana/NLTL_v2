@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasStructuralMember" ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:minCount 1 ;
                    sh:node gs:StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/calc> ;
                    sh:resultMessage "Less than 1 values on ex:calc->nltl:interpolationUpperEndpoint" ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:minCount 1 ;
                            sh:node gs:InterpolationPointShape ;
                            sh:path nltl:interpolationUpperEndpoint ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/calc> ;
                                    sh:resultMessage "Less than 1 values on ex:calc->nltl:sectionCalculationCasePlating" ;
                                    sh:resultPath nltl:sectionCalculationCasePlating ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                                    sh:sourceShape [ sh:class nltl:plating ;
                                            sh:minCount 1 ;
                                            sh:node gs:PlatingShape ;
                                            sh:path nltl:sectionCalculationCasePlating ] ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/member> ;
                            sh:resultMessage "Value does not conform to Shape gs:LocalFrameSectionCalculationCaseShape. See details for more information." ;
                            sh:resultPath nltl:hasLocalFrameSectionCalculationCase ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:class nltl:localFrameSectionCalculationCase ;
                                    sh:minCount 1 ;
                                    sh:node gs:LocalFrameSectionCalculationCaseShape ;
                                    sh:path nltl:hasLocalFrameSectionCalculationCase ] ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/calc> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/calc> ;
                    sh:resultMessage "Value does not conform to Shape gs:StructuralMemberShape. See details for more information." ;
                    sh:resultPath nltl:sectionCalculationCaseStructuralMember ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:structuralMember ;
                            sh:minCount 1 ;
                            sh:node gs:StructuralMemberShape ;
                            sh:path nltl:sectionCalculationCaseStructuralMember ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/member> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/calc> ;
                    sh:resultMessage "Less than 1 values on ex:calc->nltl:interpolationLowerEndpoint" ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:minCount 1 ;
                            sh:node gs:InterpolationPointShape ;
                            sh:path nltl:interpolationLowerEndpoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:minCount 1 ;
                    sh:node gs:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F05/calc> ] .

