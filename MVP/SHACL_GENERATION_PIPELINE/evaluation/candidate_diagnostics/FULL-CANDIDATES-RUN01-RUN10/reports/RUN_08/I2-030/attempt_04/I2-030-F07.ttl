@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasStructuralMember" ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/upper> ;
                            sh:resultMessage "Less than 1 values on ex:upper->nltl:interpolationPointResult" ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:interpolationPointResult ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/calc> ;
                    sh:resultMessage "Value does not conform to Shape gen:InterpolationPointShape. See details for more information." ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node gen:InterpolationPointShape ;
                            sh:or ( [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:path nltl:interpolationUpperEndpoint ] [ sh:sparql [ sh:message "Upper interpolation endpoint is required for oblique framing." ;
                                                sh:select """
                        PREFIX nltl: <https://w3id.org/nltl/vocab#>
                        PREFIX qudt: <http://qudt.org/schema/qudt/>
                        PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                        SELECT $this
                        WHERE {
                            ?ship nltl:hasCalculationCase $this .
                            ?ship nltl:hasStructuralMember ?member .
                            ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                            ?localCase nltl:sectionCalculationCasePlating ?plating .
                            ?plating nltl:framingAngleOmega ?angle .
                            ?angle qudt:numericValue ?omega .
                            FILTER (?omega <= 20 || ?omega >= 70)
                        }
                    """ ] ] ) ;
                            sh:path nltl:interpolationUpperEndpoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/upper> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F07/calc> ] .

