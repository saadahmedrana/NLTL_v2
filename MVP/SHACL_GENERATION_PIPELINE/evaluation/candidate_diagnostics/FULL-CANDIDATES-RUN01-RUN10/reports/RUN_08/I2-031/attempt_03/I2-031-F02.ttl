@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/member> ;
                    sh:resultMessage "Node ex:member must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:bottomStructureLocation ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:structuralLocation ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:I2_031_BottomLoadCaseShape ; sh:path nltl:hasStructuralMemberLoadCase ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:transverseFrameOrientation ], [ sh:hasValue nltl:sideStructureLocation ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:structuralLocation ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gs:I2_031_MemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:I2_031_MemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gs:I2_031_MemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/ship> ;
            sh:resultMessage "The ship must identify the plastic collapse mechanism produced by the midspan collapse load." ;
            sh:resultPath nltl:plasticCollapseMechanism ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must identify the plastic collapse mechanism produced by the midspan collapse load." ;
                    sh:minCount 1 ;
                    sh:path nltl:plasticCollapseMechanism ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/ship> ;
            sh:resultMessage "The ship must provide the patch load." ;
            sh:resultPath nltl:patchLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the patch load." ;
                    sh:minCount 1 ;
                    sh:node gs:I2_031_QuantityShape ;
                    sh:path nltl:patchLoad ] ] .

