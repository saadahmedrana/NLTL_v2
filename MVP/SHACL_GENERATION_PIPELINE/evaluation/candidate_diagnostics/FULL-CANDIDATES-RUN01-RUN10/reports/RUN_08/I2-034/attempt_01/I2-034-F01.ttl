                    sh:resultMessage "Node ex:member must conform to one or more shapes in [ sh:property [ sh:class nltl:loadCase ; sh:node gs:I2_034_LoadCaseShape ; sh:path nltl:hasStructuralMemberLoadCase ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:longitudinalFrameOrientation ], [ sh:hasValue nltl:sideStructureLocation ; sh:path nltl:structuralLocation ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:longitudinalFrameOrientation ], [ sh:hasValue nltl:bottomStructureLocation ; sh:path nltl:structuralLocation ] ]" ;
                    sh:resultSeverity sh:Violation ;
