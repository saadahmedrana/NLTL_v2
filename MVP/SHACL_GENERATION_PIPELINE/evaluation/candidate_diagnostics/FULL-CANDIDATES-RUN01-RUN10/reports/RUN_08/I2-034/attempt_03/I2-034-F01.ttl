@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ;
                    sh:resultMessage "The combined shear-and-bending demand of every represented load case must not exceed the applicable member plastic strength." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:ne9434752ff5d4cdf9c345f936af21824b11 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-034-StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ;
            sh:resultMessage "The combined shear-and-bending demand of every represented load case must not exceed the applicable member plastic strength." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:ne9434752ff5d4cdf9c345f936af21824b11 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "The ship must specify one permitted frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:in ( nltl:flatBarSection nltl:profileSection ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship must specify one permitted frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ] .

_:ne9434752ff5d4cdf9c345f936af21824b11 a sh:SPARQLConstraint ;
    sh:message "The combined shear-and-bending demand of every represented load case must not exceed the applicable member plastic strength." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:longitudinalFrameOrientation true ;
                      nltl:structuralLocation nltl:sideStructureLocation ;
                      nltl:plasticStrength ?plasticNode ;
                      nltl:hasStructuralMemberLoadCase ?loadCase .
                ?plasticNode qudt:numericValue ?plasticValue .
                ?loadCase nltl:combinedShearAndBendingDemand ?demandNode .
                ?demandNode qudt:numericValue ?demandValue .
                FILTER (
                    datatype(?plasticValue) = xsd:decimal &&
                    datatype(?demandValue) = xsd:decimal &&
                    ?demandValue > ?plasticValue
                )
            }
        """ .

