@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/member> ;
                    sh:resultMessage "An applicable longitudinal side frame must provide plastic strength and a midspan plastic-collapse load whose magnitudes define the same strength." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:ne9434752ff5d4cdf9c345f936af21824b10 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-034-StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/ship> ;
            sh:resultMessage "The ship must specify one permitted frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:in ( nltl:flatBarSection nltl:profileSection ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship must specify one permitted frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/member> ;
            sh:resultMessage "An applicable longitudinal side frame must provide plastic strength and a midspan plastic-collapse load whose magnitudes define the same strength." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:ne9434752ff5d4cdf9c345f936af21824b10 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/member> ] .

_:ne9434752ff5d4cdf9c345f936af21824b10 a sh:SPARQLConstraint ;
    sh:message "An applicable longitudinal side frame must provide plastic strength and a midspan plastic-collapse load whose magnitudes define the same strength." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX qudtunit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:longitudinalFrameOrientation true ;
                      nltl:structuralLocation nltl:sideStructureLocation .
                FILTER NOT EXISTS {
                    $this nltl:plasticStrength ?plasticNode ;
                          nltl:midspanPlasticCollapseLoad ?midspanNode .
                    ?plasticNode qudt:numericValue ?plasticValue ;
                                 qudt:unit qudtunit:KiloN .
                    ?midspanNode qudt:numericValue ?midspanValue ;
                                  qudt:unit qudtunit:KiloN .
                    FILTER (
                        datatype(?plasticValue) = xsd:decimal &&
                        datatype(?midspanValue) = xsd:decimal &&
                        ?plasticValue = ?midspanValue
                    )
                }
            }
        """ .

