@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "The ship must specify an allowed frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:flatBarSection nltl:profileSection ) ;
                    sh:message "The ship must specify an allowed frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ;
            sh:resultMessage "Combined shear-and-bending demand must not exceed the applicable plastic strength." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:nc448a1efebeb4876a7aefbaa1f70fe1cb10 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ;
                    sh:resultMessage "Combined shear-and-bending demand must not exceed the applicable plastic strength." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:nc448a1efebeb4876a7aefbaa1f70fe1cb10 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-034-StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] .

_:nc448a1efebeb4876a7aefbaa1f70fe1cb10 a sh:SPARQLConstraint ;
    sh:message "Combined shear-and-bending demand must not exceed the applicable plastic strength." ;
    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:longitudinalFrameOrientation true ;
        nltl:structuralLocation nltl:sideStructureLocation ;
        nltl:hasStructuralMemberLoadCase ?lc ;
        nltl:plasticStrength ?ps .
  ?ps qudt:numericValue ?strengthValue .
  ?lc nltl:combinedShearAndBendingDemand ?demand .
  ?demand qudt:numericValue ?demandValue .
  FILTER (
    datatype(?strengthValue) = xsd:decimal &&
    datatype(?demandValue) = xsd:decimal &&
    ?demandValue > ?strengthValue
  )
}
""" .

