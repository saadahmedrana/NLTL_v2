@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/member> ;
            sh:resultMessage "An applicable side longitudinal frame must provide plastic strength and midspan plastic collapse load in kN, and the plastic strength must equal the defining midspan load within a relative tolerance of 1e-6 with a 1e-6 absolute fallback near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:nc448a1efebeb4876a7aefbaa1f70fe1cb8 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/member> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/member> ;
                    sh:resultMessage "An applicable side longitudinal frame must provide plastic strength and midspan plastic collapse load in kN, and the plastic strength must equal the defining midspan load within a relative tolerance of 1e-6 with a 1e-6 absolute fallback near zero." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:nc448a1efebeb4876a7aefbaa1f70fe1cb8 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-034-StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F02/ship> ;
            sh:resultMessage "The ship must specify an allowed frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:flatBarSection nltl:profileSection ) ;
                    sh:message "The ship must specify an allowed frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ] .

_:nc448a1efebeb4876a7aefbaa1f70fe1cb8 a sh:SPARQLConstraint ;
    sh:message "An applicable side longitudinal frame must provide plastic strength and midspan plastic collapse load in kN, and the plastic strength must equal the defining midspan load within a relative tolerance of 1e-6 with a 1e-6 absolute fallback near zero." ;
    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:longitudinalFrameOrientation true ;
        nltl:structuralLocation nltl:sideStructureLocation .
  FILTER (
    NOT EXISTS {
      $this nltl:plasticStrength ?ps .
      ?ps qudt:numericValue ?psv ;
          qudt:unit unit:KiloN .
      FILTER (datatype(?psv) = xsd:decimal)
    }
    ||
    NOT EXISTS {
      $this nltl:midspanPlasticCollapseLoad ?mid .
      ?mid qudt:numericValue ?midv ;
           qudt:unit unit:KiloN .
      FILTER (datatype(?midv) = xsd:decimal)
    }
    ||
    NOT EXISTS {
      $this nltl:plasticStrength ?ps .
      ?ps qudt:numericValue ?psv ;
          qudt:unit unit:KiloN .
      $this nltl:midspanPlasticCollapseLoad ?mid .
      ?mid qudt:numericValue ?midv ;
           qudt:unit unit:KiloN .
      FILTER (
        datatype(?psv) = xsd:decimal &&
        datatype(?midv) = xsd:decimal &&
        ABS(?psv - ?midv) <=
          IF(ABS(?midv) > 0.000001, ABS(?midv) * 0.000001, 0.000001)
      )
    }
  )
}
""" .

