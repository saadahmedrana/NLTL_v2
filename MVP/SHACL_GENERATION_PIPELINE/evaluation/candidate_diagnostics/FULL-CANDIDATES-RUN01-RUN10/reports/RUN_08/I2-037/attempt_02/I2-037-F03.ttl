                            sh:resultMessage "Less than 1 values on ex:loadcase->nltl:loadPatchApplicationLocation" ;
                            sh:resultPath nltl:loadPatchApplicationLocation ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:minLength 1 ;
                                    sh:path nltl:loadPatchApplicationLocation ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/member> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minLength Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:combinedShearBendingEffect ], [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minLength Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadPatchApplicationLocation ] ]. See details for more information." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCase ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:string ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:minLength 1 ;
                                            sh:path nltl:combinedShearBendingEffect ],
                                        [ sh:datatype xsd:string ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:minLength 1 ;
                                            sh:path nltl:loadPatchApplicationLocation ] ] ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:hasStructuralMemberLoadCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/loadcase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:class nltl:loadCase ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minLength Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:combinedShearBendingEffect ], [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minLength Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadPatchApplicationLocation ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:hasStructuralMemberLoadCase ], [ sh:class qudt:QuantityValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:memberCapacity ] ]. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:class qudt:QuantityValue ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue unit:KiloN ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
