                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:hasStructuralMemberLoadCase ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/member> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/patchCase> ;
                    sh:resultMessage "The ice-load-patch design case must confirm that the selected application location minimises member capacity under combined bending and shear." ;
                    sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n4fd3b0f000dc4deca2e41aa6d1b1662cb4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/patchCase> ;
                    sh:resultMessage "The ice-load-patch design case must confirm that the selected application location minimises member capacity under combined bending and shear." ;
                    sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n4fd3b0f000dc4deca2e41aa6d1b1662cb4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ice-load-patch design case must confirm that the selected application location minimises member capacity under combined bending and shear.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:memberCapacityMinimizationConfirmed ] ]. See details for more information." ;
            sh:resultPath nltl:hasIceLoadPatchDesignCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceLoadPatchDesignCase ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The ice-load-patch design case must confirm that the selected application location minimises member capacity under combined bending and shear." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:memberCapacityMinimizationConfirmed ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceLoadPatchDesignCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/patchCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/ship> ;
            sh:resultMessage "The ship must identify the ice load patch to which the structural design applies." ;
            sh:resultPath nltl:hasIceLoadPatch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceLoadPatch ;
                    sh:message "The ship must identify the ice load patch to which the structural design applies." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceLoadPatch ] ] .

_:n4fd3b0f000dc4deca2e41aa6d1b1662cb4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice-load-patch design case must confirm that the selected application location minimises member capacity under combined bending and shear." ;
    sh:minCount 1 ;
    sh:path nltl:memberCapacityMinimizationConfirmed .

