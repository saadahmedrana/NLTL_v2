@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/member> ;
                    sh:resultMessage "Each represented structural member must provide its capacity as a single value in kilonewtons." ;
                    sh:resultPath nltl:memberCapacity ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class qudt:QuantityValue ;
                            sh:maxCount 1 ;
                            sh:message "Each represented structural member must provide its capacity as a single value in kilonewtons." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue unit:KiloN ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:memberCapacity ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/loadcase> ;
                            sh:resultMessage "Each structural-member load case must identify the combined bending-and-shear effect considered." ;
                            sh:resultPath nltl:combinedShearBendingEffect ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:message "Each structural-member load case must identify the combined bending-and-shear effect considered." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:combinedShearBendingEffect ] ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/loadcase> ;
                            sh:resultMessage "Each structural-member load case must identify the load-patch application location." ;
                            sh:resultPath nltl:loadPatchApplicationLocation ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:message "Each structural-member load case must identify the load-patch application location." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:loadPatchApplicationLocation ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/member> ;
                    sh:resultMessage "Each represented structural member must provide its structural-member load case." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCase ;
                            sh:message "Each represented structural member must provide its structural-member load case." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-037-LoadCaseShape> ;
                            sh:path nltl:hasStructuralMemberLoadCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/loadcase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-037-StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:node <urn:nltl:generated-shape:I2-037-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "The ship must identify the ice load patch used by the design." ;
            sh:resultPath nltl:hasIceLoadPatch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceLoadPatch ;
                    sh:message "The ship must identify the ice load patch used by the design." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasIceLoadPatch ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ;
                    sh:resultMessage "The design case must identify the combined bending-and-shear effect considered." ;
                    sh:resultPath nltl:combinedShearBendingEffect ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:message "The design case must identify the combined bending-and-shear effect considered." ;
                            sh:minCount 1 ;
                            sh:path nltl:combinedShearBendingEffect ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ;
                    sh:resultMessage "The design case must record that the load-patch location was selected where member capacity under combined bending and shear is minimised." ;
                    sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:ne5a6a194d42642a89e3ff7ea3257d2d4b4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ;
                    sh:resultMessage "The design case must record that the load-patch location was selected where member capacity under combined bending and shear is minimised." ;
                    sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:ne5a6a194d42642a89e3ff7ea3257d2d4b4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ;
                    sh:resultMessage "The design case must identify the load-patch application location." ;
                    sh:resultPath nltl:loadPatchApplicationLocation ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:message "The design case must identify the load-patch application location." ;
                            sh:minCount 1 ;
                            sh:path nltl:loadPatchApplicationLocation ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/ship> ;
            sh:resultMessage "The ship must provide an ice-load-patch design case with the required minimisation evidence." ;
            sh:resultPath nltl:hasIceLoadPatchDesignCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceLoadPatchDesignCase ;
                    sh:message "The ship must provide an ice-load-patch design case with the required minimisation evidence." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-037-DesignCaseShape> ;
                    sh:path nltl:hasIceLoadPatchDesignCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-P02/patchCase> ] .

_:ne5a6a194d42642a89e3ff7ea3257d2d4b4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The design case must record that the load-patch location was selected where member capacity under combined bending and shear is minimised." ;
    sh:minCount 1 ;
    sh:path nltl:memberCapacityMinimizationConfirmed .

