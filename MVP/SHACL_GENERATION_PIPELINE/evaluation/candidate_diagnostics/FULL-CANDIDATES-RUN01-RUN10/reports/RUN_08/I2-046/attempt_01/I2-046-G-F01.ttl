@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F01/addition1> ;
                            sh:resultMessage "The internal structure corrosion/abrasion addition must be at least 1.0 mm." ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:message "The internal structure corrosion/abrasion addition must be at least 1.0 mm." ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 1.0 ;
                                    sh:path qudt:numericValue ] ;
                            sh:value 0.99 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F01/internalStructure1> ;
                    sh:resultMessage "Each linked internal ice-strengthened structure must have exactly one corrosion/abrasion addition." ;
                    sh:resultPath nltl:internalStructureCorrosionAbrasionAddition ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each linked internal ice-strengthened structure must have exactly one corrosion/abrasion addition." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                            sh:maxCount 1 ;
                                            sh:message "The internal structure corrosion/abrasion addition must use exactly one millimetre unit." ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:message "The internal structure corrosion/abrasion addition must be at least 1.0 mm." ;
                                            sh:minCount 1 ;
                                            sh:minInclusive 1.0 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:internalStructureCorrosionAbrasionAddition ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F01/addition1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each linked internal ice-strengthened structure must have exactly one corrosion/abrasion addition.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The internal structure corrosion/abrasion addition must be at least 1.0 mm.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The internal structure corrosion/abrasion addition must use exactly one millimetre unit.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:internalStructureCorrosionAbrasionAddition ] ]. See details for more information." ;
            sh:resultPath nltl:hasInternalIceStrengthenedStructure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ a sh:NodeShape ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "Each linked internal ice-strengthened structure must have exactly one corrosion/abrasion addition." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:message "The internal structure corrosion/abrasion addition must use exactly one millimetre unit." ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:message "The internal structure corrosion/abrasion addition must be at least 1.0 mm." ;
                                                    sh:minCount 1 ;
                                                    sh:minInclusive 1.0 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:internalStructureCorrosionAbrasionAddition ] ] ;
                    sh:path nltl:hasInternalIceStrengthenedStructure ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F01/internalStructure1> ] .

