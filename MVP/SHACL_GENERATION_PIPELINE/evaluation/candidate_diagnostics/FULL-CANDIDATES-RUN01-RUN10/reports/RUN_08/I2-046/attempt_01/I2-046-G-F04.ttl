@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/ship> ;
            sh:resultMessage "Exactly one polarClassRequirementsApplicable boolean is required." ;
            sh:resultPath nltl:polarClassRequirementsApplicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Exactly one polarClassRequirementsApplicable boolean is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarClassRequirementsApplicable ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:polarClassValue ; sh:in ( nltl:polarClassPc1 nltl:polarClassPc2 nltl:polarClassPc3 nltl:polarClassPc4 nltl:polarClassPc5 nltl:polarClassPc6 nltl:polarClassPc7 ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"An applicable ship must have exactly one valid polarClass value.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarClass ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:polarClassRequirementsApplicable ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:polarClassRequirementsApplicable ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-046-PolarClassCorrosionAbrasionAdditionShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/ship> ] .

