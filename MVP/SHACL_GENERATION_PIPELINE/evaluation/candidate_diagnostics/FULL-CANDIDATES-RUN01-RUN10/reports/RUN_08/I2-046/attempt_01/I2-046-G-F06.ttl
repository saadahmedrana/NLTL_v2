@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F06/ship> ;
            sh:resultMessage "Exactly one polarClassRequirementsApplicable boolean is required." ;
            sh:resultPath nltl:polarClassRequirementsApplicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MaxCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Exactly one polarClassRequirementsApplicable boolean is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarClassRequirementsApplicable ] ] .

