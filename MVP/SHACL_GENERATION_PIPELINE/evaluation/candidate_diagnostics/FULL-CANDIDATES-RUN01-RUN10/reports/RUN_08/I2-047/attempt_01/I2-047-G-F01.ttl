@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F01/ship> ;
            sh:resultMessage "Steel renewal is required exactly when gauged thickness is less than net thickness plus 0.5 mm." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Steel renewal is required exactly when gauged thickness is less than net thickness plus 0.5 mm." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:gaugedThickness ?gaugedQuantity ;
                      nltl:netThickness ?netQuantity ;
                      nltl:steelRenewalRequired ?renewal .

                ?gaugedQuantity qudt:numericValue ?gauged .
                ?netQuantity qudt:numericValue ?net .

                FILTER (
                    (?gauged < (?net + 0.0005) && ?renewal != true) ||
                    (?gauged >= (?net + 0.0005) && ?renewal != false)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <nltl:generated-shape-I2-047> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F01/ship> ] .

