@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F05/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Ice-strengthened structure status must be recorded as true for this applicability branch.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ], [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:steelRenewalRequired ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:gaugedThickness ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path ( nltl:hasPlating nltl:iceLoadRequiredNetPlateThickness ) ] ; sh:sparql [ sh:message Literal("Steel renewal must be required when gauged thickness is less than ice-load required net plate thickness plus 0.5 mm.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:gaugedThickness ?gaugedNode ;
                              nltl:hasPlating ?plating ;
                              nltl:steelRenewalRequired ?renewal .
                        ?gaugedNode qudt:numericValue ?gauged .
                        ?plating nltl:iceLoadRequiredNetPlateThickness ?tnetNode .
                        ?tnetNode qudt:numericValue ?tnet .
                        FILTER (
                            ?gauged * 1000 < ?tnet + 0.5 &&
                            ?renewal != true
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ a sh:NodeShape ;
                    sh:or ( [ sh:property [ sh:datatype xsd:boolean ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:path nltl:steelRenewalRequired ],
                                    [ sh:datatype xsd:boolean ;
                                        sh:hasValue true ;
                                        sh:maxCount 1 ;
                                        sh:message "Ice-strengthened structure status must be recorded as true for this applicability branch." ;
                                        sh:minCount 1 ;
                                        sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ],
                                    [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:property [ ],
                                                    [ ] ] ;
                                        sh:path ( nltl:hasPlating nltl:iceLoadRequiredNetPlateThickness ) ],
                                    [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:gaugedThickness ] ;
                                sh:sparql [ sh:message "Steel renewal must be required when gauged thickness is less than ice-load required net plate thickness plus 0.5 mm." ;
                                        sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:gaugedThickness ?gaugedNode ;
                              nltl:hasPlating ?plating ;
                              nltl:steelRenewalRequired ?renewal .
                        ?gaugedNode qudt:numericValue ?gauged .
                        ?plating nltl:iceLoadRequiredNetPlateThickness ?tnetNode .
                        ?tnetNode qudt:numericValue ?tnet .
                        FILTER (
                            ?gauged * 1000 < ?tnet + 0.5 &&
                            ?renewal != true
                        )
                    }
                """ ] ] [ sh:property [ sh:datatype xsd:boolean ;
                                        sh:hasValue false ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ] ] ) ;
                    sh:targetClass nltl:ship ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F05/ship> ] .

