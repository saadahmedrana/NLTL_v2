@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F05/gauged> ;
                    sh:resultMessage "Node ex:gauged->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/M>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:gaugedThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n1365838ff5b0430790b6353739432528b2 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F05/gauged> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ a sh:NodeShape ;
                    sh:or ( [ sh:property [ sh:hasValue true ;
                                        sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ] ] [ sh:property [ sh:hasValue false ;
                                        sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ] ] ) ;
                    sh:property [ sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:message "The ice-strengthened structure status must be recorded." ;
                            sh:minCount 1 ;
                            sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ],
                        [ sh:datatype qudt:QuantityValue ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:netThickness ],
                        [ sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:steelRenewalRequired ],
                        [ sh:datatype qudt:QuantityValue ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:gaugedThickness ] ;
                    sh:sparql [ sh:message "For an ice-strengthened structure, steel renewal is required exactly when gauged thickness is less than net thickness plus 0.5 mm." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:gaugedThickness ?gaugedQuantity ;
                      nltl:netThickness ?netQuantity ;
                      nltl:steelRenewalRequired ?renewal ;
                      nltl:hasPlating/nltl:iceStrengthenedStructureStatus ?ice .

                ?gaugedQuantity qudt:numericValue ?gauged ;
                                 qudt:unit <http://qudt.org/vocab/unit/M> .
                ?netQuantity qudt:numericValue ?net ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .

                FILTER (
                    (?ice = true &&
                        (
                            (?gauged < (?net + 0.0005) && ?renewal != true) ||
                            (?gauged >= (?net + 0.0005) && ?renewal != false)
                        )
                    ) ||
                    (?ice = false && ?renewal != false)
                )
            }
        """ ] ;
                    sh:targetClass nltl:ship ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F05/ship> ;
            sh:resultMessage "The ice-strengthened structure status must be recorded." ;
            sh:resultPath ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ice-strengthened structure status must be recorded." ;
                    sh:minCount 1 ;
                    sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F05/ship> ;
            sh:resultMessage "Value is not Literal with datatype qudt:QuantityValue" ;
            sh:resultPath nltl:gaugedThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape _:n1365838ff5b0430790b6353739432528b2 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F05/gauged> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F05/ship> ;
            sh:resultMessage "Value is not Literal with datatype qudt:QuantityValue" ;
            sh:resultPath nltl:netThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:netThickness ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F05/net> ] .

_:Ndb894a9217984e6597a63b4c403ca687 sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:n1365838ff5b0430790b6353739432528b2 sh:datatype qudt:QuantityValue ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node _:Ndb894a9217984e6597a63b4c403ca687 ;
    sh:path nltl:gaugedThickness .

