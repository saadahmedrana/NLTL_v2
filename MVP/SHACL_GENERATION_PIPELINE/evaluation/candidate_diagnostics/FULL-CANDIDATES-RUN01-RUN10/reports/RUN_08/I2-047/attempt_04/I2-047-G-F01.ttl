@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ] ; sh:sparql [ sh:message Literal("For an ice-strengthened structure, steelRenewalRequired must be true exactly when gaugedThickness is less than netThickness plus 0.0005 m.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:gaugedThickness ?gaugedNode ;
                              nltl:netThickness ?netNode ;
                              nltl:steelRenewalRequired ?renewal .
                        ?gaugedNode qudt:numericValue ?gauged ;
                                     qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?netNode qudt:numericValue ?net ;
                                 qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (
                            (?gauged < (?net + "0.0005"^^xsd:decimal) && ?renewal != true) ||
                            (?gauged >= (?net + "0.0005"^^xsd:decimal) && ?renewal != false)
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ], [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:steelRenewalRequired ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ a sh:NodeShape ;
                    sh:or ( [ sh:property [ sh:datatype xsd:boolean ;
                                        sh:hasValue true ;
                                        sh:minCount 1 ;
                                        sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ] ;
                                sh:sparql [ sh:message "For an ice-strengthened structure, steelRenewalRequired must be true exactly when gaugedThickness is less than netThickness plus 0.0005 m." ;
                                        sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:gaugedThickness ?gaugedNode ;
                              nltl:netThickness ?netNode ;
                              nltl:steelRenewalRequired ?renewal .
                        ?gaugedNode qudt:numericValue ?gauged ;
                                     qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?netNode qudt:numericValue ?net ;
                                 qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (
                            (?gauged < (?net + "0.0005"^^xsd:decimal) && ?renewal != true) ||
                            (?gauged >= (?net + "0.0005"^^xsd:decimal) && ?renewal != false)
                        )
                    }
                """ ] ] [ sh:property [ sh:hasValue false ;
                                        sh:path nltl:steelRenewalRequired ],
                                    [ sh:datatype xsd:boolean ;
                                        sh:hasValue false ;
                                        sh:minCount 1 ;
                                        sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ] ] ) ;
                    sh:property [ sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:steelRenewalRequired ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:gaugedThickness ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:netThickness ] ;
                    sh:targetClass nltl:ship ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F01/ship> ] .

