@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F014/case> ;
                    sh:resultMessage "Each steel-grade case must specify one as-built plate thickness in millimetres." ;
                    sh:resultPath nltl:asBuiltPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each steel-grade case must specify one as-built plate thickness in millimetres." ;
                            sh:minCount 1 ;
                            sh:node [ a sh:NodeShape ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:asBuiltPlateThickness ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F014/case> ;
                    sh:resultMessage "The actual hull structural steel grade does not have a rank at least as high as the Table 8 required grade within the same strength category." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "The actual hull structural steel grade does not have a rank at least as high as the Table 8 required grade within the same strength category." ;
                            sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  ?ship nltl:hasSteelGradeRequirementCase $this .
  $this nltl:steelStrengthCategory ?category ;
        nltl:actualHullStructuralSteelGrade ?actual ;
        nltl:requiredHullStructuralSteelGrade ?required .
  ?actual nltl:steelGradeOrderRank ?actualRank .
  ?required nltl:steelGradeOrderRank ?requiredRank .
  FILTER (
    (
      ?category = nltl:normalStrengthSteelCategory &&
      ?actual IN (
        nltl:steelGradeB, nltl:steelGradeD, nltl:steelGradeE
      ) &&
      ?required IN (
        nltl:steelGradeB, nltl:steelGradeD, nltl:steelGradeE
      )
    )
    ||
    (
      ?category = nltl:highTensileSteelCategory &&
      ?actual IN (
        nltl:steelGradeAh, nltl:steelGradeDh,
        nltl:steelGradeEh, nltl:steelGradeFh
      ) &&
      ?required IN (
        nltl:steelGradeAh, nltl:steelGradeDh,
        nltl:steelGradeEh, nltl:steelGradeFh
      )
    )
  )
  FILTER (?actualRank < ?requiredRank)
}
""" ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-048-CaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F014/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F014/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-048-CaseShape>. See details for more information." ;
            sh:resultPath nltl:hasSteelGradeRequirementCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeRequirementCase ;
                    sh:node <urn:nltl:generated-shape:I2-048-CaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasSteelGradeRequirementCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F014/case> ] .

