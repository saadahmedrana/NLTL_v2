@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-PZERO/ship> ;
            sh:resultMessage "Each ship assessed by a steel-grade requirement case must provide one permitted Polar Class." ;
            sh:resultPath nltl:polarClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarClassValue ;
                    sh:in ( nltl:polarClassPc1 nltl:polarClassPc2 nltl:polarClassPc3 nltl:polarClassPc4 nltl:polarClassPc5 nltl:polarClassPc6 nltl:polarClassPc7 ) ;
                    sh:maxCount 1 ;
                    sh:message "Each ship assessed by a steel-grade requirement case must provide one permitted Polar Class." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:polarClass ] ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:normalStrengthHullStructuralSteel ;
            sh:resultMessage "Less than 1 values on nltl:normalStrengthHullStructuralSteel->nltl:steelGradeOrderRank" ;
            sh:resultPath nltl:steelGradeOrderRank ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n79c5ab26291a40b69f8513e010fdda20b39 ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:highStrengthHullStructuralSteel ;
            sh:resultMessage "Less than 1 values on nltl:highStrengthHullStructuralSteel->nltl:steelGradeOrderRank" ;
            sh:resultPath nltl:steelGradeOrderRank ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n79c5ab26291a40b69f8513e010fdda20b39 ] .

_:n79c5ab26291a40b69f8513e010fdda20b39 sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:steelGradeOrderRank .

