@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T017/plating> ;
            sh:resultMessage "Each steel-grade requirement case must reference IACS UR I2 Table 8." ;
            sh:resultPath nltl:tableReference ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n79c5ab26291a40b69f8513e010fdda20b10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T017/plating> ;
            sh:resultMessage "Each steel-grade requirement case must provide exactly one permitted steel strength category." ;
            sh:resultPath nltl:steelStrengthCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelStrengthCategoryValue ;
                    sh:in ( nltl:normalStrengthSteelCategory nltl:highTensileSteelCategory ) ;
                    sh:maxCount 1 ;
                    sh:message "Each steel-grade requirement case must provide exactly one permitted steel strength category." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelStrengthCategory ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T017/plating> ;
            sh:resultMessage "Each steel-grade requirement case must identify exactly one plating." ;
            sh:resultPath nltl:steelGradeRequirementCasePlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:plating ;
                    sh:maxCount 1 ;
                    sh:message "Each steel-grade requirement case must identify exactly one plating." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelGradeRequirementCasePlating ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T017/plating> ;
            sh:resultMessage "Each steel-grade requirement case must provide exactly one permitted actual steel grade." ;
            sh:resultPath nltl:actualHullStructuralSteelGrade ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeValue ;
                    sh:in ( nltl:steelGradeAh nltl:steelGradeB nltl:steelGradeD nltl:steelGradeDh nltl:steelGradeE nltl:steelGradeEh nltl:steelGradeFh ) ;
                    sh:maxCount 1 ;
                    sh:message "Each steel-grade requirement case must provide exactly one permitted actual steel grade." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:actualHullStructuralSteelGrade ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T017/case> ;
            sh:resultMessage "Each steel-grade requirement case must provide exactly one as-built plate thickness in millimetres." ;
            sh:resultPath nltl:asBuiltPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "Each steel-grade requirement case must provide exactly one as-built plate thickness in millimetres." ;
                    sh:minCount 1 ;
                    sh:node gs:ThicknessQuantityShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:asBuiltPlateThickness ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T017/plating> ;
            sh:resultMessage "Each steel-grade requirement case must reference IACS UR I2 Table 8." ;
            sh:resultPath nltl:tableReference ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n79c5ab26291a40b69f8513e010fdda20b10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T017/plating> ;
            sh:resultMessage "Each steel-grade requirement case must provide exactly one permitted steel material class." ;
            sh:resultPath nltl:steelMaterialClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelMaterialClassValue ;
                    sh:in ( nltl:steelMaterialClassOne nltl:steelMaterialClassTwo nltl:steelMaterialClassThree ) ;
                    sh:maxCount 1 ;
                    sh:message "Each steel-grade requirement case must provide exactly one permitted steel material class." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelMaterialClass ] ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:normalStrengthHullStructuralSteel ;
            sh:resultMessage "Less than 1 values on nltl:normalStrengthHullStructuralSteel->nltl:steelGradeOrderRank" ;
            sh:resultPath nltl:steelGradeOrderRank ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n79c5ab26291a40b69f8513e010fdda20b39 ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:highStrengthHullStructuralSteel ;
            sh:resultMessage "Less than 1 values on nltl:highStrengthHullStructuralSteel->nltl:steelGradeOrderRank" ;
            sh:resultPath nltl:steelGradeOrderRank ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n79c5ab26291a40b69f8513e010fdda20b39 ] .

_:n79c5ab26291a40b69f8513e010fdda20b10 sh:hasValue nltl:iacsUrI2Table8 ;
    sh:maxCount 1 ;
    sh:message "Each steel-grade requirement case must reference IACS UR I2 Table 8." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:tableReference .

_:n79c5ab26291a40b69f8513e010fdda20b39 sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:steelGradeOrderRank .

