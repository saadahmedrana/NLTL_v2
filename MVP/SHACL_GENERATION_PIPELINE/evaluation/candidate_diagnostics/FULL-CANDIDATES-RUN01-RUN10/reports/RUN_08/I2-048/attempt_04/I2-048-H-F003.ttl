@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F003/case> ;
                    sh:resultMessage "Each steel-grade requirement case must provide exactly one as-built plate thickness." ;
                    sh:resultPath nltl:asBuiltPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nb5c69267719b461585fe3833ef4c3404b5 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F003/ship> ;
            sh:resultMessage "Value does not conform to Shape nltl:SteelGradeRequirementCaseShape. See details for more information." ;
            sh:resultPath nltl:hasSteelGradeRequirementCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltl:SteelGradeRequirementCaseShape ;
                    sh:path nltl:hasSteelGradeRequirementCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F003/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F003/case> ;
            sh:resultMessage "Each steel-grade requirement case must provide exactly one as-built plate thickness." ;
            sh:resultPath nltl:asBuiltPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb5c69267719b461585fe3833ef4c3404b5 ] .

_:nb5c69267719b461585fe3833ef4c3404b5 sh:maxCount 1 ;
    sh:message "Each steel-grade requirement case must provide exactly one as-built plate thickness." ;
    sh:minCount 1 ;
    sh:node nltl:AsBuiltPlateThicknessShape ;
    sh:path nltl:asBuiltPlateThickness .

