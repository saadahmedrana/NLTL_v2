            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb5c69267719b461585fe3833ef4c3404b4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F006/case> ;
            sh:resultMessage "Each steel-grade requirement case must provide exactly one valid steel material class." ;
            sh:resultPath nltl:steelMaterialClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MaxCountConstraintComponent ;
            sh:sourceShape _:nb5c69267719b461585fe3833ef4c3404b6 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F006/case> ;
                    sh:resultMessage "Each steel-grade requirement case must provide exactly one valid steel material class." ;
