            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the ice strength coefficient kI with a unitless quantity value." ;
                    sh:minCount 1 ;
                    sh:node gen:DimensionlessQuantityShape ;
                    sh:path nltl:iceStrengthCoefficientKI ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/ship> ;
            sh:resultMessage "The externally computed design vertical ice force at the bow must be provided in meganewtons." ;
            sh:resultPath nltl:designVerticalIceForceAtBow ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The externally computed design vertical ice force at the bow must be provided in meganewtons." ;
                    sh:minCount 1 ;
                    sh:node gen:ForceQuantityShape ;
                    sh:path nltl:designVerticalIceForceAtBow ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ship must provide a table lookup case containing the required class factors." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd971df71e91a42399df26d1faebde74fb8 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The externally computed first candidate design vertical ice force at the bow must be provided in meganewtons." ;
            sh:resultPath nltl:designVerticalIceForceAtBowCandidateOne ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The externally computed first candidate design vertical ice force at the bow must be provided in meganewtons." ;
                    sh:minCount 1 ;
                    sh:node gen:ForceQuantityShape ;
                    sh:path nltl:designVerticalIceForceAtBowCandidateOne ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ship must provide the hull form coefficient kh with a unitless quantity value." ;
            sh:resultPath nltl:hullFormCoefficientKh ;
