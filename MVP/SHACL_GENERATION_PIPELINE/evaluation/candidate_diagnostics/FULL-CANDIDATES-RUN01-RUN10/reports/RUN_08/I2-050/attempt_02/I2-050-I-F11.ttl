            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd971df71e91a42399df26d1faebde74fb8 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ship must provide the ice strength coefficient kI with a unitless quantity value." ;
            sh:resultPath nltl:iceStrengthCoefficientKI ;
            sh:resultSeverity sh:Violation ;
