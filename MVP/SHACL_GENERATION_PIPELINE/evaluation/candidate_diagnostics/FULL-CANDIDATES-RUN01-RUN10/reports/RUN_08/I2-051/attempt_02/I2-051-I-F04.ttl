@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F04/calculation> ;
                    sh:resultMessage """Node ex:calculation must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:positiveShearForce ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shearForceDirection ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("0", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:hullGirderLongitudinalPositionFromAft ] ; sh:sparql [ sh:message Literal("For a positive shear-force case at or before 0.6 LUI from aft, the longitudinal distribution factor must be exactly 0.0.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity .
                                ?positionQuantity qudt:numericValue ?position .
                                ?ship nltl:hasCalculationCase $this ;
                                       nltl:upperIceWaterlineLengthLUI ?lengthQuantity ;
                                       nltl:longitudinalDistributionFactor ?factorQuantity .
                                ?lengthQuantity qudt:numericValue ?length .
                                ?factorQuantity qudt:numericValue ?factor .
                                FILTER (?position <= (?length * "0.6"^^xsd:decimal))
                                FILTER (?factor < "0.0"^^xsd:decimal || ?factor > "0.0"^^xsd:decimal)
                            }
                        ") ] ] , [ sh:property [ sh:hasValue nltl:positiveShearForce ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shearForceDirection ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("0", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:hullGirderLongitudinalPositionFromAft ] ; sh:sparql [ sh:message Literal("For a positive shear-force case between 0.9 LUI and the forward end of LUI, the longitudinal distribution factor must be exactly 1.0.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity .
                                ?positionQuantity qudt:numericValue ?position .
                                ?ship nltl:hasCalculationCase $this ;
                                       nltl:upperIceWaterlineLengthLUI ?lengthQuantity ;
                                       nltl:longitudinalDistributionFactor ?factorQuantity .
                                ?lengthQuantity qudt:numericValue ?length .
                                ?factorQuantity qudt:numericValue ?factor .
                                FILTER (?position >= (?length * "0.9"^^xsd:decimal))
                                FILTER (?position <= ?length)
                                FILTER (?factor < "1.0"^^xsd:decimal || ?factor > "1.0"^^xsd:decimal)
                            }
                        ") ] ]""" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:calculationCase ;
                            sh:or ( [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class qudt:QuantityValue ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:hullGirderLongitudinalPositionFromAft ],
                                            [ sh:hasValue nltl:positiveShearForce ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shearForceDirection ] ;
                                        sh:sparql [ sh:message "For a positive shear-force case at or before 0.6 LUI from aft, the longitudinal distribution factor must be exactly 0.0." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity .
                                ?positionQuantity qudt:numericValue ?position .
                                ?ship nltl:hasCalculationCase $this ;
                                       nltl:upperIceWaterlineLengthLUI ?lengthQuantity ;
                                       nltl:longitudinalDistributionFactor ?factorQuantity .
                                ?lengthQuantity qudt:numericValue ?length .
                                ?factorQuantity qudt:numericValue ?factor .
                                FILTER (?position <= (?length * "0.6"^^xsd:decimal))
                                FILTER (?factor < "0.0"^^xsd:decimal || ?factor > "0.0"^^xsd:decimal)
                            }
                        """ ] ] [ sh:property [ sh:hasValue nltl:positiveShearForce ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shearForceDirection ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class qudt:QuantityValue ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:hullGirderLongitudinalPositionFromAft ] ;
                                        sh:sparql [ sh:message "For a positive shear-force case between 0.9 LUI and the forward end of LUI, the longitudinal distribution factor must be exactly 1.0." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity .
                                ?positionQuantity qudt:numericValue ?position .
                                ?ship nltl:hasCalculationCase $this ;
                                       nltl:upperIceWaterlineLengthLUI ?lengthQuantity ;
                                       nltl:longitudinalDistributionFactor ?factorQuantity .
                                ?lengthQuantity qudt:numericValue ?length .
                                ?factorQuantity qudt:numericValue ?factor .
                                FILTER (?position >= (?length * "0.9"^^xsd:decimal))
                                FILTER (?position <= ?length)
                                FILTER (?factor < "1.0"^^xsd:decimal || ?factor > "1.0"^^xsd:decimal)
                            }
                        """ ] ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F04/calculation> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F04/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:class nltl:calculationCase ; sh:or ( [ sh:property [ sh:hasValue nltl:positiveShearForce ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shearForceDirection ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("0", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:hullGirderLongitudinalPositionFromAft ] ; sh:sparql [ sh:message Literal("For a positive shear-force case at or before 0.6 LUI from aft, the longitudinal distribution factor must be exactly 0.0.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity .
                                ?positionQuantity qudt:numericValue ?position .
                                ?ship nltl:hasCalculationCase $this ;
                                       nltl:upperIceWaterlineLengthLUI ?lengthQuantity ;
                                       nltl:longitudinalDistributionFactor ?factorQuantity .
                                ?lengthQuantity qudt:numericValue ?length .
                                ?factorQuantity qudt:numericValue ?factor .
                                FILTER (?position <= (?length * "0.6"^^xsd:decimal))
                                FILTER (?factor < "0.0"^^xsd:decimal || ?factor > "0.0"^^xsd:decimal)
                            }
                        ") ] ] [ sh:property [ sh:hasValue nltl:positiveShearForce ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shearForceDirection ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("0", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:hullGirderLongitudinalPositionFromAft ] ; sh:sparql [ sh:message Literal("For a positive shear-force case between 0.9 LUI and the forward end of LUI, the longitudinal distribution factor must be exactly 1.0.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity .
                                ?positionQuantity qudt:numericValue ?position .
                                ?ship nltl:hasCalculationCase $this ;
                                       nltl:upperIceWaterlineLengthLUI ?lengthQuantity ;
                                       nltl:longitudinalDistributionFactor ?factorQuantity .
                                ?lengthQuantity qudt:numericValue ?length .
                                ?factorQuantity qudt:numericValue ?factor .
                                FILTER (?position >= (?length * "0.9"^^xsd:decimal))
                                FILTER (?position <= ?length)
                                FILTER (?factor < "1.0"^^xsd:decimal || ?factor > "1.0"^^xsd:decimal)
                            }
                        ") ] ] ) ]. See details for more information.""" ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:or ( [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:hullGirderLongitudinalPositionFromAft ],
                                            [ sh:hasValue nltl:positiveShearForce ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shearForceDirection ] ;
                                        sh:sparql [ sh:message "For a positive shear-force case at or before 0.6 LUI from aft, the longitudinal distribution factor must be exactly 0.0." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity .
                                ?positionQuantity qudt:numericValue ?position .
                                ?ship nltl:hasCalculationCase $this ;
                                       nltl:upperIceWaterlineLengthLUI ?lengthQuantity ;
                                       nltl:longitudinalDistributionFactor ?factorQuantity .
                                ?lengthQuantity qudt:numericValue ?length .
                                ?factorQuantity qudt:numericValue ?factor .
                                FILTER (?position <= (?length * "0.6"^^xsd:decimal))
                                FILTER (?factor < "0.0"^^xsd:decimal || ?factor > "0.0"^^xsd:decimal)
                            }
                        """ ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:hullGirderLongitudinalPositionFromAft ],
                                            [ sh:hasValue nltl:positiveShearForce ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shearForceDirection ] ;
                                        sh:sparql [ sh:message "For a positive shear-force case between 0.9 LUI and the forward end of LUI, the longitudinal distribution factor must be exactly 1.0." ;
                                                sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity .
                                ?positionQuantity qudt:numericValue ?position .
                                ?ship nltl:hasCalculationCase $this ;
                                       nltl:upperIceWaterlineLengthLUI ?lengthQuantity ;
                                       nltl:longitudinalDistributionFactor ?factorQuantity .
                                ?lengthQuantity qudt:numericValue ?length .
                                ?factorQuantity qudt:numericValue ?factor .
                                FILTER (?position >= (?length * "0.9"^^xsd:decimal))
                                FILTER (?position <= ?length)
                                FILTER (?factor < "1.0"^^xsd:decimal || ?factor > "1.0"^^xsd:decimal)
                            }
                        """ ] ] ) ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F04/calculation> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:longitudinalDistributionFactor" ;
            sh:resultPath nltl:longitudinalDistributionFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:longitudinalDistributionFactor ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:designVerticalIceShearForce" ;
            sh:resultPath nltl:designVerticalIceShearForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designVerticalIceShearForce ] ] .

