@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F04/calculation> ;
                    sh:resultMessage "Each calculation case must provide a hull-girder position from aft in metres." ;
                    sh:resultPath nltl:hullGirderLongitudinalPositionFromAft ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each calculation case must provide a hull-girder position from aft in metres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue unit:M ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:hullGirderLongitudinalPositionFromAft ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:calculationCase ; sh:property [ sh:hasValue nltl:positiveShearForce ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each calculation case must identify the positive shear-force direction.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shearForceDirection ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each calculation case must provide a hull-girder position from aft in metres.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:hullGirderLongitudinalPositionFromAft ] ]. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "Each calculation case must provide a hull-girder position from aft in metres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:hullGirderLongitudinalPositionFromAft ],
                                [ sh:hasValue nltl:positiveShearForce ;
                                    sh:maxCount 1 ;
                                    sh:message "Each calculation case must identify the positive shear-force direction." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:shearForceDirection ] ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F04/calculation> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F04/ship> ;
            sh:resultMessage "The longitudinal distribution factor must be a single dimensionless quantity equal to 0 or 1." ;
            sh:resultPath nltl:longitudinalDistributionFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The longitudinal distribution factor must be a single dimensionless quantity equal to 0 or 1." ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:node [ sh:class qudt:QuantityValue ;
                                        sh:property [ sh:hasValue unit:UNITLESS ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path qudt:unit ],
                                            [ sh:datatype xsd:decimal ;
                                                sh:maxCount 1 ;
                                                sh:maxInclusive 0.0 ;
                                                sh:minCount 1 ;
                                                sh:minInclusive 0.0 ;
                                                sh:path qudt:numericValue ] ] ] [ sh:node [ sh:class qudt:QuantityValue ;
                                        sh:property [ sh:datatype xsd:decimal ;
                                                sh:maxCount 1 ;
                                                sh:maxInclusive 1.0 ;
                                                sh:minCount 1 ;
                                                sh:minInclusive 1.0 ;
                                                sh:path qudt:numericValue ],
                                            [ sh:hasValue unit:UNITLESS ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path qudt:unit ] ] ] ) ;
                    sh:path nltl:longitudinalDistributionFactor ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F04/ship> ;
            sh:resultMessage "The design vertical ice shear force must be a single force quantity in kN." ;
            sh:resultPath nltl:designVerticalIceShearForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The design vertical ice shear force must be a single force quantity in kN." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designVerticalIceShearForce ] ] .

