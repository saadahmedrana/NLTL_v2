@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasCalculationCase" ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:minCount 5 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ] ] ;
                                    sh:path nltl:hasInterpolationPoint ] ;
                            sh:sparql [ sh:message "The calculation case must contain paired interpolation points for C_m = 0.0 at 0.0 and 1.0, 1.0 at 0.5 and 0.7, 0.3 at 0.95, and 0.0 at 1.0; intermediate values are determined by linear interpolation." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        FILTER (
                            NOT EXISTS {
                                $this nltl:hasInterpolationPoint ?p0 .
                                ?p0 nltl:interpolationPointCoordinate ?cq0 ;
                                    nltl:interpolationPointResult ?rq0 .
                                ?cq0 qudt:numericValue ?c0 .
                                ?rq0 qudt:numericValue ?r0 .
                                FILTER(?c0 >= 0.0 && ?c0 <= 0.0 && ?r0 >= 0.0 && ?r0 <= 0.0)
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasInterpolationPoint ?p1 .
                                ?p1 nltl:interpolationPointCoordinate ?cq1 ;
                                    nltl:interpolationPointResult ?rq1 .
                                ?cq1 qudt:numericValue ?c1 .
                                ?rq1 qudt:numericValue ?r1 .
                                FILTER(?c1 >= 0.5 && ?c1 <= 0.5 && ?r1 >= 1.0 && ?r1 <= 1.0)
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasInterpolationPoint ?p2 .
                                ?p2 nltl:interpolationPointCoordinate ?cq2 ;
                                    nltl:interpolationPointResult ?rq2 .
                                ?cq2 qudt:numericValue ?c2 .
                                ?rq2 qudt:numericValue ?r2 .
                                FILTER(?c2 >= 0.7 && ?c2 <= 0.7 && ?r2 >= 1.0 && ?r2 <= 1.0)
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasInterpolationPoint ?p3 .
                                ?p3 nltl:interpolationPointCoordinate ?cq3 ;
                                    nltl:interpolationPointResult ?rq3 .
                                ?cq3 qudt:numericValue ?c3 .
                                ?rq3 qudt:numericValue ?r3 .
                                FILTER(?c3 >= 0.95 && ?c3 <= 0.95 && ?r3 >= 0.3 && ?r3 <= 0.3)
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasInterpolationPoint ?p4 .
                                ?p4 nltl:interpolationPointCoordinate ?cq4 ;
                                    nltl:interpolationPointResult ?rq4 .
                                ?cq4 qudt:numericValue ?c4 .
                                ?rq4 qudt:numericValue ?r4 .
                                FILTER(?c4 >= 1.0 && ?c4 <= 1.0 && ?r4 >= 0.0 && ?r4 <= 0.0)
                            }
                        )
                    }
                """ ] ] ;
                    sh:path nltl:hasCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/designVerticalIceForceAtBow> ;
                    sh:resultMessage "Node ex:designVerticalIceForceAtBow->qudt:unit does not contain a value in the set: ['qudt:MegaN']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:MegaN ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:MegaN ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:designVerticalIceForceAtBow ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue qudt:MegaN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:designVerticalIceForceAtBow ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/designVerticalIceForceAtBow> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/upperIceWaterlineLengthLUI> ;
                    sh:resultMessage "Node ex:upperIceWaterlineLengthLUI->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:upperIceWaterlineLengthLUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:upperIceWaterlineLengthLUI ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/upperIceWaterlineLengthLUI> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/stemAngle> ;
                    sh:resultMessage "Node ex:stemAngle->qudt:unit does not contain a value in the set: ['qudt:DEG']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:DEG ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:DEG ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:stemAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue qudt:DEG ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:stemAngle ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/stemAngle> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/caseBendingMomentDistributionFactor> ;
                            sh:resultMessage "Node ex:caseBendingMomentDistributionFactor->qudt:unit does not contain a value in the set: ['qudt:UNITLESS']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/bendingCase> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
                    sh:resultPath nltl:caseBendingMomentDistributionFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue qudt:UNITLESS ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:caseBendingMomentDistributionFactor ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/caseBendingMomentDistributionFactor> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/caseDesignVerticalIceBendingMoment> ;
                            sh:resultMessage "Node ex:caseDesignVerticalIceBendingMoment->qudt:unit does not contain a value in the set: ['qudt:MegaN-M']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:MegaN-M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/bendingCase> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:MegaN-M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
                    sh:resultPath nltl:caseDesignVerticalIceBendingMoment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue qudt:MegaN-M ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:caseDesignVerticalIceBendingMoment ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/caseDesignVerticalIceBendingMoment> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/caseHullGirderLongitudinalPositionFromAft> ;
                            sh:resultMessage "Node ex:caseHullGirderLongitudinalPositionFromAft->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/bendingCase> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
                    sh:resultPath nltl:caseHullGirderLongitudinalPositionFromAft ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue qudt:M ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:caseHullGirderLongitudinalPositionFromAft ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/caseHullGirderLongitudinalPositionFromAft> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:hullGirderBendingMomentCalculationCase ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:caseHullGirderLongitudinalPositionFromAft ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:MegaN-M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:caseDesignVerticalIceBendingMoment ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:caseBendingMomentDistributionFactor ] ]. See details for more information." ;
            sh:resultPath nltl:hasHullGirderBendingMomentCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:hullGirderBendingMomentCalculationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue qudt:MegaN-M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:caseDesignVerticalIceBendingMoment ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue qudt:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:caseHullGirderLongitudinalPositionFromAft ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue qudt:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:caseBendingMomentDistributionFactor ] ] ;
                    sh:path nltl:hasHullGirderBendingMomentCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/bendingCase> ] .

