@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/member> ;
                    sh:resultMessage "Where stiffening is necessary for a member in way of a cut-out, the ship must record structural stiffening." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Where stiffening is necessary for a member in way of a cut-out, the ship must record structural stiffening." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCutout ?cutout .
                $this nltl:stiffeningNecessary true .
                ?ship nltl:hasStructuralMember $this .
                FILTER NOT EXISTS {
                    ?ship nltl:structuralStiffening ?stiffening .
                    FILTER (datatype(?stiffening) = xsd:string)
                }
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_060_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_060_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:node gen:I2_060_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/ship> ;
            sh:resultMessage "The ship must record that loads carried by members in way of cut-outs do not cause instability." ;
            sh:resultPath nltl:memberInstability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n773e71c18b8c4cf0a26fe43b06884254b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/ship> ;
            sh:resultMessage "The ship must record that loads carried by members in way of cut-outs do not cause instability." ;
            sh:resultPath nltl:memberInstability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n773e71c18b8c4cf0a26fe43b06884254b1 ] .

_:n773e71c18b8c4cf0a26fe43b06884254b1 sh:datatype xsd:boolean ;
    sh:hasValue false ;
    sh:maxCount 1 ;
    sh:message "The ship must record that loads carried by members in way of cut-outs do not cause instability." ;
    sh:minCount 1 ;
    sh:path nltl:memberInstability .

