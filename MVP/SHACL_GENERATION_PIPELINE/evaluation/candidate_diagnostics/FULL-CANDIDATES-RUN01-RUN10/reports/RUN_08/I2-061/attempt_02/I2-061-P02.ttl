@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P02/ship> ;
            sh:resultMessage "For a shell-plating or local-frame hull structure, the calculation case must use the prescribed analytical procedure, must not use direct calculation, and must provide thickness in metres." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a shell-plating or local-frame hull structure, the calculation case must use the prescribed analytical procedure, must not use direct calculation, and must provide thickness in metres." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX qudtu: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationCaseAssessedHullStructure ?hullStructure .
                ?hullStructure a ?structureKind .
                FILTER (
                    ?structureKind = nltl:plating ||
                    ?structureKind = nltl:structuralMember
                )
                FILTER (
                    NOT EXISTS {
                        ?case nltl:calculationMethod
                            nltl:prescribedAnalyticalProcedure
                    }
                    ||
                    EXISTS {
                        ?case nltl:calculationMethod
                            nltl:directCalculationMethodValue
                    }
                    ||
                    NOT EXISTS {
                        ?hullStructure nltl:thickness ?thickness .
                        ?thickness qudt:numericValue ?numericValue ;
                                   qudt:unit qudtu:M .
                        FILTER (datatype(?numericValue) = xsd:decimal)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_061_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P02/ship> ] .

