@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/case> ;
                    sh:resultMessage "Node ex:case must conform to one or more shapes in [ sh:not [ sh:property [ sh:hasValue nltl:directCalculationMethodValue ; sh:path nltl:calculationMethod ] ] ; sh:property [ sh:hasValue nltl:prescribedAnalyticalProcedure ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:calculationMethod ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2-061-PlatingShape> ; sh:path nltl:calculationCaseAssessedHullStructure ] ] , [ sh:not [ sh:property [ sh:hasValue nltl:directCalculationMethodValue ; sh:path nltl:calculationMethod ] ] ; sh:property [ sh:hasValue nltl:prescribedAnalyticalProcedure ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:calculationMethod ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2-061-StructuralMemberShape> ; sh:path nltl:calculationCaseAssessedHullStructure ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-CalculationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/case> ] .

