@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/member> ;
            sh:resultMessage "Less than 1 values on ex:member->nltl:hasStructuralMemberFlange" ;
            sh:resultPath nltl:hasStructuralMemberFlange ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node nltl:I2_064_FlangeShape ;
                    sh:path nltl:hasStructuralMemberFlange ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/ship> ;
            sh:resultMessage "Yield strength in MPa is required for the direct checks." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Yield strength in MPa is required for the direct checks." ;
                    sh:minCount 1 ;
                    sh:node nltl:I2_064_YieldStrengthShape ;
                    sh:path nltl:yieldStrength ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/nominalShearStress> ;
                    sh:resultMessage "Node ex:nominalShearStress->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n54980f49c0b64b439cb8d07ea95541b9b14 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/web> ;
            sh:resultMessage "Nominal shear stress is required for each member web." ;
            sh:resultPath nltl:nominalShearStress ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n54980f49c0b64b439cb8d07ea95541b9b11 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/nominalShearStress> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/nominalShearStress> ;
                            sh:resultMessage "Node ex:nominalShearStress->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:n54980f49c0b64b439cb8d07ea95541b9b14 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/web> ;
                    sh:resultMessage "Nominal shear stress is required for each member web." ;
                    sh:resultPath nltl:nominalShearStress ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n54980f49c0b64b439cb8d07ea95541b9b11 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/nominalShearStress> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/member> ;
            sh:resultMessage "Value does not conform to Shape nltl:I2_064_WebShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMemberWeb ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node nltl:I2_064_WebShape ;
                    sh:path nltl:hasStructuralMemberWeb ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/web> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/nominalFlangeVonMisesStress> ;
                    sh:resultMessage "Node ex:nominalFlangeVonMisesStress->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n54980f49c0b64b439cb8d07ea95541b9b14 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/flange> ;
            sh:resultMessage "Nominal flange von Mises stress is required for each member flange." ;
            sh:resultPath nltl:nominalFlangeVonMisesStress ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Nominal flange von Mises stress is required for each member flange." ;
                    sh:minCount 1 ;
                    sh:node nltl:I2_064_StressShape ;
                    sh:path nltl:nominalFlangeVonMisesStress ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F03/nominalFlangeVonMisesStress> ] .

_:n54980f49c0b64b439cb8d07ea95541b9b11 sh:maxCount 1 ;
    sh:message "Nominal shear stress is required for each member web." ;
    sh:minCount 1 ;
    sh:node nltl:I2_064_StressShape ;
    sh:path nltl:nominalShearStress .

_:n54980f49c0b64b439cb8d07ea95541b9b14 sh:hasValue qudt:MegaPA ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

