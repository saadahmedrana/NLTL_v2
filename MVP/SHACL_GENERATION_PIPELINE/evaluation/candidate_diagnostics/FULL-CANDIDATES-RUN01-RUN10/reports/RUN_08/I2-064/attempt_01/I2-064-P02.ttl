@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/calculation> ;
            sh:resultMessage "The calculation case must identify the linear calculation method." ;
            sh:resultPath nltl:calculationMethod ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n54980f49c0b64b439cb8d07ea95541b9b5 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/calculation> ;
                    sh:resultMessage "The calculation case must identify the linear calculation method." ;
                    sh:resultPath nltl:calculationMethod ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n54980f49c0b64b439cb8d07ea95541b9b5 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/ship> ;
            sh:resultMessage "A calculation case with the applicable calculation method is required." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A calculation case with the applicable calculation method is required." ;
                    sh:minCount 1 ;
                    sh:node nltl:I2_064_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/calculation> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/ship> ;
            sh:resultMessage "Yield strength in MPa is required for the direct checks." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Yield strength in MPa is required for the direct checks." ;
                    sh:minCount 1 ;
                    sh:node nltl:I2_064_YieldStrengthShape ;
                    sh:path nltl:yieldStrength ] ] .

_:n54980f49c0b64b439cb8d07ea95541b9b5 sh:hasValue nltl:linearCalculationMethodValue ;
    sh:maxCount 1 ;
    sh:message "The calculation case must identify the linear calculation method." ;
    sh:minCount 1 ;
    sh:path nltl:calculationMethod .

