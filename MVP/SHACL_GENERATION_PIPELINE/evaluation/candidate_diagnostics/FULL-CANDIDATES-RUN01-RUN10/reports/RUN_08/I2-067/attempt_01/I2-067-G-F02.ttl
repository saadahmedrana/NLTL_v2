@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F02/ship> ;
            sh:resultMessage "Every structural connection must have strength continuity ensured." ;
            sh:resultPath ( nltl:structuralConnection nltl:strengthContinuityStatus ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:in ( true ) ;
                    sh:message "Every structural connection must have strength continuity ensured." ;
                    sh:minCount 1 ;
                    sh:path ( nltl:structuralConnection nltl:strengthContinuityStatus ) ] ;
            sh:value false ] .

