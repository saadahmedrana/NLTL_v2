@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-F01/ship> ;
            sh:resultMessage "A ship designed for at least medium first-year ice with possible old-ice inclusions must have Polar Ship Category A." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A ship designed for at least medium first-year ice with possible old-ice inclusions must have Polar Ship Category A." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:designIceCondition nltl:mediumFirstYearIceWithPossibleOldIceInclusions .
                FILTER NOT EXISTS {
                    $this nltl:shipCategory nltl:polarShipCategoryA .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_001_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-F01/ship> ] .

