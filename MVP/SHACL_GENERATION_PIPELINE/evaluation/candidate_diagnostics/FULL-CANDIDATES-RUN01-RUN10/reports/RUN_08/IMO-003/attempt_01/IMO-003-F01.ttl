@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:polarShipCategoryC ; sh:message Literal("A ship designed for open water or ice conditions less severe than categories A and B shall have ship category C.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipCategory ], [ sh:in ( nltl:openWaterIceCondition nltl:iceConditionLessSevereThanCategoryAAndB ) ; sh:path nltl:designIceCondition ] ] , [ sh:sparql [ sh:message Literal("The declared design ice condition is an applicable condition and therefore requires ship category C.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:designIceCondition ?condition .
                        FILTER (
                            ?condition IN (
                                nltl:openWaterIceCondition,
                                nltl:iceConditionLessSevereThanCategoryAAndB
                            )
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-003-ShipDesignIceConditionCategory> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F01/ship> ] .

