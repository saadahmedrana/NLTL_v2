@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F02/ship> ;
            sh:resultMessage "For bergy waters, land-origin ice concentration must be less than 1/10 and total ice concentration must not exceed 1/10; both concentrations must be supplied as valid dimensionless decimal quantities." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For bergy waters, land-origin ice concentration must be less than 1/10 and total ice concentration must not exceed 1/10; both concentrations must be supplied as valid dimensionless decimal quantities." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceCondition ?condition .
                FILTER (?condition = "bergy waters")

                FILTER (
                    NOT EXISTS {
                        $this nltl:landOriginIceConcentration ?landQuantity .
                        ?landQuantity qudt:numericValue ?landValue ;
                                       qudt:unit unit:UNITLESS .
                        FILTER (
                            datatype(?landValue) = xsd:decimal &&
                            ?landValue < 1
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:totalIceConcentration ?totalQuantity .
                        ?totalQuantity qudt:numericValue ?totalValue ;
                                        qudt:unit unit:UNITLESS .
                        FILTER (
                            datatype(?totalValue) = xsd:decimal &&
                            ?totalValue <= 1
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:landOriginIceConcentration ?invalidLandQuantity .
                        FILTER NOT EXISTS {
                            ?invalidLandQuantity qudt:numericValue ?landNumericValue .
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:landOriginIceConcentration ?invalidLandQuantity .
                        ?invalidLandQuantity qudt:numericValue ?landNumericValue .
                        FILTER (
                            datatype(?landNumericValue) != xsd:decimal ||
                            ?landNumericValue >= 1
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:landOriginIceConcentration ?invalidLandQuantity .
                        FILTER NOT EXISTS {
                            ?invalidLandQuantity qudt:unit unit:UNITLESS .
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:totalIceConcentration ?invalidTotalQuantity .
                        FILTER NOT EXISTS {
                            ?invalidTotalQuantity qudt:numericValue ?totalNumericValue .
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:totalIceConcentration ?invalidTotalQuantity .
                        ?invalidTotalQuantity qudt:numericValue ?totalNumericValue .
                        FILTER (
                            datatype(?totalNumericValue) != xsd:decimal ||
                            ?totalNumericValue > 1
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:totalIceConcentration ?invalidTotalQuantity .
                        FILTER NOT EXISTS {
                            ?invalidTotalQuantity qudt:unit unit:UNITLESS .
                        }
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-009-Static> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F02/ship> ] .

