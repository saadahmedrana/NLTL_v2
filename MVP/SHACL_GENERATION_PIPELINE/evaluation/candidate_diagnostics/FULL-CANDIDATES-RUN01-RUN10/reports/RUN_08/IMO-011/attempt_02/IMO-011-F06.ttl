@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F06/ship> ;
            sh:resultMessage "For a data period shorter than 10 years, the administration dataset status must be Approved and no non-approved status may be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a data period shorter than 10 years, the administration dataset status must be Approved and no non-approved status may be present." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                {
                    $this nltl:dataPeriod ?period .
                    ?period qudt:numericValue ?periodValue .
                    FILTER (?periodValue < 10)
                    FILTER NOT EXISTS {
                        $this nltl:administrationDatasetApprovalStatus
                              nltl:evidenceStateApproved .
                    }
                }
                UNION
                {
                    $this nltl:dataPeriod ?period .
                    ?period qudt:numericValue ?periodValue .
                    FILTER (?periodValue < 10)
                    FILTER EXISTS {
                        $this nltl:administrationDatasetApprovalStatus ?status .
                        FILTER (?status != nltl:evidenceStateApproved)
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_011_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F06/ship> ] .

