@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ;
            sh:resultMessage "Polar Ship Certificate dates shall match the corresponding SOLAS certificate schedule dates in both directions." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Polar Ship Certificate dates shall match the corresponding SOLAS certificate schedule dates in both directions." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                FILTER (
                    EXISTS {
                        ?this nltl:polarCertificateValidityDates ?d1 .
                        FILTER NOT EXISTS {
                            ?this nltl:hasSolasCertificateSchedule ?s1 .
                            ?s1 nltl:hasCertificateScheduleDateRecord ?r1 .
                            ?r1 nltl:certificateScheduleDateType nltl:validityDateCategory ;
                                nltl:certificateScheduleDate ?d1 .
                        }
                    }
                    ||
                    EXISTS {
                        ?this nltl:hasSolasCertificateSchedule ?s2 .
                        ?s2 nltl:hasCertificateScheduleDateRecord ?r2 .
                        ?r2 nltl:certificateScheduleDateType nltl:validityDateCategory ;
                            nltl:certificateScheduleDate ?d2 .
                        FILTER NOT EXISTS {
                            ?this nltl:polarCertificateValidityDates ?d2 .
                        }
                    }
                    ||
                    EXISTS {
                        ?this nltl:surveyDates ?d3 .
                        FILTER NOT EXISTS {
                            ?this nltl:hasSolasCertificateSchedule ?s3 .
                            ?s3 nltl:hasCertificateScheduleDateRecord ?r3 .
                            ?r3 nltl:certificateScheduleDateType nltl:surveyDateCategory ;
                                nltl:certificateScheduleDate ?d3 .
                        }
                    }
                    ||
                    EXISTS {
                        ?this nltl:hasSolasCertificateSchedule ?s4 .
                        ?s4 nltl:hasCertificateScheduleDateRecord ?r4 .
                        ?r4 nltl:certificateScheduleDateType nltl:surveyDateCategory ;
                            nltl:certificateScheduleDate ?d4 .
                        FILTER NOT EXISTS {
                            ?this nltl:surveyDates ?d4 .
                        }
                    }
                    ||
                    EXISTS {
                        ?this nltl:endorsementDates ?d5 .
                        FILTER NOT EXISTS {
                            ?this nltl:hasSolasCertificateSchedule ?s5 .
                            ?s5 nltl:hasCertificateScheduleDateRecord ?r5 .
                            ?r5 nltl:certificateScheduleDateType nltl:endorsementDateCategory ;
                                nltl:certificateScheduleDate ?d5 .
                        }
                    }
                    ||
                    EXISTS {
                        ?this nltl:hasSolasCertificateSchedule ?s6 .
                        ?s6 nltl:hasCertificateScheduleDateRecord ?r6 .
                        ?r6 nltl:certificateScheduleDateType nltl:endorsementDateCategory ;
                            nltl:certificateScheduleDate ?d6 .
                        FILTER NOT EXISTS {
                            ?this nltl:endorsementDates ?d6 .
                        }
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-017_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ;
            sh:resultMessage "A SOLAS certificate schedule with all required date categories is required." ;
            sh:resultPath nltl:hasSolasCertificateSchedule ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:solasCertificateSchedule ;
                    sh:message "A SOLAS certificate schedule with all required date categories is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:message "The SOLAS certificate schedule shall contain a survey date record." ;
                                    sh:path nltl:hasCertificateScheduleDateRecord ;
                                    sh:qualifiedMinCount 1 ;
                                    sh:qualifiedValueShape [ a sh:NodeShape ;
                                            sh:class nltl:certificateScheduleDateRecord ;
                                            sh:property [ sh:datatype xsd:date ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:certificateScheduleDate ],
                                                [ sh:hasValue nltl:surveyDateCategory ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:certificateScheduleDateType ] ] ],
                                [ sh:message "The SOLAS certificate schedule shall contain an endorsement date record." ;
                                    sh:path nltl:hasCertificateScheduleDateRecord ;
                                    sh:qualifiedMinCount 1 ;
                                    sh:qualifiedValueShape [ a sh:NodeShape ;
                                            sh:class nltl:certificateScheduleDateRecord ;
                                            sh:property [ sh:datatype xsd:date ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:certificateScheduleDate ],
                                                [ sh:hasValue nltl:endorsementDateCategory ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:certificateScheduleDateType ] ] ],
                                [ sh:message "The SOLAS certificate schedule shall contain a validity date record." ;
                                    sh:path nltl:hasCertificateScheduleDateRecord ;
                                    sh:qualifiedMinCount 1 ;
                                    sh:qualifiedValueShape [ a sh:NodeShape ;
                                            sh:class nltl:certificateScheduleDateRecord ;
                                            sh:property [ sh:hasValue nltl:validityDateCategory ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:certificateScheduleDateType ],
                                                [ sh:datatype xsd:date ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:certificateScheduleDate ] ] ] ] ;
                    sh:path nltl:hasSolasCertificateSchedule ] ] .

