@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-023-F03/ship> ;
            sh:resultMessage "The ship shall record procedures for normal operations in its polar water operational manual." ;
            sh:resultPath nltl:normalOperationProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n6e5cdeda2df447de8da26a1fb82110ceb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-023-F03/ship> ;
            sh:resultMessage "The ship shall record procedures for normal operations in its polar water operational manual." ;
            sh:resultPath nltl:normalOperationProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n6e5cdeda2df447de8da26a1fb82110ceb1 ] .

_:n6e5cdeda2df447de8da26a1fb82110ceb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship shall record procedures for normal operations in its polar water operational manual." ;
    sh:minCount 1 ;
    sh:path nltl:normalOperationProcedurePresent .

