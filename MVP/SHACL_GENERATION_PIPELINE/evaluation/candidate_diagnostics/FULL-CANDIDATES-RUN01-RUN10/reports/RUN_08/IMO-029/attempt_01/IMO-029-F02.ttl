@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-029-F02/ship> ;
            sh:resultMessage "The ship shall record that the PWOM includes procedures for ice or temperature exceedances." ;
            sh:resultPath nltl:exceedanceResponseProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb1ac248811bf47c9940294a7e3af2757b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-029-F02/ship> ;
            sh:resultMessage "The ship shall record that the PWOM includes procedures for ice or temperature exceedances." ;
            sh:resultPath nltl:exceedanceResponseProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb1ac248811bf47c9940294a7e3af2757b1 ] .

_:nb1ac248811bf47c9940294a7e3af2757b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall record that the PWOM includes procedures for ice or temperature exceedances." ;
    sh:minCount 1 ;
    sh:path nltl:exceedanceResponseProcedurePresent .

