@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-032-F05/ship> ;
            sh:resultMessage "The ship must satisfy the applicable category-conditioned scantling approval requirement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO032Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-032-F05/ship> ] .

