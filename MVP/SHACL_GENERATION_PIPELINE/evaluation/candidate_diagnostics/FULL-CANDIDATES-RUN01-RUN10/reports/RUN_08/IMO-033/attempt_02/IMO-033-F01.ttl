@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("30", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("30", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloGM-PER-M2 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:deckIcingAllowance ], [ sh:class qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("7.5", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("7.5", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloGM-PER-M2 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:sideIcingAllowance ], [ sh:class qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN-M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:continuousSurfaceStaticMoment ], [ sh:class qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN-M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:discontinuousSurfaceStaticMoment ], [ sh:class qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M2 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:continuousSurfaceProjectedArea ], [ sh:class qudt:QuantityValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M2 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:discontinuousSurfaceProjectedArea ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Ice accretion applicability must be explicitly true for the icing calculation branch.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ] ; sh:sparql [ sh:message Literal("With ice accretion likely, discontinuous projected area must equal continuous projected area multiplied by 1.05 and discontinuous static moment must equal continuous static moment multiplied by 1.10 within an expected-result-scaled tolerance.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:iceAccretionLikely true ;
                              nltl:continuousSurfaceProjectedArea ?continuousAreaNode ;
                              nltl:continuousSurfaceStaticMoment ?continuousMomentNode ;
                              nltl:discontinuousSurfaceProjectedArea ?discontinuousAreaNode ;
                              nltl:discontinuousSurfaceStaticMoment ?discontinuousMomentNode .

                        ?continuousAreaNode qudt:numericValue ?continuousArea .
                        ?continuousMomentNode qudt:numericValue ?continuousMoment .
                        ?discontinuousAreaNode qudt:numericValue ?discontinuousArea .
                        ?discontinuousMomentNode qudt:numericValue ?discontinuousMoment .

                        FILTER (
                            ?discontinuousArea < ((?continuousArea * 1.05) - ((?continuousArea * 1.05) * 0.000001 + 0.000001))
                            || ?discontinuousArea > ((?continuousArea * 1.05) + ((?continuousArea * 1.05) * 0.000001 + 0.000001))
                            || ?discontinuousMoment < ((?continuousMoment * 1.10) - ((?continuousMoment * 1.10) * 0.000001 + 0.000001))
                            || ?discontinuousMoment > ((?continuousMoment * 1.10) + ((?continuousMoment * 1.10) * 0.000001 + 0.000001))
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Ice accretion applicability must be explicitly false for the non-applicable branch.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_033_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F01/ship> ] .

