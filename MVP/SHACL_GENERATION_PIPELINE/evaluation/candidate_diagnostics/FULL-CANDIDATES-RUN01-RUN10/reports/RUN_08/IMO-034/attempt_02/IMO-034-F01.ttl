@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-034-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"A design to minimize ice accretion is required when ice accretion is likely.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAccretionMinimizationDesignPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Ice accretion likelihood must be true when the applicable branch is selected.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Required ice-removal means must be present when ice accretion is likely.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:requiredIceRemovalMeansPresent ], [ sh:datatype xsd:string ; sh:message Literal(\"Administration-required ice-removal means must be recorded when ice accretion is likely.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:administrationRequiredIceRemovalMeans ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-034> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-034-F01/ship> ] .

