@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F01/ship> ;
            sh:resultMessage "The stability calculation icing allowance values must be provided." ;
            sh:resultPath nltl:stabilityCalculationIcingAllowanceValues ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The stability calculation icing allowance values must be provided." ;
                    sh:minCount 1 ;
                    sh:path nltl:stabilityCalculationIcingAllowanceValues ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F01/ship> ;
            sh:resultMessage "The PWOM must state that icing allowance information is present." ;
            sh:resultPath nltl:polarWaterOperationalManualIcingAllowanceInformationPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ne4c878e99bf34c78b89e3e3092b34c47b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F01/ship> ;
            sh:resultMessage "The PWOM icing allowance values must be provided." ;
            sh:resultPath nltl:polarWaterOperationalManualIcingAllowanceValues ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The PWOM icing allowance values must be provided." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarWaterOperationalManualIcingAllowanceValues ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F01/ship> ;
            sh:resultMessage "The PWOM must state that icing allowance information is present." ;
            sh:resultPath nltl:polarWaterOperationalManualIcingAllowanceInformationPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ne4c878e99bf34c78b89e3e3092b34c47b3 ] .

_:ne4c878e99bf34c78b89e3e3092b34c47b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The PWOM must state that icing allowance information is present." ;
    sh:minCount 1 ;
    sh:path nltl:polarWaterOperationalManualIcingAllowanceInformationPresent .

