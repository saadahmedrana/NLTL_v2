@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F04/ship> ;
            sh:resultMessage "Applicable ships must provide each loading condition with either compliant alternative-instrument residual-stability status or residual stability factor s_i equal to 1." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-037-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F04/ship> ] .

