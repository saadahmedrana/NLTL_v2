@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ;
            sh:resultMessage "Allowed vertical position must be recorded." ;
            sh:resultPath nltl:allowedVerticalPosition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "Allowed vertical position must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:allowedVerticalPosition ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ;
            sh:resultMessage "Damage extents and selected vertical position do not satisfy the required piecewise formulas and inclusive keel-to-1.20-draught range; calculated decimal results use a relative tolerance of 1e-6 plus an absolute fallback of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Damage extents and selected vertical position do not satisfy the required piecewise formulas and inclusive keel-to-1.20-draught range; calculated decimal results use a relative tolerance of 1e-6 plus an absolute fallback of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthNode ;
                      nltl:upperIceWaterlineDraught ?draughtNode ;
                      nltl:longitudinalDamageExtent ?longitudinalNode ;
                      nltl:verticalDamageExtent ?verticalNode ;
                      nltl:selectedVerticalDamagePosition ?positionNode .

                ?lengthNode qudt:numericValue ?length .
                ?draughtNode qudt:numericValue ?draught .
                ?longitudinalNode qudt:numericValue ?longitudinal .
                ?verticalNode qudt:numericValue ?vertical .
                ?positionNode qudt:numericValue ?position .

                BIND(
                    IF(
                        ?forward = true,
                        0.045 * ?length,
                        0.015 * ?length
                    ) AS ?expectedLongitudinal
                )
                BIND(
                    IF(
                        (0.20 * ?draught) < ?expectedLongitudinal,
                        0.20 * ?draught,
                        ?expectedLongitudinal
                    ) AS ?expectedVertical
                )

                FILTER(
                    ABS(?longitudinal - ?expectedLongitudinal) >
                    (0.000001 * ABS(?expectedLongitudinal) + 0.000000001)
                    ||
                    ABS(?vertical - ?expectedVertical) >
                    (0.000001 * ABS(?expectedVertical) + 0.000000001)
                    ||
                    ?position > (1.20 * ?draught)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_038_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ] .

