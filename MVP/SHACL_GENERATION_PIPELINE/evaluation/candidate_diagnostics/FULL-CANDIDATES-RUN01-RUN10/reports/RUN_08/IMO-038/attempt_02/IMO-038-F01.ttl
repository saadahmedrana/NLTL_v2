@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ;
            sh:resultMessage "The damage extents and selected vertical damage position do not satisfy the required piecewise formulas, exact transverse penetration, or inclusive vertical-position range." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The damage extents and selected vertical damage position do not satisfy the required piecewise formulas, exact transverse penetration, or inclusive vertical-position range." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthNode ;
                      nltl:upperIceWaterlineDraught ?draughtNode ;
                      nltl:longitudinalDamageExtent ?longitudinalNode ;
                      nltl:transversePenetration ?transverseNode ;
                      nltl:verticalDamageExtent ?verticalNode ;
                      nltl:selectedVerticalDamagePosition ?positionNode .

                ?lengthNode qudt:numericValue ?length .
                ?draughtNode qudt:numericValue ?draught .
                ?longitudinalNode qudt:numericValue ?longitudinal .
                ?transverseNode qudt:numericValue ?transverse .
                ?verticalNode qudt:numericValue ?vertical .
                ?positionNode qudt:numericValue ?position .

                BIND(
                    IF(?forward = true,
                       0.045 * ?length,
                       0.015 * ?length)
                    AS ?expectedLongitudinal
                )
                BIND(
                    IF(0.20 * ?draught < ?expectedLongitudinal,
                       0.20 * ?draught,
                       ?expectedLongitudinal)
                    AS ?expectedVertical
                )

                FILTER (
                    ABS(?longitudinal - ?expectedLongitudinal) >
                        IF(ABS(?expectedLongitudinal) * 0.000001 > 0.000000001,
                           ABS(?expectedLongitudinal) * 0.000001,
                           0.000000001)
                    ||
                    ?transverse != 760
                    ||
                    ABS(?vertical - ?expectedVertical) >
                        IF(ABS(?expectedVertical) * 0.000001 > 0.000000001,
                           ABS(?expectedVertical) * 0.000001,
                           0.000000001)
                    ||
                    ?position < 0
                    ||
                    ?position > 1.20 * ?draught
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO038ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ] .

