@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F06/ship> ;
            sh:resultMessage "Upper ice waterline length is required in metres." ;
            sh:resultPath nltl:upperIceWaterlineLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Upper ice waterline length is required in metres." ;
                    sh:minCount 1 ;
                    sh:node gen:MeterQuantityShape ;
                    sh:path nltl:upperIceWaterlineLength ] ] .

