@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F02/ship> ;
            sh:resultMessage "When ice accretion is likely, every relevant hatch or door must have associated ice or snow removal or prevention means." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When ice accretion is likely, every relevant hatch or door must have associated ice or snow removal or prevention means." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely ?applicability .
                FILTER (?applicability = true)
                $this nltl:hasRelevantHatchOrDoor ?hatchOrDoor .
                FILTER NOT EXISTS {
                    ?hatchOrDoor nltl:hasIceOrSnowRemovalOrPreventionMeans ?means .
                    ?means a nltl:iceSnowRemovalOrPreventionMeans .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_040_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F02/ship> ] .

