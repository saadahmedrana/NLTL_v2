@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-041-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Hydraulic openings require freezing or excessive-viscosity control for the hydraulic fluid.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hydraulicFluidFreezingOrViscosityControlPresent ], [ sh:datatype xsd:string ; sh:hasValue Literal("hydraulic") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The opening actuation type must be hydraulic for this applicability branch.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:openingActuationType ] ] , [ sh:property [ sh:datatype xsd:string ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An opening actuation type is required to determine applicability.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:openingActuationType ] ; sh:sparql [ sh:message Literal("The non-hydraulic applicability branch must not use the hydraulic actuation type.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:openingActuationType ?actuation .
                        FILTER (?actuation = "hydraulic"^^xsd:string)
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-041> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-041-F03/ship> ] .

