            sh:sourceShape _:na6c2f260a2c24fd1ab7613cbd974d0d1b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F01/ship> ;
            sh:resultMessage "The ship shall record hazard protection coverage." ;
            sh:resultPath nltl:hazardProtectionCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:na6c2f260a2c24fd1ab7613cbd974d0d1b1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F01/mainMachinery> ;
                    sh:resultMessage "Protection coverage shall address the snow ingestion hazard." ;
