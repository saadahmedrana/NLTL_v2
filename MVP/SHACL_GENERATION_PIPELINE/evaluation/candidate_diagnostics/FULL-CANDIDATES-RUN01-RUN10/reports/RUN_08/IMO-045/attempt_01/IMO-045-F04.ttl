@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F04/ship> ;
            sh:resultMessage "For a ship with a machinery seawater supply, ice-ingestion prevention must be present or the alternative functionality arrangement must be approved." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO_045_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F04/ship> ] .

