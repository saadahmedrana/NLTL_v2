@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-F02/medium1> ;
                    sh:resultMessage "Each extinguishing medium must have an approved compatibility status for the intended operation." ;
                    sh:resultPath nltl:extinguishingMediumCompatibilityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nf1f09062709045bea58814f0a078b6feb3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-F02/medium1> ;
                    sh:resultMessage "Each extinguishing medium must have an approved compatibility status for the intended operation." ;
                    sh:resultPath nltl:extinguishingMediumCompatibilityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nf1f09062709045bea58814f0a078b6feb3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Each extinguishing medium must have an approved compatibility status for the intended operation.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extinguishingMediumCompatibilityStatus ] ]. See details for more information." ;
            sh:resultPath nltl:hasExtinguishingMedium ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ a sh:NodeShape ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:message "Each extinguishing medium must have an approved compatibility status for the intended operation." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:extinguishingMediumCompatibilityStatus ] ] ;
                    sh:path nltl:hasExtinguishingMedium ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-F02/medium1> ] .

