@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-P01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Valve exposure must be recorded as false when the conditional valve requirement is not applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:valveExposed ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Applicable exposed isolating, pressure, or vacuum valves must be protected from ice accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAccretionProtectionPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Applicable exposed isolating, pressure, or vacuum valves must remain continuously accessible.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:continuouslyAccessible ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Valve exposure must be recorded as true for an applicable exposed-valve case.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:valveExposed ], [ sh:datatype xsd:string ; sh:in ( Literal(\"isolating\") Literal(\"pressure\") Literal(\"vacuum\") ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"An exposed applicable valve must be identified as isolating, pressure, or vacuum.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:valveType ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-055> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-P01/ship> ] .

