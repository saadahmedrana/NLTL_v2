@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-P02/ship> ;
            sh:resultMessage "A ship must represent valve exposure and satisfy the applicable ice-accretion protection and accessibility condition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_055_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-P02/ship> ] .

