@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-F03/section1> ;
                    sh:resultMessage "Means of draining the exposed fire-main section must be provided." ;
                    sh:resultPath nltl:fireMainSectionDrainageMeansPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:message "Means of draining the exposed fire-main section must be provided." ;
                            sh:path nltl:fireMainSectionDrainageMeansPresent ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-F03/section1> ;
                    sh:resultMessage "The exposed fire-main section must have isolation capability." ;
                    sh:resultPath nltl:fireMainSectionIsolationCapability ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:message "The exposed fire-main section must have isolation capability." ;
                            sh:path nltl:fireMainSectionIsolationCapability ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-F03/ship> ;
            sh:resultMessage "Each linked exposed fire-main section must provide the required isolation and drainage arrangements." ;
            sh:resultPath nltl:hasExposedFireMainSection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked exposed fire-main section must provide the required isolation and drainage arrangements." ;
                    sh:node gen:IMO058ExposedFireMainSectionShape ;
                    sh:path nltl:hasExposedFireMainSection ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-F03/section1> ] .

