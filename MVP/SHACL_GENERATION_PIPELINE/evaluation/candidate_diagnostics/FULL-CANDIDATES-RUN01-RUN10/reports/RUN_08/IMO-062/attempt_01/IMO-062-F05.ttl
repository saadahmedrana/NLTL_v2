@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F05/ship> ;
            sh:resultMessage "The ship must record safe status as true." ;
            sh:resultPath nltl:safeStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n21b4952d9b4249a384c28f50e7b79e3ab3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F05/ship> ;
            sh:resultMessage "The ship must record ice/snow mitigation coverage as true." ;
            sh:resultPath nltl:iceSnowMitigationCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n21b4952d9b4249a384c28f50e7b79e3ab4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F05/ship> ;
            sh:resultMessage "The ship must record safe status as true." ;
            sh:resultPath nltl:safeStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n21b4952d9b4249a384c28f50e7b79e3ab3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F05/ship> ;
            sh:resultMessage "The ship must record ice/snow mitigation coverage as true." ;
            sh:resultPath nltl:iceSnowMitigationCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n21b4952d9b4249a384c28f50e7b79e3ab4 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F05/route1> ;
                    sh:resultMessage "Each exposed escape route must have documented ice/snow mitigation evidence." ;
                    sh:resultPath nltl:hasEscapeRouteIceSnowMitigationEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:message "Each exposed escape route must have documented ice/snow mitigation evidence." ;
                            sh:minCount 1 ;
                            sh:path nltl:hasEscapeRouteIceSnowMitigationEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-062-ExposedEscapeRouteShape>. See details for more information." ;
            sh:resultPath nltl:hasExposedEscapeRoute ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:exposedEscapeRoute ;
                    sh:node <urn:nltl:generated-shape:IMO-062-ExposedEscapeRouteShape> ;
                    sh:path nltl:hasExposedEscapeRoute ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F05/route1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F05/ship> ;
            sh:resultMessage "The ship must record accessible status as true." ;
            sh:resultPath nltl:accessibleStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n21b4952d9b4249a384c28f50e7b79e3ab2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F05/ship> ;
            sh:resultMessage "The ship must record accessible status as true." ;
            sh:resultPath nltl:accessibleStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n21b4952d9b4249a384c28f50e7b79e3ab2 ] .

_:n21b4952d9b4249a384c28f50e7b79e3ab2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record accessible status as true." ;
    sh:minCount 1 ;
    sh:path nltl:accessibleStatus .

_:n21b4952d9b4249a384c28f50e7b79e3ab3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record safe status as true." ;
    sh:minCount 1 ;
    sh:path nltl:safeStatus .

_:n21b4952d9b4249a384c28f50e7b79e3ab4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record ice/snow mitigation coverage as true." ;
    sh:minCount 1 ;
    sh:path nltl:iceSnowMitigationCoverage .

