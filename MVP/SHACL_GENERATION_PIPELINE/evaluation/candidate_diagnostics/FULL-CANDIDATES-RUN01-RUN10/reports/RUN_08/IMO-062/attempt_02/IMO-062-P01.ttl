@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-P01/route1> ;
            sh:resultMessage "Each exposed escape route shall be safe." ;
            sh:resultPath nltl:escapeRouteSafeStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n31e54a474d4e4d81a11e570249761b5db4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-P01/route1> ;
            sh:resultMessage "Each exposed escape route shall be accessible." ;
            sh:resultPath nltl:escapeRouteAccessibleStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n31e54a474d4e4d81a11e570249761b5db3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-P01/route1> ;
            sh:resultMessage "Each exposed escape route shall be safe." ;
            sh:resultPath nltl:escapeRouteSafeStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n31e54a474d4e4d81a11e570249761b5db4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-P01/route1> ;
            sh:resultMessage "Each exposed escape route shall be accessible." ;
            sh:resultPath nltl:escapeRouteAccessibleStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n31e54a474d4e4d81a11e570249761b5db3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-P01/ship> ;
            sh:resultMessage "The ship shall document ice and snow mitigation coverage." ;
            sh:resultPath nltl:iceSnowMitigationCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n31e54a474d4e4d81a11e570249761b5db1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-P01/ship> ;
            sh:resultMessage "The ship shall document ice and snow mitigation coverage." ;
            sh:resultPath nltl:iceSnowMitigationCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n31e54a474d4e4d81a11e570249761b5db1 ] .

_:n31e54a474d4e4d81a11e570249761b5db1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall document ice and snow mitigation coverage." ;
    sh:minCount 1 ;
    sh:path nltl:iceSnowMitigationCoverage .

_:n31e54a474d4e4d81a11e570249761b5db3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Each exposed escape route shall be accessible." ;
    sh:minCount 1 ;
    sh:path nltl:escapeRouteAccessibleStatus .

_:n31e54a474d4e4d81a11e570249761b5db4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Each exposed escape route shall be safe." ;
    sh:minCount 1 ;
    sh:path nltl:escapeRouteSafeStatus .

