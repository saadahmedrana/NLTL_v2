@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F02/ship> ;
            sh:resultMessage "Thermal-protection adequacy must have approved status." ;
            sh:resultPath nltl:thermalProtectionApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:evidenceStateApproved ) ;
                    sh:maxCount 1 ;
                    sh:message "Thermal-protection adequacy must have approved status." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:thermalProtectionApprovalStatus ] ;
            sh:value nltl:evidenceStateRejected ] .

