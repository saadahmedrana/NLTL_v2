@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F01/ship> ;
            sh:resultMessage "Survival support must last at least the maximum expected rescue time." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Survival support must last at least the maximum expected rescue time." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:survivalSupportDuration ?supportQuantity .
                ?supportQuantity qudt:numericValue ?supportValue ;
                    qudt:unit <http://qudt.org/vocab/unit/DAY> .
                $this nltl:maximumExpectedRescueTime ?rescueQuantity .
                ?rescueQuantity qudt:numericValue ?rescueValue ;
                    qudt:unit <http://qudt.org/vocab/unit/DAY> .
                FILTER (
                    datatype(?supportValue) = xsd:decimal &&
                    datatype(?rescueValue) = xsd:decimal &&
                    ?supportValue < ?rescueValue
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-065-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F01/ship> ] .

