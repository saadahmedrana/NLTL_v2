@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F07/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"The ship is not recorded as exposed to ice accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipExposedToIceAccretion ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The ship must record whether it is exposed to ice accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipExposedToIceAccretion ], [ sh:message Literal(\"A launching appliance must be represented among the protected items.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:hasValue nltl:launchingApplianceProtectedItem ; sh:path nltl:protectedItemCategory ] ] ], [ sh:message Literal(\"A muster station must be represented among the protected items.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:hasValue nltl:musterStationProtectedItem ; sh:path nltl:protectedItemCategory ] ] ], [ sh:message Literal(\"A survival craft must be represented among the protected items.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:hasValue nltl:survivalCraftProtectedItem ; sh:path nltl:protectedItemCategory ] ] ], [ sh:message Literal(\"Access to a survival craft must be represented among the protected items.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:hasValue nltl:survivalCraftAccessProtectedItem ; sh:path nltl:protectedItemCategory ] ] ], [ sh:message Literal(\"An embarkation area must be represented among the protected items.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:hasValue nltl:embarkationAreaProtectedItem ; sh:path nltl:protectedItemCategory ] ] ], [ sh:message Literal(\"An escape route must be represented among the protected items.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:hasValue nltl:escapeRouteProtectedItem ; sh:path nltl:protectedItemCategory ] ] ], [ sh:node [ sh:property [ sh:message Literal(\"Each protected item must have associated means to remove or prevent ice and snow accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasIceSnowRemovalOrPreventionMeans ], [ sh:message Literal(\"Each protected item must identify its protected-item category.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:protectedItemCategory ] ] ; sh:path nltl:hasProtectedItem ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-066-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F07/ship> ] .

