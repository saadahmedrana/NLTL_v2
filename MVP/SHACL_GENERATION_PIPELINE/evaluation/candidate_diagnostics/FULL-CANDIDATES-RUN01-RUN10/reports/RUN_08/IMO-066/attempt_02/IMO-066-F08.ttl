@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F08/ship> ;
            sh:resultMessage "Each ship must provide a single boolean ice-accretion applicability assessment." ;
            sh:resultPath nltl:shipExposedToIceAccretion ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Each ship must provide a single boolean ice-accretion applicability assessment." ;
                    sh:minCount 1 ;
                    sh:path nltl:shipExposedToIceAccretion ] ] .

