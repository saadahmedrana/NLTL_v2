    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipExposedToIceAccretion ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipExposedToIceAccretion ], [ sh:message Literal(\"At least one embarkation area shall have ice or snow removal or prevention means.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO_066_EmbarkationAreaItemShape ], [ sh:message Literal(\"At least one escape route shall have ice or snow removal or prevention means.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO_066_EscapeRouteItemShape ], [ sh:message Literal(\"At least one launching appliance shall have ice or snow removal or prevention means.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO_066_LaunchingApplianceItemShape ], [ sh:message Literal(\"At least one muster station shall have ice or snow removal or prevention means.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO_066_MusterStationItemShape ], [ sh:message Literal(\"At least one survival craft shall have ice or snow removal or prevention means.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO_066_SurvivalCraftItemShape ], [ sh:message Literal(\"At least one survival-craft access item shall have ice or snow removal or prevention means.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape gen:IMO_066_SurvivalCraftAccessItemShape ] ]" ;
