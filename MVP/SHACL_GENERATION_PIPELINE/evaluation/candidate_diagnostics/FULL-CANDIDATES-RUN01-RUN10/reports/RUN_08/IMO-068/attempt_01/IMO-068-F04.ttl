@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:IMO068ApplicableByIceOperationShape , gen:IMO068ApplicableByDirectIceEvacuationShape , gen:IMO068NotApplicableShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO068ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-F04/ship> ;
            sh:resultMessage "The ship's ice-covered-water operating condition is required to determine applicability." ;
            sh:resultPath nltl:shipOperatesInIceCoveredWaters ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "The ship's ice-covered-water operating condition is required to determine applicability." ;
                    sh:minCount 1 ;
                    sh:path nltl:shipOperatesInIceCoveredWaters ] ] .

