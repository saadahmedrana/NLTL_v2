@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-069-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:addedLifeSavingDeviceRequiresPower ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When an added life-saving device requires power, its power source must operate independently of the ship's main source of power.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:devicePowerSourceIndependentOfMainPower ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:addedLifeSavingDeviceRequiresPower ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_069_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-069-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-069-F03/ship> ;
            sh:resultMessage "The ship must state whether an added life-saving device requires a source of power." ;
            sh:resultPath nltl:addedLifeSavingDeviceRequiresPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "The ship must state whether an added life-saving device requires a source of power." ;
                    sh:minCount 1 ;
                    sh:path nltl:addedLifeSavingDeviceRequiresPower ] ] .

