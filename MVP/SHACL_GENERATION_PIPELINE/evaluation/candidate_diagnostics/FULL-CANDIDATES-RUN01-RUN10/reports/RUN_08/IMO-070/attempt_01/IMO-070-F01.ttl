@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "A passenger ship must report compatible sizing for the assigned personal survival equipment." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n79fbd0b91b414249a5919a0388008e82b1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/person1> ;
                    sh:resultMessage "Each person on board must have an immersion suit or thermal protective aid assignment." ;
                    sh:resultPath nltl:hasPersonalSurvivalEquipmentAssignment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each person on board must have an immersion suit or thermal protective aid assignment." ;
                            sh:minCount 1 ;
                            sh:node gen:IMO070AssignmentShape ;
                            sh:path nltl:hasPersonalSurvivalEquipmentAssignment ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO070PersonOnBoardMemberShape. See details for more information." ;
            sh:resultPath nltl:hasPersonOnBoardMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:IMO070PersonOnBoardMemberShape ;
                    sh:path nltl:hasPersonOnBoardMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/person1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "A passenger ship must report compatible sizing for the assigned personal survival equipment." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n79fbd0b91b414249a5919a0388008e82b1 ] .

_:n79fbd0b91b414249a5919a0388008e82b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "A passenger ship must report compatible sizing for the assigned personal survival equipment." ;
    sh:minCount 1 ;
    sh:path nltl:sizeCompatibilityStatus .

