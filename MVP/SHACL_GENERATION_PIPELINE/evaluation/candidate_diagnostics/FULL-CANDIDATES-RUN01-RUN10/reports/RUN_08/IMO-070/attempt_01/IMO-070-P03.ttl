@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P03/ship> ;
            sh:resultMessage "A passenger ship must report compatible sizing for the assigned personal survival equipment." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n79fbd0b91b414249a5919a0388008e82b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P03/ship> ;
            sh:resultMessage "A passenger ship must report compatible sizing for the assigned personal survival equipment." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n79fbd0b91b414249a5919a0388008e82b1 ] .

_:n79fbd0b91b414249a5919a0388008e82b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "A passenger ship must report compatible sizing for the assigned personal survival equipment." ;
    sh:minCount 1 ;
    sh:path nltl:sizeCompatibilityStatus .

