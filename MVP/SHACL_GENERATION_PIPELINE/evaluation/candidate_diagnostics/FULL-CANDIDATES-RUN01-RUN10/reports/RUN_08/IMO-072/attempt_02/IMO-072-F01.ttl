@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Extended darkness operation must be true for this applicability branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendedDarknessOperation ], [ sh:message Literal(\"At least one lifeboat is required when extended darkness operation applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:IMO-072-LifeboatShape> ; sh:path nltl:hasLifeboat ] ] , [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Extended darkness operation must be false for this applicability branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendedDarknessOperation ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-072-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F01/ship> ] .

