@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F01/ship> ;
            sh:resultMessage "When personal or group survival equipment is required, available survival equipment capacity must be at least 110% of the persons on board." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When personal or group survival equipment is required, available survival equipment capacity must be at least 110% of the persons on board." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:personalOrGroupSurvivalEquipmentRequired ?required ;
                      nltl:personsOnBoard ?persons ;
                      nltl:availableSurvivalEquipmentCapacity ?capacity .
                FILTER (
                    ?required = true &&
                    ?capacity < (?persons * 1.10)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO075Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:IMO075ApplicableShape , gs:IMO075NotApplicableShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO075Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F01/ship> ] .

