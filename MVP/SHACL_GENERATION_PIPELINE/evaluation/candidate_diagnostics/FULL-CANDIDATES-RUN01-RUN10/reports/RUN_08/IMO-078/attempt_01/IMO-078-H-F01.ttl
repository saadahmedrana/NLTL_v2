@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F01/passenger1> ;
                    sh:resultMessage "Every linked passenger must have completed personal survival equipment instruction." ;
                    sh:resultPath nltl:personalSurvivalEquipmentInstructionCompleted ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:message "Every linked passenger must have completed personal survival equipment instruction." ;
                            sh:minCount 1 ;
                            sh:path nltl:personalSurvivalEquipmentInstructionCompleted ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO078PassengerShape. See details for more information." ;
            sh:resultPath nltl:hasPassenger ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:passenger ;
                    sh:node gen:IMO078PassengerShape ;
                    sh:path nltl:hasPassenger ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F01/passenger1> ] .

