@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship shall have a clear view astern for this bridge configuration.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:clearViewAsternStatus ], [ sh:hasValue nltl:asternViewRequiredBridgeConfiguration ; sh:path nltl:bridgeConfigurationType ] ] , [ sh:property [ sh:not [ sh:hasValue nltl:asternViewRequiredBridgeConfiguration ] ; sh:path nltl:bridgeConfigurationType ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-082> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F05/ship> ] .

