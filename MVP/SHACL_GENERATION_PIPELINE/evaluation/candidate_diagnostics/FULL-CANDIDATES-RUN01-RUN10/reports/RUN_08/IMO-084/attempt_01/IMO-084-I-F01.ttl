@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-084-I-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to exactly one shape in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:requiredSensorProjectsBelowHull ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Sensors projecting below the hull shall be protected against ice.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sensorIceProtectionPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:requiredSensorProjectsBelowHull ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:XoneConstraintComponent ;
            sh:sourceShape g:IMO084Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-084-I-F01/ship> ] .

