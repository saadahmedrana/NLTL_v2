@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading2> ;
                    sh:resultMessage "Each non-magnetic heading means shall be connected to emergency power." ;
                    sh:resultPath nltl:connectedToEmergencyPower ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nfa839b2aee044b01a53259c4fd07b07bb4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic heading means." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nfa839b2aee044b01a53259c4fd07b07bb1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading2> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/ship> ;
            sh:resultMessage "Each non-magnetic heading means shall be connected to both main and emergency power and shall be independent from another distinct heading means of the same ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each non-magnetic heading means shall be connected to both main and emergency power and shall be independent from another distinct heading means of the same ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:hasNonMagneticHeadingMeans ?means .
                FILTER NOT EXISTS {
                    ?means nltl:connectedToMainPower ?mainPower .
                    ?means nltl:connectedToEmergencyPower ?emergencyPower .
                    ?means nltl:independentFromHeadingMeans ?otherMeans .
                    FILTER (?otherMeans != ?means)
                    $this nltl:hasNonMagneticHeadingMeans ?otherMeans .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-086-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading1> ;
                    sh:resultMessage "Each non-magnetic heading means shall be connected to emergency power." ;
                    sh:resultPath nltl:connectedToEmergencyPower ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nfa839b2aee044b01a53259c4fd07b07bb4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic heading means." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nfa839b2aee044b01a53259c4fd07b07bb1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading1> ] .

_:nfa839b2aee044b01a53259c4fd07b07bb1 sh:class nltl:nonMagneticHeadingMeans ;
    sh:message "The ship shall have at least two non-magnetic heading means." ;
    sh:minCount 2 ;
    sh:node <urn:nltl:generated-shape:IMO-086-HeadingMeansShape> ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasNonMagneticHeadingMeans .

_:nfa839b2aee044b01a53259c4fd07b07bb4 sh:class nltl:benchmarkEntity ;
    sh:message "Each non-magnetic heading means shall be connected to emergency power." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:connectedToEmergencyPower .

