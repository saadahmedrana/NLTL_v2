@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-094-J-F01/ship> ;
            sh:resultMessage "A ship providing icebreaking escort must have an astern-facing sound signaling system and comply with the International Code of Signals." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A ship providing icebreaking escort must have an astern-facing sound signaling system and comply with the International Code of Signals." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipProvidesIcebreakingEscort true .
                FILTER (
                    NOT EXISTS {
                        $this nltl:asternFacingSoundSignalingSystemPresent true
                    }
                    ||
                    EXISTS {
                        $this nltl:asternFacingSoundSignalingSystemPresent ?soundPresent .
                        FILTER (?soundPresent != true)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:internationalCodeOfSignalsComplianceStatus true
                    }
                    ||
                    EXISTS {
                        $this nltl:internationalCodeOfSignalsComplianceStatus ?codeCompliant .
                        FILTER (?codeCompliant != true)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-094> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-094-J-F01/ship> ] .

