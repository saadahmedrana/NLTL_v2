            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n084f3df29f3e462b8040969345ce6427b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F02/ship> ;
            sh:resultMessage "The ship must declare search and rescue communication capability." ;
