            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n084f3df29f3e462b8040969345ce6427b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F02/ship> ;
            sh:resultMessage "Less than 2 values on ex:ship->nltl:supportedAircraftVoiceFrequency" ;
