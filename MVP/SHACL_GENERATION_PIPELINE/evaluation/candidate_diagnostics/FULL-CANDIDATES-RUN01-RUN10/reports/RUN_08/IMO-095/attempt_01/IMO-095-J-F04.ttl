            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F04/freq1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F04/ship> ;
            sh:resultMessage "The ship must support aircraft voice communications at both 121.5 MHz and 123.1 MHz." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The ship must support aircraft voice communications at both 121.5 MHz and 123.1 MHz." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:supportedAircraftVoiceFrequency ?frequency1 .
                $this nltl:supportedAircraftVoiceFrequency ?frequency2 .
                ?frequency1 qudt:numericValue ?value1 .
                ?frequency2 qudt:numericValue ?value2 .
                FILTER (
                    (?value1 = "121.5"^^xsd:decimal &&
                     ?value2 = "123.1"^^xsd:decimal)
                    ||
                    (?value1 = "123.1"^^xsd:decimal &&
                     ?value2 = "121.5"^^xsd:decimal)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-095> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F04/ship> ],
