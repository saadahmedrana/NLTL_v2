    sh:minCount 1 ;
    sh:path qudt:unit .

_:N6a5b673093e646c19d93560fc251c9c6 a sh:NodeShape ;
    sh:property [ sh:hasValue unit:MegaHZ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
