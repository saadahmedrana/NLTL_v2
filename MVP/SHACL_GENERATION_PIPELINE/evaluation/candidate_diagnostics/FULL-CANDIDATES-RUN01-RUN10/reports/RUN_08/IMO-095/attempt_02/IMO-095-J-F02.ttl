@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F02/ship> ;
            sh:resultMessage "The ship shall support aircraft voice communications on both 121.5 MHz and 123.1 MHz." ;
            sh:resultPath nltl:supportedAircraftVoiceFrequency ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape _:n1ca69a9decf2439e9b402c4f5b502ff6b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F02/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath nltl:searchAndRescueCommunicationCapability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n1ca69a9decf2439e9b402c4f5b502ff6b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F02/ship> ;
            sh:resultMessage "The ship shall support aircraft voice communications on both 121.5 MHz and 123.1 MHz." ;
            sh:resultPath nltl:supportedAircraftVoiceFrequency ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall support aircraft voice communications on both 121.5 MHz and 123.1 MHz." ;
                    sh:minCount 2 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ sh:hasValue unit:MegaHZ ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:supportedAircraftVoiceFrequency ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ a sh:NodeShape ;
                            sh:property [ sh:hasValue unit:MegaHZ ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 123.1 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 123.1 ;
                                    sh:path qudt:numericValue ] ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F02/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath nltl:searchAndRescueCommunicationCapability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n1ca69a9decf2439e9b402c4f5b502ff6b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F02/ship> ;
            sh:resultMessage "The ship shall support aircraft voice communications on both 121.5 MHz and 123.1 MHz." ;
            sh:resultPath nltl:supportedAircraftVoiceFrequency ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n1ca69a9decf2439e9b402c4f5b502ff6b3 ] .

