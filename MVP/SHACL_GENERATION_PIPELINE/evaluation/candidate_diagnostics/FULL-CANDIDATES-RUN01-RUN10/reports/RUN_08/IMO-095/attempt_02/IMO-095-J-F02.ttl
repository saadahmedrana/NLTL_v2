            sh:path qudt:numericValue ] .

_:Nb00efe209b9b4ece8f264bffa2848054 sh:hasValue unit:MegaHZ ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

_:Nd4ce183f31974b0a837c9975abe1cede a sh:NodeShape ;
    sh:property _:N6667c79accb843c1bbb309cccdd7e132,
        _:Nb00efe209b9b4ece8f264bffa2848054 .

_:n1ca69a9decf2439e9b402c4f5b502ff6b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall declare search and rescue communication capability." ;
