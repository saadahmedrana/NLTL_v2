    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:N9ad076a3d4b74880b86376f11aec1522 a sh:NodeShape ;
    sh:property [ sh:hasValue unit:MegaHZ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 121.5 ;
