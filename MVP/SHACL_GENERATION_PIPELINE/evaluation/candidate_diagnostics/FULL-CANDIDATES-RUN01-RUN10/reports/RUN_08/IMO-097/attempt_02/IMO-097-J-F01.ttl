@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F01/ship> ;
            sh:resultMessage "An applicable ship must identify its lifeboat and other-survival-craft relationships." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "An applicable ship must identify its lifeboat and other-survival-craft relationships." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true .
                FILTER (
                    NOT EXISTS { $this nltl:hasLifeboat ?lifeboat }
                    ||
                    NOT EXISTS { $this nltl:hasOtherSurvivalCraft ?craft }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-097> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F01/ship> ] .

