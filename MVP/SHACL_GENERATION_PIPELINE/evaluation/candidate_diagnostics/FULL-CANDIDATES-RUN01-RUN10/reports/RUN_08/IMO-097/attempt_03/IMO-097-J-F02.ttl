@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F02/ship> ;
            sh:resultMessage "Each applicable survival craft must identify whether it is a released rescue boat or lifeboat." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each applicable survival craft must identify whether it is a released rescue boat or lifeboat." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true .
                $this nltl:hasSurvivalCraft ?craft .
                FILTER (
                    NOT EXISTS { ?craft nltl:releasedRescueBoatOrLifeboat ?released }
                    || EXISTS {
                        ?craft nltl:releasedRescueBoatOrLifeboat ?releasedValue .
                        FILTER (datatype(?releasedValue) != xsd:boolean)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-097-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F02/craft1> ;
            sh:resultMessage "An applicable released rescue boat or lifeboat must have a location-signal device." ;
            sh:resultPath nltl:survivalCraftHasLocationSignalDevice ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "An applicable released rescue boat or lifeboat must have a location-signal device." ;
                    sh:minCount 1 ;
                    sh:path nltl:survivalCraftHasLocationSignalDevice ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F02/ship> ;
            sh:resultMessage "When the ship operates in low air temperature, the declared lifeboat and survival-craft relationships must be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the ship operates in low air temperature, the declared lifeboat and survival-craft relationships must be present." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true .
                FILTER (
                    NOT EXISTS { $this nltl:hasLifeboat ?lifeboat }
                    || NOT EXISTS { $this nltl:hasOtherSurvivalCraft ?otherCraft }
                    || NOT EXISTS { $this nltl:hasRequiredRescueBoatOrLifeboat ?requiredCraft }
                    || NOT EXISTS { $this nltl:hasSurvivalCraft ?survivalCraft }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-097-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F02/ship> ] .

