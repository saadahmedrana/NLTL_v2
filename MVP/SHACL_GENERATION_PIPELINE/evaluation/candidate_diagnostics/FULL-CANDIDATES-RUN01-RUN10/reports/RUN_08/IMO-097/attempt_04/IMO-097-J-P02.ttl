@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P02/ship> ;
            sh:resultMessage "Each lifeboat reached through the declared lifeboat path must record whether it is released when the ship operates in low air temperature." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each lifeboat reached through the declared lifeboat path must record whether it is released when the ship operates in low air temperature." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:shipOperatesInLowAirTemperature true .
  {
    $this nltl:hasLifeboat ?craft .
  }
  UNION
  {
    $this nltl:hasRequiredRescueBoatOrLifeboat ?craft .
  }
  FILTER (
    NOT EXISTS {
      ?craft nltl:releasedRescueBoatOrLifeboat true .
    }
    &&
    NOT EXISTS {
      ?craft nltl:releasedRescueBoatOrLifeboat false .
    }
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-097-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P02/ship> ] .

