@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F02/ship> ;
            sh:resultMessage "The ship must have a polar route plan with required voyage-planning topic coverage." ;
            sh:resultPath nltl:hasPolarRoutePlan ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must have a polar route plan with required voyage-planning topic coverage." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The polar route plan must indicate that all required voyage-planning topics are covered." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:voyagePlanningTopicCoverage ] ] ;
                    sh:path nltl:hasPolarRoutePlan ] ] .

