@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F03/ship> ;
            sh:resultMessage "Each applicable crew member shall have a training record whose required level matches the recorded level and whose STCW qualification is valid." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each applicable crew member shall have a training record whose required level matches the recorded level and whose STCW qualification is valid." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType ;
                      nltl:hasCrewMemberInventory ?crew .
                ?crew nltl:polarTrainingCrewRoleClassification ?role .
                BIND(
                    IF(
                        ?ice = nltl:iceFreeIceCondition,
                        nltl:polarTrainingNotApplicable,
                        IF(
                            ?ice = nltl:openWaterIceCondition &&
                            ?shipType = nltl:otherShipPolarTrainingType,
                            nltl:polarTrainingNotApplicable,
                            IF(
                                ?ice = nltl:openWaterIceCondition,
                                nltl:basicPolarTrainingLevel,
                                IF(
                                    ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole,
                                    nltl:basicPolarTrainingLevel,
                                    nltl:advancedPolarTrainingLevel
                                )
                            )
                        )
                    )
                    AS ?required
                )
                FILTER (?required != nltl:polarTrainingNotApplicable)
                FILTER NOT EXISTS {
                    ?crew (
                        nltl:hasCrewTrainingRecord |
                        nltl:hasPolarTrainingRecord
                    ) ?record .
                    ?record nltl:requiredTrainingLevel ?required ;
                            nltl:trainingRecordLevel ?recordedLevel ;
                            nltl:stcwQualificationValid true .
                    FILTER (?recordedLevel = ?required)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_102_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F03/trainingRecord> ;
                            sh:resultMessage "A polar training record shall state a controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nfd54bf865be24584bab72e133918b37ab17 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F03/trainingRecord> ;
                            sh:resultMessage "An applicable polar training record shall have a valid STCW qualification." ;
                            sh:resultPath nltl:stcwQualificationValid ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:nfd54bf865be24584bab72e133918b37ab25 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F03/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:IMO_102_TrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasPolarTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node gen:IMO_102_TrainingRecordShape ;
                            sh:path nltl:hasPolarTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F03/trainingRecord> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F03/trainingRecord> ;
                            sh:resultMessage "A polar training record shall state a controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nfd54bf865be24584bab72e133918b37ab17 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F03/trainingRecord> ;
                            sh:resultMessage "An applicable polar training record shall have a valid STCW qualification." ;
                            sh:resultPath nltl:stcwQualificationValid ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:nfd54bf865be24584bab72e133918b37ab25 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F03/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:IMO_102_TrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasCrewTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node gen:IMO_102_TrainingRecordShape ;
                            sh:path nltl:hasCrewTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F03/trainingRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO_102_CrewMemberShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:IMO_102_CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F03/crew> ] .

_:N19e42af6e1c9484898e86aa7a94eeec9 rdf:first nltl:polarTrainingNotApplicable ;
    rdf:rest () .

_:N39f23272bd10473a90f5e84f13efdb2a rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest ( nltl:advancedPolarTrainingLevel nltl:polarTrainingNotApplicable ) .

_:nfd54bf865be24584bab72e133918b37ab17 sh:in _:N39f23272bd10473a90f5e84f13efdb2a ;
    sh:message "A polar training record shall state a controlled required training level." ;
    sh:minCount 1 ;
    sh:path nltl:requiredTrainingLevel .

_:nfd54bf865be24584bab72e133918b37ab25 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "An applicable polar training record shall have a valid STCW qualification." ;
    sh:minCount 1 ;
    sh:path nltl:stcwQualificationValid .

