@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ;
                            sh:resultMessage "A polar training record shall state a controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nfd54bf865be24584bab72e133918b37ab17 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:IMO_102_TrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasPolarTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node gen:IMO_102_TrainingRecordShape ;
                            sh:path nltl:hasPolarTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ;
                            sh:resultMessage "A polar training record shall state a controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nfd54bf865be24584bab72e133918b37ab17 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:IMO_102_TrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasCrewTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node gen:IMO_102_TrainingRecordShape ;
                            sh:path nltl:hasCrewTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ;
                    sh:resultMessage "Each linked crew member shall have exactly one controlled polar training role." ;
                    sh:resultPath nltl:polarTrainingCrewRoleClassification ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:masterPolarTrainingRole nltl:chiefMatePolarTrainingRole nltl:officerInChargeOfNavigationalWatchPolarTrainingRole ) ;
                            sh:maxCount 1 ;
                            sh:message "Each linked crew member shall have exactly one controlled polar training role." ;
                            sh:minCount 1 ;
                            sh:path nltl:polarTrainingCrewRoleClassification ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO_102_CrewMemberShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:IMO_102_CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ] .

_:N4cac160d8cd94581aab45c5ab91dc213 rdf:first nltl:polarTrainingNotApplicable ;
    rdf:rest () .

_:Nb563e047785f4ed58513569d9065becd rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest ( nltl:advancedPolarTrainingLevel nltl:polarTrainingNotApplicable ) .

_:nfd54bf865be24584bab72e133918b37ab17 sh:in _:Nb563e047785f4ed58513569d9065becd ;
    sh:message "A polar training record shall state a controlled required training level." ;
    sh:minCount 1 ;
    sh:path nltl:requiredTrainingLevel .

