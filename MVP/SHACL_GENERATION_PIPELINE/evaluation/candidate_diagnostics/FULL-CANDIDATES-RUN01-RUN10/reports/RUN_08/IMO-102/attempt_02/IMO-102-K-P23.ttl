@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P23/ship> ;
            sh:resultMessage "Each applicable crew member shall have one matching polar training record through both declared training-record relationships, with the matrix-required level and a valid STCW qualification." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each applicable crew member shall have one matching polar training record through both declared training-record relationships, with the matrix-required level and a valid STCW qualification." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification ?ice ;
                       nltl:polarTrainingShipTypeClassification ?shipType ;
                       nltl:hasCrewMemberInventory ?crew .

                ?crew nltl:polarTrainingCrewRoleClassification ?role .

                FILTER (
                    (
                        ?ice = nltl:openWaterIceCondition &&
                        ?shipType IN (
                            nltl:tankerPolarTrainingShipType,
                            nltl:passengerShipPolarTrainingShipType
                        ) &&
                        ?role IN (
                            nltl:masterPolarTrainingRole,
                            nltl:chiefMatePolarTrainingRole,
                            nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
                        )
                    )
                    ||
                    (
                        ?ice = nltl:otherWatersIceCondition &&
                        ?role IN (
                            nltl:masterPolarTrainingRole,
                            nltl:chiefMatePolarTrainingRole
                        )
                    )
                    ||
                    (
                        ?ice = nltl:otherWatersIceCondition &&
                        ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
                    )
                )

                FILTER NOT EXISTS {
                    ?crew nltl:hasCrewTrainingRecord ?record ;
                          nltl:hasPolarTrainingRecord ?record .

                    ?record nltl:requiredTrainingLevel ?requiredLevel ;
                            nltl:trainingRecordLevel ?recordLevel ;
                            nltl:stcwQualificationValid true .

                    FILTER (
                        (
                            ?ice = nltl:openWaterIceCondition &&
                            ?shipType IN (
                                nltl:tankerPolarTrainingShipType,
                                nltl:passengerShipPolarTrainingShipType
                            ) &&
                            ?requiredLevel = nltl:basicPolarTrainingLevel
                        )
                        ||
                        (
                            ?ice = nltl:otherWatersIceCondition &&
                            ?role IN (
                                nltl:masterPolarTrainingRole,
                                nltl:chiefMatePolarTrainingRole
                            ) &&
                            ?requiredLevel = nltl:advancedPolarTrainingLevel
                        )
                        ||
                        (
                            ?ice = nltl:otherWatersIceCondition &&
                            ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole &&
                            ?requiredLevel = nltl:basicPolarTrainingLevel
                        )
                    )

                    FILTER (?recordLevel = ?requiredLevel)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-102-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P23/ship> ] .

