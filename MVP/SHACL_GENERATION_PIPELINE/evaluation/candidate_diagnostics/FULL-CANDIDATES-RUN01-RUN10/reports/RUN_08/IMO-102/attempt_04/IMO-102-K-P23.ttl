@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P23/trainingRecord> ;
                            sh:resultMessage "A crew training record must state exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:in ( nltl:basicPolarTrainingLevel nltl:advancedPolarTrainingLevel nltl:polarTrainingNotApplicable ) ;
                                    sh:maxCount 1 ;
                                    sh:message "A crew training record must state exactly one controlled required training level." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:requiredTrainingLevel ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P23/crew> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-102-CrewTrainingRecordShape>. See details for more information." ;
                    sh:resultPath nltl:hasCrewTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-102-CrewTrainingRecordShape> ;
                            sh:path nltl:hasCrewTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P23/trainingRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P23/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-102-CrewMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:crewMember ;
                    sh:node <urn:nltl:generated-shape:IMO-102-CrewMemberShape> ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P23/crew> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P23/ship> ;
            sh:resultMessage "Each applicable crew member must have a matching required training level, a true STCW qualification status, and separately linked polar-training evidence." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each applicable crew member must have a matching required training level, a true STCW qualification status, and separately linked polar-training evidence." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?crew
            WHERE {
                $this nltl:hasCrewMemberInventory ?crew .
                $this nltl:iceConditionClassification ?ice .
                $this nltl:polarTrainingShipTypeClassification ?shipType .
                ?crew nltl:polarTrainingCrewRoleClassification ?role .

                BIND(
                    IF(
                        ?ice = nltl:otherWatersIceCondition &&
                        (
                            ?role = nltl:masterPolarTrainingRole ||
                            ?role = nltl:chiefMatePolarTrainingRole
                        ),
                        nltl:advancedPolarTrainingLevel,
                        IF(
                            (
                                ?ice = nltl:otherWatersIceCondition &&
                                ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
                            ) ||
                            (
                                ?ice = nltl:openWaterIceCondition &&
                                (
                                    ?shipType = nltl:tankerPolarTrainingShipType ||
                                    ?shipType = nltl:passengerShipPolarTrainingShipType
                                )
                            ),
                            nltl:basicPolarTrainingLevel,
                            nltl:polarTrainingNotApplicable
                        )
                    ) AS ?expectedLevel
                )

                FILTER (?expectedLevel != nltl:polarTrainingNotApplicable)

                FILTER (
                    NOT EXISTS {
                        ?crew nltl:hasCrewTrainingRecord ?record .
                        ?record nltl:requiredTrainingLevel ?expectedLevel .
                        ?record nltl:trainingRecordLevel ?recordLevel .
                        ?record nltl:stcwQualificationValid true .
                        FILTER (?recordLevel = ?expectedLevel)
                    }
                    ||
                    NOT EXISTS {
                        ?crew nltl:hasPolarTrainingRecord ?evidence .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-102-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P23/ship> ] .

