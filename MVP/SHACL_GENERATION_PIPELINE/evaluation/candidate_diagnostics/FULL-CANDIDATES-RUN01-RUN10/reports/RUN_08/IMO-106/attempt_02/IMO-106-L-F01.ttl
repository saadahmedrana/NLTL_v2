@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F01/ship> ;
            sh:resultMessage "For clean or segregated ballast discharge, the paragraph 1.1.1 oil-discharge prohibition applicability must be explicitly false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For clean or segregated ballast discharge, the paragraph 1.1.1 oil-discharge prohibition applicability must be explicitly false." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:dischargedMaterialClassification ?classification .
                FILTER (
                    ?classification = nltl:cleanBallastMaterial ||
                    ?classification = nltl:segregatedBallastMaterial
                )
                FILTER NOT EXISTS {
                    $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable false
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_106_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F01/ship> ] .

