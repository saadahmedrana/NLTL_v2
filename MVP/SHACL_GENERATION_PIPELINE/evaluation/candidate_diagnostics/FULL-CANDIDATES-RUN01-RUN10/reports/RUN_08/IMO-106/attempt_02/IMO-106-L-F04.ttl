@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F04/ship> ;
            sh:resultMessage "The discharged material classification must be clean ballast or segregated ballast." ;
            sh:resultPath nltl:dischargedMaterialClassification ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:cleanBallastMaterial nltl:segregatedBallastMaterial ) ;
                    sh:message "The discharged material classification must be clean ballast or segregated ballast." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:dischargedMaterialClassification ] ] .

