@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F02/ship> ;
            sh:resultMessage "For clean or segregated ballast discharge, the oil-discharge prohibition applicability must be explicitly typed boolean false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For clean or segregated ballast discharge, the oil-discharge prohibition applicability must be explicitly typed boolean false." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:dischargedMaterialClassification ?material .
    FILTER (
        ?material = nltl:cleanBallastMaterial ||
        ?material = nltl:segregatedBallastMaterial
    )
    FILTER (
        NOT EXISTS {
            $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?validFalse .
            FILTER (
                datatype(?validFalse) = xsd:boolean &&
                ?validFalse = false
            )
        }
        ||
        EXISTS {
            $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?app .
            FILTER (
                !(datatype(?app) = xsd:boolean && ?app = false)
            )
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_106_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F02/ship> ] .

