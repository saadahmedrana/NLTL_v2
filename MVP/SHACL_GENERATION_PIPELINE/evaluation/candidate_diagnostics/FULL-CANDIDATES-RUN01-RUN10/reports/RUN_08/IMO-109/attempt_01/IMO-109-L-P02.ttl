@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-P02/ship> ;
            sh:resultMessage "For a Category A or B ship constructed on or after 1 January 2017, other than an oil tanker, when cargo tanks carry oil, the cargo tank outer shell separation must be at least 0.76 m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a Category A or B ship constructed on or after 1 January 2017, other than an oil tanker, when cargo tanks carry oil, the cargo tank outer shell separation must be at least 0.76 m." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:shipType ?shipType ;
                      nltl:constructionDate ?constructionDate ;
                      nltl:cargoTankCarriesOil ?carriesOil .

                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                    && ?shipType != "oil_tanker"^^xsd:string
                    && ?constructionDate >= "2017-01-01"^^xsd:date
                    && ?carriesOil = true
                )

                FILTER NOT EXISTS {
                    $this nltl:cargoTankOuterShellSeparation ?separation .
                    ?separation a qudt:QuantityValue ;
                                qudt:numericValue ?value ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .

                    FILTER (
                        datatype(?value) = xsd:decimal
                        && ?value >= "0.76"^^xsd:decimal
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-109-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-P02/ship> ] .

