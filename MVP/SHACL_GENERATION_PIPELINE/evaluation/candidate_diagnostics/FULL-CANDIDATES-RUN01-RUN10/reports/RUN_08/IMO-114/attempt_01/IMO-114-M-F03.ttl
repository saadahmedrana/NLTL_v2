@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-F03/ship> ;
            sh:resultMessage "For an applicable Category A or B ship, the Administration approval must be approved and the applicable polar operation certificate entry must be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an applicable Category A or B ship, the Administration approval must be approved and the applicable polar operation certificate entry must be present." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:shipCategory ?category ;
          nltl:constructionDate ?constructionDate ;
          nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ?requiresType3 ;
          nltl:cargoTankType ?tankType .

    FILTER (
        ?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB)
        && ?constructionDate >= "2017-01-01"^^xsd:date
        && ?requiresType3 = true
        && ?tankType = "3"
    )

    FILTER (
        NOT EXISTS {
            $this nltl:administrationCarriageApprovalStatus nltl:evidenceStateApproved
        }
        ||
        EXISTS {
            $this nltl:administrationCarriageApprovalStatus ?approvalStatus .
            FILTER (?approvalStatus != nltl:evidenceStateApproved)
        }
        ||
        NOT EXISTS {
            $this nltl:applicableCertificatePolarOperationEntryPresent true
        }
        ||
        EXISTS {
            $this nltl:applicableCertificatePolarOperationEntryPresent ?entryPresent .
            FILTER (?entryPresent != true)
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-114> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-F03/ship> ] .

