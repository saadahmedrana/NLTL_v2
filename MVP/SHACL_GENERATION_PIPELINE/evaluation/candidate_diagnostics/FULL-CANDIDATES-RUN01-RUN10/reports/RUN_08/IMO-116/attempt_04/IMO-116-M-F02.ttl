@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-F02/ship> ;
            sh:resultMessage "The sewage discharge condition and its applicable Polar Code evidence must conform." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-116-Static> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-F02/ship> ] .

