@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F01/ship> ;
            sh:resultMessage "For ships constructed on or after 1 January 2017, sewage discharge to sea must be false unless paragraph 4.2.1.3 compliance is true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO_118_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F01/ship> ] .

