@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in <urn:nltl:generated-shape:IMO-119-applicable> , <urn:nltl:generated-shape:IMO-119-category-c> , <urn:nltl:generated-shape:IMO-119-ice-not-exceeding-one> , <urn:nltl:generated-shape:IMO-119-not-extended> , <urn:nltl:generated-shape:IMO-119-no-discharge>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-119> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F03/ship> ] .

