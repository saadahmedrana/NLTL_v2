@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F03/ship> ;
            sh:resultMessage "Cargo-residue discharge is permitted only when one of the verified regulatory branches is satisfied." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-123-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F03/ship> ] .

