@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F09/ship> ;
            sh:resultMessage "A discharge-distance record must be provided." ;
            sh:resultPath nltl:hasDischargeDistanceRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A discharge-distance record must be provided." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-123-DischargeDistanceRecordShape> ;
                    sh:path nltl:hasDischargeDistanceRecord ] ] .

