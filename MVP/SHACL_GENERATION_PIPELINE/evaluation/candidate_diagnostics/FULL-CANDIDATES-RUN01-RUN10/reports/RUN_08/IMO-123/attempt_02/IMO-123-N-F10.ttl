@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ;
                    sh:resultMessage "The distance to the nearest land, ice shelf, or fast ice must be at least 12 nautical miles." ;
                    sh:resultPath nltl:distanceToNearestLandIceShelfOrFastIce ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:na36ce3ce971a49ea895d1fdfc4295160b11 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ;
                    sh:resultMessage "The distance from an area with ice concentration greater than one tenth must be recorded." ;
                    sh:resultPath nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:na36ce3ce971a49ea895d1fdfc4295160b12 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/ship> ;
            sh:resultMessage "A discharge-distance record must be provided." ;
            sh:resultPath nltl:hasDischargeDistanceRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A discharge-distance record must be provided." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-123-DischargeDistanceRecordShape> ;
                    sh:path nltl:hasDischargeDistanceRecord ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ;
            sh:resultMessage "The distance from an area with ice concentration greater than one tenth must be recorded." ;
            sh:resultPath nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:na36ce3ce971a49ea895d1fdfc4295160b12 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ;
            sh:resultMessage "The distance to the nearest land, ice shelf, or fast ice must be at least 12 nautical miles." ;
            sh:resultPath nltl:distanceToNearestLandIceShelfOrFastIce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:na36ce3ce971a49ea895d1fdfc4295160b11 ] .

_:na36ce3ce971a49ea895d1fdfc4295160b11 sh:maxCount 1 ;
    sh:message "The distance to the nearest land, ice shelf, or fast ice must be at least 12 nautical miles." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:IMO-123-MinimumDistanceShape> ;
    sh:path nltl:distanceToNearestLandIceShelfOrFastIce .

_:na36ce3ce971a49ea895d1fdfc4295160b12 sh:maxCount 1 ;
    sh:message "The distance from an area with ice concentration greater than one tenth must be recorded." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:IMO-123-UnthresholdedDistanceShape> ;
    sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth .

