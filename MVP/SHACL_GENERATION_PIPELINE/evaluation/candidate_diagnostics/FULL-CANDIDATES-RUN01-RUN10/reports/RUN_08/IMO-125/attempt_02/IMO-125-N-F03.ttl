@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F03/ship> ;
            sh:resultMessage "When the ship operates in polar waters, the Garbage Record Book, Garbage Management Plan, and garbage placards must include polar-operation coverage." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the ship operates in polar waters, the Garbage Record Book, Garbage Management Plan, and garbage placards must include polar-operation coverage." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters true .
                FILTER (
                    NOT EXISTS {
                        $this nltl:garbageRecordBookPolarCoverage true
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:garbageManagementPlanPolarCoverage true
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:garbagePlacardPolarCoverage true
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-125> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F03/ship> ] .

