@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F05/ship> ;
            sh:resultMessage "The polar-operation applicability value must be provided." ;
            sh:resultPath nltl:shipOperatesInPolarWaters ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "The polar-operation applicability value must be provided." ;
                    sh:minCount 1 ;
                    sh:path nltl:shipOperatesInPolarWaters ] ] .

