@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F04/ship> ;
            sh:resultMessage "The Chapter 9-1 applicability result does not match the ship category, dimensions, gross tonnage, and trade status." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The Chapter 9-1 applicability result does not match the ship category, dimensions, gross tonnage, and trade status." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:polarCodeChapter9Dash1Applicable ?actual .
                BIND (
                    EXISTS {
                        $this rdf:type nltl:fishingVessel .
                        $this nltl:lengthOverall ?lengthQuantity .
                        ?lengthQuantity qudt:numericValue ?lengthValue ;
                                         qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (
                            datatype(?lengthValue) = xsd:decimal &&
                            ?lengthValue >= 24
                        )
                    } ||
                    EXISTS {
                        $this rdf:type nltl:pleasureYacht .
                        $this nltl:grossTonnage ?grossQuantity .
                        ?grossQuantity qudt:numericValue ?grossValue ;
                                       qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        $this nltl:engagedInTrade ?tradeValue .
                        FILTER (
                            datatype(?grossValue) = xsd:decimal &&
                            ?grossValue >= 300 &&
                            datatype(?tradeValue) = xsd:boolean &&
                            ?tradeValue = false
                        )
                    } ||
                    EXISTS {
                        $this rdf:type nltl:cargoShip .
                        $this nltl:grossTonnage ?grossQuantity .
                        ?grossQuantity qudt:numericValue ?grossValue ;
                                       qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (
                            datatype(?grossValue) = xsd:decimal &&
                            ?grossValue >= 300 &&
                            ?grossValue < 500
                        )
                    }
                    AS ?expected
                )
                FILTER (?actual != ?expected)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO26_002_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F04/ship> ] .

