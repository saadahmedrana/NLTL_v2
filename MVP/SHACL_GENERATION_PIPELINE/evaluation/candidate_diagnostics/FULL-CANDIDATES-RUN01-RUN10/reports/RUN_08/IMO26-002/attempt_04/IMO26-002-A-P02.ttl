@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:FishingVesselBranch , gs:PleasureYachtBranch , gs:CargoShipBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:Chapter9Dash1ApplicabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P02/ship> ;
            sh:resultMessage "Exactly one canonical ship category must be represented as fishing vessel, pleasure yacht, or cargo ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Exactly one canonical ship category must be represented as fishing vessel, pleasure yacht, or cargo ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                BIND(
                    IF(EXISTS { $this a nltl:fishingVessel }, 1, 0) +
                    IF(EXISTS { $this a nltl:pleasureYacht }, 1, 0) +
                    IF(EXISTS { $this a nltl:cargoShip }, 1, 0)
                    AS ?categoryCount
                )
                FILTER(?categoryCount != 1)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:Chapter9Dash1ApplicabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-P02/ship> ] .

