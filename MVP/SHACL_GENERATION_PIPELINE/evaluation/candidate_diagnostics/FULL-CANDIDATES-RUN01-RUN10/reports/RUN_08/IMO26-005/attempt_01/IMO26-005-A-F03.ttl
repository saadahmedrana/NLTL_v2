@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-F03/ship> ;
            sh:resultMessage "Each heading-reference or position-fixing system must have an approved intended-area suitability status." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each heading-reference or position-fixing system must have an approved intended-area suitability status." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:headingOrPositionSystem ?system .
                FILTER NOT EXISTS {
                    $this nltl:intendedAreaSuitabilityApprovalStatus
                        nltl:evidenceStateApproved .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-005> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-F03/ship> ] .

