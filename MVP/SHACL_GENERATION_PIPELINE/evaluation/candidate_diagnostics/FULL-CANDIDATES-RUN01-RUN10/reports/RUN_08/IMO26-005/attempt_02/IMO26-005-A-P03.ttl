@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P03/ship> ;
            sh:resultMessage "The heading-reference or position-fixing system must be approved as suitable for the declared intended area." ;
            sh:resultPath nltl:intendedAreaSuitabilityApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceState ;
                    sh:in ( nltl:evidenceStateApproved ) ;
                    sh:message "The heading-reference or position-fixing system must be approved as suitable for the declared intended area." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:intendedAreaSuitabilityApprovalStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P03/ship> ;
            sh:resultMessage "The ship must declare the intended area for suitability assessment." ;
            sh:resultPath nltl:intendedArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must declare the intended area for suitability assessment." ;
                    sh:minCount 1 ;
                    sh:path nltl:intendedArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P03/ship> ;
            sh:resultMessage "The ship must identify its heading-reference or position-fixing system." ;
            sh:resultPath nltl:headingOrPositionSystem ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must identify its heading-reference or position-fixing system." ;
                    sh:minCount 1 ;
                    sh:path nltl:headingOrPositionSystem ] ] .

