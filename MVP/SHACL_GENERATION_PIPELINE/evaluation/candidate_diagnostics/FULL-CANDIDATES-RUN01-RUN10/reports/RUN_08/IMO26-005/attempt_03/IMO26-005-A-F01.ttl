@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-F01/ship> ;
            sh:resultMessage "Every represented heading-reference or position-fixing system must be covered by an Approved suitability status for the ship's declared intended area." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Every represented heading-reference or position-fixing system must be covered by an Approved suitability status for the ship's declared intended area." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:headingOrPositionSystem ?system .
                FILTER NOT EXISTS {
                    $this nltl:intendedArea ?area ;
                          nltl:intendedAreaSuitabilityApprovalStatus nltl:evidenceStateApproved .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO26_005_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-F01/ship> ;
            sh:resultMessage "The intended-area suitability approval status must be Approved." ;
            sh:resultPath nltl:intendedAreaSuitabilityApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceState ;
                    sh:in ( nltl:evidenceStateApproved ) ;
                    sh:maxCount 1 ;
                    sh:message "The intended-area suitability approval status must be Approved." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:intendedAreaSuitabilityApprovalStatus ] ;
            sh:value nltl:evidenceStateRejected ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-F01/ship> ;
            sh:resultMessage "The ship must declare its intended area." ;
            sh:resultPath nltl:intendedArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must declare its intended area." ;
                    sh:minCount 1 ;
                    sh:path nltl:intendedArea ] ] .

