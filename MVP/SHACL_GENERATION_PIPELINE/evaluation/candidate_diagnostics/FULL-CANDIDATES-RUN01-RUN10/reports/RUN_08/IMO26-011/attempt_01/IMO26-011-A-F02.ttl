@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-011-A-F02/ship> ;
            sh:resultMessage "For a Category A or B ship constructed on or after 1 January 2026, bridge wings must be enclosed, have the required protection design, or have an Administration-approved equivalent arrangement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a Category A or B ship constructed on or after 1 January 2026, bridge wings must be enclosed, have the required protection design, or have an Administration-approved equivalent arrangement." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?constructionDate .

                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )

                FILTER (
                    YEAR(?constructionDate) > 2026
                    || (
                        YEAR(?constructionDate) = 2026
                        && MONTH(?constructionDate) > 1
                    )
                    || (
                        YEAR(?constructionDate) = 2026
                        && MONTH(?constructionDate) = 1
                        && DAY(?constructionDate) >= 1
                    )
                )

                FILTER NOT EXISTS {
                    $this nltl:bridgeWingsEnclosed ?enclosed .
                    FILTER (?enclosed = true)
                }

                FILTER NOT EXISTS {
                    $this nltl:bridgeWingProtectionDesignStatus ?designed .
                    FILTER (?designed = true)
                }

                FILTER NOT EXISTS {
                    $this nltl:administrationApprovedEquivalentBridgeWingProtectionPresent ?equivalent .
                    FILTER (?equivalent = true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO26_011_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-011-A-F02/ship> ] .

