            sh:sourceShape _:nd4ea09ad24a5476ba885a62fcb2d9a14b3 ] .

_:nd4ea09ad24a5476ba885a62fcb2d9a14b3 sh:class nltl:iceClassRegulatoryProvisionValue ;
    sh:hasValue nltl:iceClassSection1Point8Provision2021 ;
    sh:message "The 2021 section 1.8 Ice Classes provision must apply." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:applicableIceClassRegulatoryProvision .

_:nd4ea09ad24a5476ba885a62fcb2d9a14b4 sh:class nltl:iceClassRegulatoryProvisionValue ;
