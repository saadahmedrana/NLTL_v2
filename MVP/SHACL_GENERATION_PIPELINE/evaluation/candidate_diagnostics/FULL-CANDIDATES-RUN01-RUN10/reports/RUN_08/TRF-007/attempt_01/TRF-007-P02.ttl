@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P02/ship> ;
            sh:resultMessage "The applicable compliance deadline is 1 January in the year twenty years after delivery." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The applicable compliance deadline is 1 January in the year twenty years after delivery." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:constructionStageDate ?stage ;
                      nltl:deliveryDate ?delivery ;
                      nltl:assessmentDate ?assessment .
                FILTER (?ice IN (
                    nltl:iceClassIa,
                    nltl:iceClassIaSuper
                ))
                FILTER (datatype(?stage) = xsd:date)
                FILTER (datatype(?delivery) = xsd:date)
                FILTER (datatype(?assessment) = xsd:date)
                FILTER (
                    YEAR(?stage) < 2003 ||
                    (YEAR(?stage) = 2003 && MONTH(?stage) < 9)
                )
                FILTER NOT EXISTS {
                    $this nltl:assessmentDate ?observedAssessment .
                    FILTER (datatype(?observedAssessment) = xsd:date)
                    FILTER (
                        YEAR(?observedAssessment) < YEAR(?delivery) + 20 ||
                        (
                            YEAR(?observedAssessment) = YEAR(?delivery) + 20 &&
                            MONTH(?observedAssessment) = 1 &&
                            DAY(?observedAssessment) <= 1
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF007ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P02/ship> ] .

