@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-P01/ship> ;
            sh:resultMessage "For an IA Super or IA ship whose construction stage began before 1 September 2003, an allowed compliance method and delivery date are required, and the compliance deadline must be 1 January twenty years after the delivery year." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an IA Super or IA ship whose construction stage began before 1 September 2003, an allowed compliance method and delivery date are required, and the compliance deadline must be 1 January twenty years after the delivery year." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?constructionStageDate .

                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa
                    )
                )

                FILTER (
                    YEAR(?constructionStageDate) < 2003
                    ||
                    (
                        YEAR(?constructionStageDate) = 2003
                        && MONTH(?constructionStageDate) < 9
                    )
                )

                OPTIONAL {
                    $this nltl:deliveryDate ?deliveryDate .
                }

                OPTIONAL {
                    $this nltl:engineOutputComplianceMethod ?method .
                }

                FILTER (
                    !BOUND(?deliveryDate)
                    ||
                    !BOUND(?method)
                    ||
                    (
                        datatype(?deliveryDate) = xsd:date
                        &&
                        (
                            MONTH(?deliveryDate) != 1
                            ||
                            DAY(?deliveryDate) != 1
                            ||
                            YEAR(?deliveryDate) + 20 < YEAR(?deliveryDate) + 20
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-009-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-P01/ship> ] .

