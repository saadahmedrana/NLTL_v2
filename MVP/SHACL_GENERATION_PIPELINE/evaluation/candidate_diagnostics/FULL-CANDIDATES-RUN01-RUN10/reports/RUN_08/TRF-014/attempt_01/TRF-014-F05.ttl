@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "The ice draught restriction information shall be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n2620cea6edf74740b6e19104e1934d40b10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "The ice draught restriction information shall be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n2620cea6edf74740b6e19104e1934d40b9 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "The ice draught restriction information shall be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n2620cea6edf74740b6e19104e1934d40b10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "The ice draught restriction information shall be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n2620cea6edf74740b6e19104e1934d40b9 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "For a ship built on or after 1 July 2007, when the summer load line fresh water draught is above the UIWL, the warning triangle and ice-class draught mark at the maximum permissible amidships draught are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a ship built on or after 1 July 2007, when the summer load line fresh water draught is above the UIWL, the warning triangle and ice-class draught mark at the maximum permissible amidships draught are required." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?construction ;
                      nltl:summerLoadLineFreshWaterDraught ?summer ;
                      nltl:upperIceWaterlineDraught ?uiwl .
                ?summer qudt:numericValue ?summerValue .
                ?uiwl qudt:numericValue ?uiwlValue .
                FILTER (?construction >= "2007-07-01"^^xsd:date)
                FILTER (?summerValue > ?uiwlValue)
                FILTER (
                    NOT EXISTS {
                        $this nltl:warningTrianglePresent true
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceClassDraughtMarkPresent true
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceClassDraughtMarkDraughtAmidships ?mark ;
                              nltl:hasClassCertificate ?certificate .
                        ?mark qudt:numericValue ?markValue .
                        ?certificate nltl:maximumIceClassDraughtAmidships ?maximum .
                        ?maximum qudt:numericValue ?maximumValue .
                        FILTER (?markValue = ?maximumValue)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlgen:TRF014ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ] .

_:n2620cea6edf74740b6e19104e1934d40b10 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice draught restriction information shall be readily available to the master." ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

_:n2620cea6edf74740b6e19104e1934d40b9 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice draught restriction information shall be retained on board." ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

