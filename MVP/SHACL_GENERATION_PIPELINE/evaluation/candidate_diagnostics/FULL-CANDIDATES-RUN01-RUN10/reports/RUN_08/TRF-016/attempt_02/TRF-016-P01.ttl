@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-P01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:iceWaterline ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasLowerIceWaterline ], [ sh:class nltl:iceWaterline ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasUpperIceWaterline ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerHighestPointSubmerged ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:navigatingInIce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-016-LengthQuantity> ; sh:path nltl:draughtAmidships ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-016-LengthQuantity> ; sh:path nltl:forwardDraught ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-016-LengthQuantity> ; sh:path nltl:levelIceThickness ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-016-LengthQuantity> ; sh:path nltl:liwlDraughtAmidships ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-016-MassQuantity> ; sh:path nltl:displacementAtUpperIceWaterline ], [ sh:node [ sh:class nltl:ballastTank ] ; sh:path nltl:hasBallastTank ] ; sh:sparql [ sh:message Literal("A ballast tank situated above the LIWL and needed to reach the LIWL must have freezing prevention.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasBallastTank ?tank .
                        ?tank nltl:situatedAboveLowerIceWaterline true ;
                              nltl:usedToReachLowerIceWaterline true .
                        FILTER NOT EXISTS {
                            ?tank nltl:freezingPreventionPresent true
                        }
                    }
                ") ], [ sh:message Literal("Draught amidships must be at least the LIWL draught amidships when navigating in ice.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:draughtAmidships ?draughtNode ;
                              nltl:liwlDraughtAmidships ?liwlNode .
                        ?draughtNode <http://qudt.org/schema/qudt/numericValue> ?draught .
                        ?liwlNode <http://qudt.org/schema/qudt/numericValue> ?liwl .
                        FILTER (?draught < ?liwl)
                    }
                ") ], [ sh:message Literal("Forward draught must satisfy the UIWL displacement and level-ice-thickness formula.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:forwardDraught ?forwardNode ;
                              nltl:displacementAtUpperIceWaterline ?displacementNode ;
                              nltl:levelIceThickness ?thicknessNode .
                        ?forwardNode <http://qudt.org/schema/qudt/numericValue> ?forward .
                        ?displacementNode <http://qudt.org/schema/qudt/numericValue> ?displacement .
                        ?thicknessNode <http://qudt.org/schema/qudt/numericValue> ?thickness .
                        BIND ((2 + (0.00025 * ?displacement)) * ?thickness AS ?formulaLimit)
                        BIND (4 * ?thickness AS ?upperLimit)
                        BIND (IF(?formulaLimit < ?upperLimit, ?formulaLimit, ?upperLimit) AS ?requiredForward)
                        FILTER (?forward < ?requiredForward)
                    }
                ") ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:navigatingInIce ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-016> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-P01/ship> ] .

