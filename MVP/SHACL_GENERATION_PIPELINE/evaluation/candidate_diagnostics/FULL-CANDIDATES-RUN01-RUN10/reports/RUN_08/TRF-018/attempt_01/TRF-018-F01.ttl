@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F01/ship> ;
            sh:resultMessage "maximumContinuousRatingPower must be at least the calculated required power and at least 2,800 kW for IA Super or 1,000 kW for IA, IB, and IC." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "maximumContinuousRatingPower must be at least the calculated required power and at least 2,800 kW for IA Super or 1,000 kW for IA, IB, and IC." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:calculatedRequiredPower ?calculatedQuantity ;
                      nltl:maximumContinuousRatingPower ?maximumQuantity .
                ?calculatedQuantity qudt:numericValue ?calculatedPower .
                ?maximumQuantity qudt:numericValue ?maximumPower .
                FILTER (
                    (?iceClass = nltl:iceClassIaSuper &&
                     (?maximumPower < ?calculatedPower || ?maximumPower < 2800)) ||
                    (?iceClass IN (nltl:iceClassIa, nltl:iceClassIb, nltl:iceClassIc) &&
                     (?maximumPower < ?calculatedPower || ?maximumPower < 1000))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF018Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F01/ship> ] .

