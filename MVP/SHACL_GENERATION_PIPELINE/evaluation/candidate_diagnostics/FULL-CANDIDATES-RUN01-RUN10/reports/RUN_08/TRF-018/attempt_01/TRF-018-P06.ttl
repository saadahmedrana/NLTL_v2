@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P06/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:hasValue nltl:iceClassIb ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:hasValue nltl:iceClassIc ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF018Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P06/ship> ] .

