@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-P04/ship> ;
            sh:resultMessage "A permitted ice class is required." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceClassValue ;
                    sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc ) ;
                    sh:message "A permitted ice class is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceClass ] ;
            sh:value nltl:iceClassIi ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-P04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:engineOutputCoefficientKe" ;
            sh:resultPath nltl:engineOutputCoefficientKe ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltlg:DimensionlessQuantityShape ;
                    sh:path nltl:engineOutputCoefficientKe ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-P04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:minimumRequiredPowerAtUpperIceWaterline" ;
            sh:resultPath nltl:minimumRequiredPowerAtUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltlg:PowerQuantityShape ;
                    sh:path nltl:minimumRequiredPowerAtUpperIceWaterline ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-P04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:brashIceChannelResistanceRch" ;
            sh:resultPath nltl:brashIceChannelResistanceRch ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltlg:ForceQuantityShape ;
                    sh:path nltl:brashIceChannelResistanceRch ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-P04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:brashIceChannelResistanceAtLowerIceWaterline" ;
            sh:resultPath nltl:brashIceChannelResistanceAtLowerIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltlg:UnspecifiedQuantityShape ;
                    sh:path nltl:brashIceChannelResistanceAtLowerIceWaterline ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-P04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:maximumContinuousRatingPower" ;
            sh:resultPath nltl:maximumContinuousRatingPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltlg:PowerQuantityShape ;
                    sh:path nltl:maximumContinuousRatingPower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-P04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:brashIceChannelResistanceAtUpperIceWaterline" ;
            sh:resultPath nltl:brashIceChannelResistanceAtUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltlg:UnspecifiedQuantityShape ;
                    sh:path nltl:brashIceChannelResistanceAtUpperIceWaterline ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-P04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:minimumRequiredPowerAtLowerIceWaterline" ;
            sh:resultPath nltl:minimumRequiredPowerAtLowerIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltlg:PowerQuantityShape ;
                    sh:path nltl:minimumRequiredPowerAtLowerIceWaterline ] ] .

