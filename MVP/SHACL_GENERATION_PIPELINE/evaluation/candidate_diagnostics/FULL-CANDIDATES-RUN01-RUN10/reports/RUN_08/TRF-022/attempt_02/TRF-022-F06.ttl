@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-022-F06/ship> ;
            sh:resultMessage "Coefficient C3 shall equal 845 kg/(m^2*s^2)." ;
            sh:resultPath nltl:coefficientC3 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Coefficient C3 shall equal 845 kg/(m^2*s^2)." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:maxInclusive 845.0 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 845.0 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:coefficientC3 ] ] .

