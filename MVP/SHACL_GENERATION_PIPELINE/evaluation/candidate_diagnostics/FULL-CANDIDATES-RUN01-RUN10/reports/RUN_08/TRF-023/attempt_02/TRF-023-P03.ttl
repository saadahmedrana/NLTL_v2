@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in <urn:nltl:generated-shape:TRF-023-Applicable1985Branch> , <urn:nltl:generated-shape:TRF-023-Non1985ClassBranch> , <urn:nltl:generated-shape:TRF-023-Non1985EditionBranch>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-023-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P03/ship> ] .

