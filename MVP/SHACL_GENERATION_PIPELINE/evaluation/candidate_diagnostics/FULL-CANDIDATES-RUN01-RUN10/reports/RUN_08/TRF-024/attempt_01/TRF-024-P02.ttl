@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-P02/ship> ;
            sh:resultMessage "For a ship retaining ice class IA or IA Super whose construction stage began before 1 September 2003, construction stage date, delivery date, and assessment date are required, and the section 3.2.2 deadline is 1 January in the year twenty years after delivery." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a ship retaining ice class IA or IA Super whose construction stage began before 1 September 2003, construction stage date, delivery date, and assessment date are required, and the section 3.2.2 deadline is 1 January in the year twenty years after delivery." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass = nltl:iceClassIa ||
                    ?iceClass = nltl:iceClassIaSuper
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:constructionStageDate ?stageDate .
                        FILTER (datatype(?stageDate) = xsd:date)
                    }
                    ||
                    EXISTS {
                        $this nltl:constructionStageDate ?stageDate .
                        FILTER (
                            datatype(?stageDate) = xsd:date &&
                            ?stageDate < "2003-09-01"^^xsd:date
                        )
                        FILTER (
                            NOT EXISTS {
                                $this nltl:deliveryDate ?deliveryDate .
                                FILTER (datatype(?deliveryDate) = xsd:date)
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:assessmentDate ?assessmentDate .
                                FILTER (datatype(?assessmentDate) = xsd:date)
                            }
                            ||
                            EXISTS {
                                $this nltl:deliveryDate ?deliveryDate .
                                $this nltl:assessmentDate ?assessmentDate .
                                FILTER (
                                    datatype(?deliveryDate) = xsd:date &&
                                    datatype(?assessmentDate) = xsd:date
                                )
                                FILTER (
                                    YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20
                                    ||
                                    (
                                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                                        (
                                            MONTH(?assessmentDate) > 1
                                            ||
                                            (
                                                MONTH(?assessmentDate) = 1 &&
                                                DAY(?assessmentDate) > 1
                                            )
                                        )
                                    )
                                )
                            }
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF024ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-P02/ship> ] .

