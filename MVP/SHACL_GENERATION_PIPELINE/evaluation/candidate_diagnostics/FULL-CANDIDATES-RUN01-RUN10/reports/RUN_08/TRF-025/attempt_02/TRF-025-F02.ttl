@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-025-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:bulbousBowPresent ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:bulbousBowPresent ], [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:CoefficientF1QuantityNodeShape ; sh:path nltl:coefficientF1 ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:CoefficientF2QuantityNodeShape ; sh:path nltl:coefficientF2 ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:CoefficientF3QuantityNodeShape ; sh:path nltl:coefficientF3 ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:CoefficientF4QuantityNodeShape ; sh:path nltl:coefficientF4 ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:CoefficientG1QuantityNodeShape ; sh:path nltl:coefficientG1 ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:CoefficientG2QuantityNodeShape ; sh:path nltl:coefficientG2 ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:CoefficientG3QuantityNodeShape ; sh:path nltl:coefficientG3 ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:ForceQuantityNodeShape ; sh:path nltl:brashIceResistanceCoefficientC1 ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:ForceQuantityNodeShape ; sh:path nltl:brashIceResistanceCoefficientC2 ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:LengthQuantityNodeShape ; sh:path nltl:iceClassDraught ; sh:property [ sh:minExclusive Literal(\"0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:LengthQuantityNodeShape ; sh:path nltl:shipBreadth ; sh:property [ sh:minExclusive Literal(\"0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:LengthQuantityNodeShape ; sh:path nltl:shipLength ; sh:property [ sh:minExclusive Literal(\"0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-025-F02/ship> ] .

