            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-027> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-P04/ship> ] .

