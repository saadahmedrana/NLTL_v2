coefficientF4 ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("825", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("825", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue nltl:kilogramPerSquareSecondUnit ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:coefficientC5 ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:iceClassDraught ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:shipBreadth ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:shipLength ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:clampedHullGeometryTerm ] ; sh:sparql [ sh:message Literal("clampedHullGeometryTerm must equal (((shipLength * iceClassDraught) / shipBreadth^2) clamped to [5,20])^3 within numerical tolerance.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:shipLength ?lengthValue ;
                              nltl:iceClassDraught ?draughtValue ;
                              nltl:shipBreadth ?breadthValue ;
                              nltl:clampedHullGeometryTerm ?resultValue .
                        ?lengthValue qudt:numericValue ?length .
                        ?draughtValue qudt:numericValue ?draught .
                        ?breadthValue qudt:numericValue ?breadth .
                        ?resultValue qudt:numericValue ?result .
                        BIND (((?length * ?draught) / (?breadth * ?breadth)) AS ?raw)
                        BIND (IF(?raw < 5, 5, IF(?raw > 20, 20, ?raw)) AS ?clamped)
                        BIND (?clamped * ?clamped * ?clamped AS ?expected)
                        BIND ((IF(?expected >= 0, ?expected, -?expected) * 0.000001) + 0.000000001 AS ?tolerance)
                        FILTER (?result < (?expected - ?tolerance) || ?result > (?expected + ?tolerance))
                    }
                ") ] ] , [ sh:or ( [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi ) ; sh:path nltl:iceClass ] ] [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("2003-09-01", datatype=xsd:date) ; sh:path nltl:constructionStageDate ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ; sh:path nltl:iceClass ] ] ) ]""" ;
