@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F04/ship> ;
            sh:resultMessage "The alternative Ke or RCH basis shall have an approved status that can be subject to revocation." ;
            sh:resultPath nltl:approvalRevocationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:evidenceStateApproved ;
                    sh:maxCount 1 ;
                    sh:message "The alternative Ke or RCH basis shall have an approved status that can be subject to revocation." ;
                    sh:minCount 1 ;
                    sh:path nltl:approvalRevocationStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F04/ship> ;
            sh:resultMessage "The ship shall provide evidence for an approved alternative calculation or model-test basis." ;
            sh:resultPath nltl:hasEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide evidence for an approved alternative calculation or model-test basis." ;
                    sh:minCount 1 ;
                    sh:node [ sh:or ( [ sh:class nltl:alternativeCalculationEvidence ] [ sh:class nltl:modelTestEvidence ] ) ] ;
                    sh:path nltl:hasEvidence ] ] .

