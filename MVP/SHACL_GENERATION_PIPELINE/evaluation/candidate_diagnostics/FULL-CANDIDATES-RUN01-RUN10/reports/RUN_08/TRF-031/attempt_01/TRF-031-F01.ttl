@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/ship> ;
            sh:resultMessage "yieldShearStress must equal yieldPoint divided by the square root of 3 within a relative tolerance of 1e-6, and combinedBendingShearStress must be lower than yieldPoint." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "yieldShearStress must equal yieldPoint divided by the square root of 3 within a relative tolerance of 1e-6, and combinedBendingShearStress must be lower than yieldPoint." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:yieldPoint/qudt:numericValue ?yieldPoint ;
                      nltl:combinedBendingShearStress/qudt:numericValue ?combinedStress ;
                      nltl:yieldShearStress/qudt:numericValue ?yieldShearStress .
                BIND((?yieldPoint / 1.7320508075688772) AS ?expectedShear)
                BIND((ABS(?expectedShear) * 0.000001) AS ?relativeTolerance)
                BIND(IF(?relativeTolerance > 0.000000001,
                        ?relativeTolerance,
                        0.000000001) AS ?tolerance)
                FILTER (
                    ABS(?yieldShearStress - ?expectedShear) > ?tolerance
                    || ?combinedStress >= ?yieldPoint
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_031_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/yieldPoint> ;
                    sh:resultMessage "Node ex:yieldPoint->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n05c7a95c7f0547e5af94c8fb82c31d24b2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:StressQuantityShape. See details for more information." ;
            sh:resultPath nltl:yieldPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:StressQuantityShape ;
                    sh:path nltl:yieldPoint ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/yieldPoint> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/yieldShear> ;
                    sh:resultMessage "Node ex:yieldShear->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n05c7a95c7f0547e5af94c8fb82c31d24b2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:StressQuantityShape. See details for more information." ;
            sh:resultPath nltl:yieldShearStress ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:StressQuantityShape ;
                    sh:path nltl:yieldShearStress ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/yieldShear> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/combinedStress> ;
                    sh:resultMessage "Node ex:combinedStress->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n05c7a95c7f0547e5af94c8fb82c31d24b2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:StressQuantityShape. See details for more information." ;
            sh:resultPath nltl:combinedBendingShearStress ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:StressQuantityShape ;
                    sh:path nltl:combinedBendingShearStress ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/combinedStress> ] .

_:n05c7a95c7f0547e5af94c8fb82c31d24b2 sh:hasValue qudt:MegaPA ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

