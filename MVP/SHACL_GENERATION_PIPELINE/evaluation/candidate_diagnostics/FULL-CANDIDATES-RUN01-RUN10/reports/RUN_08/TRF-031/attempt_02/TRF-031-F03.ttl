@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ;
            sh:resultMessage "Combined bending and shear stress must be lower than the yield point, and yield shear stress must equal yield point divided by sqrt(3) within a relative tolerance of 1e-6 with an absolute fallback of 1e-12 MPa." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Combined bending and shear stress must be lower than the yield point, and yield shear stress must equal yield point divided by sqrt(3) within a relative tolerance of 1e-6 with an absolute fallback of 1e-12 MPa." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldPointQ ;
                      nltl:combinedBendingShearStress ?combinedQ ;
                      nltl:yieldShearStress ?yieldShearQ .

                ?yieldPointQ qudt:numericValue ?yieldPoint ;
                             qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?combinedQ qudt:numericValue ?combined ;
                           qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?yieldShearQ qudt:numericValue ?yieldShear ;
                             qudt:unit <http://qudt.org/vocab/unit/MegaPA> .

                BIND((?yieldPoint / 1.7320508075688772) AS ?expectedYieldShear)
                FILTER(
                    ?combined >= ?yieldPoint ||
                    ABS(?yieldShear - ?expectedYieldShear) >
                    (ABS(?expectedYieldShear) * 0.000001 + 0.000000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_031_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ] .

