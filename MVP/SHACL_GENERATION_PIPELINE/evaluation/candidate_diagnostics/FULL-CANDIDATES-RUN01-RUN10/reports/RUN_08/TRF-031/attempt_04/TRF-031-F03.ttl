@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ;
            sh:resultMessage "yieldShearStress must equal yieldPoint divided by the square root of three within the permitted numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "yieldShearStress must equal yieldPoint divided by the square root of three within the permitted numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldNode ;
                      nltl:yieldShearStress ?shearNode .
                ?yieldNode qudt:numericValue ?yield .
                ?shearNode qudt:numericValue ?reported .
                BIND (?yield / 1.7320508075688772 AS ?expected)
                FILTER (
                    (?expected >= 0 &&
                        (
                            (?reported - ?expected) > ((?expected * 0.000001) + 0.000000001) ||
                            (?expected - ?reported) > ((?expected * 0.000001) + 0.000000001)
                        )
                    ) ||
                    (?expected < 0 &&
                        (
                            (?reported - ?expected) > (((0 - ?expected) * 0.000001) + 0.000000001) ||
                            (?expected - ?reported) > (((0 - ?expected) * 0.000001) + 0.000000001)
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF031Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ;
            sh:resultMessage "The acceptance comparison must identify the von Mises yield criterion." ;
            sh:resultPath nltl:vonMisesYieldCriterion ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:hasValue "von Mises" ;
                    sh:maxCount 1 ;
                    sh:message "The acceptance comparison must identify the von Mises yield criterion." ;
                    sh:minCount 1 ;
                    sh:path nltl:vonMisesYieldCriterion ] ] .

