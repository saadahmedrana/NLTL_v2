@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/ship> ;
            sh:resultMessage "When beam theory is used, allowableShearStress must not exceed 0.9 times yieldShearStress." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When beam theory is used, allowableShearStress must not exceed 0.9 times yieldShearStress." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:beamTheoryUsed true ;
                      nltl:allowableShearStress ?allowableNode ;
                      nltl:yieldPoint ?yieldNode .
                ?allowableNode qudt:numericValue ?allowable .
                ?yieldNode qudt:numericValue ?yield .
                BIND ((0.9 * ?yield) / 1.7320508075688772 AS ?limit)
                FILTER (?allowable > ?limit)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF031Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/ship> ;
            sh:resultMessage "The acceptance comparison must identify the von Mises yield criterion." ;
            sh:resultPath nltl:vonMisesYieldCriterion ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:hasValue "von Mises" ;
                    sh:maxCount 1 ;
                    sh:message "The acceptance comparison must identify the von Mises yield criterion." ;
                    sh:minCount 1 ;
                    sh:path nltl:vonMisesYieldCriterion ] ] .

