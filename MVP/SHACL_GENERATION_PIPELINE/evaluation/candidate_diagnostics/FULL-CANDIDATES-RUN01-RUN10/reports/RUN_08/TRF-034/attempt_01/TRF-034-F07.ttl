@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/member> ;
                    sh:resultMessage "Less than 1 values on ex:member->nltl:memberNormalToPlating" ;
                    sh:resultPath nltl:memberNormalToPlating ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:memberNormalToPlating ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/effectiveSection> ;
            sh:resultMessage "An effective member cross section must be linked from a hull structure with a declared member orientation." ;
            sh:resultPath [ sh:inversePath nltl:hasEffectiveMemberCrossSection ] ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "An effective member cross section must be linked from a hull structure with a declared member orientation." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:hullStructure ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:memberNormalToPlating ] ] ;
                    sh:path [ sh:inversePath nltl:hasEffectiveMemberCrossSection ] ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/member> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/shearArea> ;
                    sh:resultMessage "Node ex:shearArea->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/M2>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/M2> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/effectiveSection> ;
            sh:resultMessage "An effective member cross section must provide shear area in square metres." ;
            sh:resultPath nltl:shearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "An effective member cross section must provide shear area in square metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M2> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:shearArea ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/shearArea> ] .

