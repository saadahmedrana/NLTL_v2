@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ship> ;
            sh:resultMessage "The ship's rule length must be the classification society rule length used for the ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ship's rule length must be the classification society rule length used for the ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:ruleLength ?ruleQuantity .
                $this nltl:classificationSocietyRuleLength ?societyQuantity .
                ?ruleQuantity qudt:numericValue ?ruleValue ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .
                ?societyQuantity qudt:numericValue ?societyValue ;
                                 qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (?ruleValue != ?societyValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-035-ShipRuleLengthShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ship> ] .

