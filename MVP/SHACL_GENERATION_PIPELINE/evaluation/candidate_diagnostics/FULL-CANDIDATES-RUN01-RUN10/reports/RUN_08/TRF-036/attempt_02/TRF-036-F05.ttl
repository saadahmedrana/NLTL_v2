@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F05/designParameters> ;
            sh:resultMessage "Level ice thickness or design ice load height does not conform to the Table 4-1 values for the ice class." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Level ice thickness or design ice load height does not conform to the Table 4-1 values for the ice class." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?class ;
                      nltl:levelIceThickness ?thickness ;
                      nltl:designIceLoadHeight ?height .
                ?thickness qudt:numericValue ?thicknessValue .
                ?height qudt:numericValue ?heightValue .
                FILTER (
                    !(
                        (
                            ?class = nltl:iceClassIaSuper &&
                            ?thicknessValue <= "1.0"^^xsd:decimal &&
                            ?heightValue >= "0.35"^^xsd:decimal &&
                            ?heightValue <= "0.35"^^xsd:decimal
                        ) ||
                        (
                            ?class = nltl:iceClassIa &&
                            ?thicknessValue <= "0.8"^^xsd:decimal &&
                            ?heightValue >= "0.30"^^xsd:decimal &&
                            ?heightValue <= "0.30"^^xsd:decimal
                        ) ||
                        (
                            ?class = nltl:iceClassIb &&
                            ?thicknessValue <= "0.6"^^xsd:decimal &&
                            ?heightValue >= "0.25"^^xsd:decimal &&
                            ?heightValue <= "0.25"^^xsd:decimal
                        ) ||
                        (
                            ?class = nltl:iceClassIc &&
                            ?thicknessValue <= "0.4"^^xsd:decimal &&
                            ?heightValue >= "0.22"^^xsd:decimal &&
                            ?heightValue <= "0.22"^^xsd:decimal
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_036_IceClassDesignParameterSetShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F05/designParameters> ] .

