@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/designParameters> ;
            sh:resultMessage "Level ice thickness and design ice load height must satisfy the Table 4-1 values for the selected ice class." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Level ice thickness and design ice load height must satisfy the Table 4-1 values for the selected ice class." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?class ;
                      nltl:levelIceThickness ?levelQuantity ;
                      nltl:designIceLoadHeight ?heightQuantity .
                ?levelQuantity qudt:numericValue ?levelValue .
                ?heightQuantity qudt:numericValue ?heightValue .
                FILTER (
                    (
                        ?class = nltl:iceClassIaSuper &&
                        (?levelValue > 1.0 || ?heightValue < 0.35 || ?heightValue > 0.35)
                    ) ||
                    (
                        ?class = nltl:iceClassIa &&
                        (?levelValue > 0.8 || ?heightValue < 0.30 || ?heightValue > 0.30)
                    ) ||
                    (
                        ?class = nltl:iceClassIb &&
                        (?levelValue > 0.6 || ?heightValue < 0.25 || ?heightValue > 0.25)
                    ) ||
                    (
                        ?class = nltl:iceClassIc &&
                        (?levelValue > 0.4 || ?heightValue < 0.22 || ?heightValue > 0.22)
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-036-ParameterSetShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/designParameters> ] .

