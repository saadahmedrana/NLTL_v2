@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/designParameters> ;
            sh:resultMessage "Level ice thickness must not exceed the Table 4-1 value and design ice load height must equal its class-specific Table 4-1 value." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Level ice thickness must not exceed the Table 4-1 value and design ice load height must equal its class-specific Table 4-1 value." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?class ;
                      nltl:levelIceThickness ?thickness ;
                      nltl:designIceLoadHeight ?height .
                ?thickness qudt:numericValue ?thicknessValue .
                ?height qudt:numericValue ?heightValue .
                FILTER (
                    (
                        ?class = nltl:iceClassIaSuper &&
                        (
                            ?thicknessValue > 1.0 ||
                            ?heightValue < 0.35 ||
                            ?heightValue > 0.35
                        )
                    ) ||
                    (
                        ?class = nltl:iceClassIa &&
                        (
                            ?thicknessValue > 0.8 ||
                            ?heightValue < 0.30 ||
                            ?heightValue > 0.30
                        )
                    ) ||
                    (
                        ?class = nltl:iceClassIb &&
                        (
                            ?thicknessValue > 0.6 ||
                            ?heightValue < 0.25 ||
                            ?heightValue > 0.25
                        )
                    ) ||
                    (
                        ?class = nltl:iceClassIc &&
                        (
                            ?thicknessValue > 0.4 ||
                            ?heightValue < 0.22 ||
                            ?heightValue > 0.22
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF036IceClassDesignParameterSetShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/designParameters> ] .

