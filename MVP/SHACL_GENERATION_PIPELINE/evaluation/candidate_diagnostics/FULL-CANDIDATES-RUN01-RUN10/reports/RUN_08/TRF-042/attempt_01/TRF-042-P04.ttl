@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P04/plating> ;
            sh:resultMessage "corrosionAbrasionAddition must be 2 mm, or a lower value supported by an approved maintained special surface coating." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:TRF_042_PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P04/plating> ] .

