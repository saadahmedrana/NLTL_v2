@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "Node ex:plating must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF042_CorrosionAdditionNormalShape ; sh:path nltl:corrosionAbrasionAddition ] ] , [ sh:property [ sh:class nltl:evidenceState ; sh:hasValue nltl:evidenceStateApproved ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:materialApprovalStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:specialSurfaceCoatingMaintained ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF042_CorrosionAdditionLowerShape ; sh:path nltl:corrosionAbrasionAddition ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF042_PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "The longitudinal plating factor f2 must follow the applicable h/s formula and remain within the specified h/s range." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The longitudinal plating factor f2 must follow the applicable h/s formula and remain within the specified h/s range." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?hNode ;
                      nltl:spacing ?sNode ;
                      nltl:longitudinalPlatingFactorF2 ?fNode .
                ?hNode qudt:numericValue ?h .
                ?sNode qudt:numericValue ?s .
                ?fNode qudt:numericValue ?fnum .

                BIND (?h / ?s AS ?ratio)
                BIND (
                    IF(
                        ?ratio <= 1,
                        (0.4 / ?ratio) + 0.6,
                        1.4 - (0.4 * ?ratio)
                    )
                    AS ?expected
                )
                BIND (
                    IF(
                        ?expected < 0,
                        0 - ?expected,
                        ?expected
                    )
                    AS ?absExpected
                )
                BIND (
                    IF(
                        (0.000001 * ?absExpected) > 0.000000000001,
                        0.000001 * ?absExpected,
                        0.000000000001
                    )
                    AS ?tolerance
                )

                FILTER (
                    ?ratio <= 0
                    || ?ratio > 1.8
                    || ?fnum < (?expected - ?tolerance)
                    || ?fnum > (?expected + ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF042_PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "The corrosion and abrasion addition must normally be 2 mm, or be lower only with approved maintained special-surface-coating evidence." ;
            sh:resultPath nltl:corrosionAbrasionAddition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The corrosion and abrasion addition must normally be 2 mm, or be lower only with approved maintained special-surface-coating evidence." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF042_CorrosionAdditionAlternativeShape ;
                    sh:path nltl:corrosionAbrasionAddition ] ] .

