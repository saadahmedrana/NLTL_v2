@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P01/extensionBeyondAdjacentDeckOrTankBoundaryValue> ;
                            sh:resultMessage "Node ex:extensionBeyondAdjacentDeckOrTankBoundaryValue->qudt:unit does not contain a value in the set: ['qudt:MilliM']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:MilliM ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P01/terminationCase> ;
                    sh:resultMessage "Value does not conform to Shape gen:LengthMmShape. See details for more information." ;
                    sh:resultPath nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node gen:LengthMmShape ;
                            sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P01/extensionBeyondAdjacentDeckOrTankBoundaryValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:FramingIceStrengtheningTerminationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasFramingIceStrengtheningTerminationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:FramingIceStrengtheningTerminationCaseShape ;
                    sh:path nltl:hasFramingIceStrengtheningTerminationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P01/terminationCase> ] .

