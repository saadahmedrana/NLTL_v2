@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F04/terminationCase> ;
                    sh:resultMessage "Less than 1 values on ex:terminationCase->nltl:extensionBeyondAdjacentDeckOrTankBoundary" ;
                    sh:resultPath nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:TRF043ExtensionMillimetresShape> ;
                            sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF043TerminationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasFramingIceStrengtheningTerminationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:TRF043TerminationCaseShape> ;
                    sh:path nltl:hasFramingIceStrengtheningTerminationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F04/terminationCase> ] .

