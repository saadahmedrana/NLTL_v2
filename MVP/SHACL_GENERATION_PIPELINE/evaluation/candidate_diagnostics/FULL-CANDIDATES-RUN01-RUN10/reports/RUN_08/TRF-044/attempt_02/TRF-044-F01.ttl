@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ;
            sh:resultMessage "The boundary-condition m0 selection or one of mt, sectionModulus, or requiredShearArea does not conform to clause 4.4.2.1." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The boundary-condition m0 selection or one of mt, sectionModulus, or requiredShearArea does not conform to clause 4.4.2.1." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?icePressureNode ;
                      nltl:spacing ?spacingNode ;
                      nltl:designIceLoadHeight ?heightNode ;
                      nltl:span ?spanNode ;
                      nltl:frameBoundaryConditionType ?condition ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:yieldStrength ?yieldNode ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?icePressureNode qudt:numericValue ?p .
                ?spacingNode qudt:numericValue ?s .
                ?heightNode qudt:numericValue ?h .
                ?spanNode qudt:numericValue ?l .
                ?m0Node qudt:numericValue ?m0 .
                ?yieldNode qudt:numericValue ?sigma .
                ?mtNode qudt:numericValue ?mt .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND (7 * ?m0 / (7 - 5 * ?h / ?l) AS ?mtExpected)
                BIND (?p * ?s * ?h * ?l / (?mtExpected * ?sigma) * 1000000 AS ?zExpected)
                BIND (1.7320508075688772 * 1.2 * ?p * ?h * ?s / (2 * ?sigma) * 10000 AS ?aExpected)

                FILTER (
                    !(
                        (?condition = nltl:bulkCarrierTopWingTankFrameCondition && ?m0 = 7) ||
                        (?condition = nltl:singleDeckTankTopToMainDeckFrameCondition && ?m0 = 6) ||
                        (?condition = nltl:multiDeckOrStringerContinuousFrameCondition && ?m0 = 5.7) ||
                        (?condition = nltl:twoDeckFrameCondition && ?m0 = 5)
                    )
                    ||
                    ABS(?mt - ?mtExpected) > (1e-6 * ABS(?mtExpected) + 1e-9)
                    ||
                    ABS(?z - ?zExpected) > (1e-6 * ABS(?zExpected) + 1e-9)
                    ||
                    ABS(?a - ?aExpected) > (1e-6 * ABS(?aExpected) + 1e-9)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_044_StaticCalculationShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ] .

