@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ;
            sh:resultMessage "The frame boundary condition and calculated m0, mt, section modulus, and required shear area must satisfy TRF-044." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The frame boundary condition and calculated m0, mt, section modulus, and required shear area must satisfy TRF-044." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType ?condition ;
                      nltl:frameBoundaryConditionFactorM0/qudt:numericValue ?m0 ;
                      nltl:icePressure/qudt:numericValue ?p ;
                      nltl:spacing/qudt:numericValue ?s ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:span/qudt:numericValue ?l ;
                      nltl:yieldStrength/qudt:numericValue ?sigma ;
                      nltl:frameMomentFactorMt/qudt:numericValue ?mt ;
                      nltl:sectionModulus/qudt:numericValue ?z ;
                      nltl:requiredShearArea/qudt:numericValue ?a .
                BIND ((7 * ?m0) / (7 - (5 * ?h / ?l)) AS ?expectedMt)
                BIND ((?p * ?s * ?h * ?l / (?expectedMt * ?sigma)) * 1000000 AS ?expectedZ)
                BIND ((1.7320508075688772 * 1.2 * ?p * ?h * ?s / (2 * ?sigma)) * 10000 AS ?expectedA)
                FILTER (
                    !(
                        (?condition = nltl:bulkCarrierTopWingTankFrameCondition && ?m0 = 7) ||
                        (?condition = nltl:singleDeckTankTopToMainDeckFrameCondition && ?m0 = 6) ||
                        (?condition = nltl:multiDeckOrStringerContinuousFrameCondition && ?m0 = 5.7) ||
                        (?condition = nltl:twoDeckFrameCondition && ?m0 = 5)
                    ) ||
                    ABS(?mt - ?expectedMt) > (0.000001 * ABS(?expectedMt) + 0.000000001) ||
                    ABS(?z - ?expectedZ) > (0.000001 * ABS(?expectedZ) + 0.000000001) ||
                    ABS(?a - ?expectedA) > (0.000001 * ABS(?expectedA) + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-044> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ] .

