@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F04/frameSpanWithinIceStrengtheningZoneValue> ;
                    sh:resultMessage "Node ex:frameSpanWithinIceStrengtheningZoneValue->qudt:unit does not contain a value in the set: ['unit:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue unit:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F04/frame> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:frameSpanWithinIceStrengtheningZone ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:frameSpanWithinIceStrengtheningZone ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F04/frameSpanWithinIceStrengtheningZoneValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F04/frame> ;
            sh:resultMessage "Ordinary frame scantlings may be used only when less than 15% of the frame span is within the ice-strengthening zone, with both spans reported in metres." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ordinary frame scantlings may be used only when less than 15% of the frame span is within the ice-strengthening zone, with both spans reported in metres." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:ordinaryFrameScantlingsUsed ?ordinary .
                FILTER (?ordinary = true)
                FILTER NOT EXISTS {
                    $this nltl:frameSpanWithinIceStrengtheningZone ?withinNode .
                    ?withinNode qudt:numericValue ?withinValue ;
                                qudt:unit unit:M .
                    $this nltl:span ?spanNode .
                    ?spanNode qudt:numericValue ?spanValue ;
                              qudt:unit unit:M .
                    FILTER ((?withinValue / ?spanValue) < 0.15)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_045_FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F04/frame> ] .

