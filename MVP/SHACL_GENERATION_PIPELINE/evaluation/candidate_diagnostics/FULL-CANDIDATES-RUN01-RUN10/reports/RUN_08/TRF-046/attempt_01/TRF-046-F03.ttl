@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/adjacentMainFrame> ;
            sh:resultMessage "The frame shall identify an upper end with the required supporting-structure attachment." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ne31246a0d14e43f7bf00b0156b10626eb2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/adjacentMainFrame> ;
            sh:resultMessage "The frame shall identify its strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameStrengthenedPart ;
                    sh:message "The frame shall identify its strengthened part." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasStrengthenedPart ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/upperEnd> ;
                    sh:resultMessage "The upper end of the strengthened part shall be attached to a deck, tank boundary plating, or ice stringer." ;
                    sh:resultPath nltl:hasAttachedSupportingStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The upper end of the strengthened part shall be attached to a deck, tank boundary plating, or ice stringer." ;
                            sh:minCount 1 ;
                            sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:iceStringer ] ) ;
                            sh:path nltl:hasAttachedSupportingStructure ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/frame> ;
            sh:resultMessage "The frame shall identify an upper end with the required supporting-structure attachment." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:ne31246a0d14e43f7bf00b0156b10626eb2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/upperEnd> ] .

_:N0f6e3ae33de74327acbd1376d0cec1f4 rdf:first [ sh:class nltl:iceStringer ] ;
    rdf:rest () .

_:N375d47ae5c834b75ba4ba34cddae3cb7 rdf:first [ sh:class nltl:deckStructure ] ;
    rdf:rest ( [ sh:class nltl:tankBoundaryPlating ] _:N5b47e0257e5a4208b2459c4d19f0242a ) .

_:N57a6e68cedef43319629245d3e765996 sh:message "The upper end of the strengthened part shall be attached to a deck, tank boundary plating, or ice stringer." ;
    sh:minCount 1 ;
    sh:or _:N375d47ae5c834b75ba4ba34cddae3cb7 ;
    sh:path nltl:hasAttachedSupportingStructure .

_:Nfc55b4c9ea1c40ee8b9d2ab3d00df9c1 sh:property _:N57a6e68cedef43319629245d3e765996 .

_:ne31246a0d14e43f7bf00b0156b10626eb2 sh:message "The frame shall identify an upper end with the required supporting-structure attachment." ;
    sh:minCount 1 ;
    sh:node _:Nfc55b4c9ea1c40ee8b9d2ab3d00df9c1 ;
    sh:path nltl:hasUpperEnd .

