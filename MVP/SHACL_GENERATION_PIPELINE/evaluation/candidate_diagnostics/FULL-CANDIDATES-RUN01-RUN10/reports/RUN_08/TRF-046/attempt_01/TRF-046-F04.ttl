@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/upperEnd> ;
                    sh:resultMessage "The upper end of the strengthened part shall be attached to a deck, tank boundary plating, or ice stringer." ;
                    sh:resultPath nltl:hasAttachedSupportingStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The upper end of the strengthened part shall be attached to a deck, tank boundary plating, or ice stringer." ;
                            sh:minCount 1 ;
                            sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:iceStringer ] ) ;
                            sh:path nltl:hasAttachedSupportingStructure ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/frame> ;
            sh:resultMessage "The frame shall identify an upper end with the required supporting-structure attachment." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:ne31246a0d14e43f7bf00b0156b10626eb2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/upperEnd> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/adjacentMainFrame> ;
            sh:resultMessage "The frame shall identify its strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameStrengthenedPart ;
                    sh:message "The frame shall identify its strengthened part." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasStrengthenedPart ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/adjacentMainFrame> ;
            sh:resultMessage "The frame shall identify an upper end with the required supporting-structure attachment." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ne31246a0d14e43f7bf00b0156b10626eb2 ] .

_:N2db955aff8fc4d6eb98913be88402143 rdf:first [ sh:class nltl:tankBoundaryPlating ] ;
    rdf:rest ( [ sh:class nltl:iceStringer ] ) .

_:N3344a81fb2d9461aa261cad61935ed37 rdf:first [ sh:class nltl:deckStructure ] ;
    rdf:rest _:N2db955aff8fc4d6eb98913be88402143 .

_:Na0a68ed153274612bd4bf7fb0fe80379 sh:property [ sh:message "The upper end of the strengthened part shall be attached to a deck, tank boundary plating, or ice stringer." ;
            sh:minCount 1 ;
            sh:or _:N3344a81fb2d9461aa261cad61935ed37 ;
            sh:path nltl:hasAttachedSupportingStructure ] .

_:ne31246a0d14e43f7bf00b0156b10626eb2 sh:message "The frame shall identify an upper end with the required supporting-structure attachment." ;
