    sh:minCount 1 ;
    sh:or ( [ sh:class nltl:deckStructure ] _:N2552b0c5aa4545538a6b7e279f785127 _:N8adc6e34db7a41c290242c40ce4a750a ) ;
    sh:path nltl:hasAttachedSupportingStructure .

