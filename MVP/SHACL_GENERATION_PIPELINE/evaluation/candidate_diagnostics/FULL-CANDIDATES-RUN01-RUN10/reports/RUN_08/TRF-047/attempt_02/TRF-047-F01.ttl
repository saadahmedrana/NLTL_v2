@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F01/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:class nltl:mainFrame ; sh:property [ sh:class nltl:frameStrengthenedPart ; sh:message Literal(\"A main frame shall have a strengthened part.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrengthenedPart ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A main frame in scope shall be ice strengthened below the ice belt.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:mainFrameBelowIceBeltStrengthened ], [ sh:message Literal(\"The lower end of the strengthened main-frame part shall be attached to an allowed supporting structure.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF047AttachedLowerEndShape> ; sh:path nltl:hasLowerEnd ] ] , [ sh:class nltl:intermediateIceFrame ; sh:property [ sh:class nltl:frameStrengthenedPart ; sh:message Literal(\"An intermediate ice frame shall have a strengthened part.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrengthenedPart ], [ sh:message Literal(\"The lower end of the strengthened intermediate ice frame shall satisfy an allowed attachment or qualifying horizontal-member connection.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF047IntermediateLowerEndShape> ; sh:path nltl:hasLowerEnd ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF047Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F01/frame> ] .

