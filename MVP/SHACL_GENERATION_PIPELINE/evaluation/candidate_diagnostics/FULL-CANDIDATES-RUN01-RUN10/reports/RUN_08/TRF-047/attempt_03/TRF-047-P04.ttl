@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/frame> ;
            sh:resultMessage "Only strengthened main frames and intermediate ice frames are subject to this lower-end constraint." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF047Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/adjacentMainFrame> ;
            sh:resultMessage "Only strengthened main frames and intermediate ice frames are subject to this lower-end constraint." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF047Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/adjacentMainFrame> ] .

