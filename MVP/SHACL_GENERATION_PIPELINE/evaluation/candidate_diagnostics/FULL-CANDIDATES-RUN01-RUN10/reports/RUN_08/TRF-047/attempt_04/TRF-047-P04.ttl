@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/adjacentMainFrame> ;
            sh:resultMessage "The lower end of the strengthened part must be attached to a permitted deck, tank plating, tank top, or ice stringer." ;
            sh:resultPath ( nltl:hasStrengthenedPart nltl:hasLowerEnd nltl:hasAttachedSupportingStructure ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape gen:AttachedSupportPropertyShape ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/frame> ;
            sh:resultMessage "The lower end of an intermediate ice frame must use the ordinary attached-supporting-structure arrangement or the permitted exceptional horizontal-member arrangement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IntermediateIceFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/frame> ] .

