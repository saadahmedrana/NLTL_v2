@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F02/longitudinalFrame> ;
            sh:resultMessage "A longitudinal frame must specify one permitted frame boundary condition type." ;
            sh:resultPath nltl:frameBoundaryConditionType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype nltl:frameBoundaryConditionTypeValue ;
                    sh:in ( nltl:continuousBeamWithBracketsFrameCondition nltl:bulkCarrierTopWingTankFrameCondition nltl:multiDeckOrStringerContinuousFrameCondition nltl:singleDeckTankTopToMainDeckFrameCondition nltl:twoDeckFrameCondition ) ;
                    sh:maxCount 1 ;
                    sh:message "A longitudinal frame must specify one permitted frame boundary condition type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameBoundaryConditionType ] ;
            sh:value nltl:continuousBeamWithBracketsFrameCondition ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F02/longitudinalFrame> ;
            sh:resultMessage "The frame distribution factor, section modulus, and required shear area must match the declared formulas within a relative tolerance of 1e-6, with an absolute tolerance of 1e-12 near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The frame distribution factor, section modulus, and required shear area must match the declared formulas within a relative tolerance of 1e-6, with an absolute tolerance of 1e-12 near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:spacing/qudt:numericValue ?s ;
                      nltl:span/qudt:numericValue ?l ;
                      nltl:frameMomentFactorM/qudt:numericValue ?m ;
                      nltl:yieldStrength/qudt:numericValue ?sigma ;
                      nltl:longitudinalFrameLoadDistributionFactorF4/qudt:numericValue ?f4Reported ;
                      nltl:sectionModulus/qudt:numericValue ?zReported ;
                      nltl:requiredShearArea/qudt:numericValue ?aReported .

                BIND ((1 - (0.2 * ?h / ?s)) AS ?f4Expected)
                BIND (((?f4Expected * ?p * ?h * ?l * ?l) /
                       (4 * ?m * ?sigma) * 1000000) AS ?zExpected)
                BIND (((1.7320508075688772 * ?f4Expected * 2.16 * ?p * ?h * ?l) /
                       (2 * ?sigma) * 10000) AS ?aExpected)

                FILTER (
                    ABS(?f4Reported - ?f4Expected) >
                    IF(ABS(?f4Expected) > 0.000001,
                       0.000001 * ABS(?f4Expected),
                       0.000000000001)
                    ||
                    ABS(?zReported - ?zExpected) >
                    IF(ABS(?zExpected) > 0.000001,
                       0.000001 * ABS(?zExpected),
                       0.000000000001)
                    ||
                    ABS(?aReported - ?aExpected) >
                    IF(ABS(?aExpected) > 0.000001,
                       0.000001 * ABS(?aExpected),
                       0.000000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF048_LongitudinalFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F02/longitudinalFrame> ] .

