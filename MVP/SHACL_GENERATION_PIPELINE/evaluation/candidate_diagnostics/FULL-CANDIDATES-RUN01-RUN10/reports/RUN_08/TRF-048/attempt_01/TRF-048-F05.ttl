@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F05/longitudinalFrame> ;
            sh:resultMessage "A longitudinal frame must specify one permitted frame boundary condition type." ;
            sh:resultPath nltl:frameBoundaryConditionType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype nltl:frameBoundaryConditionTypeValue ;
                    sh:in ( nltl:continuousBeamWithBracketsFrameCondition nltl:bulkCarrierTopWingTankFrameCondition nltl:multiDeckOrStringerContinuousFrameCondition nltl:singleDeckTankTopToMainDeckFrameCondition nltl:twoDeckFrameCondition ) ;
                    sh:maxCount 1 ;
                    sh:message "A longitudinal frame must specify one permitted frame boundary condition type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameBoundaryConditionType ] ;
            sh:value nltl:continuousBeamWithBracketsFrameCondition ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F05/longitudinalFrame> ;
            sh:resultMessage "Less than 1 values on ex:longitudinalFrame->nltl:span" ;
            sh:resultPath nltl:span ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:span ] ] .

