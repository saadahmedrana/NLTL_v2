@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-P02/longitudinalFrame> ;
            sh:resultMessage "A longitudinal frame must specify one permitted frame boundary condition type." ;
            sh:resultPath nltl:frameBoundaryConditionType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype nltl:frameBoundaryConditionTypeValue ;
                    sh:in ( nltl:continuousBeamWithBracketsFrameCondition nltl:bulkCarrierTopWingTankFrameCondition nltl:multiDeckOrStringerContinuousFrameCondition nltl:singleDeckTankTopToMainDeckFrameCondition nltl:twoDeckFrameCondition ) ;
                    sh:maxCount 1 ;
                    sh:message "A longitudinal frame must specify one permitted frame boundary condition type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameBoundaryConditionType ] ;
            sh:value nltl:continuousBeamWithBracketsFrameCondition ] .

