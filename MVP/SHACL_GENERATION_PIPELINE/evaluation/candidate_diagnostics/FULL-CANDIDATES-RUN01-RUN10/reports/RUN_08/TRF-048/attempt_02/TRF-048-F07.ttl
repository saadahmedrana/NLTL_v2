@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/sectionModulusValue> ;
                    sh:resultMessage "Node ex:sectionModulusValue->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/CentiM2>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ;
            sh:resultMessage "Value does not conform to Shape gs:QuantityValueShape. See details for more information." ;
            sh:resultPath nltl:sectionModulus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gs:QuantityValueShape ;
                    sh:path nltl:sectionModulus ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/sectionModulusValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ;
            sh:resultMessage "Frame calculation results must satisfy the declared f4, section-modulus, effective shear-area, and bracket-exclusion formulas within a relative tolerance of 1e-6, with an absolute tolerance of 1e-9 near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Frame calculation results must satisfy the declared f4, section-modulus, effective shear-area, and bracket-exclusion formulas within a relative tolerance of 1e-6, with an absolute tolerance of 1e-9 near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:spacing ?sNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Node ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?requiredNode ;
                      nltl:grossFrameShearArea ?grossNode ;
                      nltl:bracketArea ?bracketNode ;
                      nltl:actualFrameShearArea ?actualNode .
                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?sNode qudt:numericValue ?s .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?sigmaNode qudt:numericValue ?sigma .
                ?f4Node qudt:numericValue ?f4Observed .
                ?zNode qudt:numericValue ?zObserved .
                ?requiredNode qudt:numericValue ?requiredObserved .
                ?grossNode qudt:numericValue ?gross .
                ?bracketNode qudt:numericValue ?bracket .
                ?actualNode qudt:numericValue ?actualObserved .
                BIND ((1 - (0.2 * ?h / ?s)) AS ?f4Expected)
                BIND ((?f4Expected * ?p * ?h * ?l * ?l / (4 * ?m * ?sigma) * 1000000) AS ?zExpected)
                BIND ((1.7320508075688772 * ?f4Expected * 2.16 * ?p * ?h * ?l / (2 * ?sigma) * 10000) AS ?aExpected)
                BIND ((?gross - ?bracket) AS ?actualExpected)
                BIND (IF(?f4Expected >= 0.001, 0.000001 * ?f4Expected, 0.000000001) AS ?f4Tolerance)
                BIND (IF(?zExpected >= 0.001, 0.000001 * ?zExpected, 0.000000001) AS ?zTolerance)
                BIND (IF(?aExpected >= 0.001, 0.000001 * ?aExpected, 0.000000001) AS ?aTolerance)
                BIND (IF(?actualExpected >= 0.001, 0.000001 * ?actualExpected, 0.000000001) AS ?actualTolerance)
                FILTER (
                    ?f4Observed < (?f4Expected - ?f4Tolerance) ||
                    ?f4Observed > (?f4Expected + ?f4Tolerance) ||
                    ?zObserved < (?zExpected - ?zTolerance) ||
                    ?zObserved > (?zExpected + ?zTolerance) ||
                    ?requiredObserved < (?aExpected - ?aTolerance) ||
                    ?requiredObserved > (?aExpected + ?aTolerance) ||
                    ?actualObserved < (?aExpected - ?aTolerance) ||
                    ?actualObserved > (?aExpected + ?aTolerance) ||
                    ?actualObserved < (?actualExpected - ?actualTolerance) ||
                    ?actualObserved > (?actualExpected + ?actualTolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:LongitudinalFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ] .

