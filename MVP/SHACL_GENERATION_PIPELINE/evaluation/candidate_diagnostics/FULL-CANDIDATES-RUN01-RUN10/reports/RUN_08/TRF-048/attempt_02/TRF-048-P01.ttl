@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-P01/longitudinalFrame> ;
            sh:resultMessage "Less than 1 values on ex:longitudinalFrame->nltl:bracketArea" ;
            sh:resultPath nltl:bracketArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gs:QuantityValueShape ;
                    sh:path nltl:bracketArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-P01/longitudinalFrame> ;
            sh:resultMessage "Less than 1 values on ex:longitudinalFrame->nltl:actualFrameShearArea" ;
            sh:resultPath nltl:actualFrameShearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gs:QuantityValueShape ;
                    sh:path nltl:actualFrameShearArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-P01/longitudinalFrame> ;
            sh:resultMessage "Less than 1 values on ex:longitudinalFrame->nltl:grossFrameShearArea" ;
            sh:resultPath nltl:grossFrameShearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gs:QuantityValueShape ;
                    sh:path nltl:grossFrameShearArea ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-P01/sectionModulusValue> ;
                    sh:resultMessage "Node ex:sectionModulusValue->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/CentiM2>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-P01/longitudinalFrame> ;
            sh:resultMessage "Value does not conform to Shape gs:QuantityValueShape. See details for more information." ;
            sh:resultPath nltl:sectionModulus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gs:QuantityValueShape ;
                    sh:path nltl:sectionModulus ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-P01/sectionModulusValue> ] .

