@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ;
            sh:resultMessage "The through-structure condition must be recorded." ;
            sh:resultPath nltl:passesThroughSupportingStructure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The through-structure condition must be recorded." ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:hasValue false ] [ sh:hasValue true ;
                                sh:property [ sh:datatype xsd:integer ;
                                        sh:maxCount 1 ;
                                        sh:message "A frame passing through a supporting structure must have both sides of its web plate connected." ;
                                        sh:minCount 1 ;
                                        sh:minInclusive 2 ;
                                        sh:path nltl:webPlateConnectionSideCount ] ] ) ;
                    sh:path nltl:passesThroughSupportingStructure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ;
            sh:resultMessage "The frame must have an effective attachment record." ;
            sh:resultPath nltl:hasFrameAttachment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The frame must have an effective attachment record." ;
                    sh:minCount 1 ;
                    sh:node nltl:TRF049_FrameAttachmentShape ;
                    sh:path nltl:hasFrameAttachment ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/webFrame> ;
                    sh:resultMessage "Each linked supporting structure must have an attachment record." ;
                    sh:resultPath nltl:hasSupportingStructureAttachment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n0d8a19a207fe46b49cfdbb0ed8c2627eb6 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ;
            sh:resultMessage "Value does not conform to Shape nltl:TRF049_SupportingStructureShape. See details for more information." ;
            sh:resultPath nltl:hasSupportingWebFrame ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltl:TRF049_SupportingStructureShape ;
                    sh:path nltl:hasSupportingWebFrame ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/webFrame> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/bulkhead> ;
                    sh:resultMessage "Each linked supporting structure must have an attachment record." ;
                    sh:resultPath nltl:hasSupportingStructureAttachment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n0d8a19a207fe46b49cfdbb0ed8c2627eb6 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ;
            sh:resultMessage "Value does not conform to Shape nltl:TRF049_SupportingStructureShape. See details for more information." ;
            sh:resultPath nltl:hasSupportingBulkhead ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltl:TRF049_SupportingStructureShape ;
                    sh:path nltl:hasSupportingBulkhead ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/bulkhead> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ;
            sh:resultMessage "A longitudinal frame must be attached by brackets." ;
            sh:resultPath nltl:hasFrameAttachment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A longitudinal frame must be attached by brackets." ;
                    sh:minCount 1 ;
                    sh:node nltl:TRF049_BracketAttachmentShape ;
                    sh:path nltl:hasFrameAttachment ] ] .

_:n0d8a19a207fe46b49cfdbb0ed8c2627eb6 sh:message "Each linked supporting structure must have an attachment record." ;
    sh:minCount 1 ;
    sh:node nltl:TRF049_FrameAttachmentShape ;
    sh:path nltl:hasSupportingStructureAttachment .

