@prefix ex: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P04/frame> ;
            sh:resultMessage "Each frame must provide one frame-web thickness in millimetres." ;
            sh:resultPath nltl:frameWebThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "Each frame must provide one frame-web thickness in millimetres." ;
                    sh:minCount 1 ;
                    sh:node ex:TRF049FrameWebThicknessShape ;
                    sh:path nltl:frameWebThickness ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P04/frameWebThicknessValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P04/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:node ex:TRF049IceStrengthenedFrameShape ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:withinIceStrengthenedArea ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:withinIceStrengthenedArea ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape ex:TRF049FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P04/frame> ] .

