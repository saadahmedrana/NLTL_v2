@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/webFrame> ;
                    sh:resultMessage "Each supplied supporting structure must identify its frame attachment." ;
                    sh:resultPath nltl:hasSupportingStructureAttachment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n9c7eeb117b304892a60e345291fed55eb15 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF049_SupportingStructureShape>. See details for more information." ;
            sh:resultPath nltl:hasSupportingWebFrame ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:supportingStructure ;
                    sh:node <urn:nltl:generated-shape:TRF049_SupportingStructureShape> ;
                    sh:path nltl:hasSupportingWebFrame ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/webFrame> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/bulkhead> ;
                    sh:resultMessage "Each supplied supporting structure must identify its frame attachment." ;
                    sh:resultPath nltl:hasSupportingStructureAttachment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n9c7eeb117b304892a60e345291fed55eb15 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF049_SupportingStructureShape>. See details for more information." ;
            sh:resultPath nltl:hasSupportingBulkhead ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:supportingStructure ;
                    sh:node <urn:nltl:generated-shape:TRF049_SupportingStructureShape> ;
                    sh:path nltl:hasSupportingBulkhead ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/bulkhead> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in ([ sh:node <urn:nltl:generated-shape:TRF049_IceAreaShape> ; sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ] ]) and ([ sh:node <urn:nltl:generated-shape:TRF049_LongitudinalShape> ] , [ sh:node <urn:nltl:generated-shape:TRF049_TransverseShape> ])" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF049_FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/frame> ;
            sh:resultMessage "The frame web thickness must be a single millimetre quantity." ;
            sh:resultPath nltl:frameWebThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The frame web thickness must be a single millimetre quantity." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF049_QuantityValueShape> ;
                    sh:path nltl:frameWebThickness ] ] .

_:n9c7eeb117b304892a60e345291fed55eb15 sh:class nltl:frameAttachment ;
    sh:message "Each supplied supporting structure must identify its frame attachment." ;
    sh:minCount 1 ;
    sh:path nltl:hasSupportingStructureAttachment .

