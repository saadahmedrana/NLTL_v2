@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qv: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-051-F06/frameWebThicknessValue> ;
                    sh:resultMessage "Value is not <= Literal(\"9\", datatype=xsd:integer)" ;
                    sh:resultPath qv:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MaxInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxInclusive 9 ;
                            sh:minCount 1 ;
                            sh:minInclusive 9 ;
                            sh:path qv:numericValue ] ;
                    sh:value 10.0 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-051-F06/hullStructure> ;
            sh:resultMessage "Frame web thickness is required and must be at least 9 mm." ;
            sh:resultPath nltl:frameWebThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Frame web thickness is required and must be at least 9 mm." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qv:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxInclusive 9 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 9 ;
                                    sh:path qv:numericValue ] ] ;
                    sh:path nltl:frameWebThickness ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-051-F06/frameWebThicknessValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-051-F06/hullStructure> ;
            sh:resultMessage "The in-lieu-of-frame applicability value is required." ;
            sh:resultPath nltl:inLieuOfFrame ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "The in-lieu-of-frame applicability value is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:inLieuOfFrame ] ] .

