@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F01/frame> ;
            sh:resultMessage "When the frame is asymmetrical or its web angle to the shell is below 90 degrees, antitripping support spacing must be present and must not exceed 1300 mm unless an equivalent arrangement is demonstrated." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the frame is asymmetrical or its web angle to the shell is below 90 degrees, antitripping support spacing must be present and must not exceed 1300 mm unless an equivalent arrangement is demonstrated." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameAsymmetrical ?asym .
                $this nltl:frameWebAngleToShell ?angleNode .
                ?angleNode qudt:numericValue ?angle .
                FILTER (?asym = true || ?angle < 90)
                FILTER NOT EXISTS {
                    $this nltl:equivalentSupportStatusByDirectCalculation true .
                }
                FILTER NOT EXISTS {
                    $this nltl:antitrippingSupportSpacing ?spacingNode .
                    ?spacingNode qudt:numericValue ?spacing .
                    ?spacingNode qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    FILTER (?spacing <= 1300)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-052-FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F01/frame> ] .

