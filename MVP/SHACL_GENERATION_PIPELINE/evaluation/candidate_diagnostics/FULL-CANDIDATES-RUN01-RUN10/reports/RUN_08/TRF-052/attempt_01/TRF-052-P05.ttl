@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P05/frame> ;
            sh:resultMessage "For a frame span of 4 m or less, IA frames require antitripping support in both the bow and midbody regions, and IB or IC frames require support in the bow region, unless an equivalent arrangement is demonstrated." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a frame span of 4 m or less, IA frames require antitripping support in both the bow and midbody regions, and IB or IC frames require support in the bow region, unless an equivalent arrangement is demonstrated." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameSpan ?spanNode .
                ?spanNode qudt:numericValue ?span .
                ?spanNode qudt:unit <http://qudt.org/vocab/unit/M> .
                $this nltl:iceClass ?ice .
                FILTER (?span <= 4)
                FILTER NOT EXISTS {
                    $this nltl:equivalentSupportStatusByDirectCalculation true .
                }
                FILTER (
                    (
                        ?ice = nltl:iceClassIa &&
                        (
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:bowRegion .
                            } ||
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion .
                            }
                        )
                    ) ||
                    (
                        (?ice = nltl:iceClassIb || ?ice = nltl:iceClassIc) &&
                        NOT EXISTS {
                            $this nltl:hasAntitrippingSupportRegion nltl:bowRegion .
                        }
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-052-FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P05/frame> ] .

