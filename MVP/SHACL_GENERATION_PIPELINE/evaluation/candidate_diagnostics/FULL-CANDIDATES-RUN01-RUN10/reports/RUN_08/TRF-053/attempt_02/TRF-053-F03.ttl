@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ;
            sh:resultMessage "Design line load, section modulus, and required shear area must satisfy the declared formulas within a relative tolerance of 1e-6, with an absolute tolerance of 1e-6 for expected values near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Design line load, section modulus, and required shear area must satisfy the declared formulas within a relative tolerance of 1e-6, with an absolute tolerance of 1e-6 for expected values near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:designIceLoadHeight ?heightNode ;
                      nltl:span ?spanNode ;
                      nltl:frameMomentFactorM ?momentNode ;
                      nltl:yieldStrength ?strengthNode ;
                      nltl:designLineLoad ?lineNode ;
                      nltl:sectionModulus ?modulusNode ;
                      nltl:requiredShearArea ?areaNode .

                ?pressureNode qudt:numericValue ?p .
                ?heightNode qudt:numericValue ?h .
                ?spanNode qudt:numericValue ?l .
                ?momentNode qudt:numericValue ?m .
                ?strengthNode qudt:numericValue ?sigma .
                ?lineNode qudt:numericValue ?lineReported .
                ?modulusNode qudt:numericValue ?zReported .
                ?areaNode qudt:numericValue ?aReported .

                BIND(IF((?p * ?h) < 0.15, 0.15, (?p * ?h)) AS ?lineExpected)
                BIND((0.9 * 1.8 * ?lineExpected * ?l * ?l / (?m * ?sigma) * 1000000) AS ?zExpected)
                BIND((1.7320508075688772 * 0.9 * 1.8 * 1.2 * ?lineExpected * ?l / (2 * ?sigma) * 10000) AS ?aExpected)

                FILTER(
                    (
                        (?lineExpected <= 0.001 &&
                         (?lineReported < (?lineExpected - 0.000001) ||
                          ?lineReported > (?lineExpected + 0.000001))) ||
                        (?lineExpected > 0.001 &&
                         (?lineReported < (?lineExpected * (1 - 0.000001)) ||
                          ?lineReported > (?lineExpected * (1 + 0.000001))))
                    ) ||
                    (
                        (?zExpected <= 0.001 &&
                         (?zReported < (?zExpected - 0.000001) ||
                          ?zReported > (?zExpected + 0.000001))) ||
                        (?zExpected > 0.001 &&
                         (?zReported < (?zExpected * (1 - 0.000001)) ||
                          ?zReported > (?zExpected * (1 + 0.000001))))
                    ) ||
                    (
                        (?aExpected <= 0.001 &&
                         (?aReported < (?aExpected - 0.000001) ||
                          ?aReported > (?aExpected + 0.000001))) ||
                        (?aExpected > 0.001 &&
                         (?aReported < (?aExpected * (1 - 0.000001)) ||
                          ?aReported > (?aExpected * (1 + 0.000001))))
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF053IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/sectionModulusValue> ;
                    sh:resultMessage "Section modulus must use cm^3 as its unit." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:CentiM3 ;
                            sh:maxCount 1 ;
                            sh:message "Section modulus must use cm^3 as its unit." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ;
            sh:resultMessage "The calculated section modulus is required." ;
            sh:resultPath nltl:sectionModulus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The calculated section modulus is required." ;
                    sh:minCount 1 ;
                    sh:node gen:SectionModulusQuantityShape ;
                    sh:path nltl:sectionModulus ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/sectionModulusValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/icePressureValue> ;
                    sh:resultMessage "Ice pressure must use MPa as its unit." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:MegaPA ;
                            sh:maxCount 1 ;
                            sh:message "Ice pressure must use MPa as its unit." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ;
            sh:resultMessage "Ice pressure is required for the ice-belt stringer calculation." ;
            sh:resultPath nltl:icePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Ice pressure is required for the ice-belt stringer calculation." ;
                    sh:minCount 1 ;
                    sh:node gen:IcePressureQuantityShape ;
                    sh:path nltl:icePressure ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/icePressureValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/requiredShearAreaValue> ;
                    sh:resultMessage "Required shear area must use cm^2 as its unit." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:CentiM2 ;
                            sh:maxCount 1 ;
                            sh:message "Required shear area must use cm^2 as its unit." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ;
            sh:resultMessage "The calculated required shear area is required." ;
            sh:resultPath nltl:requiredShearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The calculated required shear area is required." ;
                    sh:minCount 1 ;
                    sh:node gen:RequiredShearAreaQuantityShape ;
                    sh:path nltl:requiredShearArea ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/requiredShearAreaValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/designLineLoadValue> ;
                    sh:resultMessage "Design line load must use kN/m as its unit." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:KiloN-PER-M ;
                            sh:maxCount 1 ;
                            sh:message "Design line load must use kN/m as its unit." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ;
            sh:resultMessage "The calculated design line load is required." ;
            sh:resultPath nltl:designLineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The calculated design line load is required." ;
                    sh:minCount 1 ;
                    sh:node gen:DesignLineLoadQuantityShape ;
                    sh:path nltl:designLineLoad ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/designLineLoadValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/frameMomentFactorMValue> ;
                    sh:resultMessage "The frame moment factor must be unitless." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                            sh:maxCount 1 ;
                            sh:message "The frame moment factor must be unitless." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ;
            sh:resultMessage "The frame moment factor is required for the ice-belt stringer calculation." ;
            sh:resultPath nltl:frameMomentFactorM ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The frame moment factor is required for the ice-belt stringer calculation." ;
                    sh:minCount 1 ;
                    sh:node gen:FrameMomentFactorQuantityShape ;
                    sh:path nltl:frameMomentFactorM ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/frameMomentFactorMValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ;
            sh:resultMessage "The ice stringer must be explicitly recorded as located within the ice belt." ;
            sh:resultPath nltl:locatedWithinIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ncca9c771df10441b88216915bbc33f8fb10 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/yieldStrengthValue> ;
                    sh:resultMessage "Yield strength must use MPa as its unit." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:MegaPA ;
                            sh:maxCount 1 ;
                            sh:message "Yield strength must use MPa as its unit." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/iceStringer> ;
            sh:resultMessage "Yield strength is required for the ice-belt stringer calculation." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Yield strength is required for the ice-belt stringer calculation." ;
                    sh:minCount 1 ;
                    sh:node gen:YieldStrengthQuantityShape ;
                    sh:path nltl:yieldStrength ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/yieldStrengthValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F03/spanValue> ;
                    sh:resultMessage "Span must use metres as its unit." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M ;
