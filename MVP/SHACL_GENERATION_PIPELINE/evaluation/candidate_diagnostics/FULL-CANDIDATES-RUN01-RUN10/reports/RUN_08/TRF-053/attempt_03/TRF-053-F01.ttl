@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/requiredShearAreaValue> ;
                    sh:resultMessage "Node ex:requiredShearAreaValue->qudt:unit does not contain a value in the set: ['qudt:CentiM2']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:CentiM2 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/iceStringer> ;
            sh:resultMessage "The calculated required shear area is required in cm^2." ;
            sh:resultPath nltl:requiredShearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The calculated required shear area is required in cm^2." ;
                    sh:minCount 1 ;
                    sh:node gs:RequiredShearAreaQuantityShape ;
                    sh:path nltl:requiredShearArea ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/requiredShearAreaValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/iceStringer> ;
            sh:resultMessage "Design line load, section modulus, and required shear area must satisfy the declared ice-stringer formulas within a relative tolerance of 1e-6, with a 1e-15 absolute fallback." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Design line load, section modulus, and required shear area must satisfy the declared ice-stringer formulas within a relative tolerance of 1e-6, with a 1e-15 absolute fallback." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?yNode ;
                      nltl:designLineLoad ?lineNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?yNode qudt:numericValue ?y .
                ?lineNode qudt:numericValue ?line .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND(IF((?p * ?h) >= 0.15, (?p * ?h), 0.15) AS ?loadMNPerM)
                BIND(1000 * ?loadMNPerM AS ?expectedLine)
                BIND(0.9 * 1.8 * ?loadMNPerM * ?l * ?l / (?m * ?y) * 1000000 AS ?expectedZ)
                BIND(1.7320508075688772 * 0.9 * 1.8 * 1.2 * ?loadMNPerM * ?l / (2 * ?y) * 10000 AS ?expectedA)

                BIND(0.000001 * IF(?expectedLine >= 0, ?expectedLine, -?expectedLine) + 0.000000000000001 AS ?tolLine)
                BIND(0.000001 * IF(?expectedZ >= 0, ?expectedZ, -?expectedZ) + 0.000000000000001 AS ?tolZ)
                BIND(0.000001 * IF(?expectedA >= 0, ?expectedA, -?expectedA) + 0.000000000000001 AS ?tolA)

                FILTER(
                    (?line < (?expectedLine - ?tolLine)) ||
                    (?line > (?expectedLine + ?tolLine)) ||
                    (?z < (?expectedZ - ?tolZ)) ||
                    (?z > (?expectedZ + ?tolZ)) ||
                    (?a < (?expectedA - ?tolA)) ||
                    (?a > (?expectedA + ?tolA))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF053IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/iceStringer> ],
