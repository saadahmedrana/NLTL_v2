@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F04/iceStringer> ;
            sh:resultMessage "Node ex:iceStringer must conform to one or more shapes in <urn:nltl:generated-shape:TRF054Applicable> , <urn:nltl:generated-shape:TRF054OutsideIceBeltFalse> , <urn:nltl:generated-shape:TRF054DoesNotSupportFrames>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF054IceStringerShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F04/iceStringer> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F04/iceStringer> ;
            sh:resultMessage "Less than 1 values on ex:iceStringer->nltl:supportsIceStrengthenedFrames" ;
            sh:resultPath nltl:supportsIceStrengthenedFrames ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:supportsIceStrengthenedFrames ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F04/iceStringer> ;
            sh:resultMessage "Less than 1 values on ex:iceStringer->nltl:locatedOutsideIceBelt" ;
            sh:resultPath nltl:locatedOutsideIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:locatedOutsideIceBelt ] ] .

