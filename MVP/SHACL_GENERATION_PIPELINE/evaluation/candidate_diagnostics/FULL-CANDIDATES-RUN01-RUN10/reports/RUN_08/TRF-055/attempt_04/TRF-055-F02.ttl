@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudtv: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "Design line load must be supplied in kilonewtons per metre." ;
            sh:resultPath nltl:designLineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Design line load must be supplied in kilonewtons per metre." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudtv:KiloN-PER-M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designLineLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "Actual section modulus and actual shear area must each be at least their corresponding required value." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Actual section modulus and actual shear area must each be at least their corresponding required value." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:actualSectionModulus ?actualSectionNode .
    ?actualSectionNode qudt:numericValue ?actualSection .
    $this nltl:requiredSectionModulus ?requiredSectionNode .
    ?requiredSectionNode qudt:numericValue ?requiredSection .
    $this nltl:actualShearArea ?actualShearNode .
    ?actualShearNode qudt:numericValue ?actualShear .
    $this nltl:requiredShearArea ?requiredShearNode .
    ?requiredShearNode qudt:numericValue ?requiredShear .
    FILTER (?actualSection < ?requiredSection || ?actualShear < ?requiredShear)
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF055_NarrowDeckStripShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "A scantling approval status must be supplied." ;
            sh:resultPath nltl:scantlingApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceState ;
                    sh:maxCount 1 ;
                    sh:message "A scantling approval status must be supplied." ;
                    sh:minCount 1 ;
                    sh:path nltl:scantlingApprovalStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "Hatch opening length must be supplied in metres." ;
            sh:resultPath nltl:hatchOpeningLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Hatch opening length must be supplied in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudtv:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:hatchOpeningLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "Section modulus must be supplied in cubic centimetres." ;
            sh:resultPath nltl:sectionModulus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Section modulus must be supplied in cubic centimetres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudtv:CentiM3 ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:sectionModulus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "Ship breadth must be supplied in metres." ;
            sh:resultPath nltl:shipBreadth ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Ship breadth must be supplied in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudtv:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:shipBreadth ] ] .

