@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "webFrameIceLoad must equal 1.8 times the web-frame spacing and the greater of icePressure times iceLoadHeight or 0.15 MN/m, within numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "webFrameIceLoad must equal 1.8 times the web-frame spacing and the greater of icePressure times iceLoadHeight or 0.15 MN/m, within numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:iceLoadHeight ?heightNode ;
                      nltl:webFrameSpacing ?spacingNode ;
                      nltl:webFrameIceLoad ?loadNode .

                ?pressureNode qudt:numericValue ?pressure ;
                              qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?heightNode qudt:numericValue ?height ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                ?spacingNode qudt:numericValue ?spacing ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .
                ?loadNode qudt:numericValue ?actualLoad ;
                           qudt:unit <http://qudt.org/vocab/unit/KiloN> .

                BIND((?pressure * ?height) AS ?rawLineLoad)
                BIND(IF(?rawLineLoad < 0.15, 0.15, ?rawLineLoad) AS ?effectiveLineLoad)
                BIND((1.8 * ?effectiveLineLoad * ?spacing * 1000) AS ?expectedLoad)
                BIND(IF((ABS(?expectedLoad) * 0.000001) > 0.000001,
                        ABS(?expectedLoad) * 0.000001,
                        0.000001) AS ?tolerance)

                FILTER(ABS(?actualLoad - ?expectedLoad) > ?tolerance)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-057-WebFrameIceLoadShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ] .

