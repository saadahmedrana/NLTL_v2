@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-P01/webFrame> ;
            sh:resultMessage """Node ex:webFrame must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:supportedStringerOutsideIceBelt ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:ForceQuantityShape ; sh:path nltl:adjustedIceLoadForce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:ForceQuantityShape ; sh:path nltl:iceLoadForce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:stringerOutsideIceBeltHeight ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:LengthQuantityShape ; sh:path nltl:stringerSpan ] ; sh:sparql [ sh:message Literal("adjustedIceLoadForce must equal iceLoadForce multiplied by (1 - stringerOutsideIceBeltHeight / stringerSpan), within numerical tolerance") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:iceLoadForce ?forceNode ;
                              nltl:stringerOutsideIceBeltHeight ?heightNode ;
                              nltl:stringerSpan ?spanNode ;
                              nltl:adjustedIceLoadForce ?adjustedNode .

                        ?forceNode qudt:numericValue ?force ;
                                   qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        ?heightNode qudt:numericValue ?height ;
                                    qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?spanNode qudt:numericValue ?span ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?adjustedNode qudt:numericValue ?adjusted ;
                                     qudt:unit <http://qudt.org/vocab/unit/KiloN> .

                        BIND (?force * (1 - (?height / ?span)) AS ?expected)
                        BIND (ABS(?expected) * 0.000001 AS ?relativeTolerance)
                        BIND (
                            IF(
                                ?relativeTolerance > 0.000000001,
                                ?relativeTolerance,
                                0.000000001
                            )
                            AS ?tolerance
                        )

                        FILTER (ABS(?adjusted - ?expected) > ?tolerance)
                    }
                ") ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:supportedStringerOutsideIceBelt ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF058WebFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-P01/webFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-P01/webFrame> ;
            sh:resultMessage "Less than 1 values on ex:webFrame->nltl:supportedStringerOutsideIceBelt" ;
            sh:resultPath nltl:supportedStringerOutsideIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:supportedStringerOutsideIceBelt ] ] .

