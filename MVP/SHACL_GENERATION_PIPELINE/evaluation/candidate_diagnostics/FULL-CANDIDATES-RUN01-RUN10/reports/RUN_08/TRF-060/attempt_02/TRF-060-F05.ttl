@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode nltl:iacsUrI2Table8 ;
                            sh:resultMessage "Value nltl:iacsUrI2Table8 not in list ['nltl:traficomTable4Dash8']" ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:InConstraintComponent ;
                            sh:sourceShape [ sh:class nltl:tableReferenceValue ;
                                    sh:in ( nltl:traficomTable4Dash8 ) ] ;
                            sh:value nltl:iacsUrI2Table8 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F05/lookup> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:tableReferenceValue ; sh:in ( nltl:traficomTable4Dash8 ) ]. See details for more information." ;
                    sh:resultPath nltl:tableReference ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class nltl:tableReferenceValue ;
                                    sh:in ( nltl:traficomTable4Dash8 ) ] ;
                            sh:path nltl:tableReference ] ;
                    sh:value nltl:iacsUrI2Table8 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF060TableLookupCaseShape. See details for more information." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:TRF060TableLookupCaseShape ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F05/lookup> ] .

