@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-062-F01/ship> ;
            sh:resultMessage "The propeller blade tip to hull clearance must be no less than the specified minimum clearance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The propeller blade tip to hull clearance must be no less than the specified minimum clearance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:minimumClearance ?minimumNode .
                ?minimumNode qudt:numericValue ?minimum .
                $this nltl:propellerBladeTipHullClearance ?observedNode .
                ?observedNode qudt:numericValue ?observed .
                FILTER (datatype(?minimum) = xsd:decimal &&
                        datatype(?observed) = xsd:decimal)
                FILTER (?observed < ?minimum)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_062_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-062-F01/ship> ] .

