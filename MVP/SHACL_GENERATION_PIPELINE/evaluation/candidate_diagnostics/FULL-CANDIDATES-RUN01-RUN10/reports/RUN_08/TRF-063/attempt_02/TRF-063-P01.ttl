@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-P01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:sidePropellerStrengtheningEnvelope ; sh:message Literal(\"Each twin or triple screw ship shall provide a conforming side-propeller strengthening envelope.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF063EnvelopeShape ; sh:nodeKind sh:IRI ; sh:path nltl:hasSidePropellerStrengtheningEnvelope ], [ sh:in ( Literal(\"2\", datatype=xsd:integer) Literal(\"3\", datatype=xsd:integer) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propellerCount ] ] , [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:not [ sh:in ( Literal(\"2\", datatype=xsd:integer) Literal(\"3\", datatype=xsd:integer) ) ] ; sh:path nltl:propellerCount ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF063ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-P01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-P01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:propellerCount" ;
            sh:resultPath nltl:propellerCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerCount ] ] .

