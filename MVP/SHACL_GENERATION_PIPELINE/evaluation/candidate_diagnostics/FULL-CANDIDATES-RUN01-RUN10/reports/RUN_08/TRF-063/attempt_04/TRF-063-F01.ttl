@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F01/strengtheningForwardExtentValue> ;
                    sh:resultMessage "The extent value must be a decimal of at least 1.5." ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:message "The extent value must be a decimal of at least 1.5." ;
                            sh:minCount 1 ;
                            sh:minInclusive 1.5 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 1.49 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F01/envelope> ;
            sh:resultMessage "The forward strengthening extent must be at least 1.5 metres." ;
            sh:resultPath nltl:strengtheningForwardExtent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The forward strengthening extent must be at least 1.5 metres." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF063MetreExtentShape ;
                    sh:path nltl:strengtheningForwardExtent ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F01/strengtheningForwardExtentValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:TRF063TwinShipBranch , gen:TRF063TripleShipBranch , gen:TRF063NonApplicableLowPropellerCountBranch , gen:TRF063NonApplicableHighPropellerCountBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF063ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F01/ship> ] .

