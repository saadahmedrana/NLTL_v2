@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-P03/ship> ;
            sh:resultMessage "Each stern tube of a side propeller shall be enclosed within plated bossing." ;
            sh:resultPath nltl:hasSternTube ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Each stern tube of a side propeller shall be enclosed within plated bossing." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF064EnclosureShape ;
                    sh:path nltl:hasSternTube ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-P03/ship> ;
            sh:resultMessage "Each side propeller shafting assembly shall be enclosed within plated bossing." ;
            sh:resultPath nltl:hasSidePropellerShafting ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Each side propeller shafting assembly shall be enclosed within plated bossing." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF064EnclosureShape ;
                    sh:path nltl:hasSidePropellerShafting ] ] .

