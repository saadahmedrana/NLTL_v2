@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F05/detachedStrut> ;
                    sh:resultMessage "A detached strut must have hull-attachment evidence." ;
                    sh:resultPath nltl:hasStrutHullAttachmentEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:strutHullAttachmentEvidence ;
                            sh:message "A detached strut must have hull-attachment evidence." ;
                            sh:minCount 1 ;
                            sh:path nltl:hasStrutHullAttachmentEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:DetachedStrutShape. See details for more information." ;
            sh:resultPath nltl:hasDetachedStrut ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:detachedStrutStructure ;
                    sh:node gen:DetachedStrutShape ;
                    sh:path nltl:hasDetachedStrut ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F05/detachedStrut> ] .

