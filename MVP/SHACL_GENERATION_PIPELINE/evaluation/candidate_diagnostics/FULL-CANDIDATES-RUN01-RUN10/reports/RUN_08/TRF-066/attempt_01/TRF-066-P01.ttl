@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-P01/ship> ;
            sh:resultMessage "For ice classes IA and IA Super, iceKnifePracticable must be recorded and the rudder protection arrangement must use an ice knife extending below the LIWL when practicable, or an equivalent rudder protection means otherwise." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ice classes IA and IA Super, iceKnifePracticable must be recorded and the rudder protection arrangement must use an ice knife extending below the LIWL when practicable, or an equivalent rudder protection means otherwise." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass = nltl:iceClassIa ||
                    ?iceClass = nltl:iceClassIaSuper
                )

                {
                    FILTER NOT EXISTS {
                        $this nltl:iceKnifePracticable ?practicable .
                        FILTER (
                            ?practicable = true ||
                            ?practicable = false
                        )
                    }
                }
                UNION
                {
                    $this nltl:iceKnifePracticable ?practicable .
                    FILTER (
                        ?practicable = true ||
                        ?practicable = false
                    )
                    FILTER NOT EXISTS {
                        $this nltl:hasRudderProtectionArrangement ?arrangement .
                        {
                            ?arrangement rdf:type nltl:iceKnife .
                            ?arrangement nltl:extendsBelowLowerIceWaterline true .
                            FILTER (?practicable = true)
                        }
                        UNION
                        {
                            ?arrangement rdf:type nltl:equivalentRudderProtectionMeans .
                            FILTER (?practicable = false)
                        }
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF066ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-P01/ship> ] .

