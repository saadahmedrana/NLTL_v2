@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:rudderProtectionArrangement ; sh:message Literal(\"For ice class IA, a practicable ice knife extending below the lower ice waterline is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:IceKnifeArrangementShape ; sh:path nltl:hasRudderProtectionArrangement ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The lower ice waterline must be recorded for the applicable rudder-protection check.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lowerIceWaterline ], [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:class nltl:rudderProtectionArrangement ; sh:message Literal(\"When an ice knife is not practicable for ice class IA, an equivalent rudder protection means is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:EquivalentRudderProtectionShape ; sh:path nltl:hasRudderProtectionArrangement ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The lower ice waterline must be recorded for the applicable rudder-protection check.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lowerIceWaterline ], [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:class nltl:rudderProtectionArrangement ; sh:message Literal(\"For ice class IA Super, a practicable ice knife extending below the lower ice waterline is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:IceKnifeArrangementShape ; sh:path nltl:hasRudderProtectionArrangement ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The lower ice waterline must be recorded for the applicable rudder-protection check.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lowerIceWaterline ], [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:class nltl:rudderProtectionArrangement ; sh:message Literal(\"When an ice knife is not practicable for ice class IA Super, an equivalent rudder protection means is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:EquivalentRudderProtectionShape ; sh:path nltl:hasRudderProtectionArrangement ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The lower ice waterline must be recorded for the applicable rudder-protection check.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lowerIceWaterline ], [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:TRF066ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F04/ship> ] .

