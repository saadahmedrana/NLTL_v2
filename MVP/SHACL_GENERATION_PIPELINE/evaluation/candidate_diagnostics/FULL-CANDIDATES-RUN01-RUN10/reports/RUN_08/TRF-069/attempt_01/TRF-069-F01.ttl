@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( Literal("controllable") Literal("fixed") ) ; sh:path nltl:pitchType ], [ sh:in ( Literal("open") Literal("ducted") ) ; sh:path nltl:propellerType ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc ) ; sh:path nltl:iceClass ], [ sh:message Literal("An applicable design condition shall record the prescribed normal service-life load scope and each stated load-model exclusion.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:fixedPitchPropellerReversalLoadIncluded ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:normalOperationalConditions ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:normalServiceLifePropellerIceLoadCondition ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:radialIceEntryOutsideLoadModel ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stoppedPropellerDraggingOutsideLoadModel ] ] ; sh:path nltl:hasDesignCondition ] ] , [ sh:sparql [ sh:message Literal("If the ice-class, propeller-type, and pitch-type applicability conditions are not all met, the propulsion-machinery rule is non-applicable.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>

                    SELECT ?this
                    WHERE {
                        ?this nltl:iceClass ?iceClass ;
                              nltl:propellerType ?propellerType ;
                              nltl:pitchType ?pitchType .
                        FILTER (
                            !(
                                ?iceClass IN (
                                    nltl:iceClassIaSuper,
                                    nltl:iceClassIa,
                                    nltl:iceClassIb,
                                    nltl:iceClassIc
                                )
                            )
                            || !(?propellerType IN ("open", "ducted"))
                            || !(?pitchType IN ("controllable", "fixed"))
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF069Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-F01/ship> ] .

