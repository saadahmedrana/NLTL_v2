@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-P03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( Literal("controllable") Literal("fixed") ) ; sh:path nltl:pitchType ], [ sh:in ( Literal("open") Literal("ducted") ) ; sh:path nltl:propellerType ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc ) ; sh:path nltl:iceClass ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:designCondition ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:fixedPitchPropellerReversalLoadIncluded ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:normalOperationalConditions ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:normalServiceLifePropellerIceLoadCondition ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:radialIceEntryOutsideLoadModel ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:stoppedPropellerDraggingOutsideLoadModel ] ] ; sh:path nltl:hasDesignCondition ] ] , [ sh:sparql [ sh:message Literal("The propulsion-machinery applicability conditions must be represented by a permitted non-applicable value when the design-condition obligations are omitted.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?ice ;
                              nltl:propellerType ?propeller ;
                              nltl:pitchType ?pitch .
                        FILTER (
                            ?ice NOT IN (
                                nltl:iceClassIaSuper,
                                nltl:iceClassIa,
                                nltl:iceClassIb,
                                nltl:iceClassIc
                            )
                            ||
                            ?propeller NOT IN ( "open" , "ducted" )
                            ||
                            ?pitch NOT IN ( "controllable" , "fixed" )
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF_069_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-P03/ship> ] .

