@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F02/ship> ;
            sh:resultMessage "A local ice pressure with a valid pressure quantity is required." ;
            sh:resultPath nltl:localIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A local ice pressure with a valid pressure quantity is required." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF070PressureQuantityShape ;
                    sh:path nltl:localIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F02/ship> ;
            sh:resultMessage "A thruster-body/ice interaction load with a valid force quantity is required." ;
            sh:resultPath nltl:thrusterBodyIceInteractionLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A thruster-body/ice interaction load with a valid force quantity is required." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF070ForceQuantityShape ;
                    sh:path nltl:thrusterBodyIceInteractionLoad ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F02/designCondition> ;
                    sh:resultMessage "Each design condition shall provide an externally assessed local-strength capacity." ;
                    sh:resultPath nltl:designConditionLocalStrengthCapacity ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each design condition shall provide an externally assessed local-strength capacity." ;
                            sh:minCount 1 ;
                            sh:node gen:TRF070ForceQuantityShape ;
                            sh:path nltl:designConditionLocalStrengthCapacity ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F02/ship> ;
            sh:resultMessage "The ship shall provide a linked design condition." ;
            sh:resultPath nltl:hasDesignCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide a linked design condition." ;
                    sh:node [ sh:class nltl:designCondition ;
                            sh:property [ sh:message "Each design condition shall provide an externally assessed local-strength capacity." ;
                                    sh:minCount 1 ;
                                    sh:node gen:TRF070ForceQuantityShape ;
                                    sh:path nltl:designConditionLocalStrengthCapacity ] ] ;
                    sh:path nltl:hasDesignCondition ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F02/designCondition> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F02/ship> ;
            sh:resultMessage "A propeller/ice interaction load with a valid force quantity is required." ;
            sh:resultPath nltl:propellerIceInteractionLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A propeller/ice interaction load with a valid force quantity is required." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF070ForceQuantityShape ;
                    sh:path nltl:propellerIceInteractionLoad ] ] .

