@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "A thruster-body/ice interaction load with a valid force quantity is required." ;
            sh:resultPath nltl:thrusterBodyIceInteractionLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A thruster-body/ice interaction load with a valid force quantity is required." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF070ForceQuantityShape ;
                    sh:path nltl:thrusterBodyIceInteractionLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "A local ice pressure with a valid pressure quantity is required." ;
            sh:resultPath nltl:localIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A local ice pressure with a valid pressure quantity is required." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF070PressureQuantityShape ;
                    sh:path nltl:localIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "The thruster shall be identified as main propulsion." ;
            sh:resultPath nltl:mainPropulsionThruster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:message "The thruster shall be identified as main propulsion." ;
                    sh:minCount 1 ;
                    sh:path nltl:mainPropulsionThruster ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "A propeller/ice interaction load with a valid force quantity is required." ;
            sh:resultPath nltl:propellerIceInteractionLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A propeller/ice interaction load with a valid force quantity is required." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF070ForceQuantityShape ;
                    sh:path nltl:propellerIceInteractionLoad ] ] .

