@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:thrusterBodyIceInteractionLoad" ;
            sh:resultPath nltl:thrusterBodyIceInteractionLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:KiloNewtonQuantityShape ;
                    sh:path nltl:thrusterBodyIceInteractionLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:propellerIceInteractionLoad" ;
            sh:resultPath nltl:propellerIceInteractionLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:KiloNewtonQuantityShape ;
                    sh:path nltl:propellerIceInteractionLoad ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F02/designCondition> ;
                    sh:resultMessage "Node ex:designCondition->nltl:normalOperationalConditions does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
                    sh:resultPath nltl:normalOperationalConditions ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nb9f98ac53c0d4324a78eb94a7c12700fb5 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F02/designCondition> ;
                    sh:resultMessage "Less than 1 values on ex:designCondition->nltl:normalOperationalConditions" ;
                    sh:resultPath nltl:normalOperationalConditions ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nb9f98ac53c0d4324a78eb94a7c12700fb5 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F02/designCondition> ;
                    sh:resultMessage "Less than 1 values on ex:designCondition->nltl:designConditionExpectedLoad" ;
                    sh:resultPath nltl:designConditionExpectedLoad ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node gen:KiloNewtonQuantityShape ;
                            sh:path nltl:designConditionExpectedLoad ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:DesignConditionContextShape. See details for more information." ;
            sh:resultPath nltl:hasDesignCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:DesignConditionContextShape ;
                    sh:path nltl:hasDesignCondition ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F02/designCondition> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:ExtremeLoadConditionShape , gen:NonExtremeLoadConditionShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF070ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-F02/ship> ;
            sh:resultMessage "Value Literal(\"azimuthing\", datatype=xsd:string) not in list ['Literal(\"azimuthing\")', 'Literal(\"fixed\")']" ;
            sh:resultPath nltl:thrusterType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "azimuthing" "fixed" ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:thrusterType ] ;
            sh:value "azimuthing"^^xsd:string ] .

_:nb9f98ac53c0d4324a78eb94a7c12700fb5 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:normalOperationalConditions .

