@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:propellerIceInteractionLoad" ;
            sh:resultPath nltl:propellerIceInteractionLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:KiloNewtonQuantityShape ;
                    sh:path nltl:propellerIceInteractionLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:ExtremeLoadConditionShape , gen:NonExtremeLoadConditionShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF070ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:thrusterBodyIceInteractionLoad" ;
            sh:resultPath nltl:thrusterBodyIceInteractionLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:KiloNewtonQuantityShape ;
                    sh:path nltl:thrusterBodyIceInteractionLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasDesignCondition" ;
            sh:resultPath nltl:hasDesignCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:DesignConditionContextShape ;
                    sh:path nltl:hasDesignCondition ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "Node ex:ship->nltl:mainPropulsionThruster does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:mainPropulsionThruster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:mainPropulsionThruster ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "Value Literal(\"azimuthing\", datatype=xsd:string) not in list ['Literal(\"azimuthing\")', 'Literal(\"fixed\")']" ;
            sh:resultPath nltl:thrusterType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "azimuthing" "fixed" ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:thrusterType ] ;
            sh:value "azimuthing"^^xsd:string ] .

