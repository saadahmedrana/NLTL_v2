@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "A main-propulsion thruster type must be azimuthing or fixed." ;
            sh:resultPath nltl:thrusterType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "azimuthing" "fixed" ) ;
                    sh:maxCount 1 ;
                    sh:message "A main-propulsion thruster type must be azimuthing or fixed." ;
                    sh:minCount 1 ;
                    sh:path nltl:thrusterType ] ;
            sh:value "azimuthing"^^xsd:string ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "The ship must provide the extreme-load quantity in kN." ;
            sh:resultPath nltl:extremeLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the extreme-load quantity in kN." ;
                    sh:minCount 1 ;
                    sh:node nltlgen:KiloNewtonQuantityShape ;
                    sh:path nltl:extremeLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "The ship must provide the thruster-body/ice interaction load in kN." ;
            sh:resultPath nltl:thrusterBodyIceInteractionLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the thruster-body/ice interaction load in kN." ;
                    sh:minCount 1 ;
                    sh:node nltlgen:KiloNewtonQuantityShape ;
                    sh:path nltl:thrusterBodyIceInteractionLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:thrusterBodyLocalStrength ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Local ice pressure is required when the thruster body is designed for extreme loads.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:MegaPascalQuantityShape ; sh:path nltl:localIcePressure ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:LocalStrengthConditionShape ; sh:path nltl:hasDesignCondition ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:thrusterBodyLocalStrength ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:TRF070ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "The ship must provide its service-life quantity." ;
            sh:resultPath nltl:serviceLife ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide its service-life quantity." ;
                    sh:minCount 1 ;
                    sh:node nltlgen:ServiceLifeQuantityShape ;
                    sh:path nltl:serviceLife ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "The ship must link a design condition containing the normal-operational expected-load context." ;
            sh:resultPath nltl:hasDesignCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must link a design condition containing the normal-operational expected-load context." ;
                    sh:minCount 1 ;
                    sh:node nltlgen:DesignConditionShape ;
                    sh:path nltl:hasDesignCondition ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "The ship must provide the propeller/ice interaction load in kN." ;
            sh:resultPath nltl:propellerIceInteractionLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the propeller/ice interaction load in kN." ;
                    sh:minCount 1 ;
                    sh:node nltlgen:KiloNewtonQuantityShape ;
                    sh:path nltl:propellerIceInteractionLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-070-P03/ship> ;
            sh:resultMessage "The ship must identify the applicable thruster as main propulsion." ;
            sh:resultPath nltl:mainPropulsionThruster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The ship must identify the applicable thruster as main propulsion." ;
                    sh:minCount 1 ;
                    sh:path nltl:mainPropulsionThruster ] ] .

