@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:iceClassValue ; sh:in ( nltl:iceClassIa nltl:iceClassIaSuper nltl:iceClassIi nltl:iceClassIii ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:class nltl:iceClassValue ; sh:in ( nltl:iceClassIb nltl:iceClassIc ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:ballastConditionPropellerTopDepth ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:requiredPropellerSubmersionDepthHi ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("For ice class IB or IC, when the ballast-condition propeller top depth is below hi, the propulsion system must be designed for ice class IA.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER (
                            ?iceClass = nltl:iceClassIb ||
                            ?iceClass = nltl:iceClassIc
                        )
                        $this nltl:ballastConditionPropellerTopDepth ?depthNode .
                        ?depthNode qudt:numericValue ?depth ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                        $this nltl:requiredPropellerSubmersionDepthHi ?hiNode .
                        ?hiNode qudt:numericValue ?hi ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (?depth < ?hi)
                        FILTER NOT EXISTS {
                            $this nltl:propulsionSystemDesignedForIceClass
                                nltl:iceClassIa .
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF074ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-F01/ship> ] .

