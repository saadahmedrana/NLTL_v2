@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F03/ship> ;
            sh:resultMessage "CP and FP propellers must cover load cases 1 through 4; a reversing FP propeller must also cover load case 5." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "CP and FP propellers must cover load cases 1 through 4; a reversing FP propeller must also cover load case 5." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType ?pt .
                FILTER (
                    ?pt = "CP" ||
                    ?pt = "FP"
                )
                FILTER (
                    ?pt = "CP" ||
                    EXISTS {
                        $this nltl:propellerReversingCapability ?rev .
                        FILTER (
                            datatype(?rev) = xsd:boolean &&
                            (?rev = true || ?rev = false)
                        )
                    }
                )
                BIND(
                    EXISTS {
                        $this nltl:propellerReversingCapability ?rev2 .
                        FILTER(?rev2 = true)
                    }
                    AS ?hasTrueReversingCapability
                )
                $this nltl:hasPropellerBladeLoadCase ?case .
                ?case nltl:propellerBladeLoadCaseNumber ?number .
            }
            GROUP BY $this ?pt ?hasTrueReversingCapability
            HAVING (
                SUM(IF(?number = 1, 1, 0)) = 0 ||
                SUM(IF(?number = 2, 1, 0)) = 0 ||
                SUM(IF(?number = 3, 1, 0)) = 0 ||
                SUM(IF(?number = 4, 1, 0)) = 0 ||
                (
                    ?pt = "FP" &&
                    ?hasTrueReversingCapability = true &&
                    SUM(IF(?number = 5, 1, 0)) = 0
                )
            )
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_076_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F03/ship> ] .

