@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "A Table 6-7 lookup case with a propeller-location key and selected location factor is required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A Table 6-7 lookup case with a propeller-location key and selected location factor is required." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?case .
                ?case nltl:tableReference nltl:traficomTable6Dash7 .
                FILTER NOT EXISTS {
                    ?case nltl:tableLookupPropellerLocation ?location .
                    FILTER (isIRI(?location))
                }
                FILTER NOT EXISTS {
                    ?case nltl:selectedPropellerLocationFactor ?factor .
                    ?factor qudt:numericValue ?value ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    FILTER (datatype(?value) = xsd:decimal)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-078-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ] .

