@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ;
            sh:resultMessage "iceLoadCycleCount must equal k1 times k2 times k3 times N_class times n_n, using the required Table 6-6 and Table 6-7 lookup cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "iceLoadCycleCount must equal k1 times k2 times k3 times N_class times n_n, using the required Table 6-6 and Table 6-7 lookup cases." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?case6 ;
                       nltl:hasTableLookupCase ?case7 ;
                       nltl:iceLoadCycleCoefficientK2 ?k2Node ;
                       nltl:iceLoadCycleCoefficientK3 ?k3Node ;
                       nltl:propellerBladeLoadSpectrumCountFactor ?nnNode ;
                       nltl:iceLoadCycleCount ?nice .

                ?case6 a nltl:tableLookupCase ;
                       nltl:tableReference nltl:traficomTable6Dash6 ;
                       nltl:selectedIceClassCycleCount ?nclassNode .

                ?case7 a nltl:tableLookupCase ;
                       nltl:tableReference nltl:traficomTable6Dash7 ;
                       nltl:selectedPropellerLocationFactor ?k1Node .

                ?k1Node <http://qudt.org/schema/qudt/numericValue> ?k1 .
                ?k2Node <http://qudt.org/schema/qudt/numericValue> ?k2 .
                ?k3Node <http://qudt.org/schema/qudt/numericValue> ?k3 .
                ?nclassNode <http://qudt.org/schema/qudt/numericValue> ?nclass .
                ?nnNode <http://qudt.org/schema/qudt/numericValue> ?nn .

                BIND(
                    xsd:decimal(?k1) *
                    xsd:decimal(?k2) *
                    xsd:decimal(?k3) *
                    xsd:decimal(?nclass) *
                    xsd:decimal(?nn)
                    AS ?expected
                )

                FILTER(
                    ABS(xsd:decimal(?nice) - ?expected) >
                    (ABS(?expected) * 0.000001 + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF078ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ] .

