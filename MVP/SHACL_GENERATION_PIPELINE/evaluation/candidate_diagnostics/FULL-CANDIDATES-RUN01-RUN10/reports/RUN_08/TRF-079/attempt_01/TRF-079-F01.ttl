@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ;
            sh:resultMessage "The immersion function and submersion factor do not satisfy the specified formulae." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The immersion function and submersion factor do not satisfy the specified formulae." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?iceQuantity ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Quantity ;
                      nltl:propellerDiameter ?diameterQuantity ;
                      nltl:propellerImmersionFunction ?fQuantity ;
                      nltl:propellerShaftCentrelineDepth ?depthQuantity .

                ?iceQuantity qudt:numericValue ?hIce .
                ?k2Quantity qudt:numericValue ?k2 .
                ?diameterQuantity qudt:numericValue ?diameter .
                ?fQuantity qudt:numericValue ?f .
                ?depthQuantity qudt:numericValue ?h0 .

                BIND(
                    IF(
                        ?diameter = 0,
                        0.0,
                        ((?h0 - ?hIce) / (?diameter / 2.0)) - 1.0
                    ) AS ?fCalculated
                )

                BIND(
                    IF(
                        ?f < 0,
                        0.8 - ?f,
                        IF(
                            ?f <= 1,
                            0.8 - (0.4 * ?f),
                            IF(
                                ?f <= 2.5,
                                0.6 - (0.2 * ?f),
                                0.1
                            )
                        )
                    ) AS ?k2Calculated
                )

                FILTER(
                    ?diameter = 0
                    ||
                    ABS(?f - ?fCalculated) >
                        ((0.000001 * ABS(?fCalculated)) + 0.000000001)
                    ||
                    ABS(?k2 - ?k2Calculated) >
                        ((0.000001 * ABS(?k2Calculated)) + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF079StaticCalculationShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ] .

