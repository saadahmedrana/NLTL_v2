@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/effectiveIceLoadCycleCountValue> ;
                    sh:resultMessage "The effective ice load cycle count must use the unitless count unit." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                            sh:maxCount 1 ;
                            sh:message "The effective ice load cycle count must use the unitless count unit." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ;
            sh:resultMessage "Each ship must provide one effective ice load cycle count quantity." ;
            sh:resultPath nltl:effectiveIceLoadCycleCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ship must provide one effective ice load cycle count quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:message "The effective ice load cycle count must use the unitless count unit." ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:effectiveIceLoadCycleCount ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/effectiveIceLoadCycleCountValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ;
            sh:resultMessage "The effective ice load cycle count must equal the ice load cycle count multiplied by the propeller blade count, within a relative tolerance of 1e-6 plus an absolute fallback of 1e-7." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The effective ice load cycle count must equal the ice load cycle count multiplied by the propeller blade count, within a relative tolerance of 1e-6 plus an absolute fallback of 1e-7." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?ice ;
                      nltl:propellerBladeCount ?blades ;
                      nltl:effectiveIceLoadCycleCount ?resultNode .
                ?resultNode qudt:numericValue ?reported .
                BIND (xsd:decimal(?ice) * xsd:decimal(?blades) AS ?expected)
                FILTER (
                    ABS(?reported - ?expected) >
                    (ABS(?expected) * "0.000001"^^xsd:decimal +
                     "0.0000001"^^xsd:decimal)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-080> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ] .

