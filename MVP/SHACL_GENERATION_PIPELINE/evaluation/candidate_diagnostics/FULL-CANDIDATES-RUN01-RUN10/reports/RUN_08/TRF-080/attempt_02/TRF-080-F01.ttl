@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ;
            sh:resultMessage "The effective ice load cycle count must equal the ice load cycle count multiplied by the propeller blade count within a relative tolerance of 1e-6, with an absolute tolerance fallback of 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The effective ice load cycle count must equal the ice load cycle count multiplied by the propeller blade count within a relative tolerance of 1e-6, with an absolute tolerance fallback of 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?ice ;
                      nltl:propellerBladeCount ?blades ;
                      nltl:effectiveIceLoadCycleCount ?resultNode .
                ?resultNode qudt:numericValue ?reported .
                BIND((?ice * ?blades) AS ?expected)
                BIND(IF(?expected >= 0, ?expected, (0 - ?expected)) AS ?scale)
                FILTER(
                    (
                        ?reported < (?expected - 0.000001) &&
                        ?reported < (?expected - (?scale * 0.000001))
                    )
                    ||
                    (
                        ?reported > (?expected + 0.000001) &&
                        ?reported > (?expected + (?scale * 0.000001))
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_080_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/effectiveIceLoadCycleCountValue> ;
                    sh:resultMessage "Node ex:effectiveIceLoadCycleCountValue->qudt:unit does not contain a value in the set: ['qudt:UNITLESS']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ;
            sh:resultMessage "The effective ice load cycle count must be a single unitless decimal quantity." ;
            sh:resultPath nltl:effectiveIceLoadCycleCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The effective ice load cycle count must be a single unitless decimal quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:effectiveIceLoadCycleCount ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/effectiveIceLoadCycleCountValue> ] .

