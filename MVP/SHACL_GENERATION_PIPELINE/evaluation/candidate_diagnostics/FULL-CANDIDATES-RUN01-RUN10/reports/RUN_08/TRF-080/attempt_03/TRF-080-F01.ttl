@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ;
            sh:resultMessage "The effective ice load cycle count must equal iceLoadCycleCount multiplied by propellerBladeCount within an expected-result-scaled tolerance of 1e-6 plus an absolute fallback of 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The effective ice load cycle count must equal iceLoadCycleCount multiplied by propellerBladeCount within an expected-result-scaled tolerance of 1e-6 plus an absolute fallback of 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?nice ;
                      nltl:propellerBladeCount ?blades ;
                      nltl:effectiveIceLoadCycleCount ?resultNode .

                ?resultNode qudt:numericValue ?reported .

                BIND (xsd:decimal(?nice) * xsd:decimal(?blades) AS ?expected)

                FILTER (
                    (
                        ?expected >= 0 &&
                        (
                            ?reported < (?expected - ((?expected * 0.000001) + 0.000001)) ||
                            ?reported > (?expected + ((?expected * 0.000001) + 0.000001))
                        )
                    ) ||
                    (
                        ?expected < 0 &&
                        (
                            ?reported < (?expected - (((0 - ?expected) * 0.000001) + 0.000001)) ||
                            ?reported > (?expected + (((0 - ?expected) * 0.000001) + 0.000001))
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_080_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ] .

