@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-082-F01/ship> ;
            sh:resultMessage "When hydrodynamic bollard thrust is not known, it must be selected from TRAFICOM Table 6-8 with lookup application and selection evidence." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-082> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-082-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-082-F01/hydrodynamicBollardThrustValue> ;
                    sh:resultMessage "Node ex:hydrodynamicBollardThrustValue->qudt:unit does not contain a value in the set: ['qudt:KiloN']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:KiloN ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-082-F01/ship> ;
            sh:resultMessage "Hydrodynamic bollard thrust must be supplied as a single force quantity in kN." ;
            sh:resultPath nltl:hydrodynamicBollardThrust ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Hydrodynamic bollard thrust must be supplied as a single force quantity in kN." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:KiloN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:hydrodynamicBollardThrust ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-082-F01/hydrodynamicBollardThrustValue> ] .

