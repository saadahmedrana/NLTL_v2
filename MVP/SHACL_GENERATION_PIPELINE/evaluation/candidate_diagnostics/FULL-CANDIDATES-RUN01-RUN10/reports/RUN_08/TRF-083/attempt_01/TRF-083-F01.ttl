@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-083-F01/ship> ;
            sh:resultMessage "If bollard propeller speed is unknown, the attributed speed must be supported by a Table 6-9 lookup case." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-083-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-083-F01/ship> ] .

