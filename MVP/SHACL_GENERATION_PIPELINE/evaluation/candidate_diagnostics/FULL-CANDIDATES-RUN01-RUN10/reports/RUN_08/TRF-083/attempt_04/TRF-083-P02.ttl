@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-083-P02/ship> ;
            sh:resultMessage "Bollard propeller speed must be supplied in rev/min; when unknown, a Table 6-9 lookup case with its selected table reference and evidence is required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF083Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-083-P02/ship> ] .

