@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/ship> ;
            sh:resultMessage "The ship shall state whether the bollard propeller speed is known." ;
            sh:resultPath nltl:bollardPropellerSpeedKnown ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ship shall state whether the bollard propeller speed is known." ;
                    sh:minCount 1 ;
                    sh:path nltl:bollardPropellerSpeedKnown ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:bollardPropellerSpeedKnown ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A known bollard propeller speed at MCR shall be provided in revolutions per minute.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:TRF085SpeedQuantityShape ; sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:bollardPropellerSpeedKnown ], [ sh:message Literal(\"When the bollard propeller speed is not known, a Table 6-9 lookup case shall be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:TRF085TableLookupCaseShape ; sh:path nltl:hasTableLookupCase ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF085ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/ship> ] .

