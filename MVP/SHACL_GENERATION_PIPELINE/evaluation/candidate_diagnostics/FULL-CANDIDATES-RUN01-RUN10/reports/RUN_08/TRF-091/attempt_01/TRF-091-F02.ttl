@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/milling> ;
            sh:resultMessage "Less than 1 values on ex:milling->nltl:hasIceMillingSequenceCase" ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceMillingSequenceCase ;
                    sh:minCount 1 ;
                    sh:node gen:TRF091IceMillingSequenceCaseShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceMillingSequenceCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasPropulsionLoadCase" ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb985c4a49f714e6aaad54c6ef62c7434b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/ship> ;
            sh:resultMessage "The ice-milling load sequence case used for propulsion-line strength evaluation must be the applicable propulsion load case and must not be designated for stalling analysis." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ice-milling load sequence case used for propulsion-line strength evaluation must be the applicable propulsion load case and must not be designated for stalling analysis." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasIceMillingSequenceCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:hasPropulsionLoadCase ?case .
                    ?case nltl:loadCasePurpose nltl:propulsionLineStrengthEvaluationPurpose .
                    FILTER NOT EXISTS {
                        ?case nltl:loadCasePurpose nltl:stallingAnalysisPurposeValue .
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF091ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ;
                    sh:resultMessage "The propulsion load case shall have propulsion-line strength evaluation as its purpose and shall not have stalling analysis as its purpose." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nb985c4a49f714e6aaad54c6ef62c7434b4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ;
                    sh:resultMessage "The propulsion load case shall have propulsion-line strength evaluation as its purpose and shall not have stalling analysis as its purpose." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nb985c4a49f714e6aaad54c6ef62c7434b4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/milling> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF091PropulsionLoadCaseShape. See details for more information." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nb985c4a49f714e6aaad54c6ef62c7434b2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ] .

_:nb985c4a49f714e6aaad54c6ef62c7434b2 sh:class nltl:loadCase ;
    sh:minCount 1 ;
    sh:node gen:TRF091PropulsionLoadCaseShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasPropulsionLoadCase .

_:nb985c4a49f714e6aaad54c6ef62c7434b4 sh:class nltl:loadCasePurposeValue ;
    sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
    sh:maxCount 1 ;
    sh:message "The propulsion load case shall have propulsion-line strength evaluation as its purpose and shall not have stalling analysis as its purpose." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:loadCasePurpose .

