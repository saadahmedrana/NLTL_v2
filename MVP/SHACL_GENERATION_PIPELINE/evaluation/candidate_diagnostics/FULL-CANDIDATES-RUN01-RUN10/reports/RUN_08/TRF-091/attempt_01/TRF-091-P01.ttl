@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/ship> ;
            sh:resultMessage "The ice-milling load sequence case used for propulsion-line strength evaluation must be the applicable propulsion load case and must not be designated for stalling analysis." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ice-milling load sequence case used for propulsion-line strength evaluation must be the applicable propulsion load case and must not be designated for stalling analysis." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasIceMillingSequenceCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:hasPropulsionLoadCase ?case .
                    ?case nltl:loadCasePurpose nltl:propulsionLineStrengthEvaluationPurpose .
                    FILTER NOT EXISTS {
                        ?case nltl:loadCasePurpose nltl:stallingAnalysisPurposeValue .
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF091ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasPropulsionLoadCase" ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:loadCase ;
                    sh:minCount 1 ;
                    sh:node gen:TRF091PropulsionLoadCaseShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasPropulsionLoadCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/milling> ;
            sh:resultMessage "Less than 1 values on ex:milling->nltl:hasIceMillingSequenceCase" ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceMillingSequenceCase ;
                    sh:minCount 1 ;
                    sh:node gen:TRF091IceMillingSequenceCaseShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceMillingSequenceCase ] ] .

