@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:MaximumSpindleTorqueQuantity ; sh:path nltl:maximumSpindleTorque ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:approvalRecord ] ; sh:path nltl:approvedSpindleTorqueStressAnalysis ] ] , [ sh:property [ sh:datatype xsd:integer ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerBladeCount ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:BladeExpandedAreaRatioQuantity ; sh:path nltl:bladeExpandedAreaRatio ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:BladeFailureSpindleTorqueFactorQuantity ; sh:path nltl:bladeFailureSpindleTorqueFactor ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:BladeFailureSpindleTorqueQuantity ; sh:path nltl:bladeFailureSpindleTorque ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:ExtremeIceForceQuantity ; sh:path nltl:extremeIceForce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:LeadingEdgeChordPortionQuantity ; sh:path nltl:leadingEdgeChordPortionAtZeroPointEightRadius ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:MaximumSpindleTorqueQuantity ; sh:path nltl:maximumSpindleTorque ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:TrailingEdgeChordPortionQuantity ; sh:path nltl:trailingEdgeChordPortionAtZeroPointEightRadius ] ; sh:sparql [ sh:message Literal("The calculated spindle torque factor and spindle torque values must satisfy the prescribed formula within numerical tolerance.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:bladeExpandedAreaRatio ?earNode ;
                              nltl:propellerBladeCount ?z ;
                              nltl:leadingEdgeChordPortionAtZeroPointEightRadius ?leNode ;
                              nltl:trailingEdgeChordPortionAtZeroPointEightRadius ?teNode ;
                              nltl:extremeIceForce ?forceNode ;
                              nltl:bladeFailureSpindleTorqueFactor ?factorNode ;
                              nltl:bladeFailureSpindleTorque ?qsexNode ;
                              nltl:maximumSpindleTorque ?qmaxNode .

                        ?earNode qudt:numericValue ?ear .
                        ?leNode qudt:numericValue ?le .
                        ?teNode qudt:numericValue ?te .
                        ?forceNode qudt:numericValue ?force .
                        ?factorNode qudt:numericValue ?factor .
                        ?qsexNode qudt:numericValue ?qsex .
                        ?qmaxNode qudt:numericValue ?qmax .

                        BIND ((4 * ?ear) / ?z AS ?ratio)
                        BIND (0.7 * (1 - (?ratio * ?ratio * ?ratio)) AS ?rawFactor)
                        BIND (IF(?rawFactor < 0.3, 0.3, ?rawFactor) AS ?expectedFactor)
                        BIND (IF(?le > (0.8 * ?te), ?le, (0.8 * ?te)) AS ?expectedChord)
                        BIND (?expectedChord * ?expectedFactor * ?force AS ?expectedTorque)

                        BIND (IF(?expectedFactor < 0, 0 - ?expectedFactor, ?expectedFactor) AS ?factorAbs)
                        BIND (IF(?expectedTorque < 0, 0 - ?expectedTorque, ?expectedTorque) AS ?torqueAbs)
                        BIND (IF((0.000001 * ?factorAbs) > 0.000001,
                                 (0.000001 * ?factorAbs),
                                 0.000001) AS ?factorTolerance)
                        BIND (IF((0.000001 * ?torqueAbs) > 0.000001,
                                 (0.000001 * ?torqueAbs),
                                 0.000001) AS ?torqueTolerance)

                        FILTER (
                            ?factor < (?expectedFactor - ?factorTolerance) ||
                            ?factor > (?expectedFactor + ?factorTolerance) ||
                            ?qsex < (?expectedTorque - ?torqueTolerance) ||
                            ?qsex > (?expectedTorque + ?torqueTolerance) ||
                            ?qmax < (?expectedTorque - ?torqueTolerance) ||
                            ?qmax > (?expectedTorque + ?torqueTolerance)
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF102Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-F01/ship> ] .

