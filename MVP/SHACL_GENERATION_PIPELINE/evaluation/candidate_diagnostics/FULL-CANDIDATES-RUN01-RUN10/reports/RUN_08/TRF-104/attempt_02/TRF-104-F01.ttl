@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-F01/component0> ;
                    sh:resultMessage "Each linked propeller shaft line component must record no significant damage from propeller blade loss." ;
                    sh:resultPath nltl:significantDamageFromBladeLoss ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( false ) ;
                            sh:message "Each linked propeller shaft line component must record no significant damage from propeller blade loss." ;
                            sh:minCount 1 ;
                            sh:path nltl:significantDamageFromBladeLoss ] ;
                    sh:value true ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"false\" = False, datatype=xsd:boolean) ) ; sh:message Literal(\"Each linked propeller shaft line component must record no significant damage from propeller blade loss.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:significantDamageFromBladeLoss ] ]. See details for more information." ;
            sh:resultPath nltl:hasPropellerShaftLineComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:in ( false ) ;
                                    sh:message "Each linked propeller shaft line component must record no significant damage from propeller blade loss." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:significantDamageFromBladeLoss ] ] ;
                    sh:path nltl:hasPropellerShaftLineComponent ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-F01/component0> ] .

