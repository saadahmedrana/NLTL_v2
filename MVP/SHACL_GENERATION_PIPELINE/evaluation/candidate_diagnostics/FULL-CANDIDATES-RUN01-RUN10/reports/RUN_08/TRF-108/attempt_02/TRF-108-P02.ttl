@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-P02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal(\"Evidence shall demonstrate correspondence between the selected stress-life curve and the blade material properties.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ], [ sh:class nltl:stressLifeCurveTypeValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A stress-life curve type shall be selected when the curve is known.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelection ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The stress-life curve applicability state shall identify the curve as known.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveKnown ], [ sh:datatype xsd:string ; sh:message Literal(\"Blade material properties shall be represented for correspondence with the selected stress-life curve.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propellerBladeMaterialProperty ] ] , [ sh:property [ sh:class nltl:stressLifeCurveTypeValue ; sh:hasValue nltl:twoSlopeStressLifeCurve ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The two-slope SN curve shall be selected when the stress-life curve is unknown.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveSelection ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The stress-life curve applicability state shall identify the curve as unknown.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stressLifeCurveKnown ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-108> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-P02/ship> ] .

