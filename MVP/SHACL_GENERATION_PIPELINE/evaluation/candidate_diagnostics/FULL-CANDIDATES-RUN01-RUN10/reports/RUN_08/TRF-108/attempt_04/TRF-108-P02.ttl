@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-P02/ship> ;
            sh:resultMessage "Node ex:ship must conform to exactly one shape in gen:TRF108KnownCurveBranch , gen:TRF108UnknownCurveBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:XoneConstraintComponent ;
            sh:sourceShape gen:TRF108Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-P02/ship> ] .

