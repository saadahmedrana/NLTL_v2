@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-P01/lookup> ;
                    sh:resultMessage "Node ex:lookup must conform to one or more shapes in gen:TRF_109_OpenCaseShape , gen:TRF_109_DuctedCaseShape" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:or ( gen:TRF_109_OpenCaseShape gen:TRF_109_DuctedCaseShape ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-P01/lookup> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-P01/ship> ;
            sh:resultMessage "A table lookup case using the applicable open or ducted Table 6-14 row is required." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A table lookup case using the applicable open or ducted Table 6-14 row is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:or ( gen:TRF_109_OpenCaseShape gen:TRF_109_DuctedCaseShape ) ] ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-P01/lookup> ] .

