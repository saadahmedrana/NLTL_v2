@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F03/lookup> ;
                    sh:resultMessage "Node ex:lookup must conform to one or more shapes in <urn:nltl:generated-shape:TRF_109_OpenCaseShape> , <urn:nltl:generated-shape:TRF_109_DuctedCaseShape>" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:or ( <urn:nltl:generated-shape:TRF_109_OpenCaseShape> <urn:nltl:generated-shape:TRF_109_DuctedCaseShape> ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F03/lookup> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F03/ship> ;
            sh:resultMessage "Exactly one applicable Table 6-14 lookup case is required." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Exactly one applicable Table 6-14 lookup case is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:or ( <urn:nltl:generated-shape:TRF_109_OpenCaseShape> <urn:nltl:generated-shape:TRF_109_DuctedCaseShape> ) ] ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F03/lookup> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F03/ship> ;
            sh:resultMessage "Ice load cycle count must be between 5000000 and 100000000 inclusive." ;
            sh:resultPath nltl:iceLoadCycleCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:maxInclusive 100000000 ;
                    sh:message "Ice load cycle count must be between 5000000 and 100000000 inclusive." ;
                    sh:minCount 1 ;
                    sh:minInclusive 5000000 ;
                    sh:path nltl:iceLoadCycleCount ] ;
            sh:value 4999999 ] .

