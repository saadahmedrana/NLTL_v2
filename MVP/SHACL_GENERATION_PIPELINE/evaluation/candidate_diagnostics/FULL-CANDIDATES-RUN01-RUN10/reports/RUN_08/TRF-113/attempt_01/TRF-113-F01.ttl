@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The ship must provide a load case with maximum component load blade-orientation confirmation." ;
            sh:resultPath nltl:hasLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a load case with maximum component load blade-orientation confirmation." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:loadCase ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:message "A load case must record whether the maximum component load blade orientation has been confirmed." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ] ] ;
                    sh:path nltl:hasLoadCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The ship must provide evidence for the thruster blade-loss design." ;
            sh:resultPath nltl:thrusterBladeLossDesignEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide evidence for the thruster blade-loss design." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:evidenceArtifact ] ;
                    sh:path nltl:thrusterBladeLossDesignEvidence ] ] .

