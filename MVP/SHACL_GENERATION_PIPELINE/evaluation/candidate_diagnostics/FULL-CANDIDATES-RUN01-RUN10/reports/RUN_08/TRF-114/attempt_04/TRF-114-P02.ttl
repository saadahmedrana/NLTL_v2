@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/impact> ;
            sh:resultMessage "A non-hemispherical contact geometry requires an equivalent impact sphere radius on the owning ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A non-hemispherical contact geometry requires an equivalent impact sphere radius on the owning ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:contactGeometryClassification nltl:nonHemisphericalContactGeometry .
                ?ship nltl:hasThrusterIceImpactLoadCase $this .
                FILTER NOT EXISTS {
                    ?ship nltl:equivalentImpactSphereRadius ?radius .
                    ?radius a qudt:QuantityValue ;
                            qudt:numericValue ?value ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-114-LoadCaseShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/impact> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:iceOperatingSpeed" ;
            sh:resultPath nltl:iceOperatingSpeed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:iceOperatingSpeed ] ] .

