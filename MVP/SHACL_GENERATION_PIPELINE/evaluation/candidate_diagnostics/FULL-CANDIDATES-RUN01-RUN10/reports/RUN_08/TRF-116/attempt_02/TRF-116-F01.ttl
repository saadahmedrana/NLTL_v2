@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-116-F01/ship> ;
            sh:resultMessage "For each ship with a non-hemispherical impact case, the area, ice-thickness, impact-type input, and externally computed equivalent sphere radius must be provided with the declared units and datatypes." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-116-ComplexReadiness> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-116-F01/ship> ] .

