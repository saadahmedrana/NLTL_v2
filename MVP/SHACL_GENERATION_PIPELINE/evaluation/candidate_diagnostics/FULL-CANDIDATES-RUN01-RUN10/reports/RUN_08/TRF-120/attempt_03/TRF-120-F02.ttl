@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-120-F02/ship> ;
            sh:resultMessage "Each applicable thruster estimation must represent both longitudinal and transverse calculation cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each applicable thruster estimation must represent both longitudinal and transverse calculation cases." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasComponent ?tb .
                        ?tb a nltl:thrusterBody ;
                            nltl:hasNaturalFrequencyCalculationCase ?case .
                        ?case a nltl:calculationCase ;
                            nltl:vibrationDirection nltl:longitudinalDirection .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasComponent ?tb .
                        ?tb a nltl:thrusterBody ;
                            nltl:hasNaturalFrequencyCalculationCase ?case .
                        ?case a nltl:calculationCase ;
                            nltl:vibrationDirection nltl:transverseDirection .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF120_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-120-F02/ship> ] .

