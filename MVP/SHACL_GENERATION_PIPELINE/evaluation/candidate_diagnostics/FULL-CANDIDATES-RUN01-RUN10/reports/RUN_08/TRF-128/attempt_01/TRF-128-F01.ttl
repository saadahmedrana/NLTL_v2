@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:message Literal(\"For ice class IA Super with propulsion engine reversal required for astern, compressor charge time must not exceed 0.5 hour.\") ; sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:propulsionEngineReversalRequiredForAstern ], [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ], [ sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxInclusive Literal(\"0.5\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:compressorChargeTime ] ] , [ sh:message Literal(\"Except for the IA Super reversal case, compressor charge time must not exceed 1 hour.\") ; sh:property [ sh:in ( nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ], [ sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxInclusive Literal(\"1\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:compressorChargeTime ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_128_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F01/ship> ] .

