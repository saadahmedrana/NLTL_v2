@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F09/ship> ;
            sh:resultMessage "The ship must provide either a compliant standard cooling-water inlet chest or the permitted alternating-chest arrangement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF130Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F09/ship> ] .

