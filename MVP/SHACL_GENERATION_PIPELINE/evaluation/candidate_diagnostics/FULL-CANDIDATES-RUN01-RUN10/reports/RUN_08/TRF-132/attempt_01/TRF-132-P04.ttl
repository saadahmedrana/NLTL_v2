@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-P04/ship> ;
            sh:resultMessage "Maximum continuous rating power must be no less than f1*f2*f3*(f4*Delta + P0), within a relative tolerance of 1e-6 and an absolute fallback of 1e-9 kW." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Maximum continuous rating power must be no less than f1*f2*f3*(f4*Delta + P0), within a relative tolerance of 1e-6 and an absolute fallback of 1e-9 kW." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:engineOutputFormulaBasePowerP0 ?p0q ;
                      nltl:engineOutputFormulaDisplacement ?deltaq ;
                      nltl:engineOutputFormulaFactorF1 ?f1q ;
                      nltl:engineOutputFormulaFactorF2 ?f2q ;
                      nltl:engineOutputFormulaFactorF3 ?f3q ;
                      nltl:engineOutputFormulaFactorF4 ?f4q ;
                      nltl:maximumContinuousRatingPower ?mcrq .
                ?p0q qudt:numericValue ?p0 .
                ?deltaq qudt:numericValue ?delta .
                ?f1q qudt:numericValue ?f1 .
                ?f2q qudt:numericValue ?f2 .
                ?f3q qudt:numericValue ?f3 .
                ?f4q qudt:numericValue ?f4 .
                ?mcrq qudt:numericValue ?mcr .
                BIND (?f1 * ?f2 * ?f3 * ((?f4 * ?delta) + ?p0) AS ?expected)
                FILTER (?mcr + (ABS(?expected) * 0.000001) + 0.000000001 < ?expected)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape g:TRF_132_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-P04/ship> ] .

