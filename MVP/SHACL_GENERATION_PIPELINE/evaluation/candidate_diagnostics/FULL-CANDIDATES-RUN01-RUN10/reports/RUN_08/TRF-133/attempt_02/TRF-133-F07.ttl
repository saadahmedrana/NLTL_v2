@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F07/ship> ;
            sh:resultMessage "The ship must declare a permitted Finnish-Swedish ice class." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must declare a permitted Finnish-Swedish ice class." ;
                    sh:minCount 1 ;
                    sh:node [ sh:in ( nltl:iceClassIa nltl:iceClassIaSuper nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ] ;
                    sh:path nltl:iceClass ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F07/ship> ;
            sh:resultMessage "A linked hull structure must carry the required marking construction, colour, visibility, and thickness constraints." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A linked hull structure must carry the required marking construction, colour, visibility, and thickness constraints." ;
                    sh:path nltl:hasComponent ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape gen:TRF133HullStructureShape ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F07/verticalOffsetAboveSummerFreshWaterLoadLineValue> ;
                            sh:resultMessage "Value is not >= Literal(\"1000\", datatype=xsd:decimal)" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 1000.0 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 1000.0 ;
                                    sh:path qudt:numericValue ] ;
                            sh:value 900.0 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F07/triangle> ;
                    sh:resultMessage "The warning triangle upper edge must be 1000 mm above the summer fresh water load line." ;
                    sh:resultPath nltl:verticalOffsetAboveSummerFreshWaterLoadLine ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The warning triangle upper edge must be 1000 mm above the summer fresh water load line." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:maxInclusive 1000.0 ;
                                            sh:minCount 1 ;
                                            sh:minInclusive 1000.0 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue unit:MilliM ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:verticalOffsetAboveSummerFreshWaterLoadLine ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F07/verticalOffsetAboveSummerFreshWaterLoadLineValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F07/ship> ;
            sh:resultMessage "The ship must have a conforming warning triangle marking." ;
            sh:resultPath nltl:hasWarningTriangleMarking ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must have a conforming warning triangle marking." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF133WarningTriangleShape ;
                    sh:path nltl:hasWarningTriangleMarking ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F07/triangle> ] .

