@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The ship must specify its upper ice waterline." ;
            sh:resultPath nltl:upperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship must specify its upper ice waterline." ;
                    sh:minCount 1 ;
                    sh:path nltl:upperIceWaterline ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The upper ice waterline displacement must equal the greatest displacement among the linked upper ice waterline cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The upper ice waterline displacement must equal the greatest displacement among the linked upper ice waterline cases." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:upperIceWaterlineDisplacement ?shipDisplacement .
  ?shipDisplacement qudt:numericValue ?shipValue .
  FILTER (
    EXISTS {
      $this nltl:hasUpperIceWaterlineCase ?higherCase .
      ?higherCase nltl:waterlineCaseDisplacement ?higherDisplacement .
      ?higherDisplacement qudt:numericValue ?higherValue .
      FILTER (?higherValue > ?shipValue)
    }
    ||
    NOT EXISTS {
      $this nltl:hasUpperIceWaterlineCase ?equalCase .
      ?equalCase nltl:waterlineCaseDisplacement ?equalDisplacement .
      ?equalDisplacement qudt:numericValue ?equalValue .
      FILTER (?equalValue = ?shipValue)
    }
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-004-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

