@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The reported upper ice waterline displacement must equal the greatest linked waterline case displacement within the permitted tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The reported upper ice waterline displacement must equal the greatest linked waterline case displacement within the permitted tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?reportedQuantity .
                ?reportedQuantity qudt:numericValue ?reportedValue ;
                                   qudt:unit unit:KiloTON_Metric .

                $this nltl:hasUpperIceWaterlineCase ?case .
                ?case nltl:waterlineCaseDisplacement ?caseQuantity .
                ?caseQuantity qudt:numericValue ?expectedValue ;
                              qudt:unit unit:KiloTON_Metric .

                FILTER NOT EXISTS {
                    $this nltl:hasUpperIceWaterlineCase ?greaterCase .
                    ?greaterCase nltl:waterlineCaseDisplacement ?greaterQuantity .
                    ?greaterQuantity qudt:numericValue ?greaterValue ;
                                     qudt:unit unit:KiloTON_Metric .
                    FILTER ( ?greaterValue > ?expectedValue )
                }

                FILTER (
                    ?reportedValue < ?expectedValue -
                        (1e-6 * ABS(?expectedValue) + 1e-9)
                    ||
                    ?reportedValue > ?expectedValue +
                        (1e-6 * ABS(?expectedValue) + 1e-9)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-004-UpperIceWaterlineDisplacementShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

