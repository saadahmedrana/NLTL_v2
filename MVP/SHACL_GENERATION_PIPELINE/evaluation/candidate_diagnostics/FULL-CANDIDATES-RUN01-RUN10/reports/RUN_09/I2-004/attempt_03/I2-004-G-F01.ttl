@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The reported upper ice waterline displacement shall equal the greatest linked waterline case displacement within the permitted tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The reported upper ice waterline displacement shall equal the greatest linked waterline case displacement within the permitted tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?reportedQuantity .
                ?reportedQuantity qudt:numericValue ?reportedValue .
                ?reportedQuantity qudt:unit unit:KiloTON_Metric .

                $this nltl:hasUpperIceWaterlineCase ?case .
                ?case nltl:waterlineCaseDisplacement ?caseQuantity .
                ?caseQuantity qudt:numericValue ?caseValue .
                ?caseQuantity qudt:unit unit:KiloTON_Metric .

                FILTER NOT EXISTS {
                    $this nltl:hasUpperIceWaterlineCase ?greaterCase .
                    ?greaterCase nltl:waterlineCaseDisplacement ?greaterQuantity .
                    ?greaterQuantity qudt:numericValue ?greaterValue .
                    ?greaterQuantity qudt:unit unit:KiloTON_Metric .
                    FILTER (?greaterValue > ?caseValue)
                }

                BIND((?caseValue * 0.000001 + 0.000000001) AS ?tolerance)
                FILTER (
                    ?reportedValue < (?caseValue - ?tolerance) ||
                    ?reportedValue > (?caseValue + ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-004-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

