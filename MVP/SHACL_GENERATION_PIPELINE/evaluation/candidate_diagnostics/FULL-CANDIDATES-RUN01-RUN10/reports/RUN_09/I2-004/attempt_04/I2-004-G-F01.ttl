@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The upper ice waterline displacement must equal, within the permitted tolerance, the greatest linked waterline case displacement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The upper ice waterline displacement must equal, within the permitted tolerance, the greatest linked waterline case displacement." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?reportedQuantity .
                ?reportedQuantity qudt:numericValue ?reportedValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/KiloTON_Metric> .

                $this nltl:hasUpperIceWaterlineCase ?case .
                ?case nltl:waterlineCaseDisplacement ?caseQuantity .
                ?caseQuantity qudt:numericValue ?expectedValue ;
                              qudt:unit <http://qudt.org/vocab/unit/KiloTON_Metric> .

                FILTER NOT EXISTS {
                    $this nltl:hasUpperIceWaterlineCase ?higherCase .
                    ?higherCase nltl:waterlineCaseDisplacement ?higherQuantity .
                    ?higherQuantity qudt:numericValue ?higherValue ;
                                    qudt:unit <http://qudt.org/vocab/unit/KiloTON_Metric> .
                    FILTER ( ?higherValue > ?expectedValue )
                }

                BIND (
                    0.000001 * ?expectedValue + 0.000000001
                    AS ?tolerance
                )

                FILTER (
                    ?reportedValue < ?expectedValue - ?tolerance ||
                    ?reportedValue > ?expectedValue + ?tolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:I2_004_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The ship must identify the upper ice waterline." ;
            sh:resultPath nltl:upperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship must identify the upper ice waterline." ;
                    sh:minCount 1 ;
                    sh:path nltl:upperIceWaterline ] ] .

