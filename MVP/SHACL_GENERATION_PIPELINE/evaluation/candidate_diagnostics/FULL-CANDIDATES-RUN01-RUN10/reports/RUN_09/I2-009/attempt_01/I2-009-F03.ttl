@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ;
            sh:resultMessage "A hull area value must be recorded for the ship." ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "A hull area value must be recorded for the ship." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/assignment> ;
                    sh:resultMessage "The hull-area assignment must identify a permitted ice-strengthened hull area." ;
                    sh:resultPath nltl:assignedHullArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:bowIntermediateBottomHullArea nltl:midbodyBottomHullArea nltl:otherIceStrengthenedArea nltl:sternBottomHullArea ) ;
                            sh:maxCount 1 ;
                            sh:message "The hull-area assignment must identify a permitted ice-strengthened hull area." ;
                            sh:minCount 1 ;
                            sh:path nltl:assignedHullArea ] ;
                    sh:value nltl:bowRegion ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ;
            sh:resultMessage "The ship must provide a hull-area assignment for the applicable area." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a hull-area assignment for the applicable area." ;
                    sh:minCount 1 ;
                    sh:node nltlg:I2_009_HullAreaAssignmentShape ;
                    sh:path nltl:hasHullAreaAssignment ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/assignment> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ;
            sh:resultMessage "Bow-form applicability must be recorded as a single boolean value." ;
            sh:resultPath nltl:bowFormApplicability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Bow-form applicability must be recorded as a single boolean value." ;
                    sh:minCount 1 ;
                    sh:path nltl:bowFormApplicability ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ;
            sh:resultMessage "Buttock angle must be supplied as a single degree quantity." ;
            sh:resultPath nltl:buttockAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Buttock angle must be supplied as a single degree quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:buttockAngle ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F03/ship> ;
            sh:resultMessage "Normal frame angle must be supplied as a single degree quantity." ;
            sh:resultPath nltl:normalFrameAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Normal frame angle must be supplied as a single degree quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:normalFrameAngle ] ] .

