@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F02/ship> ;
            sh:resultMessage "For a PC6 or PC7 ship with a vertical-sided bow, the design-force method must be recorded and each represented normal frame angle must be a decimal from 0 to 10 degrees." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a PC6 or PC7 ship with a vertical-sided bow, the design-force method must be recorded and each represented normal frame angle must be a decimal from 0 to 10 degrees." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:polarClass ?pc .
    FILTER (?pc IN (nltl:polarClassPc6, nltl:polarClassPc7))

    FILTER (
        EXISTS {
            $this nltl:verticalSidedBowForm ?verticalForm .
            FILTER (?verticalForm = true)
        }
        ||
        EXISTS {
            $this nltl:bowVerticalSideStatus ?verticalStatus .
            FILTER (?verticalStatus = true)
        }
    )

    FILTER (
        NOT EXISTS {
            $this nltl:bowDesignForceMethod ?method .
            FILTER (datatype(?method) = xsd:string)
        }
        ||
        NOT EXISTS {
            $this nltl:normalFrameAngle ?angleQuantity .
            ?angleQuantity qudt:numericValue ?angleValue ;
                            qudt:unit unit:DEG .
            FILTER (
                datatype(?angleValue) = xsd:decimal &&
                ?angleValue >= 0 &&
                ?angleValue <= 10
            )
        }
        ||
        EXISTS {
            $this nltl:normalFrameAngle ?invalidQuantity .
            FILTER (
                NOT EXISTS {
                    ?invalidQuantity qudt:numericValue ?invalidValue ;
                                      qudt:unit unit:DEG .
                    FILTER (
                        datatype(?invalidValue) = xsd:decimal &&
                        ?invalidValue >= 0 &&
                        ?invalidValue <= 10
                    )
                }
            )
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-010> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F02/ship> ] .

