@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F02/beta> ;
                    sh:resultMessage "Each represented normal frame angle must have a decimal numeric value from 0 to 10 degrees inclusive." ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MaxInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:maxInclusive 10 ;
                            sh:message "Each represented normal frame angle must have a decimal numeric value from 0 to 10 degrees inclusive." ;
                            sh:minCount 1 ;
                            sh:minInclusive 0 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 11.0 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F02/ship> ;
            sh:resultMessage "Every represented normal frame angle must be a decimal QuantityValue in unit:DEG from 0 to 10 degrees inclusive." ;
            sh:resultPath nltl:normalFrameAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Every represented normal frame angle must be a decimal QuantityValue in unit:DEG from 0 to 10 degrees inclusive." ;
                    sh:node <urn:nltl:generated-shape:I2-010-AngleValue> ;
                    sh:path nltl:normalFrameAngle ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F02/beta> ] .

