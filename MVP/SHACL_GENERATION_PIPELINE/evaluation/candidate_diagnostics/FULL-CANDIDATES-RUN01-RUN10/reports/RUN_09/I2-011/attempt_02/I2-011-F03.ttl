@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F03/ship> ;
            sh:resultMessage "For an applicable PC6 or PC7 ship with a bulbous bow, the bow design force in kN must not be less than the I2.3.2.1(iii) force in MN converted to kN; the method-iii calculation uses fa = 0.6 and AR = 1.3." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an applicable PC6 or PC7 ship with a bulbous bow, the bow design force in kN must not be less than the I2.3.2.1(iii) force in MN converted to kN; the method-iii calculation uses fa = 0.6 and AR = 1.3." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:polarClass ?polarClass ;
                      nltl:bulbousBowPresent true ;
                      nltl:shapeCoefficient ?faQuantity ;
                      nltl:loadPatchAspectRatio ?arQuantity ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?methodIiiQuantity ;
                      nltl:bowDesignForce ?bowForceQuantity .

                FILTER (?polarClass IN (
                    nltl:polarClassPc6,
                    nltl:polarClassPc7
                ))

                ?faQuantity qudt:numericValue ?faValue .
                ?arQuantity qudt:numericValue ?arValue .
                ?methodIiiQuantity qudt:numericValue ?methodIiiValue .
                ?bowForceQuantity qudt:numericValue ?bowForceValue .

                FILTER (
                    ?faValue = 0.6 &&
                    ?arValue = 1.3 &&
                    ?bowForceValue < (?methodIiiValue * 1000)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-011> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F03/ship> ] .

