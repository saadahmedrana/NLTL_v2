@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F05/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:or ( [ sh:property [ sh:hasValue nltl:polarClassPc6 ; sh:path nltl:polarClass ] ] [ sh:property [ sh:hasValue nltl:polarClassPc7 ; sh:path nltl:polarClass ] ] ) ; sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:bulbousBowPresent ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("0.6", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("0.6", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:shapeCoefficient ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("1.3", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("1.3", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:loadPatchAspectRatio ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:bowDesignForce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ] ; sh:sparql [ sh:message Literal("For an applicable PC6 or PC7 ship with a bulbous bow, bowDesignForce must be determined by method (iv), within numerical tolerance, and must not be less than method (iii) with fa = 0.6 and AR = 1.3.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:bowDesignForce ?resultNode ;
                              nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivNode ;
                              nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiNode ;
                              nltl:shapeCoefficient ?faNode ;
                              nltl:loadPatchAspectRatio ?arNode .
                        ?resultNode qudt:numericValue ?result ;
                                    qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        ?ivNode qudt:numericValue ?iv ;
                                qudt:unit <http://qudt.org/vocab/unit/MegaN> .
                        ?iiiNode qudt:numericValue ?iii ;
                                 qudt:unit <http://qudt.org/vocab/unit/MegaN> .
                        ?faNode qudt:numericValue ?fa ;
                                qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        ?arNode qudt:numericValue ?ar ;
                                qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (
                            ?fa = "0.6"^^xsd:decimal &&
                            ?ar = "1.3"^^xsd:decimal &&
                            ?result >= (?iii * 1000) &&
                            ABS(?result - (?iv * 1000)) <=
                                IF(ABS(?iv * 1000) * 0.000001 > 0.000000001,
                                   ABS(?iv * 1000) * 0.000001,
                                   0.000000001)
                        )
                    }
                ") ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:bulbousBowPresent ] ] , [ sh:or ( [ sh:property [ sh:hasValue nltl:polarClassPc1 ; sh:path nltl:polarClass ] ] [ sh:property [ sh:hasValue nltl:polarClassPc2 ; sh:path nltl:polarClass ] ] [ sh:property [ sh:hasValue nltl:polarClassPc3 ; sh:path nltl:polarClass ] ] [ sh:property [ sh:hasValue nltl:polarClassPc4 ; sh:path nltl:polarClass ] ] [ sh:property [ sh:hasValue nltl:polarClassPc5 ; sh:path nltl:polarClass ] ] ) ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-011> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F05/ship> ] .

