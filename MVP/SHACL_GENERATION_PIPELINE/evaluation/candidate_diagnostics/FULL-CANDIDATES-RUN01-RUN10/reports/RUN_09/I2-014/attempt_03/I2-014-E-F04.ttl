@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowSubregionCount" ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:maxInclusive 4 ;
                    sh:minCount 1 ;
                    sh:minInclusive 4 ;
                    sh:path nltl:bowSubregionCount ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "Selected maximum bow force must match, within tolerance, the maximum calculated subregion force and must not be below any subregion force." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Selected maximum bow force must match, within tolerance, the maximum calculated subregion force and must not be below any subregion force." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selected ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?selected qudt:numericValue ?sv .
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?matchingCase .
                        ?matchingCase nltl:bowSubregionCalculatedForce ?matching .
                        ?matching qudt:numericValue ?cv .
                        FILTER (?sv >= (?cv - (?cv * 0.000001 + 0.000001)) &&
                                ?sv <= (?cv + (?cv * 0.000001 + 0.000001)))
                    } ||
                    EXISTS {
                        ?case nltl:bowSubregionCalculatedForce ?exceeding .
                        ?exceeding qudt:numericValue ?ev .
                        FILTER (?ev > (?sv + (?ev * 0.000001 + 0.000001)))
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_014_BowSubregionShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowLength" ;
            sh:resultPath nltl:bowLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:bowLength ] ] .

