@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F08/ship> ;
            sh:resultMessage "The ship must provide a bow subregion calculation case for the applicable bow-form calculation." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a bow subregion calculation case for the applicable bow-form calculation." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:bowSubregionCalculationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "The bow subregion case must provide its waterline angle in degrees." ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:bowSubregionWaterlineAngle ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each applicable bow subregion case must provide the externally calculated dimensionless bow shape coefficient." ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:bowShapeCoefficient ],
                                [ sh:maxCount 1 ;
                                    sh:message "The bow subregion case must provide its mid-length position in metres." ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:bowSubregionMidLengthPosition ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each bow subregion calculation case must identify the I2.3.1(v) bow-form applicability." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:bowFormApplicabilityValue ;
                                            sh:hasValue nltl:i231vBowFormApplicability ] ;
                                    sh:path nltl:bowFormApplicabilityClassification ],
                                [ sh:message "Each bow subregion calculation case must reference a failure-class factor lookup case." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:tableLookupCase ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:message "The lookup case must provide the dimensionless flexural failure class factor." ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:flexuralFailureClassFactor ],
                                                [ sh:maxCount 1 ;
                                                    sh:message "The lookup case must provide the dimensionless crushing failure class factor." ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:crushingFailureClassFactor ] ] ;
                                    sh:path nltl:hasFailureClassFactorLookupCase ] ] ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ] .

