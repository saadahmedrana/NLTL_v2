@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:hasBowSubregionCalculationCase ] ] , [ sh:property [ sh:message Literal(\"An applicable bow-form ship must provide beta i prime.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:QuantityUnitlessShape ; sh:path nltl:betaIPrime ], [ sh:message Literal(\"An applicable bow-form ship must provide the upper ice waterline draught.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:QuantityMShape ; sh:path nltl:upperIceWaterlineDraughtDUI ], [ sh:message Literal(\"An applicable bow-form ship must provide the upper ice waterline length.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:QuantityMShape ; sh:path nltl:upperIceWaterlineLengthLUI ], [ sh:message Literal(\"Each applicable bow-subregion calculation case must be complete.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:BowSubregionCalculationCaseShape ; sh:path nltl:hasBowSubregionCalculationCase ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_015_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/ship> ] .

