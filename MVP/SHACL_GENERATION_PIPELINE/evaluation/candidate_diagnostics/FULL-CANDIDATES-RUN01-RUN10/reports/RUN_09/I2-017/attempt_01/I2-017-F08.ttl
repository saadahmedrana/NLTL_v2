@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-017-F08/ship> ;
            sh:resultMessage "The ship must provide the table lookup case containing the required class factors." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the table lookup case containing the required class factors." ;
                    sh:minCount 1 ;
                    sh:node nltlg:I2_017_TableLookupCaseShape ;
                    sh:path nltl:hasTableLookupCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-017-F08/ship> ;
            sh:resultMessage "The ship must provide a non-bow ice load calculation case with externally determined calculation results." ;
            sh:resultPath nltl:hasNonBowIceLoadCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide a non-bow ice load calculation case with externally determined calculation results." ;
                    sh:minCount 1 ;
                    sh:node nltlg:I2_017_NonBowCalculationCaseShape ;
                    sh:path nltl:hasNonBowIceLoadCalculationCase ] ] .

