@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F06/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:averageIcePressure" ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:MegaPA ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F06/lookup> ;
                    sh:resultMessage "Node ex:lookup->nltl:tableReference does not contain a value in the set: ['nltl:iacsUrI2Table3']" ;
                    sh:resultPath nltl:tableReference ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue nltl:iacsUrI2Table3 ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:tableReference ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F06/lookup> ;
                    sh:resultMessage "Value nltl:bottomStructureFrameCategory not in list ['nltl:transverseFrameWithLoadDistributingStringersCategory', 'nltl:stringerSideLongitudinalOrWebFrameCategory', 'nltl:longitudinallyFramedPlatingCategory', 'nltl:transverselyFramedPlatingCategory', 'nltl:transverseFrameWithoutLoadDistributingStringersCategory']" ;
                    sh:resultPath nltl:localizedStructuralMemberCategory ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:longitudinallyFramedPlatingCategory nltl:stringerSideLongitudinalOrWebFrameCategory nltl:transverseFrameWithLoadDistributingStringersCategory nltl:transverseFrameWithoutLoadDistributingStringersCategory nltl:transverselyFramedPlatingCategory ) ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:localizedStructuralMemberCategory ] ;
                    sh:value nltl:bottomStructureFrameCategory ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:class nltl:evidenceArtifact ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lookupSelectionEvidence ], [ sh:hasValue nltl:iacsUrI2Table3 ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:tableReference ], [ sh:in ( nltl:longitudinallyFramedPlatingCategory nltl:stringerSideLongitudinalOrWebFrameCategory nltl:transverseFrameWithLoadDistributingStringersCategory nltl:transverseFrameWithoutLoadDistributingStringersCategory nltl:transverselyFramedPlatingCategory ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:localizedStructuralMemberCategory ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:selectedPeakPressureFactor ] ]. See details for more information." ;
            sh:resultPath nltl:hasPeakPressureFactorLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:peakPressureFactorLookupCase ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:in ( nltl:longitudinallyFramedPlatingCategory nltl:stringerSideLongitudinalOrWebFrameCategory nltl:transverseFrameWithLoadDistributingStringersCategory nltl:transverseFrameWithoutLoadDistributingStringersCategory nltl:transverselyFramedPlatingCategory ) ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:localizedStructuralMemberCategory ],
                                [ sh:hasValue nltl:iacsUrI2Table3 ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:tableReference ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:selectedPeakPressureFactor ],
                                [ sh:class nltl:evidenceArtifact ;
                                    sh:minCount 1 ;
                                    sh:path nltl:lookupSelectionEvidence ] ] ;
                    sh:path nltl:hasPeakPressureFactorLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F06/lookup> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F06/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:iceForce" ;
            sh:resultPath nltl:iceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:KiloN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:iceForce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F06/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchHeight" ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F06/ship> ;
            sh:resultMessage "The peak pressure factor lookup case must be the table lookup case selected from IACS UR I2 Table 3 and supported by lookup evidence." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The peak pressure factor lookup case must be the table lookup case selected from IACS UR I2 Table 3 and supported by lookup evidence." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasPeakPressureFactorLookupCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:hasTableLookupCase ?case .
                    ?case nltl:tableReference nltl:iacsUrI2Table3 ;
                          nltl:lookupSelectionEvidence ?evidence .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-018-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F06/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F06/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchLength" ;
            sh:resultPath nltl:loadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:loadPatchLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F06/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:peakPressureFactor" ;
            sh:resultPath nltl:peakPressureFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:peakPressureFactor ] ] .

