@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F03/ship> ;
            sh:resultMessage "A structural member spanning multiple hull areas must have a selected hull area factor." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A structural member spanning multiple hull areas must have a selected hull area factor." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasSpannedHullArea ?area1 ;
                        nltl:hasSpannedHullArea ?area2 .
                FILTER (?area1 != ?area2)
                FILTER NOT EXISTS {
                    ?member nltl:selectedHullAreaFactor ?selectedFactorNode .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_019_ApplicabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F03/ship> ] .

