@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/area2> ;
                            sh:resultMessage "Less than 1 values on ex:area2->nltl:hullAreaFactor" ;
                            sh:resultPath nltl:hullAreaFactor ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:hullAreaFactor ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/member> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:hullAreaValue ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:hullAreaFactor ] ]. See details for more information." ;
                    sh:resultPath nltl:hasSpannedHullArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node [ sh:class nltl:hullAreaValue ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:class qudt:QuantityValue ;
                                                    sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ],
                                                        [ sh:hasValue unit:UNITLESS ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ] ] ;
                                            sh:path nltl:hullAreaFactor ] ] ;
                            sh:path nltl:hasSpannedHullArea ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/area2> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:structuralMember ; sh:property [ sh:node [ sh:class nltl:hullAreaValue ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:hullAreaFactor ] ] ; sh:path nltl:hasSpannedHullArea ] ]. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:structuralMember ;
                            sh:property [ sh:node [ sh:class nltl:hullAreaValue ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:hullAreaFactor ] ] ;
                                    sh:path nltl:hasSpannedHullArea ] ] ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/ship> ;
            sh:resultMessage "The selected hull area factor must equal the maximum hull area factor across all hull areas spanned by the structural member, within numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The selected hull area factor must equal the maximum hull area factor across all hull areas spanned by the structural member, within numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasSpannedHullArea ?area1 ;
                        nltl:hasSpannedHullArea ?area2 ;
                        nltl:selectedHullAreaFactor ?selectedFactorNode .
                FILTER (?area1 != ?area2)

                ?selectedFactorNode qudt:numericValue ?selectedValue .

                {
                    SELECT $this ?member (MAX(?factorValue) AS ?expectedValue)
                    WHERE {
                        $this nltl:hasStructuralMember ?member .
                        ?member nltl:hasSpannedHullArea ?area .
                        ?area nltl:hullAreaFactor ?factorNode .
                        ?factorNode qudt:numericValue ?factorValue .
                    }
                    GROUP BY $this ?member
                }

                BIND(IF(?expectedValue < 0, -?expectedValue, ?expectedValue) AS ?scale)
                BIND((0.000001 * ?scale) + 0.000001 AS ?tolerance)
                FILTER (
                    ?selectedValue < (?expectedValue - ?tolerance) ||
                    ?selectedValue > (?expectedValue + ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_019_ApplicabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/ship> ] .

