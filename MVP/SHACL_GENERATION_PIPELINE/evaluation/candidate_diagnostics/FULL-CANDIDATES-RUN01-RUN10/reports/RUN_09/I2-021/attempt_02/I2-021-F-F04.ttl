@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/plating> ;
                    sh:resultMessage "Thickness must equal ice-load required net plate thickness plus corrosion and abrasion allowance within a relative tolerance of 1e-6, with an absolute fallback of 1e-6 mm." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Thickness must equal ice-load required net plate thickness plus corrosion and abrasion allowance within a relative tolerance of 1e-6, with an absolute fallback of 1e-6 mm." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadRequiredNetPlateThickness ?netNode ;
                      nltl:corrosionAbrasionAllowance ?allowanceNode ;
                      nltl:thickness ?thicknessNode .
                ?netNode qudt:numericValue ?net .
                ?allowanceNode qudt:numericValue ?allowance .
                ?thicknessNode qudt:numericValue ?actual .
                BIND((?net + ?allowance) AS ?expected)
                FILTER (
                    (
                        ?expected >= 0 &&
                        (
                            (
                                ?actual < (?expected - 0.000001) &&
                                ?actual < (?expected - (?expected * 0.000001))
                            ) ||
                            (
                                ?actual > (?expected + 0.000001) &&
                                ?actual > (?expected + (?expected * 0.000001))
                            )
                        )
                    ) ||
                    (
                        ?expected < 0 &&
                        (
                            (
                                ?actual < (?expected - 0.000001) &&
                                ?actual < (?expected - ((0 - ?expected) * 0.000001))
                            ) ||
                            (
                                ?actual > (?expected + 0.000001) &&
                                ?actual > (?expected + ((0 - ?expected) * 0.000001))
                            )
                        )
                    )
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gs:I2_021_PlatingShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/plating> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/thickness> ;
                            sh:resultMessage "Node ex:thickness->qudt:unit does not contain a value in the set: ['unit:MilliM']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue unit:MilliM ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/plating> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MilliM ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
                    sh:resultPath nltl:thickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue unit:MilliM ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:thickness ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/thickness> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:I2_021_PlatingShape. See details for more information." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gs:I2_021_PlatingShape ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/plating> ] .

