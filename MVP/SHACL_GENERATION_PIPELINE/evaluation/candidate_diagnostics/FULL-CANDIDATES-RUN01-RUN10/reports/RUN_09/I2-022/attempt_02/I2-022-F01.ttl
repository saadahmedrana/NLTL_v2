@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F01/ship> ;
            sh:resultMessage "The ship must provide the peak pressure factor." ;
            sh:resultPath nltl:peakPressureFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the peak pressure factor." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-022-QuantityValue-Decimal-Unitless> ;
                    sh:path nltl:peakPressureFactor ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F01/ship> ;
            sh:resultMessage "The ship must provide yield strength in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide yield strength in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-022-QuantityValue-Decimal-MegaPA> ;
                    sh:path nltl:yieldStrength ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F01/plating> ;
                    sh:resultMessage "Node ex:plating must conform to one or more shapes in <urn:nltl:generated-shape:I2-022-ApplicablePlating> , <urn:nltl:generated-shape:I2-022-NonApplicablePlating>" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-022-PlatingApplicability> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F01/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F01/ship> ;
            sh:resultMessage "Each linked plating must provide evidence of applicability or a non-applicable framing-angle branch." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked plating must provide evidence of applicability or a non-applicable framing-angle branch." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-022-PlatingApplicability> ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F01/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F01/ship> ;
            sh:resultMessage "The ship must provide load patch height in metres." ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide load patch height in metres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-022-QuantityValue-Decimal-M> ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F01/ship> ;
            sh:resultMessage "The ship must provide average ice pressure in MPa." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide average ice pressure in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-022-QuantityValue-Decimal-MegaPA> ;
                    sh:path nltl:averageIcePressure ] ] .

