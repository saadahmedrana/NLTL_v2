@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F02/lowerEndpoint> ;
            sh:resultMessage "A calculation case must provide the transverse framing net plate thickness input." ;
            sh:resultPath nltl:transverseFramingNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n396f88f48f4c4487a7d8880a0b289fcab8 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F02/lowerEndpoint> ;
            sh:resultMessage "A calculation case must provide the longitudinal framing net plate thickness input." ;
            sh:resultPath nltl:longitudinalFramingNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n396f88f48f4c4487a7d8880a0b289fcab7 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F02/case> ;
            sh:resultMessage "An oblique plating interpolation case must provide the externally calculated interpolated net plate thickness." ;
            sh:resultPath nltl:interpolatedNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n396f88f48f4c4487a7d8880a0b289fcab6 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F02/upperEndpoint> ;
            sh:resultMessage "A calculation case must provide the longitudinal framing net plate thickness input." ;
            sh:resultPath nltl:longitudinalFramingNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n396f88f48f4c4487a7d8880a0b289fcab7 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F02/case> ;
                    sh:resultMessage "An oblique plating interpolation case must provide the externally calculated interpolated net plate thickness." ;
                    sh:resultPath nltl:interpolatedNetPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n396f88f48f4c4487a7d8880a0b289fcab6 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-024-ObliqueCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasObliquePlatingInterpolationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-024-ObliqueCaseShape> ;
                    sh:path nltl:hasObliquePlatingInterpolationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F02/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F02/upperEndpoint> ;
            sh:resultMessage "A calculation case must provide the transverse framing net plate thickness input." ;
            sh:resultPath nltl:transverseFramingNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n396f88f48f4c4487a7d8880a0b289fcab8 ] .

_:n396f88f48f4c4487a7d8880a0b289fcab6 sh:message "An oblique plating interpolation case must provide the externally calculated interpolated net plate thickness." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-024-LengthQuantityShape> ;
    sh:path nltl:interpolatedNetPlateThickness .

_:n396f88f48f4c4487a7d8880a0b289fcab7 sh:message "A calculation case must provide the longitudinal framing net plate thickness input." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-024-LengthQuantityShape> ;
    sh:path nltl:longitudinalFramingNetPlateThickness .

_:n396f88f48f4c4487a7d8880a0b289fcab8 sh:message "A calculation case must provide the transverse framing net plate thickness input." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-024-LengthQuantityShape> ;
    sh:path nltl:transverseFramingNetPlateThickness .

