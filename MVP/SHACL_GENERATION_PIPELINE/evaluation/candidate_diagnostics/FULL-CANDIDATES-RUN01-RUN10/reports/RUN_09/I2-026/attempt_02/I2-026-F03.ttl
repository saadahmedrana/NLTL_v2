@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ;
                    sh:resultMessage "The support condition must be fixed when the member is continuous through its support, has a connection bracket, has demonstrated rotational restraint, or terminates within an ice-strengthened area; otherwise it must be simple." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "The support condition must be fixed when the member is continuous through its support, has a connection bracket, has demonstrated rotational restraint, or terminates within an ice-strengthened area; otherwise it must be simple." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasMemberSupport ?support .
                $this nltl:continuousThroughSupport ?continuous .
                $this nltl:terminatesWithinIceStrengthenedArea ?terminates .
                ?support nltl:connectionBracketPresent ?bracket .
                ?support nltl:demonstratedRotationalRestraint ?restraint .
                ?support nltl:frameSupportCondition ?condition .
                FILTER (
                    (
                        (
                            ?continuous = true ||
                            ?bracket = true ||
                            ?restraint = true ||
                            ?terminates = true
                        ) &&
                        ?condition != nltl:fixedFrameSupport
                    ) ||
                    (
                        ?continuous = false &&
                        ?bracket = false &&
                        ?restraint = false &&
                        ?terminates = false &&
                        ?condition != nltl:simpleFrameSupport
                    )
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_026_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/ship> ;
            sh:resultMessage "Each represented structural member must satisfy the framing support-fixity requirements." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each represented structural member must satisfy the framing support-fixity requirements." ;
                    sh:node gen:I2_026_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ] .

