@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "The ship must provide one patch load in kN." ;
            sh:resultPath nltl:patchLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one patch load in kN." ;
                    sh:minCount 1 ;
                    sh:node nltl:I2_031_KiloNewtonQuantityShape ;
                    sh:path nltl:patchLoad ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/demand> ;
                            sh:resultMessage "The quantity must use kN as its unit." ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:nabaa7f24ca3040cea099c40890fbd121b29 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/loadcase> ;
                    sh:resultMessage "Each load case must provide the combined shear and bending demand in kN." ;
                    sh:resultPath nltl:combinedShearAndBendingDemand ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nabaa7f24ca3040cea099c40890fbd121b26 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/demand> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
            sh:resultMessage "Each structural member must have a load case." ;
            sh:resultPath nltl:hasStructuralMemberLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nabaa7f24ca3040cea099c40890fbd121b15 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/loadcase> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/demand> ;
                    sh:resultMessage "The quantity must use kN as its unit." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nabaa7f24ca3040cea099c40890fbd121b29 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/loadcase> ;
            sh:resultMessage "Each load case must provide the combined shear and bending demand in kN." ;
            sh:resultPath nltl:combinedShearAndBendingDemand ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nabaa7f24ca3040cea099c40890fbd121b26 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/demand> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/strength> ;
                    sh:resultMessage "The quantity must use kN as its unit." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nabaa7f24ca3040cea099c40890fbd121b29 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
            sh:resultMessage "Each structural member must provide its plastic strength in kN." ;
            sh:resultPath nltl:plasticStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nabaa7f24ca3040cea099c40890fbd121b13 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/strength> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/strength> ;
                            sh:resultMessage "The quantity must use kN as its unit." ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:nabaa7f24ca3040cea099c40890fbd121b29 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
                    sh:resultMessage "Each structural member must provide its plastic strength in kN." ;
                    sh:resultPath nltl:plasticStrength ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nabaa7f24ca3040cea099c40890fbd121b13 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/strength> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/demand> ;
                                    sh:resultMessage "The quantity must use kN as its unit." ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:nabaa7f24ca3040cea099c40890fbd121b29 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/loadcase> ;
                            sh:resultMessage "Each load case must provide the combined shear and bending demand in kN." ;
                            sh:resultPath nltl:combinedShearAndBendingDemand ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape _:nabaa7f24ca3040cea099c40890fbd121b26 ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/demand> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
                    sh:resultMessage "Each structural member must have a load case." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nabaa7f24ca3040cea099c40890fbd121b15 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/loadcase> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/collapse> ;
                            sh:resultMessage "The quantity must use kN as its unit." ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:nabaa7f24ca3040cea099c40890fbd121b29 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
                    sh:resultMessage "Each structural member must provide the midspan plastic collapse load in kN." ;
                    sh:resultPath nltl:midspanPlasticCollapseLoad ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nabaa7f24ca3040cea099c40890fbd121b14 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/collapse> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
                    sh:resultMessage "The combined shear and bending demand must not exceed the member plastic strength, and plastic strength must equal the midspan plastic collapse load within tolerance." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:nabaa7f24ca3040cea099c40890fbd121b25 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape nltl:I2_031_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape nltl:I2_031_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltl:I2_031_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
            sh:resultMessage "The combined shear and bending demand must not exceed the member plastic strength, and plastic strength must equal the midspan plastic collapse load within tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:nabaa7f24ca3040cea099c40890fbd121b25 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:I2_031_StructuralMemberShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/collapse> ;
                    sh:resultMessage "The quantity must use kN as its unit." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nabaa7f24ca3040cea099c40890fbd121b29 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
            sh:resultMessage "Each structural member must provide the midspan plastic collapse load in kN." ;
            sh:resultPath nltl:midspanPlasticCollapseLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nabaa7f24ca3040cea099c40890fbd121b14 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/collapse> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "The ship must identify a permitted frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must identify a permitted frame profile type." ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:hasValue nltl:flatBarSection ] [ sh:hasValue nltl:profileSection ] ) ;
                    sh:path nltl:frameProfileType ] ] .

_:nabaa7f24ca3040cea099c40890fbd121b13 sh:maxCount 1 ;
    sh:message "Each structural member must provide its plastic strength in kN." ;
    sh:minCount 1 ;
    sh:node nltl:I2_031_KiloNewtonQuantityShape ;
    sh:path nltl:plasticStrength .

_:nabaa7f24ca3040cea099c40890fbd121b14 sh:maxCount 1 ;
    sh:message "Each structural member must provide the midspan plastic collapse load in kN." ;
    sh:minCount 1 ;
    sh:node nltl:I2_031_KiloNewtonQuantityShape ;
    sh:path nltl:midspanPlasticCollapseLoad .

_:nabaa7f24ca3040cea099c40890fbd121b15 sh:message "Each structural member must have a load case." ;
    sh:minCount 1 ;
    sh:node nltl:I2_031_LoadCaseShape ;
    sh:path nltl:hasStructuralMemberLoadCase .

_:nabaa7f24ca3040cea099c40890fbd121b25 a sh:SPARQLConstraint ;
    sh:message "The combined shear and bending demand must not exceed the member plastic strength, and plastic strength must equal the midspan plastic collapse load within tolerance." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMemberLoadCase ?case .
                ?case nltl:combinedShearAndBendingDemand ?demand .
                ?demand qudt:numericValue ?demandValue .
                $this nltl:plasticStrength ?strength .
                ?strength qudt:numericValue ?strengthValue .
                $this nltl:midspanPlasticCollapseLoad ?midspan .
                ?midspan qudt:numericValue ?midspanValue .
                FILTER (
                    ?demandValue > ?strengthValue ||
                    ABS(?strengthValue - ?midspanValue) >
                    ((1e-6 * ABS(?midspanValue)) + 1e-9)
                )
            }
        """ .

_:nabaa7f24ca3040cea099c40890fbd121b26 sh:maxCount 1 ;
    sh:message "Each load case must provide the combined shear and bending demand in kN." ;
    sh:minCount 1 ;
    sh:node nltl:I2_031_KiloNewtonQuantityShape ;
    sh:path nltl:combinedShearAndBendingDemand .

_:nabaa7f24ca3040cea099c40890fbd121b29 sh:hasValue qudt:KiloN ;
    sh:maxCount 1 ;
    sh:message "The quantity must use kN as its unit." ;
    sh:minCount 1 ;
    sh:path qudt:unit .

