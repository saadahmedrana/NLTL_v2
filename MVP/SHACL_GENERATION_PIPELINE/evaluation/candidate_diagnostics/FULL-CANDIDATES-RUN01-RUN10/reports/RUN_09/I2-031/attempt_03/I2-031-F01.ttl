@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/collapse> ;
                            sh:resultMessage "Node ex:collapse->qudt:unit does not contain a value in the set: ['qudt:KiloN']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:n52989138b4b048e1b42e3ff3b6737df7b2 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
                    sh:resultMessage "Each applicable structural member must provide its midspan plastic-collapse load in kN." ;
                    sh:resultPath nltl:midspanPlasticCollapseLoad ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each applicable structural member must provide its midspan plastic-collapse load in kN." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2_031_QuantityValueShape> ;
                            sh:path nltl:midspanPlasticCollapseLoad ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/collapse> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
                    sh:resultMessage "Combined shear and bending demand must not exceed plastic strength, and plastic strength must equal the midspan plastic-collapse load within the stated tolerance." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "Combined shear and bending demand must not exceed plastic strength, and plastic strength must equal the midspan plastic-collapse load within the stated tolerance." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:midspanPlasticCollapseLoad ?midspanQuantity ;
                      nltl:plasticStrength ?strengthQuantity ;
                      nltl:hasStructuralMemberLoadCase ?loadCase .

                ?midspanQuantity qudt:numericValue ?midspanValue .
                ?strengthQuantity qudt:numericValue ?strengthValue .
                ?loadCase nltl:combinedShearAndBendingDemand ?demandQuantity .
                ?demandQuantity qudt:numericValue ?demandValue .

                FILTER (
                    ?demandValue > ?strengthValue
                    ||
                    (
                        (?midspanValue >= 0 && ?midspanValue <= 0.000000000001 &&
                         (?strengthValue < ?midspanValue - 0.000001 ||
                          ?strengthValue > ?midspanValue + 0.000001))
                        ||
                        (?midspanValue >= 0 && ?midspanValue > 0.000000000001 &&
                         (?strengthValue < ?midspanValue - (0.000001 * ?midspanValue) ||
                          ?strengthValue > ?midspanValue + (0.000001 * ?midspanValue)))
                        ||
                        (?midspanValue < 0 && (0 - ?midspanValue) <= 0.000000000001 &&
                         (?strengthValue < ?midspanValue - 0.000001 ||
                          ?strengthValue > ?midspanValue + 0.000001))
                        ||
                        (?midspanValue < 0 && (0 - ?midspanValue) > 0.000000000001 &&
                         (?strengthValue < ?midspanValue - (0.000001 * (0 - ?midspanValue)) ||
                          ?strengthValue > ?midspanValue + (0.000001 * (0 - ?midspanValue))))
                    )
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2_031_StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
                    sh:resultMessage "Node ex:member must conform to one or more shapes in <urn:nltl:generated-shape:I2_031_BottomMemberShape> , <urn:nltl:generated-shape:I2_031_SideMemberShape>" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2_031_StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/demand> ;
                                    sh:resultMessage "Node ex:demand->qudt:unit does not contain a value in the set: ['qudt:KiloN']" ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape _:n52989138b4b048e1b42e3ff3b6737df7b2 ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/loadcase> ;
                            sh:resultMessage "Each structural-member load case must provide one combined shear and bending demand in kN." ;
                            sh:resultPath nltl:combinedShearAndBendingDemand ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each structural-member load case must provide one combined shear and bending demand in kN." ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:I2_031_QuantityValueShape> ;
                                    sh:path nltl:combinedShearAndBendingDemand ] ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/demand> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2_031_LoadCaseShape>. See details for more information." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2_031_LoadCaseShape> ;
                            sh:path nltl:hasStructuralMemberLoadCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/loadcase> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/strength> ;
                            sh:resultMessage "Node ex:strength->qudt:unit does not contain a value in the set: ['qudt:KiloN']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:n52989138b4b048e1b42e3ff3b6737df7b2 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
                    sh:resultMessage "Each applicable structural member must provide one plastic strength in kN." ;
                    sh:resultPath nltl:plasticStrength ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each applicable structural member must provide one plastic strength in kN." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2_031_QuantityValueShape> ;
                            sh:path nltl:plasticStrength ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/strength> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2_031_StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2_031_StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:frameProfileType" ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:flatBarSection nltl:profileSection ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "The applicable ship must provide one patch load in kN." ;
            sh:resultPath nltl:patchLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The applicable ship must provide one patch load in kN." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2_031_QuantityValueShape> ;
                    sh:path nltl:patchLoad ] ] .

_:n52989138b4b048e1b42e3ff3b6737df7b2 sh:hasValue qudt:KiloN ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

