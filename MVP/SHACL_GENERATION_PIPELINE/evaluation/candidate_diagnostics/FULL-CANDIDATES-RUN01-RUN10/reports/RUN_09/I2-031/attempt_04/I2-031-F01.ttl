@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "The ship must identify its frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must identify its frame profile type." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "The ship must provide the patch load in kN." ;
            sh:resultPath nltl:patchLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the patch load in kN." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:patchLoad ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
                    sh:resultMessage "For every structural-member load case, combined shear and bending demand must not exceed plastic strength, and plastic strength must match the midspan plastic-collapse load within a relative tolerance of 1e-6 or an absolute tolerance of 1e-9 near zero." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "For every structural-member load case, combined shear and bending demand must not exceed plastic strength, and plastic strength must match the midspan plastic-collapse load within a relative tolerance of 1e-6 or an absolute tolerance of 1e-9 near zero." ;
                            sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:plasticStrength ?strengthNode .
                        ?strengthNode qudt:numericValue ?strength .
                        $this nltl:midspanPlasticCollapseLoad ?midspanNode .
                        ?midspanNode qudt:numericValue ?midspan .
                        $this nltl:hasStructuralMemberLoadCase ?loadCase .
                        ?loadCase nltl:combinedShearAndBendingDemand ?demandNode .
                        ?demandNode qudt:numericValue ?demand .
                        FILTER (
                            ?demand > ?strength
                            ||
                            (
                                ?midspan > 0 &&
                                (
                                    ?strength < (?midspan - (?midspan * 0.000001)) ||
                                    ?strength > (?midspan + (?midspan * 0.000001))
                                )
                            )
                            ||
                            (
                                ?midspan <= 0 &&
                                ?midspan >= 0 &&
                                (
                                    ?strength < (?midspan - 0.000000001) ||
                                    ?strength > (?midspan + 0.000000001)
                                )
                            )
                            ||
                            (
                                ?midspan < 0 &&
                                (
                                    ?strength < (?midspan - ((0 - ?midspan) * 0.000001)) ||
                                    ?strength > (?midspan + ((0 - ?midspan) * 0.000001))
                                )
                            )
                        )
                    }
                """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape [ sh:or ( [ sh:property [ sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:hasStructuralMemberLoadCase ],
                                            [ sh:hasValue nltl:bottomStructureLocation ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:structuralLocation ] ] [ sh:property [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:maxCount 1 ;
                                                sh:message "A side structural member must be identified as transverse." ;
                                                sh:minCount 1 ;
                                                sh:path nltl:transverseFrameOrientation ],
                                            [ sh:minCount 1 ;
                                                sh:node [ sh:property [ ] ] ;
                                                sh:path nltl:hasStructuralMemberLoadCase ],
                                            [ sh:hasValue nltl:sideStructureLocation ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:structuralLocation ] ] ) ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "The member must provide its midspan plastic-collapse load in kN." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:midspanPlasticCollapseLoad ],
                                [ sh:maxCount 1 ;
                                    sh:message "The member must provide its plastic strength in kN." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:plasticStrength ],
                                [ sh:in ( nltl:bottomStructureLocation nltl:sideStructureLocation ) ;
                                    sh:maxCount 1 ;
                                    sh:message "Each applicable structural member must identify a bottom or side structure location." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:structuralLocation ] ;
                            sh:sparql [ a sh:SPARQLConstraint ;
                                    sh:message "For every structural-member load case, combined shear and bending demand must not exceed plastic strength, and plastic strength must match the midspan plastic-collapse load within a relative tolerance of 1e-6 or an absolute tolerance of 1e-9 near zero." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:plasticStrength ?strengthNode .
                        ?strengthNode qudt:numericValue ?strength .
                        $this nltl:midspanPlasticCollapseLoad ?midspanNode .
                        ?midspanNode qudt:numericValue ?midspan .
                        $this nltl:hasStructuralMemberLoadCase ?loadCase .
                        ?loadCase nltl:combinedShearAndBendingDemand ?demandNode .
                        ?demandNode qudt:numericValue ?demand .
                        FILTER (
                            ?demand > ?strength
                            ||
                            (
                                ?midspan > 0 &&
                                (
                                    ?strength < (?midspan - (?midspan * 0.000001)) ||
                                    ?strength > (?midspan + (?midspan * 0.000001))
                                )
                            )
                            ||
                            (
                                ?midspan <= 0 &&
                                ?midspan >= 0 &&
                                (
                                    ?strength < (?midspan - 0.000000001) ||
                                    ?strength > (?midspan + 0.000000001)
                                )
                            )
                            ||
                            (
                                ?midspan < 0 &&
                                (
                                    ?strength < (?midspan - ((0 - ?midspan) * 0.000001)) ||
                                    ?strength > (?midspan + ((0 - ?midspan) * 0.000001))
                                )
                            )
                        )
                    }
                """ ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:or ( [ sh:property [ sh:hasValue nltl:bottomStructureLocation ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:structuralLocation ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:hasValue nltl:loadPatchHeightParallelToFrame ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A bottom-structure load case must apply the patch-load dimension parallel to the frame.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:loadPatchOrientation ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <http://recursion.too.deep> ; sh:path nltl:combinedShearAndBendingDemand ] ] ; sh:path nltl:hasStructuralMemberLoadCase ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A side structural member must be identified as transverse.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:transverseFrameOrientation ], [ sh:hasValue nltl:sideStructureLocation ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:structuralLocation ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <http://recursion.too.deep> ; sh:path nltl:combinedShearAndBendingDemand ] ] ; sh:path nltl:hasStructuralMemberLoadCase ] ] ) ; sh:property [ sh:in ( nltl:bottomStructureLocation nltl:sideStructureLocation ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Each applicable structural member must identify a bottom or side structure location.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:structuralLocation ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The member must provide its midspan plastic-collapse load in kN.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:midspanPlasticCollapseLoad ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The member must provide its plastic strength in kN.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:plasticStrength ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("For every structural-member load case, combined shear and bending demand must not exceed plastic strength, and plastic strength must match the midspan plastic-collapse load within a relative tolerance of 1e-6 or an absolute tolerance of 1e-9 near zero.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:plasticStrength ?strengthNode .
                        ?strengthNode qudt:numericValue ?strength .
                        $this nltl:midspanPlasticCollapseLoad ?midspanNode .
                        ?midspanNode qudt:numericValue ?midspan .
                        $this nltl:hasStructuralMemberLoadCase ?loadCase .
                        ?loadCase nltl:combinedShearAndBendingDemand ?demandNode .
                        ?demandNode qudt:numericValue ?demand .
                        FILTER (
                            ?demand > ?strength
                            ||
                            (
                                ?midspan > 0 &&
                                (
                                    ?strength < (?midspan - (?midspan * 0.000001)) ||
                                    ?strength > (?midspan + (?midspan * 0.000001))
                                )
                            )
                            ||
                            (
                                ?midspan <= 0 &&
                                ?midspan >= 0 &&
                                (
                                    ?strength < (?midspan - 0.000000001) ||
                                    ?strength > (?midspan + 0.000000001)
                                )
                            )
                            ||
                            (
                                ?midspan < 0 &&
                                (
                                    ?strength < (?midspan - ((0 - ?midspan) * 0.000001)) ||
                                    ?strength > (?midspan + ((0 - ?midspan) * 0.000001))
                                )
                            )
                        )
                    }
                ") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:or ( [ sh:property [ sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:hasStructuralMemberLoadCase ],
                                            [ sh:hasValue nltl:bottomStructureLocation ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:structuralLocation ] ] [ sh:property [ sh:hasValue nltl:sideStructureLocation ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:structuralLocation ],
                                            [ sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:hasStructuralMemberLoadCase ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:maxCount 1 ;
                                                sh:message "A side structural member must be identified as transverse." ;
                                                sh:minCount 1 ;
                                                sh:path nltl:transverseFrameOrientation ] ] ) ;
                            sh:property [ sh:in ( nltl:bottomStructureLocation nltl:sideStructureLocation ) ;
                                    sh:maxCount 1 ;
                                    sh:message "Each applicable structural member must identify a bottom or side structure location." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:structuralLocation ],
                                [ sh:maxCount 1 ;
                                    sh:message "The member must provide its midspan plastic-collapse load in kN." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:midspanPlasticCollapseLoad ],
                                [ sh:maxCount 1 ;
                                    sh:message "The member must provide its plastic strength in kN." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:plasticStrength ] ;
                            sh:sparql [ a sh:SPARQLConstraint ;
                                    sh:message "For every structural-member load case, combined shear and bending demand must not exceed plastic strength, and plastic strength must match the midspan plastic-collapse load within a relative tolerance of 1e-6 or an absolute tolerance of 1e-9 near zero." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:plasticStrength ?strengthNode .
                        ?strengthNode qudt:numericValue ?strength .
                        $this nltl:midspanPlasticCollapseLoad ?midspanNode .
                        ?midspanNode qudt:numericValue ?midspan .
                        $this nltl:hasStructuralMemberLoadCase ?loadCase .
                        ?loadCase nltl:combinedShearAndBendingDemand ?demandNode .
                        ?demandNode qudt:numericValue ?demand .
                        FILTER (
                            ?demand > ?strength
                            ||
                            (
                                ?midspan > 0 &&
                                (
                                    ?strength < (?midspan - (?midspan * 0.000001)) ||
                                    ?strength > (?midspan + (?midspan * 0.000001))
                                )
                            )
                            ||
                            (
                                ?midspan <= 0 &&
                                ?midspan >= 0 &&
                                (
                                    ?strength < (?midspan - 0.000000001) ||
                                    ?strength > (?midspan + 0.000000001)
                                )
                            )
                            ||
                            (
                                ?midspan < 0 &&
                                (
                                    ?strength < (?midspan - ((0 - ?midspan) * 0.000001)) ||
                                    ?strength > (?midspan + ((0 - ?midspan) * 0.000001))
                                )
                            )
                        )
                    }
                """ ] ] ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ] .

