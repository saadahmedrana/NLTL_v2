@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ;
            sh:resultMessage "A represented structural member must provide either its plastic strength or its midspan plastic collapse load.",
                "For a longitudinal frame in a side structure, the combined shear-and-bending demand must not exceed the plastic strength." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a longitudinal frame in a side structure, the combined shear-and-bending demand must not exceed the plastic strength." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:longitudinalFrameOrientation true ;
                      nltl:structuralLocation nltl:sideStructureLocation ;
                      nltl:hasStructuralMemberLoadCase ?case .
                ?case nltl:combinedShearAndBendingDemand ?demandNode .
                ?demandNode <http://qudt.org/schema/qudt/numericValue> ?demand .
                $this nltl:plasticStrength ?strengthNode .
                ?strengthNode <http://qudt.org/schema/qudt/numericValue> ?strength .
                FILTER (?demand > ?strength)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlgen:I2_034_StructuralMemberShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ;
            sh:resultMessage "A represented structural member must provide either its plastic strength or its midspan plastic collapse load.",
                "For a longitudinal frame in a side structure, the combined shear-and-bending demand must not exceed the midspan plastic collapse load." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a longitudinal frame in a side structure, the combined shear-and-bending demand must not exceed the midspan plastic collapse load." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:longitudinalFrameOrientation true ;
                      nltl:structuralLocation nltl:sideStructureLocation ;
                      nltl:hasStructuralMemberLoadCase ?case .
                ?case nltl:combinedShearAndBendingDemand ?demandNode .
                ?demandNode <http://qudt.org/schema/qudt/numericValue> ?demand .
                $this nltl:midspanPlasticCollapseLoad ?strengthNode .
                ?strengthNode <http://qudt.org/schema/qudt/numericValue> ?strength .
                FILTER (?demand > ?strength)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlgen:I2_034_StructuralMemberShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] .

