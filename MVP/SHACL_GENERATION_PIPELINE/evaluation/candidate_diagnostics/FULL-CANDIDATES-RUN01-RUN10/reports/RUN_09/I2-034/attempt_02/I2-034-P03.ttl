@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-P03/ship> ;
            sh:resultMessage "The ship must identify its frame profile type using a canonical frame profile type value." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship must identify its frame profile type using a canonical frame profile type value." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ] .

