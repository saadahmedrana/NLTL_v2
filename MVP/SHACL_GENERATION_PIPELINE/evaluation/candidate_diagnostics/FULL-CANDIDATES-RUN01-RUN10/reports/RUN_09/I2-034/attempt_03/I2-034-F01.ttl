@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "Each ship must specify one permitted frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:in ( nltl:flatBarSection nltl:profileSection ) ;
                    sh:maxCount 1 ;
                    sh:message "Each ship must specify one permitted frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ;
                    sh:resultMessage "For each applicable longitudinal frame, combined shear and bending demand must not exceed plastic strength, and plastic strength must equal the midspan plastic collapse load within tolerance." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "For each applicable longitudinal frame, combined shear and bending demand must not exceed plastic strength, and plastic strength must equal the midspan plastic collapse load within tolerance." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:longitudinalFrameOrientation true ;
                      nltl:structuralLocation nltl:sideStructureLocation ;
                      nltl:plasticStrength ?ps ;
                      nltl:midspanPlasticCollapseLoad ?mc ;
                      nltl:hasStructuralMemberLoadCase ?lc .

                ?ps qudt:numericValue ?pv ;
                    qudt:unit unit:KiloN .
                ?mc qudt:numericValue ?mv ;
                    qudt:unit unit:KiloN .
                ?lc nltl:combinedShearAndBendingDemand ?d .
                ?d qudt:numericValue ?dv ;
                   qudt:unit unit:KiloN .

                FILTER (datatype(?pv) = xsd:decimal)
                FILTER (datatype(?mv) = xsd:decimal)
                FILTER (datatype(?dv) = xsd:decimal)
                FILTER (
                    ?dv > ?pv
                    ||
                    ABS(?pv - ?mv) > (ABS(?pv) * 0.000001 + 0.000001)
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-034-StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] .

