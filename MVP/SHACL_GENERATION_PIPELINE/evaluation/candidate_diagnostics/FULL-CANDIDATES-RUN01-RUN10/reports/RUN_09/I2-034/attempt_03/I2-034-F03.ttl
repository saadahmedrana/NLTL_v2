@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F03/member> ;
                    sh:resultMessage "An applicable longitudinal frame in a side structure must provide single-valued plastic strength, midspan plastic collapse load, and valid load-case demand quantities in kN." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "An applicable longitudinal frame in a side structure must provide single-valued plastic strength, midspan plastic collapse load, and valid load-case demand quantities in kN." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:longitudinalFrameOrientation true ;
                      nltl:structuralLocation nltl:sideStructureLocation .

                FILTER (
                    NOT EXISTS {
                        $this nltl:plasticStrength ?ps .
                        ?ps qudt:numericValue ?pv ;
                            qudt:unit unit:KiloN .
                        FILTER (datatype(?pv) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:midspanPlasticCollapseLoad ?mc .
                        ?mc qudt:numericValue ?mv ;
                            qudt:unit unit:KiloN .
                        FILTER (datatype(?mv) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        $this nltl:plasticStrength ?ps1, ?ps2 .
                        FILTER (?ps1 != ?ps2)
                    }
                    ||
                    EXISTS {
                        $this nltl:midspanPlasticCollapseLoad ?mc1, ?mc2 .
                        FILTER (?mc1 != ?mc2)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasStructuralMemberLoadCase ?lc .
                        FILTER NOT EXISTS {
                            ?lc nltl:combinedShearAndBendingDemand ?d .
                            ?d qudt:numericValue ?dv ;
                               qudt:unit unit:KiloN .
                            FILTER (datatype(?dv) = xsd:decimal)
                        }
                    }
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F03/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-034-StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-034-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F03/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F03/ship> ;
            sh:resultMessage "Each ship must specify one permitted frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:in ( nltl:flatBarSection nltl:profileSection ) ;
                    sh:maxCount 1 ;
                    sh:message "Each ship must specify one permitted frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ] .

