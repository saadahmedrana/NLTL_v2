@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "The ship must provide exactly one canonical frame-profile-type relationship." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship must provide exactly one canonical frame-profile-type relationship." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ;
                    sh:resultMessage "Every combined shear-and-bending demand must not exceed plastic strength, and plastic strength must equal the midspan plastic-collapse load within tolerance." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "Every combined shear-and-bending demand must not exceed plastic strength, and plastic strength must equal the midspan plastic-collapse load within tolerance." ;
                            sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this
WHERE {
    $this nltl:longitudinalFrameOrientation true ;
          nltl:structuralLocation nltl:sideStructureLocation ;
          nltl:midspanPlasticCollapseLoad ?midspanQuantity ;
          nltl:plasticStrength ?strengthQuantity ;
          nltl:hasStructuralMemberLoadCase ?loadCase .

    ?midspanQuantity qudt:numericValue ?mv ;
                     qudt:unit <http://qudt.org/vocab/unit/KiloN> .

    ?strengthQuantity qudt:numericValue ?pv ;
                     qudt:unit <http://qudt.org/vocab/unit/KiloN> .

    ?loadCase nltl:combinedShearAndBendingDemand ?demandQuantity .
    ?demandQuantity qudt:numericValue ?dv ;
                    qudt:unit <http://qudt.org/vocab/unit/KiloN> .

    FILTER (
        ?dv > ?pv ||
        ABS(?pv - ?mv) > (0.000001 * ABS(?mv) + 0.000000001)
    )
}
""" ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "Each represented structural member must satisfy the longitudinal side-frame requirement." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each represented structural member must satisfy the longitudinal side-frame requirement." ;
                    sh:node gen:StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] .

