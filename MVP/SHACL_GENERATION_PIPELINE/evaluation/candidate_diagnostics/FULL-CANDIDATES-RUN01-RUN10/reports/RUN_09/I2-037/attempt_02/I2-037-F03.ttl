@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/ship> ;
            sh:resultMessage "The ice-load-patch design case must be the structural-member load case, and the selected member capacity must not exceed the capacity of another linked member under the combined bending-and-shear load case." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ice-load-patch design case must be the structural-member load case, and the selected member capacity must not exceed the capacity of another linked member under the combined bending-and-shear load case." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT ?this
            WHERE {
                ?this nltl:hasStructuralMember ?member ;
                      nltl:hasIceLoadPatchDesignCase ?designCase .

                FILTER (
                    NOT EXISTS {
                        ?member nltl:hasStructuralMemberLoadCase ?matchingCase .
                        FILTER (?matchingCase = ?designCase)
                    }
                    ||
                    EXISTS {
                        ?member nltl:hasStructuralMemberLoadCase ?selectedCase ;
                                nltl:memberCapacity ?capacity .
                        FILTER (?selectedCase = ?designCase)

                        ?selectedCase nltl:combinedShearBendingEffect ?selectedEffect ;
                                      nltl:loadPatchApplicationLocation ?selectedLocation .
                        ?capacity qudt:numericValue ?currentValue .

                        ?this nltl:hasStructuralMember ?otherMember .
                        ?otherMember nltl:memberCapacity ?otherCapacity ;
                                     nltl:hasStructuralMemberLoadCase ?otherCase .
                        ?otherCase nltl:combinedShearBendingEffect ?otherEffect ;
                                   nltl:loadPatchApplicationLocation ?otherLocation .
                        ?otherCapacity qudt:numericValue ?otherValue .

                        FILTER (?otherValue < ?currentValue)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_037_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/member> ;
                    sh:resultMessage "Less than 1 values on ex:member->nltl:memberCapacity" ;
                    sh:resultPath nltl:memberCapacity ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue unit:KiloN ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:memberCapacity ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/loadcase> ;
                            sh:resultMessage "Less than 1 values on ex:loadcase->nltl:combinedShearBendingEffect" ;
                            sh:resultPath nltl:combinedShearBendingEffect ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:minCount 1 ;
                                    sh:path nltl:combinedShearBendingEffect ] ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/loadcase> ;
                            sh:resultMessage "Less than 1 values on ex:loadcase->nltl:loadPatchApplicationLocation" ;
                            sh:resultPath nltl:loadPatchApplicationLocation ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:minCount 1 ;
                                    sh:path nltl:loadPatchApplicationLocation ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/member> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:loadCase ; sh:property [ sh:datatype xsd:string ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:combinedShearBendingEffect ], [ sh:datatype xsd:string ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadPatchApplicationLocation ] ]. See details for more information." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class nltl:loadCase ;
                                    sh:property [ sh:datatype xsd:string ;
                                            sh:minCount 1 ;
                                            sh:path nltl:loadPatchApplicationLocation ],
                                        [ sh:datatype xsd:string ;
                                            sh:minCount 1 ;
                                            sh:path nltl:combinedShearBendingEffect ] ] ;
                            sh:path nltl:hasStructuralMemberLoadCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/loadcase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:structuralMember ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:loadCase ; sh:property [ sh:datatype xsd:string ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:combinedShearBendingEffect ], [ sh:datatype xsd:string ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadPatchApplicationLocation ] ] ; sh:path nltl:hasStructuralMemberLoadCase ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:memberCapacity ] ]. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:structuralMember ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:KiloN ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:memberCapacity ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:loadCase ;
                                            sh:property [ sh:datatype xsd:string ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:combinedShearBendingEffect ],
                                                [ sh:datatype xsd:string ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:loadPatchApplicationLocation ] ] ;
                                    sh:path nltl:hasStructuralMemberLoadCase ] ] ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/member> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/patchCase> ;
                    sh:resultMessage "Less than 1 values on ex:patchCase->nltl:memberCapacityMinimizationConfirmed" ;
                    sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n243d38a8ffd54f83ad838490afc3c195b13 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/patchCase> ;
                    sh:resultMessage "Node ex:patchCase->nltl:memberCapacityMinimizationConfirmed does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
                    sh:resultPath nltl:memberCapacityMinimizationConfirmed ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n243d38a8ffd54f83ad838490afc3c195b13 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:iceLoadPatchDesignCase ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:memberCapacityMinimizationConfirmed ] ]. See details for more information." ;
            sh:resultPath nltl:hasIceLoadPatchDesignCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:iceLoadPatchDesignCase ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:memberCapacityMinimizationConfirmed ] ] ;
                    sh:path nltl:hasIceLoadPatchDesignCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F03/patchCase> ] .

_:n243d38a8ffd54f83ad838490afc3c195b13 sh:datatype xsd:boolean ;
