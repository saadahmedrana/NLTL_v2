@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-042-F01/member> ;
                    sh:resultMessage "flangeWidth must be at least five times netWebThickness" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "flangeWidth must be at least five times netWebThickness" ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:netWebThickness ?thicknessNode ;
                      nltl:flangeWidth ?flangeNode .
                ?thicknessNode qudt:numericValue ?thickness .
                ?flangeNode qudt:numericValue ?flange .
                FILTER (
                    ?flange < (5 * ?thickness)
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2_042_StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-042-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-042-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2_042_StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2_042_StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-042-F01/member> ] .

