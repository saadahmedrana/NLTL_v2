@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F05/ship> ;
            sh:resultMessage "When Polar Class requirements are applicable, every linked internal ice-strengthened structure must satisfy the corrosion/abrasion addition requirement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_046_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F05/ship> ] .

