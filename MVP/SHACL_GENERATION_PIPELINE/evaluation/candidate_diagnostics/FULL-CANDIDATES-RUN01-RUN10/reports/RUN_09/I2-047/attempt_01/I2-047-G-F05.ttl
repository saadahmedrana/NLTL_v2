@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudt-unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F05/gauged> ;
                    sh:resultMessage "Node ex:gauged->qudt:unit does not contain a value in the set: ['qudt-unit:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt-unit:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape nltlgen:GaugedThicknessQuantityShape. See details for more information." ;
            sh:resultPath nltl:gaugedThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node nltlgen:GaugedThicknessQuantityShape ;
                    sh:path nltl:gaugedThickness ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F05/gauged> ] .

