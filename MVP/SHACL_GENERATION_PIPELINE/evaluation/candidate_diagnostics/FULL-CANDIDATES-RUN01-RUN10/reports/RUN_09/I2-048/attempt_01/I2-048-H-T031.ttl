@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T031/plating> ;
            sh:resultMessage "A single valid steel strength category is required." ;
            sh:resultPath nltl:steelStrengthCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelStrengthCategoryValue ;
                    sh:in ( nltl:normalStrengthSteelCategory nltl:highTensileSteelCategory ) ;
                    sh:maxCount 1 ;
                    sh:message "A single valid steel strength category is required." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelStrengthCategory ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T031/plating> ;
            sh:resultMessage "The steel-grade case must reference IACS UR I2 Table 8." ;
            sh:resultPath nltl:tableReference ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nf8576244b3e64bb3b6e945c49e794f39b11 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T031/plating> ;
            sh:resultMessage "A single valid steel material class is required." ;
            sh:resultPath nltl:steelMaterialClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelMaterialClassValue ;
                    sh:in ( nltl:steelMaterialClassOne nltl:steelMaterialClassTwo nltl:steelMaterialClassThree ) ;
                    sh:maxCount 1 ;
                    sh:message "A single valid steel material class is required." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelMaterialClass ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T031/plating> ;
            sh:resultMessage "The steel-grade case must reference IACS UR I2 Table 8." ;
            sh:resultPath nltl:tableReference ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf8576244b3e64bb3b6e945c49e794f39b11 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T031/case> ;
                    sh:resultMessage "As-built plate thickness must be one millimetre-valued quantity." ;
                    sh:resultPath nltl:asBuiltPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nf8576244b3e64bb3b6e945c49e794f39b12 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T031/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_048_CaseShape. See details for more information." ;
            sh:resultPath nltl:hasSteelGradeRequirementCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeRequirementCase ;
                    sh:node gen:I2_048_CaseShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasSteelGradeRequirementCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T031/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T031/plating> ;
            sh:resultMessage "The actual hull structural steel grade is required and must be a valid Table 8 grade." ;
            sh:resultPath nltl:actualHullStructuralSteelGrade ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeValue ;
                    sh:in ( nltl:steelGradeB nltl:steelGradeD nltl:steelGradeE nltl:steelGradeAh nltl:steelGradeDh nltl:steelGradeEh nltl:steelGradeFh ) ;
                    sh:maxCount 1 ;
                    sh:message "The actual hull structural steel grade is required and must be a valid Table 8 grade." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:actualHullStructuralSteelGrade ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T031/case> ;
            sh:resultMessage "As-built plate thickness must be one millimetre-valued quantity." ;
            sh:resultPath nltl:asBuiltPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf8576244b3e64bb3b6e945c49e794f39b12 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T031/plating> ;
            sh:resultMessage "Each represented steel-grade case must identify exactly one plating." ;
            sh:resultPath nltl:steelGradeRequirementCasePlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:plating ;
                    sh:maxCount 1 ;
                    sh:message "Each represented steel-grade case must identify exactly one plating." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:steelGradeRequirementCasePlating ] ] .

_:N830a5c6dc53a491e8296bfd6ea2c19ae sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

_:N83e5bb62b1164f94aaa245de5cbd043c sh:property _:N830a5c6dc53a491e8296bfd6ea2c19ae,
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:nf8576244b3e64bb3b6e945c49e794f39b11 sh:class nltl:tableReferenceValue ;
    sh:hasValue nltl:iacsUrI2Table8 ;
    sh:maxCount 1 ;
    sh:message "The steel-grade case must reference IACS UR I2 Table 8." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:tableReference .

_:nf8576244b3e64bb3b6e945c49e794f39b12 sh:class qudt:QuantityValue ;
    sh:maxCount 1 ;
    sh:message "As-built plate thickness must be one millimetre-valued quantity." ;
    sh:minCount 1 ;
    sh:node _:N83e5bb62b1164f94aaa245de5cbd043c ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:asBuiltPlateThickness .

