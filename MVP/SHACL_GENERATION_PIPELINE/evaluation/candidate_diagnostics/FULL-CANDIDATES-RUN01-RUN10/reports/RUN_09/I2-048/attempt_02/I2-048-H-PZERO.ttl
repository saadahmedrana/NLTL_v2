@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode nltl:normalStrengthHullStructuralSteel ;
            sh:resultMessage "Less than 1 values on nltl:normalStrengthHullStructuralSteel->nltl:steelGradeOrderRank" ;
            sh:resultPath nltl:steelGradeOrderRank ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n71257ed41d6e430596f3ff80b1c6bdffb14 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-PZERO/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:polarClass" ;
            sh:resultPath nltl:polarClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarClassValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:polarClass ] ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:highStrengthHullStructuralSteel ;
            sh:resultMessage "Less than 1 values on nltl:highStrengthHullStructuralSteel->nltl:steelGradeOrderRank" ;
            sh:resultPath nltl:steelGradeOrderRank ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n71257ed41d6e430596f3ff80b1c6bdffb14 ] .

_:n71257ed41d6e430596f3ff80b1c6bdffb14 sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:steelGradeOrderRank .

