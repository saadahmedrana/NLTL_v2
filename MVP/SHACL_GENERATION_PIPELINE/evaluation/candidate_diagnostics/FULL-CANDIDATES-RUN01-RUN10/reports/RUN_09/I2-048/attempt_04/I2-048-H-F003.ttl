      FILTER(?sc = nltl:highTensileSteelCategory)
      FILTER(?t > 35 && ?t <= 50)
      BIND(nltl:steelGradeDh AS ?expected)
      $this nltl:requiredHullStructuralSteelGrade ?expected
    }
    UNION
    {
      FILTER(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5))
      FILTER(?mc = nltl:steelMaterialClassTwo)
      FILTER(?sc = nltl:highTensileSteelCategory)
      FILTER(?t <= 10)
      BIND(nltl:steelGradeAh AS ?expected)
      $this nltl:requiredHullStructuralSteelGrade ?expected
    }
    UNION
