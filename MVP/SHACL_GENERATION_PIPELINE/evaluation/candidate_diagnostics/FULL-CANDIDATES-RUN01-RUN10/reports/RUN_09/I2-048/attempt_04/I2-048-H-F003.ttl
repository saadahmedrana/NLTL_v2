      FILTER(?sc = nltl:normalStrengthSteelCategory)
      FILTER(?t > 25 && ?t <= 50)
      BIND(nltl:steelGradeD AS ?expected)
      $this nltl:requiredHullStructuralSteelGrade ?expected
    }
    UNION
    {
      FILTER(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3))
      FILTER(?mc = nltl:steelMaterialClassThree)
      FILTER(?sc = nltl:normalStrengthSteelCategory)
      FILTER(?t <= 35)
      BIND(nltl:steelGradeE AS ?expected)
      $this nltl:requiredHullStructuralSteelGrade ?expected
    }
    UNION
    {
      FILTER(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3))
      FILTER(?mc = nltl:steelMaterialClassThree)
      FILTER(?sc = nltl:normalStrengthSteelCategory)
      FILTER(?t > 35 && ?t <= 50)
      FILTER NOT EXISTS { $this nltl:requiredHullStructuralSteelGrade ?none }
    }
    UNION
    {
      FILTER(?pc IN (nltl:polarClassPc4,nltl:polarClassPc5))
      FILTER(?mc = nltl:steelMaterialClassThree)
      FILTER(?sc = nltl:normalStrengthSteelCategory)
      FILTER(?t <= 45)
      BIND(nltl:steelGradeE AS ?expected)
