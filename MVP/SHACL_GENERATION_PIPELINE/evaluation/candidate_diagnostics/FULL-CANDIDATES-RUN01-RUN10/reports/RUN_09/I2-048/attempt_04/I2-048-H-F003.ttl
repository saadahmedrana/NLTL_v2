            sh:sourceConstraint _:nd78489e578b14d03882f191d2829f181b31 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:I2-048-CaseShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F003/case> ],
