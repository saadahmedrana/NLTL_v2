_:nd78489e578b14d03882f191d2829f181b31 a sh:SPARQLConstraint ;
    sh:message "The selectors do not produce the exact Table 8 required grade, or a non-applicable combination has a required grade." ;
    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  FILTER NOT EXISTS {
    ?ship nltl:hasSteelGradeRequirementCase $this ;
          nltl:polarClass ?pc .
    $this nltl:tableReference nltl:iacsUrI2Table8 ;
           nltl:asBuiltPlateThickness ?q ;
           nltl:steelMaterialClass ?mc ;
           nltl:steelStrengthCategory ?sc .
    ?q qudt:numericValue ?t ;
       qudt:unit <http://qudt.org/vocab/unit/MilliM> .

    {
      FILTER(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5))
      FILTER(?mc = nltl:steelMaterialClassOne)
      FILTER(?sc = nltl:normalStrengthSteelCategory)
      FILTER(?t <= 10)
      BIND(nltl:steelGradeB AS ?expected)
      $this nltl:requiredHullStructuralSteelGrade ?expected
    }
    UNION
    {
      FILTER(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5))
      FILTER(?mc = nltl:steelMaterialClassOne)
      FILTER(?sc = nltl:normalStrengthSteelCategory)
      FILTER(?t > 10 && ?t <= 35)
      BIND(nltl:steelGradeD AS ?expected)
      $this nltl:requiredHullStructuralSteelGrade ?expected
    }
    UNION
    {
      FILTER(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5))
      FILTER(?mc = nltl:steelMaterialClassOne)
      FILTER(?sc = nltl:normalStrengthSteelCategory)
      FILTER(?t > 35 && ?t <= 50)
      BIND(nltl:steelGradeE AS ?expected)
      $this nltl:requiredHullStructuralSteelGrade ?expected
    }
    UNION
    {
      FILTER(?pc IN (nltl:polarClassPc6,nltl:polarClassPc7))
      FILTER(?mc = nltl:steelMaterialClassOne)
      FILTER(?sc = nltl:normalStrengthSteelCategory)
      FILTER(?t <= 35)
      BIND(nltl:steelGradeB AS ?expected)
