    UNION
    {
      FILTER(?pc IN (nltl:polarClassPc4,nltl:polarClassPc5))
      FILTER(?mc = nltl:steelMaterialClassThree)
      FILTER(?sc = nltl:highTensileSteelCategory)
      FILTER(?t > 45 && ?t <= 50)
      BIND(nltl:steelGradeFh AS ?expected)
      $this nltl:requiredHullStructuralSteelGrade ?expected
    }
    UNION
    {
      FILTER(?pc IN (nltl:polarClassPc6,nltl:polarClassPc7))
      FILTER(?mc = nltl:steelMaterialClassThree)
      FILTER(?sc = nltl:highTensileSteelCategory)
      FILTER(?t <= 20)
      BIND(nltl:steelGradeDh AS ?expected)
      $this nltl:requiredHullStructuralSteelGrade ?expected
    }
    UNION
    {
      FILTER(?pc IN (nltl:polarClassPc6,nltl:polarClassPc7))
      FILTER(?mc = nltl:steelMaterialClassThree)
      FILTER(?sc = nltl:highTensileSteelCategory)
      FILTER(?t > 20 && ?t <= 50)
      BIND(nltl:steelGradeEh AS ?expected)
      $this nltl:requiredHullStructuralSteelGrade ?expected
    }
  }
}
""" .

