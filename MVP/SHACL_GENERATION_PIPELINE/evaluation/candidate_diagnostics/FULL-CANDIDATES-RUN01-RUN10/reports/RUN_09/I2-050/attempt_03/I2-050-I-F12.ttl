@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F12/stemAngle> ;
                    sh:resultMessage "Node ex:stemAngle->q:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/DEG>']" ;
                    sh:resultPath q:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path q:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F12/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class q:QuantityValue ; sh:property [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path q:unit ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path q:numericValue ] ]. See details for more information." ;
            sh:resultPath nltl:stemAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class q:QuantityValue ;
                            sh:property [ sh:minCount 1 ;
                                    sh:path q:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path q:unit ] ] ;
                    sh:path nltl:stemAngle ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F12/stemAngle> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F12/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasTableLookupCase" ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:tableLookupCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class q:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path q:unit ],
                                                [ sh:minCount 1 ;
                                                    sh:path q:numericValue ] ] ;
                                    sh:path nltl:crushingFailureClassFactor ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class q:QuantityValue ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:path q:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path q:unit ] ] ;
                                    sh:path nltl:flexuralFailureClassFactor ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class q:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path q:unit ],
                                                [ sh:minCount 1 ;
                                                    sh:path q:numericValue ] ] ;
                                    sh:path nltl:longitudinalStrengthClassFactor ] ] ;
                    sh:path nltl:hasTableLookupCase ] ] .

