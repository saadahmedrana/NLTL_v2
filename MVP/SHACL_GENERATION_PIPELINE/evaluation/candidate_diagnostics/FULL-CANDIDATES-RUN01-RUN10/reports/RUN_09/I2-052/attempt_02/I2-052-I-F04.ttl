@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/ship> ;
            sh:resultMessage "The ship must provide the externally determined interpolated value." ;
            sh:resultPath nltl:interpolatedValue ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must provide the externally determined interpolated value." ;
                    sh:minCount 1 ;
                    sh:path nltl:interpolatedValue ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/lowerPoint> ;
                            sh:resultMessage "Each interpolation point must provide an interpolation coordinate." ;
                            sh:resultPath nltl:interpolationCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nd2522bd10ec94fd3abe43657dd674c81b14 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/calculation> ;
                    sh:resultMessage "The calculation case must identify a lower interpolation endpoint." ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "The calculation case must identify a lower interpolation endpoint." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_052_InterpolationPointShape ;
                            sh:path nltl:interpolationLowerEndpoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/lowerPoint> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/lowerPoint> ;
                            sh:resultMessage "Each interpolation point must provide an interpolation coordinate." ;
                            sh:resultPath nltl:interpolationCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nd2522bd10ec94fd3abe43657dd674c81b14 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/calculation> ;
                    sh:resultMessage "The calculation case must provide an interpolation point." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "The calculation case must provide an interpolation point." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_052_InterpolationPointShape ;
                            sh:path nltl:hasInterpolationPoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/lowerPoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/ship> ;
            sh:resultMessage "The ship must provide at least one interpolation calculation case." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide at least one interpolation calculation case." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_052_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/calculation> ] .

_:N15f7e3877c6049ca811c510a7c3559c9 sh:class qudt:QuantityValue ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:nd2522bd10ec94fd3abe43657dd674c81b14 sh:message "Each interpolation point must provide an interpolation coordinate." ;
    sh:minCount 1 ;
