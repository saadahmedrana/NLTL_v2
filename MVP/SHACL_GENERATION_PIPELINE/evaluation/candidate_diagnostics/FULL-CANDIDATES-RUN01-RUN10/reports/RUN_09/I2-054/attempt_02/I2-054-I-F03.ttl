@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F03/ship> ;
            sh:resultMessage "Each hull-girder case distribution factor shall correspond to an interpolation result at the case longitudinal position normalized by L_UI." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each hull-girder case distribution factor shall correspond to an interpolation result at the case longitudinal position normalized by L_UI." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this a nltl:ship .
  ?this nltl:upperIceWaterlineLengthLUI ?length ;
        nltl:hasHullGirderBendingMomentCalculationCase ?hc .
  ?length qudt:numericValue ?lv .
  ?hc nltl:caseHullGirderLongitudinalPositionFromAft ?position ;
      nltl:caseBendingMomentDistributionFactor ?factor .
  ?position qudt:numericValue ?pv .
  ?factor qudt:numericValue ?fv .
  FILTER (xsd:decimal(?lv) > 0)
  FILTER NOT EXISTS {
    $this nltl:hasCalculationCase ?cc .
    ?cc nltl:hasInterpolationPoint ?ip .
    ?ip nltl:interpolationPointCoordinate ?coordinate ;
        nltl:interpolationPointResult ?result .
    ?coordinate qudt:numericValue ?cv .
    ?result qudt:numericValue ?rv .
    FILTER (ABS(xsd:decimal(?cv) - (xsd:decimal(?pv) / xsd:decimal(?lv))) <= 0.000001)
    FILTER (ABS(xsd:decimal(?rv) - xsd:decimal(?fv)) <= 0.000001)
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:I2_054_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F03/bendingCase> ;
                    sh:resultMessage "Less than 5 values on ex:bendingCase->nltl:hasInterpolationPoint" ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 5 ;
                            sh:node [ sh:class nltl:interpolationPoint ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:interpolationPointResult ],
                                        [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ],
                                                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ] ] ;
                                            sh:path nltl:interpolationPointCoordinate ] ] ;
                            sh:path nltl:hasInterpolationPoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F03/ship> ;
            sh:resultMessage "Each calculation case shall contain the interpolation-point structure." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each calculation case shall contain the interpolation-point structure." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:minCount 5 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ] ] ;
                                    sh:path nltl:hasInterpolationPoint ] ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F03/bendingCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F03/ship> ;
            sh:resultMessage "The ship shall provide one design vertical ice force at the bow in meganewtons." ;
            sh:resultPath nltl:designVerticalIceForceAtBow ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide one design vertical ice force at the bow in meganewtons." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designVerticalIceForceAtBow ] ] .

