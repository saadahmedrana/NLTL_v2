@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/ship> ;
            sh:resultMessage "Each hull-girder case distribution factor shall correspond to an interpolation result at the case longitudinal position normalized by L_UI." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each hull-girder case distribution factor shall correspond to an interpolation result at the case longitudinal position normalized by L_UI." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this a nltl:ship .
  ?this nltl:upperIceWaterlineLengthLUI ?length ;
        nltl:hasHullGirderBendingMomentCalculationCase ?hc .
  ?length qudt:numericValue ?lv .
  ?hc nltl:caseHullGirderLongitudinalPositionFromAft ?position ;
      nltl:caseBendingMomentDistributionFactor ?factor .
  ?position qudt:numericValue ?pv .
  ?factor qudt:numericValue ?fv .
  FILTER (xsd:decimal(?lv) > 0)
  FILTER NOT EXISTS {
    $this nltl:hasCalculationCase ?cc .
    ?cc nltl:hasInterpolationPoint ?ip .
    ?ip nltl:interpolationPointCoordinate ?coordinate ;
        nltl:interpolationPointResult ?result .
    ?coordinate qudt:numericValue ?cv .
    ?result qudt:numericValue ?rv .
    FILTER (ABS(xsd:decimal(?cv) - (xsd:decimal(?pv) / xsd:decimal(?lv))) <= 0.000001)
    FILTER (ABS(xsd:decimal(?rv) - xsd:decimal(?fv)) <= 0.000001)
  }
}
""" ] ;
