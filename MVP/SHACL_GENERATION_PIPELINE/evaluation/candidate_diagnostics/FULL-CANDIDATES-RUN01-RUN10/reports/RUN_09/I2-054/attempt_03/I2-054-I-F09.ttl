@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/ship> ;
            sh:resultMessage "Each hull-girder case must link its distribution factor to an interpolation result at its normalized longitudinal position, with the required piecewise-linear interpolation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each hull-girder case must link its distribution factor to an interpolation result at its normalized longitudinal position, with the required piecewise-linear interpolation." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineLengthLUI ?lq .
                ?lq qudt:numericValue ?l .
                $this nltl:hasHullGirderBendingMomentCalculationCase ?hc .
                ?hc nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
                ?pq qudt:numericValue ?p .
                ?hc nltl:caseBendingMomentDistributionFactor ?fq .
                ?fq qudt:numericValue ?f .
                FILTER(?l != 0)
                FILTER(?p >= 0 && ?p <= ?l)
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?cc .
                    ?cc nltl:hasInterpolationPoint ?ip .
                    ?ip nltl:interpolationPointCoordinate ?xq .
                    ?xq qudt:numericValue ?x .
                    ?ip nltl:interpolationPointResult ?rq .
                    ?rq qudt:numericValue ?r .
                    BIND(?p / ?l AS ?norm)
                    FILTER(ABS(?x - ?norm) <= 1e-9)
                    BIND(
                        IF(?norm <= 0.5,
                            2.0 * ?norm,
                            IF(?norm <= 0.7,
                                1.0,
                                IF(?norm <= 0.95,
                                    1.0 - 0.7 * ((?norm - 0.7) / 0.25),
                                    0.3 * ((1.0 - ?norm) / 0.05)
                                )
                            )
                        ) AS ?expected
                    )
                    FILTER(ABS(?r - ?expected) <= (ABS(?expected) * 1e-6 + 1e-9))
                    FILTER(ABS(?f - ?r) <= (ABS(?expected) * 1e-6 + 1e-9))
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_054_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/bendingCase> ;
                    sh:resultMessage "Less than 5 values on ex:bendingCase->nltl:hasInterpolationPoint" ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 5 ;
                            sh:node gen:I2_054_InterpolationPointShape ;
                            sh:path nltl:hasInterpolationPoint ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/bendingCase> ;
                    sh:resultMessage "The calculation case must contain the five required interpolation anchors: 0 at the aft end, 1.0 at 0.5 and 0.7 of the upper ice waterline length, 0.3 at 0.95, and 0 at the forward end." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "The calculation case must contain the five required interpolation anchors: 0 at the aft end, 1.0 at 0.5 and 0.7 of the upper ice waterline length, 0.3 at 0.95, and 0 at the forward end." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasInterpolationPoint ?p0 .
                    ?p0 nltl:interpolationPointCoordinate ?q0c ;
                        nltl:interpolationPointResult ?q0r .
                    ?q0c qudt:numericValue ?c0 .
                    ?q0r qudt:numericValue ?r0 .
                    FILTER(?c0 = 0.0 && ?r0 = 0.0)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasInterpolationPoint ?p05 .
                    ?p05 nltl:interpolationPointCoordinate ?q05c ;
                         nltl:interpolationPointResult ?q05r .
                    ?q05c qudt:numericValue ?c05 .
                    ?q05r qudt:numericValue ?r05 .
                    FILTER(?c05 = 0.5 && ?r05 = 1.0)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasInterpolationPoint ?p07 .
                    ?p07 nltl:interpolationPointCoordinate ?q07c ;
                         nltl:interpolationPointResult ?q07r .
                    ?q07c qudt:numericValue ?c07 .
                    ?q07r qudt:numericValue ?r07 .
                    FILTER(?c07 = 0.7 && ?r07 = 1.0)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasInterpolationPoint ?p095 .
                    ?p095 nltl:interpolationPointCoordinate ?q095c ;
                          nltl:interpolationPointResult ?q095r .
                    ?q095c qudt:numericValue ?c095 .
                    ?q095r qudt:numericValue ?r095 .
                    FILTER(?c095 = 0.95 && ?r095 = 0.3)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasInterpolationPoint ?p1 .
                    ?p1 nltl:interpolationPointCoordinate ?q1c ;
                        nltl:interpolationPointResult ?q1r .
                    ?q1c qudt:numericValue ?c1 .
                    ?q1r qudt:numericValue ?r1 .
                    FILTER(?c1 = 1.0 && ?r1 = 0.0)
                }
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_054_CalculationCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/bendingCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_054_CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:I2_054_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/bendingCase> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/caseDesignVerticalIceBendingMoment> ;
                            sh:resultMessage "Node ex:caseDesignVerticalIceBendingMoment->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/MegaN-M>']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/bendingCase> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
                    sh:resultPath nltl:caseDesignVerticalIceBendingMoment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:caseDesignVerticalIceBendingMoment ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/caseDesignVerticalIceBendingMoment> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_054_HullGirderCaseShape. See details for more information." ;
            sh:resultPath nltl:hasHullGirderBendingMomentCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:I2_054_HullGirderCaseShape ;
                    sh:path nltl:hasHullGirderBendingMomentCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/bendingCase> ] .

