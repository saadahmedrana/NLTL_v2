                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n4f3d209cee1943f8933f2dfa62044b3db22 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp1> ;
                            sh:resultMessage "Less than 1 values on ex:interp1->nltl:interpolationPointCoordinate" ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n4f3d209cee1943f8933f2dfa62044b3db18 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/bendingCase> ;
                    sh:resultMessage "Value does not conform to Shape gen:I2_054_InterpolationPointShape. See details for more information." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n4f3d209cee1943f8933f2dfa62044b3db16 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp1> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/bendingCase> ;
                    sh:resultMessage "Less than 5 values on ex:bendingCase->nltl:hasInterpolationPoint" ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n4f3d209cee1943f8933f2dfa62044b3db16 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_054_CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:I2_054_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/bendingCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/ship> ;
            sh:resultMessage "Each hull-girder case must link its distribution factor to an interpolation result at its normalized longitudinal position, with the required piecewise-linear interpolation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each hull-girder case must link its distribution factor to an interpolation result at its normalized longitudinal position, with the required piecewise-linear interpolation." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineLengthLUI ?lq .
                ?lq qudt:numericValue ?l .
                $this nltl:hasHullGirderBendingMomentCalculationCase ?hc .
                ?hc nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
                ?pq qudt:numericValue ?p .
                ?hc nltl:caseBendingMomentDistributionFactor ?fq .
                ?fq qudt:numericValue ?f .
                FILTER(?l != 0)
                FILTER(?p >= 0 && ?p <= ?l)
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?cc .
                    ?cc nltl:hasInterpolationPoint ?ip .
                    ?ip nltl:interpolationPointCoordinate ?xq .
                    ?xq qudt:numericValue ?x .
                    ?ip nltl:interpolationPointResult ?rq .
                    ?rq qudt:numericValue ?r .
                    BIND(?p / ?l AS ?norm)
                    FILTER(ABS(?x - ?norm) <= 1e-9)
                    BIND(
                        IF(?norm <= 0.5,
                            2.0 * ?norm,
                            IF(?norm <= 0.7,
                                1.0,
                                IF(?norm <= 0.95,
                                    1.0 - 0.7 * ((?norm - 0.7) / 0.25),
                                    0.3 * ((1.0 - ?norm) / 0.05)
                                )
                            )
                        ) AS ?expected
                    )
                    FILTER(ABS(?r - ?expected) <= (ABS(?expected) * 1e-6 + 1e-9))
                    FILTER(ABS(?f - ?r) <= (ABS(?expected) * 1e-6 + 1e-9))
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_054_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/ship> ] .

