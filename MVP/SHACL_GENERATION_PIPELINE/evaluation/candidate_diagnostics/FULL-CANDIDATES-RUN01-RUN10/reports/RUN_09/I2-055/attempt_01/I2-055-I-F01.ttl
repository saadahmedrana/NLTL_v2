@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F01/ship> ;
            sh:resultMessage "Design stress must not exceed permissible stress." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Design stress must not exceed permissible stress." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:designStress ?designQuantity .
  ?designQuantity qudt:numericValue ?designValue ;
                  qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
  $this nltl:permissibleStress ?permissibleQuantity .
  ?permissibleQuantity qudt:numericValue ?permissibleValue ;
                       qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
  FILTER (?designValue > ?permissibleValue)
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:I2_055_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F01/ship> ] .

