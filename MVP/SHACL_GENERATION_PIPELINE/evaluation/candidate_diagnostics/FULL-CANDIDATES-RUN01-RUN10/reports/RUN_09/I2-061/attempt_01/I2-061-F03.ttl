@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/case> ;
            sh:resultMessage "The prescribed analytical procedure must be used; direct calculation may not replace it." ;
            sh:resultPath nltl:calculationMethod ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/structure> ;
            sh:resultMessage "The assessed hull structure must provide its thickness in metres." ;
            sh:resultPath nltl:thickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b6 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/structure> ;
                            sh:resultMessage "The assessed hull structure must provide its thickness in metres." ;
                            sh:resultPath nltl:thickness ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b6 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/case> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-HullStructureShape>. See details for more information." ;
                    sh:resultPath nltl:calculationCaseAssessedHullStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b5 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/structure> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/case> ;
                    sh:resultMessage "The prescribed analytical procedure must be used; direct calculation may not replace it." ;
                    sh:resultPath nltl:calculationMethod ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-CalculationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:node <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/case> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/structure> ;
                    sh:resultMessage "The assessed hull structure must provide its thickness in metres." ;
                    sh:resultPath nltl:thickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b6 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/case> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-HullStructureShape>. See details for more information." ;
            sh:resultPath nltl:calculationCaseAssessedHullStructure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b5 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/structure> ] .

_:N213d62b3c18640f7aa60c7fee382e50f sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:N3aaff8edd4044fbc918cc0f3dbddf02f sh:class qudt:QuantityValue ;
    sh:property _:N213d62b3c18640f7aa60c7fee382e50f,
        [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:N5a157536f43e476ea2b003fd9963b6fa rdf:first nltl:prescribedAnalyticalProcedure ;
    rdf:rest () .

_:nf5df6db0ba7d4b7db1bdddaf70b9e359b3 sh:class nltl:calculationMethodValue ;
    sh:in _:N5a157536f43e476ea2b003fd9963b6fa ;
    sh:maxCount 1 ;
    sh:message "The prescribed analytical procedure must be used; direct calculation may not replace it." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:calculationMethod .

_:nf5df6db0ba7d4b7db1bdddaf70b9e359b5 sh:node <urn:nltl:generated-shape:I2-061-HullStructureShape> ;
    sh:path nltl:calculationCaseAssessedHullStructure .

_:nf5df6db0ba7d4b7db1bdddaf70b9e359b6 sh:maxCount 1 ;
    sh:message "The assessed hull structure must provide its thickness in metres." ;
    sh:minCount 1 ;
    sh:node _:N3aaff8edd4044fbc918cc0f3dbddf02f ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:thickness .

