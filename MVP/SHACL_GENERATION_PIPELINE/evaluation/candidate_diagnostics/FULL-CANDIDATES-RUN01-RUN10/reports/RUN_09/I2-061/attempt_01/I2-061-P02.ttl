@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P02/structure> ;
                            sh:resultMessage "The assessed hull structure must provide its thickness in metres." ;
                            sh:resultPath nltl:thickness ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b6 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P02/case> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-HullStructureShape>. See details for more information." ;
                    sh:resultPath nltl:calculationCaseAssessedHullStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b5 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P02/structure> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-CalculationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:node <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P02/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P02/structure> ;
            sh:resultMessage "The assessed hull structure must provide its thickness in metres." ;
            sh:resultPath nltl:thickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b6 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P02/structure> ;
                    sh:resultMessage "The assessed hull structure must provide its thickness in metres." ;
                    sh:resultPath nltl:thickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b6 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P02/case> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-HullStructureShape>. See details for more information." ;
            sh:resultPath nltl:calculationCaseAssessedHullStructure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b5 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P02/structure> ] .

_:N2ec6c1b6273d488db0d6960245da7fa9 sh:class qudt:QuantityValue ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ],
        [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:nf5df6db0ba7d4b7db1bdddaf70b9e359b5 sh:node <urn:nltl:generated-shape:I2-061-HullStructureShape> ;
    sh:path nltl:calculationCaseAssessedHullStructure .

_:nf5df6db0ba7d4b7db1bdddaf70b9e359b6 sh:maxCount 1 ;
    sh:message "The assessed hull structure must provide its thickness in metres." ;
    sh:minCount 1 ;
    sh:node _:N2ec6c1b6273d488db0d6960245da7fa9 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:thickness .

