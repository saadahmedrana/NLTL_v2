@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/structure> ;
                    sh:resultMessage "The assessed hull structure must provide its thickness in metres." ;
                    sh:resultPath nltl:thickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b6 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/case> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-HullStructureShape>. See details for more information." ;
            sh:resultPath nltl:calculationCaseAssessedHullStructure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b5 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/structure> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/structure> ;
                            sh:resultMessage "The assessed hull structure must provide its thickness in metres." ;
                            sh:resultPath nltl:thickness ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b6 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/case> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-HullStructureShape>. See details for more information." ;
                    sh:resultPath nltl:calculationCaseAssessedHullStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b5 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/structure> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/case> ;
                    sh:resultMessage "The prescribed analytical procedure must be used; direct calculation may not replace it." ;
                    sh:resultPath nltl:calculationMethod ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b3 ;
                    sh:value nltl:directCalculationMethodValue ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-CalculationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:node <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/structure> ;
            sh:resultMessage "The assessed hull structure must provide its thickness in metres." ;
            sh:resultPath nltl:thickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b6 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/case> ;
            sh:resultMessage "The prescribed analytical procedure must be used; direct calculation may not replace it." ;
            sh:resultPath nltl:calculationMethod ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape _:nf5df6db0ba7d4b7db1bdddaf70b9e359b3 ;
            sh:value nltl:directCalculationMethodValue ] .

_:N11fb0ce935af4b2e9069943061c184d3 sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

