@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/case> ;
                    sh:resultMessage "Node ex:case must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:prescribedAnalyticalProcedure ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"An applicable calculation case must use the prescribed analytical procedure.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:calculationMethod ] ] , [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:message Literal(\"A calculation case without an applicability method is not subject to this prescribed-procedure check.\") ; sh:path nltl:calculationMethod ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:I2_061_CalculationCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/ship> ;
            sh:resultMessage "Each calculation case must identify the applicable assessed hull structure and use the prescribed analytical procedure rather than a direct calculation." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "Each calculation case must identify the applicable assessed hull structure and use the prescribed analytical procedure rather than a direct calculation." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_061_CalculationCaseShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/case> ] .

