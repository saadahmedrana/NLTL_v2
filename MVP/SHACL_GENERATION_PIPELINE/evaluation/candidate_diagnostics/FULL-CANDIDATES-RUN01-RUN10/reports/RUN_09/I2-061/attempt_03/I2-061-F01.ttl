@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ;
                    sh:resultMessage "Node ex:case must not conform to shape [ rdf:type sh:PropertyShape ; sh:hasValue nltl:directCalculationMethodValue ; sh:message Literal(\"A direct calculation method must not be used as an alternative to the prescribed analytical procedure for this calculation case.\") ; sh:path nltl:calculationMethod ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NotConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-CalculationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:node <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ] .

