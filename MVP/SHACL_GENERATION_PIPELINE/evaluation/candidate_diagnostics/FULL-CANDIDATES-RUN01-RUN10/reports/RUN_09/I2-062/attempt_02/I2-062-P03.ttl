@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "Every load carrying stringer or web frame linked to the ship must form part of a grillage system." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Every load carrying stringer or web frame linked to the ship must form part of a grillage system." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member rdf:type ?memberType .
                FILTER (
                    ?memberType IN (
                        nltl:loadCarryingStringer,
                        nltl:webFrame
                    )
                )
                FILTER NOT EXISTS {
                    ?member nltl:partOfGrillageSystem ?grillage .
                    ?grillage rdf:type nltl:grillageSystem .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-062> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "The ship must record that direct calculation is used." ;
            sh:resultPath nltl:directCalculationUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n07343c45b34a4f37885d5dd7cd5b862db1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "The ship must record that direct calculation is used." ;
            sh:resultPath nltl:directCalculationUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n07343c45b34a4f37885d5dd7cd5b862db1 ] .

_:n07343c45b34a4f37885d5dd7cd5b862db1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record that direct calculation is used." ;
    sh:minCount 1 ;
    sh:path nltl:directCalculationUsed .

