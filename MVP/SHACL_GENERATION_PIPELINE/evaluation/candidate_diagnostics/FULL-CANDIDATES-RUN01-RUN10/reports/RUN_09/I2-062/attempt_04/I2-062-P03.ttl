@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "The ship shall record that direct calculation is used." ;
            sh:resultPath nltl:directCalculationUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nc6657e9176af4ce9b3bac7e987449336b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "Every linked load-carrying stringer or web frame shall be related to a grillage system through partOfGrillageSystem." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Every linked load-carrying stringer or web frame shall be related to a grillage system through partOfGrillageSystem." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a ?memberType .
                FILTER (
                    ?memberType IN (
                        nltl:loadCarryingStringer,
                        nltl:webFrame
                    )
                )
                FILTER NOT EXISTS {
                    ?member nltl:partOfGrillageSystem ?grillageSystem .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-062> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "The ship shall record that direct calculation is used." ;
            sh:resultPath nltl:directCalculationUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc6657e9176af4ce9b3bac7e987449336b1 ] .

_:nc6657e9176af4ce9b3bac7e987449336b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship shall record that direct calculation is used." ;
    sh:minCount 1 ;
    sh:path nltl:directCalculationUsed .

