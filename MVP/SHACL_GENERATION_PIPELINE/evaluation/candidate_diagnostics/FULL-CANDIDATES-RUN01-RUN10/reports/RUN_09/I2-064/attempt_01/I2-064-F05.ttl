@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F05/ship> ;
            sh:resultMessage "The ship shall provide one yield strength value in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide one yield strength value in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/schema/qudt/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:yieldStrength ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F05/flange> ;
                            sh:resultMessage "Each applicable member flange shall provide one nominal von Mises stress value in MPa." ;
                            sh:resultPath nltl:nominalFlangeVonMisesStress ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each applicable member flange shall provide one nominal von Mises stress value in MPa." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/schema/qudt/unit/MegaPA> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:nominalFlangeVonMisesStress ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F05/member> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-064-StructuralMemberFlangeShape>. See details for more information." ;
                    sh:resultPath nltl:hasStructuralMemberFlange ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-064-StructuralMemberFlangeShape> ;
                            sh:path nltl:hasStructuralMemberFlange ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F05/flange> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F05/nominalShearStress> ;
                                    sh:resultMessage "Node ex:nominalShearStress->qudt:unit does not contain a value in the set: ['<http://qudt.org/schema/qudt/unit/MegaPA>']" ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape [ sh:hasValue <http://qudt.org/schema/qudt/unit/MegaPA> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F05/web> ;
                            sh:resultMessage "Each applicable member web shall provide one nominal shear stress value in MPa." ;
                            sh:resultPath nltl:nominalShearStress ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each applicable member web shall provide one nominal shear stress value in MPa." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/schema/qudt/unit/MegaPA> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:nominalShearStress ] ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F05/nominalShearStress> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F05/member> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-064-StructuralMemberWebShape>. See details for more information." ;
                    sh:resultPath nltl:hasStructuralMemberWeb ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-064-StructuralMemberWebShape> ;
                            sh:path nltl:hasStructuralMemberWeb ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F05/web> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-064-StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-064-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F05/member> ] .

