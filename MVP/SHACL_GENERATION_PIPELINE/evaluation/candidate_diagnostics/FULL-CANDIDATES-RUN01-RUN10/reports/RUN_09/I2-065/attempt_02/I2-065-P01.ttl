@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P01/calculation> ;
            sh:resultMessage "A nonlinear calculation case must be associated with ship-level buckling-response and plastic-deformation capture." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A nonlinear calculation case must be associated with ship-level buckling-response and plastic-deformation capture." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                ?ship nltl:hasCalculationCase $this .
                FILTER (
                    NOT EXISTS {
                        ?ship nltl:bucklingResponse ?buckling .
                        FILTER (isLiteral(?buckling) && datatype(?buckling) = xsd:string)
                    }
                    ||
                    NOT EXISTS {
                        ?ship nltl:plasticDeformation ?plastic .
                        FILTER (isLiteral(?plastic) && datatype(?plastic) = xsd:string)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:NonlinearCaptureShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P01/calculation> ] .

