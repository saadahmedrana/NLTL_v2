@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P01/ship> ;
            sh:resultMessage "For a ship with a nonlinear calculation case, buckling and plastic deformation capture and the fracture, major buckling, and yielding margin inputs are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a ship with a nonlinear calculation case, buckling and plastic deformation capture and the fracture, major buckling, and yielding margin inputs are required." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:ship .
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                FILTER (
                    NOT EXISTS {
                        $this nltl:bucklingResponse ?buckling .
                        FILTER (datatype(?buckling) = xsd:string)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:plasticDeformation ?plastic .
                        FILTER (datatype(?plastic) = xsd:string)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:fractureMargin ?fracture .
                        ?fracture qudt:numericValue ?fractureNumber ;
                                 qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (datatype(?fractureNumber) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:majorBucklingMargin ?major .
                        ?major qudt:numericValue ?majorNumber ;
                               qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (datatype(?majorNumber) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:yieldingMargin ?yielding .
                        ?yielding qudt:numericValue ?yieldingNumber ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (datatype(?yieldingNumber) = xsd:decimal)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-065-ShipReadinessShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P01/ship> ] .

