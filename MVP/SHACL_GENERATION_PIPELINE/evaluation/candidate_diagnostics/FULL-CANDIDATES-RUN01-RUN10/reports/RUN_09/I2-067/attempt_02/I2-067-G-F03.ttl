@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F03/ship> ;
            sh:resultMessage "Strength continuity must be asserted as true for every structural connection of the ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Strength continuity must be asserted as true for every structural connection of the ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:ship .
                $this nltl:structuralConnection ?connection .
                FILTER NOT EXISTS {
                    $this nltl:strengthContinuityStatus true
                }
                FILTER NOT EXISTS {
                    $this nltl:strengthContinuityStatus ?nonTrueStatus .
                    FILTER (?nonTrueStatus != true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_067_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F03/ship> ] .

