@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-P01/ship> ;
            sh:resultMessage "A ship with structural connections must provide one boolean strength-continuity status." ;
            sh:resultPath nltl:strengthContinuityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "A ship with structural connections must provide one boolean strength-continuity status." ;
                    sh:minCount 1 ;
                    sh:path nltl:strengthContinuityStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-P01/ship> ;
            sh:resultMessage "Strength continuity must be ensured at all structural connections." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Strength continuity must be ensured at all structural connections." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:structuralConnection ?connection .
                FILTER NOT EXISTS {
                    $this nltl:strengthContinuityStatus true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-067-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-P01/ship> ] .

