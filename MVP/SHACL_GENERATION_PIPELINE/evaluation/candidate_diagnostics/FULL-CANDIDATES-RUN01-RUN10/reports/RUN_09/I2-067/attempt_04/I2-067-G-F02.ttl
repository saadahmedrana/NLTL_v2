@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F02/ship> ;
            sh:resultMessage "A ship with a structural connection must have strengthContinuityStatus true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A ship with a structural connection must have strengthContinuityStatus true." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:structuralConnection ?connection .
                FILTER NOT EXISTS {
                    $this nltl:strengthContinuityStatus "true"^^xsd:boolean .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-067> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F02/ship> ] .

