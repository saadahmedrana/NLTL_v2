@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-F01/ship> ;
            sh:resultMessage "A ship designed for at least thin first-year ice with possible old-ice inclusions and declared as not Category A must have Category B." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship designed for at least thin first-year ice with possible old-ice inclusions and declared as not Category A must have Category B." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:designIceCondition ?designCondition ;
                      nltl:shipCategory ?category .
                FILTER (
                    ?designCondition = nltl:thinFirstYearIceWithPossibleOldIceInclusions
                    && ?category != nltl:polarShipCategoryA
                    && ?category != nltl:polarShipCategoryB
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO002Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-F01/ship> ] .

