@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F02/ship> ;
            sh:resultMessage "When the ice origin is sea ice, winter growth is not more than one, and thickness is between 0.3 m and 2.0 m inclusive, the ice type must be first-year ice." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the ice origin is sea ice, winter growth is not more than one, and thickness is between 0.3 m and 2.0 m inclusive, the ice type must be first-year ice." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceOriginType ?origin ;
                      nltl:winterGrowthCount ?growth ;
                      nltl:iceThickness ?thicknessNode .
                ?thicknessNode qudt:numericValue ?thickness .

                FILTER (?origin = nltl:seaIceOrigin)
                FILTER (?growth <= 1)
                FILTER (?thickness >= 0.3 && ?thickness <= 2.0)

                FILTER NOT EXISTS {
                    $this nltl:iceTypeClassification nltl:firstYearIce
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-004> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F02/ship> ] .

