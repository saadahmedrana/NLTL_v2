@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-P03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in <urn:nltl:generated-shape:IMO-007-OpenWaterIceConditionShape> , <urn:nltl:generated-shape:IMO-007-NonOpenWaterIceConditionShape>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-007-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-P03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-P03/ship> ;
            sh:resultMessage "Node ex:ship->nltl:iceConditionClassification does not contain a value in the set: ['nltl:openWaterIceCondition']" ;
            sh:resultPath nltl:iceConditionClassification ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:openWaterIceCondition ;
                    sh:minCount 1 ;
                    sh:path nltl:iceConditionClassification ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-P03/ship> ;
            sh:resultMessage "The ice condition classification must identify a non-open-water condition for this applicability branch." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The ice condition classification must identify a non-open-water condition for this applicability branch." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification ?classification .
                FILTER (?classification != nltl:openWaterIceCondition)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-007-NonOpenWaterIceConditionShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-P03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-P03/ship> ;
            sh:resultMessage "Node ex:ship->nltl:iceOfLandOriginPresent does not contain a value in the set: ['Literal(\"false\" = False, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:iceOfLandOriginPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue false ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:iceOfLandOriginPresent ] ] .

