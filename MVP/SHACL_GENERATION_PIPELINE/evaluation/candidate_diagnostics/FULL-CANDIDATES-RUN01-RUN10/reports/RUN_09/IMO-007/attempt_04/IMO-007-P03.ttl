@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-P03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype nltl:iceConditionValue ; sh:hasValue nltl:openWaterIceCondition ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Open-water classification is required for the open-water branch.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceConditionClassification ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("No ice of land origin may be present in open water.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceOfLandOriginPresent ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Open-water ships must provide sea ice concentration.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Sea ice concentration must use the canonical unitless unit.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Sea ice concentration must provide a numeric value.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:seaIceConcentration ] ; sh:sparql [ sh:message Literal("For open water, sea ice concentration must be less than 1.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:seaIceConcentration ?quantity .
                        ?quantity qudt:numericValue ?value .
                        FILTER (?value >= 1)
                    }
                ") ] ] , [ sh:sparql [ sh:message Literal("The non-open-water branch requires an existing ice-condition classification that is not open water.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>

                    SELECT $this
                    WHERE {
                        $this nltl:iceConditionClassification ?condition .
                        FILTER (?condition != nltl:openWaterIceCondition)
                        FILTER NOT EXISTS {
                            $this nltl:iceConditionClassification nltl:openWaterIceCondition .
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_007_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-P03/ship> ] .

