@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:thinFirstYearIce ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A ship classified as thin first-year ice shall have the thin first-year ice classification.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceTypeClassification ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("0.7", datatype=xsd:decimal) ; sh:message Literal("Ice thickness for thin first-year ice shall be between 0.3 m and 0.7 m inclusive.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("0.3", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Ice thickness shall use metres as its unit.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:iceThickness ] ] , [ sh:or ( [ sh:property [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:path nltl:iceTypeClassification ] ] [ sh:sparql [ sh:message Literal("A non-applicable ship shall not have thin first-year ice as its classification.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                FILTER (
                                    EXISTS {
                                        $this nltl:iceTypeClassification nltl:thinFirstYearIce .
                                    }
                                    ||
                                    NOT EXISTS {
                                        $this nltl:iceTypeClassification ?classification .
                                        FILTER (?classification != nltl:thinFirstYearIce)
                                    }
                                )
                            }
                        ") ] ] ) ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_008_ThinFirstYearIceShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-F02/ship> ] .

