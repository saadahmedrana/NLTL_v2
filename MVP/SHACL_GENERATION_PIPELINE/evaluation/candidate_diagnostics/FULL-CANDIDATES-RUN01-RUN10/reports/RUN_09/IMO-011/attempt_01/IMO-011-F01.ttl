@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F01/obs1> ;
                    sh:resultMessage "Each daily low-temperature observation must have one calendar date." ;
                    sh:resultPath nltl:dailyTemperatureObservationDate ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:date ;
                            sh:maxCount 1 ;
                            sh:message "Each daily low-temperature observation must have one calendar date." ;
                            sh:minCount 1 ;
                            sh:path nltl:dailyTemperatureObservationDate ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape nltl:IMO011_DailyObservationShape. See details for more information." ;
            sh:resultPath nltl:hasDailyLowTemperatureObservation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltl:IMO011_DailyObservationShape ;
                    sh:path nltl:hasDailyLowTemperatureObservation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F01/obs1> ] .

