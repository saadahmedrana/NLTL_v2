@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F02/obs1> ;
                    sh:resultMessage "Each daily low-temperature observation must carry one temperature value in degrees Celsius." ;
                    sh:resultPath nltl:dailyLowTemperature ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each daily low-temperature observation must carry one temperature value in degrees Celsius." ;
                            sh:minCount 1 ;
                            sh:node nltl:IMO011_TemperatureQuantityShape ;
                            sh:path nltl:dailyLowTemperature ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape nltl:IMO011_DailyObservationShape. See details for more information." ;
            sh:resultPath nltl:hasDailyLowTemperatureObservation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltl:IMO011_DailyObservationShape ;
                    sh:path nltl:hasDailyLowTemperatureObservation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F02/obs1> ] .

