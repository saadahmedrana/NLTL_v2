@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in nltl:IMO011_DataPeriodAtLeastTenShape , nltl:IMO011_DataPeriodBelowTenShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltl:IMO011_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F05/ship> ] .

