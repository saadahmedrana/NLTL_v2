@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F01/obs1> ;
                    sh:resultMessage "Less than 1 values on ex:obs1->nltl:dailyTemperatureObservationDate" ;
                    sh:resultPath nltl:dailyTemperatureObservationDate ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:date ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:dailyTemperatureObservationDate ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO011_DailyObservationShape. See details for more information." ;
            sh:resultPath nltl:hasDailyLowTemperatureObservation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:dailyLowTemperatureObservation ;
                    sh:minCount 1 ;
                    sh:node gen:IMO011_DailyObservationShape ;
                    sh:path nltl:hasDailyLowTemperatureObservation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F01/obs1> ] .

