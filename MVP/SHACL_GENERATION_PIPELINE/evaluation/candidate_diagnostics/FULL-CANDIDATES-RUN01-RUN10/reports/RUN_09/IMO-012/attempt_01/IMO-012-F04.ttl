@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-012-F04/lowestMdltValue> ;
                    sh:resultMessage "The lowest MDLT must use degrees Celsius." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue unit:DEG_C ;
                            sh:maxCount 1 ;
                            sh:message "The lowest MDLT must use degrees Celsius." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-012-F04/ship> ;
            sh:resultMessage "The ship must specify its lowest MDLT in degrees Celsius." ;
            sh:resultPath nltl:lowestMdlt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must specify its lowest MDLT in degrees Celsius." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:DEG_C ;
                                    sh:maxCount 1 ;
                                    sh:message "The lowest MDLT must use degrees Celsius." ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:lowestMdlt ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-012-F04/lowestMdltValue> ] .

