@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/certificate> ;
                    sh:resultMessage "The Polar Ship Certificate form shall correspond to the Appendix I model." ;
                    sh:resultPath nltl:certificateFormModel ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:certificateFormModelValue ;
                            sh:hasValue nltl:appendixIPolarShipCertificateModel ;
                            sh:message "The Polar Ship Certificate form shall correspond to the Appendix I model." ;
                            sh:minCount 1 ;
                            sh:path nltl:certificateFormModel ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ;
            sh:resultMessage "The ship shall have a Polar Ship Certificate corresponding to the Appendix I model." ;
            sh:resultPath nltl:hasPolarShipCertificate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarShipCertificateForm ;
                    sh:message "The ship shall have a Polar Ship Certificate corresponding to the Appendix I model." ;
                    sh:minCount 1 ;
                    sh:node gs:IMO_016_CertificateFormShape ;
                    sh:path nltl:hasPolarShipCertificate ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/certificate> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:string ; sh:in ( Literal(\"English\") Literal(\"French\") Literal(\"Spanish\") ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:certificateLanguage ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"A translation into English, French, or Spanish is required when the certificate language is another language.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:approvedTranslationPresent ], [ sh:datatype xsd:string ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:certificateLanguage ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO_016_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ] .

