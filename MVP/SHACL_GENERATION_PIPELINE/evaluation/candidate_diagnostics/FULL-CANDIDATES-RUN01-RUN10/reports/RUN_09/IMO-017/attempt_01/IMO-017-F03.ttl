@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "Polar Ship Certificate validity, survey, and endorsement dates shall match the corresponding SOLAS certificate schedule dates." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Polar Ship Certificate validity, survey, and endorsement dates shall match the corresponding SOLAS certificate schedule dates." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?date ;
                            nltl:certificateScheduleDateType ?category .
                    FILTER (
                        ?category = nltl:validityDateCategory ||
                        ?category = nltl:surveyDateCategory ||
                        ?category = nltl:endorsementDateCategory
                    )
                    FILTER NOT EXISTS {
                        {
                            FILTER (?category = nltl:validityDateCategory)
                            $this nltl:polarCertificateValidityDates ?date
                        }
                        UNION
                        {
                            FILTER (?category = nltl:surveyDateCategory)
                            $this nltl:surveyDates ?date
                        }
                        UNION
                        {
                            FILTER (?category = nltl:endorsementDateCategory)
                            $this nltl:endorsementDates ?date
                        }
                    }
                }
                UNION
                {
                    $this nltl:polarCertificateValidityDates ?date .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?date ;
                                nltl:certificateScheduleDateType nltl:validityDateCategory
                    }
                }
                UNION
                {
                    $this nltl:surveyDates ?date .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?date ;
                                nltl:certificateScheduleDateType nltl:surveyDateCategory
                    }
                }
                UNION
                {
                    $this nltl:endorsementDates ?date .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?date ;
                                nltl:certificateScheduleDateType nltl:endorsementDateCategory
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-017-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "The Polar Ship Certificate shall include a supplement." ;
            sh:resultPath nltl:polarCertificateSupplementPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n8ebe1dd570124fd4a6cee686271036a4b4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "The ship shall have a Polar Certificate supplement with required equipment records." ;
            sh:resultPath nltl:hasPolarCertificateSupplement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall have a Polar Certificate supplement with required equipment records." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-017-PolarSupplementShape> ;
                    sh:path nltl:hasPolarCertificateSupplement ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "The Polar Ship Certificate shall include a supplement." ;
            sh:resultPath nltl:polarCertificateSupplementPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n8ebe1dd570124fd4a6cee686271036a4b4 ] .

_:n8ebe1dd570124fd4a6cee686271036a4b4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The Polar Ship Certificate shall include a supplement." ;
    sh:minCount 1 ;
    sh:path nltl:polarCertificateSupplementPresent .

