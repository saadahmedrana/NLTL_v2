@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-018-F01/ship> ;
            sh:resultMessage "When an ice capability methodology is applicable, the certificate methodology reference must be present and administration acceptance must be approved." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-018> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-018-F01/ship> ] .

