@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-018-F03/ship> ;
            sh:resultMessage "When an ice capability methodology is applicable, the certificate methodology reference must be present and administration acceptance must be approved." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-018> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-018-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-018-F03/ship> ;
            sh:resultMessage "The ice capability methodology applicability decision must be recorded as one boolean value." ;
            sh:resultPath nltl:iceCapabilityMethodologyApplicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ice capability methodology applicability decision must be recorded as one boolean value." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceCapabilityMethodologyApplicable ] ] .

