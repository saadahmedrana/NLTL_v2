@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F01/ship> ;
            sh:resultMessage "Polar service temperature must be at least 10 degrees Celsius below the lowest MDLT when the ship operates in low air temperature." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Polar service temperature must be at least 10 degrees Celsius below the lowest MDLT when the ship operates in low air temperature." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true ;
                      nltl:lowestMdlt ?lowestNode ;
                      nltl:polarServiceTemperature ?pstNode .
                ?lowestNode qudt:numericValue ?lowest ;
                            qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
                ?pstNode qudt:numericValue ?pst ;
                           qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
                FILTER (?pst > (?lowest - 10))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_019_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F01/ship> ] .

