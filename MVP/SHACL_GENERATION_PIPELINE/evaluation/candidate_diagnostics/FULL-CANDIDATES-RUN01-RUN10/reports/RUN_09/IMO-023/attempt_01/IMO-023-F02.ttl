@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-023-F02/ship> ;
            sh:resultMessage "The ship must record procedures for avoiding conditions that exceed its capabilities." ;
            sh:resultPath nltl:capabilityExceedanceAvoidanceProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:message "The ship must record procedures for avoiding conditions that exceed its capabilities." ;
                    sh:minCount 1 ;
                    sh:path nltl:capabilityExceedanceAvoidanceProcedurePresent ] ] .

