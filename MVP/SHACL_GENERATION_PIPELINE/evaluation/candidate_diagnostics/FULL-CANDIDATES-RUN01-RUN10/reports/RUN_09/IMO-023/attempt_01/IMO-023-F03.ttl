@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-023-F03/ship> ;
            sh:resultMessage "The ship must record procedures for normal operations." ;
            sh:resultPath nltl:normalOperationProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nea453f0b060d4789bd1aca5d28d5e19cb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-023-F03/ship> ;
            sh:resultMessage "The ship must record procedures for normal operations." ;
            sh:resultPath nltl:normalOperationProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nea453f0b060d4789bd1aca5d28d5e19cb1 ] .

_:nea453f0b060d4789bd1aca5d28d5e19cb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship must record procedures for normal operations." ;
    sh:minCount 1 ;
    sh:path nltl:normalOperationProcedurePresent .

