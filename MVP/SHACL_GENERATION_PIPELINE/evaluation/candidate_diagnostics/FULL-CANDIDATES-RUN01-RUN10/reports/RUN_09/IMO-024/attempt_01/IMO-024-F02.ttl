@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-024-F02/ship> ;
            sh:resultMessage "The ship shall record that polar-water incident procedures are included or referenced in the PWOM." ;
            sh:resultPath nltl:polarIncidentProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n08abe6ccd82d4245ba5854a874491e17b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-024-F02/ship> ;
            sh:resultMessage "The ship shall record that polar-water incident procedures are included or referenced in the PWOM." ;
            sh:resultPath nltl:polarIncidentProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n08abe6ccd82d4245ba5854a874491e17b1 ] .

_:n08abe6ccd82d4245ba5854a874491e17b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall record that polar-water incident procedures are included or referenced in the PWOM." ;
    sh:minCount 1 ;
    sh:path nltl:polarIncidentProcedurePresent .

