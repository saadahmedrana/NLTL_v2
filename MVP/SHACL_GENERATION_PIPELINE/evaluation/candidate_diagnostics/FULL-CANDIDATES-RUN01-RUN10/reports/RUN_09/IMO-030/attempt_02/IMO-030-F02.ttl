@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:iceOperationApplicable ] ] , [ sh:or ( [ sh:property [ sh:datatype xsd:string ; sh:message Literal(\"Independent-operation limitations shall be specified when that operating mode applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:independentOperationLimits ] ] [ sh:property [ sh:datatype xsd:string ; sh:message Literal(\"Escorted-operation limitations shall be specified when escorted operation applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:escortedOperationLimits ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When ice operations are applicable, the PWOM shall include applicable escort or icebreaker-assistance requirements.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:escortRequirementsPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When ice operations are applicable, the PWOM shall include ice-operation monitoring and safety procedures.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceSafetyMonitoringProcedurePresent ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:iceOperationApplicable ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_030_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F02/ship> ] .

