@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F03/ship> ;
            sh:resultMessage "Approval must reference an Organization-acceptable standard or an equivalent-safety standard." ;
            sh:resultPath nltl:approvalStandard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "standard acceptable to the Organization" "another standard offering an equivalent level of safety" ) ;
                    sh:message "Approval must reference an Organization-acceptable standard or an equivalent-safety standard." ;
                    sh:minCount 1 ;
                    sh:path nltl:approvalStandard ] ;
            sh:value "standard acceptable to the Organization"^^xsd:string ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode nltl:evidenceStateRejected ;
                    sh:resultMessage "Value nltl:evidenceStateRejected not in list ['nltl:evidenceStateApproved']" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceState ;
                            sh:in ( nltl:evidenceStateApproved ) ] ;
                    sh:value nltl:evidenceStateRejected ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F03/ship> ;
            sh:resultMessage "The exposed-structure material approval status must be Approved." ;
            sh:resultPath nltl:materialApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The exposed-structure material approval status must be Approved." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:evidenceState ;
                            sh:in ( nltl:evidenceStateApproved ) ] ;
                    sh:path nltl:materialApprovalStatus ] ;
            sh:value nltl:evidenceStateRejected ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F03/ship> ;
            sh:resultMessage "Approval must identify the Administration or a recognized organization accepted by the Administration." ;
            sh:resultPath nltl:approvingAuthority ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "Administration" "recognized organization accepted by the Administration" ) ;
                    sh:message "Approval must identify the Administration or a recognized organization accepted by the Administration." ;
                    sh:minCount 1 ;
                    sh:path nltl:approvingAuthority ] ;
            sh:value "Administration"^^xsd:string ] .

