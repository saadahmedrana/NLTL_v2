@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ] ] , [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("30", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("30", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloGM-PER-M2 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:deckIcingAllowance ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("7.5", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("7.5", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloGM-PER-M2 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:sideIcingAllowance ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN-M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:continuousSurfaceStaticMoment ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN-M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:discontinuousSurfaceStaticMoment ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M2 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:continuousSurfaceProjectedArea ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M2 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:discontinuousSurfaceProjectedArea ] ; sh:sparql [ sh:message Literal("When ice accretion is likely, discontinuous projected area and static moment must equal the continuous values multiplied by 1.05 and 1.10, respectively, within a relative tolerance of 1e-6 and an absolute tolerance of 1e-9.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:iceAccretionLikely true ;
                              nltl:continuousSurfaceProjectedArea ?continuousAreaNode ;
                              nltl:discontinuousSurfaceProjectedArea ?discontinuousAreaNode ;
                              nltl:continuousSurfaceStaticMoment ?continuousMomentNode ;
                              nltl:discontinuousSurfaceStaticMoment ?discontinuousMomentNode .

                        ?continuousAreaNode qudt:numericValue ?continuousArea .
                        ?discontinuousAreaNode qudt:numericValue ?discontinuousArea .
                        ?continuousMomentNode qudt:numericValue ?continuousMoment .
                        ?discontinuousMomentNode qudt:numericValue ?discontinuousMoment .

                        BIND(?continuousArea * 1.05 AS ?expectedArea)
                        BIND(?continuousMoment * 1.10 AS ?expectedMoment)
                        BIND(IF(ABS(?expectedArea) * 0.000001 > 0.000000001,
                                ABS(?expectedArea) * 0.000001,
                                0.000000001) AS ?areaTolerance)
                        BIND(IF(ABS(?expectedMoment) * 0.000001 > 0.000000001,
                                ABS(?expectedMoment) * 0.000001,
                                0.000000001) AS ?momentTolerance)

                        FILTER(
                            ?discontinuousArea < (?expectedArea - ?areaTolerance) ||
                            ?discontinuousArea > (?expectedArea + ?areaTolerance) ||
                            ?discontinuousMoment < (?expectedMoment - ?momentTolerance) ||
                            ?discontinuousMoment > (?expectedMoment + ?momentTolerance)
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-033-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F04/ship> ] .

