@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-P02/ship> ;
            sh:resultMessage "The PWOM shall state that icing allowance information is present." ;
            sh:resultPath nltl:polarWaterOperationalManualIcingAllowanceInformationPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc81f41bc0b244a828e03ed80d064bd7cb3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-P02/ship> ;
            sh:resultMessage "The PWOM shall state that icing allowance information is present." ;
            sh:resultPath nltl:polarWaterOperationalManualIcingAllowanceInformationPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nc81f41bc0b244a828e03ed80d064bd7cb3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-P02/ship> ;
            sh:resultMessage "Stability calculation icing allowance values are required for comparison." ;
            sh:resultPath nltl:stabilityCalculationIcingAllowanceValues ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "Stability calculation icing allowance values are required for comparison." ;
                    sh:minCount 1 ;
                    sh:path nltl:stabilityCalculationIcingAllowanceValues ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-P02/ship> ;
            sh:resultMessage "The PWOM icing allowance values shall match the stability calculation values." ;
            sh:resultPath nltl:polarWaterOperationalManualIcingAllowanceValues ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:equals nltl:stabilityCalculationIcingAllowanceValues ;
                    sh:maxCount 1 ;
                    sh:message "The PWOM icing allowance values shall match the stability calculation values." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarWaterOperationalManualIcingAllowanceValues ] ] .

_:nc81f41bc0b244a828e03ed80d064bd7cb3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The PWOM shall state that icing allowance information is present." ;
    sh:minCount 1 ;
    sh:path nltl:polarWaterOperationalManualIcingAllowanceInformationPresent .

