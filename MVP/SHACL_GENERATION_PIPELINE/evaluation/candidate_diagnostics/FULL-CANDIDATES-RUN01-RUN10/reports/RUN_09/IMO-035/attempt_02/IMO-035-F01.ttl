@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F01/pwomRecord> ;
                    sh:resultMessage "The polar water operational manual record shall state that icing allowance information is present." ;
                    sh:resultPath nltl:polarWaterOperationalManualIcingAllowanceInformationPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:message "The polar water operational manual record shall state that icing allowance information is present." ;
                            sh:minCount 1 ;
                            sh:path nltl:polarWaterOperationalManualIcingAllowanceInformationPresent ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F01/ship> ;
            sh:resultMessage "A ship shall identify its polar water operational manual record containing the icing allowance information." ;
            sh:resultPath nltl:hasPolarWaterOperationalManualRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A ship shall identify its polar water operational manual record containing the icing allowance information." ;
                    sh:minCount 1 ;
                    sh:node nltl:IMO035PWOMRecordShape ;
                    sh:path nltl:hasPolarWaterOperationalManualRecord ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F01/pwomRecord> ] .

