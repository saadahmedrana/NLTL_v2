@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F02/ship> ;
            sh:resultMessage "The polar water operational manual icing allowance values shall match the stability calculation icing allowance values." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The polar water operational manual icing allowance values shall match the stability calculation icing allowance values." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasPolarWaterOperationalManualRecord ?pwomRecord .
                $this nltl:hasStabilityCalculationRecord ?stabilityRecord .
                ?pwomRecord nltl:polarWaterOperationalManualIcingAllowanceValues ?pwomValue .
                ?stabilityRecord nltl:stabilityCalculationIcingAllowanceValues ?stabilityValue .
                FILTER (?pwomValue != ?stabilityValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:IMO035ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F02/ship> ] .

