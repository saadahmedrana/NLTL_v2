@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F03/ship> ;
            sh:resultMessage "A ship shall identify its polar water operational manual record containing the icing allowance information." ;
            sh:resultPath nltl:hasPolarWaterOperationalManualRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A ship shall identify its polar water operational manual record containing the icing allowance information." ;
                    sh:minCount 1 ;
                    sh:node nltl:IMO035PWOMRecordShape ;
                    sh:path nltl:hasPolarWaterOperationalManualRecord ] ] .

