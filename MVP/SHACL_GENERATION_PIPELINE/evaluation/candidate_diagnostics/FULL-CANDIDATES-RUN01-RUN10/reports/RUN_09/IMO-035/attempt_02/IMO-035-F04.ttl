@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F04/ship> ;
            sh:resultMessage "A ship shall identify its stability calculation record containing the icing allowance values." ;
            sh:resultPath nltl:hasStabilityCalculationRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A ship shall identify its stability calculation record containing the icing allowance values." ;
                    sh:minCount 1 ;
                    sh:node nltl:IMO035StabilityRecordShape ;
                    sh:path nltl:hasStabilityCalculationRecord ] ] .

