@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F05/pwomRecord> ;
                    sh:resultMessage "The polar water operational manual record shall provide icing allowance values." ;
                    sh:resultPath nltl:polarWaterOperationalManualIcingAllowanceValues ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:string ;
                            sh:message "The polar water operational manual record shall provide icing allowance values." ;
                            sh:minCount 1 ;
                            sh:path nltl:polarWaterOperationalManualIcingAllowanceValues ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F05/pwomRecord> ;
                    sh:resultMessage "The polar water operational manual record shall state that icing allowance information is present." ;
                    sh:resultPath nltl:polarWaterOperationalManualIcingAllowanceInformationPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n72469a55bbda4e5b8e9667dff0123fafb4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F05/pwomRecord> ;
                    sh:resultMessage "The polar water operational manual record shall state that icing allowance information is present." ;
                    sh:resultPath nltl:polarWaterOperationalManualIcingAllowanceInformationPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n72469a55bbda4e5b8e9667dff0123fafb4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F05/ship> ;
            sh:resultMessage "A ship shall identify its polar water operational manual record containing the icing allowance information." ;
            sh:resultPath nltl:hasPolarWaterOperationalManualRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A ship shall identify its polar water operational manual record containing the icing allowance information." ;
                    sh:minCount 1 ;
                    sh:node nltl:IMO035PWOMRecordShape ;
                    sh:path nltl:hasPolarWaterOperationalManualRecord ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F05/pwomRecord> ] .

_:n72469a55bbda4e5b8e9667dff0123fafb4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The polar water operational manual record shall state that icing allowance information is present." ;
    sh:minCount 1 ;
    sh:path nltl:polarWaterOperationalManualIcingAllowanceInformationPresent .

