@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F02/ship> ;
            sh:resultMessage "Transverse penetration must be exactly 760 mm." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Transverse penetration must be exactly 760 mm." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:transversePenetration ?penetrationNode .
                ?penetrationNode qudt:numericValue ?penetration .
                FILTER (?penetration < 760 || ?penetration > 760)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO038ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F02/ship> ] .

