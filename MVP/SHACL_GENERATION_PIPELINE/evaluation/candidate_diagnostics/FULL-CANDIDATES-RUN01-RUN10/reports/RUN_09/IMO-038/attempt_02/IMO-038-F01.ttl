@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ;
            sh:resultMessage "longitudinalDamageExtent must equal 4.5% or 1.5% of upperIceWaterlineLength according to damageCenterForwardOfMaxBreadth." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "longitudinalDamageExtent must equal 4.5% or 1.5% of upperIceWaterlineLength according to damageCenterForwardOfMaxBreadth." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthNode ;
                      nltl:longitudinalDamageExtent ?extentNode .
                ?lengthNode qudt:numericValue ?length ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                ?extentNode qudt:numericValue ?actual ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                BIND(IF(?forward = true,
                        (?length * 0.045),
                        (?length * 0.015)) AS ?expected)
                BIND((?expected * 0.000001) + 0.000001 AS ?tolerance)
                FILTER (
                    ?actual < (?expected - ?tolerance) ||
                    ?actual > (?expected + ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO038Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ] .

