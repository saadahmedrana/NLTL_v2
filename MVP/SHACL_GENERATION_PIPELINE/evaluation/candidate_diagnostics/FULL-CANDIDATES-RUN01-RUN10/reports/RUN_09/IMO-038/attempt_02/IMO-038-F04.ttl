@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F04/ship> ;
            sh:resultMessage "selectedVerticalDamagePosition must be between the keel and 1.20 times upperIceWaterlineDraught." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "selectedVerticalDamagePosition must be between the keel and 1.20 times upperIceWaterlineDraught." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDraught ?draughtNode ;
                      nltl:selectedVerticalDamagePosition ?positionNode .
                ?draughtNode qudt:numericValue ?draught ;
                             qudt:unit <http://qudt.org/vocab/unit/M> .
                ?positionNode qudt:numericValue ?position ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (?position < 0 || ?position > (?draught * 1.20))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO038Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F04/ship> ] .

