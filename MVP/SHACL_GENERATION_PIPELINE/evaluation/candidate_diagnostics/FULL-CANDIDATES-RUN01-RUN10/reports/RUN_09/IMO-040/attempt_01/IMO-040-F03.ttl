@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"iceAccretionLikely must be recorded as false when the conditional requirement is not applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ] ] , [ sh:property [ sh:class nltl:relevantHatchOrDoorItem ; sh:node [ sh:property [ sh:class nltl:iceSnowRemovalOrPreventionMeans ; sh:message Literal(\"Each relevant hatch or door must have associated means to remove or prevent ice or snow accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ] ] ; sh:path nltl:hasRelevantHatchOrDoor ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"iceAccretionLikely must be recorded as true when the conditional requirement applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAccretionLikely ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_040_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F03/ship> ] .

