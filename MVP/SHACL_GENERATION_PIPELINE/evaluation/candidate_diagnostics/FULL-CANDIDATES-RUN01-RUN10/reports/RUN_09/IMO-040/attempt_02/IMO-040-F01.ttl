@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F01/ship> ;
            sh:resultMessage "When ice accretion is likely, every linked hatch or door must be a relevant hatch or door item with associated ice or snow removal or prevention means." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When ice accretion is likely, every linked hatch or door must be a relevant hatch or door item with associated ice or snow removal or prevention means." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely true .
                $this nltl:hasRelevantHatchOrDoor ?hatchOrDoor .
                FILTER NOT EXISTS {
                    ?hatchOrDoor a nltl:relevantHatchOrDoorItem ;
                        nltl:hasIceOrSnowRemovalOrPreventionMeans ?means .
                    ?means a nltl:iceSnowRemovalOrPreventionMeans .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_040_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F01/ship> ] .

