@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F02/ship> ;
            sh:resultMessage "Where machinery seawater supply is present, ice-ingestion prevention or an approved alternative functionality arrangement is required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-045> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F02/ship> ] .

