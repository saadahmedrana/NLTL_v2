@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F03/ship> ;
            sh:resultMessage "The manufacturer's maximum combustion-air temperature criterion shall be provided in degrees Celsius." ;
            sh:resultPath nltl:manufacturerMaxAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The manufacturer's maximum combustion-air temperature criterion shall be provided in degrees Celsius." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO_047_TemperatureQuantityShape ;
                    sh:path nltl:manufacturerMaxAirTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F03/ship> ;
            sh:resultMessage "Combustion-air temperature control shall be recorded as present." ;
            sh:resultPath nltl:combustionAirTemperatureControlPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n310ea60fc989498d8c9e3baa34da8c85b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F03/ship> ;
            sh:resultMessage "Combustion-air temperature control shall be recorded as present." ;
            sh:resultPath nltl:combustionAirTemperatureControlPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n310ea60fc989498d8c9e3baa34da8c85b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F03/ship> ;
            sh:resultMessage "The manufacturer's minimum combustion-air temperature criterion shall be provided in degrees Celsius." ;
            sh:resultPath nltl:manufacturerMinAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The manufacturer's minimum combustion-air temperature criterion shall be provided in degrees Celsius." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO_047_TemperatureQuantityShape ;
                    sh:path nltl:manufacturerMinAirTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F03/ship> ;
            sh:resultMessage "The combustion-air temperature shall be provided in degrees Celsius." ;
            sh:resultPath nltl:combustionAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The combustion-air temperature shall be provided in degrees Celsius." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO_047_TemperatureQuantityShape ;
                    sh:path nltl:combustionAirTemperature ] ] .

_:n310ea60fc989498d8c9e3baa34da8c85b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Combustion-air temperature control shall be recorded as present." ;
    sh:minCount 1 ;
    sh:path nltl:combustionAirTemperatureControlPresent .

