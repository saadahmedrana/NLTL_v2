@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F02/ship> ;
            sh:resultMessage "A manufacturer maximum air temperature in degrees Celsius is required." ;
            sh:resultPath nltl:manufacturerMaxAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A manufacturer maximum air temperature in degrees Celsius is required." ;
                    sh:minCount 1 ;
                    sh:node nltlgen:TemperatureQuantityShape ;
                    sh:path nltl:manufacturerMaxAirTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F02/ship> ;
            sh:resultMessage "Combustion-air temperature control must be present." ;
            sh:resultPath nltl:combustionAirTemperatureControlPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nbca88be258b44d1fae2a36beb5eb1bcbb4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F02/ship> ;
            sh:resultMessage "Combustion-air temperature control must be present." ;
            sh:resultPath nltl:combustionAirTemperatureControlPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nbca88be258b44d1fae2a36beb5eb1bcbb4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F02/ship> ;
            sh:resultMessage "A manufacturer minimum air temperature in degrees Celsius is required." ;
            sh:resultPath nltl:manufacturerMinAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A manufacturer minimum air temperature in degrees Celsius is required." ;
                    sh:minCount 1 ;
                    sh:node nltlgen:TemperatureQuantityShape ;
                    sh:path nltl:manufacturerMinAirTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F02/ship> ;
            sh:resultMessage "A combustion-air temperature in degrees Celsius is required." ;
            sh:resultPath nltl:combustionAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A combustion-air temperature in degrees Celsius is required." ;
                    sh:minCount 1 ;
                    sh:node nltlgen:TemperatureQuantityShape ;
                    sh:path nltl:combustionAirTemperature ] ] .

_:nbca88be258b44d1fae2a36beb5eb1bcbb4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Combustion-air temperature control must be present." ;
    sh:minCount 1 ;
    sh:path nltl:combustionAirTemperatureControlPresent .

