@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-P03/ship> ;
            sh:resultMessage "A single manufacturer maximum air temperature in degrees Celsius is required." ;
            sh:resultPath nltl:manufacturerMaxAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A single manufacturer maximum air temperature in degrees Celsius is required." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO047TemperatureQuantityShape ;
                    sh:path nltl:manufacturerMaxAirTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-P03/ship> ;
            sh:resultMessage "Combustion air temperature control must be recorded as present." ;
            sh:resultPath nltl:combustionAirTemperatureControlPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n3fa061920f4f45cf9c2b34685dad3f53b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-P03/ship> ;
            sh:resultMessage "A single manufacturer minimum air temperature in degrees Celsius is required." ;
            sh:resultPath nltl:manufacturerMinAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A single manufacturer minimum air temperature in degrees Celsius is required." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO047TemperatureQuantityShape ;
                    sh:path nltl:manufacturerMinAirTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-P03/ship> ;
            sh:resultMessage "Combustion air temperature control must be recorded as present." ;
            sh:resultPath nltl:combustionAirTemperatureControlPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n3fa061920f4f45cf9c2b34685dad3f53b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-P03/ship> ;
            sh:resultMessage "A single combustion-air temperature in degrees Celsius is required." ;
            sh:resultPath nltl:combustionAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A single combustion-air temperature in degrees Celsius is required." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO047TemperatureQuantityShape ;
                    sh:path nltl:combustionAirTemperature ] ] .

_:n3fa061920f4f45cf9c2b34685dad3f53b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Combustion air temperature control must be recorded as present." ;
    sh:minCount 1 ;
    sh:path nltl:combustionAirTemperatureControlPresent .

