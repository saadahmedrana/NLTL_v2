@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/ship> ;
            sh:resultMessage "Combustion-air temperature control must be recorded as present." ;
            sh:resultPath nltl:combustionAirTemperatureControlPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb189fedd0cc24896adfa3f16c897f2e4b4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/ship> ;
            sh:resultMessage "The manufacturer's maximum air-temperature criterion must be provided in degrees Celsius." ;
            sh:resultPath nltl:manufacturerMaxAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The manufacturer's maximum air-temperature criterion must be provided in degrees Celsius." ;
                    sh:minCount 1 ;
                    sh:node g:IMO_047_QuantityValueShape ;
                    sh:path nltl:manufacturerMaxAirTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/ship> ;
            sh:resultMessage "The combustion-air temperature must be provided in degrees Celsius." ;
            sh:resultPath nltl:combustionAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The combustion-air temperature must be provided in degrees Celsius." ;
                    sh:minCount 1 ;
                    sh:node g:IMO_047_QuantityValueShape ;
                    sh:path nltl:combustionAirTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/ship> ;
            sh:resultMessage "For every identified essential engine, combustion-air temperature control must be present and the combustion-air temperature must be within the inclusive manufacturer minimum and maximum criteria." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For every identified essential engine, combustion-air temperature control must be present and the combustion-air temperature must be within the inclusive manufacturer minimum and maximum criteria." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX qudt-unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?engine
            WHERE {
                $this nltl:hasEssentialEngine ?engine .
                FILTER (
                    NOT EXISTS {
                        $this nltl:combustionAirTemperatureControlPresent ?control .
                        FILTER (?control = true)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:combustionAirTemperature ?temperatureQuantity .
                        ?temperatureQuantity qudt:numericValue ?temperature ;
                            qudt:unit qudt-unit:DEG_C .
                        $this nltl:manufacturerMinAirTemperature ?minimumQuantity .
                        ?minimumQuantity qudt:numericValue ?minimum ;
                            qudt:unit qudt-unit:DEG_C .
                        $this nltl:manufacturerMaxAirTemperature ?maximumQuantity .
                        ?maximumQuantity qudt:numericValue ?maximum ;
                            qudt:unit qudt-unit:DEG_C .
                        FILTER (?temperature >= ?minimum && ?temperature <= ?maximum)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape g:IMO_047_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/ship> ;
            sh:resultMessage "The manufacturer's minimum air-temperature criterion must be provided in degrees Celsius." ;
            sh:resultPath nltl:manufacturerMinAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The manufacturer's minimum air-temperature criterion must be provided in degrees Celsius." ;
                    sh:minCount 1 ;
                    sh:node g:IMO_047_QuantityValueShape ;
                    sh:path nltl:manufacturerMinAirTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/ship> ;
            sh:resultMessage "Combustion-air temperature control must be recorded as present." ;
            sh:resultPath nltl:combustionAirTemperatureControlPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb189fedd0cc24896adfa3f16c897f2e4b4 ] .

_:nb189fedd0cc24896adfa3f16c897f2e4b4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Combustion-air temperature control must be recorded as present." ;
    sh:minCount 1 ;
    sh:path nltl:combustionAirTemperatureControlPresent .

