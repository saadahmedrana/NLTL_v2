@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F04/ship> ;
            sh:resultMessage "Each exposed machinery or foundation material must have approved status, an authorized approving authority, an accepted or equivalent-safety standard, and a polar service temperature basis." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each exposed machinery or foundation material must have approved status, an authorized approving authority, an accepted or equivalent-safety standard, and a polar service temperature basis." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:exposedMachineryOrFoundationMaterial ?material .
                FILTER (
                    NOT EXISTS {
                        $this nltl:materialApprovalStatus nltl:evidenceStateApproved
                    }
                    ||
                    EXISTS {
                        $this nltl:materialApprovalStatus ?status .
                        FILTER (?status != nltl:evidenceStateApproved)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:approvingAuthority ?authority .
                        FILTER (
                            datatype(?authority) = xsd:string &&
                            STR(?authority) IN (
                                "Administration",
                                "recognized organization accepted by the Administration"
                            )
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:approvingAuthority ?authority .
                        FILTER (
                            datatype(?authority) != xsd:string ||
                            STR(?authority) NOT IN (
                                "Administration",
                                "recognized organization accepted by the Administration"
                            )
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:approvalStandard ?standard .
                        FILTER (
                            datatype(?standard) = xsd:string &&
                            STR(?standard) IN (
                                "standard acceptable to the Organization",
                                "another standard offering an equivalent level of safety"
                            )
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:approvalStandard ?standard .
                        FILTER (
                            datatype(?standard) != xsd:string ||
                            STR(?standard) NOT IN (
                                "standard acceptable to the Organization",
                                "another standard offering an equivalent level of safety"
                            )
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:polarServiceTemperature ?pst .
                        ?pst a qudt:QuantityValue ;
                             qudt:numericValue ?numericValue ;
                             qudt:unit unit:DEG_C .
                        FILTER (datatype(?numericValue) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        $this nltl:polarServiceTemperature ?pst .
                        FILTER NOT EXISTS {
                            ?pst a qudt:QuantityValue ;
                                 qudt:numericValue ?numericValue ;
                                 qudt:unit unit:DEG_C .
                            FILTER (datatype(?numericValue) = xsd:decimal)
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:polarServiceTemperature ?pst .
                        ?pst qudt:unit ?temperatureUnit .
                        FILTER (?temperatureUnit != unit:DEG_C)
                    }
                    ||
                    EXISTS {
                        $this nltl:polarServiceTemperature ?pst .
                        ?pst qudt:numericValue ?numericValue .
                        FILTER (datatype(?numericValue) != xsd:decimal)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-048> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F04/ship> ] .

