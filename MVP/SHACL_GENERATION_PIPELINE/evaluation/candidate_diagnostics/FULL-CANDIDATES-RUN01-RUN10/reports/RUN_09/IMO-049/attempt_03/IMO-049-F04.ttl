@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:and ( gen:IMO049InventoryShape gen:IMO049CategoryAShape ) ] , [ sh:and ( gen:IMO049InventoryShape gen:IMO049CategoryBShape ) ] , [ sh:and ( gen:IMO049InventoryShape gen:IMO049CategoryCIceStrengthenedShape ) ] , [ sh:and ( gen:IMO049InventoryShape gen:IMO049CategoryCNotIceStrengthenedShape ) ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO049Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/ship> ] .

