@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-P03/ship> ;
            sh:resultMessage "For an exposed isolating, pressure, or vacuum valve, ice accretion protection and continuous accessibility are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-055-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-P03/ship> ] .

