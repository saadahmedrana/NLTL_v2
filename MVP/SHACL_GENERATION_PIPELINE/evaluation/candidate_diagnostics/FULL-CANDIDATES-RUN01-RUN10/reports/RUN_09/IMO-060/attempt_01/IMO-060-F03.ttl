@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F03/ship> ;
            sh:resultMessage "The independent sea suction status must be supplied as one boolean value." ;
            sh:resultPath nltl:independentSeaSuctionUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The independent sea suction status must be supplied as one boolean value." ;
                    sh:minCount 1 ;
                    sh:path nltl:independentSeaSuctionUsed ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F03/ship> ;
            sh:resultMessage "When the fixed water system is separate from the main fire pumps and uses an independent sea suction, that sea suction must be capable of being cleared of ice accumulation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO060Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F03/ship> ] .

