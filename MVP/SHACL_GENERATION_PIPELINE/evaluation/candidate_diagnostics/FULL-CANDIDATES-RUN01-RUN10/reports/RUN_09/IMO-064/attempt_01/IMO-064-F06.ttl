[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F06/ship> ;
            sh:resultMessage "Thermal protection must have approved adequacy status." ;
            sh:resultPath nltl:thermalProtectionApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n939cec5b6b2c4adea546e49a05001d86b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F06/ship> ;
            sh:resultMessage "Thermal protection must have approved adequacy status." ;
            sh:resultPath nltl:thermalProtectionApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n939cec5b6b2c4adea546e49a05001d86b3 ] .

_:n939cec5b6b2c4adea546e49a05001d86b3 sh:class nltl:evidenceState ;
