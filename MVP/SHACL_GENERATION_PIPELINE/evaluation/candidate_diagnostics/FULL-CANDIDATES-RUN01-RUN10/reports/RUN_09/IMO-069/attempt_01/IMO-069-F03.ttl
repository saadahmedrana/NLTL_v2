@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-069-F03/ship> ;
            sh:resultMessage "The ship must state whether an added life-saving device requires power." ;
            sh:resultPath nltl:addedLifeSavingDeviceRequiresPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ship must state whether an added life-saving device requires power." ;
                    sh:minCount 1 ;
                    sh:path nltl:addedLifeSavingDeviceRequiresPower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-069-F03/ship> ;
            sh:resultMessage "If an added life-saving device requires power, its power source must operate independently of the ship's main source of power." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_069_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-069-F03/ship> ] .

