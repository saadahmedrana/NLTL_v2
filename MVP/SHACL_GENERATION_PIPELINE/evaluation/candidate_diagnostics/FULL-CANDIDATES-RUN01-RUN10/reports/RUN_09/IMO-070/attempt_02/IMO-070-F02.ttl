            sh:resultMessage "Node ex:ship->nltl:shipType does not contain a value in the set: ['Literal(\"passenger_ship\")']" ;
            sh:resultPath nltl:shipType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb751aafd5a1b46aa9866555f7f08e8feb2 ] .

_:nb751aafd5a1b46aa9866555f7f08e8feb2 sh:datatype xsd:string ;
    sh:hasValue "passenger_ship" ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:shipType .

_:nb751aafd5a1b46aa9866555f7f08e8feb3 sh:datatype xsd:boolean ;
