            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb751aafd5a1b46aa9866555f7f08e8feb3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:shipType" ;
            sh:resultPath nltl:shipType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb751aafd5a1b46aa9866555f7f08e8feb2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F02/ship> ;
            sh:resultMessage "Node ex:ship->nltl:sizeCompatibilityStatus does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
