    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:sizeCompatibilityStatus" ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
