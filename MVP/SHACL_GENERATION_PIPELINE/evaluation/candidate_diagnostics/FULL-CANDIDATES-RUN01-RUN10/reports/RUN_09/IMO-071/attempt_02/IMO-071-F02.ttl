@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F02/ship> ;
            sh:resultMessage "When immersion suits are required, the immersion suit type must be insulated." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When immersion suits are required, the immersion suit type must be insulated." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:immersionSuitRequired true .
                FILTER NOT EXISTS {
                    $this nltl:immersionSuitTypeClassification
                        nltl:insulatedImmersionSuit .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_071_ImmersionSuitTypeShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F02/ship> ] .

