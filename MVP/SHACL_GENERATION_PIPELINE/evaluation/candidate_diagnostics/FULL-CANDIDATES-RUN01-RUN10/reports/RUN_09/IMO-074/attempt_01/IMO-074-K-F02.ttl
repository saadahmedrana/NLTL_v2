@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-074-K-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in g:IMO074NotApplicableShape , g:IMO074EquipmentAlternativeShape , g:IMO074EquivalentFunctionalityAlternativeShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:IMO074Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-074-K-F02/ship> ] .

