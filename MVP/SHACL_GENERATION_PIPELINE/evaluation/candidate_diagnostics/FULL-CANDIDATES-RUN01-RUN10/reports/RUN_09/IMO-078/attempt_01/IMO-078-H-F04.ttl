                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nc24c0d1ccc2f4813980a41f168bf2381b1 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F04/crew1> ;
                    sh:resultMessage "Each linked crew member shall have completed personal and group survival equipment training." ;
                    sh:resultPath nltl:personalAndGroupSurvivalEquipmentTrainingCompleted ;
