@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading1> ;
                    sh:resultMessage "Less than 1 values on ex:heading1->nltl:independentFromHeadingMeans" ;
                    sh:resultPath nltl:independentFromHeadingMeans ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n015879be5f3c4e0094ce2553db2d5546b5 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/ship> ;
            sh:resultMessage "The ship must have at least two non-magnetic heading means, each connected to main and emergency power and independently related to another heading means." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n015879be5f3c4e0094ce2553db2d5546b1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/ship> ;
            sh:resultMessage "Each non-magnetic heading means must be independent from another distinct heading means belonging to the same ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each non-magnetic heading means must be independent from another distinct heading means belonging to the same ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasNonMagneticHeadingMeans ?means .
                FILTER NOT EXISTS {
                    ?means nltl:independentFromHeadingMeans ?other .
                    FILTER (?other != ?means)
                    $this nltl:hasNonMagneticHeadingMeans ?other .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-086-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading2> ;
                    sh:resultMessage "Less than 1 values on ex:heading2->nltl:independentFromHeadingMeans" ;
                    sh:resultPath nltl:independentFromHeadingMeans ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n015879be5f3c4e0094ce2553db2d5546b5 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/ship> ;
            sh:resultMessage "The ship must have at least two non-magnetic heading means, each connected to main and emergency power and independently related to another heading means." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n015879be5f3c4e0094ce2553db2d5546b1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading2> ] .

_:N2496f2f8197649e5b1d6421f286688c7 sh:class nltl:benchmarkEntity ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:connectedToMainPower .

_:N971b34576b7c4b538ab07dfe3a19ebf5 a sh:NodeShape ;
    sh:property _:N2496f2f8197649e5b1d6421f286688c7,
        [ sh:class nltl:benchmarkEntity ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path nltl:connectedToEmergencyPower ],
        [ sh:class nltl:nonMagneticHeadingMeans ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path nltl:independentFromHeadingMeans ] .

_:n015879be5f3c4e0094ce2553db2d5546b1 sh:class nltl:nonMagneticHeadingMeans ;
    sh:message "The ship must have at least two non-magnetic heading means, each connected to main and emergency power and independently related to another heading means." ;
    sh:minCount 2 ;
    sh:node _:N971b34576b7c4b538ab07dfe3a19ebf5 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasNonMagneticHeadingMeans .

_:n015879be5f3c4e0094ce2553db2d5546b5 sh:class nltl:nonMagneticHeadingMeans ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:independentFromHeadingMeans .

