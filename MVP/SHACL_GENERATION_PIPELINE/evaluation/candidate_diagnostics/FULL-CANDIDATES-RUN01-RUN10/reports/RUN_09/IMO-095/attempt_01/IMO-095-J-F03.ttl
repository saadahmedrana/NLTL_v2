@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F03/ship> ;
            sh:resultMessage "The ship shall support aircraft voice communications on 121.5 MHz." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ship shall support aircraft voice communications on 121.5 MHz." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                FILTER NOT EXISTS {
                    ?this nltl:supportedAircraftVoiceFrequency ?frequency .
                    ?frequency qudt:numericValue ?value .
                    ?frequency qudt:unit qudt:MegaHZ .
                    FILTER (?value = "121.5"^^xsd:decimal)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-095> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F03/ship> ],
