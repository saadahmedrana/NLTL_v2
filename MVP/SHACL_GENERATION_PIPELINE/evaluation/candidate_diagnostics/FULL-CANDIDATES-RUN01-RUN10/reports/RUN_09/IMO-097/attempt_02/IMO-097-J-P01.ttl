@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:otherSurvivalCraft ; sh:message Literal(\"The applicable ship must represent its other-survival-craft relationship.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasOtherSurvivalCraft ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The low-air-temperature applicability value must be true for this branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipOperatesInLowAirTemperature ], [ sh:message Literal(\"Each applicable released rescue boat or lifeboat must be represented.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:IMO097LifeboatShape ; sh:path nltl:hasRequiredRescueBoatOrLifeboat ], [ sh:message Literal(\"Each applicable survival craft must be linked from the ship and carry the required communication devices.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:IMO097SurvivalCraftShape ; sh:path nltl:hasSurvivalCraft ], [ sh:message Literal(\"The applicable ship must represent its lifeboat relationship.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:IMO097LifeboatShape ; sh:path nltl:hasLifeboat ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The low-air-temperature applicability value must be false for this branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipOperatesInLowAirTemperature ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO097ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P01/ship> ] .

