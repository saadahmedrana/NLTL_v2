@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F02/craft1> ;
                    sh:resultMessage "Less than 1 values on ex:craft1->nltl:survivalCraftHasLocationSignalDevice" ;
                    sh:resultPath nltl:survivalCraftHasLocationSignalDevice ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:locationSignalDevice ;
                            sh:minCount 1 ;
                            sh:path nltl:survivalCraftHasLocationSignalDevice ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO097SurvivalCraftShape. See details for more information." ;
            sh:resultPath nltl:hasSurvivalCraft ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:survivalCraft ;
                    sh:node gen:IMO097SurvivalCraftShape ;
                    sh:path nltl:hasSurvivalCraft ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F02/craft1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInLowAirTemperature ] ] , [ sh:property [ sh:class nltl:lifeboat ; sh:node gen:IMO097LifeboatShape ; sh:path nltl:hasLifeboat ], [ sh:class nltl:lifeboat ; sh:node gen:IMO097LifeboatShape ; sh:path nltl:hasRequiredRescueBoatOrLifeboat ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInLowAirTemperature ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO097ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F02/ship> ] .

