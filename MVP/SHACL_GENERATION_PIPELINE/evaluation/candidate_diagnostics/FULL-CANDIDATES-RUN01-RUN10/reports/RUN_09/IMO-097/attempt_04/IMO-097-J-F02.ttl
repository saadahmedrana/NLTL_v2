@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F02/ship> ;
            sh:resultMessage "When the ship operates in low air temperature, each represented released rescue boat or lifeboat must carry the required communication devices." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO097ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-F02/ship> ] .

