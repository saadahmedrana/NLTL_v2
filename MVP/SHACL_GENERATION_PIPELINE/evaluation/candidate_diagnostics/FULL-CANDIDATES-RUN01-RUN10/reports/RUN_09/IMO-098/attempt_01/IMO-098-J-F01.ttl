@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-098-J-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The low-air-temperature operating applicability must be recorded as false for this non-applicable case.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipOperatesInLowAirTemperature ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The low-air-temperature operating applicability must be recorded as true for this applicable case.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipOperatesInLowAirTemperature ], [ sh:node [ sh:class nltl:otherSurvivalCraft ; sh:property [ sh:message Literal(\"Every other survival craft must carry at least one location-signal device.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:locationSignalDevice ] ; sh:path nltl:hasLocationSignalDevice ], [ sh:message Literal(\"Every other survival craft must carry at least one on-scene transmit/receive communication device.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:onSceneCommunicationDevice ] ; sh:path nltl:hasOnSceneCommunicationDevice ] ] ; sh:path nltl:hasOtherSurvivalCraft ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-098-Ship> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-098-J-F01/ship> ] .

