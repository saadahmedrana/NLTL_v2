@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-F04/ship> ;
            sh:resultMessage "The ship shall have a voyage plan." ;
            sh:resultPath nltl:voyagePlanPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nc34f31bb570a4821855445e490d12aa3b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-F04/ship> ;
            sh:resultMessage "The ship shall have a voyage plan." ;
            sh:resultPath nltl:voyagePlanPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc34f31bb570a4821855445e490d12aa3b1 ] .

_:nc34f31bb570a4821855445e490d12aa3b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship shall have a voyage plan." ;
    sh:minCount 1 ;
    sh:path nltl:voyagePlanPresent .

