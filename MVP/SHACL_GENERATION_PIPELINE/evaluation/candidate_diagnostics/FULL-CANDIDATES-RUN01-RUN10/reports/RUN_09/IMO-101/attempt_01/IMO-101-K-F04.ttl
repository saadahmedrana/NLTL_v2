            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F04/ship> ;
            sh:resultMessage "The ship shall have a polar route plan whose topic coverage is recorded as true." ;
            sh:resultPath nltl:hasPolarRoutePlan ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall have a polar route plan whose topic coverage is recorded as true." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO101PolarRoutePlanShape ;
                    sh:path nltl:hasPolarRoutePlan ] ;
