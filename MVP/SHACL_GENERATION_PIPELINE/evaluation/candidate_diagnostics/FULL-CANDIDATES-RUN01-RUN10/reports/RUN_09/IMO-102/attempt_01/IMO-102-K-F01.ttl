@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F01/trainingRecord> ;
                            sh:resultMessage "Less than 1 values on ex:trainingRecord->nltl:requiredTrainingLevel" ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:neeb402cdfec347bbb15cd0a62171e867b17 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F01/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:IMO102TrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasCrewTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node gen:IMO102TrainingRecordShape ;
                            sh:path nltl:hasCrewTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F01/trainingRecord> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F01/trainingRecord> ;
                            sh:resultMessage "Less than 1 values on ex:trainingRecord->nltl:requiredTrainingLevel" ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:neeb402cdfec347bbb15cd0a62171e867b17 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F01/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:IMO102TrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasPolarTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node gen:IMO102TrainingRecordShape ;
                            sh:path nltl:hasPolarTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F01/trainingRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO102CrewMemberShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:IMO102CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F01/crew> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F01/ship> ;
            sh:resultMessage "Each represented crew member shall satisfy the clause 12.3.1 training matrix and, where Basic or Advanced training is required, have a matching valid STCW training record." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each represented crew member shall satisfy the clause 12.3.1 training matrix and, where Basic or Advanced training is required, have a matching valid STCW training record." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?crew
            WHERE {
                $this nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType ;
                      nltl:hasCrewMemberInventory ?crew .
                ?crew nltl:polarTrainingCrewRoleClassification ?role .
                FILTER NOT EXISTS {
                    {
                        FILTER (?ice = nltl:iceFreeIceCondition)
                    }
                    UNION
                    {
                        FILTER (
                            ?ice = nltl:openWaterIceCondition &&
                            ?shipType = nltl:otherShipPolarTrainingType
                        )
                    }
                    UNION
                    {
                        FILTER (
                            ?ice = nltl:openWaterIceCondition &&
                            ?shipType IN (
                                nltl:tankerPolarTrainingShipType,
                                nltl:passengerShipPolarTrainingShipType
                            )
                        )
                        FILTER (
                            ?role IN (
                                nltl:masterPolarTrainingRole,
                                nltl:chiefMatePolarTrainingRole,
                                nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
                            )
                        )
                        ?crew nltl:hasCrewTrainingRecord ?record ;
                              nltl:hasPolarTrainingRecord ?evidence .
                        ?record nltl:requiredTrainingLevel nltl:basicPolarTrainingLevel ;
                                nltl:trainingRecordLevel nltl:basicPolarTrainingLevel ;
                                nltl:stcwQualificationValid true .
                    }
                    UNION
                    {
                        FILTER (?ice = nltl:otherWatersIceCondition)
                        FILTER (
                            ?role IN (
                                nltl:masterPolarTrainingRole,
                                nltl:chiefMatePolarTrainingRole
                            )
                        )
                        ?crew nltl:hasCrewTrainingRecord ?record ;
                              nltl:hasPolarTrainingRecord ?evidence .
                        ?record nltl:requiredTrainingLevel nltl:advancedPolarTrainingLevel ;
                                nltl:trainingRecordLevel nltl:advancedPolarTrainingLevel ;
                                nltl:stcwQualificationValid true .
                    }
                    UNION
                    {
                        FILTER (
                            ?ice = nltl:otherWatersIceCondition &&
                            ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
                        )
                        ?crew nltl:hasCrewTrainingRecord ?record ;
                              nltl:hasPolarTrainingRecord ?evidence .
                        ?record nltl:requiredTrainingLevel nltl:basicPolarTrainingLevel ;
                                nltl:trainingRecordLevel nltl:basicPolarTrainingLevel ;
                                nltl:stcwQualificationValid true .
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO102ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F01/ship> ] .

_:Nb1f9815792244a7596cedadc2de2f247 rdf:first nltl:polarTrainingNotApplicable ;
    rdf:rest () .

_:Nbc7db8adf6d446bea1fea09b1622e745 rdf:first nltl:advancedPolarTrainingLevel ;
    rdf:rest _:Nb1f9815792244a7596cedadc2de2f247 .

_:Nd37cae4ae81b438cb67174f63b297973 rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest _:Nbc7db8adf6d446bea1fea09b1622e745 .

_:neeb402cdfec347bbb15cd0a62171e867b17 sh:in _:Nd37cae4ae81b438cb67174f63b297973 ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:requiredTrainingLevel .

