@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P01/ship> ;
            sh:resultMessage "Each represented crew member shall satisfy the clause 12.3.1 training matrix and, where Basic or Advanced training is required, have a matching valid STCW training record." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each represented crew member shall satisfy the clause 12.3.1 training matrix and, where Basic or Advanced training is required, have a matching valid STCW training record." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?crew
            WHERE {
                $this nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType ;
                      nltl:hasCrewMemberInventory ?crew .
                ?crew nltl:polarTrainingCrewRoleClassification ?role .
                FILTER NOT EXISTS {
                    {
                        FILTER (?ice = nltl:iceFreeIceCondition)
                    }
                    UNION
                    {
                        FILTER (
                            ?ice = nltl:openWaterIceCondition &&
                            ?shipType = nltl:otherShipPolarTrainingType
                        )
                    }
                    UNION
                    {
                        FILTER (
                            ?ice = nltl:openWaterIceCondition &&
                            ?shipType IN (
                                nltl:tankerPolarTrainingShipType,
                                nltl:passengerShipPolarTrainingShipType
                            )
                        )
                        FILTER (
                            ?role IN (
                                nltl:masterPolarTrainingRole,
                                nltl:chiefMatePolarTrainingRole,
                                nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
                            )
                        )
                        ?crew nltl:hasCrewTrainingRecord ?record ;
                              nltl:hasPolarTrainingRecord ?evidence .
                        ?record nltl:requiredTrainingLevel nltl:basicPolarTrainingLevel ;
                                nltl:trainingRecordLevel nltl:basicPolarTrainingLevel ;
                                nltl:stcwQualificationValid true .
                    }
                    UNION
                    {
                        FILTER (?ice = nltl:otherWatersIceCondition)
                        FILTER (
                            ?role IN (
                                nltl:masterPolarTrainingRole,
                                nltl:chiefMatePolarTrainingRole
                            )
                        )
                        ?crew nltl:hasCrewTrainingRecord ?record ;
                              nltl:hasPolarTrainingRecord ?evidence .
                        ?record nltl:requiredTrainingLevel nltl:advancedPolarTrainingLevel ;
                                nltl:trainingRecordLevel nltl:advancedPolarTrainingLevel ;
                                nltl:stcwQualificationValid true .
                    }
                    UNION
                    {
                        FILTER (
                            ?ice = nltl:otherWatersIceCondition &&
                            ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
                        )
                        ?crew nltl:hasCrewTrainingRecord ?record ;
                              nltl:hasPolarTrainingRecord ?evidence .
                        ?record nltl:requiredTrainingLevel nltl:basicPolarTrainingLevel ;
                                nltl:trainingRecordLevel nltl:basicPolarTrainingLevel ;
                                nltl:stcwQualificationValid true .
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO102ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P01/ship> ] .

