@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-103-K-F01/ship> ;
            sh:resultMessage "Value Literal(\"passenger ship\", datatype=xsd:string) not in list ['Literal(\"cargo ship other than tanker\")', 'Literal(\"tanker\")', 'Literal(\"passenger ship\")']" ;
            sh:resultPath nltl:shipType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "passenger ship" "tanker" "cargo ship other than tanker" ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:shipType ] ;
            sh:value "passenger ship"^^xsd:string ] .

