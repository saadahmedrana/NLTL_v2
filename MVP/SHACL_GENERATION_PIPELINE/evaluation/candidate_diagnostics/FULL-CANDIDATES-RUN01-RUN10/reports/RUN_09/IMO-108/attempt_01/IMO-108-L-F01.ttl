@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in <urn:nltl:generated-shape:IMO-108-Applicable> , <urn:nltl:generated-shape:IMO-108-CategoryC> , <urn:nltl:generated-shape:IMO-108-DateBefore2017> , <urn:nltl:generated-shape:IMO-108-AggregateAtLeast600> , <urn:nltl:generated-shape:IMO-108-IndividualAtMost30>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-108> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-F01/ship> ] .

