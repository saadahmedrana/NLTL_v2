@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-F01/ship> ;
            sh:resultMessage "For applicable Category A or B ships constructed on or after 1 January 2017, non-oil-tanker ships whose cargo tanks carry oil must provide an outer-shell separation of at least 0.76 m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO109ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-F01/ship> ] .

