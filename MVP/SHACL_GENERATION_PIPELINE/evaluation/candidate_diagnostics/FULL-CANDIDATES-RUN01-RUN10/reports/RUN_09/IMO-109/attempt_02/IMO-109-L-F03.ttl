@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-F03/ship> ;
            sh:resultMessage "The ship must have a declared type other than oil_tanker." ;
            sh:resultPath nltl:shipType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship must have a declared type other than oil_tanker." ;
                    sh:minCount 1 ;
                    sh:not [ sh:hasValue "oil_tanker" ] ;
                    sh:path nltl:shipType ] ] .

