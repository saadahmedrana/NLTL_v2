@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-P05/ship> ;
            sh:resultMessage "For a Category A or B ship constructed on or after 1 January 2017 and not an oil tanker, cargo tanks carrying oil must be separated from the outer shell by at least 0.76 m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO109Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-P05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-P05/ship> ;
            sh:resultMessage "The ship category must be Category A or Category B." ;
            sh:resultPath nltl:shipCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship category must be Category A or Category B." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:shipCategory ] ;
            sh:value nltl:polarShipCategoryC ] .

