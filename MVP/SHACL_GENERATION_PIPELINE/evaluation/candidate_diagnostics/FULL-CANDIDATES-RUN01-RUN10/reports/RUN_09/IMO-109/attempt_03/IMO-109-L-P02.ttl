@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-P02/ship> ;
            sh:resultMessage "For an applicable Category A or B, non-oil-tanker ship constructed on or after 1 January 2017 and carrying oil in cargo tanks, outer-shell separation must be at least 0.76 m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO109Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-P02/ship> ] .

