@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-P02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:and ( [ sh:property [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ; sh:path nltl:shipCategory ] ] [ sh:property [ sh:minInclusive Literal(\"2017-01-01\", datatype=xsd:date) ; sh:path nltl:constructionDate ] ] [ sh:not [ sh:property [ sh:hasValue Literal(\"oil_tanker\", datatype=xsd:string) ; sh:path nltl:shipType ] ] ] [ sh:not [ sh:property [ sh:hasValue nltl:oilTanker ; sh:path rdf:type ] ] ] [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:cargoTankCarriesOil ] ] [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minInclusive Literal(\"0.76\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:cargoTankOuterShellSeparation ] ] ) ] , [ sh:property [ sh:hasValue nltl:polarShipCategoryC ; sh:path nltl:shipCategory ] ] , [ sh:property [ sh:maxInclusive Literal(\"2016-12-31\", datatype=xsd:date) ; sh:path nltl:constructionDate ] ] , [ sh:property [ sh:hasValue Literal(\"oil_tanker\", datatype=xsd:string) ; sh:path nltl:shipType ] ] , [ sh:property [ sh:hasValue nltl:oilTanker ; sh:path rdf:type ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:cargoTankCarriesOil ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-109> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-P02/ship> ] .

