@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-112-M-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:message Literal("Discharge of noxious liquid substances or mixtures into the sea shall be false in Arctic waters.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:noxiousLiquidSubstanceOrNoxiousLiquidSubstanceMixtureDischargeToSea ], [ sh:datatype xsd:string ; sh:hasValue Literal("Arctic_waters", datatype=xsd:string) ; sh:message Literal("The operating area must identify Arctic_waters for this applicability branch.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:operatingArea ] ] , [ sh:property [ sh:datatype xsd:string ; sh:message Literal("An operating area is required to determine applicability of the Arctic-waters prohibition.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:operatingArea ] ; sh:sparql [ sh:message Literal("This non-Arctic applicability branch cannot be used when the operating area includes Arctic_waters.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:operatingArea ?area .
                        FILTER (?area = "Arctic_waters"^^xsd:string)
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_112_Arctic_NLS_DischargeShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-112-M-F02/ship> ] .

