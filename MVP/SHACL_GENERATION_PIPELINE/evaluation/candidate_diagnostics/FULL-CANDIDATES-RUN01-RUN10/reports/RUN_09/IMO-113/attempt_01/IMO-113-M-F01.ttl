@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-113-M-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to exactly one shape in <urn:nltl:generated-shape:IMO-113-ApplicablePolarCoverage> , <urn:nltl:generated-shape:IMO-113-NonApplicablePolarCoverage>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:XoneConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-113-PolarDocumentCoverageShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-113-M-F01/ship> ] .

