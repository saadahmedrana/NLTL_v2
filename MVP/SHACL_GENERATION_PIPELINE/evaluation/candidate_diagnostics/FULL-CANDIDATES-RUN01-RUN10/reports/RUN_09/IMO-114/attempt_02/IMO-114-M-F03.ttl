@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-F03/ship> ;
            sh:resultMessage "For applicable Category A or B ships constructed on or after 2017-01-01 and meeting the specified NLS and cargo-tank conditions, Administration approval must be approved and the applicable polar operation certificate entry must be true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For applicable Category A or B ships constructed on or after 2017-01-01 and meeting the specified NLS and cargo-tank conditions, Administration approval must be approved and the applicable polar operation certificate entry must be true." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?constructionDate ;
                      nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ?requiresType3 ;
                      nltl:cargoTankType ?tankType .

                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )
                FILTER (?constructionDate >= "2017-01-01"^^xsd:date)
                FILTER (?requiresType3 = true)
                FILTER (?tankType = "3"^^xsd:string)

                {
                    FILTER NOT EXISTS {
                        $this nltl:administrationCarriageApprovalStatus
                              nltl:evidenceStateApproved
                    }
                }
                UNION
                {
                    $this nltl:administrationCarriageApprovalStatus ?approvalStatus .
                    FILTER (?approvalStatus != nltl:evidenceStateApproved)
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:applicableCertificatePolarOperationEntryPresent true
                    }
                }
                UNION
                {
                    $this nltl:applicableCertificatePolarOperationEntryPresent ?entryPresent .
                    FILTER (?entryPresent != true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-114> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-F03/ship> ] .

