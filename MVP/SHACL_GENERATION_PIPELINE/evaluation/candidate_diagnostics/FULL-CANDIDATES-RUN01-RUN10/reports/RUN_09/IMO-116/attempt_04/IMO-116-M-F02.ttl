@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in <urn:nltl:generated-shape:IMO-116-ApplicableShape> , <urn:nltl:generated-shape:IMO-116-NonApplicableShape>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-116-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-F02/ship> ;
            sh:resultMessage "Sewage discharge type and the not-comminuted-or-disinfected indicator are inconsistent." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Sewage discharge type and the not-comminuted-or-disinfected indicator are inconsistent." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:sewageDischargeType ?dischargeType ;
                      nltl:notComminutedOrDisinfected ?notComminuted .
                FILTER (
                    (
                        ?dischargeType = "not_comminuted_or_disinfected"
                        && ?notComminuted != true
                    )
                    ||
                    (
                        ?dischargeType != "not_comminuted_or_disinfected"
                        && ?notComminuted = true
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-116-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-F02/ship> ] .

