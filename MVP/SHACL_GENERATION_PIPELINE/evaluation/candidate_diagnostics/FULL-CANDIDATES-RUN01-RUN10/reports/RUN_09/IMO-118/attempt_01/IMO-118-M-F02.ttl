@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F02/ship> ;
            sh:resultMessage "Applicable ships must not discharge sewage into the sea unless paragraph 4.2.1.3 compliance is recorded." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Applicable ships must not discharge sewage into the sea unless paragraph 4.2.1.3 compliance is recorded." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?date .
                FILTER (?date >= "2017-01-01"^^xsd:date)
                {
                    $this nltl:shipCategory ?category .
                    FILTER (?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    ))
                }
                UNION
                {
                    $this rdf:type nltl:passengerShip .
                }
                FILTER (
                    NOT EXISTS {
                        $this nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ?status .
                        FILTER (?status = true)
                    }
                    &&
                    (
                        NOT EXISTS {
                            $this nltl:sewageDischargeToSea ?discharge .
                            FILTER (?discharge = false)
                        }
                        ||
                        EXISTS {
                            $this nltl:sewageDischargeToSea ?dischargeValue .
                            FILTER (?dischargeValue != false)
                        }
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO118Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F02/ship> ] .

