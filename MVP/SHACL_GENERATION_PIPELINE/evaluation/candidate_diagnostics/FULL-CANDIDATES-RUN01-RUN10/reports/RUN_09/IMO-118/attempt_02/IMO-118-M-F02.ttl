@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F02/ship> ;
            sh:resultMessage "Applicable ships must not discharge sewage into the sea unless paragraph 4.2.1.3 compliance is recorded." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Applicable ships must not discharge sewage into the sea unless paragraph 4.2.1.3 compliance is recorded." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionDate ?d .
                FILTER (
                    YEAR(?d) > 2017 ||
                    (
                        YEAR(?d) = 2017 &&
                        (
                            MONTH(?d) > 1 ||
                            (MONTH(?d) = 1 && DAY(?d) >= 1)
                        )
                    )
                )
                FILTER (
                    EXISTS {
                        $this nltl:shipCategory ?category .
                        FILTER (
                            ?category IN (
                                nltl:polarShipCategoryA,
                                nltl:polarShipCategoryB
                            )
                        )
                    }
                    ||
                    EXISTS {
                        $this a nltl:passengerShip .
                    }
                )
                FILTER NOT EXISTS {
                    $this nltl:sewageDischargeToSea "false"^^xsd:boolean .
                }
                FILTER NOT EXISTS {
                    $this nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus
                        "true"^^xsd:boolean .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_118_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F02/ship> ] .

