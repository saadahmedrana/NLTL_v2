@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-P04/ship> ;
            sh:resultMessage "For a ship constructed on or after 1 January 2017, Category A, Category B, or passenger-ship evidence is required to establish applicability." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a ship constructed on or after 1 January 2017, Category A, Category B, or passenger-ship evidence is required to establish applicability." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionDate ?d .
                FILTER (
                    YEAR(?d) > 2017 ||
                    (
                        YEAR(?d) = 2017 &&
                        (
                            MONTH(?d) > 1 ||
                            (MONTH(?d) = 1 && DAY(?d) >= 1)
                        )
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:shipCategory ?category .
                    FILTER (
                        ?category IN (
                            nltl:polarShipCategoryA,
                            nltl:polarShipCategoryB
                        )
                    )
                }
                FILTER NOT EXISTS {
                    $this a nltl:passengerShip .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_118_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-P04/ship> ] .

