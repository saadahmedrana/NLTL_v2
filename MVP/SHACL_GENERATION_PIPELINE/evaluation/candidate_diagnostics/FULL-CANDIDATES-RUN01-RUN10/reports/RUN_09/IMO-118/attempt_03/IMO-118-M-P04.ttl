@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-P04/ship> ;
            sh:resultMessage "A ship constructed on or after 2017-01-01 must be Category A, Category B, or typed as a passenger ship for this rule's applicability to be determined." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A ship constructed on or after 2017-01-01 must be Category A, Category B, or typed as a passenger ship for this rule's applicability to be determined." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionDate ?date .
                FILTER (?date >= "2017-01-01"^^xsd:date)
                FILTER NOT EXISTS {
                    $this nltl:shipCategory ?category .
                    FILTER (?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    ))
                }
                FILTER NOT EXISTS {
                    $this a nltl:passengerShip .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-118> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-P04/ship> ] .

