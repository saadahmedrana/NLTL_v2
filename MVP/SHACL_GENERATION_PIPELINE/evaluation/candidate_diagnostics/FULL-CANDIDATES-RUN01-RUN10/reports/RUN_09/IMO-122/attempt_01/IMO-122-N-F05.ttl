@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-122-N-F05/ship> ;
            sh:resultMessage "Discharge of animal carcasses is prohibited." ;
            sh:resultPath nltl:animalCarcassDischarge ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nd47df5dfe961438fb2c1cbf76298bdd4b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-122-N-F05/ship> ;
            sh:resultMessage "Discharge of animal carcasses is prohibited." ;
            sh:resultPath nltl:animalCarcassDischarge ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd47df5dfe961438fb2c1cbf76298bdd4b2 ] .

_:nd47df5dfe961438fb2c1cbf76298bdd4b2 sh:datatype xsd:boolean ;
    sh:hasValue false ;
    sh:maxCount 1 ;
    sh:message "Discharge of animal carcasses is prohibited." ;
    sh:minCount 1 ;
    sh:path nltl:animalCarcassDischarge .

