@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ;
                    sh:resultMessage "Less than 1 values on ex:distanceRecord->nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth" ;
                    sh:resultPath nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MI_N> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ;
                    sh:resultMessage "Less than 1 values on ex:distanceRecord->nltl:distanceToNearestLandIceShelfOrFastIce" ;
                    sh:resultPath nltl:distanceToNearestLandIceShelfOrFastIce ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:minInclusive 12.0 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/MI_N> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:distanceToNearestLandIceShelfOrFastIce ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/ship> ;
            sh:resultMessage "Each discharge-distance record must include both required distances, and the nearest land, ice shelf, or fast ice distance must be at least 12 nautical miles." ;
            sh:resultPath nltl:hasDischargeDistanceRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each discharge-distance record must include both required distances, and the nearest land, ice shelf, or fast ice distance must be at least 12 nautical miles." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:dischargeDistanceRecords ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MI_N> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MI_N> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:minInclusive 12.0 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:distanceToNearestLandIceShelfOrFastIce ] ] ;
                    sh:path nltl:hasDischargeDistanceRecord ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ] .

