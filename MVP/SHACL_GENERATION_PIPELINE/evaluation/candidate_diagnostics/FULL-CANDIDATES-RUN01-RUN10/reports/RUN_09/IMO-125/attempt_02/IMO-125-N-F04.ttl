@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When the ship operates in polar waters, garbage placards must include polar operation coverage.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:garbagePlacardPolarCoverage ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When the ship operates in polar waters, polar operation coverage must be recorded.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarOperationCoverage ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When the ship operates in polar waters, the Garbage Management Plan must include polar operation coverage.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:garbageManagementPlanPolarCoverage ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When the ship operates in polar waters, the Garbage Record Book must include polar operation coverage.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:garbageRecordBookPolarCoverage ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInPolarWaters ] ] , [ sh:or ( [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:shipOperatesInPolarWaters ] ] [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInPolarWaters ] ] ) ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-125> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F04/ship> ] .

