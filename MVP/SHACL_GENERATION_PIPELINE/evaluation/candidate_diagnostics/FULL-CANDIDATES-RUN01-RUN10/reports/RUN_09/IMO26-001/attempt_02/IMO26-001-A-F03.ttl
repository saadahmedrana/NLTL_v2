@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-001-A-F03/ship> ;
            sh:resultMessage "SOLAS chapter I certification status is required to determine whether Polar Code chapter 9 applies." ;
            sh:resultPath nltl:solasChapterICertified ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "SOLAS chapter I certification status is required to determine whether Polar Code chapter 9 applies." ;
                    sh:minCount 1 ;
                    sh:path nltl:solasChapterICertified ] ] .

