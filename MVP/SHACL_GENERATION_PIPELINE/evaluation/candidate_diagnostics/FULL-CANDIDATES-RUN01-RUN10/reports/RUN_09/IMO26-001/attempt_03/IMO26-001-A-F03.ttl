@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-001-A-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:solasChapterICertified" ;
            sh:resultPath nltl:solasChapterICertified ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:hasValue true ;
                                sh:message "SOLAS chapter I certification is true; Polar Code chapter 9 is applicable." ] [ sh:hasValue false ;
                                sh:message "SOLAS chapter I certification is false; Polar Code chapter 9 is not applicable." ] ) ;
                    sh:path nltl:solasChapterICertified ] ] .

