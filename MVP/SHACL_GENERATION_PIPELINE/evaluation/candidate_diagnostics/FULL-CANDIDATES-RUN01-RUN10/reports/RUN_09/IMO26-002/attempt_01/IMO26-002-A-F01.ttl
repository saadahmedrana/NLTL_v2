@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/ship> ;
            sh:resultMessage "Chapter 9-1 applicability does not match the ship type, dimensions, gross tonnage, and trade status." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Chapter 9-1 applicability does not match the ship type, dimensions, gross tonnage, and trade status." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:shipType ?shipType ;
                      nltl:lengthOverall ?lengthQuantity ;
                      nltl:grossTonnage ?tonnageQuantity ;
                      nltl:engagedInTrade ?engagedInTrade ;
                      nltl:polarCodeChapter9Dash1Applicable ?applicable .

                ?lengthQuantity qudt:numericValue ?length .
                ?tonnageQuantity qudt:numericValue ?tonnage .

                BIND(
                    (
                        (
                            STR(?shipType) = "fishing_vessel" &&
                            ?length >= 24
                        ) ||
                        (
                            STR(?shipType) = "pleasure_yacht" &&
                            ?tonnage >= 300 &&
                            ?engagedInTrade = false
                        ) ||
                        (
                            STR(?shipType) = "cargo_ship" &&
                            ?tonnage >= 300 &&
                            ?tonnage < 500
                        )
                    )
                    AS ?expected
                )

                FILTER(?applicable != ?expected)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO26_002_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/ship> ] .

