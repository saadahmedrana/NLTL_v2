@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P03/ship> ;
            sh:resultMessage "The ship shall identify at least one heading-reference or position-fixing system." ;
            sh:resultPath nltl:headingOrPositionSystem ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship shall identify at least one heading-reference or position-fixing system." ;
                    sh:minCount 1 ;
                    sh:path nltl:headingOrPositionSystem ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P03/ship> ;
            sh:resultMessage "The intended-area suitability approval status shall be Approved." ;
            sh:resultPath nltl:intendedAreaSuitabilityApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n7c41482b838e49739bd8acf6cfd343d2b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P03/ship> ;
            sh:resultMessage "The intended area shall be specified for the heading-reference or position-fixing system." ;
            sh:resultPath nltl:intendedArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The intended area shall be specified for the heading-reference or position-fixing system." ;
                    sh:minCount 1 ;
                    sh:path nltl:intendedArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P03/ship> ;
            sh:resultMessage "The intended-area suitability approval status shall be Approved." ;
            sh:resultPath nltl:intendedAreaSuitabilityApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n7c41482b838e49739bd8acf6cfd343d2b3 ] .

_:n7c41482b838e49739bd8acf6cfd343d2b3 sh:class nltl:evidenceState ;
    sh:hasValue nltl:evidenceStateApproved ;
    sh:message "The intended-area suitability approval status shall be Approved." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:intendedAreaSuitabilityApprovalStatus .

