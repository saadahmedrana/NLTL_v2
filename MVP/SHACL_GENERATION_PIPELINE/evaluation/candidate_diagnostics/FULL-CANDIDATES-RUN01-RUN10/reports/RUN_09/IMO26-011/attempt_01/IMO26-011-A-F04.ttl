@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-011-A-F04/ship> ;
            sh:resultMessage "A construction date is required." ;
            sh:resultPath nltl:constructionDate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:date ;
                    sh:maxCount 1 ;
                    sh:message "A construction date is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:constructionDate ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-011-A-F04/ship> ;
            sh:resultMessage "For Category A or B ships constructed on or after 1 January 2026, bridge wings shall be enclosed, or bridge-wing protection shall be designed as required, or an Administration-approved equivalent protection arrangement shall be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-011-BridgeWingProtection> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-011-A-F04/ship> ] .

