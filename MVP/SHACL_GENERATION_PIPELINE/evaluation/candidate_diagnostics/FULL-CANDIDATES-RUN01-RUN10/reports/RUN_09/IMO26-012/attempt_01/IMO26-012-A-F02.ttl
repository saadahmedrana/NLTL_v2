@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F02/ship> ;
            sh:resultMessage "When at least two non-magnetic heading means are represented, each must be typed as a non-magnetic heading means, connected to main and emergency power, and independent from another distinct heading means on the same ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When at least two non-magnetic heading means are represented, each must be typed as a non-magnetic heading means, connected to main and emergency power, and independent from another distinct heading means on the same ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:hasNonMagneticHeadingMeans ?means .
                FILTER EXISTS {
                    $this nltl:hasNonMagneticHeadingMeans ?otherMeans .
                    FILTER (?otherMeans != ?means)
                }
                FILTER (
                    NOT EXISTS {
                        ?means a nltl:nonMagneticHeadingMeans
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasNonMagneticHeadingMeans ?otherTypedMeans .
                        FILTER (?otherTypedMeans != ?means)
                        ?otherTypedMeans a nltl:nonMagneticHeadingMeans
                    }
                    ||
                    NOT EXISTS {
                        ?means nltl:connectedToMainPower ?mainPower .
                        ?mainPower a nltl:benchmarkEntity
                    }
                    ||
                    NOT EXISTS {
                        ?means nltl:connectedToEmergencyPower ?emergencyPower .
                        ?emergencyPower a nltl:benchmarkEntity
                    }
                    ||
                    NOT EXISTS {
                        ?means nltl:independentFromHeadingMeans ?independentMeans .
                        FILTER (?independentMeans != ?means)
                        ?independentMeans a nltl:nonMagneticHeadingMeans .
                        $this nltl:hasNonMagneticHeadingMeans ?independentMeans
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-012> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F02/ship> ] .

