@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-P04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:iceClassRegulationEdition2008 ; sh:message Literal("Ships contracted from 1 January 2010 through 31 December 2011 must identify the 2008 Ice Class Regulations as applicable.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:applicableIceClassRegulationEdition ] ; sh:sparql [ sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionContractDate ?date .
                        FILTER (YEAR(?date) >= 2010 && YEAR(?date) < 2012)
                    }
                ") ] ] , [ sh:sparql [ sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionContractDate ?date .
                        FILTER (YEAR(?date) < 2010 || YEAR(?date) >= 2012)
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF004Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-P04/ship> ] .

