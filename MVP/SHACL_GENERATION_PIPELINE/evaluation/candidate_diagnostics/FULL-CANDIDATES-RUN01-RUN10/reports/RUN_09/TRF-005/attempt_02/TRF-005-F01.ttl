@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F01/ship> ;
            sh:resultMessage "For ships with a construction stage date on or after 2003-09-01 and a construction contract date before 2010-01-01, the applicable ice class regulation edition must be exactly the 2002 edition and no conflicting edition may be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ships with a construction stage date on or after 2003-09-01 and a construction contract date before 2010-01-01, the applicable ice class regulation edition must be exactly the 2002 edition and no conflicting edition may be present." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:constructionStageDate ?stageDate ;
                      nltl:constructionContractDate ?contractDate .

                FILTER (datatype(?stageDate) = xsd:date)
                FILTER (datatype(?contractDate) = xsd:date)

                FILTER (
                    YEAR(?stageDate) > 2003 ||
                    (YEAR(?stageDate) = 2003 && MONTH(?stageDate) > 9) ||
                    (YEAR(?stageDate) = 2003 && MONTH(?stageDate) = 9 && DAY(?stageDate) >= 1)
                )
                FILTER (YEAR(?contractDate) < 2010)

                FILTER (
                    NOT EXISTS {
                        ?this nltl:applicableIceClassRegulationEdition
                              nltl:iceClassRegulationEdition2002
                    }
                    ||
                    EXISTS {
                        ?this nltl:applicableIceClassRegulationEdition ?conflictingEdition .
                        FILTER (?conflictingEdition != nltl:iceClassRegulationEdition2002)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-005> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F01/ship> ] .

