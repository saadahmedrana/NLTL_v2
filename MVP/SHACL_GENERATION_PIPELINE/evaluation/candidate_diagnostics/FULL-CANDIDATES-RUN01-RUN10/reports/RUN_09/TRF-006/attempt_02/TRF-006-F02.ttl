@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F02/ship> ;
            sh:resultMessage "The ship must provide maximum continuous rating power as a single kW quantity." ;
            sh:resultPath nltl:maximumContinuousRatingPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide maximum continuous rating power as a single kW quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:maximumContinuousRatingPower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F02/ship> ;
            sh:resultMessage "For ships constructed from 1 November 1986 through 31 August 2003, the 1985 rule edition and the owner-request selector must be represented; a true selector requires the 2008 engine-output edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For ships constructed from 1 November 1986 through 31 August 2003, the 1985 rule edition and the owner-request selector must be represented; a true selector requires the 2008 engine-output edition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?d .

                FILTER (
                    (
                        YEAR(?d) > 1986 ||
                        (YEAR(?d) = 1986 && MONTH(?d) > 11) ||
                        (YEAR(?d) = 1986 && MONTH(?d) = 11 && DAY(?d) >= 1)
                    )
                    &&
                    (
                        YEAR(?d) < 2003 ||
                        (YEAR(?d) = 2003 && MONTH(?d) < 9)
                    )
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:applicableIceClassRegulationEdition
                            nltl:iceClassRuleEdition1985
                    }
                    ||
                    EXISTS {
                        $this nltl:applicableIceClassRegulationEdition ?applicableEdition .
                        FILTER (
                            ?applicableEdition !=
                            nltl:iceClassRuleEdition1985
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:ownerRequested2008EngineOutputRequirements ?selector .
                        FILTER (
                            ?selector = true ||
                            ?selector = false
                        )
                    }
                    ||
                    (
                        EXISTS {
                            $this nltl:ownerRequested2008EngineOutputRequirements true
                        }
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:engineOutputRegulationEdition
                                    nltl:iceClassRegulationEdition2008
                            }
                            ||
                            EXISTS {
                                $this nltl:engineOutputRegulationEdition ?engineEdition .
                                FILTER (
                                    ?engineEdition !=
                                    nltl:iceClassRegulationEdition2008
                                )
                            }
                        )
                    )
                    ||
                    (
                        EXISTS {
                            $this nltl:ownerRequested2008EngineOutputRequirements false
                        }
                        &&
                        EXISTS {
                            $this nltl:engineOutputRegulationEdition
                                nltl:iceClassRegulationEdition2008
                        }
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF006Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F02/ship> ] .

