@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F03/ship> ;
            sh:resultMessage "For an applicable IA or IA Super ship, valid delivery and assessment dates and one of the specified 2017 compliance methods are required, and compliance must be established by 1 January of the year in which twenty years have elapsed since delivery." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an applicable IA or IA Super ship, valid delivery and assessment dates and one of the specified 2017 compliance methods are required, and compliance must be established by 1 January of the year in which twenty years have elapsed since delivery." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                       nltl:constructionStageDate ?constructionStageDate .

                FILTER (
                    ?iceClass = nltl:iceClassIa ||
                    ?iceClass = nltl:iceClassIaSuper
                )
                FILTER (datatype(?constructionStageDate) = xsd:date)
                FILTER (?constructionStageDate < "2003-09-01"^^xsd:date)

                OPTIONAL {
                    $this nltl:deliveryDate ?deliveryDate .
                    FILTER (datatype(?deliveryDate) = xsd:date)
                }
                OPTIONAL {
                    $this nltl:assessmentDate ?assessmentDate .
                    FILTER (datatype(?assessmentDate) = xsd:date)
                }
                OPTIONAL {
                    $this nltl:engineOutputComplianceMethod ?method .
                    FILTER (
                        ?method = nltl:traficom2017Section3Point2Point2Method ||
                        ?method = nltl:traficom2017Section3Point2Point4Method
                    )
                }

                FILTER (
                    !BOUND(?deliveryDate) ||
                    !BOUND(?assessmentDate) ||
                    !BOUND(?method) ||
                    (
                        YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20
                    ) ||
                    (
                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                        MONTH(?assessmentDate) > 1
                    ) ||
                    (
                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                        MONTH(?assessmentDate) = 1 &&
                        DAY(?assessmentDate) > 1
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF009ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F03/ship> ] .

