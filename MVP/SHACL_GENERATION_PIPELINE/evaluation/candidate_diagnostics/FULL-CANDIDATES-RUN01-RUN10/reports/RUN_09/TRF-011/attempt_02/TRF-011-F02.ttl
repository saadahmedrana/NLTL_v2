@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F02/ship> ;
            sh:resultMessage "The upper ice waterline must equal the envelope of the highest intended ice-operating waterline points at every longitudinal position, with no extra or missing UIWL positions." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The upper ice waterline must equal the envelope of the highest intended ice-operating waterline points at every longitudinal position, with no extra or missing UIWL positions." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                {
                    SELECT ?this ?x
                    WHERE {
                        {
                            ?this nltl:hasIntendedIceOperatingWaterline ?iw .
                            ?iw nltl:hasWaterlineProfilePoint ?ip .
                            ?ip nltl:longitudinalPosition ?ixq .
                            ?ixq qudt:numericValue ?x ;
                                 qudt:unit <http://qudt.org/vocab/unit/M> .
                            FILTER (datatype(?x) = xsd:decimal)
                        }
                        UNION
                        {
                            ?this nltl:hasUpperIceWaterline ?uw .
                            ?uw nltl:hasWaterlineProfilePoint ?up .
                            ?up nltl:longitudinalPosition ?uxq .
                            ?uxq qudt:numericValue ?x ;
                                 qudt:unit <http://qudt.org/vocab/unit/M> .
                            FILTER (datatype(?x) = xsd:decimal)
                        }
                    }
                    GROUP BY ?this ?x
                }

                OPTIONAL {
                    ?this nltl:hasIntendedIceOperatingWaterline ?iw2 .
                    ?iw2 nltl:hasWaterlineProfilePoint ?ip2 .
                    ?ip2 nltl:longitudinalPosition ?ixq2 ;
                         nltl:verticalCoordinate ?ivq2 .
                    ?ixq2 qudt:numericValue ?x2 ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
                    ?ivq2 qudt:numericValue ?iv ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
                    FILTER (
                        datatype(?x2) = xsd:decimal &&
                        datatype(?iv) = xsd:decimal &&
                        ?x2 = ?x
                    )
                }

                OPTIONAL {
                    ?this nltl:hasUpperIceWaterline ?uw2 .
                    ?uw2 nltl:hasWaterlineProfilePoint ?up2 .
                    ?up2 nltl:longitudinalPosition ?uxq2 ;
                         nltl:verticalCoordinate ?uvq2 .
                    ?uxq2 qudt:numericValue ?x3 ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
                    ?uvq2 qudt:numericValue ?uv ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
                    FILTER (
                        datatype(?x3) = xsd:decimal &&
                        datatype(?uv) = xsd:decimal &&
                        ?x3 = ?x
                    )
                }

                {
                    SELECT ?this ?x
                           (MAX(?iv0) AS ?expected)
                           (MIN(?uv0) AS ?actualMin)
                           (MAX(?uv0) AS ?actualMax)
                           (COUNT(DISTINCT ?ip0) AS ?intendedCount)
                           (COUNT(DISTINCT ?up0) AS ?upperCount)
                    WHERE {
                        {
                            SELECT ?this ?x
                            WHERE {
                                {
                                    ?this nltl:hasIntendedIceOperatingWaterline ?iw0 .
                                    ?iw0 nltl:hasWaterlineProfilePoint ?ip0a .
                                    ?ip0a nltl:longitudinalPosition ?ixq0 .
                                    ?ixq0 qudt:numericValue ?x ;
                                          qudt:unit <http://qudt.org/vocab/unit/M> .
                                    FILTER (datatype(?x) = xsd:decimal)
                                }
                                UNION
                                {
                                    ?this nltl:hasUpperIceWaterline ?uw0 .
                                    ?uw0 nltl:hasWaterlineProfilePoint ?up0a .
                                    ?up0a nltl:longitudinalPosition ?uxq0 .
                                    ?uxq0 qudt:numericValue ?x ;
                                          qudt:unit <http://qudt.org/vocab/unit/M> .
                                    FILTER (datatype(?x) = xsd:decimal)
                                }
                            }
                            GROUP BY ?this ?x
                        }

                        OPTIONAL {
                            ?this nltl:hasIntendedIceOperatingWaterline ?iw1 .
                            ?iw1 nltl:hasWaterlineProfilePoint ?ip0 .
                            ?ip0 nltl:longitudinalPosition ?ixq1 ;
                                nltl:verticalCoordinate ?ivq0 .
                            ?ixq1 qudt:numericValue ?x1 ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                            ?ivq0 qudt:numericValue ?iv0 ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                            FILTER (
                                datatype(?x1) = xsd:decimal &&
                                datatype(?iv0) = xsd:decimal &&
                                ?x1 = ?x
                            )
                        }

                        OPTIONAL {
                            ?this nltl:hasUpperIceWaterline ?uw1 .
                            ?uw1 nltl:hasWaterlineProfilePoint ?up0 .
                            ?up0 nltl:longitudinalPosition ?uxq1 ;
                                nltl:verticalCoordinate ?uvq0 .
                            ?uxq1 qudt:numericValue ?x4 ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                            ?uvq0 qudt:numericValue ?uv0 ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                            FILTER (
                                datatype(?x4) = xsd:decimal &&
                                datatype(?uv0) = xsd:decimal &&
                                ?x4 = ?x
                            )
                        }
                    }
                    GROUP BY ?this ?x
                }

                FILTER (
                    !BOUND(?expected) ||
                    !BOUND(?actualMin) ||
                    !BOUND(?actualMax) ||
                    ABS(?actualMin - ?expected) >
                        (0.000001 * ABS(?expected) + 0.000001) ||
                    ABS(?actualMax - ?expected) >
                        (0.000001 * ABS(?expected) + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF011ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F02/ship> ] .

