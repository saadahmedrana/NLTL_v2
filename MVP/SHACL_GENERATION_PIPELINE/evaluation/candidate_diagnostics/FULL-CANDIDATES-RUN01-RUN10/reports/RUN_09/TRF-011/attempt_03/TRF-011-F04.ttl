@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ;
            sh:resultMessage "The upper ice waterline must contain exactly the pointwise envelope of the highest intended ice-operating waterline points." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The upper ice waterline must contain exactly the pointwise envelope of the highest intended ice-operating waterline points." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    SELECT $this ?pos
                           (MAX(?intendedY) AS ?expected)
                           (MIN(?uiwlY) AS ?actualMin)
                           (MAX(?uiwlY) AS ?actualMax)
                    WHERE {
                        {
                            $this nltl:hasIntendedIceOperatingWaterline ?intendedLine .
                            ?intendedLine nltl:hasWaterlineProfilePoint ?intendedPoint .
                            ?intendedPoint nltl:longitudinalPosition ?intendedPosition ;
                                           nltl:verticalCoordinate ?intendedCoordinate .
                            ?intendedPosition qudt:numericValue ?pos .
                            ?intendedCoordinate qudt:numericValue ?intendedY .
                        }
                        UNION
                        {
                            $this nltl:hasUpperIceWaterline ?uiwlLine .
                            ?uiwlLine nltl:hasWaterlineProfilePoint ?uiwlPoint .
                            ?uiwlPoint nltl:longitudinalPosition ?uiwlPosition ;
                                       nltl:verticalCoordinate ?uiwlCoordinate .
                            ?uiwlPosition qudt:numericValue ?pos .
                            ?uiwlCoordinate qudt:numericValue ?uiwlY .
                        }
                    }
                    GROUP BY $this ?pos
                }
                BIND(
                    IF(
                        ?expected >= "0"^^xsd:decimal,
                        ?expected * "0.000001"^^xsd:decimal,
                        -?expected * "0.000001"^^xsd:decimal
                    )
                    AS ?relativeTolerance
                )
                BIND(
                    IF(
                        ?relativeTolerance > "0.000000001"^^xsd:decimal,
                        ?relativeTolerance,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER(
                    !BOUND(?expected)
                    || !BOUND(?actualMin)
                    || !BOUND(?actualMax)
                    || ?actualMin < ?expected - ?tolerance
                    || ?actualMax > ?expected + ?tolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/upperIceWaterline> ;
                    sh:resultMessage "Less than 1 values on ex:upperIceWaterline->nltl:hasWaterlineProfilePoint" ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:waterlineProfilePoint ;
                            sh:minCount 1 ;
                            sh:node gen:WaterlineProfilePointShape ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:hasWaterlineProfilePoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IceWaterlineShape. See details for more information." ;
            sh:resultPath nltl:hasUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:minCount 1 ;
                    sh:node gen:IceWaterlineShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasUpperIceWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/upperIceWaterline> ] .

