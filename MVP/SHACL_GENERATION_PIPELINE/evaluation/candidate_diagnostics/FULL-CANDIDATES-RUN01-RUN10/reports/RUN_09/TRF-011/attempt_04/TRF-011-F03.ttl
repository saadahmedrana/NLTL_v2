@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/ship> ;
            sh:resultMessage "The upper ice waterline must contain exactly the maximum intended ice-operating waterline height at every longitudinal position, with no missing or extra positions." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The upper ice waterline must contain exactly the maximum intended ice-operating waterline height at every longitudinal position, with no missing or extra positions." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this ?position ?expected ?actualMin ?actualMax
WHERE {
  {
    SELECT ?this ?position
           (MAX(IF(?kind = "intended", ?value, ?unboundIntended)) AS ?expected)
           (MIN(IF(?kind = "uiwl", ?value, ?unboundUIWL)) AS ?actualMin)
           (MAX(IF(?kind = "uiwl", ?value, ?unboundUIWL)) AS ?actualMax)
           (SUM(IF(?kind = "intended", 1, 0)) AS ?intendedCount)
           (SUM(IF(?kind = "uiwl", 1, 0)) AS ?uiwlCount)
    WHERE {
      {
        ?this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
        ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
        ?intendedPoint nltl:longitudinalPosition ?intendedPosition .
        ?intendedPosition qudt:numericValue ?position .
        ?intendedPoint nltl:verticalCoordinate ?intendedVertical .
        ?intendedVertical qudt:numericValue ?value .
        FILTER(datatype(?position) = xsd:decimal)
        FILTER(datatype(?value) = xsd:decimal)
        BIND("intended" AS ?kind)
      }
      UNION
      {
        ?this nltl:hasUpperIceWaterline ?uiwlWaterline .
        ?uiwlWaterline nltl:hasWaterlineProfilePoint ?uiwlPoint .
        ?uiwlPoint nltl:longitudinalPosition ?uiwlPosition .
        ?uiwlPosition qudt:numericValue ?position .
        ?uiwlPoint nltl:verticalCoordinate ?uiwlVertical .
        ?uiwlVertical qudt:numericValue ?value .
        FILTER(datatype(?position) = xsd:decimal)
        FILTER(datatype(?value) = xsd:decimal)
        BIND("uiwl" AS ?kind)
      }
    }
    GROUP BY ?this ?position
  }
  FILTER(
    ?intendedCount = 0 ||
    ?uiwlCount = 0 ||
    !BOUND(?expected) ||
    !BOUND(?actualMin) ||
    !BOUND(?actualMax) ||
    ?actualMin < (?expected - (ABS(?expected) * 0.000001 + 0.000000001)) ||
    ?actualMin > (?expected + (ABS(?expected) * 0.000001 + 0.000000001)) ||
    ?actualMax < (?expected - (ABS(?expected) * 0.000001 + 0.000000001)) ||
    ?actualMax > (?expected + (ABS(?expected) * 0.000001 + 0.000000001))
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF011ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasUpperIceWaterline" ;
            sh:resultPath nltl:hasUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:minCount 1 ;
                    sh:node gen:TRF011IceWaterlineShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasUpperIceWaterline ] ] .

