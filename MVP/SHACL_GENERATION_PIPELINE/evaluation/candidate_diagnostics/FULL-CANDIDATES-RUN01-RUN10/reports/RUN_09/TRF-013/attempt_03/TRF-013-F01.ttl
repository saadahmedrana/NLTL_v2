@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-F01/ship> ;
            sh:resultMessage "When ice conditions require an ice-strengthened ship, the fore and aft operating draughts shall be inclusively between their corresponding minimum and maximum ice-class draughts, with the ice class and both waterlines linked to the same ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When ice conditions require an ice-strengthened ship, the fore and aft operating draughts shall be inclusively between their corresponding minimum and maximum ice-class draughts, with the ice class and both waterlines linked to the same ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipIceStrengthened true ;
                      nltl:iceClass ?iceClass ;
                      nltl:hasUpperIceWaterline ?upperWaterline ;
                      nltl:hasLowerIceWaterline ?lowerWaterline ;
                      nltl:operatingForeDraught ?operatingFore ;
                      nltl:operatingAftDraught ?operatingAft ;
                      nltl:maximumIceClassDraughtFore ?maximumFore ;
                      nltl:maximumIceClassDraughtAft ?maximumAft ;
                      nltl:minimumIceClassDraughtFore ?minimumFore ;
                      nltl:minimumIceClassDraughtAft ?minimumAft .
                ?operatingFore qudt:numericValue ?operatingForeValue .
                ?operatingAft qudt:numericValue ?operatingAftValue .
                ?maximumFore qudt:numericValue ?maximumForeValue .
                ?maximumAft qudt:numericValue ?maximumAftValue .
                ?minimumFore qudt:numericValue ?minimumForeValue .
                ?minimumAft qudt:numericValue ?minimumAftValue .
                FILTER (
                    ?operatingForeValue < ?minimumForeValue ||
                    ?operatingForeValue > ?maximumForeValue ||
                    ?operatingAftValue < ?minimumAftValue ||
                    ?operatingAftValue > ?maximumAftValue
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-013> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-F01/ship> ] .

