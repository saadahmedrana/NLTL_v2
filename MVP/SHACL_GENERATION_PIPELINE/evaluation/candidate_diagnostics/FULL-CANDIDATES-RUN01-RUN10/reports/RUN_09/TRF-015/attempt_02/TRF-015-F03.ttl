@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F03/ship> ;
            sh:resultMessage "Loading calculation sea water salinity must represent the intended-route sea water salinity." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Loading calculation sea water salinity must represent the intended-route sea water salinity." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:intendedRouteSeaWaterSalinity ?intendedQuantity ;
                          nltl:loadingCalculationSeaWaterSalinity ?loadingQuantity .
                    ?intendedQuantity qudt:numericValue ?intendedValue ;
                                       qudt:unit nltl:gramPerKilogramSalinityUnit .
                    ?loadingQuantity qudt:numericValue ?loadingValue ;
                                      qudt:unit nltl:gramPerKilogramSalinityUnit .
                    FILTER (?intendedValue = ?loadingValue)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-015-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F03/ship> ] .

