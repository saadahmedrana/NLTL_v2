@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F03/ship> ;
            sh:resultMessage "The highest point of the propeller must be submerged." ;
            sh:resultPath nltl:propellerHighestPointSubmerged ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The highest point of the propeller must be submerged." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerHighestPointSubmerged ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:TRF-016-ApplicableNavigatingInIce , gs:TRF-016-NonApplicableNavigatingInIce" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF-016-ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F03/ship> ] .

