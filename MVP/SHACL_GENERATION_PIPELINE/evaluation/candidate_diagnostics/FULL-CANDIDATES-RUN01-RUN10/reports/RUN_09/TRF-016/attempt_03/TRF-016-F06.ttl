@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F06/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:TRF-016-ApplicableNavigatingInIce , gs:TRF-016-NonApplicableNavigatingInIce" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF-016-ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F06/ship> ] .

