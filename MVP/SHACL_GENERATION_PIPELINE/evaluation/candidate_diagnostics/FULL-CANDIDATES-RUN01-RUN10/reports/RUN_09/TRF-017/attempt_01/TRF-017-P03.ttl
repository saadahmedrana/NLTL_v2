@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P03/ship> ;
            sh:resultMessage "When propulsion output is not restricted, maximum continuous rating power must equal propulsion machinery continuous output." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When propulsion output is not restricted, maximum continuous rating power must equal propulsion machinery continuous output." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies ?restriction ;
                      nltl:maximumContinuousRatingPower ?maximumNode ;
                      nltl:propulsionMachineryContinuousOutput ?machineryNode .
                FILTER (?restriction = "false"^^xsd:boolean)
                ?maximumNode qudt:numericValue ?maximumValue .
                ?machineryNode qudt:numericValue ?machineryValue .
                FILTER (?maximumValue != ?machineryValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:ShipPropulsionOutputShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P03/ship> ] .

