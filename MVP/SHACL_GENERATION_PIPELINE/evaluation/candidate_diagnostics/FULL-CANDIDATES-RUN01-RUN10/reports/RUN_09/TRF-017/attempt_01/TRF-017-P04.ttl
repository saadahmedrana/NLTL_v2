@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P04/ship> ;
            sh:resultMessage "When propulsion output is restricted, maximum continuous rating power must equal restricted propulsion output." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When propulsion output is restricted, maximum continuous rating power must equal restricted propulsion output." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies ?restriction ;
                      nltl:maximumContinuousRatingPower ?maximumNode ;
                      nltl:restrictedPropulsionOutput ?restrictedNode .
                FILTER (?restriction = "true"^^xsd:boolean)
                ?maximumNode qudt:numericValue ?maximumValue .
                ?restrictedNode qudt:numericValue ?restrictedValue .
                FILTER (?maximumValue != ?restrictedValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:ShipPropulsionOutputShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P04/ship> ] .

