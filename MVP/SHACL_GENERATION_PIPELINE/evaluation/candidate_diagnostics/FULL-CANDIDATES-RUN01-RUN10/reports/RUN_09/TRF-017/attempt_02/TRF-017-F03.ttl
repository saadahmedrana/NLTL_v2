@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:additionalPropulsionPower" ;
            sh:resultPath nltl:additionalPropulsionPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:additionalPropulsionPower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propulsionOutputRestrictionApplies ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloW ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:propulsionMachineryContinuousOutput ] ; sh:sparql [ sh:message Literal("When propulsion output restriction does not apply, maximum continuous rating power shall equal propulsion machinery continuous output plus additional propulsion power within a relative tolerance of 1e-6 and an absolute fallback of 1e-6 kW.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propulsionOutputRestrictionApplies false .
                        $this nltl:maximumContinuousRatingPower ?reportedNode .
                        ?reportedNode qudt:numericValue ?reported .
                        $this nltl:propulsionMachineryContinuousOutput ?machineryNode .
                        ?machineryNode qudt:numericValue ?machinery .
                        $this nltl:additionalPropulsionPower ?additionalNode .
                        ?additionalNode qudt:numericValue ?additional .
                        BIND((?machinery + ?additional) AS ?expected)
                        FILTER(
                            ABS(?reported - ?expected) >
                            (0.000001 * ABS(?expected) + 0.000001)
                        )
                    }
                ") ] ] , [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propulsionOutputRestrictionApplies ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloW ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:restrictedPropulsionOutput ] ; sh:sparql [ sh:message Literal("When propulsion output restriction applies, maximum continuous rating power shall equal restricted propulsion output plus additional propulsion power within a relative tolerance of 1e-6 and an absolute fallback of 1e-6 kW.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propulsionOutputRestrictionApplies true .
                        $this nltl:maximumContinuousRatingPower ?reportedNode .
                        ?reportedNode qudt:numericValue ?reported .
                        $this nltl:restrictedPropulsionOutput ?restrictedNode .
                        ?restrictedNode qudt:numericValue ?restricted .
                        $this nltl:additionalPropulsionPower ?additionalNode .
                        ?additionalNode qudt:numericValue ?additional .
                        BIND((?restricted + ?additional) AS ?expected)
                        FILTER(
                            ABS(?reported - ?expected) >
                            (0.000001 * ABS(?expected) + 0.000001)
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-017> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F03/ship> ] .

