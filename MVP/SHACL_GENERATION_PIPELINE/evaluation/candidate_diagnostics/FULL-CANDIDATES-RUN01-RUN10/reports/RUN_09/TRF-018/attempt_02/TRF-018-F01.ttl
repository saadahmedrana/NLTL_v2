@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F01/ship> ;
            sh:resultMessage "For ice classes IA, IB and IC, maximumContinuousRatingPower must be at least calculatedRequiredPower and 1000 kW; for IA Super, it must be at least calculatedRequiredPower and 2800 kW." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For ice classes IA, IB and IC, maximumContinuousRatingPower must be at least calculatedRequiredPower and 1000 kW; for IA Super, it must be at least calculatedRequiredPower and 2800 kW." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:calculatedRequiredPower ?calculatedNode ;
                      nltl:maximumContinuousRatingPower ?maximumNode .

                ?calculatedNode qudt:numericValue ?calculated ;
                                qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                ?maximumNode qudt:numericValue ?maximum ;
                              qudt:unit <http://qudt.org/vocab/unit/KiloW> .

                FILTER (
                    (
                        ?ice IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                        && (?maximum < ?calculated || ?maximum < 1000)
                    )
                    ||
                    (
                        ?ice = nltl:iceClassIaSuper
                        && (?maximum < ?calculated || ?maximum < 2800)
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF018ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F01/ship> ] .

