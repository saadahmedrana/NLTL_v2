@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:node gs:PowerRequirementsShape ; sh:property [ sh:hasValue nltl:iceClassIaSuper ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:node gs:PowerRequirementsShape ; sh:property [ sh:hasValue nltl:iceClassIa ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:node gs:PowerRequirementsShape ; sh:property [ sh:hasValue nltl:iceClassIb ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:node gs:PowerRequirementsShape ; sh:property [ sh:hasValue nltl:iceClassIc ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:hasValue nltl:iceClassIi ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:hasValue nltl:iceClassIii ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF018ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F04/ship> ] .

