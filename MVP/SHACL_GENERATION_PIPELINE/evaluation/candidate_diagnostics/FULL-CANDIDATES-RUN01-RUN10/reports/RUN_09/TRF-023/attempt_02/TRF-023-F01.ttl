@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:iceClassRuleEdition1985 ; sh:message Literal("The applicable ice class regulation edition must be the 1985 rules for this branch.") ; sh:path nltl:applicableIceClassRegulationEdition ], [ sh:in ( nltl:iceClassIb nltl:iceClassIc ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("For the 1985 rules, the ship ice class must be IB or IC.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloW> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Maximum continuous rating power must be expressed in kW.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:maximumContinuousRatingPower ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloW> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Required power under the 1985 rules must be expressed in kW.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:requiredPowerUnder1985Rules ] ; sh:sparql [ sh:message Literal("For ice class IB or IC under the 1985 rules, maximum continuous rating power must be at least the required power.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc)) .

                        $this nltl:maximumContinuousRatingPower ?maximumQuantity .
                        ?maximumQuantity qudt:numericValue ?maximumValue .
                        ?maximumQuantity qudt:unit <http://qudt.org/vocab/unit/KiloW> .

                        $this nltl:requiredPowerUnder1985Rules ?requiredQuantity .
                        ?requiredQuantity qudt:numericValue ?requiredValue .
                        ?requiredQuantity qudt:unit <http://qudt.org/vocab/unit/KiloW> .

                        FILTER (?maximumValue < ?requiredValue)
                    }
                ") ] ] , [ sh:property [ sh:in ( nltl:iceClassRegulationEdition2002 nltl:iceClassRegulationEdition2008 nltl:iceClassRegulationEdition2010 nltl:iceClassRegulationEdition2017 nltl:iceClassRegulationEdition2021 ) ; sh:message Literal("The applicable regulation edition is not the 1985 edition, so the IB/IC 1985-rule power constraint does not apply.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:applicableIceClassRegulationEdition ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF023ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F01/ship> ] .

