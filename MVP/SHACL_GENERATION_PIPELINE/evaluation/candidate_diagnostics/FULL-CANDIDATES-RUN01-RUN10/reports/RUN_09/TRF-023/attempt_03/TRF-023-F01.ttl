@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F01/ship> ;
            sh:resultMessage "Maximum continuous rating power must be at least the required power under the 1985 rules." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Maximum continuous rating power must be at least the required power under the 1985 rules." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass = nltl:iceClassIb ||
                    ?iceClass = nltl:iceClassIc
                )
                $this nltl:applicableIceClassRegulationEdition
                    nltl:iceClassRuleEdition1985 .
                $this nltl:maximumContinuousRatingPower ?maximumQuantity .
                ?maximumQuantity qudt:numericValue ?maximumValue .
                $this nltl:requiredPowerUnder1985Rules ?requiredQuantity .
                ?requiredQuantity qudt:numericValue ?requiredValue .
                FILTER ( ?maximumValue < ?requiredValue )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF023PowerComparisonShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F01/ship> ] .

