@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-F03/ship> ;
            sh:resultMessage "For ice class IA Super or IA with construction begun before 1 September 2003, the assessment date must be no later than 1 January of the year twenty years after delivery." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ice class IA Super or IA with construction begun before 1 September 2003, the assessment date must be no later than 1 January of the year twenty years after delivery." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:constructionStageDate ?constructionDate ;
                          nltl:deliveryDate ?deliveryDate ;
                          nltl:assessmentDate ?assessmentDate .
                    FILTER (
                        DATATYPE(?constructionDate) = xsd:date &&
                        DATATYPE(?deliveryDate) = xsd:date &&
                        DATATYPE(?assessmentDate) = xsd:date
                    )
                    FILTER (
                        YEAR(?constructionDate) < 2003 ||
                        (
                            YEAR(?constructionDate) = 2003 &&
                            MONTH(?constructionDate) < 9
                        )
                    )
                    FILTER (
                        YEAR(?assessmentDate) < YEAR(?deliveryDate) + 20 ||
                        (
                            YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                            MONTH(?assessmentDate) >= 1 &&
                            DAY(?assessmentDate) >= 1
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF024Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-F03/ship> ] .

