@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-025-F03/ship> ;
            sh:resultMessage "For an IA Super ship without a bulbous bow, the required calculation inputs and externally computed C1 and C2 results must be present with their declared units; non-applicable ships are validated through the permitted applicability branches." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF025> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-025-F03/ship> ] .

