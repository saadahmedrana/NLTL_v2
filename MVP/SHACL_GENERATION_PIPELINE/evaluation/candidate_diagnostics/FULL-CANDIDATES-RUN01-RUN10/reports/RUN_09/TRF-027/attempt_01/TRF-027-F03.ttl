@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:node gen:TRF027ApplicableShape ] , [ sh:node gen:TRF027NonApplicableClassShape ] , [ sh:node gen:TRF027LaterConstructionShape ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF027Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-F03/ship> ] .

