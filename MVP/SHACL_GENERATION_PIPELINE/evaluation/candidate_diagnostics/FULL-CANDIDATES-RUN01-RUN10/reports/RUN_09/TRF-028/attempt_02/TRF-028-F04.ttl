@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in ([ sh:property [ sh:class nltl:alternativeCalculationEvidence ; sh:message Literal(\"An approved alternative calculation method requires alternative calculation evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasEvidence ] ] , [ sh:property [ sh:class nltl:modelTestEvidence ; sh:message Literal(\"An approved model-test method requires model-test evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasEvidence ] ]) and ([ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:engineOutputCoefficientKe ] ] , [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/N> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:brashIceChannelResistanceRch ] ])" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF028Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F04/ship> ;
            sh:resultMessage "An approved ship must have approvalRevocationStatus evidenceStateApproved." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "An approved ship must have approvalRevocationStatus evidenceStateApproved." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:approvalStatus true ;
                      nltl:approvalRevocationStatus ?state .
                FILTER (?state != nltl:evidenceStateApproved)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF028Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F04/ship> ] .

