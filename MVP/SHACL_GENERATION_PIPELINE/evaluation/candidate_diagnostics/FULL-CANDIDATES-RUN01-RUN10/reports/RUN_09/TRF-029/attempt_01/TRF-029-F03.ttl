@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-029-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"directAnalysisUsed must be false when direct analysis is not used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:directAnalysisUsed ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Prescribed procedure applicability must be false when direct analysis is used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:prescribedProcedureApplicability ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"directAnalysisUsed must be true for the direct-analysis branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:directAnalysisUsed ], [ sh:datatype xsd:string ; sh:message Literal(\"A structural arrangement is required when direct analysis is used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:structuralArrangement ], [ sh:hasValue nltl:evidenceStateApproved ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Direct analysis must have approved status.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:directAnalysisApprovalStatus ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF029Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-029-F03/ship> ] .

