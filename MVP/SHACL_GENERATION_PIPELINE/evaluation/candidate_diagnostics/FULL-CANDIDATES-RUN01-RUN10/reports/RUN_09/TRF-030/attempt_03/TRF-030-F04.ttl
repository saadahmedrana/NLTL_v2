            sh:resultMessage "Focus node does not conform to shape MinCount 1: [ sh:class nltl:directAnalysisCase ; sh:property [ sh:hasValue nltl:halfLoadHeightBelowLowerIceWaterlinePosition ; sh:path nltl:verticalLoadPositionType ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lowerIceWaterlineReferencePosition ] ]" ;
            sh:resultPath nltl:hasDirectAnalysisCase ;
