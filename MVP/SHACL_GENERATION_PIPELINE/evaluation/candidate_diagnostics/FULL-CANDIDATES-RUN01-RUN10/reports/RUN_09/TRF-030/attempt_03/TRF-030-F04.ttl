            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/directAnalysis> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/ship> ;
