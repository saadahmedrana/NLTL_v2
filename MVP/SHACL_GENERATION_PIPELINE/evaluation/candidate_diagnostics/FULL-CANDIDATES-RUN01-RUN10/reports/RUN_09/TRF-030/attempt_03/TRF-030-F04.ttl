            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:path nltl:hasDirectAnalysisCase ;
                    sh:qualifiedMinCount 2 ;
                    sh:qualifiedValueShape [ sh:class nltl:directAnalysisCase ;
                            sh:property [ sh:in ( nltl:midSpanOrSpacingCenteredPosition nltl:otherHorizontalPosition ) ;
                                    sh:path nltl:horizontalLoadPositionType ] ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:icePressure" ;
            sh:resultPath nltl:icePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
