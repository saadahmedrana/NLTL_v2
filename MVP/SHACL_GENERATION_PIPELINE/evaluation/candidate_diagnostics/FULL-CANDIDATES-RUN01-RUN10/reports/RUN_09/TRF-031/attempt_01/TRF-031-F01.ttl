@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/ship> ;
            sh:resultMessage "Combined bending and shear stress must be lower than the yield point, and yield shear stress must equal yield point divided by sqrt(3) within a relative tolerance of 1e-6, with an absolute tolerance fallback of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Combined bending and shear stress must be lower than the yield point, and yield shear stress must equal yield point divided by sqrt(3) within a relative tolerance of 1e-6, with an absolute tolerance fallback of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldPointQuantity ;
                      nltl:combinedBendingShearStress ?combinedQuantity ;
                      nltl:yieldShearStress ?yieldShearQuantity .
                ?yieldPointQuantity qudt:numericValue ?yieldPoint .
                ?combinedQuantity qudt:numericValue ?combined .
                ?yieldShearQuantity qudt:numericValue ?reported .
                BIND((?yieldPoint / 1.7320508075688772) AS ?expected)
                BIND(IF(ABS(?expected) * 0.000001 > 0.000000001,
                        ABS(?expected) * 0.000001,
                        0.000000001) AS ?tolerance)
                FILTER (
                    ?combined >= ?yieldPoint ||
                    ABS(?reported - ?expected) > ?tolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF031Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F01/ship> ] .

