@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F01/effectiveSection> ;
            sh:resultMessage "The effective member cross section must be linked from a hull structure." ;
            sh:resultPath [ sh:inversePath nltl:hasEffectiveMemberCrossSection ] ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:hullStructure ;
                    sh:message "The effective member cross section must be linked from a hull structure." ;
                    sh:minCount 1 ;
                    sh:path [ sh:inversePath nltl:hasEffectiveMemberCrossSection ] ] ] .

