@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/effectiveSection> ;
            sh:resultMessage "The effective member cross section must be linked to a hull structure whose normal-to-plating status is established; non-normal members require classification-society section-property calculation evidence." ;
            sh:resultPath nltl:hasEffectiveMemberCrossSection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The effective member cross section must be linked to a hull structure whose normal-to-plating status is established; non-normal members require classification-society section-property calculation evidence." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:hullStructure ;
                            sh:or ( [ sh:property [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:memberNormalToPlating ] ] [ sh:property [ sh:node [ ] ;
                                                sh:path [ ] ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:hasValue false ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:memberNormalToPlating ] ] ) ] ;
                    sh:path nltl:hasEffectiveMemberCrossSection ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/shearArea> ;
                    sh:resultMessage "Node ex:shearArea->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/M2>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/M2> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/effectiveSection> ;
            sh:resultMessage "The effective member cross section must provide one shear area quantity in square metres." ;
            sh:resultPath nltl:shearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The effective member cross section must provide one shear area quantity in square metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M2> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:shearArea ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/shearArea> ] .

