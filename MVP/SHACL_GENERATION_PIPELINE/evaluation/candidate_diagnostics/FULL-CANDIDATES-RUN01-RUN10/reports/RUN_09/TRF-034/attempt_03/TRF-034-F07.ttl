@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/shearArea> ;
                    sh:resultMessage "Node ex:shearArea->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/M2>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/M2> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/effectiveSection> ;
            sh:resultMessage "The effective member cross section must provide a shear area in square metres." ;
            sh:resultPath nltl:shearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The effective member cross section must provide a shear area in square metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M2> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:shearArea ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/shearArea> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/member> ;
                    sh:resultMessage "Node ex:member must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:memberNormalToPlating ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:memberNormalToPlating ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property <http://recursion.too.deep> ] ; sh:path [ sh:inversePath nltl:hasEffectiveMemberCrossSection ] ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:memberNormalToPlating ] ] [ sh:property [ sh:minCount 1 ;
                                                sh:node [ sh:property [ ] ] ;
                                                sh:path [ sh:inversePath nltl:hasEffectiveMemberCrossSection ] ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:hasValue false ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:memberNormalToPlating ] ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/effectiveSection> ;
            sh:resultMessage "The effective member cross section must link to a hull structure with a declared plating orientation; a non-normal member requires classification-society section-property calculation evidence." ;
            sh:resultPath [ sh:inversePath nltl:hasEffectiveMemberCrossSection ] ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:hullStructure ;
                    sh:message "The effective member cross section must link to a hull structure with a declared plating orientation; a non-normal member requires classification-society section-property calculation evidence." ;
                    sh:minCount 1 ;
                    sh:node [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:memberNormalToPlating ] ] [ sh:property [ sh:datatype xsd:boolean ;
                                                sh:hasValue false ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:memberNormalToPlating ],
                                            [ sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path [ ] ] ] ) ] ;
                    sh:path [ sh:inversePath nltl:hasEffectiveMemberCrossSection ] ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F07/member> ] .

