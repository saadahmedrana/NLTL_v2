@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F04/ship> ;
            sh:resultMessage "The ship shall provide an ice class design parameter set." ;
            sh:resultPath nltl:hasIceClassDesignParameterSet ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceClassDesignParameterSet ;
                    sh:message "The ship shall provide an ice class design parameter set." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF036_IceClassDesignParameterSetShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceClassDesignParameterSet ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F04/designParameters> ;
            sh:resultMessage "The ice class, permitted level ice thickness, and design ice load height shall conform to Table 4-1." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ice class, permitted level ice thickness, and design ice load height shall conform to Table 4-1." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:or ( [ sh:hasValue nltl:iceClassIaSuper ;
                                sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class qudt:QuantityValue ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:designIceLoadHeight ],
                                    [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class qudt:QuantityValue ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:levelIceThickness ] ] [ sh:hasValue nltl:iceClassIa ;
                                sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class qudt:QuantityValue ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:designIceLoadHeight ],
                                    [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class qudt:QuantityValue ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:levelIceThickness ] ] [ sh:hasValue nltl:iceClassIb ;
                                sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class qudt:QuantityValue ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:designIceLoadHeight ],
                                    [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class qudt:QuantityValue ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:levelIceThickness ] ] [ sh:hasValue nltl:iceClassIc ;
                                sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class qudt:QuantityValue ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:designIceLoadHeight ],
                                    [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class qudt:QuantityValue ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:levelIceThickness ] ] ) ;
                    sh:path nltl:iceClass ] ;
            sh:value nltl:iceClassIa ] .

