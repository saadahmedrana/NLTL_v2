[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-P01/designParameters> ;
            sh:resultMessage "The ice class, permitted level ice thickness, and design ice load height shall conform to Table 4-1." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape _:n010a625277ab433e94f2481922029038b2 ;
            sh:value nltl:iceClassIaSuper ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-P01/designParameters> ;
                    sh:resultMessage "The ice class, permitted level ice thickness, and design ice load height shall conform to Table 4-1." ;
                    sh:resultPath nltl:iceClass ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape _:n010a625277ab433e94f2481922029038b2 ;
                    sh:value nltl:iceClassIaSuper ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-P01/ship> ;
            sh:resultMessage "The ship shall provide an ice class design parameter set." ;
            sh:resultPath nltl:hasIceClassDesignParameterSet ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceClassDesignParameterSet ;
                    sh:message "The ship shall provide an ice class design parameter set." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF036_IceClassDesignParameterSetShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceClassDesignParameterSet ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-P01/designParameters> ] .

