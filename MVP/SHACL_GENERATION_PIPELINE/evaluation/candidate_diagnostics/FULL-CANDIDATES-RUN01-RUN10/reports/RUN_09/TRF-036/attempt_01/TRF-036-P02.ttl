    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-P02/designParameters> ;
            sh:resultMessage "The ice class, permitted level ice thickness, and design ice load height shall conform to Table 4-1." ;
