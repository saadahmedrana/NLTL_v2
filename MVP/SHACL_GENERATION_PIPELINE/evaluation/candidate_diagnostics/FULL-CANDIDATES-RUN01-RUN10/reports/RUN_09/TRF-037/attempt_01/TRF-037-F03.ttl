@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-F03/ship> ;
            sh:resultMessage "shipSizeEngineOutputFactorCd must equal the capped value IF((a*k+b)/1000 is greater than 1, 1, (a*k+b)/1000), within a relative tolerance of 1e-6 and an absolute tolerance of 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "shipSizeEngineOutputFactorCd must equal the capped value IF((a*k+b)/1000 is greater than 1, 1, (a*k+b)/1000), within a relative tolerance of 1e-6 and an absolute tolerance of 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipSizeEngineOutputCoefficientA ?aNode ;
                      nltl:shipSizeEngineOutputCoefficientK ?kNode ;
                      nltl:shipSizeEngineOutputCoefficientB ?bNode ;
                      nltl:shipSizeEngineOutputFactorCd ?cdNode .
                ?aNode qudt:numericValue ?a .
                ?kNode qudt:numericValue ?k .
                ?bNode qudt:numericValue ?b .
                ?cdNode qudt:numericValue ?actualCd .
                BIND ((?a * ?k + ?b) / 1000 AS ?rawCd)
                BIND (IF(?rawCd > 1, 1, ?rawCd) AS ?expectedCd)
                FILTER (
                    ABS(?actualCd - ?expectedCd) >
                    (ABS(?expectedCd) * 0.000001 + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_037_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasDirectAnalysisCase" ;
            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:directAnalysisCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:iceLoadAreaFactorCa ] ] ;
                    sh:path nltl:hasDirectAnalysisCase ] ] .

