@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasDirectAnalysisCase" ;
            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:directAnalysisCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:iceLoadAreaFactorCa ] ] ;
                    sh:path nltl:hasDirectAnalysisCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-F01/ship> ;
            sh:resultMessage "shipSizeEngineOutputFactorCd must equal the capped value of (a*k+b)/1000 within numerical tolerance" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "shipSizeEngineOutputFactorCd must equal the capped value of (a*k+b)/1000 within numerical tolerance" ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipSizeEngineOutputCoefficientA ?aNode ;
                      nltl:shipSizeEngineOutputCoefficientK ?kNode ;
                      nltl:shipSizeEngineOutputCoefficientB ?bNode ;
                      nltl:shipSizeEngineOutputFactorCd ?actualNode .
                ?aNode <http://qudt.org/schema/qudt/numericValue> ?a .
                ?kNode <http://qudt.org/schema/qudt/numericValue> ?k .
                ?bNode <http://qudt.org/schema/qudt/numericValue> ?b .
                ?actualNode <http://qudt.org/schema/qudt/numericValue> ?actual .
                BIND (((?a * ?k) + ?b) / 1000.0 AS ?rawCd)
                BIND (IF(?rawCd > 1.0, 1.0, ?rawCd) AS ?expected)
                BIND (?actual - ?expected AS ?delta)
                BIND (IF(?delta < 0, -?delta, ?delta) AS ?error)
                BIND (IF(?expected < 0, -?expected, ?expected) AS ?expectedMagnitude)
                BIND (IF(?expectedMagnitude > 0.000000001, ?expectedMagnitude, 0.000000001) AS ?scale)
                FILTER (?error > (0.000001 * ?scale))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF037ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-F01/ship> ] .

