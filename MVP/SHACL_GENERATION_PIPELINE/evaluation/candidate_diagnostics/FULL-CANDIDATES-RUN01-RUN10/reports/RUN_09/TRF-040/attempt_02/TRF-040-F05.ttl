@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F05/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in ([ sh:sparql [ sh:message Literal("For ice class IA Super, forefoot shell strengthening shall equal bow-region equivalence.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass nltl:iceClassIaSuper .
                        FILTER NOT EXISTS {
                            $this nltl:forefootShellStrengtheningStatus ?forefoot ;
                                  nltl:bowRegionEquivalent ?bow .
                            FILTER (?forefoot = ?bow)
                        }
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bowRegionEquivalent ], [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:forefootShellStrengtheningStatus ] ]) and ([ sh:sparql [ sh:message Literal("For ice class IA Super, the applicable upper-bow condition shall be established with the open-water service speed.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass nltl:iceClassIaSuper ;
                              nltl:openWaterServiceSpeed ?speed .
                        ?speed qudt:numericValue ?v .
                        FILTER (?v < 18)
                    }
                ") ] ] , [ sh:sparql [ sh:message Literal("For ice class IA, the applicable upper-bow condition shall be established with the open-water service speed.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass nltl:iceClassIa ;
                              nltl:openWaterServiceSpeed ?speed .
                        ?speed qudt:numericValue ?v .
                        FILTER (?v < 18)
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:midbodyEquivalent ], [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:upperBowIceBeltStrengtheningStatus ] ; sh:sparql [ sh:message Literal("For ice class IA or IA Super at an open-water service speed of at least 18 knots, upper-bow strengthening shall equal midbody equivalence.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?ice ;
                              nltl:openWaterServiceSpeed ?speed ;
                              nltl:upperBowIceBeltStrengtheningStatus ?upper ;
                              nltl:midbodyEquivalent ?mid .
                        ?speed qudt:numericValue ?v .
                        FILTER (?ice IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                        FILTER (?v >= 18)
                        FILTER (?upper != ?mid)
                    }
                ") ] ]) and ([ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:weatherDeckBelowIceBeltUpperLimit ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bulwarkStrengthStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:freeingPortStrengthStatus ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:weatherDeckBelowIceBeltUpperLimit ] ])""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-040> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F05/ship> ;
            sh:resultMessage "The plating thickness input, in metres, is required for the ice-belt strengthening extent." ;
            sh:resultPath nltl:thickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The plating thickness input, in metres, is required for the ice-belt strengthening extent." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:thickness ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F05/ship> ;
            sh:resultMessage "The main-frame spacing input, in metres, is required for the five-main-frame forefoot extent." ;
            sh:resultPath nltl:spacing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The main-frame spacing input, in metres, is required for the five-main-frame forefoot extent." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:spacing ] ] .

