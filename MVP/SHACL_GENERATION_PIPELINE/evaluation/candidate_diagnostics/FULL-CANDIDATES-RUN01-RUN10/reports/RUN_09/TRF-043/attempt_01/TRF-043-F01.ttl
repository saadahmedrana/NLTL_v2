@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/terminationCase> ;
                    sh:resultMessage "Node ex:terminationCase must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Termination at the adjacent boundary must be permitted when the extension is no more than 250 mm.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ], [ sh:message Literal(\"The termination boundary must be a deck structure, tank boundary plating, or tank top.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] ) ] ; sh:path nltl:terminationAdjacentBoundary ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"250\", datatype=xsd:integer) ; sh:path q:numericValue ] ] ; sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ] , [ sh:property [ sh:node [ sh:property [ sh:minExclusive Literal(\"250\", datatype=xsd:integer) ; sh:path q:numericValue ] ] ; sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ a sh:NodeShape ;
                            sh:class nltl:framingIceStrengtheningTerminationCase ;
                            sh:or ( [ sh:property [ sh:node [ sh:property [ ] ] ;
                                                sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ],
                                            [ sh:message "The termination boundary must be a deck structure, tank boundary plating, or tank top." ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:or [ ] ] ;
                                                sh:path nltl:terminationAdjacentBoundary ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:message "Termination at the adjacent boundary must be permitted when the extension is no more than 250 mm." ;
                                                sh:minCount 1 ;
                                                sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ] ] [ sh:property [ sh:node [ sh:property [ ] ] ;
                                                sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ] ) ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue unit:MilliM ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path q:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path q:numericValue ] ] ;
                                    sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/terminationCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:class nltl:framingIceStrengtheningTerminationCase ; sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Termination at the adjacent boundary must be permitted when the extension is no more than 250 mm.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ], [ sh:message Literal(\"The termination boundary must be a deck structure, tank boundary plating, or tank top.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] ) ] ; sh:path nltl:terminationAdjacentBoundary ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"250\", datatype=xsd:integer) ; sh:path q:numericValue ] ] ; sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ] [ sh:property [ sh:node [ sh:property [ sh:minExclusive Literal(\"250\", datatype=xsd:integer) ; sh:path q:numericValue ] ] ; sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ] ) ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path q:numericValue ], [ sh:hasValue unit:MilliM ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ]. See details for more information." ;
            sh:resultPath nltl:hasFramingIceStrengtheningTerminationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ a sh:NodeShape ;
                            sh:class nltl:framingIceStrengtheningTerminationCase ;
                            sh:or ( [ sh:property [ sh:message "The termination boundary must be a deck structure, tank boundary plating, or tank top." ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:terminationAdjacentBoundary ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:message "Termination at the adjacent boundary must be permitted when the extension is no more than 250 mm." ;
                                                sh:minCount 1 ;
                                                sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ],
                                            [ sh:node [ ] ;
                                                sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ] [ sh:property [ sh:node [ ] ;
                                                sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ] ) ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue unit:MilliM ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path q:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path q:numericValue ] ] ;
                                    sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ] ;
                    sh:path nltl:hasFramingIceStrengtheningTerminationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/terminationCase> ] .

