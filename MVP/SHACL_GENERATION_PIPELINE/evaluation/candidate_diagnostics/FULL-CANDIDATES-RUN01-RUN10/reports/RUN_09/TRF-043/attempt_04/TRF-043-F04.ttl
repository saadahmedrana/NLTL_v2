@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F04/terminationCase> ;
                    sh:resultMessage "Node ex:terminationCase must conform to one or more shapes in [ sh:and ( [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:ExtensionAtMost250MillimetresShape ; sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ] ] [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:tankTop ] ) ] ; sh:path nltl:terminationAdjacentBoundary ] ] ) ] , [ sh:and ( [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:ExtensionAbove250MillimetresShape ; sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ] ) ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:TerminationCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F04/terminationCase> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F04/terminationCase> ;
                    sh:resultMessage "Less than 1 values on ex:terminationCase->nltl:extensionBeyondAdjacentDeckOrTankBoundary" ;
                    sh:resultPath nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node gen:LengthMillimetreQuantityShape ;
                            sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TerminationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasFramingIceStrengtheningTerminationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:TerminationCaseShape ;
                    sh:path nltl:hasFramingIceStrengtheningTerminationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F04/terminationCase> ] .

