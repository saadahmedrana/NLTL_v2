@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/adjacentMainFrame> ;
            sh:resultMessage "A frame must have an upper end attached to an eligible supporting structure." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n9abd6c113bc54d0e8ed1ce9675abdb0fb1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/upperEnd> ;
                    sh:resultMessage "The upper end must be attached to a deck, tank boundary plating, or ice stringer." ;
                    sh:resultPath nltl:hasAttachedSupportingStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The upper end must be attached to a deck, tank boundary plating, or ice stringer." ;
                            sh:minCount 1 ;
                            sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:iceStringer ] ) ;
                            sh:path nltl:hasAttachedSupportingStructure ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/frame> ;
            sh:resultMessage "A frame must have an upper end attached to an eligible supporting structure." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n9abd6c113bc54d0e8ed1ce9675abdb0fb1 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F04/upperEnd> ] .

_:N0f708d013c63449bac080d48f07773da rdf:first [ sh:class nltl:iceStringer ] ;
    rdf:rest () .

_:N161af3d5a62642e291d7891f3f5b019f rdf:first [ sh:class nltl:tankBoundaryPlating ] ;
    rdf:rest _:N0f708d013c63449bac080d48f07773da .

_:N1864ff25b694489e8d43521fd71417d8 sh:message "The upper end must be attached to a deck, tank boundary plating, or ice stringer." ;
    sh:minCount 1 ;
    sh:or ( [ sh:class nltl:deckStructure ] _:N3f8e0337ed05453a8fd5fbc2804ed56f _:Nb0a9920c7aeb428e9cb4cbbfa861f30a ) ;
    sh:path nltl:hasAttachedSupportingStructure .

_:Nfbd34528a1504d9cb15c2c23cad051ee a sh:NodeShape ;
    sh:property _:N1864ff25b694489e8d43521fd71417d8 .

_:n9abd6c113bc54d0e8ed1ce9675abdb0fb1 sh:message "A frame must have an upper end attached to an eligible supporting structure." ;
    sh:minCount 1 ;
    sh:node _:Nfbd34528a1504d9cb15c2c23cad051ee ;
    sh:path nltl:hasUpperEnd .

