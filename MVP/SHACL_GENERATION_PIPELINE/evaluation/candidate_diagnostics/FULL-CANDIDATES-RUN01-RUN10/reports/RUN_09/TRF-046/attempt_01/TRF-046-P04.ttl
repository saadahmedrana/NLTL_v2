@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-P04/upperEnd> ;
                    sh:resultMessage "The upper end must be attached to a deck, tank boundary plating, or ice stringer." ;
                    sh:resultPath nltl:hasAttachedSupportingStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The upper end must be attached to a deck, tank boundary plating, or ice stringer." ;
                            sh:minCount 1 ;
                            sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:iceStringer ] ) ;
                            sh:path nltl:hasAttachedSupportingStructure ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-P04/frame> ;
            sh:resultMessage "A frame must have an upper end attached to an eligible supporting structure." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n9abd6c113bc54d0e8ed1ce9675abdb0fb1 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-P04/upperEnd> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-P04/adjacentMainFrame> ;
            sh:resultMessage "A frame must have an upper end attached to an eligible supporting structure." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n9abd6c113bc54d0e8ed1ce9675abdb0fb1 ] .

_:N4c9e0ed904214cb494d6ab594175360a rdf:first [ sh:class nltl:iceStringer ] ;
    rdf:rest () .

_:N8a01c02339f44678a849a714f7bf24ef rdf:first [ sh:class nltl:deckStructure ] ;
    rdf:rest ( [ sh:class nltl:tankBoundaryPlating ] _:N9503a3c419724ad0acfc00037f77150d ) .

_:N8bcbfbd813f642539ef1cb7015975f2a a sh:NodeShape ;
    sh:property [ sh:message "The upper end must be attached to a deck, tank boundary plating, or ice stringer." ;
            sh:minCount 1 ;
            sh:or _:N8a01c02339f44678a849a714f7bf24ef ;
            sh:path nltl:hasAttachedSupportingStructure ] .

_:n9abd6c113bc54d0e8ed1ce9675abdb0fb1 sh:message "A frame must have an upper end attached to an eligible supporting structure." ;
    sh:minCount 1 ;
    sh:node _:N8bcbfbd813f642539ef1cb7015975f2a ;
    sh:path nltl:hasUpperEnd .

