                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-P03/longitudinalFrame> ;
            sh:resultMessage "Frame spacing must be supplied as one decimal quantity in metres." ;
            sh:resultPath nltl:spacing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Frame spacing must be supplied as one decimal quantity in metres." ;
                    sh:minCount 1 ;
