                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-P03/longitudinalFrame> ;
            sh:resultMessage "Section modulus must be supplied as one decimal quantity in cm^3." ;
            sh:resultPath nltl:sectionModulus ;
