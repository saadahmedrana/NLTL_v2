                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:requiredShearArea ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-P03/requiredShearAreaValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-P03/yieldStrengthValue> ;
                    sh:resultMessage "Node ex:yieldStrengthValue->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:MegaPA ;
