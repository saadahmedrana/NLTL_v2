@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ;
            sh:resultMessage "For significantly different boundary conditions, frameMomentFactorM must be smaller than 13.3; otherwise a continuous beam with brackets requires frameMomentFactorM equal to 13.3." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For significantly different boundary conditions, frameMomentFactorM must be smaller than 13.3; otherwise a continuous beam with brackets requires frameMomentFactorM equal to 13.3." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType ?boundary ;
                      nltl:significantlyDifferentBoundaryConditions ?different ;
                      nltl:frameMomentFactorM ?factorNode .
                ?factorNode qudt:numericValue ?factor .
                FILTER (
                    (?different = true && ! (?factor < 13.3)) ||
                    (?boundary = nltl:continuousBeamWithBracketsFrameCondition &&
                     ?different = false &&
                     ?factor != 13.3)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF048Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ] .

