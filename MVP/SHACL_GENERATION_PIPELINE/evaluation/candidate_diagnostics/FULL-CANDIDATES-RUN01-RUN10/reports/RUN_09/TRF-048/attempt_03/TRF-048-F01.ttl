@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ;
            sh:resultMessage "Node ex:longitudinalFrame must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:significantlyDifferentBoundaryConditions ], [ sh:hasValue nltl:continuousBeamWithBracketsFrameCondition ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:frameBoundaryConditionType ], [ sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"13.3\", datatype=xsd:decimal) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"13.3\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:frameMomentFactorM ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:significantlyDifferentBoundaryConditions ], [ sh:hasValue nltl:continuousBeamWithBracketsFrameCondition ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:frameBoundaryConditionType ], [ sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxExclusive Literal(\"13.3\", datatype=xsd:decimal) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:frameMomentFactorM ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF048LongitudinalFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ;
            sh:resultMessage "Frame distribution factor, section modulus, and required shear area must match the declared calculation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Frame distribution factor, section modulus, and required shear area must match the declared calculation." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:spacing ?sNode ;
                      nltl:span ?lNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Node ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?sNode qudt:numericValue ?s .
                ?lNode qudt:numericValue ?l .
                ?sigmaNode qudt:numericValue ?sigma .
                ?f4Node qudt:numericValue ?f4 .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND((1 - 0.2 * ?h / ?s) AS ?expectedF4)
                BIND((?expectedF4 * ?p * ?h * ?l * ?l /
                      (4 * 13.3 * ?sigma) * 1000000) AS ?expectedZ)
                BIND((1.7320508075688772 * ?expectedF4 * 2.16 * ?p * ?h * ?l /
                      (2 * ?sigma) * 10000) AS ?expectedA)

                FILTER(
                    (?f4 > ?expectedF4 +
                        (IF(?expectedF4 >= 0, ?expectedF4, 0 - ?expectedF4) * 0.000001 + 0.000001))
                    ||
                    (?f4 < ?expectedF4 -
                        (IF(?expectedF4 >= 0, ?expectedF4, 0 - ?expectedF4) * 0.000001 + 0.000001))
                    ||
                    (?z > ?expectedZ +
                        (IF(?expectedZ >= 0, ?expectedZ, 0 - ?expectedZ) * 0.000001 + 0.000001))
                    ||
                    (?z < ?expectedZ -
                        (IF(?expectedZ >= 0, ?expectedZ, 0 - ?expectedZ) * 0.000001 + 0.000001))
                    ||
                    (?a > ?expectedA +
                        (IF(?expectedA >= 0, ?expectedA, 0 - ?expectedA) * 0.000001 + 0.000001))
                    ||
                    (?a < ?expectedA -
                        (IF(?expectedA >= 0, ?expectedA, 0 - ?expectedA) * 0.000001 + 0.000001))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF048LongitudinalFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ] .

