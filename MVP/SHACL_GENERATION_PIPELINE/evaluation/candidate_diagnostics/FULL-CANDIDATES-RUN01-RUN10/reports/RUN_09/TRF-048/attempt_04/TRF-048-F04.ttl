@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F04/longitudinalFrame> ;
            sh:resultMessage "The frame calculation results must satisfy the declared f4, section modulus, and required shear area formulas within a relative tolerance of 1e-6 plus an absolute fallback of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The frame calculation results must satisfy the declared f4, section modulus, and required shear area formulas within a relative tolerance of 1e-6 plus an absolute fallback of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:spacing ?sNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Node ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?sNode qudt:numericValue ?s .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?sigmaNode qudt:numericValue ?sigma .
                ?f4Node qudt:numericValue ?f4 .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND ((1 - ("0.2"^^xsd:decimal) * ?h / ?s) AS ?f4Expected)
                BIND ((?f4Expected * ?p * ?h * ?l * ?l / (4 * ?m * ?sigma)) * 1000000 AS ?zExpected)
                BIND ((1.7320508075688772 * ?f4Expected * 2.16 * ?p * ?h * ?l / (2 * ?sigma)) * 10000 AS ?aExpected)

                BIND ((?f4Expected * 0.000001) + 0.000000001 AS ?f4Tolerance)
                BIND ((?zExpected * 0.000001) + 0.000000001 AS ?zTolerance)
                BIND ((?aExpected * 0.000001) + 0.000000001 AS ?aTolerance)

                FILTER (
                    ?f4 < (?f4Expected - ?f4Tolerance) ||
                    ?f4 > (?f4Expected + ?f4Tolerance) ||
                    ?z < (?zExpected - ?zTolerance) ||
                    ?z > (?zExpected + ?zTolerance) ||
                    ?a < (?aExpected - ?aTolerance) ||
                    ?a > (?aExpected + ?aTolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-048-LongitudinalFrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F04/longitudinalFrame> ] .

