@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F01/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:withinIceStrengthenedArea ] ] , [ sh:or ( [ sh:class nltl:longitudinalFrame ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-049-LongitudinalAttachmentShape> ; sh:path nltl:hasFrameAttachment ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-049-SupportingStructureShape> ; sh:path nltl:hasSupportingBulkhead ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-049-SupportingStructureShape> ; sh:path nltl:hasSupportingWebFrame ] ] [ sh:class nltl:transverseFrame ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:terminatesAtDeckOrIceStringer ] ] [ sh:class nltl:transverseFrame ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:terminatesAtDeckOrIceStringer ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-049-TerminatingAttachmentShape> ; sh:path nltl:hasFrameAttachment ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Every frame in the ice-strengthened area must be effectively attached.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:effectiveAttachmentConfirmed ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:withinIceStrengthenedArea ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The frame web thickness must be provided in millimetres.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-049-QuantityValueShape> ; sh:path nltl:frameWebThickness ], [ sh:message Literal(\"A frame in the ice-strengthened area must identify its frame attachments.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-049-AttachmentShape> ; sh:path nltl:hasFrameAttachment ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-049-FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F01/frame> ] .

