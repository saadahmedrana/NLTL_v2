@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F03/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in <urn:nltl:generated-shape:TRF-049-OutsideIceArea> , <urn:nltl:generated-shape:TRF-049-IceLongitudinalFrame> , <urn:nltl:generated-shape:TRF-049-IceTransverseFrame>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-049-FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F03/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F03/frame> ;
            sh:resultMessage "Node Literal(\"true\" = True, datatype=xsd:boolean) must conform to one or more shapes in [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ] , [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:property [ sh:datatype xsd:integer ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"2\", datatype=xsd:integer) ; sh:message Literal(\"Both sides of the frame web plate must be connected when the frame runs through the supporting structure.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:webPlateConnectionSideCount ] ]" ;
            sh:resultPath nltl:passesThroughSupportingStructure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:hasValue false ] [ sh:hasValue true ;
                                sh:property [ sh:datatype xsd:integer ;
                                        sh:maxCount 1 ;
                                        sh:maxInclusive 2 ;
                                        sh:message "Both sides of the frame web plate must be connected when the frame runs through the supporting structure." ;
                                        sh:minCount 1 ;
                                        sh:minInclusive 2 ;
                                        sh:path nltl:webPlateConnectionSideCount ] ] ) ;
                    sh:path nltl:passesThroughSupportingStructure ] ;
            sh:value true ] .

