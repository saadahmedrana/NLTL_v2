@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F05/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in <urn:nltl:generated-shape:TRF-049-OutsideIceArea> , <urn:nltl:generated-shape:TRF-049-IceLongitudinalFrame> , <urn:nltl:generated-shape:TRF-049-IceTransverseFrame>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-049-FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F05/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F05/frame> ;
            sh:resultMessage "Less than 1 values on ex:frame->nltl:passesThroughSupportingStructure" ;
            sh:resultPath nltl:passesThroughSupportingStructure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:hasValue false ] [ sh:hasValue true ;
                                sh:property [ sh:datatype xsd:integer ;
                                        sh:maxCount 1 ;
                                        sh:maxInclusive 2 ;
                                        sh:message "Both sides of the frame web plate must be connected when the frame runs through the supporting structure." ;
                                        sh:minCount 1 ;
                                        sh:minInclusive 2 ;
                                        sh:path nltl:webPlateConnectionSideCount ] ] ) ;
                    sh:path nltl:passesThroughSupportingStructure ] ] .

