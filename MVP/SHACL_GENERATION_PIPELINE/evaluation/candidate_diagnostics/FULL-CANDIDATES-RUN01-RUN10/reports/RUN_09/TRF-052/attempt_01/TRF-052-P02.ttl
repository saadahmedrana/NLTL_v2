@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P02/frame> ;
            sh:resultMessage "Value is not Literal with datatype nltl:iceClassValue" ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype nltl:iceClassValue ;
                    sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:iceClass ] ;
            sh:value nltl:iceClassIaSuper ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P02/frame> ;
            sh:resultMessage """Node ex:frame must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:equivalentSupportStatusByDirectCalculation ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:frameAsymmetrical ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:frameWebAngleToShell ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:frameSpan ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:antitrippingSupportSpacing ] ; sh:sparql [ sh:message Literal("The frame does not satisfy the applicable antitripping support spacing or regional coverage requirement.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:frameAsymmetrical ?asym ;
                              nltl:frameWebAngleToShell ?angleNode ;
                              nltl:frameSpan ?spanNode ;
                              nltl:iceClass ?iceClass .

                        ?angleNode qudt:numericValue ?angle .
                        ?spanNode qudt:numericValue ?span .

                        FILTER (
                            (
                                (?asym = true || ?angle < 90)
                                &&
                                !EXISTS {
                                    $this nltl:antitrippingSupportSpacing ?spacingNode .
                                    ?spacingNode qudt:numericValue ?spacing .
                                    FILTER (?spacing <= 1300)
                                }
                            )
                            ||
                            (
                                ?span > 4
                                &&
                                (
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:bowRegion }
                                    ||
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion }
                                    ||
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:sternRegion }
                                    ||
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue }
                                )
                            )
                            ||
                            (
                                ?span <= 4
                                &&
                                ?iceClass = nltl:iceClassIaSuper
                                &&
                                (
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:bowRegion }
                                    ||
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion }
                                    ||
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:sternRegion }
                                    ||
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue }
                                )
                            )
                            ||
                            (
                                ?span <= 4
                                &&
                                ?iceClass = nltl:iceClassIa
                                &&
                                (
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:bowRegion }
                                    ||
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion }
                                )
                            )
                            ||
                            (
                                ?span <= 4
                                &&
                                (
                                    ?iceClass = nltl:iceClassIb
                                    ||
                                    ?iceClass = nltl:iceClassIc
                                )
                                &&
                                !EXISTS {
                                    $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                                }
                            )
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_052_FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P02/frame> ] .

