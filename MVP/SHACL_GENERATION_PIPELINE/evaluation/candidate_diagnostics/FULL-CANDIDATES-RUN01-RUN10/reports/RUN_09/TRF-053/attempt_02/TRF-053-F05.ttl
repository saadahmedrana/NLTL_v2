@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/designLineLoadValue> ;
                    sh:resultMessage "Node ex:designLineLoadValue->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/KiloN-PER-M>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/iceStringer> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
            sh:resultPath nltl:designLineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designLineLoad ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/designLineLoadValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/iceStringer> ;
            sh:resultMessage "Design line load, section modulus, and required shear area must satisfy the specified ice-stringer formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Design line load, section modulus, and required shear area must satisfy the specified ice-stringer formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:designIceLoadHeight ?heightNode ;
                      nltl:span ?spanNode ;
                      nltl:frameMomentFactorM ?momentNode ;
                      nltl:yieldStrength ?yieldNode ;
                      nltl:designLineLoad ?loadNode ;
                      nltl:sectionModulus ?sectionNode ;
                      nltl:requiredShearArea ?areaNode .

                ?pressureNode <http://qudt.org/schema/qudt/numericValue> ?p .
                ?heightNode <http://qudt.org/schema/qudt/numericValue> ?h .
                ?spanNode <http://qudt.org/schema/qudt/numericValue> ?l .
                ?momentNode <http://qudt.org/schema/qudt/numericValue> ?m .
                ?yieldNode <http://qudt.org/schema/qudt/numericValue> ?sigma .
                ?loadNode <http://qudt.org/schema/qudt/numericValue> ?loadReported .
                ?sectionNode <http://qudt.org/schema/qudt/numericValue> ?zReported .
                ?areaNode <http://qudt.org/schema/qudt/numericValue> ?aReported .

                BIND(IF((?p * ?h) >= 0.15, (?p * ?h), 0.15) AS ?loadExpected)
                BIND((0.9 * 1.8 * ?loadExpected * ?l * ?l /
                      (?m * ?sigma) * 1000000.0) AS ?zExpected)
                BIND((1.7320508075688772 * 0.9 * 1.8 * 1.2 *
                      ?loadExpected * ?l /
                      (2.0 * ?sigma) * 10000.0) AS ?aExpected)

                BIND((0.000001 * IF(?loadExpected >= 0.0,
                                    ?loadExpected,
                                    0.0 - ?loadExpected) +
                      0.000000001) AS ?loadTolerance)
                BIND((0.000001 * IF(?zExpected >= 0.0,
                                    ?zExpected,
                                    0.0 - ?zExpected) +
                      0.000000001) AS ?zTolerance)
                BIND((0.000001 * IF(?aExpected >= 0.0,
                                    ?aExpected,
                                    0.0 - ?aExpected) +
                      0.000000001) AS ?aTolerance)

                FILTER(
                    ?loadReported < (?loadExpected - ?loadTolerance) ||
                    ?loadReported > (?loadExpected + ?loadTolerance) ||
                    ?zReported < (?zExpected - ?zTolerance) ||
                    ?zReported > (?zExpected + ?zTolerance) ||
                    ?aReported < (?aExpected - ?aTolerance) ||
                    ?aReported > (?aExpected + ?aTolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_053_IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/iceStringer> ] .

