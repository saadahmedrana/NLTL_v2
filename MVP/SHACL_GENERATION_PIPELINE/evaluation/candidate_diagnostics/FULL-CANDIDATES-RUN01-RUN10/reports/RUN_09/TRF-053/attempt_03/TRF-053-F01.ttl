@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/iceStringer> ;
            sh:resultMessage "Design line load, section modulus, and required shear area must satisfy the specified ice-stringer formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Design line load, section modulus, and required shear area must satisfy the specified ice-stringer formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:designIceLoadHeight ?heightNode ;
                      nltl:span ?spanNode ;
                      nltl:frameMomentFactorM ?momentNode ;
                      nltl:yieldStrength ?strengthNode ;
                      nltl:designLineLoad ?loadNode ;
                      nltl:sectionModulus ?sectionNode ;
                      nltl:requiredShearArea ?areaNode .

                ?pressureNode qudt:numericValue ?p ;
                              qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?heightNode qudt:numericValue ?h ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                ?spanNode qudt:numericValue ?l ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
                ?momentNode qudt:numericValue ?m ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?strengthNode qudt:numericValue ?sigma ;
                              qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?loadNode qudt:numericValue ?loadReported ;
                          qudt:unit <http://qudt.org/vocab/unit/KiloN-PER-M> .
                ?sectionNode qudt:numericValue ?sectionReported ;
                             qudt:unit <http://qudt.org/vocab/unit/CentiM3> .
                ?areaNode qudt:numericValue ?areaReported ;
                          qudt:unit <http://qudt.org/vocab/unit/CentiM2> .

                BIND(?p * ?h * 1000.0 AS ?productKiloNPerM)
                BIND(IF(?productKiloNPerM > 150.0, ?productKiloNPerM, 150.0) AS ?loadExpected)
                BIND(0.9 * 1.8 * ?loadExpected * ?l * ?l / (?m * ?sigma) * 1000.0 AS ?sectionExpected)
                BIND(1.7320508075688772935 * 0.9 * 1.8 * 1.2 * ?loadExpected * ?l / (2.0 * ?sigma) * 10.0 AS ?areaExpected)

                BIND(IF(?loadExpected > 0.0, ?loadExpected * 0.000001, 0.000001) AS ?loadTolerance)
                BIND(IF(?sectionExpected > 0.0, ?sectionExpected * 0.000001, 0.000001) AS ?sectionTolerance)
                BIND(IF(?areaExpected > 0.0, ?areaExpected * 0.000001, 0.000001) AS ?areaTolerance)

                FILTER(
                    ?loadReported > ?loadExpected + ?loadTolerance ||
                    ?loadReported < ?loadExpected - ?loadTolerance ||
                    ?sectionReported > ?sectionExpected + ?sectionTolerance ||
                    ?sectionReported < ?sectionExpected - ?sectionTolerance ||
                    ?areaReported > ?areaExpected + ?areaTolerance ||
                    ?areaReported < ?areaExpected - ?areaTolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_053_IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/iceStringer> ] .

