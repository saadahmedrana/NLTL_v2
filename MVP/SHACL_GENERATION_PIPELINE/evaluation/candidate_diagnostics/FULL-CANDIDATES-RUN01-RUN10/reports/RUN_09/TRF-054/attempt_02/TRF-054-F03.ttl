_:n1faee7f12e874f09812d1e5fd299a407b8 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice stringer must be located outside the ice belt." ;
    sh:minCount 1 ;
    sh:path nltl:locatedOutsideIceBelt .

_:n1faee7f12e874f09812d1e5fd299a407b9 sh:datatype xsd:boolean ;
