        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F03/iceStringer> ;
            sh:resultMessage "The ice stringer must support ice-strengthened frames." ;
            sh:resultPath nltl:supportsIceStrengthenedFrames ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n1faee7f12e874f09812d1e5fd299a407b9 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F03/iceStringer> ;
            sh:resultMessage "Less than 1 values on ex:iceStringer->nltl:distanceToAdjacentIceStringer" ;
            sh:resultPath nltl:distanceToAdjacentIceStringer ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
