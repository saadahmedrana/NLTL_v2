@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F03/iceStringer> ;
            sh:resultMessage "The ice stringer must be identified as located outside the ice belt." ;
            sh:resultPath nltl:locatedOutsideIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n632e00a229cb4ea1b74689584b130dbbb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F03/iceStringer> ;
            sh:resultMessage "Less than 1 values on ex:iceStringer->nltl:outsideIceBeltDistributionFactorF9" ;
            sh:resultPath nltl:outsideIceBeltDistributionFactorF9 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 0.80 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 0.80 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:outsideIceBeltDistributionFactorF9 ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F03/iceStringer> ;
            sh:resultMessage "The ice stringer must support ice-strengthened frames." ;
            sh:resultPath nltl:supportsIceStrengthenedFrames ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n632e00a229cb4ea1b74689584b130dbbb2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F03/iceStringer> ;
            sh:resultMessage "Less than 1 values on ex:iceStringer->nltl:outsideIceBeltShearFactorF11" ;
            sh:resultPath nltl:outsideIceBeltShearFactorF11 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 1.2 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 1.2 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:outsideIceBeltShearFactorF11 ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F03/iceStringer> ;
            sh:resultMessage "The ice stringer must be identified as located outside the ice belt." ;
            sh:resultPath nltl:locatedOutsideIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n632e00a229cb4ea1b74689584b130dbbb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F03/iceStringer> ;
            sh:resultMessage "The ice stringer must support ice-strengthened frames." ;
            sh:resultPath nltl:supportsIceStrengthenedFrames ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n632e00a229cb4ea1b74689584b130dbbb2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F03/iceStringer> ;
            sh:resultMessage "Less than 1 values on ex:iceStringer->nltl:distanceToAdjacentIceStringer" ;
            sh:resultPath nltl:distanceToAdjacentIceStringer ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:distanceToAdjacentIceStringer ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F03/iceStringer> ;
            sh:resultMessage "Less than 1 values on ex:iceStringer->nltl:outsideIceBeltSafetyFactorF10" ;
            sh:resultPath nltl:outsideIceBeltSafetyFactorF10 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 1.8 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 1.8 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:outsideIceBeltSafetyFactorF10 ] ] .

_:n632e00a229cb4ea1b74689584b130dbbb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice stringer must be identified as located outside the ice belt." ;
    sh:minCount 1 ;
    sh:path nltl:locatedOutsideIceBelt .

_:n632e00a229cb4ea1b74689584b130dbbb2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice stringer must support ice-strengthened frames." ;
    sh:minCount 1 ;
    sh:path nltl:supportsIceStrengthenedFrames .

