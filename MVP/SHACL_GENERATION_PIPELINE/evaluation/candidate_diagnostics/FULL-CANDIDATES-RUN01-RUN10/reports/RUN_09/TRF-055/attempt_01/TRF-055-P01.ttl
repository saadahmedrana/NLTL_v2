@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P01/narrowDeckStrip> ;
            sh:resultMessage "When the strip is abreast of a hatch and serves as an ice stringer, its actual section modulus and shear area must meet the required values; an approved very-long-hatch reduced line load must be between 0.10 and less than 0.15 kN/m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the strip is abreast of a hatch and serves as an ice stringer, its actual section modulus and shear area must meet the required values; an approved very-long-hatch reduced line load must be between 0.10 and less than 0.15 kN/m." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:abreastOfHatch true ;
                      nltl:servesAsIceStringer true ;
                      nltl:veryLongHatchOpening ?veryLong ;
                      nltl:actualSectionModulus ?actualZ ;
                      nltl:requiredSectionModulus ?requiredZ ;
                      nltl:actualShearArea ?actualA ;
                      nltl:requiredShearArea ?requiredA .

                ?actualZ qudt:numericValue ?actualZValue .
                ?requiredZ qudt:numericValue ?requiredZValue .
                ?actualA qudt:numericValue ?actualAValue .
                ?requiredA qudt:numericValue ?requiredAValue .

                FILTER (
                    ?actualZValue >= ?requiredZValue &&
                    ?actualAValue >= ?requiredAValue
                )

                FILTER (
                    ?veryLong = false ||
                    EXISTS {
                        $this nltl:permittedReducedLineLoad ?reducedLoad ;
                              nltl:reducedLineLoadApprovedByClassificationSociety true .
                        ?reducedLoad qudt:numericValue ?reducedLoadValue .
                        FILTER (
                            ?reducedLoadValue >= "0.10"^^xsd:decimal &&
                            ?reducedLoadValue < "0.15"^^xsd:decimal
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-055-NarrowDeckStripShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P01/narrowDeckStrip> ] .

