@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F01/narrowDeckStrip> ;
            sh:resultMessage "For an applicable narrow deck strip, the actual section modulus and shear area shall meet their required values." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an applicable narrow deck strip, the actual section modulus and shear area shall meet their required values." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:abreastOfHatch true ;
                      nltl:servesAsIceStringer true ;
                      nltl:actualSectionModulus ?actualSectionModulusNode ;
                      nltl:requiredSectionModulus ?requiredSectionModulusNode ;
                      nltl:actualShearArea ?actualShearAreaNode ;
                      nltl:requiredShearArea ?requiredShearAreaNode .

                ?actualSectionModulusNode qudt:numericValue ?actualSectionModulus .
                ?requiredSectionModulusNode qudt:numericValue ?requiredSectionModulus .
                ?actualShearAreaNode qudt:numericValue ?actualShearArea .
                ?requiredShearAreaNode qudt:numericValue ?requiredShearArea .

                FILTER (
                    ?actualSectionModulus < ?requiredSectionModulus ||
                    ?actualShearArea < ?requiredShearArea
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF055NarrowDeckStripShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F01/narrowDeckStrip> ] .

