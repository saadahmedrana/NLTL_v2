@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "webFrameIceLoad must equal 1.8 times max(icePressure multiplied by iceLoadHeight, 0.15) multiplied by webFrameSpacing, converted from MN to kN; comparison uses a 1e-6 relative tolerance with a 1e-6 kN absolute fallback." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "webFrameIceLoad must equal 1.8 times max(icePressure multiplied by iceLoadHeight, 0.15) multiplied by webFrameSpacing, converted from MN to kN; comparison uses a 1e-6 relative tolerance with a 1e-6 kN absolute fallback." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:iceLoadHeight ?heightNode ;
                      nltl:webFrameSpacing ?spacingNode ;
                      nltl:webFrameIceLoad ?loadNode .

                ?pressureNode qudt:numericValue ?p .
                ?heightNode qudt:numericValue ?h .
                ?spacingNode qudt:numericValue ?s .
                ?loadNode qudt:numericValue ?actual .

                BIND(?p * ?h AS ?pressureHeight)
                BIND(IF(?pressureHeight < 0.15, 0.15, ?pressureHeight) AS ?effectiveLineLoad)
                BIND(1.8 * ?effectiveLineLoad * ?s * 1000 AS ?expected)
                BIND(IF(?expected - ?actual < 0,
                         ?actual - ?expected,
                         ?expected - ?actual) AS ?delta)
                BIND(IF(?expected < 0.000001,
                         0.000001,
                         0.000001 * ?expected) AS ?tolerance)

                FILTER(?delta > ?tolerance)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-057-WebFrameIceLoadShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ] .

