@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F03/webFrame> ;
            sh:resultMessage "Alpha must match Table 4-8 for the flange-to-web area ratio, and required shear area must match the declared formula within a relative tolerance of 1e-6 with a 1e-9 absolute fallback." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Alpha must match Table 4-8 for the flange-to-web area ratio, and required shear area must match the declared formula within a relative tolerance of 1e-6 with a 1e-9 absolute fallback." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?qNode ;
                      nltl:webFrameShearFactorAlpha ?alphaNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:freeFlangeToWebAreaRatio ?ratioNode ;
                      nltl:requiredShearArea ?areaNode .

                ?qNode qudt:numericValue ?q .
                ?alphaNode qudt:numericValue ?alpha .
                ?sigmaNode qudt:numericValue ?sigma .
                ?ratioNode qudt:numericValue ?ratio .
                ?areaNode qudt:numericValue ?area .

                BIND((1.7320508075688772 * ?alpha * 1.1 * ?q / 1000.0 / ?sigma) * 10000.0 AS ?expected)

                FILTER (
                    !(
                        (?ratio = 0.0 && ?alpha = 1.5) ||
                        (?ratio = 0.2 && ?alpha = 1.23) ||
                        (?ratio = 0.4 && ?alpha = 1.16) ||
                        (?ratio = 0.6 && ?alpha = 1.11) ||
                        (?ratio = 0.8 && ?alpha = 1.09) ||
                        (?ratio = 1.0 && ?alpha = 1.07) ||
                        (?ratio = 1.2 && ?alpha = 1.06) ||
                        (?ratio = 1.4 && ?alpha = 1.05) ||
                        (?ratio = 1.6 && ?alpha = 1.05) ||
                        (?ratio = 1.8 && ?alpha = 1.04) ||
                        (?ratio = 2.0 && ?alpha = 1.04)
                    )
                    ||
                    ABS(?area - ?expected) >
                    IF(ABS(?expected) * 0.000001 > 0.000000001,
                       ABS(?expected) * 0.000001,
                       0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF059WebFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F03/webFrame> ] .

