@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ;
            sh:resultMessage "Required shear area must equal sqrt(3) times alpha times 1.1 times maximum shear force in MN divided by yield strength, scaled to cm2, within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-6 cm2." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Required shear area must equal sqrt(3) times alpha times 1.1 times maximum shear force in MN divided by yield strength, scaled to cm2, within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-6 cm2." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?forceNode ;
                      nltl:webFrameShearFactorAlpha ?alphaNode ;
                      nltl:yieldStrength ?strengthNode ;
                      nltl:requiredShearArea ?areaNode .
                ?forceNode qudt:numericValue ?forceKN .
                ?alphaNode qudt:numericValue ?alpha .
                ?strengthNode qudt:numericValue ?strength .
                ?areaNode qudt:numericValue ?area .
                BIND (1.7320508075688772 * ?alpha * 1.1 * (?forceKN / 1000.0) / ?strength * 10000.0 AS ?expected)
                FILTER (ABS(?area - ?expected) > (0.000001 * ABS(?expected) + 0.000001))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-059-WebFrameShearAreaShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ] .

