@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F03/webFrame> ;
            sh:resultMessage "The free flange to web area ratio and alpha must be one of the corresponding Table 4-8 pairs." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The free flange to web area ratio and alpha must be one of the corresponding Table 4-8 pairs." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:freeFlangeToWebAreaRatio ?ratioNode ;
                      nltl:webFrameShearFactorAlpha ?alphaNode .
                ?ratioNode qudt:numericValue ?ratio .
                ?alphaNode qudt:numericValue ?alpha .
                FILTER (!(
                    (?ratio = 0.0 && ?alpha = 1.5) ||
                    (?ratio = 0.2 && ?alpha = 1.23) ||
                    (?ratio = 0.4 && ?alpha = 1.16) ||
                    (?ratio = 0.6 && ?alpha = 1.11) ||
                    (?ratio = 0.8 && ?alpha = 1.09) ||
                    (?ratio = 1.0 && ?alpha = 1.07) ||
                    (?ratio = 1.2 && ?alpha = 1.06) ||
                    (?ratio = 1.4 && ?alpha = 1.05) ||
                    (?ratio = 1.6 && ?alpha = 1.05) ||
                    (?ratio = 1.8 && ?alpha = 1.04) ||
                    (?ratio = 2.0 && ?alpha = 1.04)
                ))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-059-WebFrameShearAreaShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F03/webFrame> ] .

