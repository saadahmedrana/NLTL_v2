@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-P04/webFrame> ;
            sh:resultMessage "requiredShearArea must equal sqrt(3) times alpha times 1.1 times maximumCalculatedShearForce divided by yieldStrength, scaled by 10^4, within numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "requiredShearArea must equal sqrt(3) times alpha times 1.1 times maximumCalculatedShearForce divided by yieldStrength, scaled by 10^4, within numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?qNode ;
                      nltl:webFrameShearFactorAlpha ?aNode ;
                      nltl:yieldStrength ?sNode ;
                      nltl:requiredShearArea ?rNode .
                ?qNode qudt:numericValue ?q .
                ?aNode qudt:numericValue ?alpha .
                ?sNode qudt:numericValue ?sigma .
                ?rNode qudt:numericValue ?reported .
                BIND((1.7320508075688772 * ?alpha * 1.1 * ?q / ?sigma * 10000) AS ?expected)
                BIND(IF(?expected >= 0, ?expected, 0 - ?expected) AS ?magnitude)
                BIND((0.000001 * ?magnitude + 0.000000001) AS ?tolerance)
                FILTER (
                    ?reported < (?expected - ?tolerance)
                    || ?reported > (?expected + ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF059WebFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-P04/webFrame> ] .

