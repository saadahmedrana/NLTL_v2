@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ;
            sh:resultMessage "requiredShearArea must equal sqrt(3) times alpha times 1.1 times the maximum calculated shear force in kN, divided by yield strength, times 10, within a relative tolerance of 1e-6 and an absolute tolerance of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "requiredShearArea must equal sqrt(3) times alpha times 1.1 times the maximum calculated shear force in kN, divided by yield strength, times 10, within a relative tolerance of 1e-6 and an absolute tolerance of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?qv ;
                      nltl:webFrameShearFactorAlpha ?av ;
                      nltl:yieldStrength ?yv ;
                      nltl:requiredShearArea ?rv .

                ?qv qudt:numericValue ?q .
                ?av qudt:numericValue ?alpha .
                ?yv qudt:numericValue ?yield .
                ?rv qudt:numericValue ?reported .

                BIND((1.7320508075688772 * ?alpha * 1.1 * ?q * 10 / ?yield) AS ?expected)
                BIND(IF(?expected >= 0, ?expected, 0 - ?expected) AS ?magnitude)
                BIND((?magnitude * 0.000001 + 0.000000001) AS ?tolerance)

                FILTER(
                    ?reported < (?expected - ?tolerance) ||
                    ?reported > (?expected + ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-059-WebFrameShearAreaShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ] .

