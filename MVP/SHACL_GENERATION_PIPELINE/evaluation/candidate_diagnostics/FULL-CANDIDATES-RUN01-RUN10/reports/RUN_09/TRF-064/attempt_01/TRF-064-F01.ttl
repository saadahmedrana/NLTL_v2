@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:sidePropellerShaftingAssembly ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:platedBossingStructure ; sh:message Literal(\"Side propeller shafting shall be enclosed within plated bossing.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:enclosedByPlatedBossing ] ] ; sh:path nltl:hasSidePropellerShafting ], [ sh:class nltl:sternTube ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:platedBossingStructure ; sh:message Literal(\"Stern tubes of side propellers shall be enclosed within plated bossing.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:enclosedByPlatedBossing ] ] ; sh:path nltl:hasSternTube ] ] , [ sh:property [ sh:class nltl:detachedStrutStructure ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:strutDesignEvidence ; sh:message Literal(\"Detached struts require design evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutDesignEvidence ], [ sh:class nltl:strutHullAttachmentEvidence ; sh:message Literal(\"Detached struts require hull-attachment evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutHullAttachmentEvidence ], [ sh:class nltl:strutStrengthEvidence ; sh:message Literal(\"Detached struts require strength evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutStrengthEvidence ] ] ; sh:path nltl:hasDetachedStrut ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-064> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/ship> ] .

