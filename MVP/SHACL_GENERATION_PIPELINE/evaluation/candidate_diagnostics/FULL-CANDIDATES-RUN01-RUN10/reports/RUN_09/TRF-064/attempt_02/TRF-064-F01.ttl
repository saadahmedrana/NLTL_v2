@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/shafting> ;
                    sh:resultMessage "Each existing side propeller shafting assembly shall be enclosed by a plated bossing." ;
                    sh:resultPath nltl:enclosedByPlatedBossing ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:platedBossingStructure ;
                            sh:message "Each existing side propeller shafting assembly shall be enclosed by a plated bossing." ;
                            sh:minCount 1 ;
                            sh:path nltl:enclosedByPlatedBossing ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:class nltl:platedBossingStructure ; sh:message Literal(\"Each existing side propeller shafting assembly shall be enclosed by a plated bossing.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:enclosedByPlatedBossing ] ]. See details for more information." ;
            sh:resultPath nltl:hasSidePropellerShafting ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ a sh:NodeShape ;
                            sh:property [ sh:class nltl:platedBossingStructure ;
                                    sh:message "Each existing side propeller shafting assembly shall be enclosed by a plated bossing." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:enclosedByPlatedBossing ] ] ;
                    sh:path nltl:hasSidePropellerShafting ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/shafting> ] .

