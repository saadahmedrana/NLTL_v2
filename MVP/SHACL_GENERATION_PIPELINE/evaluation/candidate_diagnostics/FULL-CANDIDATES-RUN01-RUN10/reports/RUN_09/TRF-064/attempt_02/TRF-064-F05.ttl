@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F05/detachedStrut> ;
                    sh:resultMessage "Each detached strut shall have hull-attachment evidence." ;
                    sh:resultPath nltl:hasStrutHullAttachmentEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:strutHullAttachmentEvidence ;
                            sh:message "Each detached strut shall have hull-attachment evidence." ;
                            sh:minCount 1 ;
                            sh:path nltl:hasStrutHullAttachmentEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:class nltl:strutDesignEvidence ; sh:message Literal(\"Each detached strut shall have design evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutDesignEvidence ], [ sh:class nltl:strutHullAttachmentEvidence ; sh:message Literal(\"Each detached strut shall have hull-attachment evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutHullAttachmentEvidence ], [ sh:class nltl:strutStrengthEvidence ; sh:message Literal(\"Each detached strut shall have strength evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutStrengthEvidence ] ]. See details for more information." ;
            sh:resultPath nltl:hasDetachedStrut ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:detachedStrutStructure ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ sh:class nltl:strutHullAttachmentEvidence ;
                                    sh:message "Each detached strut shall have hull-attachment evidence." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:hasStrutHullAttachmentEvidence ],
                                [ sh:class nltl:strutDesignEvidence ;
                                    sh:message "Each detached strut shall have design evidence." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:hasStrutDesignEvidence ],
                                [ sh:class nltl:strutStrengthEvidence ;
                                    sh:message "Each detached strut shall have strength evidence." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:hasStrutStrengthEvidence ] ] ;
                    sh:path nltl:hasDetachedStrut ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F05/detachedStrut> ] .

