@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F02/ship> ;
            sh:resultMessage "The ship shall provide the lower ice waterline (LIWL)." ;
            sh:resultPath nltl:lowerIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship shall provide the lower ice waterline (LIWL)." ;
                    sh:minCount 1 ;
                    sh:path nltl:lowerIceWaterline ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:in ( nltl:iceClassIa nltl:iceClassIaSuper ) ; sh:path nltl:iceClass ], [ sh:message Literal(\"For an applicable ice class, the rudder shall have an ice-knife or equivalent protection arrangement.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:rudderProtectionArrangement ; sh:or ( [ sh:class nltl:iceKnife ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ice knife shall extend below the LIWL.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendsBelowLowerIceWaterline ] ] [ sh:class nltl:equivalentRudderProtectionMeans ] ) ] ; sh:path nltl:hasRudderProtectionArrangement ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:in ( nltl:iceClassIa nltl:iceClassIaSuper ) ; sh:path nltl:iceClass ], [ sh:message Literal(\"When an ice knife is not practicable, an equivalent rudder protection means shall be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:equivalentRudderProtectionMeans, nltl:rudderProtectionArrangement ] ; sh:path nltl:hasRudderProtectionArrangement ] ] , [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF066Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F02/ship> ] .

