@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-P02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIi nltl:iceClassIii ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:message Literal("For ice classes IB or IC, the propulsion system must be designed for ice class IA when the ballast-condition propeller depth is less than hi.") ; sh:or ( [ sh:sparql [ sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:ballastConditionPropellerTopDepth ?depthQuantity .
                                ?depthQuantity qudt:numericValue ?depthValue .
                                $this nltl:requiredPropellerSubmersionDepthHi ?requiredQuantity .
                                ?requiredQuantity qudt:numericValue ?requiredValue .
                                FILTER (?depthValue >= ?requiredValue)
                            }
                        ") ] ] [ sh:property [ sh:class nltl:iceClassValue ; sh:hasValue nltl:iceClassIa ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:propulsionSystemDesignedForIceClass ] ] ) ; sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Ballast-condition propeller top depth is required for ice classes IB and IC.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-074-LengthQuantityShape> ; sh:path nltl:ballastConditionPropellerTopDepth ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Required propeller submersion depth hi is required for ice classes IB and IC.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-074-LengthQuantityShape> ; sh:path nltl:requiredPropellerSubmersionDepthHi ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-074-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-P02/ship> ] .

