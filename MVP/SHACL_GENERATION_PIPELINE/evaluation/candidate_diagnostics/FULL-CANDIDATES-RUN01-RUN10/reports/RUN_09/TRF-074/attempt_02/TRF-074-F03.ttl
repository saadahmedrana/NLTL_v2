@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:iceClassValue ; sh:in ( nltl:iceClassIb nltl:iceClassIc ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:ballastConditionPropellerTopDepth ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:requiredPropellerSubmersionDepthHi ] ; sh:sparql [ sh:message Literal("For ice class IB or IC, the ballast-condition propeller top depth must be at least hi in this alternative.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
                        $this nltl:ballastConditionPropellerTopDepth ?depth .
                        ?depth qudt:numericValue ?depthValue ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                        $this nltl:requiredPropellerSubmersionDepthHi ?required .
                        ?required qudt:numericValue ?requiredValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (?depthValue < ?requiredValue)
                    }
                ") ] ] , [ sh:property [ sh:class nltl:iceClassValue ; sh:hasValue nltl:iceClassIa ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("When the propeller top depth is deficient for ice class IB or IC, the propulsion system must be designed for ice class IA.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:propulsionSystemDesignedForIceClass ], [ sh:class nltl:iceClassValue ; sh:in ( nltl:iceClassIb nltl:iceClassIc ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:ballastConditionPropellerTopDepth ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:requiredPropellerSubmersionDepthHi ] ; sh:sparql [ sh:message Literal("This alternative applies only when the ballast-condition propeller top depth is less than hi.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
                        $this nltl:ballastConditionPropellerTopDepth ?depth .
                        ?depth qudt:numericValue ?depthValue ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                        $this nltl:requiredPropellerSubmersionDepthHi ?required .
                        ?required qudt:numericValue ?requiredValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (?depthValue >= ?requiredValue)
                    }
                ") ] ] , [ sh:property [ sh:class nltl:iceClassValue ; sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIi nltl:iceClassIii ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF074ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-F03/ship> ] .

