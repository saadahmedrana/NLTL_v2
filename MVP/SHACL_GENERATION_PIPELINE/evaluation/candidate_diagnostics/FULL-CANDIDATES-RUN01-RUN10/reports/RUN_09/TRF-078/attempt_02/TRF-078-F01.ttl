@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "A ship must have exactly one ice class." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceClassValue ;
                    sh:maxCount 1 ;
                    sh:message "A ship must have exactly one ice class." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:iceClass ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "The ship must have exactly one applicable Table 6-7 lookup case with a propeller location and selected factor." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ship must have exactly one applicable Table 6-7 lookup case with a propeller location and selected factor." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:hasTableLookupCase ?case7 .
                FILTER (
                    NOT EXISTS {
                        ?case7 a nltl:tableLookupCase ;
                               nltl:tableReference nltl:traficomTable6Dash7 ;
                               nltl:tableLookupPropellerLocation ?location7 ;
                               nltl:selectedPropellerLocationFactor ?factor7 .
                    }
                    ||
                    EXISTS {
                        ?other7 a nltl:tableLookupCase ;
                                nltl:tableReference nltl:traficomTable6Dash7 ;
                                nltl:tableLookupPropellerLocation ?otherLocation7 ;
                                nltl:selectedPropellerLocationFactor ?otherFactor7 .
                        FILTER (?case7 != ?other7)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-078-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/table6> ;
                    sh:resultMessage "Node ex:table6 must conform to one or more shapes in <urn:nltl:generated-shape:TRF-078-Table6Dash6CaseShape> , <urn:nltl:generated-shape:TRF-078-Table6Dash7CaseShape>" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:TRF-078-TableLookupCaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/table6> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF-078-TableLookupCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:tableLookupCase ;
                    sh:minCount 2 ;
                    sh:node <urn:nltl:generated-shape:TRF-078-TableLookupCaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/table6> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "The ship must have exactly one applicable Table 6-6 lookup case keyed by its ice class." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ship must have exactly one applicable Table 6-6 lookup case keyed by its ice class." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:ship .
                FILTER (
                    NOT EXISTS {
                        $this nltl:iceClass ?shipIceClass ;
                              nltl:hasTableLookupCase ?case6 .
                        ?case6 a nltl:tableLookupCase ;
                               nltl:tableReference nltl:traficomTable6Dash6 ;
                               nltl:iceClass ?shipIceClass ;
                               nltl:selectedIceClassCycleCount ?count6 .
                    }
                    ||
                    EXISTS {
                        $this nltl:iceClass ?shipIceClass ;
                              nltl:hasTableLookupCase ?case6 ;
                              nltl:hasTableLookupCase ?other6 .
                        ?case6 a nltl:tableLookupCase ;
                               nltl:tableReference nltl:traficomTable6Dash6 ;
                               nltl:iceClass ?shipIceClass ;
                               nltl:selectedIceClassCycleCount ?count6 .
                        ?other6 a nltl:tableLookupCase ;
                                nltl:tableReference nltl:traficomTable6Dash6 ;
                                nltl:iceClass ?shipIceClass ;
                                nltl:selectedIceClassCycleCount ?otherCount6 .
                        FILTER (?case6 != ?other6)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-078-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ] .

