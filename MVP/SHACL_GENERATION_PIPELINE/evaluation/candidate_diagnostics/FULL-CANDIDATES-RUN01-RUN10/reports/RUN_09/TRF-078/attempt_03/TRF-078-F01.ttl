@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "Each Table 6-7 lookup case must be ship-linked, typed, reference Table 6-7, and provide one propeller-location selection key and one selected location factor." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each Table 6-7 lookup case must be ship-linked, typed, reference Table 6-7, and provide one propeller-location selection key and one selected location factor." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:hasTableLookupCase ?case .
                    ?case nltl:tableReference nltl:traficomTable6Dash7 .
                    FILTER NOT EXISTS { ?case a nltl:tableLookupCase . }
                }
                UNION
                {
                    $this nltl:hasTableLookupCase ?case .
                    ?case nltl:tableReference nltl:traficomTable6Dash7 .
                    FILTER NOT EXISTS {
                        ?case a nltl:tableLookupCase ;
                              nltl:tableLookupPropellerLocation ?location ;
                              nltl:selectedPropellerLocationFactor ?factor .
                        ?location a nltl:propellerLocationValue .
                        ?factor a qudt:QuantityValue ;
                                qudt:numericValue ?factorValue ;
                                qudt:unit unit:UNITLESS .
                        FILTER (datatype(?factorValue) = xsd:decimal)
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF078ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ] .

