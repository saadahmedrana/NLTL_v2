@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "Node ex:table6 must conform to one or more shapes in <urn:nltl:generated-shape:TRF078_Table6CaseShape> , <urn:nltl:generated-shape:TRF078_Table7CaseShape>" ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:or ( <urn:nltl:generated-shape:TRF078_Table6CaseShape> <urn:nltl:generated-shape:TRF078_Table7CaseShape> ) ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/table6> ] .

