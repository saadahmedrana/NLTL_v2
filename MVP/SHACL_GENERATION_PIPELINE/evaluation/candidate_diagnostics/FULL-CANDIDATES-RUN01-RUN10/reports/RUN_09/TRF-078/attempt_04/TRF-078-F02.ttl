@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ;
            sh:resultMessage "iceLoadCycleCount must equal k1*k2*k3*N_class*n_n within a relative tolerance of 1e-6 plus an absolute fallback of 1e-9; exactly one valid Table 6-6 and one valid Table 6-7 case must supply the selected operands" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "iceLoadCycleCount must equal k1*k2*k3*N_class*n_n within a relative tolerance of 1e-6 plus an absolute fallback of 1e-9; exactly one valid Table 6-6 and one valid Table 6-7 case must supply the selected operands" ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCoefficientK2 ?k2Node ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Node ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnNode ;
                      nltl:iceLoadCycleCount ?reported .

                ?k2Node qudt:numericValue ?k2 ;
                         qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?k3Node qudt:numericValue ?k3 ;
                         qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?nnNode qudt:numericValue ?nn ;
                         qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

                $this nltl:hasTableLookupCase ?case6 .
                ?case6 a nltl:tableLookupCase ;
                        nltl:tableReference nltl:traficomTable6Dash6 ;
                        nltl:iceClass ?classKey ;
                        nltl:selectedIceClassCycleCount ?nClassNode .
                ?nClassNode qudt:numericValue ?nClass ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

                FILTER NOT EXISTS {
                    $this nltl:hasTableLookupCase ?other6 .
                    ?other6 a nltl:tableLookupCase ;
                            nltl:tableReference nltl:traficomTable6Dash6 .
                    FILTER (?other6 != ?case6)
                }

                $this nltl:hasTableLookupCase ?case7 .
                ?case7 a nltl:tableLookupCase ;
                        nltl:tableReference nltl:traficomTable6Dash7 ;
                        nltl:tableLookupPropellerLocation ?locationKey ;
                        nltl:selectedPropellerLocationFactor ?k1Node .
                ?k1Node qudt:numericValue ?k1 ;
                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

                FILTER NOT EXISTS {
                    $this nltl:hasTableLookupCase ?other7 .
                    ?other7 a nltl:tableLookupCase ;
                            nltl:tableReference nltl:traficomTable6Dash7 .
                    FILTER (?other7 != ?case7)
                }

                BIND ((?k1 * ?k2 * ?k3 * ?nClass * ?nn) AS ?expected)
                BIND ((?expected * 0.000001 + 0.000000001) AS ?tolerance)

                FILTER (
                    (?reported > (?expected + ?tolerance)) ||
                    (?reported < (?expected - ?tolerance))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF078_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F02/ship> ] .

