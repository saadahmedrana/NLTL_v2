@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ;
            sh:resultMessage "Propeller immersion function and ice load cycle coefficient k2 must satisfy the specified formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Propeller immersion function and ice load cycle coefficient k2 must satisfy the specified formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?iceNode ;
                      nltl:propellerDiameter ?diameterNode ;
                      nltl:propellerShaftCentrelineDepth ?depthNode ;
                      nltl:propellerImmersionFunction ?fNode ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node .

                ?iceNode qudt:numericValue ?ice .
                ?diameterNode qudt:numericValue ?diameter .
                ?depthNode qudt:numericValue ?depth .
                ?fNode qudt:numericValue ?reportedF .
                ?k2Node qudt:numericValue ?reportedK2 .

                BIND (((?depth - ?ice) / (?diameter / 2)) - 1 AS ?fCalc)

                BIND (
                    IF(
                        ?fCalc < 0,
                        0.8 - ?fCalc,
                        IF(
                            ?fCalc <= 1,
                            0.8 - (0.4 * ?fCalc),
                            IF(
                                ?fCalc <= 2.5,
                                0.6 - (0.2 * ?fCalc),
                                0.1
                            )
                        )
                    ) AS ?k2Calc
                )

                BIND (IF(?fCalc < 0, -?fCalc, ?fCalc) AS ?fMagnitude)
                BIND (IF(?fMagnitude > 0.000000001, ?fMagnitude * 0.000001, 0.000000001) AS ?fTolerance)

                BIND (IF(?k2Calc < 0, -?k2Calc, ?k2Calc) AS ?k2Magnitude)
                BIND (IF(?k2Magnitude > 0.000000001, ?k2Magnitude * 0.000001, 0.000000001) AS ?k2Tolerance)

                FILTER (
                    ?reportedF < (?fCalc - ?fTolerance) ||
                    ?reportedF > (?fCalc + ?fTolerance) ||
                    ?reportedK2 < (?k2Calc - ?k2Tolerance) ||
                    ?reportedK2 > (?k2Calc + ?k2Tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_079_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ] .

