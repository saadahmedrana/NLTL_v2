@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-P01/ship> ;
            sh:resultMessage "Ice thrust and propeller shaft design thrust values must satisfy the declared formulas; calculated results use a 1e-6 relative tolerance with a 1e-6 absolute fallback." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ice thrust and propeller shaft design thrust values must satisfy the declared formulas; calculated results use a 1e-6 relative tolerance with a 1e-6 absolute fallback." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce ?forwardForceNode ;
                      nltl:backwardBladeForce ?backwardForceNode ;
                      nltl:hydrodynamicBollardThrust ?bollardNode ;
                      nltl:forwardIceThrust ?forwardIceNode ;
                      nltl:backwardIceThrust ?backwardIceNode ;
                      nltl:forwardPropellerShaftDesignThrust ?forwardDesignNode ;
                      nltl:backwardPropellerShaftDesignThrust ?backwardDesignNode ;
                      nltl:propellerShaftDesignThrust ?designNode .

                ?forwardForceNode qudt:numericValue ?forwardForce .
                ?backwardForceNode qudt:numericValue ?backwardForce .
                ?bollardNode qudt:numericValue ?bollard .
                ?forwardIceNode qudt:numericValue ?forwardIce .
                ?backwardIceNode qudt:numericValue ?backwardIce .
                ?forwardDesignNode qudt:numericValue ?forwardDesign .
                ?backwardDesignNode qudt:numericValue ?backwardDesign .
                ?designNode qudt:numericValue ?design .

                BIND((1.1 * ?forwardForce) AS ?expectedForwardIce)
                BIND((1.1 * ?backwardForce) AS ?expectedBackwardIce)
                BIND((?bollard + (2.2 * ?expectedForwardIce)) AS ?forwardLoad)
                BIND((1.5 * ?expectedBackwardIce) AS ?backwardLoad)
                BIND(IF(?forwardLoad >= ?backwardLoad, ?forwardLoad, ?backwardLoad) AS ?expectedDesign)

                BIND(IF(ABS(?expectedForwardIce) * 0.000001 > 0.000001,
                        ABS(?expectedForwardIce) * 0.000001,
                        0.000001) AS ?forwardIceTolerance)
                BIND(IF(ABS(?expectedBackwardIce) * 0.000001 > 0.000001,
                        ABS(?expectedBackwardIce) * 0.000001,
                        0.000001) AS ?backwardIceTolerance)
                BIND(IF(ABS(?expectedDesign) * 0.000001 > 0.000001,
                        ABS(?expectedDesign) * 0.000001,
                        0.000001) AS ?designTolerance)

                FILTER (
                    ABS(?forwardIce - ?expectedForwardIce) > ?forwardIceTolerance
                    || ABS(?backwardIce - ?expectedBackwardIce) > ?backwardIceTolerance
                    || ABS(?forwardDesign - ?expectedDesign) > ?designTolerance
                    || ABS(?backwardDesign - ?expectedDesign) > ?designTolerance
                    || ABS(?design - ?expectedDesign) > ?designTolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF_081_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-P01/ship> ] .

