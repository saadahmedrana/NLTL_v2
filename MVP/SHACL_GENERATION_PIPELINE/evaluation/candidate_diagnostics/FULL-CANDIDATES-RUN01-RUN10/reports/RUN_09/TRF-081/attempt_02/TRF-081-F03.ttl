@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-F03/ship> ;
            sh:resultMessage "Each ship must provide one backward propeller shaft design thrust in kN." ;
            sh:resultPath nltl:backwardPropellerShaftDesignThrust ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ship must provide one backward propeller shaft design thrust in kN." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF081QuantityValueShape ;
                    sh:path nltl:backwardPropellerShaftDesignThrust ] ] .

