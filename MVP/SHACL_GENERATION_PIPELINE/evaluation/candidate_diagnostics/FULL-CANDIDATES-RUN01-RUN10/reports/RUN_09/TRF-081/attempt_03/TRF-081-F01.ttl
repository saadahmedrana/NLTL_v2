@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-F01/ship> ;
            sh:resultMessage "Ice thrust and propeller shaft design thrust values must satisfy the declared forward, backward, and maximum directional formulas." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ice thrust and propeller shaft design thrust values must satisfy the declared forward, backward, and maximum directional formulas." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce ?forwardForceNode ;
                      nltl:backwardBladeForce ?backwardForceNode ;
                      nltl:hydrodynamicBollardThrust ?bollardNode ;
                      nltl:forwardIceThrust ?forwardIceNode ;
                      nltl:backwardIceThrust ?backwardIceNode ;
                      nltl:forwardPropellerShaftDesignThrust ?forwardDesignNode ;
                      nltl:backwardPropellerShaftDesignThrust ?backwardDesignNode ;
                      nltl:propellerShaftDesignThrust ?designNode .

                ?forwardForceNode qudt:numericValue ?forwardForce .
                ?backwardForceNode qudt:numericValue ?backwardForce .
                ?bollardNode qudt:numericValue ?bollard .
                ?forwardIceNode qudt:numericValue ?forwardIce .
                ?backwardIceNode qudt:numericValue ?backwardIce .
                ?forwardDesignNode qudt:numericValue ?forwardDesign .
                ?backwardDesignNode qudt:numericValue ?backwardDesign .
                ?designNode qudt:numericValue ?design .

                BIND (1.1 * ?forwardForce AS ?expectedForwardIce)
                BIND (1.1 * ?backwardForce AS ?expectedBackwardIce)
                BIND (?bollard + 2.2 * ?expectedForwardIce AS ?expectedForwardDesign)
                BIND (1.5 * ?expectedBackwardIce AS ?expectedBackwardDesign)
                BIND (
                    IF(
                        ?expectedForwardDesign >= ?expectedBackwardDesign,
                        ?expectedForwardDesign,
                        ?expectedBackwardDesign
                    )
                    AS ?expectedDesign
                )

                FILTER (
                    ?forwardIce <
                        ?expectedForwardIce -
                        (
                            IF(?expectedForwardIce >= 0,
                               ?expectedForwardIce,
                               0 - ?expectedForwardIce)
                            * 0.000001 + 0.000000001
                        )
                    ||
                    ?forwardIce >
                        ?expectedForwardIce +
                        (
                            IF(?expectedForwardIce >= 0,
                               ?expectedForwardIce,
                               0 - ?expectedForwardIce)
                            * 0.000001 + 0.000000001
                        )
                    ||
                    ?backwardIce <
                        ?expectedBackwardIce -
                        (
                            IF(?expectedBackwardIce >= 0,
                               ?expectedBackwardIce,
                               0 - ?expectedBackwardIce)
                            * 0.000001 + 0.000000001
                        )
                    ||
                    ?backwardIce >
                        ?expectedBackwardIce +
                        (
                            IF(?expectedBackwardIce >= 0,
                               ?expectedBackwardIce,
                               0 - ?expectedBackwardIce)
                            * 0.000001 + 0.000000001
                        )
                    ||
                    ?forwardDesign <
                        ?expectedForwardDesign -
                        (
                            IF(?expectedForwardDesign >= 0,
                               ?expectedForwardDesign,
                               0 - ?expectedForwardDesign)
                            * 0.000001 + 0.000000001
                        )
                    ||
                    ?forwardDesign >
                        ?expectedForwardDesign +
                        (
                            IF(?expectedForwardDesign >= 0,
                               ?expectedForwardDesign,
                               0 - ?expectedForwardDesign)
                            * 0.000001 + 0.000000001
                        )
                    ||
                    ?backwardDesign <
                        ?expectedBackwardDesign -
                        (
                            IF(?expectedBackwardDesign >= 0,
                               ?expectedBackwardDesign,
                               0 - ?expectedBackwardDesign)
                            * 0.000001 + 0.000000001
                        )
                    ||
                    ?backwardDesign >
                        ?expectedBackwardDesign +
                        (
                            IF(?expectedBackwardDesign >= 0,
                               ?expectedBackwardDesign,
                               0 - ?expectedBackwardDesign)
                            * 0.000001 + 0.000000001
                        )
                    ||
                    ?design <
                        ?expectedDesign -
                        (
                            IF(?expectedDesign >= 0,
                               ?expectedDesign,
                               0 - ?expectedDesign)
                            * 0.000001 + 0.000000001
                        )
                    ||
                    ?design >
                        ?expectedDesign +
                        (
                            IF(?expectedDesign >= 0,
                               ?expectedDesign,
                               0 - ?expectedDesign)
                            * 0.000001 + 0.000000001
                        )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_081_StaticCalculationShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-F01/ship> ] .

