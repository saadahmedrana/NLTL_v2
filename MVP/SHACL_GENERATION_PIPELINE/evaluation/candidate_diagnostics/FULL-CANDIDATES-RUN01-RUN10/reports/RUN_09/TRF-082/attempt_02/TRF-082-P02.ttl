@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-082-P02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Bollard thrust must be explicitly recorded as known for this branch.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bollardThrustKnown ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Bollard thrust must be explicitly recorded as not known for the table-lookup branch.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bollardThrustKnown ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A hydrodynamic bollard thrust quantity in kN is required when the thrust is not known.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:hydrodynamicBollardThrust ], [ sh:message Literal("A Table 6-8 lookup case is required when hydrodynamic bollard thrust is not known.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:tableLookupCase ; sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal("Evidence for the Table 6-8 selection is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:lookupSelectionEvidence ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The Table 6-8 lookup case must be marked as applied.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:tableLookupApplied ], [ sh:message Literal("The lookup case must reference TRAFICOM Table 6-8.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:hasValue nltl:traficomTable6Dash8 ] ; sh:path nltl:tableReference ] ] ; sh:path nltl:hasTableLookupCase ] ; sh:sparql [ sh:message Literal("When thrust is not known, the recorded hydrodynamic bollard thrust must equal the numeric value selected from Table 6-8.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:bollardThrustKnown false ;
                              nltl:hydrodynamicBollardThrust ?thrust ;
                              nltl:hasTableLookupCase ?case .
                        ?thrust qudt:numericValue ?actual .
                        ?case nltl:tableReference nltl:traficomTable6Dash8 .
                        FILTER (
                            NOT EXISTS {
                                nltl:traficomTable6Dash8 qudt:numericValue ?selected
                            }
                            ||
                            NOT EXISTS {
                                nltl:traficomTable6Dash8 qudt:numericValue ?matching ;
                                FILTER (?matching = ?actual)
                            }
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-082> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-082-P02/ship> ] .

