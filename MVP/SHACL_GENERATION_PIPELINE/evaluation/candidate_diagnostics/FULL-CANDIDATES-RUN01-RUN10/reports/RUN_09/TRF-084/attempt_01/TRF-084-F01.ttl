@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:pitchValueKnown ] ; sh:sparql [ sh:message Literal("For a CP propeller with a known pitch value, propellerPitchAtMcrBollard must be present as a decimal quantity in metres.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerType "CP"^^xsd:string ;
                              nltl:pitchValueKnown true .
                        FILTER NOT EXISTS {
                            $this nltl:propellerPitchAtMcrBollard ?result .
                            ?result qudt:numericValue ?value ;
                                    qudt:unit unit:M .
                            FILTER(datatype(?value) = xsd:decimal)
                        }
                    }
                ") ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:pitchValueKnown ] ; sh:sparql [ sh:message Literal("For a CP propeller with an unknown pitch value, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within a relative tolerance of 1e-6 plus an absolute fallback of 1e-9, with both quantities expressed in metres.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerType "CP"^^xsd:string ;
                              nltl:pitchValueKnown false .
                        FILTER NOT EXISTS {
                            $this nltl:propellerPitchAtMcrFreeRunning ?free ;
                                  nltl:propellerPitchAtMcrBollard ?bollard .
                            ?free qudt:numericValue ?freeValue ;
                                  qudt:unit unit:M .
                            ?bollard qudt:numericValue ?bollardValue ;
                                     qudt:unit unit:M .
                            FILTER(datatype(?freeValue) = xsd:decimal)
                            FILTER(datatype(?bollardValue) = xsd:decimal)
                            BIND(0.7 * ?freeValue AS ?expected)
                            FILTER(
                                ABS(?bollardValue - ?expected)
                                <= ABS(?expected) * 0.000001 + 0.000000001
                            )
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-084> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ] .

