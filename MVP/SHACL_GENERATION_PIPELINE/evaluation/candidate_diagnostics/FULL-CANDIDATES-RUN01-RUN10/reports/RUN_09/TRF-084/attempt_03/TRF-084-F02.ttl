@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("For a CP propeller with known pitch, pitchValueKnown must be true.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:pitchValueKnown ], [ sh:hasValue Literal("CP") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerType ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A CP propeller with known pitch must provide one bollard-condition pitch quantity in metres.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:propellerPitchAtMcrBollard ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("For a CP propeller with unknown pitch, pitchValueKnown must be false.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:pitchValueKnown ], [ sh:hasValue Literal("CP") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerType ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An unknown CP propeller pitch requires one bollard-condition pitch quantity in metres.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:propellerPitchAtMcrBollard ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An unknown CP propeller pitch requires one free-running MCR pitch quantity in metres.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:propellerPitchAtMcrFreeRunning ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("For an unknown CP propeller pitch, the bollard pitch must equal 0.7 times the free-running pitch within the permitted tolerance.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:propellerPitchAtMcrFreeRunning ?freeQuantity .
                        ?freeQuantity qudt:numericValue ?free .
                        ?freeQuantity qudt:unit <http://qudt.org/vocab/unit/M> .
                        $this nltl:propellerPitchAtMcrBollard ?bollardQuantity .
                        ?bollardQuantity qudt:numericValue ?bollard .
                        ?bollardQuantity qudt:unit <http://qudt.org/vocab/unit/M> .
                        BIND (0.7 * ?free AS ?expected)
                        FILTER (!(
                            (
                                ?expected >= 0.000001 &&
                                ?bollard >= (?expected - (0.000001 * ?expected)) &&
                                ?bollard <= (?expected + (0.000001 * ?expected))
                            ) ||
                            (
                                ?expected < 0.000001 &&
                                ?bollard >= (?expected - 0.000000000001) &&
                                ?bollard <= (?expected + 0.000000000001)
                            )
                        ))
                    }
                ") ] ] , [ sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("The conditional propeller pitch rule applies only to CP propellers or must identify a non-CP propeller type.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>

                    SELECT $this
                    WHERE {
                        $this nltl:propellerType ?type .
                        FILTER (?type = "CP")
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF084Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F02/ship> ] .

