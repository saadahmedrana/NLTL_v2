@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:string ; sh:path nltl:propellerType ; sh:pattern Literal("^(?!CP$).*") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:pitchValueKnown ], [ sh:datatype xsd:string ; sh:hasValue Literal("CP", datatype=xsd:string) ; sh:path nltl:propellerType ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A CP propeller with a known pitch must provide its MCR bollard-condition pitch.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:propellerPitchAtMcrBollard ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:pitchValueKnown ], [ sh:datatype xsd:string ; sh:hasValue Literal("CP", datatype=xsd:string) ; sh:path nltl:propellerType ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The MCR bollard-condition propeller pitch is required when the pitch value is not known.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:propellerPitchAtMcrBollard ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The MCR free-running propeller pitch is required to calculate the bollard-condition pitch.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:propellerPitchAtMcrFreeRunning ] ; sh:sparql [ sh:message Literal("For a CP propeller with unknown pitch, the MCR bollard pitch must equal 0.7 times the MCR free-running pitch within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:propellerType ?propellerType ;
          nltl:pitchValueKnown ?pitchValueKnown ;
          nltl:propellerPitchAtMcrBollard ?bollardPitch ;
          nltl:propellerPitchAtMcrFreeRunning ?freeRunningPitch .
    FILTER (?propellerType = "CP"^^xsd:string)
    FILTER (?pitchValueKnown = false)
    ?bollardPitch qudt:numericValue ?bollardValue ;
                  qudt:unit unit:M .
    ?freeRunningPitch qudt:numericValue ?freeValue ;
                      qudt:unit unit:M .
    BIND (0.7 * ?freeValue AS ?expectedValue)
    FILTER (
        ABS(?bollardValue - ?expectedValue) >
        (0.000001 * ABS(?expectedValue) + 0.000000001)
    )
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF086Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-F02/ship> ] .

