@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-P01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:TRF086CpKnownShape , gen:TRF086CpUnknownShape , gen:TRF086NonCpShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF086Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-P01/ship> ] .

