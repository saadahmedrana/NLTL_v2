@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/milling> ;
            sh:resultMessage "The ship shall identify an ice milling sequence case." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceMillingSequenceCase ;
                    sh:message "The ship shall identify an ice milling sequence case." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceMillingSequenceCase ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ;
                    sh:resultMessage "The propulsion load case shall be identified as being for propulsion line strength evaluation." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCasePurposeValue ;
                            sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                            sh:message "The propulsion load case shall be identified as being for propulsion line strength evaluation." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:loadCasePurpose ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ;
                    sh:resultMessage "Node ex:loadCase must not conform to shape [ sh:property [ sh:hasValue nltl:stallingAnalysisPurposeValue ; sh:path nltl:loadCasePurpose ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NotConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:TRF-091_PropulsionLoadCaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/milling> ;
            sh:resultMessage "The ship shall identify a propulsion load case for the strength evaluation." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nfb11b01358ea4e9ebe299e0e44adca8cb2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/ship> ;
            sh:resultMessage "The ship shall identify a propulsion load case for the strength evaluation." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nfb11b01358ea4e9ebe299e0e44adca8cb2 ] .

_:nfb11b01358ea4e9ebe299e0e44adca8cb2 sh:class nltl:loadCase ;
    sh:message "The ship shall identify a propulsion load case for the strength evaluation." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:TRF-091_PropulsionLoadCaseShape> ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasPropulsionLoadCase .

