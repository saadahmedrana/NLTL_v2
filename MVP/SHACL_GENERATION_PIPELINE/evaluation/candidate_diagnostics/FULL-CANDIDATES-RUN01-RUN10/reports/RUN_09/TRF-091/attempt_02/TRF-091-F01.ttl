@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ;
                    sh:resultMessage "The propulsion load case shall be designated for propulsion line strength evaluation and shall not be designated for stalling analysis." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCasePurposeValue ;
                            sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                            sh:maxCount 1 ;
                            sh:message "The propulsion load case shall be designated for propulsion line strength evaluation and shall not be designated for stalling analysis." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:loadCasePurpose ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/milling> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:class nltl:loadCasePurposeValue ; sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The propulsion load case shall be designated for propulsion line strength evaluation and shall not be designated for stalling analysis.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:loadCasePurpose ] ]. See details for more information." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:loadCase ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ sh:class nltl:loadCasePurposeValue ;
                                    sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                                    sh:maxCount 1 ;
                                    sh:message "The propulsion load case shall be designated for propulsion line strength evaluation and shall not be designated for stalling analysis." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:loadCasePurpose ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasPropulsionLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/ship> ;
            sh:resultMessage "Each existing ice-milling sequence case shall be the propulsion load case used for the strength evaluation." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
            sh:sourceShape _:n185fab2d39c54b58a58c69cb11e61e3db1 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/milling> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/milling> ;
            sh:resultMessage "Each existing ice-milling sequence case shall be the propulsion load case used for the strength evaluation." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
            sh:sourceShape _:n185fab2d39c54b58a58c69cb11e61e3db1 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ] .

_:n185fab2d39c54b58a58c69cb11e61e3db1 sh:class nltl:iceMillingSequenceCase ;
    sh:equals nltl:hasPropulsionLoadCase ;
    sh:message "Each existing ice-milling sequence case shall be the propulsion load case used for the strength evaluation." ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasIceMillingSequenceCase .

