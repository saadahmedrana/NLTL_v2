@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F03/milling> ;
            sh:resultMessage "Each existing ice-milling sequence case shall be the propulsion load case used for the strength evaluation." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
            sh:sourceShape _:n185fab2d39c54b58a58c69cb11e61e3db1 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F03/loadCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F03/ship> ;
            sh:resultMessage "Each existing ice-milling sequence case shall be the propulsion load case used for the strength evaluation." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
            sh:sourceShape _:n185fab2d39c54b58a58c69cb11e61e3db1 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F03/milling> ] .

_:n185fab2d39c54b58a58c69cb11e61e3db1 sh:class nltl:iceMillingSequenceCase ;
    sh:equals nltl:hasPropulsionLoadCase ;
    sh:message "Each existing ice-milling sequence case shall be the propulsion load case used for the strength evaluation." ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasIceMillingSequenceCase .

