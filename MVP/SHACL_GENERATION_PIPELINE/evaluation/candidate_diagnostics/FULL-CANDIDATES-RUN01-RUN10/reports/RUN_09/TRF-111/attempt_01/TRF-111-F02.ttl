@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/ship> ;
            sh:resultMessage "The ship shall provide the externally calculated extreme ice force in kN." ;
            sh:resultPath nltl:extremeIceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide the externally calculated extreme ice force in kN." ;
                    sh:minCount 1 ;
                    sh:node gen:ExtremeIceForceQuantityShape ;
                    sh:path nltl:extremeIceForce ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/fatigueSafetyFactorValue> ;
                            sh:resultMessage "Value is not >= Literal(\"1.5\", datatype=xsd:decimal)" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                            sh:sourceShape [ sh:minInclusive 1.5 ;
                                    sh:path qudt:numericValue ] ;
                            sh:value 1.3 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/component> ;
                    sh:resultMessage "Each propeller shaft line component shall have a fatigue safety factor of at least 1.5." ;
                    sh:resultPath nltl:fatigueSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each propeller shaft line component shall have a fatigue safety factor of at least 1.5." ;
                            sh:minCount 1 ;
                            sh:node gen:TRF111FatigueFactorAtLeast150Shape ;
                            sh:path nltl:fatigueSafetyFactor ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/fatigueSafetyFactorValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF111ShaftLineComponentShape. See details for more information." ;
            sh:resultPath nltl:hasPropellerShaftLineComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:TRF111ShaftLineComponentShape ;
                    sh:path nltl:hasPropellerShaftLineComponent ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/component> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/loadCase> ;
                    sh:resultMessage "Node ex:loadCase must conform to one or more shapes in gen:TRF111ExtremeOperationalLoadCaseShape , gen:TRF111FatigueLoadCaseShape , gen:TRF111BladeFailureLoadCaseShape" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:or ( gen:TRF111ExtremeOperationalLoadCaseShape gen:TRF111FatigueLoadCaseShape gen:TRF111BladeFailureLoadCaseShape ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/loadCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/ship> ;
            sh:resultMessage "Each propulsion load case shall identify an applicable shaft-line load-case type and satisfy its associated readiness check." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each propulsion load case shall identify an applicable shaft-line load-case type and satisfy its associated readiness check." ;
                    sh:node [ sh:or ( gen:TRF111ExtremeOperationalLoadCaseShape gen:TRF111FatigueLoadCaseShape gen:TRF111BladeFailureLoadCaseShape ) ] ;
                    sh:path nltl:hasPropulsionLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/loadCase> ] .

