@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F03/ship> ;
            sh:resultMessage "The ship must provide the extreme ice force in kN." ;
            sh:resultPath nltl:extremeIceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the extreme ice force in kN." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:extremeIceForce ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F03/loadCase> ;
                    sh:resultMessage "Each propulsion load case must identify an applicable shaft line load case type and satisfy its required safety factor." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCase ;
                            sh:message "Each propulsion load case must identify an applicable shaft line load case type and satisfy its required safety factor." ;
                            sh:or ( [ sh:property [ sh:hasValue nltl:extremeOperationalLoadCase ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] [ sh:property [ sh:hasValue nltl:fatigueLoadCase ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] [ sh:property [ sh:hasValue nltl:bladeFailureLoadCase ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] ) ;
                            sh:property [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                                    sh:in ( nltl:bladeFailureLoadCase nltl:extremeOperationalLoadCase nltl:fatigueLoadCase ) ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:shaftLineLoadCaseType ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F03/loadCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:loadCase ; sh:message Literal(\"Each propulsion load case must identify an applicable shaft line load case type and satisfy its required safety factor.\") ; sh:or ( [ sh:property [ sh:hasValue nltl:extremeOperationalLoadCase ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shaftLineLoadCaseType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.3\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ] ] [ sh:property [ sh:hasValue nltl:fatigueLoadCase ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shaftLineLoadCaseType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.5\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ] ] [ sh:property [ sh:hasValue nltl:bladeFailureLoadCase ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shaftLineLoadCaseType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ] ] ) ; sh:property [ sh:class nltl:shaftLineLoadCaseTypeValue ; sh:in ( nltl:bladeFailureLoadCase nltl:extremeOperationalLoadCase nltl:fatigueLoadCase ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shaftLineLoadCaseType ] ]. See details for more information." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:loadCase ;
                            sh:message "Each propulsion load case must identify an applicable shaft line load case type and satisfy its required safety factor." ;
                            sh:or ( [ sh:property [ sh:hasValue nltl:extremeOperationalLoadCase ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:componentYieldSafetyFactor ],
                                            [ sh:hasValue nltl:fatigueLoadCase ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ] ] [ sh:property [ sh:hasValue nltl:bladeFailureLoadCase ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] ) ;
                            sh:property [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                                    sh:in ( nltl:bladeFailureLoadCase nltl:extremeOperationalLoadCase nltl:fatigueLoadCase ) ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:shaftLineLoadCaseType ] ] ;
                    sh:path nltl:hasPropulsionLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F03/loadCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasComponent" ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:shipComponent ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "Each applicable shaft line component must have a fatigue safety factor of at least 1.5." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:minInclusive 1.5 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:fatigueSafetyFactor ] ] ;
                    sh:path nltl:hasComponent ] ] .

