@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F03/loadCase> ;
            sh:resultMessage "The fatigue load case safety factor shall be at least 1.5." ;
            sh:resultPath nltl:componentYieldSafetyFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n52b21278aaac4184a69fcb9da071bc0bb32 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F03/ship> ;
            sh:resultMessage "The ship shall provide one extreme ice force in kN." ;
            sh:resultPath nltl:extremeIceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide one extreme ice force in kN." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:extremeIceForce ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F03/componentYieldSafetyFactorValue> ;
                    sh:resultMessage "Value is not >= Literal(\"1.5\", datatype=xsd:decimal)" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:minInclusive 1.5 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 0.8 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F03/component> ;
            sh:resultMessage "The fatigue load case safety factor shall be at least 1.5." ;
            sh:resultPath nltl:componentYieldSafetyFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n52b21278aaac4184a69fcb9da071bc0bb32 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F03/componentYieldSafetyFactorValue> ] .

_:N7b588e6338cf46249316b850ca1fa474 sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 1.5 ;
    sh:path qudt:numericValue .

_:N83e6abfeefc44e17ad07c889c917d08d sh:property _:N7b588e6338cf46249316b850ca1fa474,
        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:n52b21278aaac4184a69fcb9da071bc0bb32 sh:maxCount 1 ;
    sh:message "The fatigue load case safety factor shall be at least 1.5." ;
    sh:minCount 1 ;
    sh:node _:N83e6abfeefc44e17ad07c889c917d08d ;
    sh:path nltl:componentYieldSafetyFactor .

