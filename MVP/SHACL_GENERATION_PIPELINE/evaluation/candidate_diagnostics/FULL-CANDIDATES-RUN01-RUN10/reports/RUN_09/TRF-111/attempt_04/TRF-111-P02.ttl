@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P02/componentYieldSafetyFactorValue> ;
                    sh:resultMessage "Value is not >= Literal(\"1.5\", datatype=xsd:decimal)" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:minInclusive 1.5 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 1.0 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P02/component> ;
            sh:resultMessage "The fatigue load case safety factor shall be at least 1.5." ;
            sh:resultPath nltl:componentYieldSafetyFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n52b21278aaac4184a69fcb9da071bc0bb32 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P02/componentYieldSafetyFactorValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P02/ship> ;
            sh:resultMessage "The ship shall provide one extreme ice force in kN." ;
            sh:resultPath nltl:extremeIceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide one extreme ice force in kN." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:extremeIceForce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P02/loadCase> ;
            sh:resultMessage "The fatigue load case safety factor shall be at least 1.5." ;
            sh:resultPath nltl:componentYieldSafetyFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n52b21278aaac4184a69fcb9da071bc0bb32 ] .

_:N66868099bc1147bd888d69c0f41a9eb2 sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 1.5 ;
    sh:path qudt:numericValue .

_:N70b6d82db00249d1bbb788f4cc26ac27 sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

_:N853f0b99a6e04485a4557f90efd5296d sh:property _:N66868099bc1147bd888d69c0f41a9eb2,
        _:N70b6d82db00249d1bbb788f4cc26ac27 .

_:n52b21278aaac4184a69fcb9da071bc0bb32 sh:maxCount 1 ;
    sh:message "The fatigue load case safety factor shall be at least 1.5." ;
    sh:minCount 1 ;
    sh:node _:N853f0b99a6e04485a4557f90efd5296d ;
    sh:path nltl:componentYieldSafetyFactor .

