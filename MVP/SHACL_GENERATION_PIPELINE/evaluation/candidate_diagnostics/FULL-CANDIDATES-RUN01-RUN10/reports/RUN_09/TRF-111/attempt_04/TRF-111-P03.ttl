@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/loadCase> ;
                    sh:resultMessage "Each propulsion load case shall declare a controlled shaft-line load-case type." ;
                    sh:resultPath nltl:shaftLineLoadCaseType ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each propulsion load case shall declare a controlled shaft-line load-case type." ;
                            sh:minCount 1 ;
                            sh:or ( [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                                        sh:hasValue nltl:extremeOperationalLoadCase ;
                                        sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                                        sh:hasValue nltl:fatigueLoadCase ] [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                                        sh:hasValue nltl:bladeFailureLoadCase ;
                                        sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] ) ;
                            sh:path nltl:shaftLineLoadCaseType ] ;
                    sh:value nltl:bladeFailureLoadCase ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/ship> ;
            sh:resultMessage "The ship shall provide the applicable propulsion load cases and externally calculated safety-factor results." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide the applicable propulsion load cases and externally calculated safety-factor results." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:loadCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "Each propulsion load case shall declare a controlled shaft-line load-case type." ;
                                    sh:minCount 1 ;
                                    sh:or ( [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                                                sh:hasValue nltl:extremeOperationalLoadCase ;
                                                sh:property [ ] ] [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                                                sh:hasValue nltl:fatigueLoadCase ] [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                                                sh:hasValue nltl:bladeFailureLoadCase ;
                                                sh:property [ ] ] ) ;
                                    sh:path nltl:shaftLineLoadCaseType ] ] ;
                    sh:path nltl:hasPropulsionLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/loadCase> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/componentYieldSafetyFactorValue> ;
                    sh:resultMessage "Value is not >= Literal(\"1.5\", datatype=xsd:decimal)" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:minInclusive 1.5 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 1.0 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/component> ;
            sh:resultMessage "The fatigue load case safety factor shall be at least 1.5." ;
            sh:resultPath nltl:componentYieldSafetyFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n52b21278aaac4184a69fcb9da071bc0bb32 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/componentYieldSafetyFactorValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/ship> ;
            sh:resultMessage "The ship shall provide one extreme ice force in kN." ;
            sh:resultPath nltl:extremeIceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide one extreme ice force in kN." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:extremeIceForce ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode nltl:bladeFailureLoadCase ;
                    sh:resultMessage "Node nltl:bladeFailureLoadCase value is not a in the set of values: ['nltl:fatigueLoadCase']" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                            sh:hasValue nltl:fatigueLoadCase ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/loadCase> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:shaftLineLoadCaseTypeValue ; sh:hasValue nltl:fatigueLoadCase ]. See details for more information." ;
            sh:resultPath nltl:shaftLineLoadCaseType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:shaftLineLoadCaseTypeValue ;
                            sh:hasValue nltl:fatigueLoadCase ] ;
                    sh:path nltl:shaftLineLoadCaseType ] ;
            sh:value nltl:bladeFailureLoadCase ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-P03/loadCase> ;
            sh:resultMessage "The fatigue load case safety factor shall be at least 1.5." ;
            sh:resultPath nltl:componentYieldSafetyFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n52b21278aaac4184a69fcb9da071bc0bb32 ] .

_:N357cf746412447aabfaf5aa8ba5923bf sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1.5 ;
            sh:path qudt:numericValue ],
        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:n52b21278aaac4184a69fcb9da071bc0bb32 sh:maxCount 1 ;
    sh:message "The fatigue load case safety factor shall be at least 1.5." ;
    sh:minCount 1 ;
    sh:node _:N357cf746412447aabfaf5aa8ba5923bf ;
    sh:path nltl:componentYieldSafetyFactor .

