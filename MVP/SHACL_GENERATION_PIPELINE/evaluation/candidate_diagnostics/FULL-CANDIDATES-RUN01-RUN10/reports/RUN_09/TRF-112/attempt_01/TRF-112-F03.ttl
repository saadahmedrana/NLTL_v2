@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/ship> ;
            sh:resultMessage "For an applicable blade-failure load case, each propeller shaft-line component shall provide a torsional yield safety factor of at least 1.0 with a dimensionless unit." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an applicable blade-failure load case, each propeller shaft-line component shall provide a torsional yield safety factor of at least 1.0 with a dimensionless unit." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:hasPropulsionLoadCase ?loadCase .
  ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
  $this nltl:hasPropellerShaftLineComponent ?component .
  FILTER NOT EXISTS {
    ?component nltl:torsionalYieldSafetyFactor ?quantity .
    ?quantity a qudt:QuantityValue ;
              qudt:numericValue ?value ;
              qudt:unit qudt:UNITLESS .
    FILTER (datatype(?value) = xsd:decimal && ?value >= 1.0)
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-112-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/ship> ;
            sh:resultMessage "For an applicable blade-failure load case, each propeller shaft-line component shall provide a bending yield safety factor of at least 1.0 with a dimensionless unit." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an applicable blade-failure load case, each propeller shaft-line component shall provide a bending yield safety factor of at least 1.0 with a dimensionless unit." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:hasPropulsionLoadCase ?loadCase .
  ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
  $this nltl:hasPropellerShaftLineComponent ?component .
  FILTER NOT EXISTS {
    ?component nltl:bendingYieldSafetyFactor ?quantity .
    ?quantity a qudt:QuantityValue ;
              qudt:numericValue ?value ;
              qudt:unit qudt:UNITLESS .
    FILTER (datatype(?value) = xsd:decimal && ?value >= 1.0)
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-112-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/ship> ] .

