@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-P01/ship> ;
            sh:resultMessage "The ship must record the plastic blade-bending design condition." ;
            sh:resultPath nltl:bladePlasticBending ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must record the plastic blade-bending design condition." ;
                    sh:minCount 1 ;
                    sh:path nltl:bladePlasticBending ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-P01/ship> ;
            sh:resultMessage "The ship must identify the thruster body component." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must identify the thruster body component." ;
                    sh:path nltl:hasComponent ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:thrusterBody ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-P01/ship> ;
            sh:resultMessage "The ship must record the propeller blade orientation producing the maximum component load." ;
            sh:resultPath nltl:propellerBladeOrientation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must record the propeller blade orientation producing the maximum component load." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerBladeOrientation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-P01/ship> ;
            sh:resultMessage "The ship must identify a steering mechanism component." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must identify a steering mechanism component." ;
                    sh:path nltl:hasComponent ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:steeringMechanism ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-P01/ship> ;
            sh:resultMessage "The ship must identify the thruster unit fitting component." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must identify the thruster unit fitting component." ;
                    sh:path nltl:hasComponent ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:thrusterFitting ] ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-P01/ship> ;
            sh:resultMessage "The blade-loss assessment must link the recorded maximum-load orientation to a propulsion load case confirmed for the maximum component load." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The blade-loss assessment must link the recorded maximum-load orientation to a propulsion load case confirmed for the maximum component load." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:propellerBladeOrientation ?orientation .
                    $this nltl:hasPropulsionLoadCase ?case .
                    ?case a nltl:loadCase .
                    ?case nltl:maximumComponentLoadBladeOrientationConfirmed ?confirmed .
                    FILTER ( ?confirmed = true )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF113Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-P01/ship> ] .

