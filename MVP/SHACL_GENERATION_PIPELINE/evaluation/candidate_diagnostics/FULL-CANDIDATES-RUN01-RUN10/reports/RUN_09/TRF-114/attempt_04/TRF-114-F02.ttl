@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/thrusterBody> ;
                            sh:resultMessage "Less than 1 values on ex:thrusterBody->nltl:thrusterResistanceCapacity" ;
                            sh:resultPath nltl:thrusterResistanceCapacity ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:thrusterResistanceCapacity ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/impact> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterResistanceCapacity ] ]. See details for more information." ;
                    sh:resultPath nltl:thrusterImpactCaseAppliesToBody ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:thrusterBody ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:minCount 1 ;
                                            sh:node [ sh:class qudt:QuantityValue ;
                                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ],
                                                        [ sh:datatype xsd:decimal ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:thrusterResistanceCapacity ] ] ;
                            sh:path nltl:thrusterImpactCaseAppliesToBody ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/thrusterBody> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/impact> ;
                    sh:resultMessage """Node nltl:nonHemisphericalContactGeometry must conform to one or more shapes in [ sh:hasValue nltl:hemisphericalContactGeometry ; sh:path nltl:contactGeometryClassification ] , [ sh:hasValue nltl:nonHemisphericalContactGeometry ; sh:path nltl:contactGeometryClassification ; sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal("Non-hemispherical geometry requires correspondence evidence.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:contactGeometryCorrespondenceEvidence ] ; sh:sparql [ sh:message Literal("Non-hemispherical geometry requires a valid equivalent impact sphere radius on the ship.") ; sh:select Literal("
                                PREFIX nltl: <https://w3id.org/nltl/vocab#>
                                PREFIX qudt: <http://qudt.org/schema/qudt/>
                                PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                                SELECT $this
                                WHERE {
                                    $this nltl:contactGeometryClassification nltl:nonHemisphericalContactGeometry .
                                    FILTER NOT EXISTS {
                                        ?ship nltl:hasThrusterIceImpactLoadCase $this .
                                        ?ship nltl:equivalentImpactSphereRadius ?radius .
                                        ?radius qudt:numericValue ?value .
                                        ?radius qudt:unit <http://qudt.org/vocab/unit/M> .
                                        FILTER (datatype(?value) = xsd:decimal)
                                    }
                                }
                            ") ] ]""" ;
                    sh:resultPath nltl:contactGeometryClassification ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:or ( [ sh:hasValue nltl:hemisphericalContactGeometry ;
                                        sh:path nltl:contactGeometryClassification ] [ sh:hasValue nltl:nonHemisphericalContactGeometry ;
                                        sh:path nltl:contactGeometryClassification ;
                                        sh:property [ sh:class nltl:evidenceArtifact ;
                                                sh:message "Non-hemispherical geometry requires correspondence evidence." ;
                                                sh:minCount 1 ;
                                                sh:path nltl:contactGeometryCorrespondenceEvidence ] ;
                                        sh:sparql [ sh:message "Non-hemispherical geometry requires a valid equivalent impact sphere radius on the ship." ;
                                                sh:select """
                                PREFIX nltl: <https://w3id.org/nltl/vocab#>
                                PREFIX qudt: <http://qudt.org/schema/qudt/>
                                PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                                SELECT $this
                                WHERE {
                                    $this nltl:contactGeometryClassification nltl:nonHemisphericalContactGeometry .
                                    FILTER NOT EXISTS {
                                        ?ship nltl:hasThrusterIceImpactLoadCase $this .
                                        ?ship nltl:equivalentImpactSphereRadius ?radius .
                                        ?radius qudt:numericValue ?value .
                                        ?radius qudt:unit <http://qudt.org/vocab/unit/M> .
                                        FILTER (datatype(?value) = xsd:decimal)
                                    }
                                }
                            """ ] ] ) ;
                            sh:path nltl:contactGeometryClassification ] ;
                    sh:value nltl:nonHemisphericalContactGeometry ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:class nltl:thrusterIceImpactLoadCase ; sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal("Each impact case must provide evidence for the loaded impact area.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:thrusterIceImpactLoadedAreaEvidence ], [ sh:class nltl:thrusterBody ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterResistanceCapacity ] ] ; sh:path nltl:thrusterImpactCaseAppliesToBody ], [ sh:hasValue nltl:traficomTable6Dash16Reference ; sh:message Literal("Each impact case must reference TRAFICOM Table 6-16 for its impact load case.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:impactLoadCaseTableReference ], [ sh:hasValue nltl:traficomTable6Dash3Reference ; sh:message Literal("Each impact case must reference TRAFICOM Table 6-3 for the design ice block.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:designIceBlockTableReference ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterIceImpactDemand ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterIceImpactLoad ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:or ( [ sh:hasValue nltl:hemisphericalContactGeometry ; sh:path nltl:contactGeometryClassification ] [ sh:hasValue nltl:nonHemisphericalContactGeometry ; sh:path nltl:contactGeometryClassification ; sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal("Non-hemispherical geometry requires correspondence evidence.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:contactGeometryCorrespondenceEvidence ] ; sh:sparql [ sh:message Literal("Non-hemispherical geometry requires a valid equivalent impact sphere radius on the ship.") ; sh:select Literal("
                                PREFIX nltl: <https://w3id.org/nltl/vocab#>
                                PREFIX qudt: <http://qudt.org/schema/qudt/>
                                PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                                SELECT $this
                                WHERE {
                                    $this nltl:contactGeometryClassification nltl:nonHemisphericalContactGeometry .
                                    FILTER NOT EXISTS {
                                        ?ship nltl:hasThrusterIceImpactLoadCase $this .
                                        ?ship nltl:equivalentImpactSphereRadius ?radius .
                                        ?radius qudt:numericValue ?value .
                                        ?radius qudt:unit <http://qudt.org/vocab/unit/M> .
                                        FILTER (datatype(?value) = xsd:decimal)
                                    }
                                }
                            ") ] ] ) ; sh:path nltl:contactGeometryClassification ] ; sh:sparql [ sh:message Literal("Thruster resistance capacity must be greater than or equal to the linked impact demand.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    SELECT $this
                    WHERE {
                        $this nltl:thrusterIceImpactDemand ?demandQuantity .
                        ?demandQuantity qudt:numericValue ?demandValue .
                        ?demandQuantity qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        $this nltl:thrusterImpactCaseAppliesToBody ?body .
                        ?body nltl:thrusterResistanceCapacity ?capacityQuantity .
                        ?capacityQuantity qudt:numericValue ?capacityValue .
                        ?capacityQuantity qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        FILTER (?capacityValue < ?demandValue)
                    }
                ") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasThrusterIceImpactLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:thrusterIceImpactLoadCase ;
                            sh:property [ sh:class nltl:thrusterBody ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:thrusterResistanceCapacity ] ] ;
                                    sh:path nltl:thrusterImpactCaseAppliesToBody ],
                                [ sh:minCount 1 ;
                                    sh:or ( [ sh:hasValue nltl:hemisphericalContactGeometry ;
                                                sh:path nltl:contactGeometryClassification ] [ sh:hasValue nltl:nonHemisphericalContactGeometry ;
                                                sh:path nltl:contactGeometryClassification ;
                                                sh:property [ ] ;
                                                sh:sparql [ ] ] ) ;
                                    sh:path nltl:contactGeometryClassification ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thrusterIceImpactDemand ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thrusterIceImpactLoad ],
                                [ sh:hasValue nltl:traficomTable6Dash16Reference ;
                                    sh:message "Each impact case must reference TRAFICOM Table 6-16 for its impact load case." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:impactLoadCaseTableReference ],
                                [ sh:class nltl:evidenceArtifact ;
                                    sh:message "Each impact case must provide evidence for the loaded impact area." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:thrusterIceImpactLoadedAreaEvidence ],
                                [ sh:hasValue nltl:traficomTable6Dash3Reference ;
                                    sh:message "Each impact case must reference TRAFICOM Table 6-3 for the design ice block." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:designIceBlockTableReference ] ;
                            sh:sparql [ sh:message "Thruster resistance capacity must be greater than or equal to the linked impact demand." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    SELECT $this
                    WHERE {
                        $this nltl:thrusterIceImpactDemand ?demandQuantity .
                        ?demandQuantity qudt:numericValue ?demandValue .
                        ?demandQuantity qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        $this nltl:thrusterImpactCaseAppliesToBody ?body .
                        ?body nltl:thrusterResistanceCapacity ?capacityQuantity .
                        ?capacityQuantity qudt:numericValue ?capacityValue .
                        ?capacityQuantity qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        FILTER (?capacityValue < ?demandValue)
                    }
                """ ] ] ;
                    sh:path nltl:hasThrusterIceImpactLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/impact> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/ship> ;
            sh:resultMessage "The ship must provide a typical ice operating speed in knots." ;
            sh:resultPath nltl:iceOperatingSpeed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a typical ice operating speed in knots." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/KN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:iceOperatingSpeed ] ] .

