@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F03/loadCase> ;
                    sh:resultMessage "The occasional-force analysis case must provide the externally calculated component yield safety factor." ;
                    sh:resultPath nltl:componentYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class qudt:QuantityValue ;
                            sh:maxCount 1 ;
                            sh:message "The occasional-force analysis case must provide the externally calculated component yield safety factor." ;
                            sh:minCount 1 ;
                            sh:node gs:TRF123SafetyFactorQuantityShape ;
                            sh:path nltl:componentYieldSafetyFactor ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F03/component> ;
                            sh:resultMessage "Each assessed component must provide its externally calculated occasional-force stress." ;
                            sh:resultPath nltl:occasionalForceComponentStress ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:class qudt:QuantityValue ;
                                    sh:maxCount 1 ;
                                    sh:message "Each assessed component must provide its externally calculated occasional-force stress." ;
                                    sh:minCount 1 ;
                                    sh:node gs:TRF123StressQuantityShape ;
                                    sh:path nltl:occasionalForceComponentStress ] ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F03/component> ;
                            sh:resultMessage "Each assessed component must identify its material properties." ;
                            sh:resultPath nltl:hasMaterialProperties ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:class nltl:materialProperties ;
                                    sh:message "Each assessed component must identify its material properties." ;
                                    sh:minCount 1 ;
                                    sh:node gs:TRF123MaterialPropertiesShape ;
                                    sh:path nltl:hasMaterialProperties ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F03/loadCase> ;
                    sh:resultMessage "The occasional-force analysis case must identify each assessed component." ;
                    sh:resultPath nltl:occasionalForceCaseAssessedComponent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:shipComponent ;
                            sh:message "The occasional-force analysis case must identify each assessed component." ;
                            sh:minCount 1 ;
                            sh:node gs:TRF123AssessedComponentShape ;
                            sh:path nltl:occasionalForceCaseAssessedComponent ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F03/component> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F03/ship> ;
            sh:resultMessage "The ship must provide an occasional-force load case for the required analysis." ;
            sh:resultPath nltl:hasOccasionalForceLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:occasionalForceLoadCase ;
                    sh:message "The ship must provide an occasional-force load case for the required analysis." ;
                    sh:minCount 1 ;
                    sh:node gs:TRF123OccasionalForceLoadCaseShape ;
                    sh:path nltl:hasOccasionalForceLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F03/loadCase> ] .

