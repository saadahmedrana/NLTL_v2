@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F01/ship> ;
            sh:resultMessage "When air receivers serve an additional purpose, their capacity must be at least the capacity required for that purpose." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When air receivers serve an additional purpose, their capacity must be at least the capacity required for that purpose." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this nltl:airReceiverServesAdditionalPurpose true .
                ?this nltl:airReceiverCapacity ?capacityNode .
                ?capacityNode qudt:numericValue ?capacityValue .
                ?this nltl:additionalPurposeRequiredAirCapacity ?requiredNode .
                ?requiredNode qudt:numericValue ?requiredValue .
                FILTER (
                    ?capacityValue < ?requiredValue
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_127_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F01/ship> ] .

