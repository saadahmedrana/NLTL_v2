@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:airReceiverServesAdditionalPurpose ] ] , [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:airReceiverServesAdditionalPurpose ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("When the air receivers serve an additional purpose, air receiver capacity is required with a numeric value in cubic metres.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M3 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:airReceiverCapacity ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("When the air receivers serve an additional purpose, the required additional air capacity is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:additionalPurposeRequiredAirCapacity ] ; sh:sparql [ sh:message Literal("Air receiver capacity must be at least the additional-purpose required air capacity when the air receivers serve an additional purpose.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:airReceiverServesAdditionalPurpose true ;
                              nltl:airReceiverCapacity ?capacity ;
                              nltl:additionalPurposeRequiredAirCapacity ?required .
                        ?capacity qudt:numericValue ?capacityValue .
                        ?required qudt:numericValue ?requiredValue .
                        FILTER (
                            datatype(?capacityValue) = xsd:decimal &&
                            datatype(?requiredValue) = xsd:decimal &&
                            ?capacityValue < ?requiredValue
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF127Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F02/ship> ;
            sh:resultMessage "The air-receiver additional-purpose applicability selector is required." ;
            sh:resultPath nltl:airReceiverServesAdditionalPurpose ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The air-receiver additional-purpose applicability selector is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:airReceiverServesAdditionalPurpose ] ] .

