@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/chest1> ;
            sh:resultMessage "Less than 1 values on ex:chest1->nltl:seaInletLocation" ;
            sh:resultPath nltl:seaInletLocation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n4956f5bed7cc4f57bf91eeae6cf31b62b10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:StandardArrangementBranch , gen:AlternativeArrangementBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F04/chest1> ;
            sh:resultMessage "Node ex:chest1->nltl:seaInletLocation does not contain a value in the set: ['Literal(\"near centreline and well aft if possible\")']" ;
            sh:resultPath nltl:seaInletLocation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n4956f5bed7cc4f57bf91eeae6cf31b62b10 ] .

_:n4956f5bed7cc4f57bf91eeae6cf31b62b10 sh:datatype xsd:string ;
    sh:hasValue "near centreline and well aft if possible" ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:seaInletLocation .

