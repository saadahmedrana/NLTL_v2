@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ], [ sh:path nltl:hasComponent ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:class nltl:inletChest ; sh:node <urn:nltl:generated-shape:TRF-130-standard-chest> ] ] ] , [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestAlternativeArrangementUsed ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ], [ sh:path nltl:hasComponent ; sh:qualifiedMinCount Literal(\"2\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:class nltl:inletChest ; sh:node <urn:nltl:generated-shape:TRF-130-alternating-chest> ] ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-130> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:totalRelevantEnginePower" ;
            sh:resultPath nltl:totalRelevantEnginePower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:totalRelevantEnginePower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:maximumContinuousRatingPower" ;
            sh:resultPath nltl:maximumContinuousRatingPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:maximumContinuousRatingPower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F03/ship> ;
            sh:resultMessage "Node ex:chest1 must conform to one or more shapes in [ rdf:type sh:NodeShape ; sh:property [ sh:path nltl:hasComponent ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:class nltl:inletChest ; sh:node <urn:nltl:generated-shape:TRF-130-standard-chest> ] ] ] , [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestAlternativeArrangementUsed ], [ sh:path nltl:hasComponent ; sh:qualifiedMinCount Literal(\"2\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:class nltl:inletChest ; sh:node <urn:nltl:generated-shape:TRF-130-alternating-chest> ] ] ]" ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:or ( [ a sh:NodeShape ;
                                sh:property [ sh:path nltl:hasComponent ;
                                        sh:qualifiedMinCount 1 ;
                                        sh:qualifiedValueShape [ sh:class nltl:inletChest ;
                                                sh:node <urn:nltl:generated-shape:TRF-130-standard-chest> ] ] ] [ a sh:NodeShape ;
                                sh:property [ sh:path nltl:hasComponent ;
                                        sh:qualifiedMinCount 2 ;
                                        sh:qualifiedValueShape [ sh:class nltl:inletChest ;
                                                sh:node <urn:nltl:generated-shape:TRF-130-alternating-chest> ] ],
                                    [ sh:datatype xsd:boolean ;
                                        sh:hasValue true ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:path nltl:coolingWaterChestAlternativeArrangementUsed ] ] ) ;
                    sh:path nltl:hasComponent ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F03/chest1> ] .

