@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F10/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:totalRelevantEnginePower" ;
            sh:resultPath nltl:totalRelevantEnginePower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:totalRelevantEnginePower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F10/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:maximumContinuousRatingPower" ;
            sh:resultPath nltl:maximumContinuousRatingPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:maximumContinuousRatingPower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F10/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet" ;
            sh:resultPath nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F10/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ], [ sh:message Literal(\"At least one inlet chest shall satisfy the standard cooling-water inlet-chest requirements.\") ; sh:path nltl:hasComponent ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:node <urn:nltl:generated-shape:TRF-130-StandardChest> ] ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestAlternativeArrangementUsed ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ], [ sh:message Literal(\"When the standard volume and height requirements cannot be met, at least two alternating inlet chests shall be provided.\") ; sh:path nltl:hasComponent ; sh:qualifiedMinCount Literal(\"2\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:node <urn:nltl:generated-shape:TRF-130-AlternativeChest> ] ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-130-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F10/ship> ] .

