@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-131-P01/ship> ;
            sh:resultMessage "A ballast-water cooling arrangement must not be accepted as a substitute for an inlet chest." ;
            sh:resultPath nltl:substituteArrangementStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n9ad3a6a930f14d27bc363ab674854978b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-131-P01/ship> ;
            sh:resultMessage "A ballast-water cooling arrangement must not be accepted as a substitute for an inlet chest." ;
            sh:resultPath nltl:substituteArrangementStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n9ad3a6a930f14d27bc363ab674854978b1 ] .

_:n9ad3a6a930f14d27bc363ab674854978b1 sh:datatype xsd:boolean ;
    sh:hasValue false ;
    sh:maxCount 1 ;
    sh:message "A ballast-water cooling arrangement must not be accepted as a substitute for an inlet chest." ;
    sh:minCount 1 ;
    sh:path nltl:substituteArrangementStatus .

