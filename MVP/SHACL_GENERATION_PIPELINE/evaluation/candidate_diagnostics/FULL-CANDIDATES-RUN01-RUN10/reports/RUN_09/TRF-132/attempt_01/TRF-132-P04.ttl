@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-P04/ship> ;
            sh:resultMessage "Maximum continuous rating power must be at least f1*f2*f3*(f4*Delta + P0), and at least 740 kW for ice classes IB and IC." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Maximum continuous rating power must be at least f1*f2*f3*(f4*Delta + P0), and at least 740 kW for ice classes IB and IC." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:engineOutputFormulaBasePowerP0 ?p0Node ;
                      nltl:engineOutputFormulaDisplacement ?deltaNode ;
                      nltl:engineOutputFormulaFactorF1 ?f1Node ;
                      nltl:engineOutputFormulaFactorF2 ?f2Node ;
                      nltl:engineOutputFormulaFactorF3 ?f3Node ;
                      nltl:engineOutputFormulaFactorF4 ?f4Node ;
                      nltl:maximumContinuousRatingPower ?powerNode .

                ?p0Node qudt:numericValue ?p0 .
                ?deltaNode qudt:numericValue ?delta .
                ?f1Node qudt:numericValue ?f1 .
                ?f2Node qudt:numericValue ?f2 .
                ?f3Node qudt:numericValue ?f3 .
                ?f4Node qudt:numericValue ?f4 .
                ?powerNode qudt:numericValue ?power .

                FILTER (
                    ?power < (?f1 * ?f2 * ?f3 * ((?f4 * ?delta) + ?p0))
                    ||
                    (
                        ?iceClass IN (
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                        && ?power < 740
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-132-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-P04/ship> ] .

