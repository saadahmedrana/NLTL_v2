@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F01/ship> ;
            sh:resultMessage "For ice classes IB and IC, maximum continuous rating power must be at least 740 kW and must not be below the declared formula result." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For ice classes IB and IC, maximum continuous rating power must be at least 740 kW and must not be below the declared formula result." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:engineOutputFormulaBasePowerP0 ?p0Node ;
                      nltl:engineOutputFormulaDisplacement ?deltaNode ;
                      nltl:engineOutputFormulaFactorF1 ?f1Node ;
                      nltl:engineOutputFormulaFactorF2 ?f2Node ;
                      nltl:engineOutputFormulaFactorF3 ?f3Node ;
                      nltl:engineOutputFormulaFactorF4 ?f4Node ;
                      nltl:maximumContinuousRatingPower ?reportedNode .

                FILTER (?ice IN (nltl:iceClassIb, nltl:iceClassIc))

                ?p0Node qudt:numericValue ?p0 .
                ?deltaNode qudt:numericValue ?delta .
                ?f1Node qudt:numericValue ?f1 .
                ?f2Node qudt:numericValue ?f2 .
                ?f3Node qudt:numericValue ?f3 .
                ?f4Node qudt:numericValue ?f4 .
                ?reportedNode qudt:numericValue ?reported .

                BIND (?f1 * ?f2 * ?f3 * (?f4 * ?delta + ?p0) AS ?expected)
                BIND (IF (?expected >= 0, ?expected, -?expected) AS ?absoluteExpected)
                BIND (IF (?absoluteExpected * 0.000001 >= 0.000001,
                          ?absoluteExpected * 0.000001,
                          0.000001) AS ?tolerance)

                FILTER (
                    ?reported < 740 ||
                    ?reported + ?tolerance < ?expected
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-132-EngineOutput> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F01/ship> ] .

