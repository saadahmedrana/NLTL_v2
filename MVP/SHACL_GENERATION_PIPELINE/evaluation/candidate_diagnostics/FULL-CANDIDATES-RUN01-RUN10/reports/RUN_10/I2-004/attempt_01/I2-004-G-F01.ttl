@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The upper ice waterline displacement must equal the greatest displacement among the linked upper ice waterline cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The upper ice waterline displacement must equal the greatest displacement among the linked upper ice waterline cases." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:upperIceWaterlineDisplacement ?displacementQuantity .
    ?displacementQuantity qudt:numericValue ?displacementValue .
    {
        SELECT (MAX(?caseValue) AS ?greatestCaseValue)
        WHERE {
            $this nltl:hasUpperIceWaterlineCase ?case .
            ?case nltl:waterlineCaseDisplacement ?caseQuantity .
            ?caseQuantity qudt:numericValue ?caseValue .
        }
    }
    FILTER (?displacementValue != ?greatestCaseValue)
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:I2_004_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

