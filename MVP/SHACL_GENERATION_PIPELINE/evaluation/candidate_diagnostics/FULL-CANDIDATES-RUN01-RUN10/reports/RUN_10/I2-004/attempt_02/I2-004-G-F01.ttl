@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:path nltl:hasUpperIceWaterlineCase ] ] , [ sh:property [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasUpperIceWaterlineCase ], [ sh:node [ sh:class nltl:upperIceWaterlineCase ; sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloTON_Metric ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:waterlineCaseDisplacement ] ] ; sh:path nltl:hasUpperIceWaterlineCase ] ; sh:sparql [ sh:message Literal("DUI must equal the greatest upper-ice-waterline case displacement within a relative tolerance of 1e-6, with an absolute tolerance of 1e-6 near zero.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this ?dui
                    WHERE {
                        $this nltl:upperIceWaterlineDisplacement ?duiNode .
                        ?duiNode qudt:numericValue ?dui ;
                                 qudt:unit unit:KiloTON_Metric .
                        $this nltl:hasUpperIceWaterlineCase ?case .
                        ?case nltl:waterlineCaseDisplacement ?caseQuantity .
                        ?caseQuantity qudt:numericValue ?v ;
                                      qudt:unit unit:KiloTON_Metric .
                    }
                    GROUP BY $this ?dui
                    HAVING (
                        ?dui < (
                            MAX(?v) -
                            IF(
                                IF(MAX(?v) < 0, -MAX(?v), MAX(?v)) > 1,
                                IF(MAX(?v) < 0, -MAX(?v), MAX(?v)) * 0.000001,
                                0.000001
                            )
                        )
                        ||
                        ?dui > (
                            MAX(?v) +
                            IF(
                                IF(MAX(?v) < 0, -MAX(?v), MAX(?v)) > 1,
                                IF(MAX(?v) < 0, -MAX(?v), MAX(?v)) * 0.000001,
                                0.000001
                            )
                        )
                    )
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_004_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The ship must identify the upper ice waterline (UIWL)." ;
            sh:resultPath nltl:upperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship must identify the upper ice waterline (UIWL)." ;
                    sh:minCount 1 ;
                    sh:path nltl:upperIceWaterline ] ] .

