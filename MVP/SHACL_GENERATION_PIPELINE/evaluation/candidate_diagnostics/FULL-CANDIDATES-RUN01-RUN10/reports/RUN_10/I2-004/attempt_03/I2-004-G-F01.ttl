@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "When upper ice waterline cases are supplied, DUI must equal the greatest case displacement within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9, scaled from the expected greatest case displacement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When upper ice waterline cases are supplied, DUI must equal the greatest case displacement within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9, scaled from the expected greatest case displacement." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?duiQuantity .
                ?duiQuantity qudt:numericValue ?duiValue .

                $this nltl:hasUpperIceWaterlineCase ?case .
                ?case nltl:waterlineCaseDisplacement ?caseQuantity .
                ?caseQuantity qudt:numericValue ?caseValue .

                FILTER NOT EXISTS {
                    $this nltl:hasUpperIceWaterlineCase ?higherCase .
                    ?higherCase nltl:waterlineCaseDisplacement ?higherQuantity .
                    ?higherQuantity qudt:numericValue ?higherValue .
                    FILTER (?higherValue > ?caseValue)
                }

                FILTER (
                    ABS(?duiValue - ?caseValue) >
                    (ABS(?caseValue) * "0.000001"^^xsd:decimal +
                     "0.000000001"^^xsd:decimal)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_004_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The ship must identify the upper ice waterline (UIWL)." ;
            sh:resultPath nltl:upperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship must identify the upper ice waterline (UIWL)." ;
                    sh:minCount 1 ;
                    sh:path nltl:upperIceWaterline ] ] .

