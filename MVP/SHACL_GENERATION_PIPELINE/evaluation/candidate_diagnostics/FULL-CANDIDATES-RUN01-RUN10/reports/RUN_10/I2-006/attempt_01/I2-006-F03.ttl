@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"A ship not intended to operate astern in ice regions must record asternIceOperationIntent as false.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:asternIceOperationIntent ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"A ship intended to operate astern in ice regions must record asternIceOperationIntent as true.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:asternIceOperationIntent ], [ sh:datatype xsd:string ; sh:message Literal(\"A ship intended to operate astern in ice regions must record the aft section design basis.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:aftSectionDesignBasis ], [ sh:datatype xsd:string ; sh:message Literal(\"A ship intended to operate astern in ice regions must record the hull area requirement set used for the aft section.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hullAreaRequirementSet ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_006_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F03/ship> ] .

