@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F03/ship> ;
            sh:resultMessage "When astern ice operation is intended, the aft section design basis must be Bow and Bow Intermediate." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When astern ice operation is intended, the aft section design basis must be Bow and Bow Intermediate." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:asternIceOperationIntent true .
                FILTER NOT EXISTS {
                    $this nltl:aftSectionDesignBasis "Bow and Bow Intermediate"^^xsd:string .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-006> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F03/ship> ] .

