@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "Line load is required as an externally established calculation input." ;
            sh:resultPath nltl:lineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Line load is required as an externally established calculation input." ;
                    sh:minCount 1 ;
                    sh:node g:LineLoadQuantityShape ;
                    sh:path nltl:lineLoad ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/polarClass> ;
                    sh:resultMessage "Value ex:polarClass not in list ['nltl:polarClassPc3', 'nltl:polarClassPc2', 'nltl:polarClassPc5', 'nltl:polarClassPc4', 'nltl:polarClassPc6', 'nltl:polarClassPc7', 'nltl:polarClassPc1']" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:polarClassValue ;
                            sh:in ( nltl:polarClassPc1 nltl:polarClassPc2 nltl:polarClassPc3 nltl:polarClassPc4 nltl:polarClassPc5 nltl:polarClassPc6 nltl:polarClassPc7 ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/polarClass> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "A ship shall specify a permitted Polar Class value." ;
            sh:resultPath nltl:polarClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A ship shall specify a permitted Polar Class value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:polarClassValue ;
                            sh:in ( nltl:polarClassPc1 nltl:polarClassPc2 nltl:polarClassPc3 nltl:polarClassPc4 nltl:polarClassPc5 nltl:polarClassPc6 nltl:polarClassPc7 ) ] ;
                    sh:path nltl:polarClass ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/polarClass> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "The externally computed total glancing impact force is required." ;
            sh:resultPath nltl:totalGlancingImpactForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The externally computed total glancing impact force is required." ;
                    sh:minCount 1 ;
                    sh:node g:ForceQuantityShape ;
                    sh:path nltl:totalGlancingImpactForce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:shapeCoefficient" ;
            sh:resultPath nltl:shapeCoefficient ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node g:DimensionlessQuantityShape ;
                    sh:path nltl:shapeCoefficient ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchLength" ;
            sh:resultPath nltl:loadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node g:LengthQuantityShape ;
                    sh:path nltl:loadPatchLength ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/bowCase> ;
                    sh:resultMessage "Less than 1 values on ex:bowCase->nltl:bowShapeCoefficient" ;
                    sh:resultPath nltl:bowShapeCoefficient ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node g:DimensionlessQuantityShape ;
                            sh:path nltl:bowShapeCoefficient ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:bowSubregionCalculationCase ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each bow subregion calculation case shall provide its externally computed glancing impact line load.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node g:GlancingLineLoadQuantityShape ; sh:path nltl:glancingImpactLineLoad ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each bow subregion calculation case shall provide its externally computed glancing impact pressure.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node g:PressureQuantityShape ; sh:path nltl:glancingImpactPressure ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node g:DimensionlessQuantityShape ; sh:path nltl:bowShapeCoefficient ] ]. See details for more information." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:bowSubregionCalculationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node g:DimensionlessQuantityShape ;
                                    sh:path nltl:bowShapeCoefficient ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each bow subregion calculation case shall provide its externally computed glancing impact line load." ;
                                    sh:minCount 1 ;
                                    sh:node g:GlancingLineLoadQuantityShape ;
                                    sh:path nltl:glancingImpactLineLoad ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each bow subregion calculation case shall provide its externally computed glancing impact pressure." ;
                                    sh:minCount 1 ;
                                    sh:node g:PressureQuantityShape ;
                                    sh:path nltl:glancingImpactPressure ] ] ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/bowCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "Average ice pressure is required as an externally established calculation input." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Average ice pressure is required as an externally established calculation input." ;
                    sh:minCount 1 ;
                    sh:node g:PressureQuantityShape ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:loadPatchHeight" ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node g:LengthQuantityShape ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:localIcePressure" ;
            sh:resultPath nltl:localIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node g:PressureQuantityShape ;
                    sh:path nltl:localIcePressure ] ] .

