@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "Average ice pressure is required for the other ice-strengthened area case." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Average ice pressure is required for the other ice-strengthened area case." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-PressureQuantityShape> ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "The non-bow load patch length is required for the other ice-strengthened area case." ;
            sh:resultPath nltl:nonBowLoadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The non-bow load patch length is required for the other ice-strengthened area case." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-LengthQuantityShape> ;
                    sh:path nltl:nonBowLoadPatchLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "The load patch aspect ratio shall be exactly 3.6." ;
            sh:resultPath nltl:loadPatchAspectRatio ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The load patch aspect ratio shall be exactly 3.6." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-AspectRatioQuantityShape> ;
                    sh:path nltl:loadPatchAspectRatio ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "The non-bow load patch height is required for the other ice-strengthened area case." ;
            sh:resultPath nltl:nonBowLoadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The non-bow load patch height is required for the other ice-strengthened area case." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-LengthQuantityShape> ;
                    sh:path nltl:nonBowLoadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/beta> ;
                    sh:resultMessage "Value is not > Literal(\"10\", datatype=xsd:integer)" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinExclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:minExclusive 10 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 10.0 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "The normal frame angle shall be greater than 10 degrees." ;
            sh:resultPath nltl:normalFrameAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The normal frame angle shall be greater than 10 degrees." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-NormalFrameAngleQuantityShape> ;
                    sh:path nltl:normalFrameAngle ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/beta> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F06/ship> ;
            sh:resultMessage "The ship shall provide a hull-area assignment for the other ice-strengthened area case." ;
            sh:resultPath nltl:hasHullAreaAssignment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide a hull-area assignment for the other ice-strengthened area case." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-009-HullAreaAssignmentShape> ;
                    sh:path nltl:hasHullAreaAssignment ] ] .

