@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/beta> ;
                    sh:resultMessage "Node ex:beta->qudt:unit does not contain a value in the set: ['qudt:DEG']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:DEG ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape nltl:I2_009_NormalFrameAngleQuantityShape. See details for more information." ;
            sh:resultPath nltl:normalFrameAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltl:I2_009_NormalFrameAngleQuantityShape ;
                    sh:path nltl:normalFrameAngle ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/beta> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/gamma> ;
                    sh:resultMessage "Node ex:gamma->qudt:unit does not contain a value in the set: ['qudt:DEG']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:DEG ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/gamma> ;
                    sh:resultMessage "For an applicable bow form, the buttock angle shall be greater than 0 degrees and less than 80 degrees." ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinExclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:maxExclusive 80 ;
                            sh:message "For an applicable bow form, the buttock angle shall be greater than 0 degrees and less than 80 degrees." ;
                            sh:minCount 1 ;
                            sh:minExclusive 0 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 0.0 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape nltl:I2_009_ButtockAngleQuantityShape. See details for more information." ;
            sh:resultPath nltl:buttockAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltl:I2_009_ButtockAngleQuantityShape ;
                    sh:path nltl:buttockAngle ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-F04/gamma> ] .

