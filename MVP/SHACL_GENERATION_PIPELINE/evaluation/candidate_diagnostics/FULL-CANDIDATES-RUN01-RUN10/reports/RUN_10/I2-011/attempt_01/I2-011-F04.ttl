@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F04/ship> ;
            sh:resultMessage "bowDesignForce must not be less than either applicable method force; method forces are in MN and bowDesignForce is in kN." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "bowDesignForce must not be less than either applicable method force; method forces are in MN and bowDesignForce is in kN." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bulbousBowPresent true ;
                      nltl:polarClass ?pc ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivNode ;
                      nltl:bowDesignForce ?resultNode .
                FILTER (?pc IN (
                    nltl:polarClassPc6,
                    nltl:polarClassPc7
                ))
                ?iiiNode qudt:numericValue ?iii ;
                          qudt:unit <http://qudt.org/vocab/unit/MegaN> .
                ?ivNode qudt:numericValue ?iv ;
                         qudt:unit <http://qudt.org/vocab/unit/MegaN> .
                ?resultNode qudt:numericValue ?result ;
                            qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                FILTER (
                    ?result < (?iii * 1000) ||
                    ?result < (?iv * 1000)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-011> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F04/ship> ] .

