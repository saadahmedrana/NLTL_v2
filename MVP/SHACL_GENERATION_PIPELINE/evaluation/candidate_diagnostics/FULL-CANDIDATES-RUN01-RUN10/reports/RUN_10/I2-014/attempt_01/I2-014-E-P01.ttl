@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-P01/ship> ;
            sh:resultMessage "Selected maximum bow force, line load, and pressure must equal the respective maxima across the four bow subregion cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Selected maximum bow force, line load, and pressure must equal the respective maxima across the four bow subregion cases." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce/qudt:numericValue ?selectedForce ;
                      nltl:selectedMaximumBowLineLoad/qudt:numericValue ?selectedLineLoad ;
                      nltl:selectedMaximumBowPressure/qudt:numericValue ?selectedPressure .

                $this nltl:hasBowSubregionCalculationCase ?forceCase .
                ?forceCase nltl:bowSubregionCalculatedForce/qudt:numericValue ?equalForce .
                FILTER (?selectedForce = ?equalForce)
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?greaterForceCase .
                    ?greaterForceCase nltl:bowSubregionCalculatedForce/qudt:numericValue ?greaterForce .
                    FILTER (?greaterForce > ?selectedForce)
                }

                $this nltl:hasBowSubregionCalculationCase ?lineCase .
                ?lineCase nltl:bowSubregionCalculatedLineLoad/qudt:numericValue ?equalLineLoad .
                FILTER (?selectedLineLoad = ?equalLineLoad)
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?greaterLineCase .
                    ?greaterLineCase nltl:bowSubregionCalculatedLineLoad/qudt:numericValue ?greaterLineLoad .
                    FILTER (?greaterLineLoad > ?selectedLineLoad)
                }

                $this nltl:hasBowSubregionCalculationCase ?pressureCase .
                ?pressureCase nltl:bowSubregionCalculatedPressure/qudt:numericValue ?equalPressure .
                FILTER (?selectedPressure = ?equalPressure)
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?greaterPressureCase .
                    ?greaterPressureCase nltl:bowSubregionCalculatedPressure/qudt:numericValue ?greaterPressure .
                    FILTER (?greaterPressure > ?selectedPressure)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_014_BowSubregionShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-P01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-P01/ship> ;
            sh:resultMessage "bowSubregionCount must be four." ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:maxInclusive 4 ;
                    sh:message "bowSubregionCount must be four." ;
                    sh:minCount 1 ;
                    sh:minInclusive 4 ;
                    sh:path nltl:bowSubregionCount ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-P01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowLength" ;
            sh:resultPath nltl:bowLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:bowLength ] ] .

