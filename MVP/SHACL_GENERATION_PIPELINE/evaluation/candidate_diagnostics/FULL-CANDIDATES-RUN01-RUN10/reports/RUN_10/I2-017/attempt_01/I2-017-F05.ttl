@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-017-F05/ship> ;
            sh:resultMessage "The ship must provide a table lookup case containing the required class factors." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a table lookup case containing the required class factors." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:tableLookupCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "The table lookup case must provide the load patch dimension class factor CFD." ;
                                    sh:minCount 1 ;
                                    sh:node gen:I2_017_DimensionlessQuantityShape ;
                                    sh:path nltl:loadPatchDimensionClassFactor ],
                                [ sh:maxCount 1 ;
                                    sh:message "The table lookup case must provide the crushing failure class factor CFC." ;
                                    sh:minCount 1 ;
                                    sh:node gen:I2_017_DimensionlessQuantityShape ;
                                    sh:path nltl:crushingFailureClassFactor ] ] ;
                    sh:path nltl:hasTableLookupCase ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-017-F05/nonBowCase> ;
                    sh:resultMessage "The non-bow ice load calculation case must contain the externally determined ship displacement factor DF." ;
                    sh:resultPath nltl:shipDisplacementFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The non-bow ice load calculation case must contain the externally determined ship displacement factor DF." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_017_DimensionlessQuantityShape ;
                            sh:path nltl:shipDisplacementFactor ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-017-F05/ship> ;
            sh:resultMessage "The ship must provide a non-bow ice load calculation case." ;
            sh:resultPath nltl:hasNonBowIceLoadCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a non-bow ice load calculation case." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:nonBowIceLoadCalculationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "The non-bow ice load calculation case must contain the externally determined ship displacement factor DF." ;
                                    sh:minCount 1 ;
                                    sh:node gen:I2_017_DimensionlessQuantityShape ;
                                    sh:path nltl:shipDisplacementFactor ],
                                [ sh:maxCount 1 ;
                                    sh:message "The non-bow ice load calculation case must contain the externally determined non-bow ice force F_NonBow." ;
                                    sh:minCount 1 ;
                                    sh:node gen:I2_017_ForceQuantityShape ;
                                    sh:path nltl:nonBowIceForce ],
                                [ sh:maxCount 1 ;
                                    sh:message "The non-bow ice load calculation case must contain the externally determined non-bow ice line load Q_NonBow." ;
                                    sh:minCount 1 ;
                                    sh:node gen:I2_017_LineLoadQuantityShape ;
                                    sh:path nltl:nonBowIceLineLoad ] ] ;
                    sh:path nltl:hasNonBowIceLoadCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-017-F05/nonBowCase> ] .

