@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/ship> ;
            sh:resultMessage "The ship must provide load patch length in metres." ;
            sh:resultPath nltl:loadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide load patch length in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:loadPatchLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/ship> ;
            sh:resultMessage "The ship must provide a dimensionless peak pressure factor." ;
            sh:resultPath nltl:peakPressureFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide a dimensionless peak pressure factor." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:peakPressureFactor ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/ship> ;
            sh:resultMessage "The ship must provide average ice pressure in megapascals." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide average ice pressure in megapascals." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:MegaPA ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/ship> ;
            sh:resultMessage "The ship must provide ice force in kilonewtons." ;
            sh:resultPath nltl:iceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide ice force in kilonewtons." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:KiloN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:iceForce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/ship> ;
            sh:resultMessage "The ship must provide load patch height in metres." ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide load patch height in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/lookup> ;
                    sh:resultMessage "The Table 3 lookup selection must have evidence." ;
                    sh:resultPath nltl:lookupSelectionEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:message "The Table 3 lookup selection must have evidence." ;
                            sh:minCount 1 ;
                            sh:path nltl:lookupSelectionEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/ship> ;
            sh:resultMessage "The ship must provide a Table 3 lookup case." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:tableLookupCase ;
                    sh:message "The ship must provide a Table 3 lookup case." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:class nltl:evidenceArtifact ;
                                    sh:message "The Table 3 lookup selection must have evidence." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:lookupSelectionEvidence ],
                                [ sh:hasValue nltl:iacsUrI2Table3 ;
                                    sh:maxCount 1 ;
                                    sh:message "The table lookup case must cite IACS UR I2 Table 3." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:tableReference ] ] ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F05/lookup> ] .

