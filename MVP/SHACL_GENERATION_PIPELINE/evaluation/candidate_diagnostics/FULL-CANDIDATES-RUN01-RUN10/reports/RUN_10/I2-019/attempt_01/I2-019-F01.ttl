@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F01/ship> ;
            sh:resultMessage "The selected hull area factor must equal the largest spanned hull area factor within a relative tolerance of 1e-6 and an absolute tolerance of 1e-12." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The selected hull area factor must equal the largest spanned hull area factor within a relative tolerance of 1e-6 and an absolute tolerance of 1e-12." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:selectedHullAreaFactor ?selectedNode .
                ?selectedNode <http://qudt.org/schema/qudt/numericValue> ?selected .
                ?member nltl:hasSpannedHullArea ?maxArea .
                ?maxArea nltl:hullAreaFactor ?maxFactorNode .
                ?maxFactorNode <http://qudt.org/schema/qudt/numericValue> ?maxFactor .

                FILTER NOT EXISTS {
                    ?member nltl:hasSpannedHullArea ?higherArea .
                    ?higherArea nltl:hullAreaFactor ?higherFactorNode .
                    ?higherFactorNode <http://qudt.org/schema/qudt/numericValue> ?higherFactor .
                    FILTER (
                        ?higherFactor >
                        (?maxFactor + (ABS(?maxFactor) * 0.000001) + 0.000000000001)
                    )
                }

                FILTER (
                    ABS(?selected - ?maxFactor) >
                    (ABS(?maxFactor) * 0.000001) + 0.000000000001
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:SelectedHullAreaFactorCalculationShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F01/ship> ] .

