@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/area2> ;
                            sh:resultMessage "Each spanned hull area must have exactly one dimensionless hull area factor." ;
                            sh:resultPath nltl:hullAreaFactor ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each spanned hull area must have exactly one dimensionless hull area factor." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:hullAreaFactor ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/member> ;
                    sh:resultMessage "A structural member subject to the spanning rule must identify at least one spanned hull area." ;
                    sh:resultPath nltl:hasSpannedHullArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "A structural member subject to the spanning rule must identify at least one spanned hull area." ;
                            sh:minCount 1 ;
                            sh:node gen:HullAreaValueShape ;
                            sh:path nltl:hasSpannedHullArea ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/area2> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/ship> ;
            sh:resultMessage "The selected hull area factor must equal the largest spanned hull area factor within a relative tolerance of 1e-6 and an absolute tolerance of 1e-12." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The selected hull area factor must equal the largest spanned hull area factor within a relative tolerance of 1e-6 and an absolute tolerance of 1e-12." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:selectedHullAreaFactor ?selectedNode .
                ?selectedNode <http://qudt.org/schema/qudt/numericValue> ?selected .
                ?member nltl:hasSpannedHullArea ?maxArea .
                ?maxArea nltl:hullAreaFactor ?maxFactorNode .
                ?maxFactorNode <http://qudt.org/schema/qudt/numericValue> ?maxFactor .

                FILTER NOT EXISTS {
                    ?member nltl:hasSpannedHullArea ?higherArea .
                    ?higherArea nltl:hullAreaFactor ?higherFactorNode .
                    ?higherFactorNode <http://qudt.org/schema/qudt/numericValue> ?higherFactor .
                    FILTER (
                        ?higherFactor >
                        (?maxFactor + (ABS(?maxFactor) * 0.000001) + 0.000000000001)
                    )
                }

                FILTER (
                    ABS(?selected - ?maxFactor) >
                    (ABS(?maxFactor) * 0.000001) + 0.000000000001
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:SelectedHullAreaFactorCalculationShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F04/ship> ] .

