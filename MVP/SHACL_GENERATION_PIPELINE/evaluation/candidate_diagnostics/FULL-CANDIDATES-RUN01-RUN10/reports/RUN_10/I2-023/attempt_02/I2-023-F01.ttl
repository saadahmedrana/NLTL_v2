@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F01/plating> ;
                    sh:resultMessage "Node ex:plating must conform to one or more shapes in nltl:I2_023_NonApplicablePlating , [ sh:and ( nltl:I2_023_ApplicableBase nltl:I2_023_BranchBGreaterEqualS ) ] , [ sh:and ( nltl:I2_023_ApplicableBase nltl:I2_023_BranchBLessThanS ) ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:or ( nltl:I2_023_NonApplicablePlating [ sh:and ( nltl:I2_023_ApplicableBase nltl:I2_023_BranchBGreaterEqualS ) ] [ sh:and ( nltl:I2_023_ApplicableBase nltl:I2_023_BranchBLessThanS ) ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F01/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:or ( nltl:I2_023_NonApplicablePlating [ sh:and ( nltl:I2_023_ApplicableBase nltl:I2_023_BranchBGreaterEqualS ) ] [ sh:and ( nltl:I2_023_ApplicableBase nltl:I2_023_BranchBLessThanS ) ] ) ]. See details for more information." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:or ( nltl:I2_023_NonApplicablePlating [ sh:and ( nltl:I2_023_ApplicableBase nltl:I2_023_BranchBGreaterEqualS ) ] [ sh:and ( nltl:I2_023_ApplicableBase nltl:I2_023_BranchBLessThanS ) ] ) ] ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F01/plating> ] .

