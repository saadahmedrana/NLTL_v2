@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/ship> ;
            sh:resultMessage "The ship shall provide the declared interpolation calculation inputs." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "The ship shall provide the declared interpolation calculation inputs." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-024-CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/case> ;
                    sh:resultMessage "The linear interpolation rule applies only when 20 degrees is less than the framing angle and the framing angle is less than 70 degrees." ;
                    sh:resultPath ( nltl:framingAngle qudt:numericValue ) ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinExclusiveConstraintComponent ;
                    sh:sourceShape [ sh:maxExclusive 70 ;
                            sh:message "The linear interpolation rule applies only when 20 degrees is less than the framing angle and the framing angle is less than 70 degrees." ;
                            sh:minExclusive 20 ;
                            sh:path ( nltl:framingAngle qudt:numericValue ) ] ;
                    sh:value 20.0 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/case> ;
                    sh:resultMessage "The oblique-plating case shall provide the externally calculated interpolated net plate thickness." ;
                    sh:resultPath nltl:interpolatedNetPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The oblique-plating case shall provide the externally calculated interpolated net plate thickness." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:interpolatedNetPlateThickness ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/case> ;
                    sh:resultMessage "The oblique-plating case shall provide a lower interpolation endpoint." ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:message "The oblique-plating case shall provide a lower interpolation endpoint." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-024-InterpolationPointShape> ;
                            sh:path nltl:interpolationLowerEndpoint ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/case> ;
                    sh:resultMessage "The oblique-plating case shall provide an upper interpolation endpoint." ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:message "The oblique-plating case shall provide an upper interpolation endpoint." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-024-InterpolationPointShape> ;
                            sh:path nltl:interpolationUpperEndpoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/ship> ;
            sh:resultMessage "The ship shall provide an oblique-plating interpolation case." ;
            sh:resultPath nltl:hasObliquePlatingInterpolationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:obliquePlatingInterpolationCase ;
                    sh:message "The ship shall provide an oblique-plating interpolation case." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-024-ObliqueCaseShape> ;
                    sh:path nltl:hasObliquePlatingInterpolationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/case> ] .

