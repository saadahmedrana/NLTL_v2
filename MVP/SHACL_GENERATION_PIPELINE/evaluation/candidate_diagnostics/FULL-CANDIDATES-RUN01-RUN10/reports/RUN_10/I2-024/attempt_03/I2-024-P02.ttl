@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/ship> ;
            sh:resultMessage "The ship shall link the calculation case used for the interpolation readiness record." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "The ship shall link the calculation case used for the interpolation readiness record." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/ship> ;
            sh:resultMessage "The oblique plating interpolation case shall be the calculation case linked by the ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The oblique plating interpolation case shall be the calculation case linked by the ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasObliquePlatingInterpolationCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?case .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:I2_024_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/ship> ] .

