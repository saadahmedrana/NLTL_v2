@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/case> ;
                    sh:resultMessage "The framing angle for an oblique plating interpolation case shall satisfy 20 degrees < framing angle < 70 degrees." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "The framing angle for an oblique plating interpolation case shall satisfy 20 degrees < framing angle < 70 degrees." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:framingAngle ?angle .
                ?angle qudt:numericValue ?value .
                FILTER (?value <= 20 || ?value >= 70)
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gs:I2_024_ObliqueCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/case> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/case> ;
                    sh:resultMessage "The transverse framing net plate thickness operand shall be provided once in millimetres." ;
                    sh:resultPath nltl:transverseFramingNetPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The transverse framing net plate thickness operand shall be provided once in millimetres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:transverseFramingNetPlateThickness ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/case> ;
                    sh:resultMessage "The longitudinal framing net plate thickness operand shall be provided once in millimetres." ;
                    sh:resultPath nltl:longitudinalFramingNetPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The longitudinal framing net plate thickness operand shall be provided once in millimetres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:longitudinalFramingNetPlateThickness ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/case> ;
                    sh:resultMessage "The interpolation case shall provide one upper interpolation endpoint." ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:maxCount 1 ;
                            sh:message "The interpolation case shall provide one upper interpolation endpoint." ;
                            sh:minCount 1 ;
                            sh:node gs:I2_024_InterpolationPointShape ;
                            sh:path nltl:interpolationUpperEndpoint ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/case> ;
                    sh:resultMessage "The interpolation case shall provide one lower interpolation endpoint." ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:maxCount 1 ;
                            sh:message "The interpolation case shall provide one lower interpolation endpoint." ;
                            sh:minCount 1 ;
                            sh:node gs:I2_024_InterpolationPointShape ;
                            sh:path nltl:interpolationLowerEndpoint ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/case> ;
                    sh:resultMessage "The externally calculated interpolated net plate thickness shall be provided once in millimetres." ;
                    sh:resultPath nltl:interpolatedNetPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The externally calculated interpolated net plate thickness shall be provided once in millimetres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:interpolatedNetPlateThickness ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/ship> ;
            sh:resultMessage "Each ship shall link an oblique plating interpolation case for this requirement." ;
            sh:resultPath nltl:hasObliquePlatingInterpolationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:obliquePlatingInterpolationCase ;
                    sh:message "Each ship shall link an oblique plating interpolation case for this requirement." ;
                    sh:minCount 1 ;
                    sh:node gs:I2_024_ObliqueCaseShape ;
                    sh:path nltl:hasObliquePlatingInterpolationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/ship> ;
            sh:resultMessage "The ship shall link the calculation case used for the interpolation readiness record." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "The ship shall link the calculation case used for the interpolation readiness record." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/ship> ;
            sh:resultMessage "The oblique plating interpolation case shall be the calculation case linked by the ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The oblique plating interpolation case shall be the calculation case linked by the ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasObliquePlatingInterpolationCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?case .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:I2_024_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P03/ship> ] .

