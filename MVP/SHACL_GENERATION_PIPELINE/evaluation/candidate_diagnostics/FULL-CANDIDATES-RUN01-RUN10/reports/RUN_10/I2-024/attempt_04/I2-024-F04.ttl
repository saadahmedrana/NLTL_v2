@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:hasObliquePlatingInterpolationCase ] ] , [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:CalculationCaseShape ; sh:path nltl:hasCalculationCase ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:ObliquePlatingInterpolationCaseShape ; sh:path nltl:hasObliquePlatingInterpolationCase ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_024_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F04/ship> ] .

