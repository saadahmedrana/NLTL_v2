@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F01/member> ;
                    sh:resultMessage "The structural member must select either fixed support or simple support." ;
                    sh:resultPath nltl:frameSupportCondition ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:fixedFrameSupport nltl:simpleFrameSupport ) ;
                            sh:maxCount 1 ;
                            sh:message "The structural member must select either fixed support or simple support." ;
                            sh:minCount 1 ;
                            sh:path nltl:frameSupportCondition ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F01/member> ;
                    sh:resultMessage "Node ex:member must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:fixedFrameSupport ; sh:path nltl:frameSupportCondition ] ] , [ sh:property [ sh:hasValue nltl:simpleFrameSupport ; sh:path nltl:frameSupportCondition ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:I2_026_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F01/ship> ;
            sh:resultMessage "Each represented structural member must provide the support information needed to determine support fixity." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each represented structural member must provide the support information needed to determine support fixity." ;
                    sh:node gen:I2_026_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F01/member> ] .

