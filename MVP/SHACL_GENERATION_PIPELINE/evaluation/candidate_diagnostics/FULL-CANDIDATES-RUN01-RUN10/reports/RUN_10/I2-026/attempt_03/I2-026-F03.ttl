@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ;
                    sh:resultMessage "Support fixity must be fixed when termination, continuity, a connection bracket, or demonstrated rotational restraint with evidence applies; otherwise it must be simple, and evidence cannot be present without demonstrated restraint." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Support fixity must be fixed when termination, continuity, a connection bracket, or demonstrated rotational restraint with evidence applies; otherwise it must be simple, and evidence cannot be present without demonstrated restraint." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasMemberSupport ?support .
                ?support nltl:frameSupportCondition ?condition .
                FILTER (
                    (
                        ?condition = nltl:fixedFrameSupport
                        &&
                        !(
                            EXISTS {
                                $this nltl:terminatesWithinIceStrengthenedArea true
                            }
                            ||
                            EXISTS {
                                $this nltl:continuousThroughSupport true
                            }
                            ||
                            EXISTS {
                                ?support nltl:connectionBracketPresent true
                            }
                            ||
                            (
                                EXISTS {
                                    ?support nltl:demonstratedRotationalRestraint true
                                }
                                &&
                                EXISTS {
                                    $this nltl:significantRotationalRestraintEvidence ?evidence
                                }
                            )
                        )
                    )
                    ||
                    (
                        ?condition = nltl:simpleFrameSupport
                        &&
                        (
                            EXISTS {
                                $this nltl:terminatesWithinIceStrengthenedArea true
                            }
                            ||
                            EXISTS {
                                $this nltl:continuousThroughSupport true
                            }
                            ||
                            EXISTS {
                                ?support nltl:connectionBracketPresent true
                            }
                            ||
                            EXISTS {
                                $this nltl:significantRotationalRestraintEvidence ?evidence
                            }
                            ||
                            EXISTS {
                                ?support nltl:demonstratedRotationalRestraint true
                            }
                        )
                    )
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_026_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_026_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:I2_026_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ] .

