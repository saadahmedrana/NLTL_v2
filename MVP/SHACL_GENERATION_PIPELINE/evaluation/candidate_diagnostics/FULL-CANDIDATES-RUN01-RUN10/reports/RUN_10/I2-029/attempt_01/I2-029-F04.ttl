@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F04/case> ;
                    sh:resultMessage "Each calculation case shall explicitly represent whether flange material is included in the shear area." ;
                    sh:resultPath nltl:flangeMaterialIncludedInShearArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:message "Each calculation case shall explicitly represent whether flange material is included in the shear area." ;
                            sh:minCount 1 ;
                            sh:path nltl:flangeMaterialIncludedInShearArea ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F04/case> ;
                    sh:resultMessage "Node ex:case must conform to one or more shapes in gs:FlangeMaterialExcludedShape , gs:FlangeMaterialIncludedShape" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gs:CalculationCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F04/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gs:CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F04/case> ] .

