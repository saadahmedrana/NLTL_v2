], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:interpolationPointResult ] ] ; sh:path nltl:interpolationUpperEndpoint ] ; sh:sparql [ sh:message Literal("The oblique-interpolation readiness branch requires a local-frame area greater than the attached plate-flange area and a framing angle strictly between 20 and 70 degrees.") ; sh:select Literal("
