@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F04/member> ;
            sh:resultMessage "Less than 1 values on ex:member->nltl:netEffectivePlasticSectionModulus" ;
            sh:resultPath nltl:netEffectivePlasticSectionModulus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-030-SectionModulusQuantityShape> ;
                    sh:path nltl:netEffectivePlasticSectionModulus ] ] .

