@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/member> ;
            sh:resultMessage "Less than 1 values on ex:member->nltl:netAttachedShellPlateThickness" ;
            sh:resultPath nltl:netAttachedShellPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:I2_030_MillimetreQuantityShape ;
                    sh:path nltl:netAttachedShellPlateThickness ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/calc> ;
                    sh:resultMessage "Node ex:calc must conform to one or more shapes in gen:I2_030_DirectBranchShape , gen:I2_030_InterpolationBranchShape" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:I2_030_CalculationCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/calc> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_030_CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:I2_030_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/calc> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/ship> ;
            sh:resultMessage "Each calculation case must be linked to its local-frame section case and structural member, and must contain the declared plastic neutral axis and section modulus results with their required operand relationships." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each calculation case must be linked to its local-frame section case and structural member, and must contain the declared plastic neutral axis and section modulus results with their required operand relationships." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?cc .
                FILTER NOT EXISTS {
                    ?cc a nltl:calculationCase ;
                        nltl:plasticNeutralAxisHeight ?zna ;
                        nltl:interpolationLowerEndpoint ?lower ;
                        nltl:interpolationUpperEndpoint ?upper .
                    ?ccx nltl:sectionCalculationCaseStructuralMember ?sm .
                    ?sm nltl:hasLocalFrameSectionCalculationCase ?lfc ;
                        nltl:netEffectivePlasticSectionModulus ?zp ;
                        nltl:netLocalFrameFlangeArea ?afn ;
                        nltl:webHeight ?hw ;
                        nltl:netWebThickness ?twn ;
                        nltl:netAttachedShellPlateThickness ?tpn ;
                        nltl:frameSpacing ?s ;
                        nltl:localFrameFlangeCentreHeight ?hfc ;
                        nltl:webAngleToShellPlate ?phiw ;
                        nltl:webToFlangeCentreDistance ?bw .
                    ?lfc nltl:sectionCalculationCaseStructuralMember ?sm ;
                         nltl:sectionCalculationCasePlating ?pl .
                    ?pl nltl:framingAngleOmega ?omega .
                    ?afn qudt:numericValue ?afnValue ;
                         qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
                    ?hw qudt:numericValue ?hwValue ;
                        qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?twn qudt:numericValue ?twnValue ;
                         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?tpn qudt:numericValue ?tpnValue ;
                         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?s qudt:numericValue ?sValue ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                    ?hfc qudt:numericValue ?hfcValue ;
                         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?phiw qudt:numericValue ?phiwValue ;
                          qudt:unit <http://qudt.org/vocab/unit/DEG> .
                    ?bw qudt:numericValue ?bwValue ;
                        qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?omega qudt:numericValue ?omegaValue ;
                           qudt:unit <http://qudt.org/vocab/unit/DEG> .
                    ?zna qudt:numericValue ?znaValue ;
                         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?zp qudt:numericValue ?zpValue ;
                        qudt:unit <http://qudt.org/vocab/unit/CentiM3> .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_030_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F02/ship> ] .

