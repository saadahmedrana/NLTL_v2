@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F03/strength> ;
                            sh:resultMessage "Node ex:strength->qudt:unit does not contain a value in the set: ['qudt:KiloN']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:KiloN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F03/member> ;
                    sh:resultMessage "Each structural member must provide its plastic strength in kN." ;
                    sh:resultPath nltl:plasticStrength ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Each structural member must provide its plastic strength in kN." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue qudt:KiloN ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:plasticStrength ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F03/strength> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-031-StructuralMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-031-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F03/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F03/ship> ;
            sh:resultMessage "A frame profile type is required for the ship." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:message "A frame profile type is required for the ship." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ] .

