@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode nltl:otherIceStrengthenedArea ;
            sh:resultMessage "hullAreaFactor must be supplied as a dimensionless quantity." ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n5b7a08d9f0d34b75bd83cc04bac56f28b12 ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:midbodyBottomHullArea ;
            sh:resultMessage "hullAreaFactor must be supplied as a dimensionless quantity." ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n5b7a08d9f0d34b75bd83cc04bac56f28b12 ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:sternBottomHullArea ;
            sh:resultMessage "hullAreaFactor must be supplied as a dimensionless quantity." ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n5b7a08d9f0d34b75bd83cc04bac56f28b12 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-032-F04/at> ;
                    sh:resultMessage "Node ex:at->qudt:unit does not contain a value in the set: ['unit:CentiM2']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue unit:CentiM2 ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-032-F04/ship> ;
            sh:resultMessage "requiredTransverseFrameShearArea must be supplied as an area quantity in square centimetres." ;
            sh:resultPath nltl:requiredTransverseFrameShearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "requiredTransverseFrameShearArea must be supplied as an area quantity in square centimetres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-032-CentiAreaQuantityShape> ;
                    sh:path nltl:requiredTransverseFrameShearArea ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-032-F04/at> ],
        [ a sh:ValidationResult ;
            sh:focusNode nltl:bowIntermediateBottomHullArea ;
            sh:resultMessage "hullAreaFactor must be supplied as a dimensionless quantity." ;
            sh:resultPath nltl:hullAreaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n5b7a08d9f0d34b75bd83cc04bac56f28b12 ] .

_:n5b7a08d9f0d34b75bd83cc04bac56f28b12 sh:maxCount 1 ;
    sh:message "hullAreaFactor must be supplied as a dimensionless quantity." ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-032-DimensionlessQuantityShape> ;
    sh:path nltl:hullAreaFactor .

