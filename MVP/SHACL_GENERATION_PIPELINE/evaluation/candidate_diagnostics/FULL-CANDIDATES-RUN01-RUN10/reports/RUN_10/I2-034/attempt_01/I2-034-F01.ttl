@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ;
                    sh:resultMessage """Node ex:member must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A non-longitudinal structural member is not applicable to the longitudinal side-frame requirement.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:longitudinalFrameOrientation ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The structural member must identify itself as longitudinal to establish applicability.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:longitudinalFrameOrientation ], [ sh:hasValue nltl:sideStructureLocation ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An applicable longitudinal member must be located in the side structure.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:structuralLocation ], [ sh:node nltl:I2_034_LoadCaseShape ; sh:path nltl:hasStructuralMemberLoadCase ] ; sh:sparql [ sh:message Literal("Each represented load case for an applicable member requires a valid plastic-strength or midspan-plastic-collapse-load input.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasStructuralMemberLoadCase ?loadCase .
                        FILTER (
                            !EXISTS {
                                $this nltl:plasticStrength ?strength .
                                ?strength qudt:numericValue ?strengthValue ;
                                          qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                                FILTER (datatype(?strengthValue) = xsd:decimal)
                            }
                            &&
                            !EXISTS {
                                $this nltl:midspanPlasticCollapseLoad ?collapseLoad .
                                ?collapseLoad qudt:numericValue ?collapseValue ;
                                              qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                                FILTER (datatype(?collapseValue) = xsd:decimal)
                            }
                        )
                    }
                ") ], [ sh:message Literal("The combined shear-and-bending demand must not exceed the member plastic strength or midspan plastic-collapse load.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasStructuralMemberLoadCase ?loadCase .
                        ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                        ?demand qudt:numericValue ?demandValue .
                        FILTER (datatype(?demandValue) = xsd:decimal)
                        FILTER (
                            EXISTS {
                                $this nltl:plasticStrength ?strength .
                                ?strength qudt:numericValue ?strengthValue ;
                                          qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                                FILTER (datatype(?strengthValue) = xsd:decimal)
                                FILTER (?demandValue > ?strengthValue)
                            }
                            &&
                            EXISTS {
                                $this nltl:midspanPlasticCollapseLoad ?collapseLoad .
                                ?collapseLoad qudt:numericValue ?collapseValue ;
                                              qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                                FILTER (datatype(?collapseValue) = xsd:decimal)
                                FILTER (?demandValue > ?collapseValue)
                            }
                        )
                    }
                ") ] ]""" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape nltl:I2_034_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape nltl:I2_034_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltl:I2_034_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] .

