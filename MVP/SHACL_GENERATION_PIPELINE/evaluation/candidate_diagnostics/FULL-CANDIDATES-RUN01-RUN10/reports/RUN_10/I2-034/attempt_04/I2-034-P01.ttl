@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-P01/member> ;
                    sh:resultMessage "Node ex:member must conform to one or more shapes in [ sh:not [ rdf:type sh:NodeShape ; sh:and ( [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:longitudinalFrameOrientation ] ] [ sh:property [ sh:hasValue nltl:sideStructureLocation ; sh:path nltl:structuralLocation ] ] ) ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:longitudinalFrameOrientation ], [ sh:hasValue nltl:sideStructureLocation ; sh:path nltl:structuralLocation ], [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:midspanPlasticCollapseLoad ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:plasticStrength ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:longitudinalFrameOrientation ], [ sh:hasValue nltl:sideStructureLocation ; sh:path nltl:structuralLocation ], [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:plasticStrength ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:midspanPlasticCollapseLoad ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ a sh:NodeShape ;
                            sh:or ( [ sh:not [ a sh:NodeShape ;
                                                sh:and ( [ ] [ ] ) ] ] [ sh:property [ sh:hasValue nltl:sideStructureLocation ;
                                                sh:path nltl:structuralLocation ],
                                            [ sh:hasValue true ;
                                                sh:path nltl:longitudinalFrameOrientation ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class qudt:QuantityValue ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:plasticStrength ],
                                            [ sh:maxCount 0 ;
                                                sh:path nltl:midspanPlasticCollapseLoad ] ] [ sh:property [ sh:hasValue true ;
                                                sh:path nltl:longitudinalFrameOrientation ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class qudt:QuantityValue ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:midspanPlasticCollapseLoad ],
                                            [ sh:hasValue nltl:sideStructureLocation ;
                                                sh:path nltl:structuralLocation ],
                                            [ sh:maxCount 0 ;
                                                sh:path nltl:plasticStrength ] ] ) ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:maxCount 1 ;
                                    sh:message "Each represented structural member must state whether it is longitudinal." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:longitudinalFrameOrientation ],
                                [ sh:node [ a sh:NodeShape ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ sh:class qudt:QuantityValue ;
                                                            sh:property [ ] ] ;
                                                    sh:path nltl:combinedShearAndBendingDemand ] ] ;
                                    sh:path nltl:hasStructuralMemberLoadCase ],
                                [ sh:class nltl:structuralLocationValue ;
                                    sh:maxCount 1 ;
                                    sh:message "Each represented structural member must specify its structural location." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:structuralLocation ] ;
                            sh:sparql [ sh:message "A represented load-case demand must not exceed the selected midspan plastic-collapse load." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:longitudinalFrameOrientation true ;
                              nltl:structuralLocation nltl:sideStructureLocation ;
                              nltl:midspanPlasticCollapseLoad ?capacity ;
                              nltl:hasStructuralMemberLoadCase ?loadCase .
                        ?capacity qudt:numericValue ?capacityValue .
                        ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                        ?demand qudt:numericValue ?demandValue .
                        FILTER NOT EXISTS {
                            $this nltl:plasticStrength ?otherCapacity .
                        }
                        FILTER (?demandValue > ?capacityValue)
                    }
                """ ],
                                [ sh:message "A represented load-case demand must not exceed the selected plastic strength." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:longitudinalFrameOrientation true ;
                              nltl:structuralLocation nltl:sideStructureLocation ;
                              nltl:plasticStrength ?capacity ;
                              nltl:hasStructuralMemberLoadCase ?loadCase .
                        ?capacity qudt:numericValue ?capacityValue .
                        ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                        ?demand qudt:numericValue ?demandValue .
                        FILTER NOT EXISTS {
                            $this nltl:midspanPlasticCollapseLoad ?otherCapacity .
                        }
                        FILTER (?demandValue > ?capacityValue)
                    }
                """ ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-P01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-P01/ship> ;
            sh:resultMessage """Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:or ( [ sh:not [ rdf:type sh:NodeShape ; sh:and ( [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:longitudinalFrameOrientation ] ] [ sh:property [ sh:hasValue nltl:sideStructureLocation ; sh:path nltl:structuralLocation ] ] ) ] ] [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:longitudinalFrameOrientation ], [ sh:hasValue nltl:sideStructureLocation ; sh:path nltl:structuralLocation ], [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:path nltl:midspanPlasticCollapseLoad ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:plasticStrength ] ] [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:longitudinalFrameOrientation ], [ sh:hasValue nltl:sideStructureLocation ; sh:path nltl:structuralLocation ], [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:path nltl:plasticStrength ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:midspanPlasticCollapseLoad ] ] ) ; sh:property [ sh:class nltl:structuralLocationValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Each represented structural member must specify its structural location.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:structuralLocation ], [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Each represented structural member must state whether it is longitudinal.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:longitudinalFrameOrientation ], [ sh:node [ rdf:type sh:NodeShape ; sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:combinedShearAndBendingDemand ] ] ; sh:path nltl:hasStructuralMemberLoadCase ] ; sh:sparql [ sh:message Literal("A represented load-case demand must not exceed the selected midspan plastic-collapse load.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:longitudinalFrameOrientation true ;
                              nltl:structuralLocation nltl:sideStructureLocation ;
                              nltl:midspanPlasticCollapseLoad ?capacity ;
                              nltl:hasStructuralMemberLoadCase ?loadCase .
                        ?capacity qudt:numericValue ?capacityValue .
                        ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                        ?demand qudt:numericValue ?demandValue .
                        FILTER NOT EXISTS {
                            $this nltl:plasticStrength ?otherCapacity .
                        }
                        FILTER (?demandValue > ?capacityValue)
                    }
                ") ], [ sh:message Literal("A represented load-case demand must not exceed the selected plastic strength.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:longitudinalFrameOrientation true ;
                              nltl:structuralLocation nltl:sideStructureLocation ;
                              nltl:plasticStrength ?capacity ;
                              nltl:hasStructuralMemberLoadCase ?loadCase .
                        ?capacity qudt:numericValue ?capacityValue .
                        ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                        ?demand qudt:numericValue ?demandValue .
                        FILTER NOT EXISTS {
                            $this nltl:midspanPlasticCollapseLoad ?otherCapacity .
                        }
                        FILTER (?demandValue > ?capacityValue)
                    }
                ") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ a sh:NodeShape ;
                            sh:or ( [ sh:not [ a sh:NodeShape ;
                                                sh:and [ ] ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:plasticStrength ],
                                            [ sh:hasValue nltl:sideStructureLocation ;
                                                sh:path nltl:structuralLocation ],
                                            [ sh:maxCount 0 ;
                                                sh:path nltl:midspanPlasticCollapseLoad ],
                                            [ sh:hasValue true ;
                                                sh:path nltl:longitudinalFrameOrientation ] ] [ sh:property [ sh:maxCount 0 ;
                                                sh:path nltl:plasticStrength ],
                                            [ sh:hasValue nltl:sideStructureLocation ;
                                                sh:path nltl:structuralLocation ],
                                            [ sh:hasValue true ;
                                                sh:path nltl:longitudinalFrameOrientation ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:midspanPlasticCollapseLoad ] ] ) ;
                            sh:property [ sh:class nltl:structuralLocationValue ;
                                    sh:maxCount 1 ;
                                    sh:message "Each represented structural member must specify its structural location." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:structuralLocation ],
                                [ sh:node [ a sh:NodeShape ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:combinedShearAndBendingDemand ] ] ;
                                    sh:path nltl:hasStructuralMemberLoadCase ],
                                [ sh:datatype xsd:boolean ;
                                    sh:maxCount 1 ;
                                    sh:message "Each represented structural member must state whether it is longitudinal." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:longitudinalFrameOrientation ] ;
                            sh:sparql [ sh:message "A represented load-case demand must not exceed the selected midspan plastic-collapse load." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:longitudinalFrameOrientation true ;
                              nltl:structuralLocation nltl:sideStructureLocation ;
                              nltl:midspanPlasticCollapseLoad ?capacity ;
                              nltl:hasStructuralMemberLoadCase ?loadCase .
                        ?capacity qudt:numericValue ?capacityValue .
                        ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                        ?demand qudt:numericValue ?demandValue .
                        FILTER NOT EXISTS {
                            $this nltl:plasticStrength ?otherCapacity .
                        }
                        FILTER (?demandValue > ?capacityValue)
                    }
                """ ],
                                [ sh:message "A represented load-case demand must not exceed the selected plastic strength." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:longitudinalFrameOrientation true ;
                              nltl:structuralLocation nltl:sideStructureLocation ;
                              nltl:plasticStrength ?capacity ;
                              nltl:hasStructuralMemberLoadCase ?loadCase .
                        ?capacity qudt:numericValue ?capacityValue .
                        ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                        ?demand qudt:numericValue ?demandValue .
                        FILTER NOT EXISTS {
                            $this nltl:midspanPlasticCollapseLoad ?otherCapacity .
                        }
                        FILTER (?demandValue > ?capacityValue)
                    }
                """ ] ] ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-P01/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-P01/ship> ;
            sh:resultMessage "The ship must specify one frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship must specify one frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ] .

