@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-042-F01/ship> ;
            sh:resultMessage "Flange width must be at least five times the net web thickness for each structural member." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Flange width must be at least five times the net web thickness for each structural member." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:netWebThickness ?webQuantity ;
                        nltl:flangeWidth ?flangeQuantity .
                ?webQuantity qudt:numericValue ?web .
                ?flangeQuantity qudt:numericValue ?flange .
                FILTER (
                    ?flange < (5 * ?web)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_042_StaticCalculationShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-042-F01/ship> ] .

