@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F02/ship> ;
            sh:resultMessage "steelRenewalRequired must be true exactly when gaugedThickness is less than netThickness plus 0.0005 m" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "steelRenewalRequired must be true exactly when gaugedThickness is less than netThickness plus 0.0005 m" ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:gaugedThickness ?gaugedNode ;
                      nltl:netThickness ?netNode ;
                      nltl:steelRenewalRequired ?required .
                ?gaugedNode <http://qudt.org/schema/qudt/numericValue> ?gauged .
                ?netNode <http://qudt.org/schema/qudt/numericValue> ?net .
                FILTER (
                    (?required = true && !(?gauged < (?net + 0.0005))) ||
                    (?required = false && (?gauged < (?net + 0.0005)))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_047_SteelRenewalIceStrengthenedShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F02/ship> ] .

