@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F009/case> ;
            sh:resultMessage "Each steel-grade requirement case must provide exactly one actual hull structural steel grade with an order rank." ;
            sh:resultPath nltl:actualHullStructuralSteelGrade ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeValue ;
                    sh:maxCount 1 ;
                    sh:message "Each steel-grade requirement case must provide exactly one actual hull structural steel grade with an order rank." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:integer ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:steelGradeOrderRank ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:actualHullStructuralSteelGrade ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F009/case> ;
            sh:resultMessage "Each steel-grade requirement case must provide one as-built plate thickness in millimetres." ;
            sh:resultPath nltl:asBuiltPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each steel-grade requirement case must provide one as-built plate thickness in millimetres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:asBuiltPlateThickness ] ] .

