@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-PZERO/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:polarClass" ;
            sh:resultPath nltl:polarClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarClassValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:or ( [ sh:hasValue nltl:polarClassPc1 ] [ sh:hasValue nltl:polarClassPc2 ] [ sh:hasValue nltl:polarClassPc3 ] [ sh:hasValue nltl:polarClassPc4 ] [ sh:hasValue nltl:polarClassPc5 ] [ sh:hasValue nltl:polarClassPc6 ] [ sh:hasValue nltl:polarClassPc7 ] ) ;
                    sh:path nltl:polarClass ] ] .

