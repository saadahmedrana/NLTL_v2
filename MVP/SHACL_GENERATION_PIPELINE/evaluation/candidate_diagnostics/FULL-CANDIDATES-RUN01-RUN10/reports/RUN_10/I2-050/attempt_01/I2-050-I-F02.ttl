                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n072b90276c364987be698d47ef7c482ab14 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F02/ship> ;
            sh:resultMessage "The ship must provide one hull form coefficient k_h." ;
            sh:resultPath nltl:hullFormCoefficientKh ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one hull form coefficient k_h." ;
                    sh:minCount 1 ;
                    sh:node gs:DimensionlessQuantityShape ;
                    sh:path nltl:hullFormCoefficientKh ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F02/hullFormCoefficientKh> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F02/iceStrengthCoefficientKI> ;
