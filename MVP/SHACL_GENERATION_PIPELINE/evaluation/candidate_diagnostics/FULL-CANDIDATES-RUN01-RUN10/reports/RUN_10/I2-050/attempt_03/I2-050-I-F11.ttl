            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ],
        [ sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:N7c4976d3eecd44ecbaa1f8f30cdd3f5c sh:property _:N3ca81875300f4594ad7a0969470807f7,
        [ sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:N9e0bcb4ea37a4a41a0e885e242c52eab sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node _:N7c4976d3eecd44ecbaa1f8f30cdd3f5c ;
    sh:path nltl:crushingFailureClassFactor .

_:Nba491ef09dd54560b520cf2a50ef26c9 sh:class nltl:tableLookupCase ;
    sh:property _:N239d0eb365054d0f9ae104328db5df31,
        _:N9e0bcb4ea37a4a41a0e885e242c52eab,
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node _:N6ba8c0e939974c829f5e887c522360c9 ;
            sh:path nltl:flexuralFailureClassFactor ] .

_:n8110a69aa4a746b893a83b548dcdd31db13 sh:message "The ship must provide a table lookup case containing the required class factors." ;
    sh:minCount 1 ;
    sh:node _:Nba491ef09dd54560b520cf2a50ef26c9 ;
    sh:path nltl:hasTableLookupCase .

