        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ship must provide the dimensionless hull form coefficient." ;
            sh:resultPath nltl:hullFormCoefficientKh ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the dimensionless hull form coefficient." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:hullFormCoefficientKh ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ship must provide the upper ice waterline draught in metres." ;
            sh:resultPath nltl:upperIceWaterlineDraughtDUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the upper ice waterline draught in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:upperIceWaterlineDraughtDUI ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ship must provide the externally computed first candidate bow ice force." ;
            sh:resultPath nltl:designVerticalIceForceAtBowCandidateOne ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the externally computed first candidate bow ice force." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:MegaN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designVerticalIceForceAtBowCandidateOne ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ship must provide the stem angle in degrees." ;
            sh:resultPath nltl:stemAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the stem angle in degrees." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:DEG ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:stemAngle ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ship must provide the ice strength coefficient with a dimensionless quantity value." ;
            sh:resultPath nltl:iceStrengthCoefficientKI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the ice strength coefficient with a dimensionless quantity value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:iceStrengthCoefficientKI ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/ship> ;
            sh:resultMessage "The ship must provide the externally computed design vertical ice force at the bow." ;
            sh:resultPath nltl:designVerticalIceForceAtBow ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the externally computed design vertical ice force at the bow." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue unit:MegaN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:designVerticalIceForceAtBow ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ship must provide the externally computed second candidate bow ice force." ;
            sh:resultPath nltl:designVerticalIceForceAtBowCandidateTwo ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the externally computed second candidate bow ice force." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:MegaN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designVerticalIceForceAtBowCandidateTwo ] ] .

_:N239d0eb365054d0f9ae104328db5df31 sh:maxCount 1 ;
