                    sh:node <urn:nltl:generated-shape:I2-052-CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F01/calculation> ] .

_:N0b823f3b66c84df78b44aff0068474f3 sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:Nc7ffdca67ad047b883fbb77f0dfd996e sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ],
        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ] .

_:nb9cc218a79f3483c99d10b21d216f1d4b10 sh:class qudt:QuantityValue ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node _:N0b823f3b66c84df78b44aff0068474f3 ;
    sh:path nltl:hullGirderLongitudinalPositionFromAft .

_:nb9cc218a79f3483c99d10b21d216f1d4b14 sh:class qudt:QuantityValue ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node _:Nc7ffdca67ad047b883fbb77f0dfd996e ;
    sh:path nltl:interpolatedLongitudinalDistributionFactor .

_:nb9cc218a79f3483c99d10b21d216f1d4b3 sh:class nltl:interpolationPoint ;
    sh:minCount 1 ;
    sh:node <urn:nltl:generated-shape:I2-052-IntermediatePointShape> ;
    sh:path nltl:hasInterpolationPoint .

