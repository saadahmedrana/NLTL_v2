                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nb9cc218a79f3483c99d10b21d216f1d4b21 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F06/calculation> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-052-EndpointShape>. See details for more information." ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
