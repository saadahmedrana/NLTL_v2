                            sh:path nltl:interpolationLowerEndpoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P03/lowerPoint> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P03/upperPoint> ;
                            sh:resultMessage "Less than 1 values on ex:upperPoint->nltl:interpolatedLongitudinalDistributionFactor" ;
                            sh:resultPath nltl:interpolatedLongitudinalDistributionFactor ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nb9cc218a79f3483c99d10b21d216f1d4b14 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P03/upperPoint> ;
                            sh:resultMessage "Less than 1 values on ex:upperPoint->nltl:hullGirderLongitudinalPositionFromAft" ;
                            sh:resultPath nltl:hullGirderLongitudinalPositionFromAft ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nb9cc218a79f3483c99d10b21d216f1d4b10 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P03/calculation> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-052-IntermediatePointShape>. See details for more information." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nb9cc218a79f3483c99d10b21d216f1d4b3 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P03/upperPoint> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P03/upperPoint> ;
                            sh:resultMessage "Less than 1 values on ex:upperPoint->nltl:hullGirderLongitudinalPositionFromAft" ;
                            sh:resultPath nltl:hullGirderLongitudinalPositionFromAft ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
