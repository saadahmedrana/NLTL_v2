                            sh:resultMessage "Less than 1 values on ex:extraPoint->nltl:interpolatedLongitudinalDistributionFactor" ;
                            sh:resultPath nltl:interpolatedLongitudinalDistributionFactor ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nb9cc218a79f3483c99d10b21d216f1d4b14 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P03/extraPoint> ;
                            sh:resultMessage "Less than 1 values on ex:extraPoint->nltl:hullGirderLongitudinalPositionFromAft" ;
                            sh:resultPath nltl:hullGirderLongitudinalPositionFromAft ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nb9cc218a79f3483c99d10b21d216f1d4b10 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P03/calculation> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-052-IntermediatePointShape>. See details for more information." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nb9cc218a79f3483c99d10b21d216f1d4b3 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P03/extraPoint> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P03/calculation> ;
                    sh:resultMessage "The intermediate interpolation coordinate must lie strictly between the lower and upper endpoint coordinates in the same calculation case." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "The intermediate interpolation coordinate must lie strictly between the lower and upper endpoint coordinates in the same calculation case." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasInterpolationPoint ?mid .
                $this nltl:interpolationLowerEndpoint ?lower .
                $this nltl:interpolationUpperEndpoint ?upper .

                ?mid nltl:interpolationCoordinate ?midCoordinate .
                ?lower nltl:interpolationCoordinate ?lowerCoordinate .
                ?upper nltl:interpolationCoordinate ?upperCoordinate .

                ?midCoordinate qudt:numericValue ?midValue .
                ?lowerCoordinate qudt:numericValue ?lowerValue .
                ?upperCoordinate qudt:numericValue ?upperValue .

                FILTER (
                    DATATYPE(?midValue) = xsd:decimal &&
                    DATATYPE(?lowerValue) = xsd:decimal &&
                    DATATYPE(?upperValue) = xsd:decimal &&
                    !(
                        ?lowerValue < ?midValue &&
                        ?midValue < ?upperValue
                    )
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-052-CalculationCaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P03/calculation> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-052-CalculationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-052-CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-P03/calculation> ] .

