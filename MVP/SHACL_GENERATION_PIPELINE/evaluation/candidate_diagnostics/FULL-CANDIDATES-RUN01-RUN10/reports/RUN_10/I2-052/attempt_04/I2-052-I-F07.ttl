@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F07/calculation> ;
                    sh:resultMessage "The lower, intermediate, and upper interpolation coordinates and their paired values must be represented on the same calculation case, with strict lower-to-intermediate-to-upper coordinate ordering." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "The lower, intermediate, and upper interpolation coordinates and their paired values must be represented on the same calculation case, with strict lower-to-intermediate-to-upper coordinate ordering." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:interpolationLowerEndpoint ?lower .
                ?this nltl:hasInterpolationPoint ?intermediate .
                ?this nltl:interpolationUpperEndpoint ?upper .

                ?lower nltl:interpolationCoordinate ?lowerCoordinateNode .
                ?lower nltl:interpolationPointValue ?lowerValueNode .
                ?lowerCoordinateNode qudt:numericValue ?lowerCoordinate .
                ?lowerValueNode qudt:numericValue ?lowerValue .

                ?intermediate nltl:interpolationCoordinate ?intermediateCoordinateNode .
                ?intermediate nltl:interpolationPointValue ?intermediateValueNode .
                ?intermediateCoordinateNode qudt:numericValue ?intermediateCoordinate .
                ?intermediateValueNode qudt:numericValue ?intermediateValue .

                ?upper nltl:interpolationCoordinate ?upperCoordinateNode .
                ?upper nltl:interpolationPointValue ?upperValueNode .
                ?upperCoordinateNode qudt:numericValue ?upperCoordinate .
                ?upperValueNode qudt:numericValue ?upperValue .

                FILTER (
                    ?lowerCoordinate >= ?intermediateCoordinate ||
                    ?intermediateCoordinate >= ?upperCoordinate
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape nltlgen:I2-052-CalculationCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F07/calculation> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F07/ship> ;
            sh:resultMessage "The ship must provide a calculation case for the linear interpolation readiness record." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "The ship must provide a calculation case for the linear interpolation readiness record." ;
                    sh:minCount 1 ;
                    sh:node nltlgen:I2-052-CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F07/calculation> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F07/ship> ;
            sh:resultMessage "The ship must provide the externally recorded interpolated value." ;
            sh:resultPath nltl:interpolatedValue ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must provide the externally recorded interpolated value." ;
                    sh:minCount 1 ;
                    sh:path nltl:interpolatedValue ] ] .

