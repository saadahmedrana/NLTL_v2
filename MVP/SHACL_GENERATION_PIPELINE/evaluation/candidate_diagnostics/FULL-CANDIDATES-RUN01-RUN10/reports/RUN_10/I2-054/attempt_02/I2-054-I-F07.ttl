@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "A coherent calculation case containing the hull-girder bending-moment inputs and result is required." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A coherent calculation case containing the hull-girder bending-moment inputs and result is required." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_054_HullGirderCaseShape ;
                    sh:path nltl:hasCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/upperIceWaterlineLengthLUI> ;
                    sh:resultMessage "Node ex:upperIceWaterlineLengthLUI->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "The ship must provide one upper ice waterline length in metres." ;
            sh:resultPath nltl:upperIceWaterlineLengthLUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one upper ice waterline length in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:upperIceWaterlineLengthLUI ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/upperIceWaterlineLengthLUI> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/caseBendingMomentDistributionFactor> ;
                            sh:resultMessage "Node ex:caseBendingMomentDistributionFactor->qudt:unit does not contain a value in the set: ['qudt:UNITLESS']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/bendingCase> ;
                    sh:resultMessage "The calculation case must provide the bending moment distribution factor." ;
                    sh:resultPath nltl:caseBendingMomentDistributionFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The calculation case must provide the bending moment distribution factor." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue qudt:UNITLESS ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:caseBendingMomentDistributionFactor ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/caseBendingMomentDistributionFactor> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/caseDesignVerticalIceBendingMoment> ;
                            sh:resultMessage "Node ex:caseDesignVerticalIceBendingMoment->qudt:unit does not contain a value in the set: ['qudt:MegaN-M']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:MegaN-M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/bendingCase> ;
                    sh:resultMessage "The calculation case must provide the externally determined design vertical ice bending moment in meganewton-metres." ;
                    sh:resultPath nltl:caseDesignVerticalIceBendingMoment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The calculation case must provide the externally determined design vertical ice bending moment in meganewton-metres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue qudt:MegaN-M ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:caseDesignVerticalIceBendingMoment ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/caseDesignVerticalIceBendingMoment> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/caseHullGirderLongitudinalPositionFromAft> ;
                            sh:resultMessage "Node ex:caseHullGirderLongitudinalPositionFromAft->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/bendingCase> ;
                    sh:resultMessage "The calculation case must provide its hull-girder longitudinal position from aft in metres." ;
                    sh:resultPath nltl:caseHullGirderLongitudinalPositionFromAft ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The calculation case must provide its hull-girder longitudinal position from aft in metres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue qudt:M ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:caseHullGirderLongitudinalPositionFromAft ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/caseHullGirderLongitudinalPositionFromAft> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/bendingCase> ;
                    sh:resultMessage "The calculation case must provide the declared interpolation-point structure." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The calculation case must provide the declared interpolation-point structure." ;
                            sh:minCount 4 ;
                            sh:node gen:I2_054_InterpolationPointShape ;
                            sh:path nltl:hasInterpolationPoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "A hull-girder bending-moment calculation case is required." ;
            sh:resultPath nltl:hasHullGirderBendingMomentCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A hull-girder bending-moment calculation case is required." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_054_HullGirderCaseShape ;
                    sh:path nltl:hasHullGirderBendingMomentCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/bendingCase> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/stemAngle> ;
                    sh:resultMessage "Node ex:stemAngle->qudt:unit does not contain a value in the set: ['qudt:DEG']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:DEG ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "The ship must provide one stem angle in degrees." ;
            sh:resultPath nltl:stemAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one stem angle in degrees." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:DEG ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:stemAngle ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/stemAngle> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/designVerticalIceForceAtBow> ;
                    sh:resultMessage "Node ex:designVerticalIceForceAtBow->qudt:unit does not contain a value in the set: ['qudt:MegaN']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:MegaN ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "The ship must provide one design vertical ice force at the bow in meganewtons." ;
            sh:resultPath nltl:designVerticalIceForceAtBow ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one design vertical ice force at the bow in meganewtons." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:MegaN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designVerticalIceForceAtBow ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/designVerticalIceForceAtBow> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "The calculation-case and hull-girder bending-moment paths must identify the same case." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The calculation-case and hull-girder bending-moment paths must identify the same case." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?case .
                    $this nltl:hasHullGirderBendingMomentCalculationCase ?case .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_054_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ] .

