            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n82269db688c940dab7b0be54b96ece6ab1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "Value of ex:ship->nltl:hasCalculationCase != ex:bendingCase" ;
            sh:resultPath nltl:hasHullGirderBendingMomentCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
            sh:sourceShape [ sh:equals nltl:hasCalculationCase ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:hullGirderBendingMomentCalculationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class q:QuantityValue ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:path q:numericValue ],
                                                [ sh:hasValue qudt:MegaN-M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path q:unit ] ] ;
                                    sh:path nltl:caseDesignVerticalIceBendingMoment ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class q:QuantityValue ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:path q:numericValue ],
                                                [ sh:hasValue qudt:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path q:unit ] ] ;
                                    sh:path nltl:caseBendingMomentDistributionFactor ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class q:QuantityValue ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:path q:numericValue ],
                                                [ sh:hasValue qudt:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path q:unit ] ] ;
                                    sh:path nltl:caseHullGirderLongitudinalPositionFromAft ] ] ;
                    sh:path nltl:hasHullGirderBendingMomentCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/bendingCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/ship> ;
            sh:resultMessage "Value of ex:ship->nltl:hasHullGirderBendingMomentCalculationCase != ex:bendingCase" ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
            sh:sourceShape _:n82269db688c940dab7b0be54b96ece6ab1 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F07/bendingCase> ] .

