            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:calculationCase ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:interpolationPoint ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class q:QuantityValue ; sh:property [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path q:unit ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path q:numericValue ] ] ; sh:path nltl:interpolationPointCoordinate ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class q:QuantityValue ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path q:numericValue ] ] ; sh:path nltl:interpolationPointResult ] ] ; sh:path nltl:hasInterpolationPoint ] ]. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
