@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F03/ship> ;
            sh:resultMessage "The ship's strength criteria status must be true." ;
            sh:resultPath nltl:strengthCriterionStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The ship's strength criteria status must be true." ;
                    sh:minCount 1 ;
                    sh:path nltl:strengthCriterionStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F03/ship> ;
            sh:resultMessage "Design stress must not exceed permissible stress." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Design stress must not exceed permissible stress." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX qudt-unit: <http://qudt.org/vocab/unit/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:designStress ?designQuantity .
    ?designQuantity qudt:numericValue ?designValue .
    ?designQuantity qudt:unit qudt-unit:MegaPA .
    $this nltl:permissibleStress ?permissibleQuantity .
    ?permissibleQuantity qudt:numericValue ?permissibleValue .
    ?permissibleQuantity qudt:unit qudt-unit:MegaPA .
    FILTER (?designValue > ?permissibleValue)
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-055-StrengthCriteria> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F03/ship> ] .

