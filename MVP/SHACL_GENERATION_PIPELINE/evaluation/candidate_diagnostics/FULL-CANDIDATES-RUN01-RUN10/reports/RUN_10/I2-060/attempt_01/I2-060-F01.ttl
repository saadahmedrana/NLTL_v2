@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/ship> ;
            sh:resultMessage "A member in way of a cutout must not be unstable, and required stiffening must be recorded." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A member in way of a cutout must not be unstable, and required stiffening must be recorded." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasCutout ?cutout ;
                        nltl:memberInWayOfCutout true ;
                        nltl:stiffeningNecessary ?necessary .
                FILTER (
                    NOT EXISTS {
                        $this nltl:memberInstability false
                    }
                    || EXISTS {
                        $this nltl:memberInstability true
                    }
                    || (
                        ?necessary = true
                        && NOT EXISTS {
                            $this nltl:structuralStiffening ?stiffening
                        }
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-060-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F01/ship> ] .

