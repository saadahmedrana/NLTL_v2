@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/member> ;
            sh:resultMessage "A structural member linked to a cutout must provide the applicability and stiffening-necessity indicators." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A structural member linked to a cutout must provide the applicability and stiffening-necessity indicators." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:hasCutout ?cutout .
                FILTER (
                    NOT EXISTS {
                        $this nltl:memberInWayOfCutout ?inWay
                    }
                    || NOT EXISTS {
                        $this nltl:stiffeningNecessary ?necessary
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-060-StructuralMemberShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F03/member> ] .

