@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/case> ;
                    sh:resultMessage "The calculation case must use the prescribed analytical procedure; direct calculation must not replace it." ;
                    sh:resultPath nltl:calculationMethod ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nff3558c2edc042e691db033dc8bbd4ffb2 ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/structure> ;
                            sh:resultMessage "The assessed hull structure must provide one thickness quantity." ;
                            sh:resultPath nltl:thickness ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "The assessed hull structure must provide one thickness quantity." ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:I2-061-ThicknessQuantityShape> ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:thickness ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/case> ;
                    sh:resultMessage "The calculation case must identify its assessed hull structure." ;
                    sh:resultPath nltl:calculationCaseAssessedHullStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "The calculation case must identify its assessed hull structure." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-061-HullStructureShape> ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:calculationCaseAssessedHullStructure ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/structure> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/case> ;
                    sh:resultMessage "The calculation case must use the prescribed analytical procedure; direct calculation must not replace it." ;
                    sh:resultPath nltl:calculationMethod ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nff3558c2edc042e691db033dc8bbd4ffb2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-CalculationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/case> ] .

_:nff3558c2edc042e691db033dc8bbd4ffb2 sh:hasValue nltl:prescribedAnalyticalProcedure ;
    sh:maxCount 1 ;
    sh:message "The calculation case must use the prescribed analytical procedure; direct calculation must not replace it." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:calculationMethod .

