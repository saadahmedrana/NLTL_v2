@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/case> ;
            sh:resultMessage "The assessed hull structure must have a single thickness quantity with a decimal numeric value in metres." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The assessed hull structure must have a single thickness quantity with a decimal numeric value in metres." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:calculationCaseAssessedHullStructure ?structure .
                ?structure rdf:type ?scopeType .
                FILTER (?scopeType IN (
                    nltl:plating,
                    nltl:structuralMember
                ))
                FILTER (
                    NOT EXISTS {
                        ?structure nltl:thickness ?quantity .
                        ?quantity qudt:numericValue ?value ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (datatype(?value) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?structure nltl:thickness ?quantity1, ?quantity2 .
                        FILTER (?quantity1 != ?quantity2)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/case> ] .

