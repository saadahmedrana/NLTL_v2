@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/case> ;
            sh:resultMessage "A scoped calculation case must be linked from a ship and assess a shell-plating or local-frame hull structure." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A scoped calculation case must be linked from a ship and assess a shell-plating or local-frame hull structure." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    ?ship rdf:type nltl:ship ;
                          nltl:hasCalculationCase $this .
                    $this nltl:calculationCaseAssessedHullStructure ?structure .
                    ?structure rdf:type ?scopeType .
                    FILTER (?scopeType IN (
                        nltl:plating,
                        nltl:structuralMember
                    ))
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/case> ] .

