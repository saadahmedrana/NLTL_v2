@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ;
                    sh:resultMessage "For an applicable shell-plating or local-frame hull structure, the prescribed analytical procedure is required, direct calculation may not be used, and thickness must be present as a decimal quantity in metres." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "For an applicable shell-plating or local-frame hull structure, the prescribed analytical procedure is required, direct calculation may not be used, and thickness must be present as a decimal quantity in metres." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:calculationCaseAssessedHullStructure ?hullStructure .
                ?hullStructure rdf:type ?scopeType .
                FILTER (
                    ?scopeType = nltl:plating ||
                    ?scopeType = nltl:structuralMember
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:calculationMethod
                            nltl:prescribedAnalyticalProcedure
                    }
                    ||
                    EXISTS {
                        $this nltl:calculationMethod
                            nltl:directCalculationMethodValue
                    }
                    ||
                    NOT EXISTS {
                        ?hullStructure nltl:thickness ?quantity
                    }
                    ||
                    EXISTS {
                        ?hullStructure nltl:thickness ?quantity .
                        FILTER (
                            !isIRI(?quantity) ||
                            NOT EXISTS {
                                ?quantity qudt:numericValue ?numericValue ;
                                          qudt:unit qudt:M .
                                FILTER (datatype(?numericValue) = xsd:decimal)
                            } ||
                            EXISTS {
                                ?quantity qudt:unit ?unit .
                                FILTER (?unit != qudt:M)
                            }
                        )
                    }
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-CalculationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:node <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F01/case> ] .

