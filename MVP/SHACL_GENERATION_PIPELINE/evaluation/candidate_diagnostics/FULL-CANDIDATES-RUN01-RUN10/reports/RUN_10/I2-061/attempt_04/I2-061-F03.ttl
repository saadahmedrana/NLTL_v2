@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/ship> ;
            sh:resultMessage "Each applicable calculation case linked to the ship shall use the prescribed analytical procedure, shall not use direct calculation as an alternative, and shall provide hull-structure thickness in metres as a decimal quantity." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each applicable calculation case linked to the ship shall use the prescribed analytical procedure, shall not use direct calculation as an alternative, and shall provide hull-structure thickness in metres as a decimal quantity." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationCaseAssessedHullStructure ?hull .
                ?hull rdf:type ?scopeType .
                FILTER (?scopeType IN (nltl:plating, nltl:structuralMember))
                FILTER (
                    NOT EXISTS {
                        ?case nltl:calculationMethod nltl:prescribedAnalyticalProcedure
                    }
                    ||
                    EXISTS {
                        ?case nltl:calculationMethod nltl:directCalculationMethodValue
                    }
                    ||
                    NOT EXISTS {
                        ?hull nltl:thickness ?quantity .
                        ?quantity qudt:numericValue ?numericValue .
                        ?quantity qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (datatype(?numericValue) = xsd:decimal)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:GeneratedShape_I2_061_Ship ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/case> ;
                    sh:resultMessage "Each applicable calculation case shall use the prescribed analytical procedure, shall not use direct calculation as an alternative, and shall provide hull-structure thickness in metres as a decimal quantity." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "Each applicable calculation case shall use the prescribed analytical procedure, shall not use direct calculation as an alternative, and shall provide hull-structure thickness in metres as a decimal quantity." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:calculationCaseAssessedHullStructure ?hull .
                ?hull rdf:type ?scopeType .
                FILTER (?scopeType IN (nltl:plating, nltl:structuralMember))
                FILTER (
                    NOT EXISTS {
                        $this nltl:calculationMethod nltl:prescribedAnalyticalProcedure
                    }
                    ||
                    EXISTS {
                        $this nltl:calculationMethod nltl:directCalculationMethodValue
                    }
                    ||
                    NOT EXISTS {
                        ?hull nltl:thickness ?quantity .
                        ?quantity qudt:numericValue ?numericValue .
                        ?quantity qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (datatype(?numericValue) = xsd:decimal)
                    }
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape nltl:GeneratedShape_I2_061_CalculationCase ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape nltl:GeneratedShape_I2_061_CalculationCase. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node nltl:GeneratedShape_I2_061_CalculationCase ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F03/case> ] .

