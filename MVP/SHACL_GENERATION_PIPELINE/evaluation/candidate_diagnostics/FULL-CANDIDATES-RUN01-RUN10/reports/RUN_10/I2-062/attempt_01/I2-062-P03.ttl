@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "The ship record must confirm that the required direct calculation is used." ;
            sh:resultPath nltl:directCalculationUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n975dd9a1fe7547f4aab1a799c7bcbec0b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "The ship record must confirm that the required direct calculation is used." ;
            sh:resultPath nltl:directCalculationUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n975dd9a1fe7547f4aab1a799c7bcbec0b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ;
            sh:resultMessage "Each linked load carrying stringer or web frame must be identified as forming part of a grillage system." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each linked load carrying stringer or web frame must be identified as forming part of a grillage system." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>

            SELECT $this
            WHERE {
                $this a nltl:ship .
                $this nltl:hasStructuralMember ?member .
                {
                    ?member a nltl:loadCarryingStringer .
                }
                UNION
                {
                    ?member a nltl:webFrame .
                }
                FILTER NOT EXISTS {
                    ?member nltl:partOfGrillageSystem ?grillage .
                    ?grillage a nltl:grillageSystem .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-062-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-P03/ship> ] .

_:n975dd9a1fe7547f4aab1a799c7bcbec0b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship record must confirm that the required direct calculation is used." ;
    sh:minCount 1 ;
    sh:path nltl:directCalculationUsed .

