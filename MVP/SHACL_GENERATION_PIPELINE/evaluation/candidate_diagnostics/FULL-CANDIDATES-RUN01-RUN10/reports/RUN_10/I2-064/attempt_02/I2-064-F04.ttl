@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/web> ;
                            sh:resultMessage "Each represented member web must provide one decimal nominal shear stress in MPa." ;
                            sh:resultPath nltl:nominalShearStress ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each represented member web must provide one decimal nominal shear stress in MPa." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue qudt:MegaPA ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:nominalShearStress ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/member> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:structuralMemberWeb ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each represented member web must provide one decimal nominal shear stress in MPa.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:MegaPA ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:nominalShearStress ] ]. See details for more information." ;
                    sh:resultPath nltl:hasStructuralMemberWeb ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node [ sh:class nltl:structuralMemberWeb ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:message "Each represented member web must provide one decimal nominal shear stress in MPa." ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:hasValue qudt:MegaPA ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ],
                                                        [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:nominalShearStress ] ] ;
                            sh:path nltl:hasStructuralMemberWeb ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/web> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/nominalFlangeVonMisesStress> ;
                                    sh:resultMessage "Node ex:nominalFlangeVonMisesStress->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape [ sh:hasValue qudt:MegaPA ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/flange> ;
                            sh:resultMessage "Each represented member flange must provide one decimal nominal von Mises stress in MPa." ;
                            sh:resultPath nltl:nominalFlangeVonMisesStress ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each represented member flange must provide one decimal nominal von Mises stress in MPa." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue qudt:MegaPA ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:nominalFlangeVonMisesStress ] ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/nominalFlangeVonMisesStress> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/member> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:structuralMemberFlange ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each represented member flange must provide one decimal nominal von Mises stress in MPa.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:MegaPA ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:nominalFlangeVonMisesStress ] ]. See details for more information." ;
                    sh:resultPath nltl:hasStructuralMemberFlange ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node [ sh:class nltl:structuralMemberFlange ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:message "Each represented member flange must provide one decimal nominal von Mises stress in MPa." ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:hasValue qudt:MegaPA ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ],
                                                        [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:nominalFlangeVonMisesStress ] ] ;
                            sh:path nltl:hasStructuralMemberFlange ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/flange> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:hullStructure, nltl:structuralMember ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each represented structural member must confirm that the applicable buckling criteria are satisfied.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bucklingCriteriaSatisfied ], [ sh:node [ sh:class nltl:structuralMemberFlange ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each represented member flange must provide one decimal nominal von Mises stress in MPa.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:MegaPA ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:nominalFlangeVonMisesStress ] ] ; sh:path nltl:hasStructuralMemberFlange ], [ sh:node [ sh:class nltl:structuralMemberWeb ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each represented member web must provide one decimal nominal shear stress in MPa.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:MegaPA ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:nominalShearStress ] ] ; sh:path nltl:hasStructuralMemberWeb ] ]. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:hullStructure,
                                nltl:structuralMember ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "Each represented structural member must confirm that the applicable buckling criteria are satisfied." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:bucklingCriteriaSatisfied ],
                                [ sh:node [ sh:class nltl:structuralMemberWeb ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:message "Each represented member web must provide one decimal nominal shear stress in MPa." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:nominalShearStress ] ] ;
                                    sh:path nltl:hasStructuralMemberWeb ],
                                [ sh:node [ sh:class nltl:structuralMemberFlange ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:message "Each represented member flange must provide one decimal nominal von Mises stress in MPa." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:nominalFlangeVonMisesStress ] ] ;
                                    sh:path nltl:hasStructuralMemberFlange ] ] ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/ship> ;
            sh:resultMessage "The ship must provide one decimal yield-strength value in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one decimal yield-strength value in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:MegaPA ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:yieldStrength ] ] .

