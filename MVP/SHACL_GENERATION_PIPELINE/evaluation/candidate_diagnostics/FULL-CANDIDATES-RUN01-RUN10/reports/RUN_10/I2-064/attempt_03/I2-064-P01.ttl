@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P01/flange> ;
            sh:resultMessage "Applicable hull structures must satisfy the buckling criteria." ;
            sh:resultPath nltl:bucklingCriteriaSatisfied ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n32cc197c15744df68053ec7df6fdaf31b10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P01/web> ;
            sh:resultMessage "Applicable hull structures must satisfy the buckling criteria." ;
            sh:resultPath nltl:bucklingCriteriaSatisfied ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n32cc197c15744df68053ec7df6fdaf31b10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P01/ship> ;
            sh:resultMessage "For an applicable linear calculation, yield strength must be a decimal quantity in MPa." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an applicable linear calculation, yield strength must be a decimal quantity in MPa." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?linearCase .
                ?linearCase nltl:calculationMethod nltl:linearCalculationMethodValue .
                FILTER NOT EXISTS {
                    $this nltl:yieldStrength ?yieldQuantity .
                    ?yieldQuantity qudt:numericValue ?yieldValue ;
                                   qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                    FILTER (datatype(?yieldValue) = xsd:decimal)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_064_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P01/flange> ;
            sh:resultMessage "Applicable hull structures must satisfy the buckling criteria." ;
            sh:resultPath nltl:bucklingCriteriaSatisfied ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n32cc197c15744df68053ec7df6fdaf31b10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P01/web> ;
            sh:resultMessage "Applicable hull structures must satisfy the buckling criteria." ;
            sh:resultPath nltl:bucklingCriteriaSatisfied ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n32cc197c15744df68053ec7df6fdaf31b10 ] .

_:n32cc197c15744df68053ec7df6fdaf31b10 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Applicable hull structures must satisfy the buckling criteria." ;
    sh:minCount 1 ;
    sh:path nltl:bucklingCriteriaSatisfied .

