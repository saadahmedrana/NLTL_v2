@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:calculationCase ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:hasValue nltl:nonlinearCalculationMethodValue ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:calculationMethod ] ] ; sh:path nltl:hasCalculationCase ], [ sh:class nltl:calculationCase ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltl:I2_065_CalculationCaseShape ; sh:path nltl:hasCalculationCase ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A nonlinear evaluation must provide the fracture margin.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltl:I2_065_MarginValueShape ; sh:path nltl:fractureMargin ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A nonlinear evaluation must provide the major buckling margin.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltl:I2_065_MarginValueShape ; sh:path nltl:majorBucklingMargin ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A nonlinear evaluation must provide the yielding margin.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltl:I2_065_MarginValueShape ; sh:path nltl:yieldingMargin ] ] , [ sh:property [ sh:class nltl:calculationCase ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltl:I2_065_OtherMethodCaseShape ; sh:path nltl:hasCalculationCase ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltl:I2_065_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ] .

