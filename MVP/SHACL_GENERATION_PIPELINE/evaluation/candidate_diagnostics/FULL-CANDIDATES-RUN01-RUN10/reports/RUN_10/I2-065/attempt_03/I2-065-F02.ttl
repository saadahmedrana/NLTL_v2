@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "A ship using a represented nonlinear calculation case shall provide the required acceptance margins." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-065-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/calculation> ;
            sh:resultMessage "Each represented nonlinear calculation case shall include acceptance evidence, deformation and structural-dimension inputs, and a satisfied minor-deformation assessment." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-065-CalculationCaseShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/calculation> ] .

