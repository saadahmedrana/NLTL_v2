@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F03/ship> ;
            sh:resultMessage "Each linked weld must record whether it is within an ice-strengthened area." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each linked weld must record whether it is within an ice-strengthened area." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasWeld ?weld .
                FILTER NOT EXISTS {
                    ?weld nltl:withinIceStrengthenedArea ?scope .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-066> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F03/weld1> ;
            sh:resultMessage "Less than 1 values on ex:weld1->nltl:withinIceStrengthenedArea" ;
            sh:resultPath nltl:withinIceStrengthenedArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:minCount 1 ;
                    sh:path nltl:withinIceStrengthenedArea ] ] .

