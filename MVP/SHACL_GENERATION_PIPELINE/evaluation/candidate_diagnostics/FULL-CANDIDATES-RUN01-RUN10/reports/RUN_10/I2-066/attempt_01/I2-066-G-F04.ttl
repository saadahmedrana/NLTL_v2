@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/ship> ;
            sh:resultMessage "Welding within an ice-strengthened area must be of the double continuous type." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Welding within an ice-strengthened area must be of the double continuous type." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasWeld ?weld .
                ?weld nltl:withinIceStrengthenedArea ?scope .
                FILTER ( ?scope = true || ?scope = "true"^^xsd:boolean )
                FILTER NOT EXISTS {
                    ?weld nltl:weldType nltl:doubleContinuousWeld .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-066> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/ship> ] .

