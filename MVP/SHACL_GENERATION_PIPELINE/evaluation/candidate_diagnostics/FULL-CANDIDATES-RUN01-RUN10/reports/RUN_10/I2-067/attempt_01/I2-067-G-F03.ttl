@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F03/connection1> ;
                    sh:resultMessage "Strength continuity must be ensured at the structural connection." ;
                    sh:resultPath nltl:strengthContinuityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n637e5aff4cbf47498075dca3f519e3a9b2 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F03/connection1> ;
                    sh:resultMessage "Strength continuity must be ensured at the structural connection." ;
                    sh:resultPath nltl:strengthContinuityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n637e5aff4cbf47498075dca3f519e3a9b2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F03/ship> ;
            sh:resultMessage "Every structural connection must have continuity of strength ensured." ;
            sh:resultPath nltl:structuralConnection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Every structural connection must have continuity of strength ensured." ;
                    sh:node gen:I2_067_StructuralConnectionShape ;
                    sh:path nltl:structuralConnection ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F03/connection1> ] .

_:n637e5aff4cbf47498075dca3f519e3a9b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Strength continuity must be ensured at the structural connection." ;
    sh:minCount 1 ;
    sh:path nltl:strengthContinuityStatus .

