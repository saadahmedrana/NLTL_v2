@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F01/connection1> ;
            sh:resultMessage "Continuity of strength must be ensured at every structural connection." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Continuity of strength must be ensured at every structural connection." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                ?ship nltl:structuralConnection $this .
                FILTER NOT EXISTS {
                    ?ship nltl:strengthContinuityStatus ?status .
                    FILTER (?status = true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_067_StructuralConnectionShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F01/connection1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F01/ship> ;
            sh:resultMessage "The ship must record that continuity of strength is ensured." ;
            sh:resultPath nltl:strengthContinuityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n2b718037b84f428c8b4a49baabaece80b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F01/ship> ;
            sh:resultMessage "The ship must record that continuity of strength is ensured." ;
            sh:resultPath nltl:strengthContinuityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n2b718037b84f428c8b4a49baabaece80b1 ] .

_:n2b718037b84f428c8b4a49baabaece80b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record that continuity of strength is ensured." ;
    sh:minCount 1 ;
    sh:path nltl:strengthContinuityStatus .

