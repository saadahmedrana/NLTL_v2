@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:polarShipCategoryA ; sh:path nltl:shipCategory ] ] , [ sh:property [ sh:hasValue nltl:polarShipCategoryB ; sh:path nltl:shipCategory ] ] , [ sh:property [ sh:hasValue nltl:polarShipCategoryC ; sh:path nltl:shipCategory ] ; sh:sparql [ sh:message Literal("A non-category-A ship designed for at least thin first-year ice must be category B.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    SELECT $this
                    WHERE {
                        $this nltl:designIceCondition nltl:thinFirstYearIceWithPossibleOldIceInclusions .
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-002-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-F01/ship> ] .

