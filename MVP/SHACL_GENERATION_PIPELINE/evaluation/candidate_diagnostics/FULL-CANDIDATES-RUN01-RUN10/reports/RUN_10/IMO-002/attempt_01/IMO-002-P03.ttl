@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-P03/ship> ;
            sh:resultMessage "A ship must provide exactly one design ice condition, including the applicable thin first-year ice condition." ;
            sh:resultPath nltl:designIceCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:thinFirstYearIceWithPossibleOldIceInclusions ;
                    sh:maxCount 1 ;
                    sh:message "A ship must provide exactly one design ice condition, including the applicable thin first-year ice condition." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:designIceCondition ] ] .

