@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F02/ship> ;
            sh:resultMessage "When the ship has sea ice origin, no more than one winter of growth, and ice thickness from 0.3 m through 2.0 m, its ice type classification must be first-year ice." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the ship has sea ice origin, no more than one winter of growth, and ice thickness from 0.3 m through 2.0 m, its ice type classification must be first-year ice." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:iceOriginType nltl:seaIceOrigin .
    $this nltl:winterGrowthCount ?growthCount .
    $this nltl:iceThickness ?thicknessNode .
    ?thicknessNode qudt:numericValue ?thickness .
    ?thicknessNode qudt:unit <http://qudt.org/vocab/unit/M> .
    FILTER(
        datatype(?growthCount) = xsd:integer &&
        ?growthCount <= 1 &&
        datatype(?thickness) = xsd:decimal &&
        ?thickness >= 0.3 &&
        ?thickness <= 2.0
    )
    FILTER(
        NOT EXISTS {
            $this nltl:iceTypeClassification nltl:firstYearIce .
        }
        ||
        EXISTS {
            $this nltl:iceTypeClassification ?classification .
            FILTER(?classification != nltl:firstYearIce)
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_004_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F02/ship> ] .

