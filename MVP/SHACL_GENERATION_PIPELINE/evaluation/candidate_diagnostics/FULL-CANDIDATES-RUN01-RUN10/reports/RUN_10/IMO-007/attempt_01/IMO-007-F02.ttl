@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For open water, ice of land origin must not be present.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceOfLandOriginPresent ], [ sh:hasValue nltl:openWaterIceCondition ; sh:message Literal(\"The ship's ice condition classification must identify open water for the open-water constraints to apply.\") ; sh:path nltl:iceConditionClassification ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Open water requires a unitless sea ice concentration less than 1/10.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxExclusive Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For open water, sea ice concentration must be less than 1/10.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Sea ice concentration must use the unitless unit.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:seaIceConcentration ] ] , [ rdf:type sh:NodeShape ; sh:property [ sh:in ( nltl:iceConditionLessSevereThanCategoryAAndB nltl:iceFreeIceCondition nltl:mediumFirstYearIceWithPossibleOldIceInclusions nltl:otherWatersIceCondition nltl:thinFirstYearIceWithPossibleOldIceInclusions ) ; sh:message Literal(\"The ship's ice condition classification must identify a permitted non-open-water condition when the open-water constraints do not apply.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceConditionClassification ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO_007_OpenWaterShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F02/ship> ] .

