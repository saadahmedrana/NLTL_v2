@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F04/ship> ;
            sh:resultMessage "If the ice condition is open water, sea ice concentration must be unitless and less than 1, and ice of land origin must be false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-007-OpenWaterIceConditionShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F04/ship> ] .

