@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F01/ship> ;
            sh:resultMessage "For bergy waters, land-origin ice concentration must be a decimal less than 1 and use the unitless unit." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For bergy waters, land-origin ice concentration must be a decimal less than 1 and use the unitless unit." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceCondition ?condition ;
                      nltl:landOriginIceConcentration ?quantity .
                ?quantity qudt:numericValue ?value ;
                          qudt:unit ?quantityUnit .
                FILTER (STR(?condition) = "bergy waters")
                FILTER (
                    datatype(?value) != xsd:decimal ||
                    ?quantityUnit != unit:UNITLESS ||
                    ?value >= 1
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-009-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F01/ship> ;
            sh:resultMessage "A bergy-waters ship must provide a conforming land-origin ice concentration below 1." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A bergy-waters ship must provide a conforming land-origin ice concentration below 1." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceCondition ?condition .
                FILTER (STR(?condition) = "bergy waters")
                FILTER NOT EXISTS {
                    $this nltl:landOriginIceConcentration ?quantity .
                    ?quantity qudt:numericValue ?value ;
                              qudt:unit unit:UNITLESS .
                    FILTER (
                        datatype(?value) = xsd:decimal &&
                        ?value < 1
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-009-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F01/ship> ] .

