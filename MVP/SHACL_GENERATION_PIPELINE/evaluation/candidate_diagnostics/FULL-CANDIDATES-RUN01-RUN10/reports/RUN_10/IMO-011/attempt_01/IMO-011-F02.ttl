@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F02/ship> ;
            sh:resultMessage "The ship must provide the required dated temperature inputs and externally calculated mean daily low temperature; a data period shorter than 10 years requires approved administration dataset status." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_011_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F02/obs1> ;
                    sh:resultMessage "Less than 1 values on ex:obs1->nltl:dailyLowTemperature" ;
                    sh:resultPath nltl:dailyLowTemperature ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue unit:DEG_C ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:dailyLowTemperature ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:dailyTemperatureObservationDate ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG_C ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:dailyLowTemperature ] ]. See details for more information." ;
            sh:resultPath nltl:hasDailyLowTemperatureObservation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:dailyLowTemperatureObservation ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:DEG_C ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:dailyLowTemperature ],
                                [ sh:datatype xsd:date ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:dailyTemperatureObservationDate ] ] ;
                    sh:path nltl:hasDailyLowTemperatureObservation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F02/obs1> ] .

