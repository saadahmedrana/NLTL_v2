@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/certificate> ;
                    sh:resultMessage "The Polar Ship Certificate form model shall be the Appendix I model." ;
                    sh:resultPath nltl:certificateFormModel ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:certificateFormModelValue ;
                            sh:hasValue nltl:appendixIPolarShipCertificateModel ;
                            sh:maxCount 1 ;
                            sh:message "The Polar Ship Certificate form model shall be the Appendix I model." ;
                            sh:minCount 1 ;
                            sh:path nltl:certificateFormModel ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ;
            sh:resultMessage "The ship shall have a Polar Ship Certificate corresponding to the Appendix I model." ;
            sh:resultPath nltl:hasPolarShipCertificate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall have a Polar Ship Certificate corresponding to the Appendix I model." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-016-CertificateShape> ;
                    sh:path nltl:hasPolarShipCertificate ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/certificate> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("English") ; sh:path nltl:certificateLanguage ] ] , [ sh:property [ sh:hasValue Literal("French") ; sh:path nltl:certificateLanguage ] ] , [ sh:property [ sh:hasValue Literal("Spanish") ; sh:path nltl:certificateLanguage ] ] , [ sh:and ( [ sh:property [ sh:datatype xsd:string ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:certificateLanguage ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A translation into English, French, or Spanish is required when another certificate language is used.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:approvedTranslationPresent ] ] [ sh:sparql [ sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX sh: <http://www.w3.org/ns/shacl#>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                FILTER NOT EXISTS {
                                    $this nltl:certificateLanguage ?language ;
                                          nltl:approvedTranslationPresent ?translation .
                                    FILTER (?language NOT IN ("English", "French", "Spanish"))
                                    FILTER (?translation = true)
                                }
                            }
                        ") ] ] ) ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-016-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ;
            sh:resultMessage "The certificate language shall be recorded exactly once." ;
            sh:resultPath nltl:certificateLanguage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The certificate language shall be recorded exactly once." ;
                    sh:minCount 1 ;
                    sh:path nltl:certificateLanguage ] ] .

