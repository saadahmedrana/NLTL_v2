@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F04/ship> ;
            sh:resultMessage "The ship shall have a Polar Ship Certificate conforming to the required Appendix I model and language rule." ;
            sh:resultPath nltl:hasPolarShipCertificate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall have a Polar Ship Certificate conforming to the required Appendix I model and language rule." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO016CertificateShape ;
                    sh:path nltl:hasPolarShipCertificate ] ] .

