@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-P02/certificate> ;
                    sh:resultMessage "Node ex:certificate must conform to one or more shapes in [ sh:property [ sh:in ( Literal(\"English\") Literal(\"French\") Literal(\"Spanish\") ) ; sh:path nltl:certificateLanguage ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A certificate language other than English, French, or Spanish requires an approved translation.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:approvedTranslationPresent ], [ sh:not [ sh:in ( Literal(\"English\") Literal(\"French\") Literal(\"Spanish\") ) ] ; sh:path nltl:certificateLanguage ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:IMO016CertificateShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-P02/certificate> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-P02/ship> ;
            sh:resultMessage "The ship shall have a Polar Ship Certificate conforming to the required Appendix I model and language rule." ;
            sh:resultPath nltl:hasPolarShipCertificate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall have a Polar Ship Certificate conforming to the required Appendix I model and language rule." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO016CertificateShape ;
                    sh:path nltl:hasPolarShipCertificate ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-P02/certificate> ] .

