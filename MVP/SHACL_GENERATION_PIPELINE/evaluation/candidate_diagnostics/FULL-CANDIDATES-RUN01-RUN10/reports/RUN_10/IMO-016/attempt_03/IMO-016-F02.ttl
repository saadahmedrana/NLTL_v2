@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/certificate> ;
                    sh:resultMessage "The Polar Ship Certificate form shall correspond to the Appendix I model." ;
                    sh:resultPath nltl:certificateFormModel ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue nltl:appendixIPolarShipCertificateModel ;
                            sh:message "The Polar Ship Certificate form shall correspond to the Appendix I model." ;
                            sh:minCount 1 ;
                            sh:path nltl:certificateFormModel ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ;
            sh:resultMessage "A Polar Ship Certificate form corresponding to the Appendix I model is required." ;
            sh:resultPath nltl:hasPolarShipCertificate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A Polar Ship Certificate form corresponding to the Appendix I model is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:polarShipCertificateForm ;
                            sh:property [ sh:hasValue nltl:appendixIPolarShipCertificateModel ;
                                    sh:message "The Polar Ship Certificate form shall correspond to the Appendix I model." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:certificateFormModel ] ] ;
                    sh:path nltl:hasPolarShipCertificate ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/certificate> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ;
            sh:resultMessage "The certificate language shall be English, French, or Spanish, or an approved translation shall be present for another language." ;
            sh:resultPath nltl:certificateLanguage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The certificate language shall be English, French, or Spanish, or an approved translation shall be present for another language." ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:in ( "English" "French" "Spanish" ) ] [ sh:not [ sh:in ( "English" "French" "Spanish" ) ] ;
                                sh:property [ sh:datatype xsd:boolean ;
                                        sh:hasValue true ;
                                        sh:maxCount 1 ;
                                        sh:message "A certificate language other than English, French, or Spanish requires an approved translation." ;
                                        sh:minCount 1 ;
                                        sh:path nltl:approvedTranslationPresent ] ] ) ;
                    sh:path nltl:certificateLanguage ] ] .

