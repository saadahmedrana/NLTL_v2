@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-021-F05/ship> ;
            sh:resultMessage "Any represented applicable Introduction section 3 hazard coverage shall be assessed." ;
            sh:resultPath nltl:assessedCodeHazards ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:in ( true ) ;
                    sh:message "Any represented applicable Introduction section 3 hazard coverage shall be assessed." ;
                    sh:path nltl:assessedCodeHazards ] ;
            sh:value false ] .

