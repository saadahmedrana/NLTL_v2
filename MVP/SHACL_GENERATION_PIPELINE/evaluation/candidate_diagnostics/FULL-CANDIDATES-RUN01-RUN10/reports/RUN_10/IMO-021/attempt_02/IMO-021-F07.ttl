@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-021-F07/ship> ;
            sh:resultMessage "The operational assessment shall cover low-air-temperature operation using a Celsius quantity." ;
            sh:resultPath nltl:assessedLowAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The operational assessment shall cover low-air-temperature operation using a Celsius quantity." ;
                    sh:minCount 1 ;
                    sh:node gs:IMO_021_TemperatureQuantityShape ;
                    sh:path nltl:assessedLowAirTemperature ] ] .

