@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-023-F03/ship> ;
            sh:resultMessage "The ship must record that procedures for normal operations are included or referenced." ;
            sh:resultPath nltl:normalOperationProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n36a8f0f02054429880b7ead632f859a5b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-023-F03/ship> ;
            sh:resultMessage "The ship must record that procedures for normal operations are included or referenced." ;
            sh:resultPath nltl:normalOperationProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n36a8f0f02054429880b7ead632f859a5b1 ] .

_:n36a8f0f02054429880b7ead632f859a5b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record that procedures for normal operations are included or referenced." ;
    sh:minCount 1 ;
    sh:path nltl:normalOperationProcedurePresent .

