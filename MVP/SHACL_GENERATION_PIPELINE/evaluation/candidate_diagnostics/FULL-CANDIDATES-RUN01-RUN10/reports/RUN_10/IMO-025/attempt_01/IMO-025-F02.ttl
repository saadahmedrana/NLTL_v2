@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-025-F02/ship> ;
            sh:resultMessage "The ship must record that the Polar Water Operational Manual is present on board." ;
            sh:resultPath nltl:polarWaterOperationalManualPresentOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n8147d7e98576478887ccbb66d33d9aabb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-025-F02/ship> ;
            sh:resultMessage "The ship must record that the Polar Water Operational Manual is present on board." ;
            sh:resultPath nltl:polarWaterOperationalManualPresentOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n8147d7e98576478887ccbb66d33d9aabb1 ] .

_:n8147d7e98576478887ccbb66d33d9aabb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship must record that the Polar Water Operational Manual is present on board." ;
    sh:minCount 1 ;
    sh:path nltl:polarWaterOperationalManualPresentOnBoard .

