@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-027-F02/ship> ;
            sh:resultMessage "Non-empty arrangements for receiving environmental forecasts are required." ;
            sh:resultPath nltl:environmentalForecastArrangements ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinLengthConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "Non-empty arrangements for receiving environmental forecasts are required." ;
                    sh:minCount 1 ;
                    sh:minLength 1 ;
                    sh:path nltl:environmentalForecastArrangements ] ;
            sh:value ""^^xsd:string ] .

