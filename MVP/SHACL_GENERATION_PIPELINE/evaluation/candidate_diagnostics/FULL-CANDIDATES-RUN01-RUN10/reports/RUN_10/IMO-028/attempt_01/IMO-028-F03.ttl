@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-028-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in <urn:nltl:generated-shape:IMO-028-NotIceStrengthenedBranch> , <urn:nltl:generated-shape:IMO-028-IceStrengthenedBranch>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-028-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-028-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-028-F03/ship> ;
            sh:resultMessage "The ship's ice-strengthening status is required to determine the applicable entrapment-procedure obligation." ;
            sh:resultPath nltl:shipIceStrengthened ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ship's ice-strengthening status is required to determine the applicable entrapment-procedure obligation." ;
                    sh:minCount 1 ;
                    sh:path nltl:shipIceStrengthened ] ] .

