@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:exposedStructureMaterial ] ] , [ sh:property [ sh:datatype xsd:string ; sh:in ( Literal(\"Administration\") Literal(\"recognized organization accepted by the Administration\") ) ; sh:message Literal(\"Approval must be issued by the Administration or a recognized organization accepted by it.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:approvingAuthority ], [ sh:datatype xsd:string ; sh:in ( Literal(\"standard acceptable to the Organization\") Literal(\"another standard offering an equivalent level of safety\") ) ; sh:message Literal(\"Approval must reference an Organization-acceptable standard or an equivalent-safety standard.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:approvalStandard ], [ sh:datatype xsd:string ; sh:message Literal(\"Each applicable exposed-structure material must be represented as a string.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:exposedStructureMaterial ], [ sh:hasValue nltl:evidenceStateApproved ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each applicable exposed-structure material must have approved material approval status.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:materialApprovalStatus ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The approval basis must preserve the polar service temperature in degrees Celsius.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG_C ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:polarServiceTemperature ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_031_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F02/ship> ] .

