@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-032-P04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ; sh:message Literal(\"The ship category must be category A or category B for this approval branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipCategory ], [ sh:message Literal(\"A compliant approval record is required for a category A or B ship.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:ApprovalRecordCategoryABShape ; sh:path nltl:hasApprovalRecord ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The category C ship must be identified as ice strengthened for this approval branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipIceStrengthened ], [ sh:hasValue nltl:polarShipCategoryC ; sh:message Literal(\"The ship category must be category C for this approval branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipCategory ], [ sh:message Literal(\"A compliant approval record with operating ice context is required for an ice-strengthened category C ship.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:ApprovalRecordIceStrengthenedCategoryCShape ; sh:path nltl:hasApprovalRecord ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO032ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-032-P04/ship> ] .

