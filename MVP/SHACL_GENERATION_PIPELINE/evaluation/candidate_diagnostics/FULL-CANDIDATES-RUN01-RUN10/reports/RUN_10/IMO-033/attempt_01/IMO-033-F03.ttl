@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F03/ship> ;
            sh:resultMessage "When ice accretion is likely, discontinuous projected area must equal continuous projected area times 1.05 and discontinuous static moment must equal continuous static moment times 1.10 within a relative tolerance of 1e-6, with an absolute tolerance floor of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When ice accretion is likely, discontinuous projected area must equal continuous projected area times 1.05 and discontinuous static moment must equal continuous static moment times 1.10 within a relative tolerance of 1e-6, with an absolute tolerance floor of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely true ;
                      nltl:continuousSurfaceProjectedArea ?continuousArea ;
                      nltl:discontinuousSurfaceProjectedArea ?discontinuousArea ;
                      nltl:continuousSurfaceStaticMoment ?continuousMoment ;
                      nltl:discontinuousSurfaceStaticMoment ?discontinuousMoment .

                ?continuousArea qudt:numericValue ?continuousAreaValue ;
                                qudt:unit unit:M2 .
                ?discontinuousArea qudt:numericValue ?discontinuousAreaValue ;
                                   qudt:unit unit:M2 .
                ?continuousMoment qudt:numericValue ?continuousMomentValue ;
                                  qudt:unit unit:KiloN-M .
                ?discontinuousMoment qudt:numericValue ?discontinuousMomentValue ;
                                     qudt:unit unit:KiloN-M .

                BIND (?continuousAreaValue * 1.05 AS ?expectedArea)
                BIND (?continuousMomentValue * 1.10 AS ?expectedMoment)
                BIND (IF(ABS(?expectedArea) * 0.000001 > 0.000000001,
                         ABS(?expectedArea) * 0.000001,
                         0.000000001) AS ?areaTolerance)
                BIND (IF(ABS(?expectedMoment) * 0.000001 > 0.000000001,
                         ABS(?expectedMoment) * 0.000001,
                         0.000000001) AS ?momentTolerance)

                FILTER (
                    ?discontinuousAreaValue < (?expectedArea - ?areaTolerance) ||
                    ?discontinuousAreaValue > (?expectedArea + ?areaTolerance) ||
                    ?discontinuousMomentValue < (?expectedMoment - ?momentTolerance) ||
                    ?discontinuousMomentValue > (?expectedMoment + ?momentTolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_033_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-F03/ship> ] .

