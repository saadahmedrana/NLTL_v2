@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F07/ship> ;
            sh:resultMessage "The allowed vertical position must be recorded." ;
            sh:resultPath nltl:allowedVerticalPosition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The allowed vertical position must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:allowedVerticalPosition ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F07/ship> ;
            sh:resultMessage "Vertical damage extent is required in metres." ;
            sh:resultPath nltl:verticalDamageExtent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Vertical damage extent is required in metres." ;
                    sh:minCount 1 ;
                    sh:node gs:QuantityValueMetres ;
                    sh:path nltl:verticalDamageExtent ] ] .

