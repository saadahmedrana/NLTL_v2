@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ;
            sh:resultMessage "Longitudinal and vertical damage extents must satisfy the declared piecewise formulas within the required numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Longitudinal and vertical damage extents must satisfy the declared piecewise formulas within the required numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthNode ;
                      nltl:upperIceWaterlineDraught ?draughtNode ;
                      nltl:longitudinalDamageExtent ?longNode ;
                      nltl:verticalDamageExtent ?verticalNode .

                ?lengthNode <http://qudt.org/schema/qudt/numericValue> ?length .
                ?draughtNode <http://qudt.org/schema/qudt/numericValue> ?draught .
                ?longNode <http://qudt.org/schema/qudt/numericValue> ?reportedLong .
                ?verticalNode <http://qudt.org/schema/qudt/numericValue> ?reportedVertical .

                BIND(
                    IF(
                        ?forward = true,
                        0.045 * ?length,
                        0.015 * ?length
                    )
                    AS ?expectedLong
                )
                BIND(
                    IF(
                        0.20 * ?draught <= ?expectedLong,
                        0.20 * ?draught,
                        ?expectedLong
                    )
                    AS ?expectedVertical
                )

                FILTER (
                    ?reportedLong <
                        (?expectedLong - (?expectedLong * 0.000001 + 0.000000001))
                    ||
                    ?reportedLong >
                        (?expectedLong + (?expectedLong * 0.000001 + 0.000000001))
                    ||
                    ?reportedVertical <
                        (?expectedVertical - (?expectedVertical * 0.000001 + 0.000000001))
                    ||
                    ?reportedVertical >
                        (?expectedVertical + (?expectedVertical * 0.000001 + 0.000000001))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO038Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F01/ship> ] .

