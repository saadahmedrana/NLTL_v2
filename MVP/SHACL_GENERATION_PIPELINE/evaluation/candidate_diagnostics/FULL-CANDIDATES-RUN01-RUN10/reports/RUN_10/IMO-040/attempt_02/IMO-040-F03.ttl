@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F03/hatch1> ;
            sh:resultMessage "A relevant hatch or door must have an associated ice or snow removal or prevention means." ;
            sh:resultPath nltl:hasIceOrSnowRemovalOrPreventionMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceSnowRemovalOrPreventionMeans ;
                    sh:message "A relevant hatch or door must have an associated ice or snow removal or prevention means." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F03/ship> ;
            sh:resultMessage "When ice accretion is likely, every relevant hatch or door must have an associated ice or snow removal or prevention means." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When ice accretion is likely, every relevant hatch or door must have an associated ice or snow removal or prevention means." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely true .
                $this nltl:hasRelevantHatchOrDoor ?hatch .
                FILTER NOT EXISTS {
                    ?hatch nltl:hasIceOrSnowRemovalOrPreventionMeans ?means .
                    ?means a nltl:iceSnowRemovalOrPreventionMeans .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-040-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F03/ship> ] .

