@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F02/ship> ;
            sh:resultMessage "When ice accretion is explicitly likely, every relevant hatch or door must have at least one associated ice or snow removal or prevention means of the canonical means type." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When ice accretion is explicitly likely, every relevant hatch or door must have at least one associated ice or snow removal or prevention means of the canonical means type." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely true .
                $this nltl:hasRelevantHatchOrDoor ?hatch .
                FILTER (
                    NOT EXISTS {
                        ?hatch nltl:hasIceOrSnowRemovalOrPreventionMeans ?means
                    }
                    ||
                    EXISTS {
                        ?hatch nltl:hasIceOrSnowRemovalOrPreventionMeans ?invalidMeans .
                        FILTER NOT EXISTS {
                            ?invalidMeans a nltl:iceSnowRemovalOrPreventionMeans
                        }
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-040-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F02/ship> ] .

