@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "The ship must record hazard protection coverage." ;
            sh:resultPath nltl:hazardProtectionCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n3fbe8f8fc88a49f1b493d5874a378f53b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "The ship must record hazard protection coverage." ;
            sh:resultPath nltl:hazardProtectionCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n3fbe8f8fc88a49f1b493d5874a378f53b1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachinery> ;
                    sh:resultMessage "Each machinery installation must have hazard protection evidence." ;
                    sh:resultPath nltl:hasHazardProtectionEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:message "Each machinery installation must have hazard protection evidence." ;
                            sh:minCount 1 ;
                            sh:path nltl:hasHazardProtectionEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-043-MachineryInstallationShape>. See details for more information." ;
            sh:resultPath nltl:hasMachineryInstallation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:machineryInstallationItem ;
                    sh:node <urn:nltl:generated-shape:IMO-043-MachineryInstallationShape> ;
                    sh:path nltl:hasMachineryInstallation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachinery> ] .

_:n3fbe8f8fc88a49f1b493d5874a378f53b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record hazard protection coverage." ;
    sh:minCount 1 ;
    sh:path nltl:hazardProtectionCoverage .

