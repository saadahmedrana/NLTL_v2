@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/mainMachinery> ;
                    sh:resultMessage "Every associated equipment and applicable hazard combination on a machinery installation must be covered by hazard-protection evidence for that installation." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "Every associated equipment and applicable hazard combination on a machinery installation must be covered by hazard-protection evidence for that installation." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>

            SELECT $this
            WHERE {
                $this nltl:hasAssociatedEquipment ?equipment .
                $this nltl:hasApplicableHazard ?hazard .
                FILTER (?hazard IN (
                    nltl:iceAccretionHazard,
                    nltl:snowAccumulationHazard,
                    nltl:seawaterIceIngestionHazard,
                    nltl:liquidFreezingOrViscosityIncreaseHazard,
                    nltl:seawaterIntakeTemperatureHazard,
                    nltl:snowIngestionHazard
                ))
                FILTER NOT EXISTS {
                    $this nltl:hasHazardProtectionEvidence ?evidence .
                    ?evidence a nltl:evidenceArtifact .
                }
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:IMO_043_MachineryInstallationShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/mainMachinery> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/mainMachinery> ;
                    sh:resultMessage "Each machinery installation with applicable hazards must have hazard-protection evidence." ;
                    sh:resultPath nltl:hasHazardProtectionEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each machinery installation with applicable hazards must have hazard-protection evidence." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:evidenceArtifact ] ;
                            sh:path nltl:hasHazardProtectionEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/ship> ;
            sh:resultMessage "Each represented machinery installation must satisfy the applicable hazard coverage constraints." ;
            sh:resultPath nltl:hasMachineryInstallation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each represented machinery installation must satisfy the applicable hazard coverage constraints." ;
                    sh:node gen:IMO_043_MachineryInstallationShape ;
                    sh:path nltl:hasMachineryInstallation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/mainMachinery> ] .

