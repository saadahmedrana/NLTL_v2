@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F01/ship> ;
            sh:resultMessage "A machinery seawater supply must have ice-ingestion prevention or an approved alternate functionality arrangement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A machinery seawater supply must have ice-ingestion prevention or an approved alternate functionality arrangement." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:machinerySeawaterSupply true .
                FILTER NOT EXISTS {
                    $this nltl:iceIngestionPreventionPresent true .
                }
                FILTER NOT EXISTS {
                    $this nltl:alternateFunctionalityArrangementApprovalStatus
                          nltl:evidenceStateApproved .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-045> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F01/ship> ] .

