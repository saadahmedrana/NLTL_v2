@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-P01/ship> ;
            sh:resultMessage "The material approval must identify the Administration or a recognized organization accepted by it." ;
            sh:resultPath nltl:approvingAuthority ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "Administration" "recognized organization accepted by the Administration" ) ;
                    sh:maxCount 1 ;
                    sh:message "The material approval must identify the Administration or a recognized organization accepted by it." ;
                    sh:minCount 1 ;
                    sh:path nltl:approvingAuthority ] ;
            sh:value "Administration"^^xsd:string ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-P01/ship> ;
            sh:resultMessage "The material approval must identify an Organization-acceptable or equivalent-safety standard." ;
            sh:resultPath nltl:approvalStandard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "standard acceptable to the Organization" "another standard offering an equivalent level of safety" ) ;
                    sh:maxCount 1 ;
                    sh:message "The material approval must identify an Organization-acceptable or equivalent-safety standard." ;
                    sh:minCount 1 ;
                    sh:path nltl:approvalStandard ] ;
            sh:value "standard acceptable to the Organization"^^xsd:string ] .

