@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:exposedMachineryOrFoundationMaterial ] ] , [ sh:property [ sh:datatype xsd:string ; sh:in ( Literal(\"Administration\") Literal(\"recognized organization accepted by the Administration\") ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"An applicable exposed machinery or foundation material must have an authorized approving authority.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:approvingAuthority ], [ sh:datatype xsd:string ; sh:in ( Literal(\"standard acceptable to the Organization\") Literal(\"another standard offering an equivalent level of safety\") ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"An applicable exposed machinery or foundation material must have an accepted or equivalent-safety approval standard.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:approvalStandard ], [ sh:datatype xsd:string ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:exposedMachineryOrFoundationMaterial ], [ sh:hasValue nltl:evidenceStateApproved ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"An applicable exposed machinery or foundation material must have approved material-approval status.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:materialApprovalStatus ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The approval must preserve a polar service temperature basis in degrees Celsius.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG_C ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:polarServiceTemperature ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-048> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F01/ship> ] .

