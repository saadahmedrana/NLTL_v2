@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/ship> ;
            sh:resultMessage "Each applicable Category A or B machinery component must have an approved approval record with an authorized authority and an acceptable or equivalent-safety standard." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each applicable Category A or B machinery component must have an approved approval record with an authorized authority and an acceptable or equivalent-safety standard." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:hasComponent ?component .
                FILTER (
                    ?category = nltl:polarShipCategoryA ||
                    ?category = nltl:polarShipCategoryB
                )
                ?component a nltl:machineryComponent ;
                           nltl:machineryComponentType ?componentType .
                FILTER (
                    DATATYPE(?componentType) = xsd:string &&
                    STR(?componentType) IN (
                        "propeller blade",
                        "propulsion line",
                        "steering equipment",
                        "appendage"
                    )
                )
                FILTER NOT EXISTS {
                    ?component nltl:hasApprovalRecord ?record .
                    ?record a nltl:approvalRecord ;
                            nltl:scantlingApprovalStatus nltl:evidenceStateApproved ;
                            nltl:approvingAuthority ?authority ;
                            nltl:approvalStandard ?standard .
                    FILTER (
                        DATATYPE(?authority) = xsd:string &&
                        STR(?authority) IN (
                            "Administration",
                            "recognized organization accepted by the Administration"
                        )
                    )
                    FILTER (
                        DATATYPE(?standard) = xsd:string &&
                        STR(?standard) IN (
                            "standard acceptable to the Organization",
                            "another standard offering an equivalent level of safety"
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO049ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/ship> ] .

