@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-050-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"The fire-safety component exposure status must be recorded as false when protection is not required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:fireSafetyComponentExposed ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"An exposed fire-safety component must have ice and snow protection.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAndSnowProtectionPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The fire-safety component exposure status must be recorded as true for an exposed fire-safety component.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:fireSafetyComponentExposed ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_050_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-050-F02/ship> ] .

