@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-F01/ship> ;
            sh:resultMessage "Exposed isolating, pressure, or vacuum valves shall have ice accretion protection and remain continuously accessible." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Exposed isolating, pressure, or vacuum valves shall have ice accretion protection and remain continuously accessible." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:valveExposed ?exposed ;
                      nltl:valveType ?type .

                FILTER (?exposed = true)
                FILTER (STR(?type) IN ("isolating", "pressure", "vacuum"))

                FILTER (
                    NOT EXISTS {
                        $this nltl:iceAccretionProtectionPresent true
                    }
                    || EXISTS {
                        $this nltl:iceAccretionProtectionPresent false
                    }
                    || NOT EXISTS {
                        $this nltl:continuouslyAccessible true
                    }
                    || EXISTS {
                        $this nltl:continuouslyAccessible false
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_055_Static_ConditionalShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-F01/ship> ] .

