@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F02/outfit1> ;
                    sh:resultMessage "Each firefighter outfit must have a classified physical storage location." ;
                    sh:resultPath nltl:hasStorageLocation ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:physicalStorageLocation ;
                            sh:message "Each firefighter outfit must have a classified physical storage location." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue nltl:warmStorageLocation ;
                                            sh:message "Each firefighter outfit storage location must have the warm storage-location classification." ;
                                            sh:minCount 1 ;
                                            sh:path nltl:storageTemperatureClass ] ] ;
                            sh:path nltl:hasStorageLocation ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:equipmentItem, nltl:firefighterOutfitItem ; sh:property [ sh:class nltl:physicalStorageLocation ; sh:message Literal(\"Each firefighter outfit must have a classified physical storage location.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:hasValue nltl:warmStorageLocation ; sh:message Literal(\"Each firefighter outfit storage location must have the warm storage-location classification.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:storageTemperatureClass ] ] ; sh:path nltl:hasStorageLocation ] ]. See details for more information." ;
            sh:resultPath nltl:hasFirefighterOutfit ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:equipmentItem,
                                nltl:firefighterOutfitItem ;
                            sh:property [ sh:class nltl:physicalStorageLocation ;
                                    sh:message "Each firefighter outfit must have a classified physical storage location." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue nltl:warmStorageLocation ;
                                                    sh:message "Each firefighter outfit storage location must have the warm storage-location classification." ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:storageTemperatureClass ] ] ;
                                    sh:path nltl:hasStorageLocation ] ] ;
                    sh:path nltl:hasFirefighterOutfit ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F02/outfit1> ] .

