[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-P03/ship> ;
            sh:resultMessage "The ship shall record ice and snow mitigation coverage as true." ;
            sh:resultPath nltl:iceSnowMitigationCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:na9b9505df05c46109aa4d1f53c16f5b1b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-P03/ship> ;
            sh:resultMessage "The ship shall record ice and snow mitigation coverage as true." ;
            sh:resultPath nltl:iceSnowMitigationCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:na9b9505df05c46109aa4d1f53c16f5b1b1 ] .

_:na9b9505df05c46109aa4d1f53c16f5b1b1 sh:datatype xsd:boolean ;
