            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n9df5a655466248d7ac2880191e47c41cb7 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F06/ship> ;
            sh:resultMessage "Thermal-protection adequacy evidence must have approved status." ;
