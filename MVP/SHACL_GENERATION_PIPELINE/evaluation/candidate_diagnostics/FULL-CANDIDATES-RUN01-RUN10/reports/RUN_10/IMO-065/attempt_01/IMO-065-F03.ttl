@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F03/ship> ;
            sh:resultMessage "Protection from cold, wind, and sun must be provided." ;
            sh:resultPath nltl:weatherProtectionPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "Protection from cold, wind, and sun must be provided." ;
                    sh:minCount 1 ;
                    sh:path nltl:weatherProtectionPresent ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F03/maximumExpectedRescueTimeValue> ;
            sh:resultMessage "Node ex:maximumExpectedRescueTimeValue->qudt:unit does not contain a value in the set: ['qudt:DAY']" ;
            sh:resultPath qudt:unit ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue qudt:DAY ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path qudt:unit ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F03/survivalSupportDurationValue> ;
            sh:resultMessage "Node ex:survivalSupportDurationValue->qudt:unit does not contain a value in the set: ['qudt:DAY']" ;
            sh:resultPath qudt:unit ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue qudt:DAY ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path qudt:unit ] ] .

