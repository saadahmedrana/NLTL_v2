@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F08/ship> ;
            sh:resultMessage "The ship exposure-to-ice-accretion applicability value is required and must be a single boolean." ;
            sh:resultPath nltl:shipExposedToIceAccretion ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ship exposure-to-ice-accretion applicability value is required and must be a single boolean." ;
                    sh:minCount 1 ;
                    sh:path nltl:shipExposedToIceAccretion ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F08/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:shipExposedToIceAccretion ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:shipExposedToIceAccretion ], [ sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:hasValue nltl:embarkationAreaProtectedItem ; sh:path nltl:protectedItemCategory ], [ sh:message Literal(\"An embarkation area must have associated means to remove or prevent ice and snow accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasIceSnowRemovalOrPreventionMeans ] ] ], [ sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:hasValue nltl:escapeRouteProtectedItem ; sh:path nltl:protectedItemCategory ], [ sh:message Literal(\"An escape route must have associated means to remove or prevent ice and snow accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasIceSnowRemovalOrPreventionMeans ] ] ], [ sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:hasValue nltl:launchingApplianceProtectedItem ; sh:path nltl:protectedItemCategory ], [ sh:message Literal(\"A launching appliance must have associated means to remove or prevent ice and snow accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasIceSnowRemovalOrPreventionMeans ] ] ], [ sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:hasValue nltl:musterStationProtectedItem ; sh:path nltl:protectedItemCategory ], [ sh:message Literal(\"A muster station must have associated means to remove or prevent ice and snow accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasIceSnowRemovalOrPreventionMeans ] ] ], [ sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:hasValue nltl:survivalCraftAccessProtectedItem ; sh:path nltl:protectedItemCategory ], [ sh:message Literal(\"Access to a survival craft must have associated means to remove or prevent ice and snow accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasIceSnowRemovalOrPreventionMeans ] ] ], [ sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:hasValue nltl:survivalCraftProtectedItem ; sh:path nltl:protectedItemCategory ], [ sh:message Literal(\"A survival craft must have associated means to remove or prevent ice and snow accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasIceSnowRemovalOrPreventionMeans ] ] ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_066_StaticShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F08/ship> ] .

