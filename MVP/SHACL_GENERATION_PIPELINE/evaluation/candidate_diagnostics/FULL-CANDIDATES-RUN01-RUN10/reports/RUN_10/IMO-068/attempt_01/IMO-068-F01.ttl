@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Safe evacuation means must be present when the ship operates in ice-covered waters.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:safeEvacuationMeansPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The ship must record operation in ice-covered waters as true for this applicability branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipOperatesInIceCoveredWaters ], [ sh:hasValue nltl:evidenceStateApproved ; sh:message Literal(\"Survival equipment deployment approval status must be approved when the ship operates in ice-covered waters.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:survivalEquipmentDeploymentApprovalStatus ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Safe evacuation means must be present when direct evacuation onto the ice is applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:safeEvacuationMeansPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The ship must record direct evacuation onto the ice as applicable for this applicability branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:directEvacuationOntoIceApplicable ], [ sh:hasValue nltl:evidenceStateApproved ; sh:message Literal(\"Survival equipment deployment approval status must be approved when direct evacuation onto the ice is applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:survivalEquipmentDeploymentApprovalStatus ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_068_StaticShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-F01/ship> ] .

