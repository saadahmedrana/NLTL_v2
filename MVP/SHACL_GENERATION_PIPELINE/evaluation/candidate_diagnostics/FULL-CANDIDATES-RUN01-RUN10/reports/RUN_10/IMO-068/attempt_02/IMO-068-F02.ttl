@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-F02/ship> ;
            sh:resultMessage "When operating in ice-covered waters or evacuating directly onto the ice, safe evacuation means and approved survival equipment deployment are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_068_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-F02/ship> ] .

