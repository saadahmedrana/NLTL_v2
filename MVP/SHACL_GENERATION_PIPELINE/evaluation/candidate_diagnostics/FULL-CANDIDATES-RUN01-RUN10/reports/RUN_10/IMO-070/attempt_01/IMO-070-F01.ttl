@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "A passenger ship must establish that assigned personal survival equipment is properly sized." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:na0e9c4a5531348f789355ba6e628c053b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "A passenger ship must establish that assigned personal survival equipment is properly sized." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:na0e9c4a5531348f789355ba6e628c053b1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/person1> ;
                    sh:resultMessage "Each person on board must have a personal survival equipment assignment." ;
                    sh:resultPath nltl:hasPersonalSurvivalEquipmentAssignment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:personalSurvivalEquipmentAssignment ;
                            sh:message "Each person on board must have a personal survival equipment assignment." ;
                            sh:minCount 1 ;
                            sh:node gen:IMO070AssignmentShape ;
                            sh:path nltl:hasPersonalSurvivalEquipmentAssignment ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "Each linked person on board must have a compliant personal survival equipment assignment." ;
            sh:resultPath nltl:hasPersonOnBoardMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:personOnBoardMember ;
                    sh:message "Each linked person on board must have a compliant personal survival equipment assignment." ;
                    sh:node gen:IMO070PersonOnBoardMemberShape ;
                    sh:path nltl:hasPersonOnBoardMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/person1> ] .

_:na0e9c4a5531348f789355ba6e628c053b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "A passenger ship must establish that assigned personal survival equipment is properly sized." ;
    sh:minCount 1 ;
    sh:path nltl:sizeCompatibilityStatus .

