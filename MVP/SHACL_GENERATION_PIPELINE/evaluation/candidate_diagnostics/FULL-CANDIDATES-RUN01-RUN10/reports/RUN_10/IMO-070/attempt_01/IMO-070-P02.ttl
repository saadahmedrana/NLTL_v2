@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P02/ship> ;
            sh:resultMessage "A passenger ship must establish that assigned personal survival equipment is properly sized." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:na0e9c4a5531348f789355ba6e628c053b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P02/ship> ;
            sh:resultMessage "A passenger ship must establish that assigned personal survival equipment is properly sized." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:na0e9c4a5531348f789355ba6e628c053b1 ] .

_:na0e9c4a5531348f789355ba6e628c053b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "A passenger ship must establish that assigned personal survival equipment is properly sized." ;
    sh:minCount 1 ;
    sh:path nltl:sizeCompatibilityStatus .

