@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:class nltl:passengerShip ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A passenger ship must report compatible sizing for the assigned personal survival equipment.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sizeCompatibilityStatus ], [ sh:node [ sh:class nltl:personOnBoardMember ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each person on board must have exactly one personal survival equipment assignment.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasPersonalSurvivalEquipmentAssignment ; sh:qualifiedMaxCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:class nltl:personalSurvivalEquipmentAssignment ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each assignment must identify exactly one immersion suit or thermal protective aid equipment item.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:assignedPersonalSurvivalEquipment ; sh:qualifiedMaxCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:or ( [ sh:class nltl:immersionSuitEquipment ] [ sh:class nltl:thermalProtectiveAidEquipment ] ) ] ] ] ] ] ; sh:path nltl:hasPersonOnBoardMember ] ] , [ sh:not [ sh:class nltl:passengerShip ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-070-PolarSurvivalEquipment> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ] .

