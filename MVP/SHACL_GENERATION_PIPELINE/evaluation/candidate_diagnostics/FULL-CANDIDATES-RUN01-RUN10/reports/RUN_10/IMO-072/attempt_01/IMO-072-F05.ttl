@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Extended darkness operation must be recorded as true when this requirement applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendedDarknessOperation ], [ sh:node [ sh:class nltl:lifeboat ; sh:property [ sh:message Literal(\"Each lifeboat must have an assigned searchlight during extended darkness operation.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:searchlight ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Each assigned searchlight must be suitable for continuous use.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:searchlightContinuousUseSuitabilityStatus ] ] ; sh:path nltl:hasAssignedSearchlight ] ] ; sh:path nltl:hasLifeboat ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"Extended darkness operation must be explicitly recorded as false when this requirement does not apply.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendedDarknessOperation ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-072> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F05/ship> ] .

