@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F02/ship> ;
            sh:resultMessage "When additional equipment is carried, survival craft capacity must be at least the persons capacity requirement plus the additional equipment capacity requirement, and launching appliance capacity must be at least the loaded survival craft requirement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When additional equipment is carried, survival craft capacity must be at least the persons capacity requirement plus the additional equipment capacity requirement, and launching appliance capacity must be at least the loaded survival craft requirement." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:additionalEquipmentCarriedInSurvivalCraft true .
                $this nltl:personsCapacityRequirement ?persons .
                $this nltl:additionalEquipmentCapacityRequirement ?additional .
                $this nltl:survivalCraftAvailableCapacity ?available .
                $this nltl:loadedSurvivalCraftRequirement ?loadedQuantity .
                ?loadedQuantity qudt:numericValue ?loaded .
                $this nltl:launchingApplianceCapacity ?launchQuantity .
                ?launchQuantity qudt:numericValue ?launchCapacity .
                FILTER (
                    ?available < (?persons + ?additional)
                    || ?launchCapacity < ?loaded
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_077_StaticCalculationShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F02/ship> ] .

