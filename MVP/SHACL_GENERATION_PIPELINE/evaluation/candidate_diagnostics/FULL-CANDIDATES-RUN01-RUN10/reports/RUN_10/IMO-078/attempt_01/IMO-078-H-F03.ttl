@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F03/passenger1> ;
                    sh:resultMessage "Each linked passenger must have completed personal-survival-equipment instruction." ;
                    sh:resultPath nltl:personalSurvivalEquipmentInstructionCompleted ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n3547c208f53045fe8321edadfd54da98b1 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F03/passenger1> ;
                    sh:resultMessage "Each linked passenger must have completed personal-survival-equipment instruction." ;
                    sh:resultPath nltl:personalSurvivalEquipmentInstructionCompleted ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n3547c208f53045fe8321edadfd54da98b1 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:PassengerTrainingShape. See details for more information." ;
            sh:resultPath nltl:hasPassenger ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gs:PassengerTrainingShape ;
                    sh:path nltl:hasPassenger ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F03/passenger1> ] .

_:n3547c208f53045fe8321edadfd54da98b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Each linked passenger must have completed personal-survival-equipment instruction." ;
    sh:minCount 1 ;
    sh:path nltl:personalSurvivalEquipmentInstructionCompleted .

