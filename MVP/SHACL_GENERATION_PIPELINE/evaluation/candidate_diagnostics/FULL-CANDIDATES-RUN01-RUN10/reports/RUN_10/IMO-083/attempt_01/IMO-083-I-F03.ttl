@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:iceAccretionLikely ], [ sh:node <urn:nltl:generated-shape:IMO-083-AntennaShape> ; sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:iceAccretionLikely ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-083-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F03/ship> ;
            sh:resultMessage "The ice-accretion applicability value must be recorded as a single boolean." ;
            sh:resultPath nltl:iceAccretionLikely ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ice-accretion applicability value must be recorded as a single boolean." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceAccretionLikely ] ] .

