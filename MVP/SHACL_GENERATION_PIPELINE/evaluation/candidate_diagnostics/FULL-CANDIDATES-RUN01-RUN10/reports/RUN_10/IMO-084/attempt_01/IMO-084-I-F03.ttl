@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-084-I-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"The below-hull sensor applicability state must be recorded as false when the protection requirement does not apply.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:requiredSensorProjectsBelowHull ] ] , [ sh:and ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The below-hull sensor applicability state must be recorded as true when such sensors project below the hull.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:requiredSensorProjectsBelowHull ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Sensors projecting below the hull must be protected against ice.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sensorIceProtectionPresent ] ] ) ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-084-conditional-sensor-ice-protection> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-084-I-F03/ship> ] .

