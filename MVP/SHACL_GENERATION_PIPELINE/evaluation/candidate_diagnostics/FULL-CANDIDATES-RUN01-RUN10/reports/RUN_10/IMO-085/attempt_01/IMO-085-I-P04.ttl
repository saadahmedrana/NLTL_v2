@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-P04/ship> ;
            sh:resultMessage "The construction date is required and must be on or after 1 January 2017." ;
            sh:resultPath nltl:constructionDate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:date ;
                    sh:maxCount 1 ;
                    sh:message "The construction date is required and must be on or after 1 January 2017." ;
                    sh:minCount 1 ;
                    sh:minInclusive "2017-01-01"^^xsd:date ;
                    sh:path nltl:constructionDate ] ;
            sh:value "2016-12-31"^^xsd:date ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-P04/ship> ;
            sh:resultMessage "For an applicable Category A or B ship, the bridge wings must be enclosed or have an approved protection design." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-085-Static> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-P04/ship> ] .

