@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F04/ship> ;
            sh:resultMessage "A ship must provide one planned or actual latitude as a decimal degree quantity." ;
            sh:resultPath nltl:plannedOrActualLatitude ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A ship must provide one planned or actual latitude as a decimal degree quantity." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-087-LatitudeQuantityShape> ;
                    sh:path nltl:plannedOrActualLatitude ] ] .

