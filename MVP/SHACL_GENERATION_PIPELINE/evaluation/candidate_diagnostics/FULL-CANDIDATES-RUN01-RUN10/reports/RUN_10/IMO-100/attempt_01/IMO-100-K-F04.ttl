            sh:sourceShape _:n97518ddd688b45e48c6b0a4b532bd73ab1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-F04/ship> ;
            sh:resultMessage "The ship shall record that a voyage plan is present." ;
