@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F04/routePlan> ;
                    sh:resultMessage "The polar-route planning record must indicate coverage of all required voyage-planning topics." ;
                    sh:resultPath nltl:voyagePlanningTopicCoverage ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "The polar-route planning record must indicate coverage of all required voyage-planning topics." ;
                            sh:minCount 1 ;
                            sh:path nltl:voyagePlanningTopicCoverage ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F04/ship> ;
            sh:resultMessage "The ship must have a polar-route planning record covering all required voyage-planning topics." ;
            sh:resultPath nltl:hasPolarRoutePlan ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must have a polar-route planning record covering all required voyage-planning topics." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:polarRoutePlan ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:in ( true ) ;
                                    sh:message "The polar-route planning record must indicate coverage of all required voyage-planning topics." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:voyagePlanningTopicCoverage ] ] ;
                    sh:path nltl:hasPolarRoutePlan ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F04/routePlan> ] .

