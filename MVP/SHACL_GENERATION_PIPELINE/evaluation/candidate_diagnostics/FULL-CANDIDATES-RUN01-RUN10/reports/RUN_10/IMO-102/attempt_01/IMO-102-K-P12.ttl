@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P12/ship> ;
            sh:resultMessage "Each applicable crew member must have a training record with a matching required and recorded training level and a valid STCW qualification." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each applicable crew member must have a training record with a matching required and recorded training level and a valid STCW qualification." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?member
            WHERE {
                $this nltl:hasCrewMemberInventory ?member ;
                      nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType .
                ?member nltl:polarTrainingCrewRoleClassification ?role .

                FILTER (
                    (
                        ?ice = nltl:openWaterIceCondition &&
                        (?shipType = nltl:tankerPolarTrainingShipType ||
                         ?shipType = nltl:passengerShipPolarTrainingShipType) &&
                        (?role = nltl:masterPolarTrainingRole ||
                         ?role = nltl:chiefMatePolarTrainingRole ||
                         ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole)
                    ) ||
                    (
                        ?ice = nltl:otherWatersIceCondition &&
                        (?shipType = nltl:tankerPolarTrainingShipType ||
                         ?shipType = nltl:passengerShipPolarTrainingShipType ||
                         ?shipType = nltl:otherShipPolarTrainingType) &&
                        (?role = nltl:masterPolarTrainingRole ||
                         ?role = nltl:chiefMatePolarTrainingRole ||
                         ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole)
                    )
                )

                FILTER NOT EXISTS {
                    ?member (nltl:hasCrewTrainingRecord|nltl:hasPolarTrainingRecord) ?record .
                    ?record nltl:requiredTrainingLevel ?required ;
                            nltl:trainingRecordLevel ?recorded ;
                            nltl:stcwQualificationValid true .

                    FILTER (
                        (
                            ?ice = nltl:openWaterIceCondition &&
                            (?shipType = nltl:tankerPolarTrainingShipType ||
                             ?shipType = nltl:passengerShipPolarTrainingShipType) &&
                            (?role = nltl:masterPolarTrainingRole ||
                             ?role = nltl:chiefMatePolarTrainingRole ||
                             ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole) &&
                            ?required = nltl:basicPolarTrainingLevel &&
                            ?recorded = nltl:basicPolarTrainingLevel
                        ) ||
                        (
                            ?ice = nltl:otherWatersIceCondition &&
                            (?shipType = nltl:tankerPolarTrainingShipType ||
                             ?shipType = nltl:passengerShipPolarTrainingShipType ||
                             ?shipType = nltl:otherShipPolarTrainingType) &&
                            (?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole) &&
                            ?required = nltl:basicPolarTrainingLevel &&
                            ?recorded = nltl:basicPolarTrainingLevel
                        ) ||
                        (
                            ?ice = nltl:otherWatersIceCondition &&
                            (?shipType = nltl:tankerPolarTrainingShipType ||
                             ?shipType = nltl:passengerShipPolarTrainingShipType ||
                             ?shipType = nltl:otherShipPolarTrainingType) &&
                            (?role = nltl:masterPolarTrainingRole ||
                             ?role = nltl:chiefMatePolarTrainingRole) &&
                            ?required = nltl:advancedPolarTrainingLevel &&
                            ?recorded = nltl:advancedPolarTrainingLevel
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO102ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P12/ship> ] .

