@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P17/crew> ;
            sh:resultMessage "Each represented crew member must have a crew training record relationship." ;
            sh:resultPath nltl:hasCrewTrainingRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Each represented crew member must have a crew training record relationship." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasCrewTrainingRecord ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P17/crew> ;
            sh:resultMessage "Each represented crew member must have the required polar training evidence relationship." ;
            sh:resultPath nltl:hasPolarTrainingRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Each represented crew member must have the required polar training evidence relationship." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasPolarTrainingRecord ] ] .

