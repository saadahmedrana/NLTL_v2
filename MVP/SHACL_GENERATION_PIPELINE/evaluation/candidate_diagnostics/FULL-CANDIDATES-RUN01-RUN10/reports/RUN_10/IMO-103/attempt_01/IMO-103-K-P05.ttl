@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-103-K-P05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:IMO_103_AlternateFalse , gen:IMO_103_AlternateTrue" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_103_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-103-K-P05/ship> ] .

