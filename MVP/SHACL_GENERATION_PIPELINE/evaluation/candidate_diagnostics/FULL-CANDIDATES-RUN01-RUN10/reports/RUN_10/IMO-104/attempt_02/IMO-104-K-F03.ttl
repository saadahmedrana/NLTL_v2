@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "The ship must identify its crew members and their PWOM familiarization information." ;
            sh:resultPath nltl:hasCrewMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must identify its crew members and their PWOM familiarization information." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO104CrewMemberShape ;
                    sh:path nltl:hasCrewMember ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "The ship must record completed familiarization for relevant PWOM procedures and equipment." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n827ec37ce9804a36a8b541bffca60ea1b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "The ship must record completed familiarization for relevant PWOM procedures and equipment." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n827ec37ce9804a36a8b541bffca60ea1b1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/crew1> ;
                    sh:resultMessage "Each crew member must have the assigned-duty information needed to identify relevant PWOM items." ;
                    sh:resultPath nltl:hasAssignedDuty ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each crew member must have the assigned-duty information needed to identify relevant PWOM items." ;
                            sh:minCount 1 ;
                            sh:node gen:IMO104AssignedDutyShape ;
                            sh:path nltl:hasAssignedDuty ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "The ship must provide the declared crew-member inventory for validation." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the declared crew-member inventory for validation." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO104CrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/crew1> ] .

_:n827ec37ce9804a36a8b541bffca60ea1b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record completed familiarization for relevant PWOM procedures and equipment." ;
    sh:minCount 1 ;
    sh:path nltl:polarWaterOperationalManualFamiliarizationStatus .

