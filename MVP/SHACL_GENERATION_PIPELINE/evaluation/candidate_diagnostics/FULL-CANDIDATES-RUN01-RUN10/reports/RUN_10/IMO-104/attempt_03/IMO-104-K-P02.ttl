@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-P02/ship> ;
            sh:resultMessage "The ship must record completed PWOM familiarization status." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nefcb3a7142d744ef9276f1b4d938994ab1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-P02/ship> ;
            sh:resultMessage "The ship must identify its crew members and their familiarization records." ;
            sh:resultPath nltl:hasCrewMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:crewMember ;
                    sh:message "The ship must identify its crew members and their familiarization records." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-104-CrewMemberShape> ;
                    sh:path nltl:hasCrewMember ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-P02/ship> ;
            sh:resultMessage "The ship must record completed PWOM familiarization status." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nefcb3a7142d744ef9276f1b4d938994ab1 ] .

_:nefcb3a7142d744ef9276f1b4d938994ab1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record completed PWOM familiarization status." ;
    sh:minCount 1 ;
    sh:path nltl:polarWaterOperationalManualFamiliarizationStatus .

