@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The paragraph 1.1.1 oil-discharge prohibition must be recorded as not applicable for clean ballast.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ], [ sh:hasValue nltl:cleanBallastMaterial ; sh:path nltl:dischargedMaterialClassification ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The paragraph 1.1.1 oil-discharge prohibition must be recorded as not applicable for segregated ballast.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ], [ sh:hasValue nltl:segregatedBallastMaterial ; sh:path nltl:dischargedMaterialClassification ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-106-Static> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F04/ship> ;
            sh:resultMessage "A discharged material classification is required to determine whether the paragraph 1.1.1 prohibition applies." ;
            sh:resultPath nltl:dischargedMaterialClassification ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A discharged material classification is required to determine whether the paragraph 1.1.1 prohibition applies." ;
                    sh:minCount 1 ;
                    sh:path nltl:dischargedMaterialClassification ] ] .

