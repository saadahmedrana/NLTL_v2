@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For clean ballast discharge, paragraph 1.1.1 oil-discharge prohibition applicability must be recorded as exactly one false boolean.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ], [ sh:hasValue nltl:cleanBallastMaterial ; sh:path nltl:dischargedMaterialClassification ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For segregated ballast discharge, paragraph 1.1.1 oil-discharge prohibition applicability must be recorded as exactly one false boolean.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ], [ sh:hasValue nltl:segregatedBallastMaterial ; sh:path nltl:dischargedMaterialClassification ] ] , [ sh:not [ sh:property [ sh:hasValue nltl:cleanBallastMaterial ; sh:path nltl:dischargedMaterialClassification ] ], [ sh:property [ sh:hasValue nltl:segregatedBallastMaterial ; sh:path nltl:dischargedMaterialClassification ] ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-106> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F02/ship> ] .

