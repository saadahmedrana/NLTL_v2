@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-F05/ship> ;
            sh:resultMessage "The ship's polar-waters applicability status must be provided as one boolean value." ;
            sh:resultPath nltl:shipOperatesInPolarWaters ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ship's polar-waters applicability status must be provided as one boolean value." ;
                    sh:minCount 1 ;
                    sh:path nltl:shipOperatesInPolarWaters ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in nltlgen:IMO107NotApplicableShape , nltlgen:IMO107ApplicableShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:IMO107Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-F05/ship> ] .

