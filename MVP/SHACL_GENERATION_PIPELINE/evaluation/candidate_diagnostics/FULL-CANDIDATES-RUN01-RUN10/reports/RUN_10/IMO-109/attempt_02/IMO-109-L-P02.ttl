@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-P02/ship> ;
            sh:resultMessage "For a Category A or B ship constructed on or after 1 January 2017, which is not an oil tanker and carries oil in its cargo tanks, cargo tank outer-shell separation must be at least 0.76 m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a Category A or B ship constructed on or after 1 January 2017, which is not an oil tanker and carries oil in its cargo tanks, cargo tank outer-shell separation must be at least 0.76 m." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:shipType ?shipType ;
                      nltl:constructionDate ?constructionDate ;
                      nltl:cargoTankCarriesOil ?carriesOil .

                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                    && datatype(?shipType) = xsd:string
                    && ?constructionDate >= "2017-01-01"^^xsd:date
                    && ?carriesOil = true
                )

                FILTER NOT EXISTS {
                    $this a nltl:oilTanker
                }

                FILTER NOT EXISTS {
                    $this nltl:cargoTankOuterShellSeparation ?separation .
                    ?separation a qudt:QuantityValue ;
                                qudt:numericValue ?value ;
                                qudt:unit unit:M .
                    FILTER (
                        datatype(?value) = xsd:decimal
                        && ?value >= "0.76"^^xsd:decimal
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO109ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-109-L-P02/ship> ] .

