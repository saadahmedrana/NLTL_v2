@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-110-L-P03/ship> ;
            sh:resultMessage "The wing tanks or spaces must have compliant protection." ;
            sh:resultPath nltl:wingTankProtectionStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The wing tanks or spaces must have compliant protection." ;
                    sh:minCount 1 ;
                    sh:path nltl:wingTankProtectionStatus ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-110-L-P03/deadweightValue> ;
                    sh:resultMessage "Value is not < Literal(\"5000\", datatype=xsd:decimal)" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MaxExclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:maxExclusive 5000.0 ;
                            sh:minCount 1 ;
                            sh:path qudt:numericValue ] ;
                    sh:value 5000.0 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-110-L-P03/ship> ;
            sh:resultMessage "The ship deadweight must be a single metric-tonne quantity below 5,000 tonnes." ;
            sh:resultPath nltl:deadweight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship deadweight must be a single metric-tonne quantity below 5,000 tonnes." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:TON_Metric ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxExclusive 5000.0 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:deadweight ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-110-L-P03/deadweightValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-110-L-P03/ship> ;
            sh:resultMessage "The entire cargo tank length must have compliant double-bottom protection." ;
            sh:resultPath nltl:entireCargoTankLengthDoubleBottomProtectionStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The entire cargo tank length must have compliant double-bottom protection." ;
                    sh:minCount 1 ;
                    sh:path nltl:entireCargoTankLengthDoubleBottomProtectionStatus ] ] .

