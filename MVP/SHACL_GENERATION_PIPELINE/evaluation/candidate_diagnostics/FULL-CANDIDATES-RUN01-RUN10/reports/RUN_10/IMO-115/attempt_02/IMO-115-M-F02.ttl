@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-115-M-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Comminuted and disinfected sewage must comply with MARPOL Annex IV regulation 11.1.1.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus ], [ sh:datatype xsd:string ; sh:hasValue Literal("comminuted_and_disinfected") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:sewageDischargeType ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A nautical-mile distance from the qualifying ice-concentration area must be recorded.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MI_N ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The recorded qualifying ice concentration must exceed one tenth.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minExclusive Literal("0.1", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:iceConcentration ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The ship must be more than three nautical miles from any ice shelf or fast ice.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minExclusive Literal("3", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MI_N ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:distanceToNearestIceShelfOrFastIce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:nearbyIceConcentration ] ] , [ sh:sparql [ sh:message Literal("The conditional sewage-discharge requirements apply only when the discharge type is comminuted and disinfected.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:sewageDischargeType ?dischargeType .
                        FILTER (?dischargeType != "comminuted_and_disinfected"^^xsd:string)
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-115-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-115-M-F02/ship> ] .

