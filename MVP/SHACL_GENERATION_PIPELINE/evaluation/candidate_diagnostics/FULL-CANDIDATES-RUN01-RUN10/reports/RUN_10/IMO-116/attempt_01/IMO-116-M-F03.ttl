@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-F03/ship> ;
            sh:resultMessage "For areas with ice concentration exceeding 1/10, the distance from that area must be recorded in nautical miles." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For areas with ice concentration exceeding 1/10, the distance from that area must be recorded in nautical miles." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:nearbyIceConcentration ?concentration .
                ?concentration qudt:numericValue ?iceValue ;
                               qudt:unit unit:UNITLESS .
                FILTER(datatype(?iceValue) = xsd:decimal)
                FILTER(?iceValue > 1)

                FILTER NOT EXISTS {
                    $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?distance .
                    ?distance qudt:numericValue ?distanceValue ;
                              qudt:unit unit:MI_N .
                    FILTER(datatype(?distanceValue) = xsd:decimal)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-116-Static> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-F03/ship> ] .

