@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F02/ship> ;
            sh:resultMessage "For a Category A or B ship, or a passenger ship, constructed on or after 1 January 2017, sewage discharge to sea must be false unless it is compliant with paragraph 4.2.1.3." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a Category A or B ship, or a passenger ship, constructed on or after 1 January 2017, sewage discharge to sea must be false unless it is compliant with paragraph 4.2.1.3." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionDate ?date .
                FILTER (?date >= "2017-01-01"^^xsd:date)

                FILTER (
                    EXISTS {
                        $this nltl:shipCategory ?category .
                        FILTER (
                            ?category = nltl:polarShipCategoryA
                            || ?category = nltl:polarShipCategoryB
                        )
                    }
                    || EXISTS {
                        $this a nltl:passengerShip .
                    }
                )

                FILTER NOT EXISTS {
                    $this nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ?status .
                    FILTER (?status = true)
                }

                FILTER (
                    NOT EXISTS {
                        $this nltl:sewageDischargeToSea ?discharge .
                    }
                    || EXISTS {
                        $this nltl:sewageDischargeToSea ?discharge .
                        FILTER (?discharge != false)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-118> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F02/ship> ] .

