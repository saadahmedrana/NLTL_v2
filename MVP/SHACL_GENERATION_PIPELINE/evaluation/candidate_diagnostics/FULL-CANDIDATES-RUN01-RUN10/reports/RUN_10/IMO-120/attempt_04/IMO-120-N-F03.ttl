@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-F03/ship> ;
            sh:resultMessage "Node ex:ship->nltl:arcticWaters does not contain a value in the set: ['Literal(\"Arctic_waters\")']" ;
            sh:resultPath nltl:arcticWaters ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:hasValue "Arctic_waters" ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:arcticWaters ] ] .

