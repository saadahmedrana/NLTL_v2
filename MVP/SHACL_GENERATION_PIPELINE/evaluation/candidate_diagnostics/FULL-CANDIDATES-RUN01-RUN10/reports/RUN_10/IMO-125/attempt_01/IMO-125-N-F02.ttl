@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInPolarWaters ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Polar operation coverage shall be included in the applicable Garbage Management Plan.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:garbageManagementPlanPolarCoverage ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Polar operation coverage shall be included on the applicable garbage placards.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:garbagePlacardPolarCoverage ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Polar operation coverage shall be recorded in the applicable Garbage Record Book.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:garbageRecordBookPolarCoverage ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInPolarWaters ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO125GarbageCoverageShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F02/ship> ] .

