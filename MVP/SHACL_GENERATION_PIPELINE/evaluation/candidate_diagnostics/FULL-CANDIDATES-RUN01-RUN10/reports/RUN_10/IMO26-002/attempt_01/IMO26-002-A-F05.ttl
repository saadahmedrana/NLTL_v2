@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in <urn:nltl:generated-shape:IMO26-002-FishingApplicable> , <urn:nltl:generated-shape:IMO26-002-FishingNotApplicable> , <urn:nltl:generated-shape:IMO26-002-YachtApplicable> , <urn:nltl:generated-shape:IMO26-002-YachtNotApplicable> , <urn:nltl:generated-shape:IMO26-002-CargoApplicable> , <urn:nltl:generated-shape:IMO26-002-CargoNotApplicable> , <urn:nltl:generated-shape:IMO26-002-OtherType>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-002-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F05/ship> ] .

