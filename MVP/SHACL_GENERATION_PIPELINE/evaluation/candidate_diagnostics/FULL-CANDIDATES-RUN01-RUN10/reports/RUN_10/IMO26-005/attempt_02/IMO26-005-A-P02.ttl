@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P02/ship> ;
            sh:resultMessage "Every supplied heading-reference or position-fixing system must have an intended area and an Approved suitability status." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Every supplied heading-reference or position-fixing system must have an intended area and an Approved suitability status." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:headingOrPositionSystem ?system .
                FILTER NOT EXISTS {
                    $this nltl:intendedArea ?area ;
                          nltl:intendedAreaSuitabilityApprovalStatus nltl:evidenceStateApproved .
                    FILTER (
                        isLiteral(?area) &&
                        datatype(?area) = xsd:string
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-005-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P02/ship> ] .

