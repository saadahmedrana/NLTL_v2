@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F01/heading1> ;
                    sh:resultMessage "Each non-magnetic heading means shall identify an independent non-magnetic heading means." ;
                    sh:resultPath nltl:independentFromHeadingMeans ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:nonMagneticHeadingMeans ;
                            sh:message "Each non-magnetic heading means shall identify an independent non-magnetic heading means." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:independentFromHeadingMeans ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F01/heading1> ;
                    sh:resultMessage "Each non-magnetic heading means shall be independent from another distinct heading means belonging to the same ship." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Each non-magnetic heading means shall be independent from another distinct heading means belonging to the same ship." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    ?ship nltl:hasNonMagneticHeadingMeans $this .
                    $this nltl:independentFromHeadingMeans ?other .
                    ?ship nltl:hasNonMagneticHeadingMeans ?other .
                    FILTER (?other != $this)
                }
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:IMO26-012-HeadingMeansShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F01/heading1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO26-012-HeadingMeansShape>. See details for more information." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:nonMagneticHeadingMeans ;
                    sh:node <urn:nltl:generated-shape:IMO26-012-HeadingMeansShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasNonMagneticHeadingMeans ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F01/heading1> ] .

