                    sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F05/heading1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO26-012-HeadingMeansShape>. See details for more information." ;
