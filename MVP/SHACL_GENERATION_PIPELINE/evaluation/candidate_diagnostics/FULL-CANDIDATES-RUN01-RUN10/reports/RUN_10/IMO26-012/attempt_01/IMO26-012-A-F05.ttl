_:n82463b8561fd423185da0482de165fe2b1 sh:class nltl:nonMagneticHeadingMeans ;
    sh:node <urn:nltl:generated-shape:IMO26-012-HeadingMeansShape> ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasNonMagneticHeadingMeans .

_:n82463b8561fd423185da0482de165fe2b5 sh:message "Each non-magnetic heading means shall be independent from another distinct heading means belonging to the same ship." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    ?ship nltl:hasNonMagneticHeadingMeans $this .
                    $this nltl:independentFromHeadingMeans ?other .
                    ?ship nltl:hasNonMagneticHeadingMeans ?other .
                    FILTER (?other != $this)
                }
            }
        """ .

