@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F06/ship> ;
            sh:resultMessage "A ship must provide one gross tonnage value to establish applicability." ;
            sh:resultPath nltl:grossTonnage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A ship must provide one gross tonnage value to establish applicability." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO26_012_GrossTonnageShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:grossTonnage ] ] .

