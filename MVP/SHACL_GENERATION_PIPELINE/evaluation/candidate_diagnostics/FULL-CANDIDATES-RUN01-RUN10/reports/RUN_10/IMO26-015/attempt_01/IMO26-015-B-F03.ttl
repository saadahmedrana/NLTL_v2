@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-015-B-F03/ship> ;
            sh:resultMessage "SOLAS chapter I certification and Polar Code chapter 11 applicability must correspond." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO26_015_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-015-B-F03/ship> ] .

