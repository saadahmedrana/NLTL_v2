@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-017-B-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:polarCodeChapter11Dash1Applicable ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When Polar Code chapter 11-1 applies, a voyage plan shall be present.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:voyagePlanPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When Polar Code chapter 11-1 applies, the voyage plan shall cover every intended voyage hazard.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:voyagePlanCoverage ], [ sh:datatype xsd:string ; sh:path nltl:intendedVoyageHazard ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:polarCodeChapter11Dash1Applicable ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO26_017_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-017-B-F01/ship> ] .

