@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-018-B-F04/ship> ;
            sh:resultMessage "Safety management system status must be provided as a boolean." ;
            sh:resultPath nltl:safetyManagementSystemImplemented ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "Safety management system status must be provided as a boolean." ;
                    sh:minCount 1 ;
                    sh:path nltl:safetyManagementSystemImplemented ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-018-B-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in (gen:IMO26_018_ChapterApplicableBranch , gen:IMO26_018_ChapterNotApplicableBranch) and (gen:IMO26_018_SafetyManagementAbsentBranch , gen:IMO26_018_SafetyManagementImplementedBranch)" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO26_018_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-018-B-F04/ship> ] .

