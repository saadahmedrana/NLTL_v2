@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-P03/ship> ;
            sh:resultMessage "The 2021 section 1.8 Ice Classes provision must apply." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ne7e1e09ec985433e946b3fd50b8c53e2b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-P03/ship> ;
            sh:resultMessage "The 2021 chapter 2 Ice Class Draught provision must apply." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ne7e1e09ec985433e946b3fd50b8c53e2b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-P03/ship> ;
            sh:resultMessage "The 2021 chapter 2 Ice Class Draught provision must apply." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ne7e1e09ec985433e946b3fd50b8c53e2b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-P03/ship> ;
            sh:resultMessage "The 2021 section 1.8 Ice Classes provision must apply." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ne7e1e09ec985433e946b3fd50b8c53e2b3 ] .

_:ne7e1e09ec985433e946b3fd50b8c53e2b2 sh:hasValue nltl:iceClassDraughtChapter2Provision2021 ;
    sh:message "The 2021 chapter 2 Ice Class Draught provision must apply." ;
    sh:minCount 1 ;
    sh:path nltl:applicableIceClassRegulatoryProvision .

_:ne7e1e09ec985433e946b3fd50b8c53e2b3 sh:hasValue nltl:iceClassSection1Point8Provision2021 ;
    sh:message "The 2021 section 1.8 Ice Classes provision must apply." ;
    sh:minCount 1 ;
    sh:path nltl:applicableIceClassRegulatoryProvision .

