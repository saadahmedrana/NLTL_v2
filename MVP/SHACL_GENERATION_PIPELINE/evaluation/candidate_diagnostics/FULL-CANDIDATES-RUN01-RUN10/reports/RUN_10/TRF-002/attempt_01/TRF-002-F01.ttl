@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-002-F01/ship> ;
            sh:resultMessage "Ships contracted for construction on or after 2019-01-01 but before 2021-07-05 must identify the 2017 Ice Class Regulations as the applicable regulation edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ships contracted for construction on or after 2019-01-01 but before 2021-07-05 must identify the 2017 Ice Class Regulations as the applicable regulation edition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?contractDate .
                FILTER (datatype(?contractDate) = xsd:date)
                FILTER (
                    ?contractDate >= "2019-01-01"^^xsd:date &&
                    ?contractDate < "2021-07-05"^^xsd:date
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRegulationEdition2017 .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF002Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-002-F01/ship> ] .

