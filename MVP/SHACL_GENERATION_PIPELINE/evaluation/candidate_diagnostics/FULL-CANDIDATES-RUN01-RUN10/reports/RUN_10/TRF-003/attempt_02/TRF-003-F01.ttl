@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-003-F01/ship> ;
            sh:resultMessage "For ships contracted on or after 2012-01-01 but before 2019-01-01, the applicable Ice Class regulation edition must be the 2010 edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ships contracted on or after 2012-01-01 but before 2019-01-01, the applicable Ice Class regulation edition must be the 2010 edition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    ?date >= "2012-01-01"^^xsd:date &&
                    ?date < "2019-01-01"^^xsd:date
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:applicableIceClassRegulationEdition
                            nltl:iceClassRegulationEdition2010 .
                    }
                    ||
                    EXISTS {
                        $this nltl:applicableIceClassRegulationEdition ?edition .
                        FILTER (
                            ?edition != nltl:iceClassRegulationEdition2010
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-003-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-003-F01/ship> ] .

