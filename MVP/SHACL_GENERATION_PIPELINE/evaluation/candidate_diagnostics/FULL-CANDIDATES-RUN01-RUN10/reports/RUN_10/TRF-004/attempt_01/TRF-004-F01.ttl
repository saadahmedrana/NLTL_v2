@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ;
            sh:resultMessage "For a ship contracted for construction in 2010 or 2011, the applicable Ice Class Regulation edition must be the 2008 edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a ship contracted for construction in 2010 or 2011, the applicable Ice Class Regulation edition must be the 2008 edition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (datatype(?date) = xsd:date)
                FILTER (
                    YEAR(?date) = 2010 ||
                    YEAR(?date) = 2011
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRegulationEdition2008 .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-004> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ] .

