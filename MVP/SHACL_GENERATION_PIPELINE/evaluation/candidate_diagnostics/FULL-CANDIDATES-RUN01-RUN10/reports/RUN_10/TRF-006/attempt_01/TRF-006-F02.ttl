@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F02/ship> ;
            sh:resultMessage "Without an owner request for the 2008 requirements, the engine-output regulation edition must be the 1985 rule edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Without an owner request for the 2008 requirements, the engine-output regulation edition must be the 1985 rule edition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date .
                FILTER (
                    ?date >= "1986-11-01"^^xsd:date &&
                    ?date < "2003-09-01"^^xsd:date
                )
                $this nltl:ownerRequested2008EngineOutputRequirements ?requested .
                FILTER (?requested = "false"^^xsd:boolean)
                FILTER NOT EXISTS {
                    $this nltl:engineOutputRegulationEdition
                        nltl:iceClassRuleEdition1985 .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-006> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F02/ship> ;
            sh:resultMessage "Without an owner request for the 2008 requirements, the engine-output regulation edition must not contain another edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Without an owner request for the 2008 requirements, the engine-output regulation edition must not contain another edition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date .
                FILTER (
                    ?date >= "1986-11-01"^^xsd:date &&
                    ?date < "2003-09-01"^^xsd:date
                )
                $this nltl:ownerRequested2008EngineOutputRequirements ?requested .
                FILTER (?requested = "false"^^xsd:boolean)
                $this nltl:engineOutputRegulationEdition ?edition .
                FILTER (?edition != nltl:iceClassRuleEdition1985)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-006> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F02/ship> ] .

