@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F03/ship> ;
            sh:resultMessage "For the applicable construction-stage cohort, the applicable ice-class regulation edition must be the 1985 rule edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For the applicable construction-stage cohort, the applicable ice-class regulation edition must be the 1985 rule edition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date .
                FILTER (
                    ?date >= "1986-11-01"^^xsd:date &&
                    ?date < "2003-09-01"^^xsd:date
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRuleEdition1985 .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-006> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F03/ship> ;
            sh:resultMessage "The applicable ice-class regulation edition must not contain a value other than the 1985 rule edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The applicable ice-class regulation edition must not contain a value other than the 1985 rule edition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date .
                FILTER (
                    ?date >= "1986-11-01"^^xsd:date &&
                    ?date < "2003-09-01"^^xsd:date
                )
                $this nltl:applicableIceClassRegulationEdition ?edition .
                FILTER (?edition != nltl:iceClassRuleEdition1985)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-006> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F03/ship> ] .

