@prefix gs: <urn:nltl:generated-shape:TRF-006:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:TRF006ApplicableCohort , gs:TRF006OutsideApplicableCohort" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF006ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F03/ship> ] .

