@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P05/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:engineOutputComplianceMethodValue ; sh:in ( nltl:traficom2017Section3Point2Point2Method nltl:traficom2017Section3Point2Point4Method ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:engineOutputComplianceMethod ], [ sh:datatype xsd:date ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:assessmentDate ], [ sh:datatype xsd:date ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:datatype xsd:date ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:deliveryDate ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ] ; sh:sparql [ sh:message Literal("For an IA Super or IA ship constructed before 1 September 2003, the permitted 2017 Ice Class Regulations compliance method must be established by 1 January of the year twenty years after delivery.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionStageDate ?construction ;
          nltl:deliveryDate ?delivery ;
          nltl:assessmentDate ?assessment .
    FILTER (
        YEAR(?construction) < 2003 ||
        (
            YEAR(?construction) = 2003 &&
            (
                MONTH(?construction) < 9 ||
                (MONTH(?construction) = 9 && DAY(?construction) < 1)
            )
        )
    )
    BIND(YEAR(?delivery) + 20 AS ?deadlineYear)
    FILTER (
        YEAR(?assessment) < ?deadlineYear ||
        (
            YEAR(?assessment) = ?deadlineYear &&
            MONTH(?assessment) = 1 &&
            DAY(?assessment) <= 1
        )
    )
}
") ] ] , [ sh:property [ sh:datatype xsd:date ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ] ; sh:sparql [ sh:message Literal("For an IA Super or IA ship, construction must not be before 1 September 2003 unless the applicable twenty-year compliance condition is satisfied.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionStageDate ?construction .
    FILTER (
        YEAR(?construction) > 2003 ||
        (
            YEAR(?construction) = 2003 &&
            MONTH(?construction) >= 9
        )
    )
}
") ] ] , [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceClass ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-007> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P05/ship> ] .

