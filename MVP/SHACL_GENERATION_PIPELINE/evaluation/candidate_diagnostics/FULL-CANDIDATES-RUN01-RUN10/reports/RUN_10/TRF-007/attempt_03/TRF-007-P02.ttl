@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P02/ship> ;
            sh:resultMessage "For an IA or IA Super ship constructed before 1 September 2003, the 2017 Ice Class Regulations requirement is overdue." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an IA or IA Super ship constructed before 1 September 2003, the 2017 Ice Class Regulations requirement is overdue." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this nltl:iceClass ?ice ;
                      nltl:constructionStageDate ?constructionDate ;
                      nltl:deliveryDate ?deliveryDate ;
                      nltl:assessmentDate ?assessmentDate ;
                      nltl:engineOutputComplianceMethod ?method .
                FILTER (
                    ?ice IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa
                    )
                )
                FILTER (
                    datatype(?constructionDate) = xsd:date &&
                    datatype(?deliveryDate) = xsd:date &&
                    datatype(?assessmentDate) = xsd:date
                )
                FILTER (
                    YEAR(?constructionDate) < 2003 ||
                    (
                        YEAR(?constructionDate) = 2003 &&
                        MONTH(?constructionDate) < 9
                    )
                )
                FILTER (
                    ?method IN (
                        nltl:traficom2017Section3Point2Point2Method,
                        nltl:traficom2017Section3Point2Point4Method
                    )
                )
                FILTER (
                    YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20 ||
                    (
                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                        (
                            MONTH(?assessmentDate) > 1 ||
                            (
                                MONTH(?assessmentDate) = 1 &&
                                DAY(?assessmentDate) > 1
                            )
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF007Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P02/ship> ] .

