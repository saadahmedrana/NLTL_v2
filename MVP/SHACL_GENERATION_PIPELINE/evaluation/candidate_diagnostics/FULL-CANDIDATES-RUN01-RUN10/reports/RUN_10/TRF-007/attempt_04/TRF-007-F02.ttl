@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-F02/ship> ;
            sh:resultMessage "The compliance method, when supplied, must be one permitted 2017 regulation method." ;
            sh:resultPath nltl:engineOutputComplianceMethod ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:class nltl:engineOutputComplianceMethodValue ;
                    sh:in ( nltl:traficom2017Section3Point2Point2Method nltl:traficom2017Section3Point2Point4Method ) ;
                    sh:maxCount 1 ;
                    sh:message "The compliance method, when supplied, must be one permitted 2017 regulation method." ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:engineOutputComplianceMethod ] ;
            sh:value nltl:iceClassRegulationEdition2010 ] .

