@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-F03/ship> ;
            sh:resultMessage "An IA or IA Super ship constructed before 1 September 2003 must have a delivery date, assessment date, and permitted compliance method." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "An IA or IA Super ship constructed before 1 September 2003 must have a delivery date, assessment date, and permitted compliance method." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:constructionStageDate ?construction .
                FILTER (
                    ?ice = nltl:iceClassIa ||
                    ?ice = nltl:iceClassIaSuper
                )
                FILTER (
                    YEAR(?construction) < 2003 ||
                    (
                        YEAR(?construction) = 2003 &&
                        (
                            MONTH(?construction) < 9 ||
                            (MONTH(?construction) = 9 && DAY(?construction) < 1)
                        )
                    )
                )
                FILTER (
                    NOT EXISTS { $this nltl:deliveryDate ?delivery } ||
                    NOT EXISTS { $this nltl:assessmentDate ?assessment } ||
                    NOT EXISTS { $this nltl:engineOutputComplianceMethod ?method }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-007-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-F03/ship> ] .

