@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P02/ship> ;
            sh:resultMessage "The assessment date exceeds the required deadline for an applicable IA or IA Super ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The assessment date exceeds the required deadline for an applicable IA or IA Super ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:constructionStageDate ?construction ;
                      nltl:deliveryDate ?delivery ;
                      nltl:assessmentDate ?assessment ;
                      nltl:engineOutputComplianceMethod ?method .
                FILTER (
                    ?ice = nltl:iceClassIa ||
                    ?ice = nltl:iceClassIaSuper
                )
                FILTER (
                    YEAR(?construction) < 2003 ||
                    (
                        YEAR(?construction) = 2003 &&
                        (
                            MONTH(?construction) < 9 ||
                            (MONTH(?construction) = 9 && DAY(?construction) < 1)
                        )
                    )
                )
                FILTER (
                    ?method = nltl:traficom2017Section3Point2Point2Method ||
                    ?method = nltl:traficom2017Section3Point2Point4Method
                )
                FILTER (
                    YEAR(?assessment) > YEAR(?delivery) + 20 ||
                    (
                        YEAR(?assessment) = YEAR(?delivery) + 20 &&
                        (
                            MONTH(?assessment) > 1 ||
                            (MONTH(?assessment) = 1 && DAY(?assessment) > 1)
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-007-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P02/ship> ] .

