            sh:resultMessage "At each longitudinal position, the UIWL vertical coordinate must equal the maximum intended ice-operating waterline vertical coordinate within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9; every position must have points on both sides." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "At each longitudinal position, the UIWL vertical coordinate must equal the maximum intended ice-operating waterline vertical coordinate within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9; every position must have points on both sides." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                {
                    SELECT ?this ?pos
                           (MAX(?uiwlVertical) AS ?maxUiwlVertical)
                           (MAX(?intendedVertical) AS ?maxIntendedVertical)
                           (COUNT(?uiwlVertical) AS ?uiwlCount)
                           (COUNT(?intendedVertical) AS ?intendedCount)
                    WHERE {
                        {
                            ?this nltl:hasUpperIceWaterline ?uiwl .
                            ?uiwl nltl:hasWaterlineProfilePoint ?uiwlPoint .
                            ?uiwlPoint nltl:longitudinalPosition ?uiwlPositionValue ;
                                       nltl:verticalCoordinate ?uiwlVerticalValue .
                            ?uiwlPositionValue qudt:numericValue ?pos .
                            ?uiwlVerticalValue qudt:numericValue ?uiwlVertical .
                            FILTER (?this = $this)
                        }
                        UNION
                        {
                            ?this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
                            ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
                            ?intendedPoint nltl:longitudinalPosition ?intendedPositionValue ;
                                             nltl:verticalCoordinate ?intendedVerticalValue .
                            ?intendedPositionValue qudt:numericValue ?pos .
                            ?intendedVerticalValue qudt:numericValue ?intendedVertical .
                            FILTER (?this = $this)
                        }
                    }
                    GROUP BY ?this ?pos
                }
                FILTER (
                    ?uiwlCount = 0 ||
                    ?intendedCount = 0 ||
                    ABS(?maxUiwlVertical - ?maxIntendedVertical) >
                    (ABS(?maxIntendedVertical) * 0.000001 + 0.000000001)
                )
            }
        """ ] ;
