@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/ship> ;
            sh:resultMessage "The ship must identify its upper ice waterline and its waterline profile points." ;
            sh:resultPath nltl:hasUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:message "The ship must identify its upper ice waterline and its waterline profile points." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-011-IceWaterlineShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasUpperIceWaterline ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/ship> ;
            sh:resultMessage "At each longitudinal position, the UIWL vertical coordinate must equal the maximum intended ice-operating waterline vertical coordinate within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9; every position must have points on both sides." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "At each longitudinal position, the UIWL vertical coordinate must equal the maximum intended ice-operating waterline vertical coordinate within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9; every position must have points on both sides." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                {
                    SELECT ?this ?pos
                           (MAX(?uiwlVertical) AS ?maxUiwlVertical)
                           (MAX(?intendedVertical) AS ?maxIntendedVertical)
                           (COUNT(?uiwlVertical) AS ?uiwlCount)
                           (COUNT(?intendedVertical) AS ?intendedCount)
                    WHERE {
                        {
                            ?this nltl:hasUpperIceWaterline ?uiwl .
                            ?uiwl nltl:hasWaterlineProfilePoint ?uiwlPoint .
                            ?uiwlPoint nltl:longitudinalPosition ?uiwlPositionValue ;
                                       nltl:verticalCoordinate ?uiwlVerticalValue .
                            ?uiwlPositionValue qudt:numericValue ?pos .
                            ?uiwlVerticalValue qudt:numericValue ?uiwlVertical .
                            FILTER (?this = $this)
                        }
                        UNION
                        {
                            ?this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
                            ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
                            ?intendedPoint nltl:longitudinalPosition ?intendedPositionValue ;
                                             nltl:verticalCoordinate ?intendedVerticalValue .
                            ?intendedPositionValue qudt:numericValue ?pos .
                            ?intendedVerticalValue qudt:numericValue ?intendedVertical .
                            FILTER (?this = $this)
                        }
                    }
                    GROUP BY ?this ?pos
                }
                FILTER (
                    ?uiwlCount = 0 ||
                    ?intendedCount = 0 ||
                    ABS(?maxUiwlVertical - ?maxIntendedVertical) >
                    (ABS(?maxIntendedVertical) * 0.000001 + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-011-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/i1X1> ;
                                    sh:resultMessage "Node ex:i1X1->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape [ sh:hasValue qudt:M ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/i1Point1> ;
                            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
                            sh:resultPath nltl:longitudinalPosition ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue qudt:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:longitudinalPosition ] ;
                            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/i1X1> ],
                        [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/i1Z1> ;
                                    sh:resultMessage "Node ex:i1Z1->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape [ sh:hasValue qudt:M ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/i1Point1> ;
                            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
                            sh:resultPath nltl:verticalCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue qudt:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:verticalCoordinate ] ;
                            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/i1Z1> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/intendedLine1> ;
                    sh:resultMessage "Each represented ice waterline must have at least one profile point." ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:waterlineProfilePoint ;
                            sh:message "Each represented ice waterline must have at least one profile point." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:TRF-011-ProfilePointShape> ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:hasWaterlineProfilePoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/i1Point1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/ship> ;
            sh:resultMessage "The ship must identify at least one intended ice-operating waterline and its waterline profile points." ;
            sh:resultPath nltl:hasIntendedIceOperatingWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:message "The ship must identify at least one intended ice-operating waterline and its waterline profile points." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-011-IceWaterlineShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIntendedIceOperatingWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F03/intendedLine1> ] .

