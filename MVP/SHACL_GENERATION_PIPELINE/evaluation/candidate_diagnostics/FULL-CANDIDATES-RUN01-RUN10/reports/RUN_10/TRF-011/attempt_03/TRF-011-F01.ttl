@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F01/ship> ;
            sh:resultMessage "The UIWL vertical coordinate must equal the maximum intended-waterline vertical coordinate at the same longitudinal position within tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The UIWL vertical coordinate must equal the maximum intended-waterline vertical coordinate at the same longitudinal position within tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?uiwlPoint ?x ?observed ?expected
            WHERE {
                $this nltl:hasUpperIceWaterline ?uiwl .
                ?uiwl nltl:hasWaterlineProfilePoint ?uiwlPoint .
                ?uiwlPoint nltl:longitudinalPosition ?uiwlXValue ;
                    nltl:verticalCoordinate ?uiwlZValue .
                ?uiwlXValue qudt:numericValue ?uiwlX ;
                    qudt:unit <http://qudt.org/vocab/unit/M> .
                ?uiwlZValue qudt:numericValue ?observed ;
                    qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (datatype(?uiwlX) = xsd:decimal)
                FILTER (datatype(?observed) = xsd:decimal)

                {
                    SELECT $this ?x (MAX(?candidate) AS ?expected)
                    WHERE {
                        $this nltl:hasIntendedIceOperatingWaterline ?intended .
                        ?intended nltl:hasWaterlineProfilePoint ?intendedPoint .
                        ?intendedPoint nltl:longitudinalPosition ?intendedXValue ;
                            nltl:verticalCoordinate ?intendedZValue .
                        ?intendedXValue qudt:numericValue ?x ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?intendedZValue qudt:numericValue ?candidate ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (datatype(?x) = xsd:decimal)
                        FILTER (datatype(?candidate) = xsd:decimal)
                    }
                    GROUP BY $this ?x
                }

                FILTER (?uiwlX = ?x)
                FILTER (
                    ABS(?observed - ?expected) >
                    (ABS(?expected) * 0.000001 + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF011ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F01/ship> ] .

