@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ;
            sh:resultMessage "Each intended ice-operating waterline profile point must have a corresponding UIWL point at the same longitudinal position." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each intended ice-operating waterline profile point must have a corresponding UIWL point at the same longitudinal position." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?intendedPoint ?x
            WHERE {
                $this nltl:hasIntendedIceOperatingWaterline ?intended .
                ?intended nltl:hasWaterlineProfilePoint ?intendedPoint .
                ?intendedPoint nltl:longitudinalPosition ?intendedXValue .
                ?intendedXValue qudt:numericValue ?x ;
                    qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (datatype(?x) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:hasUpperIceWaterline ?uiwl .
                    ?uiwl nltl:hasWaterlineProfilePoint ?uiwlPoint .
                    ?uiwlPoint nltl:longitudinalPosition ?uiwlXValue .
                    ?uiwlXValue qudt:numericValue ?uiwlX ;
                        qudt:unit <http://qudt.org/vocab/unit/M> .
                    FILTER (datatype(?uiwlX) = xsd:decimal)
                    FILTER (?uiwlX = ?x)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF011ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/upperIceWaterline> ;
                    sh:resultMessage "Less than 1 values on ex:upperIceWaterline->nltl:hasWaterlineProfilePoint" ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:waterlineProfilePoint ;
                            sh:minCount 1 ;
                            sh:node gen:TRF011ProfilePointShape ;
                            sh:path nltl:hasWaterlineProfilePoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF011IceWaterlineShape. See details for more information." ;
            sh:resultPath nltl:hasUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:minCount 1 ;
                    sh:node gen:TRF011IceWaterlineShape ;
                    sh:path nltl:hasUpperIceWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/upperIceWaterline> ] .

