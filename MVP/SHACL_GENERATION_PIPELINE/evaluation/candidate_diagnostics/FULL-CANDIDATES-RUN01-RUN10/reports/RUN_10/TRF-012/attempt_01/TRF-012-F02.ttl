@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F02/ship> ;
            sh:resultMessage "The externally determined lower ice waterline must be represented with profile points." ;
            sh:resultPath nltl:hasLowerIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The externally determined lower ice waterline must be represented with profile points." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-012-IceWaterlineShape> ;
                    sh:path nltl:hasLowerIceWaterline ] ] .

