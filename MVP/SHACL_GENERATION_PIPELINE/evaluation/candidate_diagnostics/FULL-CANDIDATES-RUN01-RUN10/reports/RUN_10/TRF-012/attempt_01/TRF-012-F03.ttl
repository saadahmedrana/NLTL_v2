@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F03/intendedLine> ;
                    sh:resultMessage "Each represented ice waterline must contain waterline profile points." ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each represented ice waterline must contain waterline profile points." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:waterlineProfilePoint ;
                                    sh:node <urn:nltl:generated-shape:TRF-012-ProfilePointShape> ] ;
                            sh:path nltl:hasWaterlineProfilePoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F03/ship> ;
            sh:resultMessage "The ship must represent its intended ice-operating waterline with profile points." ;
            sh:resultPath nltl:hasIntendedIceOperatingWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must represent its intended ice-operating waterline with profile points." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-012-IceWaterlineShape> ;
                    sh:path nltl:hasIntendedIceOperatingWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F03/intendedLine> ] .

