@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:readilyAvailableToMaster" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb233c4d88c5c41bfaeb97231f9156c8cb23 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "Node ex:ship->nltl:retainedOnBoard does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb233c4d88c5c41bfaeb97231f9156c8cb24 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:retainedOnBoard" ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb233c4d88c5c41bfaeb97231f9156c8cb24 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "Node ex:ship->nltl:readilyAvailableToMaster does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb233c4d88c5c41bfaeb97231f9156c8cb23 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "The required ice draught marking is missing or is not supported by the applicable date and draught condition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The required ice draught marking is missing or is not supported by the applicable date and draught condition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate ;
                      nltl:assessmentDate ?assessmentDate ;
                      nltl:summerLoadLineFreshWaterDraught ?summerQuantity ;
                      nltl:upperIceWaterlineDraught ?uiwlQuantity .

                ?summerQuantity qudt:numericValue ?summerDraught .
                ?uiwlQuantity qudt:numericValue ?uiwlDraught .

                FILTER (
                    (
                        ?constructionDate >= "2007-07-01"^^xsd:date
                        && ?summerDraught > ?uiwlDraught
                        && NOT EXISTS {
                            $this nltl:warningTrianglePresent true ;
                                  nltl:iceClassDraughtMarkPresent true ;
                                  nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity .
                        }
                    )
                    ||
                    (
                        ?constructionDate < "2007-07-01"^^xsd:date
                        && ?summerDraught > ?uiwlDraught
                        && NOT EXISTS {
                            $this nltl:warningTrianglePresent true ;
                                  nltl:iceClassDraughtMarkPresent true ;
                                  nltl:iceClassDraughtMarkDraughtAmidships ?completeMarkQuantity .
                        }
                        && (
                            NOT EXISTS {
                                $this nltl:firstScheduledDryDockingDate ?dryDockingDate .
                            }
                            ||
                            EXISTS {
                                $this nltl:firstScheduledDryDockingDate ?dryDockingDate .
                                FILTER (?dryDockingDate <= ?assessmentDate)
                                FILTER NOT EXISTS {
                                    $this nltl:warningTrianglePresent true ;
                                          nltl:iceClassDraughtMarkPresent true ;
                                          nltl:iceClassDraughtMarkDraughtAmidships ?dueMarkQuantity .
                                }
                            }
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF014_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ] .

_:nb233c4d88c5c41bfaeb97231f9156c8cb23 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

_:nb233c4d88c5c41bfaeb97231f9156c8cb24 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

