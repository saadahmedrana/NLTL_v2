@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "The ice-draught restriction document must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf5cbb455550c47a0b9907b8f886445b5b9 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "The ice-draught restriction document must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nf5cbb455550c47a0b9907b8f886445b5b9 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "The ice-draught restriction document must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf5cbb455550c47a0b9907b8f886445b5b10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "The ice-draught restriction document must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nf5cbb455550c47a0b9907b8f886445b5b10 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F03/ship> ;
            sh:resultMessage "For an applicable pre-cutoff ship without complete marking evidence, the scheduled dry-docking date is required; markings are required once that date is on or before the assessment date, and applicable post-cutoff ships must have complete markings." ;
            sh:resultPath nltl:assessmentDate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an applicable pre-cutoff ship without complete marking evidence, the scheduled dry-docking date is required; markings are required once that date is on or before the assessment date, and applicable post-cutoff ships must have complete markings." ;
                    sh:select """
                PREFIX nltl: <https://w3id.org/nltl/vocab#>
                PREFIX qudt: <http://qudt.org/schema/qudt/>
                PREFIX sh: <http://www.w3.org/ns/shacl#>
                PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                SELECT $this
                WHERE {
                    $this nltl:assessmentDate ?assessment ;
                           nltl:constructionDate ?construction ;
                           nltl:summerLoadLineFreshWaterDraught ?summerNode ;
                           nltl:upperIceWaterlineDraught ?uiwlNode .
                    ?summerNode qudt:numericValue ?summer .
                    ?uiwlNode qudt:numericValue ?uiwl .

                    FILTER(?summer > ?uiwl)

                    FILTER(
                        (
                            ?construction >= "2007-07-01"^^xsd:date
                            &&
                            NOT EXISTS {
                                $this nltl:warningTrianglePresent true ;
                                       nltl:iceClassDraughtMarkPresent true ;
                                       nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                                ?markNode qudt:numericValue ?markValue .
                            }
                        )
                        ||
                        (
                            ?construction < "2007-07-01"^^xsd:date
                            &&
                            NOT EXISTS {
                                $this nltl:warningTrianglePresent true ;
                                       nltl:iceClassDraughtMarkPresent true ;
                                       nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                                ?markNode qudt:numericValue ?markValue .
                            }
                            &&
                            (
                                NOT EXISTS {
                                    $this nltl:firstScheduledDryDockingDate ?docking .
                                }
                                ||
                                (
                                    EXISTS {
                                        $this nltl:firstScheduledDryDockingDate ?docking .
                                        FILTER(?docking <= ?assessment)
                                    }
                                    &&
                                    NOT EXISTS {
                                        $this nltl:warningTrianglePresent true ;
                                               nltl:iceClassDraughtMarkPresent true ;
                                               nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                                        ?markNode qudt:numericValue ?markValue .
                                    }
                                )
                            )
                        )
                    )
                }
            """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape [ sh:path nltl:assessmentDate ;
                    sh:sparql [ a sh:SPARQLConstraint ;
                            sh:message "For an applicable pre-cutoff ship without complete marking evidence, the scheduled dry-docking date is required; markings are required once that date is on or before the assessment date, and applicable post-cutoff ships must have complete markings." ;
                            sh:select """
                PREFIX nltl: <https://w3id.org/nltl/vocab#>
                PREFIX qudt: <http://qudt.org/schema/qudt/>
                PREFIX sh: <http://www.w3.org/ns/shacl#>
                PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                SELECT $this
                WHERE {
                    $this nltl:assessmentDate ?assessment ;
                           nltl:constructionDate ?construction ;
                           nltl:summerLoadLineFreshWaterDraught ?summerNode ;
                           nltl:upperIceWaterlineDraught ?uiwlNode .
                    ?summerNode qudt:numericValue ?summer .
                    ?uiwlNode qudt:numericValue ?uiwl .

                    FILTER(?summer > ?uiwl)

                    FILTER(
                        (
                            ?construction >= "2007-07-01"^^xsd:date
                            &&
                            NOT EXISTS {
                                $this nltl:warningTrianglePresent true ;
                                       nltl:iceClassDraughtMarkPresent true ;
                                       nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                                ?markNode qudt:numericValue ?markValue .
                            }
                        )
                        ||
                        (
                            ?construction < "2007-07-01"^^xsd:date
                            &&
                            NOT EXISTS {
                                $this nltl:warningTrianglePresent true ;
                                       nltl:iceClassDraughtMarkPresent true ;
                                       nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                                ?markNode qudt:numericValue ?markValue .
                            }
                            &&
                            (
                                NOT EXISTS {
                                    $this nltl:firstScheduledDryDockingDate ?docking .
                                }
                                ||
                                (
                                    EXISTS {
                                        $this nltl:firstScheduledDryDockingDate ?docking .
                                        FILTER(?docking <= ?assessment)
                                    }
                                    &&
                                    NOT EXISTS {
                                        $this nltl:warningTrianglePresent true ;
                                               nltl:iceClassDraughtMarkPresent true ;
                                               nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                                        ?markNode qudt:numericValue ?markValue .
                                    }
                                )
                            )
                        )
                    )
                }
            """ ] ] ] .

_:nf5cbb455550c47a0b9907b8f886445b5b10 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice-draught restriction document must be retained on board." ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

_:nf5cbb455550c47a0b9907b8f886445b5b9 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice-draught restriction document must be readily available to the master." ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

