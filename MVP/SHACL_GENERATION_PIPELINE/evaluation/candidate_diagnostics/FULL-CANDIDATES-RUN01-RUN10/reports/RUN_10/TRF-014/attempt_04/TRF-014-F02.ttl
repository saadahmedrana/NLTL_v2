@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "The required marking is absent, or the pre-cutoff dry-docking deadline and assessment-date condition is not satisfied." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The required marking is absent, or the pre-cutoff dry-docking deadline and assessment-date condition is not satisfied." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate ;
                      nltl:summerLoadLineFreshWaterDraught/qudt:numericValue ?summer ;
                      nltl:upperIceWaterlineDraught/qudt:numericValue ?uiwl ;
                      nltl:assessmentDate ?assessmentDate .
                FILTER (?summer > ?uiwl)
                FILTER (
                    (
                        ?constructionDate >= "2007-07-01"^^xsd:date
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:warningTrianglePresent true ;
                                      nltl:iceClassDraughtMarkPresent true .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:warningTrianglePresent true ;
                                      nltl:iceClassDraughtMarkPresent true ;
                                      nltl:iceClassDraughtMarkDraughtAmidships/qudt:numericValue ?mark .
                                $this nltl:hasClassCertificate/
                                     nltl:maximumIceClassDraughtAmidships/qudt:numericValue ?maximum .
                                FILTER (
                                    ABS(?mark - ?maximum)
                                    > (ABS(?maximum) * 0.000001 + 0.000000001)
                                )
                            }
                        )
                    )
                    ||
                    (
                        ?constructionDate < "2007-07-01"^^xsd:date
                        &&
                        NOT EXISTS {
                            $this nltl:warningTrianglePresent true ;
                                  nltl:iceClassDraughtMarkPresent true .
                        }
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:firstScheduledDryDockingDate ?docking .
                            }
                            ||
                            EXISTS {
                                $this nltl:firstScheduledDryDockingDate ?docking .
                                FILTER (?docking < "2007-07-01"^^xsd:date)
                            }
                            ||
                            EXISTS {
                                $this nltl:firstScheduledDryDockingDate ?docking .
                                FILTER (?docking <= ?assessmentDate)
                                FILTER NOT EXISTS {
                                    $this nltl:warningTrianglePresent true ;
                                          nltl:iceClassDraughtMarkPresent true ;
                                          nltl:iceClassDraughtMarkDraughtAmidships/qudt:numericValue ?mark .
                                    $this nltl:hasClassCertificate/
                                         nltl:maximumIceClassDraughtAmidships/qudt:numericValue ?maximum .
                                    FILTER (
                                        ABS(?mark - ?maximum)
                                        <= (ABS(?maximum) * 0.000001 + 0.000000001)
                                    )
                                }
                            }
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF014_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "The ice-draught restriction information must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n8cebe3ea1a064c8aa9a971a85a034b2ab15 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "The ice-draught restriction information must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n8cebe3ea1a064c8aa9a971a85a034b2ab16 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/certificate> ;
                    sh:resultMessage "Less than 1 values on ex:certificate->nltl:minimumIceClassDraughtAft" ;
                    sh:resultPath nltl:minimumIceClassDraughtAft ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node gs:TRF014_MetreQuantityShape ;
                            sh:path nltl:minimumIceClassDraughtAft ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "A class certificate containing all maximum and minimum ice-class draughts is required." ;
            sh:resultPath nltl:hasClassCertificate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A class certificate containing all maximum and minimum ice-class draughts is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:classCertificate ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node gs:TRF014_MetreQuantityShape ;
                                    sh:path nltl:minimumIceClassDraughtFore ],
                                [ sh:minCount 1 ;
                                    sh:node gs:TRF014_MetreQuantityShape ;
                                    sh:path nltl:maximumIceClassDraughtFore ],
                                [ sh:minCount 1 ;
                                    sh:node gs:TRF014_MetreQuantityShape ;
                                    sh:path nltl:minimumIceClassDraughtAmidships ],
                                [ sh:minCount 1 ;
                                    sh:node gs:TRF014_MetreQuantityShape ;
                                    sh:path nltl:maximumIceClassDraughtAmidships ],
                                [ sh:minCount 1 ;
                                    sh:node gs:TRF014_MetreQuantityShape ;
                                    sh:path nltl:minimumIceClassDraughtAft ],
                                [ sh:minCount 1 ;
                                    sh:node gs:TRF014_MetreQuantityShape ;
                                    sh:path nltl:maximumIceClassDraughtAft ] ] ;
                    sh:path nltl:hasClassCertificate ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/certificate> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "The ice-draught restriction information must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n8cebe3ea1a064c8aa9a971a85a034b2ab16 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F02/ship> ;
            sh:resultMessage "The ice-draught restriction information must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n8cebe3ea1a064c8aa9a971a85a034b2ab15 ] .

_:n8cebe3ea1a064c8aa9a971a85a034b2ab15 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ice-draught restriction information must be readily available to the master." ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

_:n8cebe3ea1a064c8aa9a971a85a034b2ab16 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ice-draught restriction information must be retained on board." ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

