@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "The ice-draught restriction information must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n8cebe3ea1a064c8aa9a971a85a034b2ab15 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "The ice-draught restriction information must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n8cebe3ea1a064c8aa9a971a85a034b2ab16 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "The ice-class draught mark amidships must equal the class certificate maximum amidships draught within the permitted numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The ice-class draught mark amidships must equal the class certificate maximum amidships draught within the permitted numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:iceClassDraughtMarkPresent true ;
                      nltl:iceClassDraughtMarkDraughtAmidships/qudt:numericValue ?mark ;
                      nltl:hasClassCertificate/
                      nltl:maximumIceClassDraughtAmidships/qudt:numericValue ?maximum .
                FILTER (
                    ABS(?mark - ?maximum)
                    > (ABS(?maximum) * 0.000001 + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF014_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "The ice-draught restriction information must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n8cebe3ea1a064c8aa9a971a85a034b2ab16 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-F05/ship> ;
            sh:resultMessage "The ice-draught restriction information must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n8cebe3ea1a064c8aa9a971a85a034b2ab15 ] .

_:n8cebe3ea1a064c8aa9a971a85a034b2ab15 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ice-draught restriction information must be readily available to the master." ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

_:n8cebe3ea1a064c8aa9a971a85a034b2ab16 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ice-draught restriction information must be retained on board." ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

