@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P01/ship> ;
            sh:resultMessage "The ice-draught restriction information must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n8cebe3ea1a064c8aa9a971a85a034b2ab16 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P01/ship> ;
            sh:resultMessage "The ice-draught restriction information must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n8cebe3ea1a064c8aa9a971a85a034b2ab15 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P01/ship> ;
            sh:resultMessage "The ice-draught restriction information must be retained on board." ;
            sh:resultPath nltl:retainedOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n8cebe3ea1a064c8aa9a971a85a034b2ab16 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P01/ship> ;
            sh:resultMessage "The ice-draught restriction information must be readily available to the master." ;
            sh:resultPath nltl:readilyAvailableToMaster ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n8cebe3ea1a064c8aa9a971a85a034b2ab15 ] .

_:n8cebe3ea1a064c8aa9a971a85a034b2ab15 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ice-draught restriction information must be readily available to the master." ;
    sh:minCount 1 ;
    sh:path nltl:readilyAvailableToMaster .

_:n8cebe3ea1a064c8aa9a971a85a034b2ab16 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ice-draught restriction information must be retained on board." ;
    sh:minCount 1 ;
    sh:path nltl:retainedOnBoard .

