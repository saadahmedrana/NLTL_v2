@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F02/ship> ;
            sh:resultMessage "When navigating in ice, operating draught and trim must not exceed their permitted limits." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When navigating in ice, operating draught and trim must not exceed their permitted limits." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:navigatingInIce true ;
                      nltl:operatingDraught ?operatingDraught ;
                      nltl:upperIceWaterlineDraught ?upperWaterlineDraught ;
                      nltl:operatingTrim ?operatingTrim ;
                      nltl:maximumPermittedIceTrim ?maximumTrim .
                ?operatingDraught qudt:numericValue ?operatingDraughtValue .
                ?upperWaterlineDraught qudt:numericValue ?upperWaterlineDraughtValue .
                ?operatingTrim qudt:numericValue ?operatingTrimValue .
                ?maximumTrim qudt:numericValue ?maximumTrimValue .
                FILTER (
                    ?operatingDraughtValue > ?upperWaterlineDraughtValue ||
                    ?operatingTrimValue > ?maximumTrimValue
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-015> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F02/ship> ] .

