@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:propulsionOutputRestrictionApplies ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:propulsionOutputRestrictionApplies ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Restricted propulsion output must be supplied in kW when the propulsion output restriction applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:PowerQuantityShape ; sh:path nltl:restrictedPropulsionOutput ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF017Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F03/ship> ] .

