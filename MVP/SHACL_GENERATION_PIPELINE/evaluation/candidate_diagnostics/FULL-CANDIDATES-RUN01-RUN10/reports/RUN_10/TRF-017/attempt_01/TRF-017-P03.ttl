@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P03/ship> ;
            sh:resultMessage "When propulsion output is not restricted, maximum continuous rating power must equal the continuously deliverable propulsion machinery output." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When propulsion output is not restricted, maximum continuous rating power must equal the continuously deliverable propulsion machinery output." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies false ;
                      nltl:maximumContinuousRatingPower ?pNode ;
                      nltl:propulsionMachineryContinuousOutput ?mNode .
                ?pNode qudt:numericValue ?pValue .
                ?mNode qudt:numericValue ?mValue .
                FILTER (?pValue != ?mValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF017Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P03/ship> ] .

