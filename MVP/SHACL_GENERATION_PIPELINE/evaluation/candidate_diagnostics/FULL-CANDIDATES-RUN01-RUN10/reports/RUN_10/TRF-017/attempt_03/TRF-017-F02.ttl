@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propulsionOutputRestrictionApplies ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloW ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:restrictedPropulsionOutput ] ; sh:sparql [ sh:message Literal("When propulsion output restriction applies, maximum continuous rating power must equal restricted propulsion output.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:maximumContinuousRatingPower ?pNode .
                        ?pNode qudt:numericValue ?p .

                        $this nltl:restrictedPropulsionOutput ?rNode .
                        ?rNode qudt:numericValue ?r .

                        FILTER (?p != ?r)
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propulsionOutputRestrictionApplies ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloW ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:propulsionMachineryContinuousOutput ] ; sh:sparql [ sh:message Literal("When propulsion output is not restricted, maximum continuous rating power must equal total propulsion machinery output including any additional propulsion power, within the stated numerical tolerance.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:maximumContinuousRatingPower ?pNode .
                        ?pNode qudt:numericValue ?p .

                        {
                            $this nltl:propulsionMachineryContinuousOutput ?mNode .
                            ?mNode qudt:numericValue ?m .
                            FILTER NOT EXISTS {
                                $this nltl:additionalPropulsionPower ?aNode .
                            }
                            BIND(?m AS ?expected)
                        }
                        UNION
                        {
                            $this nltl:propulsionMachineryContinuousOutput ?mNode .
                            ?mNode qudt:numericValue ?m .

                            $this nltl:additionalPropulsionPower ?aNode .
                            ?aNode qudt:numericValue ?a .

                            BIND((?m + ?a) AS ?expected)
                        }

                        BIND((?expected * 0.000001 + 0.000001) AS ?tolerance)
                        FILTER (
                            ?p < (?expected - ?tolerance) ||
                            ?p > (?expected + ?tolerance)
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_017_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F02/ship> ] .

