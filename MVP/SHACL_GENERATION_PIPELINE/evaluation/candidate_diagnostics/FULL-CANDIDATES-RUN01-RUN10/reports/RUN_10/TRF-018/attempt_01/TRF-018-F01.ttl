@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F01/ship> ;
            sh:resultMessage "Maximum continuous rating power must be at least the calculated required power and at least 2800 kW for IA Super or 1000 kW for IA, IB, or IC." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Maximum continuous rating power must be at least the calculated required power and at least 2800 kW for IA Super or 1000 kW for IA, IB, or IC." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:calculatedRequiredPower ?calculatedNode ;
                      nltl:maximumContinuousRatingPower ?mcrNode .
                ?calculatedNode qudt:numericValue ?calculated .
                ?mcrNode qudt:numericValue ?mcr .
                FILTER (
                    (
                        ?ice = nltl:iceClassIaSuper &&
                        (
                            ?mcr < ?calculated ||
                            ?mcr < "2800.0"^^xsd:decimal
                        )
                    ) ||
                    (
                        ?ice IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        ) &&
                        (
                            ?mcr < ?calculated ||
                            ?mcr < "1000.0"^^xsd:decimal
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF018ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F01/ship> ] .

