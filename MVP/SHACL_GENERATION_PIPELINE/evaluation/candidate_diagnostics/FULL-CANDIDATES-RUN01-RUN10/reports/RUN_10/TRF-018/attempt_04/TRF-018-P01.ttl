@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P01/ship> ;
            sh:resultMessage "An applicable ice-class ship must provide calculatedRequiredPower and maximumContinuousRatingPower as decimal kW quantities." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "An applicable ice-class ship must provide calculatedRequiredPower and maximumContinuousRatingPower as decimal kW quantities." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:calculatedRequiredPower ?calculatedQuantity .
                        ?calculatedQuantity qudt:numericValue ?calculatedValue ;
                                             qudt:unit qudt:KiloW .
                        FILTER (datatype(?calculatedValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:maximumContinuousRatingPower ?mcrQuantity .
                        ?mcrQuantity qudt:numericValue ?mcrValue ;
                                     qudt:unit qudt:KiloW .
                        FILTER (datatype(?mcrValue) = xsd:decimal)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-018-ship> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P01/ship> ;
            sh:resultMessage "Applicable power quantities must use decimal numeric values and the kW unit." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Applicable power quantities must use decimal numeric values and the kW unit." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )
                {
                    $this nltl:calculatedRequiredPower ?quantity .
                    ?quantity qudt:numericValue ?value .
                    FILTER (
                        datatype(?value) != xsd:decimal
                        ||
                        NOT EXISTS {
                            ?quantity qudt:unit qudt:KiloW .
                        }
                    )
                }
                UNION
                {
                    $this nltl:maximumContinuousRatingPower ?quantity .
                    ?quantity qudt:numericValue ?value .
                    FILTER (
                        datatype(?value) != xsd:decimal
                        ||
                        NOT EXISTS {
                            ?quantity qudt:unit qudt:KiloW .
                        }
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-018-ship> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P01/ship> ] .

