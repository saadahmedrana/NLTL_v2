d:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:upperIceWaterlineBreadth ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:upperIceWaterlineLength ] ] ; sh:path nltl:hasLowerIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:iceWaterline ; sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:upperIceWaterlineBreadth ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:upperIceWaterlineLength ] ] ; sh:path nltl:hasUpperIceWaterline ], [ sh:minInclusive Literal("2003-09-01", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ; sh:sparql [ sh:message Literal("Maximum continuous rating power must be at least both externally calculated minimum powers.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX q: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:maximumContinuousRatingPower ?mcrQ .
                        ?mcrQ q:numericValue ?mcr .
                        $this nltl:minimumRequiredPowerAtLowerIceWaterline ?lowerQ .
                        ?lowerQ q:numericValue ?lower .
                        $this nltl:minimumRequiredPowerAtUpperIceWaterline ?upperQ .
                        ?upperQ q:numericValue ?upper .
                        FILTER (?mcr < ?lower || ?mcr < ?upper)
