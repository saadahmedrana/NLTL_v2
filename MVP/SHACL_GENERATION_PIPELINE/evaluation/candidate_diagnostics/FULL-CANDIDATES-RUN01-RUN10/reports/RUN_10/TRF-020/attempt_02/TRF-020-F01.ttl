                ") ] ] , [ sh:property [ sh:maxExclusive Literal("2003-09-01", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ] , [ sh:property [ sh:not [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc ) ] ; sh:path nltl:iceClass ] ]""" ;
