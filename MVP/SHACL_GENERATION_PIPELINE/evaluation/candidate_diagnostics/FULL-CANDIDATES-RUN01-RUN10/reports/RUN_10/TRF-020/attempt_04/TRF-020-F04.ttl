@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-F04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:integer ; sh:maxInclusive Literal("3", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerCount ], [ sh:in ( nltl:controllablePitch nltl:fixedPitch ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerPitchControlType ], [ sh:in ( nltl:conventionalPropulsionSystem nltl:electricPropulsionMachinery nltl:hydraulicPropulsionMachinery ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propulsionSystemType ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc ) ; sh:path nltl:iceClass ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:engineOutputCoefficientKe ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:iceWaterline ; sh:property [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:upperIceWaterlineBreadth ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:upperIceWaterlineLength ] ] ; sh:path nltl:hasUpperIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class nltl:iceWaterline ] ; sh:path nltl:hasLowerIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:brashIceChannelResistanceAtLowerIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:brashIceChannelResistanceAtUpperIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloW> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:minimumRequiredPowerAtLowerIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloW> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:minimumRequiredPowerAtUpperIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:propellerDiameter ], [ sh:minInclusive Literal("2003-09-01", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ; sh:sparql [ sh:message Literal("Maximum continuous rating power must be at least both externally calculated minimum powers.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    SELECT $this
                    WHERE {
                        $this nltl:maximumContinuousRatingPower ?mcrNode ;
                              nltl:minimumRequiredPowerAtLowerIceWaterline ?lowerNode ;
                              nltl:minimumRequiredPowerAtUpperIceWaterline ?upperNode .
                        ?mcrNode qudt:numericValue ?mcr .
                        ?lowerNode qudt:numericValue ?lower .
                        ?upperNode qudt:numericValue ?upper .
                        FILTER (?mcr < ?lower || ?mcr < ?upper)
                    }
                ") ], [ sh:message Literal("The engine-output coefficient Ke does not match the Table 3-1 selection for propeller count, pitch-control type, and propulsion-system type.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerCount ?count ;
                              nltl:propellerPitchControlType ?pitch ;
                              nltl:propulsionSystemType ?propulsion ;
                              nltl:engineOutputCoefficientKe ?keNode .
                        ?keNode qudt:numericValue ?ke .
                        FILTER (
                            !(
                                (?count = 1 && ?pitch = nltl:controllablePitch && ?ke = "2.03"^^xsd:decimal) ||
                                (?count = 1 && ?pitch = nltl:fixedPitch && ?ke = "2.26"^^xsd:decimal) ||
                                (?count = 1 && ?propulsion IN (nltl:electricPropulsionMachinery, nltl:hydraulicPropulsionMachinery) && ?ke = "2.03"^^xsd:decimal) ||
                                (?count = 2 && ?pitch = nltl:controllablePitch && ?ke = "1.44"^^xsd:decimal) ||
                                (?count = 2 && ?pitch = nltl:fixedPitch && ?ke = "1.60"^^xsd:decimal) ||
                                (?count = 2 && ?propulsion IN (nltl:electricPropulsionMachinery, nltl:hydraulicPropulsionMachinery) && ?ke = "1.44"^^xsd:decimal) ||
                                (?count = 3 && ?pitch = nltl:controllablePitch && ?ke = "1.18"^^xsd:decimal) ||
                                (?count = 3 && ?pitch = nltl:fixedPitch && ?ke = "1.31"^^xsd:decimal) ||
                                (?count = 3 && ?propulsion IN (nltl:electricPropulsionMachinery, nltl:hydraulicPropulsionMachinery) && ?ke = "1.18"^^xsd:decimal)
                            )
                        )
                    }
                ") ] ] , [ sh:property [ sh:maxExclusive Literal("2003-09-01", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ] , [ sh:property [ sh:not [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc ) ] ; sh:path nltl:iceClass ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-020> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-F04/ship> ] .

