@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F02/ship> ;
            sh:resultMessage "For an IB or IC ship to which the 1985 ice-class rules apply, maximum continuous rating power must be a kW QuantityValue and must be at least the required power under the 1985 rules." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an IB or IC ship to which the 1985 ice-class rules apply, maximum continuous rating power must be a kW QuantityValue and must be at least the required power under the 1985 rules." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 .

                FILTER (
                    ?iceClass = nltl:iceClassIb ||
                    ?iceClass = nltl:iceClassIc
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:maximumContinuousRatingPower ?maximumPower .
                        ?maximumPower a qudt:QuantityValue ;
                                      qudt:numericValue ?maximumValue ;
                                      qudt:unit qudt:KiloW .
                        FILTER (datatype(?maximumValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:requiredPowerUnder1985Rules ?requiredPower .
                        ?requiredPower a qudt:QuantityValue ;
                                       qudt:numericValue ?requiredValue ;
                                       qudt:unit qudt:KiloW .
                        FILTER (datatype(?requiredValue) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        $this nltl:maximumContinuousRatingPower ?maximumPower ;
                              nltl:requiredPowerUnder1985Rules ?requiredPower .
                        ?maximumPower a qudt:QuantityValue ;
                                      qudt:numericValue ?maximumValue ;
                                      qudt:unit qudt:KiloW .
                        ?requiredPower a qudt:QuantityValue ;
                                       qudt:numericValue ?requiredValue ;
                                       qudt:unit qudt:KiloW .
                        FILTER (datatype(?maximumValue) = xsd:decimal)
                        FILTER (datatype(?requiredValue) = xsd:decimal)
                        FILTER (?maximumValue < ?requiredValue)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-023> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F02/ship> ] .

