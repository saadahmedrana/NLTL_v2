@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-F01/ship> ;
            sh:resultMessage "The ship's ice-class applicability and, where applicable, the twenty-year compliance deadline must be satisfied." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-024> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-F01/ship> ] .

