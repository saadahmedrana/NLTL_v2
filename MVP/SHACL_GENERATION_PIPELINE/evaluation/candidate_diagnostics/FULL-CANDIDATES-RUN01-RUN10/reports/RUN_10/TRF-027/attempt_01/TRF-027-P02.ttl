=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:clampedHullGeometryTerm ] ; sh:sparql [ sh:message Literal("For an IA Super or IA ship, constructionStageDate must be before 2003-09-01 for this rule to apply.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass ;
                              nltl:constructionStageDate ?date .
                        FILTER (
                            ?iceClass IN (nltl:iceClassIa, nltl:iceClassIaSuper)
                            &&
                            (
                                YEAR(?date) > 2003
                                ||
                                (YEAR(?date) = 2003 && MONTH(?date) > 9)
                                ||
                                (YEAR(?date) = 2003 && MONTH(?date) = 9 && DAY(?date) >= 1)
                            )
                        )
                    }
                ") ], [ sh:message Literal("clampedHullGeometryTerm must equal ((shipLength * iceClassDraught) / shipBreadth squared) cubed, clamped to the inclusive interval 5 to 20, within numerical tolerance.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass ;
                              nltl:constructionStageDate ?date ;
                              nltl:shipLength ?lengthNode ;
                              nltl:iceClassDraught ?draughtNode ;
                              nltl:shipBreadth ?breadthNode ;
                              nltl:clampedHullGeometryTerm ?resultNode .
                        ?lengthNode qudt:numericValue ?length .
                        ?draughtNode qudt:numericValue ?draught .
                        ?breadthNode qudt:numericValue ?breadth .
                        ?resultNode qudt:numericValue ?reported .
                        FILTER (
                            ?iceClass IN (nltl:iceClassIa, nltl:iceClassIaSuper)
                            &&
                            (
                                YEAR(?date) < 2003
                                ||
                                (YEAR(?date) = 2003 && MONTH(?date) < 9)
                                ||
                                (YEAR(?date) = 2003 && MONTH(?date) = 9 && DAY(?date) < 1)
                            )
                        )
                        BIND (((?length * ?draught) / (?breadth * ?breadth)) *
                              ((?length * ?draught) / (?breadth * ?breadth)) *
                              ((?length * ?draught) / (?breadth * ?breadth)) AS ?raw)
                        BIND (IF(?raw < 5, 5, IF(?raw > 20, 20, ?raw)) AS ?expected)
                        FILTER (ABS(?reported - ?expected) >
                                ((0.000001 * ABS(?expected)) + 0.000001))
                    }
                ") ] ] , [ sh:sparql [ sh:message Literal("This rule applies only to IA Super or IA ships with constructionStageDate before 2003-09-01.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass ;
                              nltl:constructionStageDate ?date .
                        FILTER (
                            ?iceClass IN (nltl:iceClassIa, nltl:iceClassIaSuper)
                            &&
                            (
                                YEAR(?date) < 2003
                                ||
                                (YEAR(?date) = 2003 && MONTH(?date) < 9)
                                ||
                                (YEAR(?date) = 2003 && MONTH(?date) = 9 && DAY(?date) < 1)
                            )
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-027-StaticCalculationShape> ;
