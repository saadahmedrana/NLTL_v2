@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F05/ship> ;
            sh:resultMessage "The approval or revocation status shall be recorded using a permitted evidence state." ;
            sh:resultPath nltl:approvalRevocationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceState ;
                    sh:in ( nltl:evidenceStateApproved nltl:evidenceStateDraft nltl:evidenceStateExpired nltl:evidenceStateRejected nltl:evidenceStateRevoked nltl:evidenceStateSubmitted nltl:evidenceStateUnderReview ) ;
                    sh:maxCount 1 ;
                    sh:message "The approval or revocation status shall be recorded using a permitted evidence state." ;
                    sh:minCount 1 ;
                    sh:path nltl:approvalRevocationStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F05/ship> ;
            sh:resultMessage "The ship shall provide evidence for either an alternative calculation or a model test." ;
            sh:resultPath nltl:hasEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide evidence for either an alternative calculation or a model test." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:evidenceArtifact ] ;
                    sh:or ( gen:AlternativeCalculationBranch gen:ModelTestBranch ) ;
                    sh:path nltl:hasEvidence ] ] .

