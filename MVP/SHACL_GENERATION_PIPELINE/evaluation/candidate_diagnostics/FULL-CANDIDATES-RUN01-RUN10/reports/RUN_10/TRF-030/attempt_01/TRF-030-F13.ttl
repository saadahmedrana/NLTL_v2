@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/ship> ;
            sh:resultMessage "The ship must provide the load patch height in metres." ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the load patch height in metres." ;
                    sh:minCount 1 ;
                    sh:node g:LengthQuantityShape ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/ship> ;
            sh:resultMessage "The ship must state whether load length is determined from the arrangement." ;
            sh:resultPath nltl:loadLengthDeterminedFromArrangement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "The ship must state whether load length is determined from the arrangement." ;
                    sh:minCount 1 ;
                    sh:path nltl:loadLengthDeterminedFromArrangement ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/ship> ;
            sh:resultMessage "The externally determined applied ice pressure must be provided in MPa." ;
            sh:resultPath nltl:appliedIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The externally determined applied ice pressure must be provided in MPa." ;
                    sh:minCount 1 ;
                    sh:node g:PressureQuantityShape ;
                    sh:path nltl:appliedIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadLengthDeterminedFromArrangement ] ] , [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadLengthDeterminedFromArrangement ], [ sh:message Literal(\"When load length is not determined from the arrangement, each direct analysis case must pair load patch length with its corresponding area factor.\") ; sh:minCount Literal(\"2\", datatype=xsd:integer) ; sh:node g:LoadLengthAnalysisCaseShape ; sh:path nltl:hasDirectAnalysisCase ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:TRF030ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/ship> ;
            sh:resultMessage "The ship must provide the ice pressure in MPa." ;
            sh:resultPath nltl:icePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the ice pressure in MPa." ;
                    sh:minCount 1 ;
                    sh:node g:PressureQuantityShape ;
                    sh:path nltl:icePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/ship> ;
            sh:resultMessage "The ship must provide several direct analysis cases." ;
            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:directAnalysisCase ;
                    sh:message "The ship must provide several direct analysis cases." ;
                    sh:minCount 2 ;
                    sh:node g:DirectAnalysisCaseShape ;
                    sh:path nltl:hasDirectAnalysisCase ] ] .

