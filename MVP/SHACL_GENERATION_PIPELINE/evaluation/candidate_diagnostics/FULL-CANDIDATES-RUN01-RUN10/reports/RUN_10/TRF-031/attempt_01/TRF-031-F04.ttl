@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/ship> ;
            sh:resultMessage "When beam theory is used, allowableShearStress must be no larger than 0.9 times yieldPoint divided by sqrt(3)." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When beam theory is used, allowableShearStress must be no larger than 0.9 times yieldPoint divided by sqrt(3)." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:beamTheoryUsed true ;
                      nltl:yieldPoint ?yieldPointQuantity ;
                      nltl:allowableShearStress ?allowableQuantity .

                ?yieldPointQuantity qudt:numericValue ?yieldPoint .
                ?allowableQuantity qudt:numericValue ?allowable .

                FILTER (?allowable > 0.9 * (?yieldPoint / 1.7320508075688772))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-031> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/ship> ] .

