@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ;
            sh:resultMessage "Yield shear stress must equal yield point divided by sqrt(3) within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Yield shear stress must equal yield point divided by sqrt(3) within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldPoint ;
                      nltl:yieldShearStress ?yieldShear .
                ?yieldPoint qudt:numericValue ?yieldPointValue .
                ?yieldShear qudt:numericValue ?yieldShearValue .
                BIND (?yieldPointValue / 1.7320508075688772935 AS ?expectedValue)
                BIND ((?expectedValue * 0.000001) + 0.000000001 AS ?tolerance)
                FILTER (
                    (?yieldShearValue < (?expectedValue - ?tolerance))
                    ||
                    (?yieldShearValue > (?expectedValue + ?tolerance))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-031-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F03/ship> ] .

