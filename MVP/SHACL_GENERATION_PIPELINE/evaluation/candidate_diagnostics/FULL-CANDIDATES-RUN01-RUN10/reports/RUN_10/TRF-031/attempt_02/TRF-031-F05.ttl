@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F05/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:beamTheoryUsed ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-031-QuantityValueShape> ; sh:path nltl:allowableShearStress ] ; sh:sparql [ sh:message Literal("When beam theory is used, allowable shear stress must be no larger than 0.9 times yield shear stress.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:beamTheoryUsed true ;
                              nltl:allowableShearStress ?allowable ;
                              nltl:yieldShearStress ?yieldShear .
                        ?allowable qudt:numericValue ?allowableValue .
                        ?yieldShear qudt:numericValue ?yieldShearValue .
                        FILTER (?allowableValue > (0.9 * ?yieldShearValue))
                    }
                ") ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:beamTheoryUsed ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-031-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F05/ship> ] .

