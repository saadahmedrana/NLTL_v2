@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F02/ship> ;
            sh:resultMessage "Combined bending and shear stress must be lower than the yield point, and yield shear stress must equal yield point divided by square root of three within the permitted tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Combined bending and shear stress must be lower than the yield point, and yield shear stress must equal yield point divided by square root of three within the permitted tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldPointNode ;
                      nltl:combinedBendingShearStress ?combinedNode ;
                      nltl:yieldShearStress ?yieldShearNode .
                ?yieldPointNode qudt:numericValue ?yieldPoint .
                ?combinedNode qudt:numericValue ?combined .
                ?yieldShearNode qudt:numericValue ?yieldShear .
                BIND ((?yieldPoint / 1.7320508075688772) AS ?expected)
                BIND (((?expected * 0.000001) + 0.000000000001) AS ?tolerance)
                FILTER (
                    (?combined >= ?yieldPoint) ||
                    (?yieldShear < (?expected - ?tolerance)) ||
                    (?yieldShear > (?expected + ?tolerance))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF031Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F02/ship> ;
            sh:resultMessage "Node ex:ship->nltl:vonMisesYieldCriterion does not contain a value in the set: ['Literal(\"von Mises\")']" ;
            sh:resultPath nltl:vonMisesYieldCriterion ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:hasValue "von Mises" ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:vonMisesYieldCriterion ] ] .

