@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F05/ship> ;
            sh:resultMessage "Node ex:ship->nltl:vonMisesYieldCriterion does not contain a value in the set: ['Literal(\"von Mises\")']" ;
            sh:resultPath nltl:vonMisesYieldCriterion ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:hasValue "von Mises" ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:vonMisesYieldCriterion ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:node gen:BeamTheoryTrueShape ] , [ sh:node gen:BeamTheoryFalseShape ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF031Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F05/ship> ] .

