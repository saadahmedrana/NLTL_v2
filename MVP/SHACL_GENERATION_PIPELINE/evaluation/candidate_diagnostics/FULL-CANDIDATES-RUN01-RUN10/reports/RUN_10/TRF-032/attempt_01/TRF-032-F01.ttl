@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceStrengtheningStatus ] ] , [ sh:or ( [ sh:sparql [ sh:message Literal("The regulation-required scantling must not be less than the classification-society-required scantling unless the latter is selected.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:regulationRequiredScantling ?regulationQuantity .
                                ?regulationQuantity qudt:numericValue ?regulationValue .
                                $this nltl:classificationSocietyRequiredScantling ?classificationQuantity .
                                ?classificationQuantity qudt:numericValue ?classificationValue .
                                FILTER (?regulationValue < ?classificationValue)
                            }
                        ") ] ] [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:selectedDesignScantling ] ; sh:sparql [ sh:message Literal("When the regulation-required scantling is less than the classification-society-required scantling, the selected design scantling must equal the classification-society-required scantling.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:regulationRequiredScantling ?regulationQuantity .
                                ?regulationQuantity qudt:numericValue ?regulationValue .
                                $this nltl:classificationSocietyRequiredScantling ?classificationQuantity .
                                ?classificationQuantity qudt:numericValue ?classificationValue .
                                FILTER (?regulationValue < ?classificationValue)
                                FILTER NOT EXISTS {
                                    $this nltl:selectedDesignScantling ?selectedQuantity .
                                    ?selectedQuantity qudt:numericValue ?selectedValue .
                                    FILTER (?selectedValue = ?classificationValue)
                                }
                            }
                        ") ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceStrengtheningStatus ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:classificationSocietyRequiredScantling ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:regulationRequiredScantling ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF032Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-F01/ship> ] .

