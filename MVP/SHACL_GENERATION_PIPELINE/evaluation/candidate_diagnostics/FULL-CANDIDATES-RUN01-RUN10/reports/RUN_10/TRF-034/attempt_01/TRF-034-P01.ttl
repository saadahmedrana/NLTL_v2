@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-P01/effectiveSection> ;
            sh:resultMessage "The effective member cross section must be linked from a hull structure with a valid plating-normal selector; non-normal members require classification-society section-property calculation evidence." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:TRF034EffectiveMemberCrossSectionShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-P01/effectiveSection> ] .

