@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F03/designParameters> ;
            sh:resultMessage "The ice-class design parameter set must specify one permitted ice class." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceClassValue ;
                    sh:maxCount 1 ;
                    sh:message "The ice-class design parameter set must specify one permitted ice class." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:iceClass ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F03/designParameters> ;
            sh:resultMessage "The level ice thickness and design ice load height must match the values specified for the selected ice class." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-036_IceClassDesignParameterSetShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F03/designParameters> ] .

