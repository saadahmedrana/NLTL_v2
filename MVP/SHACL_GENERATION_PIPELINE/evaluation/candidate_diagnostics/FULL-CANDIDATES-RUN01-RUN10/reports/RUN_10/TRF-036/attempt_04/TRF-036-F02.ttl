@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/designParameters> ;
            sh:resultMessage "Node ex:designParameters must conform to one or more shapes in gen:TRF036IaSuperCase , gen:TRF036IaCase , gen:TRF036IbCase , gen:TRF036IcCase" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF036Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/designParameters> ] .

