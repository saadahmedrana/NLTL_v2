@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in ([ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For ice class IA Super, forefoot shell strengthening shall be equivalent to the bow region.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:forefootShellStrengtheningStatus ], [ sh:hasValue nltl:iceClassIaSuper ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:in ( nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ]) and ([ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For ice class IA Super or IA at an open-water service speed of at least 18 knots, upper-bow ice-belt strengthening shall be equivalent to the midbody region.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:upperBowIceBeltStrengtheningStatus ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:TRF040AtLeast18KnotsShape ; sh:path nltl:openWaterServiceSpeed ] ] , [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:TRF040Below18KnotsShape ; sh:path nltl:openWaterServiceSpeed ] ]) and ([ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Where the weather deck is below the ice-belt upper limit, freeing-port construction shall meet the ice-belt shell strength requirement.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:freeingPortStrengthStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Where the weather deck is below the ice-belt upper limit, the bulwark shall meet the ice-belt shell strength requirement.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bulwarkStrengthStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:weatherDeckBelowIceBeltUpperLimit ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:weatherDeckBelowIceBeltUpperLimit ] ])" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:TRF040Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F02/ship> ;
            sh:resultMessage "Design operation speed in ice is required as a single knot-valued quantity." ;
            sh:resultPath nltl:designOperationSpeedInIce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Design operation speed in ice is required as a single knot-valued quantity." ;
                    sh:minCount 1 ;
                    sh:node nltlgen:TRF040KnotsShape ;
                    sh:path nltl:designOperationSpeedInIce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F02/ship> ;
            sh:resultMessage "Thickness is required as a single metre-valued quantity." ;
            sh:resultPath nltl:thickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Thickness is required as a single metre-valued quantity." ;
                    sh:minCount 1 ;
                    sh:node nltlgen:TRF040MetersShape ;
                    sh:path nltl:thickness ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-F02/ship> ;
            sh:resultMessage "Spacing is required as a single metre-valued quantity." ;
            sh:resultPath nltl:spacing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Spacing is required as a single metre-valued quantity." ;
                    sh:minCount 1 ;
                    sh:node nltlgen:TRF040MetersShape ;
                    sh:path nltl:spacing ] ] .

