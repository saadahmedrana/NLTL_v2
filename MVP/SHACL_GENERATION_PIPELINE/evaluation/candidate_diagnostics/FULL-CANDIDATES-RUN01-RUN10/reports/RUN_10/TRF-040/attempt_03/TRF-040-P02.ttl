@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-P02/ship> ;
            sh:resultMessage "The specified frame spacing shall be supplied as a single metre quantity." ;
            sh:resultPath nltl:spacing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The specified frame spacing shall be supplied as a single metre quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:spacing ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-P02/ship> ;
            sh:resultMessage "The design operation speed in ice shall be supplied as a single knot quantity." ;
            sh:resultPath nltl:designOperationSpeedInIce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The design operation speed in ice shall be supplied as a single knot quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:KN ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:designOperationSpeedInIce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-P02/ship> ;
            sh:resultMessage "The applicable shell thickness shall be supplied as a single metre quantity." ;
            sh:resultPath nltl:thickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The applicable shell thickness shall be supplied as a single metre quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:thickness ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-P02/ship> ;
            sh:resultMessage "For IA Super or IA ships with open-water service speed of at least 18 knots, the upper-bow ice-belt strengthening status shall equal the midbody-equivalent status, with one boolean value for each property." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For IA Super or IA ships with open-water service speed of at least 18 knots, the upper-bow ice-belt strengthening status shall equal the midbody-equivalent status, with one boolean value for each property." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:openWaterServiceSpeed ?speed .
                FILTER (
                    ?iceClass = nltl:iceClassIaSuper ||
                    ?iceClass = nltl:iceClassIa
                )
                ?speed qudt:numericValue ?speedValue .
                FILTER (
                    datatype(?speedValue) = xsd:decimal &&
                    ?speedValue >= 18
                )
                FILTER NOT EXISTS {
                    $this nltl:upperBowIceBeltStrengtheningStatus ?upperBow ;
                          nltl:midbodyEquivalent ?midbody .
                    FILTER (datatype(?upperBow) = xsd:boolean)
                    FILTER (datatype(?midbody) = xsd:boolean)
                    FILTER NOT EXISTS {
                        $this nltl:upperBowIceBeltStrengtheningStatus ?upperBowOther .
                        FILTER (?upperBowOther != ?upperBow)
                    }
                    FILTER NOT EXISTS {
                        $this nltl:midbodyEquivalent ?midbodyOther .
                        FILTER (?midbodyOther != ?midbody)
                    }
                    FILTER (?upperBow = ?midbody)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-040> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-P02/ship> ] .

