@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F08/plating> ;
            sh:resultMessage "Plating framing orientation must identify transverse or longitudinal framing." ;
            sh:resultPath nltl:platingFramingOrientation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:transverseFramingOrientation nltl:longitudinalFramingOrientation ) ;
                    sh:maxCount 1 ;
                    sh:message "Plating framing orientation must identify transverse or longitudinal framing." ;
                    sh:minCount 1 ;
                    sh:path nltl:platingFramingOrientation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F08/plating> ;
            sh:resultMessage "The applicable transverse or longitudinal shell-plating calculation inputs must be present; the calculated thickness must be supplied as an external result." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF041PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F08/plating> ] .

