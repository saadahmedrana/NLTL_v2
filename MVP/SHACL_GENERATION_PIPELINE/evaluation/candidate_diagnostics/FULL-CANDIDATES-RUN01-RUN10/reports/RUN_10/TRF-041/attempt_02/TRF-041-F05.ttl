@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F05/plating> ;
            sh:resultMessage "Node ex:plating must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:transverseFramingOrientation ; sh:message Literal(\"The plating framing orientation must identify transverse framing.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:platingFramingOrientation ], [ sh:message Literal(\"Plating pressure is required for transverse framing.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-041-PressureQuantityShape> ; sh:path nltl:platingPressure ], [ sh:message Literal(\"The transverse plating factor f1 is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-041-DimensionlessQuantityShape> ; sh:path nltl:transversePlatingFactorF1 ] ] , [ sh:property [ sh:hasValue nltl:longitudinalFramingOrientation ; sh:message Literal(\"The plating framing orientation must identify longitudinal framing.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:platingFramingOrientation ], [ sh:message Literal(\"Ice pressure is required for longitudinal framing.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-041-PressureQuantityShape> ; sh:path nltl:icePressure ], [ sh:message Literal(\"The longitudinal plating factor f2 is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-041-DimensionlessQuantityShape> ; sh:path nltl:longitudinalPlatingFactorF2 ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-041-PlatingShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F05/plating> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F05/spacingValue> ;
                    sh:resultMessage "The length quantity must use millimetres." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                            sh:maxCount 1 ;
                            sh:message "The length quantity must use millimetres." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F05/plating> ;
            sh:resultMessage "Spacing is required for the applicable shell-plating calculation." ;
            sh:resultPath nltl:spacing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Spacing is required for the applicable shell-plating calculation." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-041-LengthQuantityShape> ;
                    sh:path nltl:spacing ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F05/spacingValue> ] .

