@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F06/spacingValue> ;
                    sh:resultMessage "The length quantity must use millimetres." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                            sh:maxCount 1 ;
                            sh:message "The length quantity must use millimetres." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F06/plating> ;
            sh:resultMessage "Spacing is required for the applicable shell-plating calculation." ;
            sh:resultPath nltl:spacing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Spacing is required for the applicable shell-plating calculation." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-041-LengthQuantityShape> ;
                    sh:path nltl:spacing ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F06/spacingValue> ] .

