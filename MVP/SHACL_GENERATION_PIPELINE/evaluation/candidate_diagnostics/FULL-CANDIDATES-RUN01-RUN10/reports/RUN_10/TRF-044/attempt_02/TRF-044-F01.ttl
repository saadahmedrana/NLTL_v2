@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ;
            sh:resultMessage "Node ex:transverseFrame must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:bulkCarrierTopWingTankFrameCondition ; sh:path nltl:frameBoundaryConditionType ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"7\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"7\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:frameBoundaryConditionFactorM0 ] ] , [ sh:property [ sh:hasValue nltl:singleDeckTankTopToMainDeckFrameCondition ; sh:path nltl:frameBoundaryConditionType ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"6\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"6\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:frameBoundaryConditionFactorM0 ] ] , [ sh:property [ sh:hasValue nltl:multiDeckOrStringerContinuousFrameCondition ; sh:path nltl:frameBoundaryConditionType ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"5.7\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"5.7\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:frameBoundaryConditionFactorM0 ] ] , [ sh:property [ sh:hasValue nltl:twoDeckFrameCondition ; sh:path nltl:frameBoundaryConditionType ], [ sh:node [ sh:property [ sh:maxInclusive Literal(\"5\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"5\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:frameBoundaryConditionFactorM0 ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF044TransverseFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F01/transverseFrame> ] .

