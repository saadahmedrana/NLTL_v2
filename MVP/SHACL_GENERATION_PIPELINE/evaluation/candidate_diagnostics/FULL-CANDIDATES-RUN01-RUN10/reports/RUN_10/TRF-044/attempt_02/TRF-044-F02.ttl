@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F02/transverseFrame> ;
            sh:resultMessage "Frame moment factor, section modulus, and required shear area must match the declared direct-calculation formulas within the specified tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Frame moment factor, section modulus, and required shear area must match the declared direct-calculation formulas within the specified tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:spacing ?sNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:yieldStrength ?ysNode ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?sNode qudt:numericValue ?s .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?m0Node qudt:numericValue ?m0 .
                ?ysNode qudt:numericValue ?ys .
                ?mtNode qudt:numericValue ?mt .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND ((7 * ?m0) / (7 - (5 * ?h / ?l)) AS ?mtExpected)
                BIND (((?p * ?s * ?h * ?l) / (?mtExpected * ?ys)) * 1000000 AS ?zExpected)
                BIND (((1.7320508075688772 * 1.2 * ?p * ?h * ?s) / (2 * ?ys)) * 10000 AS ?aExpected)

                FILTER (
                    (?mt < (?mtExpected - ((?mtExpected * 0.000001) + 0.000001)) ||
                     ?mt > (?mtExpected + ((?mtExpected * 0.000001) + 0.000001))) ||
                    (?z < (?zExpected - ((?zExpected * 0.000001) + 0.000001)) ||
                     ?z > (?zExpected + ((?zExpected * 0.000001) + 0.000001))) ||
                    (?a < (?aExpected - ((?aExpected * 0.000001) + 0.000001)) ||
                     ?a > (?aExpected + ((?aExpected * 0.000001) + 0.000001)))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF044TransverseFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F02/transverseFrame> ] .

