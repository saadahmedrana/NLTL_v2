@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/frame> ;
            sh:resultMessage "The upper end of the strengthened part must attach to a deck, tank boundary plating, or ice stringer." ;
            sh:resultPath _:necf4f644912b49fb83718a93ac31c011b3 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:necf4f644912b49fb83718a93ac31c011b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/adjacentMainFrame> ;
            sh:resultMessage "A frame must identify its strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A frame must identify its strengthened part." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasStrengthenedPart ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/adjacentMainFrame> ;
            sh:resultMessage "The upper end of the strengthened part must attach to a deck, tank boundary plating, or ice stringer." ;
            sh:resultPath _:necf4f644912b49fb83718a93ac31c011b3 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:necf4f644912b49fb83718a93ac31c011b2 ] .

_:N1b7586a12e564880bcb3db5e027a4f00 rdf:first [ sh:class nltl:deckStructure ] ;
    rdf:rest ( [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:iceStringer ] ) .

_:N265fab1e72384ec2803fd1613330e07d rdf:first nltl:hasUpperEnd ;
    rdf:rest ( nltl:hasAttachedSupportingStructure ) .

_:N6ef69cebcaa94287b39dbe05a6ebeb8e rdf:first nltl:hasAttachedSupportingStructure ;
    rdf:rest () .

_:necf4f644912b49fb83718a93ac31c011b2 sh:message "The upper end of the strengthened part must attach to a deck, tank boundary plating, or ice stringer." ;
    sh:minCount 1 ;
    sh:or _:N1b7586a12e564880bcb3db5e027a4f00 ;
    sh:path _:N265fab1e72384ec2803fd1613330e07d .

_:necf4f644912b49fb83718a93ac31c011b3 rdf:first nltl:hasUpperEnd ;
    rdf:rest _:N6ef69cebcaa94287b39dbe05a6ebeb8e .

