@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-P04/adjacentMainFrame> ;
            sh:resultMessage "The strengthened part upper end of a main frame or intermediate ice frame must be attached to a deck, tank boundary plating, or ice stringer." ;
            sh:resultPath _:n78ca95aabfe74d819084e23744db9259b2 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n78ca95aabfe74d819084e23744db9259b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-P04/frame> ;
            sh:resultMessage "The strengthened part upper end of a main frame or intermediate ice frame must be attached to a deck, tank boundary plating, or ice stringer." ;
            sh:resultPath _:n78ca95aabfe74d819084e23744db9259b2 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n78ca95aabfe74d819084e23744db9259b1 ] .

_:N19ef12c3a16e44e8aa94b36a90723681 rdf:first nltl:hasUpperEnd ;
    rdf:rest ( nltl:hasAttachedSupportingStructure ) .

_:N3a38f043b4204132bb2d6e88fc401269 rdf:first [ sh:class nltl:tankBoundaryPlating ] ;
    rdf:rest ( [ sh:class nltl:iceStringer ] ) .

_:N7d7497b72ebc4453968501615581d2a7 rdf:first [ sh:class nltl:deckStructure ] ;
    rdf:rest _:N3a38f043b4204132bb2d6e88fc401269 .

_:N7ee301486b2e4d73800f188d778ffaef rdf:first nltl:hasStrengthenedPart ;
    rdf:rest _:N19ef12c3a16e44e8aa94b36a90723681 .

_:Naf80c7b8d55942f0a2719891492a4f45 rdf:first nltl:hasUpperEnd ;
    rdf:rest ( nltl:hasAttachedSupportingStructure ) .

_:n78ca95aabfe74d819084e23744db9259b1 sh:message "The strengthened part upper end of a main frame or intermediate ice frame must be attached to a deck, tank boundary plating, or ice stringer." ;
    sh:minCount 1 ;
    sh:or _:N7d7497b72ebc4453968501615581d2a7 ;
    sh:path _:N7ee301486b2e4d73800f188d778ffaef .

_:n78ca95aabfe74d819084e23744db9259b2 rdf:first nltl:hasStrengthenedPart ;
    rdf:rest _:Naf80c7b8d55942f0a2719891492a4f45 .

