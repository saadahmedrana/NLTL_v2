@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/frame> ;
            sh:resultMessage "The frame must conform as a main frame or an intermediate ice frame under clause 4.4.2.3." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF047FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/adjacentMainFrame> ;
            sh:resultMessage "The frame must conform as a main frame or an intermediate ice frame under clause 4.4.2.3." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF047FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/adjacentMainFrame> ] .

