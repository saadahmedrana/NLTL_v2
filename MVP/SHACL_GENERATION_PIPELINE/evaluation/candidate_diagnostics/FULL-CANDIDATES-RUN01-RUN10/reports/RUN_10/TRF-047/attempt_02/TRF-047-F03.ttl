@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/frame> ;
            sh:resultMessage "Each lower end of a main frame or intermediate ice frame shall have an allowed supporting-structure attachment or the permitted horizontal-member connection." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each lower end of a main frame or intermediate ice frame shall have an allowed supporting-structure attachment or the permitted horizontal-member connection." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this rdf:type ?frameType .
                FILTER (?frameType IN (nltl:mainFrame, nltl:intermediateIceFrame))
                $this rdf:type nltl:transverseFrame .
                $this nltl:hasLowerEnd ?lowerEnd .
                FILTER NOT EXISTS {
                    ?lowerEnd nltl:hasAttachedSupportingStructure ?directSupport .
                    ?directSupport rdf:type nltl:supportingStructure .
                    ?directSupport rdf:type ?directType .
                    FILTER (?directType IN (
                        nltl:deckStructure,
                        nltl:tankBoundaryPlating,
                        nltl:tankTop,
                        nltl:iceStringer
                    ))
                }
                FILTER NOT EXISTS {
                    ?lowerEnd nltl:hasTerminationBelowSupportingStructure ?lowerSupport .
                    ?lowerSupport rdf:type nltl:supportingStructure .
                    ?lowerSupport rdf:type ?lowerType .
                    FILTER (?lowerType IN (
                        nltl:deckStructure,
                        nltl:tankBoundaryPlating,
                        nltl:tankTop,
                        nltl:iceStringer
                    ))
                    $this nltl:supportingStructureAtOrBelowIceBeltLowerLimit "true"^^xsd:boolean .
                    $this nltl:sameScantlingsAsMainFrame "true"^^xsd:boolean .
                    ?lowerEnd nltl:hasHorizontalConnectionMember ?member .
                    ?member rdf:type nltl:horizontalConnectionMember .
                    ?member nltl:connectsToAdjacentMainFrame ?adjacentMain .
                    ?adjacentMain rdf:type nltl:mainFrame .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF047FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/adjacentMainFrame> ;
            sh:resultMessage "A main frame or intermediate ice frame shall have a strengthened part." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A main frame or intermediate ice frame shall have a strengthened part." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this
            WHERE {
                $this rdf:type ?frameType .
                FILTER (?frameType IN (nltl:mainFrame, nltl:intermediateIceFrame))
                FILTER NOT EXISTS {
                    $this nltl:hasStrengthenedPart ?part .
                    ?part rdf:type nltl:frameStrengthenedPart .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF047FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/adjacentMainFrame> ] .

