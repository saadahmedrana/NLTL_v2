@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/adjacentMainFrame> ;
            sh:resultMessage "Node ex:adjacentMainFrame must conform to one or more shapes in <urn:nltl:generated-shape:TRF-047_MainFrameBranch> , <urn:nltl:generated-shape:TRF-047_IntermediateIceFrameBranch>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-047_FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/adjacentMainFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in <urn:nltl:generated-shape:TRF-047_MainFrameBranch> , <urn:nltl:generated-shape:TRF-047_IntermediateIceFrameBranch>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-047_FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/frame> ] .

