@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F02/frame> ;
            sh:resultMessage "The lower end of the strengthened main-frame part must use a permitted direct attachment." ;
            sh:resultPath ( nltl:hasStrengthenedPart nltl:hasLowerEnd ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The lower end of the strengthened main-frame part must use a permitted direct attachment." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF047DirectAttachmentShape ;
                    sh:path ( nltl:hasStrengthenedPart nltl:hasLowerEnd ) ] ] .

