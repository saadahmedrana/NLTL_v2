@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ;
            sh:resultMessage "Node ex:longitudinalFrame must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:significantlyDifferentBoundaryConditions ], [ sh:hasValue nltl:continuousBeamWithBracketsFrameCondition ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:frameBoundaryConditionType ], [ sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxInclusive Literal(\"13.3\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"13.3\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:path qudt:unit ] ] ; sh:path nltl:frameMomentFactorM ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:significantlyDifferentBoundaryConditions ], [ sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxExclusive Literal(\"13.3\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:path qudt:unit ] ] ; sh:path nltl:frameMomentFactorM ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-048-LongitudinalFrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ;
            sh:resultMessage "A longitudinal frame must declare one permitted frame boundary condition type." ;
            sh:resultPath nltl:frameBoundaryConditionType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype nltl:frameBoundaryConditionTypeValue ;
                    sh:in ( nltl:continuousBeamWithBracketsFrameCondition nltl:multiDeckOrStringerContinuousFrameCondition nltl:singleDeckTankTopToMainDeckFrameCondition nltl:twoDeckFrameCondition ) ;
                    sh:maxCount 1 ;
                    sh:message "A longitudinal frame must declare one permitted frame boundary condition type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameBoundaryConditionType ] ;
            sh:value nltl:continuousBeamWithBracketsFrameCondition ] .

