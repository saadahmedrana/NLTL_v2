@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F02/longitudinalFrame> ;
            sh:resultMessage "A longitudinal frame must declare one permitted frame boundary condition type." ;
            sh:resultPath nltl:frameBoundaryConditionType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype nltl:frameBoundaryConditionTypeValue ;
                    sh:in ( nltl:continuousBeamWithBracketsFrameCondition nltl:multiDeckOrStringerContinuousFrameCondition nltl:singleDeckTankTopToMainDeckFrameCondition nltl:twoDeckFrameCondition ) ;
                    sh:maxCount 1 ;
                    sh:message "A longitudinal frame must declare one permitted frame boundary condition type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameBoundaryConditionType ] ;
            sh:value nltl:continuousBeamWithBracketsFrameCondition ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F02/longitudinalFrame> ;
            sh:resultMessage "f4, section modulus, and required shear area must match their declared calculations within numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "f4, section modulus, and required shear area must match their declared calculations within numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:spacing/qudt:numericValue ?s ;
                      nltl:span/qudt:numericValue ?l ;
                      nltl:frameMomentFactorM/qudt:numericValue ?m ;
                      nltl:yieldStrength/qudt:numericValue ?sigma ;
                      nltl:longitudinalFrameLoadDistributionFactorF4/qudt:numericValue ?f4 ;
                      nltl:sectionModulus/qudt:numericValue ?z ;
                      nltl:requiredShearArea/qudt:numericValue ?a .

                BIND ((1.0 - (0.2 * ?h / ?s)) AS ?expectedF4)
                BIND (((?expectedF4 * ?p * ?h * ?l * ?l) /
                       (4.0 * ?m * ?sigma)) * 1000000.0 AS ?expectedZ)
                BIND (((1.7320508075688773 * ?expectedF4 * 2.16 * ?p * ?h * ?l) /
                       (2.0 * ?sigma)) * 10000.0 AS ?expectedA)

                FILTER (
                    ABS(?f4 - ?expectedF4) >
                    (0.000001 * ABS(?expectedF4) + 0.000000001)
                    ||
                    ABS(?z - ?expectedZ) >
                    (0.000001 * ABS(?expectedZ) + 0.000000001)
                    ||
                    ABS(?a - ?expectedA) >
                    (0.000001 * ABS(?expectedA) + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-048-LongitudinalFrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F02/longitudinalFrame> ] .

