@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F05/longitudinalFrame> ;
            sh:resultMessage "Frame span must be provided as a single decimal quantity in metres." ;
            sh:resultPath nltl:span ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Frame span must be provided as a single decimal quantity in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:span ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F05/longitudinalFrame> ;
            sh:resultMessage "A longitudinal frame must declare one permitted frame boundary condition type." ;
            sh:resultPath nltl:frameBoundaryConditionType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype nltl:frameBoundaryConditionTypeValue ;
                    sh:in ( nltl:continuousBeamWithBracketsFrameCondition nltl:multiDeckOrStringerContinuousFrameCondition nltl:singleDeckTankTopToMainDeckFrameCondition nltl:twoDeckFrameCondition ) ;
                    sh:maxCount 1 ;
                    sh:message "A longitudinal frame must declare one permitted frame boundary condition type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameBoundaryConditionType ] ;
            sh:value nltl:continuousBeamWithBracketsFrameCondition ] .

