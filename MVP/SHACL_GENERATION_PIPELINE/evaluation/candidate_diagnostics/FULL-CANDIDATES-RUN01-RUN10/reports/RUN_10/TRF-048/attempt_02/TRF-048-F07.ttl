@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ;
            sh:resultMessage "The longitudinal-frame calculated results must match the declared formulas within a relative tolerance of 1e-6." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The longitudinal-frame calculated results must match the declared formulas within a relative tolerance of 1e-6." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>

            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:spacing/qudt:numericValue ?s ;
                      nltl:span/qudt:numericValue ?l ;
                      nltl:frameMomentFactorM/qudt:numericValue ?m ;
                      nltl:yieldStrength/qudt:numericValue ?sigma ;
                      nltl:longitudinalFrameLoadDistributionFactorF4/qudt:numericValue ?f4 ;
                      nltl:sectionModulus/qudt:numericValue ?z ;
                      nltl:requiredShearArea/qudt:numericValue ?a ;
                      nltl:grossFrameShearArea/qudt:numericValue ?gross ;
                      nltl:bracketArea/qudt:numericValue ?bracket ;
                      nltl:actualFrameShearArea/qudt:numericValue ?actual .

                BIND ((1 - (0.2 * ?h / ?s)) AS ?expectedF4)
                BIND ((?expectedF4 * ?p * ?h * ?l * ?l /
                       (4 * ?m * ?sigma) * 1000000) AS ?expectedZ)
                BIND ((math:sin(1.5707963267948966) * ?expectedF4 * 2.16 *
                       ?p * ?h * ?l / (2 * ?sigma) * 10000) AS ?expectedA)
                BIND ((?gross - ?bracket) AS ?expectedActual)

                FILTER (
                    ?f4 < (?expectedF4 - (0.000001 * ?expectedF4)) ||
                    ?f4 > (?expectedF4 + (0.000001 * ?expectedF4)) ||
                    ?z < (?expectedZ - (0.000001 * ?expectedZ)) ||
                    ?z > (?expectedZ + (0.000001 * ?expectedZ)) ||
                    ?a < (?expectedA - (0.000001 * ?expectedA)) ||
                    ?a > (?expectedA + (0.000001 * ?expectedA)) ||
                    ?actual < (?expectedActual - (0.000001 * ?expectedActual)) ||
                    ?actual > (?expectedActual + (0.000001 * ?expectedActual))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF048_LongitudinalFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ] .

