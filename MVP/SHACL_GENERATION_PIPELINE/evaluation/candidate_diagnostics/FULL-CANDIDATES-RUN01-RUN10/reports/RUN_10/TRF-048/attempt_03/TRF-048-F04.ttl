@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F04/longitudinalFrame> ;
            sh:resultMessage "The required shear area must equal the declared frame formula within tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The required shear area must equal the declared frame formula within tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:span/qudt:numericValue ?l ;
                      nltl:yieldStrength/qudt:numericValue ?y ;
                      nltl:longitudinalFrameLoadDistributionFactorF4/qudt:numericValue ?f4 ;
                      nltl:requiredShearArea/qudt:numericValue ?a .
                BIND ((1.7320508075688772 * ?f4 * 2.16 * ?p * ?h * ?l / (2 * ?y)) * 10000 AS ?expected)
                BIND (IF((0.000001 * ?expected) > 0.000000001, (0.000001 * ?expected), 0.000000001) AS ?tol)
                FILTER (?a < (?expected - ?tol) || ?a > (?expected + ?tol))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-048> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F04/longitudinalFrame> ] .

