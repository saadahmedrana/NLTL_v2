@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F06/longitudinalFrame> ;
            sh:resultMessage "Node ex:longitudinalFrame->( nltl:yieldStrength qudt:unit ) does not contain a value in the set: ['<http://qudt.org/vocab/unit/MegaPA>']" ;
            sh:resultPath ( nltl:yieldStrength qudt:unit ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path ( nltl:yieldStrength qudt:unit ) ] ] .

