@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ;
            sh:resultMessage "Bracket shear area must be excluded from the actual frame shear area." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Bracket shear area must be excluded from the actual frame shear area." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:grossFrameShearArea/qudt:numericValue ?gross ;
                      nltl:bracketArea/qudt:numericValue ?bracket ;
                      nltl:actualFrameShearArea/qudt:numericValue ?actual .
                BIND (?gross - ?bracket AS ?expected)
                BIND (IF((0.000001 * ?expected) > 0.000000001, (0.000001 * ?expected), 0.000000001) AS ?tol)
                FILTER (?actual < (?expected - ?tol) || ?actual > (?expected + ?tol))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-048> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ] .

