@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P01/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:class nltl:longitudinalFrame ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF049FittedAttachmentShape ; sh:path nltl:hasFrameAttachment ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:hasSupportingBulkhead ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:hasSupportingWebFrame ] ] , [ sh:class nltl:transverseFrame ; sh:property [ sh:datatype xsd:boolean ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:or ( [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF049FittedAttachmentShape ; sh:path nltl:hasFrameAttachment ] ] [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ] ) ; sh:path nltl:terminatesAtDeckOrIceStringer ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF049FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P01/frame> ] .

