@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P04/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:class nltl:longitudinalFrame ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF049FittedAttachmentShape ; sh:path nltl:hasFrameAttachment ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:hasSupportingBulkhead ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:hasSupportingWebFrame ] ] , [ sh:class nltl:transverseFrame ; sh:property [ sh:datatype xsd:boolean ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:or ( [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF049FittedAttachmentShape ; sh:path nltl:hasFrameAttachment ] ] [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ] ) ; sh:path nltl:terminatesAtDeckOrIceStringer ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF049FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P04/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P04/frame> ;
            sh:resultMessage "Node Literal(\"true\" = True, datatype=xsd:boolean) must conform to one or more shapes in [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:effectiveAttachmentConfirmed ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF049AttachmentShape ; sh:path nltl:hasFrameAttachment ] ] , [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ]" ;
            sh:resultPath nltl:withinIceStrengthenedArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:hasValue true ;
                                sh:property [ sh:datatype xsd:boolean ;
                                        sh:hasValue true ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:path nltl:effectiveAttachmentConfirmed ],
                                    [ sh:minCount 1 ;
                                        sh:node gen:TRF049AttachmentShape ;
                                        sh:path nltl:hasFrameAttachment ] ] [ sh:hasValue false ] ) ;
                    sh:path nltl:withinIceStrengthenedArea ] ;
            sh:value true ] .

