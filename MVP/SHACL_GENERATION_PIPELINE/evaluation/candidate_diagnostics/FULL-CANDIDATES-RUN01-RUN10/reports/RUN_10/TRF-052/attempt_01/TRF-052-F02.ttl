@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F02/frame> ;
            sh:resultMessage "The frame does not satisfy the applicable antitripping support spacing or regional scope requirement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The frame does not satisfy the applicable antitripping support spacing or regional scope requirement." ;
                    sh:select """PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:equivalentSupportStatusByDirectCalculation ?equivalent .
    FILTER (?equivalent != true)

    {
        $this nltl:frameAsymmetrical ?asymmetrical ;
              nltl:frameWebAngleToShell ?angleNode .
        ?angleNode qudt:numericValue ?angle .
        FILTER (
            ?asymmetrical = true ||
            (datatype(?angle) = xsd:decimal && ?angle < 90)
        )
        FILTER NOT EXISTS {
            $this nltl:antitrippingSupportSpacing ?spacingNode .
            ?spacingNode qudt:numericValue ?spacing ;
                         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
            FILTER (
                datatype(?spacing) = xsd:decimal &&
                ?spacing <= 1300
            )
        }
    }
    UNION
    {
        $this nltl:frameSpan ?spanNode .
        ?spanNode qudt:numericValue ?span .
        FILTER (
            datatype(?span) = xsd:decimal &&
            ?span > 4
        )
        {
            FILTER NOT EXISTS {
                $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
            }
        }
        UNION
        {
            FILTER NOT EXISTS {
                $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion
            }
        }
        UNION
        {
            FILTER NOT EXISTS {
                $this nltl:hasAntitrippingSupportRegion nltl:sternRegion
            }
        }
        UNION
        {
            FILTER NOT EXISTS {
                $this nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue
            }
        }
    }
    UNION
    {
        $this nltl:frameSpan ?spanNode ;
              nltl:iceClass ?iceClass .
        ?spanNode qudt:numericValue ?span .
        FILTER (
            datatype(?span) = xsd:decimal &&
            ?span <= 4 &&
            ?iceClass = nltl:iceClassIaSuper
        )
        {
            FILTER NOT EXISTS {
                $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
            }
        }
        UNION
        {
            FILTER NOT EXISTS {
                $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion
            }
        }
        UNION
        {
            FILTER NOT EXISTS {
                $this nltl:hasAntitrippingSupportRegion nltl:sternRegion
            }
        }
        UNION
        {
            FILTER NOT EXISTS {
                $this nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue
            }
        }
    }
    UNION
    {
        $this nltl:frameSpan ?spanNode ;
              nltl:iceClass nltl:iceClassIa .
        ?spanNode qudt:numericValue ?span .
        FILTER (
            datatype(?span) = xsd:decimal &&
            ?span <= 4
        )
        {
            FILTER NOT EXISTS {
                $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
            }
        }
        UNION
        {
            FILTER NOT EXISTS {
                $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion
            }
        }
    }
    UNION
    {
        $this nltl:frameSpan ?spanNode ;
              nltl:iceClass ?iceClass .
        ?spanNode qudt:numericValue ?span .
        FILTER (
            datatype(?span) = xsd:decimal &&
            ?span <= 4 &&
            (
                ?iceClass = nltl:iceClassIb ||
                ?iceClass = nltl:iceClassIc
            )
        )
        FILTER NOT EXISTS {
            $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
        }
    }
}""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-052-FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F02/frame> ] .

