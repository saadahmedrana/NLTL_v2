@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/iceStringer> ;
            sh:resultMessage "The design line load, section modulus, and required shear area must satisfy the declared ice-stringer formulas; calculated decimal results are checked with a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The design line load, section modulus, and required shear area must satisfy the declared ice-stringer formulas; calculated decimal results are checked with a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:designLineLoad ?loadNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?sigmaNode qudt:numericValue ?sigma .
                ?loadNode qudt:numericValue ?reportedLoad .
                ?zNode qudt:numericValue ?reportedZ .
                ?aNode qudt:numericValue ?reportedA .

                BIND((?p * ?h) AS ?rawLoad)
                BIND(IF(?rawLoad > 0.15, ?rawLoad, 0.15) AS ?expectedLoad)
                BIND((0.9 * 1.8 * ?expectedLoad * ?l * ?l / (?m * ?sigma) * 1000000) AS ?expectedZ)
                BIND((1.7320508075688772 * 0.9 * 1.8 * 1.2 * ?expectedLoad * ?l / (2 * ?sigma) * 10000) AS ?expectedA)

                FILTER(
                    ABS(?reportedLoad - ?expectedLoad) >
                    IF(ABS(?expectedLoad) * 0.000001 > 0.000000001,
                       ABS(?expectedLoad) * 0.000001,
                       0.000000001)
                    ||
                    ABS(?reportedZ - ?expectedZ) >
                    IF(ABS(?expectedZ) * 0.000001 > 0.000000001,
                       ABS(?expectedZ) * 0.000001,
                       0.000000001)
                    ||
                    ABS(?reportedA - ?expectedA) >
                    IF(ABS(?expectedA) * 0.000001 > 0.000000001,
                       ABS(?expectedA) * 0.000001,
                       0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF053IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/iceStringer> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/designLineLoadValue> ;
                    sh:resultMessage "Node ex:designLineLoadValue->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/KiloN-PER-M>']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/iceStringer> ;
            sh:resultMessage "Each ice stringer must provide exactly one calculated design line load in kN/m." ;
            sh:resultPath nltl:designLineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ice stringer must provide exactly one calculated design line load in kN/m." ;
                    sh:minCount 1 ;
                    sh:node gen:DesignLineLoadQuantityShape ;
                    sh:path nltl:designLineLoad ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F05/designLineLoadValue> ] .

