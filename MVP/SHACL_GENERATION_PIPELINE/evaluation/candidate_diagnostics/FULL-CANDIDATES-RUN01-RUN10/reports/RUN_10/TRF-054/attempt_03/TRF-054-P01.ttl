sd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:designIceLoadHeight ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:distanceToAdjacentIceStringer ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:distanceToIceBelt ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:span ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:stringerSpan ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:icePressure ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:yieldStrength ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:frameMomentFactorM ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:outsideIceBeltFactor ] ; sh:sparql [ sh:message Literal("Ice stringer calculation results do not match the required formulas within tolerance.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:locatedOutsideIceBelt true ;
                              nltl:supportsIceStrengthenedFrames true ;
                              nltl:icePressure ?pNode ;
                              nltl:designIceLoadHeight ?hNode ;
                              nltl:span ?spanNode ;
                              nltl:stringerSpan ?lNode ;
                              nltl:frameMomentFactorM ?mNode ;
                              nltl:yieldStrength ?sigmaNode ;
                              nltl:distanceToIceBelt ?hsNode ;
                              nltl:distanceToAdjacentIceStringer ?lsNode ;
                              nltl:designLineLoad ?loadNode ;
                              nltl:outsideIceBeltFactor ?factorNode ;
                              nltl:sectionModulus ?zNode ;
                              nltl:requiredShearArea ?aNode .
                        ?pNode qudt:numericValue ?p .
                        ?hNode qudt:numericValue ?h .
                        ?spanNode qudt:numericValue ?span .
                        ?lNode qudt:numericValue ?l .
                        ?mNode qudt:numericValue ?m .
                        ?sigmaNode qudt:numericValue ?sigma .
                        ?hsNode qudt:numericValue ?hs .
                        ?lsNode qudt:numericValue ?ls .
                        ?loadNode qudt:numericValue ?load .
                        ?factorNode qudt:numericValue ?factor .
                        ?zNode qudt:numericValue ?z .
                        ?aNode qudt:numericValue ?a .
                        BIND(IF((?p * ?h) < 0.15, 0.15, (?p * ?h)) AS ?loadMN)
                        BIND((1 - (?hs / ?ls)) AS ?expectedFactor)
                        BIND((?loadMN * 1000) AS ?expectedLoad)
                        BIND((0.80 * 1.8 * ?loadMN * ?l * ?l / (?m * ?sigma) * ?expectedFactor * 1000000) AS ?expectedZ)
                        BIND((1.7320508075688772 * 0.80 * 1.8 * 1.2 * ?loadMN * ?l / (2 * ?sigma) * ?expectedFactor * 10000) AS ?expectedA)
                        FILTER (
                            (?expectedLoad >= 1 && (?load < (?expectedLoad - (?expectedLoad * 0.000001)) || ?load > (?expectedLoad + (?expectedLoad * 0.000001)))) ||
                            (?expectedLoad < 1 && (?load < (?expectedLoad - 0.000001) || ?load > (?expectedLoad + 0.000001))) ||
                            (?expectedFactor >= 1 && (?factor < (?expectedFactor - (?expectedFactor * 0.000001)) || ?factor > (?expectedFactor + (?expectedFactor * 0.000001)))) ||
                            (?expectedFactor < 1 && (?factor < (?expectedFactor - 0.000001) || ?factor > (?expectedFactor + 0.000001))) ||
                            (?expectedZ >= 1 && (?z < (?expectedZ - (?expectedZ * 0.000001)) || ?z > (?expectedZ + (?expectedZ * 0.000001)))) ||
                            (?expectedZ < 1 && (?z < (?expectedZ - 0.000001) || ?z > (?expectedZ + 0.000001))) ||
                            (?expectedA >= 1 && (?a < (?expectedA - (?expectedA * 0.000001)) || ?a > (?expectedA + (?expectedA * 0.000001)))) ||
                            (?expectedA < 1 && (?a < (?expectedA - 0.000001) || ?a > (?expectedA + 0.000001)))
                        )
                    }
                ") ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:locatedOutsideIceBelt ] ] , [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:supportsIceStrengthenedFrames ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF054IceStringerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-P01/iceStringer> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-P01/iceStringer> ;
            sh:resultMessage "Less than 1 values on ex:iceStringer->nltl:locatedOutsideIceBelt" ;
            sh:resultPath nltl:locatedOutsideIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:locatedOutsideIceBelt ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-P01/iceStringer> ;
            sh:resultMessage "Less than 1 values on ex:iceStringer->nltl:supportsIceStrengthenedFrames" ;
            sh:resultPath nltl:supportsIceStrengthenedFrames ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:supportsIceStrengthenedFrames ] ] .

