@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "The actual section modulus and shear area must be at least their respective required values." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The actual section modulus and shear area must be at least their respective required values." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:actualSectionModulus ?actualZ .
    ?actualZ qudt:numericValue ?actualZValue .
    $this nltl:requiredSectionModulus ?requiredZ .
    ?requiredZ qudt:numericValue ?requiredZValue .
    $this nltl:actualShearArea ?actualA .
    ?actualA qudt:numericValue ?actualAValue .
    $this nltl:requiredShearArea ?requiredA .
    ?requiredA qudt:numericValue ?requiredAValue .
    FILTER (
        ?actualZValue < ?requiredZValue ||
        ?actualAValue < ?requiredAValue
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <nltl:generated-shape:TRF055_NarrowDeckStripShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "The design line load is required in kN/m." ;
            sh:resultPath nltl:designLineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The design line load is required in kN/m." ;
                    sh:minCount 1 ;
                    sh:node <nltl:generated-shape:TRF055_LineLoadQuantityShape> ;
                    sh:path nltl:designLineLoad ] ] .

