@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P03/narrowDeckStrip> ;
            sh:resultMessage "The design line load is required in kN/m." ;
            sh:resultPath nltl:designLineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The design line load is required in kN/m." ;
                    sh:minCount 1 ;
                    sh:node <nltl:generated-shape:TRF055_LineLoadQuantityShape> ;
                    sh:path nltl:designLineLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P03/narrowDeckStrip> ;
            sh:resultMessage "Node ex:narrowDeckStrip must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:veryLongHatchOpening ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A very-long-hatch reduced line load requires classification-society approval.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:reducedLineLoadApprovedByClassificationSociety ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:veryLongHatchOpening ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The permitted reduced line load is required for the approved exception.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <nltl:generated-shape:TRF055_ReducedLineLoadQuantityShape> ; sh:path nltl:permittedReducedLineLoad ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <nltl:generated-shape:TRF055_NarrowDeckStripShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P03/narrowDeckStrip> ] .

