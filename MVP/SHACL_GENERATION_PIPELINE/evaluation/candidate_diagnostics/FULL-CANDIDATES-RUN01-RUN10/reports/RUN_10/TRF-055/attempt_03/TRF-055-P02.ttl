@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:designLineLoad" ;
            sh:resultPath nltl:designLineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:designLineLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ;
            sh:resultMessage "Node ex:narrowDeckStrip must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:veryLongHatchOpening ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:reducedLineLoadApprovedByClassificationSociety ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:veryLongHatchOpening ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:reducedLineLoadApprovedByClassificationSociety ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:veryLongHatchOpening ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxExclusive Literal(\"0.15\", datatype=xsd:decimal) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"0.10\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:permittedReducedLineLoad ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ a sh:NodeShape ;
                    sh:or ( [ sh:property [ sh:hasValue false ;
                                        sh:path nltl:veryLongHatchOpening ] ] [ sh:property [ sh:hasValue true ;
                                        sh:path nltl:veryLongHatchOpening ],
                                    [ sh:hasValue false ;
                                        sh:path nltl:reducedLineLoadApprovedByClassificationSociety ] ] [ sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:permittedReducedLineLoad ],
                                    [ sh:hasValue true ;
                                        sh:path nltl:veryLongHatchOpening ],
                                    [ sh:hasValue true ;
                                        sh:path nltl:reducedLineLoadApprovedByClassificationSociety ] ] ) ;
                    sh:property [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "The narrow deck strip must serve as an ice stringer." ;
                            sh:minCount 1 ;
                            sh:path nltl:servesAsIceStringer ],
                        [ sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:reducedLineLoadApprovedByClassificationSociety ],
                        [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "The narrow deck strip must be abreast of a hatch." ;
                            sh:minCount 1 ;
                            sh:path nltl:abreastOfHatch ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:actualSectionModulus ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:requiredShearArea ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:requiredSectionModulus ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:shipBreadth ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:hatchOpeningLength ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:designLineLoad ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:sectionModulus ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:actualShearArea ],
                        [ sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:veryLongHatchOpening ],
                        [ sh:class nltl:evidenceState ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:scantlingApprovalStatus ] ;
                    sh:sparql [ sh:message "The actual section modulus and shear area must each be at least their corresponding required value." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:actualSectionModulus ?actualZ .
                ?actualZ qudt:numericValue ?actualZValue .
                $this nltl:requiredSectionModulus ?requiredZ .
                ?requiredZ qudt:numericValue ?requiredZValue .
                $this nltl:actualShearArea ?actualA .
                ?actualA qudt:numericValue ?actualAValue .
                $this nltl:requiredShearArea ?requiredA .
                ?requiredA qudt:numericValue ?requiredAValue .
                FILTER (
                    !( ?actualZValue >= ?requiredZValue &&
                       ?actualAValue >= ?requiredAValue )
                )
            }
        """ ] ;
                    sh:targetClass nltl:narrowDeckStrip ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:hatchOpeningLength" ;
            sh:resultPath nltl:hatchOpeningLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:hatchOpeningLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:scantlingApprovalStatus" ;
            sh:resultPath nltl:scantlingApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceState ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:scantlingApprovalStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:shipBreadth" ;
            sh:resultPath nltl:shipBreadth ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:shipBreadth ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ;
            sh:resultMessage "Less than 1 values on ex:narrowDeckStrip->nltl:sectionModulus" ;
            sh:resultPath nltl:sectionModulus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:sectionModulus ] ] .

