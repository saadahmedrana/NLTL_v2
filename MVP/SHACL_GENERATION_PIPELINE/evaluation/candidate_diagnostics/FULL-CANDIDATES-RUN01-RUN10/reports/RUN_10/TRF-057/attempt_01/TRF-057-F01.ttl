@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "webFrameIceLoad must equal 1.8 times the clamped ice pressure-height product times webFrameSpacing, with the result expressed in kN." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "webFrameIceLoad must equal 1.8 times the clamped ice pressure-height product times webFrameSpacing, with the result expressed in kN." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:iceLoadHeight ?heightNode ;
                      nltl:webFrameSpacing ?spacingNode ;
                      nltl:webFrameIceLoad ?loadNode .

                ?pressureNode qudt:numericValue ?pressure .
                ?heightNode qudt:numericValue ?height .
                ?spacingNode qudt:numericValue ?spacing .
                ?loadNode qudt:numericValue ?load .

                BIND(IF((?pressure * ?height) < "0.15"^^xsd:decimal,
                        "0.15"^^xsd:decimal,
                        (?pressure * ?height)) AS ?clampedLineLoad)
                BIND(("1.8"^^xsd:decimal * ?clampedLineLoad * ?spacing *
                      "1000"^^xsd:decimal) AS ?expectedLoad)
                BIND(ABS(?load - ?expectedLoad) AS ?difference)
                BIND(IF(ABS(?expectedLoad) > "0.000001"^^xsd:decimal,
                        ABS(?expectedLoad) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal) AS ?tolerance)

                FILTER(?difference > ?tolerance)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-057-WebFrameIceLoadShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ] .

