@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F03/webFrame> ;
            sh:resultMessage "requiredShearArea must equal sqrt(3) times alpha times 1.1 times maximumCalculatedShearForce converted from kN to MN, divided by yieldStrength, times 10^4; alpha must correspond to the Table 4-8 area ratio. Calculated decimal equality uses relative tolerance 1e-6 with absolute fallback 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "requiredShearArea must equal sqrt(3) times alpha times 1.1 times maximumCalculatedShearForce converted from kN to MN, divided by yieldStrength, times 10^4; alpha must correspond to the Table 4-8 area ratio. Calculated decimal equality uses relative tolerance 1e-6 with absolute fallback 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?qQuantity ;
                      nltl:webFrameShearFactorAlpha ?alphaQuantity ;
                      nltl:yieldStrength ?sigmaQuantity ;
                      nltl:freeFlangeToWebAreaRatio ?ratioQuantity ;
                      nltl:requiredShearArea ?areaQuantity .

                ?qQuantity qudt:numericValue ?q .
                ?alphaQuantity qudt:numericValue ?alpha .
                ?sigmaQuantity qudt:numericValue ?sigma .
                ?ratioQuantity qudt:numericValue ?ratio .
                ?areaQuantity qudt:numericValue ?area .

                BIND ((1.7320508075688772 * ?alpha * 1.1 * (?q / 1000) / ?sigma) * 10000 AS ?expected)

                FILTER (
                    !(
                        (?ratio = "0"^^xsd:decimal && ?alpha = "1.5"^^xsd:decimal) ||
                        (?ratio = "0.2"^^xsd:decimal && ?alpha = "1.23"^^xsd:decimal) ||
                        (?ratio = "0.4"^^xsd:decimal && ?alpha = "1.16"^^xsd:decimal) ||
                        (?ratio = "0.6"^^xsd:decimal && ?alpha = "1.11"^^xsd:decimal) ||
                        (?ratio = "0.8"^^xsd:decimal && ?alpha = "1.09"^^xsd:decimal) ||
                        (?ratio = "1.0"^^xsd:decimal && ?alpha = "1.07"^^xsd:decimal) ||
                        (?ratio = "1.2"^^xsd:decimal && ?alpha = "1.06"^^xsd:decimal) ||
                        (?ratio = "1.4"^^xsd:decimal && ?alpha = "1.05"^^xsd:decimal) ||
                        (?ratio = "1.6"^^xsd:decimal && ?alpha = "1.05"^^xsd:decimal) ||
                        (?ratio = "1.8"^^xsd:decimal && ?alpha = "1.04"^^xsd:decimal) ||
                        (?ratio = "2.0"^^xsd:decimal && ?alpha = "1.04"^^xsd:decimal)
                    )
                    ||
                    ABS(?area - ?expected) > (ABS(?expected) * 0.000001 + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF059WebFrameShearAreaShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F03/webFrame> ] .

