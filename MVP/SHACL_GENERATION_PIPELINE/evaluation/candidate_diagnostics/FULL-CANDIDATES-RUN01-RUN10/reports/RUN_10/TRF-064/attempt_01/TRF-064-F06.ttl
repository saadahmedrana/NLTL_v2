@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F06/ship> ;
            sh:resultMessage "The ship must state whether detached struts are used." ;
            sh:resultPath nltl:detachedStrut ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ship must state whether detached struts are used." ;
                    sh:minCount 1 ;
                    sh:path nltl:detachedStrut ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F06/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:detachedStrut ], [ sh:message Literal(\"Side propeller shafting must be enclosed within plated bossing when detached struts are not used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path ( nltl:hasSidePropellerShafting nltl:enclosedByPlatedBossing ) ], [ sh:message Literal(\"Stern tubes of side propellers must be enclosed within plated bossing when detached struts are not used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path ( nltl:hasSternTube nltl:enclosedByPlatedBossing ) ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:detachedStrut ], [ sh:message Literal(\"Design evidence is required for a detached strut.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path ( nltl:hasDetachedStrut nltl:hasStrutDesignEvidence ) ], [ sh:message Literal(\"Hull-attachment evidence is required for a detached strut.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path ( nltl:hasDetachedStrut nltl:hasStrutHullAttachmentEvidence ) ], [ sh:message Literal(\"Strength evidence is required for a detached strut.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path ( nltl:hasDetachedStrut nltl:hasStrutStrengthEvidence ) ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF064ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F06/ship> ] .

