@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-P01/ship> ;
            sh:resultMessage "The ship shall have exactly one permitted ice class." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceClassValue ;
                    sh:datatype xsd:anyURI ;
                    sh:in ( nltl:iceClassIa nltl:iceClassIaSuper nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship shall have exactly one permitted ice class." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceClass ] ;
            sh:value nltl:iceClassIa ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-P01/ship> ;
            sh:resultMessage "The lower ice waterline shall be recorded." ;
            sh:resultPath nltl:lowerIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The lower ice waterline shall be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:lowerIceWaterline ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-P01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:iceClassIb ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:hasValue nltl:iceClassIc ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:hasValue nltl:iceClassIi ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:hasValue nltl:iceClassIii ; sh:path nltl:iceClass ] ] , [ sh:class nltl:iceKnife ; sh:property [ sh:class nltl:rudderProtectionArrangement ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A rudder protection arrangement shall be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasRudderProtectionArrangement ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ice knife shall extend below the recorded lower ice waterline.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendsBelowLowerIceWaterline ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] , [ sh:class nltl:equivalentRudderProtectionMeans ; sh:property [ sh:class nltl:rudderProtectionArrangement ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"An equivalent rudder protection means shall be provided when an ice knife is not practicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasRudderProtectionArrangement ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] , [ sh:class nltl:iceKnife ; sh:property [ sh:class nltl:rudderProtectionArrangement ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A rudder protection arrangement shall be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasRudderProtectionArrangement ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ice knife shall extend below the recorded lower ice waterline.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendsBelowLowerIceWaterline ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ] ] , [ sh:class nltl:equivalentRudderProtectionMeans ; sh:property [ sh:class nltl:rudderProtectionArrangement ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"An equivalent rudder protection means shall be provided when an ice knife is not practicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasRudderProtectionArrangement ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-066> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-P01/ship> ] .

