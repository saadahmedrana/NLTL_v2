@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-P03/ship> ;
            sh:resultMessage "The ship shall have exactly one permitted ice class." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceClassValue ;
                    sh:datatype xsd:anyURI ;
                    sh:in ( nltl:iceClassIa nltl:iceClassIaSuper nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship shall have exactly one permitted ice class." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceClass ] ;
            sh:value nltl:iceClassIb ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-P03/ship> ;
            sh:resultMessage "The lower ice waterline shall be recorded." ;
            sh:resultPath nltl:lowerIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The lower ice waterline shall be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:lowerIceWaterline ] ] .

