@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F02/ship> ;
            sh:resultMessage "The ship must have one permitted Finnish-Swedish ice-class value." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceClassValue ;
                    sh:datatype xsd:anyURI ;
                    sh:maxCount 1 ;
                    sh:message "The ship must have one permitted Finnish-Swedish ice-class value." ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:hasValue nltl:iceClassIa ] [ sh:hasValue nltl:iceClassIaSuper ] [ sh:hasValue nltl:iceClassIb ] [ sh:hasValue nltl:iceClassIc ] [ sh:hasValue nltl:iceClassIi ] [ sh:hasValue nltl:iceClassIii ] ) ;
                    sh:path nltl:iceClass ] ;
            sh:value nltl:iceClassIa ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F02/ship> ;
            sh:resultMessage "The ship must provide its lower ice waterline." ;
            sh:resultPath nltl:lowerIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship must provide its lower ice waterline." ;
                    sh:minCount 1 ;
                    sh:path nltl:lowerIceWaterline ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:class nltl:iceKnife ; sh:property [ sh:class nltl:rudderProtectionArrangement ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasRudderProtectionArrangement ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendsBelowLowerIceWaterline ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:iceKnifePracticable ], [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] , [ sh:class nltl:equivalentRudderProtectionMeans ; sh:property [ sh:class nltl:rudderProtectionArrangement ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasRudderProtectionArrangement ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:iceKnifePracticable ], [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] , [ sh:class nltl:iceKnife ; sh:property [ sh:class nltl:rudderProtectionArrangement ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasRudderProtectionArrangement ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendsBelowLowerIceWaterline ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:iceKnifePracticable ], [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ] ] , [ sh:class nltl:equivalentRudderProtectionMeans ; sh:property [ sh:class nltl:rudderProtectionArrangement ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasRudderProtectionArrangement ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:iceKnifePracticable ], [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-066> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F02/ship> ] .

