@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F03/ship> ;
            sh:resultMessage "At least four propeller blade load cases must be represented." ;
            sh:resultPath nltl:hasPropellerBladeLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "At least four propeller blade load cases must be represented." ;
                    sh:minCount 4 ;
                    sh:node [ sh:class nltl:propellerBladeLoadCase ;
                            sh:property [ sh:datatype xsd:integer ;
                                    sh:message "Each propeller blade load case must have an integer case number." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:propellerBladeLoadCaseNumber ] ] ;
                    sh:path nltl:hasPropellerBladeLoadCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:TRF_076_CPBranch , gen:TRF_076_FPNonReversingBranch , gen:TRF_076_FPReversingBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_076_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F03/ship> ;
            sh:resultMessage "A ship must declare propeller type CP or FP." ;
            sh:resultPath nltl:propellerType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "CP" "FP" ) ;
                    sh:message "A ship must declare propeller type CP or FP." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerType ] ;
            sh:value "CP"^^xsd:string ] .

