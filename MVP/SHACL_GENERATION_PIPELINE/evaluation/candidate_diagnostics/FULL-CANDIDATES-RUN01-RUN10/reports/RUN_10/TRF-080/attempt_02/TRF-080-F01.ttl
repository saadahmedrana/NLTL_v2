@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ;
            sh:resultMessage "effectiveIceLoadCycleCount must equal iceLoadCycleCount multiplied by propellerBladeCount within a 1e-6 expected-result-scaled tolerance, with a 1e-6 absolute fallback near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "effectiveIceLoadCycleCount must equal iceLoadCycleCount multiplied by propellerBladeCount within a 1e-6 expected-result-scaled tolerance, with a 1e-6 absolute fallback near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?ice ;
                      nltl:propellerBladeCount ?blades ;
                      nltl:effectiveIceLoadCycleCount ?resultNode .

                ?resultNode qudt:numericValue ?reported ;
                            qudt:unit unit:UNITLESS .

                BIND((?ice * ?blades) AS ?expected)

                FILTER (
                    (
                        (?expected >= 1)
                        &&
                        (
                            ?reported < (?expected - (?expected * 0.000001))
                            ||
                            ?reported > (?expected + (?expected * 0.000001))
                        )
                    )
                    ||
                    (
                        (?expected < 1)
                        &&
                        (
                            ?reported < (?expected - 0.000001)
                            ||
                            ?reported > (?expected + 0.000001)
                        )
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF080ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ] .

