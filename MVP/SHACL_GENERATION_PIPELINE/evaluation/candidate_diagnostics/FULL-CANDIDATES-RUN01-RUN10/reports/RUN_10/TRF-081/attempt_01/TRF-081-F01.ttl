@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-F01/ship> ;
            sh:resultMessage "Ice thrust and propeller shaft design thrust values must satisfy the TRF-081 formulas within numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ice thrust and propeller shaft design thrust values must satisfy the TRF-081 formulas within numerical tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce ?ffNode ;
                      nltl:backwardBladeForce ?fbNode ;
                      nltl:hydrodynamicBollardThrust ?tNode ;
                      nltl:forwardIceThrust ?tfNode ;
                      nltl:backwardIceThrust ?tbNode ;
                      nltl:forwardPropellerShaftDesignThrust ?trfNode ;
                      nltl:backwardPropellerShaftDesignThrust ?trbNode ;
                      nltl:propellerShaftDesignThrust ?trNode .

                ?ffNode qudt:numericValue ?ff .
                ?fbNode qudt:numericValue ?fb .
                ?tNode qudt:numericValue ?t .
                ?tfNode qudt:numericValue ?tfReported .
                ?tbNode qudt:numericValue ?tbReported .
                ?trfNode qudt:numericValue ?trfReported .
                ?trbNode qudt:numericValue ?trbReported .
                ?trNode qudt:numericValue ?trReported .

                BIND((1.1 * ?ff) AS ?tfExpected)
                BIND((1.1 * ?fb) AS ?tbExpected)
                BIND((?t + (2.2 * ?tfExpected)) AS ?trfExpected)
                BIND((1.5 * ?tbExpected) AS ?trbExpected)
                BIND(IF(?trfExpected >= ?trbExpected, ?trfExpected, ?trbExpected) AS ?trExpected)

                FILTER (
                    ABS(?tfReported - ?tfExpected) >
                        ((0.000001 * ABS(?tfExpected)) + 0.000000001)
                    ||
                    ABS(?tbReported - ?tbExpected) >
                        ((0.000001 * ABS(?tbExpected)) + 0.000000001)
                    ||
                    ABS(?trfReported - ?trfExpected) >
                        ((0.000001 * ABS(?trfExpected)) + 0.000000001)
                    ||
                    ABS(?trbReported - ?trbExpected) >
                        ((0.000001 * ABS(?trbExpected)) + 0.000000001)
                    ||
                    ABS(?trReported - ?trExpected) >
                        ((0.000001 * ABS(?trExpected)) + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF081Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-F01/ship> ] .

