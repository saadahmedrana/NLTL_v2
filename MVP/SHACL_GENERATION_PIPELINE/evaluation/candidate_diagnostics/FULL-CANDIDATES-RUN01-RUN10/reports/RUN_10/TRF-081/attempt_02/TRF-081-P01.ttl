@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-P01/ship> ;
            sh:resultMessage "Ice thrust and design thrust values must satisfy the TRF-081 formulas, with the greater directional load used for all design thrust results." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ice thrust and design thrust values must satisfy the TRF-081 formulas, with the greater directional load used for all design thrust results." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce ?ffNode ;
                      nltl:backwardBladeForce ?fbNode ;
                      nltl:hydrodynamicBollardThrust ?tNode ;
                      nltl:forwardIceThrust ?tfNode ;
                      nltl:backwardIceThrust ?tbNode ;
                      nltl:forwardPropellerShaftDesignThrust ?frNode ;
                      nltl:backwardPropellerShaftDesignThrust ?brNode ;
                      nltl:propellerShaftDesignThrust ?rNode .
                ?ffNode qudt:numericValue ?ff .
                ?fbNode qudt:numericValue ?fb .
                ?tNode qudt:numericValue ?t .
                ?tfNode qudt:numericValue ?tf .
                ?tbNode qudt:numericValue ?tb .
                ?frNode qudt:numericValue ?fr .
                ?brNode qudt:numericValue ?br .
                ?rNode qudt:numericValue ?r .
                BIND (1.1 * ?ff AS ?expectedTf)
                BIND (1.1 * ?fb AS ?expectedTb)
                BIND (?t + (2.2 * ?tf) AS ?forwardLoad)
                BIND (1.5 * ?tb AS ?backwardLoad)
                BIND (IF(?forwardLoad >= ?backwardLoad, ?forwardLoad, ?backwardLoad) AS ?expectedDesign)
                FILTER (
                    (?expectedTf >= 0 &&
                        (?tf < (?expectedTf - ((?expectedTf * 0.000001) + 0.000000001)) ||
                         ?tf > (?expectedTf + ((?expectedTf * 0.000001) + 0.000000001)))) ||
                    (?expectedTf < 0 &&
                        (?tf < (?expectedTf - (((0 - ?expectedTf) * 0.000001) + 0.000000001)) ||
                         ?tf > (?expectedTf + (((0 - ?expectedTf) * 0.000001) + 0.000000001)))) ||
                    (?expectedTb >= 0 &&
                        (?tb < (?expectedTb - ((?expectedTb * 0.000001) + 0.000000001)) ||
                         ?tb > (?expectedTb + ((?expectedTb * 0.000001) + 0.000000001)))) ||
                    (?expectedTb < 0 &&
                        (?tb < (?expectedTb - (((0 - ?expectedTb) * 0.000001) + 0.000000001)) ||
                         ?tb > (?expectedTb + (((0 - ?expectedTb) * 0.000001) + 0.000000001)))) ||
                    (?expectedDesign >= 0 &&
                        (?fr < (?expectedDesign - ((?expectedDesign * 0.000001) + 0.000000001)) ||
                         ?fr > (?expectedDesign + ((?expectedDesign * 0.000001) + 0.000000001)))) ||
                    (?expectedDesign < 0 &&
                        (?fr < (?expectedDesign - (((0 - ?expectedDesign) * 0.000001) + 0.000000001)) ||
                         ?fr > (?expectedDesign + (((0 - ?expectedDesign) * 0.000001) + 0.000000001)))) ||
                    (?expectedDesign >= 0 &&
                        (?br < (?expectedDesign - ((?expectedDesign * 0.000001) + 0.000000001)) ||
                         ?br > (?expectedDesign + ((?expectedDesign * 0.000001) + 0.000000001)))) ||
                    (?expectedDesign < 0 &&
                        (?br < (?expectedDesign - (((0 - ?expectedDesign) * 0.000001) + 0.000000001)) ||
                         ?br > (?expectedDesign + (((0 - ?expectedDesign) * 0.000001) + 0.000000001)))) ||
                    (?expectedDesign >= 0 &&
                        (?r < (?expectedDesign - ((?expectedDesign * 0.000001) + 0.000000001)) ||
                         ?r > (?expectedDesign + ((?expectedDesign * 0.000001) + 0.000000001)))) ||
                    (?expectedDesign < 0 &&
                        (?r < (?expectedDesign - (((0 - ?expectedDesign) * 0.000001) + 0.000000001)) ||
                         ?r > (?expectedDesign + (((0 - ?expectedDesign) * 0.000001) + 0.000000001))))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF081Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-P01/ship> ] .

