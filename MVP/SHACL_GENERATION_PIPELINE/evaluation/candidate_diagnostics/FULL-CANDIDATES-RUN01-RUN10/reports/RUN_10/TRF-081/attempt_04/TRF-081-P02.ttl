@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-P02/ship> ;
            sh:resultMessage "Ice thrust and all propeller shaft design thrust results must satisfy the TRF-081 formulas within tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ice thrust and all propeller shaft design thrust results must satisfy the TRF-081 formulas within tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce ?ffNode ;
                      nltl:backwardBladeForce ?fbNode ;
                      nltl:hydrodynamicBollardThrust ?tNode ;
                      nltl:forwardIceThrust ?tfNode ;
                      nltl:backwardIceThrust ?tbNode ;
                      nltl:forwardPropellerShaftDesignThrust ?forwardResultNode ;
                      nltl:backwardPropellerShaftDesignThrust ?backwardResultNode ;
                      nltl:propellerShaftDesignThrust ?designResultNode .

                ?ffNode <http://qudt.org/schema/qudt/numericValue> ?ff .
                ?fbNode <http://qudt.org/schema/qudt/numericValue> ?fb .
                ?tNode <http://qudt.org/schema/qudt/numericValue> ?t .
                ?tfNode <http://qudt.org/schema/qudt/numericValue> ?tf .
                ?tbNode <http://qudt.org/schema/qudt/numericValue> ?tb .
                ?forwardResultNode <http://qudt.org/schema/qudt/numericValue> ?forwardResult .
                ?backwardResultNode <http://qudt.org/schema/qudt/numericValue> ?backwardResult .
                ?designResultNode <http://qudt.org/schema/qudt/numericValue> ?designResult .

                BIND (1.1 * ?ff AS ?expectedTf)
                BIND (1.1 * ?fb AS ?expectedTb)
                BIND (?t + 2.2 * ?expectedTf AS ?forwardLoad)
                BIND (1.5 * ?expectedTb AS ?backwardLoad)
                BIND (IF(?forwardLoad >= ?backwardLoad, ?forwardLoad, ?backwardLoad) AS ?expectedMax)

                BIND (IF(?expectedTf < 0.000001, 0.000001, 0.000001 * ?expectedTf) AS ?tfTolerance)
                BIND (IF(?expectedTb < 0.000001, 0.000001, 0.000001 * ?expectedTb) AS ?tbTolerance)
                BIND (IF(?expectedMax < 0.000001, 0.000001, 0.000001 * ?expectedMax) AS ?maxTolerance)

                FILTER (
                    ?tf < (?expectedTf - ?tfTolerance) ||
                    ?tf > (?expectedTf + ?tfTolerance) ||
                    ?tb < (?expectedTb - ?tbTolerance) ||
                    ?tb > (?expectedTb + ?tbTolerance) ||
                    ?forwardResult < (?expectedMax - ?maxTolerance) ||
                    ?forwardResult > (?expectedMax + ?maxTolerance) ||
                    ?backwardResult < (?expectedMax - ?maxTolerance) ||
                    ?backwardResult > (?expectedMax + ?maxTolerance) ||
                    ?designResult < (?expectedMax - ?maxTolerance) ||
                    ?designResult > (?expectedMax + ?maxTolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF081Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-P02/ship> ] .

