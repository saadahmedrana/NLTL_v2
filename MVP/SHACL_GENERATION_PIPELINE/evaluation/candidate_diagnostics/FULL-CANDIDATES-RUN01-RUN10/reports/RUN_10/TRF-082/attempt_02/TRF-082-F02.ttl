@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-082-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to exactly one shape in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship must state that hydrodynamic bollard thrust is known when the Table 6-8 fallback does not apply.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bollardThrustKnown ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship must state that hydrodynamic bollard thrust is not known before using the Table 6-8 fallback.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bollardThrustKnown ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When hydrodynamic bollard thrust is unknown, the ship must provide the Table 6-8 thrust quantity in kN.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:hydrodynamicBollardThrust ], [ sh:message Literal(\"When hydrodynamic bollard thrust is unknown, the ship must have a Table 6-8 lookup case with its reference and selection evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal(\"The Table 6-8 selection must have selection evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lookupSelectionEvidence ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The Table 6-8 lookup case must record that the lookup was applied.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:tableLookupApplied ], [ sh:hasValue nltl:traficomTable6Dash8 ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The lookup case must reference TRAFICOM Table 6-8.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:tableReference ] ] ; sh:path nltl:hasTableLookupCase ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:XoneConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-082-ship> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-082-F02/ship> ] .

