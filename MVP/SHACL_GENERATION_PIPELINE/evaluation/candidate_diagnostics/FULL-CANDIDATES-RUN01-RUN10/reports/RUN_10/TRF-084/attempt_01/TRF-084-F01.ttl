@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ;
            sh:resultMessage "For a CP propeller whose pitch value is not known, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning, with metre units." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a CP propeller whose pitch value is not known, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning, with metre units." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:propellerType ?propellerType ;
          nltl:pitchValueKnown ?known .
    FILTER (?propellerType = "CP"^^xsd:string)
    FILTER (?known = false)

    FILTER NOT EXISTS {
        $this nltl:propellerPitchAtMcrFreeRunning ?freeQuantity ;
              nltl:propellerPitchAtMcrBollard ?bollardQuantity .
        ?freeQuantity qudt:numericValue ?freeValue ;
                      qudt:unit unit:M .
        ?bollardQuantity qudt:numericValue ?bollardValue ;
                         qudt:unit unit:M .
        FILTER (datatype(?freeValue) = xsd:decimal)
        FILTER (datatype(?bollardValue) = xsd:decimal)
        BIND ((7.0 / 10.0) * ?freeValue AS ?expectedValue)
        FILTER (
            ABS(?bollardValue - ?expectedValue)
            <= (ABS(?expectedValue) * 0.000001 + 0.000001)
        )
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-084_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ] .

