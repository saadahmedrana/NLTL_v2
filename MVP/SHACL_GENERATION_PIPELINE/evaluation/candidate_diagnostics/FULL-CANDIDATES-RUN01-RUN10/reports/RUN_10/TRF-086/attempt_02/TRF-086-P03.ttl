@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-P03/ship> ;
            sh:resultMessage "The CP-propeller pitch requirement is not satisfied for the selected applicability branch." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF086Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-P03/ship> ] .

