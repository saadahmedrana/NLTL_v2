@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:maximumEngineTorqueKnown ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:maximumEngineTorqueKnown ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:tableLookupCase ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:tableLookupApplied ], [ sh:hasValue nltl:traficomTable6Dash10 ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:tableReference ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:evidenceArtifact ] ; sh:path nltl:lookupSelectionEvidence ] ] ; sh:path nltl:hasTableLookupCase ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN-M> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:maximumEngineTorque ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF088MaximumTorqueShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F01/ship> ;
            sh:resultMessage "When maximumEngineTorqueKnown is false, a Table 6-10 lookup case and the reported maximumEngineTorque quantity must be present together." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When maximumEngineTorqueKnown is false, a Table 6-10 lookup case and the reported maximumEngineTorque quantity must be present together." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:maximumEngineTorqueKnown false .
                FILTER NOT EXISTS {
                    $this nltl:maximumEngineTorque ?torque .
                    ?torque qudt:unit <http://qudt.org/vocab/unit/KiloN-M> .
                    $this nltl:hasTableLookupCase ?case .
                    ?case nltl:tableLookupApplied true ;
                          nltl:tableReference nltl:traficomTable6Dash10 ;
                          nltl:lookupSelectionEvidence ?evidence .
                    ?evidence a nltl:evidenceArtifact .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF088MaximumTorqueShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F01/ship> ] .

