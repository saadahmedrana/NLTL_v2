@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ;
                    sh:resultMessage "The ice-milling load sequence shall be used for propulsion line strength evaluation and not for propulsion system stalling analysis." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n0f9268ad01b9425a86608f3f8f7010f0b4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ;
                    sh:resultMessage "The ice-milling load sequence shall be used for propulsion line strength evaluation and not for propulsion system stalling analysis." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n0f9268ad01b9425a86608f3f8f7010f0b4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/milling> ;
            sh:resultMessage "A propulsion load case using the ice-milling load sequence shall be declared." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n0f9268ad01b9425a86608f3f8f7010f0b2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/ship> ;
            sh:resultMessage "A propulsion load case using the ice-milling load sequence shall be declared." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n0f9268ad01b9425a86608f3f8f7010f0b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/milling> ;
            sh:resultMessage "A ship using the ice-milling load sequence shall identify an ice milling sequence case." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceMillingSequenceCase ;
                    sh:message "A ship using the ice-milling load sequence shall identify an ice milling sequence case." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceMillingSequenceCase ] ] .

_:N4a3f24dc51194555a3acda17665eb7c9 a sh:NodeShape ;
    sh:property [ sh:class nltl:loadCasePurposeValue ;
            sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
            sh:maxCount 1 ;
            sh:message "The ice-milling load sequence shall be used for propulsion line strength evaluation and not for propulsion system stalling analysis." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path nltl:loadCasePurpose ] .

_:n0f9268ad01b9425a86608f3f8f7010f0b2 sh:class nltl:loadCase ;
    sh:message "A propulsion load case using the ice-milling load sequence shall be declared." ;
    sh:minCount 1 ;
    sh:node _:N4a3f24dc51194555a3acda17665eb7c9 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasPropulsionLoadCase .

_:n0f9268ad01b9425a86608f3f8f7010f0b4 sh:class nltl:loadCasePurposeValue ;
    sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
    sh:maxCount 1 ;
    sh:message "The ice-milling load sequence shall be used for propulsion line strength evaluation and not for propulsion system stalling analysis." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:loadCasePurpose .

