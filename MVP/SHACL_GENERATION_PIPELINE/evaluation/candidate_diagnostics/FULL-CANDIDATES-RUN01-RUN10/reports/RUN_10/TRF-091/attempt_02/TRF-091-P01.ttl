@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/ship> ;
            sh:resultMessage "Each supplied ice-milling sequence case shall also be linked as the propulsion load case." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each supplied ice-milling sequence case shall also be linked as the propulsion load case." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this
WHERE {
    $this nltl:hasIceMillingSequenceCase ?iceCase .
    FILTER NOT EXISTS {
        $this nltl:hasPropulsionLoadCase ?iceCase .
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF091ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/milling> ;
                    sh:resultMessage "An ice-milling load case shall be used for propulsion-line strength evaluation." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n7847bd33f99a4bbbad4850cbe6552b95b3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/milling> ;
                    sh:resultMessage "An ice-milling load case shall be used for propulsion-line strength evaluation." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n7847bd33f99a4bbbad4850cbe6552b95b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:loadCase ; sh:not [ sh:property [ sh:hasValue nltl:stallingAnalysisPurposeValue ; sh:path nltl:loadCasePurpose ] ] ; sh:property [ sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ; sh:message Literal(\"An ice-milling load case shall be used for propulsion-line strength evaluation.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:loadCasePurpose ] ]. See details for more information." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:loadCase ;
                            sh:not [ sh:property [ sh:hasValue nltl:stallingAnalysisPurposeValue ;
                                            sh:path nltl:loadCasePurpose ] ] ;
                            sh:property [ sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                                    sh:message "An ice-milling load case shall be used for propulsion-line strength evaluation." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:loadCasePurpose ] ] ;
                    sh:path nltl:hasIceMillingSequenceCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/milling> ] .

_:n7847bd33f99a4bbbad4850cbe6552b95b3 sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
    sh:message "An ice-milling load case shall be used for propulsion-line strength evaluation." ;
    sh:minCount 1 ;
    sh:path nltl:loadCasePurpose .

