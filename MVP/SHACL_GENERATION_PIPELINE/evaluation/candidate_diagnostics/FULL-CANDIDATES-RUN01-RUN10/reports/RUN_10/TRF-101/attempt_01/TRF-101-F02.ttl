@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasLoadCase" ;
            sh:resultPath nltl:hasLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:bladeFailureLoadWeakestDirectionConfirmed ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:maxInclusive 0.8 ;
                                                    sh:minCount 1 ;
                                                    sh:minInclusive 0.8 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:bladeFailureLoadApplicationRadiusRatio ] ] ;
                    sh:path nltl:hasLoadCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F02/ship> ;
            sh:resultMessage "bladeFailureStatus must be true when blade tip offset exceeds 10 percent of propeller diameter." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "bladeFailureStatus must be true when blade tip offset exceeds 10 percent of propeller diameter." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeTipOffset ?tipNode ;
                      nltl:propellerDiameter ?diameterNode .
                ?tipNode qudt:numericValue ?tip .
                ?diameterNode qudt:numericValue ?diameter .
                FILTER (?tip > (0.10 * ?diameter))
                FILTER NOT EXISTS {
                    $this nltl:bladeFailureStatus true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-101> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bladeReferenceStrength1" ;
            sh:resultPath nltl:bladeReferenceStrength1 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:bladeReferenceStrength1 ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:approvedNonlinearBladeStressAnalysis" ;
            sh:resultPath nltl:approvedNonlinearBladeStressAnalysis ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:approvalRecord ;
                    sh:minCount 1 ;
                    sh:path nltl:approvedNonlinearBladeStressAnalysis ] ] .

