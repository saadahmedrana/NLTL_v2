@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/bladeTipOffsetValue> ;
                    sh:resultMessage "Node ex:bladeTipOffsetValue->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "Blade tip offset must be supplied as a metre quantity." ;
            sh:resultPath nltl:bladeTipOffset ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Blade tip offset must be supplied as a metre quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:bladeTipOffset ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/bladeTipOffsetValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/propellerDiameterValue> ;
                    sh:resultMessage "Node ex:propellerDiameterValue->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "Propeller diameter must be supplied as a metre quantity." ;
            sh:resultPath nltl:propellerDiameter ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Propeller diameter must be supplied as a metre quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:propellerDiameter ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/propellerDiameterValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "Blade failure status must be true when blade tip offset exceeds 10 percent of propeller diameter." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Blade failure status must be true when blade tip offset exceeds 10 percent of propeller diameter." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeTipOffset ?tipQuantity ;
                      nltl:propellerDiameter ?diameterQuantity .
                ?tipQuantity qudt:numericValue ?tipOffset .
                ?diameterQuantity qudt:numericValue ?diameter .
                FILTER (
                    ?tipOffset > (0.10 * ?diameter)
                    && NOT EXISTS {
                        $this nltl:bladeFailureStatus true
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF101Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:TRF101ApprovedAnalysisBranch , gs:TRF101CalculationBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF101Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "A load case with the required application radius and weakest-direction confirmation is required." ;
            sh:resultPath nltl:hasLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A load case with the required application radius and weakest-direction confirmation is required." ;
                    sh:minCount 1 ;
                    sh:node gs:TRF101LoadCaseShape ;
                    sh:path nltl:hasLoadCase ] ] .

