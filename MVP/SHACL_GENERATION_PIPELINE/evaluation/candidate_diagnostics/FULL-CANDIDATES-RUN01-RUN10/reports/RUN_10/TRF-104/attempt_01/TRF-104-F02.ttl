@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-F02/component0> ;
                    sh:resultMessage "A propeller shaft line component shall not have significant damage from propeller blade loss." ;
                    sh:resultPath nltl:significantDamageFromBladeLoss ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n29f1ac0576e6440d902c2f5f65495a45b4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-F02/component0> ;
                    sh:resultMessage "A propeller shaft line component shall not have significant damage from propeller blade loss." ;
                    sh:resultPath nltl:significantDamageFromBladeLoss ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n29f1ac0576e6440d902c2f5f65495a45b4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-F02/ship> ;
            sh:resultMessage "The ship shall identify the propeller shaft line components subject to the blade-loss damage constraint." ;
            sh:resultPath nltl:hasPropellerShaftLineComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify the propeller shaft line components subject to the blade-loss damage constraint." ;
                    sh:minCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue false ;
                                    sh:message "A propeller shaft line component shall not have significant damage from propeller blade loss." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:significantDamageFromBladeLoss ] ] ;
                    sh:path nltl:hasPropellerShaftLineComponent ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-F02/component0> ] .

_:n29f1ac0576e6440d902c2f5f65495a45b4 sh:datatype xsd:boolean ;
    sh:hasValue false ;
    sh:message "A propeller shaft line component shall not have significant damage from propeller blade loss." ;
    sh:minCount 1 ;
    sh:path nltl:significantDamageFromBladeLoss .

