@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/ship> ;
            sh:resultMessage "The ship must provide one extreme ice force in kN." ;
            sh:resultPath nltl:extremeIceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one extreme ice force in kN." ;
                    sh:minCount 1 ;
                    sh:node gen:KiloNewtonQuantityShape ;
                    sh:path nltl:extremeIceForce ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/loadCase> ;
                    sh:resultMessage "Node ex:loadCase must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:extremeOperationalLoadCase ; sh:path nltl:shaftLineLoadCaseType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Extreme operational load cases require a component yield safety factor of at least 1.3.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:minInclusive Literal(\"1.3\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ], gen:UnitlessQuantityShape ; sh:path nltl:componentYieldSafetyFactor ] ] , [ sh:property [ sh:hasValue nltl:fatigueLoadCase ; sh:path nltl:shaftLineLoadCaseType ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:shipComponent ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Fatigue load cases require a fatigue safety factor of at least 1.5 on each linked ship component.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:minInclusive Literal(\"1.5\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ], gen:UnitlessQuantityShape ; sh:path nltl:fatigueSafetyFactor ] ] ; sh:path ( nltl:hasPropellerShaftLineComponent nltl:hasComponent ) ] ] , [ sh:property [ sh:hasValue nltl:bladeFailureLoadCase ; sh:path nltl:shaftLineLoadCaseType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Blade failure load cases require a component yield safety factor of at least 1.0.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ], gen:UnitlessQuantityShape ; sh:path nltl:componentYieldSafetyFactor ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCase ;
                            sh:or ( [ sh:property [ sh:hasValue nltl:extremeOperationalLoadCase ;
                                                sh:path nltl:shaftLineLoadCaseType ],
                                            [ sh:maxCount 1 ;
                                                sh:message "Extreme operational load cases require a component yield safety factor of at least 1.3." ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:property [ ] ],
                                                    gen:UnitlessQuantityShape ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] [ sh:property [ sh:hasValue nltl:fatigueLoadCase ;
                                                sh:path nltl:shaftLineLoadCaseType ],
                                            [ sh:minCount 1 ;
                                                sh:node [ sh:class nltl:shipComponent ;
                                                        sh:property [ ] ] ;
                                                sh:path ( nltl:hasPropellerShaftLineComponent nltl:hasComponent ) ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:message "Blade failure load cases require a component yield safety factor of at least 1.0." ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:property [ ] ],
                                                    gen:UnitlessQuantityShape ;
                                                sh:path nltl:componentYieldSafetyFactor ],
                                            [ sh:hasValue nltl:bladeFailureLoadCase ;
                                                sh:path nltl:shaftLineLoadCaseType ] ] ) ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "Each propulsion load case must declare one applicable shaft line load case type." ;
                                    sh:minCount 1 ;
                                    sh:node gen:ShaftLineLoadCaseTypeValueShape ;
                                    sh:path nltl:shaftLineLoadCaseType ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/loadCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:loadCase ; sh:or ( [ sh:property [ sh:hasValue nltl:extremeOperationalLoadCase ; sh:path nltl:shaftLineLoadCaseType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Extreme operational load cases require a component yield safety factor of at least 1.3.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:minInclusive Literal(\"1.3\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ], gen:UnitlessQuantityShape ; sh:path nltl:componentYieldSafetyFactor ] ] [ sh:property [ sh:hasValue nltl:fatigueLoadCase ; sh:path nltl:shaftLineLoadCaseType ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:shipComponent ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Fatigue load cases require a fatigue safety factor of at least 1.5 on each linked ship component.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:minInclusive Literal(\"1.5\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ], gen:UnitlessQuantityShape ; sh:path nltl:fatigueSafetyFactor ] ] ; sh:path ( nltl:hasPropellerShaftLineComponent nltl:hasComponent ) ] ] [ sh:property [ sh:hasValue nltl:bladeFailureLoadCase ; sh:path nltl:shaftLineLoadCaseType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Blade failure load cases require a component yield safety factor of at least 1.0.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ], gen:UnitlessQuantityShape ; sh:path nltl:componentYieldSafetyFactor ] ] ) ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each propulsion load case must declare one applicable shaft line load case type.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:ShaftLineLoadCaseTypeValueShape ; sh:path nltl:shaftLineLoadCaseType ] ]. See details for more information." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:loadCase ;
                            sh:or ( [ sh:property [ sh:hasValue nltl:extremeOperationalLoadCase ;
                                                sh:path nltl:shaftLineLoadCaseType ],
                                            [ sh:maxCount 1 ;
                                                sh:message "Extreme operational load cases require a component yield safety factor of at least 1.3." ;
                                                sh:minCount 1 ;
                                                sh:node [ ],
                                                    gen:UnitlessQuantityShape ;
                                                sh:path nltl:componentYieldSafetyFactor ] ] [ sh:property [ sh:hasValue nltl:fatigueLoadCase ;
                                                sh:path nltl:shaftLineLoadCaseType ],
                                            [ sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path [ ] ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:message "Blade failure load cases require a component yield safety factor of at least 1.0." ;
                                                sh:minCount 1 ;
                                                sh:node [ ],
                                                    gen:UnitlessQuantityShape ;
                                                sh:path nltl:componentYieldSafetyFactor ],
                                            [ sh:hasValue nltl:bladeFailureLoadCase ;
                                                sh:path nltl:shaftLineLoadCaseType ] ] ) ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "Each propulsion load case must declare one applicable shaft line load case type." ;
                                    sh:minCount 1 ;
                                    sh:node gen:ShaftLineLoadCaseTypeValueShape ;
                                    sh:path nltl:shaftLineLoadCaseType ] ] ;
                    sh:path nltl:hasPropulsionLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/loadCase> ] .

