@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/ship> ;
            sh:resultMessage "The ship shall provide a single ice operating speed quantity in knots." ;
            sh:resultPath nltl:iceOperatingSpeed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide a single ice operating speed quantity in knots." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:iceOperatingSpeed ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/thrusterBody> ;
            sh:resultMessage "Less than 1 values on ex:thrusterBody->nltl:thrusterResistanceCapacity" ;
            sh:resultPath nltl:thrusterResistanceCapacity ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:thrusterResistanceCapacity ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/thrusterBody> ;
                            sh:resultMessage "Less than 1 values on ex:thrusterBody->nltl:thrusterResistanceCapacity" ;
                            sh:resultPath nltl:thrusterResistanceCapacity ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thrusterResistanceCapacity ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/impact> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:thrusterBody ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterResistanceCapacity ] ]. See details for more information." ;
                    sh:resultPath nltl:thrusterImpactCaseAppliesToBody ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class nltl:thrusterBody ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:class qudt:QuantityValue ;
                                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ],
                                                        [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:thrusterResistanceCapacity ] ] ;
                            sh:path nltl:thrusterImpactCaseAppliesToBody ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/thrusterBody> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/impact> ;
                    sh:resultMessage "Less than 1 values on ex:impact->nltl:thrusterIceImpactLoadCaseIdentifier" ;
                    sh:resultPath nltl:thrusterIceImpactLoadCaseIdentifier ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:string ;
                            sh:minCount 1 ;
                            sh:path nltl:thrusterIceImpactLoadCaseIdentifier ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF-114-ImpactCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasThrusterIceImpactLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-114-ImpactCaseShape> ;
                    sh:path nltl:hasThrusterIceImpactLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/impact> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/ship> ;
            sh:resultMessage "A non-hemispherical impact case shall have an equivalent impact sphere radius on the ship and contact geometry correspondence evidence on the case." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A non-hemispherical impact case shall have an equivalent impact sphere radius on the ship and contact geometry correspondence evidence on the case." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:hasThrusterIceImpactLoadCase ?case .
                ?case nltl:contactGeometryClassification nltl:nonHemisphericalContactGeometry .
                FILTER (
                    NOT EXISTS {
                        $this nltl:equivalentImpactSphereRadius ?radius .
                        ?radius qudt:numericValue ?radiusValue .
                        ?radius qudt:unit <http://qudt.org/vocab/unit/M> .
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:contactGeometryCorrespondenceEvidence ?evidence .
                        ?evidence a nltl:evidenceArtifact .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-114-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/ship> ] .

