@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasMaterialProperties" ;
            sh:resultPath nltl:hasMaterialProperties ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:materialProperties ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:componentMaterialYieldStrength ] ] ;
                    sh:path nltl:hasMaterialProperties ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/assessment> ;
                    sh:resultMessage "Less than 1 values on ex:assessment->nltl:assessedFactoredExtremeLoad" ;
                    sh:resultPath nltl:assessedFactoredExtremeLoad ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:assessedFactoredExtremeLoad ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:factoredExtremeLoadOperabilityAssessment ; sh:property [ sh:class nltl:shipComponent ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:assessedThrusterComponent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The external assessment must confirm that no repair is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:assessmentRepairRequired ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The external assessment must confirm that operability is maintained.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:assessmentOperabilityMaintained ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:assessedFactoredExtremeLoad ] ]. See details for more information." ;
            sh:resultPath nltl:hasFactoredExtremeLoadOperabilityAssessment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:factoredExtremeLoadOperabilityAssessment ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue false ;
                                    sh:maxCount 1 ;
                                    sh:message "The external assessment must confirm that no repair is required." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:assessmentRepairRequired ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:assessedFactoredExtremeLoad ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The external assessment must confirm that operability is maintained." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:assessmentOperabilityMaintained ],
                                [ sh:class nltl:shipComponent ;
                                    sh:minCount 1 ;
                                    sh:path nltl:assessedThrusterComponent ] ] ;
                    sh:path nltl:hasFactoredExtremeLoadOperabilityAssessment ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/assessment> ] .

