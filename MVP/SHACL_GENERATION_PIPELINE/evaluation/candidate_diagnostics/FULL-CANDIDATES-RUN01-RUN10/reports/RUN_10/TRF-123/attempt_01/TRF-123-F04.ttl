@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/loadCase> ;
                    sh:resultMessage "The occasional-force load case must provide the externally calculated component yield safety factor with a dimensionless unit." ;
                    sh:resultPath nltl:componentYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The occasional-force load case must provide the externally calculated component yield safety factor with a dimensionless unit." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue qudt:UNITLESS ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:componentYieldSafetyFactor ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:detail [ a sh:ValidationResult ;
                                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/componentMaterialYieldStrengthValue> ;
                                            sh:resultMessage "Node ex:componentMaterialYieldStrengthValue->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                                            sh:resultPath qudt:unit ;
                                            sh:resultSeverity sh:Violation ;
                                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                            sh:sourceShape [ sh:hasValue qudt:MegaPA ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/material> ;
                                    sh:resultMessage "The assessed component must provide its material yield strength in MPa." ;
                                    sh:resultPath nltl:componentMaterialYieldStrength ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                                    sh:sourceShape [ sh:maxCount 1 ;
                                            sh:message "The assessed component must provide its material yield strength in MPa." ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ],
                                                        [ sh:hasValue qudt:MegaPA ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ] ] ;
                                            sh:path nltl:componentMaterialYieldStrength ] ;
                                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/componentMaterialYieldStrengthValue> ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/component> ;
                            sh:resultMessage "Each assessed occasional-force component must link to its material properties." ;
                            sh:resultPath nltl:hasMaterialProperties ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:message "Each assessed occasional-force component must link to its material properties." ;
                                    sh:node [ sh:class nltl:materialProperties ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:message "The assessed component must provide its material yield strength in MPa." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ sh:property [ sh:hasValue qudt:MegaPA ;
                                                                    sh:maxCount 1 ;
                                                                    sh:minCount 1 ;
                                                                    sh:path qudt:unit ],
                                                                [ sh:datatype xsd:decimal ;
                                                                    sh:maxCount 1 ;
                                                                    sh:minCount 1 ;
                                                                    sh:path qudt:numericValue ] ] ;
                                                    sh:path nltl:componentMaterialYieldStrength ] ] ;
                                    sh:path nltl:hasMaterialProperties ] ;
                            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/material> ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/component> ;
                            sh:resultMessage "Each assessed occasional-force component must provide its externally calculated stress in MPa." ;
                            sh:resultPath nltl:occasionalForceComponentStress ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Each assessed occasional-force component must provide its externally calculated stress in MPa." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue qudt:MegaPA ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:occasionalForceComponentStress ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/loadCase> ;
                    sh:resultMessage "Each applicable occasional-force load case must identify every assessed component." ;
                    sh:resultPath nltl:occasionalForceCaseAssessedComponent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Each applicable occasional-force load case must identify every assessed component." ;
                            sh:node [ sh:class nltl:shipComponent ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:message "Each assessed occasional-force component must provide its externally calculated stress in MPa." ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ],
                                                        [ sh:hasValue qudt:MegaPA ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ] ] ;
                                            sh:path nltl:occasionalForceComponentStress ],
                                        [ sh:message "Each assessed occasional-force component must link to its material properties." ;
                                            sh:node [ sh:class nltl:materialProperties ;
                                                    sh:property [ sh:maxCount 1 ;
                                                            sh:message "The assessed component must provide its material yield strength in MPa." ;
                                                            sh:minCount 1 ;
                                                            sh:node [ ] ;
                                                            sh:path nltl:componentMaterialYieldStrength ] ] ;
                                            sh:path nltl:hasMaterialProperties ] ] ;
                            sh:path nltl:occasionalForceCaseAssessedComponent ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/component> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/ship> ;
            sh:resultMessage "The ship must provide an occasional-force load case for the required analysis." ;
            sh:resultPath nltl:hasOccasionalForceLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide an occasional-force load case for the required analysis." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:occasionalForceLoadCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "The occasional-force load case must provide the externally calculated component yield safety factor with a dimensionless unit." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue qudt:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:componentYieldSafetyFactor ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The occasional-force load case must identify that propeller blades are excluded from its scope." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ],
                                [ sh:message "Each applicable occasional-force load case must identify every assessed component." ;
                                    sh:node [ sh:class nltl:shipComponent ;
                                            sh:property [ sh:message "Each assessed occasional-force component must link to its material properties." ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:hasMaterialProperties ],
                                                [ sh:maxCount 1 ;
                                                    sh:message "Each assessed occasional-force component must provide its externally calculated stress in MPa." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:occasionalForceComponentStress ] ] ;
                                    sh:path nltl:occasionalForceCaseAssessedComponent ] ] ;
                    sh:path nltl:hasOccasionalForceLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F04/loadCase> ] .

