@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The propulsion reversal state must be recorded as true when the 12-start requirement applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propulsionEngineReversedForAstern ], [ sh:datatype xsd:integer ; sh:message Literal(\"Air receiver capacity must provide at least 12 consecutive propulsion-engine starts when reversal for astern movement is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"12\", datatype=xsd:integer) ; sh:path nltl:airReceiverConsecutiveStartCapacity ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"The propulsion reversal state must be recorded as false when the 6-start requirement applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propulsionEngineReversedForAstern ], [ sh:datatype xsd:integer ; sh:message Literal(\"Air receiver capacity must provide at least 6 consecutive propulsion-engine starts when reversal for astern movement is not required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"6\", datatype=xsd:integer) ; sh:path nltl:airReceiverConsecutiveStartCapacity ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_126_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-F01/ship> ] .

