@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F01/ship> ;
            sh:resultMessage "Compressor charge time must be at most 0.5 hours for an IA Super ship requiring propulsion engine reversal for astern, and at most 1 hour otherwise." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Compressor charge time must be at most 0.5 hours for an IA Super ship requiring propulsion engine reversal for astern, and at most 1 hour otherwise." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:propulsionEngineReversalRequiredForAstern ?reversal ;
                      nltl:compressorChargeTime ?chargeTime .
                ?chargeTime qudt:numericValue ?value .
                FILTER (
                    (
                        ?iceClass = nltl:iceClassIaSuper &&
                        ?reversal = true &&
                        ?value > "0.5"^^xsd:decimal
                    )
                    ||
                    (
                        (
                            ?iceClass != nltl:iceClassIaSuper ||
                            ?reversal = false
                        ) &&
                        ?value > "1"^^xsd:decimal
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF128Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F01/ship> ] .

