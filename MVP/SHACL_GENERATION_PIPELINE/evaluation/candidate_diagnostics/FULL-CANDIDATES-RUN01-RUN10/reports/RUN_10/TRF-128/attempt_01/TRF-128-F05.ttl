@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F05/ship> ;
            sh:resultMessage "A ship must state whether propulsion engine reversal is required for going astern." ;
            sh:resultPath nltl:propulsionEngineReversalRequiredForAstern ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "A ship must state whether propulsion engine reversal is required for going astern." ;
                    sh:minCount 1 ;
                    sh:path nltl:propulsionEngineReversalRequiredForAstern ] ] .

