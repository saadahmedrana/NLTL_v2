@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F10/chest1> ;
            sh:resultMessage "Less than 1 values on ex:chest1->nltl:seaInletLocation" ;
            sh:resultPath nltl:seaInletLocation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:seaInletLocation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F10/ship> ;
            sh:resultMessage "The cooling-water chest volume and height applicability selector must be provided exactly once." ;
            sh:resultPath nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The cooling-water chest volume and height applicability selector must be provided exactly once." ;
                    sh:minCount 1 ;
                    sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F10/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:totalRelevantEnginePower" ;
            sh:resultPath nltl:totalRelevantEnginePower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:totalRelevantEnginePower ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F10/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ] ; sh:sparql [ sh:message Literal("At least one inlet chest must satisfy the standard cooling-water chest arrangement and calculations.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:hasComponent ?ch .
                        ?ch a nltl:inletChest ;
                            nltl:seaInletLocation "near centreline and well aft if possible" ;
                            nltl:iceAccumulationSpaceAboveInlet true ;
                            nltl:fullCapacityDischargePipeConnected true ;
                            nltl:recommendedChestVolume ?rv ;
                            nltl:strainerOpenArea ?sa ;
                            nltl:inletPipeArea ?ia .

                        ?rv qudt:numericValue ?rvn ;
                            qudt:unit unit:M3 .
                        ?sa qudt:numericValue ?san ;
                            qudt:unit unit:M2 .
                        ?ia qudt:numericValue ?ian ;
                            qudt:unit unit:M2 .
                        $this nltl:totalRelevantEnginePower ?tp .
                        ?tp qudt:numericValue ?tpn ;
                            qudt:unit unit:KiloW .

                        FILTER (
                            ABS(?rvn - (?tpn / 750)) <=
                            (0.000001 * ABS(?tpn / 750) + 0.000000001)
                        )
                        FILTER (?san >= 4 * ?ian)
                    }
                ") ] ] , [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestAlternativeArrangementUsed ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ] ; sh:sparql [ sh:message Literal("When the standard volume and height requirements cannot be met, at least two alternating inlet chests must be provided.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>

                    SELECT $this
                    WHERE {
                        $this nltl:hasComponent ?ch1 .
                        $this nltl:hasComponent ?ch2 .
                        ?ch1 a nltl:inletChest ;
                             nltl:alternatingCoolingWaterIntakeAndDischarge true .
                        ?ch2 a nltl:inletChest ;
                             nltl:alternatingCoolingWaterIntakeAndDischarge true .
                        FILTER (?ch1 != ?ch2)
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-130-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F10/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-130-F10/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:maximumContinuousRatingPower" ;
            sh:resultPath nltl:maximumContinuousRatingPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:maximumContinuousRatingPower ] ] .

