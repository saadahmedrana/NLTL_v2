@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F01/ship> ;
            sh:resultMessage "Maximum continuous rating power must be at least f1*f2*f3*(f4*Delta + P0), within a relative tolerance of 1e-6 and an absolute fallback of 1e-6 kW." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Maximum continuous rating power must be at least f1*f2*f3*(f4*Delta + P0), within a relative tolerance of 1e-6 and an absolute fallback of 1e-6 kW." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumContinuousRatingPower ?power ;
                      nltl:engineOutputFormulaBasePowerP0 ?p0 ;
                      nltl:engineOutputFormulaDisplacement ?delta ;
                      nltl:engineOutputFormulaFactorF1 ?f1 ;
                      nltl:engineOutputFormulaFactorF2 ?f2 ;
                      nltl:engineOutputFormulaFactorF3 ?f3 ;
                      nltl:engineOutputFormulaFactorF4 ?f4 .
                ?power qudt:numericValue ?actual .
                ?p0 qudt:numericValue ?p0Value .
                ?delta qudt:numericValue ?deltaValue .
                ?f1 qudt:numericValue ?f1Value .
                ?f2 qudt:numericValue ?f2Value .
                ?f3 qudt:numericValue ?f3Value .
                ?f4 qudt:numericValue ?f4Value .
                BIND((?f1Value * ?f2Value * ?f3Value * ((?f4Value * ?deltaValue) + ?p0Value)) AS ?expected)
                FILTER(
                    ?actual < ?expected &&
                    ABS(?actual - ?expected) > (ABS(?expected) * "0.000001"^^xsd:decimal + "0.000001"^^xsd:decimal)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape [ a sh:NodeShape ;
                    sh:or ( [ sh:property [ sh:node [ sh:property [ ] ] ;
                                        sh:path nltl:maximumContinuousRatingPower ],
                                    [ sh:or ( [ ] [ ] ) ;
                                        sh:path nltl:iceClass ] ] [ sh:property [ sh:or ( [ ] [ ] [ ] [ ] ) ;
                                        sh:path nltl:iceClass ] ] ) ;
                    sh:property [ sh:maxCount 1 ;
                            sh:message "The ship must declare one maximum continuous rating power in kW." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue unit:KiloW ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:maximumContinuousRatingPower ],
                        [ sh:maxCount 1 ;
                            sh:message "The ship must have one ice class." ;
                            sh:minCount 1 ;
                            sh:path nltl:iceClass ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:engineOutputFormulaDisplacement ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:engineOutputFormulaFactorF4 ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue unit:UNITLESS ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:engineOutputFormulaFactorF3 ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue unit:UNITLESS ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:engineOutputFormulaFactorF2 ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue unit:UNITLESS ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:engineOutputFormulaFactorF1 ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue unit:KiloW ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:engineOutputFormulaBasePowerP0 ] ;
                    sh:sparql [ sh:message "Maximum continuous rating power must be at least f1*f2*f3*(f4*Delta + P0), within a relative tolerance of 1e-6 and an absolute fallback of 1e-6 kW." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumContinuousRatingPower ?power ;
                      nltl:engineOutputFormulaBasePowerP0 ?p0 ;
                      nltl:engineOutputFormulaDisplacement ?delta ;
                      nltl:engineOutputFormulaFactorF1 ?f1 ;
                      nltl:engineOutputFormulaFactorF2 ?f2 ;
                      nltl:engineOutputFormulaFactorF3 ?f3 ;
                      nltl:engineOutputFormulaFactorF4 ?f4 .
                ?power qudt:numericValue ?actual .
                ?p0 qudt:numericValue ?p0Value .
                ?delta qudt:numericValue ?deltaValue .
                ?f1 qudt:numericValue ?f1Value .
                ?f2 qudt:numericValue ?f2Value .
                ?f3 qudt:numericValue ?f3Value .
                ?f4 qudt:numericValue ?f4Value .
                BIND((?f1Value * ?f2Value * ?f3Value * ((?f4Value * ?deltaValue) + ?p0Value)) AS ?expected)
                FILTER(
                    ?actual < ?expected &&
                    ABS(?actual - ?expected) > (ABS(?expected) * "0.000001"^^xsd:decimal + "0.000001"^^xsd:decimal)
                )
            }
        """ ] ;
                    sh:targetClass nltl:ship ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F01/ship> ] .

