@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-P01/ship> ;
            sh:resultMessage "When the ship is intended to operate astern in ice regions, its aft section design basis must be \"Bow and Bow Intermediate hull area requirements\"." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the ship is intended to operate astern in ice regions, its aft section design basis must be \"Bow and Bow Intermediate hull area requirements\"." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:asternIceOperationIntent true .
                FILTER NOT EXISTS {
                    $this nltl:aftSectionDesignBasis "Bow and Bow Intermediate hull area requirements"^^xsd:string .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_006_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-P01/ship> ] .

