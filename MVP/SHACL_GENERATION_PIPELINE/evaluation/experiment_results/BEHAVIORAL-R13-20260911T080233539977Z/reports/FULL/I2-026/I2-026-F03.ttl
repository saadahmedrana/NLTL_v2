@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ;
                    sh:resultMessage "The structural member must identify exactly one permitted frame support condition." ;
                    sh:resultPath nltl:frameSupportCondition ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:frameSupportConditionValue ;
                            sh:in ( nltl:fixedFrameSupport nltl:simpleFrameSupport ) ;
                            sh:maxCount 1 ;
                            sh:message "The structural member must identify exactly one permitted frame support condition." ;
                            sh:minCount 1 ;
                            sh:path nltl:frameSupportCondition ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ;
                    sh:resultMessage "A structural member requiring fixity must have fixed frame support." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "A structural member requiring fixity must have fixed frame support." ;
                            sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  FILTER (
    (
      EXISTS {
        $this nltl:continuousThroughSupport true .
      }
      ||
      EXISTS {
        $this nltl:terminatesWithinIceStrengthenedArea true .
      }
      ||
      EXISTS {
        $this nltl:hasMemberSupport ?support .
        ?support nltl:connectionBracketPresent true .
      }
      ||
      EXISTS {
        $this nltl:significantRotationalRestraintEvidence ?evidence .
      }
    )
    &&
    NOT EXISTS {
      $this nltl:frameSupportCondition nltl:fixedFrameSupport .
    }
  )
}
""" ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_026_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_026_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:node gen:I2_026_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F03/member> ] .

