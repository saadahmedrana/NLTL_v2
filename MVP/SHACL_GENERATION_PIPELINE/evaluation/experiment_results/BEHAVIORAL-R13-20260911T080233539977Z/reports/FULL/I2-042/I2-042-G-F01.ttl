@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-042-F01/member> ;
                    sh:resultMessage "Flange width must be at least five times the net web thickness." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Flange width must be at least five times the net web thickness." ;
                            sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl/vocab#netWebThickness> ?netThicknessNode ;
                      <https://w3id.org/nltl/vocab#flangeWidth> ?flangeWidthNode .
                ?netThicknessNode <http://qudt.org/schema/qudt/numericValue> ?netThickness ;
                                  <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/MilliM> .
                ?flangeWidthNode <http://qudt.org/schema/qudt/numericValue> ?flangeWidth ;
                                  <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/MilliM> .
                FILTER (?flangeWidth < (5 * ?netThickness))
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_042_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-042-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-042-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_042_StructuralMemberShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:I2_042_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-042-F01/member> ] .

