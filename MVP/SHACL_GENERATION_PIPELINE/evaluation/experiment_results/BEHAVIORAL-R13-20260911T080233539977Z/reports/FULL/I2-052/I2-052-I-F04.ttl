@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/ship> ;
            sh:resultMessage "The ship must contain the externally determined interpolated value." ;
            sh:resultPath nltl:interpolatedValue ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must contain the externally determined interpolated value." ;
                    sh:minCount 1 ;
                    sh:path nltl:interpolatedValue ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/lowerPoint> ;
                            sh:resultMessage "Less than 1 values on ex:lowerPoint->nltl:interpolationCoordinate" ;
                            sh:resultPath nltl:interpolationCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n7ec2969e3c434defbd0930dee874c7d1b15 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/calculation> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-052-InterpolationPointShape>. See details for more information." ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-052-InterpolationPointShape> ;
                            sh:path nltl:interpolationLowerEndpoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/lowerPoint> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/lowerPoint> ;
                            sh:resultMessage "Less than 1 values on ex:lowerPoint->nltl:interpolationCoordinate" ;
                            sh:resultPath nltl:interpolationCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n7ec2969e3c434defbd0930dee874c7d1b15 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/calculation> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-052-InterpolationPointShape>. See details for more information." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-052-InterpolationPointShape> ;
                            sh:path nltl:hasInterpolationPoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/lowerPoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-052-CalculationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-052-CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F04/calculation> ] .

