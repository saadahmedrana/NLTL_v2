@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F07/ship> ;
            sh:resultMessage "The ship must contain the externally determined interpolated value." ;
            sh:resultPath nltl:interpolatedValue ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must contain the externally determined interpolated value." ;
                    sh:minCount 1 ;
                    sh:path nltl:interpolatedValue ] ] .

