@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F06/ship> ;
            sh:resultMessage "The Table 9 strength criteria must be satisfied." ;
            sh:resultPath nltl:strengthCriterionStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb99df624f9814ca88c67c2456c3ab272b9 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F06/ship> ;
            sh:resultMessage "The Table 9 strength criteria must be satisfied." ;
            sh:resultPath nltl:strengthCriterionStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb99df624f9814ca88c67c2456c3ab272b9 ] .

_:nb99df624f9814ca88c67c2456c3ab272b9 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The Table 9 strength criteria must be satisfied." ;
    sh:minCount 1 ;
    sh:path nltl:strengthCriterionStatus .

