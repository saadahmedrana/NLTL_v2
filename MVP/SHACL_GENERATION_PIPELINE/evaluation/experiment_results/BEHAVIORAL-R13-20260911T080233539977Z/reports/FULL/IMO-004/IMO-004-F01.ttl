@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F01/ship> ;
            sh:resultMessage "When the sea-ice origin, winter growth count, and ice thickness conditions apply, the ice type classification must be first-year ice." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the sea-ice origin, winter growth count, and ice thickness conditions apply, the ice type classification must be first-year ice." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceOriginType nltl:seaIceOrigin ;
                       nltl:winterGrowthCount ?growth ;
                       nltl:iceThickness ?thickness ;
                       nltl:iceTypeClassification ?classification .
                ?thickness qudt:numericValue ?thicknessValue ;
                           qudt:unit unit:M .
                FILTER (datatype(?growth) = xsd:integer)
                FILTER (datatype(?thicknessValue) = xsd:decimal)
                FILTER (?growth <= 1)
                FILTER (?thicknessValue >= 0.3)
                FILTER (?thicknessValue <= 2.0)
                FILTER (?classification != nltl:firstYearIce)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_004_ConditionalClassificationShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F01/ship> ;
            sh:resultMessage "When the sea-ice origin, winter growth count, and ice thickness conditions apply, a first-year ice classification is required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the sea-ice origin, winter growth count, and ice thickness conditions apply, a first-year ice classification is required." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceOriginType nltl:seaIceOrigin ;
                       nltl:winterGrowthCount ?growth ;
                       nltl:iceThickness ?thickness .
                ?thickness qudt:numericValue ?thicknessValue ;
                           qudt:unit unit:M .
                FILTER (datatype(?growth) = xsd:integer)
                FILTER (datatype(?thicknessValue) = xsd:decimal)
                FILTER (?growth <= 1)
                FILTER (?thicknessValue >= 0.3)
                FILTER (?thicknessValue <= 2.0)
                FILTER NOT EXISTS {
                    $this nltl:iceTypeClassification nltl:firstYearIce .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_004_ConditionalClassificationShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F01/ship> ] .

