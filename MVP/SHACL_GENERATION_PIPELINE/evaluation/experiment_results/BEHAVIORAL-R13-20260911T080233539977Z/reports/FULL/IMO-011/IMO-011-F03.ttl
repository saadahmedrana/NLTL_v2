@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F03/ship> ;
            sh:resultMessage "The ship must provide one externally computed mean daily low temperature in degrees Celsius." ;
            sh:resultPath nltl:meanDailyLowTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide one externally computed mean daily low temperature in degrees Celsius." ;
                    sh:minCount 1 ;
                    sh:node nltlgen:IMO_011_MeanDailyLowTemperatureQuantityShape ;
                    sh:path nltl:meanDailyLowTemperature ] ] .

