@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-013-F01/ship> ;
            sh:resultMessage "A ship with a lowest MDLT below -10 degrees Celsius must be declared to operate in low air temperature." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A ship with a lowest MDLT below -10 degrees Celsius must be declared to operate in low air temperature." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:lowestMdlt ?quantity .
                ?quantity qudt:numericValue ?value .
                FILTER (?value < "-10"^^xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:shipOperatesInLowAirTemperature ?state .
                    FILTER (?state = true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-013> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-013-F01/ship> ] .

