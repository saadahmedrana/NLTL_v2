@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ;
            sh:resultMessage "A ship shall have the applicable SOLAS certificate schedule." ;
            sh:resultPath nltl:hasSolasCertificateSchedule ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:solasCertificateSchedule ;
                    sh:message "A ship shall have the applicable SOLAS certificate schedule." ;
                    sh:minCount 1 ;
                    sh:node gs:IMO017SolasScheduleShape ;
                    sh:path nltl:hasSolasCertificateSchedule ] ] .

