@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F04/supplement> ;
                    sh:resultMessage "The Polar Certificate supplement shall record the equipment required by the Code." ;
                    sh:resultPath nltl:hasRequiredEquipmentRecords ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:requiredEquipmentRecords ;
                            sh:message "The Polar Certificate supplement shall record the equipment required by the Code." ;
                            sh:minCount 1 ;
                            sh:path nltl:hasRequiredEquipmentRecords ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F04/ship> ;
            sh:resultMessage "The Polar Ship Certificate shall include a supplement." ;
            sh:resultPath nltl:hasPolarCertificateSupplement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarCertificateSupplement ;
                    sh:message "The Polar Ship Certificate shall include a supplement." ;
                    sh:minCount 1 ;
                    sh:node gs:IMO017SupplementShape ;
                    sh:path nltl:hasPolarCertificateSupplement ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F04/supplement> ] .

