@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-026-F01/ship> ;
            sh:resultMessage "When the ice capability methodology is applicable, the Polar Water Operational Manual must contain it." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When the ice capability methodology is applicable, the Polar Water Operational Manual must contain it." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceCapabilityMethodologyApplicable ?applicable .
                FILTER (datatype(?applicable) = xsd:boolean && ?applicable = true)
                FILTER NOT EXISTS {
                    $this nltl:polarWaterOperationalManualIceCapabilityMethodologyPresent ?present .
                    FILTER (datatype(?present) = xsd:boolean && ?present = true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_026_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-026-F01/ship> ] .

