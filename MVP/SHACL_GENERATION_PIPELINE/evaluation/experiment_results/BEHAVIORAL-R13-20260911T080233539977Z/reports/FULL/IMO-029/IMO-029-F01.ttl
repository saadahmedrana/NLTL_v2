@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-029-F01/ship> ;
            sh:resultMessage "The ship's PWOM must include procedures for encounters with ice or temperatures exceeding its design capabilities or limitations." ;
            sh:resultPath nltl:exceedanceResponseProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The ship's PWOM must include procedures for encounters with ice or temperatures exceeding its design capabilities or limitations." ;
                    sh:minCount 1 ;
                    sh:path nltl:exceedanceResponseProcedurePresent ] ] .

