@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F05/ship> ;
            sh:resultMessage "The ship must state whether ice operation is applicable." ;
            sh:resultPath nltl:iceOperationApplicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ship must state whether ice operation is applicable." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceOperationApplicable ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:iceOperationApplicable ] ] , [ sh:or ( [ sh:property [ sh:datatype xsd:string ; sh:message Literal(\"Independent-operation limitations must be specified for the independent-operation option.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:independentOperationLimits ], [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:escortedOperationLimits ] ] [ sh:property [ sh:datatype xsd:string ; sh:message Literal(\"Escorted-operation limitations must be specified for the escorted-operation option.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:escortedOperationLimits ], [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:independentOperationLimits ] ] [ sh:property [ sh:datatype xsd:string ; sh:message Literal(\"Escorted-operation limitations must be specified when both operating options apply.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:escortedOperationLimits ], [ sh:datatype xsd:string ; sh:message Literal(\"Independent-operation limitations must be specified when both operating options apply.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:independentOperationLimits ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Applicable escort or icebreaker-assistance requirements must be present when ice operation is applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:escortRequirementsPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Ice-operation safety monitoring procedures must be present when ice operation is applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceSafetyMonitoringProcedurePresent ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:iceOperationApplicable ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO030Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F05/ship> ] .

