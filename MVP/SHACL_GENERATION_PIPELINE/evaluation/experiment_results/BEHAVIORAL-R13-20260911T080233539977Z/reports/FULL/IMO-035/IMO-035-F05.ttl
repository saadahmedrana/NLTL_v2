@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F05/ship> ;
            sh:resultMessage "Stability calculation icing allowance values must be provided." ;
            sh:resultPath nltl:stabilityCalculationIcingAllowanceValues ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "Stability calculation icing allowance values must be provided." ;
                    sh:minCount 1 ;
                    sh:path nltl:stabilityCalculationIcingAllowanceValues ] ] .

