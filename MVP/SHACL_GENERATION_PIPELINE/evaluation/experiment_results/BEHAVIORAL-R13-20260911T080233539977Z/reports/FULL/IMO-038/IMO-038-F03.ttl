@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ;
            sh:resultMessage "Ice damage extents or selected vertical damage position do not satisfy the required formulas and inclusive range." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ice damage extents or selected vertical damage position do not satisfy the required formulas and inclusive range." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthNode ;
                      nltl:upperIceWaterlineDraught ?draughtNode ;
                      nltl:longitudinalDamageExtent ?longNode ;
                      nltl:verticalDamageExtent ?verticalNode ;
                      nltl:selectedVerticalDamagePosition ?positionNode .

                ?lengthNode qudt:numericValue ?length .
                ?draughtNode qudt:numericValue ?draught .
                ?longNode qudt:numericValue ?reportedLong .
                ?verticalNode qudt:numericValue ?reportedVertical .
                ?positionNode qudt:numericValue ?position .

                BIND(
                    IF(?forward = true,
                       ?length * 0.045,
                       ?length * 0.015)
                    AS ?expectedLong
                )
                BIND(
                    IF(?draught * 0.20 < ?expectedLong,
                       ?draught * 0.20,
                       ?expectedLong)
                    AS ?expectedVertical
                )
                BIND(
                    IF(?expectedLong > 0.000001,
                       ?expectedLong * 0.000001,
                       0.000001)
                    AS ?longTolerance
                )
                BIND(
                    IF(?expectedVertical > 0.000001,
                       ?expectedVertical * 0.000001,
                       0.000001)
                    AS ?verticalTolerance
                )

                FILTER(
                    ?reportedLong < (?expectedLong - ?longTolerance) ||
                    ?reportedLong > (?expectedLong + ?longTolerance) ||
                    ?reportedVertical < (?expectedVertical - ?verticalTolerance) ||
                    ?reportedVertical > (?expectedVertical + ?verticalTolerance) ||
                    ?position < 0 ||
                    ?position > (?draught * 1.20)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlgen:IMO038ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ] .

