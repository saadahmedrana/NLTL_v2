@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F01/control1> ;
                    sh:resultMessage "The local control must have freezing, snow, and ice protection." ;
                    sh:resultPath nltl:localControlProtectionPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n8fc75425f0d24fa6b61a1a9b251a8ac5b2 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F01/control1> ;
                    sh:resultMessage "The local control must remain continuously accessible." ;
                    sh:resultPath nltl:localControlContinuouslyAccessible ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n8fc75425f0d24fa6b61a1a9b251a8ac5b3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F01/control1> ;
                    sh:resultMessage "The local control must have freezing, snow, and ice protection." ;
                    sh:resultPath nltl:localControlProtectionPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n8fc75425f0d24fa6b61a1a9b251a8ac5b2 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F01/control1> ;
                    sh:resultMessage "The local control must remain continuously accessible." ;
                    sh:resultPath nltl:localControlContinuouslyAccessible ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n8fc75425f0d24fa6b61a1a9b251a8ac5b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F01/ship> ;
            sh:resultMessage "Each linked local control item must be a localControlItem satisfying the required protection and accessibility conditions." ;
            sh:resultPath nltl:hasLocalControlItem ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:localControlItem ;
                    sh:message "Each linked local control item must be a localControlItem satisfying the required protection and accessibility conditions." ;
                    sh:node gen:IMO_051_LocalControlItemShape ;
                    sh:path nltl:hasLocalControlItem ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F01/control1> ] .

_:n8fc75425f0d24fa6b61a1a9b251a8ac5b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The local control must have freezing, snow, and ice protection." ;
    sh:minCount 1 ;
    sh:path nltl:localControlProtectionPresent .

_:n8fc75425f0d24fa6b61a1a9b251a8ac5b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The local control must remain continuously accessible." ;
    sh:minCount 1 ;
    sh:path nltl:localControlContinuouslyAccessible .

