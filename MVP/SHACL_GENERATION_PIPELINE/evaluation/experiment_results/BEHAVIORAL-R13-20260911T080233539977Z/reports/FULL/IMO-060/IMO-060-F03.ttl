@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:independentSeaSuctionUsed" ;
            sh:resultPath nltl:independentSeaSuctionUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:independentSeaSuctionUsed ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F03/ship> ;
            sh:resultMessage "When the fixed water system is separate from the main fire pumps and uses an independent sea suction, that sea suction must be capable of being cleared of ice accumulation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-060> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F03/ship> ] .

