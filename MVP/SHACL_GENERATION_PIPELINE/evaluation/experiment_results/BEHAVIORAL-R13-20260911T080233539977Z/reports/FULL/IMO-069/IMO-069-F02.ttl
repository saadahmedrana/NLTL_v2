@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-069-F02/ship> ;
            sh:resultMessage "Every added life-saving device requiring power must have a power source independent of the ship's main power source." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Every added life-saving device requiring power must have a power source independent of the ship's main power source." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:addedLifeSavingDeviceRequiresPower ?requiresPower .
                FILTER (?requiresPower = "true"^^xsd:boolean)
                FILTER NOT EXISTS {
                    $this nltl:devicePowerSourceIndependentOfMainPower ?independent .
                    FILTER (?independent = "true"^^xsd:boolean)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_069_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-069-F02/ship> ] .

