@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-073-F03/boat2> ;
                    sh:resultMessage "A lifeboat shall be partially enclosed or totally enclosed." ;
                    sh:resultPath nltl:lifeboatTypeClassification ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:lifeboatTypeValue ;
                            sh:in ( nltl:partiallyEnclosedLifeboat nltl:totallyEnclosedLifeboat ) ;
                            sh:message "A lifeboat shall be partially enclosed or totally enclosed." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:lifeboatTypeClassification ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-073-F03/boat2OpenType> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-073-F03/ship> ;
            sh:resultMessage "Each linked lifeboat shall have an allowed lifeboat type classification." ;
            sh:resultPath nltl:hasLifeboat ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:lifeboat ;
                    sh:message "Each linked lifeboat shall have an allowed lifeboat type classification." ;
                    sh:node <urn:nltl:generated-shape:IMO-073-LifeboatShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasLifeboat ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-073-F03/boat2> ] .

