@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F03/passenger1> ;
                    sh:resultMessage "Each linked passenger must have received instruction in the use of personal survival equipment." ;
                    sh:resultPath nltl:personalSurvivalEquipmentInstructionCompleted ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nf0fe7bd1ff694a0d8bbd42c6ba674e79b4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F03/passenger1> ;
                    sh:resultMessage "Each linked passenger must have received instruction in the use of personal survival equipment." ;
                    sh:resultPath nltl:personalSurvivalEquipmentInstructionCompleted ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nf0fe7bd1ff694a0d8bbd42c6ba674e79b4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-078-PassengerShape>. See details for more information." ;
            sh:resultPath nltl:hasPassenger ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-078-PassengerShape> ;
                    sh:path nltl:hasPassenger ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F03/passenger1> ] .

_:nf0fe7bd1ff694a0d8bbd42c6ba674e79b4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "Each linked passenger must have received instruction in the use of personal survival equipment." ;
    sh:minCount 1 ;
    sh:path nltl:personalSurvivalEquipmentInstructionCompleted .

