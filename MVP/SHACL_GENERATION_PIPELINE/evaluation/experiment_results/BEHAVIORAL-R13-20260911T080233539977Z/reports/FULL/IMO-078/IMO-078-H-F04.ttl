@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F04/crew1> ;
                    sh:resultMessage "Each linked crew member must have completed personal and group survival equipment training." ;
                    sh:resultPath nltl:personalAndGroupSurvivalEquipmentTrainingCompleted ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nf0fe7bd1ff694a0d8bbd42c6ba674e79b3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F04/crew1> ;
                    sh:resultMessage "Each linked crew member must have completed personal and group survival equipment training." ;
                    sh:resultPath nltl:personalAndGroupSurvivalEquipmentTrainingCompleted ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nf0fe7bd1ff694a0d8bbd42c6ba674e79b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-078-CrewMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-078-CrewMemberShape> ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F04/crew1> ] .

_:nf0fe7bd1ff694a0d8bbd42c6ba674e79b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "Each linked crew member must have completed personal and group survival equipment training." ;
    sh:minCount 1 ;
    sh:path nltl:personalAndGroupSurvivalEquipmentTrainingCompleted .

