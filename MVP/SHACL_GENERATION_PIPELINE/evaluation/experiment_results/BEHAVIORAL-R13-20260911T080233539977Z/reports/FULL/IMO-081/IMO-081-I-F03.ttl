@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F03/ship> ;
            sh:resultMessage "For ships constructed on or after 1 January 2017 and ice strengthened, provide either at least two independent echo-sounding devices or at least one device with at least two independent transducers." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-081> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F03/ship> ] .

