@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-092-J-F02/ship> ;
            sh:resultMessage "The ship shall provide communication equipment enabling telemedical assistance in polar areas." ;
            sh:resultPath nltl:telemedicalAssistanceCommunicationEquipmentPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ndae16ff0575c4dd5bf441f50d6d575ccb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-092-J-F02/ship> ;
            sh:resultMessage "The ship shall provide communication equipment enabling telemedical assistance in polar areas." ;
            sh:resultPath nltl:telemedicalAssistanceCommunicationEquipmentPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ndae16ff0575c4dd5bf441f50d6d575ccb1 ] .

_:ndae16ff0575c4dd5bf441f50d6d575ccb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall provide communication equipment enabling telemedical assistance in polar areas." ;
    sh:minCount 1 ;
    sh:path nltl:telemedicalAssistanceCommunicationEquipmentPresent .

