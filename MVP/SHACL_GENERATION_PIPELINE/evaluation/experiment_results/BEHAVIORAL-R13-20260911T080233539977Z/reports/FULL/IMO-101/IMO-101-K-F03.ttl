@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/routePlan> ;
                    sh:resultMessage "The polar route plan shall indicate that voyage-planning topic coverage is true." ;
                    sh:resultPath nltl:voyagePlanningTopicCoverage ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n6a6b9439684f4b44bc59f77b0c88b8dfb2 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/routePlan> ;
                    sh:resultMessage "The polar route plan shall indicate that voyage-planning topic coverage is true." ;
                    sh:resultPath nltl:voyagePlanningTopicCoverage ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n6a6b9439684f4b44bc59f77b0c88b8dfb2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/ship> ;
            sh:resultMessage "Each ship shall have a polar route plan covering the required voyage-planning topics." ;
            sh:resultPath nltl:hasPolarRoutePlan ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarRoutePlan ;
                    sh:message "Each ship shall have a polar route plan covering the required voyage-planning topics." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-101-PolarRoutePlanShape> ;
                    sh:path nltl:hasPolarRoutePlan ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/routePlan> ] .

_:n6a6b9439684f4b44bc59f77b0c88b8dfb2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The polar route plan shall indicate that voyage-planning topic coverage is true." ;
    sh:minCount 1 ;
    sh:path nltl:voyagePlanningTopicCoverage .

