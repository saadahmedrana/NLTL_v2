@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ;
            sh:resultMessage "The ship must record completed PWOM familiarization." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf846f11efbb245e08f5f0e33c25c9e5fb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ;
            sh:resultMessage "Each assigned duty's relevant PWOM item must correspond to an item in the crew member's familiarization records." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each assigned duty's relevant PWOM item must correspond to an item in the crew member's familiarization records." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:hasCrewMemberInventory ?crewMember .
                ?crewMember nltl:hasAssignedDuty ?assignedDuty .
                ?assignedDuty nltl:hasRelevantPolarWaterOperationalManualItem ?manualItem .
                FILTER NOT EXISTS {
                    ?crewMember nltl:hasFamiliarizationRecord ?record .
                    ?record nltl:familiarizationRecordItem ?manualItem .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO104ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ;
            sh:resultMessage "The ship must record completed PWOM familiarization." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nf846f11efbb245e08f5f0e33c25c9e5fb1 ] .

_:nf846f11efbb245e08f5f0e33c25c9e5fb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record completed PWOM familiarization." ;
    sh:minCount 1 ;
    sh:path nltl:polarWaterOperationalManualFamiliarizationStatus .

