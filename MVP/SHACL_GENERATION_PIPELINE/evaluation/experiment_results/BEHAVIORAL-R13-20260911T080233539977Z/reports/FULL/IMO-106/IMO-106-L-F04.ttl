@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F04/ship> ;
            sh:resultMessage "A ship must provide its discharged material classification." ;
            sh:resultPath nltl:dischargedMaterialClassification ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:dischargedMaterialTypeValue ;
                    sh:message "A ship must provide its discharged material classification." ;
                    sh:minCount 1 ;
                    sh:path nltl:dischargedMaterialClassification ] ] .

