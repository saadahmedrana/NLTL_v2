@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Polar-operation coverage must be present for the applicable MARPOL documents.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarOperationCoverage ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Polar-operation coverage must be present in the applicable Oil Record Book.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:oilRecordBookPolarCoverage ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Polar-operation coverage must be present in the applicable manuals.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:manualPolarCoverage ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Polar-operation coverage must be present in the applicable oil or marine pollution emergency plan.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:pollutionEmergencyPlanPolarCoverage ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInPolarWaters ] ] , [ rdf:type sh:NodeShape ; sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:shipOperatesInPolarWaters ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-107-PolarOperationDocumentCoverageShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-F02/ship> ] .

