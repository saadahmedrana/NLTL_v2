@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-113-M-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in <urn:nltl:generated-shape:IMO-113-ApplicablePolarCoverageShape> , <urn:nltl:generated-shape:IMO-113-NonApplicablePolarCoverageShape>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-113-PolarOperationDocumentCoverageShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-113-M-F02/ship> ] .

