@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The sewage treatment plant applicability value must be false for this non-applicable branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sewageDischargeUsesTreatmentPlant ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The MARPOL Annex IV regulation 11.1.2 discharge compliance status must be true.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:marpolAnnexIvRegulation11Point1Point2DischargeComplianceStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The sewage treatment plant applicability value must be true for this applicable branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sewageDischargeUsesTreatmentPlant ], [ sh:hasValue nltl:complianceStateCompliant ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The MARPOL Annex IV regulation 9.1.1 or 9.2.1 certification status must be compliant.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ], [ sh:hasValue nltl:evidenceStateApproved ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"An applicable sewage treatment plant must have approved status.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:sewageTreatmentPlantApprovalStatus ], [ sh:message Literal(\"An applicable ship must have a discharge distance record.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:DischargeDistanceRecordShape ; sh:path nltl:hasDischargeDistanceRecord ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO117Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F01/ship> ] .

