@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/ship> ;
            sh:resultMessage "Chapter 9-1 applicability must be true exactly for qualifying fishing vessels, pleasure yachts, or cargo ships, and false otherwise." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Chapter 9-1 applicability must be true exactly for qualifying fishing vessels, pleasure yachts, or cargo ships, and false otherwise." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this a nltl:ship ;
                      nltl:shipType ?type ;
                      nltl:lengthOverall ?lengthQuantity ;
                      nltl:grossTonnage ?tonnageQuantity ;
                      nltl:engagedInTrade ?trade ;
                      nltl:polarCodeChapter9Dash1Applicable ?app .

                ?lengthQuantity qudt:numericValue ?lengthValue ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .

                ?tonnageQuantity qudt:numericValue ?tonnageValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

                FILTER (
                    ?app !=
                    (
                        (?type = "fishing_vessel" && ?lengthValue >= 24) ||
                        (?type = "pleasure_yacht" && ?tonnageValue >= 300 && ?trade = false) ||
                        (?type = "cargo_ship" && ?tonnageValue >= 300 && ?tonnageValue < 500)
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlgen:Chapter9Dash1ApplicabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F01/ship> ] .

