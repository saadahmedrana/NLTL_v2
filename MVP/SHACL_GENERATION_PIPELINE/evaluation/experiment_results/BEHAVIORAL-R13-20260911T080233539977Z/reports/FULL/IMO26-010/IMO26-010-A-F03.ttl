@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-010-A-F03/ship> ;
            sh:resultMessage "Sensors that project below the hull must be protected against ice." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Sensors that project below the hull must be protected against ice." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:requiredSensorProjectsBelowHull ?required .
                FILTER (?required = true)
                FILTER NOT EXISTS {
                    $this nltl:sensorIceProtectionPresent ?protected .
                    FILTER (?protected = true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO26_010_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-010-A-F03/ship> ] .

