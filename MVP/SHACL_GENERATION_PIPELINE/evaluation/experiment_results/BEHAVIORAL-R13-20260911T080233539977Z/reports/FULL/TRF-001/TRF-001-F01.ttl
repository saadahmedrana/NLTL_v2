@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:iceClassRegulationEdition2021 ; sh:message Literal(\"Ships contracted for construction on or after 5 July 2021 must identify the 2021 Ice Class Regulations as applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:applicableIceClassRegulationEdition ], [ sh:minInclusive Literal(\"2021-07-05\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ] ] , [ sh:property [ sh:maxExclusive Literal(\"2021-07-05\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-001> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "The 2021 Ice Class Draught provision must apply to the ship." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ned47612599654cdb8e76b81b38db5789b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "The 2021 Ice Class Draught provision must apply to the ship." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ned47612599654cdb8e76b81b38db5789b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "The 2021 section 1.8 Ice Classes provision must apply to the ship." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ned47612599654cdb8e76b81b38db5789b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "The 2021 section 1.8 Ice Classes provision must apply to the ship." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ned47612599654cdb8e76b81b38db5789b3 ] .

_:ned47612599654cdb8e76b81b38db5789b2 sh:hasValue nltl:iceClassDraughtChapter2Provision2021 ;
    sh:message "The 2021 Ice Class Draught provision must apply to the ship." ;
    sh:minCount 1 ;
    sh:path nltl:applicableIceClassRegulatoryProvision .

_:ned47612599654cdb8e76b81b38db5789b3 sh:hasValue nltl:iceClassSection1Point8Provision2021 ;
    sh:message "The 2021 section 1.8 Ice Classes provision must apply to the ship." ;
    sh:minCount 1 ;
    sh:path nltl:applicableIceClassRegulatoryProvision .

