@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F02/ship> ;
            sh:resultMessage "An applicable IA or IA Super ship constructed before 1 September 2003 must have an allowed 2017 compliance method and an assessment no later than 1 January in the year twenty years after delivery." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "An applicable IA or IA Super ship constructed before 1 September 2003 must have an allowed 2017 compliance method and an assessment no later than 1 January in the year twenty years after delivery." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (?iceClass IN (
                    nltl:iceClassIa,
                    nltl:iceClassIaSuper
                ))

                $this nltl:constructionStageDate ?constructionStageDate .
                FILTER (datatype(?constructionStageDate) = xsd:date)
                FILTER (
                    YEAR(?constructionStageDate) < 2003 ||
                    (
                        YEAR(?constructionStageDate) = 2003 &&
                        (
                            MONTH(?constructionStageDate) < 9 ||
                            (
                                MONTH(?constructionStageDate) = 9 &&
                                DAY(?constructionStageDate) < 1
                            )
                        )
                    )
                )

                FILTER NOT EXISTS {
                    $this nltl:deliveryDate ?deliveryDate .
                    $this nltl:assessmentDate ?assessmentDate .
                    $this nltl:engineOutputComplianceMethod ?method .

                    FILTER (datatype(?deliveryDate) = xsd:date)
                    FILTER (datatype(?assessmentDate) = xsd:date)
                    FILTER (?method IN (
                        nltl:traficom2017Section3Point2Point2Method,
                        nltl:traficom2017Section3Point2Point4Method
                    ))

                    FILTER (
                        YEAR(?assessmentDate) < YEAR(?deliveryDate) + 20 ||
                        (
                            YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                            (
                                MONTH(?assessmentDate) < 1 ||
                                (
                                    MONTH(?assessmentDate) = 1 &&
                                    DAY(?assessmentDate) <= 1
                                )
                            )
                        )
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF009ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F02/ship> ] .

