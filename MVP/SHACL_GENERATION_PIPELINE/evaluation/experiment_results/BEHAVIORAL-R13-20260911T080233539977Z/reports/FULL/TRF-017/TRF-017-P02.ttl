@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P02/ship> ;
            sh:resultMessage "Maximum continuous rating power must equal the applicable propulsion output, including any additional propulsion power, within the permitted numerical tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Maximum continuous rating power must equal the applicable propulsion output, including any additional propulsion power, within the permitted numerical tolerance." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:propulsionOutputRestrictionApplies ?restrictionFlag .
    FILTER (?restrictionFlag = true || ?restrictionFlag = false)

    OPTIONAL {
        $this nltl:restrictedPropulsionOutput ?restrictedNode .
        ?restrictedNode qudt:numericValue ?restrictedValue .
        ?restrictedNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .
        FILTER (?restrictionFlag = true)
    }

    OPTIONAL {
        $this nltl:propulsionMachineryContinuousOutput ?machineryNode .
        ?machineryNode qudt:numericValue ?machineryValue .
        ?machineryNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .
        FILTER (?restrictionFlag = false)
    }

    FILTER (
        (?restrictionFlag = true && BOUND(?restrictedValue)) ||
        (?restrictionFlag = false && BOUND(?machineryValue))
    )

    BIND(
        IF(?restrictionFlag = true, ?restrictedValue, ?machineryValue)
        AS ?baseValue
    )

    OPTIONAL {
        $this nltl:additionalPropulsionPower ?additionalNode .
        ?additionalNode qudt:numericValue ?additionalValue .
        ?additionalNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .
    }

    BIND(
        IF(BOUND(?additionalValue),
           ?baseValue + ?additionalValue,
           ?baseValue)
        AS ?expectedValue
    )

    $this nltl:maximumContinuousRatingPower ?resultNode .
    ?resultNode qudt:numericValue ?reportedValue .
    ?resultNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .

    FILTER (
        (
            ?reportedValue >= ?expectedValue - (?expectedValue * 0.000001) &&
            ?reportedValue <= ?expectedValue + (?expectedValue * 0.000001)
        ) ||
        (
            ?reportedValue >= ?expectedValue - 0.000001 &&
            ?reportedValue <= ?expectedValue + 0.000001
        )
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF017EngineOutputShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P02/ship> ] .

