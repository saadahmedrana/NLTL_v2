@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-F03/ship> ;
            sh:resultMessage "For ice class IA Super or IA ships constructed before 1 September 2003, deliveryDate and assessmentDate are required, and assessmentDate must not be later than 1 January of the year twenty years after delivery." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ice class IA Super or IA ships constructed before 1 September 2003, deliveryDate and assessmentDate are required, and assessmentDate must not be later than 1 January of the year twenty years after delivery." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass = nltl:iceClassIaSuper ||
                    ?iceClass = nltl:iceClassIa
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:constructionStageDate ?constructionDate
                    }
                    ||
                    EXISTS {
                        $this nltl:constructionStageDate ?constructionDate .
                        FILTER (datatype(?constructionDate) = xsd:date)
                        FILTER (
                            YEAR(?constructionDate) < 2003 ||
                            (
                                YEAR(?constructionDate) = 2003 &&
                                MONTH(?constructionDate) < 9
                            ) ||
                            (
                                YEAR(?constructionDate) = 2003 &&
                                MONTH(?constructionDate) = 9 &&
                                DAY(?constructionDate) < 1
                            )
                        )
                        FILTER (
                            NOT EXISTS {
                                $this nltl:deliveryDate ?deliveryDate
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:assessmentDate ?assessmentDate
                            }
                            ||
                            EXISTS {
                                $this nltl:deliveryDate ?deliveryDate2 .
                                $this nltl:assessmentDate ?assessmentDate2 .
                                FILTER (datatype(?deliveryDate2) = xsd:date)
                                FILTER (datatype(?assessmentDate2) = xsd:date)
                                FILTER (
                                    YEAR(?assessmentDate2) > YEAR(?deliveryDate2) + 20 ||
                                    (
                                        YEAR(?assessmentDate2) = YEAR(?deliveryDate2) + 20 &&
                                        MONTH(?assessmentDate2) > 1
                                    ) ||
                                    (
                                        YEAR(?assessmentDate2) = YEAR(?deliveryDate2) + 20 &&
                                        MONTH(?assessmentDate2) = 1 &&
                                        DAY(?assessmentDate2) > 1
                                    )
                                )
                            }
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF024ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-F03/ship> ] .

