@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-029-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When direct analysis is used, prescribedProcedureApplicability must be false.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:prescribedProcedureApplicability ], [ sh:datatype xsd:string ; sh:message Literal(\"When direct analysis is used, structuralArrangement must be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:structuralArrangement ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:directAnalysisUsed ], [ sh:hasValue nltl:evidenceStateApproved ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When direct analysis is used, its approval status must be Approved.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:directAnalysisApprovalStatus ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:directAnalysisUsed ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF029DirectAnalysisShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-029-F04/ship> ] .

