@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F02/ship> ;
            sh:resultMessage "Combined bending and shear stress must be lower than the yield point, and yield shear stress must equal yield point divided by square root of three within tolerance; when beam theory is used, allowable shear stress must not exceed 0.9 times the calculated yield shear stress." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Combined bending and shear stress must be lower than the yield point, and yield shear stress must equal yield point divided by square root of three within tolerance; when beam theory is used, allowable shear stress must not exceed 0.9 times the calculated yield shear stress." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:combinedBendingShearStress ?combinedNode ;
                      nltl:yieldPoint ?yieldNode ;
                      nltl:yieldShearStress ?resultNode ;
                      nltl:beamTheoryUsed ?beam .

                ?combinedNode qudt:numericValue ?combined .
                ?yieldNode qudt:numericValue ?yield .
                ?resultNode qudt:numericValue ?reported .

                BIND (?yield / 1.7320508075688772 AS ?expected)

                OPTIONAL {
                    FILTER (?beam = true)
                    $this nltl:allowableShearStress ?allowableNode .
                    ?allowableNode qudt:numericValue ?allowable .
                }

                FILTER (
                    (?combined >= ?yield)
                    ||
                    (
                        (?expected >= 0)
                        &&
                        (
                            ?reported < (?expected - ((?expected * 0.000001) + 0.000000000001))
                            ||
                            ?reported > (?expected + ((?expected * 0.000001) + 0.000000000001))
                        )
                    )
                    ||
                    (
                        (?expected < 0)
                        &&
                        (
                            ?reported < (?expected - (((0 - ?expected) * 0.000001) + 0.000000000001))
                            ||
                            ?reported > (?expected + (((0 - ?expected) * 0.000001) + 0.000000000001))
                        )
                    )
                    ||
                    (
                        (?beam = true)
                        &&
                        (?allowable > (0.9 * ?expected))
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF031Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F02/ship> ] .

