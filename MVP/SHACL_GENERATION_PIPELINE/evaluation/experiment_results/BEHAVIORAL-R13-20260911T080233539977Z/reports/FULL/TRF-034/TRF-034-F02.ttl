@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F02/effectiveSection> ;
            sh:resultMessage "The effective member cross section must provide section modulus in cubic centimetres." ;
            sh:resultPath nltl:sectionModulus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "The effective member cross section must provide section modulus in cubic centimetres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:CentiM3 ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:sectionModulus ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F02/shearArea> ;
                    sh:resultMessage "Node ex:shearArea->qudt:unit does not contain a value in the set: ['qudt:M2']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M2 ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F02/effectiveSection> ;
            sh:resultMessage "The effective member cross section must provide shear area in square metres." ;
            sh:resultPath nltl:shearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "The effective member cross section must provide shear area in square metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:M2 ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:shearArea ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F02/shearArea> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F02/effectiveSection> ;
            sh:resultMessage "Node ex:effectiveSection must conform to one or more shapes in [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:hullStructure ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:memberNormalToPlating ] ] ; sh:path [ sh:inversePath nltl:hasEffectiveMemberCrossSection ] ] ] , [ sh:and ( [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:hullStructure ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:memberNormalToPlating ] ] ; sh:path [ sh:inversePath nltl:hasEffectiveMemberCrossSection ] ] ] [ sh:property [ sh:class nltl:evidenceArtifact ; sh:message Literal(\"Classification society section-property calculation evidence is required when the linked member is not normal to the plating.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasClassificationSocietySectionPropertyCalculationEvidence ] ] ) ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF034EffectiveMemberCrossSectionShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F02/effectiveSection> ] .

