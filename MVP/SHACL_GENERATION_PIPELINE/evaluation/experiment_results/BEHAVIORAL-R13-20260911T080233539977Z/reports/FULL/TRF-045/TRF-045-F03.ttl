@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F03/frame> ;
            sh:resultMessage "Ordinary frame scantlings may be used only when the frame span within the ice-strengthening zone is less than 15% of the frame span, with both spans recorded in metres." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ordinary frame scantlings may be used only when the frame span within the ice-strengthening zone is less than 15% of the frame span, with both spans recorded in metres." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:ordinaryFrameScantlingsUsed true .
                FILTER NOT EXISTS {
                    $this nltl:frameSpanWithinIceStrengtheningZone ?iceQuantity .
                    ?iceQuantity qudt:numericValue ?iceValue ;
                                  qudt:unit unit:M .
                    FILTER (datatype(?iceValue) = xsd:decimal)

                    $this nltl:span ?spanQuantity .
                    ?spanQuantity qudt:numericValue ?spanValue ;
                                  qudt:unit unit:M .
                    FILTER (datatype(?spanValue) = xsd:decimal)

                    FILTER (?iceValue < (0.15 * ?spanValue))
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-045_FrameSpanIceZone> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F03/frame> ] .

