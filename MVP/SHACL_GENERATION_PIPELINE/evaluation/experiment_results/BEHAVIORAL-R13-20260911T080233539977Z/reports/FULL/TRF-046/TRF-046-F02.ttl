@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F02/frame> ;
            sh:resultMessage "The upper end of the strengthened frame part must be attached to a deck, tank boundary plating, or ice stringer." ;
            sh:resultPath ( nltl:hasUpperEnd nltl:hasAttachedSupportingStructure ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The upper end of the strengthened frame part must be attached to a deck, tank boundary plating, or ice stringer." ;
                    sh:minCount 1 ;
                    sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:iceStringer ] ) ] ;
                    sh:path ( nltl:hasUpperEnd nltl:hasAttachedSupportingStructure ) ] ] .

