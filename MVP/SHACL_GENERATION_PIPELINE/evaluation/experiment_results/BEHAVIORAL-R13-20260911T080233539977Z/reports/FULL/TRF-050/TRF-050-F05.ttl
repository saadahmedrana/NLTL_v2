@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/attachmentRecord> ;
            sh:resultMessage "The frame shall be attached to the shell by a double continuous weld." ;
            sh:resultPath nltl:frameShellWeldType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nb3c9a7c28c0d440cae0d41623f3b4983b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/attachmentRecord> ;
            sh:resultMessage "The frame shall be attached to the shell by a double continuous weld." ;
            sh:resultPath nltl:frameShellWeldType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb3c9a7c28c0d440cae0d41623f3b4983b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:shellPlateButtCrossing ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Scalloping is not allowed unless the frame crosses a shell plate butt.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:scallopingPresent ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:shellPlateButtCrossing ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-050-FrameAttachmentRecordShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ;
            sh:resultMessage "Shell plate butt crossing applicability must be recorded." ;
            sh:resultPath nltl:shellPlateButtCrossing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Shell plate butt crossing applicability must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:shellPlateButtCrossing ] ] .

_:nb3c9a7c28c0d440cae0d41623f3b4983b2 sh:class nltl:weldTypeValue ;
    sh:hasValue nltl:doubleContinuousWeld ;
    sh:maxCount 1 ;
    sh:message "The frame shall be attached to the shell by a double continuous weld." ;
    sh:minCount 1 ;
    sh:path nltl:frameShellWeldType .

