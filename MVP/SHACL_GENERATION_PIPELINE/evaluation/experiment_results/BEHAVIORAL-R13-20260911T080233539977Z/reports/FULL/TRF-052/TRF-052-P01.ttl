@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P01/frame> ;
            sh:resultMessage "The applicable antitripping spacing or support-region scope is missing or non-conforming." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The applicable antitripping spacing or support-region scope is missing or non-conforming." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this
WHERE {
    $this nltl:equivalentSupportStatusByDirectCalculation ?alternative ;
          nltl:frameAsymmetrical ?asymmetrical ;
          nltl:frameWebAngleToShell ?angleQuantity ;
          nltl:frameSpan ?spanQuantity ;
          nltl:iceClass ?ice .

    ?angleQuantity qudt:numericValue ?angle .
    ?spanQuantity qudt:numericValue ?span .

    FILTER(
        ?alternative != true &&
        (
            (
                (?asymmetrical = true || ?angle < 90) &&
                (
                    NOT EXISTS {
                        $this nltl:antitrippingSupportSpacing ?spacingQuantity .
                        ?spacingQuantity qudt:numericValue ?spacing .
                    }
                    ||
                    EXISTS {
                        $this nltl:antitrippingSupportSpacing ?spacingQuantity2 .
                        ?spacingQuantity2 qudt:numericValue ?spacing2 .
                        FILTER(?spacing2 > 1300)
                    }
                )
            )
            ||
            (
                ?span > 4 &&
                (
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:bowRegion }
                    ||
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion }
                    ||
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:sternRegion }
                    ||
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue }
                )
            )
            ||
            (
                ?span <= 4 &&
                ?ice = nltl:iceClassIaSuper &&
                (
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:bowRegion }
                    ||
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion }
                    ||
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:sternRegion }
                    ||
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue }
                )
            )
            ||
            (
                ?span <= 4 &&
                ?ice = nltl:iceClassIa &&
                (
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:bowRegion }
                    ||
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion }
                )
            )
            ||
            (
                ?span <= 4 &&
                (?ice = nltl:iceClassIb || ?ice = nltl:iceClassIc) &&
                NOT EXISTS {
                    $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                }
            )
        )
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF052FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P01/frame> ] .

