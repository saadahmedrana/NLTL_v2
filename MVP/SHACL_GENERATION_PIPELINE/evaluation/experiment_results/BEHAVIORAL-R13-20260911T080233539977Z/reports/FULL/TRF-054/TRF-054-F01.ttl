@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F01/iceStringer> ;
            sh:resultMessage "The ice stringer must support ice-strengthened frames." ;
            sh:resultPath nltl:supportsIceStrengthenedFrames ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n2af1c24ad09944d28214c058aa905904b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F01/iceStringer> ;
            sh:resultMessage "The ice stringer must be located outside the ice belt." ;
            sh:resultPath nltl:locatedOutsideIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n2af1c24ad09944d28214c058aa905904b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F01/iceStringer> ;
            sh:resultMessage "Less than 1 values on ex:iceStringer->nltl:distanceToAdjacentIceStringer" ;
            sh:resultPath nltl:distanceToAdjacentIceStringer ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:distanceToAdjacentIceStringer ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F01/iceStringer> ;
            sh:resultMessage "The ice stringer must support ice-strengthened frames." ;
            sh:resultPath nltl:supportsIceStrengthenedFrames ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n2af1c24ad09944d28214c058aa905904b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F01/iceStringer> ;
            sh:resultMessage "The ice stringer must be located outside the ice belt." ;
            sh:resultPath nltl:locatedOutsideIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n2af1c24ad09944d28214c058aa905904b1 ] .

_:n2af1c24ad09944d28214c058aa905904b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice stringer must be located outside the ice belt." ;
    sh:minCount 1 ;
    sh:path nltl:locatedOutsideIceBelt .

_:n2af1c24ad09944d28214c058aa905904b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ice stringer must support ice-strengthened frames." ;
    sh:minCount 1 ;
    sh:path nltl:supportsIceStrengthenedFrames .

