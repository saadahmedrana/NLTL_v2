@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-P01/webFrame> ;
            sh:resultMessage "supportedStringerOutsideIceBelt must be explicitly provided as true or false." ;
            sh:resultPath nltl:supportedStringerOutsideIceBelt ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "supportedStringerOutsideIceBelt must be explicitly provided as true or false." ;
                    sh:minCount 1 ;
                    sh:path nltl:supportedStringerOutsideIceBelt ] ] .

