@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ;
            sh:resultMessage "requiredShearArea must equal sqrt(3)*alpha*1.1*maximumCalculatedShearForce/sigma_y*10^4, with kN converted to MN, and alpha must match the Table 4-8 value for freeFlangeToWebAreaRatio within a relative tolerance of 1e-6 plus an absolute fallback of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "requiredShearArea must equal sqrt(3)*alpha*1.1*maximumCalculatedShearForce/sigma_y*10^4, with kN converted to MN, and alpha must match the Table 4-8 value for freeFlangeToWebAreaRatio within a relative tolerance of 1e-6 plus an absolute fallback of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce/qudt:numericValue ?q ;
                      nltl:webFrameShearFactorAlpha/qudt:numericValue ?alpha ;
                      nltl:yieldStrength/qudt:numericValue ?sigma ;
                      nltl:freeFlangeToWebAreaRatio/qudt:numericValue ?ratio ;
                      nltl:requiredShearArea/qudt:numericValue ?reported .

                BIND (1.7320508075688772 * ?alpha * 1.1 * (?q / 1000) / ?sigma * 10000 AS ?expected)
                BIND (?expected * 0.000001 + 0.000000001 AS ?tolerance)

                FILTER (
                    !(
                        (?ratio = 0.0 && ?alpha = 1.5) ||
                        (?ratio = 0.2 && ?alpha = 1.23) ||
                        (?ratio = 0.4 && ?alpha = 1.16) ||
                        (?ratio = 0.6 && ?alpha = 1.11) ||
                        (?ratio = 0.8 && ?alpha = 1.09) ||
                        (?ratio = 1.0 && ?alpha = 1.07) ||
                        (?ratio = 1.2 && ?alpha = 1.06) ||
                        (?ratio = 1.4 && ?alpha = 1.05) ||
                        (?ratio = 1.6 && ?alpha = 1.05) ||
                        (?ratio = 1.8 && ?alpha = 1.04) ||
                        (?ratio = 2.0 && ?alpha = 1.04)
                    )
                    ||
                    ?reported > (?expected + ?tolerance)
                    ||
                    ?reported < (?expected - ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-059-WebFrameShearAreaShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ] .

