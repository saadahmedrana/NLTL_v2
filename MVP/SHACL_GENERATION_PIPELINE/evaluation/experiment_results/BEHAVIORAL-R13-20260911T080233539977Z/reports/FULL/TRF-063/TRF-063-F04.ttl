@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F04/ship> ;
            sh:resultMessage "Twin- and triple-screw ships shall have the required side-propeller strengthening envelope; other ships are not subject to this conditional envelope constraint." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF063ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F04/ship> ] .

