@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/shafting> ;
                    sh:resultMessage "Each side-propeller shafting assembly shall be enclosed within a plated bossing." ;
                    sh:resultPath nltl:enclosedByPlatedBossing ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:platedBossingStructure ;
                            sh:message "Each side-propeller shafting assembly shall be enclosed within a plated bossing." ;
                            sh:minCount 1 ;
                            sh:path nltl:enclosedByPlatedBossing ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF-064-SideShaftingShape>. See details for more information." ;
            sh:resultPath nltl:hasSidePropellerShafting ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:TRF-064-SideShaftingShape> ;
                    sh:path nltl:hasSidePropellerShafting ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F01/shafting> ] .

