@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-F01/ship> ;
            sh:resultMessage "For ice class IB or IC, when ballast-condition propeller top depth is below hi, the propulsion system shall be designed for ice class IA." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For ice class IB or IC, when ballast-condition propeller top depth is below hi, the propulsion system shall be designed for ice class IA." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass = nltl:iceClassIb ||
                    ?iceClass = nltl:iceClassIc
                )

                $this nltl:ballastConditionPropellerTopDepth ?depthNode .
                ?depthNode qudt:numericValue ?depth .

                $this nltl:requiredPropellerSubmersionDepthHi ?hiNode .
                ?hiNode qudt:numericValue ?hi .

                FILTER (?depth < ?hi)

                FILTER NOT EXISTS {
                    $this nltl:propulsionSystemDesignedForIceClass
                        nltl:iceClassIa
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlgen:TRF074Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-F01/ship> ] .

