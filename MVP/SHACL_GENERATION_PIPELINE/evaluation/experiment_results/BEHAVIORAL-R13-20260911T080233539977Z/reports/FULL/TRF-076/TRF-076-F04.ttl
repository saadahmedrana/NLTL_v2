@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F04/ship> ;
            sh:resultMessage "The ship must identify a CP or FP propeller and cover the required propeller blade load cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF076PropellerBladeLoadCaseShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F04/ship> ] .

