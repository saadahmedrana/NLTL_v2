@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-077-P02/ship> ;
            sh:resultMessage "The ship must provide the ice load cycle count for the spectrum." ;
            sh:resultPath nltl:iceLoadCycleCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:message "The ship must provide the ice load cycle count for the spectrum." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceLoadCycleCount ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-077-P02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:string ; sh:hasValue Literal(\"open\") ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propellerType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:node <urn:nltl:generated-shape:TRF-077-ShapeParameterQuantityShape> ; sh:property [ sh:maxInclusive Literal(\"0.75\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"0.75\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:loadSpectrumShapeParameter ] ] , [ sh:property [ sh:datatype xsd:string ; sh:hasValue Literal(\"ducted\") ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propellerType ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:node <urn:nltl:generated-shape:TRF-077-ShapeParameterQuantityShape> ; sh:property [ sh:maxInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:loadSpectrumShapeParameter ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-077-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-077-P02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-077-P02/ship> ;
            sh:resultMessage "The ship must provide the blade ice load in kilonewtons." ;
            sh:resultPath nltl:bladeIceLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the blade ice load in kilonewtons." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-077-ForceQuantityShape> ;
                    sh:path nltl:bladeIceLoad ] ] .

