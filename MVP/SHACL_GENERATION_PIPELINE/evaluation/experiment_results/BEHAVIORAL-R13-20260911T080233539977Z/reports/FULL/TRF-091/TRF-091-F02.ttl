@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/milling> ;
            sh:resultMessage "Each propulsion strength-evaluation load case must be the ice-milling load sequence case." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each propulsion strength-evaluation load case must be the ice-milling load sequence case." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasPropulsionLoadCase ?propulsionCase .
                FILTER NOT EXISTS {
                    $this nltl:hasIceMillingSequenceCase ?propulsionCase .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF091ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/milling> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/milling> ;
            sh:resultMessage "The ship must identify the ice-milling load sequence case." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceMillingSequenceCase ;
                    sh:message "The ship must identify the ice-milling load sequence case." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceMillingSequenceCase ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ;
                    sh:resultMessage "The propulsion load case must be used for propulsion-line strength evaluation." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:ne298c7b5a2e64957876d08e36e032853b4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ;
                    sh:resultMessage "The propulsion load case must be used for propulsion-line strength evaluation." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:ne298c7b5a2e64957876d08e36e032853b4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/milling> ;
            sh:resultMessage "The ship must identify the propulsion load case used for the strength evaluation." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:ne298c7b5a2e64957876d08e36e032853b2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/loadCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F02/ship> ;
            sh:resultMessage "The ship must identify the propulsion load case used for the strength evaluation." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ne298c7b5a2e64957876d08e36e032853b2 ] .

_:ne298c7b5a2e64957876d08e36e032853b2 sh:class nltl:loadCase ;
    sh:message "The ship must identify the propulsion load case used for the strength evaluation." ;
    sh:minCount 1 ;
    sh:node gen:TRF091PropulsionLoadCaseShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasPropulsionLoadCase .

_:ne298c7b5a2e64957876d08e36e032853b4 sh:class nltl:loadCasePurposeValue ;
    sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
    sh:message "The propulsion load case must be used for propulsion-line strength evaluation." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:loadCasePurpose .

