@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:approvalRecord ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:approvedNonlinearBladeStressAnalysis ] ] , [ sh:sparql [ sh:message Literal("Blade reference strength and ultimate load must satisfy the declared direct calculation within a relative tolerance of 1e-6 plus a small absolute fallback.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:bladeMinimumYieldStrength ?yieldNode ;
                              nltl:bladeUltimateTensileStrength ?ultimateNode ;
                              nltl:bladeReferenceStrength1 ?referenceNode ;
                              nltl:bladeChordLengthAtWeakestSection ?chordNode ;
                              nltl:bladeMaximumThicknessAtWeakestSection ?thicknessNode ;
                              nltl:bladeCylindricalRootRadius ?rootNode ;
                              nltl:propellerDiameter ?diameterNode ;
                              nltl:bladeFailureUltimateLoad ?loadNode .
                        ?yieldNode qudt:numericValue ?yield .
                        ?ultimateNode qudt:numericValue ?ultimate .
                        ?referenceNode qudt:numericValue ?reference .
                        ?chordNode qudt:numericValue ?chord .
                        ?thicknessNode qudt:numericValue ?thickness .
                        ?rootNode qudt:numericValue ?root .
                        ?diameterNode qudt:numericValue ?diameter .
                        ?loadNode qudt:numericValue ?load .
                        BIND ((0.6 * ?yield) + (0.4 * ?ultimate) AS ?referenceExpected)
                        BIND ((300 * ?chord * ?thickness * ?thickness * ?referenceExpected) /
                              ((0.8 * ?diameter) - (2 * ?root)) AS ?loadExpected)
                        FILTER (
                            ?reference > (?referenceExpected + (0.000001 * ?referenceExpected) + 0.000001) ||
                            ?reference < (?referenceExpected - (0.000001 * ?referenceExpected) - 0.000001) ||
                            ?load > (?loadExpected + (0.000001 * ?loadExpected) + 0.000001) ||
                            ?load < (?loadExpected - (0.000001 * ?loadExpected) - 0.000001)
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF101Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasLoadCase" ;
            sh:resultPath nltl:hasLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:BladeFailureLoadCaseShape ;
                    sh:path nltl:hasLoadCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bladeFailureStatus" ;
            sh:resultPath nltl:bladeFailureStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:bladeFailureStatus ] ] .

