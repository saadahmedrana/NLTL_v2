@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-103-P01/bladeFailureSpindleTorqueFactorValue> ;
                    sh:resultMessage "The blade failure spindle torque factor shall be at least 0.3." ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The blade failure spindle torque factor shall be at least 0.3." ;
                            sh:minCount 1 ;
                            sh:minInclusive "0.3" ;
                            sh:path qudt:numericValue ] ;
                    sh:value 0.3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-103-P01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The blade failure spindle torque factor shall be at least 0.3.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"0.3\") ; sh:path qudt:numericValue ] ]. See details for more information." ;
            sh:resultPath nltl:bladeFailureSpindleTorqueFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "The blade failure spindle torque factor shall be at least 0.3." ;
                                    sh:minCount 1 ;
                                    sh:minInclusive "0.3" ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:bladeFailureSpindleTorqueFactor ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-103-P01/bladeFailureSpindleTorqueFactorValue> ] .

