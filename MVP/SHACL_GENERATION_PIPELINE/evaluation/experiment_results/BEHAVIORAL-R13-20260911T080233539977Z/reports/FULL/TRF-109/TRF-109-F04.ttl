@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F04/lookup> ;
                    sh:resultMessage "propellerType must be exactly open or ducted." ;
                    sh:resultPath nltl:propellerType ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:string ;
                            sh:in ( "open" "ducted" ) ;
                            sh:maxCount 1 ;
                            sh:message "propellerType must be exactly open or ducted." ;
                            sh:minCount 1 ;
                            sh:path nltl:propellerType ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F04/lookup> ;
                    sh:resultMessage "The Table 6-14 coefficient row must match the declared propeller type." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gs:TRF109TableLookupCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F04/lookup> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F04/ship> ;
            sh:resultMessage "The ship must provide a Table 6-14 lookup case." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a Table 6-14 lookup case." ;
                    sh:minCount 1 ;
                    sh:node gs:TRF109TableLookupCaseShape ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F04/lookup> ] .

