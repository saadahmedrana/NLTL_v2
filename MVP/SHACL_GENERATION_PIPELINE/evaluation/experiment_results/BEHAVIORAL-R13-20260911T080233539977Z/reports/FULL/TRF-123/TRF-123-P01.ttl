@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-P01/ship> ;
            sh:resultMessage "Each assessed occasional-force component must have stress multiplied by the declared safety factor no greater than its material yield strength." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each assessed occasional-force component must have stress multiplied by the declared safety factor no greater than its material yield strength." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasOccasionalForceLoadCase ?loadCase .
                    ?loadCase nltl:occasionalForceCaseAssessedComponent ?component .
                    ?component nltl:hasMaterialProperties ?materialProperties .
                    ?component nltl:occasionalForceComponentStress ?stressQuantity .
                    ?stressQuantity qudt:numericValue ?stress ;
                                    qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                    ?materialProperties nltl:componentMaterialYieldStrength ?yieldQuantity .
                    ?yieldQuantity qudt:numericValue ?yield ;
                                   qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                    ?loadCase nltl:componentYieldSafetyFactor ?factorQuantity .
                    ?factorQuantity qudt:numericValue ?factor ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    FILTER ( ! ( ?stress * ?factor <= ?yield ) )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-123-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-P01/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-P01/loadCase> ;
                    sh:resultMessage "Less than 1 values on ex:loadCase->nltl:componentYieldSafetyFactor" ;
                    sh:resultPath nltl:componentYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:componentYieldSafetyFactor ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-P01/component> ;
                            sh:resultMessage "Less than 1 values on ex:component->nltl:occasionalForceComponentStress" ;
                            sh:resultPath nltl:occasionalForceComponentStress ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:occasionalForceComponentStress ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-P01/loadCase> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:class nltl:materialProperties ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentMaterialYieldStrength ] ] ; sh:path nltl:hasMaterialProperties ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:occasionalForceComponentStress ] ]. See details for more information." ;
                    sh:resultPath nltl:occasionalForceCaseAssessedComponent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:shipComponent ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:class nltl:materialProperties ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:node [ ] ;
                                                            sh:path nltl:componentMaterialYieldStrength ] ] ;
                                            sh:path nltl:hasMaterialProperties ],
                                        [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ],
                                                        [ sh:datatype xsd:decimal ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:occasionalForceComponentStress ] ] ;
                            sh:path nltl:occasionalForceCaseAssessedComponent ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-P01/component> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-P01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:class nltl:shipComponent ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:materialProperties ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentMaterialYieldStrength ] ] ; sh:path nltl:hasMaterialProperties ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:occasionalForceComponentStress ] ] ; sh:path nltl:occasionalForceCaseAssessedComponent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The occasional-force load case must identify that propeller blades are excluded.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:componentYieldSafetyFactor ] ]. See details for more information." ;
            sh:resultPath nltl:hasOccasionalForceLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:occasionalForceLoadCase ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:class nltl:shipComponent ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:occasionalForceComponentStress ],
                                                [ sh:class nltl:materialProperties ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:hasMaterialProperties ] ] ;
                                    sh:path nltl:occasionalForceCaseAssessedComponent ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:componentYieldSafetyFactor ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:message "The occasional-force load case must identify that propeller blades are excluded." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ] ] ;
                    sh:path nltl:hasOccasionalForceLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-P01/loadCase> ] .

