@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F02/ship> ;
            sh:resultMessage "The compressor must charge the air receivers within 0.5 hours for an IA Super ship requiring propulsion-engine reversal for astern, and within 1 hour otherwise." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-128_CompressorChargeTimeShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F02/ship> ] .

