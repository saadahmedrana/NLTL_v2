@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-001-F03/ship> ;
            sh:resultMessage "A ship must record exactly one UR I2 Rev.4 applicability value." ;
            sh:resultPath nltl:urI2RevisionApplicability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "A ship must record exactly one UR I2 Rev.4 applicability value." ;
                    sh:minCount 1 ;
                    sh:path nltl:urI2RevisionApplicability ] ] .

