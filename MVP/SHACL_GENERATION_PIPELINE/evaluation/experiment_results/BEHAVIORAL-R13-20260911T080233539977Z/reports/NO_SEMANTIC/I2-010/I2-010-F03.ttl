@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F03/ship> ;
            sh:resultMessage "The ship must identify whether the PC6/PC7 vertical-sided-bow design-force rule applies and, when applicable, provide the required angle and calculation-method information." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:I2_010_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F03/ship> ] .

