@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-013-F02/ship> ;
            sh:resultMessage "Evidence that resulting inertial loads were considered in design is required." ;
            sh:resultPath nltl:inertialLoadDesignConsiderationEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                    sh:message "Evidence that resulting inertial loads were considered in design is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:inertialLoadDesignConsiderationEvidence ] ] .

