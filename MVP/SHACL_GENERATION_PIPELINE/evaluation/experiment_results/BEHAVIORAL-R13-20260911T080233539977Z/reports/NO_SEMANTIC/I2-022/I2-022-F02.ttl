@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F02/ship> ;
            sh:resultMessage "The ship shall provide exactly one yield strength in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide exactly one yield strength in MPa." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_022_PressureQuantityShape ;
                    sh:path nltl:yieldStrength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F02/ship> ;
            sh:resultMessage "The ship shall provide exactly one average ice pressure in MPa." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide exactly one average ice pressure in MPa." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_022_PressureQuantityShape ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F02/ship> ;
            sh:resultMessage "The ship shall provide exactly one load patch height in metres." ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide exactly one load patch height in metres." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_022_LengthQuantityShape ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F02/ship> ;
            sh:resultMessage "The ship shall provide exactly one peak pressure factor." ;
            sh:resultPath nltl:peakPressureFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide exactly one peak pressure factor." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_022_DimensionlessQuantityShape ;
                    sh:path nltl:peakPressureFactor ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F02/plating> ;
                    sh:resultMessage "Node ex:plating must conform to one or more shapes in [ sh:property [ sh:in ( nltl:bowIntermediateBottomHullArea nltl:midbodyBottomHullArea nltl:sternBottomHullArea ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:platingHullAreaClassification ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Applicable plating shall provide the externally calculated net plate thickness in millimetres.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_022_LengthMillimetreQuantityShape ; sh:path nltl:iceLoadRequiredNetPlateThickness ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_022_ApplicableAngleQuantityShape ; sh:path nltl:framingAngleOmega ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:structuralMember ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_022_DimensionlessQuantityShape ; sh:path nltl:selectedHullAreaFactor ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_022_LengthQuantityShape ; sh:path nltl:frameSpacing ] ] ; sh:path nltl:platingSupportedByStructuralMember ] ] , [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_022_NonApplicableAngleQuantityShape ; sh:path nltl:framingAngleOmega ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:plating ;
                            sh:or ( [ sh:property [ sh:minCount 1 ;
                                                sh:node [ sh:class nltl:structuralMember ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:platingSupportedByStructuralMember ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node gen:I2_022_ApplicableAngleQuantityShape ;
                                                sh:path nltl:framingAngleOmega ],
                                            [ sh:in ( nltl:bowIntermediateBottomHullArea nltl:midbodyBottomHullArea nltl:sternBottomHullArea ) ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:platingHullAreaClassification ],
                                            [ sh:maxCount 1 ;
                                                sh:message "Applicable plating shall provide the externally calculated net plate thickness in millimetres." ;
                                                sh:minCount 1 ;
                                                sh:node gen:I2_022_LengthMillimetreQuantityShape ;
                                                sh:path nltl:iceLoadRequiredNetPlateThickness ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node gen:I2_022_NonApplicableAngleQuantityShape ;
                                                sh:path nltl:framingAngleOmega ] ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F02/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:plating ; sh:or ( [ sh:property [ sh:in ( nltl:bowIntermediateBottomHullArea nltl:midbodyBottomHullArea nltl:sternBottomHullArea ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:platingHullAreaClassification ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Applicable plating shall provide the externally calculated net plate thickness in millimetres.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_022_LengthMillimetreQuantityShape ; sh:path nltl:iceLoadRequiredNetPlateThickness ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_022_ApplicableAngleQuantityShape ; sh:path nltl:framingAngleOmega ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:structuralMember ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_022_DimensionlessQuantityShape ; sh:path nltl:selectedHullAreaFactor ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_022_LengthQuantityShape ; sh:path nltl:frameSpacing ] ] ; sh:path nltl:platingSupportedByStructuralMember ] ] [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_022_NonApplicableAngleQuantityShape ; sh:path nltl:framingAngleOmega ] ] ) ]. See details for more information." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:plating ;
                            sh:or ( [ sh:property [ sh:maxCount 1 ;
                                                sh:message "Applicable plating shall provide the externally calculated net plate thickness in millimetres." ;
                                                sh:minCount 1 ;
                                                sh:node gen:I2_022_LengthMillimetreQuantityShape ;
                                                sh:path nltl:iceLoadRequiredNetPlateThickness ],
                                            [ sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:platingSupportedByStructuralMember ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node gen:I2_022_ApplicableAngleQuantityShape ;
                                                sh:path nltl:framingAngleOmega ],
                                            [ sh:in [ ] ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:platingHullAreaClassification ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node gen:I2_022_NonApplicableAngleQuantityShape ;
                                                sh:path nltl:framingAngleOmega ] ] ) ] ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F02/plating> ] .

