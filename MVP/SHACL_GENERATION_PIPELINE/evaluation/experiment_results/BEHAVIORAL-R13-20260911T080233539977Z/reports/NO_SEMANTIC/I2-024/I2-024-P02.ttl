@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/ship> ;
            sh:resultMessage "A calculation case with longitudinal and transverse framing net plate thickness inputs is required for the external interpolation calculation." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A calculation case with longitudinal and transverse framing net plate thickness inputs is required for the external interpolation calculation." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue qudt:MilliM ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:longitudinalFramingNetPlateThickness ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue qudt:MilliM ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:transverseFramingNetPlateThickness ] ] ;
                    sh:path nltl:hasCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/interpolatedThickness> ;
                            sh:resultMessage "Node ex:interpolatedThickness->qudt:unit does not contain a value in the set: ['qudt:MilliM']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:MilliM ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/case> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:MilliM ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
                    sh:resultPath nltl:interpolatedNetPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue qudt:MilliM ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:interpolatedNetPlateThickness ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/interpolatedThickness> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/lowerCoordinate> ;
                                    sh:resultMessage "Node ex:lowerCoordinate->qudt:unit does not contain a value in the set: ['qudt:UNITLESS']" ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/lowerEndpoint> ;
                            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue qudt:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:interpolationPointCoordinate ] ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/lowerCoordinate> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/case> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:interpolationPoint ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:interpolationPointResult ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:interpolationPointCoordinate ] ]. See details for more information." ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:interpolationPoint ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:interpolationPointResult ],
                                        [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ],
                                                        [ sh:hasValue qudt:UNITLESS ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ] ] ;
                                            sh:path nltl:interpolationPointCoordinate ] ] ;
                            sh:path nltl:interpolationLowerEndpoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/lowerEndpoint> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/framingAngle> ;
                            sh:resultMessage "Node ex:framingAngle->qudt:unit does not contain a value in the set: ['qudt:DEG']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:DEG ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/case> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:DEG ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
                    sh:resultPath nltl:framingAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue qudt:DEG ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:framingAngle ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/framingAngle> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/upperCoordinate> ;
                                    sh:resultMessage "Node ex:upperCoordinate->qudt:unit does not contain a value in the set: ['qudt:UNITLESS']" ;
                                    sh:resultPath qudt:unit ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/upperEndpoint> ;
                            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue qudt:UNITLESS ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:interpolationPointCoordinate ] ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/upperCoordinate> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/case> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:interpolationPoint ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:interpolationPointResult ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:interpolationPointCoordinate ] ]. See details for more information." ;
                    sh:resultPath nltl:interpolationUpperEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:interpolationPoint ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ],
                                                        [ sh:hasValue qudt:UNITLESS ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ] ] ;
                                            sh:path nltl:interpolationPointCoordinate ],
                                        [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:interpolationPointResult ] ] ;
                            sh:path nltl:interpolationUpperEndpoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/upperEndpoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P02/ship> ;
            sh:resultMessage "An oblique-plating interpolation case must provide the framing angle, externally computed interpolated thickness, and both interpolation endpoints with their coordinates and results." ;
            sh:resultPath nltl:hasObliquePlatingInterpolationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "An oblique-plating interpolation case must provide the framing angle, externally computed interpolated thickness, and both interpolation endpoints with their coordinates and results." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:obliquePlatingInterpolationCase ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue qudt:DEG ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:framingAngle ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ] ] ;
                                    sh:path nltl:interpolationLowerEndpoint ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ] ] ;
                                    sh:path nltl:interpolationUpperEndpoint ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
