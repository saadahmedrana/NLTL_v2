@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-P02/ship> ;
            sh:resultMessage "Each represented load case for a longitudinal frame in a side structure must provide valid combined shear-and-bending demand, plastic strength, and midspan plastic collapse load quantities with the required kN units for the latter two quantities." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each represented load case for a longitudinal frame in a side structure must provide valid combined shear-and-bending demand, plastic strength, and midspan plastic collapse load quantities with the required kN units for the latter two quantities." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:longitudinalFrameOrientation true ;
                        nltl:structuralLocation nltl:sideStructureLocation ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .

                FILTER (
                    NOT EXISTS {
                        ?loadCase nltl:combinedShearAndBendingDemand ?demandQuantity .
                    }
                    ||
                    EXISTS {
                        ?loadCase nltl:combinedShearAndBendingDemand ?demandQuantity .
                        FILTER NOT EXISTS {
                            ?demandQuantity qudt:numericValue ?demandValue .
                            FILTER (datatype(?demandValue) = xsd:decimal)
                        }
                    }
                    ||
                    NOT EXISTS {
                        ?member nltl:plasticStrength ?strengthQuantity .
                    }
                    ||
                    EXISTS {
                        ?member nltl:plasticStrength ?strengthQuantity .
                        FILTER NOT EXISTS {
                            ?strengthQuantity qudt:numericValue ?strengthValue ;
                                               qudt:unit qudt:KiloN .
                            FILTER (datatype(?strengthValue) = xsd:decimal)
                        }
                    }
                    ||
                    NOT EXISTS {
                        ?member nltl:midspanPlasticCollapseLoad ?collapseQuantity .
                    }
                    ||
                    EXISTS {
                        ?member nltl:midspanPlasticCollapseLoad ?collapseQuantity .
                        FILTER NOT EXISTS {
                            ?collapseQuantity qudt:numericValue ?collapseValue ;
                                               qudt:unit qudt:KiloN .
                            FILTER (datatype(?collapseValue) = xsd:decimal)
                        }
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-034-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-P02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-P02/ship> ;
            sh:resultMessage "A frame profile type relationship is required for the represented ship." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameProfileTypeValue ;
                    sh:message "A frame profile type relationship is required for the represented ship." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ] .

