@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F01/member> ;
                    sh:resultMessage "The structural member shall identify whether it is a flat-bar, bulb, tee, or angle section." ;
                    sh:resultPath nltl:structuralSectionType ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The structural member shall identify whether it is a flat-bar, bulb, tee, or angle section." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:structuralSectionTypeValue ;
                                    sh:in ( nltl:flatBarStructuralSection nltl:bulbSection nltl:teeSection nltl:angleSection ) ] ;
                            sh:path nltl:structuralSectionType ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:class nltl:structuralMember ; sh:property [ sh:message Literal(\"The structural member shall identify whether it is a flat-bar, bulb, tee, or angle section.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:structuralSectionTypeValue ; sh:in ( nltl:flatBarStructuralSection nltl:bulbSection nltl:teeSection nltl:angleSection ) ] ; sh:path nltl:structuralSectionType ], [ sh:message Literal(\"The structural member shall provide net web thickness as a decimal quantity in mm.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:netWebThickness ], [ sh:message Literal(\"The structural member shall provide web height as a decimal quantity in mm.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:webHeight ] ]. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ a sh:NodeShape ;
                            sh:class nltl:structuralMember ;
                            sh:property [ sh:message "The structural member shall provide web height as a decimal quantity in mm." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:webHeight ],
                                [ sh:message "The structural member shall identify whether it is a flat-bar, bulb, tee, or angle section." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:structuralSectionTypeValue ;
                                            sh:in ( nltl:flatBarStructuralSection nltl:bulbSection nltl:teeSection nltl:angleSection ) ] ;
                                    sh:path nltl:structuralSectionType ],
                                [ sh:message "The structural member shall provide net web thickness as a decimal quantity in mm." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:netWebThickness ] ] ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F01/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F01/ship> ;
            sh:resultMessage "The ship shall provide yield strength as a decimal quantity in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide yield strength as a decimal quantity in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:yieldStrength ] ] .

