@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F01/member> ;
                    sh:resultMessage "Each structural member shall provide one net flange thickness." ;
                    sh:resultPath nltl:netFlangeThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each structural member shall provide one net flange thickness." ;
                            sh:minCount 1 ;
                            sh:node gen:LengthQuantityShape ;
                            sh:path nltl:netFlangeThickness ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F01/ship> ;
            sh:resultMessage "The ship shall identify structural members with the required readiness inputs and externally computed result." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify structural members with the required readiness inputs and externally computed result." ;
                    sh:minCount 1 ;
                    sh:node gen:StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F01/member> ] .

