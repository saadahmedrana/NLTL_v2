@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/weld2> ;
                    sh:resultMessage "Node ex:weld2 must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ], [ sh:hasValue nltl:doubleContinuousWeld ; sh:message Literal(\"A weld within an ice-strengthened area must be of the double continuous type.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:weldType ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:withinIceStrengthenedArea ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:I2_066_WeldScopeShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/weld2> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/ship> ;
            sh:resultMessage "Each linked weld must provide its ice-strengthened-area scope and satisfy the applicable weld-type requirement." ;
            sh:resultPath nltl:hasWeld ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:weld ;
                    sh:message "Each linked weld must provide its ice-strengthened-area scope and satisfy the applicable weld-type requirement." ;
                    sh:node gen:I2_066_WeldScopeShape ;
                    sh:path nltl:hasWeld ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F04/weld2> ] .

