@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F03/connection1> ;
                    sh:resultMessage "Each structural connection must have strength continuity ensured." ;
                    sh:resultPath nltl:strengthContinuityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n46fbcc8e21c541b8a804ebdafefa13e2b2 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F03/connection1> ;
                    sh:resultMessage "Each structural connection must have strength continuity ensured." ;
                    sh:resultPath nltl:strengthContinuityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n46fbcc8e21c541b8a804ebdafefa13e2b2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-067-StructuralConnectionShape>. See details for more information." ;
            sh:resultPath nltl:structuralConnection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-067-StructuralConnectionShape> ;
                    sh:path nltl:structuralConnection ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F03/connection1> ] .

_:n46fbcc8e21c541b8a804ebdafefa13e2b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "Each structural connection must have strength continuity ensured." ;
    sh:minCount 1 ;
    sh:path nltl:strengthContinuityStatus .

