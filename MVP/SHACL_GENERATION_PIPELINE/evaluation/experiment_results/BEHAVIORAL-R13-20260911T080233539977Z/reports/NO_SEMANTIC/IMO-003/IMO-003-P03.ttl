@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-P03/ship> ;
            sh:resultMessage "When a ship is designed for open water or ice conditions less severe than categories A and B, its ship category must be Category C." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO003ShipDesignIceCategoryShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-P03/ship> ] .

