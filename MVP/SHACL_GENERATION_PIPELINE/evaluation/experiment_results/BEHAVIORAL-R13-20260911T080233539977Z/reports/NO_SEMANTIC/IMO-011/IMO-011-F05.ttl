@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:decimal ; sh:minInclusive Literal(\"10\", datatype=xsd:integer) ; sh:path ( nltl:dataPeriod qudt:numericValue ) ] ] , [ sh:property [ sh:datatype xsd:decimal ; sh:maxExclusive Literal(\"10\", datatype=xsd:integer) ; sh:path ( nltl:dataPeriod qudt:numericValue ) ], [ sh:hasValue nltl:evidenceStateApproved ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When the data period is shorter than 10 years, the dataset approval status must be Approved.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:administrationDatasetApprovalStatus ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:IMO_011_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F05/ship> ] .

