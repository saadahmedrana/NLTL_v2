@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F07/ship> ;
            sh:resultMessage "The ship must provide dated daily low-temperature observations." ;
            sh:resultPath nltl:hasDailyLowTemperatureObservation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:dailyLowTemperatureObservation ;
                    sh:message "The ship must provide dated daily low-temperature observations." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:dailyLowTemperatureObservation ;
                            sh:property [ sh:datatype xsd:date ;
                                    sh:maxCount 1 ;
                                    sh:message "Each daily low-temperature observation must have exactly one calendar date." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:dailyTemperatureObservationDate ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each daily low-temperature observation must carry one daily low temperature in degrees Celsius." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:dailyLowTemperature ] ] ;
                    sh:path nltl:hasDailyLowTemperatureObservation ] ] .

