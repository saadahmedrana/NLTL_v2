@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-012-F01/ship> ;
            sh:resultMessage "Polar service temperature must be at least 10 degrees Celsius below the lowest MDLT." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Polar service temperature must be at least 10 degrees Celsius below the lowest MDLT." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:lowestMdlt ?mdltQuantity ;
                      nltl:polarServiceTemperature ?pstQuantity .
                ?mdltQuantity qudt:numericValue ?mdlt .
                ?pstQuantity qudt:numericValue ?pst .
                FILTER (?pst > (?mdlt - 10))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-012> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-012-F01/ship> ] .

