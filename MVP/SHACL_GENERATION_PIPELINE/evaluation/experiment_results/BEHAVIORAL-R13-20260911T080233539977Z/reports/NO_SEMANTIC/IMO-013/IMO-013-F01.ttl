@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-013-F01/ship> ;
            sh:resultMessage "The ship's low-air-temperature classification must be true when lowest MDLT is below -10 deg C and false otherwise." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO_013_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-013-F01/ship> ] .

