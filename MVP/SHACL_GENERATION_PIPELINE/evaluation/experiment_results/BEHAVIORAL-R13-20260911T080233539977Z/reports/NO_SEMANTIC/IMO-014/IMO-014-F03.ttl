@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-014-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"A valid Polar Ship Certificate must be present when the Polar Code applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarShipCertificatePresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The Polar Ship Certificate status must be valid when the Polar Code applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarShipCertificateStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When the Polar Code applies, polarCodeApplies must be true.\") ; sh:path nltl:polarCodeApplies ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"polarCodeApplies must be false when the Polar Code does not apply.\") ; sh:path nltl:polarCodeApplies ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO014Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-014-F03/ship> ] .

