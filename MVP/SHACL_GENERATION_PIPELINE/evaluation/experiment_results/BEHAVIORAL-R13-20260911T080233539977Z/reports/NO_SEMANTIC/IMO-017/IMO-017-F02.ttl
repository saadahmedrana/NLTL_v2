@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/solasSchedule> ;
            sh:resultMessage "The SOLAS certificate schedule shall contain certificate schedule date records." ;
            sh:resultPath nltl:hasCertificateScheduleDateRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:certificateScheduleDateRecord ;
                    sh:message "The SOLAS certificate schedule shall contain certificate schedule date records." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasCertificateScheduleDateRecord ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ;
            sh:resultMessage "The ship shall have the applicable SOLAS certificate schedule." ;
            sh:resultPath nltl:hasSolasCertificateSchedule ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:solasCertificateSchedule ;
                    sh:message "The ship shall have the applicable SOLAS certificate schedule." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasSolasCertificateSchedule ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ;
            sh:resultMessage "Polar Ship Certificate validity, survey, and endorsement dates shall match the corresponding SOLAS certificate schedule dates." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Polar Ship Certificate validity, survey, and endorsement dates shall match the corresponding SOLAS certificate schedule dates." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    $this nltl:polarCertificateValidityDates ?date .
                    FILTER (datatype(?date) = xsd:date)
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDateType nltl:validityDateCategory ;
                                nltl:certificateScheduleDate ?scheduleDate .
                        FILTER (datatype(?scheduleDate) = xsd:date)
                        FILTER (?scheduleDate = ?date)
                    }
                }
                UNION
                {
                    $this nltl:surveyDates ?date .
                    FILTER (datatype(?date) = xsd:date)
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDateType nltl:surveyDateCategory ;
                                nltl:certificateScheduleDate ?scheduleDate .
                        FILTER (datatype(?scheduleDate) = xsd:date)
                        FILTER (?scheduleDate = ?date)
                    }
                }
                UNION
                {
                    $this nltl:endorsementDates ?date .
                    FILTER (datatype(?date) = xsd:date)
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDateType nltl:endorsementDateCategory ;
                                nltl:certificateScheduleDate ?scheduleDate .
                        FILTER (datatype(?scheduleDate) = xsd:date)
                        FILTER (?scheduleDate = ?date)
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_017_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ] .

