@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "The Polar Ship Certificate supplement shall be present." ;
            sh:resultPath nltl:polarCertificateSupplementPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n3d98d4743f1c403cb6273cc3fb1606eab4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "The Polar Ship Certificate shall include a supplement." ;
            sh:resultPath nltl:hasPolarCertificateSupplement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarCertificateSupplement ;
                    sh:message "The Polar Ship Certificate shall include a supplement." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasPolarCertificateSupplement ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/supplement> ;
            sh:resultMessage "The Polar Certificate supplement shall contain required equipment records." ;
            sh:resultPath nltl:hasRequiredEquipmentRecords ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:requiredEquipmentRecords ;
                    sh:message "The Polar Certificate supplement shall contain required equipment records." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasRequiredEquipmentRecords ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "The Polar Ship Certificate supplement shall be present." ;
            sh:resultPath nltl:polarCertificateSupplementPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n3d98d4743f1c403cb6273cc3fb1606eab4 ] .

_:n3d98d4743f1c403cb6273cc3fb1606eab4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The Polar Ship Certificate supplement shall be present." ;
    sh:minCount 1 ;
    sh:path nltl:polarCertificateSupplementPresent .

