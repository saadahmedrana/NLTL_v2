[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-023-F03/ship> ;
            sh:resultMessage "The ship shall record procedures for normal operations in its PWOM." ;
            sh:resultPath nltl:normalOperationProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n3d244729d9b14865812abf1b661a1923b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-023-F03/ship> ;
            sh:resultMessage "The ship shall record procedures for normal operations in its PWOM." ;
            sh:resultPath nltl:normalOperationProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
