@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-024-F01/ship> ;
            sh:resultMessage "The ship's PWOM must include or reference specific polar-water incident procedures." ;
            sh:resultPath nltl:polarIncidentProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:message "The ship's PWOM must include or reference specific polar-water incident procedures." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarIncidentProcedurePresent ] ] .

