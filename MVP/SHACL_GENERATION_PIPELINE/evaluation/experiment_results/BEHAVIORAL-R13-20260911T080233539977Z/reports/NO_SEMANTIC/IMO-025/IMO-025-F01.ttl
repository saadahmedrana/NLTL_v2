@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-025-F01/ship> ;
            sh:resultMessage "The ship shall have the Polar Water Operational Manual carried on board." ;
            sh:resultPath nltl:polarWaterOperationalManualPresentOnBoard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The ship shall have the Polar Water Operational Manual carried on board." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarWaterOperationalManualPresentOnBoard ] ] .

