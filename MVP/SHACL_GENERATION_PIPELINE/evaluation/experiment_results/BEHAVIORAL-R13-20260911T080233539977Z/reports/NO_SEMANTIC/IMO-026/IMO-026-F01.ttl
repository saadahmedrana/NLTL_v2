@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-026-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:iceCapabilityMethodologyApplicable ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When the ice capability methodology is applicable, the PWOM shall contain the ice capability methodology.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarWaterOperationalManualIceCapabilityMethodologyPresent ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:iceCapabilityMethodologyApplicable ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_026_IceCapabilityMethodologyConditional ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-026-F01/ship> ] .

