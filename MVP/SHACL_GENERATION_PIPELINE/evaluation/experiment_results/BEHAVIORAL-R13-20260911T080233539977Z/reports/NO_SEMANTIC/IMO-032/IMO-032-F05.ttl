@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-032-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:IMO032CategoryAShape , gs:IMO032CategoryBShape , gs:IMO032StrengthenedCategoryCShape , gs:IMO032UnstrengthenedCategoryCShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO032ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-032-F05/ship> ] .

