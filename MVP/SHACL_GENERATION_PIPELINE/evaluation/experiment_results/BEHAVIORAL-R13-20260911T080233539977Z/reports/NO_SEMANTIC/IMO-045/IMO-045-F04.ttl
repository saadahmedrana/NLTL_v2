@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:machinerySeawaterSupply ] ] , [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceIngestionPreventionPresent ] ] [ sh:property [ sh:hasValue nltl:evidenceStateApproved ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:alternateFunctionalityArrangementApprovalStatus ] ] ) ; sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:machinerySeawaterSupply ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_045_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F04/ship> ;
            sh:resultMessage "machinerySeawaterSupply must be provided to determine whether the alternative-path requirement applies." ;
            sh:resultPath nltl:machinerySeawaterSupply ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "machinerySeawaterSupply must be provided to determine whether the alternative-path requirement applies." ;
                    sh:minCount 1 ;
                    sh:path nltl:machinerySeawaterSupply ] ] .

