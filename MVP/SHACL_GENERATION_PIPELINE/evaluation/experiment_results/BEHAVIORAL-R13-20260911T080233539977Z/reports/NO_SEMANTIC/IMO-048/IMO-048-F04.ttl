@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F04/ship> ;
            sh:resultMessage "Each exposed machinery or foundation material requires an approved material status, an authorized approving authority, an authorized approval standard, and a polar service temperature basis." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each exposed machinery or foundation material requires an approved material status, an authorized approving authority, an authorized approval standard, and a polar service temperature basis." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this a nltl:ship ;
          nltl:exposedMachineryOrFoundationMaterial ?material .
    FILTER NOT EXISTS {
        $this nltl:approvingAuthority ?authority ;
              nltl:approvalStandard ?standard ;
              nltl:materialApprovalStatus nltl:evidenceStateApproved ;
              nltl:polarServiceTemperature ?temperature .
        FILTER (
            ?authority IN (
                "Administration"^^xsd:string,
                "recognized organization accepted by the Administration"^^xsd:string
            )
        )
        FILTER (
            ?standard IN (
                "standard acceptable to the Organization"^^xsd:string,
                "another standard offering an equivalent level of safety"^^xsd:string
            )
        )
        ?temperature qudt:numericValue ?numericValue ;
                     qudt:unit unit:DEG_C .
        FILTER (datatype(?numericValue) = xsd:decimal)
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-048> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F04/ship> ] .

