@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:IMO049CategoryABShape , gen:IMO049IceStrengthenedCategoryCShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO049ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/ship> ;
            sh:resultMessage "The ship must identify the machinery component type relevant to the scantling approval assessment." ;
            sh:resultPath nltl:machineryComponentType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must identify the machinery component type relevant to the scantling approval assessment." ;
                    sh:minCount 1 ;
                    sh:path nltl:machineryComponentType ] ] .

