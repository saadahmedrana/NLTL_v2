@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-F01/ship> ;
            sh:resultMessage "The ship must record that its extinguishing medium is approved for the intended operation." ;
            sh:resultPath nltl:intendedOperationCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ndfad6936e9f44f548f14c40ab1224c2ab1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-F01/ship> ;
            sh:resultMessage "The ship must record that its extinguishing medium is approved for the intended operation." ;
            sh:resultPath nltl:intendedOperationCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ndfad6936e9f44f548f14c40ab1224c2ab1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-F01/medium1> ;
                    sh:resultMessage "Each linked extinguishing medium must be compatible with the intended operation." ;
                    sh:resultPath nltl:extinguishingMediumCompatibilityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:ndfad6936e9f44f548f14c40ab1224c2ab4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-F01/medium1> ;
                    sh:resultMessage "Each linked extinguishing medium must be compatible with the intended operation." ;
                    sh:resultPath nltl:extinguishingMediumCompatibilityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:ndfad6936e9f44f548f14c40ab1224c2ab4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Each linked extinguishing medium must be compatible with the intended operation.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extinguishingMediumCompatibilityStatus ] ]. See details for more information." ;
            sh:resultPath nltl:hasExtinguishingMedium ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ a sh:NodeShape ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:message "Each linked extinguishing medium must be compatible with the intended operation." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:extinguishingMediumCompatibilityStatus ] ] ;
                    sh:path nltl:hasExtinguishingMedium ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-F01/medium1> ] .

_:ndfad6936e9f44f548f14c40ab1224c2ab1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship must record that its extinguishing medium is approved for the intended operation." ;
    sh:minCount 1 ;
    sh:path nltl:intendedOperationCompatibilityStatus .

_:ndfad6936e9f44f548f14c40ab1224c2ab4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "Each linked extinguishing medium must be compatible with the intended operation." ;
    sh:minCount 1 ;
    sh:path nltl:extinguishingMediumCompatibilityStatus .

