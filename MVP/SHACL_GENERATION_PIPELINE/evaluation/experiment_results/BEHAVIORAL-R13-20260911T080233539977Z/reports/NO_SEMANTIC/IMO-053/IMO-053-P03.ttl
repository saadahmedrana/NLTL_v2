@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-P03/ship> ;
            sh:resultMessage "The ship must record that its extinguishing medium is approved for the intended operation." ;
            sh:resultPath nltl:intendedOperationCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ndfad6936e9f44f548f14c40ab1224c2ab1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-P03/ship> ;
            sh:resultMessage "The ship must record that its extinguishing medium is approved for the intended operation." ;
            sh:resultPath nltl:intendedOperationCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ndfad6936e9f44f548f14c40ab1224c2ab1 ] .

_:ndfad6936e9f44f548f14c40ab1224c2ab1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship must record that its extinguishing medium is approved for the intended operation." ;
    sh:minCount 1 ;
    sh:path nltl:intendedOperationCompatibilityStatus .

