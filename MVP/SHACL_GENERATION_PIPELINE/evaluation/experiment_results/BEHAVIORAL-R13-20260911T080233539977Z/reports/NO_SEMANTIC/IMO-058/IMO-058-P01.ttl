@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-P01/section1> ;
                    sh:resultMessage "Each exposed fire-main section shall have isolation capability." ;
                    sh:resultPath nltl:fireMainSectionIsolationCapability ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "Each exposed fire-main section shall have isolation capability." ;
                            sh:minCount 1 ;
                            sh:path nltl:fireMainSectionIsolationCapability ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-P01/section1> ;
                    sh:resultMessage "Each exposed fire-main section shall have means of drainage." ;
                    sh:resultPath nltl:fireMainSectionDrainageMeansPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "Each exposed fire-main section shall have means of drainage." ;
                            sh:minCount 1 ;
                            sh:path nltl:fireMainSectionDrainageMeansPresent ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-P01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"Each exposed fire-main section shall have isolation capability.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:fireMainSectionIsolationCapability ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"Each exposed fire-main section shall have means of drainage.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:fireMainSectionDrainageMeansPresent ] ]. See details for more information." ;
            sh:resultPath nltl:hasExposedFireMainSection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ a sh:NodeShape ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:in ( true ) ;
                                    sh:message "Each exposed fire-main section shall have isolation capability." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:fireMainSectionIsolationCapability ],
                                [ sh:datatype xsd:boolean ;
                                    sh:in ( true ) ;
                                    sh:message "Each exposed fire-main section shall have means of drainage." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:fireMainSectionDrainageMeansPresent ] ] ;
                    sh:path nltl:hasExposedFireMainSection ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-P01/section1> ] .

