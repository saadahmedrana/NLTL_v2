@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F03/ship> ;
            sh:resultMessage "The intended voyage shall be recorded for thermal-protection adequacy." ;
            sh:resultPath nltl:intendedVoyage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The intended voyage shall be recorded for thermal-protection adequacy." ;
                    sh:minCount 1 ;
                    sh:path nltl:intendedVoyage ] ] .

