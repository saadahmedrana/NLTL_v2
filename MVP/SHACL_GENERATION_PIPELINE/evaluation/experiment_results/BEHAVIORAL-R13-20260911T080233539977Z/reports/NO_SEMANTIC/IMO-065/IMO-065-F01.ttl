@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F01/ship> ;
            sh:resultMessage "The survival support duration must be at least the maximum expected rescue time." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The survival support duration must be at least the maximum expected rescue time." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this
WHERE {
    $this nltl:survivalSupportDuration ?supportNode .
    ?supportNode qudt:numericValue ?supportValue .
    $this nltl:maximumExpectedRescueTime ?rescueNode .
    ?rescueNode qudt:numericValue ?rescueValue .
    FILTER (?supportValue < ?rescueValue)
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO065Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F01/ship> ] .

