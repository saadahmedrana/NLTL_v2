@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F03/ship> ;
            sh:resultMessage "Resources must protect persons from cold, wind, and sun." ;
            sh:resultPath nltl:weatherProtectionPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:message "Resources must protect persons from cold, wind, and sun." ;
                    sh:minCount 1 ;
                    sh:path nltl:weatherProtectionPresent ] ] .

