@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F08/ship> ;
            sh:resultMessage "For a ship exposed to ice accretion, every required protected-item category must have associated ice or snow removal or prevention means." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO066ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F08/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F08/ship> ;
            sh:resultMessage "The ship's ice-accretion exposure applicability must be recorded as exactly one boolean value." ;
            sh:resultPath nltl:shipExposedToIceAccretion ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ship's ice-accretion exposure applicability must be recorded as exactly one boolean value." ;
                    sh:minCount 1 ;
                    sh:path nltl:shipExposedToIceAccretion ] ] .

