@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-069-F02/ship> ;
            sh:resultMessage "When an added life-saving device requires power, its power source must be independent of the ship's main source of power." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When an added life-saving device requires power, its power source must be independent of the ship's main source of power." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:addedLifeSavingDeviceRequiresPower ?requiresPower .
                FILTER (?requiresPower = true)
                FILTER NOT EXISTS {
                    $this nltl:devicePowerSourceIndependentOfMainPower ?independent .
                    FILTER (?independent = true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_069_StaticShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-069-F02/ship> ] .

