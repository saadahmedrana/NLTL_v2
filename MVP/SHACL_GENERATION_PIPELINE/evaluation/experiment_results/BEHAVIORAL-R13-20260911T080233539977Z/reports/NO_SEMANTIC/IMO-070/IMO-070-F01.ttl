@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:personOnBoardMember ; sh:node [ sh:property [ sh:class nltl:personalSurvivalEquipmentAssignment ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:personalSurvivalEquipment ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:assignedPersonalSurvivalEquipment ] ] ; sh:path nltl:hasPersonalSurvivalEquipmentAssignment ] ] ; sh:path nltl:hasPersonOnBoardMember ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:message Literal("Each assigned survival-equipment item must be properly sized.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:sizeCompatibilityStatus ], [ sh:datatype xsd:string ; sh:hasValue Literal("passenger_ship") ; sh:message Literal("A passenger ship must identify ship type as passenger_ship.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipType ] ; sh:sparql [ sh:message Literal("Each person on board a passenger ship must have a properly sized immersion suit or thermal protective aid assignment.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:shipType ?shipType .
                        FILTER (?shipType = "passenger_ship")
                        $this nltl:hasPersonOnBoardMember ?person .
                        FILTER NOT EXISTS {
                            ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment .
                            ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment .
                            ?equipment rdf:type ?equipmentType .
                            FILTER (?equipmentType IN (
                                nltl:immersionSuitEquipment,
                                nltl:thermalProtectiveAidEquipment
                            ))
                            $this nltl:sizeCompatibilityStatus true .
                        }
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:string ; sh:message Literal("The ship type must be present to establish that the passenger-ship condition does not apply.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:shipType ; sh:pattern Literal("^(?!passenger_ship$).+") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_070_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ] .

