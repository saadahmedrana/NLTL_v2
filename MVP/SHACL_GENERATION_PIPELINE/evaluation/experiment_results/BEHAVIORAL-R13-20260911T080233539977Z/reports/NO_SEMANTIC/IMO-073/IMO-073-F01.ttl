@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-073-F01/boat1> ;
                    sh:resultMessage "Each lifeboat shall have exactly one type classified as partially enclosed or totally enclosed." ;
                    sh:resultPath nltl:lifeboatTypeClassification ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:lifeboatTypeValue ;
                            sh:in ( nltl:partiallyEnclosedLifeboat nltl:totallyEnclosedLifeboat ) ;
                            sh:maxCount 1 ;
                            sh:message "Each lifeboat shall have exactly one type classified as partially enclosed or totally enclosed." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:lifeboatTypeClassification ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-073-F01/boat1OpenType> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-073-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:class nltl:lifeboatTypeValue ; sh:in ( nltl:partiallyEnclosedLifeboat nltl:totallyEnclosedLifeboat ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each lifeboat shall have exactly one type classified as partially enclosed or totally enclosed.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:lifeboatTypeClassification ] ]. See details for more information." ;
            sh:resultPath nltl:hasLifeboat ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:lifeboat ;
                    sh:node [ sh:property [ sh:class nltl:lifeboatTypeValue ;
                                    sh:in ( nltl:partiallyEnclosedLifeboat nltl:totallyEnclosedLifeboat ) ;
                                    sh:maxCount 1 ;
                                    sh:message "Each lifeboat shall have exactly one type classified as partially enclosed or totally enclosed." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:lifeboatTypeClassification ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasLifeboat ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-073-F01/boat1> ] .

