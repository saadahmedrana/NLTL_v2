@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F01/ship> ;
            sh:resultMessage "Available survival equipment capacity must be at least the ceiling of 110% of the persons on board." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Available survival equipment capacity must be at least the ceiling of 110% of the persons on board." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:personalOrGroupSurvivalEquipmentRequired true ;
                      nltl:personsOnBoard ?persons ;
                      nltl:availableSurvivalEquipmentCapacity ?capacity .
                FILTER (?capacity < CEIL(xsd:decimal(?persons) * 1.10))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_075_SurvivalEquipmentCapacityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F01/ship> ] .

