@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-079-H-F01/ship> ;
            sh:resultMessage "Available emergency ration capacity must be at least persons on board multiplied by maximum expected rescue time." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Available emergency ration capacity must be at least persons on board multiplied by maximum expected rescue time." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:personsOnBoard ?persons ;
                      nltl:maximumExpectedRescueTime ?rescueQuantity ;
                      nltl:availableEmergencyRationPerson ?availableQuantity .
                ?rescueQuantity qudt:numericValue ?rescueTime .
                ?availableQuantity qudt:numericValue ?availableRations .
                FILTER (?availableRations < (?persons * ?rescueTime))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_079_EmergencyRationCapacityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-079-H-F01/ship> ] .

