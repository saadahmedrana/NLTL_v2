@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:or ( [ sh:property [ sh:datatype xsd:date ; sh:maxInclusive Literal(\"2016-12-31\", datatype=xsd:date) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:constructionDate ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipIceStrengthened ] ] ) ] , [ sh:and ( [ sh:property [ sh:datatype xsd:date ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2017-01-01\", datatype=xsd:date) ; sh:path nltl:constructionDate ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipIceStrengthened ] ] [ sh:or ( [ sh:property [ sh:datatype xsd:integer ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:independentEchoSoundingDeviceCount ] ] [ sh:and ( [ sh:property [ sh:datatype xsd:integer ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:echoSoundingDeviceCount ] ] [ sh:property [ sh:datatype xsd:integer ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:independentTransducerCount ] ] ) ] ) ] ) ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-081> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F04/ship> ] .

