@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-084-I-F02/ship> ;
            sh:resultMessage "If required sensors project below the hull, ice protection for those sensors must be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_084_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-084-I-F02/ship> ] .

