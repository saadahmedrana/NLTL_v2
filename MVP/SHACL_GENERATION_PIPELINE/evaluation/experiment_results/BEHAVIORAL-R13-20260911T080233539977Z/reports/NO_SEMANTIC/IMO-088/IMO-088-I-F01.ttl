@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-088-I-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:operatesOnlyInContinuousDaylight ] ] , [ sh:message Literal(\"A ship not operating solely in continuous daylight must provide either the required searchlights and coverage or approved alternative visual ice-detection means.\") ; sh:or ( [ sh:property [ sh:datatype xsd:integer ; sh:message Literal(\"At least two bridge-controlled rotatable narrow-beam searchlights are required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:bridgeControlledRotatableNarrowBeamSearchlightCount ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Searchlights must provide coverage over an arc of at least 360 degrees.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"360\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:searchlightCoverageArc ] ] [ sh:property [ sh:hasValue nltl:evidenceStateApproved ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Approved alternative visual ice-detection means are required when the searchlight alternative is not demonstrated.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:alternateVisualIceDetectionMeansApprovalStatus ] ] ) ; sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:operatesOnlyInContinuousDaylight ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_088_StaticShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-088-I-F01/ship> ] .

