@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-092-J-F02/ship> ;
            sh:resultMessage "The ship shall provide appropriate communication equipment enabling telemedical assistance in polar areas." ;
            sh:resultPath nltl:telemedicalAssistanceCommunicationEquipmentPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n47ac9eeb719b448d9c60628820bc68e0b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-092-J-F02/ship> ;
            sh:resultMessage "The ship shall provide appropriate communication equipment enabling telemedical assistance in polar areas." ;
            sh:resultPath nltl:telemedicalAssistanceCommunicationEquipmentPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n47ac9eeb719b448d9c60628820bc68e0b1 ] .

_:n47ac9eeb719b448d9c60628820bc68e0b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall provide appropriate communication equipment enabling telemedical assistance in polar areas." ;
