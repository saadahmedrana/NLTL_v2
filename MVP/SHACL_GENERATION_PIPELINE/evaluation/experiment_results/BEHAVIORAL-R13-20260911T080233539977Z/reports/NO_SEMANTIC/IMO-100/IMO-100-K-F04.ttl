@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-F04/ship> ;
            sh:resultMessage "The voyage plan must be present." ;
            sh:resultPath nltl:voyagePlanPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nce28a8723a2843beb4e80a798979916fb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-F04/ship> ;
            sh:resultMessage "The voyage plan must be present." ;
            sh:resultPath nltl:voyagePlanPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nce28a8723a2843beb4e80a798979916fb1 ] .

_:nce28a8723a2843beb4e80a798979916fb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The voyage plan must be present." ;
    sh:minCount 1 ;
    sh:path nltl:voyagePlanPresent .

