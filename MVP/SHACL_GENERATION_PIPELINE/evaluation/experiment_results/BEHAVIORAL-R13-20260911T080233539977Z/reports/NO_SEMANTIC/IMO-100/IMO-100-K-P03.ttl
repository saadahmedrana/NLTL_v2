@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-P03/ship> ;
            sh:resultMessage "The voyage plan must address every identified intended-voyage hazard." ;
            sh:resultPath nltl:voyagePlanHazardCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nce28a8723a2843beb4e80a798979916fb3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-P03/ship> ;
            sh:resultMessage "At least one intended-voyage hazard must be identified." ;
            sh:resultPath nltl:identifiedIntendedVoyageHazard ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "At least one intended-voyage hazard must be identified." ;
                    sh:minCount 1 ;
                    sh:path nltl:identifiedIntendedVoyageHazard ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-P03/ship> ;
            sh:resultMessage "The voyage plan must address every identified intended-voyage hazard." ;
            sh:resultPath nltl:voyagePlanHazardCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nce28a8723a2843beb4e80a798979916fb3 ] .

_:nce28a8723a2843beb4e80a798979916fb3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The voyage plan must address every identified intended-voyage hazard." ;
    sh:minCount 1 ;
    sh:path nltl:voyagePlanHazardCoverage .

