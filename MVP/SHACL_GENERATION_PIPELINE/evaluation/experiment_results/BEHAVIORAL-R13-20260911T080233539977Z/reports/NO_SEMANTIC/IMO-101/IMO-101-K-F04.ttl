@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F04/routePlan> ;
                    sh:resultMessage "The polar-route planning record must have voyage-planning topic coverage exactly true." ;
                    sh:resultPath nltl:voyagePlanningTopicCoverage ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n4045e856e32c4d7eb97efd5ad03b190cb3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F04/routePlan> ;
                    sh:resultMessage "The polar-route planning record must have voyage-planning topic coverage exactly true." ;
                    sh:resultPath nltl:voyagePlanningTopicCoverage ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n4045e856e32c4d7eb97efd5ad03b190cb3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F04/ship> ;
            sh:resultMessage "The ship must have a polar-route planning record." ;
            sh:resultPath nltl:hasPolarRoutePlan ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarRoutePlan ;
                    sh:message "The ship must have a polar-route planning record." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:message "The polar-route planning record must have voyage-planning topic coverage exactly true." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:voyagePlanningTopicCoverage ] ] ;
                    sh:path nltl:hasPolarRoutePlan ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F04/routePlan> ] .

_:n4045e856e32c4d7eb97efd5ad03b190cb3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The polar-route planning record must have voyage-planning topic coverage exactly true." ;
    sh:minCount 1 ;
    sh:path nltl:voyagePlanningTopicCoverage .

