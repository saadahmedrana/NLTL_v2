@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-105-L-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:message Literal("Discharge of oil or oily mixtures to sea must be recorded as false in Arctic_waters.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:oilOrOilyMixtureDischargeToSea ], [ sh:datatype xsd:string ; sh:hasValue Literal("Arctic_waters") ; sh:message Literal("The operating area must be recorded as Arctic_waters when this branch applies.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:operatingArea ] ; sh:sparql [ sh:message Literal("Oil or oily mixture discharge to sea must not have any value other than false in Arctic_waters.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:operatingArea "Arctic_waters" .
                        FILTER NOT EXISTS {
                            $this nltl:oilOrOilyMixtureDischargeToSea ?discharge .
                            FILTER (?discharge != false)
                        }
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:string ; sh:message Literal("The operating area is required to determine whether the Arctic waters prohibition applies.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:operatingArea ] ; sh:sparql [ sh:message Literal("This non-Arctic branch requires an operating area other than Arctic_waters.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:operatingArea "Arctic_waters" .
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_105_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-105-L-F01/ship> ] .

