@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:IMO108CategoryCBranch , gen:IMO108DateBeforeBranch , gen:IMO108AggregateAtLeastBranch , gen:IMO108IndividualAtMostBranch , gen:IMO108ApplicableBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO108Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-F03/ship> ] .

