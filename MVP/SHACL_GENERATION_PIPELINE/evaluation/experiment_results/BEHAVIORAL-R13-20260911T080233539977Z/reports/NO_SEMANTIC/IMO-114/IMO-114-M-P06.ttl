@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-P06/ship> ;
            sh:resultMessage "For an applicable Category A or B ship constructed on or after 1 January 2017 carrying the specified NLS in type 3 cargo tanks, Administration approval and the applicable certificate polar operation entry are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_114_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-P06/ship> ] .

