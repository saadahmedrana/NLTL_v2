@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-115-M-F05/ship> ;
            sh:resultMessage "A sewage discharge type is required to determine applicability of the conditional rule." ;
            sh:resultPath nltl:sewageDischargeType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "A sewage discharge type is required to determine applicability of the conditional rule." ;
                    sh:minCount 1 ;
                    sh:path nltl:sewageDischargeType ] ] .

