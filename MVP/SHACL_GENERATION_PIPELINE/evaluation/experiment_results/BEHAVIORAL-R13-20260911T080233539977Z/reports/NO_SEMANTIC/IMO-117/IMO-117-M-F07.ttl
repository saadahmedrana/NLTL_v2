@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F07/distanceToNearestLandIceShelfOrFastIceValue> ;
                    sh:resultMessage "A discharge distance shall use nautical miles." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nf4d064c73b2848c5a20ec5663722accdb2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F07/ship> ;
            sh:resultMessage "The discharge distance record shall record the distance to the nearest land, ice shelf, or fast ice." ;
            sh:resultPath nltl:distanceToNearestLandIceShelfOrFastIce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nf4d064c73b2848c5a20ec5663722accdb3 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F07/distanceToNearestLandIceShelfOrFastIceValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F07/distanceRecord> ;
            sh:resultMessage "The discharge distance record shall record the distance to the nearest land, ice shelf, or fast ice." ;
            sh:resultPath nltl:distanceToNearestLandIceShelfOrFastIce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf4d064c73b2848c5a20ec5663722accdb3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F07/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:IMO117ApplicableShape , gen:IMO117NonApplicableShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO117ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F07/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F07/distanceToAreaWithIceConcentrationGreaterThanOneTenthValue> ;
                    sh:resultMessage "A discharge distance shall use nautical miles." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nf4d064c73b2848c5a20ec5663722accdb2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F07/ship> ;
            sh:resultMessage "The discharge distance record shall record the distance to an area with ice concentration greater than one tenth." ;
            sh:resultPath nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nf4d064c73b2848c5a20ec5663722accdb4 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F07/distanceToAreaWithIceConcentrationGreaterThanOneTenthValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F07/distanceRecord> ;
            sh:resultMessage "The discharge distance record shall record the distance to an area with ice concentration greater than one tenth." ;
            sh:resultPath nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf4d064c73b2848c5a20ec5663722accdb4 ] .

_:nf4d064c73b2848c5a20ec5663722accdb2 sh:hasValue qudt:MI_N ;
    sh:maxCount 1 ;
    sh:message "A discharge distance shall use nautical miles." ;
    sh:minCount 1 ;
    sh:path qudt:unit .

_:nf4d064c73b2848c5a20ec5663722accdb3 sh:class qudt:QuantityValue ;
    sh:maxCount 1 ;
    sh:message "The discharge distance record shall record the distance to the nearest land, ice shelf, or fast ice." ;
    sh:minCount 1 ;
    sh:node gen:DistanceQuantityShape ;
    sh:path nltl:distanceToNearestLandIceShelfOrFastIce .

_:nf4d064c73b2848c5a20ec5663722accdb4 sh:class qudt:QuantityValue ;
    sh:maxCount 1 ;
    sh:message "The discharge distance record shall record the distance to an area with ice concentration greater than one tenth." ;
    sh:minCount 1 ;
    sh:node gen:DistanceQuantityShape ;
    sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth .

