@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-F04/ship> ;
            sh:resultMessage "Node ex:ship->nltl:arcticWaters does not contain a value in the set: ['Literal(\"Arctic_waters\", datatype=xsd:string)']" ;
            sh:resultPath nltl:arcticWaters ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:hasValue "Arctic_waters"^^xsd:string ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:arcticWaters ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-F04/ship> ;
            sh:resultMessage "The ship's operating area must be recorded as Arctic_waters." ;
            sh:resultPath nltl:operatingArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf3cb78d145fc4105979a7d494a921e3ab1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:iceConcentration" ;
            sh:resultPath nltl:iceConcentration ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:iceConcentration ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-F04/ship> ;
            sh:resultMessage "The ship's operating area must be recorded as Arctic_waters." ;
            sh:resultPath nltl:operatingArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nf3cb78d145fc4105979a7d494a921e3ab1 ] .

_:nf3cb78d145fc4105979a7d494a921e3ab1 sh:datatype xsd:string ;
    sh:hasValue "Arctic_waters"^^xsd:string ;
    sh:maxCount 1 ;
    sh:message "The ship's operating area must be recorded as Arctic_waters." ;
    sh:minCount 1 ;
    sh:path nltl:operatingArea .

