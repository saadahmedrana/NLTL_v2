@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F06/ship> ;
            sh:resultMessage "Adequate reception facilities must not be available at the relevant ports." ;
            sh:resultPath nltl:adequateReceptionFacilitiesAvailable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue false ;
                    sh:maxCount 1 ;
                    sh:message "Adequate reception facilities must not be available at the relevant ports." ;
                    sh:minCount 1 ;
                    sh:path nltl:adequateReceptionFacilitiesAvailable ] ] .

