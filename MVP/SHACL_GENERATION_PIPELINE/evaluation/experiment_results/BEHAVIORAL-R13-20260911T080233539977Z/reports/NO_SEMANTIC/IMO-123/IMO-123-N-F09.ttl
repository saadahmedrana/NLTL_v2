@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F09/ship> ;
            sh:resultMessage "A discharge-distance record with both required distances must be provided." ;
            sh:resultPath nltl:hasDischargeDistanceRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A discharge-distance record with both required distances must be provided." ;
                    sh:minCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:class nltl:dischargeDistanceRecords ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "A discharge distance from the area exceeding one tenth ice concentration must be recorded." ;
                                    sh:minCount 1 ;
                                    sh:node [ a sh:NodeShape ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MI_N> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ],
                                [ sh:maxCount 1 ;
                                    sh:message "The discharge must be at least 12 nautical miles from the nearest land, ice shelf, or fast ice." ;
                                    sh:minCount 1 ;
                                    sh:node [ a sh:NodeShape ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MI_N> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:minInclusive 12.0 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:distanceToNearestLandIceShelfOrFastIce ] ] ;
                    sh:path nltl:hasDischargeDistanceRecord ] ] .

