@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-124-N-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in <urn:nltl:generated-shape:IMO-124-Applicable> , <urn:nltl:generated-shape:IMO-124-NoDischarge> , <urn:nltl:generated-shape:IMO-124-NonAntarctic>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-124-Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-124-N-F01/ship> ] .

