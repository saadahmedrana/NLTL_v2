@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-007-A-F01/ship> ;
            sh:resultMessage "For an ice-strengthened ship constructed on or after 1 January 2026, provide either at least two independent echo-sounding devices, one echo-sounding device with at least two independent transducers, or an Administration-approved equivalent depth-sounding device." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-007> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-007-A-F01/ship> ] .

