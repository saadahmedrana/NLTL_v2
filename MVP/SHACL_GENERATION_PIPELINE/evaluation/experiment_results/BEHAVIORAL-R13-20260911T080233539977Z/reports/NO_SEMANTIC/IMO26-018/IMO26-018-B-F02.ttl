@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-018-B-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in ([ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When chapter 11-1 is applicable, the route planning record must cover all nine clause 11-1.3 topics.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:voyagePlanningTopicCoverage ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:polarCodeChapter11Dash1Applicable ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:polarCodeChapter11Dash1Applicable ] ]) and ([ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:safetyManagementSystemImplemented ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When no safety management system is implemented, a documented procedure for operation in polar waters must be present.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:documentedPolarOperationProcedurePresent ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:safetyManagementSystemImplemented ] ])" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-018> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-018-B-F02/ship> ] .

