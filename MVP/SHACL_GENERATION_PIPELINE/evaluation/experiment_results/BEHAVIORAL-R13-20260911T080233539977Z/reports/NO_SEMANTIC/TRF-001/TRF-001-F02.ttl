@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:message Literal(\"A construction contract date on or after 2021-07-05 establishes applicability of the 2021 Ice Class Regulations.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2021-07-05\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2021-07-05\", datatype=xsd:date) ; sh:message Literal(\"A construction contract date before 2021-07-05 establishes non-applicability of the 2021 Ice Class Regulations under this date rule.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:constructionContractDate ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF001ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "The 2021 section 1.8 Ice Classes provision applies to every ship." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n61812ca7401a444e85ec13b669e2c515b8 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "The 2021 section 1.8 Ice Classes provision applies to every ship." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n61812ca7401a444e85ec13b669e2c515b8 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "The 2021 chapter 2 Ice Class Draught provision applies to every ship." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n61812ca7401a444e85ec13b669e2c515b9 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "The 2021 chapter 2 Ice Class Draught provision applies to every ship." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n61812ca7401a444e85ec13b669e2c515b9 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "The construction contract date is required to determine which regulatory edition applies." ;
            sh:resultPath nltl:constructionContractDate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:date ;
                    sh:message "The construction contract date is required to determine which regulatory edition applies." ;
                    sh:minCount 1 ;
                    sh:path nltl:constructionContractDate ] ] .

_:n61812ca7401a444e85ec13b669e2c515b8 sh:hasValue nltl:iceClassSection1Point8Provision2021 ;
    sh:message "The 2021 section 1.8 Ice Classes provision applies to every ship." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:applicableIceClassRegulatoryProvision .

_:n61812ca7401a444e85ec13b669e2c515b9 sh:hasValue nltl:iceClassDraughtChapter2Provision2021 ;
    sh:message "The 2021 chapter 2 Ice Class Draught provision applies to every ship." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:applicableIceClassRegulatoryProvision .

