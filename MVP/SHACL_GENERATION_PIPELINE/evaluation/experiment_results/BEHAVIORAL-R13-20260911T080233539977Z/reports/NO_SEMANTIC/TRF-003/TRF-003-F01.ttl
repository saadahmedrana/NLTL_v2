@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-003-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:iceClassRegulationEdition2010 ; sh:message Literal(\"Ships contracted for construction from 1 January 2012 up to but excluding 1 January 2019 must identify the 2010 Ice Class Regulations.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:applicableIceClassRegulationEdition ], [ sh:maxExclusive Literal(\"2019-01-01\", datatype=xsd:date) ; sh:minInclusive Literal(\"2012-01-01\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ] ] , [ sh:property [ sh:maxExclusive Literal(\"2012-01-01\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ] ] , [ sh:property [ sh:minInclusive Literal(\"2019-01-01\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-003> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-003-F01/ship> ] .

