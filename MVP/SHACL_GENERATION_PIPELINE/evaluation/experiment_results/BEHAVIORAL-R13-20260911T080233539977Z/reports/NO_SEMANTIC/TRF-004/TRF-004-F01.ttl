@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:iceClassRegulationEdition2008 ; sh:message Literal("Ships contracted for construction from 1 January 2010 through 31 December 2011 must identify the 2008 Ice Class Regulations as the applicable regulation edition.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:applicableIceClassRegulationEdition ] ; sh:sparql [ sh:message Literal("The 2008 Ice Class Regulations branch applies only to ships contracted for construction on or after 1 January 2010 and before 1 January 2012.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionContractDate ?date .
                        FILTER (
                            !(
                                (
                                    YEAR(?date) > 2010 ||
                                    (YEAR(?date) = 2010 && MONTH(?date) >= 1 && DAY(?date) >= 1)
                                )
                                &&
                                YEAR(?date) < 2012
                            )
                        )
                    }
                ") ] ] , [ sh:sparql [ sh:message Literal("The non-applicable branch is valid only when the construction contract date is outside the period from 1 January 2010 through 31 December 2011.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionContractDate ?date .
                        FILTER (
                            (
                                (
                                    YEAR(?date) > 2010 ||
                                    (YEAR(?date) = 2010 && MONTH(?date) >= 1 && DAY(?date) >= 1)
                                )
                                &&
                                YEAR(?date) < 2012
                            )
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF004_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ] .

