@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P02/ship> ;
            sh:resultMessage "For an IA Super or IA ship whose keel was laid or construction had reached a similar stage before 1 September 2003, the required 2017 compliance method, delivery date, assessment date, and deadline compliance shall be represented." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an IA Super or IA ship whose keel was laid or construction had reached a similar stage before 1 September 2003, the required 2017 compliance method, delivery date, assessment date, and deadline compliance shall be represented." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ic .
                FILTER (?ic IN (nltl:iceClassIaSuper, nltl:iceClassIa))

                $this nltl:constructionStageDate ?cs .
                FILTER (datatype(?cs) = xsd:date)
                FILTER (
                    YEAR(?cs) < 2003 ||
                    (YEAR(?cs) = 2003 && MONTH(?cs) < 9)
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:deliveryDate ?del .
                        FILTER (datatype(?del) = xsd:date)
                    } ||
                    NOT EXISTS {
                        $this nltl:assessmentDate ?ass .
                        FILTER (datatype(?ass) = xsd:date)
                    } ||
                    NOT EXISTS {
                        $this nltl:engineOutputComplianceMethod ?method .
                        FILTER (?method IN (
                            nltl:traficom2017Section3Point2Point2Method,
                            nltl:traficom2017Section3Point2Point4Method
                        ))
                    } ||
                    NOT EXISTS {
                        $this nltl:deliveryDate ?del2 ;
                              nltl:assessmentDate ?ass2 ;
                              nltl:engineOutputComplianceMethod ?method2 .
                        FILTER (datatype(?del2) = xsd:date)
                        FILTER (datatype(?ass2) = xsd:date)
                        FILTER (?method2 IN (
                            nltl:traficom2017Section3Point2Point2Method,
                            nltl:traficom2017Section3Point2Point4Method
                        ))
                        FILTER (
                            YEAR(?ass2) < YEAR(?del2) + 20 ||
                            (
                                YEAR(?ass2) = YEAR(?del2) + 20 &&
                                MONTH(?ass2) = 1 &&
                                DAY(?ass2) = 1
                            )
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_007_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-007-P02/ship> ] .

