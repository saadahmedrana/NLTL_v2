@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/lowerPoint> ;
                            sh:resultMessage "Each waterline profile point must have a vertical coordinate." ;
                            sh:resultPath nltl:verticalCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:class qudt:QuantityValue ;
                                    sh:message "Each waterline profile point must have a vertical coordinate." ;
                                    sh:minCount 1 ;
                                    sh:node gs:TRF012LengthQuantityShape ;
                                    sh:path nltl:verticalCoordinate ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/lowerIceWaterline> ;
                    sh:resultMessage "Each represented ice waterline must contain at least one waterline profile point." ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:waterlineProfilePoint ;
                            sh:message "Each represented ice waterline must contain at least one waterline profile point." ;
                            sh:minCount 1 ;
                            sh:node gs:TRF012WaterlineProfilePointShape ;
                            sh:path nltl:hasWaterlineProfilePoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/lowerPoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/ship> ;
            sh:resultMessage "The ship must represent the externally determined lower ice waterline with profile points." ;
            sh:resultPath nltl:hasLowerIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:message "The ship must represent the externally determined lower ice waterline with profile points." ;
                    sh:minCount 1 ;
                    sh:node gs:TRF012IceWaterlineShape ;
                    sh:path nltl:hasLowerIceWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/lowerIceWaterline> ] .

