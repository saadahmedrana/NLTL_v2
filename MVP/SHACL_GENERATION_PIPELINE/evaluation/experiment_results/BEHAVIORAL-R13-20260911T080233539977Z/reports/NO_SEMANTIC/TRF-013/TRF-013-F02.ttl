@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-F02/ship> ;
            sh:resultMessage "Operating fore and aft draughts must each be between the corresponding minimum and maximum ice-class draughts." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Operating fore and aft draughts must each be between the corresponding minimum and maximum ice-class draughts." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:operatingForeDraught ?ofq .
                ?ofq qudt:numericValue ?of .
                $this nltl:operatingAftDraught ?oaq .
                ?oaq qudt:numericValue ?oa .
                $this nltl:minimumIceClassDraughtFore ?minfq .
                ?minfq qudt:numericValue ?minf .
                $this nltl:maximumIceClassDraughtFore ?maxfq .
                ?maxfq qudt:numericValue ?maxf .
                $this nltl:minimumIceClassDraughtAft ?minaq .
                ?minaq qudt:numericValue ?mina .
                $this nltl:maximumIceClassDraughtAft ?maxaq .
                ?maxaq qudt:numericValue ?maxa .
                FILTER (
                    !(?minf <= ?of && ?of <= ?maxf &&
                      ?mina <= ?oa && ?oa <= ?maxa)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF013Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-F02/ship> ] .

