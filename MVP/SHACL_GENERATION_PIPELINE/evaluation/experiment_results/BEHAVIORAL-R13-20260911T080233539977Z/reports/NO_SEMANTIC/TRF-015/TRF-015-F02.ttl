@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F02/ship> ;
            sh:resultMessage "When navigating in ice, the operating draught and trim must not exceed their permitted limits." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When navigating in ice, the operating draught and trim must not exceed their permitted limits." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:navigatingInIce true ;
                      nltl:operatingDraught ?operatingDraught ;
                      nltl:upperIceWaterlineDraught ?upperDraught ;
                      nltl:operatingTrim ?operatingTrim ;
                      nltl:maximumPermittedIceTrim ?maximumTrim .

                ?operatingDraught qudt:numericValue ?operatingDraughtValue ;
                                  qudt:unit unit:M .
                ?upperDraught qudt:numericValue ?upperDraughtValue ;
                              qudt:unit unit:M .
                ?operatingTrim qudt:numericValue ?operatingTrimValue ;
                               qudt:unit unit:M .
                ?maximumTrim qudt:numericValue ?maximumTrimValue ;
                             qudt:unit unit:M .

                FILTER (
                    datatype(?operatingDraughtValue) = xsd:decimal &&
                    datatype(?upperDraughtValue) = xsd:decimal &&
                    datatype(?operatingTrimValue) = xsd:decimal &&
                    datatype(?maximumTrimValue) = xsd:decimal &&
                    (
                        ?operatingDraughtValue > ?upperDraughtValue ||
                        ?operatingTrimValue > ?maximumTrimValue
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF015Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F02/ship> ] .

