@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:navigatingInIce ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:navigatingInIce ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerHighestPointSubmerged ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:draughtAmidships ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:forwardDraught ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:levelIceThickness ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:liwlDraughtAmidships ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/TON_Metric> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:waterlineDisplacement ] ] ; sh:path nltl:hasUpperIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasLowerIceWaterline ], [ sh:node [ sh:property [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:path nltl:freezingPreventionPresent ], [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:path nltl:situatedAboveLowerIceWaterline ], [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:path nltl:usedToReachLowerIceWaterline ] ] ; sh:path nltl:hasBallastTank ] ; sh:sparql [ sh:message Literal("Draught amidships must be at least the LIWL draught amidships when navigating in ice.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:navigatingInIce true ;
                              nltl:draughtAmidships ?draughtNode ;
                              nltl:liwlDraughtAmidships ?liwlNode .
                        ?draughtNode qudt:numericValue ?draught .
                        ?liwlNode qudt:numericValue ?liwl .
                        FILTER (?draught < ?liwl)
                    }
                ") ], [ sh:message Literal("Each ballast tank situated above the LIWL and needed to reach it must have freezing prevention.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:navigatingInIce true ;
                              nltl:hasBallastTank ?tank .
                        ?tank nltl:situatedAboveLowerIceWaterline true ;
                              nltl:usedToReachLowerIceWaterline true .
                        FILTER NOT EXISTS {
                            ?tank nltl:freezingPreventionPresent true
                        }
                    }
                ") ], [ sh:message Literal("Forward draught must meet the applicable level-ice forward-draught threshold using the greatest-displacement UIWL.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:navigatingInIce true ;
                              nltl:hasUpperIceWaterline ?uiwl ;
                              nltl:levelIceThickness ?hiNode ;
                              nltl:forwardDraught ?forwardNode .
                        ?uiwl nltl:waterlineDisplacement ?displacementNode .
                        ?displacementNode qudt:numericValue ?delta .
                        ?hiNode qudt:numericValue ?hi .
                        ?forwardNode qudt:numericValue ?forward .
                        FILTER NOT EXISTS {
                            $this nltl:hasUpperIceWaterline ?otherUiwl .
                            ?otherUiwl nltl:waterlineDisplacement ?otherDisplacementNode .
                            ?otherDisplacementNode qudt:numericValue ?otherDelta .
                            FILTER (?otherDelta > ?delta)
                        }
                        FILTER (
                            ?forward <
                            IF(
                                ((2 + (0.00025 * ?delta)) * ?hi) < (4 * ?hi),
                                ((2 + (0.00025 * ?delta)) * ?hi),
                                (4 * ?hi)
                            )
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-016-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-F02/ship> ] .

