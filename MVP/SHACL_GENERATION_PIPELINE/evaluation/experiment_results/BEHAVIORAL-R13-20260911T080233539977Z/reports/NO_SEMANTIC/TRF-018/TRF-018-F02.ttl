@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F02/required> ;
                    sh:resultMessage "Node ex:required->qudt:unit does not contain a value in the set: ['qudt:KiloW']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:KiloW ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F02/ship> ;
            sh:resultMessage "calculatedRequiredPower must be a single decimal power quantity in kW." ;
            sh:resultPath nltl:calculatedRequiredPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "calculatedRequiredPower must be a single decimal power quantity in kW." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:calculatedRequiredPower ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F02/required> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F02/ship> ;
            sh:resultMessage "maximumContinuousRatingPower must be at least calculatedRequiredPower and at least 1000 kW for IA, IB, or IC, or at least 2800 kW for IA Super." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "maximumContinuousRatingPower must be at least calculatedRequiredPower and at least 1000 kW for IA, IB, or IC, or at least 2800 kW for IA Super." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:calculatedRequiredPower ?calculatedNode ;
                      nltl:maximumContinuousRatingPower ?maximumNode .
                ?calculatedNode qudt:numericValue ?calculatedPower .
                ?maximumNode qudt:numericValue ?maximumPower .
                FILTER (
                    (?ice IN (
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    ) &&
                    (?maximumPower < ?calculatedPower || ?maximumPower < 1000))
                    ||
                    (?ice = nltl:iceClassIaSuper &&
                    (?maximumPower < ?calculatedPower || ?maximumPower < 2800))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-018-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F02/mcr> ;
                    sh:resultMessage "Node ex:mcr->qudt:unit does not contain a value in the set: ['qudt:KiloW']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:KiloW ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F02/ship> ;
            sh:resultMessage "maximumContinuousRatingPower must be a single decimal power quantity in kW." ;
            sh:resultPath nltl:maximumContinuousRatingPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "maximumContinuousRatingPower must be a single decimal power quantity in kW." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:maximumContinuousRatingPower ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F02/mcr> ] .

