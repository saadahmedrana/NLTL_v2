@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-022-F05/ship> ;
            sh:resultMessage "Ship breadth is required as a metre-valued quantity input." ;
            sh:resultPath nltl:shipBreadth ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Ship breadth is required as a metre-valued quantity input." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:shipBreadth ] ] .

