    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:Nb3b63868b49647b0922ca96d3109a6b5 sh:property _:Nb13a04287495428e99e32ae5f6cb4f06,
        [ sh:hasValue unit:M ;
