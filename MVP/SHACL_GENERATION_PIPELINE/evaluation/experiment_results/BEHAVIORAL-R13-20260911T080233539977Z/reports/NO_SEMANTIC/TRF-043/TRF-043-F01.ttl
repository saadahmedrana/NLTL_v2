@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/terminationCase> ;
                    sh:resultMessage "When the extension beyond the adjacent boundary is no more than 250 mm, termination at that boundary must be permitted." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "When the extension beyond the adjacent boundary is no more than 250 mm, termination at that boundary must be permitted." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?quantity .
                ?quantity qudt:numericValue ?value .
                ?quantity qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                FILTER (?value <= "250"^^xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted true .
                }
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:TRF-043-TerminationCaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/terminationCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF-043-TerminationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasFramingIceStrengtheningTerminationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:TRF-043-TerminationCaseShape> ;
                    sh:path nltl:hasFramingIceStrengtheningTerminationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/terminationCase> ] .

