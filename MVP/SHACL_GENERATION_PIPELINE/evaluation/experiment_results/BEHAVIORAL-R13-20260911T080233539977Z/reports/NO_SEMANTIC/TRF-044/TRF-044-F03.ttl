@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F03/transverseFrame> ;
            sh:resultMessage "The boundary-condition m0 table value or one of the calculated results is non-conforming; calculated decimal results use relative tolerance 1e-6 plus absolute fallback 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The boundary-condition m0 table value or one of the calculated results is non-conforming; calculated decimal results use relative tolerance 1e-6 plus absolute fallback 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType ?condition ;
                      nltl:icePressure ?pNode ;
                      nltl:spacing ?sNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:yieldStrength ?yNode ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?sNode qudt:numericValue ?s .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?m0Node qudt:numericValue ?m0 .
                ?yNode qudt:numericValue ?y .
                ?mtNode qudt:numericValue ?mt .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND(
                    IF(
                        ?condition = nltl:bulkCarrierTopWingTankFrameCondition,
                        7.0,
                        IF(
                            ?condition = nltl:singleDeckTankTopToMainDeckFrameCondition,
                            6.0,
                            IF(
                                ?condition = nltl:multiDeckOrStringerContinuousFrameCondition,
                                5.7,
                                5.0
                            )
                        )
                    )
                    AS ?m0Expected
                )
                BIND(7.0 * ?m0Expected / (7.0 - 5.0 * ?h / ?l) AS ?mtExpected)
                BIND(?p * ?s * ?h * ?l / (?mtExpected * ?y) * 1000000.0 AS ?zExpected)
                BIND(1.7320508075688772 * 1.2 * ?p * ?h * ?s / (2.0 * ?y) * 10000.0 AS ?aExpected)

                FILTER(
                    ?m0 != ?m0Expected ||
                    ABS(?mt - ?mtExpected) >
                        (ABS(?mtExpected) * 0.000001 + 0.000000001) ||
                    ABS(?z - ?zExpected) >
                        (ABS(?zExpected) * 0.000001 + 0.000000001) ||
                    ABS(?a - ?aExpected) >
                        (ABS(?aExpected) * 0.000001 + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF044TransverseFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-044-F03/transverseFrame> ] .

