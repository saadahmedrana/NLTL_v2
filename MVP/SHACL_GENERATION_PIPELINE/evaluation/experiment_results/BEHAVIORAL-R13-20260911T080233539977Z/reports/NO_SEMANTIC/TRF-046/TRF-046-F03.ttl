@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/adjacentMainFrame> ;
            sh:resultMessage "A frame shall have an upper end whose attached supporting structure is eligible under the requirement." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n5217a6b8018143a49d8328809a2bce4ab2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/adjacentMainFrame> ;
            sh:resultMessage "A frame shall identify its strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameStrengthenedPart ;
                    sh:message "A frame shall identify its strengthened part." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasStrengthenedPart ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/upperEnd> ;
                    sh:resultMessage "The upper frame end shall be attached to a deck, tank boundary plating, or ice stringer." ;
                    sh:resultPath nltl:hasAttachedSupportingStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The upper frame end shall be attached to a deck, tank boundary plating, or ice stringer." ;
                            sh:minCount 1 ;
                            sh:node [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:iceStringer ] ) ] ;
                            sh:path nltl:hasAttachedSupportingStructure ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/frame> ;
            sh:resultMessage "A frame shall have an upper end whose attached supporting structure is eligible under the requirement." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n5217a6b8018143a49d8328809a2bce4ab2 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/upperEnd> ] .

_:N79d9f5380f4b4c41a29d2d20b97b0c0a rdf:first [ ] ;
    rdf:rest ( [ ] ) .

_:N8d46d6c5081c46daafc84de7b533f824 rdf:first [ ] ;
    rdf:rest _:N79d9f5380f4b4c41a29d2d20b97b0c0a .

_:N91d2d2cfd9a84bfcb43d5625cf038803 sh:or _:N8d46d6c5081c46daafc84de7b533f824 .

_:Nd818a4459d0e4fefbd454a60a2ca6516 sh:property [ sh:message "The upper frame end shall be attached to a deck, tank boundary plating, or ice stringer." ;
            sh:minCount 1 ;
            sh:node _:N91d2d2cfd9a84bfcb43d5625cf038803 ;
            sh:path nltl:hasAttachedSupportingStructure ] .

_:n5217a6b8018143a49d8328809a2bce4ab2 sh:class nltl:frameEnd ;
    sh:message "A frame shall have an upper end whose attached supporting structure is eligible under the requirement." ;
    sh:minCount 1 ;
