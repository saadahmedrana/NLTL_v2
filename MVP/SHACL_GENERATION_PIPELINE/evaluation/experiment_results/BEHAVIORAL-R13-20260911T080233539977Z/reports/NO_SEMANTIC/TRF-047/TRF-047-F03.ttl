@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/lowerEnd> ;
            sh:resultMessage "The lower end shall be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
            sh:resultPath nltl:hasAttachedSupportingStructure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n038b747be17f4d2698f925b03ad0f6d1b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/frame> ;
            sh:resultMessage "The lower end shall be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
            sh:resultPath nltl:hasAttachedSupportingStructure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n038b747be17f4d2698f925b03ad0f6d1b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/adjacentMainFrame> ;
            sh:resultMessage "A frame shall identify its strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameStrengthenedPart ;
                    sh:message "A frame shall identify its strengthened part." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasStrengthenedPart ] ] .

_:N005e0dbd582a45fb97fcd537989ea4b0 sh:class nltl:deckStructure .

_:N0d6f14ba895f4d84add638c6123690a5 rdf:first [ sh:class nltl:tankBoundaryPlating ] ;
    rdf:rest ( [ sh:class nltl:tankTop ] [ sh:class nltl:iceStringer ] ) .

_:N6df4bbe421af4366868390074ec69c2b rdf:first _:N005e0dbd582a45fb97fcd537989ea4b0 ;
    rdf:rest _:N0d6f14ba895f4d84add638c6123690a5 .

_:n038b747be17f4d2698f925b03ad0f6d1b3 sh:message "The lower end shall be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
    sh:minCount 1 ;
    sh:or _:N6df4bbe421af4366868390074ec69c2b ;
    sh:path nltl:hasAttachedSupportingStructure .

