[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/lowerEnd> ;
            sh:resultMessage "The lower end shall be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
            sh:resultPath nltl:hasAttachedSupportingStructure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n038b747be17f4d2698f925b03ad0f6d1b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/frame> ;
            sh:resultMessage "The lower end shall be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
            sh:resultPath nltl:hasAttachedSupportingStructure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n038b747be17f4d2698f925b03ad0f6d1b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/adjacentMainFrame> ;
            sh:resultMessage "A frame shall identify its strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameStrengthenedPart ;
                    sh:message "A frame shall identify its strengthened part." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasStrengthenedPart ] ] .

