@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/frame> ;
            sh:resultMessage "The lower end shall be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
            sh:resultPath nltl:hasAttachedSupportingStructure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n038b747be17f4d2698f925b03ad0f6d1b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/adjacentMainFrame> ;
            sh:resultMessage "A frame shall identify its strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameStrengthenedPart ;
                    sh:message "A frame shall identify its strengthened part." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasStrengthenedPart ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/lowerEnd> ;
            sh:resultMessage "The lower end shall be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
            sh:resultPath nltl:hasAttachedSupportingStructure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n038b747be17f4d2698f925b03ad0f6d1b3 ] .

_:N01ace3dc0f16432ab89ee50ba2a91526 rdf:first [ sh:class nltl:iceStringer ] ;
    rdf:rest () .

_:N2aa8fecadd5044988689fa1e945f66da sh:class nltl:deckStructure .

_:N4d695713e6464ce7a87c9b912a9470bc rdf:first [ sh:class nltl:tankBoundaryPlating ] ;
    rdf:rest ( [ sh:class nltl:tankTop ] _:N23912861fe5f4286bed9e32bf8ee6916 ) .

_:N577a16f460f24e70be1ec0e83062f115 rdf:first _:N2aa8fecadd5044988689fa1e945f66da ;
    rdf:rest _:N4d695713e6464ce7a87c9b912a9470bc .

_:n038b747be17f4d2698f925b03ad0f6d1b3 sh:message "The lower end shall be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
    sh:minCount 1 ;
    sh:or _:N577a16f460f24e70be1ec0e83062f115 ;
    sh:path nltl:hasAttachedSupportingStructure .

