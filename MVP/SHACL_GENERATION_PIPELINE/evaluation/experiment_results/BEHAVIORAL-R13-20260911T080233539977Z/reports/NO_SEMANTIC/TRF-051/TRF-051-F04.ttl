@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-051-F04/hullStructure> ;
            sh:resultMessage "Net shell plating thickness is required in millimetres." ;
            sh:resultPath nltl:netShellPlatingThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Net shell plating thickness is required in millimetres." ;
                    sh:minCount 1 ;
                    sh:node gen:LengthQuantityShape ;
                    sh:path nltl:netShellPlatingThickness ] ] .

