@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-051-F07/hullStructure> ;
            sh:resultMessage "Frame web thickness shall be provided in millimetres and shall be at least 9 mm." ;
            sh:resultPath nltl:frameWebThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Frame web thickness shall be provided in millimetres and shall be at least 9 mm." ;
                    sh:minCount 1 ;
                    sh:node gen:FrameWebThicknessQuantityShape ;
                    sh:path nltl:frameWebThickness ] ] .

