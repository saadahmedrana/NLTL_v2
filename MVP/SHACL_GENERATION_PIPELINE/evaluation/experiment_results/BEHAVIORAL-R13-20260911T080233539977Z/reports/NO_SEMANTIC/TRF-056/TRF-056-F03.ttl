@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F03/ship> ;
            sh:resultMessage "For a weatherdeck hatch longer than half the ship breadth, ship-side deflection and both hatch-cover and hatch-fitting design evidence must be represented." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a weatherdeck hatch longer than half the ship breadth, ship-side deflection and both hatch-cover and hatch-fitting design evidence must be represented." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipBreadth ?breadthQuantity ;
                      nltl:hasWeatherdeckHatch ?hatch .
                ?breadthQuantity qudt:numericValue ?breadthValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                ?hatch nltl:hatchOpeningLength ?openingQuantity .
                ?openingQuantity qudt:numericValue ?openingValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .

                FILTER (?openingValue > (?breadthValue / 2))

                FILTER (
                    NOT EXISTS {
                        ?hatch nltl:shipSideDeflection ?deflectionQuantity .
                        ?deflectionQuantity qudt:numericValue ?deflectionValue ;
                                             qudt:unit <http://qudt.org/vocab/unit/M> .
                    }
                    ||
                    NOT EXISTS {
                        ?hatch nltl:hasHatchCoverDesignEvidence ?coverEvidence .
                        ?coverEvidence rdf:type nltl:hatchCoverDesignEvidence .
                    }
                    ||
                    NOT EXISTS {
                        ?hatch nltl:hasHatchFittingDesignEvidence ?fittingEvidence .
                        ?fittingEvidence rdf:type nltl:hatchFittingDesignEvidence .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF056ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F03/ship> ] .

