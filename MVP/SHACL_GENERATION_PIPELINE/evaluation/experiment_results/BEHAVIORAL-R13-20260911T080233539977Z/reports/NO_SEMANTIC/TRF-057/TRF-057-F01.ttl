@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "webFrameIceLoad must equal 1.8 times the effective ice pressure-height product times webFrameSpacing, reported in kN; use 0.15 MN/m when the product is below 0.15 MN/m, within a relative tolerance of 1e-6 and an absolute tolerance of 1e-6 kN." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "webFrameIceLoad must equal 1.8 times the effective ice pressure-height product times webFrameSpacing, reported in kN; use 0.15 MN/m when the product is below 0.15 MN/m, within a relative tolerance of 1e-6 and an absolute tolerance of 1e-6 kN." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:iceLoadHeight ?heightNode ;
                      nltl:webFrameSpacing ?spacingNode ;
                      nltl:webFrameIceLoad ?loadNode .

                ?pressureNode qudt:numericValue ?pVal .
                ?heightNode qudt:numericValue ?hVal .
                ?spacingNode qudt:numericValue ?sVal .
                ?loadNode qudt:numericValue ?reported .

                FILTER (
                    datatype(?pVal) = xsd:decimal &&
                    datatype(?hVal) = xsd:decimal &&
                    datatype(?sVal) = xsd:decimal &&
                    datatype(?reported) = xsd:decimal
                )

                BIND((?pVal * ?hVal) AS ?pressureHeight)
                BIND(IF(?pressureHeight < 0.15, 0.15, ?pressureHeight) AS ?effectivePressureHeight)
                BIND((1.8 * ?effectivePressureHeight * ?sVal * 1000) AS ?expected)

                FILTER (
                    ABS(?reported - ?expected) >
                    (0.000001 * ABS(?expected) + 0.000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF057WebFrameIceLoadShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ] .

