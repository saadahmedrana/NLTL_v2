@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ;
            sh:resultMessage "Required shear area must match sqrt(3) times alpha times 1.1 times maximum shear force converted from kN to MN, divided by yield strength, times 10^4; alpha must match Table 4-8 for the supplied flange-to-web area ratio. A relative tolerance of 1e-6, with an absolute fallback of 1e-9 cm2 near zero, is permitted for the calculated result." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Required shear area must match sqrt(3) times alpha times 1.1 times maximum shear force converted from kN to MN, divided by yield strength, times 10^4; alpha must match Table 4-8 for the supplied flange-to-web area ratio. A relative tolerance of 1e-6, with an absolute fallback of 1e-9 cm2 near zero, is permitted for the calculated result." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?forceQuantity ;
                      nltl:webFrameShearFactorAlpha ?alphaQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:freeFlangeToWebAreaRatio ?ratioQuantity ;
                      nltl:requiredShearArea ?areaQuantity .

                ?forceQuantity qudt:numericValue ?force .
                ?alphaQuantity qudt:numericValue ?alpha .
                ?yieldQuantity qudt:numericValue ?yield .
                ?ratioQuantity qudt:numericValue ?ratio .
                ?areaQuantity qudt:numericValue ?area .

                BIND((1.7320508075688772 * ?alpha * 1.1 * (?force / 1000) / ?yield * 10000) AS ?expected)
                BIND(IF((?expected * 0.000001) > 0.000000001,
                        (?expected * 0.000001),
                        0.000000001) AS ?tolerance)

                FILTER(
                    !(
                        (?ratio = 0.0 && ?alpha = 1.5) ||
                        (?ratio = 0.2 && ?alpha = 1.23) ||
                        (?ratio = 0.4 && ?alpha = 1.16) ||
                        (?ratio = 0.6 && ?alpha = 1.11) ||
                        (?ratio = 0.8 && ?alpha = 1.09) ||
                        (?ratio = 1.0 && ?alpha = 1.07) ||
                        (?ratio = 1.2 && ?alpha = 1.06) ||
                        (?ratio = 1.4 && ?alpha = 1.05) ||
                        (?ratio = 1.6 && ?alpha = 1.05) ||
                        (?ratio = 1.8 && ?alpha = 1.04) ||
                        (?ratio = 2.0 && ?alpha = 1.04)
                    )
                    || ?area < (?expected - ?tolerance)
                    || ?area > (?expected + ?tolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF_059_WebFrameShearAreaShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ] .

