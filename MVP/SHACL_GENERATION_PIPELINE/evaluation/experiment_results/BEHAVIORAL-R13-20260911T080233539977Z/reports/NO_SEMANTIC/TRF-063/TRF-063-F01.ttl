@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:TRF063ApplicableShipBranch , gen:TRF063NonApplicableShipBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF063ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F01/ship> ] .

