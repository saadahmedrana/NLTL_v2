@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The detached-strut applicability value must be false for the plated-bossing case.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:detachedStrut ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:platedBossingStructure ; sh:message Literal(\"Each side-propeller shafting assembly must be enclosed within plated bossing.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:enclosedByPlatedBossing ] ] ; sh:path nltl:hasSidePropellerShafting ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:platedBossingStructure ; sh:message Literal(\"Each side-propeller stern tube must be enclosed within plated bossing.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:enclosedByPlatedBossing ] ] ; sh:path nltl:hasSternTube ] ] , [ sh:property [ sh:class nltl:detachedStrutStructure ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class nltl:strutDesignEvidence ; sh:message Literal(\"Detached struts require design evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutDesignEvidence ], [ sh:class nltl:strutHullAttachmentEvidence ; sh:message Literal(\"Detached struts require hull-attachment evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutHullAttachmentEvidence ], [ sh:class nltl:strutStrengthEvidence ; sh:message Literal(\"Detached struts require strength evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasStrutStrengthEvidence ] ] ; sh:path nltl:hasDetachedStrut ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The detached-strut applicability value must be true when detached struts are used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:detachedStrut ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF064ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F03/ship> ] .

