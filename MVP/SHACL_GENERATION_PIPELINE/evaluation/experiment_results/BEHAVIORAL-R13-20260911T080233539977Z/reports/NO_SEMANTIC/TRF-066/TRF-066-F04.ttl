@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype nltl:iceClassValue ; sh:in ( nltl:iceClassIa nltl:iceClassIaSuper ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF_066_IceKnifeArrangementShape ; sh:path nltl:hasRudderProtectionArrangement ] ] , [ sh:property [ sh:datatype nltl:iceClassValue ; sh:in ( nltl:iceClassIa nltl:iceClassIaSuper ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF_066_EquivalentArrangementShape ; sh:path nltl:hasRudderProtectionArrangement ] ] , [ sh:property [ sh:datatype nltl:iceClassValue ; sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceClass ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_066_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F04/ship> ] .

