@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-P03/ship> ;
            sh:resultMessage "The ship shall record one pitch type: controllable or fixed." ;
            sh:resultPath nltl:pitchType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "controllable" "fixed" ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship shall record one pitch type: controllable or fixed." ;
                    sh:minCount 1 ;
                    sh:path nltl:pitchType ] ;
            sh:value "controllable"^^xsd:string ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-P03/ship> ;
            sh:resultMessage "The ship shall record one propeller type: open or ducted." ;
            sh:resultPath nltl:propellerType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "open" "ducted" ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship shall record one propeller type: open or ducted." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerType ] ;
            sh:value "open"^^xsd:string ] .

