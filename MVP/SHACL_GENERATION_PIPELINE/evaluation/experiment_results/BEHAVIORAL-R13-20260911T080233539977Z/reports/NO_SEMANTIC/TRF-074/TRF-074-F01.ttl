@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-F01/ship> ;
            sh:resultMessage "For ice class IB or IC, when the ballast-condition propeller top depth is below hi, the propulsion system must be designed for ice class IA." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ice class IB or IC, when the ballast-condition propeller top depth is below hi, the propulsion system must be designed for ice class IA." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))

                $this nltl:ballastConditionPropellerTopDepth ?depthQuantity .
                ?depthQuantity qudt:numericValue ?depth .
                ?depthQuantity qudt:unit <http://qudt.org/vocab/unit/M> .

                $this nltl:requiredPropellerSubmersionDepthHi ?hiQuantity .
                ?hiQuantity qudt:numericValue ?hi .
                ?hiQuantity qudt:unit <http://qudt.org/vocab/unit/M> .

                FILTER (
                    datatype(?depth) = xsd:decimal &&
                    datatype(?hi) = xsd:decimal &&
                    ?depth < ?hi
                )

                FILTER NOT EXISTS {
                    $this nltl:propulsionSystemDesignedForIceClass nltl:iceClassIa .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF074ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-F01/ship> ] .

