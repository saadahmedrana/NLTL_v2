@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F01/case> ;
                    sh:resultMessage "Node ex:case must conform to exactly one shape in [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each propeller blade load case must have one backward blade force or one forward blade force, but not both.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:backwardBladeForce ] , [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each propeller blade load case must have one forward blade force or one backward blade force, but not both.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:forwardBladeForce ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:XoneConstraintComponent ;
                    sh:sourceShape [ a sh:NodeShape ;
                            sh:property [ sh:class nltl:propellerBlade ;
                                    sh:maxCount 1 ;
                                    sh:message "Each propeller blade load case must link to exactly one propeller blade." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:propellerBladeLoadCaseBlade ],
                                [ sh:class nltl:iceBlock ;
                                    sh:maxCount 1 ;
                                    sh:message "Each propeller blade load case must link to exactly one ice block." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:propellerBladeLoadCaseIceBlock ] ;
                            sh:xone ( [ sh:maxCount 1 ;
                                        sh:message "Each propeller blade load case must have one backward blade force or one forward blade force, but not both." ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class qudt:QuantityValue ;
                                                sh:property [ sh:hasValue unit:KiloN ;
                                                        sh:maxCount 1 ;
                                                        sh:minCount 1 ;
                                                        sh:path qudt:unit ],
                                                    [ sh:datatype xsd:decimal ;
                                                        sh:maxCount 1 ;
                                                        sh:minCount 1 ;
                                                        sh:path qudt:numericValue ] ] ;
                                        sh:path nltl:backwardBladeForce ] [ sh:maxCount 1 ;
                                        sh:message "Each propeller blade load case must have one forward blade force or one backward blade force, but not both." ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class qudt:QuantityValue ;
                                                sh:property [ sh:datatype xsd:decimal ;
                                                        sh:maxCount 1 ;
                                                        sh:minCount 1 ;
                                                        sh:path qudt:numericValue ],
                                                    [ sh:hasValue unit:KiloN ;
                                                        sh:maxCount 1 ;
                                                        sh:minCount 1 ;
                                                        sh:path qudt:unit ] ] ;
                                        sh:path nltl:forwardBladeForce ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F01/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:class nltl:iceBlock ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each propeller blade load case must link to exactly one ice block.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propellerBladeLoadCaseIceBlock ], [ sh:class nltl:propellerBlade ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each propeller blade load case must link to exactly one propeller blade.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propellerBladeLoadCaseBlade ] ; sh:xone ( [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each propeller blade load case must have one backward blade force or one forward blade force, but not both.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:backwardBladeForce ] [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each propeller blade load case must have one forward blade force or one backward blade force, but not both.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:forwardBladeForce ] ) ]. See details for more information." ;
            sh:resultPath nltl:hasPropellerBladeLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ a sh:NodeShape ;
                            sh:property [ sh:class nltl:iceBlock ;
                                    sh:maxCount 1 ;
                                    sh:message "Each propeller blade load case must link to exactly one ice block." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:propellerBladeLoadCaseIceBlock ],
                                [ sh:class nltl:propellerBlade ;
                                    sh:maxCount 1 ;
                                    sh:message "Each propeller blade load case must link to exactly one propeller blade." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:propellerBladeLoadCaseBlade ] ;
                            sh:xone ( [ sh:maxCount 1 ;
                                        sh:message "Each propeller blade load case must have one backward blade force or one forward blade force, but not both." ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class qudt:QuantityValue ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:backwardBladeForce ] [ sh:maxCount 1 ;
                                        sh:message "Each propeller blade load case must have one forward blade force or one backward blade force, but not both." ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:class qudt:QuantityValue ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:forwardBladeForce ] ) ] ;
                    sh:path nltl:hasPropellerBladeLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F01/case> ] .

