@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ;
            sh:resultMessage "The immersion function and ice load cycle coefficient do not satisfy the declared formulas; calculated decimal results use a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The immersion function and ice load cycle coefficient do not satisfy the declared formulas; calculated decimal results use a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?hIce ;
                      nltl:iceLoadCycleCoefficientK2 ?k2 ;
                      nltl:propellerDiameter ?diameter ;
                      nltl:propellerImmersionFunction ?fReported ;
                      nltl:propellerShaftCentrelineDepth ?h0 .

                ?hIce qudt:numericValue ?hIceValue .
                ?k2 qudt:numericValue ?k2Value .
                ?diameter qudt:numericValue ?diameterValue .
                ?fReported qudt:numericValue ?fReportedValue .
                ?h0 qudt:numericValue ?h0Value .

                BIND ((2 * (?h0Value - ?hIceValue) / ?diameterValue) - 1 AS ?fExpected)
                BIND (
                    IF(
                        ?fExpected < 0,
                        0.8 - ?fExpected,
                        IF(
                            ?fExpected <= 1,
                            0.8 - (0.4 * ?fExpected),
                            IF(
                                ?fExpected <= 2.5,
                                0.6 - (0.2 * ?fExpected),
                                0.1
                            )
                        )
                    ) AS ?k2Expected
                )

                FILTER (
                    ABS(?fReportedValue - ?fExpected) >
                    (ABS(?fExpected) * 0.000001 + 0.000000001)
                    ||
                    ABS(?k2Value - ?k2Expected) >
                    (ABS(?k2Expected) * 0.000001 + 0.000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_079_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ] .

