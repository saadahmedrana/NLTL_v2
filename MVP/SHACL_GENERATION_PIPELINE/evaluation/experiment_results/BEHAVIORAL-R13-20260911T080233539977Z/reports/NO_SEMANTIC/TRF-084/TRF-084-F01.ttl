@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ;
            sh:resultMessage "For a CP propeller with an unknown pitch value, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within a relative tolerance of 1e-6, with an absolute fallback of 1e-9 metres." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a CP propeller with an unknown pitch value, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within a relative tolerance of 1e-6, with an absolute fallback of 1e-9 metres." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType ?type ;
                      nltl:pitchValueKnown false .
                FILTER (?type = "CP"^^xsd:string)

                FILTER NOT EXISTS {
                    $this nltl:propellerPitchAtMcrFreeRunning ?free ;
                          nltl:propellerPitchAtMcrBollard ?bollard .
                    ?free qudt:numericValue ?freeValue ;
                          qudt:unit unit:M .
                    ?bollard qudt:numericValue ?bollardValue ;
                             qudt:unit unit:M .
                    FILTER (datatype(?freeValue) = xsd:decimal)
                    FILTER (datatype(?bollardValue) = xsd:decimal)
                    FILTER (
                        ABS(?bollardValue - (0.7 * ?freeValue)) <=
                        (0.000001 * ABS(0.7 * ?freeValue) + 0.000000001)
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-084> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/ship> ] .

