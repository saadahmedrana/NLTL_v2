@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bollardPropellerSpeedKnown" ;
            sh:resultPath nltl:bollardPropellerSpeedKnown ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:property [ sh:hasValue true ;
                                        sh:path nltl:bollardPropellerSpeedKnown ],
                                    [ sh:class qudt:QuantityValue ;
                                        sh:maxCount 1 ;
                                        sh:message "When bollard propeller speed is known, the known MCR bollard rotational speed must be recorded in revolutions per minute." ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ] ] [ sh:property [ sh:class nltl:tableLookupCase ;
                                        sh:minCount 1 ;
                                        sh:node [ sh:property [ ],
                                                    [ ],
                                                    [ ],
                                                    [ ] ] ;
                                        sh:path nltl:hasTableLookupCase ],
                                    [ sh:hasValue false ;
                                        sh:path nltl:bollardPropellerSpeedKnown ] ;
                                sh:sparql [ sh:message "When bollard propeller speed is unknown, a Table 6-9 lookup case must use the ship's propeller diameter as its lookup input." ;
                                        sh:select """
                        PREFIX nltl: <https://w3id.org/nltl/vocab#>
                        PREFIX qudt: <http://qudt.org/schema/qudt/>
                        PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                        SELECT $this
                        WHERE {
                            $this nltl:bollardPropellerSpeedKnown false .
                            FILTER NOT EXISTS {
                                $this nltl:propellerDiameter ?diameter .
                                ?diameter qudt:numericValue ?shipValue .
                                $this nltl:hasTableLookupCase ?case .
                                ?case nltl:lookupInputQuantity ?input .
                                ?input qudt:numericValue ?inputValue .
                                FILTER (
                                    xsd:decimal(?shipValue) =
                                    xsd:decimal(?inputValue)
                                )
                            }
                        }
                    """ ] ] ) ;
                    sh:path nltl:bollardPropellerSpeedKnown ] ] .

