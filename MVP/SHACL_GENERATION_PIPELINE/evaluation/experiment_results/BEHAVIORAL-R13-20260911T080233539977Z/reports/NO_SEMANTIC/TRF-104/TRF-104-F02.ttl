@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-F02/component0> ;
            sh:resultMessage "Loss of a propeller blade shall not cause significant damage to the propeller shaft line component." ;
            sh:resultPath nltl:significantDamageFromBladeLoss ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n3bac9b77d8be4e0692ac4c04f03da7c8b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-F02/component0> ;
            sh:resultMessage "Loss of a propeller blade shall not cause significant damage to the propeller shaft line component." ;
            sh:resultPath nltl:significantDamageFromBladeLoss ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n3bac9b77d8be4e0692ac4c04f03da7c8b2 ] .

_:n3bac9b77d8be4e0692ac4c04f03da7c8b2 sh:datatype xsd:boolean ;
    sh:hasValue false ;
    sh:maxCount 1 ;
    sh:message "Loss of a propeller blade shall not cause significant damage to the propeller shaft line component." ;
    sh:minCount 1 ;
    sh:path nltl:significantDamageFromBladeLoss .

