@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/bendingYieldSafetyFactorValue> ;
                            sh:resultMessage "Value is not >= Literal(\"1\", datatype=xsd:integer)" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 1 ;
                                    sh:path qudt:numericValue ] ;
                            sh:value 0.9 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/component> ;
                    sh:resultMessage "The propeller shaft line component shall have a bending yield safety factor of at least 1.0." ;
                    sh:resultPath nltl:bendingYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The propeller shaft line component shall have a bending yield safety factor of at least 1.0." ;
                            sh:minCount 1 ;
                            sh:node gen:TRF112BendingSafetyFactorValueShape ;
                            sh:path nltl:bendingYieldSafetyFactor ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/bendingYieldSafetyFactorValue> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/torsionalYieldSafetyFactorValue> ;
                            sh:resultMessage "Value is not >= Literal(\"1\", datatype=xsd:integer)" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 1 ;
                                    sh:path qudt:numericValue ] ;
                            sh:value 0.9 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/component> ;
                    sh:resultMessage "The propeller shaft line component shall have a torsional yield safety factor of at least 1.0." ;
                    sh:resultPath nltl:torsionalYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The propeller shaft line component shall have a torsional yield safety factor of at least 1.0." ;
                            sh:minCount 1 ;
                            sh:node gen:TRF112TorsionalSafetyFactorValueShape ;
                            sh:path nltl:torsionalYieldSafetyFactor ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/torsionalYieldSafetyFactorValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/ship> ;
            sh:resultMessage "The ship shall identify a propeller shaft line component with bending and torsional yield safety factors." ;
            sh:resultPath nltl:hasPropellerShaftLineComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify a propeller shaft line component with bending and torsional yield safety factors." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF112ShaftComponentShape ;
                    sh:path nltl:hasPropellerShaftLineComponent ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/component> ] .

