@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/impact> ;
                    sh:resultMessage "Node nltl:nonHemisphericalContactGeometry must conform to one or more shapes in [ sh:hasValue nltl:hemisphericalContactGeometry ] , [ sh:hasValue nltl:nonHemisphericalContactGeometry ; sh:property [ sh:class nltl:evidenceArtifact ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:contactGeometryCorrespondenceEvidence ] ]" ;
                    sh:resultPath nltl:contactGeometryClassification ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:or ( [ sh:hasValue nltl:hemisphericalContactGeometry ] [ sh:hasValue nltl:nonHemisphericalContactGeometry ;
                                        sh:property [ sh:class nltl:evidenceArtifact ;
                                                sh:minCount 1 ;
                                                sh:path nltl:contactGeometryCorrespondenceEvidence ] ] ) ;
                            sh:path nltl:contactGeometryClassification ] ;
                    sh:value nltl:nonHemisphericalContactGeometry ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/thrusterBody> ;
                            sh:resultMessage "Less than 1 values on ex:thrusterBody->nltl:thrusterResistanceCapacity" ;
                            sh:resultPath nltl:thrusterResistanceCapacity ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thrusterResistanceCapacity ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/impact> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterResistanceCapacity ] ]. See details for more information." ;
                    sh:resultPath nltl:thrusterImpactCaseAppliesToBody ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:thrusterBody ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ],
                                                        [ sh:datatype xsd:decimal ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:thrusterResistanceCapacity ] ] ;
                            sh:path nltl:thrusterImpactCaseAppliesToBody ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/thrusterBody> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:class nltl:evidenceArtifact ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:thrusterIceImpactLoadedAreaEvidence ], [ sh:class nltl:thrusterBody ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterResistanceCapacity ] ] ; sh:path nltl:thrusterImpactCaseAppliesToBody ], [ sh:hasValue nltl:traficomTable6Dash16Reference ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:impactLoadCaseTableReference ], [ sh:hasValue nltl:traficomTable6Dash3Reference ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:designIceBlockTableReference ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:iceOperatingSpeed ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterIceImpactDemand ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thrusterIceImpactLoad ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:or ( [ sh:hasValue nltl:hemisphericalContactGeometry ] [ sh:hasValue nltl:nonHemisphericalContactGeometry ; sh:property [ sh:class nltl:evidenceArtifact ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:contactGeometryCorrespondenceEvidence ] ] ) ; sh:path nltl:contactGeometryClassification ] ]. See details for more information." ;
            sh:resultPath nltl:hasThrusterIceImpactLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:thrusterIceImpactLoadCase ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thrusterIceImpactLoad ],
                                [ sh:minCount 1 ;
                                    sh:or ( [ sh:hasValue nltl:hemisphericalContactGeometry ] [ sh:hasValue nltl:nonHemisphericalContactGeometry ;
                                                sh:property [ ] ] ) ;
                                    sh:path nltl:contactGeometryClassification ],
                                [ sh:hasValue nltl:traficomTable6Dash16Reference ;
                                    sh:minCount 1 ;
                                    sh:path nltl:impactLoadCaseTableReference ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thrusterIceImpactDemand ],
                                [ sh:hasValue nltl:traficomTable6Dash3Reference ;
                                    sh:minCount 1 ;
                                    sh:path nltl:designIceBlockTableReference ],
                                [ sh:class nltl:evidenceArtifact ;
                                    sh:minCount 1 ;
                                    sh:path nltl:thrusterIceImpactLoadedAreaEvidence ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:iceOperatingSpeed ],
                                [ sh:class nltl:thrusterBody ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:thrusterResistanceCapacity ] ] ;
                                    sh:path nltl:thrusterImpactCaseAppliesToBody ] ] ;
                    sh:path nltl:hasThrusterIceImpactLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/impact> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/ship> ;
            sh:resultMessage "A non-hemispherical contact geometry requires an equivalent impact sphere radius on the ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A non-hemispherical contact geometry requires an equivalent impact sphere radius on the ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasThrusterIceImpactLoadCase ?case .
                ?case nltl:contactGeometryClassification nltl:nonHemisphericalContactGeometry .
                FILTER NOT EXISTS {
                    $this nltl:equivalentImpactSphereRadius ?radius .
                    ?radius qudt:numericValue ?value .
                    ?radius qudt:unit <http://qudt.org/vocab/unit/M> .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-114-ship> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-P02/ship> ] .

