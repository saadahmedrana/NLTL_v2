@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The air receiver additional-purpose applicability must be explicitly recorded as false when the additional-capacity condition does not apply.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:airReceiverServesAdditionalPurpose ] ] , [ sh:and ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The air receiver additional-purpose applicability must be explicitly recorded as true when additional capacity is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:airReceiverServesAdditionalPurpose ] ] [ sh:property [ sh:message Literal("An air receiver capacity in cubic metres is required when the receiver serves an additional purpose.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M3 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:airReceiverCapacity ] ] [ sh:property [ sh:message Literal("The required additional-purpose air capacity is required when the receiver serves an additional purpose.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:additionalPurposeRequiredAirCapacity ] ] [ sh:sparql [ sh:message Literal("Air receiver capacity must be at least the capacity required for additional purposes.") ; sh:select Literal("
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:airReceiverCapacity ?capacity .
                                ?capacity qudt:numericValue ?capacityValue .
                                $this nltl:additionalPurposeRequiredAirCapacity ?required .
                                ?required qudt:numericValue ?requiredValue .
                                FILTER ( ?capacityValue < ?requiredValue )
                            }
                        ") ] ] ) ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF127_AirReceiverAdditionalCapacityShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F04/ship> ] .

