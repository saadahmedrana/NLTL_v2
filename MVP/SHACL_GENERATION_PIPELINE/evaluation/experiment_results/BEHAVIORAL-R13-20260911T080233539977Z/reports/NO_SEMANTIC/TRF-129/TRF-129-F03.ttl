@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-129-F03/ship> ;
            sh:resultMessage "The cooling-water-supply requirement applies when the ship is navigating in ice." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_129_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-129-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-129-F03/ship> ;
            sh:resultMessage "The navigating-in-ice applicability state is required." ;
            sh:resultPath nltl:navigatingInIce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "The navigating-in-ice applicability state is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:navigatingInIce ] ] .

