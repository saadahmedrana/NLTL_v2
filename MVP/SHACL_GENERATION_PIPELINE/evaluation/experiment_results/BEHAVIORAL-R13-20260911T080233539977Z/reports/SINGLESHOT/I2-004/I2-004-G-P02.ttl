@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-P02/ship> ;
            sh:resultMessage "The upper ice waterline displacement must equal a waterline case displacement and must not be less than any linked case displacement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The upper ice waterline displacement must equal a waterline case displacement and must not be less than any linked case displacement." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?duiNode .
                ?duiNode qudt:numericValue ?duiValue .

                $this nltl:hasUpperIceWaterlineCase ?case .
                ?case nltl:waterlineCaseDisplacement ?caseDisplacement .
                ?caseDisplacement qudt:numericValue ?caseValue .
                FILTER (?caseValue = ?duiValue)

                FILTER NOT EXISTS {
                    $this nltl:hasUpperIceWaterlineCase ?otherCase .
                    ?otherCase nltl:waterlineCaseDisplacement ?otherDisplacement .
                    ?otherDisplacement qudt:numericValue ?otherValue .
                    FILTER (?otherValue > ?duiValue)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_004_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-P02/ship> ] .

