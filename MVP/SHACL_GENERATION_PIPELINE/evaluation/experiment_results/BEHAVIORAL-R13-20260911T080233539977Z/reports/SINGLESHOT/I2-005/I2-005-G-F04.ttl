@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasBottomRegionLowerRegionBoundaryPoint" ;
            sh:resultPath nltl:hasBottomRegionLowerRegionBoundaryPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:hullBoundaryPoint ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:DEG ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxInclusive 7.0 ;
                                                    sh:minCount 1 ;
                                                    sh:minInclusive 7.0 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:shellInclinationAngle ] ] ;
                    sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ] ] .

