@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:asternIceOperationIntent ] ] , [ sh:property [ sh:datatype xsd:string ; sh:message Literal(\"When astern ice operation is intended, the aft section design basis must be recorded.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:aftSectionDesignBasis ], [ sh:datatype xsd:string ; sh:message Literal(\"When astern ice operation is intended, the applicable hull area requirement set must be recorded.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hullAreaRequirementSet ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:asternIceOperationIntent ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-006_Static> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F02/ship> ] .

