@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:bulbousBowPresent ], [ sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ; sh:path nltl:polarClass ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxInclusive Literal("1.3", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("1.3", datatype=xsd:decimal) ; sh:path q:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:loadPatchAspectRatio ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:bowDesignForce ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaN> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path q:unit ] ] ; sh:path nltl:shapeCoefficient ] ; sh:sparql [ sh:message Literal("For an applicable PC6 or PC7 ship with a bulbous bow, the bow design force must correspond to the force determined under I2.3.2.1(iv), within a relative tolerance of 1e-6 with a small absolute fallback, and must not be less than the I2.3.2.1(iii) force.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX q: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:polarClass ?pc ;
                              nltl:bulbousBowPresent true ;
                              nltl:bowDesignForce ?result ;
                              nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?partIii ;
                              nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?partIv .

                        FILTER (
                            ?pc = nltl:polarClassPc6 ||
                            ?pc = nltl:polarClassPc7
                        )

                        ?result q:numericValue ?resultValue ;
                                q:unit <http://qudt.org/vocab/unit/KiloN> .
                        ?partIii q:numericValue ?partIiiValue ;
                                 q:unit <http://qudt.org/vocab/unit/MegaN> .
                        ?partIv q:numericValue ?partIvValue ;
                                q:unit <http://qudt.org/vocab/unit/MegaN> .

                        BIND (?partIvValue * 1000 AS ?expectedValue)
                        FILTER (
                            ?resultValue < ?partIiiValue * 1000 ||
                            ABS(?resultValue - ?expectedValue) >
                                (ABS(?expectedValue) * 0.000001 + 0.000001)
                        )
                    }
                ") ] ] , [ sh:or ( [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:bulbousBowPresent ] ] [ sh:property [ sh:in ( nltl:polarClassPc1 nltl:polarClassPc2 nltl:polarClassPc3 nltl:polarClassPc4 nltl:polarClassPc5 ) ; sh:path nltl:polarClass ] ] ) ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-011> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F04/ship> ] .

