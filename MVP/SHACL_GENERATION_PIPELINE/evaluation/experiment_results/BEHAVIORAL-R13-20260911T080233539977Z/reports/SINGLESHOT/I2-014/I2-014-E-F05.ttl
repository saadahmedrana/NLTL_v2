@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "The selected maximum bow force, line load, and pressure must equal the corresponding maxima reported for the four bow subregion calculation cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The selected maximum bow force, line load, and pressure must equal the corresponding maxima reported for the four bow subregion calculation cases." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce/qudt:numericValue ?selectedForce ;
                      nltl:selectedMaximumBowLineLoad/qudt:numericValue ?selectedLineLoad ;
                      nltl:selectedMaximumBowPressure/qudt:numericValue ?selectedPressure .

                FILTER (
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?caseForce .
                        ?caseForce nltl:bowSubregionCalculatedForce/qudt:numericValue ?force .
                        FILTER (?force > ?selectedForce)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?caseLineLoad .
                        ?caseLineLoad nltl:bowSubregionCalculatedLineLoad/qudt:numericValue ?lineLoad .
                        FILTER (?lineLoad > ?selectedLineLoad)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?casePressure .
                        ?casePressure nltl:bowSubregionCalculatedPressure/qudt:numericValue ?pressure .
                        FILTER (?pressure > ?selectedPressure)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?equalForceCase .
                        ?equalForceCase nltl:bowSubregionCalculatedForce/qudt:numericValue ?equalForce .
                        FILTER (?equalForce = ?selectedForce)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?equalLineLoadCase .
                        ?equalLineLoadCase nltl:bowSubregionCalculatedLineLoad/qudt:numericValue ?equalLineLoad .
                        FILTER (?equalLineLoad = ?selectedLineLoad)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?equalPressureCase .
                        ?equalPressureCase nltl:bowSubregionCalculatedPressure/qudt:numericValue ?equalPressure .
                        FILTER (?equalPressure = ?selectedPressure)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-014> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "The bow region must have a bow subregion count of exactly four." ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:maxInclusive 4 ;
                    sh:message "The bow region must have a bow subregion count of exactly four." ;
                    sh:minCount 1 ;
                    sh:minInclusive 4 ;
                    sh:path nltl:bowSubregionCount ] ] .

