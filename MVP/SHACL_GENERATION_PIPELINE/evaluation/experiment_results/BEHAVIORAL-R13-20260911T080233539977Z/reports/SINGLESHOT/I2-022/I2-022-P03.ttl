    ?quantity qudt:numericValue ?value .
    FILTER (datatype(?value) = xsd:decimal)
    FILTER (?value >= 70)
}
") ] ]""" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-022-PlatingShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P03/plating> ] ;
