@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/upperEndpoint> ;
            sh:resultMessage "The calculation case must provide longitudinal framing net plate thickness in millimetres." ;
            sh:resultPath nltl:longitudinalFramingNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n39e2b297a85249f59269ea2a5e6ae301b20 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/lowerEndpoint> ;
            sh:resultMessage "The calculation case must provide longitudinal framing net plate thickness in millimetres." ;
            sh:resultPath nltl:longitudinalFramingNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n39e2b297a85249f59269ea2a5e6ae301b20 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/lowerEndpoint> ;
            sh:resultMessage "The calculation case must provide transverse framing net plate thickness in millimetres." ;
            sh:resultPath nltl:transverseFramingNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n39e2b297a85249f59269ea2a5e6ae301b24 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/upperEndpoint> ;
            sh:resultMessage "The calculation case must provide transverse framing net plate thickness in millimetres." ;
            sh:resultPath nltl:transverseFramingNetPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n39e2b297a85249f59269ea2a5e6ae301b24 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/case> ;
                    sh:resultMessage "An oblique plating interpolation case must have a framing angle strictly between 20 and 70 degrees." ;
                    sh:resultPath nltl:framingAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "An oblique plating interpolation case must have a framing angle strictly between 20 and 70 degrees." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:maxExclusive 70 ;
                                            sh:minCount 1 ;
                                            sh:minExclusive 20 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:framingAngle ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-024-ObliqueCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasObliquePlatingInterpolationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-024-ObliqueCaseShape> ;
                    sh:path nltl:hasObliquePlatingInterpolationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F03/case> ] .

_:N1f826d5c94074495a4c066514f5de514 sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:N7142e32e86734441afffc6b94a6fe0e0 sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

_:Nb3dfcab44d514ff191ff6fee7696315d sh:property _:N7142e32e86734441afffc6b94a6fe0e0,
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ] .

_:n39e2b297a85249f59269ea2a5e6ae301b20 sh:maxCount 1 ;
    sh:message "The calculation case must provide longitudinal framing net plate thickness in millimetres." ;
    sh:minCount 1 ;
    sh:node _:Nb3dfcab44d514ff191ff6fee7696315d ;
    sh:path nltl:longitudinalFramingNetPlateThickness .

_:n39e2b297a85249f59269ea2a5e6ae301b24 sh:maxCount 1 ;
    sh:message "The calculation case must provide transverse framing net plate thickness in millimetres." ;
    sh:minCount 1 ;
    sh:node _:N1f826d5c94074495a4c066514f5de514 ;
    sh:path nltl:transverseFramingNetPlateThickness .

