@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F02/case> ;
            sh:resultMessage "The calculation case must exclude attached shell plating from the shear area." ;
            sh:resultPath nltl:attachedShellPlatingExcludedFromShearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nc9613365bdab4b3bbf101ba947950c17b3 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F02/case> ;
                    sh:resultMessage "The calculation case must exclude attached shell plating from the shear area." ;
                    sh:resultPath nltl:attachedShellPlatingExcludedFromShearArea ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nc9613365bdab4b3bbf101ba947950c17b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_029_CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:node gen:I2_029_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F02/case> ] .

_:nc9613365bdab4b3bbf101ba947950c17b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The calculation case must exclude attached shell plating from the shear area." ;
    sh:minCount 1 ;
    sh:path nltl:attachedShellPlatingExcludedFromShearArea .

