@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F06/calc> ;
                    sh:resultMessage "Less than 1 values on ex:calc->nltl:interpolationLowerEndpoint" ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-030-InterpolationPointShape> ;
                            sh:path nltl:interpolationLowerEndpoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F06/ship> ;
            sh:resultMessage "The ship must provide a calculation case containing the required external calculation inputs and results." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "The ship must provide a calculation case containing the required external calculation inputs and results." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-030-CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F06/calc> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F06/ship> ;
            sh:resultMessage "The ship must identify the structural member to which the local-frame calculation applies." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:message "The ship must identify the structural member to which the local-frame calculation applies." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-030-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ] .

