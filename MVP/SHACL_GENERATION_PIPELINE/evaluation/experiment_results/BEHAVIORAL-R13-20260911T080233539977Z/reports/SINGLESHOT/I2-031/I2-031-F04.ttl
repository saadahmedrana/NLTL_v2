@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/ship> ;
            sh:resultMessage "The ship must identify the plastic collapse mechanism used to define plastic strength." ;
            sh:resultPath nltl:plasticCollapseMechanism ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship must identify the plastic collapse mechanism used to define plastic strength." ;
                    sh:minCount 1 ;
                    sh:path nltl:plasticCollapseMechanism ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/loadcase> ;
                            sh:resultMessage "For bottom-structure loading, patch-load dimension b must be parallel with the frame direction." ;
                            sh:resultPath nltl:loadPatchOrientation ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n953fa29be3ca4849b950c701d60be033b16 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/loadcase> ;
                            sh:resultMessage "The load case must provide the combined shear and bending demand in kN." ;
                            sh:resultPath nltl:combinedShearAndBendingDemand ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "The load case must provide the combined shear and bending demand in kN." ;
                                    sh:minCount 1 ;
                                    sh:node gen:I2_031_KiloNewtonQuantityShape ;
                                    sh:path nltl:combinedShearAndBendingDemand ] ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/loadcase> ;
                            sh:resultMessage "For bottom-structure loading, patch-load dimension b must be parallel with the frame direction." ;
                            sh:resultPath nltl:loadPatchOrientation ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:n953fa29be3ca4849b950c701d60be033b16 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/member> ;
                    sh:resultMessage "The structural member must provide a load case for the I2-031 assessment." ;
                    sh:resultPath nltl:hasStructuralMemberLoadCase ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "The structural member must provide a load case for the I2-031 assessment." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_031_LoadCaseShape ;
                            sh:path nltl:hasStructuralMemberLoadCase ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/loadcase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/ship> ;
            sh:resultMessage "Each linked structural member must provide the required I2-031 structural-member data." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked structural member must provide the required I2-031 structural-member data." ;
                    sh:node gen:I2_031_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/ship> ;
            sh:resultMessage "The ship must provide the patch load in kN." ;
            sh:resultPath nltl:patchLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the patch load in kN." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_031_KiloNewtonQuantityShape ;
                    sh:path nltl:patchLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F04/ship> ;
            sh:resultMessage "The ship must identify the frame profile type." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype nltl:frameProfileTypeValue ;
                    sh:maxCount 1 ;
                    sh:message "The ship must identify the frame profile type." ;
                    sh:minCount 1 ;
                    sh:path nltl:frameProfileType ] ] .

_:n953fa29be3ca4849b950c701d60be033b16 sh:hasValue nltl:loadPatchHeightParallelToFrame ;
    sh:maxCount 1 ;
    sh:message "For bottom-structure loading, patch-load dimension b must be parallel with the frame direction." ;
    sh:minCount 1 ;
    sh:path nltl:loadPatchOrientation .

