@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F02/ship> ;
            sh:resultMessage "steelRenewalRequired must be true exactly when gaugedThickness is less than netThickness plus 0.5 mm." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "steelRenewalRequired must be true exactly when gaugedThickness is less than netThickness plus 0.5 mm." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:gaugedThickness ?gaugedQuantity ;
                      nltl:netThickness ?netQuantity ;
                      nltl:steelRenewalRequired ?renewal .
                ?gaugedQuantity qudt:numericValue ?gauged .
                ?netQuantity qudt:numericValue ?net .
                FILTER (
                    (?renewal = true && ! (?gauged < (?net + 0.0005))) ||
                    (?renewal = false && (?gauged < (?net + 0.0005)))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-047> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F02/ship> ] .

