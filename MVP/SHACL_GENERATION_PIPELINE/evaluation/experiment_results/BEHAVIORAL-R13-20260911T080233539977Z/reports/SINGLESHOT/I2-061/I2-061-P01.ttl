@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/structure> ;
                            sh:resultMessage "Less than 1 values on ex:structure->nltl:thickness" ;
                            sh:resultPath nltl:thickness ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:I2-061-ThicknessQuantityShape> ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:thickness ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/case> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-HullStructureShape>. See details for more information." ;
                    sh:resultPath nltl:calculationCaseAssessedHullStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:hullStructure ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-061-HullStructureShape> ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:calculationCaseAssessedHullStructure ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/structure> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-CalculationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:node <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P01/case> ] .

