@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/calculation> ;
                    sh:resultMessage "Node ex:calculation->nltl:calculationMethod does not contain a value in the set: ['nltl:linearCalculationMethodValue']" ;
                    sh:resultPath nltl:calculationMethod ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue nltl:linearCalculationMethodValue ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:calculationMethodValue ] ;
                            sh:path nltl:calculationMethod ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:calculationCase ; sh:property [ sh:hasValue nltl:linearCalculationMethodValue ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:calculationMethodValue ] ; sh:path nltl:calculationMethod ] ]. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:hasValue nltl:linearCalculationMethodValue ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:calculationMethodValue ] ;
                                    sh:path nltl:calculationMethod ] ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/calculation> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasStructuralMember" ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:structuralMember ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "Buckling criteria must be confirmed for the structural member." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:bucklingCriteriaSatisfied ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:structuralMemberWeb ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:nominalShearStress ] ] ;
                                    sh:path nltl:hasStructuralMemberWeb ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:structuralMemberFlange ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:nominalFlangeVonMisesStress ] ] ;
                                    sh:path nltl:hasStructuralMemberFlange ] ] ;
                    sh:path nltl:hasStructuralMember ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-P02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:yieldStrength" ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:yieldStrength ] ] .

