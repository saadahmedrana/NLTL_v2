@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "A nonlinear calculation case requires valid dimensionless fracture, major buckling, and yielding margins on the ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A nonlinear calculation case requires valid dimensionless fracture, major buckling, and yielding margins on the ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                FILTER (
                    NOT EXISTS {
                        $this nltl:fractureMargin ?fracture .
                        ?fracture qudt:numericValue ?fractureValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (DATATYPE(?fractureValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:majorBucklingMargin ?buckling .
                        ?buckling qudt:numericValue ?bucklingValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (DATATYPE(?bucklingValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:yieldingMargin ?yielding .
                        ?yielding qudt:numericValue ?yieldingValue ;
                                 qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (DATATYPE(?yieldingValue) = xsd:decimal)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-065-Readiness> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/calculation> ;
                    sh:resultMessage "Node ex:calculation must conform to one or more shapes in [ sh:property [ sh:class nltl:evidenceArtifact ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:nonlinearAnalysisAcceptanceEvidence ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:minorPermanentDeformationAssessmentSatisfied ], [ sh:hasValue nltl:nonlinearCalculationMethodValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:calculationMethod ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:permanentLateralDeformation ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:permanentOutOfPlaneDeformation ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:relevantStructuralDimension ] ] , [ sh:property [ sh:hasValue nltl:directCalculationMethodValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:calculationMethod ] ] , [ sh:property [ sh:hasValue nltl:linearCalculationMethodValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:calculationMethod ] ] , [ sh:property [ sh:hasValue nltl:prescribedAnalyticalProcedure ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:calculationMethod ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:calculationCase ;
                            sh:or ( [ sh:property [ sh:class nltl:evidenceArtifact ;
                                                sh:minCount 1 ;
                                                sh:path nltl:nonlinearAnalysisAcceptanceEvidence ],
                                            [ sh:hasValue nltl:nonlinearCalculationMethodValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:calculationMethod ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:minorPermanentDeformationAssessmentSatisfied ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class qudt:QuantityValue ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:permanentLateralDeformation ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class qudt:QuantityValue ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:relevantStructuralDimension ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class qudt:QuantityValue ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:permanentOutOfPlaneDeformation ] ] [ sh:property [ sh:hasValue nltl:directCalculationMethodValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:calculationMethod ] ] [ sh:property [ sh:hasValue nltl:linearCalculationMethodValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:calculationMethod ] ] [ sh:property [ sh:hasValue nltl:prescribedAnalyticalProcedure ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:calculationMethod ] ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/calculation> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:calculationCase ; sh:or ( [ sh:property [ sh:class nltl:evidenceArtifact ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:nonlinearAnalysisAcceptanceEvidence ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:minorPermanentDeformationAssessmentSatisfied ], [ sh:hasValue nltl:nonlinearCalculationMethodValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:calculationMethod ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:permanentLateralDeformation ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:permanentOutOfPlaneDeformation ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:relevantStructuralDimension ] ] [ sh:property [ sh:hasValue nltl:directCalculationMethodValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:calculationMethod ] ] [ sh:property [ sh:hasValue nltl:linearCalculationMethodValue ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:calculationMethod ] ] [ sh:property [ sh:hasValue nltl:prescribedAnalyticalProcedure ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:calculationMethod ] ] ) ]. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:calculationCase ;
                            sh:or ( [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:relevantStructuralDimension ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:minorPermanentDeformationAssessmentSatisfied ],
                                            [ sh:class nltl:evidenceArtifact ;
                                                sh:minCount 1 ;
                                                sh:path nltl:nonlinearAnalysisAcceptanceEvidence ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:permanentOutOfPlaneDeformation ],
                                            [ sh:hasValue nltl:nonlinearCalculationMethodValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:calculationMethod ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:permanentLateralDeformation ] ] [ sh:property [ sh:hasValue nltl:directCalculationMethodValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:calculationMethod ] ] [ sh:property [ sh:hasValue nltl:linearCalculationMethodValue ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:calculationMethod ] ] [ sh:property [ sh:hasValue nltl:prescribedAnalyticalProcedure ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:calculationMethod ] ] ) ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/calculation> ] .

