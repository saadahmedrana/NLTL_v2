@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F02/connection2> ;
                    sh:resultMessage "Each structural connection must have strength continuity ensured." ;
                    sh:resultPath nltl:strengthContinuityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "Each structural connection must have strength continuity ensured." ;
                            sh:minCount 1 ;
                            sh:path nltl:strengthContinuityStatus ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each structural connection must have strength continuity ensured.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:strengthContinuityStatus ] ]. See details for more information." ;
            sh:resultPath nltl:structuralConnection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:benchmarkEntity ;
                    sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "Each structural connection must have strength continuity ensured." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:strengthContinuityStatus ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:structuralConnection ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-F02/connection2> ] .

