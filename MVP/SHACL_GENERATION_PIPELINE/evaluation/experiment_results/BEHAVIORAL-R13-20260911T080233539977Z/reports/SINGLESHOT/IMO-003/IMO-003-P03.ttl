@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-P03/ship> ;
            sh:resultMessage "A ship shall declare a permitted design ice condition for this rule." ;
            sh:resultPath nltl:designIceCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:openWaterIceCondition nltl:iceConditionLessSevereThanCategoryAAndB ) ;
                    sh:message "A ship shall declare a permitted design ice condition for this rule." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:designIceCondition ] ;
            sh:value nltl:mediumFirstYearIceWithPossibleOldIceInclusions ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-P03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:openWaterIceCondition ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:designIceCondition ], [ sh:in ( nltl:polarShipCategoryC ) ; sh:message Literal(\"A ship designed for open water shall have Polar Code category C.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:shipCategory ] ] , [ sh:property [ sh:hasValue nltl:iceConditionLessSevereThanCategoryAAndB ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:designIceCondition ], [ sh:in ( nltl:polarShipCategoryC ) ; sh:message Literal(\"A ship designed for ice conditions less severe than categories A and B shall have Polar Code category C.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:shipCategory ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO003ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-P03/ship> ] .

