@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-005-F01/ship> ;
            sh:resultMessage "A ship identified as being in ice free waters must record totalIcePresent as false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship identified as being in ice free waters must record totalIcePresent as false." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:iceCondition ?condition .
                FILTER (?condition = "ice free waters")
                FILTER NOT EXISTS {
                    $this nltl:totalIcePresent ?presence .
                    FILTER (?presence = false)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_005_IceFreeWatersShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-005-F01/ship> ] .

