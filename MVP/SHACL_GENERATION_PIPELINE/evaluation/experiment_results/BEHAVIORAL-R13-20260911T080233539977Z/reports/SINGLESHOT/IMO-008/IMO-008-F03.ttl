@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-F03/ship> ;
            sh:resultMessage "For thin first-year ice, ice thickness must be a decimal quantity in metres between 0.3 m and 0.7 m inclusive." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For thin first-year ice, ice thickness must be a decimal quantity in metres between 0.3 m and 0.7 m inclusive." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceTypeClassification nltl:thinFirstYearIce .
                FILTER (
                    NOT EXISTS {
                        $this nltl:iceThickness ?quantity .
                        ?quantity qudt:numericValue ?value ;
                                  qudt:unit unit:M .
                        FILTER (
                            datatype(?value) = xsd:decimal &&
                            ?value >= "0.3"^^xsd:decimal &&
                            ?value <= "0.7"^^xsd:decimal
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:iceThickness ?quantity .
                        FILTER NOT EXISTS {
                            ?quantity qudt:numericValue ?value ;
                                      qudt:unit unit:M .
                            FILTER (
                                datatype(?value) = xsd:decimal &&
                                ?value >= "0.3"^^xsd:decimal &&
                                ?value <= "0.7"^^xsd:decimal
                            )
                        }
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-008_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-F03/ship> ] .

