@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F01/obs1> ;
                    sh:resultMessage "Less than 1 values on ex:obs1->nltl:dailyTemperatureObservationDate" ;
                    sh:resultPath nltl:dailyTemperatureObservationDate ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:date ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:dailyTemperatureObservationDate ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:dailyLowTemperatureObservation ; sh:property [ sh:datatype xsd:date ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:dailyTemperatureObservationDate ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:dailyLowTemperature ] ]. See details for more information." ;
            sh:resultPath nltl:hasDailyLowTemperatureObservation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:dailyLowTemperatureObservation ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:dailyLowTemperature ],
                                [ sh:datatype xsd:date ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:dailyTemperatureObservationDate ] ] ;
                    sh:path nltl:hasDailyLowTemperatureObservation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F01/obs1> ] .

