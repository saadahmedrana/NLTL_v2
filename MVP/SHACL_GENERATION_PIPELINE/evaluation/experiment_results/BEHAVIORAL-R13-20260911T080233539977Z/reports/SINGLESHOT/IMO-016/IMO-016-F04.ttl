@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F04/ship> ;
            sh:resultMessage "The certificate language must be recorded." ;
            sh:resultPath nltl:certificateLanguage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The certificate language must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:certificateLanguage ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasPolarShipCertificate" ;
            sh:resultPath nltl:hasPolarShipCertificate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarShipCertificateForm ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue nltl:appendixIPolarShipCertificateModel ;
                                    sh:maxCount 1 ;
                                    sh:message "The Polar Ship Certificate shall use the Appendix I model." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:certificateFormModel ] ] ;
                    sh:path nltl:hasPolarShipCertificate ] ] .

