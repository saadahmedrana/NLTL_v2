@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "A Polar Certificate supplement with required equipment records is required." ;
            sh:resultPath nltl:hasPolarCertificateSupplement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarCertificateSupplement ;
                    sh:message "A Polar Certificate supplement with required equipment records is required." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-017-SupplementShape> ;
                    sh:path nltl:hasPolarCertificateSupplement ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "The Polar Ship Certificate shall include a supplement." ;
            sh:resultPath nltl:polarCertificateSupplementPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:naf731407f12242d0bb055b207226ed6db4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "The Polar Ship Certificate shall include a supplement." ;
            sh:resultPath nltl:polarCertificateSupplementPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:naf731407f12242d0bb055b207226ed6db4 ] .

_:naf731407f12242d0bb055b207226ed6db4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The Polar Ship Certificate shall include a supplement." ;
    sh:minCount 1 ;
    sh:path nltl:polarCertificateSupplementPresent .

