@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F01/ship> ;
            sh:resultMessage "Polar service temperature must be at least 10 degrees Celsius below the lowest MDLT." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Polar service temperature must be at least 10 degrees Celsius below the lowest MDLT." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true ;
                      nltl:polarServiceTemperature ?pstQuantity ;
                      nltl:lowestMdlt ?mdltQuantity .
                ?pstQuantity qudt:numericValue ?pst .
                ?mdltQuantity qudt:numericValue ?mdlt .
                FILTER (?pst > (?mdlt - "10"^^xsd:decimal))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_019_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F01/ship> ] .

