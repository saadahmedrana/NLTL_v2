@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-028-F03/ship> ;
            sh:resultMessage "The ship's ice-strengthening status is required to determine the applicable entrapment-procedure obligation." ;
            sh:resultPath nltl:shipIceStrengthened ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "The ship's ice-strengthening status is required to determine the applicable entrapment-procedure obligation." ;
                    sh:minCount 1 ;
                    sh:path nltl:shipIceStrengthened ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-028-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:shipIceStrengthened ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"An ice-strengthened ship's PWOM must include prolonged-ice-entrapment life-support and ship-integrity procedures.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:prolongedEntrapmentProcedurePresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:shipIceStrengthened ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO028Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-028-F03/ship> ] .

