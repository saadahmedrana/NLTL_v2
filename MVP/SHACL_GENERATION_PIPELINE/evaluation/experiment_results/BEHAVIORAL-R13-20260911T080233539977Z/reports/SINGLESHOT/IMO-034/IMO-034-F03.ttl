@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-034-F03/ship> ;
            sh:resultMessage "When ice accretion is likely, the ship must have ice-accretion minimization design and required ice-removal means, including the administration-required means." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_034_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-034-F03/ship> ] .

