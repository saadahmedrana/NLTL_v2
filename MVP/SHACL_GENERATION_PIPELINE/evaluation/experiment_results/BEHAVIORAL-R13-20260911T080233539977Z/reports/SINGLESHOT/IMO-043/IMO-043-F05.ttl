@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/ship> ;
            sh:resultMessage "The ship shall record hazard protection coverage." ;
            sh:resultPath nltl:hazardProtectionCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nadf330dfa373406987c6b6892a800576b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/ship> ;
            sh:resultMessage "The ship shall record hazard protection coverage." ;
            sh:resultPath nltl:hazardProtectionCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nadf330dfa373406987c6b6892a800576b1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/mainMachinery> ;
                    sh:resultMessage "Each machinery installation shall have hazard protection evidence." ;
                    sh:resultPath nltl:hasHazardProtectionEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                            sh:message "Each machinery installation shall have hazard protection evidence." ;
                            sh:minCount 1 ;
                            sh:path nltl:hasHazardProtectionEvidence ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:class nltl:associatedEquipmentItem ; sh:path nltl:hasAssociatedEquipment ], [ sh:class nltl:evidenceArtifact ; sh:message Literal(\"Each machinery installation shall have hazard protection evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasHazardProtectionEvidence ], [ sh:in ( nltl:iceAccretionHazard nltl:snowAccumulationHazard nltl:seawaterIceIngestionHazard nltl:liquidFreezingOrViscosityIncreaseHazard nltl:seawaterIntakeTemperatureHazard nltl:snowIngestionHazard ) ; sh:message Literal(\"Each applicable hazard shall be one of the permitted Polar Code hazards.\") ; sh:path nltl:hasApplicableHazard ] ]. See details for more information." ;
            sh:resultPath nltl:hasMachineryInstallation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:property [ sh:class nltl:evidenceArtifact ;
                                    sh:message "Each machinery installation shall have hazard protection evidence." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:hasHazardProtectionEvidence ],
                                [ sh:in ( nltl:iceAccretionHazard nltl:snowAccumulationHazard nltl:seawaterIceIngestionHazard nltl:liquidFreezingOrViscosityIncreaseHazard nltl:seawaterIntakeTemperatureHazard nltl:snowIngestionHazard ) ;
                                    sh:message "Each applicable hazard shall be one of the permitted Polar Code hazards." ;
                                    sh:path nltl:hasApplicableHazard ],
                                [ sh:class nltl:associatedEquipmentItem ;
                                    sh:path nltl:hasAssociatedEquipment ] ] ;
                    sh:path nltl:hasMachineryInstallation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/mainMachinery> ] .

_:nadf330dfa373406987c6b6892a800576b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship shall record hazard protection coverage." ;
    sh:minCount 1 ;
    sh:path nltl:hazardProtectionCoverage .

