@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-P02/ship> ;
            sh:resultMessage "Combustion-air temperature control must be recorded as present." ;
            sh:resultPath nltl:combustionAirTemperatureControlPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n9f548f99c5584c76a0fe84aec53088c7b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-P02/ship> ;
            sh:resultMessage "Combustion-air temperature control must be recorded as present." ;
            sh:resultPath nltl:combustionAirTemperatureControlPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n9f548f99c5584c76a0fe84aec53088c7b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-P02/ship> ;
            sh:resultMessage "Combustion air temperature must be provided as a single degree-Celsius quantity." ;
            sh:resultPath nltl:combustionAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Combustion air temperature must be provided as a single degree-Celsius quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:DEG_C ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:combustionAirTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-P02/ship> ;
            sh:resultMessage "The manufacturer's maximum air temperature must be provided as a single degree-Celsius quantity." ;
            sh:resultPath nltl:manufacturerMaxAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The manufacturer's maximum air temperature must be provided as a single degree-Celsius quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:DEG_C ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:manufacturerMaxAirTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-P02/ship> ;
            sh:resultMessage "The manufacturer's minimum air temperature must be provided as a single degree-Celsius quantity." ;
            sh:resultPath nltl:manufacturerMinAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The manufacturer's minimum air temperature must be provided as a single degree-Celsius quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:DEG_C ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:manufacturerMinAirTemperature ] ] .

_:n9f548f99c5584c76a0fe84aec53088c7b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Combustion-air temperature control must be recorded as present." ;
    sh:minCount 1 ;
    sh:path nltl:combustionAirTemperatureControlPresent .

