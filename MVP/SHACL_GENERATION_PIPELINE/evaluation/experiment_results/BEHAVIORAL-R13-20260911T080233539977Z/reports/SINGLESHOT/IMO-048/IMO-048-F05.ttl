@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F05/ship> ;
            sh:resultMessage "The ship must identify the exposed machinery or foundation material covered by the approval." ;
            sh:resultPath nltl:exposedMachineryOrFoundationMaterial ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must identify the exposed machinery or foundation material covered by the approval." ;
                    sh:minCount 1 ;
                    sh:path nltl:exposedMachineryOrFoundationMaterial ] ] .

