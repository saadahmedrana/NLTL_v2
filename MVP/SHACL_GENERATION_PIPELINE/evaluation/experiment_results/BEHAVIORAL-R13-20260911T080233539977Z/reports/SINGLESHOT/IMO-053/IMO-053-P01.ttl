@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-P01/waterMist> ;
                    sh:resultMessage "Each linked extinguishing medium must have approved compatibility status." ;
                    sh:resultPath nltl:extinguishingMediumCompatibilityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n1e21a3e1dacf4ccd9b141afe5101c767b3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-P01/waterMist> ;
                    sh:resultMessage "Each linked extinguishing medium must have approved compatibility status." ;
                    sh:resultPath nltl:extinguishingMediumCompatibilityStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n1e21a3e1dacf4ccd9b141afe5101c767b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-P01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Each linked extinguishing medium must have approved compatibility status.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extinguishingMediumCompatibilityStatus ] ]. See details for more information." ;
            sh:resultPath nltl:hasExtinguishingMedium ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:message "Each linked extinguishing medium must have approved compatibility status." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:extinguishingMediumCompatibilityStatus ] ] ;
                    sh:path nltl:hasExtinguishingMedium ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-P01/waterMist> ] .

_:n1e21a3e1dacf4ccd9b141afe5101c767b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "Each linked extinguishing medium must have approved compatibility status." ;
    sh:minCount 1 ;
    sh:path nltl:extinguishingMediumCompatibilityStatus .

