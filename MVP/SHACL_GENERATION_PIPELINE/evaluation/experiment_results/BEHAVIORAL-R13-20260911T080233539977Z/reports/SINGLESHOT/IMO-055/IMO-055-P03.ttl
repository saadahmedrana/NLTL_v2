@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-P03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"Valve exposure must be recorded as false for the non-applicable branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:valveExposed ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"An exposed isolating, pressure, or vacuum valve must be protected from ice accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAccretionProtectionPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"An exposed isolating, pressure, or vacuum valve must remain continuously accessible.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:continuouslyAccessible ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Valve exposure must be recorded as true for an applicable valve.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:valveExposed ], [ sh:datatype xsd:string ; sh:in ( Literal(\"isolating\") Literal(\"pressure\") Literal(\"vacuum\") ) ; sh:message Literal(\"An exposed valve must be isolating, pressure, or vacuum type.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:valveType ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_055_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-P03/ship> ] .

