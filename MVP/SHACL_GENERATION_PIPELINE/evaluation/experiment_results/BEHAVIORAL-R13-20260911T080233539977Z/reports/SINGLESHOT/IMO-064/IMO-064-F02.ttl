@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F02/ship> ;
            sh:resultMessage "Assigned thermal-protection equipment must have approved adequacy evidence." ;
            sh:resultPath nltl:thermalProtectionApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceState ;
                    sh:hasValue nltl:evidenceStateApproved ;
                    sh:message "Assigned thermal-protection equipment must have approved adequacy evidence." ;
                    sh:minCount 1 ;
                    sh:path nltl:thermalProtectionApprovalStatus ] ] .

