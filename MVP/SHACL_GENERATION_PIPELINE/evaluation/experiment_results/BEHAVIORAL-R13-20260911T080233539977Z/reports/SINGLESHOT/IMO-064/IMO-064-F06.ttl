@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F06/ship> ;
            sh:resultMessage "Assigned thermal-protection equipment must have approved adequacy evidence." ;
            sh:resultPath nltl:thermalProtectionApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:na8e8a3f2b0d24676b5db6c96964d58ecb3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F06/ship> ;
            sh:resultMessage "Assigned thermal-protection equipment must have approved adequacy evidence." ;
            sh:resultPath nltl:thermalProtectionApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:na8e8a3f2b0d24676b5db6c96964d58ecb3 ] .

_:na8e8a3f2b0d24676b5db6c96964d58ecb3 sh:class nltl:evidenceState ;
    sh:hasValue nltl:evidenceStateApproved ;
    sh:message "Assigned thermal-protection equipment must have approved adequacy evidence." ;
    sh:minCount 1 ;
    sh:path nltl:thermalProtectionApprovalStatus .

