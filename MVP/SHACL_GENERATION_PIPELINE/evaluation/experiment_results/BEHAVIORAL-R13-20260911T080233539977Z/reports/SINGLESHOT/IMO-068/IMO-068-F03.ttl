@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:evidenceState ; sh:hasValue nltl:evidenceStateApproved ; sh:message Literal(\"Survival equipment deployment must have approved status when the rule applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:survivalEquipmentDeploymentApprovalStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"A ship operating in ice-covered waters must record safe evacuation means and approved survival equipment deployment.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipOperatesInIceCoveredWaters ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Safe evacuation means must be present when the rule applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:safeEvacuationMeansPresent ] ] , [ sh:property [ sh:class nltl:evidenceState ; sh:hasValue nltl:evidenceStateApproved ; sh:message Literal(\"Survival equipment deployment must have approved status when the rule applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:survivalEquipmentDeploymentApprovalStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Direct evacuation onto the ice must be recorded as applicable when that evacuation arrangement is used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:directEvacuationOntoIceApplicable ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Safe evacuation means must be present when the rule applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:safeEvacuationMeansPresent ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_068_ConditionalEvacuationShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-068-F03/ship> ] .

