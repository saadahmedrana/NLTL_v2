@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "Each person on board a passenger ship must have an assigned immersion suit or thermal protective aid." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each person on board a passenger ship must have an assigned immersion suit or thermal protective aid." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this WHERE {
                $this a nltl:passengerShip ;
                      nltl:hasPersonOnBoardMember ?person .
                FILTER NOT EXISTS {
                    ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment .
                    ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment .
                    ?equipment rdf:type ?equipmentType .
                    FILTER (?equipmentType IN (
                        nltl:immersionSuitEquipment,
                        nltl:thermalProtectiveAidEquipment
                    ))
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-070> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ;
            sh:resultMessage "A passenger ship must record that the assigned survival equipment is properly sized." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A passenger ship must record that the assigned survival equipment is properly sized." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this WHERE {
                $this a nltl:passengerShip .
                {
                    FILTER NOT EXISTS {
                        $this nltl:sizeCompatibilityStatus ?status .
                    }
                }
                UNION
                {
                    $this nltl:sizeCompatibilityStatus ?status .
                    FILTER (?status != true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-070> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F01/ship> ] .

