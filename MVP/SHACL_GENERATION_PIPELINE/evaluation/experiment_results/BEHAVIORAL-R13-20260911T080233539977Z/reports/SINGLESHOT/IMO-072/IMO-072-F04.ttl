@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The extended darkness operation applicability value must be false or true.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendedDarknessOperation ] ] , [ sh:and ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Extended darkness operation must be recorded as true for this requirement to apply.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:extendedDarknessOperation ] ] [ sh:property [ sh:node <urn:nltl:generated-shape:IMO-072-LifeboatShape> ; sh:path nltl:hasLifeboat ] ] ) ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-072-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F04/ship> ] .

