@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-074-K-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"The abandonment potential assessment must be false, or an applicable survival alternative must be satisfied.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:abandonmentOntoIceOrLandPotential ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Group survival equipment must be carried when abandonment onto ice or land is assessed as a potential.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:groupSurvivalEquipmentCarried ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:abandonmentOntoIceOrLandPotential ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:abandonmentOntoIceOrLandPotential ], [ sh:hasValue nltl:evidenceStateApproved ; sh:message Literal(\"Approved equivalent survival functionality must be recorded when abandonment onto ice or land is assessed as a potential and group survival equipment is not the selected alternative.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:normalLifeSavingEquivalentFunctionalityApprovalStatus ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-074> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-074-K-F02/ship> ] .

