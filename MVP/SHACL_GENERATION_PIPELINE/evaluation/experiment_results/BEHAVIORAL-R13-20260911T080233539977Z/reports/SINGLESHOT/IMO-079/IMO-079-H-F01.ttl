@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-079-H-F01/ship> ;
            sh:resultMessage "Available emergency ration person-days must be at least persons on board multiplied by maximum expected rescue time in days." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Available emergency ration person-days must be at least persons on board multiplied by maximum expected rescue time in days." ;
                    sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl/vocab#personsOnBoard> ?persons ;
                      <https://w3id.org/nltl/vocab#maximumExpectedRescueTime> ?rescueQuantity ;
                      <https://w3id.org/nltl/vocab#availableEmergencyRationPerson> ?rationQuantity .
                ?rescueQuantity <http://qudt.org/schema/qudt/numericValue> ?rescueTime ;
                                <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/DAY> .
                ?rationQuantity <http://qudt.org/schema/qudt/numericValue> ?rationCapacity ;
                               <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/DAY> .
                FILTER (?rationCapacity < (?persons * ?rescueTime))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-079> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-079-H-F01/ship> ] .

