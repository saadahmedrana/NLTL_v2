@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F02/ship> ;
            sh:resultMessage "A construction date is required to determine applicability of the equipment requirement." ;
            sh:resultPath nltl:constructionDate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:date ;
                    sh:message "A construction date is required to determine applicability of the equipment requirement." ;
                    sh:minCount 1 ;
                    sh:path nltl:constructionDate ] ] .

