@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F01/ship> ;
            sh:resultMessage "The ship must state whether ice accretion is likely; when it is likely, every required navigation or communication antenna must have ice accumulation prevention means." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_083_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F01/ship> ] .

