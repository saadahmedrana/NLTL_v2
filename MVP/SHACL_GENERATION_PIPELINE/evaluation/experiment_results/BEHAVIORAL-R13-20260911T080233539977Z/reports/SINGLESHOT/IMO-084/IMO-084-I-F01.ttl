@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-084-I-F01/ship> ;
            sh:resultMessage "When required sensors project below the hull, sensor ice protection must be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When required sensors project below the hull, sensor ice protection must be present." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:requiredSensorProjectsBelowHull true .
                FILTER NOT EXISTS {
                    $this nltl:sensorIceProtectionPresent true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO084Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-084-I-F01/ship> ] .

