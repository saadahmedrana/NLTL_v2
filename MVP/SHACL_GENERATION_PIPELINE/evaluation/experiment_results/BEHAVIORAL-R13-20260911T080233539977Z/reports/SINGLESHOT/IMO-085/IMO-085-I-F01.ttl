@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F01/ship> ;
            sh:resultMessage "For a Category A or B ship constructed on or after 1 January 2017, the bridge wings must be enclosed or the bridge-wing protection design must be approved." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a Category A or B ship constructed on or after 1 January 2017, the bridge wings must be enclosed or the bridge-wing protection design must be approved." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?date .
                FILTER (?category IN (
                    nltl:polarShipCategoryA,
                    nltl:polarShipCategoryB
                ))
                FILTER (datatype(?date) = xsd:date)
                FILTER (
                    YEAR(?date) > 2017 ||
                    (YEAR(?date) = 2017 && MONTH(?date) > 1) ||
                    (YEAR(?date) = 2017 && MONTH(?date) = 1 && DAY(?date) >= 1)
                )
                FILTER NOT EXISTS {
                    $this nltl:bridgeWingsEnclosed true .
                }
                FILTER NOT EXISTS {
                    $this nltl:bridgeWingProtectionDesignStatus true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-085-Static> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F01/ship> ] .

