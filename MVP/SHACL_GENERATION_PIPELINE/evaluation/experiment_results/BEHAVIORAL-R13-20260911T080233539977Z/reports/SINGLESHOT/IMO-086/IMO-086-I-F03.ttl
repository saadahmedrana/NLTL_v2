@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading1> ;
                    sh:resultMessage "Each non-magnetic heading means shall be connected to the ship's emergency source of power." ;
                    sh:resultPath nltl:connectedToEmergencyPower ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nbef91fb6248f419992fd8f1c34d7b205b4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic means to determine and display heading." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nbef91fb6248f419992fd8f1c34d7b205b1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading1> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading2> ;
                    sh:resultMessage "Each non-magnetic heading means shall be connected to the ship's emergency source of power." ;
                    sh:resultPath nltl:connectedToEmergencyPower ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nbef91fb6248f419992fd8f1c34d7b205b4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic means to determine and display heading." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nbef91fb6248f419992fd8f1c34d7b205b1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading2> ] .

_:nbef91fb6248f419992fd8f1c34d7b205b1 sh:class nltl:nonMagneticHeadingMeans ;
    sh:message "The ship shall have at least two non-magnetic means to determine and display heading." ;
    sh:minCount 2 ;
    sh:node gen:IMO_086_HeadingMeansShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasNonMagneticHeadingMeans .

_:nbef91fb6248f419992fd8f1c34d7b205b4 sh:class nltl:benchmarkEntity ;
    sh:message "Each non-magnetic heading means shall be connected to the ship's emergency source of power." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:connectedToEmergencyPower .

