@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:integer ; sh:message Literal(\"Ships proceeding over 80 degrees require at least one GNSS compass or equivalent.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:gnssCompassOrEquivalentCount ], [ sh:message Literal(\"The required GNSS compass or equivalent must be connected to the ship's emergency power.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:benchmarkEntity ] ; sh:path nltl:connectedToEmergencyPower ], [ sh:message Literal(\"The required GNSS compass or equivalent must be connected to the ship's main power.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:benchmarkEntity ] ; sh:path nltl:connectedToMainPower ], [ sh:node [ sh:property [ sh:minExclusive Literal(\"80\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:plannedOrActualLatitude ] ] , [ sh:property [ sh:node [ sh:property [ sh:maxInclusive Literal(\"80\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:plannedOrActualLatitude ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_087_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F02/ship> ] .

