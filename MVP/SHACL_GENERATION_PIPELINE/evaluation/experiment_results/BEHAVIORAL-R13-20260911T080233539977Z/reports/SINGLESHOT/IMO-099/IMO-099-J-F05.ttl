@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-099-J-F05/ship> ;
            sh:resultMessage "The maximum expected rescue time must be provided in days." ;
            sh:resultPath nltl:maximumExpectedRescueTime ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The maximum expected rescue time must be provided in days." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-099-RescueTimeQuantityShape> ;
                    sh:path nltl:maximumExpectedRescueTime ] ] .

