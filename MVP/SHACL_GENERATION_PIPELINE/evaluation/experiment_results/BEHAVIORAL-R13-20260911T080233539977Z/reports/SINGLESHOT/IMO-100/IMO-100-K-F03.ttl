@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-F03/ship> ;
            sh:resultMessage "The voyage plan must address every identified intended voyage hazard." ;
            sh:resultPath nltl:voyagePlanHazardCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n12189e82caf14e00a36a593899b6fa85b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-F03/ship> ;
            sh:resultMessage "The voyage plan must address every identified intended voyage hazard." ;
            sh:resultPath nltl:voyagePlanHazardCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n12189e82caf14e00a36a593899b6fa85b3 ] .

_:n12189e82caf14e00a36a593899b6fa85b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The voyage plan must address every identified intended voyage hazard." ;
    sh:minCount 1 ;
    sh:path nltl:voyagePlanHazardCoverage .

