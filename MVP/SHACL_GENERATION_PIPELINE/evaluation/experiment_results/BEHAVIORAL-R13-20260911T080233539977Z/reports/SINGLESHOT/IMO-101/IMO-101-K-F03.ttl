@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/routePlan> ;
                    sh:resultMessage "The polar-route planning record must indicate coverage of all required voyage-planning topics." ;
                    sh:resultPath nltl:voyagePlanningTopicCoverage ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n5a169feb6f914608bc5edf1f11e2d174b3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/routePlan> ;
                    sh:resultMessage "The polar-route planning record must indicate coverage of all required voyage-planning topics." ;
                    sh:resultPath nltl:voyagePlanningTopicCoverage ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n5a169feb6f914608bc5edf1f11e2d174b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/ship> ;
            sh:resultMessage "The ship must have a polar-route planning record." ;
            sh:resultPath nltl:hasPolarRoutePlan ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must have a polar-route planning record." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The polar-route planning record must indicate coverage of all required voyage-planning topics." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:voyagePlanningTopicCoverage ] ] ;
                    sh:path nltl:hasPolarRoutePlan ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/routePlan> ] .

_:n5a169feb6f914608bc5edf1f11e2d174b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The polar-route planning record must indicate coverage of all required voyage-planning topics." ;
    sh:minCount 1 ;
    sh:path nltl:voyagePlanningTopicCoverage .

