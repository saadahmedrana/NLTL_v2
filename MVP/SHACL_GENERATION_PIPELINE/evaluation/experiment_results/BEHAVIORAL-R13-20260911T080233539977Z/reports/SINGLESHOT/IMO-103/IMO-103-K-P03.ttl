@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-103-K-P03/ship> ;
            sh:resultMessage "The ship must specify whether an alternate qualified person is used and satisfy the applicable clause 12.3.2 conditions." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_103_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-103-K-P03/ship> ] .

