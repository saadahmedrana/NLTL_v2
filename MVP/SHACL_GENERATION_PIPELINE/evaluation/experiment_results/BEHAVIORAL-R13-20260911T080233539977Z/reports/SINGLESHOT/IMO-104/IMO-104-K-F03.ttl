@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/item1> ;
                                    sh:resultMessage "Less than 1 values on ex:item1->nltl:relevantPolarWaterOperationalManualProcedureOrEquipment" ;
                                    sh:resultPath nltl:relevantPolarWaterOperationalManualProcedureOrEquipment ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                                    sh:sourceShape [ sh:datatype xsd:string ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path nltl:relevantPolarWaterOperationalManualProcedureOrEquipment ] ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/record1> ;
                            sh:resultMessage "A familiarization record must identify the PWOM procedure or equipment covered." ;
                            sh:resultPath nltl:familiarizationRecordItem ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:message "A familiarization record must identify the PWOM procedure or equipment covered." ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:IMO-104-ManualItemShape> ;
                                    sh:path nltl:familiarizationRecordItem ] ;
                            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/item1> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/crew1> ;
                    sh:resultMessage "Each crew member must have a PWOM familiarization record." ;
                    sh:resultPath nltl:hasFamiliarizationRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Each crew member must have a PWOM familiarization record." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:IMO-104-FamiliarizationRecordShape> ;
                            sh:path nltl:hasFamiliarizationRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/record1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-104-CrewMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-104-CrewMemberShape> ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/crew1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "The ship must record completed PWOM familiarization status." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nf6b6e1bcb07b465c8fe9bc4c6d08b034b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "The ship must record completed PWOM familiarization status." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf6b6e1bcb07b465c8fe9bc4c6d08b034b1 ] .

_:nf6b6e1bcb07b465c8fe9bc4c6d08b034b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record completed PWOM familiarization status." ;
    sh:minCount 1 ;
    sh:path nltl:polarWaterOperationalManualFamiliarizationStatus .

