@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-P06/ship> ;
            sh:resultMessage "Value nltl:polarShipCategoryC not in list ['nltl:polarShipCategoryB', 'nltl:polarShipCategoryA']" ;
            sh:resultPath nltl:shipCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:shipCategory ] ;
            sh:value nltl:polarShipCategoryC ] .

