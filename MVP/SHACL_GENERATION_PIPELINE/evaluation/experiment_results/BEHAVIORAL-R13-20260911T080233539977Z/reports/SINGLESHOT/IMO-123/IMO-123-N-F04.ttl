@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F04/ship> ;
            sh:resultMessage "The port of departure and next port of destination must both be within Arctic waters." ;
            sh:resultPath nltl:departureAndDestinationWithinArctic ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The port of departure and next port of destination must both be within Arctic waters." ;
                    sh:minCount 1 ;
                    sh:path nltl:departureAndDestinationWithinArctic ] ] .

