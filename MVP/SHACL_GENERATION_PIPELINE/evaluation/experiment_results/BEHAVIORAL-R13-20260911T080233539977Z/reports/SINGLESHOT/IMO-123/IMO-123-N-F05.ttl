@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F05/ship> ;
            sh:resultMessage "The ship must not transit outside Arctic waters between the relevant ports." ;
            sh:resultPath nltl:routeRemainsWithinArctic ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The ship must not transit outside Arctic waters between the relevant ports." ;
                    sh:minCount 1 ;
                    sh:path nltl:routeRemainsWithinArctic ] ] .

