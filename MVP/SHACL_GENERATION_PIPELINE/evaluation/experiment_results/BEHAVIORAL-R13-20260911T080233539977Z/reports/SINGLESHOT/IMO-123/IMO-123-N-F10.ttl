@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ;
                    sh:resultMessage "The discharge-distance record must record the distance from an area with ice concentration greater than one tenth." ;
                    sh:resultPath nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The discharge-distance record must record the distance from an area with ice concentration greater than one tenth." ;
                            sh:minCount 1 ;
                            sh:node gs:IMO123IceConcentrationDistanceQuantityShape ;
                            sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ;
                    sh:resultMessage "The discharge distance must be at least 12 nautical miles from the nearest land, ice shelf, or fast ice." ;
                    sh:resultPath nltl:distanceToNearestLandIceShelfOrFastIce ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The discharge distance must be at least 12 nautical miles from the nearest land, ice shelf, or fast ice." ;
                            sh:minCount 1 ;
                            sh:node gs:IMO123NearestIceDistanceQuantityShape ;
                            sh:path nltl:distanceToNearestLandIceShelfOrFastIce ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/ship> ;
            sh:resultMessage "A discharge-distance record with both required distances must be provided." ;
            sh:resultPath nltl:hasDischargeDistanceRecord ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:dischargeDistanceRecords ;
                    sh:message "A discharge-distance record with both required distances must be provided." ;
                    sh:minCount 1 ;
                    sh:node gs:IMO123DischargeDistanceRecordShape ;
                    sh:path nltl:hasDischargeDistanceRecord ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ] .

