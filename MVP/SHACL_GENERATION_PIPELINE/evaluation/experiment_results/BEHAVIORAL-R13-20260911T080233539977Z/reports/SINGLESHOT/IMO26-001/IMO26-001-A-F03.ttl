@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-001-A-F03/ship> ;
            sh:resultMessage "Polar Code chapter 9 may apply only to a ship certified in accordance with SOLAS chapter I." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Polar Code chapter 9 may apply only to a ship certified in accordance with SOLAS chapter I." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:polarCodeChapter9Applicable ?applicable .
                FILTER ( ?applicable = true )
                FILTER NOT EXISTS {
                    $this nltl:solasChapterICertified ?certified .
                    FILTER ( ?certified = true )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-001> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-001-A-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-001-A-F03/ship> ;
            sh:resultMessage "SOLAS chapter I certification status is required to establish Polar Code chapter 9 applicability." ;
            sh:resultPath nltl:solasChapterICertified ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "SOLAS chapter I certification status is required to establish Polar Code chapter 9 applicability." ;
                    sh:minCount 1 ;
                    sh:path nltl:solasChapterICertified ] ] .

