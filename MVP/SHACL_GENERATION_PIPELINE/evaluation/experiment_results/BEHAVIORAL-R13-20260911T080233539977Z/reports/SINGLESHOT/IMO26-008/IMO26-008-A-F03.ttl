@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-008-A-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship must comply with SOLAS regulation V/22.1.9.4.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:solasRegulationV22Point1Point9Point4ComplianceStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship must have a clear view astern.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:clearViewAsternStatus ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"An Administration-approved equivalent visibility arrangement must be provided when the SOLAS and clear-astern-view requirements cannot be met.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:administrationApprovedEquivalentVisibilityArrangementPresent ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-008> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-008-A-F03/ship> ] .

