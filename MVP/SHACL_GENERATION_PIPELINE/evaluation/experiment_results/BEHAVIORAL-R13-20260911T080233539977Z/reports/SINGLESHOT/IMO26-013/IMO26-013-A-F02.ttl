@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-013-A-F02/ship> ;
            sh:resultMessage "For ships proceeding to a latitude over 80 degrees, at least one GNSS compass or equivalent must be present and connected to both the main and emergency sources of power." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ships proceeding to a latitude over 80 degrees, at least one GNSS compass or equivalent must be present and connected to both the main and emergency sources of power." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this
            WHERE {
                $this nltl:plannedOrActualLatitude ?latitudeQuantity .
                ?latitudeQuantity qudt:numericValue ?latitude ;
                    qudt:unit unit:DEG .
                FILTER (?latitude > 80)
                FILTER (
                    NOT EXISTS {
                        $this nltl:gnssCompassOrEquivalentCount ?compassCount .
                        FILTER (?compassCount >= 1)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:connectedToMainPower ?mainPowerConnection .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:connectedToEmergencyPower ?emergencyPowerConnection .
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO26_013_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-013-A-F02/ship> ] .

