@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F03/ship> ;
            sh:resultMessage "Each ship must state whether it operates in polar waters." ;
            sh:resultPath nltl:shipOperatesInPolarWaters ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Each ship must state whether it operates in polar waters." ;
                    sh:minCount 1 ;
                    sh:path nltl:shipOperatesInPolarWaters ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:IMO26_016_NonPolarBranch , gen:IMO26_016_FishingVesselBranch , gen:IMO26_016_PleasureYachtBranch , gen:IMO26_016_CargoShipBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO26_016_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F03/ship> ] .

