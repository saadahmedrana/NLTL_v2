@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-018-B-F01/ship> ;
            sh:resultMessage "When Polar Code chapter 11-1 is applicable, voyage planning topic coverage is required; when no safety management system is implemented, a documented polar operation procedure is required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-018> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-018-B-F01/ship> ] .

