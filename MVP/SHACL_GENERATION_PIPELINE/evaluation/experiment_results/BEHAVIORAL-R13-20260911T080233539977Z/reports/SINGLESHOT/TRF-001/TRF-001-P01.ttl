@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-P01/ship> ;
            sh:resultMessage "Both the 2021 section 1.8 Ice Classes provision and chapter 2 Ice Class Draught provision must apply." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceClassRegulatoryProvisionValue ;
                    sh:in ( nltl:iceClassSection1Point8Provision2021 nltl:iceClassDraughtChapter2Provision2021 ) ;
                    sh:maxCount 2 ;
                    sh:message "Both the 2021 section 1.8 Ice Classes provision and chapter 2 Ice Class Draught provision must apply." ;
                    sh:minCount 2 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:applicableIceClassRegulatoryProvision ] ] .

