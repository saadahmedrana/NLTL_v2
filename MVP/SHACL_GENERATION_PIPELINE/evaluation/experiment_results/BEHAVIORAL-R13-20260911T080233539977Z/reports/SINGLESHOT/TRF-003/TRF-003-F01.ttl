@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-003-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2019-01-01\", datatype=xsd:date) ; sh:message Literal(\"A construction contract date from 1 January 2012 up to but not including 1 January 2019 is required to establish applicability.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2012-01-01\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ], [ sh:hasValue nltl:iceClassRegulationEdition2010 ; sh:message Literal(\"Ships contracted during the applicable period shall identify the 2010 Ice Class Regulations.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:applicableIceClassRegulationEdition ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2012-01-01\", datatype=xsd:date) ; sh:message Literal(\"A construction contract date before 1 January 2012 is outside the stated applicability period.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:constructionContractDate ] ] , [ sh:property [ sh:datatype xsd:date ; sh:message Literal(\"A construction contract date on or after 1 January 2019 is outside the stated applicability period.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2019-01-01\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-003> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-003-F01/ship> ] .

