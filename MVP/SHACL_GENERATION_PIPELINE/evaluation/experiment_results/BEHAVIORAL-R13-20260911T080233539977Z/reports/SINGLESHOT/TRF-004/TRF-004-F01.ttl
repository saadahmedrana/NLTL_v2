@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ;
            sh:resultMessage "Ships contracted for construction on or after 1 January 2010 but before 1 January 2012 shall identify the 2008 Ice Class Regulations as the applicable regulation edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ships contracted for construction on or after 1 January 2010 but before 1 January 2012 shall identify the 2008 Ice Class Regulations as the applicable regulation edition." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionContractDate ?date .
    BIND(YEAR(?date) AS ?year)
    BIND(MONTH(?date) AS ?month)
    BIND(DAY(?date) AS ?day)
    FILTER(
        (?year > 2010 ||
         (?year = 2010 && (?month > 1 || (?month = 1 && ?day >= 1)))) &&
        (?year < 2012 ||
         (?year = 2012 && (?month < 1 || (?month = 1 && ?day < 1))))
    )
    FILTER NOT EXISTS {
        $this nltl:applicableIceClassRegulationEdition
              nltl:iceClassRegulationEdition2008
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF004Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ] .

