@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gen:TRF006BeforeCohortShape , gen:TRF006ApplicableCohortShape , gen:TRF006AfterCohortShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF006Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F01/ship> ] .

