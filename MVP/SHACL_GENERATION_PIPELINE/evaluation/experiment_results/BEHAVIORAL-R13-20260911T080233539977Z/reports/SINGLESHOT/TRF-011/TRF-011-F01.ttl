@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F01/ship> ;
            sh:resultMessage "The upper ice waterline must equal, within a relative tolerance of 1e-6 plus an absolute fallback of 1e-9 m near zero, the maximum vertical coordinate of the intended ice-operating waterline at every longitudinal position, with no unmatched positions." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The upper ice waterline must equal, within a relative tolerance of 1e-6 plus an absolute fallback of 1e-9 m near zero, the maximum vertical coordinate of the intended ice-operating waterline at every longitudinal position, with no unmatched positions." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    SELECT $this ?x
                           (MAX(?iv) AS ?im)
                           (MAX(?uv) AS ?um)
                           (COUNT(?iv) AS ?ic)
                           (COUNT(?uv) AS ?uc)
                    WHERE {
                        {
                            $this nltl:hasIntendedIceOperatingWaterline ?iw .
                            ?iw nltl:hasWaterlineProfilePoint ?ip .
                            ?ip nltl:longitudinalPosition ?xq ;
                                nltl:verticalCoordinate ?vq .
                            ?xq qudt:numericValue ?x ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                            ?vq qudt:numericValue ?v ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                            BIND(?v AS ?iv)
                        }
                        UNION
                        {
                            $this nltl:hasUpperIceWaterline ?uw .
                            ?uw nltl:hasWaterlineProfilePoint ?up .
                            ?up nltl:longitudinalPosition ?uxq ;
                                nltl:verticalCoordinate ?uvq .
                            ?uxq qudt:numericValue ?x ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                            ?uvq qudt:numericValue ?uv ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                        }
                    }
                    GROUP BY $this ?x
                }
                FILTER(
                    ?ic = 0 ||
                    ?uc = 0 ||
                    ABS(?im - ?um) >
                    (1e-6 * ABS(?im) + 1e-9)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF011ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F01/ship> ] .

