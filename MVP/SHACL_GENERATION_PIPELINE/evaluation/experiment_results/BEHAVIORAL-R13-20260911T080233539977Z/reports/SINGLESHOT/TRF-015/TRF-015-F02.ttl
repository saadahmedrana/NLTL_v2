@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F02/ship> ;
            sh:resultMessage "When navigating in ice, operating draught or trim exceeds its permitted ice limit." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When navigating in ice, operating draught or trim exceeds its permitted ice limit." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:navigatingInIce true ;
          nltl:operatingDraught ?draught ;
          nltl:upperIceWaterlineDraught ?waterline ;
          nltl:operatingTrim ?trim ;
          nltl:maximumPermittedIceTrim ?maximumTrim .
    ?draught qudt:numericValue ?draughtValue ;
             qudt:unit unit:M .
    ?waterline qudt:numericValue ?waterlineValue ;
               qudt:unit unit:M .
    ?trim qudt:numericValue ?trimValue ;
          qudt:unit unit:M .
    ?maximumTrim qudt:numericValue ?maximumTrimValue ;
                 qudt:unit unit:M .
    FILTER (?draughtValue > ?waterlineValue || ?trimValue > ?maximumTrimValue)
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF015Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F02/ship> ] .

