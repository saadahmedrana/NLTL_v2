@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F03/ship> ;
            sh:resultMessage "The loading-calculation sea-water salinity must equal the intended-route sea-water salinity." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The loading-calculation sea-water salinity must equal the intended-route sea-water salinity." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:intendedRouteSeaWaterSalinity ?intended ;
          nltl:loadingCalculationSeaWaterSalinity ?loading .
    ?intended qudt:numericValue ?intendedValue ;
              qudt:unit nltl:gramPerKilogramSalinityUnit .
    ?loading qudt:numericValue ?loadingValue ;
             qudt:unit nltl:gramPerKilogramSalinityUnit .
    FILTER (?intendedValue != ?loadingValue)
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF015Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F03/ship> ] .

