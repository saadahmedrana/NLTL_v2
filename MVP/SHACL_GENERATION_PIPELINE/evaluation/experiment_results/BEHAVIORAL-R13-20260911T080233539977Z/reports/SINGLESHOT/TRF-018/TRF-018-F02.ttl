@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F02/ship> ;
            sh:resultMessage "maximumContinuousRatingPower must be at least the calculated required power and at least 1000 kW for IA, IB, or IC, or 2800 kW for IA Super." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "maximumContinuousRatingPower must be at least the calculated required power and at least 1000 kW for IA, IB, or IC, or 2800 kW for IA Super." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:calculatedRequiredPower ?calculatedQuantity ;
                      nltl:maximumContinuousRatingPower ?maximumQuantity .
                ?calculatedQuantity qudt:numericValue ?calculatedPower ;
                                    qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                ?maximumQuantity qudt:numericValue ?maximumPower ;
                                 qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                FILTER (
                    (
                        ?iceClass IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                        && ?maximumPower < ?calculatedPower
                    )
                    ||
                    (
                        ?iceClass IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                        && ?maximumPower < 1000
                    )
                    ||
                    (
                        ?iceClass = nltl:iceClassIaSuper
                        && ?maximumPower < ?calculatedPower
                    )
                    ||
                    (
                        ?iceClass = nltl:iceClassIaSuper
                        && ?maximumPower < 2800
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-018> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F02/ship> ] .

