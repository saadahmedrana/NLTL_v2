@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:message Literal("Construction stage date is required to determine applicability.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ; sh:message Literal("A non-IA or non-IA Super ice class must be identified.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ] ; sh:sparql [ sh:message Literal("For a non-IA or non-IA Super ship, the construction stage date must not be before 1 September 2003.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionStageDate ?stageDate .
                        FILTER (?stageDate >= "2003-09-01"^^xsd:date)
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:date ; sh:message Literal("Assessment date is required to verify the compliance deadline.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:assessmentDate ], [ sh:datatype xsd:date ; sh:message Literal("Construction stage date is required to determine applicability.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:datatype xsd:date ; sh:message Literal("Delivery date is required to determine the twenty-year deadline.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:deliveryDate ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ; sh:message Literal("The ship's ice class must be IA Super or IA for this applicability branch.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ] ; sh:sparql [ sh:message Literal("For an IA Super or IA ship constructed before 1 September 2003, compliance must be established no later than 1 January of the year twenty years after delivery.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionStageDate ?stageDate ;
                              nltl:deliveryDate ?deliveryDate ;
                              nltl:assessmentDate ?assessmentDate .
                        FILTER (?stageDate < "2003-09-01"^^xsd:date)
                        FILTER (
                            YEAR(?assessmentDate) < YEAR(?deliveryDate) + 20
                            ||
                            (
                                YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20
                                && MONTH(?assessmentDate) = 1
                                && DAY(?assessmentDate) = 1
                            )
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:TRF024Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-F01/ship> ] .

