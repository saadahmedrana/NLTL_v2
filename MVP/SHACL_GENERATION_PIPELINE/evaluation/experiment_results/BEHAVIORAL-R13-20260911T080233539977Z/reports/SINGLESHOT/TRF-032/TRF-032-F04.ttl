@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-F04/ship> ;
            sh:resultMessage "Ice strengthening status is required to determine applicability of the scantling rule." ;
            sh:resultPath nltl:iceStrengtheningStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Ice strengthening status is required to determine applicability of the scantling rule." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceStrengtheningStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-F04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceStrengtheningStatus ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:iceStrengtheningStatus ] ; sh:sparql [ sh:message Literal("When the ship is not ice strengthened and the regulation-derived scantling is less than the classification-society requirement, the selected design scantling must use the classification-society requirement.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceStrengtheningStatus false ;
          nltl:regulationRequiredScantling ?regulation ;
          nltl:classificationSocietyRequiredScantling ?classification .
    ?regulation qudt:numericValue ?regulationValue .
    ?classification qudt:numericValue ?classificationValue .
    FILTER (?regulationValue < ?classificationValue)
    FILTER NOT EXISTS {
        $this nltl:selectedDesignScantling ?selected .
        ?selected qudt:numericValue ?selectedValue .
        FILTER (?selectedValue = ?classificationValue)
    }
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF032_Static ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-F04/ship> ;
            sh:resultMessage "The classification-society-required scantling is required." ;
            sh:resultPath nltl:classificationSocietyRequiredScantling ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The classification-society-required scantling is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:classificationSocietyRequiredScantling ] ] .

