@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F05/plating> ;
            sh:resultMessage "Plating must identify transverse or longitudinal framing and provide the corresponding pressure, plating factor, and externally determined result inputs for the applicable formula." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF041PlatingReadinessShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F05/plating> ] .

