@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/terminationCase> ;
                    sh:resultMessage "Termination at the adjacent boundary must be permitted when the extension is no more than 250 mm." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:n7ee795e6f91f4d5c8c0b55b610ec16c2b11 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:TRF-043-TerminationCaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/terminationCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF-043-TerminationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasFramingIceStrengtheningTerminationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:framingIceStrengtheningTerminationCase ;
                    sh:node <urn:nltl:generated-shape:TRF-043-TerminationCaseShape> ;
                    sh:path nltl:hasFramingIceStrengtheningTerminationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/terminationCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/terminationCase> ;
            sh:resultMessage "Termination at the adjacent boundary must be permitted when the extension is no more than 250 mm." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:n7ee795e6f91f4d5c8c0b55b610ec16c2b11 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-043-TerminationCaseShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F01/terminationCase> ] .

_:n7ee795e6f91f4d5c8c0b55b610ec16c2b11 sh:message "Termination at the adjacent boundary must be permitted when the extension is no more than 250 mm." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?extension .
                ?extension qudt:numericValue ?extensionValue .
                ?extension qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                FILTER ( ?extensionValue <= "250"^^xsd:decimal )
                FILTER NOT EXISTS {
                    $this nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted true .
                }
            }
        """ .

