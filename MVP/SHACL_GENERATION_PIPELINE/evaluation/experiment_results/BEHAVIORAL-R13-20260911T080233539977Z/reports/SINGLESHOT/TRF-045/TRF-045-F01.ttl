@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F01/frame> ;
            sh:resultMessage "Ordinary frame scantlings may be used only when less than 15% of the frame span is situated within the ice-strengthening zone." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ordinary frame scantlings may be used only when less than 15% of the frame span is situated within the ice-strengthening zone." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:ordinaryFrameScantlingsUsed ?used .
                FILTER (?used = true)

                $this nltl:frameSpanWithinIceStrengtheningZone ?withinQuantity .
                $this nltl:span ?spanQuantity .
                ?withinQuantity qudt:numericValue ?withinValue .
                ?spanQuantity qudt:numericValue ?spanValue .

                FILTER (?withinValue >= 0.15 * ?spanValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-045_FrameSpanIceZone> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-045-F01/frame> ] .

