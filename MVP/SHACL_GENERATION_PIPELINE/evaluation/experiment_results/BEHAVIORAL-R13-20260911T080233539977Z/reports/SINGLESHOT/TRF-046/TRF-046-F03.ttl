@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/frame> ;
            sh:resultMessage "A main frame or intermediate ice frame must have a strengthened part whose upper end is attached to a deck structure, tank boundary plating, or ice stringer." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:nb5e988ece5e741b6a3b617a578d75df2b1 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-046-UpperEndAttachmentShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/adjacentMainFrame> ;
            sh:resultMessage "A main frame or intermediate ice frame must have a strengthened part whose upper end is attached to a deck structure, tank boundary plating, or ice stringer." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:nb5e988ece5e741b6a3b617a578d75df2b1 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-046-UpperEndAttachmentShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F03/adjacentMainFrame> ] .

_:nb5e988ece5e741b6a3b617a578d75df2b1 a sh:SPARQLConstraint ;
    sh:message "A main frame or intermediate ice frame must have a strengthened part whose upper end is attached to a deck structure, tank boundary plating, or ice stringer." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this rdf:type ?frameType .
                FILTER (
                    ?frameType IN (
                        nltl:mainFrame,
                        nltl:intermediateIceFrame
                    )
                )

                FILTER NOT EXISTS {
                    $this nltl:hasStrengthenedPart ?strengthenedPart .
                    ?strengthenedPart rdf:type nltl:frameStrengthenedPart .

                    $this nltl:hasUpperEnd ?upperEnd .
                    ?upperEnd rdf:type nltl:frameEnd .
                    ?upperEnd nltl:hasAttachedSupportingStructure ?supportingStructure .

                    ?supportingStructure rdf:type ?supportingStructureType .
                    FILTER (
                        ?supportingStructureType IN (
                            nltl:deckStructure,
                            nltl:tankBoundaryPlating,
                            nltl:iceStringer
                        )
                    )
                }
            }
        """ .

