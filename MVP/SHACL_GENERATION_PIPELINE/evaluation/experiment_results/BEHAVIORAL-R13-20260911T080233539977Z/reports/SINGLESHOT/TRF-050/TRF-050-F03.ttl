@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F03/attachmentRecord> ;
            sh:resultMessage "Each frame attachment record shall specify a double continuous weld." ;
            sh:resultPath nltl:frameShellWeldType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nbc0355d9ff234cf89787229ce3b5953db1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F03/attachmentRecord> ;
            sh:resultMessage "Each frame attachment record shall specify a double continuous weld." ;
            sh:resultPath nltl:frameShellWeldType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nbc0355d9ff234cf89787229ce3b5953db1 ] .

_:nbc0355d9ff234cf89787229ce3b5953db1 sh:class nltl:weldTypeValue ;
    sh:hasValue nltl:doubleContinuousWeld ;
    sh:maxCount 1 ;
    sh:message "Each frame attachment record shall specify a double continuous weld." ;
    sh:minCount 1 ;
    sh:path nltl:frameShellWeldType .

