@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ;
            sh:resultMessage "Each frame attachment record shall state whether a shell plate butt is crossed." ;
            sh:resultPath nltl:shellPlateButtCrossing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Each frame attachment record shall state whether a shell plate butt is crossed." ;
                    sh:minCount 1 ;
                    sh:path nltl:shellPlateButtCrossing ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/attachmentRecord> ;
            sh:resultMessage "Each frame attachment record shall specify a double continuous weld." ;
            sh:resultPath nltl:frameShellWeldType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nbc0355d9ff234cf89787229ce3b5953db1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:shellPlateButtCrossing ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Scalloping is not allowed when the frame attachment does not cross a shell plate butt.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:scallopingPresent ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:shellPlateButtCrossing ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_050_FrameAttachmentRecordShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ;
            sh:resultMessage "Each frame attachment record shall be linked from a frame by frameAttachment." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each frame attachment record shall be linked from a frame by frameAttachment." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    ?frame nltl:frameAttachment $this .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_050_FrameAttachmentRecordShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/attachmentRecord> ;
            sh:resultMessage "Each frame attachment record shall specify a double continuous weld." ;
            sh:resultPath nltl:frameShellWeldType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nbc0355d9ff234cf89787229ce3b5953db1 ] .

_:nbc0355d9ff234cf89787229ce3b5953db1 sh:class nltl:weldTypeValue ;
    sh:hasValue nltl:doubleContinuousWeld ;
    sh:maxCount 1 ;
    sh:message "Each frame attachment record shall specify a double continuous weld." ;
    sh:minCount 1 ;
    sh:path nltl:frameShellWeldType .

