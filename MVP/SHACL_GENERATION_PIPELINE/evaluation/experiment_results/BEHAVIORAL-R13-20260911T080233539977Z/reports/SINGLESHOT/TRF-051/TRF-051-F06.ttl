@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-051-F06/hullStructure> ;
            sh:resultMessage "The in-lieu-of-frame applicability indicator is required." ;
            sh:resultPath nltl:inLieuOfFrame ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The in-lieu-of-frame applicability indicator is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:inLieuOfFrame ] ] .

