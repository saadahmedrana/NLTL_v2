@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F01/frame> ;
            sh:resultMessage "An applicable frame requires antitripping support spacing not exceeding 1300 mm, unless equivalent support is demonstrated by direct calculation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "An applicable frame requires antitripping support spacing not exceeding 1300 mm, unless equivalent support is demonstrated by direct calculation." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:equivalentSupportStatusByDirectCalculation true
                    }
                )
                {
                    $this nltl:frameAsymmetrical true
                }
                UNION
                {
                    $this nltl:frameWebAngleToShell ?angleNode .
                    ?angleNode qudt:numericValue ?angle .
                    ?angleNode qudt:unit unit:DEG .
                    FILTER (?angle < 90)
                }
                FILTER NOT EXISTS {
                    $this nltl:antitrippingSupportSpacing ?spacingNode .
                    ?spacingNode qudt:numericValue ?spacing .
                    ?spacingNode qudt:unit unit:MilliM .
                    FILTER (?spacing <= 1300)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-052-FrameSupportShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F01/frame> ] .

