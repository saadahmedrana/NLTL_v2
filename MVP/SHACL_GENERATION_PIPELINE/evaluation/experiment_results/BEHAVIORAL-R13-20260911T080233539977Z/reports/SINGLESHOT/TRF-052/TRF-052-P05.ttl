@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P05/frame> ;
            sh:resultMessage "For frames with spans of 4 m or less, the applicable ice-class region coverage is required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For frames with spans of 4 m or less, the applicable ice-class region coverage is required." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:equivalentSupportStatusByDirectCalculation true
                    }
                )
                $this nltl:frameSpan ?spanNode .
                ?spanNode qudt:numericValue ?span .
                ?spanNode qudt:unit unit:M .
                FILTER (?span <= 4)
                {
                    $this nltl:iceClass nltl:iceClassIaSuper .
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                    }
                }
                UNION
                {
                    $this nltl:iceClass nltl:iceClassIaSuper .
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion
                    }
                }
                UNION
                {
                    $this nltl:iceClass nltl:iceClassIa .
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                    }
                }
                UNION
                {
                    $this nltl:iceClass nltl:iceClassIa .
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion
                    }
                }
                UNION
                {
                    $this nltl:iceClass nltl:iceClassIb .
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                    }
                }
                UNION
                {
                    $this nltl:iceClass nltl:iceClassIc .
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-052-FrameSupportShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P05/frame> ] .

