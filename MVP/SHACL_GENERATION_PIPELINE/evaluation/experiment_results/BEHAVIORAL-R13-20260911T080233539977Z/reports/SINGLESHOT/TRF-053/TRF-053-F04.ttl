@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/frameMomentFactorMValue> ;
                    sh:resultMessage "Node ex:frameMomentFactorMValue->qudt:unit does not contain a value in the set: ['qudt:UNITLESS']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:UNITLESS ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/iceStringer> ;
            sh:resultMessage "Each ice stringer must specify one dimensionless frame moment factor." ;
            sh:resultPath nltl:frameMomentFactorM ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ice stringer must specify one dimensionless frame moment factor." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:frameMomentFactorM ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/frameMomentFactorMValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/icePressureValue> ;
                    sh:resultMessage "Node ex:icePressureValue->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:MegaPA ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/iceStringer> ;
            sh:resultMessage "Each ice stringer must specify one ice pressure in MPa." ;
            sh:resultPath nltl:icePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ice stringer must specify one ice pressure in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:MegaPA ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:icePressure ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/icePressureValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/designLineLoadValue> ;
                    sh:resultMessage "Node ex:designLineLoadValue->qudt:unit does not contain a value in the set: ['qudt:KiloN-PER-M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:KiloN-PER-M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/iceStringer> ;
            sh:resultMessage "Each ice stringer must specify a design line load of at least 0.15 kN/m." ;
            sh:resultPath nltl:designLineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ice stringer must specify a design line load of at least 0.15 kN/m." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 0.15 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:KiloN-PER-M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designLineLoad ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/designLineLoadValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/designIceLoadHeightValue> ;
                    sh:resultMessage "Node ex:designIceLoadHeightValue->qudt:unit does not contain a value in the set: ['qudt:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:M ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/iceStringer> ;
            sh:resultMessage "Each ice stringer must specify one design ice load height in metres." ;
            sh:resultPath nltl:designIceLoadHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ice stringer must specify one design ice load height in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designIceLoadHeight ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/designIceLoadHeightValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/sectionModulusValue> ;
                    sh:resultMessage "Node ex:sectionModulusValue->qudt:unit does not contain a value in the set: ['qudt:CentiM3']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:CentiM3 ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/iceStringer> ;
            sh:resultMessage "Each ice stringer must specify one section modulus in cm^3." ;
            sh:resultPath nltl:sectionModulus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ice stringer must specify one section modulus in cm^3." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:CentiM3 ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:sectionModulus ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/sectionModulusValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/iceStringer> ;
            sh:resultMessage "Each ice stringer must specify one span in metres." ;
            sh:resultPath nltl:span ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ice stringer must specify one span in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:span ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/yieldStrengthValue> ;
                    sh:resultMessage "Node ex:yieldStrengthValue->qudt:unit does not contain a value in the set: ['qudt:MegaPA']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:MegaPA ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/iceStringer> ;
            sh:resultMessage "Each ice stringer must specify one yield strength in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ice stringer must specify one yield strength in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:MegaPA ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:yieldStrength ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/yieldStrengthValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/requiredShearAreaValue> ;
                    sh:resultMessage "Node ex:requiredShearAreaValue->qudt:unit does not contain a value in the set: ['qudt:CentiM2']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue qudt:CentiM2 ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/iceStringer> ;
            sh:resultMessage "Each ice stringer must specify one required shear area in cm^2." ;
            sh:resultPath nltl:requiredShearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ice stringer must specify one required shear area in cm^2." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:CentiM2 ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:requiredShearArea ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/requiredShearAreaValue> ] .

