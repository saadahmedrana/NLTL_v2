@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "webFrameIceLoad must equal 1.8 times the effective ice pressure-height line load times webFrameSpacing; values below 0.15 MN/m use 0.15 MN/m, with a 1e-6 relative tolerance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "webFrameIceLoad must equal 1.8 times the effective ice pressure-height line load times webFrameSpacing; values below 0.15 MN/m use 0.15 MN/m, with a 1e-6 relative tolerance." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:iceLoadHeight ?heightNode ;
                      nltl:webFrameSpacing ?spacingNode ;
                      nltl:webFrameIceLoad ?loadNode .
                ?pressureNode qudt:numericValue ?p .
                ?heightNode qudt:numericValue ?h .
                ?spacingNode qudt:numericValue ?s .
                ?loadNode qudt:numericValue ?f .
                BIND((?p * ?h) AS ?lineLoad)
                BIND(IF(?lineLoad < 0.15, 0.15, ?lineLoad) AS ?effectiveLineLoad)
                BIND((1800 * ?effectiveLineLoad * ?s) AS ?expectedLoad)
                FILTER(
                    ABS(?f - ?expectedLoad) >
                    IF(
                        ABS(?expectedLoad) < 0.000001,
                        0.000001,
                        ABS(?expectedLoad) * 0.000001
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF057WebFrameIceLoadShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ] .

