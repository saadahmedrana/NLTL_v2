@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-062-F02/ship> ;
            sh:resultMessage "A measured minimum propeller blade tip to hull clearance is required; the h0 threshold is not represented by an available canonical term." ;
            sh:resultPath nltl:propellerBladeTipHullClearance ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A measured minimum propeller blade tip to hull clearance is required; the h0 threshold is not represented by an available canonical term." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:message "Propeller blade tip to hull clearance must have one decimal numeric value." ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:message "Propeller blade tip to hull clearance must be expressed in metres." ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:nodeKind sh:BlankNodeOrIRI ;
                    sh:path nltl:propellerBladeTipHullClearance ] ] .

