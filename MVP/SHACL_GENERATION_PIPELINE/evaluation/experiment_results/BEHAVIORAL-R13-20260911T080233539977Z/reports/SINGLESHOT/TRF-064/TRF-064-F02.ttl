@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:detachedStrutStructure ; sh:message Literal(\"Detached struts require design, strength, and hull-attachment evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF064DetachedStrutShape ; sh:path nltl:hasDetachedStrut ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:detachedStrut ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:detachedStrut ], [ sh:message Literal(\"Side-propeller shafting must be enclosed within plated bossing when detached struts are not used.\") ; sh:node gen:TRF064EnclosedComponentShape ; sh:path nltl:hasSidePropellerShafting ], [ sh:message Literal(\"Side-propeller stern tubes must be enclosed within plated bossing when detached struts are not used.\") ; sh:node gen:TRF064EnclosedComponentShape ; sh:path nltl:hasSternTube ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF064ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F02/ship> ;
            sh:resultMessage "A detached-strut applicability value must be recorded." ;
            sh:resultPath nltl:detachedStrut ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "A detached-strut applicability value must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:detachedStrut ] ] .

