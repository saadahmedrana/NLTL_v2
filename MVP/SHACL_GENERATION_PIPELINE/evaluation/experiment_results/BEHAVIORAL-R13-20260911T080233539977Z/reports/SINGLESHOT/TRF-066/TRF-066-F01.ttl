@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:TRF066NotApplicableShape , gs:TRF066IaIceKnifeShape , gs:TRF066IaSuperIceKnifeShape , gs:TRF066IaEquivalentShape , gs:TRF066IaSuperEquivalentShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF066Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F01/ship> ;
            sh:resultMessage "The ship must have one valid ice class." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype nltl:iceClassValue ;
                    sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship must have one valid ice class." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceClass ] ;
            sh:value nltl:iceClassIa ] .

