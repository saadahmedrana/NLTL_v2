@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F01/case> ;
                    sh:resultMessage "Node ex:case must conform to exactly one shape in [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF075ForceQuantityShape ; sh:path nltl:backwardBladeForce ] , [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF075ForceQuantityShape ; sh:path nltl:forwardBladeForce ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:XoneConstraintComponent ;
                    sh:sourceShape gen:TRF075LoadCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F01/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF075LoadCaseShape. See details for more information." ;
            sh:resultPath nltl:hasPropellerBladeLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:TRF075LoadCaseShape ;
                    sh:path nltl:hasPropellerBladeLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F01/case> ] .

