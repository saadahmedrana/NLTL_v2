@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F05/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("CP") ; sh:path nltl:propellerType ] ; sh:sparql [ sh:message Literal("A CP propeller must have propeller blade load cases 1, 2, 3, and 4.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerType "CP" .
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case1 .
                            ?case1 nltl:propellerBladeLoadCaseNumber ?number1 .
                            FILTER (?number1 >= 1 && ?number1 <= 1)
                        }
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case2 .
                            ?case2 nltl:propellerBladeLoadCaseNumber ?number2 .
                            FILTER (?number2 >= 2 && ?number2 <= 2)
                        }
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case3 .
                            ?case3 nltl:propellerBladeLoadCaseNumber ?number3 .
                            FILTER (?number3 >= 3 && ?number3 <= 3)
                        }
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case4 .
                            ?case4 nltl:propellerBladeLoadCaseNumber ?number4 .
                            FILTER (?number4 >= 4 && ?number4 <= 4)
                        }
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerReversingCapability ], [ sh:hasValue Literal("FP") ; sh:path nltl:propellerType ] ; sh:sparql [ sh:message Literal("A non-reversing FP propeller must have propeller blade load cases 1, 2, 3, and 4.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerType "FP" .
                        $this nltl:propellerReversingCapability false .
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case1 .
                            ?case1 nltl:propellerBladeLoadCaseNumber ?number1 .
                            FILTER (?number1 >= 1 && ?number1 <= 1)
                        }
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case2 .
                            ?case2 nltl:propellerBladeLoadCaseNumber ?number2 .
                            FILTER (?number2 >= 2 && ?number2 <= 2)
                        }
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case3 .
                            ?case3 nltl:propellerBladeLoadCaseNumber ?number3 .
                            FILTER (?number3 >= 3 && ?number3 <= 3)
                        }
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case4 .
                            ?case4 nltl:propellerBladeLoadCaseNumber ?number4 .
                            FILTER (?number4 >= 4 && ?number4 <= 4)
                        }
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerReversingCapability ], [ sh:hasValue Literal("FP") ; sh:path nltl:propellerType ] ; sh:sparql [ sh:message Literal("A reversing FP propeller must have propeller blade load cases 1, 2, 3, 4, and 5.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerType "FP" .
                        $this nltl:propellerReversingCapability true .
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case1 .
                            ?case1 nltl:propellerBladeLoadCaseNumber ?number1 .
                            FILTER (?number1 >= 1 && ?number1 <= 1)
                        }
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case2 .
                            ?case2 nltl:propellerBladeLoadCaseNumber ?number2 .
                            FILTER (?number2 >= 2 && ?number2 <= 2)
                        }
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case3 .
                            ?case3 nltl:propellerBladeLoadCaseNumber ?number3 .
                            FILTER (?number3 >= 3 && ?number3 <= 3)
                        }
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case4 .
                            ?case4 nltl:propellerBladeLoadCaseNumber ?number4 .
                            FILTER (?number4 >= 4 && ?number4 <= 4)
                        }
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case5 .
                            ?case5 nltl:propellerBladeLoadCaseNumber ?number5 .
                            FILTER (?number5 >= 5 && ?number5 <= 5)
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-076-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-076-F05/ship> ] .

