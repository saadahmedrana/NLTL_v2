@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "A ship must have a Table 6-6 ice-class lookup case." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A ship must have a Table 6-6 ice-class lookup case." ;
                    sh:node gen:LookupCaseShape ;
                    sh:path nltl:hasTableLookupCase ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape gen:Table6Dash6CaseShape ] ] .

