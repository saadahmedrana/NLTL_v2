@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ;
            sh:resultMessage "The immersion function and submersion factor k2 must satisfy the declared formulas; calculated decimal results are checked with a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The immersion function and submersion factor k2 must satisfy the declared formulas; calculated decimal results are checked with a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?hNode ;
                      nltl:iceLoadCycleCoefficientK2 ?kNode ;
                      nltl:propellerDiameter ?dNode ;
                      nltl:propellerImmersionFunction ?fNode ;
                      nltl:propellerShaftCentrelineDepth ?h0Node .

                ?hNode qudt:numericValue ?h .
                ?kNode qudt:numericValue ?k .
                ?dNode qudt:numericValue ?d .
                ?fNode qudt:numericValue ?f .
                ?h0Node qudt:numericValue ?h0 .

                BIND((?h0 - ?h) / (?d / 2) - 1 AS ?fExpected)
                BIND(
                    IF(
                        ?fExpected < 0,
                        0.8 - ?fExpected,
                        IF(
                            ?fExpected <= 1,
                            0.8 - 0.4 * ?fExpected,
                            IF(
                                ?fExpected <= 2.5,
                                0.6 - 0.2 * ?fExpected,
                                0.1
                            )
                        )
                    ) AS ?kExpected
                )
                BIND(
                    IF(
                        ABS(?fExpected) * 0.000001 > 0.000000001,
                        ABS(?fExpected) * 0.000001,
                        0.000000001
                    ) AS ?fTolerance
                )
                BIND(
                    IF(
                        ABS(?kExpected) * 0.000001 > 0.000000001,
                        ABS(?kExpected) * 0.000001,
                        0.000000001
                    ) AS ?kTolerance
                )

                FILTER(
                    ?f < (?fExpected - ?fTolerance) ||
                    ?f > (?fExpected + ?fTolerance) ||
                    ?k < (?kExpected - ?kTolerance) ||
                    ?k > (?kExpected + ?kTolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_079_StaticCalculationShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ] .

