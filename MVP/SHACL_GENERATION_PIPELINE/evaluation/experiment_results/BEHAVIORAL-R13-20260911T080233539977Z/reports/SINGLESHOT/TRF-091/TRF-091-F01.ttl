@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/milling> ;
            sh:resultMessage "The ship shall identify a propeller ice-milling load-sequence case." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceMillingSequenceCase ;
                    sh:message "The ship shall identify a propeller ice-milling load-sequence case." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasIceMillingSequenceCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/ship> ;
            sh:resultMessage "The ship shall identify the load sequence used for propeller ice-block milling." ;
            sh:resultPath nltl:propellerIceMillingLoadSequence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship shall identify the load sequence used for propeller ice-block milling." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerIceMillingLoadSequence ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/ship> ;
            sh:resultMessage "The ship shall identify a propulsion load case using the ice-milling load sequence." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc436346abdaa4f85b2db1151e768ca13b3 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ;
                    sh:resultMessage "The propulsion load case shall be designated for propulsion-line strength evaluation and not for propulsion-system stalling analysis." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                            sh:maxCount 1 ;
                            sh:message "The propulsion load case shall be designated for propulsion-line strength evaluation and not for propulsion-system stalling analysis." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:loadCasePurpose ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/milling> ;
            sh:resultMessage "The ship shall identify a propulsion load case using the ice-milling load sequence." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nc436346abdaa4f85b2db1151e768ca13b3 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F01/loadCase> ] .

_:Naa084ada39b64f56b318ee664822dc52 sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
    sh:maxCount 1 ;
    sh:message "The propulsion load case shall be designated for propulsion-line strength evaluation and not for propulsion-system stalling analysis." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:loadCasePurpose .

_:Ncb45989ba9a44fbea7cf993c6d411c27 a sh:NodeShape ;
    sh:property _:Naa084ada39b64f56b318ee664822dc52 .

_:nc436346abdaa4f85b2db1151e768ca13b3 sh:class nltl:loadCase ;
    sh:message "The ship shall identify a propulsion load case using the ice-milling load sequence." ;
    sh:minCount 1 ;
