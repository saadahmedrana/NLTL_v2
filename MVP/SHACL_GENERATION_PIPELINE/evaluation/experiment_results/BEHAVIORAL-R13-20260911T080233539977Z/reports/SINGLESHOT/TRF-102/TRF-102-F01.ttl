@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in nltlgen:TRF102FormulaCase , nltlgen:TRF102StressAnalysisCase" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:TRF102Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-F01/ship> ] .

