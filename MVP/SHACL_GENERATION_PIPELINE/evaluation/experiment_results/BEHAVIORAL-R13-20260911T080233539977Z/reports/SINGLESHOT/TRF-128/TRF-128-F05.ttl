@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:propulsionEngineReversalRequiredForAstern" ;
            sh:resultPath nltl:propulsionEngineReversalRequiredForAstern ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:propulsionEngineReversalRequiredForAstern ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in <urn:nltl:generated-shape:TRF-128-ia-super-reversal> , <urn:nltl:generated-shape:TRF-128-non-ia-super> , <urn:nltl:generated-shape:TRF-128-no-reversal>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-128> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F05/ship> ] .

