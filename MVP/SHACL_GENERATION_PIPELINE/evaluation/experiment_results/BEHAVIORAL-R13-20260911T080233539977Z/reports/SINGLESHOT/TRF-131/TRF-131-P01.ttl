@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-131-P01/ship> ;
            sh:resultMessage "The ship must have an inlet chest; a ballast-water cooling arrangement cannot replace it." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:inletChest ;
                    sh:message "The ship must have an inlet chest; a ballast-water cooling arrangement cannot replace it." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasComponent ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-131-P01/ship> ;
            sh:resultMessage "A ballast-water cooling arrangement must not be accepted as a substitute for an inlet chest." ;
            sh:resultPath nltl:substituteArrangementStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nd9cb802e46db44b6bb850bca833f7879b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-131-P01/ship> ;
            sh:resultMessage "A ballast-water cooling arrangement must not be accepted as a substitute for an inlet chest." ;
            sh:resultPath nltl:substituteArrangementStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd9cb802e46db44b6bb850bca833f7879b1 ] .

_:nd9cb802e46db44b6bb850bca833f7879b1 sh:datatype xsd:boolean ;
    sh:hasValue false ;
    sh:maxCount 1 ;
    sh:message "A ballast-water cooling arrangement must not be accepted as a substitute for an inlet chest." ;
    sh:minCount 1 ;
    sh:path nltl:substituteArrangementStatus .

