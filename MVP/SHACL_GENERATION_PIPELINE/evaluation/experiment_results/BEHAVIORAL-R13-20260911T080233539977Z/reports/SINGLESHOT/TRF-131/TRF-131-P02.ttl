@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-131-P02/ship> ;
            sh:resultMessage "The ship must have an inlet chest; a ballast-water cooling arrangement cannot replace it." ;
            sh:resultPath nltl:hasComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:inletChest ;
                    sh:message "The ship must have an inlet chest; a ballast-water cooling arrangement cannot replace it." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasComponent ] ] .

