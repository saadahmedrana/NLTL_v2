@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F03/triangle> ;
                    sh:resultMessage "Value ex:blue not in list ['nltl:yellowReflectingMarkingColour', 'nltl:redReflectingMarkingColour']" ;
                    sh:resultPath nltl:reflectingMarkingColour ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:redReflectingMarkingColour nltl:yellowReflectingMarkingColour ) ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:reflectingMarkingColour ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F03/blue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF133WarningTriangleMarkingShape. See details for more information." ;
            sh:resultPath nltl:hasWarningTriangleMarking ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:TRF133WarningTriangleMarkingShape ;
                    sh:path nltl:hasWarningTriangleMarking ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F03/triangle> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F03/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:iceClass" ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:iceClass ] ] .

