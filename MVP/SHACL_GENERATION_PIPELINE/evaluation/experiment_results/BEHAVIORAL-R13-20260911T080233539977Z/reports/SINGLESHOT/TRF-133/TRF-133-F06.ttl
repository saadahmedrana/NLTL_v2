@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F06/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:iceClass" ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:iceClass ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F06/warningTriangleSideLengthValue> ;
                            sh:resultMessage "Value is not >= Literal(\"300\", datatype=xsd:decimal)" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 300.0 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 300.0 ;
                                    sh:path qudt:numericValue ] ;
                            sh:value 250.0 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F06/triangle> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"300\", datatype=xsd:decimal) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"300\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MilliM ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
                    sh:resultPath nltl:warningTriangleSideLength ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue unit:MilliM ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:maxInclusive 300.0 ;
                                            sh:minCount 1 ;
                                            sh:minInclusive 300.0 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:warningTriangleSideLength ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F06/warningTriangleSideLengthValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF133WarningTriangleMarkingShape. See details for more information." ;
            sh:resultPath nltl:hasWarningTriangleMarking ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:TRF133WarningTriangleMarkingShape ;
                    sh:path nltl:hasWarningTriangleMarking ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F06/triangle> ] .

