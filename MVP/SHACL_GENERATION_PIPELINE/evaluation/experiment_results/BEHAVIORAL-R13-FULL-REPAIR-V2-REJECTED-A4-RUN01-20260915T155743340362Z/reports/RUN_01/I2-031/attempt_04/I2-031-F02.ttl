@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/member> ;
                    sh:resultMessage "Node ex:member must conform to one or more shapes in [ sh:class nltl:localFrame ; sh:node <urn:nltl:generated-shape:I2-031-StructuralMemberShape> ; sh:property [ sh:hasValue nltl:bottomStructureLocation ; sh:path nltl:structuralLocation ] ] , [ sh:class nltl:localFrame ; sh:node <urn:nltl:generated-shape:I2-031-StructuralMemberShape> ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:transverseFrameOrientation ], [ sh:hasValue nltl:sideStructureLocation ; sh:path nltl:structuralLocation ] ] , [ sh:not [ sh:class nltl:localFrame ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-031-ApplicableLocalMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/ship> ;
            sh:resultMessage "Applicable local frames in bottom structures and transverse local frames in side structures must satisfy the local-frame requirement." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Applicable local frames in bottom structures and transverse local frames in side structures must satisfy the local-frame requirement." ;
                    sh:node <urn:nltl:generated-shape:I2-031-ApplicableLocalMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/member> ] .

