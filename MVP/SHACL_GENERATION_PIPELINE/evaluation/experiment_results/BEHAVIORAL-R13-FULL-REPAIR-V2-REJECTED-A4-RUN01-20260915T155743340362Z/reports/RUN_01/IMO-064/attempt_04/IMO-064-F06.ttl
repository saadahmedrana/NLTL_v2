@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F06/ship> ;
            sh:resultMessage "Thermal-protection adequacy approval must have approved status and cover the intended voyage, anticipated cold and wind, and applicable polar-water immersion." ;
            sh:resultPath nltl:thermalProtectionApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nc00e85efc0664ba0a811eec5ae2c9a88b7 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F06/ship> ;
            sh:resultMessage "Thermal-protection adequacy approval must have approved status and cover the intended voyage, anticipated cold and wind, and applicable polar-water immersion." ;
            sh:resultPath nltl:thermalProtectionApprovalStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc00e85efc0664ba0a811eec5ae2c9a88b7 ] .

_:nc00e85efc0664ba0a811eec5ae2c9a88b7 sh:class nltl:evidenceState ;
    sh:hasValue nltl:evidenceStateApproved ;
    sh:message "Thermal-protection adequacy approval must have approved status and cover the intended voyage, anticipated cold and wind, and applicable polar-water immersion." ;
    sh:minCount 1 ;
    sh:path nltl:thermalProtectionApprovalStatus .

