@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-113-M-F03/ship> ;
            sh:resultMessage "If the ship operates in polar waters, polar operation coverage must be recorded in the Cargo Record Book, Manual, and applicable noxious liquid substance or marine pollution emergency plan." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-113> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-113-M-F03/ship> ] .

