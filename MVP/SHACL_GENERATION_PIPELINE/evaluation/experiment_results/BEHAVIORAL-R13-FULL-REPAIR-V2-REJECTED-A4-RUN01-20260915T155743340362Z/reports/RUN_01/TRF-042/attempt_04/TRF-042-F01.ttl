@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "longitudinalPlatingFactorF2 must follow the applicable piecewise formula; derived decimal comparison uses max(1e-6*ABS(expected),1e-12)." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "longitudinalPlatingFactorF2 must follow the applicable piecewise formula; derived decimal comparison uses max(1e-6*ABS(expected),1e-12)." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?hNode ;
                      nltl:spacing ?sNode ;
                      nltl:longitudinalPlatingFactorF2 ?fNode .
                ?hNode qudt:numericValue ?h .
                ?sNode qudt:numericValue ?s .
                ?fNode qudt:numericValue ?f .
                FILTER (datatype(?h) = xsd:decimal)
                FILTER (datatype(?s) = xsd:decimal)
                FILTER (datatype(?f) = xsd:decimal)
                BIND (?h / ?s AS ?ratio)
                BIND (
                    IF(
                        ?ratio <= 1,
                        0.4 / ?ratio + 0.6,
                        1.4 - 0.4 * ?ratio
                    ) AS ?expected
                )
                FILTER (
                    ?ratio > 1.8 ||
                    ABS(?f - ?expected) >
                    IF(
                        1e-6 * ABS(?expected) > 1e-12,
                        1e-6 * ABS(?expected),
                        1e-12
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF_042_PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "yieldStrength must be a positive quantity in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "yieldStrength must be a positive quantity in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:minExclusive 0 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:yieldStrength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "corrosionAbrasionAddition must be a positive quantity not exceeding 2 mm." ;
            sh:resultPath nltl:corrosionAbrasionAddition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "corrosionAbrasionAddition must be a positive quantity not exceeding 2 mm." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 2 ;
                                    sh:minCount 1 ;
                                    sh:minExclusive 0 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:corrosionAbrasionAddition ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "hullStructuralSteelGrade must identify an allowed normal-strength or high-strength hull structural steel grade." ;
            sh:resultPath nltl:hullStructuralSteelGrade ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:normalStrengthHullStructuralSteel nltl:highStrengthHullStructuralSteel nltl:steelGradeB nltl:steelGradeD nltl:steelGradeE nltl:steelGradeAh nltl:steelGradeDh nltl:steelGradeEh nltl:steelGradeFh ) ;
                    sh:maxCount 1 ;
                    sh:message "hullStructuralSteelGrade must identify an allowed normal-strength or high-strength hull structural steel grade." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullStructuralSteelGrade ] ] .

