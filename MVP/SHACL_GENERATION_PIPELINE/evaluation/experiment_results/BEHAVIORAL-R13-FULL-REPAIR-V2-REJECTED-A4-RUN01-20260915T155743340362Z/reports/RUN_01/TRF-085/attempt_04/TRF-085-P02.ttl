@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:bollardPropellerSpeedKnown ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The known bollard propeller speed at MCR is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF085SpeedQuantityShape ; sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ] ] , [ sh:property [ sh:equals nltl:propellerDiameter ; sh:message Literal(\"The Table 6-9 lookup input must be the ship's propeller diameter.\") ; sh:path ( nltl:hasTableLookupCase nltl:lookupInputQuantity ) ], [ sh:equals nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ; sh:message Literal(\"The canonical bollard propeller speed must be the Table 6-9 lookup result.\") ; sh:path ( nltl:hasTableLookupCase nltl:lookupResultQuantity ) ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:bollardPropellerSpeedKnown ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The canonical bollard propeller speed must be provided from the Table 6-9 lookup result.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF085SpeedQuantityShape ; sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ], [ sh:message Literal(\"A Table 6-9 lookup case is required when bollard propeller speed is not known.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF085TableLookupCaseShape ; sh:path nltl:hasTableLookupCase ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF085ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P02/ship> ;
            sh:resultMessage "Bollard propeller speed known must be recorded as a boolean." ;
            sh:resultPath nltl:bollardPropellerSpeedKnown ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Bollard propeller speed known must be recorded as a boolean." ;
                    sh:minCount 1 ;
                    sh:path nltl:bollardPropellerSpeedKnown ] ] .

