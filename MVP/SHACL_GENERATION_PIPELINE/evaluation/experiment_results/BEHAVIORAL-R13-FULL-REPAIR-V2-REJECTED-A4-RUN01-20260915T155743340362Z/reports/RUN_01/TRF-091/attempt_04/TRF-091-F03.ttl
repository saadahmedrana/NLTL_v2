@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F03/milling> ;
            sh:resultMessage "The ship shall identify an ice milling sequence case used for the propulsion-line strength evaluation." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n0644d0309dd34f9bb0eb0f5a6be8891db1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F03/milling> ;
                    sh:resultMessage "The ice milling load sequence case shall have propulsion-line strength evaluation as its purpose." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n0644d0309dd34f9bb0eb0f5a6be8891db2 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F03/milling> ;
                    sh:resultMessage "The ice milling load sequence case shall have propulsion-line strength evaluation as its purpose." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n0644d0309dd34f9bb0eb0f5a6be8891db2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F03/ship> ;
            sh:resultMessage "The ship shall identify an ice milling sequence case used for the propulsion-line strength evaluation." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n0644d0309dd34f9bb0eb0f5a6be8891db1 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F03/milling> ] .

_:n0644d0309dd34f9bb0eb0f5a6be8891db1 sh:class nltl:iceMillingSequenceCase ;
    sh:message "The ship shall identify an ice milling sequence case used for the propulsion-line strength evaluation." ;
    sh:minCount 1 ;
    sh:node gen:TRF091IceMillingSequenceCaseShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasIceMillingSequenceCase .

_:n0644d0309dd34f9bb0eb0f5a6be8891db2 sh:class nltl:loadCasePurposeValue ;
    sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
    sh:message "The ice milling load sequence case shall have propulsion-line strength evaluation as its purpose." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:loadCasePurpose .

