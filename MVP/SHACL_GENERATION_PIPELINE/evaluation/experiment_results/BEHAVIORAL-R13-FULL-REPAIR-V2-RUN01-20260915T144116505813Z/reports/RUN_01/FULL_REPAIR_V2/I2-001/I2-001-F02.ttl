@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-001-F02/ship> ;
            sh:resultMessage "UR I2 Rev.4 applicability must be true for ships contracted for construction on or after 1 January 2021 and false for earlier ships." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_001_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-001-F02/ship> ] .

