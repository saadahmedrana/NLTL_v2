@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-001-F03/ship> ;
            sh:resultMessage "UR I2 Rev.4 applicability must be true for ships contracted for construction on or after 1 January 2021 and false for earlier ships." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_001_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-001-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-001-F03/ship> ;
            sh:resultMessage "A ship must have exactly one UR I2 revision applicability value." ;
            sh:resultPath nltl:urI2RevisionApplicability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "A ship must have exactly one UR I2 revision applicability value." ;
                    sh:minCount 1 ;
                    sh:path nltl:urI2RevisionApplicability ] ] .

