@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The upper ice waterline displacement must equal the greatest displacement among the linked upper ice waterline cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The upper ice waterline displacement must equal the greatest displacement among the linked upper ice waterline cases." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?duiQuantity .
                ?duiQuantity qudt:numericValue ?duiValue ;
                             qudt:unit unit:KiloTON_Metric .
                FILTER (datatype(?duiValue) = xsd:decimal)

                $this nltl:hasUpperIceWaterlineCase ?case .
                ?case nltl:waterlineCaseDisplacement ?caseQuantity .
                ?caseQuantity qudt:numericValue ?caseValue ;
                              qudt:unit unit:KiloTON_Metric .
                FILTER (datatype(?caseValue) = xsd:decimal)

                FILTER (
                    ?caseValue > ?duiValue ||
                    NOT EXISTS {
                        $this nltl:hasUpperIceWaterlineCase ?equalCase .
                        ?equalCase nltl:waterlineCaseDisplacement ?equalQuantity .
                        ?equalQuantity qudt:numericValue ?equalValue ;
                                       qudt:unit unit:KiloTON_Metric .
                        FILTER (datatype(?equalValue) = xsd:decimal)
                        FILTER (?equalValue = ?duiValue)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:I2_004_StaticShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

