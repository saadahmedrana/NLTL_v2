@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-P01/ship> ;
            sh:resultMessage "A ship must provide the normal frame angle." ;
            sh:resultPath nltl:normalFrameAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A ship must provide the normal frame angle." ;
                    sh:minCount 1 ;
                    sh:node nltlg:AngleShape ;
                    sh:path nltl:normalFrameAngle ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-P01/ship> ;
            sh:resultMessage "A ship must provide the buttock angle at the stem." ;
            sh:resultPath nltl:buttockAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A ship must provide the buttock angle at the stem." ;
                    sh:minCount 1 ;
                    sh:node nltlg:AngleShape ;
                    sh:path nltl:buttockAngle ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-P01/ship> ;
            sh:resultMessage "Bow-form applicability must be explicitly recorded." ;
            sh:resultPath nltl:bowFormApplicability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Bow-form applicability must be explicitly recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:bowFormApplicability ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-009-P01/ship> ;
            sh:resultMessage "A ship must provide its hull area." ;
            sh:resultPath nltl:hullArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "A ship must provide its hull area." ;
                    sh:minCount 1 ;
                    sh:path nltl:hullArea ] ] .

