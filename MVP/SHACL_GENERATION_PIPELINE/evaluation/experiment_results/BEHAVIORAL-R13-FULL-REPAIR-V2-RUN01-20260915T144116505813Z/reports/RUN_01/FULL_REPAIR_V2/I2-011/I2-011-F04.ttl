@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in nltlg:ApplicableBowDesignForceShape , nltlg:NonApplicableBulbousBowShape , nltlg:NonApplicablePolarClassShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlg:I2_011_BowDesignForceShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F04/ship> ] .

