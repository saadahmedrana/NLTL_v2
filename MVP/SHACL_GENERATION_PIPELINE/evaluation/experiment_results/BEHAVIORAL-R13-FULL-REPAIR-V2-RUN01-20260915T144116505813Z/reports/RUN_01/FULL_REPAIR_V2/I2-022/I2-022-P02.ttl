@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P02/ship> ;
            sh:resultMessage "The ship shall provide yield strength in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide yield strength in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:MegaPA ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:yieldStrength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P02/ship> ;
            sh:resultMessage "The ship shall provide average ice pressure in MPa." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide average ice pressure in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue qudt:MegaPA ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P02/plating> ;
                    sh:resultMessage "Node ex:plating must conform to one or more shapes in [ sh:not [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:framingAngleOmega ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:platingHullAreaClassification ] ] ] , [ sh:property [ sh:in ( nltl:bowIntermediateBottomHullArea nltl:midbodyBottomHullArea nltl:sternBottomHullArea ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Applicable plating shall provide its hull area classification.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:platingHullAreaClassification ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Applicable plating shall provide its framing angle in degrees.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:DEG ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:framingAngleOmega ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Applicable plating shall provide the externally calculated required net plate thickness in millimetres.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:MilliM ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:iceLoadRequiredNetPlateThickness ], [ sh:message Literal(\"Applicable plating shall identify its supporting structural member.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:structuralMember ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The supporting structural member shall provide frame spacing in metres.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:frameSpacing ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The supporting structural member shall provide the selected hull area factor.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:selectedHullAreaFactor ] ] ; sh:path nltl:platingSupportedByStructuralMember ], [ sh:node [ sh:class nltl:hullAreaValue ] ; sh:path nltl:platingHullAreaClassification ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:plating ;
                            sh:or ( [ sh:not [ sh:property [ sh:minCount 1 ;
                                                        sh:path nltl:framingAngleOmega ],
                                                    [ sh:minCount 1 ;
                                                        sh:path nltl:platingHullAreaClassification ] ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:message "Applicable plating shall provide the externally calculated required net plate thickness in millimetres." ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:iceLoadRequiredNetPlateThickness ],
                                            [ sh:maxCount 1 ;
                                                sh:message "Applicable plating shall provide its framing angle in degrees." ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:framingAngleOmega ],
                                            [ sh:message "Applicable plating shall identify its supporting structural member." ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class nltl:structuralMember ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path nltl:platingSupportedByStructuralMember ],
                                            [ sh:in ( nltl:bowIntermediateBottomHullArea nltl:midbodyBottomHullArea nltl:sternBottomHullArea ) ;
                                                sh:maxCount 1 ;
                                                sh:message "Applicable plating shall provide its hull area classification." ;
                                                sh:minCount 1 ;
                                                sh:path nltl:platingHullAreaClassification ],
                                            [ sh:node [ sh:class nltl:hullAreaValue ] ;
                                                sh:path nltl:platingHullAreaClassification ] ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P02/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P02/ship> ;
            sh:resultMessage "The ship shall identify applicable plating for the complex readiness assessment." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify applicable plating for the complex readiness assessment." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:plating ;
                            sh:or ( [ sh:not [ sh:property [ ],
                                                    [ ] ] ] [ sh:property [ sh:message "Applicable plating shall identify its supporting structural member." ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:platingSupportedByStructuralMember ],
                                            [ sh:maxCount 1 ;
                                                sh:message "Applicable plating shall provide the externally calculated required net plate thickness in millimetres." ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:iceLoadRequiredNetPlateThickness ],
                                            [ sh:maxCount 1 ;
                                                sh:message "Applicable plating shall provide its framing angle in degrees." ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path nltl:framingAngleOmega ],
                                            [ sh:node [ ] ;
                                                sh:path nltl:platingHullAreaClassification ],
                                            [ sh:in [ ] ;
                                                sh:maxCount 1 ;
                                                sh:message "Applicable plating shall provide its hull area classification." ;
                                                sh:minCount 1 ;
                                                sh:path nltl:platingHullAreaClassification ] ] ) ] ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P02/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P02/ship> ;
            sh:resultMessage "The ship shall provide the peak pressure factor." ;
            sh:resultPath nltl:peakPressureFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide the peak pressure factor." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:peakPressureFactor ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P02/ship> ;
            sh:resultMessage "The ship shall provide load patch height in metres." ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide load patch height in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue qudt:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:loadPatchHeight ] ] .

