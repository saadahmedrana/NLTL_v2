@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/lowerEndpoint> ;
                            sh:resultMessage "Each lower interpolation endpoint must provide a dimensionless coordinate." ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:message "Each lower interpolation endpoint must provide a dimensionless coordinate." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:interpolationPointCoordinate ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/case> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class nltl:interpolationPoint ; sh:property [ sh:message Literal(\"Each lower interpolation endpoint must provide a dimensionless coordinate.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:interpolationPointCoordinate ], [ sh:message Literal(\"Each lower interpolation endpoint must provide an externally calculated result.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:interpolationPointResult ] ]. See details for more information." ;
                    sh:resultPath nltl:interpolationLowerEndpoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class nltl:interpolationPoint ;
                                    sh:property [ sh:message "Each lower interpolation endpoint must provide a dimensionless coordinate." ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ],
                                                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:unit ] ] ;
                                            sh:path nltl:interpolationPointCoordinate ],
                                        [ sh:message "Each lower interpolation endpoint must provide an externally calculated result." ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path qudt:numericValue ] ] ;
                                            sh:path nltl:interpolationPointResult ] ] ;
                            sh:path nltl:interpolationLowerEndpoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/lowerEndpoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/ship> ;
            sh:resultMessage "The ship must provide the oblique plating interpolation case and its declared interpolation structure." ;
            sh:resultPath nltl:hasObliquePlatingInterpolationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the oblique plating interpolation case and its declared interpolation structure." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:obliquePlatingInterpolationCase ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:message "Each upper interpolation endpoint must provide an externally calculated result." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ],
                                                [ sh:message "Each upper interpolation endpoint must provide a dimensionless coordinate." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ] ] ;
                                    sh:path nltl:interpolationUpperEndpoint ],
                                [ sh:message "An oblique plating interpolation case must provide the externally calculated interpolated net plate thickness in millimetres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:interpolatedNetPlateThickness ],
                                [ sh:message "An oblique plating interpolation case must provide its framing angle in degrees." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:framingAngle ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:interpolationPoint ;
                                            sh:property [ sh:message "Each lower interpolation endpoint must provide a dimensionless coordinate." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointCoordinate ],
                                                [ sh:message "Each lower interpolation endpoint must provide an externally calculated result." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:interpolationPointResult ] ] ;
                                    sh:path nltl:interpolationLowerEndpoint ] ] ;
                    sh:path nltl:hasObliquePlatingInterpolationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F01/ship> ;
            sh:resultMessage "The ship must provide the declared longitudinal and transverse framing thickness inputs for the external interpolation calculation." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the declared longitudinal and transverse framing thickness inputs for the external interpolation calculation." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:calculationCase ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:transverseFramingNetPlateThickness ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:longitudinalFramingNetPlateThickness ] ] ;
                    sh:path nltl:hasCalculationCase ] ] .

