@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F01/case> ;
            sh:resultMessage "Each applicable calculation case shall include attached shell plating in the section modulus." ;
            sh:resultPath nltl:attachedShellPlatingIncludedInSectionModulus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n03ef7e3594c5486bb0df86321c958d17b2 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F01/case> ;
                    sh:resultMessage "Each applicable calculation case shall include attached shell plating in the section modulus." ;
                    sh:resultPath nltl:attachedShellPlatingIncludedInSectionModulus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n03ef7e3594c5486bb0df86321c958d17b2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_029_CalculationCaseShape. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:I2_029_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F01/case> ] .

_:n03ef7e3594c5486bb0df86321c958d17b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Each applicable calculation case shall include attached shell plating in the section modulus." ;
    sh:minCount 1 ;
    sh:path nltl:attachedShellPlatingIncludedInSectionModulus .

