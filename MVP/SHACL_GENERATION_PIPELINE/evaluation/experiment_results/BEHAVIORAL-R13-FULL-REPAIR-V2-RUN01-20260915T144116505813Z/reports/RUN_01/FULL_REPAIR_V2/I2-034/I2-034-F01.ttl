@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ;
                    sh:resultMessage """Node ex:member must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:longitudinalFrameOrientation ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:longitudinalFrameOrientation ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:structuralLocation ; sh:sparql [ sh:message Literal("A non-side structural member must have a structural location other than sideStructureLocation.") ; sh:select Literal("
                        PREFIX nltl: <https://w3id.org/nltl/vocab#>

                        SELECT $this
                        WHERE {
                            $this nltl:structuralLocation ?location .
                            FILTER (?location = nltl:sideStructureLocation)
                        }
                    ") ] ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:longitudinalFrameOrientation ], [ sh:hasValue nltl:sideStructureLocation ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:structuralLocation ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:I2_034_KiloNewtonQuantityShape ; sh:path nltl:midspanPlasticCollapseLoad ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:I2_034_KiloNewtonQuantityShape ; sh:path nltl:plasticStrength ], [ sh:message Literal("Each represented side-structure load case must include the demand and plastic-strength quantities and must not exceed the plastic strength.") ; sh:node gen:I2_034_LoadCaseShape ; sh:path nltl:hasStructuralMemberLoadCase ] ; sh:sparql [ sh:message Literal("Combined shear-and-bending demand must not exceed the member plastic strength or midspan plastic-collapse load.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:plasticStrength ?strengthQuantity .
                        ?strengthQuantity qudt:numericValue ?strengthValue ;
                                           qudt:unit unit:KiloN .

                        $this nltl:midspanPlasticCollapseLoad ?collapseQuantity .
                        ?collapseQuantity qudt:numericValue ?collapseValue ;
                                           qudt:unit unit:KiloN .

                        $this nltl:hasStructuralMemberLoadCase ?loadCase .
                        ?loadCase nltl:combinedShearAndBendingDemand ?demandQuantity .
                        ?demandQuantity qudt:numericValue ?demandValue ;
                                        qudt:unit unit:KiloN .

                        FILTER (
                            ?demandValue > ?strengthValue ||
                            ?demandValue > ?collapseValue
                        )
                    }
                ") ] ]""" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:I2_034_StructuralMemberShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/ship> ;
            sh:resultMessage "Each represented structural member must provide applicability information and satisfy the side-structure load-case constraint when applicable." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each represented structural member must provide applicability information and satisfy the side-structure load-case constraint when applicable." ;
                    sh:node gen:I2_034_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-034-F01/member> ] .

