@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in g:I2_046_ApplicableShape , g:I2_046_NonApplicableShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:I2_046_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F04/ship> ;
            sh:resultMessage "polarClassRequirementsApplicable must be recorded exactly once." ;
            sh:resultPath nltl:polarClassRequirementsApplicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "polarClassRequirementsApplicable must be recorded exactly once." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarClassRequirementsApplicable ] ] .

