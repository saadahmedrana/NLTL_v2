@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ship must provide a table lookup case containing the required class factors." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc3a27355a195407ca82e7489febca258b29 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ship must provide the stem angle as an angle quantity." ;
            sh:resultPath nltl:stemAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the stem angle as an angle quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:stemAngle ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/ship> ;
            sh:resultMessage "The ship must provide a table lookup case containing the required class factors." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc3a27355a195407ca82e7489febca258b29 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ship must provide the ice strength coefficient k_I as a dimensionless quantity." ;
            sh:resultPath nltl:iceStrengthCoefficientKI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the ice strength coefficient k_I as a dimensionless quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:iceStrengthCoefficientKI ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ship must provide the hull form coefficient k_h as a dimensionless quantity." ;
            sh:resultPath nltl:hullFormCoefficientKh ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the hull form coefficient k_h as a dimensionless quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:hullFormCoefficientKh ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ship must provide the externally calculated first candidate bow ice force." ;
            sh:resultPath nltl:designVerticalIceForceAtBowCandidateOne ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the externally calculated first candidate bow ice force." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designVerticalIceForceAtBowCandidateOne ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ship must provide the upper ice waterline draught as a length quantity." ;
            sh:resultPath nltl:upperIceWaterlineDraughtDUI ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the upper ice waterline draught as a length quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:upperIceWaterlineDraughtDUI ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/ship> ;
            sh:resultMessage "The ship must provide the externally calculated design vertical ice force at the bow." ;
            sh:resultPath nltl:designVerticalIceForceAtBow ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the externally calculated design vertical ice force at the bow." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:designVerticalIceForceAtBow ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-050-I-F11/calculation> ;
            sh:resultMessage "The ship must provide the externally calculated second candidate bow ice force." ;
            sh:resultPath nltl:designVerticalIceForceAtBowCandidateTwo ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the externally calculated second candidate bow ice force." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:designVerticalIceForceAtBowCandidateTwo ] ] .

_:N17babd011a5c4c72886807c7bc6c59fa sh:datatype xsd:decimal ;
    sh:minCount 1 ;
    sh:path qudt:numericValue .

_:N1e604fa9204c43ea8a7a9e26b903a868 sh:message "The table lookup case must provide the crushing failure class factor." ;
    sh:minCount 1 ;
    sh:node [ sh:class qudt:QuantityValue ;
            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path qudt:unit ],
                [ sh:datatype xsd:decimal ;
                    sh:minCount 1 ;
                    sh:path qudt:numericValue ] ] ;
    sh:path nltl:crushingFailureClassFactor .

_:N21163b06a9334624aec6bba31d803d1c sh:datatype xsd:decimal ;
