@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/caseDesignVerticalIceBendingMoment> ;
                            sh:resultMessage "Node ex:caseDesignVerticalIceBendingMoment->qudt:unit does not contain a value in the set: ['<http://qudt.org/vocab/unit/MegaN-M>']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/bendingCase> ;
                    sh:resultMessage "The externally determined design vertical ice bending moment shall be provided in meganewton metres." ;
                    sh:resultPath nltl:caseDesignVerticalIceBendingMoment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class qudt:QuantityValue ;
                            sh:maxCount 1 ;
                            sh:message "The externally determined design vertical ice bending moment shall be provided in meganewton metres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:caseDesignVerticalIceBendingMoment ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/caseDesignVerticalIceBendingMoment> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/ship> ;
            sh:resultMessage "The ship shall provide a hull-girder bending-moment calculation case." ;
            sh:resultPath nltl:hasHullGirderBendingMomentCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:hullGirderBendingMomentCalculationCase ;
                    sh:message "The ship shall provide a hull-girder bending-moment calculation case." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-054-HullGirderCaseShape> ;
                    sh:path nltl:hasHullGirderBendingMomentCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/bendingCase> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/bendingCase> ;
                    sh:resultMessage "The calculation case shall provide interpolation-point data for the bending-moment distribution factor." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:interpolationPoint ;
                            sh:message "The calculation case shall provide interpolation-point data for the bending-moment distribution factor." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-054-InterpolationPointShape> ;
                            sh:path nltl:hasInterpolationPoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/ship> ;
            sh:resultMessage "The ship shall provide a calculation case for the design vertical ice bending moment assessment." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "The ship shall provide a calculation case for the design vertical ice bending moment assessment." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-054-CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F09/bendingCase> ] .

