@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp1> ;
                            sh:resultMessage "Each interpolation point shall provide its externally determined result." ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nedd5828e5f74423eacd3edc2af34516eb32 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp1> ;
                            sh:resultMessage "Each interpolation point shall provide its dimensionless coordinate." ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nedd5828e5f74423eacd3edc2af34516eb28 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/bendingCase> ;
                    sh:resultMessage "The calculation case shall provide interpolation-point data for the bending-moment distribution factor." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nedd5828e5f74423eacd3edc2af34516eb15 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp1> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp2> ;
                            sh:resultMessage "Each interpolation point shall provide its dimensionless coordinate." ;
                            sh:resultPath nltl:interpolationPointCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nedd5828e5f74423eacd3edc2af34516eb28 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp2> ;
                            sh:resultMessage "Each interpolation point shall provide its externally determined result." ;
                            sh:resultPath nltl:interpolationPointResult ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:nedd5828e5f74423eacd3edc2af34516eb32 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/bendingCase> ;
                    sh:resultMessage "The calculation case shall provide interpolation-point data for the bending-moment distribution factor." ;
                    sh:resultPath nltl:hasInterpolationPoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nedd5828e5f74423eacd3edc2af34516eb15 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/interp2> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/ship> ;
            sh:resultMessage "The ship shall provide a calculation case for the design vertical ice bending moment assessment." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "The ship shall provide a calculation case for the design vertical ice bending moment assessment." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-054-CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-P03/bendingCase> ] .

_:N1cae1a509eb14572b0b9b99fc933b7b4 sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

_:N2593a23ae2654b1cbd068e5bd07d0f6a sh:datatype xsd:decimal ;
