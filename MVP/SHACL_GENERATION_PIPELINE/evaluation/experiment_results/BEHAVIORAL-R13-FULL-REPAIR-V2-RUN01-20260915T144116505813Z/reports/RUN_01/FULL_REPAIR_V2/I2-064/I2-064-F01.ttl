@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F01/calculation> ;
                    sh:resultMessage "Less than 1 values on ex:calculation->nltl:calculationMethod" ;
                    sh:resultPath nltl:calculationMethod ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:path nltl:calculationMethod ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:message Literal(\"Each calculation case must identify a calculation method; the linear method applies only to linear calculation cases.\") ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:calculationMethod ] ]. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:minCount 1 ;
                    sh:node [ sh:message "Each calculation case must identify a calculation method; the linear method applies only to linear calculation cases." ;
                            sh:property [ sh:minCount 1 ;
                                    sh:path nltl:calculationMethod ] ] ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F01/calculation> ] .

