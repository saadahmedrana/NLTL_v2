@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F05/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:structuralMember ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:node [ sh:class nltl:hullStructure ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The applicable buckling criteria must be recorded as satisfied.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bucklingCriteriaSatisfied ] ] ; sh:property [ sh:class nltl:structuralMemberFlange ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property <http://recursion.too.deep>, <http://recursion.too.deep> ] ; sh:path nltl:nominalFlangeVonMisesStress ] ] ; sh:path nltl:hasStructuralMemberFlange ], [ sh:class nltl:structuralMemberWeb ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property <http://recursion.too.deep>, <http://recursion.too.deep> ] ; sh:path nltl:nominalShearStress ] ] ; sh:path nltl:hasStructuralMemberWeb ] ] ; sh:path nltl:hasStructuralMember ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship must provide one yield-strength quantity in MPa.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:yieldStrength ] ] , [ sh:not [ sh:property [ sh:path nltl:hasCalculationCase ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:hasValue nltl:linearCalculationMethodValue ; sh:path nltl:calculationMethod ] ] ] ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-064-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F05/ship> ] .

