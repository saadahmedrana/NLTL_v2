@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-F02/ship> ;
            sh:resultMessage "A ship designed to operate in at least thin first-year ice with possible old-ice inclusions, and not declared as category A, must be category B." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A ship designed to operate in at least thin first-year ice with possible old-ice inclusions, and not declared as category A, must be category B." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:designIceCondition ?designIceCondition .
                FILTER (
                    ?designIceCondition = nltl:thinFirstYearIceWithPossibleOldIceInclusions
                    || ?designIceCondition = nltl:mediumFirstYearIceWithPossibleOldIceInclusions
                )
                FILTER NOT EXISTS {
                    $this nltl:shipCategory nltl:polarShipCategoryA .
                }
                FILTER NOT EXISTS {
                    $this nltl:shipCategory nltl:polarShipCategoryB .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO002ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-002-F02/ship> ;
            sh:resultMessage "A ship must declare its Polar Code category." ;
            sh:resultPath nltl:shipCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarShipCategoryValue ;
                    sh:message "A ship must declare its Polar Code category." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:shipCategory ] ] .

