@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F01/ship> ;
            sh:resultMessage "When the applicable first-year-ice conditions hold, ice type classification shall not contain a conflicting value." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the applicable first-year-ice conditions hold, ice type classification shall not contain a conflicting value." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceOriginType nltl:seaIceOrigin ;
                      nltl:winterGrowthCount ?growth ;
                      nltl:iceThickness ?thicknessNode .
                ?thicknessNode qudt:numericValue ?thickness ;
                                qudt:unit unit:M .
                FILTER (
                    ?growth <= 1 &&
                    ?thickness >= 0.3 &&
                    ?thickness <= 2.0
                )
                $this nltl:iceTypeClassification ?classification .
                FILTER (?classification != nltl:firstYearIce)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_004_StaticShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F01/ship> ;
            sh:resultMessage "When the ice is sea ice with no more than one winter growth and thickness from 0.3 m through 2.0 m, the ice type shall be first-year ice." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the ice is sea ice with no more than one winter growth and thickness from 0.3 m through 2.0 m, the ice type shall be first-year ice." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceOriginType nltl:seaIceOrigin ;
                      nltl:winterGrowthCount ?growth ;
                      nltl:iceThickness ?thicknessNode .
                ?thicknessNode qudt:numericValue ?thickness ;
                                qudt:unit unit:M .
                FILTER (
                    ?growth <= 1 &&
                    ?thickness >= 0.3 &&
                    ?thickness <= 2.0
                )
                FILTER NOT EXISTS {
                    $this nltl:iceTypeClassification nltl:firstYearIce .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_004_StaticShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-004-F01/ship> ] .

