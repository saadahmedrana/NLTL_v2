@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-005-F01/ship> ;
            sh:resultMessage "An ice condition of 'ice free waters' requires totalIcePresent to be false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "An ice condition of 'ice free waters' requires totalIcePresent to be false." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:iceCondition ?condition .
                FILTER (STR(?condition) = "ice free waters")
                FILTER NOT EXISTS {
                    $this nltl:totalIcePresent false .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-005-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-005-F01/ship> ] .

