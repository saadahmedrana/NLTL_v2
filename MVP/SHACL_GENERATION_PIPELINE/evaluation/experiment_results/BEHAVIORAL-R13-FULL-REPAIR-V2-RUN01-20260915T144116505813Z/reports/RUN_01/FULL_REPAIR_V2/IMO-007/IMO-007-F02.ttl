@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F02/ship> ;
            sh:resultMessage "When the ice condition is open water, sea ice concentration shall be a numeric value less than 1 with unitless units, and ice of land origin shall be recorded as false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the ice condition is open water, sea ice concentration shall be a numeric value less than 1 with unitless units, and ice of land origin shall be recorded as false." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification nltl:openWaterIceCondition .
                FILTER (
                    NOT EXISTS {
                        $this nltl:seaIceConcentration ?concentration .
                        ?concentration qudt:numericValue ?value ;
                                       qudt:unit unit:UNITLESS .
                        FILTER (
                            ?value < 1
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:seaIceConcentration ?concentration .
                        FILTER NOT EXISTS {
                            ?concentration qudt:numericValue ?value .
                            FILTER (
                                ?value < 1
                            )
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:seaIceConcentration ?concentration .
                        FILTER NOT EXISTS {
                            ?concentration qudt:unit unit:UNITLESS .
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:seaIceConcentration ?concentration .
                        ?concentration qudt:unit ?unit .
                        FILTER (?unit != unit:UNITLESS)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceOfLandOriginPresent ?present .
                        FILTER (
                            datatype(?present) = xsd:boolean &&
                            ?present = false
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:iceOfLandOriginPresent ?present .
                        FILTER NOT EXISTS {
                            FILTER (
                                datatype(?present) = xsd:boolean &&
                                ?present = false
                            )
                        }
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_007_OpenWaterDefinitionShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F02/ship> ] .

