@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-F01/ship> ;
            sh:resultMessage "For thin first-year ice, ice thickness must be between 0.3 m and 0.7 m inclusive." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For thin first-year ice, ice thickness must be between 0.3 m and 0.7 m inclusive." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>

SELECT $this
WHERE {
    $this nltl:iceTypeClassification nltl:thinFirstYearIce .
    FILTER NOT EXISTS {
        $this nltl:iceThickness ?thickness .
        ?thickness a qudt:QuantityValue ;
                   qudt:numericValue ?value ;
                   qudt:unit unit:M .
        FILTER (
            isNumeric(?value) &&
            ?value >= 0.3 &&
            ?value <= 0.7
        )
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-008> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-F01/ship> ] .

