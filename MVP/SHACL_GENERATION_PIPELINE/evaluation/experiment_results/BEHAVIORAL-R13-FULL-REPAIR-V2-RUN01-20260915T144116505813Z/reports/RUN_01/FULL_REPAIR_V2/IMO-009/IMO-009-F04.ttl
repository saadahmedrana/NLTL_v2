@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F04/ship> ;
            sh:resultMessage "For bergy waters, total ice concentration must be a dimensionless quantity no greater than 1/10." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For bergy waters, total ice concentration must be a dimensionless quantity no greater than 1/10." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
SELECT $this
WHERE {
    $this nltl:iceCondition ?condition .
    FILTER (STR(?condition) = "bergy waters")
    FILTER NOT EXISTS {
        $this nltl:totalIceConcentration ?quantity .
        ?quantity a qudt:QuantityValue ;
            qudt:numericValue ?value ;
            qudt:unit unit:UNITLESS .
        FILTER (isNumeric(?value) && ?value <= 1)
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO009BergyWatersShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F04/ship> ] .

