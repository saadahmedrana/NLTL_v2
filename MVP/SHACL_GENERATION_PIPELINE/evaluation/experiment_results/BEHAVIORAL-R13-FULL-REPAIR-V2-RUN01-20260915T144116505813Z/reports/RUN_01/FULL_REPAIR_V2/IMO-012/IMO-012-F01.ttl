@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-012-F01/ship> ;
            sh:resultMessage "Polar service temperature must be at least 10 deg C below the lowest MDLT." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Polar service temperature must be at least 10 deg C below the lowest MDLT." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:lowestMdlt ?mdltQuantity ;
                      nltl:polarServiceTemperature ?pstQuantity .
                ?mdltQuantity qudt:numericValue ?mdltValue .
                ?pstQuantity qudt:numericValue ?pstValue .
                FILTER (?pstValue > (?mdltValue - 10))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape g:IMO_012_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-012-F01/ship> ] .

