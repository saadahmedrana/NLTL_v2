@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F01/ship> ;
            sh:resultMessage "Polar Ship Certificate validity, survey, and endorsement dates must match the corresponding categorized SOLAS certificate schedule dates." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Polar Ship Certificate validity, survey, and endorsement dates must match the corresponding categorized SOLAS certificate schedule dates." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:polarCertificateValidityDates ?value .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule /
                              nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?value ;
                                nltl:certificateScheduleDateType nltl:validityDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:surveyDates ?value .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule /
                              nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?value ;
                                nltl:certificateScheduleDateType nltl:surveyDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:endorsementDates ?value .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule /
                              nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?value ;
                                nltl:certificateScheduleDateType nltl:endorsementDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule /
                          nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?value ;
                            nltl:certificateScheduleDateType nltl:validityDateCategory .
                    FILTER NOT EXISTS {
                        $this nltl:polarCertificateValidityDates ?value
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule /
                          nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?value ;
                            nltl:certificateScheduleDateType nltl:surveyDateCategory .
                    FILTER NOT EXISTS {
                        $this nltl:surveyDates ?value
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule /
                          nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?value ;
                            nltl:certificateScheduleDateType nltl:endorsementDateCategory .
                    FILTER NOT EXISTS {
                        $this nltl:endorsementDates ?value
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_017_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F01/ship> ] .

