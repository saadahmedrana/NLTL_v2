@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ;
            sh:resultMessage "Polar Ship Certificate validity, survey, and endorsement dates must match the corresponding categorized SOLAS certificate schedule dates." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Polar Ship Certificate validity, survey, and endorsement dates must match the corresponding categorized SOLAS certificate schedule dates." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:polarCertificateValidityDates ?value .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule /
                              nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?value ;
                                nltl:certificateScheduleDateType nltl:validityDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:surveyDates ?value .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule /
                              nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?value ;
                                nltl:certificateScheduleDateType nltl:surveyDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:endorsementDates ?value .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule /
                              nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?value ;
                                nltl:certificateScheduleDateType nltl:endorsementDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule /
                          nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?value ;
                            nltl:certificateScheduleDateType nltl:validityDateCategory .
                    FILTER NOT EXISTS {
                        $this nltl:polarCertificateValidityDates ?value
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule /
                          nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?value ;
                            nltl:certificateScheduleDateType nltl:surveyDateCategory .
                    FILTER NOT EXISTS {
                        $this nltl:surveyDates ?value
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule /
                          nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?value ;
                            nltl:certificateScheduleDateType nltl:endorsementDateCategory .
                    FILTER NOT EXISTS {
                        $this nltl:endorsementDates ?value
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_017_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ;
            sh:resultMessage "The ship must have an applicable SOLAS certificate schedule with date records." ;
            sh:resultPath nltl:hasSolasCertificateSchedule ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:solasCertificateSchedule ;
                    sh:message "The ship must have an applicable SOLAS certificate schedule with date records." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:class nltl:certificateScheduleDateRecord ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:in [ ] ;
                                                    sh:message "Each SOLAS certificate schedule date record must have a valid date category." ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:certificateScheduleDateType ],
                                                [ sh:datatype xsd:date ;
                                                    sh:message "Each SOLAS certificate schedule date record must contain a date." ;
                                                    sh:minCount 1 ;
                                                    sh:path nltl:certificateScheduleDate ] ] ;
                                    sh:path nltl:hasCertificateScheduleDateRecord ] ] ;
                    sh:path nltl:hasSolasCertificateSchedule ] ] .

