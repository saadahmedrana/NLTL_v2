@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "The Polar Ship Certificate supplement must be present." ;
            sh:resultPath nltl:polarCertificateSupplementPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n8e1b67ab053a433a82b72aeaefd8b215b4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "The ship must have a Polar Certificate supplement." ;
            sh:resultPath nltl:hasPolarCertificateSupplement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarCertificateSupplement ;
                    sh:message "The ship must have a Polar Certificate supplement." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:class nltl:requiredEquipmentRecords ;
                                    sh:message "The Polar Certificate supplement must record the required equipment." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:hasRequiredEquipmentRecords ] ] ;
                    sh:path nltl:hasPolarCertificateSupplement ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "The Polar Ship Certificate supplement must be present." ;
            sh:resultPath nltl:polarCertificateSupplementPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n8e1b67ab053a433a82b72aeaefd8b215b4 ] .

_:n8e1b67ab053a433a82b72aeaefd8b215b4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The Polar Ship Certificate supplement must be present." ;
    sh:minCount 1 ;
    sh:path nltl:polarCertificateSupplementPresent .

