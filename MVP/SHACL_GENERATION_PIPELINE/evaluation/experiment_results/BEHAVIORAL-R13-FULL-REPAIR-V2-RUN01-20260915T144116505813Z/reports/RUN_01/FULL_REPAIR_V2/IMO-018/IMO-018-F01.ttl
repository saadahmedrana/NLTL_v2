@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-018-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ice capability methodology applicability decision must be recorded as true or false.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceCapabilityMethodologyApplicable ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When an ice capability methodology is applicable, the certificate must reference the methodology.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:certificateMethodologyReferencePresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When an ice capability methodology is applicable, the methodology must have Administration acceptance.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:administrationAcceptanceStatus ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ice capability methodology applicability decision must be recorded as true or false.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceCapabilityMethodologyApplicable ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-018-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-018-F01/ship> ] .

