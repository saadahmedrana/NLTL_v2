@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-024-F02/ship> ;
            sh:resultMessage "The ship's PWOM must include or refer to specific polar-water incident procedures." ;
            sh:resultPath nltl:polarIncidentProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n63cb1c42670947dcaa8b4a9b2176cb36b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-024-F02/ship> ;
            sh:resultMessage "The ship's PWOM must include or refer to specific polar-water incident procedures." ;
            sh:resultPath nltl:polarIncidentProcedurePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n63cb1c42670947dcaa8b4a9b2176cb36b1 ] .

_:n63cb1c42670947dcaa8b4a9b2176cb36b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship's PWOM must include or refer to specific polar-water incident procedures." ;
    sh:minCount 1 ;
    sh:path nltl:polarIncidentProcedurePresent .

