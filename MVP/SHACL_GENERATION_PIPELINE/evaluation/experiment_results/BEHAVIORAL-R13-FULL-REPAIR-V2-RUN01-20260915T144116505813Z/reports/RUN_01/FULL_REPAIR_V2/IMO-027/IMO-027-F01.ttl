@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-027-F01/ship> ;
            sh:resultMessage "The PWOM shall include risk-based procedures for voyage-limit avoidance." ;
            sh:resultPath nltl:voyageLimitAvoidance ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinLengthConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The PWOM shall include risk-based procedures for voyage-limit avoidance." ;
                    sh:minCount 1 ;
                    sh:minLength 1 ;
                    sh:path nltl:voyageLimitAvoidance ] ;
            sh:value ""^^xsd:string ] .

