@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When ice operation is applicable, applicable escort or icebreaker-assistance requirements must be recorded.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:escortRequirementsPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When ice operation is applicable, ice-operation monitoring and safety procedures must be present.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceSafetyMonitoringProcedurePresent ], [ sh:datatype xsd:string ; sh:message Literal(\"When ice operation is applicable, escorted-operation limitations must be recorded.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:escortedOperationLimits ], [ sh:datatype xsd:string ; sh:message Literal(\"When ice operation is applicable, independent-operation limitations must be recorded.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:independentOperationLimits ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:iceOperationApplicable ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:iceOperationApplicable ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_030_StaticShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F03/ship> ] .

