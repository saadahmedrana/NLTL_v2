@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-034-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:iceAccretionLikely ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When ice accretion is likely, the ship must have a design that minimizes ice accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceAccretionMinimizationDesignPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"When ice accretion is likely, the ship must have the required means for removing ice.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:requiredIceRemovalMeansPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:iceAccretionLikely ], [ sh:datatype xsd:string ; sh:message Literal(\"When ice accretion is likely, the ship must identify the ice-removal means required by the Administration.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:administrationRequiredIceRemovalMeans ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_034_IceAccretionRemovalMeansShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-034-F01/ship> ] .

