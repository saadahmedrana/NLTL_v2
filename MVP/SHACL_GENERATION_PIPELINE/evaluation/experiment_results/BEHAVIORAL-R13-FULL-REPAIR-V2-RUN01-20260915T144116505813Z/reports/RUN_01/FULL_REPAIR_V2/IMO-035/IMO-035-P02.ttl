@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-P02/ship> ;
            sh:resultMessage "PWOM icing allowance values must match the stability calculation." ;
            sh:resultPath nltl:polarWaterOperationalManualIcingAllowanceValues ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:equals nltl:stabilityCalculationIcingAllowanceValues ;
                    sh:message "PWOM icing allowance values must match the stability calculation." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarWaterOperationalManualIcingAllowanceValues ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-P02/ship> ;
            sh:resultMessage "The PWOM must state that icing allowance information is present." ;
            sh:resultPath nltl:polarWaterOperationalManualIcingAllowanceInformationPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ncc446514708742a8bd30187e6d588ca8b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-P02/ship> ;
            sh:resultMessage "The PWOM must state that icing allowance information is present." ;
            sh:resultPath nltl:polarWaterOperationalManualIcingAllowanceInformationPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ncc446514708742a8bd30187e6d588ca8b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-P02/ship> ;
            sh:resultMessage "Stability calculation icing allowance values are required." ;
            sh:resultPath nltl:stabilityCalculationIcingAllowanceValues ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "Stability calculation icing allowance values are required." ;
                    sh:minCount 1 ;
                    sh:path nltl:stabilityCalculationIcingAllowanceValues ] ] .

_:ncc446514708742a8bd30187e6d588ca8b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The PWOM must state that icing allowance information is present." ;
    sh:minCount 1 ;
    sh:path nltl:polarWaterOperationalManualIcingAllowanceInformationPresent .

