@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F04/ship> ;
            sh:resultMessage "Damage extents and selected vertical damage position must satisfy the Polar Code piecewise formulas and inclusive vertical range." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Damage extents and selected vertical damage position must satisfy the Polar Code piecewise formulas and inclusive vertical range." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthNode ;
                      nltl:upperIceWaterlineDraught ?draughtNode ;
                      nltl:longitudinalDamageExtent ?longNode ;
                      nltl:verticalDamageExtent ?verticalNode ;
                      nltl:selectedVerticalDamagePosition ?positionNode .

                ?lengthNode qudt:numericValue ?length ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                ?draughtNode qudt:numericValue ?draught ;
                             qudt:unit <http://qudt.org/vocab/unit/M> .
                ?longNode qudt:numericValue ?longitudinal ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
                ?verticalNode qudt:numericValue ?vertical ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .
                ?positionNode qudt:numericValue ?position ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .

                FILTER (
                    ?longitudinal != IF(
                        ?forward,
                        0.045 * ?length,
                        0.015 * ?length
                    )
                    ||
                    ?vertical != IF(
                        0.20 * ?draught < ?longitudinal,
                        0.20 * ?draught,
                        ?longitudinal
                    )
                    ||
                    ?position < 0
                    ||
                    ?position > 1.20 * ?draught
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-038-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F04/ship> ] .

