@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-041-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Hydraulic opening actuation requires freezing or excessive-viscosity control for the hydraulic fluid.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hydraulicFluidFreezingOrViscosityControlPresent ], [ sh:datatype xsd:string ; sh:hasValue Literal("hydraulic") ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A ship with hydraulic opening actuation must identify that actuation type.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:openingActuationType ] ] , [ sh:property [ sh:datatype xsd:string ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The opening actuation type is required to determine applicability of the hydraulic-fluid protection requirement.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:openingActuationType ] ; sh:sparql [ sh:message Literal("Non-hydraulic opening actuation must not be classified as hydraulic.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:openingActuationType ?actuationType .
                        FILTER (?actuationType = "hydraulic")
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-041> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-041-F02/ship> ] .

