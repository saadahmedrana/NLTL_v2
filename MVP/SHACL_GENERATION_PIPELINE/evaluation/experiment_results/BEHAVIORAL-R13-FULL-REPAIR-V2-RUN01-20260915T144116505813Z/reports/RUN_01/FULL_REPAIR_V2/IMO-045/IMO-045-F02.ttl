@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:not [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:machinerySeawaterSupply ] ] ] , [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Machinery seawater supplies must have ice-ingestion prevention.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceIngestionPreventionPresent ] ] [ sh:property [ sh:hasValue nltl:evidenceStateApproved ; sh:message Literal(\"An alternative functionality arrangement for the machinery seawater supply must have approved status.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:alternateFunctionalityArrangementApprovalStatus ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"A machinery seawater supply must be identified before its alternative compliance path is evaluated.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:machinerySeawaterSupply ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-045> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F02/ship> ] .

