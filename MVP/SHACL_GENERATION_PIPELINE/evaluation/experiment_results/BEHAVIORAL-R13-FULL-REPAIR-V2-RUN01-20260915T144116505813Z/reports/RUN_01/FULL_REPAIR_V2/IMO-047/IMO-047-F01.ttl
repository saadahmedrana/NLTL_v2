@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/ship> ;
            sh:resultMessage "The combustion-air temperature must be supplied in degrees Celsius." ;
            sh:resultPath nltl:combustionAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The combustion-air temperature must be supplied in degrees Celsius." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO047TemperatureQuantityShape ;
                    sh:path nltl:combustionAirTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/ship> ;
            sh:resultMessage "Combustion-air temperature control must be recorded as present." ;
            sh:resultPath nltl:combustionAirTemperatureControlPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n05c3a159076d430594307781911a3ea5b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/ship> ;
            sh:resultMessage "The combustion-air temperature must be within the engine manufacturer's minimum and maximum criteria." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The combustion-air temperature must be within the engine manufacturer's minimum and maximum criteria." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:combustionAirTemperatureControlPresent true .
                    $this nltl:combustionAirTemperature ?temperatureQuantity .
                    $this nltl:manufacturerMinAirTemperature ?minimumQuantity .
                    $this nltl:manufacturerMaxAirTemperature ?maximumQuantity .

                    ?temperatureQuantity
                        qudt:numericValue ?temperatureValue ;
                        qudt:unit <http://qudt.org/vocab/unit/DEG_C> .

                    ?minimumQuantity
                        qudt:numericValue ?minimumValue ;
                        qudt:unit <http://qudt.org/vocab/unit/DEG_C> .

                    ?maximumQuantity
                        qudt:numericValue ?maximumValue ;
                        qudt:unit <http://qudt.org/vocab/unit/DEG_C> .

                    FILTER (
                        datatype(?temperatureValue) = xsd:decimal &&
                        datatype(?minimumValue) = xsd:decimal &&
                        datatype(?maximumValue) = xsd:decimal &&
                        ?temperatureValue >= ?minimumValue &&
                        ?temperatureValue <= ?maximumValue
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO047ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/ship> ;
            sh:resultMessage "The manufacturer's maximum combustion-air temperature criterion must be supplied in degrees Celsius." ;
            sh:resultPath nltl:manufacturerMaxAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The manufacturer's maximum combustion-air temperature criterion must be supplied in degrees Celsius." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO047TemperatureQuantityShape ;
                    sh:path nltl:manufacturerMaxAirTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/ship> ;
            sh:resultMessage "The manufacturer's minimum combustion-air temperature criterion must be supplied in degrees Celsius." ;
            sh:resultPath nltl:manufacturerMinAirTemperature ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The manufacturer's minimum combustion-air temperature criterion must be supplied in degrees Celsius." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO047TemperatureQuantityShape ;
                    sh:path nltl:manufacturerMinAirTemperature ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-F01/ship> ;
            sh:resultMessage "Combustion-air temperature control must be recorded as present." ;
            sh:resultPath nltl:combustionAirTemperatureControlPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n05c3a159076d430594307781911a3ea5b2 ] .

_:n05c3a159076d430594307781911a3ea5b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Combustion-air temperature control must be recorded as present." ;
    sh:minCount 1 ;
    sh:path nltl:combustionAirTemperatureControlPresent .

