@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-057-F01/ship> ;
            sh:resultMessage "Each containing compartment of a linked fire pump must be maintained above 0 degrees Celsius." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each containing compartment of a linked fire pump must be maintained above 0 degrees Celsius." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasComponent ?pump .
                ?pump a ?pumpType .
                FILTER (
                    ?pumpType IN (
                        nltl:firePump,
                        nltl:emergencyFirePump,
                        nltl:waterMistPump,
                        nltl:waterSprayPump
                    )
                )
                ?pump nltl:hasContainingCompartment ?compartment .
                FILTER NOT EXISTS {
                    ?compartment a nltl:compartment ;
                        nltl:maintainedTemperature ?quantity .
                    ?quantity a qudt:QuantityValue ;
                        qudt:numericValue ?value ;
                        qudt:unit unit:DEG_C .
                    FILTER (
                        ?value > 0
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_057_StaticShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-057-F01/ship> ] .

