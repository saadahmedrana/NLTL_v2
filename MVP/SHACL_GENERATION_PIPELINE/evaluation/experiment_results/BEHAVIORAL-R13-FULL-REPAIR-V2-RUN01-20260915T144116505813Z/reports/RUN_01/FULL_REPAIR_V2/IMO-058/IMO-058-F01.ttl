@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-F01/section1> ;
                    sh:resultMessage "An exposed fire-main section shall have isolation capability." ;
                    sh:resultPath nltl:fireMainSectionIsolationCapability ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n4b4a8605a93149c0b9a6a82c5a4666d9b2 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-F01/section1> ;
                    sh:resultMessage "Means of draining an exposed fire-main section shall be provided." ;
                    sh:resultPath nltl:fireMainSectionDrainageMeansPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n4b4a8605a93149c0b9a6a82c5a4666d9b3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-F01/section1> ;
                    sh:resultMessage "An exposed fire-main section shall have isolation capability." ;
                    sh:resultPath nltl:fireMainSectionIsolationCapability ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n4b4a8605a93149c0b9a6a82c5a4666d9b2 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-F01/section1> ;
                    sh:resultMessage "Means of draining an exposed fire-main section shall be provided." ;
                    sh:resultPath nltl:fireMainSectionDrainageMeansPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n4b4a8605a93149c0b9a6a82c5a4666d9b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-F01/ship> ;
            sh:resultMessage "Each linked exposed fire-main section shall provide the required isolation and drainage capabilities." ;
            sh:resultPath nltl:hasExposedFireMainSection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:exposedFireMainSectionItem ;
                    sh:message "Each linked exposed fire-main section shall provide the required isolation and drainage capabilities." ;
                    sh:node gen:IMO_058_ExposedFireMainSectionShape ;
                    sh:path nltl:hasExposedFireMainSection ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-F01/section1> ] .

_:n4b4a8605a93149c0b9a6a82c5a4666d9b2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "An exposed fire-main section shall have isolation capability." ;
    sh:minCount 1 ;
    sh:path nltl:fireMainSectionIsolationCapability .

_:n4b4a8605a93149c0b9a6a82c5a4666d9b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Means of draining an exposed fire-main section shall be provided." ;
    sh:minCount 1 ;
    sh:path nltl:fireMainSectionDrainageMeansPresent .

