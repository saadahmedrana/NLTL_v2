@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F02/ship> ;
            sh:resultMessage "The ship shall record ice and snow mitigation coverage." ;
            sh:resultPath nltl:iceSnowMitigationCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ncf096f1a7fdb42aabef22524e641fc72b1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F02/route1> ;
                    sh:resultMessage "Each exposed escape route shall be accessible." ;
                    sh:resultPath nltl:escapeRouteAccessibleStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:ncf096f1a7fdb42aabef22524e641fc72b3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F02/route1> ;
                    sh:resultMessage "Each exposed escape route shall be safe." ;
                    sh:resultPath nltl:escapeRouteSafeStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:ncf096f1a7fdb42aabef22524e641fc72b4 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F02/route1> ;
                    sh:resultMessage "Each exposed escape route shall be accessible." ;
                    sh:resultPath nltl:escapeRouteAccessibleStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:ncf096f1a7fdb42aabef22524e641fc72b3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F02/route1> ;
                    sh:resultMessage "Each exposed escape route shall be safe." ;
                    sh:resultPath nltl:escapeRouteSafeStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:ncf096f1a7fdb42aabef22524e641fc72b4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-062-ExposedEscapeRouteShape>. See details for more information." ;
            sh:resultPath nltl:hasExposedEscapeRoute ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-062-ExposedEscapeRouteShape> ;
                    sh:path nltl:hasExposedEscapeRoute ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F02/route1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F02/ship> ;
            sh:resultMessage "The ship shall record ice and snow mitigation coverage." ;
            sh:resultPath nltl:iceSnowMitigationCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ncf096f1a7fdb42aabef22524e641fc72b1 ] .

_:ncf096f1a7fdb42aabef22524e641fc72b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall record ice and snow mitigation coverage." ;
    sh:minCount 1 ;
    sh:path nltl:iceSnowMitigationCoverage .

_:ncf096f1a7fdb42aabef22524e641fc72b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Each exposed escape route shall be accessible." ;
    sh:minCount 1 ;
    sh:path nltl:escapeRouteAccessibleStatus .

_:ncf096f1a7fdb42aabef22524e641fc72b4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Each exposed escape route shall be safe." ;
    sh:minCount 1 ;
    sh:path nltl:escapeRouteSafeStatus .

