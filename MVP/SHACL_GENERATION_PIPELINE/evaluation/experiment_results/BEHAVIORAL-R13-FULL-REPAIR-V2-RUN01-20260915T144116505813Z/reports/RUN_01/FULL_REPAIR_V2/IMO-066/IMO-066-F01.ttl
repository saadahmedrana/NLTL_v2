@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:shipExposedToIceAccretion ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:shipExposedToIceAccretion ], [ sh:message Literal(\"At least one embarkation area must have associated means to remove or prevent ice and snow accretion.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:class nltl:iceSnowRemovalOrPreventionMeans ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasIceSnowRemovalOrPreventionMeans ], [ sh:hasValue nltl:embarkationAreaProtectedItem ; sh:path nltl:protectedItemCategory ] ] ], [ sh:message Literal(\"At least one escape route must have associated means to remove or prevent ice and snow accretion.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:class nltl:iceSnowRemovalOrPreventionMeans ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasIceSnowRemovalOrPreventionMeans ], [ sh:hasValue nltl:escapeRouteProtectedItem ; sh:path nltl:protectedItemCategory ] ] ], [ sh:message Literal(\"At least one launching appliance must have associated means to remove or prevent ice and snow accretion.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:class nltl:iceSnowRemovalOrPreventionMeans ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasIceSnowRemovalOrPreventionMeans ], [ sh:hasValue nltl:launchingApplianceProtectedItem ; sh:path nltl:protectedItemCategory ] ] ], [ sh:message Literal(\"At least one muster station must have associated means to remove or prevent ice and snow accretion.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:class nltl:iceSnowRemovalOrPreventionMeans ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasIceSnowRemovalOrPreventionMeans ], [ sh:hasValue nltl:musterStationProtectedItem ; sh:path nltl:protectedItemCategory ] ] ], [ sh:message Literal(\"At least one survival craft must have associated means to remove or prevent ice and snow accretion.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:class nltl:iceSnowRemovalOrPreventionMeans ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasIceSnowRemovalOrPreventionMeans ], [ sh:hasValue nltl:survivalCraftProtectedItem ; sh:path nltl:protectedItemCategory ] ] ], [ sh:message Literal(\"At least one survival-craft access must have associated means to remove or prevent ice and snow accretion.\") ; sh:path nltl:hasProtectedItem ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:class nltl:iceSnowRemovalOrPreventionMeans ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasIceSnowRemovalOrPreventionMeans ], [ sh:hasValue nltl:survivalCraftAccessProtectedItem ; sh:path nltl:protectedItemCategory ] ] ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ rdf:type sh:NodeShape ; sh:property [ sh:class nltl:iceSnowRemovalOrPreventionMeans ; sh:message Literal(\"Each protected item must have associated means to remove or prevent ice and snow accretion.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasIceSnowRemovalOrPreventionMeans ], [ sh:in ( nltl:escapeRouteProtectedItem nltl:musterStationProtectedItem nltl:embarkationAreaProtectedItem nltl:survivalCraftProtectedItem nltl:launchingApplianceProtectedItem nltl:survivalCraftAccessProtectedItem ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each protected item must identify one permitted escape, muster, embarkation, survival-craft, launching-appliance, or survival-craft-access category.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:protectedItemCategory ] ] ; sh:path nltl:hasProtectedItem ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-066-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F01/ship> ] .

