@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:extendedDarknessOperation ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:extendedDarknessOperation ], [ sh:node [ sh:property [ sh:path nltl:hasAssignedSearchlight ; sh:qualifiedMinCount Literal("1", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Each assigned searchlight shall be suitable for continuous use.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:searchlightContinuousUseSuitabilityStatus ] ] ] ] ; sh:path nltl:hasLifeboat ] ; sh:sparql [ sh:message Literal("Each lifeboat shall have an assigned searchlight when extended darkness operation applies.") ; sh:select Literal("PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:extendedDarknessOperation true .
    $this nltl:hasLifeboat ?lifeboat .
    FILTER NOT EXISTS {
        ?lifeboat nltl:hasAssignedSearchlight ?searchlight .
    }
}") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO_072_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F04/ship> ] .

