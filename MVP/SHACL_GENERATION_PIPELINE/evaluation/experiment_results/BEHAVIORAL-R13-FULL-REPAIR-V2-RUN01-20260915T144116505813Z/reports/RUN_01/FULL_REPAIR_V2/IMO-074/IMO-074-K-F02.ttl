@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-074-K-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"The abandonment potential must be recorded as false when neither conditional alternative is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:abandonmentOntoIceOrLandPotential ] ] , [ sh:and ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The abandonment onto ice or land potential must be recorded as true for this applicable case.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:abandonmentOntoIceOrLandPotential ] ] [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Group survival equipment must be carried when abandonment onto ice or land is possible.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:groupSurvivalEquipmentCarried ] ] [ sh:property [ sh:class nltl:evidenceState ; sh:hasValue nltl:evidenceStateApproved ; sh:message Literal(\"Approved equivalence for the normal life-saving appliances is required when group survival equipment is not carried.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:normalLifeSavingEquivalentFunctionalityApprovalStatus ] ] ) ] ) ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO074Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-074-K-F02/ship> ] .

