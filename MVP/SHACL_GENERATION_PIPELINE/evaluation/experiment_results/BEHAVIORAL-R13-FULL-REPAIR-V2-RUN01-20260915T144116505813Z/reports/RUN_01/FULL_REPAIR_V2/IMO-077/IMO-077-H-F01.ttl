@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Applicability must indicate that additional equipment is carried in the survival craft.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:additionalEquipmentCarriedInSurvivalCraft ], [ sh:datatype xsd:integer ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The additional equipment capacity requirement is required when additional equipment is carried.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:additionalEquipmentCapacityRequirement ], [ sh:datatype xsd:integer ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The available survival-craft capacity is required when additional equipment is carried.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:survivalCraftAvailableCapacity ], [ sh:datatype xsd:integer ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The persons capacity requirement is required when additional equipment is carried.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:personsCapacityRequirement ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The launching-appliance capacity must be a single kilogram quantity.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloGM ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:launchingApplianceCapacity ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The loaded survival-craft requirement must be a single kilogram quantity.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloGM ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:loadedSurvivalCraftRequirement ] ; sh:sparql [ sh:message Literal("Survival-craft capacity must be at least the persons capacity requirement plus the additional equipment capacity requirement, and launching-appliance capacity must be at least the loaded survival-craft requirement.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:personsCapacityRequirement ?persons ;
                              nltl:additionalEquipmentCapacityRequirement ?additional ;
                              nltl:survivalCraftAvailableCapacity ?available ;
                              nltl:loadedSurvivalCraftRequirement ?loaded ;
                              nltl:launchingApplianceCapacity ?launching .
                        ?loaded qudt:numericValue ?loadedValue .
                        ?launching qudt:numericValue ?launchingValue .
                        FILTER (
                            ?available < (?persons + ?additional) ||
                            ?launchingValue < ?loadedValue
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Applicability must indicate that additional equipment is not carried in the survival craft.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:additionalEquipmentCarriedInSurvivalCraft ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_077_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F01/ship> ] .

