@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F05/ship> ;
            sh:resultMessage "Where the bridge configuration requires an astern view, clear view astern status shall be recorded as compliant." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Where the bridge configuration requires an astern view, clear view astern status shall be recorded as compliant." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bridgeConfigurationType
                      nltl:asternViewRequiredBridgeConfiguration .
                FILTER (
                    !EXISTS {
                        $this nltl:clearViewAsternStatus
                              "true"^^xsd:boolean
                    }
                    ||
                    EXISTS {
                        $this nltl:clearViewAsternStatus ?status .
                        FILTER (?status != "true"^^xsd:boolean)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO082ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F05/ship> ] .

