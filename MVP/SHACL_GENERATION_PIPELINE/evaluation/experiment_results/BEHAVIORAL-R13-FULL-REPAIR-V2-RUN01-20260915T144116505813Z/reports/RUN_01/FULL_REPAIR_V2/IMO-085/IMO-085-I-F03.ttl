@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F03/ship> ;
            sh:resultMessage "For Category A or B ships constructed on or after 1 January 2017, bridge wings shall be enclosed or have approved protection design." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-085-BridgeWingProtection> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F03/ship> ] .

