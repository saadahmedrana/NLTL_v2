@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading2> ;
                    sh:resultMessage "Less than 1 values on ex:heading2->nltl:independentFromHeadingMeans" ;
                    sh:resultPath nltl:independentFromHeadingMeans ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:naba1728aa802445388eff1cc752a5b26b4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic means to determine and display heading." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:naba1728aa802445388eff1cc752a5b26b1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading2> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading1> ;
                    sh:resultMessage "Less than 1 values on ex:heading1->nltl:independentFromHeadingMeans" ;
                    sh:resultPath nltl:independentFromHeadingMeans ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:naba1728aa802445388eff1cc752a5b26b4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic means to determine and display heading." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:naba1728aa802445388eff1cc752a5b26b1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/heading1> ] .

_:Nedc9209ea3024e879ecce32f3dabde7c sh:message "Each non-magnetic heading means shall be independent from another distinct non-magnetic heading means of the same ship." ;
    sh:select """
                PREFIX nltl: <https://w3id.org/nltl/vocab#>
                SELECT $this
                WHERE {
                    ?ship nltl:hasNonMagneticHeadingMeans $this .
                    ?ship nltl:hasNonMagneticHeadingMeans ?other .
                    $this nltl:independentFromHeadingMeans ?other .
                    FILTER (?other != $this)
                }
            """ .

_:naba1728aa802445388eff1cc752a5b26b1 sh:class nltl:nonMagneticHeadingMeans ;
    sh:message "The ship shall have at least two non-magnetic means to determine and display heading." ;
    sh:minCount 2 ;
    sh:node gen:IMO086HeadingMeansShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasNonMagneticHeadingMeans .

_:naba1728aa802445388eff1cc752a5b26b4 sh:class nltl:nonMagneticHeadingMeans ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:independentFromHeadingMeans ;
    sh:sparql _:Nedc9209ea3024e879ecce32f3dabde7c .

