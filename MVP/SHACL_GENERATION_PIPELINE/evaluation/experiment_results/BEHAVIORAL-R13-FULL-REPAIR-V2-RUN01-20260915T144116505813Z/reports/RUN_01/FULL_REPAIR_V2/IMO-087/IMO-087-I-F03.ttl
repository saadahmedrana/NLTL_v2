@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F03/ship> ;
            sh:resultMessage "For ships proceeding over 80 degrees latitude, at least one GNSS compass or equivalent and connections to main and emergency power are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_087_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F03/ship> ] .

