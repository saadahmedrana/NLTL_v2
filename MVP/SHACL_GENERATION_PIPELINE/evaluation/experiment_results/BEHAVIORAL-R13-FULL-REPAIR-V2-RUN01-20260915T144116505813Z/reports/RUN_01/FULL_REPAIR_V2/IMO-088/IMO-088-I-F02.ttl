@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-088-I-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"No searchlight or alternate ice-detection approval is required for ships operating solely in continuous daylight.\") ; sh:path nltl:operatesOnlyInContinuousDaylight ] ] , [ sh:or ( [ sh:property [ sh:datatype xsd:integer ; sh:message Literal(\"The ship must have at least two bridge-controlled rotatable narrow-beam searchlights.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:bridgeControlledRotatableNarrowBeamSearchlightCount ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:message Literal(\"Searchlight coverage must be at least 360 degrees.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"360\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:searchlightCoverageArc ] ] [ sh:property [ sh:hasValue nltl:evidenceStateApproved ; sh:message Literal(\"Approved alternative means for visually detecting ice must be recorded.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:alternateVisualIceDetectionMeansApprovalStatus ] ] ) ; sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:operatesOnlyInContinuousDaylight ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO088Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-088-I-F02/ship> ] .

