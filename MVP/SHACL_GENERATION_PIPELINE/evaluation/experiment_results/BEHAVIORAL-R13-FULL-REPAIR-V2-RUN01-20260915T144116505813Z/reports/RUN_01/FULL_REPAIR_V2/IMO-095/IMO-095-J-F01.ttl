@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F01/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath nltl:searchAndRescueCommunicationCapability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nae52a1e0fac848ac83c7901a3509d9aeb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F01/ship> ;
            sh:resultMessage "The supported aircraft voice frequencies shall include both 121.5 MHz and 123.1 MHz." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The supported aircraft voice frequencies shall include both 121.5 MHz and 123.1 MHz." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:supportedAircraftVoiceFrequency ?q121 .
                        ?q121 qudt:numericValue ?v121 .
                        ?q121 qudt:unit <http://qudt.org/vocab/unit/MegaHZ> .
                        FILTER (?v121 >= 121.5 && ?v121 <= 121.5)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:supportedAircraftVoiceFrequency ?q123 .
                        ?q123 qudt:numericValue ?v123 .
                        ?q123 qudt:unit <http://qudt.org/vocab/unit/MegaHZ> .
                        FILTER (?v123 >= 123.1 && ?v123 <= 123.1)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape g:IMO_095_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F01/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath nltl:searchAndRescueCommunicationCapability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nae52a1e0fac848ac83c7901a3509d9aeb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F01/ship> ;
            sh:resultMessage "The ship shall support aircraft voice communications on both 121.5 MHz and 123.1 MHz." ;
            sh:resultPath nltl:supportedAircraftVoiceFrequency ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall support aircraft voice communications on both 121.5 MHz and 123.1 MHz." ;
                    sh:minCount 2 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaHZ> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:supportedAircraftVoiceFrequency ] ] .

_:nae52a1e0fac848ac83c7901a3509d9aeb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall declare search and rescue communication capability." ;
    sh:minCount 1 ;
    sh:path nltl:searchAndRescueCommunicationCapability .

