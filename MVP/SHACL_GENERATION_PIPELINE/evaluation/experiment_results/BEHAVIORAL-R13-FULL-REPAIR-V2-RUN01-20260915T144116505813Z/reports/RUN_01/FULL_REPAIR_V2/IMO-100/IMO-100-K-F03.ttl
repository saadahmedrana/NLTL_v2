@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-F03/ship> ;
            sh:resultMessage "Every identified intended voyage hazard must be addressed by the voyage plan." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Every identified intended voyage hazard must be addressed by the voyage plan." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:identifiedIntendedVoyageHazard ?hazard .
                FILTER NOT EXISTS {
                    $this nltl:voyagePlanHazardCoverage true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_100_VoyagePlanHazardCoverageShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-F03/ship> ] .

