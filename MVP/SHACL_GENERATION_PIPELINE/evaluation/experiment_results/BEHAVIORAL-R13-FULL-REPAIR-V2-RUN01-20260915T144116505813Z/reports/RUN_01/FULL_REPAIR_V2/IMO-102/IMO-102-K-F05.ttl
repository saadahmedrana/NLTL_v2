@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F05/trainingRecord> ;
                            sh:resultMessage "A polar training record must state exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n0004a1d645aa4b868eb9620def88ea55b14 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F05/crew> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-102-TrainingRecordShape>. See details for more information." ;
                    sh:resultPath nltl:hasPolarTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-102-TrainingRecordShape> ;
                            sh:path nltl:hasPolarTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F05/trainingRecord> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F05/trainingRecord> ;
                            sh:resultMessage "A polar training record must state exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n0004a1d645aa4b868eb9620def88ea55b14 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F05/crew> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-102-TrainingRecordShape>. See details for more information." ;
                    sh:resultPath nltl:hasCrewTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-102-TrainingRecordShape> ;
                            sh:path nltl:hasCrewTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F05/trainingRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-102-CrewMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-102-CrewMemberShape> ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F05/crew> ] .

_:N79fffe318cef40a383693e827274669b rdf:first nltl:advancedPolarTrainingLevel ;
    rdf:rest ( nltl:polarTrainingNotApplicable ) .

_:Nc9670b4cace2488aa73edb5cb0301df1 rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest _:N79fffe318cef40a383693e827274669b .

_:n0004a1d645aa4b868eb9620def88ea55b14 sh:in _:Nc9670b4cace2488aa73edb5cb0301df1 ;
