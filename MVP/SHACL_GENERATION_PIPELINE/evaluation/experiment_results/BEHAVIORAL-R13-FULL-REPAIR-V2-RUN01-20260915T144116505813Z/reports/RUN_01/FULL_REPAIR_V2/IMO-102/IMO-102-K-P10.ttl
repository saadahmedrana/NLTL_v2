@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/crew> ;
                    sh:resultMessage "An applicable crew member must have a training record with the matrix-required training level and a valid STCW qualification." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "An applicable crew member must have a training record with the matrix-required training level and a valid STCW qualification." ;
                            sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    ?ship nltl:hasCrewMemberInventory $this ;
          nltl:iceConditionClassification ?ice ;
          nltl:polarTrainingShipTypeClassification ?shipType .
    $this nltl:polarTrainingCrewRoleClassification ?role .

    FILTER (
        (
            ?ice = nltl:openWaterIceCondition &&
            ?shipType != nltl:otherShipPolarTrainingType &&
            (
                ?role = nltl:masterPolarTrainingRole ||
                ?role = nltl:chiefMatePolarTrainingRole ||
                ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
            )
        )
        ||
        (
            ?ice = nltl:otherWatersIceCondition &&
            (
                ?role = nltl:masterPolarTrainingRole ||
                ?role = nltl:chiefMatePolarTrainingRole ||
                ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
            )
        )
    )

    FILTER NOT EXISTS {
        {
            ?this nltl:hasCrewTrainingRecord ?record .
        }
        UNION
        {
            ?this nltl:hasPolarTrainingRecord ?record .
        }

        ?record nltl:requiredTrainingLevel ?requiredLevel ;
                nltl:trainingRecordLevel ?recordLevel ;
                nltl:stcwQualificationValid true .

        FILTER (
            (
                ?ice = nltl:openWaterIceCondition &&
                ?shipType != nltl:otherShipPolarTrainingType &&
                ?requiredLevel = nltl:basicPolarTrainingLevel
            )
            ||
            (
                ?ice = nltl:otherWatersIceCondition &&
                (
                    (
                        (
                            ?role = nltl:masterPolarTrainingRole ||
                            ?role = nltl:chiefMatePolarTrainingRole
                        ) &&
                        ?requiredLevel = nltl:advancedPolarTrainingLevel
                    )
                    ||
                    (
                        ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole &&
                        ?requiredLevel = nltl:basicPolarTrainingLevel
                    )
                )
            )
        )

        FILTER (?recordLevel = ?requiredLevel)
    }
}
""" ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:IMO-102-CrewMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/crew> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/trainingRecord> ;
                            sh:resultMessage "A polar training record must state exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n0004a1d645aa4b868eb9620def88ea55b14 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/crew> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-102-TrainingRecordShape>. See details for more information." ;
                    sh:resultPath nltl:hasPolarTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-102-TrainingRecordShape> ;
                            sh:path nltl:hasPolarTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/trainingRecord> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/trainingRecord> ;
                            sh:resultMessage "A polar training record must state exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n0004a1d645aa4b868eb9620def88ea55b14 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/crew> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-102-TrainingRecordShape>. See details for more information." ;
                    sh:resultPath nltl:hasCrewTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-102-TrainingRecordShape> ;
                            sh:path nltl:hasCrewTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/trainingRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-102-CrewMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-102-CrewMemberShape> ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P10/crew> ] .

_:N61b6eeea1a7b4b44bc242593ee6e8130 rdf:first nltl:advancedPolarTrainingLevel ;
    rdf:rest ( nltl:polarTrainingNotApplicable ) .

_:Nb805bc48bcec466dba6d7972a636890b rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest _:N61b6eeea1a7b4b44bc242593ee6e8130 .

_:n0004a1d645aa4b868eb9620def88ea55b14 sh:in _:Nb805bc48bcec466dba6d7972a636890b ;
    sh:maxCount 1 ;
    sh:message "A polar training record must state exactly one controlled required training level." ;
    sh:minCount 1 ;
    sh:path nltl:requiredTrainingLevel .

