@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-103-K-F03/ship> ;
            sh:resultMessage "When an alternate qualified person is used, the required permission, credentials, training, watch coverage, rest compliance, and applicable basic-training safeguards must be satisfied." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-103> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-103-K-F03/ship> ] .

