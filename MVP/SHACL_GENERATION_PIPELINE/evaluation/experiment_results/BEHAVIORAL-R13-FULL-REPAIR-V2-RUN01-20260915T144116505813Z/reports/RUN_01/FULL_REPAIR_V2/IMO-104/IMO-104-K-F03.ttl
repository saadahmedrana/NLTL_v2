@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "The ship shall record completed PWOM familiarization status." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n3488b8921c9640db918459ee7c2e89e4b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "The ship shall record completed PWOM familiarization status." ;
            sh:resultPath nltl:polarWaterOperationalManualFamiliarizationStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n3488b8921c9640db918459ee7c2e89e4b1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/crew1> ;
                    sh:resultMessage "Each crew member shall have an assigned duty from which relevant PWOM items can be identified." ;
                    sh:resultPath nltl:hasAssignedDuty ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each crew member shall have an assigned duty from which relevant PWOM items can be identified." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:IMO-104-AssignedDutyShape> ;
                            sh:path nltl:hasAssignedDuty ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-104-CrewMemberShape>. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-104-CrewMemberShape> ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F03/crew1> ] .

_:n3488b8921c9640db918459ee7c2e89e4b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall record completed PWOM familiarization status." ;
    sh:minCount 1 ;
    sh:path nltl:polarWaterOperationalManualFamiliarizationStatus .

