@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-105-L-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:string ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Operating area must be recorded and must not be Arctic_waters for the non-applicable case.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:not [ sh:hasValue Literal(\"Arctic_waters\") ] ; sh:path nltl:operatingArea ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Discharge of oil or oily mixtures into the sea is prohibited in Arctic waters.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:oilOrOilyMixtureDischargeToSea ], [ sh:datatype xsd:string ; sh:hasValue Literal(\"Arctic_waters\") ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The Arctic waters applicability value must be recorded when this branch applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:operatingArea ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-105> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-105-L-F02/ship> ] .

