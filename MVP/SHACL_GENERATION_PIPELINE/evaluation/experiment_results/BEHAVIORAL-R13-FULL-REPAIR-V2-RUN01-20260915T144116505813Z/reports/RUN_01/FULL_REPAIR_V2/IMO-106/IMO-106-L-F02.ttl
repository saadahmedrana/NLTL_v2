@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F02/ship> ;
            sh:resultMessage "For clean ballast or segregated ballast discharge, paragraph 1.1.1 must be recorded as not applicable." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For clean ballast or segregated ballast discharge, paragraph 1.1.1 must be recorded as not applicable." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:dischargedMaterialClassification ?material .
                FILTER (
                    ?material = nltl:cleanBallastMaterial ||
                    ?material = nltl:segregatedBallastMaterial
                )
                FILTER NOT EXISTS {
                    $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?applicable .
                    FILTER (?applicable = false)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO_106_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F02/ship> ] .

