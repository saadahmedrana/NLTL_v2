@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-121-N-F03/ship> ;
            sh:resultMessage "If food waste is discharged to sea, it must be comminuted or ground, pass through a screen no greater than 25 mm, and not be contaminated by other garbage." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_121> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-121-N-F03/ship> ] .

