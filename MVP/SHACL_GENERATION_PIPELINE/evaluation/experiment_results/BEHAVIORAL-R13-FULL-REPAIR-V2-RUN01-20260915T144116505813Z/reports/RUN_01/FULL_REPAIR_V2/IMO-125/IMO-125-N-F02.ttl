@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F02/ship> ;
            sh:resultMessage "The ship must identify whether it operates in polar waters and, when applicable, record polar-operation coverage in the Garbage Record Book, Garbage Management Plan, and garbage placards." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO125ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F02/ship> ] .

