@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( nltl:evidenceStateApproved ) ; sh:message Literal(\"The intended-area suitability approval status for each applicable heading-reference or position-fixing system must be Approved.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:intendedAreaSuitabilityApprovalStatus ], [ sh:message Literal(\"Each applicable heading-reference or position-fixing system must have an intended area.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:intendedArea ], [ sh:message Literal(\"When a heading-reference or position-fixing system is applicable, it must be identified.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:headingOrPositionSystem ] ] , [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:message Literal(\"No heading-reference or position-fixing system is present.\") ; sh:path nltl:headingOrPositionSystem ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO26_005_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-F01/ship> ] .

