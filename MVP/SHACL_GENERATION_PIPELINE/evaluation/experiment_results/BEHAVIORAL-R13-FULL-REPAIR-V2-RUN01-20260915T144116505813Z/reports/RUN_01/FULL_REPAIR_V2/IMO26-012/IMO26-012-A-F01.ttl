@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:not [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"500\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:grossTonnage ] ] ] , [ sh:property [ sh:class nltl:nonMagneticHeadingMeans ; sh:minCount Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:hasNonMagneticHeadingMeans ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"500\", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:grossTonnage ], [ sh:node [ sh:property [ sh:class nltl:benchmarkEntity ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:connectedToEmergencyPower ], [ sh:class nltl:benchmarkEntity ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:connectedToMainPower ], [ sh:class nltl:nonMagneticHeadingMeans ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:independentFromHeadingMeans ] ] ; sh:path nltl:hasNonMagneticHeadingMeans ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-012> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F01/ship> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:grossTonnage ?gross .
                ?gross qudt:numericValue ?value .
                FILTER (xsd:decimal(?value) >= 500)
                $this nltl:hasNonMagneticHeadingMeans ?means .
                FILTER NOT EXISTS {
                    ?means a nltl:nonMagneticHeadingMeans ;
                        nltl:independentFromHeadingMeans ?peer .
                    FILTER (?peer != ?means)
                    ?peer a nltl:nonMagneticHeadingMeans .
                    $this nltl:hasNonMagneticHeadingMeans ?peer .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-012> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F01/ship> ] .

