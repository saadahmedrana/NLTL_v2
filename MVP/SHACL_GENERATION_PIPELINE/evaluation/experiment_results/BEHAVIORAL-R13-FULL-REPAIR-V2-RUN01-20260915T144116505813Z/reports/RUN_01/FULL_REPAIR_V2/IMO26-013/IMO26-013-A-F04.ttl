@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-013-A-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:LatitudeAtMost80Branch , gs:LatitudeOver80WithPowerBranch" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO26_013_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-013-A-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-013-A-F04/ship> ;
            sh:resultMessage "A ship must provide its planned or actual latitude in degrees to determine applicability." ;
            sh:resultPath nltl:plannedOrActualLatitude ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A ship must provide its planned or actual latitude in degrees to determine applicability." ;
                    sh:minCount 1 ;
                    sh:node gs:LatitudeQuantityShape ;
                    sh:path nltl:plannedOrActualLatitude ] ] .

