@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F01/ship> ;
            sh:resultMessage "A ship operating in polar waters and meeting a Chapter 11-1 applicability threshold must have polarCodeChapter11Dash1Applicable set to true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship operating in polar waters and meeting a Chapter 11-1 applicability threshold must have polarCodeChapter11Dash1Applicable set to true." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:shipOperatesInPolarWaters true ;
        nltl:shipType ?type .
  FILTER (
    (
      STR(?type) = "fishing_vessel" &&
      EXISTS {
        $this nltl:lengthOverall ?lengthValue .
        ?lengthValue qudt:numericValue ?length .
        ?lengthValue qudt:unit <http://qudt.org/vocab/unit/M> .
        FILTER (?length >= 24)
      }
    )
    ||
    (
      STR(?type) = "pleasure_yacht" &&
      EXISTS {
        $this nltl:grossTonnage ?grossValue .
        ?grossValue qudt:numericValue ?gross .
        ?grossValue qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
        FILTER (?gross >= 300)
      } &&
      EXISTS {
        $this nltl:engagedInTrade ?trade .
        FILTER (DATATYPE(?trade) = xsd:boolean && ?trade = false)
      }
    )
    ||
    (
      STR(?type) = "cargo_ship" &&
      EXISTS {
        $this nltl:grossTonnage ?grossValue .
        ?grossValue qudt:numericValue ?gross .
        ?grossValue qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
        FILTER (?gross >= 300 && ?gross < 500)
      }
    )
  )
  FILTER NOT EXISTS {
    $this nltl:polarCodeChapter11Dash1Applicable ?applicable .
    FILTER (DATATYPE(?applicable) = xsd:boolean && ?applicable = true)
  }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-016-ship> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F01/ship> ] .

