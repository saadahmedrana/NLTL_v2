@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F05/ship> ;
            sh:resultMessage "For a ship operating in polar waters, ship type and the particulars needed for its Chapter 11-1 applicability branch must be present with the required datatype and unit." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For a ship operating in polar waters, ship type and the particulars needed for its Chapter 11-1 applicability branch must be present with the required datatype and unit." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:shipOperatesInPolarWaters true .
  FILTER (
    NOT EXISTS {
      $this nltl:shipType ?type .
      FILTER (
        DATATYPE(?type) = xsd:string &&
        STR(?type) IN ("fishing_vessel", "pleasure_yacht", "cargo_ship")
      )
    }
    ||
    EXISTS {
      $this nltl:shipType "fishing_vessel"^^xsd:string .
      FILTER NOT EXISTS {
        $this nltl:lengthOverall ?lengthValue .
        ?lengthValue qudt:numericValue ?length .
        ?lengthValue qudt:unit <http://qudt.org/vocab/unit/M> .
      }
    }
    ||
    EXISTS {
      $this nltl:shipType "pleasure_yacht"^^xsd:string .
      FILTER (
        NOT EXISTS {
          $this nltl:grossTonnage ?grossValue .
          ?grossValue qudt:numericValue ?gross .
          ?grossValue qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
        }
        ||
        NOT EXISTS {
          $this nltl:engagedInTrade ?trade .
          FILTER (DATATYPE(?trade) = xsd:boolean)
        }
      )
    }
    ||
    EXISTS {
      $this nltl:shipType "cargo_ship"^^xsd:string .
      FILTER NOT EXISTS {
        $this nltl:grossTonnage ?grossValue .
        ?grossValue qudt:numericValue ?gross .
        ?grossValue qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
      }
    }
  )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-016-ship> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F05/ship> ] .

