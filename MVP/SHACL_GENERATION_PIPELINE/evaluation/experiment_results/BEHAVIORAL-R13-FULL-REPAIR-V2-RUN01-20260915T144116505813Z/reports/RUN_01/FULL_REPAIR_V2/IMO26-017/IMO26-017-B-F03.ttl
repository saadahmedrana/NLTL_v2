@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-017-B-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("When Chapter 11-1 applies, the voyage plan must be present.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:voyagePlanPresent ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("When Chapter 11-1 applies, the voyage plan must cover every intended voyage hazard.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:voyagePlanCoverage ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:polarCodeChapter11Dash1Applicable ], [ sh:datatype xsd:string ; sh:message Literal("Each intended voyage hazard must be recorded as a string.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:intendedVoyageHazard ] ; sh:sparql [ sh:message Literal("Every intended voyage hazard must have voyage-plan coverage equal to true when Chapter 11-1 applies.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this ?hazard
                    WHERE {
                        $this nltl:intendedVoyageHazard ?hazard .
                        FILTER NOT EXISTS {
                            $this nltl:voyagePlanCoverage true .
                        }
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:polarCodeChapter11Dash1Applicable ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26-017-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-017-B-F03/ship> ] .

