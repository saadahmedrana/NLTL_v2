@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-002-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2019-01-01\", datatype=xsd:date) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:constructionContractDate ] ] , [ sh:property [ sh:datatype xsd:date ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2021-07-05\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2021-07-05\", datatype=xsd:date) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2019-01-01\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ], [ sh:hasValue nltl:iceClassRegulationEdition2017 ; sh:message Literal(\"Ships contracted during the specified period must identify the 2017 Ice Class Regulations as applicable.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:applicableIceClassRegulationEdition ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-002-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-002-F01/ship> ] .

