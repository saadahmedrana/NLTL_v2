@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-003-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2019-01-01\", datatype=xsd:date) ; sh:message Literal(\"A ship contracted from 1 January 2012 through 31 December 2018 must have a valid construction contract date.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2012-01-01\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ], [ sh:in ( nltl:iceClassRegulationEdition2010 ) ; sh:message Literal(\"Ships contracted from 1 January 2012 through 31 December 2018 must identify the 2010 Ice Class Regulations as the applicable regulation edition.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:applicableIceClassRegulationEdition ] ] , [ sh:property [ sh:message Literal(\"A ship outside the 1 January 2012 to 1 January 2019 applicability interval must have a construction contract date establishing that it is outside the interval.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:or ( [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2012-01-01\", datatype=xsd:date) ] [ sh:datatype xsd:date ; sh:minInclusive Literal(\"2019-01-01\", datatype=xsd:date) ] ) ; sh:path nltl:constructionContractDate ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-003-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-003-F01/ship> ] .

