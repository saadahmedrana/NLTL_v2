@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:message Literal("A construction contract date is required to determine applicability of the 2002 Ice Class Regulations.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionContractDate ], [ sh:datatype xsd:date ; sh:message Literal("A construction stage date is required to determine applicability of the 2002 Ice Class Regulations.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:hasValue nltl:iceClassRegulationEdition2002 ; sh:message Literal("Ships meeting the stated dates shall identify the 2002 Ice Class Regulations as the applicable edition.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:applicableIceClassRegulationEdition ] ; sh:sparql [ sh:message Literal("The 2002 Ice Class Regulations applicability branch requires a construction stage on or after 1 September 2003 and a contract before 1 January 2010.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionContractDate ?contract ;
                              nltl:constructionStageDate ?stage .
                        FILTER (
                            datatype(?contract) = xsd:date &&
                            datatype(?stage) = xsd:date
                        )
                        FILTER (
                            !(
                                (
                                    YEAR(?stage) > 2003 ||
                                    (
                                        YEAR(?stage) = 2003 &&
                                        (
                                            MONTH(?stage) > 9 ||
                                            (MONTH(?stage) = 9 && DAY(?stage) >= 1)
                                        )
                                    )
                                ) &&
                                (
                                    YEAR(?contract) < 2010 ||
                                    (
                                        YEAR(?contract) = 2010 &&
                                        MONTH(?contract) = 1 &&
                                        DAY(?contract) < 1
                                    )
                                )
                            )
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:date ; sh:message Literal("A construction contract date is required to determine applicability of the 2002 Ice Class Regulations.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionContractDate ], [ sh:datatype xsd:date ; sh:message Literal("A construction stage date is required to determine applicability of the 2002 Ice Class Regulations.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ] ; sh:sparql [ sh:message Literal("The 2002 Ice Class Regulations shall not be selected when the stated construction dates do not meet their applicability condition.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionContractDate ?contract ;
                              nltl:constructionStageDate ?stage .
                        FILTER (
                            datatype(?contract) = xsd:date &&
                            datatype(?stage) = xsd:date
                        )
                        FILTER (
                            !(
                                (
                                    YEAR(?stage) > 2003 ||
                                    (
                                        YEAR(?stage) = 2003 &&
                                        (
                                            MONTH(?stage) > 9 ||
                                            (MONTH(?stage) = 9 && DAY(?stage) >= 1)
                                        )
                                    )
                                ) &&
                                (
                                    YEAR(?contract) < 2010 ||
                                    (
                                        YEAR(?contract) = 2010 &&
                                        MONTH(?contract) = 1 &&
                                        DAY(?contract) < 1
                                    )
                                )
                            )
                        )
                        FILTER EXISTS {
                            $this nltl:applicableIceClassRegulationEdition
                                  nltl:iceClassRegulationEdition2002 .
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF005Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-005-F03/ship> ;
            sh:resultMessage "An ice class is required as an input for this requirement." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "An ice class is required as an input for this requirement." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceClass ] ] .

