@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:sparql [ sh:message Literal("The conditional requirement is applicable only to IA Super or IA ships constructed before 1 September 2003.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT ?this
                    WHERE {
                        ?this nltl:iceClass ?iceClass ;
                              nltl:constructionStageDate ?constructionDate .
                        FILTER (
                            ?iceClass IN (
                                nltl:iceClassIaSuper,
                                nltl:iceClassIa
                            )
                        )
                        FILTER (
                            YEAR(?constructionDate) < 2003 ||
                            (
                                YEAR(?constructionDate) = 2003 &&
                                (
                                    MONTH(?constructionDate) < 9 ||
                                    (
                                        MONTH(?constructionDate) = 9 &&
                                        DAY(?constructionDate) < 1
                                    )
                                )
                            )
                        )
                    }
                ") ] ] , [ sh:property [ sh:class nltl:engineOutputComplianceMethodValue ; sh:in ( nltl:traficom2017Section3Point2Point2Method nltl:traficom2017Section3Point2Point4Method ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The compliance method must be section 3.2.2 or section 3.2.4 of the Ice Class Regulations of 2017.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:engineOutputComplianceMethod ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An applicable ship must provide exactly one assessment date for deadline evaluation.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:assessmentDate ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An applicable ship must provide exactly one construction stage date for applicability assessment.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An applicable ship must provide exactly one delivery date for the twenty-year deadline calculation.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:deliveryDate ] ; sh:sparql [ sh:message Literal("An applicable ship must identify compliance with section 3.2.2 or 3.2.4 of the Ice Class Regulations of 2017.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT ?this
                    WHERE {
                        ?this nltl:iceClass ?iceClass ;
                              nltl:constructionStageDate ?constructionDate .
                        FILTER (
                            !(
                                ?iceClass IN (
                                    nltl:iceClassIaSuper,
                                    nltl:iceClassIa
                                )
                                &&
                                (
                                    YEAR(?constructionDate) < 2003 ||
                                    (
                                        YEAR(?constructionDate) = 2003 &&
                                        (
                                            MONTH(?constructionDate) < 9 ||
                                            (
                                                MONTH(?constructionDate) = 9 &&
                                                DAY(?constructionDate) < 1
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    }
                ") ], [ sh:message Literal("The required compliance must be achieved no later than 1 January in the year twenty years after delivery.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT ?this
                    WHERE {
                        ?this nltl:iceClass ?iceClass ;
                              nltl:constructionStageDate ?constructionDate ;
                              nltl:deliveryDate ?deliveryDate ;
                              nltl:assessmentDate ?assessmentDate .
                        FILTER (
                            ?iceClass IN (
                                nltl:iceClassIaSuper,
                                nltl:iceClassIa
                            )
                        )
                        FILTER (
                            YEAR(?constructionDate) < 2003 ||
                            (
                                YEAR(?constructionDate) = 2003 &&
                                (
                                    MONTH(?constructionDate) < 9 ||
                                    (
                                        MONTH(?constructionDate) = 9 &&
                                        DAY(?constructionDate) < 1
                                    )
                                )
                            )
                        )
                        FILTER (
                            YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20 ||
                            (
                                YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                                (
                                    MONTH(?assessmentDate) > 1 ||
                                    (
                                        MONTH(?assessmentDate) = 1 &&
                                        DAY(?assessmentDate) > 1
                                    )
                                )
                            )
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF009ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F03/ship> ] .

