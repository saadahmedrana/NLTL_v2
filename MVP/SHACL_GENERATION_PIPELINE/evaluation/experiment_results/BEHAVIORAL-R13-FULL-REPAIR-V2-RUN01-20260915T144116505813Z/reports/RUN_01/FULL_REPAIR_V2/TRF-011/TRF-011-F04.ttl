@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/upperIceWaterline> ;
                    sh:resultMessage "Each ice waterline must contain profile points." ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:waterlineProfilePoint ;
                            sh:message "Each ice waterline must contain profile points." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:TRF-011-ProfilePointShape> ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:hasWaterlineProfilePoint ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ;
            sh:resultMessage "The ship must identify an upper ice waterline and its profile points." ;
            sh:resultPath nltl:hasUpperIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:message "The ship must identify an upper ice waterline and its profile points." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-011-IceWaterlineShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasUpperIceWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/upperIceWaterline> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ;
            sh:resultMessage "The upper ice waterline must equal, pointwise, the envelope of the highest intended ice-operating waterline points at each longitudinal position." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The upper ice waterline must equal, pointwise, the envelope of the highest intended ice-operating waterline points at each longitudinal position." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX q: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                {
                    SELECT $this ?x
                           (MAX(?iy) AS ?maxY)
                           (MIN(?uy) AS ?minUpperY)
                           (MAX(?uy) AS ?maxUpperY)
                           (COUNT(?ip) AS ?intendedCount)
                           (COUNT(?up) AS ?upperCount)
                    WHERE {
                        {
                            $this nltl:hasIntendedIceOperatingWaterline ?iw .
                            ?iw nltl:hasWaterlineProfilePoint ?ip .
                            ?ip nltl:longitudinalPosition ?ixq .
                            ?ixq q:numericValue ?x .
                            ?ip nltl:verticalCoordinate ?iyq .
                            ?iyq q:numericValue ?iy .
                        }
                        UNION
                        {
                            $this nltl:hasUpperIceWaterline ?uw .
                            ?uw nltl:hasWaterlineProfilePoint ?up .
                            ?up nltl:longitudinalPosition ?uxq .
                            ?uxq q:numericValue ?x .
                            ?up nltl:verticalCoordinate ?uyq .
                            ?uyq q:numericValue ?uy .
                        }
                    }
                    GROUP BY $this ?x
                }
                FILTER (
                    ?intendedCount = 0 ||
                    ?upperCount = 0 ||
                    ?minUpperY != ?maxY ||
                    ?maxUpperY != ?maxY
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-011-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F04/ship> ] .

