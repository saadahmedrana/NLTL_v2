@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F02/ship> ;
            sh:resultMessage "maximumContinuousRatingPower must be at least the calculated required power and at least 1,000 kW for IA, IB, or IC, or 2,800 kW for IA Super." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "maximumContinuousRatingPower must be at least the calculated required power and at least 1,000 kW for IA, IB, or IC, or 2,800 kW for IA Super." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:calculatedRequiredPower ?calculatedQuantity ;
                      nltl:maximumContinuousRatingPower ?maximumQuantity .
                ?calculatedQuantity qudt:numericValue ?calculatedPower .
                ?maximumQuantity qudt:numericValue ?maximumPower .
                FILTER (
                    (
                        ?iceClass = nltl:iceClassIaSuper &&
                        (?maximumPower < ?calculatedPower || ?maximumPower < 2800)
                    )
                    ||
                    (
                        (
                            ?iceClass = nltl:iceClassIa ||
                            ?iceClass = nltl:iceClassIb ||
                            ?iceClass = nltl:iceClassIc
                        ) &&
                        (?maximumPower < ?calculatedPower || ?maximumPower < 1000)
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltlgen:TRF018ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F02/ship> ] .

