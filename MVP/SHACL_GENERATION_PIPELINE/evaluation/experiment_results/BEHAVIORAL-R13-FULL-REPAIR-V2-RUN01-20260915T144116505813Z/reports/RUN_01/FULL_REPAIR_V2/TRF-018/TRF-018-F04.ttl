@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"iceClass must be IA Super, IA, IB, or IC.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"calculatedRequiredPower must be supplied as a single kW quantity.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:PowerQuantityShape ; sh:path nltl:calculatedRequiredPower ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"maximumContinuousRatingPower must be supplied as a single kW quantity.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node nltlgen:PowerQuantityShape ; sh:path nltl:maximumContinuousRatingPower ] ] , [ sh:not [ sh:property [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc ) ; sh:path nltl:iceClass ] ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltlgen:TRF018ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F04/ship> ] .

