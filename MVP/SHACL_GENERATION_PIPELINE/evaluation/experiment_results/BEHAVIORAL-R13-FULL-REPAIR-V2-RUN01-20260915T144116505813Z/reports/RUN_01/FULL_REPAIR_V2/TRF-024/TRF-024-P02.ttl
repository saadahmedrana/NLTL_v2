@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-P02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:iceClassValue ; sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A ship retaining ice class IA Super or IA must identify exactly one applicable ice class.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The assessment date is required to verify the TRF-024 compliance deadline.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:assessmentDate ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The construction stage date is required to determine applicability of TRF-024.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The delivery date is required to determine the TRF-024 compliance deadline.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:deliveryDate ] ; sh:sparql [ sh:message Literal("For an applicable IA Super or IA ship, section 3.2.2 compliance must be established by 1 January of the year twenty years after delivery.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:deliveryDate ?delivery ;
                              nltl:assessmentDate ?assessment .
                        FILTER (
                            YEAR(?assessment) > YEAR(?delivery) + 20
                            ||
                            (
                                YEAR(?assessment) = YEAR(?delivery) + 20
                                && MONTH(?assessment) > 1
                            )
                            ||
                            (
                                YEAR(?assessment) = YEAR(?delivery) + 20
                                && MONTH(?assessment) = 1
                                && DAY(?assessment) > 1
                            )
                        )
                    }
                ") ], [ sh:message Literal("The construction stage date for an applicable IA Super or IA ship must be before 1 September 2003.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionStageDate ?constructionDate .
                        FILTER (?constructionDate >= "2003-09-01"^^xsd:date)
                    }
                ") ] ] , [ sh:property [ sh:class nltl:iceClassValue ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("An ice class is required to determine whether TRF-024 applies.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The construction stage date is required to determine applicability of TRF-024.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ] ; sh:sparql [ sh:message Literal("TRF-024 is non-applicable only when the ship is not ice class IA Super or IA, or when construction had not reached the specified stage before 1 September 2003.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass ;
                              nltl:constructionStageDate ?constructionDate .
                        FILTER (
                            ?iceClass IN (
                                nltl:iceClassIaSuper,
                                nltl:iceClassIa
                            )
                            &&
                            ?constructionDate < "2003-09-01"^^xsd:date
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-024> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-P02/ship> ] .

