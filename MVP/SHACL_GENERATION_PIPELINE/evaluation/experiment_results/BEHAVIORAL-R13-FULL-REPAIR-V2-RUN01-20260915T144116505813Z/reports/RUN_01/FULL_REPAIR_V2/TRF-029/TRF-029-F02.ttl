@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-029-F02/ship> ;
            sh:resultMessage "Direct analysis must either be unused or, when used, have approved status, no prescribed-procedure applicability, and a structural arrangement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF029Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-029-F02/ship> ] .

