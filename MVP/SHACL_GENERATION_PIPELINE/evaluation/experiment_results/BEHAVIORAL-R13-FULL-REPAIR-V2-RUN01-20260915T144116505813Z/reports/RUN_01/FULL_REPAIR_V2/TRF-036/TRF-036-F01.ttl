@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F01/ship> ;
            sh:resultMessage "The ice class and linked ice-class design parameters must match Table 4-1." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-036-ship> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F01/ship> ] .

