@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F05/plating> ;
            sh:resultMessage "The applicable transverse or longitudinal framing inputs must be present for the external thickness calculation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-041> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F05/plating> ] .

