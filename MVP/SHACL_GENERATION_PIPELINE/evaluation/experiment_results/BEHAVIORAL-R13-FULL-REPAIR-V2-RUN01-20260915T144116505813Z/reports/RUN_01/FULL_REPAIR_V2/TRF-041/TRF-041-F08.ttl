@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F08/plating> ;
            sh:resultMessage "The applicable transverse or longitudinal framing inputs must be present for the external thickness calculation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-041> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F08/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F08/plating> ;
            sh:resultMessage "A plating framing orientation is required." ;
            sh:resultPath nltl:platingFramingOrientation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:platingFramingOrientationValue ;
                    sh:maxCount 1 ;
                    sh:message "A plating framing orientation is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:platingFramingOrientation ] ] .

