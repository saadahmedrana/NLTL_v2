@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-P02/frame> ;
            sh:resultMessage "The upper end of the strengthened part shall be attached to an eligible supporting structure." ;
            sh:resultPath ( nltl:hasStrengthenedPart nltl:hasUpperEnd ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The upper end of the strengthened part shall be attached to an eligible supporting structure." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF046UpperEndShape ;
                    sh:path ( nltl:hasStrengthenedPart nltl:hasUpperEnd ) ] ] .

