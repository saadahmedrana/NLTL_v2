@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/adjacentMainFrame> ;
            sh:resultMessage "An applicable main frame or intermediate ice frame must have a strengthened part whose lower end satisfies the permitted attachment or intermediate-frame exception." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:n5119eb8c782341b9bc4c93872ffdfd8cb1 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF047FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/adjacentMainFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/frame> ;
            sh:resultMessage "An applicable main frame or intermediate ice frame must have a strengthened part whose lower end satisfies the permitted attachment or intermediate-frame exception." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:n5119eb8c782341b9bc4c93872ffdfd8cb1 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF047FrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/frame> ] .

_:n5119eb8c782341b9bc4c93872ffdfd8cb1 a sh:SPARQLConstraint ;
    sh:message "An applicable main frame or intermediate ice frame must have a strengthened part whose lower end satisfies the permitted attachment or intermediate-frame exception." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                {
                    $this a nltl:intermediateIceFrame .
                }
                UNION
                {
                    $this a nltl:mainFrame ;
                          nltl:mainFrameBelowIceBeltStrengthened true .
                }

                FILTER NOT EXISTS {
                    $this nltl:hasStrengthenedPart ?strengthenedPart .
                    ?strengthenedPart nltl:hasLowerEnd ?lowerEnd .

                    {
                        ?lowerEnd nltl:hasAttachedSupportingStructure ?attachedStructure .
                        ?attachedStructure a ?attachedStructureKind .
                        FILTER (
                            ?attachedStructureKind IN (
                                nltl:deckStructure,
                                nltl:tankBoundaryPlating,
                                nltl:tankTop,
                                nltl:iceStringer
                            )
                        )
                    }
                    UNION
                    {
                        $this a nltl:intermediateIceFrame .
                        ?lowerEnd nltl:hasTerminationBelowSupportingStructure ?supportingStructure .
                        ?supportingStructure a ?supportingStructureKind ;
                                             nltl:supportingStructureAtOrBelowIceBeltLowerLimit true .
                        FILTER (
                            ?supportingStructureKind IN (
                                nltl:deckStructure,
                                nltl:tankBoundaryPlating,
                                nltl:tankTop,
                                nltl:iceStringer
                            )
                        )
                        ?lowerEnd nltl:hasHorizontalConnectionMember ?horizontalMember .
                        ?horizontalMember a nltl:horizontalConnectionMember ;
                                          nltl:connectsToAdjacentMainFrame ?adjacentMainFrame ;
                                          nltl:sameScantlingsAsMainFrame true .
                        ?adjacentMainFrame a nltl:mainFrame .
                    }
                }
            }
        """ .

