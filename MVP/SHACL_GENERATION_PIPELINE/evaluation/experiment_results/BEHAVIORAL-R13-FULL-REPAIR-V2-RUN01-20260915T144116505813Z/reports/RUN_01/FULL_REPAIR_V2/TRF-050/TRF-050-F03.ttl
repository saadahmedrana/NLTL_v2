@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F03/attachmentRecord> ;
            sh:resultMessage "The frame attachment shall use a double continuous weld." ;
            sh:resultPath nltl:frameShellWeldType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n65c1ae107bee414c87146d3396454437b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F03/attachmentRecord> ;
            sh:resultMessage "The frame attachment shall use a double continuous weld." ;
            sh:resultPath nltl:frameShellWeldType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n65c1ae107bee414c87146d3396454437b2 ] .

_:n65c1ae107bee414c87146d3396454437b2 sh:hasValue nltl:doubleContinuousWeld ;
    sh:message "The frame attachment shall use a double continuous weld." ;
    sh:minCount 1 ;
    sh:path nltl:frameShellWeldType .

