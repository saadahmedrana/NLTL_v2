@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F04/ship> ;
            sh:resultMessage "For a hatch opening longer than half the ship breadth, ship-side deflection and both hatch-cover and hatch-fitting design evidence must be represented." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a hatch opening longer than half the ship breadth, ship-side deflection and both hatch-cover and hatch-fitting design evidence must be represented." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasWeatherdeckHatch ?hatch .
                $this nltl:shipBreadth ?breadthValue .
                ?breadthValue qudt:numericValue ?breadth .
                ?breadthValue qudt:unit unit:M .
                ?hatch nltl:hatchOpeningLength ?openingValue .
                ?openingValue qudt:numericValue ?opening .
                ?openingValue qudt:unit unit:M .
                FILTER (datatype(?breadth) = xsd:decimal)
                FILTER (datatype(?opening) = xsd:decimal)
                FILTER (?opening > (?breadth / 2))
                FILTER (
                    NOT EXISTS {
                        ?hatch nltl:shipSideDeflection ?deflection
                    }
                    ||
                    NOT EXISTS {
                        ?hatch nltl:hasHatchCoverDesignEvidence ?coverEvidence
                    }
                    ||
                    NOT EXISTS {
                        ?hatch nltl:hasHatchFittingDesignEvidence ?fittingEvidence
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF056ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F04/ship> ] .

