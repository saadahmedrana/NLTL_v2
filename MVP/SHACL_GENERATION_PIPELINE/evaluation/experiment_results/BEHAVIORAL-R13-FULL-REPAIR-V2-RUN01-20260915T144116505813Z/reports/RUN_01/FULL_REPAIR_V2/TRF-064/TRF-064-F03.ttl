@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:not [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasDetachedStrut ] ] ; sh:property [ sh:class nltl:platedBossingStructure ; sh:message Literal(\"Side propeller shafting shall be enclosed within plated bossing when detached struts are not used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path ( nltl:hasSidePropellerShafting nltl:enclosedByPlatedBossing ) ], [ sh:class nltl:platedBossingStructure ; sh:message Literal(\"The stern tube shall be enclosed within plated bossing when detached struts are not used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path ( nltl:hasSternTube nltl:enclosedByPlatedBossing ) ] ] , [ sh:property [ sh:message Literal(\"When detached struts are used, design, strength, and hull-attachment evidence shall be provided.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF064DetachedStrutShape ; sh:path nltl:hasDetachedStrut ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasDetachedStrut ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF064ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F03/ship> ] .

