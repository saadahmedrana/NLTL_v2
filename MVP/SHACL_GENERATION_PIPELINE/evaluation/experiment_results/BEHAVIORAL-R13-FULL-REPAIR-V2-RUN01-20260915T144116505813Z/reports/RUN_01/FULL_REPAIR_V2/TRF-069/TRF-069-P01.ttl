@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-P01/ship> ;
            sh:resultMessage "For an ice class IA Super, IA, IB, or IC ship with an open or ducted controllable- or fixed-pitch propeller, the required propulsion-machinery design-condition scope must be recorded." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-069> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-P01/ship> ] .

