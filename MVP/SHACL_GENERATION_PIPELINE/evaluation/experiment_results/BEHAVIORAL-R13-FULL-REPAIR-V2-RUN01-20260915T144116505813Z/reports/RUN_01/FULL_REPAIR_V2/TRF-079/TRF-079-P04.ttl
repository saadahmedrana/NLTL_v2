@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-P04/ship> ;
            sh:resultMessage "The immersion function and submersion factor k2 must satisfy clauses 6.15 and 6.16." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The immersion function and submersion factor k2 must satisfy clauses 6.15 and 6.16." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness/qudt:numericValue ?h ;
                      nltl:iceLoadCycleCoefficientK2/qudt:numericValue ?k2 ;
                      nltl:propellerDiameter/qudt:numericValue ?d ;
                      nltl:propellerImmersionFunction/qudt:numericValue ?f ;
                      nltl:propellerShaftCentrelineDepth/qudt:numericValue ?h0 .

                BIND (((?h0 - ?h) / (?d / 2)) - 1 AS ?expectedF)
                BIND (
                    IF(?expectedF < 0,
                       0.8 - ?expectedF,
                       IF(?expectedF <= 1,
                          0.8 - (0.4 * ?expectedF),
                          IF(?expectedF <= 2.5,
                             0.6 - (0.2 * ?expectedF),
                             0.1)))
                    AS ?expectedK2
                )

                FILTER (
                    ?f != ?expectedF
                    ||
                    ?k2 != ?expectedK2
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF079Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-P04/ship> ] .

