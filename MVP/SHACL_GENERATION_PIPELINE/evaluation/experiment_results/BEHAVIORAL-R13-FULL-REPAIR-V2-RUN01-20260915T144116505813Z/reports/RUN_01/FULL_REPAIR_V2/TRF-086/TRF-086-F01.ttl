@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-F01/ship> ;
            sh:resultMessage "For a CP propeller with unknown pitch, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning exactly." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a CP propeller with unknown pitch, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning exactly." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerType ?type ;
                      nltl:pitchValueKnown ?known ;
                      nltl:propellerPitchAtMcrBollard ?bollard ;
                      nltl:propellerPitchAtMcrFreeRunning ?free .
                FILTER (?type = "CP"^^xsd:string && ?known = false)
                ?bollard qudt:numericValue ?bollardValue ;
                         qudt:unit unit:M .
                ?free qudt:numericValue ?freeValue ;
                      qudt:unit unit:M .
                FILTER (
                    datatype(?bollardValue) = xsd:decimal &&
                    datatype(?freeValue) = xsd:decimal
                )
                BIND ("0.7"^^xsd:decimal * ?freeValue AS ?expected)
                FILTER (?bollardValue != ?expected)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-086> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-086-F01/ship> ] .

