@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F01/lookup> ;
                    sh:resultMessage "The table lookup case must use the coefficient row matching an open or ducted propeller." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:TRF109TableLookupCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F01/lookup> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F01/ship> ;
            sh:resultMessage "A table lookup case using TRAFICOM Table 6-14 is required." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A table lookup case using TRAFICOM Table 6-14 is required." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF109TableLookupCaseShape ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-109-F01/lookup> ] .

