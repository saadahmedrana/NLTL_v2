@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F01/loadCase> ;
                    sh:resultMessage "The load case shall identify whether it is a blade-failure, extreme-operational, or fatigue load case; blade-failure cases shall provide the declared load inputs." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:loadCase ;
                            sh:message "The load case shall identify whether it is a blade-failure, extreme-operational, or fatigue load case; blade-failure cases shall provide the declared load inputs." ;
                            sh:or ( [ sh:and ( [ sh:property [ ] ] [ sh:property [ ] ] [ sh:property [ ] ] ) ] [ sh:property [ sh:in ( nltl:extremeOperationalLoadCase nltl:fatigueLoadCase ) ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ] ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F01/loadCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class nltl:loadCase ; sh:message Literal(\"The load case shall identify whether it is a blade-failure, extreme-operational, or fatigue load case; blade-failure cases shall provide the declared load inputs.\") ; sh:or ( [ sh:and ( [ sh:property [ sh:hasValue nltl:bladeFailureLoadCase ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shaftLineLoadCaseType ] ] [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:bladeFailureUltimateLoad ] ] [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:combinedAxialBendingTorsionLoad ] ] ) ] [ sh:property [ sh:in ( nltl:extremeOperationalLoadCase nltl:fatigueLoadCase ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shaftLineLoadCaseType ] ] ) ]. See details for more information." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class nltl:loadCase ;
                            sh:message "The load case shall identify whether it is a blade-failure, extreme-operational, or fatigue load case; blade-failure cases shall provide the declared load inputs." ;
                            sh:or ( [ sh:and ( [ ] [ ] [ ] ) ] [ sh:property [ sh:in [ ] ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path nltl:shaftLineLoadCaseType ] ] ) ] ;
                    sh:path nltl:hasPropulsionLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F01/loadCase> ] .

