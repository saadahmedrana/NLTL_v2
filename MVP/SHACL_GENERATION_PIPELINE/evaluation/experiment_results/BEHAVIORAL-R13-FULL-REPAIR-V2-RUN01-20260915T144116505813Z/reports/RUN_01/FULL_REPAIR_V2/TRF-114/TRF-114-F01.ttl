@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F01/ship> ;
            sh:resultMessage "The ship must provide its ice operating speed in knots." ;
            sh:resultPath nltl:iceOperatingSpeed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide its ice operating speed in knots." ;
                    sh:minCount 1 ;
                    sh:node g:VelocityQuantityShape ;
                    sh:path nltl:iceOperatingSpeed ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F01/thrusterBody> ;
                            sh:resultMessage "The applicable thruster body must provide its externally assessed resistance capacity in kN." ;
                            sh:resultPath nltl:thrusterResistanceCapacity ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "The applicable thruster body must provide its externally assessed resistance capacity in kN." ;
                                    sh:minCount 1 ;
                                    sh:node g:ForceQuantityShape ;
                                    sh:path nltl:thrusterResistanceCapacity ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F01/impact> ;
                    sh:resultMessage "Each impact case must identify the thruster body to which it applies." ;
                    sh:resultPath nltl:thrusterImpactCaseAppliesToBody ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:thrusterBody ;
                            sh:message "Each impact case must identify the thruster body to which it applies." ;
                            sh:minCount 1 ;
                            sh:node g:TRF114ThrusterBodyShape ;
                            sh:path nltl:thrusterImpactCaseAppliesToBody ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F01/thrusterBody> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F01/impact> ;
                    sh:resultMessage "Each impact case must reference TRAFICOM Table 6-3 for the design ice block." ;
                    sh:resultPath nltl:designIceBlockTableReference ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue nltl:traficomTable6Dash3Reference ;
                            sh:message "Each impact case must reference TRAFICOM Table 6-3 for the design ice block." ;
                            sh:minCount 1 ;
                            sh:path nltl:designIceBlockTableReference ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape g:TRF114LoadCaseShape. See details for more information." ;
            sh:resultPath nltl:hasThrusterIceImpactLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node g:TRF114LoadCaseShape ;
                    sh:path nltl:hasThrusterIceImpactLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F01/impact> ] .

