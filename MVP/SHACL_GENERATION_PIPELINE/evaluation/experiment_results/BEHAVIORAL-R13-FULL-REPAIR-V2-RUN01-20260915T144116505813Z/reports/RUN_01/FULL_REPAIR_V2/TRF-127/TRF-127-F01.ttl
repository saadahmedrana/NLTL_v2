@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F01/ship> ;
            sh:resultMessage "Air receiver capacity must be at least the capacity required for additional purposes." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Air receiver capacity must be at least the capacity required for additional purposes." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:airReceiverServesAdditionalPurpose true ;
                      nltl:airReceiverCapacity ?capacity ;
                      nltl:additionalPurposeRequiredAirCapacity ?required .
                ?capacity qudt:numericValue ?capacityValue ;
                          qudt:unit unit:M3 .
                ?required qudt:numericValue ?requiredValue ;
                          qudt:unit unit:M3 .
                FILTER (
                    ?capacityValue < ?requiredValue
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-127> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F01/ship> ] .

