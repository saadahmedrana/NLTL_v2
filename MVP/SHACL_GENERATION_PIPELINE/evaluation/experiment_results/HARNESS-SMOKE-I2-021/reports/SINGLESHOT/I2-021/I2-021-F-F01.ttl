@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/plating> ;
                    sh:resultMessage "Thickness must equal the ice-load required net plate thickness plus the corrosion and abrasion allowance; values are compared after converting millimetres to metres within a relative tolerance of 1e-6 with a 1e-9 absolute fallback." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Thickness must equal the ice-load required net plate thickness plus the corrosion and abrasion allowance; values are compared after converting millimetres to metres within a relative tolerance of 1e-6 with a 1e-9 absolute fallback." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadRequiredNetPlateThickness ?netQuantity ;
                      nltl:corrosionAbrasionAllowance ?allowanceQuantity ;
                      nltl:thickness ?thicknessQuantity .
                ?netQuantity qudt:numericValue ?net ;
                             qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                ?allowanceQuantity qudt:numericValue ?allowance ;
                                   qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                ?thicknessQuantity qudt:numericValue ?thickness ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                BIND((?net + ?allowance) / 1000 AS ?expected)
                BIND(ABS(?thickness - ?expected) AS ?difference)
                FILTER(
                    ?difference > (ABS(?expected) * 0.000001) &&
                    ?difference > 0.000000001
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-021-PlatingShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-021-PlatingShape>. See details for more information." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:plating ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-021-PlatingShape> ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/plating> ] .

