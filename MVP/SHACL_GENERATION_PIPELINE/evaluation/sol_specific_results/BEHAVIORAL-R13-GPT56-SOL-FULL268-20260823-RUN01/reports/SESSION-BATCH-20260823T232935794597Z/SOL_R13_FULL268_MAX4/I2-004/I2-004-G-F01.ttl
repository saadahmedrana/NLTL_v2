@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The upper ice waterline displacement must equal the greatest displacement among the ship's upper ice waterline cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The upper ice waterline displacement must equal the greatest displacement among the ship's upper ice waterline cases." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:upperIceWaterlineDisplacement ?reportedQuantity .
    ?reportedQuantity
        qudt:numericValue ?reportedValue ;
        qudt:unit unit:KiloTON_Metric .
    $this nltl:hasUpperIceWaterlineCase ?waterlineCase .
    ?waterlineCase nltl:waterlineCaseDisplacement ?caseQuantity .
    ?caseQuantity
        qudt:numericValue ?caseValue ;
        qudt:unit unit:KiloTON_Metric .
}
GROUP BY $this ?reportedValue
HAVING (?reportedValue != MAX(?caseValue))
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:UpperIceWaterlineDisplacementShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

