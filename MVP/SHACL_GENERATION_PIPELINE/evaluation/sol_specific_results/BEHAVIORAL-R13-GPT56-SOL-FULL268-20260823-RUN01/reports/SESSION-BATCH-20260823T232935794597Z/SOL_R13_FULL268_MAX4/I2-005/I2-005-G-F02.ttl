@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/inclination> ;
                            sh:resultMessage "Value is not <= Literal(\"7\", datatype=xsd:decimal)" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MaxInclusiveConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 7.0 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 7.0 ;
                                    sh:path qudt:numericValue ] ;
                            sh:value 7.1 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/boundaryPoint> ;
                    sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"7\", datatype=xsd:decimal) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"7\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ]. See details for more information." ;
                    sh:resultPath nltl:shellInclinationAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ a sh:NodeShape ;
                                    sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue unit:DEG ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:maxInclusive 7.0 ;
                                            sh:minCount 1 ;
                                            sh:minInclusive 7.0 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:path nltl:shellInclinationAngle ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/inclination> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/ship> ;
            sh:resultMessage "Each ship must identify a bottom/lower-region boundary point where the shell inclination is exactly 7 degrees from horizontal." ;
            sh:resultPath nltl:hasBottomRegionLowerRegionBoundaryPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:hullBoundaryPoint ;
                    sh:message "Each ship must identify a bottom/lower-region boundary point where the shell inclination is exactly 7 degrees from horizontal." ;
                    sh:minCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ a sh:NodeShape ;
                                            sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:DEG ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:maxInclusive 7.0 ;
                                                    sh:minCount 1 ;
                                                    sh:minInclusive 7.0 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:shellInclinationAngle ] ] ;
                    sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/boundaryPoint> ] .

