@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F01/ship> ;
            sh:resultMessage "A ship intended to operate astern in ice must use the Bow and Bow Intermediate hull area requirements for its aft section." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship intended to operate astern in ice must use the Bow and Bow Intermediate hull area requirements for its aft section." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:asternIceOperationIntent ?intent .
    FILTER(?intent = true)
    FILTER NOT EXISTS {
        $this nltl:aftSectionDesignBasis ?basis .
        $this nltl:hullAreaRequirementSet ?bow .
        $this nltl:hullAreaRequirementSet ?bowIntermediate .
        FILTER(
            DATATYPE(?basis) = xsd:string &&
            DATATYPE(?bow) = xsd:string &&
            DATATYPE(?bowIntermediate) = xsd:string &&
            STR(?basis) = "Bow and Bow Intermediate hull area requirements" &&
            STR(?bow) = "Bow" &&
            STR(?bowIntermediate) = "Bow Intermediate"
        )
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_006_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F01/ship> ] .

