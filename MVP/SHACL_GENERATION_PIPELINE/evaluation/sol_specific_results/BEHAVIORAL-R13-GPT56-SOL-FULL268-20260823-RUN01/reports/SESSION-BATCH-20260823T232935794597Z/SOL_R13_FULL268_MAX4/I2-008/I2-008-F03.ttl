@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:polarClass ] ] , [ sh:property [ sh:class nltl:bowSubregionCalculationCase ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_008_BowSubregionCalculationCaseShape ; sh:path nltl:hasBowSubregionCalculationCase ], [ sh:class nltl:polarClassValue ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarClass ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:KiloNewtonPerMetreQuantityShape ; sh:path nltl:lineLoad ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:KiloNewtonQuantityShape ; sh:path nltl:totalGlancingImpactForce ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:MegaPascalQuantityShape ; sh:path nltl:averageIcePressure ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:MegaPascalQuantityShape ; sh:path nltl:localIcePressure ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:MetreQuantityShape ; sh:path nltl:loadPatchHeight ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:MetreQuantityShape ; sh:path nltl:loadPatchLength ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:UnitlessQuantityShape ; sh:path nltl:shapeCoefficient ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_008_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F03/ship> ] .

