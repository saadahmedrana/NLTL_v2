@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F05/ship> ;
            sh:resultMessage "A PC6 or PC7 bow explicitly identified as vertical-sided, or having every supplied normal frame angle between 0 and 10 degrees inclusive, must be recorded as vertical-sided." ;
            sh:resultPath nltl:bowVerticalSideStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "A PC6 or PC7 bow explicitly identified as vertical-sided, or having every supplied normal frame angle between 0 and 10 degrees inclusive, must be recorded as vertical-sided." ;
                    sh:minCount 1 ;
                    sh:path nltl:bowVerticalSideStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F05/ship> ;
            sh:resultMessage "The applicable bow design ice forces must be calculated according to I2.3.2.1 (iv)." ;
            sh:resultPath nltl:bowDesignForceMethod ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "I2.3.2.1 (iv)" ) ;
                    sh:message "The applicable bow design ice forces must be calculated according to I2.3.2.1 (iv)." ;
                    sh:minCount 1 ;
                    sh:path nltl:bowDesignForceMethod ] ;
            sh:value "I2.3.2.1(iv)"^^xsd:string ] .

