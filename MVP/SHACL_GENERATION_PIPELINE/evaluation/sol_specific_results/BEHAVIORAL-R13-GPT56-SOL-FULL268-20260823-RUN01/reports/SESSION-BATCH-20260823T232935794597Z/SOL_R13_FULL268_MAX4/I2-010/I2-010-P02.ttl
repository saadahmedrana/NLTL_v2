@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-P02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:bowVerticalSideStatus ] ] , [ sh:property [ sh:datatype xsd:string ; sh:in ( Literal(\"I2.3.2.1 (iv)\") ) ; sh:message Literal(\"A PC6 or PC7 ship with a vertical-sided bow must use design ice forces calculated according to I2.3.2.1 (iv).\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:bowDesignForceMethod ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:bowVerticalSideStatus ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:Pc6Pc7VerticalSideSelectionShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-P02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-P02/ship> ;
            sh:resultMessage "The applicable bow design ice forces must be calculated according to I2.3.2.1 (iv)." ;
            sh:resultPath nltl:bowDesignForceMethod ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:in ( "I2.3.2.1 (iv)" ) ;
                    sh:message "The applicable bow design ice forces must be calculated according to I2.3.2.1 (iv)." ;
                    sh:minCount 1 ;
                    sh:path nltl:bowDesignForceMethod ] ;
            sh:value "I2.3.2.1(iv)"^^xsd:string ] .

