@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-P02/ship> ;
            sh:resultMessage "The applicability selectors or applicable bow design-force constraints do not conform to I2.3.1 (vii)." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:I2_011Shape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-P02/ship> ] .

