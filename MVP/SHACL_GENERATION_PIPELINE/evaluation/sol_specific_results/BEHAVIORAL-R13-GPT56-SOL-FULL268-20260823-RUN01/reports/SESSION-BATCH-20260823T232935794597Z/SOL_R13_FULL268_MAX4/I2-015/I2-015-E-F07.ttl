@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F07/bowCase> ;
                    sh:resultMessage """Node ex:bowCase must conform to one or more shapes in [ sh:property [ sh:class nltl:tableLookupCase ; sh:message Literal("A failure-class-factor lookup case is required for an applicable case.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:I2_015_FailureClassFactorLookupShape ; sh:path nltl:hasFailureClassFactorLookupCase ], [ sh:hasValue nltl:i231vBowFormApplicability ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bowFormApplicabilityClassification ], [ sh:message Literal("The externally calculated bow shape coefficient is required for an applicable case.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:UnitlessQuantityValueShape ; sh:path nltl:bowShapeCoefficient ], [ sh:message Literal("The subregion mid-length position is required for an applicable case.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:MeterQuantityValueShape ; sh:path nltl:bowSubregionMidLengthPosition ], [ sh:message Literal("The waterline angle is required for an applicable case.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:DegreeQuantityValueShape ; sh:path nltl:bowSubregionWaterlineAngle ] ] , [ sh:property [ sh:class nltl:bowFormApplicabilityValue ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:bowFormApplicabilityClassification ] ; sh:sparql [ sh:message Literal("Applicable I2.3.1(v) cases require the declared calculation inputs, lookup case, and result.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:bowFormApplicabilityClassification
                              nltl:i231vBowFormApplicability .
                    }
                ") ] ]""" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gs:I2_015_BowSubregionCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F07/bowCase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F07/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:I2_015_BowSubregionCaseShape. See details for more information." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:bowSubregionCalculationCase ;
                    sh:node gs:I2_015_BowSubregionCaseShape ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F07/bowCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F07/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:i231vBowFormApplicability ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path ( nltl:hasBowSubregionCalculationCase nltl:bowFormApplicabilityClassification ) ], [ sh:message Literal("L_UI is required for an applicable bow-subregion case.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:MeterQuantityValueShape ; sh:path nltl:upperIceWaterlineLengthLUI ], [ sh:message Literal("beta_i_prime is required for an applicable bow-subregion case.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gs:UnitlessQuantityValueShape ; sh:path nltl:betaIPrime ] ] , [ sh:sparql [ sh:message Literal("Ship-level formula inputs are required when a linked case is classified as an I2.3.1(v) bow form.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowFormApplicabilityClassification
                              nltl:i231vBowFormApplicability .
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:I2_015_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F07/ship> ] .

