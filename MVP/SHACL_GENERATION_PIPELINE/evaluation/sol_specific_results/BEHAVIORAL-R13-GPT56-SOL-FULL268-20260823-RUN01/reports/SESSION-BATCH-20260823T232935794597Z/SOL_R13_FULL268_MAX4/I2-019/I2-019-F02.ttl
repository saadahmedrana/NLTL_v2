@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/member> ;
                    sh:resultMessage "For a member spanning at least two hull areas, the selected hull area factor must equal the maximum spanned-area factor within relative tolerance 1e-6 and absolute fallback 1e-12." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "For a member spanning at least two hull areas, the selected hull area factor must equal the maximum spanned-area factor within relative tolerance 1e-6 and absolute fallback 1e-12." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasSpannedHullArea ?areaA, ?areaB, ?area ;
                      nltl:selectedHullAreaFactor ?selectedQuantity .
                FILTER (?areaA != ?areaB)

                ?area nltl:hullAreaFactor ?factorQuantity .
                ?factorQuantity qudt:numericValue ?factor ;
                                qudt:unit unit:UNITLESS .

                ?selectedQuantity qudt:numericValue ?reported ;
                                  qudt:unit unit:UNITLESS .
            }
            GROUP BY $this ?reported
            HAVING (
                ABS(?reported - MAX(?factor)) >
                IF(
                    ABS(MAX(?factor)) * "0.000001"^^xsd:decimal >
                        "0.000000000001"^^xsd:decimal,
                    ABS(MAX(?factor)) * "0.000001"^^xsd:decimal,
                    "0.000000000001"^^xsd:decimal
                )
            )
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:StructuralMemberHullAreaFactorShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:StructuralMemberHullAreaFactorShape. See details for more information." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:node gen:StructuralMemberHullAreaFactorShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-019-F02/member> ] .

