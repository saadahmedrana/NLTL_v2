@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/plating> ;
                    sh:resultMessage "Thickness must equal the ice-load net thickness plus the corrosion and abrasion allowance, converted from millimetres to metres, within relative tolerance 1e-6 or absolute tolerance 1e-9 near zero." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Thickness must equal the ice-load net thickness plus the corrosion and abrasion allowance, converted from millimetres to metres, within relative tolerance 1e-6 or absolute tolerance 1e-9 near zero." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadRequiredNetPlateThickness ?netQuantity ;
                      nltl:corrosionAbrasionAllowance ?allowanceQuantity ;
                      nltl:thickness ?thicknessQuantity .
                ?netQuantity qudt:numericValue ?netMillimetres .
                ?allowanceQuantity qudt:numericValue ?allowanceMillimetres .
                ?thicknessQuantity qudt:numericValue ?thicknessMetres .
                BIND(
                    ((?netMillimetres + ?allowanceMillimetres) / 1000.0)
                    AS ?expectedMetres
                )
                BIND(
                    IF(
                        ABS(?expectedMetres) * 0.000001 > 0.000000001,
                        ABS(?expectedMetres) * 0.000001,
                        0.000000001
                    )
                    AS ?tolerance
                )
                FILTER(ABS(?thicknessMetres - ?expectedMetres) > ?tolerance)
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:PlatingThicknessCalculationShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:PlatingThicknessCalculationShape. See details for more information." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:plating ;
                    sh:node gen:PlatingThicknessCalculationShape ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/plating> ] .

