@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in gs:I2_022_NoApplicablePlatingShape , gs:I2_022_ShipOperandReadinessShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:I2_022_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F04/plating> ;
                    sh:resultMessage "Node ex:plating must conform to one or more shapes in [ sh:property [ sh:maxExclusive Literal(\"70\", datatype=xsd:integer) ; sh:path ( nltl:framingAngleOmega qudt:numericValue ) ] ] , gs:I2_022_ApplicablePlatingReadinessShape" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gs:I2_022_PlatingShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F04/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gs:I2_022_PlatingShape. See details for more information." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gs:I2_022_PlatingShape ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F04/plating> ] .

