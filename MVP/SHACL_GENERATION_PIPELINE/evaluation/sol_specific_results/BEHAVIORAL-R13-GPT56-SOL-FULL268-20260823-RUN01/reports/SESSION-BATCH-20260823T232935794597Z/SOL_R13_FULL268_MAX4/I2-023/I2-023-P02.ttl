@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-P02/plating> ;
                    sh:resultMessage "Node ex:plating must conform to one or more shapes in gen:I2_023_NonApplicablePlatingShape , gen:I2_023_ApplicablePlatingShape" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:I2_023_PlatingApplicabilityShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-P02/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-P02/ship> ;
            sh:resultMessage "Each linked plating must provide its framing angle and satisfy the applicable readiness branch." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:plating ;
                    sh:message "Each linked plating must provide its framing angle and satisfy the applicable readiness branch." ;
                    sh:node gen:I2_023_PlatingApplicabilityShape ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-P02/plating> ] .

