@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F01/ship> ;
            sh:resultMessage "The ship must provide a conforming local-frame section calculation case." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a conforming local-frame section calculation case." ;
                    sh:path nltl:hasCalculationCase ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:class nltl:localFrameSectionCalculationCase ;
                            sh:node gen:I2_030_LocalFrameCaseShape ] ] ] .

