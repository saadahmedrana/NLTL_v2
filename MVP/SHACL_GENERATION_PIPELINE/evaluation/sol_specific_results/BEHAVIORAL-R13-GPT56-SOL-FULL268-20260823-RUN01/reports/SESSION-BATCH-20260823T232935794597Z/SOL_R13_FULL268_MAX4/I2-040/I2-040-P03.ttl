@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-P03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:hasStructuralMember ] ] , [ sh:property [ sh:message Literal(\"Yield strength in MPa is required for structural-member buckling assessment.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:I2_040_YieldStrengthValueShape ; sh:path nltl:yieldStrength ], [ sh:node gen:I2_040_StructuralMemberShape ; sh:path nltl:hasStructuralMember ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_040_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-P03/ship> ] .

