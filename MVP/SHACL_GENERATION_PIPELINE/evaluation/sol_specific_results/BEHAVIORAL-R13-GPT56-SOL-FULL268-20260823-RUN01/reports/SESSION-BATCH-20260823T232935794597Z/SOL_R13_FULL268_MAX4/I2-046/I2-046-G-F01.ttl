@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:polarClassRequirementsApplicable ] ] , [ sh:property [ sh:class nltl:polarClassValue ; sh:message Literal(\"An applicable ship must provide valid Polar Class evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:polarClass ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:polarClassRequirementsApplicable ], [ sh:node gen:I2_046_InternalStructureShape ; sh:path nltl:hasInternalIceStrengthenedStructure ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:I2_046_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F01/ship> ] .

