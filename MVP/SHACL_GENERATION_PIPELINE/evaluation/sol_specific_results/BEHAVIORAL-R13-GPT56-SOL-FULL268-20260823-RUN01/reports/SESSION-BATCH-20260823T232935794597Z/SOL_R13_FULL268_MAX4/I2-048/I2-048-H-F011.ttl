@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F011/case> ;
                    sh:resultMessage "Each represented case must provide exactly one as-built plate thickness in millimetres." ;
                    sh:resultPath nltl:asBuiltPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class qudt:QuantityValue ;
                            sh:maxCount 1 ;
                            sh:message "Each represented case must provide exactly one as-built plate thickness in millimetres." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_048_ThicknessShape ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:asBuiltPlateThickness ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F011/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:I2_048_SteelGradeRequirementCaseShape. See details for more information." ;
            sh:resultPath nltl:hasSteelGradeRequirementCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeRequirementCase ;
                    sh:node gen:I2_048_SteelGradeRequirementCaseShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasSteelGradeRequirementCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F011/case> ] .

