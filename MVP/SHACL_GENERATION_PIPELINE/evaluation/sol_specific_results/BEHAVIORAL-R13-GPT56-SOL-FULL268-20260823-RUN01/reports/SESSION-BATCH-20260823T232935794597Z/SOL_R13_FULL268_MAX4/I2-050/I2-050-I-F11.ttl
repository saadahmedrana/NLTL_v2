            sh:resultMessage "The stem angle is required." ;
            sh:resultPath nltl:stemAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The stem angle is required." ;
