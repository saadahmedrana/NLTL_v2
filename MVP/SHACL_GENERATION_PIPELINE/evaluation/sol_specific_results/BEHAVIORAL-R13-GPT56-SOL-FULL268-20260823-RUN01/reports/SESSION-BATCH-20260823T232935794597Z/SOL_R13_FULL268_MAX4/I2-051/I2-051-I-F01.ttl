@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:designVerticalIceShearForce" ;
            sh:resultPath nltl:designVerticalIceShearForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:DecimalKiloNewtonValueShape ;
                    sh:path nltl:designVerticalIceShearForce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:longitudinalDistributionFactor" ;
            sh:resultPath nltl:longitudinalDistributionFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:DecimalUnitlessValueShape ;
                    sh:path nltl:longitudinalDistributionFactor ] ] .

