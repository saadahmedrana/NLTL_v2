@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F08/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:designVerticalIceShearForce" ;
            sh:resultPath nltl:designVerticalIceShearForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:DecimalKiloNewtonValueShape ;
                    sh:path nltl:designVerticalIceShearForce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F08/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:node gen:ZeroDistributionFactorValueShape ; sh:path nltl:longitudinalDistributionFactor ] ; sh:sparql [ sh:message Literal("For positions from the aft end through 0.6 LUI, the longitudinal distribution factor must be 0.0.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:upperIceWaterlineLengthLUI ?lengthValue ;
                              nltl:hasCalculationCase ?case .
                        ?lengthValue qudt:numericValue ?length .
                        ?case nltl:hullGirderLongitudinalPositionFromAft ?positionValue .
                        ?positionValue qudt:numericValue ?position .
                        FILTER (
                            ?position < "0.0"^^xsd:decimal ||
                            ?position > ("0.6"^^xsd:decimal * ?length)
                        )
                    }
                ") ] ] , [ sh:property [ sh:node gen:OneDistributionFactorValueShape ; sh:path nltl:longitudinalDistributionFactor ] ; sh:sparql [ sh:message Literal("For positions from 0.9 LUI through the forward end of LUI, the longitudinal distribution factor must be 1.0.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:upperIceWaterlineLengthLUI ?lengthValue ;
                              nltl:hasCalculationCase ?case .
                        ?lengthValue qudt:numericValue ?length .
                        ?case nltl:hullGirderLongitudinalPositionFromAft ?positionValue .
                        ?positionValue qudt:numericValue ?position .
                        FILTER (
                            ?position < ("0.9"^^xsd:decimal * ?length) ||
                            ?position > ?length
                        )
                    }
                ") ] ] , [ sh:sparql [ sh:message Literal("An intermediate positive-shear calculation case must lie strictly between 0.6 LUI and 0.9 LUI.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:upperIceWaterlineLengthLUI ?lengthValue ;
                              nltl:hasCalculationCase ?case .
                        ?lengthValue qudt:numericValue ?length .
                        ?case nltl:hullGirderLongitudinalPositionFromAft ?positionValue .
                        ?positionValue qudt:numericValue ?position .
                        FILTER (
                            ?position <= ("0.6"^^xsd:decimal * ?length) ||
                            ?position >= ("0.9"^^xsd:decimal * ?length)
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:DesignVerticalIceShearForceShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F08/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F08/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:longitudinalDistributionFactor" ;
            sh:resultPath nltl:longitudinalDistributionFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:DecimalUnitlessValueShape ;
                    sh:path nltl:longitudinalDistributionFactor ] ] .

