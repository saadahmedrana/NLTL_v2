@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path ( nltl:hasStructuralMember nltl:hasCutout ) ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Loads carried by members in way of cut-outs must not cause instability.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:memberInstability ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path ( nltl:hasStructuralMember nltl:hasCutout ) ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:ShipCutoutStabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F02/ship> ] .

