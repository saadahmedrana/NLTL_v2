@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F01/calculation> ;
                    sh:resultMessage "Each calculation case must identify exactly one calculation method." ;
                    sh:resultPath nltl:calculationMethod ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:calculationMethodValue ;
                            sh:maxCount 1 ;
                            sh:message "Each calculation case must identify exactly one calculation method." ;
                            sh:minCount 1 ;
                            sh:path nltl:calculationMethod ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F01/ship> ;
            sh:resultMessage "At least one calculation case with calculation-method evidence is required." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:calculationCase ;
                    sh:message "At least one calculation case with calculation-method evidence is required." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_064_CalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F01/calculation> ] .

