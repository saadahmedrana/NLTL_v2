@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F02/ship> ;
            sh:resultMessage "Each represented flange or web requires one positive buckling-criteria result for a linear calculation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each represented flange or web requires one positive buckling-criteria result for a linear calculation." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?element
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member (nltl:hasStructuralMemberFlange|nltl:hasStructuralMemberWeb) ?element .
    OPTIONAL { ?element nltl:bucklingCriteriaSatisfied ?satisfied . }
}
GROUP BY $this ?element
HAVING (COUNT(DISTINCT ?satisfied) != 1)
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_064_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F02/ship> ;
            sh:resultMessage "A linear calculation requires exactly one ship yield-strength quantity." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A linear calculation requires exactly one ship yield-strength quantity." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:hasCalculationCase ?case .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    OPTIONAL { $this nltl:yieldStrength ?quantity . }
}
GROUP BY $this
HAVING (COUNT(DISTINCT ?quantity) != 1)
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_064_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F02/ship> ] .

