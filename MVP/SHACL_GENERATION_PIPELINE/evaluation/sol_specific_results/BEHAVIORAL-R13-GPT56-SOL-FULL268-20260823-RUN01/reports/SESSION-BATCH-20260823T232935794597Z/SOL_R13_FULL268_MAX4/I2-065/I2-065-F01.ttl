@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F01/ship> ;
            sh:resultMessage "A nonlinear calculation requires a fracture margin." ;
            sh:resultPath nltl:fractureMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:message "A nonlinear calculation requires a fracture margin." ;
                    sh:minCount 1 ;
                    sh:node gen:DimensionlessRatioValueShape ;
                    sh:path nltl:fractureMargin ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F01/calculation> ;
            sh:resultMessage "A nonlinear calculation case requires acceptance evidence." ;
            sh:resultPath nltl:nonlinearAnalysisAcceptanceEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                    sh:message "A nonlinear calculation case requires acceptance evidence." ;
                    sh:minCount 1 ;
                    sh:path nltl:nonlinearAnalysisAcceptanceEvidence ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F01/ship> ;
            sh:resultMessage "A nonlinear calculation requires a yielding margin." ;
            sh:resultPath nltl:yieldingMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:message "A nonlinear calculation requires a yielding margin." ;
                    sh:minCount 1 ;
                    sh:node gen:DimensionlessRatioValueShape ;
                    sh:path nltl:yieldingMargin ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F01/ship> ;
            sh:resultMessage "A nonlinear calculation requires a major buckling margin." ;
            sh:resultPath nltl:majorBucklingMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:message "A nonlinear calculation requires a major buckling margin." ;
                    sh:minCount 1 ;
                    sh:node gen:DimensionlessRatioValueShape ;
                    sh:path nltl:majorBucklingMargin ] ] .

