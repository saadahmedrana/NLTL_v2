@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "A nonlinear calculation requires a yielding margin." ;
            sh:resultPath nltl:yieldingMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:message "A nonlinear calculation requires a yielding margin." ;
                    sh:minCount 1 ;
                    sh:node gen:DimensionlessRatioValueShape ;
                    sh:path nltl:yieldingMargin ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "A nonlinear calculation requires a fracture margin." ;
            sh:resultPath nltl:fractureMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:message "A nonlinear calculation requires a fracture margin." ;
                    sh:minCount 1 ;
                    sh:node gen:DimensionlessRatioValueShape ;
                    sh:path nltl:fractureMargin ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/calculation> ;
            sh:resultMessage "The nonlinear calculation case must confirm that the minor permanent deformation assessment is satisfied." ;
            sh:resultPath nltl:minorPermanentDeformationAssessmentSatisfied ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:in ( true ) ;
                    sh:message "The nonlinear calculation case must confirm that the minor permanent deformation assessment is satisfied." ;
                    sh:minCount 1 ;
                    sh:path nltl:minorPermanentDeformationAssessmentSatisfied ] ;
            sh:value false ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F02/ship> ;
            sh:resultMessage "A nonlinear calculation requires a major buckling margin." ;
            sh:resultPath nltl:majorBucklingMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:message "A nonlinear calculation requires a major buckling margin." ;
                    sh:minCount 1 ;
                    sh:node gen:DimensionlessRatioValueShape ;
                    sh:path nltl:majorBucklingMargin ] ] .

