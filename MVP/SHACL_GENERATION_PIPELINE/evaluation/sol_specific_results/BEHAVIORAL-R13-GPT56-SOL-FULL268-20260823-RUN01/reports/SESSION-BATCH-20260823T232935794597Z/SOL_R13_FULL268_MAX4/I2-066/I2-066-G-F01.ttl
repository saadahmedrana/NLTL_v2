@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F01/weld1> ;
                    sh:resultMessage "Node ex:weld1 must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:withinIceStrengthenedArea ], [ sh:in ( nltl:doubleContinuousWeld ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:weldType ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"false\" = False, datatype=xsd:boolean) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:withinIceStrengthenedArea ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:I2_066_WeldShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F01/weld1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F01/ship> ;
            sh:resultMessage "Each linked weld must record whether it is within an ice-strengthened area and, when it is, must be of the double continuous type." ;
            sh:resultPath nltl:hasWeld ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:weld ;
                    sh:message "Each linked weld must record whether it is within an ice-strengthened area and, when it is, must be of the double continuous type." ;
                    sh:node gen:I2_066_WeldShape ;
                    sh:path nltl:hasWeld ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F01/weld1> ] .

