@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-005-F02/ship> ;
            sh:resultMessage "When the ice condition is 'ice free waters', total ice present must be false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the ice condition is 'ice free waters', total ice present must be false." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceCondition ?condition .
                FILTER (?condition = "ice free waters"^^xsd:string)
                FILTER (
                    NOT EXISTS {
                        $this nltl:totalIcePresent ?present .
                        FILTER (?present = "false"^^xsd:boolean)
                    }
                    ||
                    EXISTS {
                        $this nltl:totalIcePresent ?otherPresent .
                        FILTER (?otherPresent != "false"^^xsd:boolean)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IceFreeWatersShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-005-F02/ship> ] .

