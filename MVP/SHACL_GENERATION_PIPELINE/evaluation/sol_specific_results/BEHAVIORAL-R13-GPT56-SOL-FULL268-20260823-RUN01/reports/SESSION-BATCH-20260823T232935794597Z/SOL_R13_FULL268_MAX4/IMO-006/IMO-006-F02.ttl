@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-006-F02/ship> ;
            sh:resultMessage "A ship classified as medium first-year ice must have ice thickness from 0.7 m through 1.2 m inclusive." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship classified as medium first-year ice must have ice thickness from 0.7 m through 1.2 m inclusive." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
    $this nltl:iceTypeClassification nltl:mediumFirstYearIce .
    {
        FILTER NOT EXISTS {
            $this nltl:iceThickness ?anyThickness .
        }
    }
    UNION
    {
        $this nltl:iceThickness ?thickness .
        FILTER NOT EXISTS {
            ?thickness a qudt:QuantityValue ;
                qudt:numericValue ?value ;
                qudt:unit unit:M .
            FILTER(
                datatype(?value) = xsd:decimal &&
                ?value >= "0.7"^^xsd:decimal &&
                ?value <= "1.2"^^xsd:decimal
            )
            FILTER NOT EXISTS {
                ?thickness qudt:numericValue ?otherValue .
                FILTER(
                    datatype(?otherValue) != xsd:decimal ||
                    ?otherValue < "0.7"^^xsd:decimal ||
                    ?otherValue > "1.2"^^xsd:decimal
                )
            }
            FILTER NOT EXISTS {
                ?thickness qudt:unit ?otherUnit .
                FILTER(?otherUnit != unit:M)
            }
        }
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:MediumFirstYearIceThicknessShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-006-F02/ship> ] .

