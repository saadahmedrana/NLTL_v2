@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F03/ship> ;
            sh:resultMessage "A ship classified for open-water ice conditions must have sea-ice concentration below 1/10 and no ice of land origin." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship classified for open-water ice conditions must have sea-ice concentration below 1/10 and no ice of land origin." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:iceConditionClassification nltl:openWaterIceCondition .

    FILTER (
        NOT EXISTS {
            $this nltl:seaIceConcentration ?concentration
        }
        ||
        EXISTS {
            $this nltl:seaIceConcentration ?concentration .
            FILTER NOT EXISTS {
                ?concentration qudt:numericValue ?value
            }
        }
        ||
        EXISTS {
            $this nltl:seaIceConcentration ?concentration .
            ?concentration qudt:numericValue ?value .
            FILTER (!isLiteral(?value) || datatype(?value) != xsd:decimal)
        }
        ||
        EXISTS {
            $this nltl:seaIceConcentration ?concentration .
            ?concentration qudt:numericValue ?value .
            FILTER (
                isLiteral(?value) &&
                datatype(?value) = xsd:decimal &&
                ?value >= 1
            )
        }
        ||
        EXISTS {
            $this nltl:seaIceConcentration ?concentration .
            FILTER NOT EXISTS {
                ?concentration qudt:unit unit:UNITLESS
            }
        }
        ||
        EXISTS {
            $this nltl:seaIceConcentration ?concentration .
            ?concentration qudt:unit ?unit .
            FILTER (?unit != unit:UNITLESS)
        }
        ||
        NOT EXISTS {
            $this nltl:iceOfLandOriginPresent ?landIce
        }
        ||
        EXISTS {
            $this nltl:iceOfLandOriginPresent ?landIce .
            FILTER (!isLiteral(?landIce) || datatype(?landIce) != xsd:boolean)
        }
        ||
        EXISTS {
            $this nltl:iceOfLandOriginPresent ?landIce .
            FILTER (
                isLiteral(?landIce) &&
                datatype(?landIce) = xsd:boolean &&
                ?landIce != false
            )
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:OpenWaterIceConditionShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F03/ship> ] .

