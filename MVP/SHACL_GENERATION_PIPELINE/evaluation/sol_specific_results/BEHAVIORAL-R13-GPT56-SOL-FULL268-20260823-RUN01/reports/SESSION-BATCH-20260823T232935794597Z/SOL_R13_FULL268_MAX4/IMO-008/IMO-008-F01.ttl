@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-F01/ship> ;
            sh:resultMessage "A ship classified as thin first-year ice must have ice thickness from 0.3 m through 0.7 m inclusive." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship classified as thin first-year ice must have ice thickness from 0.3 m through 0.7 m inclusive." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceTypeClassification nltl:thinFirstYearIce .
                {
                    FILTER NOT EXISTS {
                        $this nltl:iceThickness ?anyThickness .
                    }
                }
                UNION
                {
                    $this nltl:iceThickness ?thickness .
                    FILTER (
                        NOT EXISTS {
                            ?thickness a qudt:QuantityValue .
                        }
                        ||
                        NOT EXISTS {
                            ?thickness qudt:unit unit:M .
                        }
                        ||
                        EXISTS {
                            ?thickness qudt:unit ?otherUnit .
                            FILTER (?otherUnit != unit:M)
                        }
                        ||
                        NOT EXISTS {
                            ?thickness qudt:numericValue ?value .
                        }
                        ||
                        EXISTS {
                            ?thickness qudt:numericValue ?value .
                            FILTER (
                                DATATYPE(?value) != xsd:decimal
                                ||
                                ?value < "0.3"^^xsd:decimal
                                ||
                                ?value > "0.7"^^xsd:decimal
                            )
                        }
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:ThinFirstYearIceThicknessShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-008-F01/ship> ] .

