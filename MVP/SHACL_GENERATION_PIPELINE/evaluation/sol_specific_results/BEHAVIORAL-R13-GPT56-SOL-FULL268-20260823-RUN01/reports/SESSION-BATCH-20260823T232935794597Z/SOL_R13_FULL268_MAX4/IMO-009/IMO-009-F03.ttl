@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F03/ship> ;
            sh:resultMessage "For bergy waters, land-origin ice concentration must be less than 1 and total ice concentration must not exceed 1." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For bergy waters, land-origin ice concentration must be less than 1 and total ice concentration must not exceed 1." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceCondition ?condition .
    FILTER(?condition = "bergy waters")
    FILTER(
        NOT EXISTS {
            $this nltl:landOriginIceConcentration ?landQuantity .
        }
        ||
        NOT EXISTS {
            $this nltl:totalIceConcentration ?totalQuantity .
        }
        ||
        EXISTS {
            $this nltl:landOriginIceConcentration ?landQuantity .
            ?landQuantity qudt:numericValue ?landValue .
            FILTER(?landValue >= "1"^^xsd:decimal)
        }
        ||
        EXISTS {
            $this nltl:totalIceConcentration ?totalQuantity .
            ?totalQuantity qudt:numericValue ?totalValue .
            FILTER(?totalValue > "1"^^xsd:decimal)
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:BergyWatersShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F03/ship> ] .

