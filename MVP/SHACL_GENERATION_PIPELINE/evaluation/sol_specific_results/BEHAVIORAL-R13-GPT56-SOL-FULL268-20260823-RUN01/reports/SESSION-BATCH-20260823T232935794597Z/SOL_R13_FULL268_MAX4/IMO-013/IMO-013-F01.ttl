@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-013-F01/ship> ;
            sh:resultMessage "A ship with a lowest MDLT below -10 degrees Celsius must be classified as operating in low air temperature." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship with a lowest MDLT below -10 degrees Celsius must be classified as operating in low air temperature." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:lowestMdlt ?lowestMdlt ;
          nltl:shipOperatesInLowAirTemperature ?classification .
    ?lowestMdlt qudt:numericValue ?temperature ;
                qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
    FILTER (
        ?temperature < "-10"^^xsd:decimal &&
        ?classification != "true"^^xsd:boolean
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:LowAirTemperatureClassificationShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-013-F01/ship> ] .

