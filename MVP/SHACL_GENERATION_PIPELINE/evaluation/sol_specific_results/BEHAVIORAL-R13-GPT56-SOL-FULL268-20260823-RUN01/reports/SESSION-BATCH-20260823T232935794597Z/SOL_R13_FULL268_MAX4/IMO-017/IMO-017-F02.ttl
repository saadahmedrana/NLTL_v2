@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ;
            sh:resultMessage "An applicable SOLAS certificate schedule is required." ;
            sh:resultPath nltl:hasSolasCertificateSchedule ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:solasCertificateSchedule ;
                    sh:message "An applicable SOLAS certificate schedule is required." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO017SolasCertificateScheduleShape ;
                    sh:path nltl:hasSolasCertificateSchedule ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ;
            sh:resultMessage "Polar Certificate validity, survey, and endorsement dates must match the corresponding SOLAS schedule dates in both directions." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Polar Certificate validity, survey, and endorsement dates must match the corresponding SOLAS schedule dates in both directions." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    {
        $this ?polarProperty ?polarDate .
        FILTER (
            ?polarProperty = nltl:polarCertificateValidityDates ||
            ?polarProperty = nltl:surveyDates ||
            ?polarProperty = nltl:endorsementDates
        )
        FILTER NOT EXISTS {
            $this nltl:hasSolasCertificateSchedule ?schedule .
            ?schedule nltl:hasCertificateScheduleDateRecord ?record .
            ?record nltl:certificateScheduleDateType ?scheduleType ;
                    nltl:certificateScheduleDate ?scheduleDate .
            FILTER (
                (?polarProperty = nltl:polarCertificateValidityDates &&
                 ?scheduleType = nltl:validityDateCategory) ||
                (?polarProperty = nltl:surveyDates &&
                 ?scheduleType = nltl:surveyDateCategory) ||
                (?polarProperty = nltl:endorsementDates &&
                 ?scheduleType = nltl:endorsementDateCategory)
            )
            FILTER (
                YEAR(?polarDate) = YEAR(?scheduleDate) &&
                MONTH(?polarDate) = MONTH(?scheduleDate) &&
                DAY(?polarDate) = DAY(?scheduleDate)
            )
        }
    }
    UNION
    {
        $this nltl:hasSolasCertificateSchedule ?schedule .
        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
        ?record nltl:certificateScheduleDateType ?scheduleType ;
                nltl:certificateScheduleDate ?scheduleDate .
        FILTER (
            ?scheduleType = nltl:validityDateCategory ||
            ?scheduleType = nltl:surveyDateCategory ||
            ?scheduleType = nltl:endorsementDateCategory
        )
        FILTER NOT EXISTS {
            $this ?polarProperty ?polarDate .
            FILTER (
                (?scheduleType = nltl:validityDateCategory &&
                 ?polarProperty = nltl:polarCertificateValidityDates) ||
                (?scheduleType = nltl:surveyDateCategory &&
                 ?polarProperty = nltl:surveyDates) ||
                (?scheduleType = nltl:endorsementDateCategory &&
                 ?polarProperty = nltl:endorsementDates)
            )
            FILTER (
                YEAR(?polarDate) = YEAR(?scheduleDate) &&
                MONTH(?polarDate) = MONTH(?scheduleDate) &&
                DAY(?polarDate) = DAY(?scheduleDate)
            )
        }
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO017ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ] .

