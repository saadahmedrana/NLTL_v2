@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "Polar Certificate supplement presence must be recorded as true." ;
            sh:resultPath nltl:polarCertificateSupplementPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:in ( true ) ;
                    sh:message "Polar Certificate supplement presence must be recorded as true." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarCertificateSupplementPresent ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "A Polar Certificate supplement is required." ;
            sh:resultPath nltl:hasPolarCertificateSupplement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarCertificateSupplement ;
                    sh:message "A Polar Certificate supplement is required." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO017PolarCertificateSupplementShape ;
                    sh:path nltl:hasPolarCertificateSupplement ] ] .

