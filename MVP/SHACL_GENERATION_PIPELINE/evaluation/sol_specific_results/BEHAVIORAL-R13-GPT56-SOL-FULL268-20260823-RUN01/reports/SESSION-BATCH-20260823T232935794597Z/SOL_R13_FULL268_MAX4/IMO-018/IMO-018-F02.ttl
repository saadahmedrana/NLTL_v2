@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-018-F02/ship> ;
            sh:resultMessage "When the ice capability methodology is applicable, the certificate methodology reference and Administration acceptance status must both be true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO018Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-018-F02/ship> ] .

