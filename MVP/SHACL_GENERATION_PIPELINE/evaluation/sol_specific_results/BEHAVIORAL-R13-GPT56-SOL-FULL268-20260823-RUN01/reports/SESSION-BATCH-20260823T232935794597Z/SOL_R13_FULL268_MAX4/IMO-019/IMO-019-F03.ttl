@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F03/ship> ;
            sh:resultMessage "The low-air-temperature applicability status must be stated; applicable ships must specify a compliant PST and remain functional at that temperature." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO019Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F03/ship> ] .

