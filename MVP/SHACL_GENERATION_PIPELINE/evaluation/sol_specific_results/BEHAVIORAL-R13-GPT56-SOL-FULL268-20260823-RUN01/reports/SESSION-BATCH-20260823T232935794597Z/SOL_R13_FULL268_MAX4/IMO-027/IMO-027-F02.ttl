@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-027-F02/ship> ;
            sh:resultMessage "PWOM environmental forecast arrangements must contain non-whitespace text." ;
            sh:resultPath nltl:environmentalForecastArrangements ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinLengthConstraintComponent ;
            sh:sourceShape _:n7192d0d041c44ade9c703016a3cff8a4b3 ;
            sh:value ""^^xsd:string ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-027-F02/ship> ;
            sh:resultMessage "PWOM environmental forecast arrangements must contain non-whitespace text." ;
            sh:resultPath nltl:environmentalForecastArrangements ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:PatternConstraintComponent ;
            sh:sourceShape _:n7192d0d041c44ade9c703016a3cff8a4b3 ;
            sh:value ""^^xsd:string ] .

_:n7192d0d041c44ade9c703016a3cff8a4b3 sh:datatype xsd:string ;
    sh:message "PWOM environmental forecast arrangements must contain non-whitespace text." ;
    sh:minCount 1 ;
    sh:minLength 1 ;
    sh:path nltl:environmentalForecastArrangements ;
    sh:pattern "\\S" .

