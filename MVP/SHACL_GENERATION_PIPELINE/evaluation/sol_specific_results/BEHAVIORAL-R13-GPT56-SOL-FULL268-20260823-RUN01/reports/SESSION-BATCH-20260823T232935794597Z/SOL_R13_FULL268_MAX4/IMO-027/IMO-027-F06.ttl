@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-027-F06/ship> ;
            sh:resultMessage "PWOM risk-based procedure coverage must be recorded as true." ;
            sh:resultPath nltl:polarWaterOperationalManualRiskProcedureCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:message "PWOM risk-based procedure coverage must be recorded as true." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarWaterOperationalManualRiskProcedureCoverage ] ] .

