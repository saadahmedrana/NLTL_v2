@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:exposedStructureMaterial ] ] , [ sh:property [ sh:datatype xsd:string ; sh:in ( Literal(\"Administration\", datatype=xsd:string) Literal(\"recognized organization accepted by the Administration\", datatype=xsd:string) ) ; sh:message Literal(\"The approving authority must be the Administration or a recognized organization accepted by it.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:approvingAuthority ], [ sh:datatype xsd:string ; sh:in ( Literal(\"standard acceptable to the Organization\", datatype=xsd:string) Literal(\"another standard offering an equivalent level of safety\", datatype=xsd:string) ) ; sh:message Literal(\"The approval standard must be Organization-acceptable or offer an equivalent level of safety.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:approvalStandard ], [ sh:datatype xsd:string ; sh:message Literal(\"Each exposed-structure material must be identified.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:exposedStructureMaterial ], [ sh:in ( nltl:evidenceStateApproved ) ; sh:message Literal(\"Exposed-structure material approval status must be Approved.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:materialApprovalStatus ], [ sh:message Literal(\"The material approval basis must record the polar service temperature in degrees Celsius.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG_C ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:polarServiceTemperature ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO031Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F03/ship> ] .

