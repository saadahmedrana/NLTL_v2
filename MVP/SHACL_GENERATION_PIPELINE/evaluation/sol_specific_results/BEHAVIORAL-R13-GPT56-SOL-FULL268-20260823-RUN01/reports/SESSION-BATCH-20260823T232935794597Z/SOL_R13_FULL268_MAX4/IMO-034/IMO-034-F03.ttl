@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-034-F03/ship> ;
            sh:resultMessage "Ice-accretion likelihood must be stated; when likely, ice-minimization design and required ice-removal means must both be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO034ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-034-F03/ship> ] .

