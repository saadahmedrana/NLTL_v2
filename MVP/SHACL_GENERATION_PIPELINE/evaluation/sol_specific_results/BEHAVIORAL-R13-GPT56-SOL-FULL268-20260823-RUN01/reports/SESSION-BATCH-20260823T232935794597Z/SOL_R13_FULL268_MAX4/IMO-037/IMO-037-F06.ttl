@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F06/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( nltl:polarShipCategoryC ) ; sh:path nltl:shipCategory ] ] , [ sh:property [ sh:maxExclusive Literal(\"2017-01-01\", datatype=xsd:date) ; sh:path nltl:constructionDate ] ] , [ sh:property [ sh:class nltl:loadingConditionCase ; sh:message Literal(\"Each applicable ship must provide its loading-condition cases.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:IMO037LoadingConditionCaseShape ; sh:path nltl:hasLoadingConditionCase ], [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ; sh:path nltl:shipCategory ], [ sh:minInclusive Literal(\"2017-01-01\", datatype=xsd:date) ; sh:path nltl:constructionDate ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO037ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F06/ship> ] .

