@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-P04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:hasEssentialEngine ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"Combustion air temperature control must be present for essential engines.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:combustionAirTemperatureControlPresent ], [ sh:message Literal(\"Combustion air temperature is required for essential engines.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node g:TemperatureQuantityShape ; sh:path nltl:combustionAirTemperature ], [ sh:message Literal(\"The manufacturer's maximum air temperature is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node g:TemperatureQuantityShape ; sh:path nltl:manufacturerMaxAirTemperature ], [ sh:message Literal(\"The manufacturer's minimum air temperature is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node g:TemperatureQuantityShape ; sh:path nltl:manufacturerMinAirTemperature ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasEssentialEngine ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:EssentialEngineCombustionAirShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-047-P04/ship> ] .

