@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:exposedMachineryOrFoundationMaterial ] ] , [ sh:property [ sh:datatype xsd:string ; sh:in ( Literal(\"Administration\", datatype=xsd:string) Literal(\"recognized organization accepted by the Administration\", datatype=xsd:string) ) ; sh:message Literal(\"The approving authority must be the Administration or a recognized organization accepted by it.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:approvingAuthority ], [ sh:datatype xsd:string ; sh:in ( Literal(\"standard acceptable to the Organization\", datatype=xsd:string) Literal(\"another standard offering an equivalent level of safety\", datatype=xsd:string) ) ; sh:message Literal(\"The approval standard must be acceptable to the Organization or offer an equivalent level of safety.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:approvalStandard ], [ sh:datatype xsd:string ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:exposedMachineryOrFoundationMaterial ], [ sh:in ( nltl:evidenceStateApproved ) ; sh:message Literal(\"Exposed machinery or foundation material must have approved material status.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:materialApprovalStatus ], [ sh:message Literal(\"Material approval must preserve its polar service temperature basis in degrees Celsius.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG_C ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:polarServiceTemperature ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO048ApprovalShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F03/ship> ] .

