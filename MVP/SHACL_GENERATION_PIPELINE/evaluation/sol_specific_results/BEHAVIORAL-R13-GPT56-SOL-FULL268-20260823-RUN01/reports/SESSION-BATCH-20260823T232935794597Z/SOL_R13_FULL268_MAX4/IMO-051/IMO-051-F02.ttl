@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F02/control1> ;
                    sh:resultMessage "Local control protection must be present." ;
                    sh:resultPath nltl:localControlProtectionPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "Local control protection must be present." ;
                            sh:minCount 1 ;
                            sh:path nltl:localControlProtectionPresent ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F02/control1> ;
                    sh:resultMessage "The local control must remain continuously accessible." ;
                    sh:resultPath nltl:localControlContinuouslyAccessible ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "The local control must remain continuously accessible." ;
                            sh:minCount 1 ;
                            sh:path nltl:localControlContinuouslyAccessible ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F02/ship> ;
            sh:resultMessage "Every linked local control item must be protected from freezing, snow and ice and remain continuously accessible." ;
            sh:resultPath nltl:hasLocalControlItem ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:localControlItem ;
                    sh:message "Every linked local control item must be protected from freezing, snow and ice and remain continuously accessible." ;
                    sh:node gen:IMO_051_LocalControlItemShape ;
                    sh:path nltl:hasLocalControlItem ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-F02/control1> ] .

