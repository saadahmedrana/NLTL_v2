@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-F02/access2> ;
                    sh:resultMessage "Each required access item must have an associated ice or snow removal or prevention means." ;
                    sh:resultPath nltl:hasIceOrSnowRemovalOrPreventionMeans ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:iceSnowRemovalOrPreventionMeans ;
                            sh:message "Each required access item must have an associated ice or snow removal or prevention means." ;
                            sh:minCount 1 ;
                            sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-F02/access2> ;
                    sh:resultMessage "Value does not have class nltl:equipmentItem" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:ClassConstraintComponent ;
                    sh:sourceShape gen:ProtectedRequiredAccessItemShape ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-F02/access2> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:ProtectedRequiredAccessItemShape. See details for more information." ;
            sh:resultPath nltl:hasRequiredAccessItem ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:requiredAccessItem ;
                    sh:node gen:ProtectedRequiredAccessItemShape ;
                    sh:path nltl:hasRequiredAccessItem ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-F02/access2> ] .

