@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-F03/ship> ;
            sh:resultMessage "An exposed valve requires a valve type to determine applicability." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "An exposed valve requires a valve type to determine applicability." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:valveExposed ?exposed .
                FILTER (?exposed = true)
                FILTER NOT EXISTS {
                    $this nltl:valveType ?type .
                    FILTER (datatype(?type) = xsd:string)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO055ValveProtectionAccessibilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-F03/ship> ] .

