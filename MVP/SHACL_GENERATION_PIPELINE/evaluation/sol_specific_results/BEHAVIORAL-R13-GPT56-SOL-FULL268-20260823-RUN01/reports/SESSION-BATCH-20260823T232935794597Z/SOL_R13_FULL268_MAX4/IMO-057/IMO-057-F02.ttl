@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <urn:nltl:generated-shape:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-057-F02/ship> ;
            sh:resultMessage "Each linked fire, emergency-fire, water-mist, or water-spray pump must be located in a compartment maintained above 0 degrees Celsius." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each linked fire, emergency-fire, water-mist, or water-spray pump must be located in a compartment maintained above 0 degrees Celsius." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?value
WHERE {
    $this nltl:hasComponent ?pump .
    ?pump a ?pumpType .
    FILTER (
        ?pumpType IN (
            nltl:firePump,
            nltl:emergencyFirePump,
            nltl:waterMistPump,
            nltl:waterSprayPump
        )
    )
    BIND (?pump AS ?value)
    FILTER NOT EXISTS {
        ?pump nltl:hasContainingCompartment ?compartment .
        ?compartment a nltl:compartment ;
            nltl:maintainedTemperature ?temperature .
        ?temperature a qudt:QuantityValue ;
            qudt:numericValue ?temperatureValue ;
            qudt:unit unit:DEG_C .
        FILTER (
            datatype(?temperatureValue) = xsd:decimal &&
            ?temperatureValue > "0"^^xsd:decimal
        )
        FILTER NOT EXISTS {
            ?temperature qudt:unit ?otherUnit .
            FILTER (?otherUnit != unit:DEG_C)
        }
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape shape:IMO057ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-057-F02/fire> ] .

