@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-F03/section1> ;
                    sh:resultMessage "Each exposed fire-main section shall have isolation capability." ;
                    sh:resultPath nltl:fireMainSectionIsolationCapability ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "Each exposed fire-main section shall have isolation capability." ;
                            sh:minCount 1 ;
                            sh:path nltl:fireMainSectionIsolationCapability ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-F03/section1> ;
                    sh:resultMessage "Each exposed fire-main section shall have drainage means." ;
                    sh:resultPath nltl:fireMainSectionDrainageMeansPresent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "Each exposed fire-main section shall have drainage means." ;
                            sh:minCount 1 ;
                            sh:path nltl:fireMainSectionDrainageMeansPresent ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:ExposedFireMainSectionShape. See details for more information." ;
            sh:resultPath nltl:hasExposedFireMainSection ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:ExposedFireMainSectionShape ;
                    sh:path nltl:hasExposedFireMainSection ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-F03/section1> ] .

