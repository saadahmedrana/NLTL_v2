@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F01/outfit1Store> ;
                            sh:resultMessage "The storage location temperature class must be warm." ;
                            sh:resultPath nltl:storageTemperatureClass ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:InConstraintComponent ;
                            sh:sourceShape [ sh:class nltl:storageTemperatureClassValue ;
                                    sh:in ( nltl:warmStorageLocation ) ;
                                    sh:message "The storage location temperature class must be warm." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:storageTemperatureClass ] ;
                            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F01/outfit1ColdClass> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F01/outfit1> ;
                    sh:resultMessage "A firefighter outfit must have a physical storage location classified as warm." ;
                    sh:resultPath nltl:hasStorageLocation ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:physicalStorageLocation ;
                            sh:message "A firefighter outfit must have a physical storage location classified as warm." ;
                            sh:minCount 1 ;
                            sh:node gen:WarmStorageLocationShape ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:hasStorageLocation ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F01/outfit1Store> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F01/ship> ;
            sh:resultMessage "Every linked firefighter outfit must be stored in a warm-classified location." ;
            sh:resultPath nltl:hasFirefighterOutfit ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:firefighterOutfitItem ;
                    sh:message "Every linked firefighter outfit must be stored in a warm-classified location." ;
                    sh:node gen:FirefighterOutfitItemShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasFirefighterOutfit ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F01/outfit1> ] .

