@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"false\" = False, datatype=xsd:boolean) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"false\" = False, datatype=xsd:boolean) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:independentSeaSuctionUsed ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:independentSeaSuctionUsed ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:seaSuctionIceClearingCapability ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO060ConditionalIceClearingShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F02/ship> ] .

