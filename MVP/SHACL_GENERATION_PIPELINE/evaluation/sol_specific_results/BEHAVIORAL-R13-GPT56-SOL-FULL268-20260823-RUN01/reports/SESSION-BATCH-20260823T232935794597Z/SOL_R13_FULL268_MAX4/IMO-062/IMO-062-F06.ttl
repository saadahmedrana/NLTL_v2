@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F06/ship> ;
            sh:resultMessage "Safe status must be recorded as true." ;
            sh:resultPath nltl:safeStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:in ( true ) ;
                    sh:message "Safe status must be recorded as true." ;
                    sh:minCount 1 ;
                    sh:path nltl:safeStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F06/ship> ;
            sh:resultMessage "Accessible status must be recorded as true." ;
            sh:resultPath nltl:accessibleStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:in ( true ) ;
                    sh:message "Accessible status must be recorded as true." ;
                    sh:minCount 1 ;
                    sh:path nltl:accessibleStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F06/ship> ;
            sh:resultMessage "Ice and snow mitigation coverage must be recorded as true." ;
            sh:resultPath nltl:iceSnowMitigationCoverage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:in ( true ) ;
                    sh:message "Ice and snow mitigation coverage must be recorded as true." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceSnowMitigationCoverage ] ] .

