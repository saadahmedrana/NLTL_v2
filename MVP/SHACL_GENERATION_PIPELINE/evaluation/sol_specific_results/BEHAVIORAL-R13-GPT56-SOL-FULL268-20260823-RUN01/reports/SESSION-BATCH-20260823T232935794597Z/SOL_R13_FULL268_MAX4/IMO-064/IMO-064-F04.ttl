@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F04/ship> ;
            sh:resultMessage "The anticipated cold conditions covered by the thermal-protection assessment are required." ;
            sh:resultPath nltl:anticipatedCold ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The anticipated cold conditions covered by the thermal-protection assessment are required." ;
                    sh:minCount 1 ;
                    sh:path nltl:anticipatedCold ] ] .

