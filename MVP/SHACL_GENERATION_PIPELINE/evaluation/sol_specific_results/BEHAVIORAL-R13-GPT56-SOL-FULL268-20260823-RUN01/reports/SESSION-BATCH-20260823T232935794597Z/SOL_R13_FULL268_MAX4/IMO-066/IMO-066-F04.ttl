@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:shipExposedToIceAccretion ] ] , [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:shipExposedToIceAccretion ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("Each linked protected item in a regulated category must have an associated ice or snow removal or prevention means.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this ?item
                    WHERE {
                        $this nltl:hasProtectedItem ?item .
                        ?item nltl:protectedItemCategory ?category .
                        FILTER (
                            ?category IN (
                                nltl:escapeRouteProtectedItem,
                                nltl:musterStationProtectedItem,
                                nltl:embarkationAreaProtectedItem,
                                nltl:survivalCraftProtectedItem,
                                nltl:launchingApplianceProtectedItem,
                                nltl:survivalCraftAccessProtectedItem
                            )
                        )
                        FILTER NOT EXISTS {
                            ?item nltl:hasIceSnowRemovalOrPreventionMeans ?means .
                            ?means a nltl:iceSnowRemovalOrPreventionMeans .
                        }
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO066Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F04/ship> ] .

