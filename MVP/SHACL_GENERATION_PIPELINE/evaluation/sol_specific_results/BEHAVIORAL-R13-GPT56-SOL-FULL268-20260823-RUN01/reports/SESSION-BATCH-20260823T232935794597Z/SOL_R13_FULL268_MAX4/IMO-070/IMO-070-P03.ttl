@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P03/ship> ;
            sh:resultMessage "Passenger-ship survival equipment shall be properly sized." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n3e47d60ceff740e6988b2ed66443bdaab1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P03/person1> ;
                    sh:resultMessage "Each person shall have one personal survival-equipment assignment." ;
                    sh:resultPath nltl:hasPersonalSurvivalEquipmentAssignment ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MaxCountConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:personalSurvivalEquipmentAssignment ;
                            sh:maxCount 1 ;
                            sh:message "Each person shall have one personal survival-equipment assignment." ;
                            sh:minCount 1 ;
                            sh:node gen:SurvivalEquipmentAssignmentShape ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:hasPersonalSurvivalEquipmentAssignment ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P03/ship> ;
            sh:resultMessage "Every represented person on board shall have a conforming survival-equipment assignment." ;
            sh:resultPath nltl:hasPersonOnBoardMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:personOnBoardMember ;
                    sh:message "Every represented person on board shall have a conforming survival-equipment assignment." ;
                    sh:node gen:PersonSurvivalEquipmentAssignmentShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasPersonOnBoardMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P03/person1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P03/ship> ;
            sh:resultMessage "Passenger-ship survival equipment shall be properly sized." ;
            sh:resultPath nltl:sizeCompatibilityStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n3e47d60ceff740e6988b2ed66443bdaab1 ] .

_:n3e47d60ceff740e6988b2ed66443bdaab1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "Passenger-ship survival equipment shall be properly sized." ;
    sh:minCount 1 ;
    sh:path nltl:sizeCompatibilityStatus .

