@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F01/ship> ;
            sh:resultMessage "Where immersion suits are required, the immersion-suit type classification must be insulated." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:ImmersionSuitTypeShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F01/ship> ] .

