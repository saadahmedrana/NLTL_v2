@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F03/ship> ;
            sh:resultMessage "Immersion-suit applicability must be recorded as a boolean." ;
            sh:resultPath nltl:immersionSuitRequired ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "Immersion-suit applicability must be recorded as a boolean." ;
                    sh:minCount 1 ;
                    sh:path nltl:immersionSuitRequired ] ] .

