@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:extendedDarknessOperation ] ] , [ sh:property [ sh:class nltl:lifeboat ; sh:message Literal(\"Each linked lifeboat must have a suitable assigned searchlight during extended-darkness operation.\") ; sh:node gen:LifeboatAssignedSearchlightShape ; sh:path nltl:hasLifeboat ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:extendedDarknessOperation ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:ExtendedDarknessSearchlightShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F01/ship> ] .

