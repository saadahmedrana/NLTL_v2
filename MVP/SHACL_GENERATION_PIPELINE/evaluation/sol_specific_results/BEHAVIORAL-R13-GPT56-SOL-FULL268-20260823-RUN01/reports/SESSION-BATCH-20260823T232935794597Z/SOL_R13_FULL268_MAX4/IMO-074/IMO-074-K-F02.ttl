@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-074-K-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:abandonmentOntoIceOrLandPotential ] ] , [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Group survival equipment must be recorded as carried.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:groupSurvivalEquipmentCarried ] ] [ sh:property [ sh:hasValue nltl:evidenceStateApproved ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Equivalent functionality of normal life-saving appliances must have approved status.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:normalLifeSavingEquivalentFunctionalityApprovalStatus ] ] ) ; sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:abandonmentOntoIceOrLandPotential ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:AbandonmentSurvivalEquipmentShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-074-K-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-074-K-F02/ship> ;
            sh:resultMessage "The abandonment onto ice or land potential must be recorded as one boolean value." ;
            sh:resultPath nltl:abandonmentOntoIceOrLandPotential ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The abandonment onto ice or land potential must be recorded as one boolean value." ;
                    sh:minCount 1 ;
                    sh:path nltl:abandonmentOntoIceOrLandPotential ] ] .

