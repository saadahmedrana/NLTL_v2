@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal("false" = False, datatype=xsd:boolean) ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:personalOrGroupSurvivalEquipmentRequired ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal("true" = True, datatype=xsd:boolean) ) ; sh:message Literal("Survival equipment storage must be accessible.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:storageAccessibilityStatus ], [ sh:datatype xsd:boolean ; sh:in ( Literal("true" = True, datatype=xsd:boolean) ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:personalOrGroupSurvivalEquipmentRequired ], [ sh:datatype xsd:integer ; sh:message Literal("Available survival equipment capacity must be provided when survival equipment is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:availableSurvivalEquipmentCapacity ], [ sh:datatype xsd:integer ; sh:message Literal("Persons on board must be provided when survival equipment is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:personsOnBoard ] ; sh:sparql [ sh:message Literal("Available survival equipment capacity must be at least 110 percent of persons on board, rounded up.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:personsOnBoard ?persons ;
                              nltl:availableSurvivalEquipmentCapacity ?available .
                        FILTER ((?available * 10) < (?persons * 11))
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO075SurvivalEquipmentShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F04/ship> ] .

