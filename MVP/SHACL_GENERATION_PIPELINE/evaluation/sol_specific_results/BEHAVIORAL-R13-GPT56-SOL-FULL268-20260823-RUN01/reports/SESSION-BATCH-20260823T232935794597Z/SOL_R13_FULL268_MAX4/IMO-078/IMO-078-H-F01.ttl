@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F01/passenger1> ;
                    sh:resultMessage "Personal survival equipment instruction must be recorded as completed." ;
                    sh:resultPath nltl:personalSurvivalEquipmentInstructionCompleted ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "Personal survival equipment instruction must be recorded as completed." ;
                            sh:minCount 1 ;
                            sh:path nltl:personalSurvivalEquipmentInstructionCompleted ] ;
                    sh:value false ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F01/ship> ;
            sh:resultMessage "Every linked passenger must have completed personal survival equipment instruction." ;
            sh:resultPath nltl:hasPassenger ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:passenger ;
                    sh:message "Every linked passenger must have completed personal survival equipment instruction." ;
                    sh:node gen:PassengerInstructionShape ;
                    sh:path nltl:hasPassenger ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F01/passenger1> ] .

