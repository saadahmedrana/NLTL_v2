@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F02/crew1> ;
                    sh:resultMessage "Personal and group survival equipment training must be recorded as completed." ;
                    sh:resultPath nltl:personalAndGroupSurvivalEquipmentTrainingCompleted ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "Personal and group survival equipment training must be recorded as completed." ;
                            sh:minCount 1 ;
                            sh:path nltl:personalAndGroupSurvivalEquipmentTrainingCompleted ] ;
                    sh:value false ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F02/ship> ;
            sh:resultMessage "Every linked crew member must have completed personal and group survival equipment training." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:crewMember ;
                    sh:message "Every linked crew member must have completed personal and group survival equipment training." ;
                    sh:node gen:CrewMemberTrainingShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F02/crew1> ] .

