@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F03/ship> ;
            sh:resultMessage "Applicable ships shall have either at least two independent echo-sounding devices or at least one echo-sounding device with at least two independent transducers." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO081Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F03/ship> ] .

