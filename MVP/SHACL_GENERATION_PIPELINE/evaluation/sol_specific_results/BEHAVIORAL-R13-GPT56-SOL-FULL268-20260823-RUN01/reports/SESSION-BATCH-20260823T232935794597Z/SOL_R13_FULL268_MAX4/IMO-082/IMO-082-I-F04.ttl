@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-082-I-F04/ship> ;
            sh:resultMessage "SOLAS regulation V/22.1.9.4 compliance status must be recorded as true." ;
            sh:resultPath nltl:solasRegulationV22Point1Point9Point4ComplianceStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:in ( true ) ;
                    sh:message "SOLAS regulation V/22.1.9.4 compliance status must be recorded as true." ;
                    sh:minCount 1 ;
                    sh:path nltl:solasRegulationV22Point1Point9Point4ComplianceStatus ] ] .

