@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F03/ship> ;
            sh:resultMessage "Ice-accretion applicability must be explicitly stated." ;
            sh:resultPath nltl:iceAccretionLikely ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Ice-accretion applicability must be explicitly stated." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceAccretionLikely ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:iceAccretionLikely ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:iceAccretionLikely ], [ sh:message Literal(\"When ice accretion is likely, required navigation or communication antennas must be identified and provided with ice accumulation prevention.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:AntennaIcePreventionShape ; sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:ShipAntennaIcePreventionShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F03/ship> ] .

