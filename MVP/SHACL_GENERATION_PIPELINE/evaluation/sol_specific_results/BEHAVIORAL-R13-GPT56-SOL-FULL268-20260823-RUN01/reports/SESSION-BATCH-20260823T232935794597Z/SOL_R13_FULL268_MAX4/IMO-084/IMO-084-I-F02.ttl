@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-084-I-F02/ship> ;
            sh:resultMessage "The ship must state whether required sensors project below the hull." ;
            sh:resultPath nltl:requiredSensorProjectsBelowHull ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "The ship must state whether required sensors project below the hull." ;
                    sh:minCount 1 ;
                    sh:path nltl:requiredSensorProjectsBelowHull ] ] .

