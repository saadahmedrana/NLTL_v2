@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic heading means." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:nonMagneticHeadingMeans ;
                    sh:message "The ship shall have at least two non-magnetic heading means." ;
                    sh:minCount 2 ;
                    sh:node [ sh:property [ sh:class nltl:benchmarkEntity ;
                                    sh:message "Each non-magnetic heading means shall be connected to main power." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:connectedToMainPower ],
                                [ sh:class nltl:benchmarkEntity ;
                                    sh:message "Each non-magnetic heading means shall be connected to emergency power." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:connectedToEmergencyPower ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasNonMagneticHeadingMeans ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "Each non-magnetic heading means shall identify another distinct means owned by the same ship as independent." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each non-magnetic heading means shall identify another distinct means owned by the same ship as independent." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this ?means
WHERE {
    $this nltl:hasNonMagneticHeadingMeans ?means .
    FILTER NOT EXISTS {
        $this nltl:hasNonMagneticHeadingMeans ?otherMeans .
        ?means nltl:independentFromHeadingMeans ?otherMeans .
        FILTER (?otherMeans != ?means)
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO086ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ] .

