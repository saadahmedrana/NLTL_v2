@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading2> ;
                    sh:resultMessage "Each non-magnetic heading means shall be connected to emergency power." ;
                    sh:resultPath nltl:connectedToEmergencyPower ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n58d36e623b874f40a4e5c8c82328fdcfb4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic heading means." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n58d36e623b874f40a4e5c8c82328fdcfb1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading2> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading1> ;
                    sh:resultMessage "Each non-magnetic heading means shall be connected to emergency power." ;
                    sh:resultPath nltl:connectedToEmergencyPower ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n58d36e623b874f40a4e5c8c82328fdcfb4 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic heading means." ;
            sh:resultPath nltl:hasNonMagneticHeadingMeans ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n58d36e623b874f40a4e5c8c82328fdcfb1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F03/heading1> ] .

_:N8a4ca5af58d8401fbde3d2d1a6ec0729 sh:property [ sh:class nltl:benchmarkEntity ;
            sh:message "Each non-magnetic heading means shall be connected to emergency power." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path nltl:connectedToEmergencyPower ],
        [ sh:class nltl:benchmarkEntity ;
            sh:message "Each non-magnetic heading means shall be connected to main power." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path nltl:connectedToMainPower ] .

_:n58d36e623b874f40a4e5c8c82328fdcfb1 sh:class nltl:nonMagneticHeadingMeans ;
    sh:message "The ship shall have at least two non-magnetic heading means." ;
    sh:minCount 2 ;
    sh:node _:N8a4ca5af58d8401fbde3d2d1a6ec0729 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasNonMagneticHeadingMeans .

_:n58d36e623b874f40a4e5c8c82328fdcfb4 sh:class nltl:benchmarkEntity ;
    sh:message "Each non-magnetic heading means shall be connected to emergency power." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:connectedToEmergencyPower .

