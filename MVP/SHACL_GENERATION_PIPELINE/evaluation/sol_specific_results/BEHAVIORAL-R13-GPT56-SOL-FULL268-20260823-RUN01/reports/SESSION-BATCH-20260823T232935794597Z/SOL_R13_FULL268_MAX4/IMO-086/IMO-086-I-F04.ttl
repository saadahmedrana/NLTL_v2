@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/ship> ;
            sh:resultMessage "Each non-magnetic heading means shall identify another distinct means owned by the same ship as independent." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:n58d36e623b874f40a4e5c8c82328fdcfb5 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO086ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/ship> ;
            sh:resultMessage "Each non-magnetic heading means shall identify another distinct means owned by the same ship as independent." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:n58d36e623b874f40a4e5c8c82328fdcfb5 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO086ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F04/ship> ] .

_:n58d36e623b874f40a4e5c8c82328fdcfb5 a sh:SPARQLConstraint ;
    sh:message "Each non-magnetic heading means shall identify another distinct means owned by the same ship as independent." ;
    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this ?means
WHERE {
    $this nltl:hasNonMagneticHeadingMeans ?means .
    FILTER NOT EXISTS {
        $this nltl:hasNonMagneticHeadingMeans ?otherMeans .
        ?means nltl:independentFromHeadingMeans ?otherMeans .
        FILTER (?otherMeans != ?means)
    }
}
""" .

