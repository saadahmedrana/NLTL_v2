@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"false\" = False, datatype=xsd:boolean) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:icebreakerEscortOperation ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"A manually initiated flashing red stopped light must be present during icebreaker escort operations.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:manuallyInitiatedFlashingRedStoppedLightPresent ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"The stopped light arcs of visibility must comply with COLREG stern-light specifications.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:colregSternLightArcComplianceStatus ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"The stopped light must be visible from astern.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lightVisibleFromAstern ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:icebreakerEscortOperation ], [ sh:message Literal(\"The stopped light visibility range must be at least 2 nautical miles.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MI_N ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:visibilityRange ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IcebreakerEscortStoppedLightShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-F04/ship> ] .

