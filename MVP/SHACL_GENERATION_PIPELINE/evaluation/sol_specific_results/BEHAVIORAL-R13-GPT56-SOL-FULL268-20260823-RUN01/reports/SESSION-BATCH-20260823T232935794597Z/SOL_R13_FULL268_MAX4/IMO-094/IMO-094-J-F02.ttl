@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-094-J-F02/ship> ;
            sh:resultMessage "A ship providing icebreaking escort must have an astern-facing sound signaling system and comply with the International Code of Signals." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IcebreakingEscortSoundSignalingShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-094-J-F02/ship> ] .

