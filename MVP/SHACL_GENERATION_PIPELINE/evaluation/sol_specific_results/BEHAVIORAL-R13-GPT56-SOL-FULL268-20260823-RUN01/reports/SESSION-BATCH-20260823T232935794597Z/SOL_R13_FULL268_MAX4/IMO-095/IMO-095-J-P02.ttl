@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-P02/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath nltl:searchAndRescueCommunicationCapability ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:in ( true ) ;
                    sh:message "The ship shall declare search and rescue communication capability." ;
                    sh:minCount 1 ;
                    sh:path nltl:searchAndRescueCommunicationCapability ] ] .

