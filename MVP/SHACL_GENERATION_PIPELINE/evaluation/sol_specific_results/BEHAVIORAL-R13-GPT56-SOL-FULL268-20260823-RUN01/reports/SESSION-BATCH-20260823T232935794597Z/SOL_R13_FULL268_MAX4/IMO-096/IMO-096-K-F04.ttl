            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ne5f862d801924959af3a9bc3e5caa503b2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-096-K-F04/ship> ;
            sh:resultMessage "The ship shall have two-way data communication capability with a Telemedical Assistance Service." ;
