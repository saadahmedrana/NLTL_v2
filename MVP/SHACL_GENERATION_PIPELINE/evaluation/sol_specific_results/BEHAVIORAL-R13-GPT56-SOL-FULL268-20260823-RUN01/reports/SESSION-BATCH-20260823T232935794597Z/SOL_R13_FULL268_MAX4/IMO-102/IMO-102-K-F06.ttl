@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ;
                            sh:resultMessage "The polar-training record must state exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n6d67671ef05b4801896671dfaf7a37ecb17 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:PolarTrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasPolarTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:polarTrainingRecord ;
                            sh:node gen:PolarTrainingRecordShape ;
                            sh:path nltl:hasPolarTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ;
                            sh:resultMessage "The polar-training record must state exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n6d67671ef05b4801896671dfaf7a37ecb17 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:PolarTrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasCrewTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:polarTrainingRecord ;
                            sh:node gen:PolarTrainingRecordShape ;
                            sh:path nltl:hasCrewTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/trainingRecord> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ;
                    sh:resultMessage "Each represented crew member must have exactly one controlled polar-training crew role." ;
                    sh:resultPath nltl:polarTrainingCrewRoleClassification ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:in ( nltl:masterPolarTrainingRole nltl:chiefMatePolarTrainingRole nltl:officerInChargeOfNavigationalWatchPolarTrainingRole ) ;
                            sh:maxCount 1 ;
                            sh:message "Each represented crew member must have exactly one controlled polar-training crew role." ;
                            sh:minCount 1 ;
                            sh:path nltl:polarTrainingCrewRoleClassification ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:PolarTrainingCrewMemberShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:crewMember ;
                    sh:node gen:PolarTrainingCrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-F06/crew> ] .

