@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/trainingRecord> ;
                            sh:resultMessage "The polar-training record must state exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n6d67671ef05b4801896671dfaf7a37ecb17 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:PolarTrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasPolarTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:polarTrainingRecord ;
                            sh:node gen:PolarTrainingRecordShape ;
                            sh:path nltl:hasPolarTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/trainingRecord> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/trainingRecord> ;
                            sh:resultMessage "The polar-training record must state exactly one controlled required training level." ;
                            sh:resultPath nltl:requiredTrainingLevel ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n6d67671ef05b4801896671dfaf7a37ecb17 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/crew> ;
                    sh:resultMessage "Value does not conform to Shape gen:PolarTrainingRecordShape. See details for more information." ;
                    sh:resultPath nltl:hasCrewTrainingRecord ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:polarTrainingRecord ;
                            sh:node gen:PolarTrainingRecordShape ;
                            sh:path nltl:hasCrewTrainingRecord ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/trainingRecord> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:PolarTrainingCrewMemberShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:crewMember ;
                    sh:node gen:PolarTrainingCrewMemberShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/crew> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/ship> ;
            sh:resultMessage "Each represented crew member must have the training level and, where applicable, valid matching STCW qualification required by the clause 12.3.1 matrix." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each represented crew member must have the training level and, where applicable, valid matching STCW qualification required by the clause 12.3.1 matrix." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this ?crew
WHERE {
    $this nltl:iceConditionClassification ?iceCondition ;
          nltl:polarTrainingShipTypeClassification ?shipType ;
          nltl:hasCrewMemberInventory ?crew .
    ?crew nltl:polarTrainingCrewRoleClassification ?crewRole .

    BIND(
        IF(
            ?iceCondition = nltl:iceFreeIceCondition,
            nltl:polarTrainingNotApplicable,
            IF(
                ?iceCondition = nltl:openWaterIceCondition,
                IF(
                    ?shipType = nltl:otherShipPolarTrainingType,
                    nltl:polarTrainingNotApplicable,
                    nltl:basicPolarTrainingLevel
                ),
                IF(
                    ?crewRole = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole,
                    nltl:basicPolarTrainingLevel,
                    nltl:advancedPolarTrainingLevel
                )
            )
        )
        AS ?expectedLevel
    )

    FILTER(
        NOT EXISTS {
            ?crew nltl:hasCrewTrainingRecord ?trainingRecord .
            ?trainingRecord nltl:requiredTrainingLevel ?expectedLevel .
            FILTER(
                ?expectedLevel = nltl:polarTrainingNotApplicable ||
                EXISTS {
                    ?trainingRecord
                        nltl:trainingRecordLevel ?expectedLevel ;
                        nltl:stcwQualificationValid true .
                }
            )
        }
        ||
        (
            ?expectedLevel != nltl:polarTrainingNotApplicable &&
            NOT EXISTS {
                ?crew nltl:hasPolarTrainingRecord ?polarRecord .
                ?polarRecord
                    nltl:requiredTrainingLevel ?expectedLevel ;
                    nltl:trainingRecordLevel ?expectedLevel ;
                    nltl:stcwQualificationValid true .
            }
        )
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:PolarTrainingShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P22/ship> ] .

_:N3a19bfb9ddfb466caa2dcbf8cd4903ab rdf:first nltl:polarTrainingNotApplicable ;
    rdf:rest () .

_:N87016f2411e34f1da9d6cf2a2419fc6f rdf:first nltl:basicPolarTrainingLevel ;
    rdf:rest ( nltl:advancedPolarTrainingLevel nltl:polarTrainingNotApplicable ) .

_:n6d67671ef05b4801896671dfaf7a37ecb17 sh:in _:N87016f2411e34f1da9d6cf2a2419fc6f ;
    sh:maxCount 1 ;
    sh:message "The polar-training record must state exactly one controlled required training level." ;
    sh:minCount 1 ;
    sh:path nltl:requiredTrainingLevel .

