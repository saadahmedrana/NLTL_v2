Value ], [ sh:hasValue unit:UNITLESS ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:iceConcentration ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"Administration permission must be approved when an alternate qualified person is used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:administrationPermissionStatus ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"Advanced polar training compliance is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:advancedPolarTrainingStatus ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"Minimum-hours-of-rest compliance is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:restComplianceStatus ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"STCW Code section A-II/2 compliance is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stcwCodeSectionAIi2ComplianceStatus ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"STCW Convention regulation II/2 compliance is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:stcwConventionRegulationIi2ComplianceStatus ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"Training-qualified personnel must cover all watches.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:watchCoverageStatus ], [ sh:datatype xsd:string ; sh:in ( Literal(\"passenger ship\", datatype=xsd:string) Literal(\"tanker\", datatype=xsd:string) Literal(\"cargo ship other than tanker\", datatype=xsd:string