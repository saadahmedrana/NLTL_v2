@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F02/ship> ;
            sh:resultMessage "For clean or segregated ballast, paragraph 1.1.1 oil-discharge applicability must be recorded as false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For clean or segregated ballast, paragraph 1.1.1 oil-discharge applicability must be recorded as false." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?material ?app
WHERE {
    $this nltl:dischargedMaterialClassification ?material .
    FILTER (
        ?material IN (
            nltl:cleanBallastMaterial,
            nltl:segregatedBallastMaterial
        )
    )
    OPTIONAL {
        $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?app .
    }
    FILTER (
        !BOUND(?app) ||
        DATATYPE(?app) != xsd:boolean ||
        ?app != false
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:PolarCodeOilDischargeExceptionShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F02/ship> ] .

