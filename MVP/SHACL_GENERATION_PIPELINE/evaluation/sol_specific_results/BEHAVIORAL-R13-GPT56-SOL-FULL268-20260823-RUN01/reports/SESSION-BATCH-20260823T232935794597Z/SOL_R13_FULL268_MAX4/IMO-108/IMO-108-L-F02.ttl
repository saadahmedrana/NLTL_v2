@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( nltl:polarShipCategoryC ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:shipCategory ] ] , [ sh:or ( [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2017-01-01\", datatype=xsd:date) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:constructionDate ] ] [ sh:or ( [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:AggregateCapacityAtLeast600 ; sh:path nltl:aggregateOilFuelCapacity ] ] [ sh:or ( [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:IndividualCapacityAtMost30 ; sh:path nltl:individualOilFuelTankCapacity ] ] [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:IndividualCapacityAbove30 ; sh:path nltl:individualOilFuelTankCapacity ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:OuterShellSeparationAtLeast076 ; sh:path nltl:oilFuelTankOuterShellSeparation ] ] ) ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gs:AggregateCapacityBelow600 ; sh:path nltl:aggregateOilFuelCapacity ] ] ) ; sh:property [ sh:datatype xsd:date ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2017-01-01\", datatype=xsd:date) ; sh:path nltl:constructionDate ] ] ) ; sh:property [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:shipCategory ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO108Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-F02/ship> ] .

