@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-F02/ship> ;
            sh:resultMessage "An applicable ship must have Administration carriage approval and a certificate entry identifying polar-water operation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "An applicable ship must have Administration carriage approval and a certificate entry identifying polar-water operation." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:shipCategory ?category ;
          nltl:constructionDate ?constructionDate ;
          nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ?requiresType3 ;
          nltl:cargoTankType ?tankType .

    FILTER (
        ?category IN (
            nltl:polarShipCategoryA,
            nltl:polarShipCategoryB
        )
    )
    FILTER (DATATYPE(?constructionDate) = xsd:date)
    FILTER (
        YEAR(?constructionDate) > 2017 ||
        (
            YEAR(?constructionDate) = 2017 &&
            (
                MONTH(?constructionDate) > 1 ||
                (
                    MONTH(?constructionDate) = 1 &&
                    DAY(?constructionDate) >= 1
                )
            )
        )
    )
    FILTER (?requiresType3 = true)
    FILTER (?tankType = "3"^^xsd:string)

    FILTER (
        NOT EXISTS {
            $this nltl:administrationCarriageApprovalStatus
                  nltl:evidenceStateApproved .
        }
        ||
        NOT EXISTS {
            $this nltl:applicableCertificatePolarOperationEntryPresent
                  ?certificateEntry .
            FILTER (?certificateEntry = true)
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO_114_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-F02/ship> ] .

