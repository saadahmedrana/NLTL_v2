@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-115-M-F04/ship> ;
            sh:resultMessage "The discharge applicability selectors and applicable sewage-discharge constraints are inconsistent." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO115Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-115-M-F04/ship> ] .

