@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F02/ship> ;
            sh:resultMessage "The treatment-plant-use selector must be recorded; when true, the required approvals, MARPOL compliance statuses, and discharge-distance records must be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO117ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F02/ship> ] .

