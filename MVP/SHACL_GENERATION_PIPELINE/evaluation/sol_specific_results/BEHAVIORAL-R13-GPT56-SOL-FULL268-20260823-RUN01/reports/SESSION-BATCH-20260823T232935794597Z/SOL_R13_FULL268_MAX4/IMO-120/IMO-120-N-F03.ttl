@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-F03/ship> ;
            sh:resultMessage "Ice concentration is required for an applicable discharge." ;
            sh:resultPath nltl:iceConcentration ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Ice concentration is required for an applicable discharge." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:iceConcentration ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-F03/ship> ;
            sh:resultMessage "At least one nearest-land, ice-shelf, or fast-ice distance is required for an applicable discharge." ;
            sh:resultPath nltl:distanceToNearestLandIceShelfOrFastIce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "At least one nearest-land, ice-shelf, or fast-ice distance is required for an applicable discharge." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:MI_N ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:message "Every reported nearest distance must be at least 12 nautical miles." ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 12.0 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:distanceToNearestLandIceShelfOrFastIce ] ] .

