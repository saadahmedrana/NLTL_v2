@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F03/ship> ;
            sh:resultMessage "Node ex:ship->nltl:harmfulSubstancePresent does not contain a value in the set: ['Literal(\"false\" = False, datatype=xsd:boolean)']" ;
            sh:resultPath nltl:harmfulSubstancePresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue false ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:harmfulSubstancePresent ] ] .

