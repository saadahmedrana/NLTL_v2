@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P02/ship> ;
            sh:resultMessage "A ship with a heading-reference or position-fixing system must identify the intended area and have approved intended-area suitability status." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:HeadingPositionSystemSuitabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P02/ship> ] .

