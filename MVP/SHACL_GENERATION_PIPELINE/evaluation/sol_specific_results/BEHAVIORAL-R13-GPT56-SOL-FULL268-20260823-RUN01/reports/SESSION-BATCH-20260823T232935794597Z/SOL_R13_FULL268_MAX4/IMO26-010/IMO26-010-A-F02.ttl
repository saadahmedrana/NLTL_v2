@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-010-A-F02/ship> ;
            sh:resultMessage "The below-hull sensor applicability selector must have exactly one boolean value." ;
            sh:resultPath nltl:requiredSensorProjectsBelowHull ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The below-hull sensor applicability selector must have exactly one boolean value." ;
                    sh:minCount 1 ;
                    sh:path nltl:requiredSensorProjectsBelowHull ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-010-A-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:requiredSensorProjectsBelowHull ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Ice protection must be present when required sensors project below the hull.\") ; sh:path nltl:sensorIceProtectionPresent ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:requiredSensorProjectsBelowHull ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:BelowHullSensorIceProtectionShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-010-A-F02/ship> ] .

