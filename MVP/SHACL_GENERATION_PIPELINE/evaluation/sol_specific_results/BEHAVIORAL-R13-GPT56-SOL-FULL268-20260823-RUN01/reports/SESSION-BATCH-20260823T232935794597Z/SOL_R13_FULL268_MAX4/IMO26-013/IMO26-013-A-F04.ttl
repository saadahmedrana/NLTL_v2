@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-013-A-F04/ship> ;
            sh:resultMessage "Planned or actual latitude is required to determine whether the over-80-degree requirements apply." ;
            sh:resultPath nltl:plannedOrActualLatitude ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Planned or actual latitude is required to determine whether the over-80-degree requirements apply." ;
                    sh:minCount 1 ;
                    sh:node gs:LatitudeValueShape ;
                    sh:path nltl:plannedOrActualLatitude ] ] .

