@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-015-B-F02/ship> ;
            sh:resultMessage "A ship marked as subject to Polar Code chapter 11 must be certified in accordance with SOLAS chapter I." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship marked as subject to Polar Code chapter 11 must be certified in accordance with SOLAS chapter I." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:polarCodeChapter11Applicable ?chapter11Applicable .
    FILTER(?chapter11Applicable = "true"^^xsd:boolean)
    FILTER NOT EXISTS {
        $this nltl:solasChapterICertified ?solasCertified .
        FILTER(?solasCertified = "true"^^xsd:boolean)
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO26_015_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-015-B-F02/ship> ] .

