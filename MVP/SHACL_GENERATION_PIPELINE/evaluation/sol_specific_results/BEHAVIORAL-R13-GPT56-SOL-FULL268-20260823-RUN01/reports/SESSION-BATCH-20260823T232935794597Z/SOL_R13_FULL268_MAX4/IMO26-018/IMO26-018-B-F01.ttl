@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-018-B-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( Literal(\"false\" = False, datatype=xsd:boolean) ) ; sh:path nltl:polarCodeChapter11Dash1Applicable ] ] , [ sh:or ( [ sh:property [ sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:path nltl:safetyManagementSystemImplemented ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"A documented polar operation procedure must be present when no safety management system is implemented.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:documentedPolarOperationProcedurePresent ], [ sh:in ( Literal(\"false\" = False, datatype=xsd:boolean) ) ; sh:path nltl:safetyManagementSystemImplemented ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"The voyage planning record must cover all nine clause 11-1.3 topics.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:voyagePlanningTopicCoverage ], [ sh:datatype xsd:boolean ; sh:message Literal(\"Safety management system implementation status must be recorded when chapter 11-1 applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:safetyManagementSystemImplemented ], [ sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:path nltl:polarCodeChapter11Dash1Applicable ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO26_018_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-018-B-F01/ship> ] .

