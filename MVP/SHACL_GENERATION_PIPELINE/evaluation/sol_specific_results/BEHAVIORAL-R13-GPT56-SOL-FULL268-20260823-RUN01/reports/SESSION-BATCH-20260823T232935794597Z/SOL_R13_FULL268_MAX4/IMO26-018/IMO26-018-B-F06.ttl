@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-018-B-F06/ship> ;
            sh:resultMessage "Polar Code chapter 11-1 applicability must be recorded." ;
            sh:resultPath nltl:polarCodeChapter11Dash1Applicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "Polar Code chapter 11-1 applicability must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarCodeChapter11Dash1Applicable ] ] .

