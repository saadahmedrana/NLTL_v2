@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-P01/ship> ;
            sh:resultMessage "The 2021 section 1.8 ice-class provision must apply." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:iceClassSection1Point8Provision2021 ;
                    sh:message "The 2021 section 1.8 ice-class provision must apply." ;
                    sh:path nltl:applicableIceClassRegulatoryProvision ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-P01/ship> ;
            sh:resultMessage "The 2021 chapter 2 Ice Class Draught provision must apply." ;
            sh:resultPath nltl:applicableIceClassRegulatoryProvision ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:iceClassDraughtChapter2Provision2021 ;
                    sh:message "The 2021 chapter 2 Ice Class Draught provision must apply." ;
                    sh:path nltl:applicableIceClassRegulatoryProvision ] ] .

