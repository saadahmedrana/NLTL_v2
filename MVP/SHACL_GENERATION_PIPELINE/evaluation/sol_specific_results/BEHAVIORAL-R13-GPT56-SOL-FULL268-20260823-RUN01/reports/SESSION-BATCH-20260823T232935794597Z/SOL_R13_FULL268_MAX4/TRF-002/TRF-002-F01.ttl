@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-002-F01/ship> ;
            sh:resultMessage "A ship contracted on or after 1 January 2019 but before 5 July 2021 must identify the 2017 Ice Class Regulations as applicable." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship contracted on or after 1 January 2019 but before 5 July 2021 must identify the 2017 Ice Class Regulations as applicable." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionContractDate ?date .
    FILTER (
        (
            YEAR(?date) > 2019 ||
            (
                YEAR(?date) = 2019 &&
                (
                    MONTH(?date) > 1 ||
                    (MONTH(?date) = 1 && DAY(?date) >= 1)
                )
            )
        ) &&
        (
            YEAR(?date) < 2021 ||
            (
                YEAR(?date) = 2021 &&
                (
                    MONTH(?date) < 7 ||
                    (MONTH(?date) = 7 && DAY(?date) < 5)
                )
            )
        )
    )
    FILTER NOT EXISTS {
        $this nltl:applicableIceClassRegulationEdition
            nltl:iceClassRegulationEdition2017 .
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF002Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-002-F01/ship> ] .

