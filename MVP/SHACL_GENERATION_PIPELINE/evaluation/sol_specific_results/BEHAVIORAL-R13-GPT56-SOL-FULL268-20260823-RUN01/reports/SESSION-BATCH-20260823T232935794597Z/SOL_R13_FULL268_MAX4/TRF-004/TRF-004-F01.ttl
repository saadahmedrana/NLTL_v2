@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:or ( [ sh:maxExclusive Literal(\"2010-01-01\", datatype=xsd:date) ] [ sh:minInclusive Literal(\"2012-01-01\", datatype=xsd:date) ] ) ; sh:path nltl:constructionContractDate ] ] , [ sh:property [ sh:hasValue nltl:iceClassRegulationEdition2008 ; sh:message Literal(\"Ships contracted on or after 1 January 2010 but before 1 January 2012 must identify the 2008 Ice Class Regulations as applicable.\") ; sh:path nltl:applicableIceClassRegulationEdition ], [ sh:path nltl:constructionContractDate ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2012-01-01\", datatype=xsd:date) ; sh:minInclusive Literal(\"2010-01-01\", datatype=xsd:date) ] ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF004IceClassRegulationApplicabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-004-F01/ship> ] .

