@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:not [ sh:or ( [ sh:property [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ] ] [ sh:property [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] ) ] ] , [ sh:or ( [ sh:property [ sh:datatype xsd:date ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("2003-09-01", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ] [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal("2003-09-01", datatype=xsd:date) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ], [ sh:datatype xsd:date ; sh:message Literal("A delivery date is required to determine the compliance deadline.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:deliveryDate ], [ sh:datatype xsd:date ; sh:message Literal("An assessment date is required to evaluate the compliance deadline.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:assessmentDate ] ; sh:sparql [ sh:message Literal("Once the twenty-year deadline has been reached, the ship must comply using the section 3.2.2 or section 3.2.4 method.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:deliveryDate ?delivery ;
          nltl:assessmentDate ?assessment .
    FILTER(YEAR(?assessment) >= YEAR(?delivery) + 20)
    FILTER NOT EXISTS {
        $this nltl:engineOutputComplianceMethod ?method .
        FILTER(?method IN (
            nltl:traficom2017Section3Point2Point2Method,
            nltl:traficom2017Section3Point2Point4Method
        ))
    }
}
") ] ] ), ( [ sh:property [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ] ] [ sh:property [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] ) ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF009Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F02/ship> ] .

