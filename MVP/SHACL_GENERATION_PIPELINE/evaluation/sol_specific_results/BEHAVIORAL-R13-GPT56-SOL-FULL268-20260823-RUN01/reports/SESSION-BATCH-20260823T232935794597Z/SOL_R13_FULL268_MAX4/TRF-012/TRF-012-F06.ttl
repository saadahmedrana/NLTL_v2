@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/lowerPoint> ;
                            sh:resultMessage "Each waterline profile point requires a vertical coordinate in metres." ;
                            sh:resultPath nltl:verticalCoordinate ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:message "Each waterline profile point requires a vertical coordinate in metres." ;
                                    sh:minCount 1 ;
                                    sh:node gen:TRF012LengthQuantityShape ;
                                    sh:path nltl:verticalCoordinate ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/lowerIceWaterline> ;
                    sh:resultMessage "The ice waterline requires profile points with position and coordinate data." ;
                    sh:resultPath nltl:hasWaterlineProfilePoint ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:waterlineProfilePoint ;
                            sh:message "The ice waterline requires profile points with position and coordinate data." ;
                            sh:minCount 1 ;
                            sh:node gen:TRF012ProfilePointShape ;
                            sh:path nltl:hasWaterlineProfilePoint ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/lowerPoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/ship> ;
            sh:resultMessage "An externally determined lower ice waterline with profile-point data is required." ;
            sh:resultPath nltl:hasLowerIceWaterline ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceWaterline ;
                    sh:message "An externally determined lower ice waterline with profile-point data is required." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF012WaterlineShape ;
                    sh:path nltl:hasLowerIceWaterline ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F06/lowerIceWaterline> ] .

