@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-F02/ship> ;
            sh:resultMessage "The operating fore and aft draughts must be between their respective minimum and maximum ice class draughts." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The operating fore and aft draughts must be between their respective minimum and maximum ice class draughts." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:shipIceStrengthened "true"^^xsd:boolean ;
          nltl:operatingForeDraught ?operatingFore ;
          nltl:operatingAftDraught ?operatingAft ;
          nltl:maximumIceClassDraughtFore ?maximumFore ;
          nltl:maximumIceClassDraughtAft ?maximumAft ;
          nltl:minimumIceClassDraughtFore ?minimumFore ;
          nltl:minimumIceClassDraughtAft ?minimumAft .
    ?operatingFore qudt:numericValue ?operatingForeValue .
    ?operatingAft qudt:numericValue ?operatingAftValue .
    ?maximumFore qudt:numericValue ?maximumForeValue .
    ?maximumAft qudt:numericValue ?maximumAftValue .
    ?minimumFore qudt:numericValue ?minimumForeValue .
    ?minimumAft qudt:numericValue ?minimumAftValue .
    FILTER (
        ?operatingForeValue < ?minimumForeValue ||
        ?operatingForeValue > ?maximumForeValue ||
        ?operatingAftValue < ?minimumAftValue ||
        ?operatingAftValue > ?maximumAftValue
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF013Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-F02/ship> ] .

