@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:navigatingInIce ] ] , [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:navigatingInIce ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The maximum permitted ice trim must be recorded when navigating in ice.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:MetreQuantityShape ; sh:path nltl:maximumPermittedIceTrim ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The operating draught must be recorded when navigating in ice.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:MetreQuantityShape ; sh:path nltl:operatingDraught ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The operating trim must be recorded when navigating in ice.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:MetreQuantityShape ; sh:path nltl:operatingTrim ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The upper ice waterline draught must be recorded when navigating in ice.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:MetreQuantityShape ; sh:path nltl:upperIceWaterlineDraught ] ; sh:sparql [ sh:message Literal("When navigating in ice, operating draught must not exceed the upper ice waterline draught and operating trim must not exceed the maximum permitted ice trim.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:operatingDraught ?operatingDraught .
                        ?operatingDraught qudt:numericValue ?operatingDraughtValue .
                        $this nltl:upperIceWaterlineDraught ?upperIceWaterlineDraught .
                        ?upperIceWaterlineDraught qudt:numericValue ?upperIceWaterlineDraughtValue .
                        $this nltl:operatingTrim ?operatingTrim .
                        ?operatingTrim qudt:numericValue ?operatingTrimValue .
                        $this nltl:maximumPermittedIceTrim ?maximumPermittedIceTrim .
                        ?maximumPermittedIceTrim qudt:numericValue ?maximumPermittedIceTrimValue .
                        FILTER (
                            ?operatingDraughtValue > ?upperIceWaterlineDraughtValue ||
                            ?operatingTrimValue > ?maximumPermittedIceTrimValue
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF015ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F02/ship> ] .

