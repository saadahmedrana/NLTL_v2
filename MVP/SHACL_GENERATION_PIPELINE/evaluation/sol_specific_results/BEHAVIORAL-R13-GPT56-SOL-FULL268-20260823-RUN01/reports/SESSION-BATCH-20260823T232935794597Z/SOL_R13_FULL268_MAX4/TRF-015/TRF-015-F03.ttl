@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F03/ship> ;
            sh:resultMessage "The loading calculation must use the sea-water salinity of the intended route." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The loading calculation must use the sea-water salinity of the intended route." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:intendedRouteSeaWaterSalinity ?routeSalinity .
                ?routeSalinity qudt:numericValue ?routeValue .
                $this nltl:loadingCalculationSeaWaterSalinity ?loadingSalinity .
                ?loadingSalinity qudt:numericValue ?loadingValue .
                FILTER (?loadingValue != ?routeValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF015ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F03/ship> ] .

