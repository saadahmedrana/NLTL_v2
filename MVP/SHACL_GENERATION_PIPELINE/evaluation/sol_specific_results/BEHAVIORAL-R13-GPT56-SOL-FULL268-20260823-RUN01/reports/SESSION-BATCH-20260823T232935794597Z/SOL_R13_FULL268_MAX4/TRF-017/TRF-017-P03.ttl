@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P03/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propulsionOutputRestrictionApplies ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:KilowattQuantityValueShape ; sh:path nltl:maximumContinuousRatingPower ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:KilowattQuantityValueShape ; sh:path nltl:propulsionMachineryContinuousOutput ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("The engine output P must equal the propulsion machinery continuous output when propulsion output restriction does not apply.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:maximumContinuousRatingPower ?reported ;
                              nltl:propulsionMachineryContinuousOutput ?selected .
                        ?reported qudt:numericValue ?reportedValue .
                        ?selected qudt:numericValue ?expectedValue .
                        FILTER(?reportedValue != ?expectedValue)
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propulsionOutputRestrictionApplies ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:KilowattQuantityValueShape ; sh:path nltl:maximumContinuousRatingPower ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:KilowattQuantityValueShape ; sh:path nltl:restrictedPropulsionOutput ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("The engine output P must equal the restricted propulsion output when propulsion output restriction applies.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:maximumContinuousRatingPower ?reported ;
                              nltl:restrictedPropulsionOutput ?selected .
                        ?reported qudt:numericValue ?reportedValue .
                        ?selected qudt:numericValue ?expectedValue .
                        FILTER(?reportedValue != ?expectedValue)
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF017EngineOutputShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P03/ship> ] .

