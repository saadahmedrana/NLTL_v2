@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <urn:nltl:generated-shape:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F01/ship> ;
            sh:resultMessage "Maximum continuous rating power must be at least the calculated required power and at least 1000 kW for IA, IB, or IC, or 2800 kW for IA Super." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Maximum continuous rating power must be at least the calculated required power and at least 1000 kW for IA, IB, or IC, or 2800 kW for IA Super." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:calculatedRequiredPower ?calculatedPower ;
                      nltl:maximumContinuousRatingPower ?mcrPower .
                ?calculatedPower qudt:numericValue ?calculatedValue ;
                                 qudt:unit unit:KiloW .
                ?mcrPower qudt:numericValue ?mcrValue ;
                          qudt:unit unit:KiloW .
                FILTER (
                    (?iceClass IN (
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    ) &&
                    (
                        ?mcrValue < ?calculatedValue ||
                        ?mcrValue < "1000"^^xsd:decimal
                    ))
                    ||
                    (?iceClass = nltl:iceClassIaSuper &&
                    (
                        ?mcrValue < ?calculatedValue ||
                        ?mcrValue < "2800"^^xsd:decimal
                    ))
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape shape:TRF018RequiredEngineOutputShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F01/ship> ] .

