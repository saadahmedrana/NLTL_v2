@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F05/mcr> ;
                    sh:resultMessage "Node ex:mcr->qudt:unit does not contain a value in the set: ['unit:KiloW']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue unit:KiloW ;
                            sh:maxCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F05/ship> ;
            sh:resultMessage "Applicable ships must have exactly one maximum continuous rating power in kW." ;
            sh:resultPath nltl:maximumContinuousRatingPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Applicable ships must have exactly one maximum continuous rating power in kW." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:KiloW ;
                                    sh:maxCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:maximumContinuousRatingPower ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-F05/mcr> ] .

