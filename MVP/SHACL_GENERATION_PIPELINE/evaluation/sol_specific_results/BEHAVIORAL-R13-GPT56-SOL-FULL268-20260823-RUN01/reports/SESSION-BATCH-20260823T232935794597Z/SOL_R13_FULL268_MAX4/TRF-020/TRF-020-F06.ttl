@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-F06/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal("2003-09-01", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ] , [ sh:property [ sh:in ( nltl:iceClassIi nltl:iceClassIii ) ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:class nltl:iceWaterline ; sh:message Literal("An applicable ship requires a lower ice waterline.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:hasLowerIceWaterline ], [ sh:class nltl:iceWaterline ; sh:message Literal("An applicable ship requires an upper ice waterline with its breadth and length.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:MetreQuantityValueShape ; sh:path nltl:upperIceWaterlineBreadth ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:MetreQuantityValueShape ; sh:path nltl:upperIceWaterlineLength ] ] ; sh:path nltl:hasUpperIceWaterline ], [ sh:class nltl:propellerPitchControlTypeValue ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerPitchControlType ], [ sh:class nltl:propulsionSystemTypeValue ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propulsionSystemType ], [ sh:datatype xsd:date ; sh:minInclusive Literal("2003-09-01", datatype=xsd:date) ; sh:path nltl:constructionStageDate ], [ sh:datatype xsd:integer ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:propellerCount ], [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc ) ; sh:path nltl:iceClass ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:DecimalQuantityValueShape ; sh:path nltl:brashIceChannelResistanceAtLowerIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:DecimalQuantityValueShape ; sh:path nltl:brashIceChannelResistanceAtUpperIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:KilowattQuantityValueShape ; sh:path nltl:maximumContinuousRatingPower ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:KilowattQuantityValueShape ; sh:path nltl:minimumRequiredPowerAtLowerIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:KilowattQuantityValueShape ; sh:path nltl:minimumRequiredPowerAtUpperIceWaterline ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:MetreQuantityValueShape ; sh:path nltl:propellerDiameter ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:UnitlessQuantityValueShape ; sh:path nltl:engineOutputCoefficientKe ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("Maximum continuous rating power must be at least both externally calculated minimum required powers.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:maximumContinuousRatingPower ?mcrQuantity ;
          nltl:minimumRequiredPowerAtLowerIceWaterline ?lowerQuantity ;
          nltl:minimumRequiredPowerAtUpperIceWaterline ?upperQuantity .
    ?mcrQuantity qudt:numericValue ?mcr .
    ?lowerQuantity qudt:numericValue ?lowerMinimum .
    ?upperQuantity qudt:numericValue ?upperMinimum .
    FILTER(
        xsd:decimal(?mcr) < xsd:decimal(?lowerMinimum) ||
        xsd:decimal(?mcr) < xsd:decimal(?upperMinimum)
    )
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF020ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-F06/ship> ] .

