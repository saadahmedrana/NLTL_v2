@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-022-F10/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:clampedHullGeometryTerm" ;
            sh:resultPath nltl:clampedHullGeometryTerm ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gen:UnitlessQuantityShape ;
                    sh:path nltl:clampedHullGeometryTerm ] ] .

