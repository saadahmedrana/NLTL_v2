@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F01/ship> ;
            sh:resultMessage "For ice class IB or IC under the 1985 rules, maximum continuous rating power must be at least the required power under those rules." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ice class IB or IC under the 1985 rules, maximum continuous rating power must be at least the required power under those rules." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
          nltl:maximumContinuousRatingPower ?mcrQuantity ;
          nltl:requiredPowerUnder1985Rules ?requiredQuantity .
    FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
    ?mcrQuantity qudt:numericValue ?mcrValue ;
                 qudt:unit unit:KiloW .
    ?requiredQuantity qudt:numericValue ?requiredValue ;
                      qudt:unit unit:KiloW .
    FILTER (datatype(?mcrValue) = xsd:decimal)
    FILTER (datatype(?requiredValue) = xsd:decimal)
    FILTER (?mcrValue < ?requiredValue)
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF023ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F01/ship> ] .

