@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/ship> ;
            sh:resultMessage "Power values used for compliance with the 1985 ice-class rules must use the kilowatt unit." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Power values used for compliance with the 1985 ice-class rules must use the kilowatt unit." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
          ?powerProperty ?quantity .
    FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
    FILTER (?powerProperty IN (
        nltl:maximumContinuousRatingPower,
        nltl:requiredPowerUnder1985Rules
    ))
    ?quantity qudt:unit ?unit .
    FILTER (?unit != unit:KiloW)
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF023ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/ship> ;
            sh:resultMessage "A ship of ice class IB or IC governed by the 1985 rules must provide decimal maximum continuous rating power and required 1985-rules power values in kilowatts." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship of ice class IB or IC governed by the 1985 rules must provide decimal maximum continuous rating power and required 1985-rules power values in kilowatts." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 .
    FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
    FILTER (
        !EXISTS {
            $this nltl:maximumContinuousRatingPower ?mcrQuantity .
            ?mcrQuantity qudt:numericValue ?mcrValue ;
                         qudt:unit unit:KiloW .
            FILTER (datatype(?mcrValue) = xsd:decimal)
        }
        ||
        !EXISTS {
            $this nltl:requiredPowerUnder1985Rules ?requiredQuantity .
            ?requiredQuantity qudt:numericValue ?requiredValue ;
                              qudt:unit unit:KiloW .
            FILTER (datatype(?requiredValue) = xsd:decimal)
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF023ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/ship> ] .

