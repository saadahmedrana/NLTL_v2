@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-F03/ship> ;
            sh:resultMessage "An applicable IA or IA Super ship must provide its delivery date." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "An applicable IA or IA Super ship must provide its delivery date." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:constructionStageDate ?constructionDate .
    FILTER (?iceClass IN (nltl:iceClassIa, nltl:iceClassIaSuper))
    FILTER (datatype(?constructionDate) = xsd:date)
    FILTER (
        YEAR(?constructionDate) < 2003 ||
        (YEAR(?constructionDate) = 2003 && MONTH(?constructionDate) < 9)
    )
    FILTER NOT EXISTS {
        $this nltl:deliveryDate ?deliveryDate .
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF024Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-F03/ship> ] .

