@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-P02/ship> ;
            sh:resultMessage "By 1 January of the twentieth year after the delivery year, the ship must use the section 3.2.2 engine-output compliance method." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "By 1 January of the twentieth year after the delivery year, the ship must use the section 3.2.2 engine-output compliance method." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:constructionStageDate ?constructionDate ;
          nltl:deliveryDate ?deliveryDate ;
          nltl:assessmentDate ?assessmentDate .
    FILTER (?iceClass IN (nltl:iceClassIa, nltl:iceClassIaSuper))
    FILTER (datatype(?constructionDate) = xsd:date)
    FILTER (datatype(?deliveryDate) = xsd:date)
    FILTER (datatype(?assessmentDate) = xsd:date)
    FILTER (
        YEAR(?constructionDate) < 2003 ||
        (YEAR(?constructionDate) = 2003 && MONTH(?constructionDate) < 9)
    )
    FILTER (YEAR(?assessmentDate) >= YEAR(?deliveryDate) + 20)
    FILTER NOT EXISTS {
        $this nltl:engineOutputComplianceMethod
              nltl:traficom2017Section3Point2Point2Method .
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF024Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-P02/ship> ] .

