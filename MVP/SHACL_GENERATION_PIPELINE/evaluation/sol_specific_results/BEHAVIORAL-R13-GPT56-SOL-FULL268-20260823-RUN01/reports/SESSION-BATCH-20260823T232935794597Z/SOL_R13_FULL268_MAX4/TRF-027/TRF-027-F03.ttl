@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:iceClassIb ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:hasValue nltl:iceClassIc ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:hasValue nltl:iceClassIi ; sh:path nltl:iceClass ] ] , [ sh:property [ sh:hasValue nltl:iceClassIii ; sh:path nltl:iceClass ] ] , [ sh:or ( [ sh:property [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ] ] [ sh:property [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] ), ( [ sh:property [ sh:minInclusive Literal(\"2003-09-01\", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ] [ sh:and ( [ sh:property [ sh:maxExclusive Literal(\"2003-09-01\", datatype=xsd:date) ; sh:path nltl:constructionStageDate ] ] gen:TRF027ApplicableShape ) ] ) ; sh:property [ sh:datatype xsd:date ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The construction stage date is required for IA Super and IA applicability.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:constructionStageDate ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF027Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-F03/ship> ] .

