@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-029-F05/ship> ;
            sh:resultMessage "Direct analysis use must be explicitly recorded." ;
            sh:resultPath nltl:directAnalysisUsed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "Direct analysis use must be explicitly recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:directAnalysisUsed ] ] .

