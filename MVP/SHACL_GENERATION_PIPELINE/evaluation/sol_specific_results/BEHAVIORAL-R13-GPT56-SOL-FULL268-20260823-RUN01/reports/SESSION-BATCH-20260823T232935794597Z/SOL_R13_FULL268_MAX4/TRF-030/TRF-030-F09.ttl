            sh:resultMessage "The externally determined applied ice pressure is required." ;
            sh:resultPath nltl:appliedIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The externally determined applied ice pressure is required." ;
                    sh:minCount 1 ;
                    sh:node gen:MegaPascalQuantityValueShape ;
                    sh:path nltl:appliedIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F09/ship> ;
            sh:resultMessage "At least two direct analysis cases with paired vertical and horizontal positions are required." ;
