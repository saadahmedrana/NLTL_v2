@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:beamTheoryUsed ] ] , [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:beamTheoryUsed ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A single allowable shear stress in MPa is required when beam theory is used.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:MPaQuantityShape ; sh:path nltl:allowableShearStress ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("A single yield shear stress in MPa is required when beam theory is used.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:MPaQuantityShape ; sh:path nltl:yieldShearStress ] ; sh:sparql [ sh:message Literal("For beam theory, yield shear stress must equal yield point divided by sqrt(3) within relative tolerance 1e-6 (absolute fallback 1e-12 MPa), and allowable shear stress must not exceed 0.9 times the calculated yield shear stress.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:yieldPoint ?yieldQuantity ;
                              nltl:yieldShearStress ?yieldShearQuantity ;
                              nltl:allowableShearStress ?allowableQuantity .
                        ?yieldQuantity qudt:numericValue ?yieldPoint .
                        ?yieldShearQuantity qudt:numericValue ?yieldShearStress .
                        ?allowableQuantity qudt:numericValue ?allowableShearStress .
                        BIND (?yieldPoint / 1.7320508075688772 AS ?expectedYieldShearStress)
                        BIND (
                            IF (
                                ABS(?expectedYieldShearStress) * 0.000001 > 0.000000000001,
                                ABS(?expectedYieldShearStress) * 0.000001,
                                0.000000000001
                            )
                            AS ?tolerance
                        )
                        FILTER (
                            ABS(?yieldShearStress - ?expectedYieldShearStress) > ?tolerance
                            ||
                            ?allowableShearStress > (0.9 * ?expectedYieldShearStress)
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF031Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F04/ship> ] .

