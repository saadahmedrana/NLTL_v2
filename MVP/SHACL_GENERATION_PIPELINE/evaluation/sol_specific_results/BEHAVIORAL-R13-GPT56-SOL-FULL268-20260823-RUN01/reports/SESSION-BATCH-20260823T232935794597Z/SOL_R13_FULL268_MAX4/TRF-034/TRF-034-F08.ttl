@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F08/member> ;
                    sh:resultMessage "Less than 1 values on ex:member->nltl:memberNormalToPlating" ;
                    sh:resultPath nltl:memberNormalToPlating ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path nltl:memberNormalToPlating ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F08/effectiveSection> ;
            sh:resultMessage "Each linked hull structure must provide exactly one boolean member orientation value." ;
            sh:resultPath [ sh:inversePath nltl:hasEffectiveMemberCrossSection ] ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked hull structure must provide exactly one boolean member orientation value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:hullStructure ;
                            sh:nodeKind sh:IRI ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path nltl:memberNormalToPlating ] ] ;
                    sh:path [ sh:inversePath nltl:hasEffectiveMemberCrossSection ] ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F08/member> ] .

