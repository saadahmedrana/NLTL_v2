@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ship> ;
            sh:resultMessage "The ship's rule length shall equal the rule length used by the classification society." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The ship's rule length shall equal the rule length used by the classification society." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:ruleLength ?ruleLengthQuantity ;
                      nltl:classificationSocietyRuleLength ?societyLengthQuantity .
                ?ruleLengthQuantity qudt:numericValue ?ruleLength .
                ?societyLengthQuantity qudt:numericValue ?societyLength .
                FILTER (?ruleLength != ?societyLength)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF035ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ship> ] .

