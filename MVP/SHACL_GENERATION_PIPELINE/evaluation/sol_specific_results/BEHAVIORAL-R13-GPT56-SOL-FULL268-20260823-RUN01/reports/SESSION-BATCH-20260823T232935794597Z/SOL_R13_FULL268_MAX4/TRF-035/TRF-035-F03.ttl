@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F03/ship> ;
            sh:resultMessage "The ship shall have exactly one rule length expressed in metres." ;
            sh:resultPath nltl:ruleLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall have exactly one rule length expressed in metres." ;
                    sh:minCount 1 ;
                    sh:node gs:TRF035LengthQuantityShape ;
                    sh:path nltl:ruleLength ] ] .

