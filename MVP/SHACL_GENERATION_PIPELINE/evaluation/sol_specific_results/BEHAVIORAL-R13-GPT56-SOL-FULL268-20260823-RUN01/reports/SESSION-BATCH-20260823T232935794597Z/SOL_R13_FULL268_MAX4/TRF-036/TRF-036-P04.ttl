@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-P04/designParameters> ;
            sh:resultMessage "The ice-class design parameters must correspond to the ship's ice class and the Table 4-1 values." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IceClassDesignParameterSetShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-P04/designParameters> ] .

