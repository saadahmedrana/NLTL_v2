@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-F11/ship> ;
            sh:resultMessage "At least one direct analysis case with ice load area factor ca is required." ;
            sh:resultPath nltl:hasDirectAnalysisCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:directAnalysisCase ;
                    sh:message "At least one direct analysis case with ice load area factor ca is required." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF037DirectAnalysisCaseShape ;
                    sh:path nltl:hasDirectAnalysisCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-F11/ship> ;
            sh:resultMessage "Design ice pressure is required as one decimal quantity in MPa." ;
            sh:resultPath nltl:icePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Design ice pressure is required as one decimal quantity in MPa." ;
                    sh:minCount 1 ;
                    sh:node gen:TRF037PressureQuantityShape ;
                    sh:path nltl:icePressure ] ] .

