@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F03/plating> ;
            sh:resultMessage "Node ex:plating must conform to one or more shapes in [ sh:property [ sh:hasValue nltl:transverseFramingOrientation ; sh:path nltl:platingFramingOrientation ], [ sh:message Literal(\"Transversely framed plating requires plating pressure in megapascals.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:MegapascalQuantityShape ; sh:path nltl:platingPressure ], [ sh:message Literal(\"Transversely framed plating requires transverse plating factor f1.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:UnitlessQuantityShape ; sh:path nltl:transversePlatingFactorF1 ] ] , [ sh:property [ sh:hasValue nltl:longitudinalFramingOrientation ; sh:path nltl:platingFramingOrientation ], [ sh:message Literal(\"Longitudinally framed plating requires ice pressure in megapascals.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:MegapascalQuantityShape ; sh:path nltl:icePressure ], [ sh:message Literal(\"Longitudinally framed plating requires longitudinal plating factor f2.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:UnitlessQuantityShape ; sh:path nltl:longitudinalPlatingFactorF2 ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF041PlatingReadinessShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F03/plating> ] .

