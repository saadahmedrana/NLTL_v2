@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P04/plating> ;
            sh:resultMessage "The corrosion and abrasion addition is required as one decimal quantity in millimetres." ;
            sh:resultPath nltl:corrosionAbrasionAddition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The corrosion and abrasion addition is required as one decimal quantity in millimetres." ;
                    sh:minCount 1 ;
                    sh:node gen:MillimetreQuantityShape ;
                    sh:path nltl:corrosionAbrasionAddition ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P04/plating> ;
            sh:resultMessage "Yield strength is required as one decimal quantity in MPa." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Yield strength is required as one decimal quantity in MPa." ;
                    sh:minCount 1 ;
                    sh:node gen:YieldStrengthQuantityShape ;
                    sh:path nltl:yieldStrength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P04/plating> ;
            sh:resultMessage "Node ex:plating must conform to one or more shapes in ([ sh:property [ sh:hasValue nltl:normalStrengthHullStructuralSteel ; sh:path nltl:hullStructuralSteelGrade ], [ sh:node gen:YieldStrength235Shape ; sh:path nltl:yieldStrength ] ] , [ sh:property [ sh:hasValue nltl:highStrengthHullStructuralSteel ; sh:path nltl:hullStructuralSteelGrade ], [ sh:node gen:YieldStrengthAtLeast315Shape ; sh:path nltl:yieldStrength ] ] , [ sh:property [ sh:class nltl:evidenceState ; sh:hasValue nltl:evidenceStateApproved ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A different steel yield strength requires approved acceptance evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:materialApprovalStatus ], [ sh:not [ sh:in ( nltl:normalStrengthHullStructuralSteel nltl:highStrengthHullStructuralSteel ) ] ; sh:path nltl:hullStructuralSteelGrade ] ]) and ([ sh:property [ sh:node gen:CorrosionAddition2Shape ; sh:path nltl:corrosionAbrasionAddition ] ] , [ sh:property [ sh:class nltl:evidenceState ; sh:hasValue nltl:evidenceStateApproved ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A corrosion addition below 2 mm requires approved evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:materialApprovalStatus ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A corrosion addition below 2 mm requires a maintained special surface coating.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:specialSurfaceCoatingMaintained ], [ sh:node gen:CorrosionAdditionBelow2Shape ; sh:path nltl:corrosionAbrasionAddition ] ])" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF042PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P04/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P04/plating> ;
            sh:resultMessage "Exactly one hull structural steel grade selector is required." ;
            sh:resultPath nltl:hullStructuralSteelGrade ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeValue ;
                    sh:maxCount 1 ;
                    sh:message "Exactly one hull structural steel grade selector is required." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hullStructuralSteelGrade ] ] .

