@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-P03/upperEnd> ;
                    sh:resultMessage "The upper end must be attached to a deck structure, tank boundary plating, or ice stringer." ;
                    sh:resultPath nltl:hasAttachedSupportingStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The upper end must be attached to a deck structure, tank boundary plating, or ice stringer." ;
                            sh:path nltl:hasAttachedSupportingStructure ;
                            sh:qualifiedMinCount 1 ;
                            sh:qualifiedValueShape [ sh:or ( [ sh:class nltl:deckStructure ] [ sh:class nltl:tankBoundaryPlating ] [ sh:class nltl:iceStringer ] ) ] ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-P03/frame> ;
            sh:resultMessage "Each upper end of a main frame must be attached to a deck structure, tank boundary plating, or ice stringer." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameEnd ;
                    sh:message "Each upper end of a main frame must be attached to a deck structure, tank boundary plating, or ice stringer." ;
                    sh:minCount 1 ;
                    sh:node gen:DirectAttachmentEndShape ;
                    sh:path nltl:hasUpperEnd ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-P03/upperEnd> ] .

