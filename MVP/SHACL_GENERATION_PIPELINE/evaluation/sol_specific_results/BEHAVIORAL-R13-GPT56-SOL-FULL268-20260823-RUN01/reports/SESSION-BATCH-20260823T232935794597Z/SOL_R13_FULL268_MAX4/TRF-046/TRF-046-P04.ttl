@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-P04/adjacentMainFrame> ;
            sh:resultMessage "A main frame must identify its strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameStrengthenedPart ;
                    sh:message "A main frame must identify its strengthened part." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasStrengthenedPart ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-P04/frame> ;
            sh:resultMessage "Each upper end of an intermediate ice frame must use a permitted direct attachment or qualifying horizontal-member connection." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameEnd ;
                    sh:message "Each upper end of an intermediate ice frame must use a permitted direct attachment or qualifying horizontal-member connection." ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:node gen:DirectAttachmentEndShape ] [ sh:node gen:QualifiedHorizontalConnectionEndShape ] ) ;
                    sh:path nltl:hasUpperEnd ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-P04/upperEnd> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-P04/adjacentMainFrame> ;
            sh:resultMessage "Each upper end of a main frame must be attached to a deck structure, tank boundary plating, or ice stringer." ;
            sh:resultPath nltl:hasUpperEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameEnd ;
                    sh:message "Each upper end of a main frame must be attached to a deck structure, tank boundary plating, or ice stringer." ;
                    sh:minCount 1 ;
                    sh:node gen:DirectAttachmentEndShape ;
                    sh:path nltl:hasUpperEnd ] ] .

