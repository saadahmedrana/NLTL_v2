@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/lowerEnd> ;
                    sh:resultMessage "Node ex:lowerEnd must conform to one or more shapes in [ sh:node gen:AttachedLowerEndShape ] , [ sh:node gen:ExceptionLowerEndShape ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gen:IntermediateLowerEndShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/lowerEnd> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/frame> ;
            sh:resultMessage "Each lower end of an intermediate ice frame must use a permitted attachment or horizontal-connection alternative." ;
            sh:resultPath nltl:hasLowerEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameEnd ;
                    sh:message "Each lower end of an intermediate ice frame must use a permitted attachment or horizontal-connection alternative." ;
                    sh:minCount 1 ;
                    sh:node gen:IntermediateLowerEndShape ;
                    sh:path nltl:hasLowerEnd ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/lowerEnd> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/adjacentMainFrame> ;
            sh:resultMessage "The main frame below the ice belt must be recorded as strengthened." ;
            sh:resultPath nltl:mainFrameBelowIceBeltStrengthened ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The main frame below the ice belt must be recorded as strengthened." ;
                    sh:minCount 1 ;
                    sh:path nltl:mainFrameBelowIceBeltStrengthened ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/adjacentMainFrame> ;
            sh:resultMessage "A main frame must identify its strengthened part." ;
            sh:resultPath nltl:hasStrengthenedPart ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameStrengthenedPart ;
                    sh:message "A main frame must identify its strengthened part." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasStrengthenedPart ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/adjacentMainFrame> ;
            sh:resultMessage "Each lower end of a main frame must be attached to a permitted supporting structure." ;
            sh:resultPath nltl:hasLowerEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameEnd ;
                    sh:message "Each lower end of a main frame must be attached to a permitted supporting structure." ;
                    sh:minCount 1 ;
                    sh:node gen:AttachedLowerEndShape ;
                    sh:path nltl:hasLowerEnd ] ] .

