@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P02/frame> ;
            sh:resultMessage "The main frame below the ice belt must be recorded as strengthened." ;
            sh:resultPath nltl:mainFrameBelowIceBeltStrengthened ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd5db7211f10e400c8d1b07c1a9e12737b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P02/frame> ;
            sh:resultMessage "The main frame below the ice belt must be recorded as strengthened." ;
            sh:resultPath nltl:mainFrameBelowIceBeltStrengthened ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nd5db7211f10e400c8d1b07c1a9e12737b3 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P02/lowerEnd> ;
                    sh:resultMessage "The lower end must be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
                    sh:resultPath nltl:hasAttachedSupportingStructure ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The lower end must be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
                            sh:path nltl:hasAttachedSupportingStructure ;
                            sh:qualifiedMinCount 1 ;
                            sh:qualifiedValueShape gen:PermittedSupportingStructureShape ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P02/frame> ;
            sh:resultMessage "Each lower end of a main frame must be attached to a permitted supporting structure." ;
            sh:resultPath nltl:hasLowerEnd ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:frameEnd ;
                    sh:message "Each lower end of a main frame must be attached to a permitted supporting structure." ;
                    sh:minCount 1 ;
                    sh:node gen:AttachedLowerEndShape ;
                    sh:path nltl:hasLowerEnd ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P02/lowerEnd> ] .

_:nd5db7211f10e400c8d1b07c1a9e12737b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The main frame below the ice belt must be recorded as strengthened." ;
    sh:minCount 1 ;
    sh:path nltl:mainFrameBelowIceBeltStrengthened .

