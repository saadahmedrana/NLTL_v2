@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ;
            sh:resultMessage "Node ex:longitudinalFrame must conform to one or more shapes in [ sh:property [ sh:not [ sh:in ( nltl:continuousBeamWithBracketsFrameCondition ) ] ; sh:path nltl:frameBoundaryConditionType ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:significantlyDifferentBoundaryConditions ], [ sh:hasValue nltl:continuousBeamWithBracketsFrameCondition ; sh:path nltl:frameBoundaryConditionType ], [ sh:maxInclusive Literal(\"13.3\", datatype=xsd:decimal) ; sh:message Literal(\"For a continuous beam with brackets without significantly different boundary conditions, m must equal 13.3.\") ; sh:minInclusive Literal(\"13.3\", datatype=xsd:decimal) ; sh:path ( nltl:frameMomentFactorM qudt:numericValue ) ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:significantlyDifferentBoundaryConditions ], [ sh:hasValue nltl:continuousBeamWithBracketsFrameCondition ; sh:path nltl:frameBoundaryConditionType ], [ sh:maxExclusive Literal(\"13.3\", datatype=xsd:decimal) ; sh:message Literal(\"For significantly different continuous-beam boundary conditions, m must be smaller than 13.3.\") ; sh:path ( nltl:frameMomentFactorM qudt:numericValue ) ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:LongitudinalFrameCalculationShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ] .

