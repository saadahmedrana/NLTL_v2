@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F02/longitudinalFrame> ;
            sh:resultMessage "The reported f4, section modulus, or required shear area does not match the prescribed calculation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The reported f4, section modulus, or required shear area does not match the prescribed calculation." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:spacing/qudt:numericValue ?s ;
                      nltl:span/qudt:numericValue ?l ;
                      nltl:frameMomentFactorM/qudt:numericValue ?m ;
                      nltl:yieldStrength/qudt:numericValue ?yield ;
                      nltl:longitudinalFrameLoadDistributionFactorF4/qudt:numericValue ?reportedF4 ;
                      nltl:sectionModulus/qudt:numericValue ?reportedZ ;
                      nltl:requiredShearArea/qudt:numericValue ?reportedA .

                BIND(IF(?s = 0, 1, ?s) AS ?safeS)
                BIND(IF(?m = 0, 1, ?m) AS ?safeM)
                BIND(IF(?yield = 0, 1, ?yield) AS ?safeYield)

                BIND(1 - (0.2 * ?h / ?safeS) AS ?expectedF4)
                BIND(
                    (?expectedF4 * ?p * ?h * ?l * ?l
                     / (4 * ?safeM * ?safeYield)) * 1000000
                    AS ?expectedZ
                )
                BIND(
                    (1.7320508075688772 * ?expectedF4 * 2.16 * ?p * ?h * ?l
                     / (2 * ?safeYield)) * 10000
                    AS ?expectedA
                )

                BIND(IF(?expectedF4 < 0, -?expectedF4, ?expectedF4) AS ?magnitudeF4)
                BIND(IF(?expectedZ < 0, -?expectedZ, ?expectedZ) AS ?magnitudeZ)
                BIND(IF(?expectedA < 0, -?expectedA, ?expectedA) AS ?magnitudeA)

                BIND(
                    IF(
                        (?magnitudeF4 * 0.000001) > 0.000000001,
                        ?magnitudeF4 * 0.000001,
                        0.000000001
                    )
                    AS ?toleranceF4
                )
                BIND(
                    IF(
                        (?magnitudeZ * 0.000001) > 0.000000001,
                        ?magnitudeZ * 0.000001,
                        0.000000001
                    )
                    AS ?toleranceZ
                )
                BIND(
                    IF(
                        (?magnitudeA * 0.000001) > 0.000000001,
                        ?magnitudeA * 0.000001,
                        0.000000001
                    )
                    AS ?toleranceA
                )

                FILTER (
                    ?s = 0 ||
                    ?m = 0 ||
                    ?yield = 0 ||
                    ?reportedF4 < (?expectedF4 - ?toleranceF4) ||
                    ?reportedF4 > (?expectedF4 + ?toleranceF4) ||
                    ?reportedZ < (?expectedZ - ?toleranceZ) ||
                    ?reportedZ > (?expectedZ + ?toleranceZ) ||
                    ?reportedA < (?expectedA - ?toleranceA) ||
                    ?reportedA > (?expectedA + ?toleranceA)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:LongitudinalFrameCalculationShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F02/longitudinalFrame> ] .

