@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ;
            sh:resultMessage "Actual frame shear area must equal gross frame shear area minus bracket area." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Actual frame shear area must equal gross frame shear area minus bracket area." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:grossFrameShearArea/qudt:numericValue ?gross ;
                      nltl:bracketArea/qudt:numericValue ?bracket ;
                      nltl:actualFrameShearArea/qudt:numericValue ?actual .

                BIND(?gross - ?bracket AS ?expectedActual)
                BIND(
                    IF(?expectedActual < 0, -?expectedActual, ?expectedActual)
                    AS ?magnitudeActual
                )
                BIND(
                    IF(
                        (?magnitudeActual * 0.000001) > 0.000000001,
                        ?magnitudeActual * 0.000001,
                        0.000000001
                    )
                    AS ?toleranceActual
                )

                FILTER (
                    ?actual < (?expectedActual - ?toleranceActual) ||
                    ?actual > (?expectedActual + ?toleranceActual)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:LongitudinalFrameCalculationShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ] .

