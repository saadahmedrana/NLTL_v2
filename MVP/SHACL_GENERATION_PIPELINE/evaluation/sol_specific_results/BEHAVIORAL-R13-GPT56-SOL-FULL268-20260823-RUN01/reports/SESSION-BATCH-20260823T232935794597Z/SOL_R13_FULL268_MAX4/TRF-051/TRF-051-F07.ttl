@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <urn:nltl:generated-shape:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-051-F07/hullStructure> ;
            sh:resultMessage "Externally calculated frame web thickness is required and must be at least 9 mm." ;
            sh:resultPath nltl:frameWebThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Externally calculated frame web thickness is required and must be at least 9 mm." ;
                    sh:minCount 1 ;
                    sh:node shape:TRF051FrameWebThicknessQuantityShape ;
                    sh:path nltl:frameWebThickness ] ] .

