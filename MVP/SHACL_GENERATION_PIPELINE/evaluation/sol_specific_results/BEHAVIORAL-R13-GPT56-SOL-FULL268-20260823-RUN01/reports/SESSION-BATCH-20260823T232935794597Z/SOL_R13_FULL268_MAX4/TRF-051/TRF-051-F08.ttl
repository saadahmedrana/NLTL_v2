@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <urn:nltl:generated-shape:> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-051-F08/frameWebThicknessValue> ;
                    sh:resultMessage "Node ex:frameWebThicknessValue->qudt:unit does not contain a value in the set: ['unit:MilliM']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue unit:MilliM ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-051-F08/hullStructure> ;
            sh:resultMessage "Externally calculated frame web thickness is required and must be at least 9 mm." ;
            sh:resultPath nltl:frameWebThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Externally calculated frame web thickness is required and must be at least 9 mm." ;
                    sh:minCount 1 ;
                    sh:node shape:TRF051FrameWebThicknessQuantityShape ;
                    sh:path nltl:frameWebThickness ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-051-F08/frameWebThicknessValue> ] .

