@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F01/frame> ;
            sh:resultMessage "Node ex:frame must conform to one or more shapes in gs:TRF052DirectCalculationAlternativeShape , gs:TRF052PrescriptiveArrangementShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF052Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-F01/frame> ] .

