@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "Actual section modulus and shear area must not be less than their required values." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Actual section modulus and shear area must not be less than their required values." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:abreastOfHatch true ;
          nltl:servesAsIceStringer true ;
          nltl:actualSectionModulus ?actualSectionNode ;
          nltl:requiredSectionModulus ?requiredSectionNode ;
          nltl:actualShearArea ?actualShearNode ;
          nltl:requiredShearArea ?requiredShearNode .
    ?actualSectionNode qudt:numericValue ?actualSection .
    ?requiredSectionNode qudt:numericValue ?requiredSection .
    ?actualShearNode qudt:numericValue ?actualShear .
    ?requiredShearNode qudt:numericValue ?requiredShear .
    FILTER (
        ?actualSection < ?requiredSection ||
        ?actualShear < ?requiredShear
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:NarrowDeckStripComplianceShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "Node ex:narrowDeckStrip must conform to one or more shapes in gs:NonApplicableNarrowDeckStripShape , gs:ApplicableNarrowDeckStripShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:NarrowDeckStripComplianceShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ] .

