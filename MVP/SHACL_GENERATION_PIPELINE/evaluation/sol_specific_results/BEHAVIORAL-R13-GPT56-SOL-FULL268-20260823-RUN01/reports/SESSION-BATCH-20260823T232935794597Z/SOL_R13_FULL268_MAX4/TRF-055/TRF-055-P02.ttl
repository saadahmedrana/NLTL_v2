@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ;
            sh:resultMessage "A represented reduced line load is permitted only for a very long hatch, must be classification-society approved, and must be at least 0.10 and less than 0.15." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A represented reduced line load is permitted only for a very long hatch, must be classification-society approved, and must be at least 0.10 and less than 0.15." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:abreastOfHatch true ;
          nltl:servesAsIceStringer true ;
          nltl:permittedReducedLineLoad ?reducedNode .
    ?reducedNode qudt:numericValue ?reducedValue .
    FILTER (
        ?reducedValue < 0.10 ||
        ?reducedValue >= 0.15 ||
        NOT EXISTS {
            $this nltl:veryLongHatchOpening true .
        } ||
        NOT EXISTS {
            $this nltl:reducedLineLoadApprovedByClassificationSociety true .
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:NarrowDeckStripComplianceShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ;
            sh:resultMessage "Node ex:narrowDeckStrip must conform to one or more shapes in gs:NonApplicableNarrowDeckStripShape , gs:ApplicableNarrowDeckStripShape" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:NarrowDeckStripComplianceShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ] .

