@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F02/ship> ;
            sh:resultMessage "A weatherdeck hatch longer than half the ship breadth must represent ship-side deflection and have both hatch-cover and hatch-fitting design evidence." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A weatherdeck hatch longer than half the ship breadth must represent ship-side deflection and have both hatch-cover and hatch-fitting design evidence." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this ?hatch
WHERE {
    $this nltl:shipBreadth ?breadth ;
          nltl:hasWeatherdeckHatch ?hatch .
    ?breadth qudt:numericValue ?breadthValue ;
             qudt:unit unit:M .
    ?hatch nltl:hatchOpeningLength ?openingLength .
    ?openingLength qudt:numericValue ?openingLengthValue ;
                   qudt:unit unit:M .
    FILTER(
        datatype(?breadthValue) = xsd:decimal &&
        datatype(?openingLengthValue) = xsd:decimal &&
        ?openingLengthValue > (?breadthValue / 2)
    )
    FILTER NOT EXISTS {
        ?hatch nltl:shipSideDeflection ?deflection ;
               nltl:hasHatchCoverDesignEvidence ?coverEvidence ;
               nltl:hasHatchFittingDesignEvidence ?fittingEvidence .
        ?deflection rdf:type qudt:QuantityValue ;
                    qudt:numericValue ?deflectionValue ;
                    qudt:unit unit:M .
        ?coverEvidence rdf:type nltl:hatchCoverDesignEvidence .
        ?fittingEvidence rdf:type nltl:hatchFittingDesignEvidence .
        FILTER(datatype(?deflectionValue) = xsd:decimal)
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF056ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F02/ship> ] .

