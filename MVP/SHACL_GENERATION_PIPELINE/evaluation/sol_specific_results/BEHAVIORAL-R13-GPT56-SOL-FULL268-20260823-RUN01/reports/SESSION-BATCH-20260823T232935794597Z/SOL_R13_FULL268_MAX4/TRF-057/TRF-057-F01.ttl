@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "Web frame ice load must equal 1.8 times the greater of p*h and 0.15 MN/m, times spacing, within relative tolerance 1e-6 or absolute tolerance 1e-9 kN." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Web frame ice load must equal 1.8 times the greater of p*h and 0.15 MN/m, times spacing, within relative tolerance 1e-6 or absolute tolerance 1e-9 kN." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureQuantity ;
                      nltl:iceLoadHeight ?heightQuantity ;
                      nltl:webFrameSpacing ?spacingQuantity ;
                      nltl:webFrameIceLoad ?loadQuantity .
                ?pressureQuantity qudt:numericValue ?p .
                ?heightQuantity qudt:numericValue ?h .
                ?spacingQuantity qudt:numericValue ?spacing .
                ?loadQuantity qudt:numericValue ?reportedLoad .
                BIND(
                    IF(
                        (?p * ?h) < "0.15"^^xsd:decimal,
                        "0.15"^^xsd:decimal,
                        (?p * ?h)
                    )
                    AS ?effectiveLineLoad
                )
                BIND(
                    ("1800"^^xsd:decimal * ?effectiveLineLoad * ?spacing)
                    AS ?expectedLoad
                )
                BIND(
                    IF(
                        ABS(?expectedLoad) * "0.000001"^^xsd:decimal
                            > "0.000000001"^^xsd:decimal,
                        ABS(?expectedLoad) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER(ABS(?reportedLoad - ?expectedLoad) > ?tolerance)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:WebFrameIceLoadShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "Ice load source type must be exactly one permitted source." ;
            sh:resultPath nltl:iceLoadSourceType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:iceStringerLoadSource nltl:longitudinalFramingLoadSource ) ;
                    sh:maxCount 1 ;
                    sh:message "Ice load source type must be exactly one permitted source." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:iceLoadSourceType ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "Less than 1 values on ex:webFrame->nltl:loadLengthParameter" ;
            sh:resultPath nltl:loadLengthParameter ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:loadLengthParameter ] ] .

