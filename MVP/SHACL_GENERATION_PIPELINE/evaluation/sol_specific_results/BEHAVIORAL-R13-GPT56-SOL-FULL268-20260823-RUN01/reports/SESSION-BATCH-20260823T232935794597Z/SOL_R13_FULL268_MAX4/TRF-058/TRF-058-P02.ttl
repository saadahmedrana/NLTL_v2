@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-P02/webFrame> ;
            sh:resultMessage "The outside-ice-belt selector and all applicable force-adjustment inputs and result must be represented." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF_058_WebFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-058-P02/webFrame> ] .

