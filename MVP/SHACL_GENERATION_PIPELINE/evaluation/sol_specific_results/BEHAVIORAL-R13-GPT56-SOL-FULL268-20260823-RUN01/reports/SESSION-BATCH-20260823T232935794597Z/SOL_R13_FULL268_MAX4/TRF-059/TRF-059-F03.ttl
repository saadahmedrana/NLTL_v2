@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F03/webFrame> ;
            sh:resultMessage "The shear factor must match Table 4-8 and requiredShearArea must satisfy the prescribed formula within relative tolerance 1e-6 or absolute tolerance 1e-9." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The shear factor must match Table 4-8 and requiredShearArea must satisfy the prescribed formula within relative tolerance 1e-6 or absolute tolerance 1e-9." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?forceQuantity ;
                      nltl:webFrameShearFactorAlpha ?alphaQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:freeFlangeToWebAreaRatio ?ratioQuantity ;
                      nltl:requiredShearArea ?areaQuantity .

                ?forceQuantity qudt:numericValue ?forceKN .
                ?alphaQuantity qudt:numericValue ?alpha .
                ?yieldQuantity qudt:numericValue ?yieldMPa .
                ?ratioQuantity qudt:numericValue ?ratio .
                ?areaQuantity qudt:numericValue ?reportedArea .

                BIND(
                    IF(
                        ?yieldMPa = "0"^^xsd:decimal,
                        "1"^^xsd:decimal,
                        ?yieldMPa
                    ) AS ?safeYield
                )
                BIND(
                    (
                        "1.7320508075688772"^^xsd:decimal *
                        ?alpha *
                        "1.1"^^xsd:decimal *
                        ?forceKN *
                        "10"^^xsd:decimal
                    ) / ?safeYield
                    AS ?expectedArea
                )
                BIND(
                    IF(
                        ABS(?expectedArea) * "0.000001"^^xsd:decimal >
                            "0.000000001"^^xsd:decimal,
                        ABS(?expectedArea) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    ) AS ?tolerance
                )

                FILTER (
                    ?yieldMPa = "0"^^xsd:decimal ||
                    !(
                        (?ratio = "0"^^xsd:decimal &&
                         ?alpha = "1.5"^^xsd:decimal) ||
                        (?ratio = "0.2"^^xsd:decimal &&
                         ?alpha = "1.23"^^xsd:decimal) ||
                        (?ratio = "0.4"^^xsd:decimal &&
                         ?alpha = "1.16"^^xsd:decimal) ||
                        (?ratio = "0.6"^^xsd:decimal &&
                         ?alpha = "1.11"^^xsd:decimal) ||
                        (?ratio = "0.8"^^xsd:decimal &&
                         ?alpha = "1.09"^^xsd:decimal) ||
                        (?ratio = "1.0"^^xsd:decimal &&
                         ?alpha = "1.07"^^xsd:decimal) ||
                        (?ratio = "1.2"^^xsd:decimal &&
                         ?alpha = "1.06"^^xsd:decimal) ||
                        (?ratio = "1.4"^^xsd:decimal &&
                         ?alpha = "1.05"^^xsd:decimal) ||
                        (?ratio = "1.6"^^xsd:decimal &&
                         ?alpha = "1.05"^^xsd:decimal) ||
                        (?ratio = "1.8"^^xsd:decimal &&
                         ?alpha = "1.04"^^xsd:decimal) ||
                        (?ratio = "2.0"^^xsd:decimal &&
                         ?alpha = "1.04"^^xsd:decimal)
                    ) ||
                    ABS(?reportedArea - ?expectedArea) > ?tolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:WebFrameShearAreaShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F03/webFrame> ] .

