@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-062-F01/ship> ;
            sh:resultMessage "Propeller blade tip hull clearance must be no less than the required minimum clearance." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Propeller blade tip hull clearance must be no less than the required minimum clearance." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:propellerBladeTipHullClearance ?actualQuantity ;
          nltl:minimumClearance ?minimumQuantity .
    ?actualQuantity qudt:numericValue ?actualValue .
    ?minimumQuantity qudt:numericValue ?minimumValue .
    FILTER (
        xsd:decimal(?actualValue) < xsd:decimal(?minimumValue)
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:PropellerBladeTipHullClearanceShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-062-F01/ship> ] .

