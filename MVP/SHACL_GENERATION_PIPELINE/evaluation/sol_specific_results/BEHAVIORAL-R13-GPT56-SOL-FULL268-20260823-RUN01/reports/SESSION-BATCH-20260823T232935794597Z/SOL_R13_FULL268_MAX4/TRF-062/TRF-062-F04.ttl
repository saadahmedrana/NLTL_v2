@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-062-F04/propellerBladeTipHullClearanceValue> ;
                    sh:resultMessage "The quantity must have metre as its single unit." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue unit:M ;
                            sh:maxCount 1 ;
                            sh:message "The quantity must have metre as its single unit." ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-062-F04/ship> ;
            sh:resultMessage "Propeller blade tip hull clearance is required." ;
            sh:resultPath nltl:propellerBladeTipHullClearance ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Propeller blade tip hull clearance is required." ;
                    sh:minCount 1 ;
                    sh:node gs:MetreQuantityValueShape ;
                    sh:path nltl:propellerBladeTipHullClearance ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-062-F04/propellerBladeTipHullClearanceValue> ] .

