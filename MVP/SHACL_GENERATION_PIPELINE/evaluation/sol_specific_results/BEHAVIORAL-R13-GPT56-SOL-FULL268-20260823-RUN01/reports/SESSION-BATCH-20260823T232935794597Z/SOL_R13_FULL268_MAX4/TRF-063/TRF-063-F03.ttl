@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:sidePropellerStrengtheningEnvelope ; sh:message Literal(\"Twin and triple screw ships must have a compliant side-propeller strengthening envelope.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF063EnvelopeShape ; sh:nodeKind sh:IRI ; sh:path nltl:hasSidePropellerStrengtheningEnvelope ], [ sh:datatype xsd:integer ; sh:in ( Literal(\"2\", datatype=xsd:integer) Literal(\"3\", datatype=xsd:integer) ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propellerCount ] ] , [ sh:property [ sh:datatype xsd:integer ; sh:maxInclusive Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:propellerCount ] ] , [ sh:property [ sh:datatype xsd:integer ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"4\", datatype=xsd:integer) ; sh:path nltl:propellerCount ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF063ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-063-F03/ship> ] .

