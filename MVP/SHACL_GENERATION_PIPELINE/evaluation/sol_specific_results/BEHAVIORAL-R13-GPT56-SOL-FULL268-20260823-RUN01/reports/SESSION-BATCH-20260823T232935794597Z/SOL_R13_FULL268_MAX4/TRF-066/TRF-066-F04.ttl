@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:and ( [ sh:or ( [ sh:property [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] [ sh:property [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ] ] ) ] [ sh:property [ sh:datatype xsd:string ; sh:message Literal(\"The lower ice waterline is required for an IA or IA Super ship.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:lowerIceWaterline ] ] [ sh:or ( [ sh:and ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ] ] [ sh:or ( [ sh:node gen:TRF066IceKnifeProtectionShape ] [ sh:node gen:TRF066EquivalentProtectionShape ] ) ] ) ] [ sh:and ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceKnifePracticable ] ] [ sh:node gen:TRF066EquivalentProtectionShape ] ) ] ) ] ) ] , [ sh:not [ sh:or ( [ sh:property [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] [ sh:property [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ] ] ) ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF066Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F04/ship> ] .

