@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-067-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:not [ sh:or ( [ sh:property [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] [ sh:property [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ] ] ) ] ] , [ sh:or ( [ sh:property [ sh:hasValue nltl:iceClassIa ; sh:path nltl:iceClass ] ] [ sh:property [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ] ] ) ; sh:property [ sh:class nltl:rudderLoadAbsorbingArrangement ; sh:message Literal(\"Ships of ice class IA or IA Super must have a rudder load absorbing arrangement.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:hasRudderProtectionArrangement ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF-067-ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-067-F02/ship> ] .

