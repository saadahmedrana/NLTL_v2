@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-F02/ship> ;
            sh:resultMessage "A fixed-pitch ship must include reversal loads in its design condition." ;
            sh:resultPath nltl:hasDesignCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A fixed-pitch ship must include reversal loads in its design condition." ;
                    sh:minCount 1 ;
                    sh:node g:FixedPitchReversalDesignConditionShape ;
                    sh:path nltl:hasDesignCondition ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-F02/ship> ;
            sh:resultMessage "An applicable ship must have a conforming propeller ice-load design condition." ;
            sh:resultPath nltl:hasDesignCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "An applicable ship must have a conforming propeller ice-load design condition." ;
                    sh:minCount 1 ;
                    sh:node g:PropellerIceLoadDesignConditionShape ;
                    sh:path nltl:hasDesignCondition ] ] .

