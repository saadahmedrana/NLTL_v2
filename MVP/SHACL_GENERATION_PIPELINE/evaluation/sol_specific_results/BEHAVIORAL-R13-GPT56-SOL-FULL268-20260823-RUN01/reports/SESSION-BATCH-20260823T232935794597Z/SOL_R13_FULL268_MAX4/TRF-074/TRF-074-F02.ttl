@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ] ; sh:sparql [ sh:message Literal("This alternative applies only when the ship is not of ice class IB or IC.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER(?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
                    }
                ") ] ] , [ sh:property [ sh:in ( nltl:iceClassIb nltl:iceClassIc ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:message Literal("Ice-class IB or IC ships require the ballast-condition propeller-top depth.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF074LengthQuantityShape ; sh:path nltl:ballastConditionPropellerTopDepth ], [ sh:message Literal("Ice-class IB or IC ships require the required propeller submersion depth hi.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF074LengthQuantityShape ; sh:path nltl:requiredPropellerSubmersionDepthHi ] ; sh:sparql [ sh:message Literal("This alternative requires the ballast-condition propeller-top depth to be at least hi.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:ballastConditionPropellerTopDepth ?depthQuantity ;
                              nltl:requiredPropellerSubmersionDepthHi ?hiQuantity .
                        ?depthQuantity qudt:numericValue ?depth .
                        ?hiQuantity qudt:numericValue ?hi .
                        FILTER(xsd:decimal(?depth) < xsd:decimal(?hi))
                    }
                ") ] ] , [ sh:property [ sh:hasValue nltl:iceClassIa ; sh:message Literal("When the ballast-condition propeller-top depth is less than hi, the propulsion system must be designed according to ice class IA.") ; sh:nodeKind sh:IRI ; sh:path nltl:propulsionSystemDesignedForIceClass ], [ sh:in ( nltl:iceClassIb nltl:iceClassIc ) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path nltl:iceClass ], [ sh:message Literal("Ice-class IB or IC ships require the ballast-condition propeller-top depth.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF074LengthQuantityShape ; sh:path nltl:ballastConditionPropellerTopDepth ], [ sh:message Literal("Ice-class IB or IC ships require the required propeller submersion depth hi.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:TRF074LengthQuantityShape ; sh:path nltl:requiredPropellerSubmersionDepthHi ] ; sh:sparql [ sh:message Literal("This alternative applies only when the ballast-condition propeller-top depth is less than hi.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:ballastConditionPropellerTopDepth ?depthQuantity ;
                              nltl:requiredPropellerSubmersionDepthHi ?hiQuantity .
                        ?depthQuantity qudt:numericValue ?depth .
                        ?hiQuantity qudt:numericValue ?hi .
                        FILTER(xsd:decimal(?depth) >= xsd:decimal(?hi))
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF074ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-F02/ship> ] .

