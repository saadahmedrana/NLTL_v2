@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "At least one conforming Table 6-6 lookup case is required." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "At least one conforming Table 6-6 lookup case is required." ;
                    sh:path nltl:hasTableLookupCase ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape [ sh:node gen:TRF078Table66CaseShape ] ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/table6> ;
                    sh:resultMessage "Every Table 6-7 lookup case must have a propeller-location selection key of class propellerLocationValue and a selected propeller-location factor." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Every Table 6-7 lookup case must have a propeller-location selection key of class propellerLocationValue and a selected propeller-location factor." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:tableReference nltl:traficomTable6Dash7 .
                FILTER(
                    NOT EXISTS {
                        $this nltl:tableLookupPropellerLocation ?location
                    }
                    ||
                    EXISTS {
                        $this nltl:tableLookupPropellerLocation ?location .
                        FILTER NOT EXISTS {
                            ?location a nltl:propellerLocationValue
                        }
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:selectedPropellerLocationFactor ?selectedFactor
                    }
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:TRF078LookupCaseShape ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/table6> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:TRF078LookupCaseShape. See details for more information." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node gen:TRF078LookupCaseShape ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/table6> ] .

