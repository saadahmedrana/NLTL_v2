@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ;
            sh:resultMessage "The immersion function and coefficient k2 must satisfy equations 6.16 and 6.15; propeller diameter must be non-zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The immersion function and coefficient k2 must satisfy equations 6.16 and 6.15; propeller diameter must be non-zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?iceNode ;
                      nltl:propellerDiameter ?diameterNode ;
                      nltl:propellerShaftCentrelineDepth ?depthNode ;
                      nltl:propellerImmersionFunction ?functionNode ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node .
                ?iceNode qudt:numericValue ?ice .
                ?diameterNode qudt:numericValue ?diameter .
                ?depthNode qudt:numericValue ?depth .
                ?functionNode qudt:numericValue ?reportedF .
                ?k2Node qudt:numericValue ?reportedK2 .

                BIND(
                    IF(
                        ?diameter = "0"^^xsd:decimal,
                        "0"^^xsd:decimal,
                        ((?depth - ?ice) / (?diameter / "2"^^xsd:decimal)) - "1"^^xsd:decimal
                    )
                    AS ?expectedF
                )
                BIND(
                    IF(
                        ?expectedF < "0"^^xsd:decimal,
                        "0.8"^^xsd:decimal - ?expectedF,
                        IF(
                            ?expectedF <= "1"^^xsd:decimal,
                            "0.8"^^xsd:decimal - ("0.4"^^xsd:decimal * ?expectedF),
                            IF(
                                ?expectedF <= "2.5"^^xsd:decimal,
                                "0.6"^^xsd:decimal - ("0.2"^^xsd:decimal * ?expectedF),
                                "0.1"^^xsd:decimal
                            )
                        )
                    )
                    AS ?expectedK2
                )
                BIND(
                    IF(
                        ABS(?expectedF) * "0.000001"^^xsd:decimal > "0.000000001"^^xsd:decimal,
                        ABS(?expectedF) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?fTolerance
                )
                BIND(
                    IF(
                        ABS(?expectedK2) * "0.000001"^^xsd:decimal > "0.000000001"^^xsd:decimal,
                        ABS(?expectedK2) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?k2Tolerance
                )
                FILTER(
                    ?diameter = "0"^^xsd:decimal ||
                    ABS(?reportedF - ?expectedF) > ?fTolerance ||
                    ABS(?reportedK2 - ?expectedK2) > ?k2Tolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF079SubmersionFactorShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F01/ship> ] .

