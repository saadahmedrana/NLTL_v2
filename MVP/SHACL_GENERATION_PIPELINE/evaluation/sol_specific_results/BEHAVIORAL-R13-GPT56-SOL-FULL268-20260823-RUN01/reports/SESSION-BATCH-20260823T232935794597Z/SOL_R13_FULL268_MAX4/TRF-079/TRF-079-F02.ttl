@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F02/ship> ;
            sh:resultMessage "Propeller immersion function must be provided as one decimal unitless quantity." ;
            sh:resultPath nltl:propellerImmersionFunction ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Propeller immersion function must be provided as one decimal unitless quantity." ;
                    sh:minCount 1 ;
                    sh:node gen:UnitlessQuantityShape ;
                    sh:path nltl:propellerImmersionFunction ] ] .

