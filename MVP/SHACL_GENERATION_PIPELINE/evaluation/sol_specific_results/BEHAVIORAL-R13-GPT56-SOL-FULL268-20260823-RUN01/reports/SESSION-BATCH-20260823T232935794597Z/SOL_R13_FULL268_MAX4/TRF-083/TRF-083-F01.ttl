@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-083-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:rotationalSpeedKnown ] ] , [ sh:property [ sh:class nltl:tableLookupCase ; sh:message Literal(\"When the rotational speed is unknown, a Table 6-9 lookup case is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:TRF083TableLookupCaseShape ; sh:path nltl:hasTableLookupCase ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:rotationalSpeedKnown ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF083ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-083-F01/ship> ] .

