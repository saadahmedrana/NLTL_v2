@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:maximumEngineTorqueKnown ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:maximumEngineTorqueKnown ], [ sh:message Literal(\"When maximum engine torque is unknown, a completed Table 6-10 lookup case is required.\") ; sh:path nltl:hasTableLookupCase ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape g:TRF088Table6Dash10LookupCaseShape ], [ sh:message Literal(\"When maximum engine torque is unknown, an assigned maximum engine torque value is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node g:TRF088MaximumEngineTorqueValueShape ; sh:path nltl:maximumEngineTorque ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape g:TRF088Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-088-F02/ship> ] .

