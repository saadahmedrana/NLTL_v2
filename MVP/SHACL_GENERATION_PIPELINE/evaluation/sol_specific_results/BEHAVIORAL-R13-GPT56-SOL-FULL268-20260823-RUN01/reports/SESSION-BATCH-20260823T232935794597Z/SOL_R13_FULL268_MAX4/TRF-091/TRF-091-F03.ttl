@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F03/milling> ;
                    sh:resultMessage "The ice-milling load sequence must be used for propulsion-line strength evaluation." ;
                    sh:resultPath nltl:loadCasePurpose ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                            sh:message "The ice-milling load sequence must be used for propulsion-line strength evaluation." ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:loadCasePurpose ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F03/ship> ;
            sh:resultMessage "The ship must identify an ice-milling load-sequence case." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:ndb4d9b14cede40d8a41c4137e8445a20b1 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F03/milling> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F03/ship> ;
            sh:resultMessage "Each ice-milling sequence case must also be a propulsion load case of the same ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each ice-milling sequence case must also be a propulsion load case of the same ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?case
            WHERE {
                $this nltl:hasIceMillingSequenceCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:hasPropulsionLoadCase ?case .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF091ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-F03/milling> ;
            sh:resultMessage "The ship must identify an ice-milling load-sequence case." ;
            sh:resultPath nltl:hasIceMillingSequenceCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ndb4d9b14cede40d8a41c4137e8445a20b1 ] .

_:ndb4d9b14cede40d8a41c4137e8445a20b1 sh:class nltl:iceMillingSequenceCase ;
    sh:message "The ship must identify an ice-milling load-sequence case." ;
    sh:minCount 1 ;
    sh:node gen:TRF091IceMillingSequenceCaseShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasIceMillingSequenceCase .

