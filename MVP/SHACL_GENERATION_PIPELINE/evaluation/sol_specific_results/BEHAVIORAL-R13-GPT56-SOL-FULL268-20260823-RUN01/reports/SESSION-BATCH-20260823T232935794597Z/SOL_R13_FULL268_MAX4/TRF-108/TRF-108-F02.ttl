@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F02/ship> ;
            sh:resultMessage "Propeller blade material properties must be recorded." ;
            sh:resultPath nltl:propellerBladeMaterialProperty ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "Propeller blade material properties must be recorded." ;
                    sh:minCount 1 ;
                    sh:path nltl:propellerBladeMaterialProperty ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-108-F02/ship> ;
            sh:resultMessage "Evidence that the selected curve corresponds with the blade material properties is required." ;
            sh:resultPath nltl:stressLifeCurveSelectionCorrespondenceEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                    sh:message "Evidence that the selected curve corresponds with the blade material properties is required." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ] ] .

