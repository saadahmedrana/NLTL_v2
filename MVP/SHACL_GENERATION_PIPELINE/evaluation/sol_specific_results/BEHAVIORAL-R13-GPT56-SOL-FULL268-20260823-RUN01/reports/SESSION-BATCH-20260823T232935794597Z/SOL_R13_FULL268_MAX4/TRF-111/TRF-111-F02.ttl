@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/ship> ;
            sh:resultMessage "Extreme ice force input is required in kilonewtons." ;
            sh:resultPath nltl:extremeIceForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:message "Extreme ice force input is required in kilonewtons." ;
                    sh:minCount 1 ;
                    sh:node gs:ExtremeIceForceValueShape ;
                    sh:path nltl:extremeIceForce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/ship> ;
            sh:resultMessage "A fatigue propulsion load case is required." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A fatigue propulsion load case is required." ;
                    sh:path nltl:hasPropulsionLoadCase ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape gs:FatigueLoadCaseShape ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/fatigueSafetyFactorValue> ;
                            sh:resultMessage "Value is not >= Literal(\"1.5\", datatype=xsd:decimal)" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 1.5 ;
                                    sh:path qudt:numericValue ] ;
                            sh:value 1.3 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/component> ;
                    sh:resultMessage "The component fatigue safety factor must be at least 1.5." ;
                    sh:resultPath nltl:fatigueSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class qudt:QuantityValue ;
                            sh:message "The component fatigue safety factor must be at least 1.5." ;
                            sh:minCount 1 ;
                            sh:node gs:FatigueSafetyFactor15ValueShape ;
                            sh:path nltl:fatigueSafetyFactor ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/fatigueSafetyFactorValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/ship> ;
            sh:resultMessage "At least one propeller shaft line component with a compliant fatigue safety factor is required." ;
            sh:resultPath nltl:hasPropellerShaftLineComponent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:propellerShaftLineComponent ;
                    sh:message "At least one propeller shaft line component with a compliant fatigue safety factor is required." ;
                    sh:minCount 1 ;
                    sh:node gs:PropellerShaftLineComponentShape ;
                    sh:path nltl:hasPropellerShaftLineComponent ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/component> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/ship> ;
            sh:resultMessage "A blade failure propulsion load case with a yield safety factor of at least 1.0 is required." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A blade failure propulsion load case with a yield safety factor of at least 1.0 is required." ;
                    sh:path nltl:hasPropulsionLoadCase ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape gs:BladeFailureLoadCaseShape ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F02/ship> ;
            sh:resultMessage "An extreme operational propulsion load case with a yield safety factor of at least 1.3 is required." ;
            sh:resultPath nltl:hasPropulsionLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "An extreme operational propulsion load case with a yield safety factor of at least 1.3 is required." ;
                    sh:path nltl:hasPropulsionLoadCase ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape gs:ExtremeOperationalLoadCaseShape ] ] .

