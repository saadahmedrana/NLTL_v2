                    sh:resultMessage "The torsional yield safety factor must be at least 1.0." ;
                    sh:resultPath nltl:torsionalYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "The torsional yield safety factor must be at least 1.0." ;
                            sh:minCount 1 ;
