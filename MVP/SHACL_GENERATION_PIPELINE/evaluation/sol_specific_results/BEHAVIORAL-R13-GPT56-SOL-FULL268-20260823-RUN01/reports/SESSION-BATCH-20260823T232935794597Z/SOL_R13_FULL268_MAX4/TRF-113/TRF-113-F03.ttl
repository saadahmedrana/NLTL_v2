@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F03/ship> ;
            sh:resultMessage "A blade-loss load case is required." ;
            sh:resultPath nltl:hasLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A blade-loss load case is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:loadCase ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:in ( true ) ;
                                    sh:message "The load case must confirm the blade orientation causing the maximum component load." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ] ] ;
                    sh:path nltl:hasLoadCase ] ] .

