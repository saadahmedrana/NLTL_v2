@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F02/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal("false" = False, datatype=xsd:boolean) ) ; sh:message Literal("The ship must explicitly state whether the air receiver serves an additional purpose.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:airReceiverServesAdditionalPurpose ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal("true" = True, datatype=xsd:boolean) ) ; sh:message Literal("The ship must explicitly state whether the air receiver serves an additional purpose.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:airReceiverServesAdditionalPurpose ], [ sh:message Literal("Air receiver capacity is required when the receiver serves an additional purpose.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M3 ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:airReceiverCapacity ], [ sh:message Literal("Required air capacity for the additional purpose must be provided.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ] ] ; sh:path nltl:additionalPurposeRequiredAirCapacity ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("Air receiver capacity must be at least the capacity required for the additional purpose.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
SELECT $this
WHERE {
    $this nltl:airReceiverServesAdditionalPurpose true ;
          nltl:airReceiverCapacity ?capacityNode ;
          nltl:additionalPurposeRequiredAirCapacity ?requiredNode .
    ?capacityNode qudt:numericValue ?capacity .
    ?requiredNode qudt:numericValue ?requiredCapacity .
    FILTER (?capacity < ?requiredCapacity)
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:TRF127AirReceiverCapacityShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-127-F02/ship> ] .

