@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F01/ship> ;
            sh:resultMessage "For ice class IA Super ships requiring propulsion-engine reversal for astern, compressor charge time must not exceed 0.5 hour." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ice class IA Super ships requiring propulsion-engine reversal for astern, compressor charge time must not exceed 0.5 hour." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper ;
                      nltl:propulsionEngineReversalRequiredForAstern ?reversal ;
                      nltl:compressorChargeTime ?chargeTime .
                ?chargeTime qudt:numericValue ?hours ;
                            qudt:unit unit:HR .
                FILTER (
                    ?reversal = "true"^^xsd:boolean &&
                    ?hours > "0.5"^^xsd:decimal
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF128Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-128-F01/ship> ] .

