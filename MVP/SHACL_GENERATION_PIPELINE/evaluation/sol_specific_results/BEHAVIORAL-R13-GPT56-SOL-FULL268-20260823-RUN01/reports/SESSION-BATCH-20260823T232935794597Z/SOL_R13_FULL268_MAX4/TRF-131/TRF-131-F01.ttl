@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-131-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:ballastWaterCoolingArrangement ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"false\" = False, datatype=xsd:boolean) ) ; sh:message Literal(\"A ballast-water cooling arrangement must not be accepted as a substitute for an inlet chest.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:substituteArrangementStatus ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:ballastWaterCoolingArrangement ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:BallastWaterCoolingSubstitutionShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-131-F01/ship> ] .

