@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F02/ship> ;
            sh:resultMessage "Engine output must be at least f1*f2*f3*(f4*Delta + P0), and at least 740 kW for ice classes IB and IC." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Engine output must be at least f1*f2*f3*(f4*Delta + P0), and at least 740 kW for ice classes IB and IC." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:maximumContinuousRatingPower ?mcrQuantity ;
                      nltl:engineOutputFormulaBasePowerP0 ?p0Quantity ;
                      nltl:engineOutputFormulaDisplacement ?displacementQuantity ;
                      nltl:engineOutputFormulaFactorF1 ?f1Quantity ;
                      nltl:engineOutputFormulaFactorF2 ?f2Quantity ;
                      nltl:engineOutputFormulaFactorF3 ?f3Quantity ;
                      nltl:engineOutputFormulaFactorF4 ?f4Quantity .

                ?mcrQuantity qudt:numericValue ?mcr .
                ?p0Quantity qudt:numericValue ?p0 .
                ?displacementQuantity qudt:numericValue ?displacement .
                ?f1Quantity qudt:numericValue ?f1 .
                ?f2Quantity qudt:numericValue ?f2 .
                ?f3Quantity qudt:numericValue ?f3 .
                ?f4Quantity qudt:numericValue ?f4 .

                FILTER (
                    ?mcr < (?f1 * ?f2 * ?f3 * ((?f4 * ?displacement) + ?p0))
                    ||
                    (
                        ?iceClass IN (nltl:iceClassIb, nltl:iceClassIc)
                        &&
                        ?mcr < "740"^^xsd:decimal
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF132EngineOutputShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F02/ship> ] .

