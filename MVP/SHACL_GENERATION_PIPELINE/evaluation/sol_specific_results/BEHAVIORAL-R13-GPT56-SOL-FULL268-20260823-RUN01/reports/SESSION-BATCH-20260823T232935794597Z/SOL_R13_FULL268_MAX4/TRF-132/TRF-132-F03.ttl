@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F03/ship> ;
            sh:resultMessage "Formula factor f4 must have one decimal numeric value." ;
            sh:resultPath nltl:engineOutputFormulaFactorF4 ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Formula factor f4 must have one decimal numeric value." ;
                    sh:minCount 1 ;
                    sh:node gen:DecimalQuantityShape ;
                    sh:path nltl:engineOutputFormulaFactorF4 ] ] .

