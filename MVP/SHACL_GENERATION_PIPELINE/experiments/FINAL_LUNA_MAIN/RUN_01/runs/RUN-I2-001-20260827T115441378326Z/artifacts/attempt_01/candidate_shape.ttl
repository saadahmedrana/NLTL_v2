@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-001> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:message "A construction contract date, when provided, must be an xsd:date."
    ] ;
    sh:property [
        sh:path nltl:urI2RevisionApplicability ;
        sh:datatype xsd:boolean ;
        sh:message "UR I2 revision applicability, when provided, must be an xsd:boolean."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ships contracted for construction on or after 1 January 2021 must have UR I2 revision applicability true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:constructionContractDate ?date .
                FILTER (?date >= "2021-01-01"^^xsd:date)
                FILTER NOT EXISTS {
                    $this nltl:urI2RevisionApplicability true .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ships contracted for construction before 1 January 2021 must not be marked as subject to the UR I2 revision." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:constructionContractDate ?date ;
                      nltl:urI2RevisionApplicability true .
                FILTER (?date < "2021-01-01"^^xsd:date)
            }
        """
    ] .
