@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_011_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [ sh:node gen:I2_011_ApplicableShape ]
        [ sh:node gen:I2_011_BulbousBowAbsentShape ]
        [ sh:node gen:I2_011_NonPc6Pc7Shape ]
    ) .

gen:I2_011_ApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarClassPc6
            nltl:polarClassPc7
        )
    ] ;
    sh:property [
        sh:path nltl:shapeCoefficient ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "0.6"^^xsd:decimal ;
                sh:maxInclusive "0.6"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "1.3"^^xsd:decimal ;
                sh:maxInclusive "1.3"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaN>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaN>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowDesignForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloN>
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "For applicable PC6 or PC7 ships with bulbous bows, bowDesignForce must equal method (iv) converted to kN within tolerance and must not be less than method (iii) converted to kN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivNode ;
                      nltl:bowDesignForce ?resultNode .

                ?iiiNode qudt:numericValue ?iii ;
                         qudt:unit <http://qudt.org/vocab/unit/MegaN> .
                ?ivNode qudt:numericValue ?iv ;
                        qudt:unit <http://qudt.org/vocab/unit/MegaN> .
                ?resultNode qudt:numericValue ?result ;
                            qudt:unit <http://qudt.org/vocab/unit/KiloN> .

                BIND (?iv * 1000 as ?expected)
                BIND (?iii * 1000 as ?minimum)
                BIND (IF(?expected < 0, -?expected, ?expected) * 0.000001 AS ?relativeTolerance)
                BIND (IF(?relativeTolerance < 0.000000001, 0.000000001, ?relativeTolerance) AS ?tolerance)

                FILTER (
                    ?result < ?minimum ||
                    ?result < (?expected - ?tolerance) ||
                    ?result > (?expected + ?tolerance)
                )
            }
        """
    ] .

gen:I2_011_BulbousBowAbsentShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .

gen:I2_011_NonPc6Pc7Shape a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:not [
                sh:in (
                    nltl:polarClassPc6
                    nltl:polarClassPc7
                )
            ]
        ]
    ] .
