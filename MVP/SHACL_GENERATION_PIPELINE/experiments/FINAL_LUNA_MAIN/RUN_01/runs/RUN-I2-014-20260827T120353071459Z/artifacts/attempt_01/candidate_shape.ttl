@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_014_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:bowLength ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide its bow length in metres."
    ] ;

    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4 ;
        sh:message "The bow region must be divided into four sub-regions."
    ] ;

    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:node [
            sh:class nltl:bowSubregionCalculationCase ;

            sh:property [
                sh:path nltl:bowSubregionCalculationEvidence ;
                sh:class nltl:evidenceArtifact ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Each bow sub-region calculation case must have calculation evidence."
            ] ;

            sh:property [
                sh:path nltl:bowSubregionMidLengthPosition ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Each bow sub-region must provide its mid-length position in metres."
            ] ;

            sh:property [
                sh:path nltl:bowSubregionAspectRatio ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Each bow sub-region must provide its load patch aspect ratio."
            ] ;

            sh:property [
                sh:path nltl:bowSubregionCalculatedForce ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Each bow sub-region must report its calculated force in MN."
            ] ;

            sh:property [
                sh:path nltl:bowSubregionCalculatedLineLoad ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN-M-PER-M2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Each bow sub-region must report its calculated line load in MN/m."
            ] ;

            sh:property [
                sh:path nltl:bowSubregionCalculatedPressure ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaPA ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Each bow sub-region must report its calculated pressure in MPa."
            ]
        ] ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:message "The ship must provide exactly four bow sub-region calculation cases."
    ] ;

    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:sparql [
        sh:message "The selected maximum bow force must be at least as large as every sub-region calculated force." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedQuantity ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?selectedQuantity qudt:numericValue ?selected .
                ?case nltl:bowSubregionCalculatedForce ?caseQuantity .
                ?caseQuantity qudt:numericValue ?value .
                FILTER (?value > ?selected)
            }
        """
    ] ;

    sh:sparql [
        sh:message "The selected maximum bow force must equal one of the four sub-region calculated forces." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedQuantity .
                ?selectedQuantity qudt:numericValue ?selected .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionCalculatedForce ?caseQuantity .
                    ?caseQuantity qudt:numericValue ?value .
                    FILTER (?value = ?selected)
                }
            }
        """
    ] ;

    sh:sparql [
        sh:message "The selected maximum bow line load must be at least as large as every sub-region calculated line load." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowLineLoad ?selectedQuantity ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?selectedQuantity qudt:numericValue ?selected .
                ?case nltl:bowSubregionCalculatedLineLoad ?caseQuantity .
                ?caseQuantity qudt:numericValue ?value .
                FILTER (?value > ?selected)
            }
        """
    ] ;

    sh:sparql [
        sh:message "The selected maximum bow line load must equal one of the four sub-region calculated line loads." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowLineLoad ?selectedQuantity .
                ?selectedQuantity qudt:numericValue ?selected .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionCalculatedLineLoad ?caseQuantity .
                    ?caseQuantity qudt:numericValue ?value .
                    FILTER (?value = ?selected)
                }
            }
        """
    ] ;

    sh:sparql [
        sh:message "The selected maximum bow pressure must be at least as large as every sub-region calculated pressure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowPressure ?selectedQuantity ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?selectedQuantity qudt:numericValue ?selected .
                ?case nltl:bowSubregionCalculatedPressure ?caseQuantity .
                ?caseQuantity qudt:numericValue ?value .
                FILTER (?value > ?selected)
            }
        """
    ] ;

    sh:sparql [
        sh:message "The selected maximum bow pressure must equal one of the four sub-region calculated pressures." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowPressure ?selectedQuantity .
                ?selectedQuantity qudt:numericValue ?selected .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionCalculatedPressure ?caseQuantity .
                    ?caseQuantity qudt:numericValue ?value .
                    FILTER (?value = ?selected)
                }
            }
        """
    ] .
