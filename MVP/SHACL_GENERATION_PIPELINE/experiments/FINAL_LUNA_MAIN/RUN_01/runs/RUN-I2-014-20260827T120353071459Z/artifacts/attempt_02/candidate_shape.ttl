@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-014-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node nltl:I2_014_BowSubregionCalculationCaseShape
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Each bow subregion case must use a distinct midpoint at one of the four equal-length subdivision positions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength/qudt:numericValue ?length ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowSubregionMidLengthPosition/qudt:numericValue ?position .
                FILTER (
                    (?position != (?length / 8)) &&
                    (?position != (3 * ?length / 8)) &&
                    (?position != (5 * ?length / 8)) &&
                    (?position != (7 * ?length / 8))
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The four bow subregion cases must have one-to-one midpoint positions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?case1 ;
                      nltl:hasBowSubregionCalculationCase ?case2 .
                FILTER (?case1 != ?case2)
                ?case1 nltl:bowSubregionMidLengthPosition/qudt:numericValue ?position1 .
                ?case2 nltl:bowSubregionMidLengthPosition/qudt:numericValue ?position2 .
                FILTER (?position1 = ?position2)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Selected maximum bow force must be at least every reported subregion force." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce/qudt:numericValue ?selected ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowSubregionCalculatedForce/qudt:numericValue ?reported .
                FILTER (?reported > ?selected)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Selected maximum bow line load must be at least every reported subregion line load." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowLineLoad/qudt:numericValue ?selected ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowSubregionCalculatedLineLoad/qudt:numericValue ?reported .
                FILTER (?reported > ?selected)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Selected maximum bow pressure must be at least every reported subregion pressure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowPressure/qudt:numericValue ?selected ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowSubregionCalculatedPressure/qudt:numericValue ?reported .
                FILTER (?reported > ?selected)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Selected maximum bow force must equal the reported maximum within tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce/qudt:numericValue ?selected ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowSubregionCalculatedForce/qudt:numericValue ?expected .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?higherCase .
                    ?higherCase nltl:bowSubregionCalculatedForce/qudt:numericValue ?higher .
                    FILTER (?higher > ?expected)
                }
                FILTER (ABS(?selected - ?expected) >
                    (ABS(?expected) * 0.000001 + 0.000000001))
            }
        """
    ] ;
    sh:sparql [
        sh:message "Selected maximum bow line load must equal the reported maximum within tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowLineLoad/qudt:numericValue ?selected ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowSubregionCalculatedLineLoad/qudt:numericValue ?expected .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?higherCase .
                    ?higherCase nltl:bowSubregionCalculatedLineLoad/qudt:numericValue ?higher .
                    FILTER (?higher > ?expected)
                }
                FILTER (ABS(?selected - ?expected) >
                    (ABS(?expected) * 0.000001 + 0.000000001))
            }
        """
    ] ;
    sh:sparql [
        sh:message "Selected maximum bow pressure must equal the reported maximum within tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowPressure/qudt:numericValue ?selected ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowSubregionCalculatedPressure/qudt:numericValue ?expected .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?higherCase .
                    ?higherCase nltl:bowSubregionCalculatedPressure/qudt:numericValue ?higher .
                    FILTER (?higher > ?expected)
                }
                FILTER (ABS(?selected - ?expected) >
                    (ABS(?expected) * 0.000001 + 0.000000001))
            }
        """
    ] .

nltl:I2_014_BowSubregionCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculationEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ]
    ] .
