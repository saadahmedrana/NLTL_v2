@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:BowSubregionQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BowSubregionCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:node gen:BowSubregionQuantityShape ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:node gen:BowSubregionQuantityShape ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:node gen:BowSubregionQuantityShape ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:node gen:BowSubregionQuantityShape ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:node gen:BowSubregionQuantityShape ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculationEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ]
    ] .

gen:I2_014_BowSubregionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:node gen:BowSubregionQuantityShape ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node gen:BowSubregionCaseShape
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:node gen:BowSubregionQuantityShape ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:node gen:BowSubregionQuantityShape ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:node gen:BowSubregionQuantityShape ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The four bow subregion cases must have distinct mid-length positions at one-eighth, three-eighths, five-eighths, and seven-eighths of bowLength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength ?lengthQuantity ;
                      nltl:hasBowSubregionCalculationCase ?case1 .
                ?lengthQuantity qudt:numericValue ?length .
                ?case1 nltl:bowSubregionMidLengthPosition ?midQuantity1 .
                ?midQuantity1 qudt:numericValue ?mid1 .
                FILTER(
                    (
                        ?mid1 != (?length / 8) &&
                        ?mid1 != (3 * ?length / 8) &&
                        ?mid1 != (5 * ?length / 8) &&
                        ?mid1 != (7 * ?length / 8)
                    )
                    ||
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case2 .
                        ?case2 nltl:bowSubregionMidLengthPosition ?midQuantity2 .
                        ?midQuantity2 qudt:numericValue ?mid2 .
                        FILTER(?case2 != ?case1 && ?mid2 = ?mid1)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowForce must equal the maximum reported bow subregion force within tolerance and must not be below any reported case force." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedQuantity .
                ?selectedQuantity qudt:numericValue ?selected .
                {
                    SELECT ?ship (MAX(?caseValue) AS ?maximum)
                    WHERE {
                        ?ship nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedForce ?caseQuantity .
                        ?caseQuantity qudt:numericValue ?caseValue .
                    }
                    GROUP BY ?ship
                }
                FILTER(?ship = $this)
                FILTER(
                    (
                        ABS(?selected - ?maximum) >
                        (ABS(?maximum) * 0.000001 + 0.000000001)
                    )
                    ||
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case2 .
                        ?case2 nltl:bowSubregionCalculatedForce ?caseQuantity2 .
                        ?caseQuantity2 qudt:numericValue ?caseValue2 .
                        FILTER(?caseValue2 > ?selected)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowLineLoad must equal the maximum reported bow subregion line load within tolerance and must not be below any reported case line load." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowLineLoad ?selectedQuantity .
                ?selectedQuantity qudt:numericValue ?selected .
                {
                    SELECT ?ship (MAX(?caseValue) AS ?maximum)
                    WHERE {
                        ?ship nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedLineLoad ?caseQuantity .
                        ?caseQuantity qudt:numericValue ?caseValue .
                    }
                    GROUP BY ?ship
                }
                FILTER(?ship = $this)
                FILTER(
                    (
                        ABS(?selected - ?maximum) >
                        (ABS(?maximum) * 0.000001 + 0.000000001)
                    )
                    ||
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case2 .
                        ?case2 nltl:bowSubregionCalculatedLineLoad ?caseQuantity2 .
                        ?caseQuantity2 qudt:numericValue ?caseValue2 .
                        FILTER(?caseValue2 > ?selected)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowPressure must equal the maximum reported bow subregion pressure within tolerance and must not be below any reported case pressure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowPressure ?selectedQuantity .
                ?selectedQuantity qudt:numericValue ?selected .
                {
                    SELECT ?ship (MAX(?caseValue) AS ?maximum)
                    WHERE {
                        ?ship nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedPressure ?caseQuantity .
                        ?caseQuantity qudt:numericValue ?caseValue .
                    }
                    GROUP BY ?ship
                }
                FILTER(?ship = $this)
                FILTER(
                    (
                        ABS(?selected - ?maximum) >
                        (ABS(?maximum) * 0.000001 + 0.000000001)
                    )
                    ||
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case2 .
                        ?case2 nltl:bowSubregionCalculatedPressure ?caseQuantity2 .
                        ?caseQuantity2 qudt:numericValue ?caseValue2 .
                        FILTER(?caseValue2 > ?selected)
                    }
                )
            }
        """
    ] .
