@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_014_BowAreaShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node [
            sh:class nltl:bowSubregionCalculationCase ;
            sh:property [
                sh:path nltl:bowSubregionMidLengthPosition ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionAspectRatio ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionCalculatedForce ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionCalculatedLineLoad ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN-M-PER-M2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionCalculatedPressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaPA ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionCalculationEvidence ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:evidenceArtifact
                ]
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Each bow subregion midpoint must be one of the four equal-subdivision midpoints derived from bowLength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength ?blq ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?blq qudt:numericValue ?bl .
                ?case nltl:bowSubregionMidLengthPosition ?mpq .
                ?mpq qudt:numericValue ?mp .
                FILTER (
                    ?mp != (?bl / 8) &&
                    ?mp != (3 * ?bl / 8) &&
                    ?mp != (5 * ?bl / 8) &&
                    ?mp != (7 * ?bl / 8)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The four bow subregion cases must have distinct midpoint positions, establishing one-to-one pairing with the four equal subdivisions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?case1 ;
                      nltl:hasBowSubregionCalculationCase ?case2 .
                FILTER (?case1 != ?case2)
                ?case1 nltl:bowSubregionMidLengthPosition ?mpq1 .
                ?case2 nltl:bowSubregionMidLengthPosition ?mpq2 .
                ?mpq1 qudt:numericValue ?mp1 .
                ?mpq2 qudt:numericValue ?mp2 .
                FILTER (?mp1 = ?mp2)
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowForce must be at least every reported bow subregion force and must equal the expected maximum within a relative tolerance of 1e-6 with a small absolute fallback." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?sq ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?sq qudt:numericValue ?sv .
                ?case nltl:bowSubregionCalculatedForce ?fq .
                ?fq qudt:numericValue ?fv .
                {
                    SELECT $this (MAX(?v) AS ?expected)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?c .
                        ?c nltl:bowSubregionCalculatedForce ?q .
                        ?q qudt:numericValue ?v .
                    }
                    GROUP BY $this
                }
                FILTER (
                    ?sv < ?fv ||
                    ABS(?sv - ?expected) >
                    IF(ABS(?expected) > "0.001"^^xsd:decimal,
                       "0.000001"^^xsd:decimal * ABS(?expected),
                       "0.000001"^^xsd:decimal)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowLineLoad must be at least every reported bow subregion line load and must equal the expected maximum within a relative tolerance of 1e-6 with a small absolute fallback." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowLineLoad ?sq ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?sq qudt:numericValue ?sv .
                ?case nltl:bowSubregionCalculatedLineLoad ?fq .
                ?fq qudt:numericValue ?fv .
                {
                    SELECT $this (MAX(?v) AS ?expected)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?c .
                        ?c nltl:bowSubregionCalculatedLineLoad ?q .
                        ?q qudt:numericValue ?v .
                    }
                    GROUP BY $this
                }
                FILTER (
                    ?sv < ?fv ||
                    ABS(?sv - ?expected) >
                    IF(ABS(?expected) > "0.001"^^xsd:decimal,
                       "0.000001"^^xsd:decimal * ABS(?expected),
                       "0.000001"^^xsd:decimal)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowPressure must be at least every reported bow subregion pressure and must equal the expected maximum within a relative tolerance of 1e-6 with a small absolute fallback." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowPressure ?sq ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?sq qudt:numericValue ?sv .
                ?case nltl:bowSubregionCalculatedPressure ?fq .
                ?fq qudt:numericValue ?fv .
                {
                    SELECT $this (MAX(?v) AS ?expected)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?c .
                        ?c nltl:bowSubregionCalculatedPressure ?q .
                        ?q qudt:numericValue ?v .
                    }
                    GROUP BY $this
                }
                FILTER (
                    ?sv < ?fv ||
                    ABS(?sv - ?expected) >
                    IF(ABS(?expected) > "0.001"^^xsd:decimal,
                       "0.000001"^^xsd:decimal * ABS(?expected),
                       "0.000001"^^xsd:decimal)
                )
            }
        """
    ] .
