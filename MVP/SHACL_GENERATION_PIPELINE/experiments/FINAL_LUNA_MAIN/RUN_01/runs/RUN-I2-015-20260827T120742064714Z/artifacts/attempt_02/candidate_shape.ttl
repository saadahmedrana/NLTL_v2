@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:LengthMetresQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AngleDegreesQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:node gen:BowSubregionCalculationCaseShape
    ] .

gen:BowSubregionCalculationCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowFormApplicabilityClassification ;
        sh:hasValue nltl:i231vBowFormApplicability ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An applicable bow subregion calculation case must identify the I2.3.1(v) bow form."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:node gen:LengthMetresQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The bow subregion calculation case must provide x in metres."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:node gen:LengthMetresQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The bow subregion calculation case must provide L_UI in metres."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraughtDUI ;
        sh:node gen:LengthMetresQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The bow subregion calculation case must provide D_UI in metres."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionWaterlineAngle ;
        sh:node gen:AngleDegreesQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The bow subregion calculation case must provide alpha_i in degrees."
    ] ;
    sh:property [
        sh:path nltl:betaIPrime ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The bow subregion calculation case must provide beta_i_prime as a dimensionless quantity."
    ] ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The externally calculated f_ai result must be provided as a dimensionless quantity."
    ] ;
    sh:property [
        sh:path nltl:hasFailureClassFactorLookupCase ;
        sh:node gen:FailureClassFactorLookupCaseShape ;
        sh:minCount 1 ;
        sh:message "The applicable bow subregion calculation case must provide its failure-class factor lookup case."
    ] .

gen:FailureClassFactorLookupCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The failure-class lookup case must provide C_FF as a dimensionless quantity."
    ] ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The failure-class lookup case must provide C_FC as a dimensionless quantity."
    ] .
