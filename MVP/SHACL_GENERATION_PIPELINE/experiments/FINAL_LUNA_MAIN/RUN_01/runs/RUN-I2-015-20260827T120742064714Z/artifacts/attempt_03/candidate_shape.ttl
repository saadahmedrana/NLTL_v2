@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_015_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:class nltl:bowSubregionCalculationCase ;
        sh:node gen:I2_015_ConditionalCaseShape
    ] ;
    sh:sparql [
        sh:message "For an I2.3.1(v) bow form, the ship shall provide exactly one valid upper ice waterline length, upper ice waterline draught, and beta i prime quantity with the declared units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowFormApplicabilityClassification nltl:i231vBowFormApplicability .
                FILTER (
                    NOT EXISTS {
                        $this nltl:upperIceWaterlineLengthLUI ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (datatype(?v) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        $this nltl:upperIceWaterlineLengthLUI ?q1 .
                        $this nltl:upperIceWaterlineLengthLUI ?q2 .
                        FILTER (?q1 != ?q2)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:upperIceWaterlineDraughtDUI ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (datatype(?v) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        $this nltl:upperIceWaterlineDraughtDUI ?q1 .
                        $this nltl:upperIceWaterlineDraughtDUI ?q2 .
                        FILTER (?q1 != ?q2)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:betaIPrime ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (datatype(?v) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        $this nltl:betaIPrime ?q1 .
                        $this nltl:betaIPrime ?q2 .
                        FILTER (?q1 != ?q2)
                    }
                )
            }
        """
    ] .

gen:I2_015_ConditionalCaseShape
    a sh:NodeShape ;
    sh:or (
        gen:I2_015_ApplicableCaseShape
        gen:I2_015_NonApplicableCaseShape
    ) .

gen:I2_015_ApplicableCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowFormApplicabilityClassification ;
        sh:hasValue nltl:i231vBowFormApplicability ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionWaterlineAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasFailureClassFactorLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:minCount 1 ;
        sh:node gen:I2_015_LookupCaseShape
    ] .

gen:I2_015_NonApplicableCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowFormApplicabilityClassification ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_015_LookupCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
