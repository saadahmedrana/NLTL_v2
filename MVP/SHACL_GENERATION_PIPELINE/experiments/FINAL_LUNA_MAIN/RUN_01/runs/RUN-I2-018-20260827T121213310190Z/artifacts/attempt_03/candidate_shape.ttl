@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_018_QuantityPressureShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_018_QuantityForceShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_018_QuantityLengthShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_018_QuantityDimensionlessShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_018_IceLoadPatchShape
    a sh:NodeShape ;
    sh:class nltl:iceLoadPatch .

gen:I2_018_LookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:class nltl:peakPressureFactorLookupCase ;
    sh:property [
        sh:path nltl:localizedStructuralMemberCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:bottomStructureFrameCategory
            nltl:longitudinallyFramedPlatingCategory
            nltl:stringerSideLongitudinalOrWebFrameCategory
            nltl:transverseFrameWithLoadDistributingStringersCategory
            nltl:transverseFrameWithoutLoadDistributingStringersCategory
            nltl:transverselyFramedPlatingCategory
        )
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:iacsUrI2Table3
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:evidenceArtifact
    ] ;
    sh:property [
        sh:path nltl:selectedPeakPressureFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_018_QuantityDimensionlessShape
    ] .

gen:I2_018_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceLoadPatch ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_018_IceLoadPatchShape
    ] ;
    sh:property [
        sh:path nltl:hasPeakPressureFactorLookupCase ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_018_LookupCaseShape
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_018_LookupCaseShape
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_018_QuantityPressureShape
    ] ;
    sh:property [
        sh:path nltl:iceForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_018_QuantityForceShape
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_018_QuantityLengthShape
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_018_QuantityLengthShape
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_018_QuantityDimensionlessShape
    ] ;
    sh:sparql [
        sh:message "The peak-pressure-factor lookup case and table lookup case must be the same node." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:hasPeakPressureFactorLookupCase ?peakCase ;
                      nltl:hasTableLookupCase ?tableCase .
                FILTER (?peakCase != ?tableCase)
            }
        """
    ] ;
    sh:sparql [
        sh:message "averageIcePressure must equal iceForce divided by loadPatchHeight and loadPatchLength, with a tolerance of 1e-6 relative and 1e-6 MPa absolute." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceForce ?forceNode ;
                      nltl:loadPatchHeight ?heightNode ;
                      nltl:loadPatchLength ?lengthNode ;
                      nltl:averageIcePressure ?averageNode .

                ?forceNode qudt:numericValue ?force .
                ?heightNode qudt:numericValue ?height .
                ?lengthNode qudt:numericValue ?length .
                ?averageNode qudt:numericValue ?actual .

                BIND ((?force / (?height * ?length)) / 1000 AS ?expected)
                FILTER (
                    ABS(?actual - ?expected) >
                    (ABS(?expected) * 0.000001 + 0.000001)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "peakPressureFactor must equal the selected peak pressure factor from the shared Table 3 lookup case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasPeakPressureFactorLookupCase ?lookupCase ;
                      nltl:peakPressureFactor ?shipFactorNode .

                ?lookupCase nltl:selectedPeakPressureFactor ?selectedFactorNode .
                ?shipFactorNode qudt:numericValue ?shipFactor .
                ?selectedFactorNode qudt:numericValue ?selectedFactor .

                FILTER (
                    ABS(?shipFactor - ?selectedFactor) >
                    (ABS(?selectedFactor) * 0.000001 + 0.000001)
                )
            }
        """
    ] .
