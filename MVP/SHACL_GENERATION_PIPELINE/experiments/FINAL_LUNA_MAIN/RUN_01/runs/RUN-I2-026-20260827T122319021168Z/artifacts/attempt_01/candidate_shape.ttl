@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_026_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:I2_026_StructuralMemberShape ;
        sh:message "Each represented structural member must have a conforming support model."
    ] .

gen:I2_026_StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasMemberSupport ;
        sh:minCount 1 ;
        sh:node gen:I2_026_MemberSupportShape ;
        sh:message "A represented structural member must identify its support."
    ] ;
    sh:property [
        sh:path nltl:continuousThroughSupport ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:terminatesWithinIceStrengthenedArea ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Support fixity must be fixed for continuous members, members with a connection bracket, members with demonstrated rotational restraint, and members terminating within an ice-strengthened area; demonstrated rotational restraint also requires evidence." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasMemberSupport ?support .
                ?support nltl:frameSupportCondition ?condition .

                FILTER (
                    (
                        EXISTS {
                            $this nltl:terminatesWithinIceStrengthenedArea true
                        }
                        && ?condition != nltl:fixedFrameSupport
                    )
                    ||
                    (
                        EXISTS {
                            $this nltl:continuousThroughSupport true
                        }
                        && ?condition != nltl:fixedFrameSupport
                    )
                    ||
                    (
                        EXISTS {
                            ?support nltl:connectionBracketPresent true
                        }
                        && ?condition != nltl:fixedFrameSupport
                    )
                    ||
                    (
                        EXISTS {
                            ?support nltl:demonstratedRotationalRestraint true
                        }
                        &&
                        (
                            ?condition != nltl:fixedFrameSupport
                            ||
                            NOT EXISTS {
                                $this nltl:significantRotationalRestraintEvidence ?evidence .
                            }
                        )
                    )
                )
            }
        """
    ] .

gen:I2_026_MemberSupportShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSupportCondition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:fixedFrameSupport
            nltl:simpleFrameSupport
        ) ;
        sh:message "A member support must specify either fixed support or simple support."
    ] ;
    sh:property [
        sh:path nltl:connectionBracketPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:demonstratedRotationalRestraint ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:significantRotationalRestraintEvidence ;
        sh:class nltl:evidenceArtifact
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:frameSupportCondition ;
                sh:hasValue nltl:fixedFrameSupport
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameSupportCondition ;
                sh:hasValue nltl:simpleFrameSupport
            ]
        ]
    ) .
