@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_026_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gen:I2_026_StructuralMemberShape
    ] .

gen:I2_026_StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasMemberSupport ;
        sh:minCount 1 ;
        sh:class nltl:memberSupport ;
        sh:node gen:I2_026_MemberSupportShape ;
        sh:message "Each structural member must identify its member support."
    ] ;
    sh:property [
        sh:path nltl:frameSupportCondition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:frameSupportConditionValue ;
        sh:in (
            nltl:fixedFrameSupport
            nltl:simpleFrameSupport
        ) ;
        sh:message "The structural member must identify exactly one permitted frame support condition."
    ] ;
    sh:property [
        sh:path nltl:continuousThroughSupport ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:terminatesWithinIceStrengthenedArea ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:significantRotationalRestraintEvidence ;
        sh:class nltl:evidenceArtifact
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A structural member requiring fixity must have fixed frame support." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  FILTER (
    (
      EXISTS {
        $this nltl:continuousThroughSupport true .
      }
      ||
      EXISTS {
        $this nltl:terminatesWithinIceStrengthenedArea true .
      }
      ||
      EXISTS {
        $this nltl:hasMemberSupport ?support .
        ?support nltl:connectionBracketPresent true .
      }
      ||
      EXISTS {
        $this nltl:significantRotationalRestraintEvidence ?evidence .
      }
    )
    &&
    NOT EXISTS {
      $this nltl:frameSupportCondition nltl:fixedFrameSupport .
    }
  )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A structural member without a fixity condition must have simple frame support." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  FILTER (
    NOT EXISTS {
      $this nltl:continuousThroughSupport true .
    }
    &&
    NOT EXISTS {
      $this nltl:terminatesWithinIceStrengthenedArea true .
    }
    &&
    NOT EXISTS {
      $this nltl:hasMemberSupport ?support .
      ?support nltl:connectionBracketPresent true .
    }
    &&
    NOT EXISTS {
      $this nltl:significantRotationalRestraintEvidence ?evidence .
    }
    &&
    NOT EXISTS {
      $this nltl:frameSupportCondition nltl:simpleFrameSupport .
    }
  )
}
"""
    ] .

gen:I2_026_MemberSupportShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:connectionBracketPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:demonstratedRotationalRestraint ;
        sh:datatype xsd:boolean
    ] .
