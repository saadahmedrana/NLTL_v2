@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_030_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node gs:I2_030_CalculationCaseShape
    ] .

gs:I2_030_CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_030_StructuralMemberShape
    ] ;
    sh:property [
        sh:path nltl:plasticNeutralAxisHeight ;
        sh:node gs:I2_030_PlasticNeutralAxisQuantityShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When 100*A_fn exceeds 1000*t_pn*s, the calculation case shall provide plastic neutral axis height." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCaseStructuralMember ?member .
                ?member nltl:netLocalFrameFlangeArea ?aNode ;
                        nltl:netAttachedShellPlateThickness ?tNode ;
                        nltl:frameSpacing ?sNode .
                ?aNode qudt:numericValue ?a ;
                       qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
                ?tNode qudt:numericValue ?t ;
                       qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                ?sNode qudt:numericValue ?s ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER(
                    datatype(?a) = xsd:decimal &&
                    datatype(?t) = xsd:decimal &&
                    datatype(?s) = xsd:decimal &&
                    100 * ?a > 1000 * ?t * ?s
                )
                FILTER NOT EXISTS {
                    $this nltl:plasticNeutralAxisHeight ?zNode .
                    ?zNode qudt:numericValue ?z ;
                           qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    FILTER(datatype(?z) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For oblique framing with 20 < Omega < 70 degrees, the calculation case shall provide paired lower and upper interpolation points with coordinates and results." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCaseStructuralMember ?member .
                ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                ?localCase nltl:sectionCalculationCasePlating ?plating .
                ?plating nltl:framingAngleOmega ?omegaNode .
                ?omegaNode qudt:numericValue ?omega ;
                           qudt:unit <http://qudt.org/vocab/unit/DEG> .
                FILTER(
                    datatype(?omega) = xsd:decimal &&
                    ?omega > 20 &&
                    ?omega < 70
                )
                FILTER NOT EXISTS {
                    $this nltl:interpolationLowerEndpoint ?lower ;
                          nltl:interpolationUpperEndpoint ?upper .
                    ?lower rdf:type nltl:interpolationPoint ;
                           nltl:interpolationPointCoordinate ?lowerCoordinate ;
                           nltl:interpolationPointResult ?lowerResult .
                    ?upper rdf:type nltl:interpolationPoint ;
                           nltl:interpolationPointCoordinate ?upperCoordinate ;
                           nltl:interpolationPointResult ?upperResult .
                    ?lowerCoordinate qudt:numericValue ?lowerX ;
                                      qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    ?upperCoordinate qudt:numericValue ?upperX ;
                                      qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    ?lowerResult qudt:numericValue ?lowerY .
                    ?upperResult qudt:numericValue ?upperY .
                    FILTER(
                        datatype(?lowerX) = xsd:decimal &&
                        datatype(?upperX) = xsd:decimal &&
                        datatype(?lowerY) = xsd:decimal &&
                        datatype(?upperY) = xsd:decimal
                    )
                }
            }
        """
    ] .

gs:I2_030_StructuralMemberShape
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:netLocalFrameFlangeArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_030_AreaQuantityShape
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_030_MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_030_MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_030_MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_030_MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:localFrameFlangeCentreHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_030_MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webToFlangeCentreDistance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_030_MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:netEffectivePlasticSectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_030_SectionModulusQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasLocalFrameSectionCalculationCase ;
        sh:minCount 1 ;
        sh:node gs:I2_030_LocalFrameSectionCalculationCaseShape
    ] .

gs:I2_030_LocalFrameSectionCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:localFrameSectionCalculationCase ;
    sh:property [
        sh:path nltl:sectionCalculationCasePlating ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_030_PlatingShape
    ] ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:minCount 1 ;
        sh:node gs:I2_030_StructuralMemberShape
    ] .

gs:I2_030_PlatingShape
    a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_030_AngleQuantityShape
    ] .

gs:I2_030_AreaQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_030_MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_030_MillimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_030_AngleQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_030_SectionModulusQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_030_PlasticNeutralAxisQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
