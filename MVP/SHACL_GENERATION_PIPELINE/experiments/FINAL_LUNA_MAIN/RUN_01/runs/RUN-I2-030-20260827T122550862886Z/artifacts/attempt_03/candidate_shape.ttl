@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gs: <urn:nltl:generated-shape:> .

gs:QuantityValueDecimalM
    a sh:NodeShape ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:QuantityValueDecimalMilliM
    a sh:NodeShape ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:QuantityValueDecimalCentiM2
    a sh:NodeShape ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:QuantityValueDecimalDEG
    a sh:NodeShape ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:QuantityValueDecimalCentiM3
    a sh:NodeShape ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:QuantityValueDecimalUnitless
    a sh:NodeShape ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:PlatingShape
    a sh:NodeShape ;
    sh:targetClass nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:node gs:QuantityValueDecimalDEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:InterpolationPointShape
    a sh:NodeShape ;
    sh:targetClass nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:node gs:QuantityValueDecimalUnitless ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:class q:QuantityValue ;
        sh:minCount 1
    ] .

gs:LocalFrameSectionCalculationCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:localFrameSectionCalculationCase ;
    sh:property [
        sh:path nltl:sectionCalculationCasePlating ;
        sh:class nltl:plating ;
        sh:node gs:PlatingShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:minCount 1
    ] .

gs:StructuralMemberShape
    a sh:NodeShape ;
    sh:targetClass nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:node gs:QuantityValueDecimalM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:localFrameFlangeCentreHeight ;
        sh:node gs:QuantityValueDecimalMilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:node gs:QuantityValueDecimalMilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:netLocalFrameFlangeArea ;
        sh:node gs:QuantityValueDecimalCentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:node gs:QuantityValueDecimalMilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:webAngleToShellPlate ;
        sh:node gs:QuantityValueDecimalDEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:node gs:QuantityValueDecimalMilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:webToFlangeCentreDistance ;
        sh:node gs:QuantityValueDecimalMilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasLocalFrameSectionCalculationCase ;
        sh:class nltl:localFrameSectionCalculationCase ;
        sh:node gs:LocalFrameSectionCalculationCaseShape ;
        sh:minCount 1
    ] .

gs:CalculationCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:calculationCase ;
    sh:property [
        sh:path nltl:netEffectivePlasticSectionModulus ;
        sh:node gs:QuantityValueDecimalCentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:plasticNeutralAxisHeight ;
        sh:node gs:QuantityValueDecimalMilliM ;
        sh:maxCount 1
    ] .

gs:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gs:StructuralMemberShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:class nltl:plating ;
        sh:node gs:PlatingShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:node gs:CalculationCaseShape ;
        sh:minCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The applicable area branch requires a plastic neutral axis result; an oblique framing branch requires paired lower and upper interpolation points with coordinates and results." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX q: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this a nltl:ship ;
        nltl:hasCalculationCase ?cc ;
        nltl:hasStructuralMember ?sm .
  ?sm nltl:netLocalFrameFlangeArea ?area ;
      nltl:netAttachedShellPlateThickness ?thickness ;
      nltl:frameSpacing ?spacing ;
      nltl:hasLocalFrameSectionCalculationCase ?localCase .
  ?localCase nltl:sectionCalculationCasePlating ?plating .
  ?plating nltl:framingAngleOmega ?angle .
  ?area q:numericValue ?areaValue .
  ?thickness q:numericValue ?thicknessValue .
  ?spacing q:numericValue ?spacingValue .
  ?angle q:numericValue ?angleValue .
  BIND((100 * ?areaValue) > (1000 * ?thicknessValue * ?spacingValue) AS ?areaExceeds)
  BIND((20 < ?angleValue) && (?angleValue < 70) AS ?oblique)
  FILTER(
    (?areaExceeds &&
      NOT EXISTS {
        ?cc nltl:plasticNeutralAxisHeight ?pna .
        ?pna q:numericValue ?pnaValue ;
             q:unit <http://qudt.org/vocab/unit/MilliM> .
        FILTER(datatype(?pnaValue) = xsd:decimal)
      })
    ||
    (?oblique &&
      (
        NOT EXISTS {
          ?cc nltl:interpolationLowerEndpoint ?lower .
          ?lower a nltl:interpolationPoint ;
                 nltl:interpolationPointCoordinate ?lowerCoordinate ;
                 nltl:interpolationPointResult ?lowerResult .
          ?lowerCoordinate q:numericValue ?lowerCoordinateValue ;
                            q:unit <http://qudt.org/vocab/unit/UNITLESS> .
          ?lowerResult q:numericValue ?lowerResultValue .
          FILTER(datatype(?lowerCoordinateValue) = xsd:decimal)
          FILTER(datatype(?lowerResultValue) = xsd:decimal)
        }
        ||
        NOT EXISTS {
          ?cc nltl:interpolationUpperEndpoint ?upper .
          ?upper a nltl:interpolationPoint ;
                 nltl:interpolationPointCoordinate ?upperCoordinate ;
                 nltl:interpolationPointResult ?upperResult .
          ?upperCoordinate q:numericValue ?upperCoordinateValue ;
                            q:unit <http://qudt.org/vocab/unit/UNITLESS> .
          ?upperResult q:numericValue ?upperResultValue .
          FILTER(datatype(?upperCoordinateValue) = xsd:decimal)
          FILTER(datatype(?upperResultValue) = xsd:decimal)
        }
      )
    )
  )
}
"""
    ] .
