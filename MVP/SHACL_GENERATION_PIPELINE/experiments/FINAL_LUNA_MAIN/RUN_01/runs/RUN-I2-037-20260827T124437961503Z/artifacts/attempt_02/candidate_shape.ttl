@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-037> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceLoadPatch ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:iceLoadPatch
        ] ;
        sh:message "The ship must identify the ice load patch used by the design."
    ] ;
    sh:property [
        sh:path nltl:hasIceLoadPatchDesignCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:iceLoadPatchDesignCase ;
            sh:property [
                sh:path nltl:memberCapacityMinimizationConfirmed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The ice-load-patch design case must confirm capacity minimization."
            ]
        ] ;
        sh:message "The ship must provide an ice-load-patch design case."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node [
            sh:class nltl:structuralMember ;
            sh:property [
                sh:path nltl:hasStructuralMemberLoadCase ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:loadCase ;
                    sh:property [
                        sh:path nltl:combinedShearBendingEffect ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "The structural-member load case must represent the combined bending and shear effects."
                    ] ;
                    sh:property [
                        sh:path nltl:loadPatchApplicationLocation ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "The structural-member load case must identify the load-patch application location."
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:memberCapacity ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:KiloN ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "Each structural member must provide its capacity in kilonewtons."
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "At least one represented structural-member load-case location must have minimum capacity under the combined bending and shear load cases." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasStructuralMember ?m0 .
                    ?m0 nltl:hasStructuralMemberLoadCase ?lc0 .
                    ?lc0 nltl:combinedShearBendingEffect ?effect0 ;
                         nltl:loadPatchApplicationLocation ?location0 .
                    ?m0 nltl:memberCapacity ?capacity0 .
                    ?capacity0 qudt:numericValue ?value0 ;
                              qudt:unit unit:KiloN .
                    FILTER NOT EXISTS {
                        $this nltl:hasStructuralMember ?m1 .
                        ?m1 nltl:hasStructuralMemberLoadCase ?lc1 .
                        ?lc1 nltl:combinedShearBendingEffect ?effect1 ;
                             nltl:loadPatchApplicationLocation ?location1 .
                        ?m1 nltl:memberCapacity ?capacity1 .
                        ?capacity1 qudt:numericValue ?value1 ;
                                  qudt:unit unit:KiloN .
                        FILTER ( ?value1 < ?value0 )
                    }
                }
            }
        """
    ] .
