@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_046_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClassRequirementsApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        gs:I2_046_ApplicableBranch
        gs:I2_046_NonApplicableBranch
    ) ;
    sh:property [
        sh:path nltl:hasInternalIceStrengthenedStructure ;
        sh:node gs:I2_046_InternalStructureShape
    ] .

gs:I2_046_ApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClassRequirementsApplicable ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:class nltl:polarClassValue ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An applicable ship must provide exactly one valid Polar Class."
    ] .

gs:I2_046_NonApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClassRequirementsApplicable ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:maxCount 0 ;
        sh:message "A ship declaring the Polar Class requirement non-applicable must not provide a Polar Class."
    ] .

gs:I2_046_InternalStructureShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:internalStructureCorrosionAbrasionAddition ;
        sh:node gs:I2_046_AdditionQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each linked internal ice-strengthened structure must have exactly one corrosion/abrasion addition."
    ] .

gs:I2_046_AdditionQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1.0"^^xsd:decimal ;
        sh:message "The internal-structure corrosion/abrasion addition must be at least 1.0 mm."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The corrosion/abrasion addition must use exactly the millimetre unit."
    ] .
