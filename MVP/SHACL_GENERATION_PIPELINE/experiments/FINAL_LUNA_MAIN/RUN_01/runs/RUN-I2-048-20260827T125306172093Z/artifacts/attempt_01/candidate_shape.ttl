@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-048-ship>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        )
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeRequirementCase ;
        sh:node <urn:nltl:generated-shape:I2-048-case>
    ] .

<urn:nltl:generated-shape:I2-048-case>
    a sh:NodeShape ;
    sh:targetClass nltl:steelGradeRequirementCase ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:in (
            nltl:normalStrengthSteelCategory
            nltl:highTensileSteelCategory
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeDh
            nltl:steelGradeE
            nltl:steelGradeEh
            nltl:steelGradeFh
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeDh
            nltl:steelGradeE
            nltl:steelGradeEh
            nltl:steelGradeFh
        )
    ] ;
    sh:sparql [
        sh:message "The requirement case must be linked to a ship with a valid Polar Class." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    ?ship nltl:hasSteelGradeRequirementCase $this .
                    ?ship nltl:polarClass ?pc .
                    FILTER (?pc IN (
                        nltl:polarClassPc1,
                        nltl:polarClassPc2,
                        nltl:polarClassPc3,
                        nltl:polarClassPc4,
                        nltl:polarClassPc5,
                        nltl:polarClassPc6,
                        nltl:polarClassPc7
                    ))
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The actual steel grade must meet or exceed the Table 8 grade for the same strength category and selected case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                ?ship nltl:hasSteelGradeRequirementCase $this .
                ?ship nltl:polarClass ?pc .
                $this nltl:asBuiltPlateThickness ?thicknessNode .
                ?thicknessNode qudt:numericValue ?thickness .
                $this nltl:steelMaterialClass ?material .
                $this nltl:steelStrengthCategory ?category .
                $this nltl:actualHullStructuralSteelGrade ?actual .
                ?actual nltl:steelGradeOrderRank ?actualRank .

                BIND (
                    (
                        (?thickness > 35.0 && ?thickness <= 40.0 &&
                         ?material = nltl:steelMaterialClassThree &&
                         ?category = nltl:normalStrengthSteelCategory &&
                         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3))
                        ||
                        (?thickness > 40.0 && ?thickness <= 50.0 &&
                         ?material = nltl:steelMaterialClassThree &&
                         ?category = nltl:normalStrengthSteelCategory &&
                         ?pc IN (
                            nltl:polarClassPc1,
                            nltl:polarClassPc2,
                            nltl:polarClassPc3,
                            nltl:polarClassPc4,
                            nltl:polarClassPc5
                         ))
                    ) AS ?notApplicable
                ) .

                BIND (
                    IF(
                        ?thickness <= 10.0,
                        IF(
                            ?material = nltl:steelMaterialClassThree &&
                            ?pc IN (
                                nltl:polarClassPc1,
                                nltl:polarClassPc2,
                                nltl:polarClassPc3,
                                nltl:polarClassPc4,
                                nltl:polarClassPc5
                            ),
                            3,
                            1
                        ),
                        IF(
                            ?thickness <= 15.0,
                            IF(
                                ?material = nltl:steelMaterialClassOne,
                                1,
                                IF(
                                    ?material = nltl:steelMaterialClassTwo &&
                                    ?pc IN (
                                        nltl:polarClassPc1,
                                        nltl:polarClassPc2,
                                        nltl:polarClassPc3,
                                        nltl:polarClassPc4,
                                        nltl:polarClassPc5
                                    ),
                                    2,
                                    IF(
                                        ?material = nltl:steelMaterialClassThree &&
                                        ?pc IN (
                                            nltl:polarClassPc1,
                                            nltl:polarClassPc2,
                                            nltl:polarClassPc3,
                                            nltl:polarClassPc4,
                                            nltl:polarClassPc5
                                        ),
                                        3,
                                        2
                                    )
                                )
                            ),
                            IF(
                                ?thickness <= 25.0,
                                IF(
                                    ?pc IN (
                                        nltl:polarClassPc1,
                                        nltl:polarClassPc2,
                                        nltl:polarClassPc3,
                                        nltl:polarClassPc4,
                                        nltl:polarClassPc5
                                    ),
                                    IF(
                                        ?material = nltl:steelMaterialClassThree,
                                        3,
                                        2
                                    ),
                                    IF(
                                        ?material = nltl:steelMaterialClassThree,
                                        2,
                                        1
                                    )
                                ),
                                IF(
                                    ?thickness <= 35.0,
                                    IF(
                                        ?pc IN (
                                            nltl:polarClassPc1,
                                            nltl:polarClassPc2,
                                            nltl:polarClassPc3,
                                            nltl:polarClassPc4,
                                            nltl:polarClassPc5
                                        ),
                                        IF(
                                            ?material = nltl:steelMaterialClassOne,
                                            2,
                                            3
                                        ),
                                        IF(
                                            ?material = nltl:steelMaterialClassOne,
                                            1,
                                            2
                                        )
                                    ),
                                    IF(
                                        ?thickness <= 40.0,
                                        IF(
                                            ?material = nltl:steelMaterialClassThree,
                                            3,
                                            2
                                        ),
                                        IF(
                                            ?pc IN (
                                                nltl:polarClassPc1,
                                                nltl:polarClassPc2,
                                                nltl:polarClassPc3,
                                                nltl:polarClassPc4,
                                                nltl:polarClassPc5
                                            ),
                                            3,
                                            2
                                        )
                                    )
                                )
                            )
                        )
                    ) AS ?requiredRank
                ) .

                BIND (
                    IF(
                        ?category = nltl:normalStrengthSteelCategory,
                        IF(
                            ?requiredRank = 1,
                            nltl:steelGradeB,
                            IF(
                                ?requiredRank = 2,
                                nltl:steelGradeD,
                                nltl:steelGradeE
                            )
                        ),
                        IF(
                            ?requiredRank = 1,
                            nltl:steelGradeAh,
                            IF(
                                ?requiredRank = 2,
                                nltl:steelGradeDh,
                                IF(
                                    ?requiredRank = 3,
                                    nltl:steelGradeEh,
                                    nltl:steelGradeFh
                                )
                            )
                        )
                    ) AS ?expectedGrade
                ) .

                FILTER (
                    ! ?notApplicable &&
                    (
                        NOT EXISTS {
                            $this nltl:requiredHullStructuralSteelGrade ?required .
                        }
                        ||
                        EXISTS {
                            $this nltl:requiredHullStructuralSteelGrade ?required .
                            FILTER (?required != ?expectedGrade)
                        }
                        ||
                        (
                            ?category = nltl:normalStrengthSteelCategory &&
                            ! (
                                ?actual IN (
                                    nltl:steelGradeB,
                                    nltl:steelGradeD,
                                    nltl:steelGradeE
                                )
                            )
                        )
                        ||
                        (
                            ?category = nltl:highTensileSteelCategory &&
                            ! (
                                ?actual IN (
                                    nltl:steelGradeAh,
                                    nltl:steelGradeDh,
                                    nltl:steelGradeEh,
                                    nltl:steelGradeFh
                                )
                            )
                        )
                        ||
                        (?actualRank < ?requiredRank)
                    )
                )
            }
        """
    ] .
