@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO002ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceConditionValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must declare exactly one design ice condition for category applicability." ;
    ] ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarShipCategoryValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must declare exactly one Polar Code ship category." ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:hasValue nltl:thinFirstYearIceWithPossibleOldIceInclusions ;
            ] ;
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryB ;
            ] ;
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryA ;
            ] ;
        ]
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:in (
                    nltl:iceConditionLessSevereThanCategoryAAndB
                    nltl:iceFreeIceCondition
                    nltl:mediumFirstYearIceWithPossibleOldIceInclusions
                    nltl:openWaterIceCondition
                    nltl:otherWatersIceCondition
                ) ;
            ] ;
        ]
    ) ;
    sh:message "A ship designed to operate in at least thin first-year ice with possible old-ice inclusions must be category B unless it is category A." .
