@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO_003_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceConditionValue ;
        sh:minCount 1 ;
        sh:message "A ship must provide a design ice condition to determine applicability of the Category C rule."
    ] ;
    sh:sparql [
        sh:message "When the design ice condition is open water or less severe than categories A and B, shipCategory must be exactly polarShipCategoryC." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:designIceCondition ?iceCondition .
                FILTER (
                    ?iceCondition = nltl:openWaterIceCondition ||
                    ?iceCondition = nltl:iceConditionLessSevereThanCategoryAAndB
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:shipCategory nltl:polarShipCategoryC .
                    }
                    ||
                    EXISTS {
                        $this nltl:shipCategory ?category .
                        FILTER (?category != nltl:polarShipCategoryC)
                    }
                )
            }
        """
    ] .
