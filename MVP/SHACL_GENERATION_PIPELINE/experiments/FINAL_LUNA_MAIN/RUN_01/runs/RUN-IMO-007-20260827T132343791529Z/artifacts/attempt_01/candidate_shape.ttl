@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO_007_Static> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceConditionClassification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must have exactly one ice condition classification."
    ] ;
    sh:sparql [
        sh:message "For open water, sea ice concentration must be a single unitless decimal quantity less than 1 and ice of land origin must be recorded as false." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification nltl:openWaterIceCondition .

                FILTER (
                    NOT EXISTS {
                        $this nltl:seaIceConcentration ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit qudt:UNITLESS .
                        FILTER (datatype(?v) = xsd:decimal && ?v < 1)
                    }
                    ||
                    EXISTS {
                        $this nltl:seaIceConcentration ?q1, ?q2 .
                        FILTER (?q1 != ?q2)
                    }
                    ||
                    EXISTS {
                        $this nltl:seaIceConcentration ?q .
                        ?q qudt:numericValue ?v1, ?v2 .
                        FILTER (?v1 != ?v2)
                    }
                    ||
                    EXISTS {
                        $this nltl:seaIceConcentration ?q .
                        ?q qudt:unit ?u1, ?u2 .
                        FILTER (?u1 != ?u2)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceOfLandOriginPresent false .
                        FILTER (datatype(false) = xsd:boolean)
                    }
                    ||
                    EXISTS {
                        $this nltl:iceOfLandOriginPresent ?b1, ?b2 .
                        FILTER (?b1 != ?b2)
                    }
                    ||
                    EXISTS {
                        $this nltl:iceOfLandOriginPresent ?b .
                        FILTER (datatype(?b) != xsd:boolean || ?b != false)
                    }
                )
            }
        """
    ] .
