@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_016_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:class nltl:polarShipCertificateForm ;
        sh:minCount 1 ;
        sh:node gen:IMO_016_CertificateShape ;
        sh:message "The ship must have a Polar Ship Certificate in the Appendix I model form."
    ] ;
    sh:property [
        sh:path nltl:certificateLanguage ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The Polar Ship Certificate language must be recorded."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "If the certificate language is not English, French, or Spanish, an approved translation must be present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:certificateLanguage ?language .
                FILTER (
                    STR(?language) NOT IN ("English", "French", "Spanish")
                )
                FILTER NOT EXISTS {
                    $this nltl:approvedTranslationPresent ?translation .
                    FILTER (
                        datatype(?translation) = xsd:boolean &&
                        ?translation = true
                    )
                }
            }
        """
    ] .

gen:IMO_016_CertificateShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:certificateFormModel ;
        sh:hasValue nltl:appendixIPolarShipCertificateModel ;
        sh:minCount 1 ;
        sh:message "The Polar Ship Certificate must correspond to the Appendix I model."
    ] .
