@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-030> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The ship must identify ice operation as not applicable when the conditional PWOM provisions do not apply."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The ship must identify ice operation as applicable before the conditional PWOM provisions can be assessed."
            ] ;
            sh:property [
                sh:path nltl:iceSafetyMonitoringProcedurePresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Ice-operation monitoring and safety procedures must be present when ice operation is applicable."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:escortRequirementsPresent ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue false
                    ] ;
                    sh:property [
                        sh:path nltl:independentOperationLimits ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:message "Independent-operation limitations must be specified when escort or icebreaker assistance is not applicable."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:escortRequirementsPresent ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:escortedOperationLimits ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:message "Escort or icebreaker-assistance requirements and escorted-operation limitations must be specified when escort is applicable."
                    ]
                ]
            )
        ]
    ) .
