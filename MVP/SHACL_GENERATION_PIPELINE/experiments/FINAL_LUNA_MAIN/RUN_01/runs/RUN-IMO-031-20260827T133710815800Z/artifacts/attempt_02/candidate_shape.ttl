@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_031_MaterialApprovalShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:exposedStructureMaterial ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:in (
            "standard acceptable to the Organization"
            "another standard offering an equivalent level of safety"
        )
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        )
    ] ;
    sh:property [
        sh:path nltl:materialApprovalStatus ;
        sh:hasValue nltl:evidenceStateApproved
    ] ;
    sh:property [
        sh:path nltl:polarServiceTemperature ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasEvidence ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each exposed-structure material must be linked to approved evidence identifying an authorized approving authority, an accepted approval standard, the approved evidence state, and the polar service temperature basis." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:exposedStructureMaterial ?material .
                FILTER NOT EXISTS {
                    $this nltl:approvalStandard ?standard ;
                          nltl:approvingAuthority ?authority ;
                          nltl:materialApprovalStatus nltl:evidenceStateApproved ;
                          nltl:polarServiceTemperature ?pst ;
                          nltl:hasEvidence ?evidence .
                    ?pst rdf:type qudt:QuantityValue ;
                         qudt:numericValue ?numeric ;
                         qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
                    ?evidence rdf:type nltl:evidenceArtifact .
                    FILTER (
                        datatype(?numeric) = xsd:decimal &&
                        ?standard IN (
                            "standard acceptable to the Organization",
                            "another standard offering an equivalent level of safety"
                        ) &&
                        ?authority IN (
                            "Administration",
                            "recognized organization accepted by the Administration"
                        )
                    )
                }
            }
        """
    ] .
