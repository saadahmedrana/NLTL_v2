@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_033_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:deckIcingAllowance ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class q:QuantityValue ;
                    sh:property [
                        sh:path q:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "30"^^xsd:decimal ;
                        sh:maxInclusive "30"^^xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path q:unit ;
                        sh:hasValue unit:KiloGM-PER-M2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:sideIcingAllowance ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class q:QuantityValue ;
                    sh:property [
                        sh:path q:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "7.5"^^xsd:decimal ;
                        sh:maxInclusive "7.5"^^xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path q:unit ;
                        sh:hasValue unit:KiloGM-PER-M2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:continuousSurfaceProjectedArea ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class q:QuantityValue ;
                    sh:property [
                        sh:path q:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path q:unit ;
                        sh:hasValue unit:M2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:continuousSurfaceStaticMoment ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class q:QuantityValue ;
                    sh:property [
                        sh:path q:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path q:unit ;
                        sh:hasValue unit:KiloN-M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:discontinuousSurfaceProjectedArea ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class q:QuantityValue ;
                    sh:property [
                        sh:path q:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path q:unit ;
                        sh:hasValue unit:M2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:discontinuousSurfaceStaticMoment ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class q:QuantityValue ;
                    sh:property [
                        sh:path q:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path q:unit ;
                        sh:hasValue unit:KiloN-M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "For ice accretion likely, discontinuous projected area must equal 1.05 times the continuous projected area and discontinuous static moment must equal 1.10 times the continuous static moment within relative tolerance 1e-6 plus an absolute fallback of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX q: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely ?likely ;
                      nltl:continuousSurfaceProjectedArea ?continuousAreaNode ;
                      nltl:discontinuousSurfaceProjectedArea ?discontinuousAreaNode ;
                      nltl:continuousSurfaceStaticMoment ?continuousMomentNode ;
                      nltl:discontinuousSurfaceStaticMoment ?discontinuousMomentNode .

                ?continuousAreaNode q:numericValue ?continuousArea .
                ?discontinuousAreaNode q:numericValue ?discontinuousArea .
                ?continuousMomentNode q:numericValue ?continuousMoment .
                ?discontinuousMomentNode q:numericValue ?discontinuousMoment .

                FILTER (?likely = "true"^^xsd:boolean)

                BIND (?continuousArea * 1.05 AS ?expectedArea)
                BIND (?continuousMoment * 1.10 AS ?expectedMoment)

                FILTER (
                    ABS(?discontinuousArea - ?expectedArea) >
                    (ABS(?expectedArea) * 0.000001 + 0.000001)
                    ||
                    ABS(?discontinuousMoment - ?expectedMoment) >
                    (ABS(?expectedMoment) * 0.000001 + 0.000001)
                )
            }
        """
    ] .
