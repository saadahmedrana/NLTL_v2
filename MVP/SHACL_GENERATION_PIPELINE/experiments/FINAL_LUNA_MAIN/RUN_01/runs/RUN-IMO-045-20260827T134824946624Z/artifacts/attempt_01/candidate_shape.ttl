@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_045_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:path nltl:machinerySeawaterSupply ;
            sh:datatype xsd:boolean ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:hasValue false ;
            sh:message "The ship must explicitly indicate that no machinery seawater supply is present when this requirement is not applicable."
        ]
        [
            sh:and (
                [
                    sh:path nltl:machinerySeawaterSupply ;
                    sh:datatype xsd:boolean ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:hasValue true
                ]
                [
                    sh:or (
                        [
                            sh:path nltl:iceIngestionPreventionPresent ;
                            sh:datatype xsd:boolean ;
                            sh:minCount 1 ;
                            sh:maxCount 1 ;
                            sh:hasValue true ;
                            sh:message "Each machinery seawater supply must indicate that ice ingestion prevention is present, or provide approved alternative-functionality evidence."
                        ]
                        [
                            sh:path nltl:alternateFunctionalityArrangementApprovalStatus ;
                            sh:minCount 1 ;
                            sh:maxCount 1 ;
                            sh:hasValue nltl:evidenceStateApproved ;
                            sh:message "The alternative functionality arrangement for a machinery seawater supply must have approved status."
                        ]
                    )
                ]
            )
        ]
    ) .
