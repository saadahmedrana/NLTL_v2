@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_047_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasEssentialEngine ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:essentialEngine ;
        sh:minCount 1 ;
        sh:message "The ship must identify at least one essential engine to which the combustion-air requirement applies."
    ] ;
    sh:property [
        sh:path nltl:combustionAirTemperatureControlPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Combustion-air temperature control must be recorded as present."
    ] ;
    sh:property [
        sh:path nltl:combustionAirTemperature ;
        sh:node gen:IMO_047_TemperatureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The combustion-air temperature must be supplied in degrees Celsius."
    ] ;
    sh:property [
        sh:path nltl:manufacturerMinAirTemperature ;
        sh:node gen:IMO_047_TemperatureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The engine manufacturer's minimum combustion-air temperature criterion must be supplied in degrees Celsius."
    ] ;
    sh:property [
        sh:path nltl:manufacturerMaxAirTemperature ;
        sh:node gen:IMO_047_TemperatureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The engine manufacturer's maximum combustion-air temperature criterion must be supplied in degrees Celsius."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The combustion-air temperature must be within the manufacturer's inclusive minimum and maximum criteria." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:combustionAirTemperature ?temperatureNode .
                $this nltl:manufacturerMinAirTemperature ?minimumNode .
                $this nltl:manufacturerMaxAirTemperature ?maximumNode .
                ?temperatureNode qudt:numericValue ?temperature .
                ?minimumNode qudt:numericValue ?minimum .
                ?maximumNode qudt:numericValue ?maximum .
                FILTER (?temperature < ?minimum || ?temperature > ?maximum)
            }
        """
    ] .

gen:IMO_047_TemperatureQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG_C ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
