@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO049ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO049CategoryAShape
        gen:IMO049CategoryBShape
        gen:IMO049IceStrengthenedCategoryCShape
    ) .

gen:IMO049CategoryAShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:polarShipCategoryA ;
        sh:message "The ship category must be Category A." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each applicable Category A scantling must have approved evidence from an authorized authority using an acceptable or equivalent-safety standard." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component a nltl:machineryComponent ;
                    nltl:machineryComponentType ?componentType .
                FILTER (LCASE(STR(?componentType)) IN
                    ("propeller blade", "propulsion-line", "steering-equipment", "appendage"))
                FILTER NOT EXISTS {
                    ?component nltl:hasApprovalRecord ?record .
                    ?record a nltl:approvalRecord ;
                        nltl:scantlingApprovalStatus nltl:evidenceStateApproved ;
                        nltl:approvingAuthority ?authority ;
                        nltl:approvalStandard ?standard .
                    FILTER (STR(?authority) IN
                        ("Administration",
                         "recognized organization accepted by the Administration"))
                    FILTER (STR(?standard) IN
                        ("standard acceptable to the Organization",
                         "another standard offering an equivalent level of safety"))
                }
            }
        """ ;
    ] .

gen:IMO049CategoryBShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:polarShipCategoryB ;
        sh:message "The ship category must be Category B." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each applicable Category B scantling must have approved evidence from an authorized authority using an acceptable or equivalent-safety standard." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component a nltl:machineryComponent ;
                    nltl:machineryComponentType ?componentType .
                FILTER (LCASE(STR(?componentType)) IN
                    ("propeller blade", "propulsion-line", "steering-equipment", "appendage"))
                FILTER NOT EXISTS {
                    ?component nltl:hasApprovalRecord ?record .
                    ?record a nltl:approvalRecord ;
                        nltl:scantlingApprovalStatus nltl:evidenceStateApproved ;
                        nltl:approvingAuthority ?authority ;
                        nltl:approvalStandard ?standard .
                    FILTER (STR(?authority) IN
                        ("Administration",
                         "recognized organization accepted by the Administration"))
                    FILTER (STR(?standard) IN
                        ("standard acceptable to the Organization",
                         "another standard offering an equivalent level of safety"))
                }
            }
        """ ;
    ] .

gen:IMO049IceStrengthenedCategoryCShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:polarShipCategoryC ;
        sh:message "The ship category must be Category C." ;
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "A Category C ship must be identified as ice-strengthened for this approval rule." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each applicable ice-strengthened Category C scantling must have approved evidence from an authorized authority using an acceptable standard with operating ice type and concentration." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component a nltl:machineryComponent ;
                    nltl:machineryComponentType ?componentType .
                FILTER (LCASE(STR(?componentType)) IN
                    ("propeller blade", "propulsion-line", "steering-equipment", "appendage"))
                FILTER NOT EXISTS {
                    ?component nltl:hasApprovalRecord ?record .
                    ?record a nltl:approvalRecord ;
                        nltl:scantlingApprovalStatus nltl:evidenceStateApproved ;
                        nltl:approvingAuthority ?authority ;
                        nltl:approvalStandard "acceptable standard adequate for operating ice type and concentration" ;
                        nltl:operatingIceType ?iceType ;
                        nltl:operatingIceConcentration ?concentration .
                    FILTER (STR(?authority) IN
                        ("Administration",
                         "recognized organization accepted by the Administration"))
                    ?concentration qudt:numericValue ?numericValue ;
                        qudt:unit qudt:UNITLESS .
                    FILTER (datatype(?numericValue) = xsd:decimal)
                }
            }
        """ ;
    ] .
