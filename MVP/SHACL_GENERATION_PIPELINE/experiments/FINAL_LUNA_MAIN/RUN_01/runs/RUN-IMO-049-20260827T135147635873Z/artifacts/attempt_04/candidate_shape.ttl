@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO049Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO049CategoryAShape
        gen:IMO049CategoryBShape
        gen:IMO049StrengthenedCategoryCShape
        gen:IMO049NonStrengthenedCategoryCShape
    ) .

gen:IMO049CategoryAShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:polarShipCategoryA
    ] ;
    sh:sparql [
        sh:message "Each applicable propeller blade, propulsion line, steering equipment, or appendage must have an approved authority and an acceptable or equivalent-safety standard." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:machineryComponentType ?componentType .
                FILTER (STR(?componentType) IN ("propeller blade", "propulsion line", "steering equipment", "appendage"))
                FILTER (
                    datatype(?componentType) != xsd:string ||
                    NOT EXISTS {
                        ?component nltl:hasApprovalRecord ?record .
                        ?record nltl:scantlingApprovalStatus nltl:evidenceStateApproved ;
                                nltl:approvingAuthority ?authority ;
                                nltl:approvalStandard ?standard .
                        FILTER (
                            datatype(?authority) = xsd:string &&
                            STR(?authority) IN ("Administration", "recognized organization accepted by the Administration") &&
                            datatype(?standard) = xsd:string &&
                            STR(?standard) IN ("standard acceptable to the Organization", "another standard offering an equivalent level of safety")
                        )
                    }
                )
            }
        """
    ] .

gen:IMO049CategoryBShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:polarShipCategoryB
    ] ;
    sh:sparql [
        sh:message "Each applicable propeller blade, propulsion line, steering equipment, or appendage must have an approved authority and an acceptable or equivalent-safety standard." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:machineryComponentType ?componentType .
                FILTER (STR(?componentType) IN ("propeller blade", "propulsion line", "steering equipment", "appendage"))
                FILTER (
                    datatype(?componentType) != xsd:string ||
                    NOT EXISTS {
                        ?component nltl:hasApprovalRecord ?record .
                        ?record nltl:scantlingApprovalStatus nltl:evidenceStateApproved ;
                                nltl:approvingAuthority ?authority ;
                                nltl:approvalStandard ?standard .
                        FILTER (
                            datatype(?authority) = xsd:string &&
                            STR(?authority) IN ("Administration", "recognized organization accepted by the Administration") &&
                            datatype(?standard) = xsd:string &&
                            STR(?standard) IN ("standard acceptable to the Organization", "another standard offering an equivalent level of safety")
                        )
                    }
                )
            }
        """
    ] .

gen:IMO049StrengthenedCategoryCShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:polarShipCategoryC
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true
    ] ;
    sh:sparql [
        sh:message "Each applicable propeller blade, propulsion line, steering equipment, or appendage must have approved authority, standard, operating ice type, and unitless decimal operating ice concentration." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:machineryComponentType ?componentType .
                FILTER (STR(?componentType) IN ("propeller blade", "propulsion line", "steering equipment", "appendage"))
                FILTER (
                    datatype(?componentType) != xsd:string ||
                    NOT EXISTS {
                        ?component nltl:hasApprovalRecord ?record .
                        ?record nltl:scantlingApprovalStatus nltl:evidenceStateApproved ;
                                nltl:approvingAuthority ?authority ;
                                nltl:approvalStandard ?standard ;
                                nltl:operatingIceType ?iceType ;
                                nltl:operatingIceConcentration ?concentration .
                        ?concentration qudt:numericValue ?numericValue ;
                                      qudt:unit qudt:UNITLESS .
                        FILTER (
                            datatype(?authority) = xsd:string &&
                            STR(?authority) IN ("Administration", "recognized organization accepted by the Administration") &&
                            datatype(?standard) = xsd:string &&
                            STR(?standard) = "acceptable standard adequate for operating ice type and concentration" &&
                            datatype(?iceType) = xsd:string &&
                            datatype(?numericValue) = xsd:decimal
                        )
                    }
                )
            }
        """
    ] .

gen:IMO049NonStrengthenedCategoryCShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:polarShipCategoryC
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue false
    ] .
