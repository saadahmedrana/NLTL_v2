@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_051_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasLocalControlItem ;
        sh:class nltl:localControlItem ;
        sh:node gen:IMO_051_LocalControlItemShape ;
        sh:message "Each linked local control item must be a localControlItem satisfying the required protection and accessibility conditions."
    ] .

gen:IMO_051_LocalControlItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:localControlProtectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The local control must have freezing, snow, and ice protection."
    ] ;
    sh:property [
        sh:path nltl:localControlContinuouslyAccessible ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The local control must remain continuously accessible."
    ] .
