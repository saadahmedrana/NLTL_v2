@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-055> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:valveExposed ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "Valve exposure, when recorded, must be a single boolean value."
    ] ;
    sh:property [
        sh:path nltl:valveType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "Valve type, when recorded, must be a single string value."
    ] ;
    sh:property [
        sh:path nltl:iceAccretionProtectionPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "Ice accretion protection status must be a single boolean value."
    ] ;
    sh:property [
        sh:path nltl:continuouslyAccessible ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "Continuous accessibility status must be a single boolean value."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An exposed isolating, pressure, or vacuum valve must have ice accretion protection and remain continuously accessible." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:valveExposed ?exposed ;
                      nltl:valveType ?type .
                FILTER (
                    ?exposed = true &&
                    ?type IN ("isolating", "pressure", "vacuum")
                )
                FILTER NOT EXISTS {
                    $this nltl:iceAccretionProtectionPresent ?protected ;
                          nltl:continuouslyAccessible ?accessible .
                    FILTER (?protected = true && ?accessible = true)
                }
            }
        """
    ] .
