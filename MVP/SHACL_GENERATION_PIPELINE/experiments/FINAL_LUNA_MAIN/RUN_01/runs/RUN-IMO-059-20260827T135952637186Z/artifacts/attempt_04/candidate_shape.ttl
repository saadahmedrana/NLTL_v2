@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO_059_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFirefighterOutfit ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:firefighterOutfitItem ;
        sh:class nltl:equipmentItem ;
        sh:message "Each linked firefighter outfit must be an IRI representing a firefighter outfit item and equipment item."
    ] .

gen:IMO_059_EquipmentItemShape
    a sh:NodeShape ;
    sh:targetClass nltl:equipmentItem ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each firefighter outfit must have a storage location classified as warm." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                ?ship a nltl:ship ;
                      nltl:hasFirefighterOutfit $this .
                FILTER NOT EXISTS {
                    $this nltl:hasStorageLocation ?location .
                    ?location a nltl:physicalStorageLocation ;
                              nltl:storageTemperatureClass nltl:warmStorageLocation .
                }
            }
        """
    ] .
