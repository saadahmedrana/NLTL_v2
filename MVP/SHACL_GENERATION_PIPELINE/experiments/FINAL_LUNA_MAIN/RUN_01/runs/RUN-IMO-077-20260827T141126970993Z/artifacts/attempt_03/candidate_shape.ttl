@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-077> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When additional equipment is carried in survival craft, the survival-craft capacity and launching-appliance capacity must satisfy the required comparisons with valid typed and unit-qualified inputs." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:additionalEquipmentCarriedInSurvivalCraft ?applicability .
                FILTER (
                    datatype(?applicability) = xsd:boolean &&
                    ?applicability = true
                )

                FILTER NOT EXISTS {
                    $this nltl:personsCapacityRequirement ?persons .
                    FILTER (datatype(?persons) = xsd:integer)

                    $this nltl:additionalEquipmentCapacityRequirement ?additional .
                    FILTER (datatype(?additional) = xsd:integer)

                    $this nltl:survivalCraftAvailableCapacity ?available .
                    FILTER (
                        datatype(?available) = xsd:integer &&
                        ?available >= (?persons + ?additional)
                    )

                    $this nltl:launchingApplianceCapacity ?launching .
                    ?launching rdf:type qudt:QuantityValue .
                    ?launching qudt:numericValue ?launchingValue .
                    ?launching qudt:unit unit:KiloGM .
                    FILTER (datatype(?launchingValue) = xsd:decimal)

                    $this nltl:loadedSurvivalCraftRequirement ?loaded .
                    ?loaded rdf:type qudt:QuantityValue .
                    ?loaded qudt:numericValue ?loadedValue .
                    ?loaded qudt:unit unit:KiloGM .
                    FILTER (
                        datatype(?loadedValue) = xsd:decimal &&
                        ?launchingValue >= ?loadedValue
                    )
                }
            }
        """
    ] .
