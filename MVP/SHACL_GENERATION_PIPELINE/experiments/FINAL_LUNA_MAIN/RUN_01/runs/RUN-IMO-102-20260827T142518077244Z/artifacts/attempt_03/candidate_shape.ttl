@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO102PolarTrainingShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceConditionClassification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceFreeIceCondition
            nltl:openWaterIceCondition
            nltl:otherWatersIceCondition
        ) ;
        sh:message "The ship must have exactly one controlled ice condition classification."
    ] ;
    sh:property [
        sh:path nltl:polarTrainingShipTypeClassification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:tankerPolarTrainingShipType
            nltl:passengerShipPolarTrainingShipType
            nltl:otherShipPolarTrainingType
        ) ;
        sh:message "The ship must have exactly one controlled polar training ship type."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each explicitly applicable master, chief mate, or officer in charge of a navigational watch must have exactly one controlled role and a matching valid polar training record for the applicable 12.3.1 matrix cell." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    $this nltl:hasCrewMemberInventory ?crew .
                    ?crew nltl:polarTrainingCrewRoleClassification ?role1 .
                    FILTER (
                        ?role1 IN (
                            nltl:masterPolarTrainingRole,
                            nltl:chiefMatePolarTrainingRole,
                            nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
                        )
                    )
                    ?crew nltl:polarTrainingCrewRoleClassification ?role2 .
                    FILTER (
                        ?role2 IN (
                            nltl:masterPolarTrainingRole,
                            nltl:chiefMatePolarTrainingRole,
                            nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
                        )
                        && ?role2 != ?role1
                    )
                }
                UNION
                {
                    $this nltl:hasCrewMemberInventory ?crew .
                    ?crew nltl:polarTrainingCrewRoleClassification ?role .
                    FILTER (
                        ?role IN (
                            nltl:masterPolarTrainingRole,
                            nltl:chiefMatePolarTrainingRole,
                            nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
                        )
                    )
                    $this nltl:iceConditionClassification nltl:openWaterIceCondition ;
                          nltl:polarTrainingShipTypeClassification ?shipType .
                    FILTER (
                        ?shipType IN (
                            nltl:tankerPolarTrainingShipType,
                            nltl:passengerShipPolarTrainingShipType
                        )
                    )
                    FILTER NOT EXISTS {
                        ?crew nltl:hasPolarTrainingRecord ?record .
                        ?record nltl:requiredTrainingLevel nltl:basicPolarTrainingLevel ;
                                nltl:trainingRecordLevel nltl:basicPolarTrainingLevel ;
                                nltl:stcwQualificationValid true .
                    }
                }
                UNION
                {
                    $this nltl:hasCrewMemberInventory ?crew .
                    ?crew nltl:polarTrainingCrewRoleClassification ?role .
                    FILTER (
                        ?role IN (
                            nltl:masterPolarTrainingRole,
                            nltl:chiefMatePolarTrainingRole
                        )
                    )
                    $this nltl:iceConditionClassification nltl:otherWatersIceCondition ;
                          nltl:polarTrainingShipTypeClassification ?shipType .
                    FILTER (
                        ?shipType IN (
                            nltl:tankerPolarTrainingShipType,
                            nltl:passengerShipPolarTrainingShipType,
                            nltl:otherShipPolarTrainingType
                        )
                    )
                    FILTER NOT EXISTS {
                        ?crew nltl:hasPolarTrainingRecord ?record .
                        ?record nltl:requiredTrainingLevel nltl:advancedPolarTrainingLevel ;
                                nltl:trainingRecordLevel nltl:advancedPolarTrainingLevel ;
                                nltl:stcwQualificationValid true .
                    }
                }
                UNION
                {
                    $this nltl:hasCrewMemberInventory ?crew .
                    ?crew nltl:polarTrainingCrewRoleClassification nltl:officerInChargeOfNavigationalWatchPolarTrainingRole .
                    $this nltl:iceConditionClassification nltl:otherWatersIceCondition ;
                          nltl:polarTrainingShipTypeClassification ?shipType .
                    FILTER (
                        ?shipType IN (
                            nltl:tankerPolarTrainingShipType,
                            nltl:passengerShipPolarTrainingShipType,
                            nltl:otherShipPolarTrainingType
                        )
                    )
                    FILTER NOT EXISTS {
                        ?crew nltl:hasPolarTrainingRecord ?record .
                        ?record nltl:requiredTrainingLevel nltl:basicPolarTrainingLevel ;
                                nltl:trainingRecordLevel nltl:basicPolarTrainingLevel ;
                                nltl:stcwQualificationValid true .
                    }
                }
            }
        """
    ] .
