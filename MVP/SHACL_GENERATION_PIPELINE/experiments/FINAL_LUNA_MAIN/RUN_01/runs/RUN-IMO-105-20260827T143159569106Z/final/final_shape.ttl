@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_105_Arctic_Discharge_Constraint
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "An operating area is required to determine whether the Arctic discharge prohibition applies."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a ship whose operating area is Arctic_waters, an explicit false oil-or-oily-mixture discharge record is required and no non-false discharge value is permitted." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:operatingArea ?area .
                FILTER (
                    sameTerm(?area, "Arctic_waters"^^xsd:string)
                    &&
                    (
                        NOT EXISTS {
                            $this nltl:oilOrOilyMixtureDischargeToSea ?discharge .
                            FILTER(sameTerm(?discharge, false))
                        }
                        ||
                        EXISTS {
                            $this nltl:oilOrOilyMixtureDischargeToSea ?discharge .
                            FILTER(!sameTerm(?discharge, false))
                        }
                    )
                )
            }
        """
    ] .
