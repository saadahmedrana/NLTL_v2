@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-113-PolarOperationDocumentCoverageShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:IMO-113-ApplicablePolarCoverageShape>
        <urn:nltl:generated-shape:IMO-113-NonApplicablePolarCoverageShape>
    ) .

<urn:nltl:generated-shape:IMO-113-ApplicablePolarCoverageShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship's polar-water applicability must be recorded as true for this applicable branch."
    ] ;
    sh:property [
        sh:path nltl:polarOperationCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Polar-operation coverage must be recorded for the applicable documents."
    ] ;
    sh:property [
        sh:path nltl:cargoRecordBookPolarCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The Cargo Record Book must account for polar operation."
    ] ;
    sh:property [
        sh:path nltl:manualPolarCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The Manual must account for polar operation."
    ] ;
    sh:property [
        sh:path nltl:noxiousLiquidSubstanceEmergencyPlanPolarCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The applicable noxious-liquid-substance or marine-pollution emergency plan must account for polar operation."
    ] .

<urn:nltl:generated-shape:IMO-113-NonApplicablePolarCoverageShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The ship's polar-water applicability must be recorded as false for this non-applicable branch."
    ] .
