@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:IMO_114_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a Category A or B ship, the applicable construction, NLS, and tank-type inputs must establish the rule, and the Administration approval and certificate polar-operation entry must then be present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                FILTER (
                    ?category = nltl:polarShipCategoryA ||
                    ?category = nltl:polarShipCategoryB
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:constructionDate ?date ;
                              nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ?requiresType3 ;
                              nltl:cargoTankType ?tankType .
                        FILTER (
                            datatype(?date) = xsd:date &&
                            (
                                YEAR(?date) > 2017 ||
                                (
                                    YEAR(?date) = 2017 &&
                                    (
                                        MONTH(?date) > 1 ||
                                        (
                                            MONTH(?date) = 1 &&
                                            DAY(?date) >= 1
                                        )
                                    )
                                )
                            )
                        )
                        FILTER (
                            datatype(?requiresType3) = xsd:boolean &&
                            ?requiresType3 = true
                        )
                        FILTER (
                            datatype(?tankType) = xsd:string &&
                            ?tankType = "3"
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:constructionDate ?date ;
                              nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ?requiresType3 ;
                              nltl:cargoTankType ?tankType ;
                              nltl:administrationCarriageApprovalStatus nltl:evidenceStateApproved ;
                              nltl:applicableCertificatePolarOperationEntryPresent ?entryPresent .
                        FILTER (
                            datatype(?date) = xsd:date &&
                            (
                                YEAR(?date) > 2017 ||
                                (
                                    YEAR(?date) = 2017 &&
                                    (
                                        MONTH(?date) > 1 ||
                                        (
                                            MONTH(?date) = 1 &&
                                            DAY(?date) >= 1
                                        )
                                    )
                                )
                            )
                        )
                        FILTER (
                            datatype(?requiresType3) = xsd:boolean &&
                            ?requiresType3 = true
                        )
                        FILTER (
                            datatype(?tankType) = xsd:string &&
                            ?tankType = "3"
                        )
                        FILTER (
                            datatype(?entryPresent) = xsd:boolean &&
                            ?entryPresent = true
                        )
                    }
                )
            }
        """
    ] .
