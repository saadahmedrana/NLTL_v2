@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-116> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When sewage discharge is not comminuted or disinfected, MARPOL compliance, the distance from ice shelf or fast ice, nearby ice concentration, and the distinct distance from qualifying ice areas must conform." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:sewageDischargeType ?dischargeType .
  FILTER (
    datatype(?dischargeType) = xsd:string &&
    str(?dischargeType) = "not comminuted or disinfected"
  )
  FILTER (
    NOT EXISTS {
      $this nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus ?status .
      FILTER (
        datatype(?status) = xsd:boolean &&
        ?status = true
      )
    }
    ||
    NOT EXISTS {
      $this nltl:distanceToNearestIceShelfOrFastIce ?distance .
      ?distance rdf:type qudt:QuantityValue ;
                qudt:numericValue ?distanceValue ;
                qudt:unit unit:MI_N .
      FILTER (
        datatype(?distanceValue) = xsd:decimal &&
        ?distanceValue > "12"^^xsd:decimal
      )
    }
    ||
    NOT EXISTS {
      $this nltl:nearbyIceConcentration ?nearby .
      ?nearby rdf:type qudt:QuantityValue ;
              qudt:numericValue ?nearbyValue ;
              qudt:unit unit:UNITLESS .
      FILTER (
        datatype(?nearbyValue) = xsd:decimal &&
        ?nearbyValue > "1"^^xsd:decimal
      )
    }
    ||
    NOT EXISTS {
      $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .
      ?areaDistance rdf:type qudt:QuantityValue ;
                    qudt:numericValue ?areaDistanceValue ;
                    qudt:unit unit:MI_N .
      FILTER (datatype(?areaDistanceValue) = xsd:decimal)
    }
  )
}
"""
    ] .
