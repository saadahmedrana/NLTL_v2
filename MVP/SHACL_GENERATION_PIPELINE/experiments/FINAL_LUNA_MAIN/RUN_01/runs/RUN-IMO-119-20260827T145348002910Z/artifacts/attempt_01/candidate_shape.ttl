@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO119Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:iceConcentration ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minExclusive "1"^^xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:extendedPeriodOperation ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:sewageDischargeOccurs ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:approvedSewageTreatmentPlantUsed ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "An approved sewage treatment plant must be used when this rule applies."
            ] ;
            sh:property [
                sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:evidenceState ;
                sh:minCount 1 ;
                sh:message "MARPOL Annex IV regulation 9.1.1 or 9.2.1 certification status is required when this rule applies."
            ] ;
            sh:property [
                sh:path nltl:marpolCertificationStatus ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:evidenceState ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:administrationDischargeApprovalStatus ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:minCount 1 ;
                sh:message "Sewage discharge must be approved by the Administration when this rule applies."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:polarShipCategoryC ) ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceConcentration ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:maxInclusive "1"^^xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:extendedPeriodOperation ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:sewageDischargeOccurs ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1
            ]
        ]
    ) .
