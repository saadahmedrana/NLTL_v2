@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-120> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:arcticWaters ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:foodWasteDischargeToSea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an Arctic-waters ship discharging food waste to sea, the nearest-feature distance must be at least 12 nautical miles." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:arcticWaters ?arctic ;
                      nltl:operatingArea ?area ;
                      nltl:foodWasteDischargeToSea ?discharge .
                FILTER(
                    ?arctic = "Arctic_waters"^^xsd:string &&
                    ?area = "Arctic_waters"^^xsd:string &&
                    ?discharge = true
                )
                FILTER NOT EXISTS {
                    $this nltl:distanceToNearestLandIceShelfOrFastIce ?distance .
                    ?distance a qudt:QuantityValue ;
                              qudt:numericValue ?value ;
                              qudt:unit unit:MI_N .
                    FILTER(
                        datatype(?value) = xsd:decimal &&
                        ?value >= "12"^^xsd:decimal
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an applicable ship, nearby ice concentration must be recorded as a dimensionless decimal quantity." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:arcticWaters ?arctic ;
                      nltl:operatingArea ?area ;
                      nltl:foodWasteDischargeToSea ?discharge .
                FILTER(
                    ?arctic = "Arctic_waters"^^xsd:string &&
                    ?area = "Arctic_waters"^^xsd:string &&
                    ?discharge = true
                )
                FILTER NOT EXISTS {
                    $this nltl:nearbyIceConcentration ?concentration .
                    ?concentration a qudt:QuantityValue ;
                                   qudt:numericValue ?value ;
                                   qudt:unit unit:UNITLESS .
                    FILTER(datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When nearby ice concentration exceeds one tenth, the distance from that qualifying area must be recorded." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:arcticWaters ?arctic ;
                      nltl:operatingArea ?area ;
                      nltl:foodWasteDischargeToSea ?discharge ;
                      nltl:nearbyIceConcentration ?concentration .
                ?concentration a qudt:QuantityValue ;
                               qudt:numericValue ?iceValue ;
                               qudt:unit unit:UNITLESS .
                FILTER(
                    ?arctic = "Arctic_waters"^^xsd:string &&
                    ?area = "Arctic_waters"^^xsd:string &&
                    ?discharge = true &&
                    datatype(?iceValue) = xsd:decimal &&
                    ?iceValue > "0.1"^^xsd:decimal
                )
                FILTER NOT EXISTS {
                    $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?recordedDistance .
                    ?recordedDistance a qudt:QuantityValue ;
                                       qudt:numericValue ?recordedValue ;
                                       qudt:unit unit:MI_N .
                    FILTER(datatype(?recordedValue) = xsd:decimal)
                }
            }
        """
    ] .
