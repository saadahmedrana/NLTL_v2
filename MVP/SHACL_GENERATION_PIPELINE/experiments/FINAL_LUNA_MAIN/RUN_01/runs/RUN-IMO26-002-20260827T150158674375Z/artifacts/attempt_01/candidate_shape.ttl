@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-002> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Chapter 9-1 applicability must be recorded as true."
    ] ;
    sh:sparql [
        sh:message "The ship must satisfy one applicable Chapter 9-1 scope branch using its ship type, dimensions, gross tonnage, and trade status." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    {
                        $this nltl:shipType ?shipType ;
                              nltl:lengthOverall ?length .
                        FILTER (
                            datatype(?shipType) = xsd:string &&
                            ?shipType = "fishing_vessel"^^xsd:string
                        )
                        ?length qudt:numericValue ?lengthValue ;
                                qudt:unit qudt:M .
                        FILTER (
                            datatype(?lengthValue) = xsd:decimal &&
                            ?lengthValue >= 24
                        )
                    }
                    UNION
                    {
                        $this nltl:shipType ?shipType ;
                              nltl:grossTonnage ?tonnage ;
                              nltl:engagedInTrade ?engaged .
                        FILTER (
                            datatype(?shipType) = xsd:string &&
                            ?shipType = "pleasure_yacht"^^xsd:string &&
                            datatype(?engaged) = xsd:boolean &&
                            ?engaged = false
                        )
                        ?tonnage qudt:numericValue ?tonnageValue ;
                                 qudt:unit qudt:UNITLESS .
                        FILTER (
                            datatype(?tonnageValue) = xsd:decimal &&
                            ?tonnageValue >= 300
                        )
                    }
                    UNION
                    {
                        $this nltl:shipType ?shipType ;
                              nltl:grossTonnage ?tonnage .
                        FILTER (
                            datatype(?shipType) = xsd:string &&
                            ?shipType = "cargo_ship"^^xsd:string
                        )
                        ?tonnage qudt:numericValue ?tonnageValue ;
                                 qudt:unit qudt:UNITLESS .
                        FILTER (
                            datatype(?tonnageValue) = xsd:decimal &&
                            ?tonnageValue >= 300 &&
                            ?tonnageValue < 500
                        )
                    }
                }
            }
        """
    ] .
