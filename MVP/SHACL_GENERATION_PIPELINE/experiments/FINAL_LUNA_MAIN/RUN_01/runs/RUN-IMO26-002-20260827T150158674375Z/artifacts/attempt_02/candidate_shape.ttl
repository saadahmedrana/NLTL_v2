@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-002-QuantityLength> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:M
    ] .

<urn:nltl:generated-shape:IMO26-002-QuantityGrossTonnage> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:UNITLESS
    ] .

<urn:nltl:generated-shape:IMO26-002-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship type is required to determine Chapter 9-1 applicability."
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO26-002-QuantityLength>
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO26-002-QuantityGrossTonnage>
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Chapter 9-1 applicability must be recorded as a single boolean result."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Chapter 9-1 applicability does not match the ship type, dimensions, gross tonnage, and trade status." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:shipType ?type .
    $this nltl:polarCodeChapter9Dash1Applicable ?app .
    OPTIONAL {
        $this nltl:lengthOverall ?lengthQuantity .
        ?lengthQuantity qudt:numericValue ?lengthValue .
    }
    OPTIONAL {
        $this nltl:grossTonnage ?tonnageQuantity .
        ?tonnageQuantity qudt:numericValue ?tonnageValue .
    }
    OPTIONAL {
        $this nltl:engagedInTrade ?trade .
    }
    FILTER (
        (
            ?type = "fishing_vessel"
            && (
                !BOUND(?lengthValue)
                || ?lengthValue < 24
                || ?app != true
            )
        )
        ||
        (
            ?type = "pleasure_yacht"
            && (
                !BOUND(?tonnageValue)
                || !BOUND(?trade)
                || ?tonnageValue < 300
                || ?trade != false
                || ?app != true
            )
        )
        ||
        (
            ?type = "cargo_ship"
            && (
                !BOUND(?tonnageValue)
                || ?tonnageValue < 300
                || ?tonnageValue >= 500
                || ?app != true
            )
        )
        ||
        (
            ?type NOT IN ("fishing_vessel", "pleasure_yacht", "cargo_ship")
            && ?app != false
        )
    )
}
"""
    ] .
