@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-013> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:plannedOrActualLatitude ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxInclusive "80"^^xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:DEG ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "A planned or actual latitude at or below 80 degrees is required to establish non-applicability."
            ]
        ]
        [
            sh:property [
                sh:path nltl:plannedOrActualLatitude ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:minExclusive "80"^^xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:DEG ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "A planned or actual latitude over 80 degrees is required to establish applicability."
            ] ;
            sh:property [
                sh:path nltl:gnssCompassOrEquivalentCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:minInclusive 1 ;
                sh:message "At least one GNSS compass or equivalent is required for voyages over 80 degrees latitude."
            ] ;
            sh:property [
                sh:path nltl:connectedToMainPower ;
                sh:minCount 1 ;
                sh:class nltl:benchmarkEntity ;
                sh:message "The GNSS compass or equivalent must be connected to the ship's main source of power."
            ] ;
            sh:property [
                sh:path nltl:connectedToEmergencyPower ;
                sh:minCount 1 ;
                sh:class nltl:benchmarkEntity ;
                sh:message "The GNSS compass or equivalent must be connected to the ship's emergency source of power."
            ]
        ]
    ) .
