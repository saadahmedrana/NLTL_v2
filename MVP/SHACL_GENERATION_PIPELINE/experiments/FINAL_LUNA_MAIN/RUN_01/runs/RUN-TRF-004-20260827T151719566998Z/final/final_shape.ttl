@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF004Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:minInclusive "2010-01-01"^^xsd:date ;
                sh:maxExclusive "2012-01-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRegulationEdition2008 ;
                sh:minCount 1 ;
                sh:message "Ships contracted from 2010-01-01 up to, but not including, 2012-01-01 shall identify the 2008 Ice Class Regulations as the applicable edition."
            ]
        ]
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxExclusive "2010-01-01"^^xsd:date
            ]
        ]
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:minInclusive "2012-01-01"^^xsd:date
            ]
        ]
    ) .
