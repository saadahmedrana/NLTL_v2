@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-005> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:message "Construction contract date must be an xsd:date when provided."
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:message "Construction stage date must be an xsd:date when provided."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:message "Applicable ice class regulation edition must be an IRI."
    ] ;
    sh:sparql [
        sh:message "Ships contracted before 1 January 2010 and at a similar construction stage on or after 1 September 2003 must identify the 2002 Ice Class Regulations as the applicable regulation edition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?contractDate ;
                      nltl:constructionStageDate ?stageDate .
                FILTER (
                    ?contractDate < "2010-01-01"^^xsd:date &&
                    ?stageDate >= "2003-09-01"^^xsd:date
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                          nltl:iceClassRegulationEdition2002 .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "For an applicable ship, the applicable regulation edition must be the 2002 Ice Class Regulations." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?contractDate ;
                      nltl:constructionStageDate ?stageDate ;
                      nltl:applicableIceClassRegulationEdition ?edition .
                FILTER (
                    ?contractDate < "2010-01-01"^^xsd:date &&
                    ?stageDate >= "2003-09-01"^^xsd:date &&
                    ?edition != nltl:iceClassRegulationEdition2002
                )
            }
        """
    ] .
