@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-006> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "For ships constructed from 1 November 1986 up to 1 September 2003, the 1985 ice-class rule edition and the owner-request engine-output selector must be represented consistently." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:constructionStageDate ?date .
    FILTER (
        ?date >= "1986-11-01"^^xsd:date &&
        ?date < "2003-09-01"^^xsd:date
    )
    {
        FILTER NOT EXISTS {
            $this nltl:applicableIceClassRegulationEdition
                nltl:iceClassRuleEdition1985
        }
    }
    UNION
    {
        $this nltl:applicableIceClassRegulationEdition ?edition .
        FILTER (?edition != nltl:iceClassRuleEdition1985)
    }
    UNION
    {
        FILTER NOT EXISTS {
            $this nltl:ownerRequested2008EngineOutputRequirements ?request
        }
    }
    UNION
    {
        $this nltl:ownerRequested2008EngineOutputRequirements ?request .
        FILTER (datatype(?request) != xsd:boolean)
    }
    UNION
    {
        $this nltl:ownerRequested2008EngineOutputRequirements "true"^^xsd:boolean .
        FILTER NOT EXISTS {
            $this nltl:engineOutputRegulationEdition
                nltl:iceClassRegulationEdition2008
        }
    }
    UNION
    {
        $this nltl:ownerRequested2008EngineOutputRequirements "false"^^xsd:boolean .
        $this nltl:engineOutputRegulationEdition
            nltl:iceClassRegulationEdition2008
    }
}
"""
    ] .
