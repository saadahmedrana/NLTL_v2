@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-006> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A construction-stage date is required to determine applicability of the ice-class regulation." ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:maxInclusive "1986-10-31"^^xsd:date ;
            ] ;
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:minInclusive "2003-09-01"^^xsd:date ;
            ] ;
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:minInclusive "1986-11-01"^^xsd:date ;
                sh:maxInclusive "2003-08-31"^^xsd:date ;
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:nodeKind sh:IRI ;
                sh:hasValue nltl:iceClassRuleEdition1985 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Ships in the applicable construction-stage cohort must identify the 1985 ice-class rule edition." ;
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Ships in the applicable construction-stage cohort must have an ice-class relationship." ;
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                    ] ;
                    sh:property [
                        sh:path nltl:engineOutputRegulationEdition ;
                        sh:nodeKind sh:IRI ;
                        sh:hasValue nltl:iceClassRegulationEdition2008 ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "When the owner requests the 2008 engine-output requirements, the ship must identify the 2008 regulation edition." ;
                    ] ;
                ]
                [
                    sh:property [
                        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue false ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                    ] ;
                ]
            ) ;
        ]
    ) .
