@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-007-Shape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:TRF-007-ApplicableShape>
        <urn:nltl:generated-shape:TRF-007-NotApplicableShape>
    ) .

<urn:nltl:generated-shape:TRF-007-ApplicableShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
        )
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:engineOutputComplianceMethod ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:in (
            nltl:traficom2017Section3Point2Point2Method
            nltl:traficom2017Section3Point2Point4Method
        )
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an applicable IA or IA Super ship, the compliance deadline must not have passed." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass .
    $this nltl:constructionStageDate ?constructionStageDate .
    $this nltl:deliveryDate ?deliveryDate .
    $this nltl:assessmentDate ?assessmentDate .
    FILTER (
        ?iceClass IN (
            nltl:iceClassIaSuper,
            nltl:iceClassIa
        )
    )
    FILTER (
        (YEAR(?constructionStageDate) < 2003) ||
        (
            YEAR(?constructionStageDate) = 2003 &&
            MONTH(?constructionStageDate) < 9
        ) ||
        (
            YEAR(?constructionStageDate) = 2003 &&
            MONTH(?constructionStageDate) = 9 &&
            DAY(?constructionStageDate) < 1
        )
    )
    FILTER (
        YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20 ||
        (
            YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
            MONTH(?assessmentDate) > 1
        ) ||
        (
            YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
            MONTH(?assessmentDate) = 1 &&
            DAY(?assessmentDate) > 1
        )
    )
}
"""
    ] .

<urn:nltl:generated-shape:TRF-007-NotApplicableShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ship is not shown to be outside the IA or IA Super pre-1 September 2003 applicability condition." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass .
    $this nltl:constructionStageDate ?constructionStageDate .
    FILTER (
        ?iceClass NOT IN (
            nltl:iceClassIaSuper,
            nltl:iceClassIa
        ) ||
        YEAR(?constructionStageDate) > 2003 ||
        (
            YEAR(?constructionStageDate) = 2003 &&
            MONTH(?constructionStageDate) > 9
        ) ||
        (
            YEAR(?constructionStageDate) = 2003 &&
            MONTH(?constructionStageDate) = 9 &&
            DAY(?constructionStageDate) >= 1
        )
    )
}
"""
    ] .
