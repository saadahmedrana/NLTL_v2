@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF011ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:node gen:TRF011IceWaterlineShape
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:node gen:TRF011IceWaterlineShape
    ] ;
    sh:sparql [
        sh:message "The upper ice waterline must equal the maximum intended ice-operating waterline vertical coordinate at every longitudinal position, in both directions; comparison uses a 1e-6 relative tolerance with a 1e-9 absolute fallback." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?this ?x
WHERE {
  {
    SELECT ?this ?x
           (SUM(IF(?source = "intended", 1, 0)) AS ?intendedCount)
           (SUM(IF(?source = "upper", 1, 0)) AS ?upperCount)
           (MAX(IF(?source = "intended", ?y, 0.0)) AS ?intendedMaximum)
           (MAX(IF(?source = "upper", ?y, 0.0)) AS ?upperMaximum)
    WHERE {
      {
        ?this nltl:hasIntendedIceOperatingWaterline ?waterline .
        ?waterline nltl:hasWaterlineProfilePoint ?point .
        ?point nltl:longitudinalPosition ?longitudinalQuantity ;
               nltl:verticalCoordinate ?verticalQuantity .
        ?longitudinalQuantity qudt:numericValue ?x ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .
        ?verticalQuantity qudt:numericValue ?y ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
        BIND("intended" AS ?source)
      }
      UNION
      {
        ?this nltl:hasUpperIceWaterline ?waterline .
        ?waterline nltl:hasWaterlineProfilePoint ?point .
        ?point nltl:longitudinalPosition ?longitudinalQuantity ;
               nltl:verticalCoordinate ?verticalQuantity .
        ?longitudinalQuantity qudt:numericValue ?x ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .
        ?verticalQuantity qudt:numericValue ?y ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
        BIND("upper" AS ?source)
      }
    }
    GROUP BY ?this ?x
  }
  FILTER(
    ?intendedCount = 0 ||
    ?upperCount = 0 ||
    ABS(?intendedMaximum - ?upperMaximum) >
      (
        0.000001 *
        IF(
          ABS(?intendedMaximum) > ABS(?upperMaximum),
          ABS(?intendedMaximum),
          ABS(?upperMaximum)
        ) +
        0.000000001
      )
  )
}
"""
    ] .

gen:TRF011IceWaterlineShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:waterlineProfilePoint ;
        sh:minCount 1 ;
        sh:node gen:TRF011ProfilePointShape
    ] .

gen:TRF011ProfilePointShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:node gen:TRF011LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:node gen:TRF011LengthQuantityShape
    ] .

gen:TRF011LengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:nodeKind sh:IRI ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
