@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-011-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-011-IceWaterlineShape>
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-011-IceWaterlineShape>
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The upper ice waterline must be the pointwise envelope of the intended ice-operating waterlines at every longitudinal position." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT ?this
WHERE {
    {
        SELECT ?x
               (MAX(?intendedValue) AS ?intendedMaximum)
               (MAX(?upperValue) AS ?upperMaximum)
               (COUNT(?intendedValue) AS ?intendedCount)
               (COUNT(?upperValue) AS ?upperCount)
        WHERE {
            {
                ?this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
                ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
                ?intendedPoint nltl:longitudinalPosition ?intendedPositionNode ;
                               nltl:verticalCoordinate ?intendedCoordinateNode .
                ?intendedPositionNode qudt:numericValue ?x .
                ?intendedCoordinateNode qudt:numericValue ?intendedValue .
            }
            UNION
            {
                ?this nltl:hasUpperIceWaterline ?upperWaterline .
                ?upperWaterline nltl:hasWaterlineProfilePoint ?upperPoint .
                ?upperPoint nltl:longitudinalPosition ?upperPositionNode ;
                            nltl:verticalCoordinate ?upperCoordinateNode .
                ?upperPositionNode qudt:numericValue ?x .
                ?upperCoordinateNode qudt:numericValue ?upperValue .
            }
        }
        GROUP BY ?x
    }
    FILTER (
        ?intendedCount = 0 ||
        ?upperCount = 0 ||
        (
            ABS(?intendedMaximum) < 0.000000001 &&
            ABS(?upperMaximum - ?intendedMaximum) > 0.000000001
        ) ||
        (
            ABS(?intendedMaximum) >= 0.000000001 &&
            ABS(?upperMaximum - ?intendedMaximum) >
                0.000001 * ABS(?intendedMaximum)
        )
    )
}
"""
    ] .

<urn:nltl:generated-shape:TRF-011-IceWaterlineShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:waterlineProfilePoint ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-011-ProfilePointShape>
    ] .

<urn:nltl:generated-shape:TRF-011-ProfilePointShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-011-LengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-011-LengthQuantityShape>
    ] .

<urn:nltl:generated-shape:TRF-011-LengthQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
