@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF013Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "shipIceStrengthened is required to determine whether the conditional draught constraints apply."
    ] ;
    sh:or (
        gen:TRF013NonApplicableShape
        gen:TRF013ApplicableShape
    ) .

gen:TRF013NonApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF013ApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:message "An ice class is required when ice conditions require the ship to be ice-strengthened."
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:message "The upper ice waterline is required for an applicable ice-strengthened ship."
    ] ;
    sh:property [
        sh:path nltl:hasLowerIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:message "The lower ice waterline is required for an applicable ice-strengthened ship."
    ] ;
    sh:property [
        sh:path nltl:operatingForeDraught ;
        sh:node gen:TRF013LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:operatingAftDraught ;
        sh:node gen:TRF013LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:node gen:TRF013LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:node gen:TRF013LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:node gen:TRF013LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:node gen:TRF013LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The operating fore and aft draughts must each be between the corresponding minimum and maximum ice-class draughts, with the applicable waterlines and draught bounds represented on the same ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasUpperIceWaterline ?upper .
                $this nltl:hasLowerIceWaterline ?lower .
                ?upper a nltl:iceWaterline .
                ?lower a nltl:iceWaterline .

                $this nltl:operatingForeDraught ?operatingForeNode .
                $this nltl:minimumIceClassDraughtFore ?minimumForeNode .
                $this nltl:maximumIceClassDraughtFore ?maximumForeNode .
                ?operatingForeNode qudt:numericValue ?operatingFore .
                ?minimumForeNode qudt:numericValue ?minimumFore .
                ?maximumForeNode qudt:numericValue ?maximumFore .

                $this nltl:operatingAftDraught ?operatingAftNode .
                $this nltl:minimumIceClassDraughtAft ?minimumAftNode .
                $this nltl:maximumIceClassDraughtAft ?maximumAftNode .
                ?operatingAftNode qudt:numericValue ?operatingAft .
                ?minimumAftNode qudt:numericValue ?minimumAft .
                ?maximumAftNode qudt:numericValue ?maximumAft .

                FILTER (
                    ?operatingFore < ?minimumFore ||
                    ?operatingFore > ?maximumFore ||
                    ?operatingAft < ?minimumAft ||
                    ?operatingAft > ?maximumAft
                )
            }
        """
    ] .

gen:TRF013LengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
