@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF014_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An assessment date is required."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A construction date is required."
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014_LengthQuantityShape ;
        sh:message "The summer load line fresh water draught is required in metres."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014_LengthQuantityShape ;
        sh:message "The upper ice waterline draught is required in metres."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have a canonical Finnish-Swedish ice-class value."
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:class nltl:classCertificate ;
        sh:minCount 1 ;
        sh:node gen:TRF014_ClassCertificateShape ;
        sh:message "A class certificate containing all required ice-class draught limits is required."
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:class nltl:iceDraughtRestrictionDocument ;
        sh:minCount 1 ;
        sh:message "An ice draught restriction document is required."
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ice draught restriction document must be retained on board."
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ice draught restriction document must be readily available to the master."
    ] ;
    sh:or (
        gen:TRF014_NonApplicableMarkingShape
        gen:TRF014_Post2007MarkingShape
        gen:TRF014_Pre2007CompleteMarkingShape
        gen:TRF014_Pre2007DeferredMarkingShape
    ) .

gen:TRF014_LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF014_ClassCertificateShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014_LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAmidships ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014_LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014_LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014_LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAmidships ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014_LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014_LengthQuantityShape
    ] .

gen:TRF014_MarkingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The warning triangle must be present."
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ice-class draught mark must be present."
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014_LengthQuantityShape ;
        sh:message "The ice-class draught mark amidships must be recorded in metres."
    ] .

gen:TRF014_NonApplicableMarkingShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the summer load line is above the UIWL, a marking branch is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:summerLoadLineFreshWaterDraught ?sl .
                $this nltl:upperIceWaterlineDraught ?ui .
                ?sl qudt:numericValue ?sv .
                ?ui qudt:numericValue ?uiv .
                FILTER (?sv > ?uiv)
            }
        """
    ] .

gen:TRF014_Post2007MarkingShape
    a sh:NodeShape ;
    sh:and (
        gen:TRF014_MarkingShape
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ships built on or after 1 July 2007 with the summer load line above the UIWL must have the required marking at the certificate maximum amidships draught." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate .
                $this nltl:summerLoadLineFreshWaterDraught ?sl .
                $this nltl:upperIceWaterlineDraught ?ui .
                $this nltl:iceClassDraughtMarkDraughtAmidships ?mark .
                $this nltl:hasClassCertificate ?certificate .
                ?sl qudt:numericValue ?sv .
                ?ui qudt:numericValue ?uiv .
                ?mark qudt:numericValue ?mv .
                ?certificate nltl:maximumIceClassDraughtAmidships ?maximum .
                ?maximum qudt:numericValue ?xv .
                FILTER (
                    ?constructionDate < "2007-07-01"^^xsd:date ||
                    ?sv <= ?uiv ||
                    ?mv != ?xv
                )
            }
        """
    ] .

gen:TRF014_Pre2007CompleteMarkingShape
    a sh:NodeShape ;
    sh:and (
        gen:TRF014_MarkingShape
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A pre-2007 ship with applicable marking must have the mark at the certificate maximum amidships draught." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate .
                $this nltl:summerLoadLineFreshWaterDraught ?sl .
                $this nltl:upperIceWaterlineDraught ?ui .
                $this nltl:iceClassDraughtMarkDraughtAmidships ?mark .
                $this nltl:hasClassCertificate ?certificate .
                ?sl qudt:numericValue ?sv .
                ?ui qudt:numericValue ?uiv .
                ?mark qudt:numericValue ?mv .
                ?certificate nltl:maximumIceClassDraughtAmidships ?maximum .
                ?maximum qudt:numericValue ?xv .
                FILTER (
                    ?constructionDate >= "2007-07-01"^^xsd:date ||
                    ?sv <= ?uiv ||
                    ?mv != ?xv
                )
            }
        """
    ] .

gen:TRF014_Pre2007DeferredMarkingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The first scheduled dry docking date is required when applicable pre-2007 marking evidence is absent."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "This branch applies only to a pre-2007 ship with the summer load line above the UIWL and a dry docking date after the assessment date." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate .
                $this nltl:assessmentDate ?assessmentDate .
                $this nltl:firstScheduledDryDockingDate ?dryDockingDate .
                $this nltl:summerLoadLineFreshWaterDraught ?sl .
                $this nltl:upperIceWaterlineDraught ?ui .
                ?sl qudt:numericValue ?sv .
                ?ui qudt:numericValue ?uiv .
                FILTER (
                    ?constructionDate >= "2007-07-01"^^xsd:date ||
                    ?sv <= ?uiv ||
                    ?dryDockingDate <= ?assessmentDate
                )
            }
        """
    ] .
