@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF016_QuantityValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF016_MassQuantityValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/TON_Metric> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF016_BallastTankShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:situatedAboveLowerIceWaterline ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:usedToReachLowerIceWaterline ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:freezingPreventionPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "A ballast tank situated above the LIWL and needed to reach the LIWL must have freezing prevention present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:situatedAboveLowerIceWaterline ?situated ;
                      nltl:usedToReachLowerIceWaterline ?needed .
                FILTER (?situated = true && ?needed = true)
                FILTER NOT EXISTS {
                    $this nltl:freezingPreventionPresent true .
                }
            }
        """
    ] .

gs:TRF016_UpperIceWaterlineShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:waterlineDisplacement ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF016_MassQuantityValueShape
    ] .

gs:TRF016_ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:navigatingInIce ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasLowerIceWaterline ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:minCount 1 ;
        sh:node gs:TRF016_UpperIceWaterlineShape
    ] ;
    sh:property [
        sh:path nltl:draughtAmidships ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF016_QuantityValueShape
    ] ;
    sh:property [
        sh:path nltl:liwlDraughtAmidships ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF016_QuantityValueShape
    ] ;
    sh:property [
        sh:path nltl:forwardDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF016_QuantityValueShape
    ] ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF016_QuantityValueShape
    ] ;
    sh:property [
        sh:path nltl:displacementAtUpperIceWaterline ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF016_MassQuantityValueShape
    ] ;
    sh:property [
        sh:path nltl:waterlineDisplacement ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF016_MassQuantityValueShape
    ] ;
    sh:property [
        sh:path nltl:propellerHighestPointSubmerged ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasBallastTank ;
        sh:node gs:TRF016_BallastTankShape
    ] ;
    sh:sparql [
        sh:message "Draught amidships must be at least the LIWL draught amidships when navigating in ice." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:draughtAmidships/qudt:numericValue ?draught ;
                      nltl:liwlDraughtAmidships/qudt:numericValue ?liwl .
                FILTER (?draught < ?liwl)
            }
        """
    ] ;
    sh:sparql [
        sh:message "The ship waterline displacement must be the displacement of a greatest-displacement UIWL." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:waterlineDisplacement/qudt:numericValue ?selected ;
                      nltl:hasUpperIceWaterline ?waterline .
                ?waterline nltl:waterlineDisplacement/qudt:numericValue ?candidate .
                FILTER NOT EXISTS {
                    $this nltl:hasUpperIceWaterline ?greaterWaterline .
                    ?greaterWaterline nltl:waterlineDisplacement/qudt:numericValue ?greater .
                    FILTER (?greater > ?selected)
                }
                FILTER NOT EXISTS {
                    FILTER (
                        ABS(?selected - ?candidate) <=
                        (1e-6 * ABS(?candidate) + 1e-9)
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The ship displacement at the UIWL must be the selected greatest-displacement UIWL value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:displacementAtUpperIceWaterline/qudt:numericValue ?formulaDisplacement ;
                      nltl:waterlineDisplacement/qudt:numericValue ?selected .
                FILTER (
                    ABS(?formulaDisplacement - ?selected) >
                    (1e-6 * ABS(?selected) + 1e-9)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Forward draught must be at least the applicable UIWL displacement and level-ice-thickness bound." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:forwardDraught/qudt:numericValue ?forward ;
                      nltl:displacementAtUpperIceWaterline/qudt:numericValue ?displacement ;
                      nltl:levelIceThickness/qudt:numericValue ?thickness .
                BIND (
                    (2.0 + (0.00025 * ?displacement)) * ?thickness
                    AS ?formulaBound
                )
                BIND (4.0 * ?thickness AS ?upperBound)
                BIND (
                    IF(?formulaBound < ?upperBound, ?formulaBound, ?upperBound)
                    AS ?requiredBound
                )
                FILTER (?forward < ?requiredBound)
            }
        """
    ] .

gs:TRF016_NonApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:navigatingInIce ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .

gs:TRF016_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:TRF016_ApplicableShape
        gs:TRF016_NonApplicableShape
    ) .
