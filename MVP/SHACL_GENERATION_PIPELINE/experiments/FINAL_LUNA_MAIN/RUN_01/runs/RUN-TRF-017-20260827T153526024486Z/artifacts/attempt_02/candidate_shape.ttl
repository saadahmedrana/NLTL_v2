@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF_017_Static> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propulsionMachineryContinuousOutput ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propulsionOutputRestrictionApplies ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:restrictedPropulsionOutput ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:additionalPropulsionPower ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propulsionOutputRestrictionApplies ;
                sh:hasValue false ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionOutputRestrictionApplies ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:restrictedPropulsionOutput ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Maximum continuous rating power P must equal the applicable propulsion output, including any additional propulsion power, within a relative tolerance of 1e-6 and an absolute fallback of 0.000001 kW." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE
            {
                {
                    $this nltl:maximumContinuousRatingPower ?pNode .
                    ?pNode qudt:numericValue ?p .
                    $this nltl:propulsionMachineryContinuousOutput ?mNode .
                    ?mNode qudt:numericValue ?m .
                    $this nltl:propulsionOutputRestrictionApplies false .
                    FILTER NOT EXISTS {
                        $this nltl:additionalPropulsionPower ?aNode .
                        ?aNode qudt:numericValue ?a .
                    }
                    FILTER (ABS(?p - ?m) > (ABS(?m) * 0.000001 + 0.000001))
                }
                UNION
                {
                    $this nltl:maximumContinuousRatingPower ?pNode .
                    ?pNode qudt:numericValue ?p .
                    $this nltl:propulsionMachineryContinuousOutput ?mNode .
                    ?mNode qudt:numericValue ?m .
                    $this nltl:propulsionOutputRestrictionApplies false .
                    $this nltl:additionalPropulsionPower ?aNode .
                    ?aNode qudt:numericValue ?a .
                    FILTER (ABS(?p - (?m + ?a)) > (ABS(?m + ?a) * 0.000001 + 0.000001))
                }
                UNION
                {
                    $this nltl:maximumContinuousRatingPower ?pNode .
                    ?pNode qudt:numericValue ?p .
                    $this nltl:restrictedPropulsionOutput ?rNode .
                    ?rNode qudt:numericValue ?r .
                    $this nltl:propulsionOutputRestrictionApplies true .
                    FILTER NOT EXISTS {
                        $this nltl:additionalPropulsionPower ?aNode .
                        ?aNode qudt:numericValue ?a .
                    }
                    FILTER (ABS(?p - ?r) > (ABS(?r) * 0.000001 + 0.000001))
                }
                UNION
                {
                    $this nltl:maximumContinuousRatingPower ?pNode .
                    ?pNode qudt:numericValue ?p .
                    $this nltl:restrictedPropulsionOutput ?rNode .
                    ?rNode qudt:numericValue ?r .
                    $this nltl:propulsionOutputRestrictionApplies true .
                    $this nltl:additionalPropulsionPower ?aNode .
                    ?aNode qudt:numericValue ?a .
                    FILTER (ABS(?p - (?r + ?a)) > (ABS(?r + ?a) * 0.000001 + 0.000001))
                }
            }
        """
    ] .
