@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF017EngineOutputShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propulsionOutputRestrictionApplies ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propulsionMachineryContinuousOutput ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:restrictedPropulsionOutput ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:additionalPropulsionPower ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propulsionOutputRestrictionApplies ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:restrictedPropulsionOutput ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionOutputRestrictionApplies ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:propulsionMachineryContinuousOutput ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:sparql [
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:propulsionOutputRestrictionApplies ?restrictionFlag .
    FILTER (?restrictionFlag = true || ?restrictionFlag = false)

    OPTIONAL {
        $this nltl:restrictedPropulsionOutput ?restrictedNode .
        ?restrictedNode qudt:numericValue ?restrictedValue .
        ?restrictedNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .
        FILTER (?restrictionFlag = true)
    }

    OPTIONAL {
        $this nltl:propulsionMachineryContinuousOutput ?machineryNode .
        ?machineryNode qudt:numericValue ?machineryValue .
        ?machineryNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .
        FILTER (?restrictionFlag = false)
    }

    FILTER (
        (?restrictionFlag = true && BOUND(?restrictedValue)) ||
        (?restrictionFlag = false && BOUND(?machineryValue))
    )

    BIND(
        IF(?restrictionFlag = true, ?restrictedValue, ?machineryValue)
        AS ?baseValue
    )

    OPTIONAL {
        $this nltl:additionalPropulsionPower ?additionalNode .
        ?additionalNode qudt:numericValue ?additionalValue .
        ?additionalNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .
    }

    BIND(
        IF(BOUND(?additionalValue),
           ?baseValue + ?additionalValue,
           ?baseValue)
        AS ?expectedValue
    )

    $this nltl:maximumContinuousRatingPower ?resultNode .
    ?resultNode qudt:numericValue ?reportedValue .
    ?resultNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .

    FILTER (
        (
            ?reportedValue >= ?expectedValue - (?expectedValue * 0.000001) &&
            ?reportedValue <= ?expectedValue + (?expectedValue * 0.000001)
        ) ||
        (
            ?reportedValue >= ?expectedValue - 0.000001 &&
            ?reportedValue <= ?expectedValue + 0.000001
        )
    )
}
""" ;
        sh:message "Maximum continuous rating power must equal the applicable propulsion output, including any additional propulsion power, within the permitted numerical tolerance."
    ] .
