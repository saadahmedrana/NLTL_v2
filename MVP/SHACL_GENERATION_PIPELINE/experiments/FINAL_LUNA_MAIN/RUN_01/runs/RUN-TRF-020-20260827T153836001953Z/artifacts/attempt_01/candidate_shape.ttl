@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-020> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single construction stage date is required."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single controlled ice class value is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIaSuper
                    nltl:iceClassIa
                    nltl:iceClassIb
                    nltl:iceClassIc
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:engineOutputCoefficientKe ;
                sh:class qudt:QuantityValue ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:brashIceChannelResistanceAtLowerIceWaterline ;
                sh:class qudt:QuantityValue ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:brashIceChannelResistanceAtUpperIceWaterline ;
                sh:class qudt:QuantityValue ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:propellerDiameter ;
                sh:class qudt:QuantityValue ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:propellerCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:propellerPitchControlType ;
                sh:in (
                    nltl:controllablePitch
                    nltl:fixedPitch
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:propulsionSystemType ;
                sh:in (
                    nltl:conventionalPropulsionSystem
                    nltl:electricPropulsionMachinery
                    nltl:hydraulicPropulsionMachinery
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasLowerIceWaterline ;
                sh:class nltl:iceWaterline ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasUpperIceWaterline ;
                sh:class nltl:iceWaterline ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:upperIceWaterlineLength ;
                        sh:class qudt:QuantityValue ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:upperIceWaterlineBreadth ;
                        sh:class qudt:QuantityValue ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:minimumRequiredPowerAtLowerIceWaterline ;
                sh:class qudt:QuantityValue ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:minimumRequiredPowerAtUpperIceWaterline ;
                sh:class qudt:QuantityValue ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:maximumContinuousRatingPower ;
                sh:class qudt:QuantityValue ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:sparql [
                sh:message "The construction stage date must establish applicability on or after 2003-09-01." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT ?this
                    WHERE {
                        ?this nltl:constructionStageDate ?date .
                        FILTER (?date < "2003-09-01"^^xsd:date)
                    }
                """
            ] ;
            sh:sparql [
                sh:message "Maximum continuous rating power must be at least both externally calculated minimum powers." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT ?this
                    WHERE {
                        ?this nltl:maximumContinuousRatingPower ?mcrNode .
                        ?mcrNode qudt:numericValue ?mcr .
                        ?this nltl:minimumRequiredPowerAtLowerIceWaterline ?lowerNode .
                        ?lowerNode qudt:numericValue ?lower .
                        ?this nltl:minimumRequiredPowerAtUpperIceWaterline ?upperNode .
                        ?upperNode qudt:numericValue ?upper .
                        FILTER (?mcr < ?lower || ?mcr < ?upper)
                    }
                """
            ]
        ]
        [
            sh:sparql [
                sh:message "A valid construction date and ice class are required to establish non-applicability." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT ?this
                    WHERE {
                        ?this nltl:constructionStageDate ?date ;
                              nltl:iceClass ?iceClass .
                        FILTER (
                            ?date < "2003-09-01"^^xsd:date ||
                            ?iceClass NOT IN (
                                nltl:iceClassIaSuper,
                                nltl:iceClassIa,
                                nltl:iceClassIb,
                                nltl:iceClassIc
                            )
                        )
                    }
                """
            ]
        ]
    ) .

<urn:nltl:generated-shape:TRF-020-applicable> a sh:NodeShape .

<urn:nltl:generated-shape:TRF-020-nonapplicable> a sh:NodeShape .
