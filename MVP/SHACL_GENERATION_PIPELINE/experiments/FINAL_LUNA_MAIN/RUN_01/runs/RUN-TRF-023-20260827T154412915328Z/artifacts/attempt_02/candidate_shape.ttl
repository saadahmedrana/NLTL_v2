@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-023-PowerQuantity> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "The power quantity must have a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:message "The power quantity must have exactly one kW unit."
    ] .

<urn:nltl:generated-shape:TRF-023-PowerComparison> a sh:NodeShape ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-023-PowerQuantity> ;
        sh:message "A maximum continuous rating power value is required."
    ] ;
    sh:property [
        sh:path nltl:requiredPowerUnder1985Rules ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-023-PowerQuantity> ;
        sh:message "A required power under the 1985 rules value is required."
    ] ;
    sh:sparql [
        sh:message "For ice class IB or IC under the 1985 ice class rules, maximum continuous rating power must be at least the required power." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:maximumContinuousRatingPower ?mcrQuantity .
  ?mcrQuantity qudt:numericValue ?mcrValue ;
                qudt:unit qudt:KiloW .
  $this nltl:requiredPowerUnder1985Rules ?requiredQuantity .
  ?requiredQuantity qudt:numericValue ?requiredValue ;
                    qudt:unit qudt:KiloW .
  FILTER (?mcrValue < ?requiredValue)
}
"""
    ] .

<urn:nltl:generated-shape:TRF-023> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:nodeKind sh:IRI ;
                sh:hasValue nltl:iceClassRuleEdition1985 ;
                sh:minCount 1 ;
                sh:message "The applicable ice class regulation edition must be the 1985 rules."
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:nodeKind sh:IRI ;
                sh:hasValue nltl:iceClassIb ;
                sh:minCount 1 ;
                sh:message "The ship must have ice class IB for this applicability branch."
            ] ;
            sh:node <urn:nltl:generated-shape:TRF-023-PowerComparison>
        ]
        [
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:nodeKind sh:IRI ;
                sh:hasValue nltl:iceClassRuleEdition1985 ;
                sh:minCount 1 ;
                sh:message "The applicable ice class regulation edition must be the 1985 rules."
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:nodeKind sh:IRI ;
                sh:hasValue nltl:iceClassIc ;
                sh:minCount 1 ;
                sh:message "The ship must have ice class IC for this applicability branch."
            ] ;
            sh:node <urn:nltl:generated-shape:TRF-023-PowerComparison>
        ]
    ) .
