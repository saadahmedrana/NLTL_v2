@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PowerQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The power quantity must have exactly one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The power quantity must have exactly one unit, KiloW."
    ] .

gen:TRF023Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:in (
                    nltl:iceClassRegulationEdition2002
                    nltl:iceClassRegulationEdition2008
                    nltl:iceClassRegulationEdition2010
                    nltl:iceClassRegulationEdition2017
                    nltl:iceClassRegulationEdition2021
                ) ;
                sh:minCount 1 ;
                sh:message "This requirement is not applicable when a regulation edition other than the 1985 edition applies."
            ]
        ]
        [
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRuleEdition1985 ;
                sh:minCount 1 ;
                sh:message "The applicable ice class regulation edition must be the 1985 rules."
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                ) ;
                sh:minCount 1 ;
                sh:message "A ship subject to the 1985 rules must retain ice class IB or IC."
            ] ;
            sh:property [
                sh:path nltl:maximumContinuousRatingPower ;
                sh:nodeKind sh:IRI ;
                sh:node gen:PowerQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The ship must have exactly one valid maximum continuous rating power value."
            ] ;
            sh:property [
                sh:path nltl:requiredPowerUnder1985Rules ;
                sh:nodeKind sh:IRI ;
                sh:node gen:PowerQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The ship must have exactly one valid required power under the 1985 rules."
            ] ;
            sh:sparql [
                sh:message "Maximum continuous rating power must be greater than or equal to the required power under the 1985 rules." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:maximumContinuousRatingPower ?mcrNode .
                        ?mcrNode qudt:numericValue ?mcrValue .
                        $this nltl:requiredPowerUnder1985Rules ?requiredNode .
                        ?requiredNode qudt:numericValue ?requiredValue .
                        FILTER (?mcrValue < ?requiredValue)
                    }
                """
            ]
        ]
    ) .
