@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF024ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:message "The ship must identify its ice class."
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:message "The construction stage date must be an xsd:date when supplied."
    ] ;
    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date ;
        sh:message "The delivery date must be an xsd:date when supplied."
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:message "The assessment date must be an xsd:date when supplied."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For ice class IA Super or IA ships constructed before 1 September 2003, deliveryDate and assessmentDate are required, and assessmentDate must not be later than 1 January of the year twenty years after delivery." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass = nltl:iceClassIaSuper ||
                    ?iceClass = nltl:iceClassIa
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:constructionStageDate ?constructionDate
                    }
                    ||
                    EXISTS {
                        $this nltl:constructionStageDate ?constructionDate .
                        FILTER (datatype(?constructionDate) = xsd:date)
                        FILTER (
                            YEAR(?constructionDate) < 2003 ||
                            (
                                YEAR(?constructionDate) = 2003 &&
                                MONTH(?constructionDate) < 9
                            ) ||
                            (
                                YEAR(?constructionDate) = 2003 &&
                                MONTH(?constructionDate) = 9 &&
                                DAY(?constructionDate) < 1
                            )
                        )
                        FILTER (
                            NOT EXISTS {
                                $this nltl:deliveryDate ?deliveryDate
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:assessmentDate ?assessmentDate
                            }
                            ||
                            EXISTS {
                                $this nltl:deliveryDate ?deliveryDate2 .
                                $this nltl:assessmentDate ?assessmentDate2 .
                                FILTER (datatype(?deliveryDate2) = xsd:date)
                                FILTER (datatype(?assessmentDate2) = xsd:date)
                                FILTER (
                                    YEAR(?assessmentDate2) > YEAR(?deliveryDate2) + 20 ||
                                    (
                                        YEAR(?assessmentDate2) = YEAR(?deliveryDate2) + 20 &&
                                        MONTH(?assessmentDate2) > 1
                                    ) ||
                                    (
                                        YEAR(?assessmentDate2) = YEAR(?deliveryDate2) + 20 &&
                                        MONTH(?assessmentDate2) = 1 &&
                                        DAY(?assessmentDate2) > 1
                                    )
                                )
                            }
                        )
                    }
                )
            }
        """
    ] .
