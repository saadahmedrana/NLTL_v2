@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF034EffectiveMemberCrossSectionShape>
    a sh:NodeShape ;
    sh:targetClass nltl:effectiveMemberCrossSection ;
    sh:message "The effective member cross section shall provide section modulus and shear area in the required units, and non-normal members shall have classification-society calculation evidence." ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:datatype qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:CentiM3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:datatype qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path [
            sh:inversePath nltl:hasEffectiveMemberCrossSection
        ] ;
        sh:class nltl:hullStructure ;
        sh:minCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path [
                    sh:inversePath nltl:hasEffectiveMemberCrossSection
                ] ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:memberNormalToPlating ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:minCount 1
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path [
                    sh:inversePath nltl:hasEffectiveMemberCrossSection
                ] ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:memberNormalToPlating ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue false ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:hasClassificationSocietySectionPropertyCalculationEvidence ;
                sh:class nltl:evidenceArtifact ;
                sh:minCount 1 ;
                sh:message "Classification-society section-property calculation evidence is required when the linked member is not normal to the plating."
            ]
        ]
    ) .
