@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF043TerminationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFramingIceStrengtheningTerminationCase ;
        sh:node [
            sh:class nltl:framingIceStrengtheningTerminationCase ;
            sh:property [
                sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "Each termination case must state the extension beyond the adjacent boundary in millimetres."
            ] ;
            sh:property [
                sh:path nltl:terminationAdjacentBoundary ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:or (
                    [ sh:class nltl:deckStructure ]
                    [ sh:class nltl:tankBoundaryPlating ]
                    [ sh:class nltl:tankTop ]
                ) ;
                sh:message "The termination boundary must be a deck structure, tank boundary plating, or tank top."
            ] ;
            sh:property [
                sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ;
                sh:datatype xsd:boolean
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "When the extension beyond the adjacent boundary is at most 250 mm, termination at that boundary must be permitted and no conflicting false value may be recorded." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?quantity .
                        ?quantity qudt:numericValue ?extension ;
                                  qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER (?extension <= 250)
                        FILTER (
                            NOT EXISTS {
                                $this nltl:iceStrengtheningTerminationAtAdjacentBoundary true
                            }
                            ||
                            EXISTS {
                                $this nltl:iceStrengtheningTerminationAtAdjacentBoundary ?conflictingValue .
                                FILTER (?conflictingValue != true)
                            }
                        )
                    }
                """
            ]
        ]
    ] .
