@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF-046> a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path ( nltl:hasUpperEnd nltl:hasAttachedSupportingStructure ) ;
        sh:minCount 1 ;
        sh:node [
            sh:or (
                [ sh:class nltl:deckStructure ]
                [ sh:class nltl:tankBoundaryPlating ]
                [ sh:class nltl:iceStringer ]
            )
        ] ;
        sh:message "The upper end of the strengthened frame part must be attached to a deck, tank boundary plating, or ice stringer."
    ] .
