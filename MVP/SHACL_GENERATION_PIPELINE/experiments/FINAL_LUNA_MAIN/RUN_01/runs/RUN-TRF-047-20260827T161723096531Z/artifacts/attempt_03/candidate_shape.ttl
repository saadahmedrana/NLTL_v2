@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF047FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each strengthened main frame part must have a lower end attached to a deck structure, tank top, tank-boundary plating, or ice stringer." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this ?part ?lower
            WHERE {
                $this nltl:hasStrengthenedPart ?part .
                ?part rdf:type nltl:mainFrame ;
                      nltl:hasLowerEnd ?lower .
                FILTER NOT EXISTS {
                    ?lower nltl:hasAttachedSupportingStructure ?support .
                    ?support rdf:type ?supportType .
                    FILTER (
                        ?supportType IN (
                            nltl:deckStructure,
                            nltl:tankTop,
                            nltl:tankBoundaryPlating,
                            nltl:iceStringer
                        )
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A frame with a represented strengthened main frame part must record that main frames below the ice belt are ice strengthened." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?part
            WHERE {
                $this nltl:hasStrengthenedPart ?part .
                ?part rdf:type nltl:mainFrame .
                FILTER NOT EXISTS {
                    $this nltl:mainFrameBelowIceBeltStrengthened
                        "true"^^xsd:boolean .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each strengthened intermediate ice frame part must have either a permitted attached supporting structure or a complete permitted horizontal-member connection." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?part ?lower
            WHERE {
                $this nltl:hasStrengthenedPart ?part .
                ?part rdf:type nltl:intermediateIceFrame ;
                      nltl:hasLowerEnd ?lower .

                FILTER NOT EXISTS {
                    ?lower nltl:hasAttachedSupportingStructure ?attached .
                    ?attached rdf:type ?attachedType .
                    FILTER (
                        ?attachedType IN (
                            nltl:deckStructure,
                            nltl:tankTop,
                            nltl:tankBoundaryPlating,
                            nltl:iceStringer
                        )
                    )
                }

                FILTER NOT EXISTS {
                    ?lower nltl:hasTerminationBelowSupportingStructure ?support ;
                           nltl:hasHorizontalConnectionMember ?member .
                    ?support rdf:type ?supportType .
                    FILTER (
                        ?supportType IN (
                            nltl:deckStructure,
                            nltl:tankTop,
                            nltl:tankBoundaryPlating,
                            nltl:iceStringer
                        )
                    )
                    ?member rdf:type nltl:horizontalConnectionMember ;
                            nltl:connectsToAdjacentMainFrame ?adjacent .
                    ?adjacent rdf:type nltl:mainFrame .
                    $this nltl:supportingStructureAtOrBelowIceBeltLowerLimit
                        "true"^^xsd:boolean ;
                        nltl:sameScantlingsAsMainFrame
                        "true"^^xsd:boolean .
                }
            }
        """
    ] .
