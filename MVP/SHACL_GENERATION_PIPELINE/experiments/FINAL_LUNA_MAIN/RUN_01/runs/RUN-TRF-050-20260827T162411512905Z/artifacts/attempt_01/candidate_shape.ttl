@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF050FrameAttachmentRecordShape
    a sh:NodeShape ;
    sh:targetClass nltl:frameAttachmentRecord ;
    sh:property [
        sh:path [
            sh:inversePath nltl:frameAttachment
        ] ;
        sh:class nltl:frame ;
        sh:minCount 1 ;
        sh:message "Each frame attachment record must be linked from a frame."
    ] ;
    sh:property [
        sh:path nltl:frameShellWeldType ;
        sh:datatype nltl:weldTypeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:doubleContinuousWeld ;
        sh:message "The frame must be attached to the shell by a double continuous weld."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shellPlateButtCrossing ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:scallopingPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shellPlateButtCrossing ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:scallopingPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "Scalloping is not allowed unless the frame crosses a shell plate butt."
            ]
        ]
    ) .
