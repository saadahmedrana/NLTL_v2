@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DegreeQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF052FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:frameAsymmetrical ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameWebAngleToShell ;
        sh:node gen:DegreeQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:antitrippingSupportSpacing ;
        sh:node gen:MillimetreQuantityShape ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:equivalentSupportStatusByDirectCalculation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:bowRegion
            nltl:midbodyRegion
            nltl:sternRegion
            nltl:otherIceStrengthenedAreaValue
        )
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The applicable antitripping spacing or support-region scope is missing or non-conforming." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this
WHERE {
    $this nltl:equivalentSupportStatusByDirectCalculation ?alternative ;
          nltl:frameAsymmetrical ?asymmetrical ;
          nltl:frameWebAngleToShell ?angleQuantity ;
          nltl:frameSpan ?spanQuantity ;
          nltl:iceClass ?ice .

    ?angleQuantity qudt:numericValue ?angle .
    ?spanQuantity qudt:numericValue ?span .

    FILTER(
        ?alternative != true &&
        (
            (
                (?asymmetrical = true || ?angle < 90) &&
                (
                    NOT EXISTS {
                        $this nltl:antitrippingSupportSpacing ?spacingQuantity .
                        ?spacingQuantity qudt:numericValue ?spacing .
                    }
                    ||
                    EXISTS {
                        $this nltl:antitrippingSupportSpacing ?spacingQuantity2 .
                        ?spacingQuantity2 qudt:numericValue ?spacing2 .
                        FILTER(?spacing2 > 1300)
                    }
                )
            )
            ||
            (
                ?span > 4 &&
                (
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:bowRegion }
                    ||
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion }
                    ||
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:sternRegion }
                    ||
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue }
                )
            )
            ||
            (
                ?span <= 4 &&
                ?ice = nltl:iceClassIaSuper &&
                (
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:bowRegion }
                    ||
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion }
                    ||
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:sternRegion }
                    ||
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue }
                )
            )
            ||
            (
                ?span <= 4 &&
                ?ice = nltl:iceClassIa &&
                (
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:bowRegion }
                    ||
                    NOT EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion }
                )
            )
            ||
            (
                ?span <= 4 &&
                (?ice = nltl:iceClassIb || ?ice = nltl:iceClassIc) &&
                NOT EXISTS {
                    $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                }
            )
        )
    )
}
"""
    ] .
