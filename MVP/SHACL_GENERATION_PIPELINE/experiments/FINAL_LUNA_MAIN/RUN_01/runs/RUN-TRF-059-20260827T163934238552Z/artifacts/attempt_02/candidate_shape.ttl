@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

gen:TRF059WebFrameShearAreaShape
    a sh:NodeShape ;
    sh:targetClass nltl:webFrame ;
    sh:property [
        sh:path nltl:maximumCalculatedShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each web frame must provide one maximum calculated shear force in kN." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webFrameShearFactorAlpha ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each web frame must provide one dimensionless shear factor alpha." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each web frame must provide one yield strength in MPa." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:freeFlangeToWebAreaRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each web frame must provide one dimensionless free-flange-to-web area ratio." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each web frame must provide one required shear area in cm2." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The shear factor alpha must match Table 4-8 for the supplied free-flange-to-web area ratio, and required shear area must equal sqrt(3) times alpha times 1.1 times maximum shear force in MN divided by yield strength, converted to cm2; calculated decimal equality is checked with a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl/vocab#maximumCalculatedShearForce> ?forceQuantity ;
                      <https://w3id.org/nltl/vocab#webFrameShearFactorAlpha> ?alphaQuantity ;
                      <https://w3id.org/nltl/vocab#yieldStrength> ?yieldQuantity ;
                      <https://w3id.org/nltl/vocab#freeFlangeToWebAreaRatio> ?ratioQuantity ;
                      <https://w3id.org/nltl/vocab#requiredShearArea> ?areaQuantity .
                ?forceQuantity <http://qudt.org/schema/qudt/numericValue> ?force .
                ?alphaQuantity <http://qudt.org/schema/qudt/numericValue> ?alpha .
                ?yieldQuantity <http://qudt.org/schema/qudt/numericValue> ?yield .
                ?ratioQuantity <http://qudt.org/schema/qudt/numericValue> ?ratio .
                ?areaQuantity <http://qudt.org/schema/qudt/numericValue> ?area .
                BIND (1.7320508075688772 * ?alpha * 1.1 * (?force / 1000) / ?yield * 10000 AS ?expected)
                FILTER (
                    !(
                        (?ratio = 0.0 && ?alpha = 1.5) ||
                        (?ratio = 0.2 && ?alpha = 1.23) ||
                        (?ratio = 0.4 && ?alpha = 1.16) ||
                        (?ratio = 0.6 && ?alpha = 1.11) ||
                        (?ratio = 0.8 && ?alpha = 1.09) ||
                        (?ratio = 1.0 && ?alpha = 1.07) ||
                        (?ratio = 1.2 && ?alpha = 1.06) ||
                        (?ratio = 1.4 && ?alpha = 1.05) ||
                        (?ratio = 1.6 && ?alpha = 1.05) ||
                        (?ratio = 1.8 && ?alpha = 1.04) ||
                        (?ratio = 2.0 && ?alpha = 1.04)
                    ) ||
                    ABS(?area - ?expected) >
                    (0.000001 * ABS(?expected) + 0.000000001)
                )
            }
        """
    ] .
