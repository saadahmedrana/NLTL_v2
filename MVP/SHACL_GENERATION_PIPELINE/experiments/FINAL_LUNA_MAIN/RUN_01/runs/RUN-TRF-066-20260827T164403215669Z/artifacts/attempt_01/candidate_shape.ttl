@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF066ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "The ship must have one permitted ice-class value."
    ] ;
    sh:or (
        gen:TRF066ApplicablePracticableShape
        gen:TRF066ApplicableNotPracticableShape
        gen:TRF066NotApplicableShape
    ) .

gen:TRF066ApplicablePracticableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIaSuper
        )
    ] ;
    sh:property [
        sh:path nltl:iceKnifePracticable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "For ice class IA or IA Super, ice-knife practicability must be recorded."
    ] ;
    sh:property [
        sh:path nltl:hasRudderProtectionArrangement ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:iceKnife ;
            sh:property [
                sh:path nltl:extendsBelowLowerIceWaterline ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "A practicable ice knife must extend below the lower ice waterline."
            ]
        ] ;
        sh:message "For ice class IA or IA Super where an ice knife is practicable, the rudder protection arrangement must include a compliant ice knife."
    ] .

gen:TRF066ApplicableNotPracticableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIaSuper
        )
    ] ;
    sh:property [
        sh:path nltl:iceKnifePracticable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "For ice class IA or IA Super, ice-knife practicability must be recorded."
    ] ;
    sh:property [
        sh:path nltl:hasRudderProtectionArrangement ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:equivalentRudderProtectionMeans
        ] ;
        sh:message "When an ice knife is not practicable, an equivalent rudder protection means must be provided."
    ] .

gen:TRF066NotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] .
