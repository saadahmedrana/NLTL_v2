@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF066Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lowerIceWaterline ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must record its lower ice waterline."
    ] ;
    sh:property [
        sh:path nltl:iceKnifePracticable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in ( nltl:iceClassIa nltl:iceClassIaSuper )
            ] ;
            sh:property [
                sh:path nltl:iceKnifePracticable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:iceKnife ;
                    sh:property [
                        sh:path nltl:extendsBelowLowerIceWaterline ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in ( nltl:iceClassIa nltl:iceClassIaSuper )
            ] ;
            sh:property [
                sh:path nltl:iceKnifePracticable ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:equivalentRudderProtectionMeans
                ]
            ]
        ]
        [
            sh:not [
                sh:property [
                    sh:path nltl:iceClass ;
                    sh:in ( nltl:iceClassIa nltl:iceClassIaSuper )
                ]
            ]
        ]
    ) ;
    sh:message "For ice classes IA and IA Super, the rudder protection arrangement must use a practicable ice knife extending below the lower ice waterline or equivalent means." .
