@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF069Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "An ice class is required to determine applicability of the propulsion-machinery rule."
    ] ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "A propeller type is required to determine applicability of the propulsion-machinery rule."
    ] ;
    sh:property [
        sh:path nltl:pitchType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "A pitch type is required to determine applicability of the propulsion-machinery rule."
    ] ;
    sh:sparql [
        sh:message "For an applicable propulsion arrangement, the design condition shall record normal operational service-life propeller and ice loads, including fixed-pitch propeller reversal loads, and shall exclude stopped-propeller dragging and radial ice-entry loads from the prescribed model scope." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:propellerType ?propellerType ;
                      nltl:pitchType ?pitchType .

                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                    &&
                    ?propellerType IN ("open", "ducted")
                    &&
                    ?pitchType IN ("controllable", "fixed")
                )

                FILTER NOT EXISTS {
                    $this nltl:hasDesignCondition ?designCondition .
                    ?designCondition
                        nltl:normalOperationalConditions true ;
                        nltl:normalServiceLifePropellerIceLoadCondition true ;
                        nltl:fixedPitchPropellerReversalLoadIncluded true ;
                        nltl:stoppedPropellerDraggingOutsideLoadModel true ;
                        nltl:radialIceEntryOutsideLoadModel true .
                }
            }
        """
    ] .
