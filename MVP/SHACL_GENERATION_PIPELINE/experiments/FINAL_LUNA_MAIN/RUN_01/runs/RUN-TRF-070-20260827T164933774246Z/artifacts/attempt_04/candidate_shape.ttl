@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/vocab/unit/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF070Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:thrusterType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Thruster type is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:mainPropulsionThruster ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Main-propulsion status is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:thrusterType ;
                sh:in ( "azimuthing" "fixed" )
            ] ;
            sh:property [
                sh:path nltl:mainPropulsionThruster ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:propellerIceInteractionLoad ;
                sh:node gen:KiloNewtonQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An applicable thruster requires the propeller/ice interaction load."
            ] ;
            sh:property [
                sh:path nltl:thrusterBodyIceInteractionLoad ;
                sh:node gen:KiloNewtonQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An applicable thruster requires the thruster-body/ice interaction load."
            ] ;
            sh:property [
                sh:path nltl:localIcePressure ;
                sh:node gen:MegaPascalQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An applicable thruster requires the local ice pressure."
            ] ;
            sh:property [
                sh:path nltl:serviceLife ;
                sh:node gen:YearQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An applicable thruster requires the ship service life."
            ] ;
            sh:property [
                sh:path nltl:extremeLoad ;
                sh:node gen:KiloNewtonQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An applicable thruster requires the extreme-load design condition."
            ] ;
            sh:property [
                sh:path nltl:thrusterBodyLocalStrength ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The applicable thruster body must satisfy the local-strength condition."
            ] ;
            sh:property [
                sh:path nltl:hasDesignCondition ;
                sh:class nltl:designCondition ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:designConditionExpectedLoad ;
                        sh:node gen:KiloNewtonQuantityShape ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "The design condition requires the expected thruster-body load."
                    ] ;
                    sh:property [
                        sh:path nltl:normalOperationalConditions ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "The expected thruster-body load must be identified for normal operational conditions."
                    ] ;
                    sh:property [
                        sh:path nltl:designConditionLocalStrengthCapacity ;
                        sh:node gen:KiloNewtonQuantityShape ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "The design condition requires the externally assessed local-strength capacity."
                    ]
                ]
            ] ;
            sh:sparql [
                sh:message "The thruster-body local-strength capacity must be at least the local ice pressure." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX q: <http://qudt.org/vocab/unit/>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:localIcePressure ?pressureNode .
                        ?pressureNode qudt:numericValue ?pressure .
                        ?pressureNode qudt:unit q:MegaPA .
                        $this nltl:hasDesignCondition ?condition .
                        ?condition nltl:designConditionLocalStrengthCapacity ?capacityNode .
                        ?capacityNode qudt:numericValue ?capacity .
                        ?capacityNode qudt:unit q:KiloN .
                        FILTER (?capacity < ?pressure)
                    }
                """
            ]
        ]
        [
            sh:or (
                [
                    sh:sparql [
                        sh:message "A non-applicable ship must not have an applicable thruster type." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:thrusterType ?type .
                                FILTER (?type IN ("azimuthing", "fixed"))
                            }
                        """
                    ]
                ]
                [
                    sh:sparql [
                        sh:message "A non-applicable ship must not identify its propulsion thruster as main propulsion." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:mainPropulsionThruster ?mainPropulsion .
                                FILTER (?mainPropulsion = true)
                            }
                        """
                    ]
                ]
            )
        ]
    ) .

gen:KiloNewtonQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue q:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaPascalQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue q:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:YearQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue q:YR ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
