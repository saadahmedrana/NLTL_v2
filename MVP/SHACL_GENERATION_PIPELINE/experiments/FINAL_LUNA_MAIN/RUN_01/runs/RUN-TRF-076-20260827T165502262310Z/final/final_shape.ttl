@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:PropellerBladeLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each propeller blade load case must have exactly one integer load case number."
    ] .

gs:LoadCaseNumber1Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1 ;
        sh:maxInclusive 1
    ] .

gs:LoadCaseNumber2Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 2 ;
        sh:maxInclusive 2
    ] .

gs:LoadCaseNumber3Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 3 ;
        sh:maxInclusive 3
    ] .

gs:LoadCaseNumber4Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] .

gs:LoadCaseNumber5Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 5 ;
        sh:maxInclusive 5
    ] .

gs:RequiredLoadCases1To4Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:node gs:PropellerBladeLoadCaseShape ;
        sh:qualifiedValueShape gs:LoadCaseNumber1Shape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Propeller blade load case 1 must be covered."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:node gs:PropellerBladeLoadCaseShape ;
        sh:qualifiedValueShape gs:LoadCaseNumber2Shape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Propeller blade load case 2 must be covered."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:node gs:PropellerBladeLoadCaseShape ;
        sh:qualifiedValueShape gs:LoadCaseNumber3Shape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Propeller blade load case 3 must be covered."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:node gs:PropellerBladeLoadCaseShape ;
        sh:qualifiedValueShape gs:LoadCaseNumber4Shape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Propeller blade load case 4 must be covered."
    ] .

gs:CPPropellerShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "CP"^^xsd:string
    ] ;
    sh:node gs:RequiredLoadCases1To4Shape .

gs:FPNonReversingPropellerShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "FP"^^xsd:string
    ] ;
    sh:property [
        sh:path nltl:propellerReversingCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] ;
    sh:node gs:RequiredLoadCases1To4Shape .

gs:FPReversingPropellerShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "FP"^^xsd:string
    ] ;
    sh:property [
        sh:path nltl:propellerReversingCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:node gs:RequiredLoadCases1To4Shape ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:node gs:PropellerBladeLoadCaseShape ;
        sh:qualifiedValueShape gs:LoadCaseNumber5Shape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Load case 5 must be covered for a reversing FP propeller."
    ] .

gs:FPPropellerShape
    a sh:NodeShape ;
    sh:or (
        gs:FPNonReversingPropellerShape
        gs:FPReversingPropellerShape
    ) .

gs:TRF076PropellerBladeLoadCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:CPPropellerShape
        gs:FPPropellerShape
    ) ;
    sh:message "The ship must identify a CP or FP propeller and cover the required propeller blade load cases."
    .
