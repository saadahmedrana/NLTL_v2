@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-086> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single propeller type must be provided."
    ] ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single pitch-value-known boolean must be provided."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a CP propeller, the applicable pitch quantity is missing or does not use a decimal value in metres." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:propellerType "CP" ;
        nltl:pitchValueKnown ?known .
  FILTER (
    (?known = true &&
      NOT EXISTS {
        $this nltl:propellerPitchAtMcrBollard ?q .
        ?q qudt:numericValue ?v ;
           qudt:unit unit:M .
        FILTER(datatype(?v) = xsd:decimal)
      })
    ||
    (?known = false &&
      (
        NOT EXISTS {
          $this nltl:propellerPitchAtMcrBollard ?qb .
          ?qb qudt:numericValue ?vb ;
             qudt:unit unit:M .
          FILTER(datatype(?vb) = xsd:decimal)
        }
        ||
        NOT EXISTS {
          $this nltl:propellerPitchAtMcrFreeRunning ?qf .
          ?qf qudt:numericValue ?vf ;
             qudt:unit unit:M .
          FILTER(datatype(?vf) = xsd:decimal)
        }
      ))
  )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a CP propeller with unknown pitch, propeller pitch at MCR in bollard condition must equal 0.7 times the free-running value within the permitted numerical tolerance." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:propellerType "CP" ;
        nltl:pitchValueKnown false ;
        nltl:propellerPitchAtMcrBollard ?qb ;
        nltl:propellerPitchAtMcrFreeRunning ?qf .
  ?qb qudt:numericValue ?vb ;
      qudt:unit unit:M .
  ?qf qudt:numericValue ?vf ;
      qudt:unit unit:M .
  FILTER(datatype(?vb) = xsd:decimal)
  FILTER(datatype(?vf) = xsd:decimal)
  BIND((0.7 * ?vf) AS ?expected)
  FILTER(
    ABS(?vb - ?expected) >
    ((ABS(?expected) * 0.000001) + 0.000000000001)
  )
}
"""
    ] .
