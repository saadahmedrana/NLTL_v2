@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF088Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:TRF088KnownShape
        gen:TRF088UnknownShape
    ) .

gen:TRF088KnownShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:maximumEngineTorqueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Maximum engine torque knowledge status must be explicitly recorded."
    ] .

gen:TRF088UnknownShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:maximumEngineTorqueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The maximum engine torque knowledge status must be false for the Table 6-10 rule to apply."
    ] ;
    sh:property [
        sh:path nltl:maximumEngineTorque ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF088TorqueQuantityShape ;
        sh:message "When maximum engine torque is unknown, a maximum engine torque quantity in kN*m must be provided."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:minCount 1 ;
        sh:node gen:TRF088LookupCaseShape ;
        sh:message "When maximum engine torque is unknown, a Table 6-10 lookup case with its selection evidence and reference must be provided."
    ] .

gen:TRF088TorqueQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Maximum engine torque must have one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:KiloN-M ;
        sh:message "Maximum engine torque must use the kN*m unit."
    ] .

gen:TRF088LookupCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:tableLookupApplied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The Table 6-10 lookup case must record that the table lookup was applied."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:traficomTable6Dash10 ;
        sh:message "The lookup case must reference TRAFICOM Table 6-10."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "The Table 6-10 lookup selection must have supporting evidence."
    ] .
