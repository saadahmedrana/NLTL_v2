@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF091ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:minCount 1 ;
        sh:message "The ship must identify the ice-milling load sequence case."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCase ;
        sh:node gen:TRF091PropulsionLoadCaseShape ;
        sh:minCount 1 ;
        sh:message "The ship must identify the propulsion load case used for the strength evaluation."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each propulsion strength-evaluation load case must be the ice-milling load sequence case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasPropulsionLoadCase ?propulsionCase .
                FILTER NOT EXISTS {
                    $this nltl:hasIceMillingSequenceCase ?propulsionCase .
                }
            }
        """
    ] .

gen:TRF091PropulsionLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:loadCasePurpose ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCasePurposeValue ;
        sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
        sh:minCount 1 ;
        sh:message "The propulsion load case must be used for propulsion-line strength evaluation."
    ] ;
    sh:not [
        sh:property [
            sh:path nltl:loadCasePurpose ;
            sh:hasValue nltl:stallingAnalysisPurposeValue
        ]
    ] .
