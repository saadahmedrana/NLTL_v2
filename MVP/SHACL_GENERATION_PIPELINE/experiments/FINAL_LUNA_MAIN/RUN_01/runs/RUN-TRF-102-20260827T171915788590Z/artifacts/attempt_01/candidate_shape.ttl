@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-102-Shape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [ sh:node <urn:nltl:generated-shape:TRF-102-FormulaCase> ]
        [ sh:node <urn:nltl:generated-shape:TRF-102-AnalysisCase> ]
    ) .

<urn:nltl:generated-shape:TRF-102-AnalysisCase> a sh:NodeShape ;
    sh:property [
        sh:path nltl:approvedSpindleTorqueStressAnalysis ;
        sh:class nltl:approvalRecord ;
        sh:minCount 1 ;
        sh:message "An approved spindle torque stress analysis is required when the direct-analysis alternative is used."
    ] ;
    sh:property [
        sh:path nltl:maximumSpindleTorque ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN-M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The maximum spindle torque determined by stress analysis must be supplied in kN*m."
    ] .

<urn:nltl:generated-shape:TRF-102-FormulaCase> a sh:NodeShape ;
    sh:property [
        sh:path nltl:bladeExpandedAreaRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerBladeCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:leadingEdgeChordPortionAtZeroPointEightRadius ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:trailingEdgeChordPortionAtZeroPointEightRadius ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:extremeIceForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bladeFailureSpindleTorqueFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bladeFailureSpindleTorque ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN-M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:maximumSpindleTorque ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN-M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The spindle torque factor and spindle torque results must satisfy the declared blade-failure formula within a relative tolerance of 1e-6, with an absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeExpandedAreaRatio ?earNode ;
                      nltl:propellerBladeCount ?z ;
                      nltl:leadingEdgeChordPortionAtZeroPointEightRadius ?leNode ;
                      nltl:trailingEdgeChordPortionAtZeroPointEightRadius ?teNode ;
                      nltl:extremeIceForce ?forceNode ;
                      nltl:bladeFailureSpindleTorqueFactor ?factorNode ;
                      nltl:bladeFailureSpindleTorque ?failureNode ;
                      nltl:maximumSpindleTorque ?maximumNode .

                ?earNode qudt:numericValue ?ear .
                ?leNode qudt:numericValue ?le .
                ?teNode qudt:numericValue ?te .
                ?forceNode qudt:numericValue ?force .
                ?factorNode qudt:numericValue ?factor .
                ?failureNode qudt:numericValue ?failure .
                ?maximumNode qudt:numericValue ?maximum .

                BIND (0.7 * (1 - ((4 * ?ear) / ?z) * ((4 * ?ear) / ?z) * ((4 * ?ear) / ?z)) AS ?rawFactor)
                BIND (IF(?rawFactor < 0.3, 0.3, ?rawFactor) AS ?expectedFactor)
                BIND (IF(?le > (0.8 * ?te), ?le, (0.8 * ?te)) * ?expectedFactor * ?force AS ?expectedTorque)

                FILTER (
                    ABS(?factor - ?expectedFactor) >
                    (0.000001 * ABS(?expectedFactor) + 0.000000001)
                    ||
                    ABS(?failure - ?expectedTorque) >
                    (0.000001 * ABS(?expectedTorque) + 0.000000001)
                    ||
                    ABS(?maximum - ?expectedTorque) >
                    (0.000001 * ABS(?expectedTorque) + 0.000000001)
                )
            }
        """
    ] .
