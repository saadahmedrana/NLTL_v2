@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF102Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:TRF102FormulaBranch
        gs:TRF102AnalysisBranch
    ) .

gs:TRF102FormulaBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:bladeExpandedAreaRatio ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerBladeCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:leadingEdgeChordPortionAtZeroPointEightRadius ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:trailingEdgeChordPortionAtZeroPointEightRadius ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:extremeIceForce ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bladeFailureSpindleTorqueFactor ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bladeFailureSpindleTorque ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN-M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The blade failure spindle torque factor and torque must satisfy the prescribed calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bladeExpandedAreaRatio ?earNode ;
                      nltl:propellerBladeCount ?z ;
                      nltl:leadingEdgeChordPortionAtZeroPointEightRadius ?leNode ;
                      nltl:trailingEdgeChordPortionAtZeroPointEightRadius ?teNode ;
                      nltl:extremeIceForce ?forceNode ;
                      nltl:bladeFailureSpindleTorqueFactor ?factorNode ;
                      nltl:bladeFailureSpindleTorque ?torqueNode .

                ?earNode qudt:numericValue ?ear ;
                         qudt:unit unit:UNITLESS .
                ?leNode qudt:numericValue ?le ;
                        qudt:unit unit:M .
                ?teNode qudt:numericValue ?te ;
                        qudt:unit unit:M .
                ?forceNode qudt:numericValue ?force ;
                            qudt:unit unit:KiloN .
                ?factorNode qudt:numericValue ?factor ;
                             qudt:unit unit:UNITLESS .
                ?torqueNode qudt:numericValue ?torque ;
                             qudt:unit unit:KiloN-M .

                BIND(
                    IF(
                        0.7 * (1 - (((4 * ?ear) / ?z) * ((4 * ?ear) / ?z) * ((4 * ?ear) / ?z))) >= 0.3,
                        0.7 * (1 - (((4 * ?ear) / ?z) * ((4 * ?ear) / ?z) * ((4 * ?ear) / ?z))),
                        0.3
                    )
                    AS ?expectedFactor
                )
                BIND(
                    IF(
                        ?le >= 0.8 * ?te,
                        ?le,
                        0.8 * ?te
                    ) * ?expectedFactor * ?force
                    AS ?expectedTorque
                )

                BIND(
                    IF(?expectedFactor >= 0, ?expectedFactor, 0 - ?expectedFactor)
                    AS ?factorMagnitude
                )
                BIND(
                    IF(
                        ?factorMagnitude > 0.000000001,
                        0.000001 * ?factorMagnitude,
                        0.000000001
                    )
                    AS ?factorTolerance
                )

                BIND(
                    IF(?expectedTorque >= 0, ?expectedTorque, 0 - ?expectedTorque)
                    AS ?torqueMagnitude
                )
                BIND(
                    IF(
                        ?torqueMagnitude > 0.000000001,
                        0.000001 * ?torqueMagnitude,
                        0.000000001
                    )
                    AS ?torqueTolerance
                )

                FILTER(
                    (?factor > ?expectedFactor + ?factorTolerance) ||
                    (?factor < ?expectedFactor - ?factorTolerance) ||
                    (?torque > ?expectedTorque + ?torqueTolerance) ||
                    (?torque < ?expectedTorque - ?torqueTolerance)
                )
            }
        """
    ] .

gs:TRF102AnalysisBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:approvedSpindleTorqueStressAnalysis ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:approvalRecord
        ]
    ] ;
    sh:property [
        sh:path nltl:maximumSpindleTorque ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN-M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
