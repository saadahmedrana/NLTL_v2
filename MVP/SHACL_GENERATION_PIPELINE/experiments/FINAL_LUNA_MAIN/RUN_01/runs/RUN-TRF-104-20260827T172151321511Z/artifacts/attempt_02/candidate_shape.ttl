@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-104-Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:pyramidStrengthPrinciple ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ship shall record that its propulsion line is designed according to the pyramid strength principle."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:minCount 1 ;
        sh:message "The ship shall identify at least one propeller shaft line component."
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoss ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "When propeller blade loss occurs, no linked propeller shaft line component may have significant damage from blade loss." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerBladeLoss true .
                $this nltl:hasPropellerShaftLineComponent ?component .
                FILTER NOT EXISTS {
                    ?component nltl:significantDamageFromBladeLoss false .
                }
            }
        """
    ] .
