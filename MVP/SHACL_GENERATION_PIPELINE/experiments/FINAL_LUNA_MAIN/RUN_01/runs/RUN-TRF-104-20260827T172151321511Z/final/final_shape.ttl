@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF104ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:minCount 1 ;
        sh:class nltl:propellerShaftLineComponent ;
        sh:node gen:TRF104ShaftLineComponentShape ;
        sh:message "The ship shall have at least one propeller shaft line component conforming to the blade-loss damage constraint."
    ] .

gen:TRF104ShaftLineComponentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:significantDamageFromBladeLoss ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "A propeller shaft line component shall record that propeller blade loss causes no significant damage."
    ] .
