@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF111ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:extremeIceForce ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship shall provide the extreme ice force as a QUDT quantity in kN."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:class nltl:loadCase ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:shaftLineLoadCaseType ;
                sh:class nltl:shaftLineLoadCaseTypeValue ;
                sh:minCount 1 ;
                sh:or (
                    [
                        sh:hasValue nltl:extremeOperationalLoadCase ;
                        sh:property [
                            sh:path nltl:componentYieldSafetyFactor ;
                            sh:class qudt:QuantityValue ;
                            sh:minCount 1 ;
                            sh:node [
                                sh:property [
                                    sh:path qudt:numericValue ;
                                    sh:datatype xsd:decimal ;
                                    sh:minInclusive 1.3 ;
                                    sh:minCount 1 ;
                                    sh:maxCount 1
                                ] ;
                                sh:property [
                                    sh:path qudt:unit ;
                                    sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:minCount 1 ;
                                    sh:maxCount 1
                                ]
                            ] ;
                            sh:message "The component yield safety factor for an extreme operational load shall be at least 1.3."
                        ]
                    ]
                    [
                        sh:hasValue nltl:fatigueLoadCase
                    ]
                    [
                        sh:hasValue nltl:bladeFailureLoadCase ;
                        sh:property [
                            sh:path nltl:componentYieldSafetyFactor ;
                            sh:class qudt:QuantityValue ;
                            sh:minCount 1 ;
                            sh:node [
                                sh:property [
                                    sh:path qudt:numericValue ;
                                    sh:datatype xsd:decimal ;
                                    sh:minInclusive 1.0 ;
                                    sh:minCount 1 ;
                                    sh:maxCount 1
                                ] ;
                                sh:property [
                                    sh:path qudt:unit ;
                                    sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:minCount 1 ;
                                    sh:maxCount 1
                                ]
                            ] ;
                            sh:message "The component yield safety factor for a blade failure load shall be at least 1.0."
                        ]
                    ]
                )
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:class nltl:propellerShaftLineComponent ;
        sh:minCount 1 ;
        sh:message "The ship shall identify its propeller shaft line components."
    ] .
