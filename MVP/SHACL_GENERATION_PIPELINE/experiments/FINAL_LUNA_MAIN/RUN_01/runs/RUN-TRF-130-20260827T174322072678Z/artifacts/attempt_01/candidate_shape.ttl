@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PowerQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloW ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:VolumeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AreaQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:RatioQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:StandardInletChestShape
    a sh:NodeShape ;
    sh:class nltl:inletChest ;
    sh:property [
        sh:path nltl:seaInletLocation ;
        sh:datatype xsd:string ;
        sh:hasValue "near centreline and well aft if possible" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The inlet chest sea inlet shall be near the centreline and well aft if possible."
    ] ;
    sh:property [
        sh:path nltl:iceAccumulationSpaceAboveInlet ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:fullCapacityDischargePipeConnected ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:recommendedChestVolume ;
        sh:node gen:VolumeQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:seaChestVolume ;
        sh:node gen:VolumeQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:strainerOpenArea ;
        sh:node gen:AreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:inletPipeArea ;
        sh:node gen:AreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:strainerOpenAreaRatio ;
        sh:node gen:RatioQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The inlet chest volume shall approximately equal total relevant engine power divided by 750, and the strainer open area shall be at least four times the inlet pipe area; the reported area ratio shall correspond to the two areas." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship nltl:hasComponent $this .
                ?ship nltl:totalRelevantEnginePower ?powerQ .
                ?powerQ qudt:numericValue ?power .
                $this nltl:recommendedChestVolume ?volumeQ .
                ?volumeQ qudt:numericValue ?volume .
                $this nltl:strainerOpenArea ?openQ .
                ?openQ qudt:numericValue ?open .
                $this nltl:inletPipeArea ?pipeQ .
                ?pipeQ qudt:numericValue ?pipe .
                $this nltl:strainerOpenAreaRatio ?ratioQ .
                ?ratioQ qudt:numericValue ?ratio .
                BIND((?power / 750) AS ?expectedVolume)
                BIND((?open / ?pipe) AS ?expectedRatio)
                FILTER(
                    ABS(?volume - ?expectedVolume) >
                    IF(ABS(?expectedVolume) > 0,
                       ABS(?expectedVolume) * 0.000001,
                       0.000000001)
                    ||
                    ?open < (4 * ?pipe)
                    ||
                    ABS(?ratio - ?expectedRatio) >
                    IF(ABS(?expectedRatio) > 0,
                       ABS(?expectedRatio) * 0.000001,
                       0.000000001)
                )
            }
        """
    ] .

gen:AlternativeInletChestShape
    a sh:NodeShape ;
    sh:class nltl:inletChest ;
    sh:property [
        sh:path nltl:seaInletLocation ;
        sh:datatype xsd:string ;
        sh:hasValue "near centreline and well aft if possible" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:alternatingCoolingWaterIntakeAndDischarge ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:fullCapacityDischargePipeConnected ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:seaChestVolume ;
        sh:node gen:VolumeQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:recommendedChestVolume ;
        sh:node gen:VolumeQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:strainerOpenArea ;
        sh:node gen:AreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:inletPipeArea ;
        sh:node gen:AreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:strainerOpenAreaRatio ;
        sh:node gen:RatioQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each alternating inlet chest shall have a strainer open area at least four times the inlet pipe area, with a corresponding reported area ratio." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:strainerOpenArea ?openQ .
                ?openQ qudt:numericValue ?open .
                $this nltl:inletPipeArea ?pipeQ .
                ?pipeQ qudt:numericValue ?pipe .
                $this nltl:strainerOpenAreaRatio ?ratioQ .
                ?ratioQ qudt:numericValue ?ratio .
                BIND((?open / ?pipe) AS ?expectedRatio)
                FILTER(
                    ?open < (4 * ?pipe)
                    ||
                    ABS(?ratio - ?expectedRatio) >
                    IF(ABS(?expectedRatio) > 0,
                       ABS(?expectedRatio) * 0.000001,
                       0.000000001)
                )
            }
        """
    ] .

gen:TRF130Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:node gen:PowerQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:totalRelevantEnginePower ;
        sh:node gen:PowerQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:qualifiedValueShape [
                    sh:class nltl:inletChest ;
                    sh:node gen:StandardInletChestShape
                ] ;
                sh:qualifiedMinCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:coolingWaterChestAlternativeArrangementUsed ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:qualifiedValueShape [
                    sh:class nltl:inletChest ;
                    sh:node gen:AlternativeInletChestShape
                ] ;
                sh:qualifiedMinCount 2
            ]
        ]
    ) .
