@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_131_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:substituteArrangementStatus ;
        sh:datatype xsd:boolean ;
        sh:message "A ballast-water cooling arrangement must not be recorded as a substitute for an inlet chest."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ballast-water cooling arrangement must not be accepted as a substitute for an inlet chest." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:substituteArrangementStatus ?status .
                FILTER (?status = true)
            }
        """
    ] .
