@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:BowSubregionCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowSubregionCalculationEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Each bow subregion calculation case must provide calculation evidence."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each bow subregion must report one midpoint position in metres."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each bow subregion must report one dimensionless load patch aspect ratio."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each bow subregion must report one calculated force in MN."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each bow subregion must report one calculated line load in MN/m."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each bow subregion must report one calculated pressure in MPa."
    ] .

gs:I2_014_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4 ;
        sh:message "The bow region must be divided into four subregions."
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node gs:BowSubregionCalculationCaseShape ;
        sh:message "The ship must provide exactly four bow subregion calculation cases."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The selected maximum bow force must be reported in MN."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The selected maximum bow line load must be reported in MN/m."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The selected maximum bow pressure must be reported in MPa."
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowForce must equal the maximum calculated force across the four bow subregions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedNode .
                ?selectedNode qudt:numericValue ?selected .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionCalculatedForce ?valueNode .
                    ?valueNode qudt:numericValue ?value .
                    FILTER (?value = ?selected)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case2 .
                    ?case2 nltl:bowSubregionCalculatedForce ?greaterNode .
                    ?greaterNode qudt:numericValue ?greater .
                    FILTER (?greater > ?selected)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowLineLoad must equal the maximum calculated line load across the four bow subregions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowLineLoad ?selectedNode .
                ?selectedNode qudt:numericValue ?selected .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionCalculatedLineLoad ?valueNode .
                    ?valueNode qudt:numericValue ?value .
                    FILTER (?value = ?selected)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case2 .
                    ?case2 nltl:bowSubregionCalculatedLineLoad ?greaterNode .
                    ?greaterNode qudt:numericValue ?greater .
                    FILTER (?greater > ?selected)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowPressure must equal the maximum calculated pressure across the four bow subregions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowPressure ?selectedNode .
                ?selectedNode qudt:numericValue ?selected .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionCalculatedPressure ?valueNode .
                    ?valueNode qudt:numericValue ?value .
                    FILTER (?value = ?selected)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case2 .
                    ?case2 nltl:bowSubregionCalculatedPressure ?greaterNode .
                    ?greaterNode qudt:numericValue ?greater .
                    FILTER (?greater > ?selected)
                }
            }
        """
    ] .
