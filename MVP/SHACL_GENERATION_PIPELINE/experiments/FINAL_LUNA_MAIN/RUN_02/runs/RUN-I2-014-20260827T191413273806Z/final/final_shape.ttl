@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_014_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each ship must provide one bow length quantity in metres."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4 ;
        sh:message "The bow region must contain four subregions."
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node gen:I2_014_CaseShape ;
        sh:message "Each ship must have exactly four bow subregion calculation cases."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The selected maximum bow force is required in MN."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The selected maximum bow line load is required in MN/m."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The selected maximum bow pressure is required in MPa."
    ] ;
    sh:sparql [
        sh:message "The four bow subregion mid-length positions must correspond to LBOW/8, 3*LBOW/8, 5*LBOW/8, and 7*LBOW/8, within a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength ?lengthQuantity ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?lengthQuantity qudt:numericValue ?lbow .

                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case1 .
                    ?case1 nltl:bowSubregionMidLengthPosition ?midQuantity1 .
                    ?midQuantity1 qudt:numericValue ?mid1 .
                    FILTER (
                        ?mid1 >= (?lbow / 8 - ((?lbow / 8) * 0.000001 + 0.000000001)) &&
                        ?mid1 <= (?lbow / 8 + ((?lbow / 8) * 0.000001 + 0.000000001))
                    )
                }
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case2 .
                    ?case2 nltl:bowSubregionMidLengthPosition ?midQuantity2 .
                    ?midQuantity2 qudt:numericValue ?mid2 .
                    FILTER (
                        ?mid2 >= (3 * ?lbow / 8 - ((3 * ?lbow / 8) * 0.000001 + 0.000000001)) &&
                        ?mid2 <= (3 * ?lbow / 8 + ((3 * ?lbow / 8) * 0.000001 + 0.000000001))
                    )
                }
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case3 .
                    ?case3 nltl:bowSubregionMidLengthPosition ?midQuantity3 .
                    ?midQuantity3 qudt:numericValue ?mid3 .
                    FILTER (
                        ?mid3 >= (5 * ?lbow / 8 - ((5 * ?lbow / 8) * 0.000001 + 0.000000001)) &&
                        ?mid3 <= (5 * ?lbow / 8 + ((5 * ?lbow / 8) * 0.000001 + 0.000000001))
                    )
                }
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case4 .
                    ?case4 nltl:bowSubregionMidLengthPosition ?midQuantity4 .
                    ?midQuantity4 qudt:numericValue ?mid4 .
                    FILTER (
                        ?mid4 >= (7 * ?lbow / 8 - ((7 * ?lbow / 8) * 0.000001 + 0.000000001)) &&
                        ?mid4 <= (7 * ?lbow / 8 + ((7 * ?lbow / 8) * 0.000001 + 0.000000001))
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Selected maximum bow force, line load, and pressure must match the corresponding maximum case value within tolerance scaled from the expected maximum." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedForceQuantity ;
                      nltl:selectedMaximumBowLineLoad ?selectedLineQuantity ;
                      nltl:selectedMaximumBowPressure ?selectedPressureQuantity .
                ?selectedForceQuantity qudt:numericValue ?selectedForce .
                ?selectedLineQuantity qudt:numericValue ?selectedLine .
                ?selectedPressureQuantity qudt:numericValue ?selectedPressure .

                {
                    SELECT $this (MAX(?force) AS ?maxForce)
                           (MAX(?line) AS ?maxLine)
                           (MAX(?pressure) AS ?maxPressure)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedForce ?forceQuantity ;
                              nltl:bowSubregionCalculatedLineLoad ?lineQuantity ;
                              nltl:bowSubregionCalculatedPressure ?pressureQuantity .
                        ?forceQuantity qudt:numericValue ?force .
                        ?lineQuantity qudt:numericValue ?line .
                        ?pressureQuantity qudt:numericValue ?pressure .
                    }
                    GROUP BY $this
                }

                FILTER (
                    ?selectedForce < (?maxForce - (?maxForce * 0.000001 + 0.000000001)) ||
                    ?selectedForce > (?maxForce + (?maxForce * 0.000001 + 0.000000001)) ||
                    ?selectedLine < (?maxLine - (?maxLine * 0.000001 + 0.000000001)) ||
                    ?selectedLine > (?maxLine + (?maxLine * 0.000001 + 0.000000001)) ||
                    ?selectedPressure < (?maxPressure - (?maxPressure * 0.000001 + 0.000000001)) ||
                    ?selectedPressure > (?maxPressure + (?maxPressure * 0.000001 + 0.000000001))
                )
            }
        """
    ] .

gen:I2_014_CaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculationEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1
    ] .
