@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_018_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceLoadPatch ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:iceLoadPatch
        ] ;
        sh:message "The ship must identify a design ice load patch."
    ] ;
    sh:property [
        sh:path nltl:hasPeakPressureFactorLookupCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:peakPressureFactorLookupCase ;
            sh:property [
                sh:path nltl:localizedStructuralMemberCategory ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:bottomStructureFrameCategory
                    nltl:longitudinallyFramedPlatingCategory
                    nltl:stringerSideLongitudinalOrWebFrameCategory
                    nltl:transverseFrameWithLoadDistributingStringersCategory
                    nltl:transverseFrameWithoutLoadDistributingStringersCategory
                    nltl:transverselyFramedPlatingCategory
                ) ;
                sh:message "The localized structural member category must be one of the permitted structural-member categories."
            ] ;
            sh:property [
                sh:path nltl:selectedPeakPressureFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "Each peak-pressure lookup case must provide one dimensionless selected peak pressure factor."
            ]
        ] ;
        sh:message "The ship must provide a peak-pressure factor lookup case."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:tableLookupCase ;
            sh:property [
                sh:path nltl:tableReference ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:hasValue nltl:iacsUrI2Table3 ;
                sh:message "The peak-pressure-factor lookup must reference IACS UR I2 Table 3."
            ] ;
            sh:property [
                sh:path nltl:lookupSelectionEvidence ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:evidenceArtifact
                ] ;
                sh:message "The table lookup must have selection evidence."
            ]
        ] ;
        sh:message "The ship must provide a table lookup case for the peak pressure factor."
    ] ;
    sh:property [
        sh:path nltl:iceForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "averageIcePressure must equal iceForce divided by loadPatchHeight and loadPatchLength, converted from kN/m2 to MPa, within numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceForce ?forceQuantity ;
                      nltl:loadPatchHeight ?heightQuantity ;
                      nltl:loadPatchLength ?lengthQuantity ;
                      nltl:averageIcePressure ?pressureQuantity .
                ?forceQuantity qudt:numericValue ?force .
                ?heightQuantity qudt:numericValue ?height .
                ?lengthQuantity qudt:numericValue ?length .
                ?pressureQuantity qudt:numericValue ?reported .
                FILTER (?height != 0)
                FILTER (?length != 0)
                BIND ((?force / (?height * ?length)) / 1000 AS ?expected)
                FILTER (ABS(?reported - ?expected) > ((ABS(?expected) * 0.000001) + 0.000000001))
            }
        """
    ] .
