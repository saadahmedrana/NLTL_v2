@prefix generated: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

generated:I2_019_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node generated:I2_019_StructuralMemberShape
    ] .

generated:I2_019_StructuralMemberShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasSpannedHullArea ;
                sh:maxCount 0 ;
                sh:message "A structural member without a spanned hull area is not subject to the maximum hull area factor check."
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasSpannedHullArea ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:hullAreaValue ;
                    sh:property [
                        sh:path nltl:hullAreaFactor ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:UNITLESS ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:selectedHullAreaFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:sparql [
                sh:message "selectedHullAreaFactor must equal the maximum reached hullAreaFactor within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-6." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        {
                            SELECT $this ?selectedNode ?selectedNumeric
                                   (MAX(?factorNumeric) AS ?maximumFactor)
                            WHERE {
                                $this nltl:hasSpannedHullArea ?area .
                                ?area nltl:hullAreaFactor ?factorNode .
                                ?factorNode qudt:numericValue ?factorNumeric .
                                $this nltl:selectedHullAreaFactor ?selectedNode .
                                ?selectedNode qudt:numericValue ?selectedNumeric .
                                FILTER (datatype(?factorNumeric) = xsd:decimal)
                                FILTER (datatype(?selectedNumeric) = xsd:decimal)
                            }
                            GROUP BY $this ?selectedNode ?selectedNumeric
                        }
                        FILTER (
                            ABS(?selectedNumeric - ?maximumFactor) >
                            (ABS(?maximumFactor) * 0.000001 + 0.000001)
                        )
                    }
                """
            ]
        ]
    ) .
