@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-030-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:node <urn:nltl:generated-shape:I2-030-CalculationCaseShape>
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node <urn:nltl:generated-shape:I2-030-StructuralMemberShape>
    ] .

<urn:nltl:generated-shape:I2-030-StructuralMemberShape>
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:netLocalFrameFlangeArea ;
        sh:node <urn:nltl:generated-shape:I2-030-AreaQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:node <urn:nltl:generated-shape:I2-030-LengthMillimetreQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:node <urn:nltl:generated-shape:I2-030-LengthMillimetreQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:node <urn:nltl:generated-shape:I2-030-LengthMillimetreQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:node <urn:nltl:generated-shape:I2-030-LengthMetreQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:localFrameFlangeCentreHeight ;
        sh:node <urn:nltl:generated-shape:I2-030-LengthMillimetreQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:webAngleToShellPlate ;
        sh:node <urn:nltl:generated-shape:I2-030-AngleQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:webToFlangeCentreDistance ;
        sh:node <urn:nltl:generated-shape:I2-030-LengthMillimetreQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:netEffectivePlasticSectionModulus ;
        sh:node <urn:nltl:generated-shape:I2-030-SectionModulusQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasLocalFrameSectionCalculationCase ;
        sh:node <urn:nltl:generated-shape:I2-030-LocalFrameSectionCalculationCaseShape>
    ] .

<urn:nltl:generated-shape:I2-030-LocalFrameSectionCalculationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:localFrameSectionCalculationCase ;
    sh:property [
        sh:path nltl:sectionCalculationCasePlating ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-PlatingShape>
    ] ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:minCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an area-exceeding local frame with oblique framing, interpolation endpoints and the conditional plastic-neutral-axis result must be represented by the linked calculation case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCaseStructuralMember ?member ;
                      nltl:sectionCalculationCasePlating ?plating .
                ?member nltl:netLocalFrameFlangeArea ?areaValue ;
                        nltl:netAttachedShellPlateThickness ?thicknessValue ;
                        nltl:frameSpacing ?spacingValue .
                ?areaValue qudt:numericValue ?area .
                ?thicknessValue qudt:numericValue ?thickness .
                ?spacingValue qudt:numericValue ?spacing .
                ?plating nltl:framingAngleOmega ?angleValue .
                ?angleValue qudt:numericValue ?angle .
                FILTER (
                    100 * ?area >
                    1000 * ?thickness * ?spacing &&
                    ?angle > 20 &&
                    ?angle < 70
                )
                FILTER NOT EXISTS {
                    ?calculationCase nltl:interpolationLowerEndpoint ?lower ;
                                      nltl:interpolationUpperEndpoint ?upper .
                    ?lower nltl:interpolationPointCoordinate ?lowerCoordinate ;
                           nltl:interpolationPointResult ?lowerResult .
                    ?upper nltl:interpolationPointCoordinate ?upperCoordinate ;
                           nltl:interpolationPointResult ?upperResult .
                }
            }
        """
    ] .

<urn:nltl:generated-shape:I2-030-PlatingShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:node <urn:nltl:generated-shape:I2-030-AngleQuantityShape> ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:I2-030-CalculationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:plasticNeutralAxisHeight ;
        sh:node <urn:nltl:generated-shape:I2-030-LengthMillimetreQuantityShape>
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable oblique-framing calculation case shall contain both interpolation endpoints and their coordinate and result values." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:interpolationLowerEndpoint ?lower ;
                      nltl:interpolationUpperEndpoint ?upper .
                ?lower nltl:interpolationPointCoordinate ?lowerCoordinate ;
                       nltl:interpolationPointResult ?lowerResult .
                ?upper nltl:interpolationPointCoordinate ?upperCoordinate ;
                       nltl:interpolationPointResult ?upperResult .
            }
        """
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:node <urn:nltl:generated-shape:I2-030-InterpolationPointShape>
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:node <urn:nltl:generated-shape:I2-030-InterpolationPointShape>
    ] .

<urn:nltl:generated-shape:I2-030-InterpolationPointShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:node <urn:nltl:generated-shape:I2-030-DimensionlessQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:node <urn:nltl:generated-shape:I2-030-NumericQuantityShape> ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:I2-030-NumericQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030-DimensionlessQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030-AreaQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030-LengthMillimetreQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030-LengthMetreQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030-AngleQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030-SectionModulusQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
