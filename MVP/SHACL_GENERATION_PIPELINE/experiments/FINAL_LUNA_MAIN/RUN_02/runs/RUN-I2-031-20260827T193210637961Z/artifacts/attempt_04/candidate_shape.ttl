@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_031_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:patchLoad ;
        sh:node gen:I2_031_KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall provide a patch load in kN."
    ] ;
    sh:property [
        sh:path nltl:plasticCollapseMechanism ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall identify the plastic collapse mechanism."
    ] ;
    sh:property [
        sh:path nltl:frameProfileType ;
        sh:class nltl:frameProfileTypeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall provide a frame profile type value."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:I2_031_StructuralMemberShape
    ] ;
    sh:sparql [
        sh:message "For every linked structural member load case, combined shear and bending demand shall not exceed plastic strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:plasticStrength ?strength ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .
                ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                ?strength qudt:numericValue ?strengthValue ;
                          qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                ?demand qudt:numericValue ?demandValue ;
                        qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                FILTER ( ?demandValue > ?strengthValue )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Plastic strength shall agree with the midspan plastic collapse load within a relative tolerance of 1e-6 with a small absolute fallback." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:plasticStrength ?strength ;
                        nltl:midspanPlasticCollapseLoad ?midspanLoad .
                ?strength qudt:numericValue ?strengthValue ;
                          qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                ?midspanLoad qudt:numericValue ?midspanValue ;
                             qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                FILTER (
                    ABS(?strengthValue - ?midspanValue) >
                    (ABS(?midspanValue) * 0.000001 + 0.000000001)
                )
            }
        """
    ] .

gen:I2_031_StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:structuralLocation ;
        sh:class nltl:structuralLocationValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each structural member shall identify its structural location."
    ] ;
    sh:property [
        sh:path nltl:plasticStrength ;
        sh:node gen:I2_031_KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each structural member shall provide its plastic strength in kN."
    ] ;
    sh:property [
        sh:path nltl:midspanPlasticCollapseLoad ;
        sh:node gen:I2_031_KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each structural member shall provide the midspan load causing plastic collapse in kN."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberLoadCase ;
        sh:node gen:I2_031_LoadCaseShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:structuralLocation ;
                sh:hasValue nltl:bottomStructureLocation
            ] ;
            sh:property [
                sh:path ( nltl:hasStructuralMemberLoadCase nltl:loadPatchOrientation ) ;
                sh:hasValue nltl:loadPatchHeightParallelToFrame ;
                sh:minCount 1 ;
                sh:message "For a bottom structural member, the patch load dimension b shall be parallel with the frame direction."
            ]
        ]
        [
            sh:property [
                sh:path nltl:structuralLocation ;
                sh:hasValue nltl:sideStructureLocation
            ] ;
            sh:property [
                sh:path nltl:transverseFrameOrientation ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A side structural member shall be identified as a transverse local frame."
            ]
        ]
    ) .

gen:I2_031_LoadCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:combinedShearAndBendingDemand ;
        sh:node gen:I2_031_KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each structural-member load case shall provide the combined shear and bending demand in kN."
    ] ;
    sh:property [
        sh:path nltl:loadPatchOrientation ;
        sh:class nltl:loadPatchOrientationValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each structural-member load case shall identify the load patch orientation."
    ] .

gen:I2_031_KiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
