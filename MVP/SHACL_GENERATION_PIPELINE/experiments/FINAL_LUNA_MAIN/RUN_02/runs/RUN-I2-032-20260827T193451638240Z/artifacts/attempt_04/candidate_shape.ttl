@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-032> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:structuralMember ;
            sh:property [
                sh:path nltl:frameSpacing ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:selectedHullAreaFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:requiredTransverseFrameShearArea ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:CentiM2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The required transverse frame shear area must equal the declared formula result within a relative tolerance of 1e-6 with a 1e-6 absolute fallback, and the actual shear area must be at least that result after converting m2 to cm2." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:averageIcePressure ?pressureValue ;
                       nltl:frameSpan ?frameSpanValue ;
                       nltl:loadPatchHeight ?loadHeightValue ;
                       nltl:peakPressureFactor ?peakFactorValue ;
                       nltl:shearArea ?shearAreaValue ;
                       nltl:span ?spanValue ;
                       nltl:yieldStrength ?yieldStrengthValue ;
                       nltl:hasStructuralMember ?member .

                ?pressureValue qudt:numericValue ?pressure ;
                               qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?frameSpanValue qudt:numericValue ?frameSpan ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                ?loadHeightValue qudt:numericValue ?loadHeight ;
                                 qudt:unit <http://qudt.org/vocab/unit/M> .
                ?peakFactorValue qudt:numericValue ?peakFactor ;
                                 qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?shearAreaValue qudt:numericValue ?shearArea ;
                                qudt:unit <http://qudt.org/vocab/unit/M2> .
                ?spanValue qudt:numericValue ?span ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                ?yieldStrengthValue qudt:numericValue ?yieldStrength ;
                                     qudt:unit <http://qudt.org/vocab/unit/MegaPA> .

                ?member nltl:frameSpacing ?spacingValue ;
                        nltl:selectedHullAreaFactor ?areaFactorValue ;
                        nltl:requiredTransverseFrameShearArea ?requiredAreaValue .

                ?spacingValue qudt:numericValue ?spacing ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .
                ?areaFactorValue qudt:numericValue ?areaFactor ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?requiredAreaValue qudt:numericValue ?requiredArea ;
                                    qudt:unit <http://qudt.org/vocab/unit/CentiM2> .

                BIND(IF(?frameSpan <= ?loadHeight, ?frameSpan, ?loadHeight) AS ?ll)
                BIND((10000 * 0.5 * ?ll * ?spacing *
                      (?areaFactor * ?peakFactor * ?pressure) /
                      (0.577 * ?yieldStrength)) AS ?expectedArea)
                BIND((ABS(?expectedArea) * 0.000001 + 0.000001) AS ?tolerance)

                FILTER (
                    ?requiredArea < (?expectedArea - ?tolerance) ||
                    ?requiredArea > (?expectedArea + ?tolerance) ||
                    (?shearArea * 10000) < ?requiredArea
                )
            }
        """
    ] .
