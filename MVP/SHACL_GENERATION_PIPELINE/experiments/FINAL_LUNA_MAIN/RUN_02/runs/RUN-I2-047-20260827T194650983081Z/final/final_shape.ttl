@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_047_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "An applicable ice-strengthened structure must be identified."
            ] ;
            sh:property [
                sh:path nltl:gaugedThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path q:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path q:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:netThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path q:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path q:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:steelRenewalRequired ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "For an ice-strengthened structure, steel renewal is required when gauged thickness is less than net thickness plus 0.0005 m." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasPlating ?plating .
                        ?plating nltl:iceStrengthenedStructureStatus "true"^^xsd:boolean .
                        $this nltl:gaugedThickness ?gaugedQuantity .
                        ?gaugedQuantity <http://qudt.org/schema/qudt/numericValue> ?gauged .
                        $this nltl:netThickness ?netQuantity .
                        ?netQuantity <http://qudt.org/schema/qudt/numericValue> ?net .
                        $this nltl:steelRenewalRequired ?renewal .
                        FILTER (?gauged < (?net + 0.0005))
                        FILTER (?renewal != "true"^^xsd:boolean)
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:message "The ice-strengthened structure applicability status must be true or false."
            ]
        ]
    ) .
