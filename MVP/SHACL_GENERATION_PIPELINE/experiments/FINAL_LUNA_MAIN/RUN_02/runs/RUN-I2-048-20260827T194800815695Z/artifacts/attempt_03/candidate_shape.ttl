@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-048-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeRequirementCase ;
        sh:node <urn:nltl:generated-shape:I2-048-CaseShape>
    ] .

<urn:nltl:generated-shape:I2-048-CaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-048-ThicknessShape>
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-048-GradeValueShape>
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-048-GradeValueShape>
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The required hull steel grade must follow Table 8 for the Polar Class, thickness, material class and strength category; an actual grade must be at least the required grade within its strength family." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  ?ship nltl:hasSteelGradeRequirementCase $this ;
        nltl:polarClass ?pc .
  $this nltl:asBuiltPlateThickness ?th ;
        nltl:steelMaterialClass ?mat ;
        nltl:steelStrengthCategory ?cat ;
        nltl:actualHullStructuralSteelGrade ?actual .
  ?th qudt:numericValue ?mm ;
      qudt:unit qudt-unit:MilliM .
  ?actual nltl:steelGradeOrderRank ?actualRank .
  OPTIONAL {
    $this nltl:requiredHullStructuralSteelGrade ?required .
    ?required nltl:steelGradeOrderRank ?requiredRank .
  }
  FILTER (
    (
      ?mm <= 10 &&
      (
        (?mat = nltl:steelMaterialClassOne &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?required = nltl:steelGradeB) ||
        (?mat = nltl:steelMaterialClassOne &&
         ?cat = nltl:highTensileSteelCategory &&
         ?required = nltl:steelGradeAh) ||
        (?mat = nltl:steelMaterialClassTwo &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?required = nltl:steelGradeB) ||
        (?mat = nltl:steelMaterialClassTwo &&
         ?cat = nltl:highTensileSteelCategory &&
         ?required = nltl:steelGradeAh) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeE) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeEh) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeB) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeAh)
      ) &&
      BOUND(?required) && ?actualRank >= ?requiredRank
    ) ||
    (
      ?mm > 10 && ?mm <= 15 &&
      (
        (?mat = nltl:steelMaterialClassOne &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?required = nltl:steelGradeB) ||
        (?mat = nltl:steelMaterialClassOne &&
         ?cat = nltl:highTensileSteelCategory &&
         ?required = nltl:steelGradeAh) ||
        (?mat = nltl:steelMaterialClassTwo &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeD) ||
        (?mat = nltl:steelMaterialClassTwo &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeDh) ||
        (?mat = nltl:steelMaterialClassTwo &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeB) ||
        (?mat = nltl:steelMaterialClassTwo &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeAh) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeE) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeEh) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeD) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeDh)
      ) &&
      BOUND(?required) && ?actualRank >= ?requiredRank
    ) ||
    (
      ?mm > 15 && ?mm <= 25 &&
      (
        (?mat IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeD) ||
        (?mat IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeDh) ||
        (?mat IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeB) ||
        (?mat IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeAh) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeE) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeEh) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeD) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeDh)
      ) &&
      BOUND(?required) && ?actualRank >= ?requiredRank
    ) ||
    (
      ?mm > 25 && ?mm <= 35 &&
      (
        (?mat = nltl:steelMaterialClassOne &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeD) ||
        (?mat = nltl:steelMaterialClassOne &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeDh) ||
        (?mat = nltl:steelMaterialClassOne &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeB) ||
        (?mat = nltl:steelMaterialClassOne &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeAh) ||
        (?mat = nltl:steelMaterialClassTwo &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeE) ||
        (?mat = nltl:steelMaterialClassTwo &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeEh) ||
        (?mat = nltl:steelMaterialClassTwo &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeD) ||
        (?mat = nltl:steelMaterialClassTwo &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeDh) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?required = nltl:steelGradeE) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:highTensileSteelCategory &&
         ?required = nltl:steelGradeEh)
      ) &&
      BOUND(?required) && ?actualRank >= ?requiredRank
    ) ||
    (
      ?mm > 35 && ?mm <= 40 &&
      (
        (?mat = nltl:steelMaterialClassOne &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?required = nltl:steelGradeD) ||
        (?mat = nltl:steelMaterialClassOne &&
         ?cat = nltl:highTensileSteelCategory &&
         ?required = nltl:steelGradeDh) ||
        (?mat = nltl:steelMaterialClassTwo &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeE) ||
        (?mat = nltl:steelMaterialClassTwo &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeEh) ||
        (?mat = nltl:steelMaterialClassTwo &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeD) ||
        (?mat = nltl:steelMaterialClassTwo &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeDh) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3) &&
         !BOUND(?required)) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3) &&
         ?required = nltl:steelGradeFh) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc4, nltl:polarClassPc5, nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeE) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc4, nltl:polarClassPc5, nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeEh)
      ) &&
      (
        (!BOUND(?required) &&
         ?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3)) ||
        (BOUND(?required) && ?actualRank >= ?requiredRank)
      )
    ) ||
    (
      ?mm > 40 && ?mm <= 45 &&
      (
        (?mat IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeE) ||
        (?mat IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeEh) ||
        (?mat IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeD) ||
        (?mat IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeDh) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3) &&
         !BOUND(?required)) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3) &&
         ?required = nltl:steelGradeFh) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc4, nltl:polarClassPc5, nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeE) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc4, nltl:polarClassPc5, nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeEh)
      ) &&
      (
        (!BOUND(?required) &&
         ?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3)) ||
        (BOUND(?required) && ?actualRank >= ?requiredRank)
      )
    ) ||
    (
      ?mm > 45 && ?mm <= 50 &&
      (
        (?mat IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeE) ||
        (?mat IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeEh) ||
        (?mat IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeD) ||
        (?mat IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeDh) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         !BOUND(?required)) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5) &&
         ?required = nltl:steelGradeFh) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeE) ||
        (?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
         ?required = nltl:steelGradeEh)
      ) &&
      (
        (!BOUND(?required) &&
         ?mat = nltl:steelMaterialClassThree &&
         ?cat = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5)) ||
        (BOUND(?required) && ?actualRank >= ?requiredRank)
      )
    )
  )
}
"""
    ] .

<urn:nltl:generated-shape:I2-048-ThicknessShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-048-GradeValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:steelGradeOrderRank ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
