@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:I2_050_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hullFormCoefficientKh ;
        sh:datatype qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:KhQuantityShape ;
        sh:message "The ship shall provide exactly one hull form coefficient kh with a dimensionless unit."
    ] ;
    sh:property [
        sh:path nltl:iceStrengthCoefficientKI ;
        sh:datatype qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:KIQuantityShape ;
        sh:message "The ship shall provide exactly one ice strength coefficient kI with a dimensionless unit."
    ] ;
    sh:property [
        sh:path nltl:stemAngle ;
        sh:datatype qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:StemAngleQuantityShape ;
        sh:message "The ship shall provide exactly one stem angle in degrees."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraughtDUI ;
        sh:datatype qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:DUIQuantityShape ;
        sh:message "The ship shall provide exactly one upper ice waterline draught in metres."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:minCount 1 ;
        sh:node nltlgen:I2_050_TableLookupCaseShape ;
        sh:message "The ship shall provide a table lookup case containing the required failure class factors."
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:DesignVerticalIceForceQuantityShape ;
        sh:message "The externally computed design vertical ice force at the bow shall be provided in meganewtons."
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBowCandidateOne ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:DesignVerticalIceForceQuantityShape ;
        sh:message "The externally computed first candidate design vertical ice force at the bow shall be provided in meganewtons."
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBowCandidateTwo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:DesignVerticalIceForceQuantityShape ;
        sh:message "The externally computed second candidate design vertical ice force at the bow shall be provided in meganewtons."
    ] .

nltlgen:I2_050_TableLookupCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:DimensionlessQuantityShape ;
        sh:message "Each table lookup case shall provide exactly one crushing failure class factor with a dimensionless unit."
    ] ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:DimensionlessQuantityShape ;
        sh:message "Each table lookup case shall provide exactly one flexural failure class factor with a dimensionless unit."
    ] ;
    sh:property [
        sh:path nltl:longitudinalStrengthClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:DimensionlessQuantityShape ;
        sh:message "Each table lookup case shall provide exactly one longitudinal strength class factor with a dimensionless unit."
    ] .

nltlgen:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:KhQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:KIQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:StemAngleQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:DUIQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:DesignVerticalIceForceQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
