@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 0
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node gs:CalculationCaseShape
    ] .

gs:CalculationCaseShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:hullGirderLongitudinalPositionFromAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 0
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:longitudinalDistributionFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:shearForceDirection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class nltl:shearForceDirectionValue ;
            sh:hasValue nltl:positiveShearForce
        ]
    ] ;
    sh:or (
        gs:PositiveShearLowerDistributionShape
        gs:PositiveShearUpperDistributionShape
    ) ;
    sh:sparql [
        sh:message "The design vertical ice shear force must equal the longitudinal distribution factor times the design vertical ice force at bow, with MN converted to kN and a relative tolerance of 1e-6 with a 1e-9 absolute fallback." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship nltl:hasCalculationCase $this ;
                      nltl:designVerticalIceForceAtBow ?fibQuantity ;
                      nltl:designVerticalIceShearForce ?fiQuantity .
                $this nltl:longitudinalDistributionFactor ?cfQuantity .
                ?fibQuantity <http://qudt.org/schema/qudt/numericValue> ?fib .
                ?fiQuantity <http://qudt.org/schema/qudt/numericValue> ?fi .
                ?cfQuantity <http://qudt.org/schema/qudt/numericValue> ?cf .
                BIND (?cf * ?fib * 1000 AS ?expected)
                FILTER (
                    ABS(?fi - ?expected) >
                    (1e-6 * ABS(?expected))
                    &&
                    ABS(?fi - ?expected) > 1e-9
                )
            }
        """
    ] .

gs:PositiveShearLowerDistributionShape a sh:NodeShape ;
    sh:sparql [
        sh:message "For positive shear force between the aft end and 0.6 LUI from aft, the longitudinal distribution factor must be 0.0." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity ;
                      nltl:longitudinalDistributionFactor ?cfQuantity .
                ?positionQuantity <http://qudt.org/schema/qudt/numericValue> ?position .
                ?cfQuantity <http://qudt.org/schema/qudt/numericValue> ?cf .
                ?ship nltl:hasCalculationCase $this ;
                      nltl:upperIceWaterlineLengthLUI ?lengthQuantity .
                ?lengthQuantity <http://qudt.org/schema/qudt/numericValue> ?length .
                FILTER (
                    !(
                        ?position >= 0 &&
                        ?position <= (0.6 * ?length) &&
                        ?cf = 0
                    )
                )
            }
        """
    ] .

gs:PositiveShearUpperDistributionShape a sh:NodeShape ;
    sh:sparql [
        sh:message "For positive shear force between 0.9 LUI from aft and the forward end of LUI, the longitudinal distribution factor must be 1.0." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity ;
                      nltl:longitudinalDistributionFactor ?cfQuantity .
                ?positionQuantity <http://qudt.org/schema/qudt/numericValue> ?position .
                ?cfQuantity <http://qudt.org/schema/qudt/numericValue> ?cf .
                ?ship nltl:hasCalculationCase $this ;
                      nltl:upperIceWaterlineLengthLUI ?lengthQuantity .
                ?lengthQuantity <http://qudt.org/schema/qudt/numericValue> ?length .
                FILTER (
                    !(
                        ?position >= (0.9 * ?length) &&
                        ?position <= ?length &&
                        ?cf = 1
                    )
                )
            }
        """
    ] .
