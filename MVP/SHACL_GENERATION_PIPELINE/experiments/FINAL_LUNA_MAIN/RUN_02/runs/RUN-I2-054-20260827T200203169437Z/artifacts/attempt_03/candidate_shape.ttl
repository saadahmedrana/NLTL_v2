@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

gen:ForceQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN>
    ] .

gen:AngleQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG>
    ] .

gen:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .

gen:TorqueQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN-M>
    ] .

gen:InterpolationPointShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:minCount 1
    ] .

gen:CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:hasInterpolationPoint ;
        sh:node gen:InterpolationPointShape ;
        sh:minCount 1
    ] .

gen:HullGirderCaseShape
    a sh:NodeShape ;
    sh:class nltl:hullGirderBendingMomentCalculationCase ;
    sh:property [
        sh:path nltl:caseHullGirderLongitudinalPositionFromAft ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:caseBendingMomentDistributionFactor ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:caseDesignVerticalIceBendingMoment ;
        sh:node gen:TorqueQuantityShape ;
        sh:minCount 1
    ] .

gen:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:stemAngle ;
        sh:node gen:AngleQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:node gen:ForceQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:node gen:CalculationCaseShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasHullGirderBendingMomentCalculationCase ;
        sh:node gen:HullGirderCaseShape ;
        sh:minCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The hull-girder calculation cases shall contain all five required C_m anchors: ratios 0.0, 0.5, 0.7, 0.95, and 1.0 of L_UI with C_m values 0.0, 1.0, 1.0, 0.3, and 0.0. Position ratios use an absolute tolerance of 1e-6; intermediate linear-interpolation cases remain permitted." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:upperIceWaterlineLengthLUI ?lNode .
                        ?lNode qudt:numericValue ?l .
                        $this nltl:hasHullGirderBendingMomentCalculationCase ?c0 .
                        ?c0 nltl:caseHullGirderLongitudinalPositionFromAft ?p0Node .
                        ?p0Node qudt:numericValue ?p0 .
                        ?c0 nltl:caseBendingMomentDistributionFactor ?m0Node .
                        ?m0Node qudt:numericValue ?m0 .
                        FILTER (ABS((?p0 / ?l) - 0.0) <= 0.000001 &&
                                ?m0 >= 0.0 && ?m0 <= 0.0)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:upperIceWaterlineLengthLUI ?lNode .
                        ?lNode qudt:numericValue ?l .
                        $this nltl:hasHullGirderBendingMomentCalculationCase ?c05 .
                        ?c05 nltl:caseHullGirderLongitudinalPositionFromAft ?p05Node .
                        ?p05Node qudt:numericValue ?p05 .
                        ?c05 nltl:caseBendingMomentDistributionFactor ?m05Node .
                        ?m05Node qudt:numericValue ?m05 .
                        FILTER (ABS((?p05 / ?l) - 0.5) <= 0.000001 &&
                                ?m05 >= 1.0 && ?m05 <= 1.0)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:upperIceWaterlineLengthLUI ?lNode .
                        ?lNode qudt:numericValue ?l .
                        $this nltl:hasHullGirderBendingMomentCalculationCase ?c07 .
                        ?c07 nltl:caseHullGirderLongitudinalPositionFromAft ?p07Node .
                        ?p07Node qudt:numericValue ?p07 .
                        ?c07 nltl:caseBendingMomentDistributionFactor ?m07Node .
                        ?m07Node qudt:numericValue ?m07 .
                        FILTER (ABS((?p07 / ?l) - 0.7) <= 0.000001 &&
                                ?m07 >= 1.0 && ?m07 <= 1.0)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:upperIceWaterlineLengthLUI ?lNode .
                        ?lNode qudt:numericValue ?l .
                        $this nltl:hasHullGirderBendingMomentCalculationCase ?c095 .
                        ?c095 nltl:caseHullGirderLongitudinalPositionFromAft ?p095Node .
                        ?p095Node qudt:numericValue ?p095 .
                        ?c095 nltl:caseBendingMomentDistributionFactor ?m095Node .
                        ?m095Node qudt:numericValue ?m095 .
                        FILTER (ABS((?p095 / ?l) - 0.95) <= 0.000001 &&
                                ?m095 >= 0.3 && ?m095 <= 0.3)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:upperIceWaterlineLengthLUI ?lNode .
                        ?lNode qudt:numericValue ?l .
                        $this nltl:hasHullGirderBendingMomentCalculationCase ?cf .
                        ?cf nltl:caseHullGirderLongitudinalPositionFromAft ?pfNode .
                        ?pfNode qudt:numericValue ?pf .
                        ?cf nltl:caseBendingMomentDistributionFactor ?mfNode .
                        ?mfNode qudt:numericValue ?mf .
                        FILTER (ABS((?pf / ?l) - 1.0) <= 0.000001 &&
                                ?mf >= 0.0 && ?mf <= 0.0)
                    }
                )
            }
        """
    ] .
