@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:I2-054-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/M>
            ]
        ] ;
        sh:message "The ship shall provide one upper ice waterline length in metres."
    ] ;
    sh:property [
        sh:path nltl:stemAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG>
            ]
        ] ;
        sh:message "The ship shall provide one stem angle in degrees."
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaN>
            ]
        ] ;
        sh:message "The ship shall provide one design vertical ice force at the bow in meganewtons."
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:calculationCase ;
            sh:property [
                sh:path nltl:hasInterpolationPoint ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:interpolationPoint
                ]
            ]
        ] ;
        sh:message "The ship shall provide a calculation case with interpolation-point data."
    ] ;
    sh:property [
        sh:path nltl:hasHullGirderBendingMomentCalculationCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:hullGirderBendingMomentCalculationCase
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The hull-girder calculation cases shall represent the five required C_m anchor cases." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this
WHERE {
    $this nltl:upperIceWaterlineLengthLUI ?lq .
    ?lq qudt:numericValue ?l .

    FILTER NOT EXISTS {
        $this nltl:hasHullGirderBendingMomentCalculationCase ?c .
        ?c nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
        ?pq qudt:numericValue ?p .
        ?c nltl:caseBendingMomentDistributionFactor ?mq .
        ?mq qudt:numericValue ?cm .
        FILTER (
            ?p >= (?l * -0.000001) &&
            ?p <= (?l * 0.000001) &&
            ?cm >= 0.0 && ?cm <= 0.0
        )
    }

    FILTER NOT EXISTS {
        $this nltl:hasHullGirderBendingMomentCalculationCase ?c .
        ?c nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
        ?pq qudt:numericValue ?p .
        ?c nltl:caseBendingMomentDistributionFactor ?mq .
        ?mq qudt:numericValue ?cm .
        FILTER (
            ?p >= (?l * 0.499999) &&
            ?p <= (?l * 0.500001) &&
            ?cm >= 1.0 && ?cm <= 1.0
        )
    }

    FILTER NOT EXISTS {
        $this nltl:hasHullGirderBendingMomentCalculationCase ?c .
        ?c nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
        ?pq qudt:numericValue ?p .
        ?c nltl:caseBendingMomentDistributionFactor ?mq .
        ?mq qudt:numericValue ?cm .
        FILTER (
            ?p >= (?l * 0.699999) &&
            ?p <= (?l * 0.700001) &&
            ?cm >= 1.0 && ?cm <= 1.0
        )
    }

    FILTER NOT EXISTS {
        $this nltl:hasHullGirderBendingMomentCalculationCase ?c .
        ?c nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
        ?pq qudt:numericValue ?p .
        ?c nltl:caseBendingMomentDistributionFactor ?mq .
        ?mq qudt:numericValue ?cm .
        FILTER (
            ?p >= (?l * 0.949999) &&
            ?p <= (?l * 0.950001) &&
            ?cm >= 0.3 && ?cm <= 0.3
        )
    }

    FILTER NOT EXISTS {
        $this nltl:hasHullGirderBendingMomentCalculationCase ?c .
        ?c nltl:caseHullGirderLongitudinalPositionFromAft ?pq .
        ?pq qudt:numericValue ?p .
        ?c nltl:caseBendingMomentDistributionFactor ?mq .
        ?mq qudt:numericValue ?cm .
        FILTER (
            ?p >= (?l * 0.999999) &&
            ?p <= (?l * 1.000001) &&
            ?cm >= 0.0 && ?cm <= 0.0
        )
    }
}
"""
    ] .

<urn:nltl:generated-shape:I2-054-CalculationCaseShape>
    a sh:NodeShape ;
    sh:targetClass nltl:calculationCase ;
    sh:property [
        sh:path nltl:hasInterpolationPoint ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:interpolationPoint
        ]
    ] .

<urn:nltl:generated-shape:I2-054-HullGirderCaseShape>
    a sh:NodeShape ;
    sh:targetClass nltl:hullGirderBendingMomentCalculationCase ;
    sh:property [
        sh:path nltl:caseHullGirderLongitudinalPositionFromAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/M>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:caseBendingMomentDistributionFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:caseDesignVerticalIceBendingMoment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaN-M>
            ]
        ] ;
        sh:message "Each hull-girder calculation case shall provide an externally computed design vertical ice bending moment in meganewton metres."
    ] .

<urn:nltl:generated-shape:I2-054-InterpolationPointShape>
    a sh:NodeShape ;
    sh:targetClass nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
