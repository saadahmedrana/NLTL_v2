@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:I2_065_ComplexReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:node [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:calculationMethod ;
                        sh:class nltl:calculationMethodValue ;
                        sh:hasValue nltl:nonlinearCalculationMethodValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:nonlinearAnalysisAcceptanceEvidence ;
                        sh:class nltl:evidenceArtifact ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:minorPermanentDeformationAssessmentSatisfied ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:permanentLateralDeformation ;
                        sh:class qudt:QuantityValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:permanentOutOfPlaneDeformation ;
                        sh:class qudt:QuantityValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:relevantStructuralDimension ;
                        sh:class qudt:QuantityValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
                [
                    sh:sparql [
                        sh:message "A calculation case must have a non-linear or another explicitly represented calculation method." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            SELECT $this
                            WHERE {
                                $this nltl:calculationMethod ?method .
                                FILTER (?method != nltl:nonlinearCalculationMethodValue)
                                FILTER NOT EXISTS {
                                    $this nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                                }
                            }
                        """
                    ]
                ]
            )
        ]
    ] ;
    sh:sparql [
        sh:message "A non-linear calculation case requires fracture, major buckling, and yielding margins on the ship, each with a unitless quantity value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                FILTER (
                    NOT EXISTS {
                        $this nltl:fractureMargin ?fracture .
                        ?fracture qudt:numericValue ?fractureValue .
                        ?fracture qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    }
                    || EXISTS {
                        $this nltl:fractureMargin ?fractureExtra .
                        ?fractureExtra qudt:unit ?fractureUnit .
                        FILTER (?fractureUnit != <http://qudt.org/vocab/unit/UNITLESS>)
                    }
                    || NOT EXISTS {
                        $this nltl:majorBucklingMargin ?buckling .
                        ?buckling qudt:numericValue ?bucklingValue .
                        ?buckling qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    }
                    || EXISTS {
                        $this nltl:majorBucklingMargin ?bucklingExtra .
                        ?bucklingExtra qudt:unit ?bucklingUnit .
                        FILTER (?bucklingUnit != <http://qudt.org/vocab/unit/UNITLESS>)
                    }
                    || NOT EXISTS {
                        $this nltl:yieldingMargin ?yielding .
                        ?yielding qudt:numericValue ?yieldingValue .
                        ?yielding qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    }
                    || EXISTS {
                        $this nltl:yieldingMargin ?yieldingExtra .
                        ?yieldingExtra qudt:unit ?yieldingUnit .
                        FILTER (?yieldingUnit != <http://qudt.org/vocab/unit/UNITLESS>)
                    }
                )
            }
        """
    ] .
