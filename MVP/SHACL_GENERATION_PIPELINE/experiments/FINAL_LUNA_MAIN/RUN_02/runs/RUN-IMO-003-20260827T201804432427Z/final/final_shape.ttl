@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO003ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceConditionValue ;
        sh:minCount 1 ;
        sh:message "A ship shall declare a design ice condition."
    ] ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarShipCategoryValue ;
        sh:minCount 1 ;
        sh:message "A ship shall declare its Polar Code ship category."
    ] ;
    sh:sparql [
        sh:message "A ship designed for open water or ice conditions less severe than categories A and B shall have Polar Code category C." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:designIceCondition ?condition .
                FILTER (
                    ?condition = nltl:openWaterIceCondition ||
                    ?condition = nltl:iceConditionLessSevereThanCategoryAAndB
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:shipCategory nltl:polarShipCategoryC .
                    }
                    ||
                    EXISTS {
                        $this nltl:shipCategory ?declaredCategory .
                        FILTER (?declaredCategory != nltl:polarShipCategoryC)
                    }
                )
            }
        """
    ] .
