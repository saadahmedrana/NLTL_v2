@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO007ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceConditionClassification ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:openWaterIceCondition ;
                sh:message "Open-water classification is required for the open-water branch."
            ] ;
            sh:property [
                sh:path nltl:seaIceConcentration ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:maxExclusive 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
                    ]
                ] ;
                sh:message "Open water requires sea-ice concentration below 1 with the canonical unitless QUDT unit."
            ] ;
            sh:property [
                sh:path nltl:iceOfLandOriginPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "Open water requires no ice of land origin."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceConditionClassification ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A non-open-water ice classification must be explicitly present."
            ] ;
            sh:sparql [
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceConditionClassification ?classification .
                        FILTER (?classification = nltl:openWaterIceCondition)
                    }
                """ ;
                sh:message "The non-open-water classification must differ from open water."
            ]
        ]
    ) .
