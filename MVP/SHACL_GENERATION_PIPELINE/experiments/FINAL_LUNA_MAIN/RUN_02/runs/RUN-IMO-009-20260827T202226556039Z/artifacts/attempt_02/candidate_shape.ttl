@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_009_BergyWatersShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:landOriginIceConcentration ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:totalIceConcentration ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "When ice condition is bergy waters, both ice concentrations are required and must satisfy their regulatory limits." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:iceCondition ?condition .
  FILTER (LCASE(STR(?condition)) = "bergy waters")
  FILTER (
    NOT EXISTS {
      $this nltl:landOriginIceConcentration ?landNode
    }
    ||
    EXISTS {
      $this nltl:landOriginIceConcentration ?landNode .
      ?landNode qudt:numericValue ?landValue .
      FILTER (?landValue >= 1)
    }
    ||
    NOT EXISTS {
      $this nltl:totalIceConcentration ?totalNode
    }
    ||
    EXISTS {
      $this nltl:totalIceConcentration ?totalNode .
      ?totalNode qudt:numericValue ?totalValue .
      FILTER (?totalValue > 1)
    }
  )
}
"""
    ] .
