@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO_030_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceOperationApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iceOperationApplicable must be recorded as a single boolean value."
    ] ;
    sh:or (
        gen:IMO_030_NotApplicableShape
        gen:IMO_030_ApplicableShape
    ) .

gen:IMO_030_NotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceOperationApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .

gen:IMO_030_ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceOperationApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:iceSafetyMonitoringProcedurePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When ice operations are applicable, an ice-safety monitoring procedure must be present."
    ] ;
    sh:property [
        sh:path nltl:escortRequirementsPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When ice operations are applicable, applicable escort or icebreaker-assistance requirements must be included."
    ] ;
    sh:or (
        gen:IMO_030_IndependentLimitsShape
        gen:IMO_030_EscortedLimitsShape
    ) .

gen:IMO_030_IndependentLimitsShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:independentOperationLimits ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "When the ship operates independently, independent-operation limitations must be specified."
    ] .

gen:IMO_030_EscortedLimitsShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:escortedOperationLimits ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "When the ship operates with icebreaker escort, escorted-operation limitations must be specified."
    ] .
