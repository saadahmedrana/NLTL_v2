@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_037_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryA ;
                sh:minCount 1 ;
                sh:message "Category A is required for this applicability branch."
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:minInclusive "2017-01-01"^^xsd:date ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:message "A construction date on or after 1 January 2017 is required."
            ] ;
            sh:property [
                sh:path nltl:hasLoadingConditionCase ;
                sh:class nltl:loadingConditionCase ;
                sh:minCount 1 ;
                sh:node gen:IMO_037_LoadingConditionCaseShape ;
                sh:message "At least one applicable loading-condition case is required."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryB ;
                sh:minCount 1 ;
                sh:message "Category B is required for this applicability branch."
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:minInclusive "2017-01-01"^^xsd:date ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:message "A construction date on or after 1 January 2017 is required."
            ] ;
            sh:property [
                sh:path nltl:hasLoadingConditionCase ;
                sh:class nltl:loadingConditionCase ;
                sh:minCount 1 ;
                sh:node gen:IMO_037_LoadingConditionCaseShape ;
                sh:message "At least one applicable loading-condition case is required."
            ]
        ]
    ) ;
    sh:message "The requirement applies to Category A or B ships constructed on or after 1 January 2017." .

gen:IMO_037_LoadingConditionCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadingConditionIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Each loading-condition case must identify its loading condition."
    ] ;
    sh:property [
        sh:path nltl:hasLoadingConditionResultEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Each loading-condition case must provide result evidence."
    ] ;
    sh:property [
        sh:path nltl:alternativeInstrumentApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message "Each loading-condition case must state whether the alternative instrument applies."
    ] ;
    sh:property [
        sh:path nltl:residualStabilityFactorSI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each loading-condition case must provide a dimensionless residual stability factor result."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:alternativeInstrumentApplicable ;
                sh:hasValue false ;
                sh:datatype xsd:boolean ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:residualStabilityFactorSI ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive 1 ;
                        sh:maxInclusive 1 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:alternativeInstrumentApplicable ;
                sh:hasValue true ;
                sh:datatype xsd:boolean ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:alternativeInstrumentResidualStabilityStatus ;
                sh:hasValue true ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The permitted alternative-instrument residual stability outcome must be compliant."
            ]
        ]
    ) ;
    sh:message "Each loading-condition case must either have residual stability factor s_i equal to one or satisfy the compliant alternative-instrument outcome." .
