@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO037ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:class nltl:polarShipCategoryValue ;
        sh:message "A ship category is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "A construction date is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:hasLoadingConditionCase ;
        sh:node gs:IMO037LoadingConditionCaseShape ;
        sh:class nltl:loadingConditionCase ;
        sh:message "Each represented loading condition must satisfy the residual-stability readiness condition."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB )
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:minInclusive "2017-01-01"^^xsd:date
            ]
        ]
        [
            sh:or (
                [
                    sh:sparql [
                        sh:message "The ship category must be outside categories A and B when the construction date does not establish applicability." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            SELECT $this
                            WHERE {
                                $this nltl:shipCategory ?category .
                                FILTER (?category NOT IN (
                                    nltl:polarShipCategoryA,
                                    nltl:polarShipCategoryB
                                ))
                            }
                        """
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:constructionDate ;
                        sh:maxInclusive "2016-12-31"^^xsd:date
                    ]
                ]
            )
        ]
    ) ;
    sh:message "The applicability branch for the ship category and construction date is not established." .

gs:IMO037LoadingConditionCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadingConditionIdentifier ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Each loading condition case requires an identifier."
    ] ;
    sh:property [
        sh:path nltl:alternativeInstrumentApplicable ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "Each loading condition case requires the alternative-instrument applicability input."
    ] ;
    sh:property [
        sh:path nltl:hasLoadingConditionResultEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Each loading condition result requires linked result evidence."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:alternativeInstrumentApplicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:alternativeInstrumentResidualStabilityStatus ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:message "The permitted alternative-instrument residual stability outcome must be compliant."
            ]
        ]
        [
            sh:property [
                sh:path nltl:alternativeInstrumentApplicable ;
                sh:hasValue false
            ] ;
            sh:node gs:IMO037ResidualStabilityResultShape
        ]
        [
            sh:property [
                sh:path nltl:alternativeInstrumentApplicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:alternativeInstrumentResidualStabilityStatus ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ] ;
            sh:node gs:IMO037ResidualStabilityResultShape
        ]
    ) ;
    sh:message "Each loading condition must provide either a compliant permitted alternative-instrument outcome or a residual stability factor result." .

gs:IMO037ResidualStabilityResultShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:residualStabilityFactorSI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue qudt:UNITLESS
            ]
        ] ;
        sh:message "The residual stability factor must be reported as a dimensionless quantity near the required result of 1, within a tolerance of 1e-6."
    ] ;
    sh:sparql [
        sh:message "The residual stability factor must equal 1 within an explicit absolute tolerance of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:residualStabilityFactorSI ?quantity .
                ?quantity qudt:numericValue ?value .
                FILTER (
                    ?value < "0.999999"^^xsd:decimal ||
                    ?value > "1.000001"^^xsd:decimal
                )
            }
        """
    ] .
