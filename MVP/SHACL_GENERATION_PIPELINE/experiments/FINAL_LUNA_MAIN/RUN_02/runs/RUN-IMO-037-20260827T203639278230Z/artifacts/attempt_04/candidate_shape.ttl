@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO037ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:class nltl:polarShipCategoryValue ;
        sh:minCount 1 ;
        sh:message "The ship must declare a canonical polar ship category."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "The ship must declare its construction date."
    ] ;
    sh:property [
        sh:path nltl:hasLoadingConditionCase ;
        sh:node gen:IMO037LoadingConditionCaseShape
    ] ;
    sh:or (
        gen:IMO037ApplicableShipShape
        gen:IMO037NonApplicableShipShape
    ) .

gen:IMO037ApplicableShipShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:class nltl:polarShipCategoryValue ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
        ) ;
        sh:minCount 1 ;
        sh:message "The applicable ship category must be Category A or Category B."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2017-01-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:message "An applicable Category A or B ship must have been constructed on or after 2017-01-01."
    ] .

gen:IMO037NonApplicableShipShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:class nltl:polarShipCategoryValue ;
        sh:in (
            nltl:polarShipCategoryC
        ) ;
        sh:minCount 1 ;
        sh:message "The non-applicable branch requires a category outside Categories A and B."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxInclusive "2016-12-31"^^xsd:date ;
        sh:minCount 1 ;
        sh:message "The non-applicable branch requires construction before 2017-01-01."
    ] .

gen:IMO037LoadingConditionCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadingConditionCase ;
    sh:property [
        sh:path nltl:loadingConditionIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Each loading condition case must have an identifier."
    ] ;
    sh:property [
        sh:path nltl:hasLoadingConditionResultEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Each loading condition case must have result evidence."
    ] ;
    sh:or (
        gen:IMO037ResidualStabilityOutcomeShape
        gen:IMO037AlternativeInstrumentOutcomeShape
    ) .

gen:IMO037ResidualStabilityOutcomeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:alternativeInstrumentApplicable ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:message "The residual-stability outcome requires the alternative instrument to be non-applicable."
    ] ;
    sh:property [
        sh:path nltl:residualStabilityFactorSI ;
        sh:minCount 1 ;
        sh:node gen:IMO037ResidualStabilityQuantityShape ;
        sh:message "The residual-stability outcome requires a residual stability factor within tolerance of 1."
    ] .

gen:IMO037AlternativeInstrumentOutcomeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:alternativeInstrumentApplicable ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "The alternative-instrument outcome requires the alternative instrument to be applicable."
    ] ;
    sh:property [
        sh:path nltl:alternativeInstrumentResidualStabilityStatus ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "The alternative-instrument residual stability status must be compliant."
    ] .

gen:IMO037ResidualStabilityQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "0.999999"^^xsd:decimal ;
        sh:maxInclusive "1.000001"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:message "The calculated residual stability factor must be within the permitted 1e-6 tolerance of 1."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The residual stability factor must use the dimensionless unit."
    ] .
