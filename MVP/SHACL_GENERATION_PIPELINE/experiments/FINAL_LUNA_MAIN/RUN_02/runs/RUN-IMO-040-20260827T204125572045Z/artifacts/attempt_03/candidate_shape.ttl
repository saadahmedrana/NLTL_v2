@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_040_RelevantHatchOrDoorItemShape
    a sh:NodeShape ;
    sh:class nltl:relevantHatchOrDoorItem ;
    sh:property [
        sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:node gs:IceSnowRemovalOrPreventionMeansShape ;
        sh:message "Each relevant hatch or door shall have an associated ice or snow removal or prevention means."
    ] .

gs:IceSnowRemovalOrPreventionMeansShape
    a sh:NodeShape ;
    sh:class nltl:iceSnowRemovalOrPreventionMeans .

gs:IMO_040_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ice accretion likelihood shall be recorded as one boolean value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasRelevantHatchOrDoor ;
                sh:node gs:IMO_040_RelevantHatchOrDoorItemShape
            ]
        ]
    ) .
