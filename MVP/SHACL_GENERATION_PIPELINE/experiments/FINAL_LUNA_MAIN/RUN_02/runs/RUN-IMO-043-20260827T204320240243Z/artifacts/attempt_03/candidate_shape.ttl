@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-043-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasMachineryInstallation ;
        sh:node <urn:nltl:generated-shape:IMO-043-InstallationShape> ;
        sh:message "Each machinery installation must satisfy the complete hazard-coverage constraint."
    ] .

<urn:nltl:generated-shape:IMO-043-InstallationShape> a sh:NodeShape ;
    sh:class nltl:machineryInstallationItem ;
    sh:property [
        sh:path nltl:hasAssociatedEquipment ;
        sh:class nltl:associatedEquipmentItem ;
        sh:message "Each linked associated equipment item must be represented as an associated equipment item."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:minCount 6 ;
        sh:maxCount 6 ;
        sh:message "Each machinery installation must identify the complete set of six applicable hazards."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:iceAccretionHazard ;
        sh:message "Ice accretion hazard coverage must be represented for the machinery installation."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:snowAccumulationHazard ;
        sh:message "Snow accumulation hazard coverage must be represented for the machinery installation."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:seawaterIceIngestionHazard ;
        sh:message "Seawater ice ingestion hazard coverage must be represented for the machinery installation."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:liquidFreezingOrViscosityIncreaseHazard ;
        sh:message "Liquid freezing or viscosity increase hazard coverage must be represented for the machinery installation."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:seawaterIntakeTemperatureHazard ;
        sh:message "Seawater intake temperature hazard coverage must be represented for the machinery installation."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:snowIngestionHazard ;
        sh:message "Snow ingestion hazard coverage must be represented for the machinery installation."
    ] ;
    sh:property [
        sh:path nltl:hasHazardProtectionEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Each machinery installation must have hazard-protection evidence."
    ] .
