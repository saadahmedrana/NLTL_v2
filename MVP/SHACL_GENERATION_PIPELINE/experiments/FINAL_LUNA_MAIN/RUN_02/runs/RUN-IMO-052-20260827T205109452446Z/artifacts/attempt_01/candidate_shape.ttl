@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-052-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasRequiredAccessItem ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:requiredAccessItem ;
        sh:node <urn:nltl:generated-shape:IMO-052-RequiredAccessItemShape>
    ] .

<urn:nltl:generated-shape:IMO-052-RequiredAccessItemShape>
    a sh:NodeShape ;
    sh:class nltl:equipmentItem ;
    sh:property [
        sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each required access item must have an associated ice or snow removal or prevention means."
    ] .
