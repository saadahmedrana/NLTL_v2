@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO059ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFirefighterOutfit ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:firefighterOutfitItem ;
        sh:node gen:IMO059FirefighterOutfitShape
    ] .

gen:IMO059FirefighterOutfitShape
    a sh:NodeShape ;
    sh:class nltl:firefighterOutfitItem , nltl:equipmentItem ;
    sh:property [
        sh:path nltl:hasStorageLocation ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:physicalStorageLocation ;
        sh:minCount 1 ;
        sh:node gen:IMO059StorageLocationShape ;
        sh:message "Each firefighter outfit must have a storage location classified as warm."
    ] .

gen:IMO059StorageLocationShape
    a sh:NodeShape ;
    sh:class nltl:physicalStorageLocation ;
    sh:property [
        sh:path nltl:storageTemperatureClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:storageTemperatureClassValue ;
        sh:minCount 1 ;
        sh:node [
            sh:hasValue nltl:warmStorageLocation
        ] ;
        sh:message "Each firefighter outfit storage location must be classified as warm."
    ] .
