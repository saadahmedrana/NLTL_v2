@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-068> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInIceCoveredWaters ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The ship's operation in ice-covered waters must be recorded as true when this applicability branch is used."
            ] ;
            sh:property [
                sh:path nltl:safeEvacuationMeansPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Safe evacuation means must be present when the requirement applies."
            ] ;
            sh:property [
                sh:path nltl:survivalEquipmentDeploymentApprovalStatus ;
                sh:minCount 1 ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "Survival equipment deployment approval status must be approved when the requirement applies."
            ]
        ]
        [
            sh:property [
                sh:path nltl:directEvacuationOntoIceApplicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Direct evacuation onto ice applicability must be recorded as true when this applicability branch is used."
            ] ;
            sh:property [
                sh:path nltl:safeEvacuationMeansPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Safe evacuation means must be present when the requirement applies."
            ] ;
            sh:property [
                sh:path nltl:survivalEquipmentDeploymentApprovalStatus ;
                sh:minCount 1 ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "Survival equipment deployment approval status must be approved when the requirement applies."
            ]
        ]
    ) .
