@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO068ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInIceCoveredWaters ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:directEvacuationOntoIceApplicable ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:safeEvacuationMeansPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:survivalEquipmentDeploymentApprovalStatus ;
        sh:class nltl:evidenceState
    ] ;
    sh:sparql [
        sh:message "When operating in ice-covered waters or evacuating directly onto ice, safe evacuation means and approved survival-equipment deployment evidence are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    EXISTS {
                        $this nltl:shipOperatesInIceCoveredWaters true .
                    }
                    ||
                    EXISTS {
                        $this nltl:directEvacuationOntoIceApplicable true .
                    }
                )
                FILTER (
                    ! EXISTS {
                        $this nltl:safeEvacuationMeansPresent true .
                    }
                    ||
                    ! EXISTS {
                        $this nltl:survivalEquipmentDeploymentApprovalStatus nltl:evidenceStateApproved .
                    }
                )
            }
        """
    ] .
