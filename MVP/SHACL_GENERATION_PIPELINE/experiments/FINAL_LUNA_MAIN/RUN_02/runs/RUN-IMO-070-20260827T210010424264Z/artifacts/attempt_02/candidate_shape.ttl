@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO070Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A passenger ship must have exactly one size compatibility status with value true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipType ?shipType .
                FILTER(?shipType = "passenger_ship")
                FILTER(
                    NOT EXISTS {
                        $this nltl:sizeCompatibilityStatus true
                    }
                    ||
                    EXISTS {
                        $this nltl:sizeCompatibilityStatus ?status .
                        FILTER(?status != true)
                    }
                    ||
                    EXISTS {
                        $this nltl:sizeCompatibilityStatus ?status1 .
                        $this nltl:sizeCompatibilityStatus ?status2 .
                        FILTER(?status1 != ?status2)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each person on board a passenger ship must have exactly one assignment containing exactly one properly sized immersion suit or thermal protective aid." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipType ?shipType .
                FILTER(?shipType = "passenger_ship")
                $this nltl:hasPersonOnBoardMember ?person .
                FILTER(
                    NOT EXISTS {
                        ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment
                    }
                    ||
                    EXISTS {
                        ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment1 .
                        ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment2 .
                        FILTER(?assignment1 != ?assignment2)
                    }
                    ||
                    EXISTS {
                        ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment .
                        FILTER(
                            NOT EXISTS {
                                ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment
                            }
                            ||
                            EXISTS {
                                ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment1 .
                                ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment2 .
                                FILTER(?equipment1 != ?equipment2)
                            }
                            ||
                            NOT EXISTS {
                                ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment .
                                ?equipment rdf:type ?equipmentType .
                                FILTER(
                                    ?equipmentType IN (
                                        nltl:immersionSuitEquipment,
                                        nltl:thermalProtectiveAidEquipment
                                    )
                                )
                            }
                        )
                    }
                )
            }
        """
    ] .
