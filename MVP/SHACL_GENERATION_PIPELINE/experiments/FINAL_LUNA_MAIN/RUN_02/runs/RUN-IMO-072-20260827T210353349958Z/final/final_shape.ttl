@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO-072-ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The extended darkness operation applicability value must be false when the requirement is not applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The extended darkness operation applicability value must be true to apply the searchlight requirement."
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasAssignedSearchlight ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path nltl:searchlightContinuousUseSuitabilityStatus ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue true ;
                                sh:message "Each assigned searchlight must be suitable for continuous use."
                            ]
                        ] ;
                        sh:message "Each lifeboat must have an assigned searchlight during extended darkness operation."
                    ]
                ]
            ]
        ]
    ) .
