@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_074_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:IMO_074_NotApplicableShape
        gs:IMO_074_ApplicableShape
    ) .

gs:IMO_074_NotApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:abandonmentOntoIceOrLandPotential ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "Abandonment onto ice or land potential must be recorded as false when the conditional requirement is not applicable."
    ] .

gs:IMO_074_ApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:abandonmentOntoIceOrLandPotential ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Abandonment onto ice or land potential must be recorded as true for the applicable conditional requirement."
    ] ;
    sh:or (
        gs:IMO_074_GroupEquipmentShape
        gs:IMO_074_EquivalentFunctionalityShape
    ) .

gs:IMO_074_GroupEquipmentShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:groupSurvivalEquipmentCarried ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Group survival equipment must be recorded as carried when abandonment onto ice or land is potentially required."
    ] .

gs:IMO_074_EquivalentFunctionalityShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:normalLifeSavingEquivalentFunctionalityApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "Approved equivalent functionality for survival must be recorded when group survival equipment is not the selected alternative."
    ] .
