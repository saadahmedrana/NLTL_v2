@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_082_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:solasRegulationV22Point1Point9Point4ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "SOLAS regulation V/22.1.9.4 compliance status must be true."
    ] ;
    sh:property [
        sh:path nltl:bridgeConfigurationType ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:bridgeConfigurationValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single bridge configuration type must be supplied and must be a bridge configuration value."
    ] ;
    sh:property [
        sh:path nltl:clearViewAsternStatus ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "Clear view astern status must be a single boolean value when supplied."
    ] ;
    sh:or (
        gen:IMO_082_ApplicableAsternViewBranch
        gen:IMO_082_NonApplicableAsternViewBranch
    ) .

gen:IMO_082_ApplicableAsternViewBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:bridgeConfigurationType ;
        sh:hasValue nltl:asternViewRequiredBridgeConfiguration ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:clearViewAsternStatus ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "When the bridge configuration requires an astern view, clear view astern status must be true."
    ] .

gen:IMO_082_NonApplicableAsternViewBranch a sh:NodeShape ;
    sh:sparql [
        sh:message "The bridge configuration does not require the conditional astern-view status." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:bridgeConfigurationType ?configuration .
                FILTER (?configuration != nltl:asternViewRequiredBridgeConfiguration)
            }
        """
    ] .
