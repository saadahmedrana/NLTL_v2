@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_083_AntennaIcePreventionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iceAccretionLikely must be recorded exactly once as a boolean."
    ] ;
    sh:xone (
        gen:IMO_083_NotLikelyBranch
        gen:IMO_083_LikelyBranch
    ) .

gen:IMO_083_NotLikelyBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:hasValue false
    ] .

gen:IMO_083_LikelyBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ;
        sh:class nltl:navigationOrCommunicationAntenna ;
        sh:node gen:IMO_083_RequiredAntennaShape ;
        sh:message "Every required navigation or communication antenna must have ice accumulation prevention."
    ] .

gen:IMO_083_RequiredAntennaShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:antennaIceAccumulationPreventionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The required antenna must have ice accumulation prevention present."
    ] .
