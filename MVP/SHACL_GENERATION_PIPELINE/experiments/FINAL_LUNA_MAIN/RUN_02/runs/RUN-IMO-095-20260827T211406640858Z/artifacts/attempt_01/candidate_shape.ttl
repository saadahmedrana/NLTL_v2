@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO095Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:searchAndRescueCommunicationCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall declare search and rescue communication capability."
    ] ;
    sh:property [
        sh:path nltl:rescueCoordinationCentreVoiceOrData ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall provide voice or data communications with relevant rescue coordination centres."
    ] ;
    sh:property [
        sh:path nltl:supportedAircraftVoiceFrequency ;
        sh:node gen:IMO095AircraftVoiceFrequencyQuantityShape ;
        sh:qualifiedValueShape gen:IMO095Aircraft1215QuantityShape ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShapesDisjoint false ;
        sh:message "The supported aircraft voice frequencies shall include 121.5 MHz."
    ] ;
    sh:property [
        sh:path nltl:supportedAircraftVoiceFrequency ;
        sh:node gen:IMO095AircraftVoiceFrequencyQuantityShape ;
        sh:qualifiedValueShape gen:IMO095Aircraft1231QuantityShape ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShapesDisjoint false ;
        sh:message "The supported aircraft voice frequencies shall include 123.1 MHz."
    ] .

gen:IMO095AircraftVoiceFrequencyQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaHZ>
    ] .

gen:IMO095Aircraft1215QuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 121.5 ;
        sh:maxInclusive 121.5
    ] .

gen:IMO095Aircraft1231QuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 123.1 ;
        sh:maxInclusive 123.1
    ] .
