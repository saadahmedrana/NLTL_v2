@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:IMO-097:> .

gen:IMO097Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO097FalseBranch
        gen:IMO097TrueBranch
    ) .

gen:IMO097FalseBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The ship must record that it does not operate in low air temperature when the conditional requirement is not applicable."
    ] .

gen:IMO097TrueBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record that it operates in low air temperature when this conditional requirement applies."
    ] ;
    sh:property [
        sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
        sh:class nltl:lifeboat ;
        sh:minCount 1 ;
        sh:message "At least one released rescue boat or lifeboat must be represented when the low-air-temperature condition applies."
    ] ;
    sh:property [
        sh:path nltl:hasSurvivalCraft ;
        sh:class nltl:survivalCraft ;
        sh:minCount 1 ;
        sh:message "At least one survival craft must be represented for the applicable communication-device checks."
    ] ;
    sh:property [
        sh:path nltl:hasLifeboat ;
        sh:class nltl:lifeboat
    ] ;
    sh:property [
        sh:path nltl:hasOtherSurvivalCraft ;
        sh:class nltl:otherSurvivalCraft
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every released rescue boat or lifeboat must carry at least one distress alert device." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:shipOperatesInLowAirTemperature true .
    $this nltl:hasRequiredRescueBoatOrLifeboat ?craft .
    FILTER NOT EXISTS {
        ?craft nltl:hasDistressAlertDevice ?device .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every applicable survival craft must carry at least one location signal device." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:shipOperatesInLowAirTemperature true .
    $this nltl:hasSurvivalCraft ?craft .
    FILTER NOT EXISTS {
        ?craft nltl:survivalCraftHasLocationSignalDevice ?device .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every applicable survival craft must carry at least one on-scene communication device." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:shipOperatesInLowAirTemperature true .
    $this nltl:hasSurvivalCraft ?craft .
    FILTER NOT EXISTS {
        ?craft nltl:survivalCraftHasOnSceneCommunicationDevice ?device .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every applicable survival craft must carry at least one ship-to-shore distress alert device." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:shipOperatesInLowAirTemperature true .
    $this nltl:hasSurvivalCraft ?craft .
    FILTER NOT EXISTS {
        ?craft nltl:survivalCraftHasShipToShoreDistressAlertDevice ?device .
    }
}
"""
    ] .
