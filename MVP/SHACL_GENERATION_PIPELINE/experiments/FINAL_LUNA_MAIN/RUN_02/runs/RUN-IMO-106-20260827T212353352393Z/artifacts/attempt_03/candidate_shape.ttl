@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_106_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:dischargedMaterialClassification ;
        sh:in (
            nltl:cleanBallastMaterial
            nltl:segregatedBallastMaterial
        ) ;
        sh:message "Any recorded discharged material classification must be clean ballast material or segregated ballast material."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the discharged material is clean or segregated ballast, polar Code paragraph 1.1.1 applicability must be recorded exactly once as false." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:dischargedMaterialClassification ?classification .
                FILTER (
                    ?classification = nltl:cleanBallastMaterial ||
                    ?classification = nltl:segregatedBallastMaterial
                ) .
                FILTER (
                    NOT EXISTS {
                        $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?applicability .
                    }
                    ||
                    EXISTS {
                        $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?firstApplicability .
                        $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?secondApplicability .
                        FILTER (?firstApplicability != ?secondApplicability)
                    }
                    ||
                    EXISTS {
                        $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?nonFalseApplicability .
                        FILTER (?nonFalseApplicability != false^^xsd:boolean)
                    }
                )
            }
        """
    ] .
