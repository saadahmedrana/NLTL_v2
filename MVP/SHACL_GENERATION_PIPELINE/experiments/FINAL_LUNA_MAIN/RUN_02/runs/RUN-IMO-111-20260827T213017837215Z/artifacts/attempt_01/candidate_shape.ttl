@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-111> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a Category A or B ship constructed on or after 1 January 2017, every oil residue or oily bilge water holding tank with capacity greater than 30 m3 must have an outer shell separation of at least 0.76 m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?constructionDate ;
                      nltl:hasComponent ?tank ;
                      nltl:individualTankCapacity ?capacityQuantity .

                ?tank rdf:type ?tankClass .

                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )
                FILTER (
                    ?tankClass IN (
                        nltl:oilResidueTank,
                        nltl:oilyBilgeWaterHoldingTank
                    )
                )
                FILTER (
                    ?constructionDate >= "2017-01-01"^^xsd:date
                )

                ?capacityQuantity qudt:numericValue ?capacityValue ;
                                   qudt:unit unit:M3 .

                FILTER (?capacityValue > 30)

                FILTER NOT EXISTS {
                    $this nltl:tankOuterShellSeparation ?separationQuantity .
                    ?separationQuantity qudt:numericValue ?separationValue ;
                                         qudt:unit unit:M .
                    FILTER (?separationValue >= 0.76)
                }
            }
        """ ;
    ] .
