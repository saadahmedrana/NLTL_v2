@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO111StaticShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have exactly one Category A or Category B ship category."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2017-01-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have exactly one construction date on or after 2017-01-01."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every oil-residue or oily-bilge-water tank on an applicable Category A or B ship constructed on or after 2017-01-01 must have a valid capacity; if its individual capacity exceeds 30 m3, its outer-shell separation must be at least 0.76 m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:ship ;
                    nltl:shipCategory ?category ;
                    nltl:constructionDate ?constructionDate ;
                    nltl:hasComponent ?tank .

                FILTER (
                    ?category = nltl:polarShipCategoryA ||
                    ?category = nltl:polarShipCategoryB
                )
                FILTER (
                    datatype(?constructionDate) = xsd:date &&
                    ?constructionDate >= "2017-01-01"^^xsd:date
                )

                ?tank nltl:tankType ?tankType .
                FILTER (
                    datatype(?tankType) = xsd:string &&
                    (
                        str(?tankType) = "oil_residue_tank" ||
                        str(?tankType) = "oily_bilge_water_holding_tank"
                    )
                )

                {
                    FILTER NOT EXISTS {
                        ?tank nltl:individualTankCapacity ?capacity .
                        ?capacity qudt:numericValue ?capacityValue ;
                            qudt:unit unit:M3 .
                        FILTER (
                            datatype(?capacityValue) = xsd:decimal
                        )
                    }
                }
                UNION
                {
                    ?tank nltl:individualTankCapacity ?capacity .
                    ?capacity qudt:numericValue ?capacityValue ;
                        qudt:unit unit:M3 .
                    FILTER (
                        datatype(?capacityValue) = xsd:decimal &&
                        ?capacityValue > "30"^^xsd:decimal
                    )

                    FILTER NOT EXISTS {
                        ?tank nltl:tankOuterShellSeparation ?separation .
                        ?separation qudt:numericValue ?separationValue ;
                            qudt:unit unit:M .
                        FILTER (
                            datatype(?separationValue) = xsd:decimal &&
                            ?separationValue >= "0.76"^^xsd:decimal
                        )
                    }
                }
            }
        """
    ] .
