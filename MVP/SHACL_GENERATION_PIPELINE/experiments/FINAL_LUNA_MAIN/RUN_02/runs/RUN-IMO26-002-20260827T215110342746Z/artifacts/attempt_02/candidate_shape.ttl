@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_002Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path rdf:type ;
                sh:minCount 1 ;
                sh:hasValue nltl:fishingVessel ;
                sh:message "The ship must be classified as a fishing vessel for this applicability branch."
            ] ;
            sh:property [
                sh:path nltl:lengthOverall ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive 24 ;
                        sh:message "The fishing vessel length overall must be at least 24 m."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:message "The length overall must use metres."
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:polarCodeChapter9Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Chapter 9-1 applicability must be true for a fishing vessel of at least 24 m length overall."
            ]
        ]
        [
            sh:property [
                sh:path rdf:type ;
                sh:minCount 1 ;
                sh:hasValue nltl:pleasureYacht ;
                sh:message "The ship must be classified as a pleasure yacht for this applicability branch."
            ] ;
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive 300 ;
                        sh:message "The pleasure yacht gross tonnage must be at least 300."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:message "The gross tonnage must use the unitless unit."
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:engagedInTrade ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The pleasure yacht must not be engaged in trade."
            ] ;
            sh:property [
                sh:path nltl:polarCodeChapter9Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Chapter 9-1 applicability must be true for a pleasure yacht of at least 300 gross tonnage not engaged in trade."
            ]
        ]
        [
            sh:property [
                sh:path rdf:type ;
                sh:minCount 1 ;
                sh:hasValue nltl:cargoShip ;
                sh:message "The ship must be classified as a cargo ship for this applicability branch."
            ] ;
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive 300 ;
                        sh:maxExclusive 500 ;
                        sh:message "The cargo ship gross tonnage must be at least 300 and below 500."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:message "The gross tonnage must use the unitless unit."
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:polarCodeChapter9Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Chapter 9-1 applicability must be true for a cargo ship of at least 300 and below 500 gross tonnage."
            ]
        ]
    ) ;
    sh:message "The ship must satisfy one of the permitted Chapter 9-1 applicability branches." .
