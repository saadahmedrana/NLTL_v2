@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO26_016_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue qudt:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue qudt:UNITLESS
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "For a ship operating in polar waters, chapter 11-1 applicability must be true and one permitted ship-type and threshold alternative must hold." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters ?operates .
                FILTER (
                    datatype(?operates) = xsd:boolean &&
                    ?operates = true
                )

                {
                    FILTER NOT EXISTS {
                        $this nltl:polarCodeChapter11Dash1Applicable "true"^^xsd:boolean .
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        {
                            $this nltl:shipType ?fishingType .
                            FILTER (
                                datatype(?fishingType) = xsd:string &&
                                ?fishingType = "fishing_vessel"
                            )
                            $this nltl:lengthOverall ?lengthQuantity .
                            ?lengthQuantity qudt:numericValue ?lengthValue .
                            ?lengthQuantity qudt:unit qudt:M .
                            FILTER (
                                datatype(?lengthValue) = xsd:decimal &&
                                ?lengthValue >= 24
                            )
                        }
                        UNION
                        {
                            $this nltl:shipType ?yachtType .
                            FILTER (
                                datatype(?yachtType) = xsd:string &&
                                ?yachtType = "pleasure_yacht"
                            )
                            $this nltl:grossTonnage ?yachtTonnageQuantity .
                            ?yachtTonnageQuantity qudt:numericValue ?yachtTonnage .
                            ?yachtTonnageQuantity qudt:unit qudt:UNITLESS .
                            FILTER (
                                datatype(?yachtTonnage) = xsd:decimal &&
                                ?yachtTonnage >= 300
                            )
                            $this nltl:engagedInTrade "false"^^xsd:boolean .
                        }
                        UNION
                        {
                            $this nltl:shipType ?cargoType .
                            FILTER (
                                datatype(?cargoType) = xsd:string &&
                                ?cargoType = "cargo_ship"
                            )
                            $this nltl:grossTonnage ?cargoTonnageQuantity .
                            ?cargoTonnageQuantity qudt:numericValue ?cargoTonnage .
                            ?cargoTonnageQuantity qudt:unit qudt:UNITLESS .
                            FILTER (
                                datatype(?cargoTonnage) = xsd:decimal &&
                                ?cargoTonnage >= 300 &&
                                ?cargoTonnage < 500
                            )
                        }
                    }
                }
            }
        """
    ] .
