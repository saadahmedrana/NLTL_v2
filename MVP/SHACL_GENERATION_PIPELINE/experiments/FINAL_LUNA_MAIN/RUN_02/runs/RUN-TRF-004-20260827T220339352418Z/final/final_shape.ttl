@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF004Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction contract date is required to determine the applicable Ice Class Regulations."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:maxExclusive "2010-01-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:minInclusive "2010-01-01"^^xsd:date ;
                sh:maxExclusive "2012-01-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:in ( nltl:iceClassRegulationEdition2008 ) ;
                sh:message "Ships contracted from 1 January 2010 up to but not including 1 January 2012 shall identify the 2008 Ice Class Regulations as the applicable edition."
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:minInclusive "2012-01-01"^^xsd:date
            ]
        ]
    ) .
