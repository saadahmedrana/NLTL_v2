@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF007ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have exactly one ice class."
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "The construction stage date is required to determine applicability."
    ] ;
    sh:or (
        gen:TRF007ApplicableBranch
        gen:TRF007NonApplicableBranch
    ) .

gen:TRF007ApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "An applicable ship must have a delivery date."
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "An applicable ship must have an assessment date."
    ] ;
    sh:property [
        sh:path nltl:engineOutputComplianceMethod ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:traficom2017Section3Point2Point2Method
            nltl:traficom2017Section3Point2Point4Method
        ) ;
        sh:message "An applicable ship must specify one permitted 2017 regulation compliance method."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an IA or IA Super ship constructed before 1 September 2003, the assessment date must be no later than 1 January of the year twenty years after delivery." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?constructionStageDate ;
                      nltl:deliveryDate ?deliveryDate ;
                      nltl:assessmentDate ?assessmentDate ;
                      nltl:engineOutputComplianceMethod ?method .

                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIa,
                        nltl:iceClassIaSuper
                    )
                )
                FILTER (?constructionStageDate < "2003-09-01"^^xsd:date)
                FILTER (
                    ?method IN (
                        nltl:traficom2017Section3Point2Point2Method,
                        nltl:traficom2017Section3Point2Point4Method
                    )
                )
                FILTER (
                    YEAR(?assessmentDate) < YEAR(?deliveryDate) + 20
                    ||
                    (
                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20
                        &&
                        MONTH(?assessmentDate) = 1
                        &&
                        DAY(?assessmentDate) <= 1
                    )
                )
            }
        """
    ] .

gen:TRF007NonApplicableBranch
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ship is non-applicable only when it is not IA or IA Super, or its construction stage date is not before 1 September 2003." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?constructionStageDate .

                FILTER (
                    ?iceClass NOT IN (
                        nltl:iceClassIa,
                        nltl:iceClassIaSuper
                    )
                    ||
                    ?constructionStageDate >= "2003-09-01"^^xsd:date
                )
            }
        """
    ] .
