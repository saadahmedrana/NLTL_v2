@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-009> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "An ice class is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction stage date is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:deliveryDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:message "A delivery date is required for an applicable ship."
            ] ;
            sh:property [
                sh:path nltl:assessmentDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:message "An assessment date is required to verify the compliance deadline."
            ] ;
            sh:sparql [
                sh:message "An applicable IA or IA Super ship must comply by 1 January in the year twenty years after its delivery year." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass ;
                              nltl:constructionStageDate ?constructionStageDate ;
                              nltl:deliveryDate ?deliveryDate ;
                              nltl:assessmentDate ?assessmentDate .
                        FILTER (
                            ?iceClass IN (
                                nltl:iceClassIaSuper,
                                nltl:iceClassIa
                            )
                        )
                        FILTER (
                            YEAR(?constructionStageDate) < 2003
                            ||
                            (
                                YEAR(?constructionStageDate) = 2003
                                && MONTH(?constructionStageDate) < 9
                            )
                            ||
                            (
                                YEAR(?constructionStageDate) = 2003
                                && MONTH(?constructionStageDate) = 9
                                && DAY(?constructionStageDate) < 1
                            )
                        )
                        FILTER (
                            YEAR(?assessmentDate) < YEAR(?deliveryDate) + 20
                            ||
                            (
                                YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20
                                && MONTH(?assessmentDate) = 1
                                && DAY(?assessmentDate) <= 1
                            )
                        )
                    }
                """
            ]
        ]
        [
            sh:sparql [
                sh:message "The ship is non-applicable because it is not an IA or IA Super ship with construction begun before 1 September 2003." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass ;
                              nltl:constructionStageDate ?constructionStageDate .
                        FILTER (
                            !(
                                ?iceClass IN (
                                    nltl:iceClassIaSuper,
                                    nltl:iceClassIa
                                )
                                &&
                                (
                                    YEAR(?constructionStageDate) < 2003
                                    ||
                                    (
                                        YEAR(?constructionStageDate) = 2003
                                        && MONTH(?constructionStageDate) < 9
                                    )
                                    ||
                                    (
                                        YEAR(?constructionStageDate) = 2003
                                        && MONTH(?constructionStageDate) = 9
                                        && DAY(?constructionStageDate) < 1
                                    )
                                )
                            )
                        )
                    }
                """
            ]
        ]
    ) .
