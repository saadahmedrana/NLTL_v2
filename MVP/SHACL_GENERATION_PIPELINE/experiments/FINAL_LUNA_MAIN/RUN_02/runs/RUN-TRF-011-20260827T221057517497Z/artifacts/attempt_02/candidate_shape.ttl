@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_011_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_011_IceWaterlineShape ;
        sh:message "The ship must identify exactly one upper ice waterline with profile points." ;
    ] ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:node gen:TRF_011_IceWaterlineShape ;
        sh:message "The ship must identify at least one intended ice-operating waterline." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    SELECT $this ?x
                           (MAX(?expectedY) AS ?expectedMax)
                           (MIN(?uiwlY) AS ?uiwlMin)
                           (MAX(?uiwlY) AS ?uiwlMax)
                    WHERE {
                        {
                            $this nltl:hasIntendedIceOperatingWaterline ?intended .
                            ?intended nltl:hasWaterlineProfilePoint ?intendedPoint .
                            ?intendedPoint nltl:longitudinalPosition ?intendedX .
                            ?intendedPoint nltl:verticalCoordinate ?intendedVertical .
                            ?intendedVertical qudt:numericValue ?expectedY .
                            BIND(?intendedX AS ?x)
                        }
                        UNION
                        {
                            $this nltl:hasUpperIceWaterline ?uiwl .
                            ?uiwl nltl:hasWaterlineProfilePoint ?uiwlPoint .
                            ?uiwlPoint nltl:longitudinalPosition ?uiwlX .
                            ?uiwlPoint nltl:verticalCoordinate ?uiwlVertical .
                            ?uiwlVertical qudt:numericValue ?uiwlY .
                            BIND(?uiwlX AS ?x)
                        }
                    }
                    GROUP BY $this ?x
                }
                FILTER(
                    !BOUND(?expectedMax) ||
                    !BOUND(?uiwlMin) ||
                    !BOUND(?uiwlMax) ||
                    ABS(?uiwlMin - ?expectedMax) >
                        IF(
                            ABS(?expectedMax) > 0.000001,
                            ABS(?expectedMax) * 0.000001,
                            0.000001
                        ) ||
                    ABS(?uiwlMax - ?expectedMax) >
                        IF(
                            ABS(?expectedMax) > 0.000001,
                            ABS(?expectedMax) * 0.000001,
                            0.000001
                        )
                )
            }
        """ ;
        sh:message "The upper ice waterline must match, in both directions, the maximum vertical coordinate of intended ice-operating waterlines at each longitudinal position; derived decimal comparisons use a relative tolerance of 1e-6 with a 1e-6 metre absolute fallback near zero." ;
    ] .

gen:TRF_011_IceWaterlineShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:waterlineProfilePoint ;
        sh:minCount 1 ;
        sh:node gen:TRF_011_ProfilePointShape ;
        sh:message "Each ice waterline must provide at least one waterline profile point." ;
    ] .

gen:TRF_011_ProfilePointShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_011_LengthQuantityShape ;
        sh:message "Each waterline profile point must have one longitudinal position in metres." ;
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_011_LengthQuantityShape ;
        sh:message "Each waterline profile point must have one vertical coordinate in metres." ;
    ] .

gen:TRF_011_LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .
