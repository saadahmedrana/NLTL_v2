@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-022-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowRakeAtQuarterBreadth ;
        sh:node <urn:nltl:generated-shape:AngleQuantity> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Bow rake at quarter breadth is required as an angle in degrees."
    ] ;
    sh:property [
        sh:path nltl:waterlineAngleAtQuarterBreadth ;
        sh:node <urn:nltl:generated-shape:AngleQuantity> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Waterline angle at quarter breadth is required as an angle in degrees."
    ] ;
    sh:property [
        sh:path nltl:shipLength ;
        sh:node <urn:nltl:generated-shape:LengthQuantity> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraught ;
        sh:node <urn:nltl:generated-shape:LengthQuantity> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:node <urn:nltl:generated-shape:LengthQuantity> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientC3 ;
        sh:node <urn:nltl:generated-shape:C3Quantity> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientC4 ;
        sh:node <urn:nltl:generated-shape:C4Quantity> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientC5 ;
        sh:node <urn:nltl:generated-shape:C5Quantity> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientF1 ;
        sh:node <urn:nltl:generated-shape:F1Quantity> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientF2 ;
        sh:node <urn:nltl:generated-shape:F2Quantity> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientF3 ;
        sh:node <urn:nltl:generated-shape:F3Quantity> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientF4 ;
        sh:node <urn:nltl:generated-shape:F4Quantity> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientG1 ;
        sh:node <urn:nltl:generated-shape:G1Quantity> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientG2 ;
        sh:node <urn:nltl:generated-shape:G2Quantity> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientG3 ;
        sh:node <urn:nltl:generated-shape:G3Quantity> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:flareAngle ;
        sh:node <urn:nltl:generated-shape:AngleQuantity> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The externally computed psi result is required as an angle in degrees."
    ] ;
    sh:property [
        sh:path nltl:clampedHullGeometryTerm ;
        sh:node <urn:nltl:generated-shape:ClampedGeometryQuantity> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The externally computed clamped hull geometry result is required in the inclusive interval [5,20]."
    ] .

<urn:nltl:generated-shape:AngleQuantity>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

