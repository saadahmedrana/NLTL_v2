            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/N-PER-M2> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:coefficientG1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 1530 ;
                sh:maxInclusive 1530
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/N> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:coefficientG2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 170 ;
                sh:maxInclusive 170
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/N-PER-M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:coefficientG3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 400 ;
                sh:maxInclusive 400
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue nltl:newtonPerMetreToPowerOnePointFiveUnit ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:flareAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:clampedHullGeometryTerm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "flareAngle must equal atan(tan(phi2)/sin(alpha)) after degree-radian conversion, within tolerance, with non-singular angle inputs." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
SELECT $this
WHERE {
  $this nltl:bowRakeAtQuarterBreadth ?phiNode ;
        nltl:waterlineAngleAtQuarterBreadth ?alphaNode ;
        nltl:flareAngle ?psiNode .
  ?phiNode qudt:numericValue ?phi .
  ?alphaNode qudt:numericValue ?alpha .
  ?psiNode qudt:numericValue ?psi .
  BIND(?phi * 3.141592653589793 / 180.0 AS ?phiRad)
  BIND(?alpha * 3.141592653589793 / 180.0 AS ?alphaRad)
  BIND(math:sin(?alphaRad) AS ?sinAlpha)
  BIND(math:cos(?phiRad) AS ?cosPhi)
  BIND(math:atan(math:tan(?phiRad) / ?sinAlpha) * 180.0 / 3.141592653589793 AS ?expected)
  FILTER(
    ABS(?sinAlpha) <= 0.000000000001 ||
    ABS(?cosPhi) <= 0.000000000001 ||
    ABS(?psi - ?expected) >
      0.000001 * IF(ABS(?expected) > 0.000000001, ABS(?expected), 0.000000001)
  )
}
"""
    ] ;
    sh:sparql [
        sh:message "clampedHullGeometryTerm must equal ((shipLength * iceClassDraught) / shipBreadth^2)^3 clamped inclusively to [5,20], within tolerance." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:shipLength ?lengthNode ;
        nltl:iceClassDraught ?draughtNode ;
        nltl:shipBreadth ?breadthNode ;
        nltl:clampedHullGeometryTerm ?resultNode .
  ?lengthNode qudt:numericValue ?length .
  ?draughtNode qudt:numericValue ?draught .
  ?breadthNode qudt:numericValue ?breadth .
  ?resultNode qudt:numericValue ?result .
  BIND((?length * ?draught / (?breadth * ?breadth)) *
       (?length * ?draught / (?breadth * ?breadth)) *
       (?length * ?draught / (?breadth * ?breadth)) AS ?raw)
  BIND(IF(?raw < 5.0, 5.0, IF(?raw > 20.0, 20.0, ?raw)) AS ?expected)
  FILTER(
    ?breadth = 0 ||
    ABS(?result - ?expected) >
      0.000001 * IF(ABS(?expected) > 0.000000001, ABS(?expected), 0.000000001)
  )
}
"""
    ] .
