@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-023> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:and (
                [
                    sh:path nltl:iceClass ;
                    sh:hasValue nltl:iceClassIb ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ]
                [
                    sh:path nltl:applicableIceClassRegulationEdition ;
                    sh:hasValue nltl:iceClassRuleEdition1985 ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ]
                [
                    sh:path nltl:maximumContinuousRatingPower ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:node [
                        sh:class qudt:QuantityValue ;
                        sh:property [
                            sh:path qudt:numericValue ;
                            sh:datatype xsd:decimal ;
                            sh:minCount 1 ;
                            sh:maxCount 1
                        ] ;
                        sh:property [
                            sh:path qudt:unit ;
                            sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                            sh:minCount 1 ;
                            sh:maxCount 1
                        ]
                    ]
                ]
                [
                    sh:path nltl:requiredPowerUnder1985Rules ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:node [
                        sh:class qudt:QuantityValue ;
                        sh:property [
                            sh:path qudt:numericValue ;
                            sh:datatype xsd:decimal ;
                            sh:minCount 1 ;
                            sh:maxCount 1
                        ] ;
                        sh:property [
                            sh:path qudt:unit ;
                            sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                            sh:minCount 1 ;
                            sh:maxCount 1
                        ]
                    ]
                ]
            )
        ]
        [
            sh:and (
                [
                    sh:path nltl:iceClass ;
                    sh:hasValue nltl:iceClassIc ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ]
                [
                    sh:path nltl:applicableIceClassRegulationEdition ;
                    sh:hasValue nltl:iceClassRuleEdition1985 ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ]
                [
                    sh:path nltl:maximumContinuousRatingPower ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:node [
                        sh:class qudt:QuantityValue ;
                        sh:property [
                            sh:path qudt:numericValue ;
                            sh:datatype xsd:decimal ;
                            sh:minCount 1 ;
                            sh:maxCount 1
                        ] ;
                        sh:property [
                            sh:path qudt:unit ;
                            sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                            sh:minCount 1 ;
                            sh:maxCount 1
                        ]
                    ]
                ]
                [
                    sh:path nltl:requiredPowerUnder1985Rules ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:node [
                        sh:class qudt:QuantityValue ;
                        sh:property [
                            sh:path qudt:numericValue ;
                            sh:datatype xsd:decimal ;
                            sh:minCount 1 ;
                            sh:maxCount 1
                        ] ;
                        sh:property [
                            sh:path qudt:unit ;
                            sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                            sh:minCount 1 ;
                            sh:maxCount 1
                        ]
                    ]
                ]
            )
        ]
        [
            sh:or (
                [
                    sh:path nltl:iceClass ;
                    sh:in (
                        nltl:iceClassIaSuper
                        nltl:iceClassIa
                        nltl:iceClassIb
                        nltl:iceClassIc
                        nltl:iceClassIi
                        nltl:iceClassIii
                    ) ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ]
                [
                    sh:path nltl:applicableIceClassRegulationEdition ;
                    sh:in (
                        nltl:iceClassRegulationEdition2002
                        nltl:iceClassRegulationEdition2008
                        nltl:iceClassRegulationEdition2010
                        nltl:iceClassRegulationEdition2017
                        nltl:iceClassRegulationEdition2021
                    ) ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ]
            )
        ]
    ) ;
    sh:sparql [
        sh:message "For ice class IB or IC under the 1985 rules, maximum continuous rating power shall be at least the required power under the 1985 rules." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
                      nltl:maximumContinuousRatingPower ?maximumQuantity ;
                      nltl:requiredPowerUnder1985Rules ?requiredQuantity .
                FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
                ?maximumQuantity qudt:numericValue ?maximumPower .
                ?requiredQuantity qudt:numericValue ?requiredPower .
                FILTER (?maximumPower < ?requiredPower)
            }
        """
    ] .
