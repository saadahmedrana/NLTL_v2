@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-023> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "A ship must identify one permitted ice class so applicability can be determined."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassRuleEdition1985
            nltl:iceClassRegulationEdition2002
            nltl:iceClassRegulationEdition2008
            nltl:iceClassRegulationEdition2010
            nltl:iceClassRegulationEdition2017
            nltl:iceClassRegulationEdition2021
        ) ;
        sh:message "A ship must identify one permitted applicable ice-class regulation edition so applicability can be determined."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For ice class IB or IC under the 1985 ice-class rules, maximum continuous rating power must be at least the required power under the 1985 rules, with both values expressed in kW." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:applicableIceClassRegulationEdition ?edition .

                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                    && ?edition = nltl:iceClassRuleEdition1985
                )

                FILTER NOT EXISTS {
                    $this nltl:maximumContinuousRatingPower ?maximumPowerNode .
                    ?maximumPowerNode qudt:numericValue ?maximumPowerValue ;
                                       qudt:unit qudt:KiloW .

                    $this nltl:requiredPowerUnder1985Rules ?requiredPowerNode .
                    ?requiredPowerNode qudt:numericValue ?requiredPowerValue ;
                                       qudt:unit qudt:KiloW .

                    FILTER (
                        datatype(?maximumPowerValue) = xsd:decimal
                        && datatype(?requiredPowerValue) = xsd:decimal
                        && ?maximumPowerValue >= ?requiredPowerValue
                    )
                }
            }
        """
    ] .
