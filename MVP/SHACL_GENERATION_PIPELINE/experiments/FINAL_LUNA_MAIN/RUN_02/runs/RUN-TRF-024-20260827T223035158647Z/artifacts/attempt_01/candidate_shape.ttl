@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF024ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "A ship must provide an ice class to determine applicability of the existing-ship deadline."
    ] ;
    sh:or (
        [
            sh:message "The TRF-024 deadline applies only to ice class IA Super or IA ships whose construction stage began before 1 September 2003." ;
            sh:sparql [
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    {
        FILTER NOT EXISTS {
            $this nltl:iceClass ?ice .
            FILTER (?ice IN (nltl:iceClassIaSuper, nltl:iceClassIa))
        }
    }
    UNION
    {
        $this nltl:iceClass ?ice .
        FILTER (?ice IN (nltl:iceClassIaSuper, nltl:iceClassIa))
        $this nltl:constructionStageDate ?stage .
        FILTER (
            YEAR(?stage) > 2003
            || (
                YEAR(?stage) = 2003
                && (
                    MONTH(?stage) > 9
                    || (MONTH(?stage) = 9 && DAY(?stage) >= 1)
                )
            )
        )
    }
}
""" ;
                sh:message "The ship is not subject to the TRF-024 twenty-year deadline because its ice class or construction-stage date makes the rule inapplicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:message "A construction-stage date is required to establish applicability of the TRF-024 deadline."
            ] ;
            sh:property [
                sh:path nltl:deliveryDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:message "A delivery date is required to calculate the TRF-024 deadline."
            ] ;
            sh:property [
                sh:path nltl:assessmentDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:message "An assessment date is required to evaluate the TRF-024 deadline."
            ] ;
            sh:sparql [
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?ice .
    FILTER (?ice IN (nltl:iceClassIaSuper, nltl:iceClassIa))

    $this nltl:constructionStageDate ?stage .
    FILTER (
        YEAR(?stage) < 2003
        || (
            YEAR(?stage) = 2003
            && (
                MONTH(?stage) < 9
                || (MONTH(?stage) = 9 && DAY(?stage) < 1)
            )
        )
    )

    $this nltl:deliveryDate ?delivery .
    $this nltl:assessmentDate ?assessment .

    FILTER (
        YEAR(?assessment) > YEAR(?delivery) + 20
        || (
            YEAR(?assessment) = YEAR(?delivery) + 20
            && (
                MONTH(?assessment) > 1
                || (MONTH(?assessment) = 1 && DAY(?assessment) > 1)
            )
        )
    )
}
""" ;
                sh:message "For an applicable IA Super or IA ship, the section 3.2.2 requirements must be complied with no later than 1 January of the year twenty years after delivery."
            ]
        ]
    ) .
