@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF024Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:TRF024NonIaShape
        gen:TRF024PostCutoffShape
        gen:TRF024ApplicableShape
    ) .

gen:TRF024NonIaShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:message "A non-IA or non-IA Super ship is outside the TRF-024 applicability condition."
    ] .

gen:TRF024PostCutoffShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Construction stage date is required to establish non-applicability of TRF-024."
    ] ;
    sh:sparql [
        sh:message "TRF-024 is inapplicable when the construction stage date is on or after 2003-09-01." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?constructionDate .
                FILTER (
                    !(
                        YEAR(?constructionDate) > 2003 ||
                        (
                            YEAR(?constructionDate) = 2003 &&
                            (
                                MONTH(?constructionDate) > 9 ||
                                (
                                    MONTH(?constructionDate) = 9 &&
                                    DAY(?constructionDate) >= 1
                                )
                            )
                        )
                    )
                )
            }
        """
    ] .

gen:TRF024ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIaSuper
        ) ;
        sh:minCount 1 ;
        sh:message "TRF-024 applies only to ships retaining ice class IA or IA Super."
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Construction stage date is required to establish TRF-024 applicability."
    ] ;
    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Delivery date is required to evaluate the TRF-024 deadline."
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Assessment date is required to evaluate the TRF-024 deadline."
    ] ;
    sh:sparql [
        sh:message "For an applicable IA or IA Super ship, construction must have begun before 2003-09-01." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?constructionDate .
                FILTER (
                    !(
                        YEAR(?constructionDate) < 2003 ||
                        (
                            YEAR(?constructionDate) = 2003 &&
                            (
                                MONTH(?constructionDate) < 9 ||
                                (
                                    MONTH(?constructionDate) = 9 &&
                                    DAY(?constructionDate) < 1
                                )
                            )
                        )
                    )
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The section 3.2.2 requirements must be met no later than 1 January of the year twenty years after delivery." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:deliveryDate ?deliveryDate .
                $this nltl:assessmentDate ?assessmentDate .
                FILTER (
                    !(
                        YEAR(?assessmentDate) < YEAR(?deliveryDate) + 20 ||
                        (
                            YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                            MONTH(?assessmentDate) = 1 &&
                            DAY(?assessmentDate) = 1
                        )
                    )
                )
            }
        """
    ] .
