@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF025Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "Exactly one permitted ice class is required."
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one boolean bulbous-bow indication is required."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an IA Super ship without a bulb, all declared formula operands and externally calculated C1 and C2 results must be present as QuantityValue nodes with their canonical units; length, breadth, and draught must be strictly positive decimal quantities." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper ;
                       nltl:bulbousBowPresent false .

                FILTER (
                    NOT EXISTS {
                        $this nltl:coefficientF1 ?f1 .
                        ?f1 a qudt:QuantityValue ;
                            qudt:numericValue ?f1n ;
                            qudt:unit <http://qudt.org/vocab/unit/N-PER-M2> .
                        FILTER (DATATYPE(?f1n) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:coefficientF2 ?f2 .
                        ?f2 a qudt:QuantityValue ;
                            qudt:numericValue ?f2n ;
                            qudt:unit <http://qudt.org/vocab/unit/N-PER-M> .
                        FILTER (DATATYPE(?f2n) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:coefficientF3 ?f3 .
                        ?f3 a qudt:QuantityValue ;
                            qudt:numericValue ?f3n ;
                            qudt:unit <http://qudt.org/vocab/unit/N-PER-M> .
                        FILTER (DATATYPE(?f3n) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:coefficientF4 ?f4 .
                        ?f4 a qudt:QuantityValue ;
                            qudt:numericValue ?f4n ;
                            qudt:unit <http://qudt.org/vocab/unit/N-PER-M2> .
                        FILTER (DATATYPE(?f4n) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:coefficientG1 ?g1 .
                        ?g1 a qudt:QuantityValue ;
                            qudt:numericValue ?g1n ;
                            qudt:unit <http://qudt.org/vocab/unit/N> .
                        FILTER (DATATYPE(?g1n) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:coefficientG2 ?g2 .
                        ?g2 a qudt:QuantityValue ;
                            qudt:numericValue ?g2n ;
                            qudt:unit <http://qudt.org/vocab/unit/N-PER-M> .
                        FILTER (DATATYPE(?g2n) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:coefficientG3 ?g3 .
                        ?g3 a qudt:QuantityValue ;
                            qudt:numericValue ?g3n ;
                            qudt:unit nltl:newtonPerMetreToPowerOnePointFiveUnit .
                        FILTER (DATATYPE(?g3n) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:shipLength ?length .
                        ?length a qudt:QuantityValue ;
                                qudt:numericValue ?lengthN ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (DATATYPE(?lengthN) = xsd:decimal && ?lengthN > 0)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:shipBreadth ?breadth .
                        ?breadth a qudt:QuantityValue ;
                                 qudt:numericValue ?breadthN ;
                                 qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (DATATYPE(?breadthN) = xsd:decimal && ?breadthN > 0)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceClassDraught ?draught .
                        ?draught a qudt:QuantityValue ;
                                 qudt:numericValue ?draughtN ;
                                 qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (DATATYPE(?draughtN) = xsd:decimal && ?draughtN > 0)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:brashIceResistanceCoefficientC1 ?c1 .
                        ?c1 a qudt:QuantityValue ;
                            qudt:numericValue ?c1n ;
                            qudt:unit <http://qudt.org/vocab/unit/N> .
                        FILTER (DATATYPE(?c1n) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:brashIceResistanceCoefficientC2 ?c2 .
                        ?c2 a qudt:QuantityValue ;
                            qudt:numericValue ?c2n ;
                            qudt:unit <http://qudt.org/vocab/unit/N> .
                        FILTER (DATATYPE(?c2n) = xsd:decimal)
                    }
                )
            }
        """
    ] .
