@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-025> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one controlled ice class is required."
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one boolean bulbous-bow value is required."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An IA Super ship without a bulb must contain positive L, B, and T operands, all declared formula coefficients, and externally computed C1 and C2 results with their required QuantityValue units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper ;
                       nltl:bulbousBowPresent false .

                $this nltl:shipLength ?lengthQuantity .
                ?lengthQuantity qudt:numericValue ?lengthValue ;
                                 qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (datatype(?lengthValue) = xsd:decimal)
                FILTER (?lengthValue > 0)
                FILTER NOT EXISTS {
                    $this nltl:shipLength ?otherLengthQuantity .
                    FILTER (?otherLengthQuantity != ?lengthQuantity)
                }

                $this nltl:shipBreadth ?breadthQuantity .
                ?breadthQuantity qudt:numericValue ?breadthValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (datatype(?breadthValue) = xsd:decimal)
                FILTER (?breadthValue > 0)
                FILTER NOT EXISTS {
                    $this nltl:shipBreadth ?otherBreadthQuantity .
                    FILTER (?otherBreadthQuantity != ?breadthQuantity)
                }

                $this nltl:iceClassDraught ?draughtQuantity .
                ?draughtQuantity qudt:numericValue ?draughtValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (datatype(?draughtValue) = xsd:decimal)
                FILTER (?draughtValue > 0)
                FILTER NOT EXISTS {
                    $this nltl:iceClassDraught ?otherDraughtQuantity .
                    FILTER (?otherDraughtQuantity != ?draughtQuantity)
                }

                $this nltl:coefficientF1 ?f1Quantity .
                ?f1Quantity qudt:numericValue ?f1Value ;
                            qudt:unit <http://qudt.org/vocab/unit/N-PER-M2> .
                FILTER (datatype(?f1Value) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:coefficientF1 ?otherF1Quantity .
                    FILTER (?otherF1Quantity != ?f1Quantity)
                }

                $this nltl:coefficientF2 ?f2Quantity .
                ?f2Quantity qudt:numericValue ?f2Value ;
                            qudt:unit <http://qudt.org/vocab/unit/N-PER-M> .
                FILTER (datatype(?f2Value) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:coefficientF2 ?otherF2Quantity .
                    FILTER (?otherF2Quantity != ?f2Quantity)
                }

                $this nltl:coefficientF3 ?f3Quantity .
                ?f3Quantity qudt:numericValue ?f3Value ;
                            qudt:unit <http://qudt.org/vocab/unit/N-PER-M> .
                FILTER (datatype(?f3Value) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:coefficientF3 ?otherF3Quantity .
                    FILTER (?otherF3Quantity != ?f3Quantity)
                }

                $this nltl:coefficientF4 ?f4Quantity .
                ?f4Quantity qudt:numericValue ?f4Value ;
                            qudt:unit <http://qudt.org/vocab/unit/N-PER-M2> .
                FILTER (datatype(?f4Value) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:coefficientF4 ?otherF4Quantity .
                    FILTER (?otherF4Quantity != ?f4Quantity)
                }

                $this nltl:coefficientG1 ?g1Quantity .
                ?g1Quantity qudt:numericValue ?g1Value ;
                            qudt:unit <http://qudt.org/vocab/unit/N> .
                FILTER (datatype(?g1Value) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:coefficientG1 ?otherG1Quantity .
                    FILTER (?otherG1Quantity != ?g1Quantity)
                }

                $this nltl:coefficientG2 ?g2Quantity .
                ?g2Quantity qudt:numericValue ?g2Value ;
                            qudt:unit <http://qudt.org/vocab/unit/N-PER-M> .
                FILTER (datatype(?g2Value) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:coefficientG2 ?otherG2Quantity .
                    FILTER (?otherG2Quantity != ?g2Quantity)
                }

                $this nltl:coefficientG3 ?g3Quantity .
                ?g3Quantity qudt:numericValue ?g3Value ;
                            qudt:unit nltl:newtonPerMetreToPowerOnePointFiveUnit .
                FILTER (datatype(?g3Value) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:coefficientG3 ?otherG3Quantity .
                    FILTER (?otherG3Quantity != ?g3Quantity)
                }

                $this nltl:brashIceResistanceCoefficientC1 ?c1Quantity .
                ?c1Quantity qudt:numericValue ?c1Value ;
                             qudt:unit <http://qudt.org/vocab/unit/N> .
                FILTER (datatype(?c1Value) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:brashIceResistanceCoefficientC1 ?otherC1Quantity .
                    FILTER (?otherC1Quantity != ?c1Quantity)
                }

                $this nltl:brashIceResistanceCoefficientC2 ?c2Quantity .
                ?c2Quantity qudt:numericValue ?c2Value ;
                             qudt:unit <http://qudt.org/vocab/unit/N> .
                FILTER (datatype(?c2Value) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:brashIceResistanceCoefficientC2 ?otherC2Quantity .
                    FILTER (?otherC2Quantity != ?c2Quantity)
                }
            }
        """
    ] .
