@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF028Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:approvalStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The approved alternative method must have approvalStatus true."
    ] ;
    sh:property [
        sh:path nltl:approvalRevocationStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "The approved alternative method must have approved revocation status."
    ] ;
    sh:xone (
        gs:TRF028AlternativeCalculationBranch
        gs:TRF028ModelTestBranch
    ) .

gs:TRF028AlternativeCalculationBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:alternativeCalculationEvidence ;
        sh:minCount 1 ;
        sh:node gs:TRF028AlternativeCalculationEvidenceShape ;
        sh:message "Evidence for the more precise alternative calculation is required."
    ] ;
    sh:xone (
        gs:TRF028KeResultShape
        gs:TRF028RchResultShape
    ) .

gs:TRF028ModelTestBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:modelTestEvidence ;
        sh:minCount 1 ;
        sh:node gs:TRF028ModelTestEvidenceShape ;
        sh:message "Evidence for the model-test alternative is required."
    ] ;
    sh:xone (
        gs:TRF028KeResultShape
        gs:TRF028RchResultShape
    ) .

gs:TRF028AlternativeCalculationEvidenceShape
    a sh:NodeShape ;
    sh:class nltl:alternativeCalculationEvidence , nltl:documentEvidence .

gs:TRF028ModelTestEvidenceShape
    a sh:NodeShape ;
    sh:class nltl:modelTestEvidence , nltl:physicalTestEvidence .

gs:TRF028KeResultShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:engineOutputCoefficientKe ;
        sh:minCount 1 ;
        sh:node gs:TRF028KeQuantityShape ;
        sh:message "An externally determined Ke result is required."
    ] .

gs:TRF028RchResultShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:brashIceChannelResistanceRch ;
        sh:minCount 1 ;
        sh:node gs:TRF028RchQuantityShape ;
        sh:message "An externally determined RCH result is required."
    ] .

gs:TRF028KeQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .

gs:TRF028RchQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/N>
    ] .
