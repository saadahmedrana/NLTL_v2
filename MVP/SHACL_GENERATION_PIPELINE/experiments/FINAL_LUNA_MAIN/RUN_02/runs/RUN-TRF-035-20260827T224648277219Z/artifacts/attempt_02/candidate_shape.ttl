@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF035ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:classificationSociety ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ship must identify the classification society whose rule length is used."
    ] ;
    sh:property [
        sh:path nltl:ruleLength ;
        sh:node gen:TRF035RuleLengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide exactly one rule length."
    ] ;
    sh:property [
        sh:path nltl:classificationSocietyRuleLength ;
        sh:node gen:TRF035RuleLengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the classification society rule length."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ship's rule length must equal the classification society rule length." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:ruleLength ?ruleLengthNode .
                $this nltl:classificationSocietyRuleLength ?societyLengthNode .
                ?ruleLengthNode qudt:numericValue ?ruleLengthValue .
                ?societyLengthNode qudt:numericValue ?societyLengthValue .
                FILTER (?ruleLengthValue != ?societyLengthValue)
            }
        """
    ] .

gen:TRF035RuleLengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
