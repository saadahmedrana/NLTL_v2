@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:SpacingPropertyShape
    sh:path nltl:spacing ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;
    sh:message "Spacing must be provided as a metre-valued decimal quantity." .

gs:YieldStrengthPropertyShape
    sh:path nltl:yieldStrength ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;
    sh:message "Yield strength must be provided as an MPa-valued decimal quantity." .

gs:CorrosionAbrasionAdditionPropertyShape
    sh:path nltl:corrosionAbrasionAddition ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;
    sh:message "The corrosion and abrasion addition must be provided as a millimetre-valued decimal quantity." .

gs:RequiredShellPlatingThicknessPropertyShape
    sh:path nltl:requiredShellPlatingThickness ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;
    sh:message "Required shell plating thickness must be provided as a millimetre-valued decimal quantity." .

gs:TransversePressurePropertyShape
    sh:path nltl:platingPressure ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;
    sh:message "Transverse framing requires plating pressure as an MPa-valued decimal quantity." .

gs:IcePressurePropertyShape
    sh:path nltl:icePressure ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;
    sh:message "Longitudinal framing requires ice pressure as an MPa-valued decimal quantity." .

gs:TransverseFactorPropertyShape
    sh:path nltl:transversePlatingFactorF1 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;
    sh:message "Transverse framing requires the dimensionless transverse plating factor f1." .

gs:LongitudinalFactorPropertyShape
    sh:path nltl:longitudinalPlatingFactorF2 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;
    sh:message "Longitudinal framing requires the dimensionless longitudinal plating factor f2." .

gs:TransverseBranchShape
    sh:property [
        sh:path nltl:platingFramingOrientation ;
        sh:hasValue nltl:transverseFramingOrientation ;
        sh:minCount 1
    ] ;
    sh:property gs:SpacingPropertyShape ;
    sh:property gs:TransversePressurePropertyShape ;
    sh:property gs:TransverseFactorPropertyShape ;
    sh:property gs:YieldStrengthPropertyShape ;
    sh:property gs:CorrosionAbrasionAdditionPropertyShape ;
    sh:property gs:RequiredShellPlatingThicknessPropertyShape .

gs:LongitudinalBranchShape
    sh:property [
        sh:path nltl:platingFramingOrientation ;
        sh:hasValue nltl:longitudinalFramingOrientation ;
        sh:minCount 1
    ] ;
    sh:property gs:SpacingPropertyShape ;
    sh:property gs:IcePressurePropertyShape ;
    sh:property gs:LongitudinalFactorPropertyShape ;
    sh:property gs:YieldStrengthPropertyShape ;
    sh:property gs:CorrosionAbrasionAdditionPropertyShape ;
    sh:property gs:RequiredShellPlatingThicknessPropertyShape .

gs:TRF041PlatingShape
    a sh:NodeShape ;
    sh:targetClass nltl:plating ;
    sh:or (
        gs:TransverseBranchShape
        gs:LongitudinalBranchShape
    ) ;
    sh:message "Each plating record must satisfy the applicable transverse or longitudinal shell-plating thickness calculation input branch." .
