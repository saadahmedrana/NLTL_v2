@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF_047_FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:message "Each frame shall identify its strengthened part." ;
        sh:node [
            sh:or (
                [
                    sh:property [
                        sh:path (
                            nltl:hasStrengthenedPart
                            nltl:hasLowerEnd
                        ) ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path nltl:hasAttachedSupportingStructure ;
                                sh:minCount 1 ;
                                sh:node [
                                    sh:or (
                                        [ sh:class nltl:deckStructure ]
                                        [ sh:class nltl:tankBoundaryPlating ]
                                        [ sh:class nltl:tankTop ]
                                        [ sh:class nltl:iceStringer ]
                                    )
                                ] ;
                                sh:message "The lower end shall be attached to a deck, tank boundary plating, tank top, or ice stringer."
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path (
                            nltl:hasStrengthenedPart
                            nltl:hasLowerEnd
                        ) ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path nltl:hasTerminationBelowSupportingStructure ;
                                sh:minCount 1 ;
                                sh:node [
                                    sh:property [
                                        sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ;
                                        sh:datatype xsd:boolean ;
                                        sh:minCount 1 ;
                                        sh:hasValue true
                                    ]
                                ] ;
                                sh:message "The applicable terminating supporting structure shall be at or below the lower limit of the ice belt."
                            ] ;
                            sh:property [
                                sh:path nltl:hasHorizontalConnectionMember ;
                                sh:minCount 1 ;
                                sh:node [
                                    sh:class nltl:horizontalConnectionMember ;
                                    sh:property [
                                        sh:path nltl:connectsToAdjacentMainFrame ;
                                        sh:minCount 1 ;
                                        sh:node nltl:mainFrame
                                    ]
                                ] ;
                                sh:message "The lower end may use a horizontal member only when it is connected to an adjacent main frame."
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:ordinaryFrameScantlingsUsed ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:sameScantlingsAsMainFrame ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:mainFrameBelowIceBeltStrengthened ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true
                    ]
                ]
            )
        ]
    ] .
