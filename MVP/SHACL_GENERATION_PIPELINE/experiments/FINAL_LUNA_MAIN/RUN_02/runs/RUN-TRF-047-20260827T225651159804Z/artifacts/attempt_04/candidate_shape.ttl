@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:TRF047_FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:mainFrame ;
    sh:targetClass nltl:intermediateIceFrame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:node nltl:TRF047_StrengthenedPartShape ;
        sh:message "The main frame or intermediate ice frame must identify its strengthened part and a compliant lower-end arrangement."
    ] .

nltl:TRF047_MainFrameStrengthShape
    a sh:NodeShape ;
    sh:targetClass nltl:mainFrame ;
    sh:property [
        sh:path nltl:mainFrameBelowIceBeltStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A main frame covered by this requirement must be ice strengthened below the lower edge of the ice belt."
    ] .

nltl:TRF047_StrengthenedPartShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasLowerEnd ;
        sh:minCount 1 ;
        sh:node nltl:TRF047_LowerEndShape ;
        sh:message "The strengthened part must identify its lower end."
    ] .

nltl:TRF047_LowerEndShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The lower end must either be attached to a permitted supporting structure, or, for an intermediate ice frame only, terminate below a qualifying supporting structure and connect through a same-scantlings horizontal member to an adjacent main frame." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    {
                        ?frame nltl:hasStrengthenedPart ?part .
                        ?part nltl:hasLowerEnd $this .
                        ?frame a nltl:mainFrame .
                        $this nltl:hasAttachedSupportingStructure ?support .
                        ?support a ?supportType .
                        FILTER (
                            ?supportType IN (
                                nltl:deckStructure,
                                nltl:tankBoundaryPlating,
                                nltl:tankTop,
                                nltl:iceStringer
                            )
                        )
                    }
                    UNION
                    {
                        ?frame nltl:hasStrengthenedPart ?part .
                        ?part nltl:hasLowerEnd $this .
                        ?frame a nltl:intermediateIceFrame .
                        $this nltl:hasAttachedSupportingStructure ?support .
                        ?support a ?supportType .
                        FILTER (
                            ?supportType IN (
                                nltl:deckStructure,
                                nltl:tankBoundaryPlating,
                                nltl:tankTop,
                                nltl:iceStringer
                            )
                        )
                    }
                    UNION
                    {
                        ?frame nltl:hasStrengthenedPart ?part .
                        ?part nltl:hasLowerEnd $this .
                        ?frame a nltl:intermediateIceFrame .
                        ?frame nltl:sameScantlingsAsMainFrame true .
                        $this nltl:hasTerminationBelowSupportingStructure ?support .
                        ?support nltl:supportingStructureAtOrBelowIceBeltLowerLimit true .
                        ?support a ?supportType .
                        FILTER (
                            ?supportType IN (
                                nltl:deckStructure,
                                nltl:tankBoundaryPlating,
                                nltl:tankTop,
                                nltl:iceStringer
                            )
                        )
                        $this nltl:hasHorizontalConnectionMember ?member .
                        ?member nltl:connectsToAdjacentMainFrame ?adjacent .
                        ?adjacent a nltl:mainFrame .
                    }
                }
            }
        """
    ] .
