@prefix n: <urn:nltl:generated-shape:TRF-048:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

n:QuantityValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

n:LongitudinalFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node n:IcePressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "icePressure is required in MPa."
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node n:DesignIceLoadHeightQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "designIceLoadHeight is required in metres."
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node n:SpacingQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "spacing is required in metres."
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node n:SpanQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "span is required in metres."
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:node n:FrameMomentFactorQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "frameMomentFactorM is required and must satisfy the applicable boundary-condition rule."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node n:YieldStrengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "yieldStrength is required in MPa."
    ] ;
    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:continuousBeamWithBracketsFrameCondition ;
        sh:message "frameBoundaryConditionType must identify a continuous beam with brackets."
    ] ;
    sh:property [
        sh:path nltl:significantlyDifferentBoundaryConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "significantlyDifferentBoundaryConditions is required."
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:node n:FactorF4QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "longitudinalFrameLoadDistributionFactorF4 is required."
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameShearFactorF5 ;
        sh:node n:FactorF5QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "longitudinalFrameShearFactorF5 must equal 2.16."
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node n:SectionModulusQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "sectionModulus is required in cm3."
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node n:RequiredShearAreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "requiredShearArea is required in cm2."
    ] ;
    sh:property [
        sh:path nltl:grossFrameShearArea ;
        sh:node n:GrossFrameShearAreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "grossFrameShearArea is required in cm2."
    ] ;
    sh:property [
        sh:path nltl:bracketArea ;
        sh:node n:BracketAreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "bracketArea is required in cm2."
    ] ;
    sh:property [
        sh:path nltl:actualFrameShearArea ;
        sh:node n:ActualFrameShearAreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "actualFrameShearArea must exclude bracket area."
    ] ;
    sh:sparql [
        sh:message "The frame factor, section modulus, shear area, actual shear area, and boundary-condition factor do not satisfy the declared calculations or conditional comparison." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:spacing/qudt:numericValue ?s ;
                      nltl:span/qudt:numericValue ?l ;
                      nltl:frameMomentFactorM/qudt:numericValue ?m ;
                      nltl:yieldStrength/qudt:numericValue ?sigma ;
                      nltl:longitudinalFrameLoadDistributionFactorF4/qudt:numericValue ?f4 ;
                      nltl:longitudinalFrameShearFactorF5/qudt:numericValue ?f5 ;
                      nltl:sectionModulus/qudt:numericValue ?z ;
                      nltl:requiredShearArea/qudt:numericValue ?a ;
                      nltl:grossFrameShearArea/qudt:numericValue ?gross ;
                      nltl:bracketArea/qudt:numericValue ?bracket ;
                      nltl:actualFrameShearArea/qudt:numericValue ?actual ;
                      nltl:frameBoundaryConditionType ?bc ;
                      nltl:significantlyDifferentBoundaryConditions ?different .

                BIND((1 - (0.2 * ?h / ?s)) AS ?expectedF4)
                BIND((?expectedF4 * ?p * ?h * ?l * ?l /
                      (4 * ?m * ?sigma) * 1000000) AS ?expectedZ)
                BIND((1.7320508075688772 * ?expectedF4 * 2.16 * ?p * ?h * ?l /
                      (2 * ?sigma) * 10000) AS ?expectedA)
                BIND((?gross - ?bracket) AS ?expectedActual)
                BIND(IF(ABS(?expectedF4) > 0.000000001, ABS(?expectedF4), 0.000000001) AS ?scaleF4)
                BIND(IF(ABS(?expectedZ) > 0.000000001, ABS(?expectedZ), 0.000000001) AS ?scaleZ)
                BIND(IF(ABS(?expectedA) > 0.000000001, ABS(?expectedA), 0.000000001) AS ?scaleA)
                BIND(IF(ABS(?expectedActual) > 0.000000001, ABS(?expectedActual), 0.000000001) AS ?scaleActual)

                FILTER (
                    ABS(?f5 - 2.16) > 0.000001 ||
                    ABS(?f4 - ?expectedF4) > (0.000001 * ?scaleF4) ||
                    ABS(?z - ?expectedZ) > (0.000001 * ?scaleZ) ||
                    ABS(?a - ?expectedA) > (0.000001 * ?scaleA) ||
                    ABS(?actual - ?expectedActual) > (0.000001 * ?scaleActual) ||
                    (
                        ?bc = nltl:continuousBeamWithBracketsFrameCondition &&
                        ?different = false &&
                        (?m < 13.3 || ?m > 13.3)
                    ) ||
                    (
                        ?bc = nltl:continuousBeamWithBracketsFrameCondition &&
                        ?different = true &&
                        !(?m < 13.3)
                    )
                )
            }
        """
    ] .

n:IcePressureQuantityShape
    a sh:NodeShape ;
    sh:node n:QuantityValueShape ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ] .

n:DesignIceLoadHeightQuantityShape
    a sh:NodeShape ;
    sh:node n:QuantityValueShape ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/M> ] .

n:SpacingQuantityShape
    a sh:NodeShape ;
    sh:node n:QuantityValueShape ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/M> ] .

n:SpanQuantityShape
    a sh:NodeShape ;
    sh:node n:QuantityValueShape ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/M> ] .

n:FrameMomentFactorQuantityShape
    a sh:NodeShape ;
    sh:node n:QuantityValueShape ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ] .

n:YieldStrengthQuantityShape
    a sh:NodeShape ;
    sh:node n:QuantityValueShape ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ] .

n:FactorF4QuantityShape
    a sh:NodeShape ;
    sh:node n:QuantityValueShape ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ] .

n:FactorF5QuantityShape
    a sh:NodeShape ;
    sh:node n:QuantityValueShape ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ] ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minInclusive 2.16 ;
        sh:maxInclusive 2.16
    ] .

n:SectionModulusQuantityShape
    a sh:NodeShape ;
    sh:node n:QuantityValueShape ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ] .

n:RequiredShearAreaQuantityShape
    a sh:NodeShape ;
    sh:node n:QuantityValueShape ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ] .

n:GrossFrameShearAreaQuantityShape
    a sh:NodeShape ;
    sh:node n:QuantityValueShape ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ] .

n:BracketAreaQuantityShape
    a sh:NodeShape ;
    sh:node n:QuantityValueShape ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ] .

n:ActualFrameShearAreaQuantityShape
    a sh:NodeShape ;
    sh:node n:QuantityValueShape ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ] .
