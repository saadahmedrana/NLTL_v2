@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:QuantityCentiM3Shape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3>
    ] .

gen:QuantityCentiM2Shape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2>
    ] .

gen:QuantityKiloNPerMShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M>
    ] .

gen:NarrowDeckStripShape
    a sh:NodeShape ;
    sh:targetClass nltl:narrowDeckStrip ;
    sh:or (
        [
            sh:property [
                sh:path nltl:abreastOfHatch ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:servesAsIceStringer ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path nltl:abreastOfHatch ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:servesAsIceStringer ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:actualSectionModulus ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gen:QuantityCentiM3Shape
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:requiredSectionModulus ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gen:QuantityCentiM3Shape
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:actualShearArea ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gen:QuantityCentiM2Shape
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:requiredShearArea ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gen:QuantityCentiM2Shape
                    ]
                ]
                [
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:veryLongHatchOpening ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:datatype xsd:boolean ;
                                sh:hasValue false
                            ]
                        ]
                        [
                            sh:and (
                                [
                                    sh:property [
                                        sh:path nltl:veryLongHatchOpening ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1 ;
                                        sh:datatype xsd:boolean ;
                                        sh:hasValue true
                                    ]
                                ]
                                [
                                    sh:property [
                                        sh:path nltl:permittedReducedLineLoad ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1 ;
                                        sh:node gen:QuantityKiloNPerMShape
                                    ]
                                ]
                                [
                                    sh:property [
                                        sh:path nltl:permittedReducedLineLoad ;
                                        sh:minInclusive 0.10 ;
                                        sh:maxExclusive 0.15
                                    ]
                                ]
                                [
                                    sh:property [
                                        sh:path nltl:reducedLineLoadApprovedByClassificationSociety ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1 ;
                                        sh:datatype xsd:boolean ;
                                        sh:hasValue true
                                    ]
                                ]
                            )
                        ]
                    )
                ]
            )
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Actual section modulus and actual shear area shall each be at least their corresponding required value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:abreastOfHatch true ;
                      nltl:servesAsIceStringer true ;
                      nltl:actualSectionModulus ?actualZ ;
                      nltl:requiredSectionModulus ?requiredZ ;
                      nltl:actualShearArea ?actualA ;
                      nltl:requiredShearArea ?requiredA .
                ?actualZ qudt:numericValue ?actualZValue .
                ?requiredZ qudt:numericValue ?requiredZValue .
                ?actualA qudt:numericValue ?actualAValue .
                ?requiredA qudt:numericValue ?requiredAValue .
                FILTER (
                    ?actualZValue < ?requiredZValue ||
                    ?actualAValue < ?requiredAValue
                )
            }
        """
    ] .
