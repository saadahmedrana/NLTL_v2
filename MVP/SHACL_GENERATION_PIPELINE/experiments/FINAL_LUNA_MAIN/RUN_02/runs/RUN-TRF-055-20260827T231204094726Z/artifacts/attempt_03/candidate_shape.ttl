@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF055DecimalQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF055LengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF055ForcePerLengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF055VolumeQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF055AreaQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF055VeryLongHatchFalseShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:veryLongHatchOpening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .

gen:TRF055VeryLongHatchTrueShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:veryLongHatchOpening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:reducedLineLoadApprovedByClassificationSociety ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:permittedReducedLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 0.10 ;
                sh:maxExclusive 0.15
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

gen:TRF055NarrowDeckStripShape a sh:NodeShape ;
    sh:targetClass nltl:narrowDeckStrip ;
    sh:property [
        sh:path nltl:abreastOfHatch ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:servesAsIceStringer ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF055LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF055ForcePerLengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hatchOpeningLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF055LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:actualSectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF055VolumeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:requiredSectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF055VolumeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF055VolumeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:actualShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF055AreaQuantityShape
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF055AreaQuantityShape
    ] ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:class nltl:evidenceState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved
    ] ;
    sh:or (
        gen:TRF055VeryLongHatchFalseShape
        gen:TRF055VeryLongHatchTrueShape
    ) ;
    sh:sparql [
        sh:message "Actual section modulus must be at least the required section modulus, actual shear area must be at least the required shear area, and sectionModulus must correspond to actualSectionModulus." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:actualSectionModulus ?actualZ .
                ?actualZ qudt:numericValue ?actualZValue .
                $this nltl:requiredSectionModulus ?requiredZ .
                ?requiredZ qudt:numericValue ?requiredZValue .
                $this nltl:actualShearArea ?actualA .
                ?actualA qudt:numericValue ?actualAValue .
                $this nltl:requiredShearArea ?requiredA .
                ?requiredA qudt:numericValue ?requiredAValue .
                $this nltl:sectionModulus ?sectionZ .
                ?sectionZ qudt:numericValue ?sectionZValue .
                FILTER(
                    ?actualZValue < ?requiredZValue ||
                    ?actualAValue < ?requiredAValue ||
                    ABS(?sectionZValue - ?actualZValue) >
                    (0.000001 * ABS(?actualZValue) + 0.000000001)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "For a very long hatch, permitted reduced line load must equal design line load multiplied by hatch opening length within a relative tolerance of 1e-6 with a small absolute fallback." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:veryLongHatchOpening true .
                $this nltl:designLineLoad ?pQuantity .
                ?pQuantity qudt:numericValue ?p .
                ?pQuantity qudt:unit <http://qudt.org/vocab/unit/KiloN-PER-M> .
                $this nltl:hatchOpeningLength ?hQuantity .
                ?hQuantity qudt:numericValue ?h .
                ?hQuantity qudt:unit <http://qudt.org/vocab/unit/M> .
                $this nltl:permittedReducedLineLoad ?rQuantity .
                ?rQuantity qudt:numericValue ?r .
                ?rQuantity qudt:unit <http://qudt.org/vocab/unit/KiloN-PER-M> .
                FILTER(
                    ABS(?r - (?p * ?h)) >
                    (0.000001 * ABS(?p * ?h) + 0.000000001)
                )
            }
        """
    ] .
