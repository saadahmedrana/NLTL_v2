@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-059_WebFrameRequiredShearAreaShape>
    a sh:NodeShape ;
    sh:targetClass nltl:webFrame ;
    sh:property [
        sh:path nltl:maximumCalculatedShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloN
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webFrameShearFactorAlpha ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MegaPA
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:freeFlangeToWebAreaRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:CentiM2
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "requiredShearArea must match the Table 4-8 alpha selection and the prescribed shear-area calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?forceNode ;
                      nltl:webFrameShearFactorAlpha ?alphaNode ;
                      nltl:yieldStrength ?strengthNode ;
                      nltl:freeFlangeToWebAreaRatio ?ratioNode ;
                      nltl:requiredShearArea ?areaNode .

                ?forceNode qudt:numericValue ?force .
                ?alphaNode qudt:numericValue ?alpha .
                ?strengthNode qudt:numericValue ?strength .
                ?ratioNode qudt:numericValue ?ratio .
                ?areaNode qudt:numericValue ?reportedArea .

                BIND ((1.7320508075688772 * ?alpha * 1.1 * ?force / ?strength) * 10000 AS ?expectedArea)
                BIND (IF((?expectedArea * 0.000001) > 0.000001,
                         (?expectedArea * 0.000001),
                         0.000001) AS ?tolerance)

                FILTER (
                    (
                        (?ratio != 0 || ?alpha != 1.5) &&
                        (?ratio != 0.2 || ?alpha != 1.23) &&
                        (?ratio != 0.4 || ?alpha != 1.16) &&
                        (?ratio != 0.6 || ?alpha != 1.11) &&
                        (?ratio != 0.8 || ?alpha != 1.09) &&
                        (?ratio != 1.0 || ?alpha != 1.07) &&
                        (?ratio != 1.2 || ?alpha != 1.06) &&
                        (?ratio != 1.4 || ?alpha != 1.05) &&
                        (?ratio != 1.6 || ?alpha != 1.05) &&
                        (?ratio != 1.8 || ?alpha != 1.04) &&
                        (?ratio != 2.0 || ?alpha != 1.04)
                    )
                    ||
                    ?reportedArea < (?expectedArea - ?tolerance)
                    ||
                    ?reportedArea > (?expectedArea + ?tolerance)
                )
            }
        """
    ] .
