@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF059WebFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:webFrame ;
    sh:property [
        sh:path nltl:maximumCalculatedShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webFrameShearFactorAlpha ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:freeFlangeToWebAreaRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "freeFlangeToWebAreaRatio and webFrameShearFactorAlpha must be a permitted Table 4-8 pair" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:freeFlangeToWebAreaRatio ?ratio ;
                      nltl:webFrameShearFactorAlpha ?alpha .
                ?ratio qudt:numericValue ?ratioValue .
                ?alpha qudt:numericValue ?alphaValue .
                FILTER (
                    ! (
                        (?ratioValue = 0.0 && ?alphaValue = 1.5) ||
                        (?ratioValue = 0.2 && ?alphaValue = 1.23) ||
                        (?ratioValue = 0.4 && ?alphaValue = 1.16) ||
                        (?ratioValue = 0.6 && ?alphaValue = 1.11) ||
                        (?ratioValue = 0.8 && ?alphaValue = 1.09) ||
                        (?ratioValue = 1.0 && ?alphaValue = 1.07) ||
                        (?ratioValue = 1.2 && ?alphaValue = 1.06) ||
                        (?ratioValue = 1.4 && ?alphaValue = 1.05) ||
                        (?ratioValue = 1.6 && ?alphaValue = 1.05) ||
                        (?ratioValue = 1.8 && ?alphaValue = 1.04) ||
                        (?ratioValue = 2.0 && ?alphaValue = 1.04)
                    )
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "yieldStrength must not be zero for the required shear area calculation" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldStrength ?yield .
                ?yield qudt:numericValue ?yieldValue .
                FILTER (?yieldValue = 0.0)
            }
        """
    ] ;
    sh:sparql [
        sh:message "requiredShearArea must equal sqrt(3)*alpha*1.1*Q_MN/sigma_y*10^4 within the expected-value-scaled tolerance" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?force ;
                      nltl:webFrameShearFactorAlpha ?alpha ;
                      nltl:yieldStrength ?yield ;
                      nltl:requiredShearArea ?required .
                ?force qudt:numericValue ?forceValue .
                ?alpha qudt:numericValue ?alphaValue .
                ?yield qudt:numericValue ?yieldValue .
                ?required qudt:numericValue ?requiredValue .
                FILTER (?yieldValue != 0.0)
                BIND (
                    1.7320508075688772 * ?alphaValue * 1.1 *
                    (?forceValue / 1000.0) / ?yieldValue * 10000.0
                    AS ?expectedArea
                )
                FILTER (
                    ?requiredValue <
                    (?expectedArea * (1.0 - 0.000001) - 0.000001)
                    ||
                    ?requiredValue >
                    (?expectedArea * (1.0 + 0.000001) + 0.000001)
                )
            }
        """
    ] .
