@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF_064_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path (
            nltl:hasSidePropellerShafting
            nltl:enclosedByPlatedBossing
        ) ;
        sh:minCount 1 ;
        sh:message "Each side propeller shafting assembly shall be enclosed within plated bossing."
    ] ;
    sh:property [
        sh:path (
            nltl:hasSternTube
            nltl:enclosedByPlatedBossing
        ) ;
        sh:minCount 1 ;
        sh:message "Each side-propeller stern tube shall be enclosed within plated bossing."
    ] ;
    sh:property [
        sh:path (
            nltl:hasDetachedStrut
            nltl:hasStrutDesignEvidence
        ) ;
        sh:minCount 1 ;
        sh:message "Each detached strut shall have design evidence."
    ] ;
    sh:property [
        sh:path (
            nltl:hasDetachedStrut
            nltl:hasStrutStrengthEvidence
        ) ;
        sh:minCount 1 ;
        sh:message "Each detached strut shall have strength evidence."
    ] ;
    sh:property [
        sh:path (
            nltl:hasDetachedStrut
            nltl:hasStrutHullAttachmentEvidence
        ) ;
        sh:minCount 1 ;
        sh:message "Each detached strut shall have hull-attachment evidence."
    ] .
