@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:TRF064ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasDetachedStrut ;
        sh:node gs:TRF064DetachedStrutShape ;
        sh:message "Each supplied detached strut shall have design, strength, and hull-attachment evidence."
    ] ;
    sh:property [
        sh:path nltl:hasSidePropellerShafting ;
        sh:node gs:TRF064SidePropellerShaftingShape ;
        sh:message "Each supplied side-propeller shafting assembly shall be enclosed by a plated bossing."
    ] ;
    sh:property [
        sh:path nltl:hasSternTube ;
        sh:node gs:TRF064SternTubeShape ;
        sh:message "Each supplied stern tube shall be enclosed by a plated bossing."
    ] .

gs:TRF064DetachedStrutShape
    a sh:NodeShape ;
    sh:class nltl:detachedStrutStructure ;
    sh:property [
        sh:path nltl:hasStrutDesignEvidence ;
        sh:minCount 1 ;
        sh:class nltl:strutDesignEvidence ;
        sh:message "Detached strut design evidence is required."
    ] ;
    sh:property [
        sh:path nltl:hasStrutStrengthEvidence ;
        sh:minCount 1 ;
        sh:class nltl:strutStrengthEvidence ;
        sh:message "Detached strut strength evidence is required."
    ] ;
    sh:property [
        sh:path nltl:hasStrutHullAttachmentEvidence ;
        sh:minCount 1 ;
        sh:class nltl:strutHullAttachmentEvidence ;
        sh:message "Detached strut hull-attachment evidence is required."
    ] .

gs:TRF064SidePropellerShaftingShape
    a sh:NodeShape ;
    sh:class nltl:sidePropellerShaftingAssembly ;
    sh:property [
        sh:path nltl:enclosedByPlatedBossing ;
        sh:minCount 1 ;
        sh:class nltl:platedBossingStructure ;
        sh:message "Side-propeller shafting shall be enclosed by a plated bossing."
    ] .

gs:TRF064SternTubeShape
    a sh:NodeShape ;
    sh:class nltl:sternTube ;
    sh:property [
        sh:path nltl:enclosedByPlatedBossing ;
        sh:minCount 1 ;
        sh:class nltl:platedBossingStructure ;
        sh:message "The stern tube shall be enclosed by a plated bossing."
    ] .
