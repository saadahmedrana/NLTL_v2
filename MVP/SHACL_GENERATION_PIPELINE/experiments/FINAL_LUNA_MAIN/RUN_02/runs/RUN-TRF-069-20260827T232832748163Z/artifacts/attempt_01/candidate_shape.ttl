@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF-069 a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
        ) ;
        sh:minCount 1 ;
        sh:message "A ship must record an ice class applicable to this rule."
    ] ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "A ship must record its propeller type to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:pitchType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "A ship must record its pitch type to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:maximumIceTorque ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN-M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The maximum ice torque must be supplied as a decimal quantity in kN*m."
    ] ;
    sh:property [
        sh:path nltl:hasDesignCondition ;
        sh:node [
            sh:property [
                sh:path nltl:normalOperationalConditions ;
                sh:datatype xsd:boolean
            ] ;
            sh:property [
                sh:path nltl:normalServiceLifePropellerIceLoadCondition ;
                sh:datatype xsd:boolean
            ] ;
            sh:property [
                sh:path nltl:fixedPitchPropellerReversalLoadIncluded ;
                sh:datatype xsd:boolean
            ] ;
            sh:property [
                sh:path nltl:stoppedPropellerDraggingOutsideLoadModel ;
                sh:datatype xsd:boolean
            ] ;
            sh:property [
                sh:path nltl:radialIceEntryOutsideLoadModel ;
                sh:datatype xsd:boolean
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an applicable propulsion arrangement, one design condition must record normal service-life propeller/ice loads, fixed-pitch reversal loads, and both stated load-model exclusions." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>

SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass .
    FILTER (?iceClass IN (
        nltl:iceClassIaSuper,
        nltl:iceClassIa,
        nltl:iceClassIb,
        nltl:iceClassIc
    )) .

    $this nltl:propellerType ?propellerType .
    FILTER (?propellerType IN ("open", "ducted")) .

    $this nltl:pitchType ?pitchType .
    FILTER (?pitchType IN ("controllable", "fixed")) .

    FILTER NOT EXISTS {
        $this nltl:hasDesignCondition ?designCondition .
        ?designCondition
            nltl:normalOperationalConditions true ;
            nltl:normalServiceLifePropellerIceLoadCondition true ;
            nltl:fixedPitchPropellerReversalLoadIncluded true ;
            nltl:stoppedPropellerDraggingOutsideLoadModel true ;
            nltl:radialIceEntryOutsideLoadModel true .
    }
}
"""
    ] .
