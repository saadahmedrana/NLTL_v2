@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF070QuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF070PressureQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF070DesignConditionShape
    a sh:NodeShape ;
    sh:class nltl:designCondition ;
    sh:property [
        sh:path nltl:normalOperationalConditions ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The applicable design condition must represent normal operational conditions."
    ] ;
    sh:property [
        sh:path nltl:designConditionExpectedLoad ;
        sh:node gen:TRF070QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "The applicable design condition must provide its expected ice load."
    ] ;
    sh:property [
        sh:path nltl:designConditionLocalStrengthCapacity ;
        sh:node gen:TRF070QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "The applicable design condition must provide externally assessed local-strength capacity."
    ] .

gen:TRF070ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:thrusterType ;
        sh:datatype xsd:string ;
        sh:in ( "azimuthing" "fixed" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An applicable main propulsion thruster must be identified as azimuthing or fixed."
    ] ;
    sh:property [
        sh:path nltl:mainPropulsionThruster ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The applicable thruster must be identified as main propulsion."
    ] ;
    sh:property [
        sh:path nltl:propellerIceInteractionLoad ;
        sh:node gen:TRF070QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Propeller/ice interaction load is required for the applicable thruster."
    ] ;
    sh:property [
        sh:path nltl:thrusterBodyIceInteractionLoad ;
        sh:node gen:TRF070QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Thruster body/ice interaction load is required for the applicable thruster."
    ] ;
    sh:property [
        sh:path nltl:localIcePressure ;
        sh:node gen:TRF070PressureQuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Local ice pressure is required for the applicable thruster."
    ] ;
    sh:property [
        sh:path nltl:hasDesignCondition ;
        sh:node gen:TRF070DesignConditionShape ;
        sh:minCount 1 ;
        sh:message "An applicable design condition with required externally assessed results is required."
    ] ;
    sh:sparql [
        sh:message "Externally assessed local-strength capacity must be at least the applicable local ice pressure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasDesignCondition ?condition .
                ?condition nltl:designConditionLocalStrengthCapacity ?capacityQuantity .
                ?capacityQuantity qudt:numericValue ?capacity .
                $this nltl:localIcePressure ?pressureQuantity .
                ?pressureQuantity qudt:numericValue ?pressure .
                FILTER (?capacity < ?pressure)
            }
        """
    ] .

gen:TRF070Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:mainPropulsionThruster ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [ sh:node gen:TRF070ApplicableShape ]
    ) .
