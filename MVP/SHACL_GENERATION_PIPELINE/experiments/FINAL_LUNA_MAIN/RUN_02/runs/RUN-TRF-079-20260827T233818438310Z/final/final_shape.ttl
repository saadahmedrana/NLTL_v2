@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

gen:TRF079Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "designIceThickness must be a single QuantityValue expressed in metres." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iceLoadCycleCoefficientK2 must be a single dimensionless QuantityValue." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "propellerDiameter must be a single QuantityValue expressed in metres." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerImmersionFunction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "propellerImmersionFunction must be a single dimensionless QuantityValue." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerShaftCentrelineDepth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "propellerShaftCentrelineDepth must be a single QuantityValue expressed in metres." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "propellerImmersionFunction and iceLoadCycleCoefficientK2 must satisfy the specified formulae." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?iceQuantity ;
                      nltl:propellerDiameter ?diameterQuantity ;
                      nltl:propellerShaftCentrelineDepth ?depthQuantity ;
                      nltl:propellerImmersionFunction ?functionQuantity ;
                      nltl:iceLoadCycleCoefficientK2 ?coefficientQuantity .

                ?iceQuantity qudt:numericValue ?ice ;
                             qudt:unit <http://qudt.org/vocab/unit/M> .
                ?diameterQuantity qudt:numericValue ?diameter ;
                                   qudt:unit <http://qudt.org/vocab/unit/M> .
                ?depthQuantity qudt:numericValue ?depth ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                ?functionQuantity qudt:numericValue ?function .
                ?coefficientQuantity qudt:numericValue ?coefficient .

                BIND (((?depth - ?ice) / (?diameter / 2)) - 1 AS ?expectedFunction)
                BIND (
                    IF(
                        ?expectedFunction < 0,
                        0.8 - ?expectedFunction,
                        IF(
                            ?expectedFunction <= 1,
                            0.8 - (0.4 * ?expectedFunction),
                            IF(
                                ?expectedFunction <= 2.5,
                                0.6 - (0.2 * ?expectedFunction),
                                0.1
                            )
                        )
                    ) AS ?expectedCoefficient
                )

                FILTER (
                    ABS(?function - ?expectedFunction) >
                    (1e-6 * ABS(?expectedFunction) + 1e-9)
                    ||
                    ABS(?coefficient - ?expectedCoefficient) >
                    (1e-6 * ABS(?expectedCoefficient) + 1e-9)
                )
            }
        """
    ] .
