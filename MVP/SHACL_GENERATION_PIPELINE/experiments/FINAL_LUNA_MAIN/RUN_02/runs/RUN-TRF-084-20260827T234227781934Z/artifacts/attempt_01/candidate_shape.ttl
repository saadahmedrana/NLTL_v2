@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_084_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "For a CP propeller, the MCR bollard pitch must be represented; when the pitch value is not known, it must equal 0.7 times the MCR free-running pitch within a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType ?propellerType ;
                      nltl:pitchValueKnown ?pitchKnown .

                FILTER (
                    (
                        ?propellerType = "CP"
                        && ?pitchKnown = true
                        && (
                            NOT EXISTS {
                                $this nltl:propellerPitchAtMcrBollard ?result .
                                ?result rdf:type qudt:QuantityValue ;
                                        qudt:numericValue ?resultValue ;
                                        qudt:unit unit:M .
                                FILTER (datatype(?resultValue) = xsd:decimal)
                            }
                            ||
                            EXISTS {
                                $this nltl:propellerPitchAtMcrBollard ?result .
                                FILTER NOT EXISTS {
                                    ?result rdf:type qudt:QuantityValue ;
                                            qudt:numericValue ?resultValue ;
                                            qudt:unit unit:M .
                                    FILTER (datatype(?resultValue) = xsd:decimal)
                                }
                            }
                            ||
                            EXISTS {
                                $this nltl:propellerPitchAtMcrBollard ?result .
                                ?result qudt:unit ?resultUnit .
                                FILTER (?resultUnit != unit:M)
                            }
                        )
                    )
                    ||
                    (
                        ?propellerType = "CP"
                        && ?pitchKnown = false
                        && (
                            NOT EXISTS {
                                $this nltl:propellerPitchAtMcrFreeRunning ?operand .
                                ?operand rdf:type qudt:QuantityValue ;
                                         qudt:numericValue ?operandValue ;
                                         qudt:unit unit:M .
                                FILTER (datatype(?operandValue) = xsd:decimal)
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:propellerPitchAtMcrBollard ?result .
                                ?result rdf:type qudt:QuantityValue ;
                                        qudt:numericValue ?resultValue ;
                                        qudt:unit unit:M .
                                FILTER (datatype(?resultValue) = xsd:decimal)
                            }
                            ||
                            EXISTS {
                                $this nltl:propellerPitchAtMcrFreeRunning ?operand .
                                FILTER NOT EXISTS {
                                    ?operand rdf:type qudt:QuantityValue ;
                                             qudt:numericValue ?operandValue ;
                                             qudt:unit unit:M .
                                    FILTER (datatype(?operandValue) = xsd:decimal)
                                }
                            }
                            ||
                            EXISTS {
                                $this nltl:propellerPitchAtMcrFreeRunning ?operand .
                                ?operand qudt:unit ?operandUnit .
                                FILTER (?operandUnit != unit:M)
                            }
                            ||
                            EXISTS {
                                $this nltl:propellerPitchAtMcrBollard ?result .
                                FILTER NOT EXISTS {
                                    ?result rdf:type qudt:QuantityValue ;
                                            qudt:numericValue ?resultValue ;
                                            qudt:unit unit:M .
                                    FILTER (datatype(?resultValue) = xsd:decimal)
                                }
                            }
                            ||
                            EXISTS {
                                $this nltl:propellerPitchAtMcrBollard ?result .
                                ?result qudt:unit ?resultUnit .
                                FILTER (?resultUnit != unit:M)
                            }
                            ||
                            EXISTS {
                                $this nltl:propellerPitchAtMcrFreeRunning ?operand ;
                                      nltl:propellerPitchAtMcrBollard ?result .
                                ?operand qudt:numericValue ?operandValue ;
                                         qudt:unit unit:M .
                                ?result qudt:numericValue ?resultValue ;
                                       qudt:unit unit:M .
                                FILTER (
                                    datatype(?operandValue) = xsd:decimal
                                    && datatype(?resultValue) = xsd:decimal
                                    && ABS(?resultValue - (0.7 * ?operandValue))
                                       > (
                                           0.000001 * ABS(0.7 * ?operandValue)
                                           + 0.000000001
                                       )
                                )
                            }
                        )
                    )
                )
            }
        """
    ] .
