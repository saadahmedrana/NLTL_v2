@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF-091-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-091-IceMillingSequenceCaseShape> ;
        sh:message "The ship shall identify the load-sequence case for propeller ice-block milling."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCase ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-091-PropulsionLoadCaseShape> ;
        sh:message "The ship shall identify the propulsion-line strength-evaluation load case."
    ] .

<urn:nltl:generated-shape:TRF-091-IceMillingSequenceCaseShape>
    a sh:NodeShape .

<urn:nltl:generated-shape:TRF-091-PropulsionLoadCaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadCasePurpose ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCasePurposeValue ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-091-StrengthEvaluationPurposeShape> ;
        sh:message "The propulsion load case shall specify its purpose as propulsion-line strength evaluation and shall not specify stalling analysis."
    ] .

<urn:nltl:generated-shape:TRF-091-StrengthEvaluationPurposeShape>
    a sh:NodeShape ;
    sh:property [
        sh:path [
            sh:inversePath nltl:loadCasePurpose
        ] ;
        sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose
    ] ;
    sh:not [
        sh:property [
            sh:path [
                sh:inversePath nltl:loadCasePurpose
            ] ;
            sh:hasValue nltl:stallingAnalysisPurposeValue
        ]
    ] .
