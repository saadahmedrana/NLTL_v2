@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF091ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:node gen:TRF091PropulsionLoadCaseShape ;
        sh:minCount 1 ;
        sh:equals nltl:hasPropulsionLoadCase ;
        sh:message "The ice-milling load-sequence case shall be the propulsion-line strength evaluation case."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCase ;
        sh:node gen:TRF091PropulsionLoadCaseShape ;
        sh:minCount 1 ;
        sh:message "A propulsion load case used for strength evaluation shall be declared."
    ] .

gen:TRF091PropulsionLoadCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadCasePurpose ;
        sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The propulsion load case shall have propulsion-line strength evaluation as its purpose."
    ] ;
    sh:not [
        sh:property [
            sh:path nltl:loadCasePurpose ;
            sh:hasValue nltl:stallingAnalysisPurposeValue
        ]
    ] .
