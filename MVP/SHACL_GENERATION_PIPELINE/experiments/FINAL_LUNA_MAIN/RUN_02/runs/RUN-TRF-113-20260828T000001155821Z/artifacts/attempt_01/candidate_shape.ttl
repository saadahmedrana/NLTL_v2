@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-113> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bladePlasticBending ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ship must record the plastic-bending design condition for blade loss." ;
    ] ;
    sh:property [
        sh:path nltl:propellerBladeOrientation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ship must identify the propeller blade orientation causing the maximum component load." ;
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:loadCase ;
            sh:property [
                sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The propulsion load case must confirm that the maximum component-load blade orientation was considered." ;
            ]
        ] ;
    ] ;
    sh:property [
        sh:path nltl:thrusterBladeLossDesignEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ] ;
        sh:message "Evidence of the thruster blade-loss design assessment must be provided." ;
    ] .
