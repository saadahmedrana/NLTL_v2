@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-120-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:node [
            sh:property [
                sh:path nltl:hasNaturalFrequencyCalculationCase ;
                sh:node [
                    sh:class nltl:calculationCase ;
                    sh:property [
                        sh:path nltl:vibrationDirection ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:or (
                                [ sh:hasValue nltl:longitudinalDirection ]
                                [ sh:hasValue nltl:transverseDirection ]
                            )
                        ] ;
                        sh:message "Each linked natural-frequency calculation case must specify longitudinal or transverse vibration direction."
                    ]
                ]
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When a thruster body has a natural-frequency calculation case, the ship must provide damping, water added mass, and thruster natural frequency, and the body must provide ship attachment stiffness with the canonical quantity structure and units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasComponent ?body .
                ?body nltl:hasNaturalFrequencyCalculationCase ?case .
                FILTER (
                    NOT EXISTS {
                        $this nltl:damping ?damping .
                        FILTER (datatype(?damping) = xsd:string)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:waterAddedMass ?mass .
                        ?mass rdf:type qudt:QuantityValue .
                        ?mass qudt:numericValue ?massValue .
                        ?mass qudt:unit <http://qudt.org/vocab/unit/KiloGM> .
                        FILTER (datatype(?massValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:thrusterNaturalFrequency ?frequency .
                        ?frequency rdf:type qudt:QuantityValue .
                        ?frequency qudt:numericValue ?frequencyValue .
                        ?frequency qudt:unit <http://qudt.org/vocab/unit/HZ> .
                        FILTER (datatype(?frequencyValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?body nltl:shipAttachmentStiffness ?stiffness .
                        ?stiffness rdf:type qudt:QuantityValue .
                        ?stiffness qudt:numericValue ?stiffnessValue .
                        ?stiffness qudt:unit <http://qudt.org/vocab/unit/KiloN-PER-M> .
                        FILTER (datatype(?stiffnessValue) = xsd:decimal)
                    }
                )
            }
        """
    ] .
