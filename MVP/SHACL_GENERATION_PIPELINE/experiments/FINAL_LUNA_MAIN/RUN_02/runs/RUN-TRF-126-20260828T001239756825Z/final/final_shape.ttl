@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propulsionEngineReversedForAstern ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "Propulsion engine astern-reversal applicability must be recorded as true for this branch."
            ] ;
            sh:property [
                sh:path nltl:airReceiverConsecutiveStartCapacity ;
                sh:datatype xsd:integer ;
                sh:minInclusive 12 ;
                sh:minCount 1 ;
                sh:message "Air receiver capacity must provide at least 12 consecutive propulsion-engine starts when reversal for astern movement is required."
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionEngineReversedForAstern ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:message "Propulsion engine astern-reversal applicability must be recorded as false for this branch."
            ] ;
            sh:property [
                sh:path nltl:airReceiverConsecutiveStartCapacity ;
                sh:datatype xsd:integer ;
                sh:minInclusive 6 ;
                sh:minCount 1 ;
                sh:message "Air receiver capacity must provide at least 6 consecutive propulsion-engine starts when reversal for astern movement is not required."
            ]
        ]
    )
] .
