@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:TRF130_InletChestCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:seaInletLocation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The inlet chest shall specify its sea inlet location."
    ] ;
    sh:property [
        sh:path nltl:nearCentrelineAndWellAftIfPossible ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The sea inlet shall be near the centreline and well aft if possible."
    ] ;
    sh:property [
        sh:path nltl:recommendedChestVolume ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:seaChestVolume ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceAccumulationSpaceAboveInlet ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The inlet chest shall provide space for ice accumulation above the inlet."
    ] ;
    sh:property [
        sh:path nltl:fullCapacityDischargePipeConnected ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A full-capacity cooling-water discharge pipe shall be connected to the inlet chest."
    ] ;
    sh:property [
        sh:path nltl:inletPipeArea ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:strainerOpenArea ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:strainerOpenAreaRatio ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The inlet chest volume shall be approximately total relevant engine power divided by 750, and the strainer open area shall be at least four times the inlet pipe area; the reported ratio shall correspond to the derived area ratio." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                ?ship nltl:hasComponent $this ;
                      nltl:totalRelevantEnginePower ?totalPowerNode ;
                      nltl:maximumContinuousRatingPower ?maximumPowerNode .
                $this nltl:recommendedChestVolume ?recommendedVolumeNode ;
                      nltl:seaChestVolume ?seaVolumeNode ;
                      nltl:strainerOpenArea ?strainerAreaNode ;
                      nltl:inletPipeArea ?pipeAreaNode ;
                      nltl:strainerOpenAreaRatio ?ratioNode .

                ?totalPowerNode qudt:numericValue ?totalPower .
                ?maximumPowerNode qudt:numericValue ?maximumPower .
                ?recommendedVolumeNode qudt:numericValue ?recommendedVolume .
                ?seaVolumeNode qudt:numericValue ?seaVolume .
                ?strainerAreaNode qudt:numericValue ?strainerArea .
                ?pipeAreaNode qudt:numericValue ?pipeArea .
                ?ratioNode qudt:numericValue ?reportedRatio .

                BIND (?totalPower / 750 AS ?expectedVolume)
                BIND (?strainerArea / ?pipeArea AS ?expectedRatio)

                FILTER (
                    ?pipeArea <= 0 ||
                    ?strainerArea < (4 * ?pipeArea) ||
                    ABS(?recommendedVolume - ?expectedVolume) >
                        (1e-6 * ABS(?expectedVolume) + 0.000001) ||
                    ABS(?seaVolume - ?expectedVolume) >
                        (1e-6 * ABS(?expectedVolume) + 0.000001) ||
                    ABS(?reportedRatio - ?expectedRatio) >
                        (1e-6 * ABS(?expectedRatio) + 0.000001) ||
                    ?maximumPower != ?maximumPower
                )
            }
        """
    ] .

nltl:TRF130_AlternativeInletChestCaseShape
    a sh:NodeShape ;
    sh:node nltl:TRF130_InletChestCaseShape ;
    sh:property [
        sh:path nltl:alternatingCoolingWaterIntakeAndDischarge ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Alternative inlet chests shall provide alternating cooling-water intake and discharge."
    ] .

nltl:TRF130_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The cooling-water chest volume and height applicability selector is required."
    ] ;
    sh:property [
        sh:path nltl:totalRelevantEnginePower ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:qualifiedValueShape [
                    sh:class nltl:inletChest ;
                    sh:node nltl:TRF130_InletChestCaseShape
                ] ;
                sh:qualifiedMinCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:coolingWaterChestAlternativeArrangementUsed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The alternative arrangement selector shall be true when the volume and height requirements cannot be met."
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:qualifiedValueShape [
                    sh:class nltl:inletChest ;
                    sh:node nltl:TRF130_AlternativeInletChestCaseShape
                ] ;
                sh:qualifiedMinCount 2
            ]
        ]
    ) .
