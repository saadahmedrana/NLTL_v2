@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-010> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowDesignForceMethod ;
        sh:datatype xsd:string ;
        sh:message "Any recorded bow design force method must be a string."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 )
            ] ;
            sh:property [
                sh:path nltl:verticalSidedBowForm ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 )
            ] ;
            sh:property [
                sh:path nltl:bowVerticalSideStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 )
            ] ;
            sh:property [
                sh:path nltl:normalFrameAngle ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive 0 ;
                        sh:maxInclusive 10
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/DEG>
                    ]
                ]
            ]
        ]
    ) ;
    sh:message "Design ice force applicability requires Polar Class PC6 or PC7 and a vertical-sided bow, including the permitted normal frame angle range from 0 to 10 degrees." .
