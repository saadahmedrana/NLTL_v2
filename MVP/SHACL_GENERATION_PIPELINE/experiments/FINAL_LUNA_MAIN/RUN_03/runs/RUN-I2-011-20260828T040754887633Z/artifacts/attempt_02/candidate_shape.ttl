@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_011_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:I2_011_ApplicableShape
        gs:I2_011_NonApplicableShape
    ) .

gs:I2_011_ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:in (
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ;
        sh:node gs:I2_011_ForceMegaNewtonValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ;
        sh:node gs:I2_011_ForceMegaNewtonValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:shapeCoefficient ;
        sh:node gs:I2_011_FaValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:node gs:I2_011_AspectRatioValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bowDesignForce ;
        sh:node gs:I2_011_ForceKiloNewtonValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "For an applicable PC6 or PC7 bulbous-bow ship, the bow design force must be determined by method (iv), must not be less than the method (iii) force, and method (iii) must use fa = 0.6 and AR = 1.3." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiNode ;
                       nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivNode ;
                       nltl:shapeCoefficient ?faNode ;
                       nltl:loadPatchAspectRatio ?arNode ;
                       nltl:bowDesignForce ?resultNode .

                ?iiiNode qudt:numericValue ?iii .
                ?ivNode qudt:numericValue ?iv .
                ?faNode qudt:numericValue ?fa .
                ?arNode qudt:numericValue ?ar .
                ?resultNode qudt:numericValue ?result .

                FILTER (
                    ?fa = 0.6 &&
                    ?ar = 1.3 &&
                    ?result >= (?iii * 1000) &&
                    ABS(?result - (?iv * 1000)) <=
                        (0.000001 * ABS(?iv * 1000) + 0.000001)
                )
            }
        """
    ] .

gs:I2_011_NonApplicableShape
    a sh:NodeShape ;
    sh:or (
        gs:I2_011_Pc1Shape
        gs:I2_011_Pc2Shape
        gs:I2_011_Pc3Shape
        gs:I2_011_Pc4Shape
        gs:I2_011_Pc5Shape
        gs:I2_011_BulbousBowAbsentShape
    ) .

gs:I2_011_Pc1Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:hasValue nltl:polarClassPc1 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_011_Pc2Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:hasValue nltl:polarClassPc2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_011_Pc3Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:hasValue nltl:polarClassPc3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_011_Pc4Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:hasValue nltl:polarClassPc4 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_011_Pc5Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:hasValue nltl:polarClassPc5 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_011_BulbousBowAbsentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_011_ForceMegaNewtonValue
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_011_ForceKiloNewtonValue
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_011_FaValue
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.6 ;
        sh:maxInclusive 0.6 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_011_AspectRatioValue
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.3 ;
        sh:maxInclusive 1.3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
