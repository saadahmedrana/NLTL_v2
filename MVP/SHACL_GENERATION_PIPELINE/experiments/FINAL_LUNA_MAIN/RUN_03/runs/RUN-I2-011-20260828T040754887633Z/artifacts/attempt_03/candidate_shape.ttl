@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_011_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "polarClass is required to determine applicability." ;
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "bulbousBowPresent is required to determine applicability." ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:in (
                    nltl:polarClassPc6
                    nltl:polarClassPc7
                )
            ] ;
            sh:property [
                sh:path nltl:bulbousBowPresent ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:shapeCoefficient ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "0.6"^^xsd:decimal ;
                        sh:maxInclusive "0.6"^^xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "For an applicable ship, shapeCoefficient must encode fa = 0.6." ;
            ] ;
            sh:property [
                sh:path nltl:loadPatchAspectRatio ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "1.3"^^xsd:decimal ;
                        sh:maxInclusive "1.3"^^xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "For an applicable ship, loadPatchAspectRatio must be AR = 1.3." ;
            ] ;
            sh:property [
                sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowDesignForce ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "The bow design force must be reported in kN." ;
            ] ;
            sh:sparql [
                sh:message "For an applicable ship, bowDesignForce must be determined by method (iv), within scaled tolerance, and must not be less than the method (iii) result using fa = 0.6 and AR = 1.3." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:shapeCoefficient ?faNode ;
                              nltl:loadPatchAspectRatio ?arNode ;
                              nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiNode ;
                              nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivNode ;
                              nltl:bowDesignForce ?forceNode .

                        ?faNode <http://qudt.org/schema/qudt/numericValue> ?fa .
                        ?arNode <http://qudt.org/schema/qudt/numericValue> ?ar .
                        ?iiiNode <http://qudt.org/schema/qudt/numericValue> ?iii .
                        ?ivNode <http://qudt.org/schema/qudt/numericValue> ?iv .
                        ?forceNode <http://qudt.org/schema/qudt/numericValue> ?force .

                        BIND ((?iii * (?fa / 0.6) * (?ar / 1.3)) * 1000 AS ?expectedIiiKiloN)
                        BIND (?iv * 1000 AS ?expectedIvKiloN)
                        BIND (1e-6 * IF(?expectedIvKiloN >= 0, ?expectedIvKiloN, -?expectedIvKiloN) + 1e-9 AS ?tolerance)

                        FILTER (
                            ?force < (?expectedIiiKiloN) ||
                            ?force < (?expectedIvKiloN - ?tolerance) ||
                            ?force > (?expectedIvKiloN + ?tolerance)
                        )
                    }
                """
            ]
        ]
        [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:polarClass ;
                        sh:in (
                            nltl:polarClassPc1
                            nltl:polarClassPc2
                            nltl:polarClassPc3
                            nltl:polarClassPc4
                            nltl:polarClassPc5
                        )
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:bulbousBowPresent ;
                        sh:hasValue false
                    ]
                ]
            )
        ]
    ) .
