@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_014_BowSubregionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:class nltl:bowSubregionCalculationCase ;
        sh:node gen:I2_014_BowSubregionCaseShape
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MegaN
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MegaN-M-PER-M2
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MegaPA
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The four bow subregions must collectively use the four quarter midpoints of the bow length, one midpoint per subregion." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength ?blq .
                ?blq qudt:numericValue ?bl .

                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?c1 .
                    ?c1 nltl:bowSubregionMidLengthPosition ?mq1 .
                    ?mq1 qudt:numericValue ?m1 .
                    BIND(0.125 * ?bl AS ?e1)
                    FILTER (
                        ABS(?m1 - ?e1) <= (0.000001 * ABS(?e1))
                        || ABS(?m1 - ?e1) <= 0.000000001
                    )
                }

                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?c2 .
                    ?c2 nltl:bowSubregionMidLengthPosition ?mq2 .
                    ?mq2 qudt:numericValue ?m2 .
                    BIND(0.375 * ?bl AS ?e2)
                    FILTER (
                        ABS(?m2 - ?e2) <= (0.000001 * ABS(?e2))
                        || ABS(?m2 - ?e2) <= 0.000000001
                    )
                }

                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?c3 .
                    ?c3 nltl:bowSubregionMidLengthPosition ?mq3 .
                    ?mq3 qudt:numericValue ?m3 .
                    BIND(0.625 * ?bl AS ?e3)
                    FILTER (
                        ABS(?m3 - ?e3) <= (0.000001 * ABS(?e3))
                        || ABS(?m3 - ?e3) <= 0.000000001
                    )
                }

                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?c4 .
                    ?c4 nltl:bowSubregionMidLengthPosition ?mq4 .
                    ?mq4 qudt:numericValue ?m4 .
                    BIND(0.875 * ?bl AS ?e4)
                    FILTER (
                        ABS(?m4 - ?e4) <= (0.000001 * ABS(?e4))
                        || ABS(?m4 - ?e4) <= 0.000000001
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Selected bow force, line load, and pressure must equal the corresponding calculated maximum within the permitted decimal tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?sfq ;
                      nltl:selectedMaximumBowLineLoad ?sqlq ;
                      nltl:selectedMaximumBowPressure ?spq ;
                      nltl:hasBowSubregionCalculationCase ?case .

                ?sfq qudt:numericValue ?sf .
                ?sqlq qudt:numericValue ?sql .
                ?spq qudt:numericValue ?sp .

                ?case nltl:bowSubregionCalculatedForce ?fq ;
                      nltl:bowSubregionCalculatedLineLoad ?qlq ;
                      nltl:bowSubregionCalculatedPressure ?pq .
                ?fq qudt:numericValue ?f .
                ?qlq qudt:numericValue ?q .
                ?pq qudt:numericValue ?p .
            }
            GROUP BY $this ?sf ?sql ?sp
            HAVING (
                (
                    ABS(?sf - MAX(?f)) > (0.000001 * ABS(MAX(?f)))
                    && ABS(?sf - MAX(?f)) > 0.000000001
                )
                ||
                (
                    ABS(?sql - MAX(?q)) > (0.000001 * ABS(MAX(?q)))
                    && ABS(?sql - MAX(?q)) > 0.000000001
                )
                ||
                (
                    ABS(?sp - MAX(?p)) > (0.000001 * ABS(MAX(?p)))
                    && ABS(?sp - MAX(?p)) > 0.000000001
                )
            )
        """
    ] .

gen:I2_014_BowSubregionCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MegaN
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MegaN-M-PER-M2
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MegaPA
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculationEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact
    ] .
